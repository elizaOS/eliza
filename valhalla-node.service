[Unit]
Description=ValhallaOS V38 Sovereign DePIN Node & Beacon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/eliza-valhalla
EnvironmentFile=/root/eliza-valhalla/.env
ExecStart=/root/.bun/bin/bun run scripts/alwaysOnBeacon.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
