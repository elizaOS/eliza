// The shell of src/greeter.vibe across a reload: what the conformance driver (test/drivers/app.ts) cannot see,
// which is a greeter started again from its store, and a store holding what is not one.
import { assert, layer } from "@effect/vitest"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { Greetings, load, stored } from "../src/greeter.vibe"

/** The greeter a page opened now would show. */
effect function reopened() { return Option.getOrUndefined(try Stream.runHead(Context.get(try Layer.build(stored), Greetings).changes)) }

layer(KeyValueStore.layerMemory)((it) => {
  // spec/app/index.md, "Story: Say hello"
  it.effect("Say hello, then open the page again", () => effect {
    const unloaded = try load()
    unloaded.count = 50
    const greetings = Context.get(try Layer.build(stored), Greetings)
    try Stream.runHead(Stream.tap(greetings.changes, (state) => sync(() => { state.count = -1 })))
    const first = try greetings.receive({ type: "greet", name: "Ada" })
    first.count = -1
    try greetings.receive({ type: "greet", name: "Grace" })
    const again = try reopened()
    // spec/app/index.md, "Once someone has been greeted, the greeter holds a name"
    try (try KeyValueStore.KeyValueStore).set("greeter", JSON.stringify({ name: "", count: 1 }))
    const invalid = try reopened()
    // spec/app/index.md, "The number of greetings is never negative"
    try (try KeyValueStore.KeyValueStore).set("greeter", JSON.stringify({ name: "Grace", count: -1 }))
    const negative = try reopened()
    try Effect.try(() => assert.deepStrictEqual([again, invalid, negative], [{ name: "Grace", count: 2 }, { name: "", count: 0 }, { name: "", count: 0 }]))
  })
})
