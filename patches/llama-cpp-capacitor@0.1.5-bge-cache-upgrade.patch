+static NSString *WritableBundle(NSString *modelPath, NSError **error) {
+    NSFileManager *files = NSFileManager.defaultManager;
+    NSString *model = modelPath.stringByResolvingSymlinksInPath;
+    NSURL *cache = [files URLsForDirectory:NSCachesDirectory inDomains:NSUserDomainMask].firstObject;
+    if (!cache) { Fail(error, @"EMBEDDING_MODEL_UNAVAILABLE", @"Writable app cache is required for BGE bundle metadata"); return nil; }
+    NSData *identity = CompleteUtf8(model, error); if (!identity) return nil;
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(identity.bytes, (CC_LONG)identity.length, digest);
+    NSMutableString *key = [NSMutableString string];
+    for (unsigned char byte : digest) [key appendFormat:@"%02x", byte];
+    NSString *bundle = [cache.path stringByAppendingPathComponent:[@"eliza-bge/" stringByAppendingString:key]];
+    NSString *textDir = [bundle stringByAppendingPathComponent:@"text"];
+    @synchronized([ElizaBgeEncoder class]) {
+        NSError *fileError = nil;
+        if (![files createDirectoryAtPath:textDir withIntermediateDirectories:YES attributes:nil error:&fileError]) {
+            Fail(error, @"EMBEDDING_ARTIFACT_INVALID", fileError.localizedDescription); return nil;
+        }
+        NSString *target = [textDir stringByAppendingPathComponent:ModelName];
+        if (![files fileExistsAtPath:target] && ![files createSymbolicLinkAtPath:target withDestinationPath:model error:&fileError]) {
+            Fail(error, @"EMBEDDING_ARTIFACT_INVALID", fileError.localizedDescription); return nil;
+        }
+        NSArray<NSString *> *entries = [files contentsOfDirectoryAtPath:textDir error:&fileError];
+        BOOL directory = NO;
+        if (entries.count != 1 || ![entries.firstObject isEqualToString:ModelName] || ![files fileExistsAtPath:target isDirectory:&directory] || directory || ![target.stringByResolvingSymlinksInPath isEqualToString:model]) {
+            Fail(error, @"EMBEDDING_ARTIFACT_INVALID", @"The encoder cache must reference only the requested pinned BGE file"); return nil;
+        }
+        if (!VerifyArtifact(target, error)) return nil;
+    }
+    return bundle;
+}
