+{"version":3,"sources":["../src/index.ts"],"sourcesContent":["import type { PGlite } from '@electric-sql/pglite'\nimport { type Server, type Socket, createServer } from 'net'\n\n// Connection queue timeout in milliseconds\nexport const CONNECTION_QUEUE_TIMEOUT = 60000 // 60 seconds\n\n/**\n * Represents a queued query waiting for PGlite access\n */\ninterface QueuedQuery {\n  handlerId: number\n  message: Uint8Array\n  resolve: (resultSize: number) => void\n  reject: (error: Error) => void\n  timestamp: number\n  onData: (data: Uint8Array) => void\n}\n\n/**\n * Global query queue manager\n * Ensures only one query executes at a time in PGlite\n */\nclass QueryQueueManager {\n  private queue: QueuedQuery[] = []\n  private processing = false\n  private extendedHandlerId: number | null = null\n  private transactionHandlerId: number | null = null\n  private activeHandlerId: number | null = null\n  private recoveringHandlerId: number | null = null\n  private recoveryPromise?: Promise<void>\n  private terminalError?: Error\n\n  constructor(private db: PGlite, private debug = false) {}\n\n  private log(message: string, ...args: any[]): void {\n    if (this.debug) console.log(`[QueryQueueManager] ${message}`, ...args)\n  }\n\n  async enqueue(handlerId: number, message: Uint8Array, onData: (data: Uint8Array) => void): Promise<number> {\n    if (this.terminalError) throw this.terminalError\n    return new Promise((resolve, reject) => {\n      this.queue.push({ handlerId, message, onData, resolve, reject, timestamp: Date.now() })\n      void this.processQueue()\n    })\n  }\n\n  private nextQueryIndex(): number {\n    if (this.terminalError || this.recoveringHandlerId !== null) return -1\n    const owner = this.transactionHandlerId ?? this.extendedHandlerId\n    return owner === null ? (this.queue.length ? 0 : -1) : this.queue.findIndex((q) => q.handlerId === owner)\n  }\n\n  private failClosed(error: Error): void {\n    this.terminalError ??= error\n    for (const query of this.queue.splice(0)) query.reject(this.terminalError)\n  }\n\n  private async processQueue(): Promise<void> {\n    if (this.processing || this.nextQueryIndex() === -1) return\n    this.processing = true\n    try {\n      for (let index = this.nextQueryIndex(); index !== -1; index = this.nextQueryIndex()) {\n        const query = this.queue.splice(index, 1)[0]\n        this.activeHandlerId = query.handlerId\n        const type = query.message[0]\n        // Parse/Bind/Describe/Execute/Close share one implicit transaction until Sync.\n        if ([80, 66, 68, 69, 67].includes(type)) this.extendedHandlerId = query.handlerId\n        let result = 0\n        try {\n          if (this.db.closed) throw new Error('PGlite database is closed')\n          await this.db.runExclusive(async () => {\n            const onData = (data: Uint8Array) => { result += data.length; query.onData(data) }\n            if (type === 83) await this.resetFrame(query.message, true, false, onData)\n            else await this.db.execProtocolRawStream(query.message, { onRawData: onData })\n          })\n          this.transactionHandlerId = this.db.isInTransaction() ? query.handlerId : null\n          if (type === 83) this.extendedHandlerId = null\n          query.resolve(result)\n        } catch (error) {\n          const failure = error instanceof Error ? error : new Error(String(error))\n          query.reject(failure)\n          this.failClosed(failure)\n        } finally {\n          this.activeHandlerId = null\n        }\n      }\n    } finally {\n      this.processing = false\n      // Recovery can finish between the final frame and this continuation.\n      if (this.nextQueryIndex() !== -1) void this.processQueue()\n    }\n  }\n\n  getQueueLength(): number { return this.queue.length }\n\n  clearQueueForHandler(handlerId: number): void {\n    this.queue = this.queue.filter((query) => {\n      if (query.handlerId !== handlerId) return true\n      query.reject(new Error('Handler disconnected'))