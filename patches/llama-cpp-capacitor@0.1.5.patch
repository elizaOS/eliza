+/** Preserves complete UTF-8 input and verifies artifact identity before invoking the linked, source-matched fused encoder. */
+#import "ElizaBgeEncoder.h"
+#import <CommonCrypto/CommonDigest.h>
+#import <LlamaCpp/eliza-inference-ffi.h>
+#include <array>
+#include <cerrno>
+#include <climits>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+
+static NSString *const ModelName = @"bge-small-en-v1.5-f16.gguf";
+static NSString *const ModelSha = @"f0b2fef971e8366438bfd2d9aefea1b0115919389448806d290237f638bae999";
+static NSString *const VectorSpace = @"BAAI/bge-small-en-v1.5:cls:l2:384";
+
+static void Fail(NSError **error, NSString *code, NSString *message) {
+    if (error) *error = [NSError errorWithDomain:code code:1 userInfo:@{NSLocalizedDescriptionKey: message}];
+}
+static NSData *CompleteUtf8(NSString *text, NSError **error) {
+    NSData *bytes = [text dataUsingEncoding:NSUTF8StringEncoding allowLossyConversion:NO];
+    if (!bytes) Fail(error, @"EMBEDDING_INPUT_INVALID", @"Input must contain complete UTF-16 characters");
+    return bytes;
+}
+static bool VerifyArtifact(NSString *file, NSError **error) {
+    std::unique_ptr<FILE, decltype(&fclose)> input(fopen(file.fileSystemRepresentation, "rb"), fclose);
+    if (!input) { Fail(error, @"EMBEDDING_MODEL_UNAVAILABLE", @"Cannot read the pinned BGE artifact"); return false; }
+    CC_SHA256_CTX digest;
+    CC_SHA256_Init(&digest);
+    std::array<unsigned char, 65536> block;
+    size_t count;
+    while ((count = fread(block.data(), 1, block.size(), input.get())) != 0) CC_SHA256_Update(&digest, block.data(), (CC_LONG)count);
+    if (ferror(input.get())) { Fail(error, @"EMBEDDING_MODEL_UNAVAILABLE", @"Cannot finish reading the BGE artifact"); return false; }
+    unsigned char result[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256_Final(result, &digest);
+    NSMutableString *actual = [NSMutableString string];
+    for (unsigned char byte : result) [actual appendFormat:@"%02x", byte];
+    if (![actual isEqualToString:ModelSha]) { Fail(error, @"EMBEDDING_ARTIFACT_INVALID", @"Install the pinned BGE-small artifact"); return false; }
+    return true;
+}
+static void NativeFailure(NSError **error, char *nativeError) {
+    NSString *detail = nativeError ? [[NSString alloc] initWithUTF8String:nativeError] : nil;
+    Fail(error, @"EMBEDDING_BACKEND_UNAVAILABLE", detail ?: @"The fused encoder returned no diagnostic");
+    eliza_inference_free_string(nativeError);
+}
+
+@implementation ElizaBgeEncoder {
+    EliInferenceContext *_context;
+    NSInteger _contextLimit;
+}
++ (instancetype)openModel:(NSString *)modelPath contextSize:(NSInteger)size error:(NSError **)error {
+    if (size < 1 || size > 512) { Fail(error, @"EMBEDDING_CONTEXT_INVALID", @"BGE context size must be between 1 and 512"); return nil; }
+    if (!modelPath.isAbsolutePath || [modelPath rangeOfCharacterFromSet:[NSCharacterSet characterSetWithRange:NSMakeRange(0, 1)]].location != NSNotFound || !CompleteUtf8(modelPath, error)) {
+        Fail(error, @"EMBEDDING_ARTIFACT_INVALID", @"An absolute model path without NUL is required"); return nil;
+    }
+    const char *configured = getenv("ELIZA_EMBED_N_CTX");
+    if (configured && *configured) {
+        errno = 0; char *end = nullptr; long limit = strtol(configured, &end, 10);
+        if (errno || !end || *end || limit < 1 || limit > INT_MAX || configured[0] < '1' || configured[0] > '9') {
+            Fail(error, @"EMBEDDING_CONTEXT_INVALID", @"ELIZA_EMBED_N_CTX must be a positive integer"); return nil;
+        }
+        size = MIN(size, limit);
+    }
+    if (!VerifyArtifact(modelPath, error)) return nil;
+    NSFileManager *files = NSFileManager.defaultManager;
+    NSString *bundle = [modelPath stringByAppendingString:@".embedding.bundle"];
+    NSString *textDir = [bundle stringByAppendingPathComponent:@"text"];
+    NSError *fileError = nil;
+    if (![files createDirectoryAtPath:textDir withIntermediateDirectories:YES attributes:nil error:&fileError]) {
+        Fail(error, @"EMBEDDING_ARTIFACT_INVALID", fileError.localizedDescription); return nil;
+    }
+    NSString *target = [textDir stringByAppendingPathComponent:ModelName];
+    if (![files fileExistsAtPath:target] && ![files createSymbolicLinkAtPath:target withDestinationPath:modelPath error:&fileError]) {
+        Fail(error, @"EMBEDDING_ARTIFACT_INVALID", fileError.localizedDescription); return nil;
+    }
+    NSArray<NSString *> *entries = [files contentsOfDirectoryAtPath:textDir error:&fileError];
+    BOOL directory = NO;
+    if (entries.count != 1 || ![entries.firstObject isEqualToString:ModelName] || ![files fileExistsAtPath:target isDirectory:&directory] || directory) {
+        Fail(error, @"EMBEDDING_ARTIFACT_INVALID", @"The encoder bundle must contain only the pinned BGE file"); return nil;
+    }
+    if (!VerifyArtifact(target, error)) return nil;
+    ElizaBgeEncoder *encoder = [[self alloc] init];
+    encoder->_contextLimit = size;
+    char *nativeError = nullptr;
+    encoder->_context = eliza_inference_create(bundle.fileSystemRepresentation, &nativeError);
+    if (!encoder->_context) { NativeFailure(error, nativeError); return nil; }
+    eliza_inference_free_string(nativeError);
+    return encoder;
+}
+- (NSInteger)contextLimit { return _contextLimit; }
+- (NSArray<NSNumber *> *)tokenizeText:(NSString *)text error:(NSError **)error {
+    @synchronized(self) {
+        if (!_context) { Fail(error, @"EMBEDDING_CONTEXT_UNAVAILABLE", @"The encoder has been released"); return nil; }
+        NSData *bytes = CompleteUtf8(text, error); if (!bytes) return nil;
+        int *tokens = nullptr; size_t count = 0; char *nativeError = nullptr;
+        int code = eliza_inference_tokenize(_context, bytes.length ? (const char *)bytes.bytes : "", bytes.length, 1, 0, &tokens, &count, &nativeError);
+        if (code != ELIZA_OK || !tokens || count == 0) {
+            eliza_inference_free_tokens(tokens); NativeFailure(error, nativeError); return nil;
+        }
+        eliza_inference_free_string(nativeError);
+        NSMutableArray<NSNumber *> *result = [NSMutableArray arrayWithCapacity:count];
+        for (size_t i = 0; i < count; i++) [result addObject:@(tokens[i])];
+        eliza_inference_free_tokens(tokens);
+        return result;
+    }
+}
+- (NSDictionary<NSString *, id> *)embedText:(NSString *)text error:(NSError **)error {
+    @synchronized(self) {
+        NSArray<NSNumber *> *tokens = [self tokenizeText:text error:error]; if (!tokens) return nil;
+        if (tokens.count > (NSUInteger)_contextLimit) {
+            Fail(error, @"EMBEDDING_INPUT_TOO_LARGE", [NSString stringWithFormat:@"Complete input has %lu tokens; limit is %ld. Split it into explicit lossless chunks.", (unsigned long)tokens.count, (long)_contextLimit]); return nil;
+        }
+        NSData *bytes = CompleteUtf8(text, error); if (!bytes) return nil;
+        std::array<float, 384> vector; int dimension = 0; char *nativeError = nullptr;
+        int code = eliza_inference_embed(_context, bytes.length ? (const char *)bytes.bytes : "", bytes.length, ELIZA_POOLING_CLS, vector.data(), vector.size(), &dimension, &nativeError);
+        if (code != ELIZA_OK) { NativeFailure(error, nativeError); return nil; }
+        eliza_inference_free_string(nativeError);
+        if (dimension != 384) { Fail(error, @"EMBEDDING_VECTOR_INVALID", @"The BGE encoder returned an unexpected dimension"); return nil; }
+        double norm = 0;
+        for (float value : vector) { if (!std::isfinite(value)) { Fail(error, @"EMBEDDING_VECTOR_INVALID", @"The encoder returned a non-finite component"); return nil; } norm += (double)value * value; }
+        if (!(norm > 0) || !std::isfinite(norm)) { Fail(error, @"EMBEDDING_VECTOR_INVALID", @"The encoder returned an invalid norm"); return nil; }
+        norm = std::sqrt(norm);
+        NSMutableArray<NSNumber *> *values = [NSMutableArray arrayWithCapacity:dimension];
+        for (float value : vector) [values addObject:@(value / norm)];
+        return @{ @"embedding": values, @"tokens": @(tokens.count), @"n_embd": @(dimension), @"embeddingSpace": VectorSpace };
+    }
+}
+- (void)close {
+    @synchronized(self) { if (_context) eliza_inference_destroy(_context); _context = nullptr; }
+}
+- (void)dealloc { if (_context) eliza_inference_destroy(_context); }
+@end
