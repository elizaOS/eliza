{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@elizaos/ui": ["./packages/ui/src/index.ts"],
      "@elizaos/ui/*": ["./packages/ui/src/*"],
      "@elizaos/agent": ["./packages/agent/src/index.ts"],
      "@elizaos/agent/*": ["./packages/agent/src/*"],
      "@elizaos/app": ["./packages/app/src/index.ts"],
      "@elizaos/app/*": ["./packages/app/src/*"],
      "@elizaos/cloud-sdk": ["./packages/cloud/sdk/src/index.ts"],
      "@elizaos/cloud-sdk/*": ["./packages/cloud/sdk/src/*"],
      "@elizaos/core": ["./packages/core/src/index.ts"],
      "@elizaos/testing": ["./packages/testing/src/index.ts"],
      "@elizaos/core/*": ["./packages/core/src/*"],
      "@elizaos/plugin-agent-orchestrator": [
        "./plugins/plugin-agent-orchestrator/src/index.ts"
      ],
      "@elizaos/plugin-anthropic": ["./plugins/plugin-anthropic/index.ts"],
      "@elizaos/plugin-browser": ["./plugins/plugin-browser/src/index.ts"],
      "@elizaos/plugin-coding-tools": [
        "./plugins/plugin-coding-tools/src/index.ts"
      ],
      "@elizaos/plugin-computeruse": [
        "./plugins/plugin-computeruse/src/index.ts"
      ],
      "@elizaos/plugin-computeruse/mobile/*": [
        "./plugins/plugin-computeruse/src/mobile/*"
      ],
      "@elizaos/plugin-native-contacts": [
        "./plugins/plugin-native-contacts/src/index.ts"
      ],
      "@elizaos/plugin-discord": ["./plugins/plugin-discord/index.ts"],
      "@elizaos/plugin-elizacloud": [
        "./plugins/plugin-elizacloud/src/index.ts"
      ],
      "@elizaos/plugin-elizacloud/endpoint-config": [
        "./plugins/plugin-elizacloud/src/utils/config.ts"
      ],
      "@elizaos/plugin-imessage": ["./plugins/plugin-imessage/src/index.ts"],
      "@elizaos/plugin-personal-assistant": [
        "./plugins/plugin-personal-assistant/src/index.ts"
      ],
      "@elizaos/plugin-mcp": ["./plugins/plugin-mcp/src/index.ts"],
      "@elizaos/plugin-native-messages": [
        "./plugins/plugin-native-messages/src/index.ts"
      ],
      "@elizaos/plugin-openai": ["./plugins/plugin-openai/index.ts"],
      "@elizaos/plugin-native-phone": [
        "./plugins/plugin-native-phone/src/index.ts"
      ],
      "@elizaos/plugin-native-phone/*": ["./plugins/plugin-native-phone/src/*"],
      "@elizaos/plugin-sql": ["./plugins/plugin-sql/src/index.ts"],
      "@elizaos/plugin-agent-orchestrator/ui": [
        "./plugins/plugin-agent-orchestrator/src/ui/index.ts"
      ],
      "@elizaos/plugin-trajectory-logger": [
        "./plugins/plugin-trajectory-logger/src/index.ts"
      ],
      "@elizaos/plugin-video": ["./plugins/plugin-video/src/index.ts"],
      "@elizaos/plugin-wallet": ["./plugins/plugin-wallet/src/index.ts"],
      "@elizaos/plugin-native-wifi": [
        "./plugins/plugin-native-wifi/src/index.ts"
      ],
      "@elizaos/plugin-workflow": ["./plugins/plugin-workflow/src/index.ts"],
      "@elizaos/auth/auth": ["./packages/auth/src/auth/index.ts"],
      "@elizaos/auth/auth/*": ["./packages/auth/src/auth/*"],
      "@elizaos/auth/vault": ["./packages/auth/src/vault/index.ts"],
      "@elizaos/auth/vault/*": ["./packages/auth/src/vault/*"],
      "@elizaos/cloud-shared": ["./packages/cloud/shared/src/index.ts"],
      "@elizaos/cloud-shared/*": ["./packages/cloud/shared/src/*"],
      "@elizaos/plugin-wallet/*": ["./plugins/plugin-wallet/src/*"],
      "@elizaos/capacitor-agent": [
        "./plugins/plugin-native-agent/src/index.ts"
      ],
      "@elizaos/capacitor-appblocker": [
        "./plugins/plugin-native-appblocker/src/index.ts"
      ],
      "@elizaos/capacitor-secure-store": [
        "./plugins/plugin-native-secure-store/src/index.ts"
      ],
      "@elizaos/capacitor-bun-runtime": [
        "./plugins/plugin-native-bun-runtime/src/index.ts"
      ],
      "@elizaos/capacitor-calendar": [
        "./plugins/plugin-native-calendar/src/index.ts"
      ],
      "@elizaos/capacitor-camera": [
        "./plugins/plugin-native-camera/src/index.ts"
      ],
      "@elizaos/capacitor-canvas": [
        "./plugins/plugin-native-canvas/src/index.ts"
      ],
      "@elizaos/plugin-native-contacts/bridge": [
        "./plugins/plugin-native-contacts/src/bridge.ts"
      ],
      "@elizaos/capacitor-desktop": [
        "./plugins/plugin-native-desktop/src/index.ts"
      ],
      "@elizaos/capacitor-gateway": [
        "./plugins/plugin-native-gateway/src/index.ts"
      ],
      "@elizaos/capacitor-location": [
        "./plugins/plugin-native-location/src/index.ts"
      ],
      "@elizaos/plugin-native-messages/bridge": [
        "./plugins/plugin-native-messages/src/bridge.ts"
      ],
      "@elizaos/capacitor-mobile-signals": [
        "./plugins/plugin-native-mobile-signals/src/index.ts"
      ],
      "@elizaos/plugin-native-phone/bridge": [
        "./plugins/plugin-native-phone/src/bridge.ts"
      ],
      "@elizaos/capacitor-swabble": [
        "./plugins/plugin-native-swabble/src/index.ts"
      ],
      "@elizaos/capacitor-system": [
        "./plugins/plugin-native-system/src/index.ts"
      ],
      "@elizaos/capacitor-talkmode": [
        "./plugins/plugin-native-talkmode/src/index.ts"
      ],
      "@elizaos/capacitor-websiteblocker": [
        "./plugins/plugin-native-websiteblocker/src/index.ts"
      ],
      "@elizaos/plugin-native-wifi/bridge": [
        "./plugins/plugin-native-wifi/src/bridge.ts"
      ],
      "@elizaos/plugin-native-inference": [
        "./plugins/plugin-native-inference/src/index.ts"
      ],
      "@elizaos/plugin-native-inference/host-bridge": [
        "./plugins/plugin-native-inference/src/bridge.ts"
      ],
      "@elizaos/plugin-native-inference/*": [
        "./plugins/plugin-native-inference/src/*"
      ],
      "@elizaos/plugin-native-settings": [
        "./plugins/plugin-native-settings/src/index.ts"
      ],
      "@elizaos/plugin-local-inference": [
        "./plugins/plugin-local-inference/src/index.ts"
      ],
      "@elizaos/plugin-local-inference/runtime": [
        "./plugins/plugin-local-inference/src/runtime/index.ts"
      ],
      "@elizaos/plugin-local-inference/runtime/*": [
        "./plugins/plugin-local-inference/src/runtime/*"
      ]
    }
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/vendor/**",
    "vendor/**",
    "**/cypress/**",
    "**/*.cy.tsx",
    "**/*.cy.ts",
    "**/scripts/**",
    "plugins/plugin-lp-manager/**",
    "plugins/plugin-local-ai/**",
    "plugins/plugin-vision/**",
    "plugins/plugin-github/**",
    "plugins/plugin-wallet/src/chains/evm/**",
    "plugins/plugin-sql/**",
    "plugins/plugin-linear/**",
    "**/build.ts"
  ],
  "references": []
}
