{
  "compilerOptions": {
    "customConditions": ["eliza-source"],
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@elizaos/ui/*": ["./packages/ui/src/*"],
      "@elizaos/agent/*": ["./packages/agent/src/*"],
      "@elizaos/app": ["./packages/app/src/index.ts"],
      "@elizaos/app/*": ["./packages/app/src/*"],
      "@elizaos/cloud-sdk/*": ["./packages/cloud/sdk/src/*"],
      "@elizaos/core/*": ["./packages/core/src/*"],
      "@elizaos/plugin-computeruse/mobile/*": [
        "./plugins/plugin-computeruse/src/mobile/*"
      ],
      "@elizaos/plugin-elizacloud": [
        "./plugins/plugin-elizacloud/src/index.ts"
      ],
      "@elizaos/plugin-native-phone/*": ["./plugins/plugin-native-phone/src/*"],
      "@elizaos/plugin-trajectory-logger": [
        "./plugins/plugin-trajectory-logger/src/index.ts"
      ],
      "@elizaos/auth/auth/*": ["./packages/auth/src/auth/*"],
      "@elizaos/auth/vault/*": ["./packages/auth/src/vault/*"],
      "@elizaos/cloud-shared/*": ["./packages/cloud/shared/src/*"],
      "@elizaos/plugin-wallet/*": ["./plugins/plugin-wallet/src/*"],
      "@elizaos/capacitor-desktop": [
        "./plugins/plugin-native-desktop/src/index.ts"
      ],
      "@elizaos/plugin-native-inference/*": [
        "./plugins/plugin-native-inference/src/*"
      ],
      "@elizaos/plugin-native-settings": [
        "./plugins/plugin-native-settings/src/index.ts"
      ],
      "@elizaos/plugin-local-inference/runtime/*": [
        "./plugins/plugin-local-inference/src/runtime/*"
      ]
    }
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/vendor/**",
    "vendor/**",
    "**/cypress/**",
    "**/*.cy.tsx",
    "**/*.cy.ts",
    "**/scripts/**",
    "plugins/plugin-lp-manager/**",
    "plugins/plugin-local-ai/**",
    "plugins/plugin-vision/**",
    "plugins/plugin-github/**",
    "plugins/plugin-wallet/src/chains/evm/**",
    "plugins/plugin-sql/**",
    "plugins/plugin-linear/**",
    "**/build.ts"
  ],
  "references": []
}
