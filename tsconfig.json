{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vibestack",
    "gen/*.ts"
  ],
  "exclude": [
    "vibestack/examples",
