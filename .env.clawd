# Boot eliza as Clawd with monorepo skills.
# Loaded by: node scripts/start-eliza-clawd.mjs (sets ELIZA_AGENT_CHARACTER_PATH).
# Or: export $(grep -v '^#' .env.clawd | xargs) && bun run start

# Absolute path preferred; start script sets this to ../characters/clawd.json
ELIZA_AGENT_CHARACTER_PATH=../characters/clawd.json

# Skills live under managed state dir (symlinked by start script):
#   ~/.local/state/eliza/skills  →  ../skills/*
