        "$TURBO_ROOT$/packages/scripts/ensure-tsc-nested-output-dir.mjs",
        "$TURBO_ROOT$/packages/scripts/flatten-tsc-package-output.mjs",
        "$TURBO_ROOT$/packages/scripts/rm-path-recursive.mjs",
        "$TURBO_ROOT$/packages/scripts/lib/script-metadata.ts",
        "$TURBO_ROOT$/packages/scripts/lib/repo-root.ts",
        "$TURBO_ROOT$/packages/scripts/lib/rewrite-module-specifiers.mjs",
        "$TURBO_ROOT$/packages/scripts/rewrite-dist-relative-imports-node-esm.mjs"
