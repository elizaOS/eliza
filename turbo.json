{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "vibestack/*.ts",
    "vibestack/gen/**",
    "vibestack/proof/**",
    "vibestack/std/**",
    "vibestack/testing/**",
    "vibestack/stories/**",
    "vibestack/design/**",
    "!vibestack/**/{node_modules,.cache}/**",
    "!vibestack/selftest.ts",
    "!vibestack/remote-cache.ts",
    "!vibestack/{testing,stories,design}/test/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": [
        "generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "cache": false
    },
    "//#gen": {
      "inputs": [
        "spec/**",
        "apps/*/package.json",
        "packages/*/package.json",
        "package.json"
      ],
      "outputs": [
        "gen/**",
        "apps/*/gen/**",
        "packages/*/gen/**"
      ]
    },
    "//#build": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "inputs": [
        "*",
        "!*.md",
        "vibestack/**",
        "!vibestack/{examples,studio}/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "spec/**",
        "!spec/**/*.md",
        "src/**",
        "test/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "//#selftest:tools:a": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "apps/*/package.json",
        "packages/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "LICENSE",
        "spec/**",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": []
    },
    "//#selftest:tools:b": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "apps/*/package.json",
        "packages/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "LICENSE",
        "spec/**",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": []
    },
    "//#selftest:tools:rest": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "apps/*/package.json",
        "packages/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "LICENSE",
        "spec/**",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": []
    },
    "//#selftest:docs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.claude/worktrees/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**"
      ],
      "outputs": []
    },
    "//#selftest:examples": {
      "inputs": [
        "vibestack/**",
        "!vibestack/{studio,fixtures}/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "package.json"
      ],
      "outputs": []
    },
    "//#check": {
      "dependsOn": [
        "//#build",
        "//#typecheck",
        "//#test",
        "vibestack-studio#test",
        "@elizaos/core#build",
        "@elizaos/core#typecheck",
        "@elizaos/core#test"
      ],
      "cache": false
    },
    "//#lint:js": {
      "dependsOn": [
        "@repo/design-system#build",
        "@elizaos/core#typecheck",
        "vibestack-studio#typecheck"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "**/*.css",
        "!.claude/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "!vibestack/{examples,fixtures}/**",
        "stylelint.config.js",
        "package.json",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#analyze": {
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#dev": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#build": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vibestack-studio#typecheck": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/fixtures/**",
        "!$TURBO_ROOT$/vibestack/fixtures/**/.DS_Store"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ]
    },
    "vibestack-studio#test:browser": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": []
    },
    "@repo/ui#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/ui#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": [
        "generated/**"
      ]
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
