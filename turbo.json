{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "bun.lock",
    "bunfig.toml",
    "turbo.json",
    "tsconfig.json",
    "tsconfig.base.json",
    "plugins/tsconfig.build.shared.json"
  ],
  "globalEnv": [
    "BUN_PATH",
    "ELIZA_APP_ROOT",
    "ELIZA_CERT_QUEUE_HOST",
    "ELIZA_CLOUD_TEST_SHARD",
    "ELIZA_GPU_VISION_CACHE",
    "ELIZA_GPU_VISION_PORT",
    "ELIZA_RELEASE_REPO",
    "RELEASE_EVIDENCE_DIR",
    "SEARCHBENCH_CORPUS",
    "SEARCHBENCH_LATENCY_REPEATS",
    "TEST_LANE",
    "VITEST_LANE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["LOG_LEVEL"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "**/*.ts",
        "**/*.tsx",
        "!dist/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/__tests__/**",
        "index.ts",
        "index.node.ts",
        "index.browser.ts",
        "build.ts",
        "build.mjs",
        "build.config.ts",
        "scripts/**",
        "tsup.config.ts",
        "tsup.config.*.ts",
        "tsdown.config.ts",
        "vite.config.ts",
        "vite.config.*.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "assets/**",
        "public/**",
        "$TURBO_ROOT$/plugins/plugin-build.ts",
        "$TURBO_ROOT$/plugins/plugin-build-externals.ts",
        "$TURBO_ROOT$/plugins/tsup.plugin-packages.shared.ts",
        "$TURBO_ROOT$/packages/scripts/view-bundle-vite.config.ts",
        "$TURBO_ROOT$/packages/scripts/prepare-package-dist.mjs",
        "$TURBO_ROOT$/packages/scripts/copy-package-assets.mjs",
        "$TURBO_ROOT$/packages/scripts/ensure-tsc-nested-output-dir.mjs",
        "$TURBO_ROOT$/packages/scripts/flatten-tsc-package-output.mjs",
        "$TURBO_ROOT$/packages/scripts/rm-path-recursive.mjs",
        "$TURBO_ROOT$/packages/scripts/lib/script-metadata.ts",
        "$TURBO_ROOT$/packages/scripts/lib/workspaces.ts",
        "$TURBO_ROOT$/packages/scripts/lib/repository-file-integrity.mjs",
        "$TURBO_ROOT$/packages/scripts/lib/repo-root.ts",
        "$TURBO_ROOT$/packages/scripts/lib/rewrite-module-specifiers.mjs",
        "$TURBO_ROOT$/packages/scripts/rewrite-dist-relative-imports-node-esm.mjs"
      ]
    },
    "@elizaos/app#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/scripts/lib/workspaces.ts",
        "$TURBO_ROOT$/packages/scripts/lib/repository-file-integrity.mjs",
        "$TURBO_ROOT$/plugins/plugin-native-bun-runtime/engine/scripts/ios-app-store-runtime-policy.mjs"
      ],
      "dependsOn": ["^build"],
      "env": [
        "LOG_LEVEL",
        "ELIZA_BUILD_STAMP",
        "ELIZA_BUILD_VARIANT",
        "ELIZA_RELEASE_AUTHORITY",
        "VITE_ENVIRONMENT"
      ],
      "outputs": ["dist/**", "web-dist/**"]
    },
    "@elizaos/cloud-api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@elizaos/ui#build": {
      "dependsOn": [
        "@elizaos/core#build",
        "@elizaos/shared#build",
        "@elizaos/capacitor-secure-store#build"
      ],
      "env": ["LOG_LEVEL"],
      "outputs": ["dist/**"]
    },
    "@elizaos/cloud-routing#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@elizaos/electrobun#build": {
      "dependsOn": ["@elizaos/app#build:dist", "^build"],
      "cache": false,
      "outputs": []
    },
    "@elizaos/plugin-sql#build": {
      "dependsOn": ["@elizaos/core#build", "@elizaos/shared#build"],
      "outputs": ["dist/**"]
    },
    "@elizaos/plugin-assistant#build": {
      "dependsOn": ["@elizaos/core#build", "@elizaos/shared#build"],
      "outputs": ["dist/**"]
    },
    "@elizaos/native-activity-tracker#build": {
      "dependsOn": ["@elizaos/core#build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": []
    },
    "@elizaos/capacitor-gateway#lint": {
      "env": ["DEVELOPER_DIR"],
      "outputs": [],
      "dependsOn": []
    },
    "@elizaos/capacitor-gateway#lint:check": {
      "env": ["DEVELOPER_DIR"],
      "outputs": [],
      "dependsOn": []
    },
    "@elizaos/ui#lint:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**/*.ts",
        "$TURBO_ROOT$/packages/**/*.tsx",
        "$TURBO_ROOT$/packages/**/*.js",
        "$TURBO_ROOT$/packages/**/*.jsx",
        "$TURBO_ROOT$/plugins/**/*.ts",
        "$TURBO_ROOT$/plugins/**/*.tsx",
        "$TURBO_ROOT$/plugins/**/*.js",
        "$TURBO_ROOT$/plugins/**/*.jsx"
      ],
      "outputs": [],
      "dependsOn": []
    },
    "lint:check": {
      "outputs": [],
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@elizaos/core#typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "@elizaos/agent#typecheck": {
      "dependsOn": [
        "@elizaos/core#build",
        "@elizaos/shared#build",
        "@elizaos/ui#build",
        "@elizaos/plugin-inbox#build",
        "@elizaos/plugin-wallet#build",
        "@elizaos/plugin-sql#build",
        "@elizaos/plugin-agent-orchestrator#build",
        "@elizaos/plugin-video#build"
      ],
      "outputs": []
    },
    "@elizaos/app#typecheck": {
      "dependsOn": [
        "@elizaos/app#build:dist",
        "@elizaos/plugin-browser#build",
        "@elizaos/plugin-personal-assistant#build",
        "@elizaos/ui#build"
      ],
      "outputs": []
    },
    "@elizaos/cloud-api#typecheck": {
      "dependsOn": ["@elizaos/cloud-shared#typecheck"],
      "outputs": []
    },
    "@elizaos/cloud-shared#typecheck": {
      "dependsOn": [
        "@elizaos/auth#build",
        "@elizaos/plugin-assistant#build",
        "@elizaos/plugin-sqlite#build",
        "@elizaos/plugin-scheduling#build",
        "@elizaos/plugin-todos#build",
        "@elizaos/plugin-web-search#build"
      ],
      "outputs": []
    },
    "@elizaos/plugin-discord#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@elizaos/plugin-relationships#typecheck": {
      "dependsOn": ["^build", "@elizaos/plugin-sql#build"],
      "outputs": []
    },
    "@elizaos/plugin-scheduling#typecheck": {
      "dependsOn": ["^build", "@elizaos/plugin-sql#build"],
      "outputs": []
    },
    "@elizaos/plugin-calendar#typecheck": {
      "dependsOn": ["@elizaos/ui#build", "@elizaos/plugin-scheduling#build"],
      "outputs": []
    },
    "@elizaos/plugin-personal-assistant#typecheck": {
      "dependsOn": [
        "@elizaos/agent#build",
        "@elizaos/plugin-blocker#build",
        "@elizaos/plugin-calendar#build",
        "@elizaos/plugin-goals#build",
        "@elizaos/plugin-health#build",
        "@elizaos/plugin-inbox#build",
        "@elizaos/plugin-pdf#build",
        "@elizaos/plugin-reminders#build",
        "@elizaos/plugin-x#build",
        "@elizaos/capacitor-mobile-signals#build",
        "@elizaos/macosreminders#build",
        "@elizaos/native-activity-tracker#build",
        "@elizaos/app#build:dist"
      ],
      "outputs": []
    },
    "@elizaos/plugin-vision#typecheck": {
      "dependsOn": ["@elizaos/plugin-computeruse#build"],
      "outputs": []
    },
    "@elizaos/plugin-native-contacts#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@elizaos/plugin-native-inference#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "outputs": [],
      "dependsOn": []
    },
    "format:check": {
      "outputs": [],
      "dependsOn": []
    },
    "start": {
      "dependsOn": ["@elizaos/core#build"],
      "env": ["LOG_LEVEL"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["@elizaos/core#build"],
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "dependsOn": ["@elizaos/core#build"],
      "cache": false
    },
    "migrate:generate": {
      "dependsOn": ["@elizaos/core#build"],
      "cache": false
    },
    "clean": {
      "cache": false,
      "dependsOn": []
    },
    "@elizaos/core#build": {
      "dependsOn": [],
      "env": ["LOG_LEVEL"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ]
    },
    "@elizaos/app#build:dist": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/scripts/lib/workspaces.ts",
        "$TURBO_ROOT$/packages/scripts/lib/repository-file-integrity.mjs",
        "$TURBO_ROOT$/plugins/plugin-native-bun-runtime/engine/scripts/ios-app-store-runtime-policy.mjs"
      ],
      "dependsOn": [
        "@elizaos/core#build",
        "@elizaos/agent#build",
        "@elizaos/shared#build",
        "@elizaos/ui#build"
      ],
      "env": [
        "LOG_LEVEL",
        "ELIZA_BUILD_STAMP",
        "ELIZA_BUILD_VARIANT",
        "ELIZA_RELEASE_AUTHORITY",
        "VITE_ENVIRONMENT"
      ],
      "outputs": ["dist/**"]
    },
    "@elizaos/lifeops-bench#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@elizaos/testing#typecheck": {
      "dependsOn": ["@elizaos/plugin-browser#build", "^build"],
      "outputs": []
    }
  }
}
