    "start": {
      "dependsOn": ["@elizaos/core#build"],
      "env": ["LOG_LEVEL"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["@elizaos/core#build"],
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "dependsOn": ["@elizaos/core#build"],
      "cache": false
    },
    "migrate:generate": {
      "dependsOn": ["@elizaos/core#build"],
      "cache": false
    },
    "clean": {
      "cache": false,
      "dependsOn": []
    },
    "@elizaos/core#build": {
      "dependsOn": [],
      "env": ["LOG_LEVEL"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
