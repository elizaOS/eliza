{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "QUINT_HOME",
    "VITEST_MAX_WORKERS"
  ],
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "vibestack/*.ts",
    "vibestack/gen/**",
    "vibestack/proof/**",
    "vibestack/std/**",
    "vibestack/testing/**",
    "vibestack/stories/**",
    "vibestack/design/**",
    "!vibestack/**/{node_modules,.cache}/**",
    "!vibestack/selftest.ts",
    "!vibestack/remote-cache.ts",
    "!vibestack/proof/lib.dfy",
    "!vibestack/{testing,stories,design}/test/**",
    ".cache/toolchain.json"
  ],
  "tasks": {
    "gen": {
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "@repo/ui#gen": {
      "dependsOn": [
        "//#gen"
      ],
      "outputs": [
        "generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "generated/**",
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build",
        "build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "test": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "gen",
        "//#gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser"
      ],
      "cache": false
    },
    "vibestack-studio#check": {
      "dependsOn": [
        "build",
        "typecheck",
        "test",
        "test:browser",
        "//#build"
      ],
      "cache": false
    },
    "//#gen": {
      "env": [
        "!VITE_*"
      ],
      "inputs": [
        "spec/**",
        "apps/*/package.json",
        "apps/*/spec/**",
        "packages/*/package.json",
        "packages/*/spec/**",
        "package.json"
      ],
      "outputs": [
        "gen/**",
        "apps/*/gen/**",
        "packages/*/gen/**"
      ]
    },
    "//#build": {
      "dependsOn": [
        "vibestack-studio#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!vibestack/fixtures/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#typecheck": {
      "dependsOn": [
        "//#gen",
        "//#build"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "tsconfig.json",
        "spec/**",
        "src/**",
        "test/**"
      ],
      "outputs": []
    },
    "//#test": {
      "dependsOn": [
        "//#gen",
        "^build"
      ],
      "inputs": [
        "*",
        "!.git",
        "!*.md",
        "vibestack/**",
        "!vibestack/{examples,studio}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "spec/**",
        "!spec/**/*.md",
        "src/**",
        "test/**"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:a": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "eslint.config.js",
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:b": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!vibestack/{studio,examples}/**/gen/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:tools:rest": {
      "dependsOn": [
        "//#build",
        "//#test",
        "vibestack-studio#typecheck",
        "vibestack-studio#test",
        "vibestack-studio#test:browser"
      ],
      "inputs": [
        ".gitignore",
        "vibestack/**",
        "!vibestack/examples/{assistant,dashboard,fullstack}/**",
        "!vibestack/selftests/{docs,examples}.ts",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "patches/**",
        "apps/*/package.json",
        "packages/**",
        ".agents/**",
        "AGENTS.md",
        "SPEC.md",
        "README.md",
        "LICENSE",
        "spec/**",
        "package.json",
        "pnpm-lock.yaml",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "//#selftest:docs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.claude/worktrees/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**"
      ],
      "outputs": []
    },
    "//#selftest:examples": {
      "inputs": [
        "vibestack/**",
        "!vibestack/selftest.ts",
        "!vibestack/selftests/{docs,tools}.ts",
        "!vibestack/{studio,fixtures}/**",
        "!vibestack/{testing,stories,design}/test/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static,__traces__}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio,vibestack/examples}/**/gen/**",
        "package.json"
      ],
      "outputs": [
        "vibestack/examples/*/.spec-cache/tests-*.json.{gz,zst}"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
