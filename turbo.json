        "@elizaos/plugin-native-wifi#typecheck",
        "@elizaos/plugin-network#typecheck",
        "@elizaos/plugin-openai#typecheck",
        "@elizaos/plugin-pdf#typecheck",
        "@elizaos/plugin-pty#typecheck",
        "@elizaos/plugin-relationships#typecheck",
        "@elizaos/plugin-reminders#typecheck",
        "@elizaos/plugin-scheduling#typecheck",
        "@elizaos/plugin-slack#typecheck",
        "@elizaos/plugin-sql#typecheck",
        "@elizaos/plugin-sqlite#typecheck",
        "@elizaos/plugin-telegram#typecheck",
        "@elizaos/plugin-todos#typecheck",
        "@elizaos/plugin-trajectory-logger#typecheck",
        "@elizaos/plugin-video#typecheck",
        "@elizaos/plugin-vision#typecheck",
        "@elizaos/plugin-wallet#typecheck",
        "@elizaos/plugin-wallet-client#typecheck",
        "@elizaos/plugin-web-search#typecheck",
        "@elizaos/plugin-x#typecheck"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts"
      ],
      "outputs": []
    },
    "//#lint:css": {
      "inputs": [
        "**/*.css",
        "!.claude/**",
        "!packages/os/android/**/build/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "!vibestack/{examples,fixtures}/**",
        "stylelint.config.js",
        "package.json",
        "pnpm-workspace.yaml"
      ],
      "outputs": []
    },
    "//#analyze": {
      "dependsOn": [
        "//#gen",
        "@repo/design-system#build",
        "@repo/ui#gen",
        "vibestack-studio#gen"
      ],
      "inputs": [
        "apps/**",
        "packages/**",
        "vibestack/**",
        "!vibestack/examples/**",
        "!**/{node_modules,dist,.vibe,.cache,.spec-cache,.turbo,generated,storybook-static}/**",
        "!**/.DS_Store",
        "!{apps,packages,vibestack/studio}/**/gen/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "*.config.js",
        "*.config.ts",
        ".madgerc",
        ".jscpd.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#studio": {
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#gen": {
      "env": [
        "!VITE_*"
      ],
      "outputs": [
        "gen/**",
        "generated/**"
      ]
    },
    "vibestack-studio#dev": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "vibestack-studio#build": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vibestack-studio#typecheck": {
      "dependsOn": [
        "gen",
        "^build",
        "build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "vibestack-studio#test": {
      "dependsOn": [
        "gen",
        "^build",
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vibestack/fixtures/**",
        "$TURBO_ROOT$/vibestack/proof/lib.dfy",
        "!$TURBO_ROOT$/vibestack/fixtures/**/.DS_Store"
      ],
      "outputs": [
        ".cache/test-result-*.json"
      ],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "vibestack-studio#test:browser": {
      "dependsOn": [
        "gen",
        "^build"
      ],
      "outputs": [],
      "env": [
        "VIBESTACK_QUINT_EVALUATOR"
      ]
    },
    "@repo/ui#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "package.json",
        "src/**",
        "styles.css",
        "tsconfig.json"
      ],
      "outputs": []
    },
    "@repo/ui#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".vibe/declarations/**"
      ]
    },
    "@repo/design-system#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "design.md"
      ]
    }
  },
  "remoteCache": {
    "apiUrl": "https://vibestack-turbo-cache.shawmakesmagic.workers.dev",
    "enabled": true,
    "timeout": 10,
    "uploadTimeout": 60,
    "teamSlug": "vibestack"
  }
}
