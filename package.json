  "specCompanions": {
    "agent": ["packages/agent-host"],
    "cloud": ["packages/cloud-worker"],
    "core": ["packages/core-node"],
    "files": ["packages/plugin-files-client"],
    "inbox": ["packages/plugin-inbox-client"],
    "localInference": ["packages/plugin-localinference-client"],
    "maps": ["packages/plugin-maps-client"],
    "notes": ["packages/plugin-notes-client"],
    "os": ["packages/os-bridges"],
    "workflow": ["packages/plugin-workflow-client", "packages/plugin-workflow-worker"]
  },
  "scripts": {
    "dev": "turbo run dev //#studio",
    "studio": "node vibestack/spec.ts studio",
    "check": "node --import ./vibestack/ci-check-phase.ts vibestack/spec.ts check",
    "gen": "node vibestack/spec.ts gen",
    "accept": "node vibestack/spec.ts accept",
    "new": "node vibestack/spec.ts new",
    "demo": "pnpm -C vibestack/examples/order demo",
    "selftest": "node vibestack/spec.ts tasks //#selftest:tools:a //#selftest:tools:b //#selftest:tools:rest //#selftest:docs //#selftest:examples",
    "selftest:tools:a": "node --test --test-name-pattern=\"^the tools each check catches its own kind of mistake in shard a \" vibestack/selftest.ts",
    "selftest:tools:b": "node --test --test-name-pattern=\"^the tools each check catches its own kind of mistake in shard b \" vibestack/selftest.ts",
    "selftest:tools:rest": "node --test --test-skip-pattern=\"^the tools each check catches its own kind of mistake in shard [ab] \" vibestack/selftest.ts",
    "selftest:docs": "node --test --test-name-pattern=\"^the documents name what exists \" vibestack/selftests/docs.ts",
    "selftest:examples": "node --test --test-name-pattern=\"^the standalone examples \" vibestack/selftests/examples.ts",
    "build": "node vibestack/spec.ts tasks vibestack-studio#build && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && vibelang -p tsconfig.build.json && node -e \"fs.chmodSync('dist/spec.js', 0o755); fs.mkdirSync('dist/proof', { recursive: true }); fs.copyFileSync('vibestack/proof/lib.dfy', 'dist/proof/lib.dfy'); fs.cpSync('vibestack/std', 'dist/std', { recursive: true }); fs.copyFileSync('vibestack/conformance.ts', 'dist/conformance.ts')\" && node vibestack/studio/pack-page.ts",
    "pnpm:devPreinstall": "node vibestack/skill-links.ts",
    "prepare": "node vibestack/spec.ts gen --install --skip-gen-on-pack //#build",
    "prepack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:browser": "node vibestack/spec.ts tasks test:browser",
    "test:models": "node vibestack/spec.ts tasks check",
    "typecheck": "vibelang --noEmit -p tsconfig.json",
    "lint": "node vibestack/spec.ts tasks //#lint:js //#lint:css",
    "lint:js": "NODE_OPTIONS=--max-old-space-size=8192 node eslint.config.js",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "analyze": "knip && madge --circular vibestack packages && jscpd .",
    "quick": "node vibestack/spec.ts tasks typecheck test //#lint:js //#lint:css",
    "verify": "node vibestack/spec.ts tasks build typecheck test test:browser check //#lint:js //#lint:css //#analyze //#selftest:tools:a //#selftest:tools:b //#selftest:tools:rest //#selftest:docs //#selftest:examples",
    "all": "node vibestack/spec.ts tasks"
  },
  "version": "0.1.0",
  "description": "Eliza core specifications and models on the Vibestack toolchain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elizaOS/eliza.git"
  },
  "homepage": "https://github.com/elizaOS/eliza#readme",
  "bugs": "https://github.com/elizaOS/eliza/issues",
  "keywords": [
    "formal-verification",
    "quint",
    "dafny",
    "typescript",
    "specification",
    "state-machine",
    "ai-agents"
  ],
  "bin": {
    "spec": "dist/spec.js"
  },
  "files": [
    "dist",
    ".agents/skills",
    "vibestack/reference/typereferences.md",
    ".agents/claude-settings.json",
    "README.md",
    "AGENTS.md",
    "SPEC.md",
    "LICENSE"
  ],
  "dependencies": {
    "@antithesishq/bombadil": "0.7.10",
