    "clean": "node packages/scripts/run-turbo.mjs run clean --concurrency=100% && node packages/scripts/rm-path-recursive.mjs dist .turbo .turbo-tsconfig.json tsconfig.tsbuildinfo",
    "reset": "bun run clean && node packages/scripts/rm-path-recursive.mjs node_modules && bun install && bun run build",
