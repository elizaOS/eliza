    "cloud:group-room-sim": "bun packages/cloud/scripts/group-room-sim/run-room-sim.ts",
    "test:live": "TEST_LANE=post-merge node packages/scripts/run-all-tests.mjs --all --no-cloud --require-work",
    "test:e2e": "TEST_LANE=pr node packages/scripts/run-all-tests.mjs --only=e2e --no-cloud --require-work --exclude packages/app-core/test/app/memory-relationships.real.e2e.test.ts --exclude packages/app-core/test/app/qa-checklist.real.e2e.test.ts",
