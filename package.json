    "audit:design:update-baseline": "node packages/scripts/design-doctor-gate.mjs --update-baseline",
    "audit:type-duplication": "node packages/scripts/type-duplication-audit.mjs",
    "test:desktop:packaged": "bun run --cwd packages/app test:desktop:packaged",
    "test:desktop:packaged:windows": "bun run --cwd packages/app test:desktop:packaged:windows",
    "start": "bun run --cwd packages/agent start",
    "start:eliza": "bun --conditions=eliza-source packages/app-core/src/entry.ts start",
    "dev:prepare": "bun packages/scripts/run-turbo.mjs run build --filter=@elizaos/app... --filter=!@elizaos/app",
