    "test:dev-startup": "node packages/app-core/scripts/dev-startup-smoke.mjs",
    "test:hmr": "bun run --cwd packages/app test:hmr",
    "build:core": "node packages/scripts/build-core.mjs",
    "lint": "node packages/scripts/run-turbo.mjs run lint",
    "lint:check": "node packages/scripts/run-turbo.mjs run lint:check",
    "knip": "NODE_OPTIONS='--max-old-space-size=16384' knip --no-progress --no-exit-code",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' node packages/scripts/run-turbo.mjs run typecheck --concurrency=8",
    "audit:scripts:inventory": "node packages/scripts/audit-scripts-inventory.mjs",
    "verify": "bun run check:agents-claude && node packages/scripts/check-biome-version-consistency.mjs && bun run check:i18n && node packages/scripts/check-generated-system-files.mjs && node packages/cloud/shared/scripts/check-migration-prefix-order.mjs && node packages/scripts/ci-bun-version-contract.mjs && node packages/scripts/ci-turbo-cache-contract.mjs && bun run fix-deps:check && bun packages/scripts/ensure-plugin-test-conventions.mjs --check && node packages/scripts/alias-read-guard.mjs && node packages/scripts/audit-tsconfig-workspace-resolution.mjs && node packages/scripts/verify-publish-graph.mjs && NODE_OPTIONS='--max-old-space-size=8192' node packages/scripts/run-turbo.mjs run typecheck lint:check --concurrency=8 && node packages/scripts/audit-build-typecheck.mjs && node packages/scripts/audit-turbo-build-deps.mjs && node packages/scripts/audit-tee-secret-leak.mjs && node packages/scripts/hetzner-fleet-routing-contract.mjs && node packages/scripts/workflow-trigger-policy.mjs && node packages/scripts/audit-scripts.mjs && node packages/scripts/audit-test-lane-membership.mjs && node packages/scripts/audit-view-bundle-inventory.mjs && node packages/scripts/audit-plugin-view-inventory.mjs && node packages/scripts/audit-focused-skipped-tests.mjs",
