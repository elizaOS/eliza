# Local development and optional live-test configuration.
# Copy to .env (or .env.test for tests), then uncomment only what you need.
# Keep credentials in local files, never in this template.
# Package-specific configuration belongs in the owning package's README/template.

# Server and storage overrides; leave unset to use the host defaults.
# NODE_ENV=development
# SERVER_PORT=3000
# ELIZA_UI_ENABLE=
# POSTGRES_URL=
# PGLITE_DATA_DIR=
# ELIZA_DATA_DIR=
# ELIZA_DATABASE_DIR=

# Model providers: configure only the providers you use.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# OLLAMA_API_ENDPOINT=
# ELEVENLABS_API_KEY=

# Tests default to the deterministic PR lane without paid provider keys.
# TEST_LANE=pr
# ELIZA_LIVE_TEST=0
# SCENARIO_USE_DETERMINISTIC_MODEL=1
# For live tests, use bun run test:live or explicitly select the live lane:
# TEST_LANE=post-merge
# ELIZA_LIVE_TEST=1
# ELIZA_REAL_APIS=1
# SCENARIO_USE_DETERMINISTIC_MODEL=0

# Optional live connector credentials and test destinations.
# DISCORD_BOT_TOKEN=
# DISCORD_TEST_GUILD_ID=
# SLACK_BOT_TOKEN=
# SLACK_TEST_CHANNEL_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_TEST_CHAT_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# X_BEARER_TOKEN=

# Productivity / SaaS
# GITHUB_TOKEN=
# LINEAR_API_KEY=
# CALENDLY_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Social / web3
# BLUESKY_PASSWORD=
# FARCASTER_NEYNAR_API_KEY=
# SHOPIFY_API_KEY=
# HYPERLIQUID_PRIVATE_KEY=
# POLYMARKET_API_KEY=

# Optional remote coding runner: eliza-cloud or home.
# ELIZA_CODING_REMOTE_RUNNER=

# Shared sandbox settings
# ELIZA_SANDBOX_WORKDIR=
# ELIZA_SANDBOX_HOST_WORKSPACE_ROOT=
# ELIZA_SANDBOX_AGENT_RUNNERS=

# Eliza Cloud sandbox runner
# ELIZA_CLOUD_SANDBOX_API_BASE_URL=
# ELIZA_CLOUD_SANDBOX_BASE_URL=
# ELIZA_CLOUD_SANDBOX_TOKEN=
# ELIZA_CLOUD_SANDBOX_ACCESS_URL=
# ELIZA_CLOUD_SANDBOX_IMAGE=

# Home Remote runner
# ELIZA_HOME_REMOTE_RUNNER_URL=
# ELIZA_HOME_REMOTE_RUNNER_TOKEN=
# ELIZA_HOME_REMOTE_RUNNER_ACCESS_URL=

# Optional home SSH tunnel metadata for Settings copy button
# ELIZA_HOME_REMOTE_RUNNER_SSH_TARGET=
# ELIZA_HOME_REMOTE_RUNNER_SSH_IDENTITY=
# ELIZA_HOME_REMOTE_RUNNER_SSH_LOCAL_PORT=

# CODEX_BIN=
