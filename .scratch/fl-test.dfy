function enabled(current: SignIn, event: Event): bool
{
  match event {
    case load(i_event_registration, i_event_build) =>
      canLoad(current)
    case start(i_event_environment, i_event_method, i_event_readiness, i_event_device) =>
      canStart(current, i_event_environment, i_event_method, i_event_readiness, i_event_device)
    case unchanged_ =>
      true
    case verify(i_event_attempt) =>
      canVerify(current, i_event_attempt)
    case cloudAnswered(i_event_attempt, i_event_reply) =>
      canCloudAnswered(current, i_event_attempt, i_event_reply)
    case exchangeSettled(i_event_credentialAttempt, i_event_key) =>
      canExchangeSettled(current, i_event_credentialAttempt, i_event_key)
    case pickerAnswered(i_event_attempt, i_event_picked) =>
      canPickerAnswered(current, i_event_attempt, i_event_picked)
    case googleConnected(i_event_attempt, i_event_connected) =>
      canGoogleConnected(current, i_event_attempt, i_event_connected)
    case resend(i_event_attempt) =>
      canResend(current, i_event_attempt)
    case cancel(i_event_attempt) =>
      canCancel(current, i_event_attempt)
    case expire(i_event_attempt) =>
      canExpire(current, i_event_attempt)
    case reauthenticate(i_event_environment, i_event_method, i_event_readiness, i_event_device, i_event_account) =>
      canReauthenticate(current, i_event_environment, i_event_method, i_event_readiness, i_event_device, i_event_account)
  }
}

function step(current: SignIn, event: Event): SignInStep
  requires inv(current)
{
  match event {
    case load(i_event_registration, i_event_build) =>
      if canLoad(current) then
        SignInStep(load(current, i_event_registration, i_event_build), [])
      else
        SignInStep(current, [])
    case start(i_event_environment, i_event_method, i_event_readiness, i_event_device) =>
      if canStart(current, i_event_environment, i_event_method, i_event_readiness, i_event_device) then
        SignInStep(start(current, i_event_environment, i_event_method, i_event_readiness, i_event_device), [])
      else
        SignInStep(current, [])
    case unchanged_ =>
      unchanged_(current)
    case verify(i_event_attempt) =>
      if canVerify(current, i_event_attempt) then
        SignInStep(verify(current, i_event_attempt), [])
      else
        SignInStep(current, [])
    case cloudAnswered(i_event_attempt, i_event_reply) =>
      if canCloudAnswered(current, i_event_attempt, i_event_reply) then
        cloudAnswered(current, i_event_attempt, i_event_reply)
      else
        SignInStep(current, [])
    case exchangeSettled(i_event_credentialAttempt, i_event_key) =>
      if canExchangeSettled(current, i_event_credentialAttempt, i_event_key) then
        exchangeSettled(current, i_event_credentialAttempt, i_event_key)
      else
        SignInStep(current, [])
    case pickerAnswered(i_event_attempt, i_event_picked) =>
      if canPickerAnswered(current, i_event_attempt, i_event_picked) then
        pickerAnswered(current, i_event_attempt, i_event_picked)
      else
        SignInStep(current, [])
    case googleConnected(i_event_attempt, i_event_connected) =>
      if canGoogleConnected(current, i_event_attempt, i_event_connected) then
        googleConnected(current, i_event_attempt, i_event_connected)
      else
        SignInStep(current, [])
    case resend(i_event_attempt) =>
      if canResend(current, i_event_attempt) then
        SignInStep(resend(current, i_event_attempt), [])
      else
        SignInStep(current, [])
    case cancel(i_event_attempt) =>
      if canCancel(current, i_event_attempt) then
        cancel(current, i_event_attempt)
      else
        SignInStep(current, [])
    case expire(i_event_attempt) =>
      if canExpire(current, i_event_attempt) then
        SignInStep(expire(current, i_event_attempt), [])
      else
        SignInStep(current, [])
    case reauthenticate(i_event_environment, i_event_method, i_event_readiness, i_event_device, i_event_account) =>
      if canReauthenticate(current, i_event_environment, i_event_method, i_event_readiness, i_event_device, i_event_account) then
        SignInStep(reauthenticate(current, i_event_environment, i_event_method, i_event_readiness, i_event_device, i_event_account), [])
      else
        SignInStep(current, [])
