lemma step_ensures(current: SignIn, event: Event)
  requires inv(current)
  ensures inv(step(current, event).state)
{
  hide *;
  reveal step, inv;
  match event {
    case load(i_registration, i_build) => load_ensures(current, i_registration, i_build);
    case start(i_environment, i_method, i_readiness, i_device) => start_ensures(current, i_environment, i_method, i_readiness, i_device);
    case unchanged_ => unchanged_ensures(current);
    case verify(i_attempt) => verify_ensures(current, i_attempt);
    case cloudAnswered(i_attempt, i_reply) => cloudAnswered_ensures(current, i_attempt, i_reply);
    case exchangeSettled(i_credentialAttempt, i_key) => exchangeSettled_ensures(current, i_credentialAttempt, i_key);
    case pickerAnswered(i_attempt, i_picked) => pickerAnswered_ensures(current, i_attempt, i_picked);
    case googleConnected(i_attempt, i_connected) => googleConnected_ensures(current, i_attempt, i_connected);
    case resend(i_attempt) => resend_ensures(current, i_attempt);
    case cancel(i_attempt) => cancel_ensures(current, i_attempt);
    case expire(i_attempt) => expire_ensures(current, i_attempt);
    case reauthenticate(i_environment, i_method, i_readiness, i_device, i_account) => reauthenticate_ensures(current, i_environment, i_method, i_readiness, i_device, i_account);
  }
}

