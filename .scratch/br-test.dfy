  ensures (inv(s) ==> alwaysRecordNamesAReservedGeneration(processRestarted(s)))
  ensures (inv(s) ==> alwaysWaitingAttemptHoldsItsLiveRecord(processRestarted(s)))
  ensures (inv(s) ==> alwaysHandedReturnRunsUnderTheNewestGeneration(processRestarted(s)))
  ensures (inv(s) ==> alwaysUnconfirmedRetirementBlocksExchange(processRestarted(s)))
  ensures (inv(s) ==> stepHandOffOnlyForTheBoundLiveRecord(s, processRestarted(s)))
  ensures (inv(s) ==> stepSignInLinksNeverReachTheRenderer(s, "processRestarted", processRestarted(s)))
{
}

function canRetired(s: BrowserReturns, burn: BurnOutcome): bool
{
  (s.retirement.RetirementUnconfirmed? && s.attempt.NoBrowserAttempt?)
}

function retired(s: BrowserReturns, burn: BurnOutcome): BrowserReturns
{
  if burn.Burned? then
    s.(record := PendingRecord.NoRecord, retirement := Retirement.RetirementSettled)
  else
    s
}

lemma retired_ensures(s: BrowserReturns, burn: BurnOutcome)
  ensures (inv(s) ==> canRetired(s, burn) ==> alwaysRecordNamesAReservedGeneration(retired(s, burn)))
  ensures (inv(s) ==> canRetired(s, burn) ==> alwaysWaitingAttemptHoldsItsLiveRecord(retired(s, burn)))
  ensures (inv(s) ==> canRetired(s, burn) ==> alwaysHandedReturnRunsUnderTheNewestGeneration(retired(s, burn)))
  ensures (inv(s) ==> canRetired(s, burn) ==> alwaysUnconfirmedRetirementBlocksExchange(retired(s, burn)))
  ensures (inv(s) ==> canRetired(s, burn) ==> stepHandOffOnlyForTheBoundLiveRecord(s, retired(s, burn)))
  ensures (inv(s) ==> canRetired(s, burn) ==> stepSignInLinksNeverReachTheRenderer(s, "retired", retired(s, burn)))
{
}

function alwaysUnconfirmedRetirementBlocksExchange(s: BrowserReturns): bool
{
  (!(s.retirement.RetirementUnconfirmed?) || (s.attempt.NoBrowserAttempt? && (!s.record.NoRecord?)))
}

function sometimesUnconfirmedBurnKeptRecord(s: BrowserReturns): bool
{
  (s.retirement.RetirementUnconfirmed? && (pendingOf(s.record).generation == s.credential.generation))
}

function sameValues(a: seq<string>, b: seq<string>): bool
{
  (!((exists set_x :: set_x in a && !((set_x in b)))) && !((exists set_x :: set_x in b && !((set_x in a)))))
}

function callbackFilterAdmits(f: CallbackFilter, host: string, path: string): bool
{
  ((((((f.exported && f.autoVerify) && f.viewBrowsable) && !(f.extraData)) && sameValues(f.schemes, ["https"])) && sameValues(f.hosts, [host])) && sameValues(f.paths, [path]))
}

function manifestHasCallback(filters: seq<CallbackFilter>, host: string, path: string): bool
{
  (exists f :: f in filters && callbackFilterAdmits(f, host, path))
}

function lawAnExtraHostOrPathNeverAdmits(f: CallbackFilter, host: string, path: string): bool
{
  (!(((|Std.Collections.Seq.Filter((set_x: string) => !((set_x in [host])), f.hosts)| > 0) || (|Std.Collections.Seq.Filter((set_x: string) => !((set_x in [path])), f.paths)| > 0))) || !(callbackFilterAdmits(f, host, path)))
}

lemma lawAnExtraHostOrPathNeverAdmits_ensures(f: CallbackFilter, host: string, path: string)
  ensures (lawAnExtraHostOrPathNeverAdmits(f, host, path) == true)
{
  forall p: string -> bool, xs: seq<string> | |Std.Collections.Seq.Filter(p, xs)| > 0
    ensures exists x :: x in xs && p(x)
  {
    ProofLib.FilterNone(p, xs);
    var i :| 0 <= i < |xs| && p(xs[i]);
    assert xs[i] in xs;
  }
}

function lawFactsOfTwoFiltersNeverCombine(f: CallbackFilter, g: CallbackFilter, host: string, path: string): bool
{
  (!((!(sameValues(f.hosts, [host])) && !(g.autoVerify))) || !(manifestHasCallback([f, g], host, path)))
}

lemma lawFactsOfTwoFiltersNeverCombine_ensures(f: CallbackFilter, g: CallbackFilter, host: string, path: string)
  ensures (lawFactsOfTwoFiltersNeverCombine(f, g, host, path) == true)
{
}

function stepSignInLinksNeverReachTheRenderer(before: BrowserReturns, via: string, after: BrowserReturns): bool
{
  ((!((((via == "returned") || (via == "failureReturned")) || (via == "processRestarted"))) || ((after.links.captured == before.links.captured) && (after.links.pending == before.links.pending))) && (!((via == "failureReturned")) || (((after.record == before.record) && (after.credential.generation == before.credential.generation)) && (after.credential.custody == before.credential.custody))))
}

function sometimesLinkCapturedBesideWaitingSignIn(s: BrowserReturns): bool
{
  (isWaiting(s.attempt) && (s.links.pending > 0))
}

function failureReturned(s: BrowserReturns, cold: bool): BrowserReturns
{
  if cold then
    relaunched(false, s)
  else
    s
}

lemma failureReturned_ensures(s: BrowserReturns, cold: bool)
  ensures (inv(s) ==> alwaysRecordNamesAReservedGeneration(failureReturned(s, cold)))
  ensures (inv(s) ==> alwaysWaitingAttemptHoldsItsLiveRecord(failureReturned(s, cold)))
  ensures (inv(s) ==> alwaysHandedReturnRunsUnderTheNewestGeneration(failureReturned(s, cold)))
  ensures (inv(s) ==> alwaysUnconfirmedRetirementBlocksExchange(failureReturned(s, cold)))
  ensures (inv(s) ==> stepHandOffOnlyForTheBoundLiveRecord(s, failureReturned(s, cold)))
  ensures (inv(s) ==> stepSignInLinksNeverReachTheRenderer(s, "failureReturned", failureReturned(s, cold)))
{
}

function linkFollowed(s: BrowserReturns, cold: bool): BrowserReturns
{
  if cold then
    relaunched(true, s)
  else
    s.(links := os__android__deepLinks_capture(s.links))
}

lemma linkFollowed_ensures(s: BrowserReturns, cold: bool)
  ensures (inv(s) ==> alwaysRecordNamesAReservedGeneration(linkFollowed(s, cold)))
  ensures (inv(s) ==> alwaysWaitingAttemptHoldsItsLiveRecord(linkFollowed(s, cold)))
  ensures (inv(s) ==> alwaysHandedReturnRunsUnderTheNewestGeneration(linkFollowed(s, cold)))
  ensures (inv(s) ==> alwaysUnconfirmedRetirementBlocksExchange(linkFollowed(s, cold)))
  ensures (inv(s) ==> stepHandOffOnlyForTheBoundLiveRecord(s, linkFollowed(s, cold)))
  ensures (inv(s) ==> stepSignInLinksNeverReachTheRenderer(s, "linkFollowed", linkFollowed(s, cold)))
{
}

function enabled(current: BrowserReturns, event: Event): bool
{
  match event {
    case start(i_event_client, i_event_nonce, i_event_checks) =>
      canStart(current, i_event_client, i_event_nonce, i_event_checks)
    case returned(i_event_client, i_event_nonce, i_event_burn) =>
      canReturned(current, i_event_client, i_event_nonce, i_event_burn)
    case elapse(i_event_ms) =>
      canElapse(current, i_event_ms)
    case credentialActed(i_event_kind) =>
      true
    case processRestarted =>
      true
    case retired(i_event_burn) =>
      canRetired(current, i_event_burn)
    case failureReturned(i_event_cold) =>
      true
    case linkFollowed(i_event_cold) =>
      true
  }
}

function step(current: BrowserReturns, event: Event): BrowserReturns
  requires inv(current)
{
  match event {
    case start(i_event_client, i_event_nonce, i_event_checks) =>
      if canStart(current, i_event_client, i_event_nonce, i_event_checks) then
        start(current, i_event_client, i_event_nonce, i_event_checks)
      else
        current
    case returned(i_event_client, i_event_nonce, i_event_burn) =>
      if canReturned(current, i_event_client, i_event_nonce, i_event_burn) then
        returned(current, i_event_client, i_event_nonce, i_event_burn)
      else
        current
    case elapse(i_event_ms) =>
      if canElapse(current, i_event_ms) then
        elapse(current, i_event_ms)
      else
        current
    case credentialActed(i_event_kind) =>
      credentialActed(current, i_event_kind)
    case processRestarted =>
      processRestarted(current)
    case retired(i_event_burn) =>
      if canRetired(current, i_event_burn) then
        retired(current, i_event_burn)
      else
        current
    case failureReturned(i_event_cold) =>
      failureReturned(current, i_event_cold)
    case linkFollowed(i_event_cold) =>
      linkFollowed(current, i_event_cold)
  }
}

lemma step_ensures(current: BrowserReturns, event: Event)
  requires inv(current)
  ensures inv(step(current, event))
{
  hide *;
  reveal step, inv;
  match event {
    case start(i_client, i_nonce, i_checks) => start_ensures(current, i_client, i_nonce, i_checks);
    case returned(i_client, i_nonce, i_burn) => returned_ensures(current, i_client, i_nonce, i_burn);
    case elapse(i_ms) => elapse_ensures(current, i_ms);
    case credentialActed(i_kind) => credentialActed_ensures(current, i_kind);
    case processRestarted => processRestarted_ensures(current);
    case retired(i_burn) => retired_ensures(current, i_burn);
    case failureReturned(i_cold) => failureReturned_ensures(current, i_cold);
    case linkFollowed(i_cold) => linkFollowed_ensures(current, i_cold);
  }
}

