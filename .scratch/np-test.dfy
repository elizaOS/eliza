  Std.Collections.Seq.FoldLeft((total: int, mail: MailNotice) => (if mailNoticeUnread(mail) then (total + 1) else total), 0, notices)
}

function lawCappingAShownNoticeKeepsTheCount(mail: MailNotice, notices: seq<MailNotice>): bool
{
  (!((mail.mailPhase.MailPosted? || mail.mailPhase.MailUncertain?)) || (unreadMailCount((notices + [cappedMail])) == unreadMailCount((notices + [mail]))))
}

lemma lawCappingAShownNoticeKeepsTheCount_ensures(mail: MailNotice, notices: seq<MailNotice>)
  ensures (lawCappingAShownNoticeKeepsTheCount(mail, notices) == true)
{
  NpCountAppend(notices, cappedMail);
  NpCountAppend(notices, mail);
}

function lawReadOrDeletedMailIsNeverCounted(notices: seq<MailNotice>): bool
{
  (unreadMailCount((notices + [readOrDeletedMail])) == unreadMailCount(notices))
}

lemma lawReadOrDeletedMailIsNeverCounted_ensures(notices: seq<MailNotice>)
  ensures (lawReadOrDeletedMailIsNeverCounted(notices) == true)
{
  NpCountAppend(notices, readOrDeletedMail);
}

function lawTheNewNoticeCountsItself(notices: seq<MailNotice>): bool
{
  (unreadMailCount((notices + [MailNotice(MailNoticePhase.MailPending, false)])) == (unreadMailCount(notices) + 1))
}

lemma lawTheNewNoticeCountsItself_ensures(notices: seq<MailNotice>)
  ensures (lawTheNewNoticeCountsItself(notices) == true)
{
  NpCountAppend(notices, MailNotice(MailNoticePhase.MailPending, false));
}

function enabled(current: NoticeProjection, event: Event): bool
{
  match event {
    case acceptLiveNotice(i_event_epoch, i_event_coordinate, i_event_mutedReadOrExpired) =>
      canAcceptLiveNotice(current, i_event_epoch, i_event_coordinate)
    case reconcilePage(i_event_page) =>
      canReconcilePage(current, i_event_page)
    case settleDispatch(i_event_settlement, i_event_stored) =>
      canSettleDispatch(current, i_event_settlement)
    case interruptDispatch =>
      canInterruptDispatch(current)
    case retireAuthority =>
      canRetireAuthority(current)
    case dispatchNotice(i_event_permitted) =>
      canDispatchNotice(current)
    case captureNoticeTap(i_event_ask) =>
      canCaptureNoticeTap(current, i_event_ask)
    case consumeNoticeTap(i_event_token, i_event_write) =>
      canConsumeNoticeTap(current, i_event_token, i_event_write)
    case releaseNoticeTap(i_event_token) =>
      canReleaseNoticeTap(current, i_event_token)
  }
}

function step(current: NoticeProjection, event: Event): NoticeProjection
  requires inv(current)
{
  match event {
    case acceptLiveNotice(i_event_epoch, i_event_coordinate, i_event_mutedReadOrExpired) =>
      if canAcceptLiveNotice(current, i_event_epoch, i_event_coordinate) then
        acceptLiveNotice(current, i_event_epoch, i_event_coordinate, i_event_mutedReadOrExpired)
      else
        current
    case reconcilePage(i_event_page) =>
      if canReconcilePage(current, i_event_page) then
        reconcilePage(current, i_event_page)
      else
        current
    case settleDispatch(i_event_settlement, i_event_stored) =>
      if canSettleDispatch(current, i_event_settlement) then
        settleDispatch(current, i_event_settlement, i_event_stored)
      else
        current
    case interruptDispatch =>
      if canInterruptDispatch(current) then
        interruptDispatch(current)
      else
        current
    case retireAuthority =>
      if canRetireAuthority(current) then
        retireAuthority(current)
      else
        current
    case dispatchNotice(i_event_permitted) =>
      if canDispatchNotice(current) then
        dispatchNotice(current, i_event_permitted)
      else
        current
    case captureNoticeTap(i_event_ask) =>
      if canCaptureNoticeTap(current, i_event_ask) then
        captureNoticeTap(current, i_event_ask)
      else
        current
    case consumeNoticeTap(i_event_token, i_event_write) =>
      if canConsumeNoticeTap(current, i_event_token, i_event_write) then
        consumeNoticeTap(current, i_event_token, i_event_write)
      else
        current
    case releaseNoticeTap(i_event_token) =>
      if canReleaseNoticeTap(current, i_event_token) then
        releaseNoticeTap(current, i_event_token)
      else
        current
  }
}

lemma step_ensures(current: NoticeProjection, event: Event)
  requires inv(current)
  ensures inv(step(current, event))
{
  hide *;
  reveal step, inv;
  match event {
    case acceptLiveNotice(i_epoch, i_coordinate, i_mutedReadOrExpired) => acceptLiveNotice_ensures(current, i_epoch, i_coordinate, i_mutedReadOrExpired);
    case reconcilePage(i_page) => reconcilePage_ensures(current, i_page);
    case settleDispatch(i_settlement, i_stored) => settleDispatch_ensures(current, i_settlement, i_stored);
    case interruptDispatch => interruptDispatch_ensures(current);
    case retireAuthority => retireAuthority_ensures(current);
    case dispatchNotice(i_permitted) => dispatchNotice_ensures(current, i_permitted);
    case captureNoticeTap(i_ask) => captureNoticeTap_ensures(current, i_ask);
    case consumeNoticeTap(i_token, i_write) => consumeNoticeTap_ensures(current, i_token, i_write);
    case releaseNoticeTap(i_token) => releaseNoticeTap_ensures(current, i_token);
  }
}

function initialHolds(): NoticeProjection
{
  initial
}

lemma initialHolds_ensures()
  ensures inv(initialHolds())
{
}

