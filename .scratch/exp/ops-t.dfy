function lawOneWireTypeIsOneOperation(a: OperationType, b: OperationType): bool
{
  (!((wireType(a) == wireType(b))) || (((a == b) || (family(a).ReviewFamily? && (wireType(a) == "calendar_named"))) || (family(a).TelephonyFamily? && (wireType(a) == "sms_compose"))))
}

