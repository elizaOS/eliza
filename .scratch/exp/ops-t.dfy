function familyNeed(f: Family, t: OperationType, versionTwo: bool): agent__deviceActions__capabilities_Need
{
  if f.CalendarFamily? then
    if t.CalendarCreateLocal? then
      agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.CalendarCreateV1)
    else
      if t.CalendarReadNext? then
        agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.CalendarNextReadV1)
      else
        agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.CalendarLocalEventV1)
  else
    if f.ReminderFamily? then
      agent__deviceActions__capabilities_reminderRecordNeed(versionTwo)
    else
      if f.ReminderCreateFamily? then
        agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.RemindersCreateV1)
      else
        if f.CameraFamily? then
          agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.CameraCapturePhotoV1)
        else
          if f.FilesFamily? then
            if versionTwo then
              needAll(agent__deviceActions__capabilities_Capability.FilesBrowserV1, agent__deviceActions__capabilities_Capability.FilesShownTargetV1)
            else
              agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.FilesBrowserV1)
          else
            if f.ReviewFamily? then
              if t.CalendarAvailability? then
                agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.CalendarAvailabilityReadV1)
              else
                if t.NotesSearch? then
                  needAll(agent__deviceActions__capabilities_Capability.NotesSearchV1, agent__deviceActions__capabilities_Capability.NotesLocalRecordV1)
                else
                  if t.NotesNamed? then
                    needAll(agent__deviceActions__capabilities_Capability.NamedTargetV1, agent__deviceActions__capabilities_Capability.NotesLocalRecordV1)
                  else
                    if t.CalendarNamedRead? then
                      needAll(agent__deviceActions__capabilities_Capability.CalendarNamedReadV1, agent__deviceActions__capabilities_Capability.CalendarLocalEventV1)
                    else
                      if t.CalendarNamedEdit? then
                        needAll(agent__deviceActions__capabilities_Capability.NamedTargetV1, agent__deviceActions__capabilities_Capability.CalendarLocalEventV1)
                      else
                        if versionTwo then
                          needAll(agent__deviceActions__capabilities_Capability.NamedTargetV1, agent__deviceActions__capabilities_Capability.RemindersLocalRecordV2)
                        else
                          agent__deviceActions__capabilities_Need([agent__deviceActions__capabilities_Capability.NamedTargetV1], [agent__deviceActions__capabilities_Capability.RemindersLocalRecordV1, agent__deviceActions__capabilities_Capability.RemindersLocalRecordV2])
            else
              if f.MapsFamily? then
                agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.MapsSelectedReadV1)
              else
                if f.NotesFamily? then
                  agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.NotesLocalRecordV1)
                else
                  if f.NotesOrganizeFamily? then
                    if t.NotesListFilter? then
                      agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.NotesListFilterV1)
                    else
                      if (t.NotesRecord? && versionTwo) then
                        agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.NotesRecordV1)
                      else
                        needAll(agent__deviceActions__capabilities_Capability.NotesOrganizeV1, agent__deviceActions__capabilities_Capability.NotesLocalRecordV1)
                  else
                    if f.NotesQueryFamily? then
                      needAll(agent__deviceActions__capabilities_Capability.NotesQueryV1, agent__deviceActions__capabilities_Capability.NotesLocalRecordV1)
                    else
                      if f.PhotoLibraryFamily? then
                        agent__deviceActions__capabilities_needOne(agent__deviceActions__capabilities_Capability.PhotosLibraryV1)
                      else
