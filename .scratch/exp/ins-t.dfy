function expectedInstall(j: Journal): int
{
  if j.recoveryAttempted then
    j.plan.recovery
  else
    j.plan.candidate
}

function canObserveInstall(j: Journal, readback: Readback): bool
{
  ((awaitsReadback(j) && (readback.planId == j.plan.id)) && (readback.sessionId == j.session))
}

function alwaysOpenCandidateIsNotQuarantined(j: Journal): bool
{
  (!(((j.phase.Staging? || j.phase.Verified?) || (awaitsReadback(j) && !(j.recoveryAttempted)))) || !((j.plan.candidate in j.quarantine)))
}

function observeInstall(j: Journal, readback: Readback): JournalStep
{
  var local_1 := j.recoveryAttempted;
  var local_2 := expectedInstall(j);
  var local_3 := previousInstall(j);
  var local_4 := stronger(j.reported, readback.report);
  var local_5 := (j.revision + 1);
  if (readback.installed == local_2) then
    conclude(true, local_2, j, j.(phase := (if local_1 then InstallPhase.RecoveryProbation else InstallPhase.Probation), support := SupportReason.NoReason, reported := InstallerReport.NoReport, releasedCandidate := (if local_1 then j.releasedCandidate else 0), releases := (if local_1 then j.releases else 0), revision := local_5))
  else
    if (readback.installed != local_3) then
      conclude(false, local_3, j, j.(phase := InstallPhase.Support, support := SupportReason.UnexpectedIdentity, revision := local_5))
    else
      if readback.status.SessionBlocked? then
        conclude(false, local_3, j, j.(phase := InstallPhase.Support, support := SupportReason.InstallerBlocked, revision := local_5))
      else
        if readback.status.SessionListed? then
          conclude(false, local_3, j, j.(reported := (if local_1 then j.reported else local_4), revision := local_5))
        else
          if (local_1 && j.phase.Support?) then
            conclude(false, local_3, j, j)
          else
            if local_1 then
              conclude(true, local_3, j, j.(phase := InstallPhase.Support, support := SupportReason.RecoveryFailed, revision := local_5))
            else
              if local_4.CandidateRejected? then
                conclude(true, local_3, j, j.(phase := InstallPhase.Quarantined, support := SupportReason.NoReason, quarantine := (j.quarantine + Std.Collections.Seq.Filter((set_x: int) => !((set_x in j.quarantine)), [j.plan.candidate])), reported := InstallerReport.NoReport, revision := local_5))
              else
                if local_4.Retryable? then
                  conclude(true, local_3, j, afterRelease(releaseCount(j), j))
                else
                  if j.support.OutcomeUnknown? then
                    conclude(false, local_3, j, j)
                  else
                    conclude(false, local_3, j, j.(phase := InstallPhase.Support, support := SupportReason.OutcomeUnknown, revision := local_5))
}

lemma observeInstall_ensures(j: Journal, readback: Readback)
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysPlanOutsideIdle(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysAwaitingIsHeld(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysHoldOnlyForAnOpenAttempt(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysUnknownOutcomeIsNotRecovery(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysOpenCandidateIsNotQuarantined(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysRetryBudget(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysQuarantinedPlanNamesItsCandidate(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysRecoveryFollowsQuarantinedCandidate(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysRecoveryPhasesMatchTheAttempt(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> alwaysSupportNamesItsReason(observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> stepHoldsAreAnnounced(j, "observeInstall", observeInstall(j, readback).state, observeInstall(j, readback).out))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> stepRejectionIsDurable(j, observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> stepQuarantineIsPermanent(j, observeInstall(j, readback).state))
  ensures (inv(j) ==> canObserveInstall(j, readback) ==> stepGenerationNeverGoesBack(j, observeInstall(j, readback).state))
{
  if inv(j) && canObserveInstall(j, readback) {
    var r := observeInstall(j, readback);
    InsHolds(j, "observeInstall", r);
    InsAdd(j.quarantine, j.plan.candidate);
    if !j.recoveryAttempted {
      assert !(j.plan.candidate in j.quarantine);
      InsRelease(j);
    }
  }
}

function abandonUnknown(j: Journal): JournalStep
{
  conclude(true, j.plan.baseline, j, afterRelease(releaseCount(j), j))
}

lemma abandonUnknown_ensures(j: Journal)
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysPlanOutsideIdle(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysAwaitingIsHeld(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysHoldOnlyForAnOpenAttempt(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysUnknownOutcomeIsNotRecovery(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysOpenCandidateIsNotQuarantined(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysRetryBudget(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysQuarantinedPlanNamesItsCandidate(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysRecoveryFollowsQuarantinedCandidate(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysRecoveryPhasesMatchTheAttempt(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> alwaysSupportNamesItsReason(abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> stepHoldsAreAnnounced(j, "abandonUnknown", abandonUnknown(j).state, abandonUnknown(j).out))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> stepRejectionIsDurable(j, abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> stepQuarantineIsPermanent(j, abandonUnknown(j).state))
  ensures (inv(j) ==> canAbandonUnknown(j) ==> stepGenerationNeverGoesBack(j, abandonUnknown(j).state))
{
  if inv(j) && canAbandonUnknown(j) {
    InsHolds(j, "abandonUnknown", abandonUnknown(j));
    assert awaitsReadback(j) && !j.recoveryAttempted;
    InsRelease(j);
  }
}

function isRelease(e: UpdateHold): bool
{
  e.Release?
}

function isHold(e: UpdateHold): bool
{
  e.Hold?
}

function stepHoldsAreAnnounced(before: Journal, via: string, after: Journal, out: seq<UpdateHold>): bool
{
  (((exists e :: e in out && isHold(e)) == (before.hold.Unheld? && after.hold.HoldRequested?)) && ((exists e :: e in out && isRelease(e)) == ((!before.hold.Unheld?) && after.hold.Unheld?)))
}

function sometimesHoldAwaitsAcknowledgement(j: Journal): bool
{
  j.hold.HoldRequested?
}

function alwaysRetryBudget(j: Journal): bool
{
  ((((j.releases >= 0) && (j.releases <= installBudget)) && ((j.releases == 0) == (j.releasedCandidate == 0))) && (!((j.releases >= installBudget)) || (j.releasedCandidate in j.quarantine)))
}

function stepRejectionIsDurable(before: Journal, after: Journal): bool
{
  (!((before.reported.CandidateRejected? && (after.phase.Committing? || after.phase.Support?))) || after.reported.CandidateRejected?)
}

function sometimesRejectionKept(j: Journal): bool
{
  (j.phase.Committing? && j.reported.CandidateRejected?)
}

function sometimesQuarantined(j: Journal): bool
{
  j.phase.Quarantined?
}

function stepQuarantineIsPermanent(before: Journal, after: Journal): bool
{
  !((exists set_x :: set_x in before.quarantine && !((set_x in after.quarantine))))
}

function alwaysQuarantinedPlanNamesItsCandidate(j: Journal): bool
{
  (!(j.phase.Quarantined?) || (j.plan.candidate in j.quarantine))
}

function stepGenerationNeverGoesBack(before: Journal, after: Journal): bool
{
  (after.generation >= before.generation)
}

function inProbation(j: Journal): bool
{
  (j.phase.Probation? || j.phase.RecoveryProbation?)
}

function observeHealth(j: Journal, evidence: HealthEvidence): Journal
{
  if evidence.verdict.HealthPassed? then
    j.(phase := (if j.recoveryAttempted then InstallPhase.Recovered else InstallPhase.Healthy), revision := (j.revision + 1))
  else
    if j.recoveryAttempted then
      j.(phase := InstallPhase.Support, support := SupportReason.RecoveryFailed, quarantine := ((j.quarantine + Std.Collections.Seq.Filter((set_x: int) => !((set_x in j.quarantine)), [j.plan.candidate])) + Std.Collections.Seq.Filter((set_x: int) => !((set_x in (j.quarantine + Std.Collections.Seq.Filter((set_x: int) => !((set_x in j.quarantine)), [j.plan.candidate])))), [j.plan.recovery])), revision := (j.revision + 1))
    else
      j.(phase := InstallPhase.RecoveryReady, quarantine := (j.quarantine + Std.Collections.Seq.Filter((set_x: int) => !((set_x in j.quarantine)), [j.plan.candidate])), revision := (j.revision + 1))
}

lemma observeHealth_ensures(j: Journal, evidence: HealthEvidence)
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysPlanOutsideIdle(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysAwaitingIsHeld(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysHoldOnlyForAnOpenAttempt(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysUnknownOutcomeIsNotRecovery(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysOpenCandidateIsNotQuarantined(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysRetryBudget(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysQuarantinedPlanNamesItsCandidate(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysRecoveryFollowsQuarantinedCandidate(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysRecoveryPhasesMatchTheAttempt(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> alwaysSupportNamesItsReason(observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> stepHoldsAreAnnounced(j, "observeHealth", observeHealth(j, evidence), []))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> stepRejectionIsDurable(j, observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> stepQuarantineIsPermanent(j, observeHealth(j, evidence)))
  ensures (inv(j) ==> canObserveHealth(j, evidence) ==> stepGenerationNeverGoesBack(j, observeHealth(j, evidence)))
{
  if inv(j) && canObserveHealth(j, evidence) {
    var q := j.quarantine + Std.Collections.Seq.Filter((set_x: int) => !((set_x in j.quarantine)), [j.plan.candidate]);
    InsAdd(j.quarantine, j.plan.candidate);
    InsAdd(q, j.plan.recovery);
  }
}

function sometimesHealthy(j: Journal): bool
{
  j.phase.Healthy?
}

function matchesHealth(j: Journal, evidence: HealthEvidence): bool
{
  ((((evidence.planId == j.plan.id) && (evidence.generation == j.generation)) && (evidence.revision == j.revision)) && (evidence.installed == expectedInstall(j)))
}

function canObserveHealth(j: Journal, evidence: HealthEvidence): bool
{
  (matchesHealth(j, evidence) && (inProbation(j) || (j.phase.Healthy? && evidence.verdict.HealthFailed?)))
}

function canCommitRecovery(j: Journal, sessionId: int): bool
{
  (((j.phase.RecoveryReady? && !(j.recoveryAttempted)) && j.hold.HoldGranted?) && (sessionId > 0))
}

function commitRecovery(j: Journal, sessionId: int): Journal
{
  j.(phase := InstallPhase.Recovering, session := sessionId, recoveryAttempted := true, revision := (j.revision + 1))
}

lemma commitRecovery_ensures(j: Journal, sessionId: int)
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysPlanOutsideIdle(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysAwaitingIsHeld(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysHoldOnlyForAnOpenAttempt(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysUnknownOutcomeIsNotRecovery(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysOpenCandidateIsNotQuarantined(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysRetryBudget(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysQuarantinedPlanNamesItsCandidate(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysRecoveryFollowsQuarantinedCandidate(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysRecoveryPhasesMatchTheAttempt(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> alwaysSupportNamesItsReason(commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> stepHoldsAreAnnounced(j, "commitRecovery", commitRecovery(j, sessionId), []))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> stepRejectionIsDurable(j, commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> stepQuarantineIsPermanent(j, commitRecovery(j, sessionId)))
  ensures (inv(j) ==> canCommitRecovery(j, sessionId) ==> stepGenerationNeverGoesBack(j, commitRecovery(j, sessionId)))
{
}

function canDenyRecovery(j: Journal): bool
{
  j.phase.RecoveryReady?
}

function alwaysRecoveryFollowsQuarantinedCandidate(j: Journal): bool
{
  (!((j.recoveryAttempted || j.phase.RecoveryReady?)) || (j.plan.candidate in j.quarantine))
}

function alwaysRecoveryPhasesMatchTheAttempt(j: Journal): bool
{
  ((!(((j.phase.Recovering? || j.phase.RecoveryProbation?) || j.phase.Recovered?)) || j.recoveryAttempted) && (!((((((j.phase.Staging? || j.phase.Verified?) || j.phase.Committing?) || j.phase.Probation?) || j.phase.Healthy?) || j.phase.RecoveryReady?)) || !(j.recoveryAttempted)))
}

function sometimesRecovered(j: Journal): bool
{
  j.phase.Recovered?
}

function denyRecovery(j: Journal): JournalStep
{
  conclude(true, j.plan.candidate, j, j.(phase := InstallPhase.Quarantined, quarantine := (j.quarantine + Std.Collections.Seq.Filter((set_x: int) => !((set_x in j.quarantine)), [j.plan.recovery])), revision := (j.revision + 1)))
}

lemma denyRecovery_ensures(j: Journal)
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysPlanOutsideIdle(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysAwaitingIsHeld(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysHoldOnlyForAnOpenAttempt(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysUnknownOutcomeIsNotRecovery(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysOpenCandidateIsNotQuarantined(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysRetryBudget(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysQuarantinedPlanNamesItsCandidate(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysRecoveryFollowsQuarantinedCandidate(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysRecoveryPhasesMatchTheAttempt(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> alwaysSupportNamesItsReason(denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> stepHoldsAreAnnounced(j, "denyRecovery", denyRecovery(j).state, denyRecovery(j).out))
  ensures (inv(j) ==> canDenyRecovery(j) ==> stepRejectionIsDurable(j, denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> stepQuarantineIsPermanent(j, denyRecovery(j).state))
  ensures (inv(j) ==> canDenyRecovery(j) ==> stepGenerationNeverGoesBack(j, denyRecovery(j).state))
{
  if inv(j) && canDenyRecovery(j) {
    InsHolds(j, "denyRecovery", denyRecovery(j));
  }
}

function alwaysSupportNamesItsReason(j: Journal): bool
{
  (j.phase.Support? == (!j.support.NoReason?))
}

function sometimesRecoveryFailed(j: Journal): bool
{
  (j.phase.Support? && j.support.RecoveryFailed?)
}

function enabled(current: Journal, event: Event): bool
{
  match event {
    case stage(i_event_plan, i_event_installed) =>
      canStage(current, i_event_plan, i_event_installed)
    case verify(i_event_planId) =>
      canVerify(current, i_event_planId)
    case dropPlan(i_event_planId) =>
      canDropPlan(current, i_event_planId)
    case changeChannel =>
      true
    case acknowledgeHold(i_event_target) =>
      canAcknowledgeHold(current, i_event_target)
    case commitCandidate(i_event_sessionId) =>
      canCommitCandidate(current, i_event_sessionId)
    case requestHold =>
      canRequestHold(current)
    case releaseUnhandedHold =>
      canReleaseUnhandedHold(current)
    case stallInstall(i_event_sessionId) =>
      canStallInstall(current, i_event_sessionId)
    case observeInstall(i_event_readback) =>
      canObserveInstall(current, i_event_readback)
    case abandonUnknown =>
      canAbandonUnknown(current)
    case observeHealth(i_event_evidence) =>
      canObserveHealth(current, i_event_evidence)
    case commitRecovery(i_event_sessionId) =>
      canCommitRecovery(current, i_event_sessionId)
    case denyRecovery =>
      canDenyRecovery(current)
  }
}

function step(current: Journal, event: Event): JournalStep
  requires inv(current)
{
  match event {
    case stage(i_event_plan, i_event_installed) =>
      if canStage(current, i_event_plan, i_event_installed) then
        JournalStep(stage(current, i_event_plan, i_event_installed), [])
      else
        JournalStep(current, [])
    case verify(i_event_planId) =>
      if canVerify(current, i_event_planId) then
        JournalStep(verify(current, i_event_planId), [])
      else
        JournalStep(current, [])
    case dropPlan(i_event_planId) =>
      if canDropPlan(current, i_event_planId) then
        dropPlan(current, i_event_planId)
      else
        JournalStep(current, [])
    case changeChannel =>
      changeChannel(current)
    case acknowledgeHold(i_event_target) =>
      if canAcknowledgeHold(current, i_event_target) then
        JournalStep(acknowledgeHold(current, i_event_target), [])
      else
        JournalStep(current, [])
    case commitCandidate(i_event_sessionId) =>
      if canCommitCandidate(current, i_event_sessionId) then
        JournalStep(commitCandidate(current, i_event_sessionId), [])
      else
        JournalStep(current, [])
    case requestHold =>
      if canRequestHold(current) then
        requestHold(current)
      else
        JournalStep(current, [])
    case releaseUnhandedHold =>
      if canReleaseUnhandedHold(current) then
        releaseUnhandedHold(current)
      else
        JournalStep(current, [])
    case stallInstall(i_event_sessionId) =>
      if canStallInstall(current, i_event_sessionId) then
        JournalStep(stallInstall(current, i_event_sessionId), [])
      else
        JournalStep(current, [])
    case observeInstall(i_event_readback) =>
      if canObserveInstall(current, i_event_readback) then
        observeInstall(current, i_event_readback)
      else
        JournalStep(current, [])
    case abandonUnknown =>
      if canAbandonUnknown(current) then
        abandonUnknown(current)
      else
        JournalStep(current, [])
    case observeHealth(i_event_evidence) =>
      if canObserveHealth(current, i_event_evidence) then
        JournalStep(observeHealth(current, i_event_evidence), [])
      else
        JournalStep(current, [])
    case commitRecovery(i_event_sessionId) =>
      if canCommitRecovery(current, i_event_sessionId) then
        JournalStep(commitRecovery(current, i_event_sessionId), [])
      else
        JournalStep(current, [])
    case denyRecovery =>
      if canDenyRecovery(current) then
        denyRecovery(current)
      else
        JournalStep(current, [])
  }
}

lemma step_ensures(current: Journal, event: Event)
  requires inv(current)
  ensures inv(step(current, event).state)
{
  hide *;
  reveal step, inv;
  match event {
    case stage(i_plan, i_installed) => stage_ensures(current, i_plan, i_installed);
    case verify(i_planId) => verify_ensures(current, i_planId);
    case dropPlan(i_planId) => dropPlan_ensures(current, i_planId);
    case changeChannel => changeChannel_ensures(current);
    case acknowledgeHold(i_target) => acknowledgeHold_ensures(current, i_target);
    case commitCandidate(i_sessionId) => commitCandidate_ensures(current, i_sessionId);
    case requestHold => requestHold_ensures(current);
    case releaseUnhandedHold => releaseUnhandedHold_ensures(current);
    case stallInstall(i_sessionId) => stallInstall_ensures(current, i_sessionId);
    case observeInstall(i_readback) => observeInstall_ensures(current, i_readback);
    case abandonUnknown => abandonUnknown_ensures(current);
    case observeHealth(i_evidence) => observeHealth_ensures(current, i_evidence);
    case commitRecovery(i_sessionId) => commitRecovery_ensures(current, i_sessionId);
    case denyRecovery => denyRecovery_ensures(current);
  }
}

function initialHolds(): Journal
{
  initial
}

lemma initialHolds_ensures()
  ensures inv(initialHolds())
{
}

const installBudget: int := 3

const noPlan: Plan := Plan(0, 0, 0, 0, 0)

const initial: Journal := Journal(InstallPhase.Idle, SupportReason.NoReason, noPlan, 0, false, HoldState.Unheld, 0, 0, [], InstallerReport.NoReport, 0, 0)

// A step that announces only releases, keeps the hold or clears it, and announces a release exactly when it clears a
// hold it had, announces its holds.
lemma InsHolds(j: Journal, via: string, r: JournalStep)
  requires forall e :: e in r.out ==> e.Release?
  requires r.state.hold.Unheld? || r.state.hold == j.hold
  requires r.state.hold.Unheld? && !j.hold.Unheld? ==> |r.out| > 0
  requires |r.out| > 0 ==> r.state.hold.Unheld? && !j.hold.Unheld?
  ensures stepHoldsAreAnnounced(j, via, r.state, r.out)
{
  if |r.out| > 0 {
    assert r.out[0] in r.out && isRelease(r.out[0]);
  }
  assert forall e :: e in r.out ==> !isHold(e);
}

// Adding a value once keeps what the list held, holds the value, and holds nothing else.
lemma InsAdd(q: seq<int>, c: int)
  ensures c in q + Std.Collections.Seq.Filter((set_x: int) => !((set_x in q)), [c])
  ensures forall x :: x in q ==> x in q + Std.Collections.Seq.Filter((set_x: int) => !((set_x in q)), [c])
  ensures forall x :: x in q + Std.Collections.Seq.Filter((set_x: int) => !((set_x in q)), [c]) ==> x in q || x == c
{
  reveal Std.Collections.Seq.Filter();
  assert [c][1..] == [];
}

// A release of a candidate that is not quarantined stays within the budget, and quarantines it when it spends it.
lemma InsRelease(j: Journal)
  requires inv(j) && !j.phase.Idle? && !(j.plan.candidate in j.quarantine)
  ensures alwaysRetryBudget(afterRelease(releaseCount(j), j))
  ensures alwaysQuarantinedPlanNamesItsCandidate(afterRelease(releaseCount(j), j))
{
  InsAdd(j.quarantine, j.plan.candidate);
  assert validPlan(j.plan);
  if j.releasedCandidate == j.plan.candidate {
    assert j.releases < installBudget;
  }
}
