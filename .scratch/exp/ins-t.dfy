function conclude(ends: bool, installed: int, before: Journal, after: Journal): JournalStep
{
  if ends then
    JournalStep(after.(hold := HoldState.Unheld), (if before.hold.Unheld? then [] else [Release(installed)]))
  else
    JournalStep(after, [])
}

