function stronger(a: InstallerReport, b: InstallerReport): InstallerReport
{
  if (a.CandidateRejected? || b.CandidateRejected?) then
    InstallerReport.CandidateRejected
  else
    if (a.Retryable? || b.Retryable?) then
      InstallerReport.Retryable
    else
      InstallerReport.NoReport
}

function previousInstall(j: Journal): int
{
  if j.recoveryAttempted then
    j.plan.candidate
  else
    j.plan.baseline
}

function releaseCount(j: Journal): int
{
  if (j.releasedCandidate == j.plan.candidate) then
    (j.releases + 1)
  else
    1
}

function afterRelease(count: int, j: Journal): Journal
{
  if (count >= installBudget) then
    j.(phase := InstallPhase.Quarantined, support := SupportReason.NoReason, quarantine := (j.quarantine + Std.Collections.Seq.Filter((set_x: int) => !((set_x in j.quarantine)), [j.plan.candidate])), releasedCandidate := j.plan.candidate, releases := count, reported := InstallerReport.NoReport, revision := (j.revision + 1))
  else
    j.(phase := InstallPhase.Idle, support := SupportReason.NoReason, plan := noPlan, session := 0, releasedCandidate := j.plan.candidate, releases := count, reported := InstallerReport.NoReport, revision := (j.revision + 1))
}

function canStallInstall(j: Journal, sessionId: int): bool
{
  ((j.phase.Committing? || j.phase.Recovering?) && (sessionId == j.session))
}

