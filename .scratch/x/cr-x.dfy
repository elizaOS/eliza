lemma {:axiom} os__signIn__credential_beginSignIn_ensures(s: os__signIn__credential_DeviceCredential)
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_alwaysCountersAreNatural(os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_alwaysSignInIsTheNewestAction(os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_alwaysKeysAreMintedInOrder(os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_alwaysDutiesNameRetiredKeys(os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_alwaysSessionBelongsToTheActiveKey(os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_alwaysRefreshWaitersAreCounted(os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepGenerationCountsOwnerActions(s, "beginSignIn", os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepEachNewKeyIsAnnouncedOnce(s, "beginSignIn", os__signIn__credential_beginSignIn(s), []))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepAReplacedKeyNamesItsSuccessor(s, "beginSignIn", os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepAnEndedKeyNamesNoSuccessor(s, "beginSignIn", os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepAKeyLeavesOnlyWithItsDuty(s, "beginSignIn", os__signIn__credential_beginSignIn(s), []))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepRestartKeepsCustody(s, "beginSignIn", os__signIn__credential_beginSignIn(s)))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepOneRefreshInFlight(s, "beginSignIn", os__signIn__credential_beginSignIn(s), []))
  ensures (os__signIn__credential_inv(s) ==> os__signIn__credential_stepARenewalKeepsTheActiveKey(s, "beginSignIn", os__signIn__credential_beginSignIn(s)))

