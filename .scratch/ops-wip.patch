@@ -141,3 +141,76 @@ lemma lawTheDraftFollowUpNeedsTheNewerRead_ensures(n: agent__deviceActions__capa
     OpsMeetsRequired(n, agent__deviceActions__capabilities_smsLatestSenderNeed(true));
