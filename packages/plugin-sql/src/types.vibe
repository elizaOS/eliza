// spec/sql/connectionLifecycle.md, "Adapter lifecycle transitions preserve transaction, RLS, schema, and embedding invariants"
import type { UUID } from "@elizaos/core"
import {
  beginConnect,
  beginShutdown,
  beginTransaction,
  canBeginConnect,
  canBeginShutdown,
  canBeginTransaction,
  canCompleteConnect,
  canEndTransaction,
  canFailConnect,
  canFinishClose,
  canPinEmbeddingSpace,
  completeConnect,
  endTransaction,
  failConnect,
  finishClose,
  initial,
  pinEmbeddingSpace,
  type ConnectionState,
  type SqlBackend,
} from "../gen/sql__connectionLifecycle.effect.vibe"

export interface SqlQueryResult<Row extends Record<string, unknown> = Record<string, unknown>> {
  rows: Row[]
  affectedRows?: number
}

export interface SqlExecutor {
  query<Row extends Record<string, unknown> = Record<string, unknown>>(
    sql: string,
    params?: readonly unknown[],
  ): Promise<SqlQueryResult<Row>>
  exec(sql: string): Promise<void>
  transaction<T>(fn: (tx: SqlExecutor) => Promise<T>): Promise<T>
}

export interface SqlAdapterConfig {
  dataDir?: string
  postgresUrl?: string
  serverId?: UUID
  maxPoolSize?: number
}

module pgliteErrors {
  export const PGLITE_ERROR_CODES = {
    ACTIVE_LOCK: "ELIZA_PGLITE_DATA_DIR_IN_USE",
    CORRUPT_DATA: "ELIZA_PGLITE_CORRUPT_DATA",
    MANUAL_RESET_REQUIRED: "ELIZA_PGLITE_MANUAL_RESET_REQUIRED",
  } as const

  export type PgliteErrorCode = (typeof PGLITE_ERROR_CODES)[keyof typeof PGLITE_ERROR_CODES]

  export class PgliteInitError extends Error {
    public readonly code: PgliteErrorCode
    public readonly dataDir?: string

    constructor(
      code: PgliteErrorCode,
      message: string,
      options?: { cause?: unknown; dataDir?: string },
    ) {
      super(message, { cause: options?.cause })
      this.name = "PgliteInitError"
      this.code = code
      this.dataDir = options?.dataDir
    }
  }

  export function createPgliteInitError(
    code: PgliteErrorCode,
    message: string,
    options?: { cause?: unknown; dataDir?: string },
  ): PgliteInitError {
    return new PgliteInitError(code, message, options)
  }
}
import { PGLITE_ERROR_CODES, PgliteInitError, createPgliteInitError, type PgliteErrorCode } from pgliteErrors
export { PGLITE_ERROR_CODES, PgliteInitError, createPgliteInitError, type PgliteErrorCode }

export function isFatalPgliteErrorCode(code: unknown): code is PgliteErrorCode {
  return (
    code === PGLITE_ERROR_CODES.ACTIVE_LOCK ||
    code === PGLITE_ERROR_CODES.CORRUPT_DATA ||
    code === PGLITE_ERROR_CODES.MANUAL_RESET_REQUIRED
  )
}

export function getPgliteErrorCode(err: unknown): PgliteErrorCode | null {
  const seen = new Set<unknown>()
  let current: unknown = err
  while (current && !seen.has(current)) {
    seen.add(current)
    if (typeof current === "object" && current !== null && "code" in current) {
      const code = (current as { code?: unknown }).code
      if (isFatalPgliteErrorCode(code)) return code
    }
    if (current instanceof Error) {
      current = (current as Error & { cause?: unknown }).cause
      continue
    }
    if (typeof current === "object" && current !== null && "cause" in current) {
      current = (current as { cause?: unknown }).cause
      continue
    }
    break
  }
  return null
}

export interface ClosePgliteSingletonResult {
  closed: boolean
  timedOut: boolean
  error: Error | null
}

export class SqlConnectionLifecycleController {
  private state: ConnectionState = initial

  getState(): ConnectionState {
    return this.state
  }

  beginConnect(backend: SqlBackend): boolean {
    if (!canBeginConnect(this.state, backend)) return false
    this.state = beginConnect(this.state, backend)
    return true
  }

  completeConnect(schemaVersion: number): boolean {
    if (!canCompleteConnect(this.state, schemaVersion)) return false
    this.state = completeConnect(this.state, schemaVersion)
    return true
  }

  failConnect(): boolean {
    if (!canFailConnect(this.state)) return false
    this.state = failConnect(this.state)
    return true
  }

  beginTransaction(withEntityScope: boolean): boolean {
    if (!canBeginTransaction(this.state, withEntityScope)) return false
    this.state = beginTransaction(this.state, withEntityScope)
    return true
  }

  endTransaction(): boolean {
    if (!canEndTransaction(this.state)) return false
    this.state = endTransaction(this.state)
    return true
  }

  pinEmbeddingSpace(dim: number): boolean {
    if (!canPinEmbeddingSpace(this.state, dim)) return false
    this.state = pinEmbeddingSpace(this.state, dim)
    return true
  }

  beginShutdown(): boolean {
    if (!canBeginShutdown(this.state)) return false
    this.state = beginShutdown(this.state)
    return true
  }

  finishClose(): boolean {
    if (!canFinishClose(this.state)) return false
    this.state = finishClose(this.state)
    return true
  }
}
