export function embeddingColumnForDimension(dimension: number): EmbeddingDimensionColumn {
  if (dimension === 384) return "dim_384"
  if (dimension === 512) return "dim_512"
  if (dimension === 768) return "dim_768"
  if (dimension === 1024) return "dim_1024"
  if (dimension === 1536) return "dim_1536"
  if (dimension === 2048) return "dim_2048"
  return "dim_3072"
}

export interface EmbeddingWriteContext {
  readonly column: EmbeddingDimensionColumn
  readonly spaceId: string | null
}

module embeddingSpaceImpl {
  import {
    ElizaError,
    getEmbeddingVectorSpaceIdentity,
    identifyEmbeddingVector,
  } from "@elizaos/core"
  import type { EmbeddingDimensionColumn, EmbeddingWriteContext } from "./schema.vibe"

  export function assertEmbeddingWrite(
    context: EmbeddingWriteContext,
    column: EmbeddingDimensionColumn,
    activeSpace: string | null,
  ): void {
    if (context.spaceId !== activeSpace || context.column !== column) {
      throw new ElizaError("Embedding representation changed before the vector could be stored", {
        code: "EMBEDDING_SPACE_MISMATCH",
        context: {
          expectedSpace: context.spaceId,
          activeSpace,
          expectedColumn: context.column,
          activeColumn: column,
        },
      })
    }
  }

  export function captureEmbeddingTarget(
    embedding: number[],
    column: EmbeddingDimensionColumn,
    activeSpace: string | null,
  ): EmbeddingWriteContext {
    const identity = getEmbeddingVectorSpaceIdentity(embedding)
    const context: EmbeddingWriteContext = { column, spaceId: identity ?? null }
    assertEmbeddingWrite(context, column, activeSpace)
    if (activeSpace !== null) {
      const expectedDim = Number(column.slice(4))
      if (embedding.length !== expectedDim) {
        throw new ElizaError("Embedding vector does not match the active dimension", {
          code: "EMBEDDING_DIMENSION_MISMATCH",
        })
      }
      for (const value of embedding) {
        if (!Number.isFinite(value)) {
          throw new ElizaError("Embedding vector contains a non-finite value", {
            code: "EMBEDDING_VECTOR_INVALID",
          })
        }
      }
    }
    return context
  }

  export function readEmbeddingVector(
    embedding: ArrayLike<number> | null | undefined,
    spaceId: string | null,
  ): number[] | undefined {
    return embedding ? identifyEmbeddingVector(Array.from(embedding), spaceId) : undefined
  }
}
import {
  assertEmbeddingWrite,
  captureEmbeddingTarget,
  readEmbeddingVector,
} from embeddingSpaceImpl
export { assertEmbeddingWrite, captureEmbeddingTarget, readEmbeddingVector }

export function cosineSimilarity(a: readonly number[], b: readonly number[]): number {
  if (a.length === 0 || a.length !== b.length) return 0
  let dot = 0
  let magA = 0
  let magB = 0
  for (let i = 0; i < a.length; i += 1) {
    const va = a[i] ?? 0
    const vb = b[i] ?? 0
    dot += va * vb
    magA += va * va
    magB += vb * vb
  }
  const denom = Math.sqrt(magA) * Math.sqrt(magB)
  return denom > 0 ? dot / denom : 0
}

export async function installRLSFunctions(executor: SqlExecutor): Promise<void> {
  await executor.exec(`
    CREATE OR REPLACE FUNCTION current_server_id() RETURNS UUID AS $$
    DECLARE app_name TEXT;
    BEGIN
      app_name := NULLIF(current_setting('application_name', TRUE), '');
      BEGIN
        RETURN app_name::UUID;
      EXCEPTION WHEN OTHERS THEN
        RETURN NULL;
      END;
    END;
    $$ LANGUAGE plpgsql STABLE;
  `)
  await executor.exec(`
    CREATE OR REPLACE FUNCTION current_entity_id() RETURNS UUID AS $$
    DECLARE raw_id TEXT;
    BEGIN
      raw_id := NULLIF(current_setting('app.entity_id', TRUE), '');
      BEGIN
        RETURN raw_id::UUID;
      EXCEPTION WHEN OTHERS THEN
        RETURN NULL;
      END;
    END;
    $$ LANGUAGE plpgsql STABLE;
  `)
}

export async function getOrCreateRlsServer(
  executor: SqlExecutor,
  serverId: string,
): Promise<string> {
  await executor.query(
    "INSERT INTO servers (id) VALUES ($1::uuid) ON CONFLICT (id) DO NOTHING",
    [serverId],
  )
  return serverId
}

export const embeddingIdentityHelpers = {
  ElizaError,
  getEmbeddingVectorSpaceIdentity,
  identifyEmbeddingVector,
}
