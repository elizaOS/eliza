    const res = await this.sqlExecutor.query("SELECT * FROM worlds WHERE id = ANY($1::uuid[])", [worldIds])
    return res.rows.map(rowToWorld)
  }

  override async createWorlds(worlds: World[]): Promise<UUID[]> {
    const ids: UUID[] = []
    const now = Date.now()
    for (const w of worlds) {
      const id = w.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO worlds (id, agent_id, name, message_server_id, metadata, created_at)
         VALUES ($1,$2,$3,$4,$5::jsonb,$6) ON CONFLICT (id) DO NOTHING`,
        [id, w.agentId ?? this.agentId, w.name ?? "World", w.messageServerId ?? null, encodeJsonb(w.metadata ?? {}, true), now],
      )
      ids.push(id)
    }
    return ids
  }

  override async updateWorlds(worlds: World[]): Promise<void> {
    for (const w of worlds) {
      await this.sqlExecutor.query(
        "UPDATE worlds SET name = $2, message_server_id = $3, metadata = $4::jsonb WHERE id = $1",
        [w.id, w.name ?? "World", w.messageServerId ?? null, encodeJsonb(w.metadata ?? {}, true)],
      )
    }
  }

  override async upsertWorlds(worlds: World[]): Promise<void> {
    const now = Date.now()
    for (const w of worlds) {
      const id = w.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO worlds (id, agent_id, name, message_server_id, metadata, created_at)
         VALUES ($1,$2,$3,$4,$5::jsonb,$6)
         ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, metadata = EXCLUDED.metadata`,
        [id, w.agentId ?? this.agentId, w.name ?? "World", w.messageServerId ?? null, encodeJsonb(w.metadata ?? {}, true), now],
      )
    }
  }

  override async deleteWorlds(worldIds: UUID[]): Promise<void> {
    if (worldIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM worlds WHERE id = ANY($1::uuid[])", [worldIds])
  }

  override async getRoomsByIds(roomIds: UUID[]): Promise<Room[]> {
    if (roomIds.length === 0) return []
    const res = await this.sqlExecutor.query("SELECT * FROM rooms WHERE id = ANY($1::uuid[])", [roomIds])
    return res.rows.map(rowToRoom)
  }

  override async getRoomsByWorlds(worldIds: UUID[], limit?: number, offset?: number): Promise<Room[]> {
    if (worldIds.length === 0) return []
    const res = await this.sqlExecutor.query("SELECT * FROM rooms WHERE world_id = ANY($1::uuid[])", [worldIds])
    const list = res.rows.map(rowToRoom)
    const start = offset ?? 0
