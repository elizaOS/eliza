function applyPatchOps(data: Record<string, unknown>, ops: readonly PatchOp[]): Record<string, unknown> {
  const next = { ...data }
  for (const op of ops) {
    const record = op as unknown as { op?: string; path?: string; key?: string; value?: unknown }
    const key = record.key ?? (typeof record.path === "string" ? record.path.replace(/^\//, "") : "")
    if (!key) continue
    if (record.op === "remove" || record.op === "delete") {
      delete next[key]
    } else {
      next[key] = record.value
    }
  }
  return next
}

function rowToAgent(row: Record<string, unknown>): Agent {
  return {
    id: String(row.id) as UUID,
    enabled: Boolean(row.enabled),
    status: String(row.status) as Agent["status"],
    name: String(row.name),
    username: row.username ? String(row.username) : undefined,
    system: row.system ? String(row.system) : undefined,
    bio: asStringList(row.bio),
    topics: asStringList(row.topics),
    adjectives: asStringList(row.adjectives),
    plugins: asStringList(row.plugins),
    settings: asRecord(row.settings) as Agent["settings"],
    style: asRecord(row.style) as Agent["style"],
    createdAt: Number(row.created_at),
    updatedAt: Number(row.updated_at),
  } as Agent
}

function rowToEntity(row: Record<string, unknown>): Entity {
  return {
    id: String(row.id) as UUID,
    agentId: String(row.agent_id) as UUID,
    names: asStringList(row.names),
    metadata: asRecord(row.metadata) as Metadata,
  }
}

function rowToComponent(row: Record<string, unknown>): Component {
  return {
    id: String(row.id) as UUID,
    entityId: String(row.entity_id) as UUID,
    agentId: String(row.agent_id) as UUID,
    roomId: String(row.room_id) as UUID,
    worldId: String(row.world_id) as UUID,
    sourceEntityId: String(row.source_entity_id) as UUID,
    type: String(row.type),
    data: asRecord(row.data) as Metadata,
    createdAt: Number(row.created_at),
  }
}

function rowToRoom(row: Record<string, unknown>): Room {
  return {
    id: String(row.id) as UUID,
    name: row.name ? String(row.name) : undefined,
    source: String(row.source),
    type: String(row.type) as Room["type"],
    channelId: row.channel_id ? String(row.channel_id) : undefined,
    messageServerId: row.message_server_id ? (String(row.message_server_id) as UUID) : undefined,
    worldId: row.world_id ? (String(row.world_id) as UUID) : undefined,
    metadata: asRecord(row.metadata) as Metadata,
  }
}

function rowToWorld(row: Record<string, unknown>): World {
  return {
    id: String(row.id) as UUID,
    agentId: String(row.agent_id) as UUID,
    name: String(row.name),
    messageServerId: row.message_server_id ? (String(row.message_server_id) as UUID) : undefined,
    metadata: asRecord(row.metadata) as WorldMetadata,
  }
}

function rowToRelationship(row: Record<string, unknown>): Relationship {
  return {
    id: String(row.id) as UUID,
    sourceEntityId: String(row.source_entity_id) as UUID,
    targetEntityId: String(row.target_entity_id) as UUID,
    agentId: String(row.agent_id) as UUID,
    tags: asStringList(row.tags),
    metadata: asRecord(row.metadata) as Metadata,
    createdAt: String(row.created_at),
  }
}

function rowToLog(row: Record<string, unknown>): Log {
  return {
    id: String(row.id) as UUID,
    entityId: String(row.entity_id) as UUID,
    roomId: String(row.room_id) as UUID,
    type: String(row.type),
    body: asRecord(row.body) as LogBody,
    createdAt: new Date(Number(row.created_at)),
  }
}

function rowToTask(row: Record<string, unknown>): Task {
  return {
    id: String(row.id) as UUID,
    name: String(row.name),
    description: row.description ? String(row.description) : "",
    roomId: row.room_id ? (String(row.room_id) as UUID) : undefined,
    worldId: row.world_id ? (String(row.world_id) as UUID) : undefined,
    entityId: row.entity_id ? (String(row.entity_id) as UUID) : undefined,
    tags: asStringList(row.tags),
    metadata: asRecord(row.metadata) as Task["metadata"],
  }
}

export abstract class BaseSqlDatabaseAdapter<DB extends object = SqlExecutor> extends DatabaseAdapter<DB> {
  override readonly messageContentSegmentCapability = 1 as const
  override readonly documentListQueryCapability = 4 as const

  readonly agentId: UUID
  readonly sqlExecutor: SqlExecutor
  protected readonly backendKind: SqlBackend
  protected readonly lifecycle = new SqlConnectionLifecycleController()
  protected embeddingDimension = 384
  protected embeddingSpaceId: string | null = null
  protected readonly serverId?: UUID

  constructor(agentId: UUID, executor: SqlExecutor, backendKind: SqlBackend, serverId?: UUID) {
    super()
    this.agentId = agentId
    this.sqlExecutor = executor
    this.backendKind = backendKind
    this.serverId = serverId
  }

  getLifecycleController(): SqlConnectionLifecycleController {
    return this.lifecycle
  }

  protected abstract createTransactionAdapter(tx: SqlExecutor): BaseSqlDatabaseAdapter<DB>
  protected abstract closeBackend(): Promise<void>
  protected abstract rawConnection(): Promise<DB>

  override async initialize(): Promise<void> {
    if (this.lifecycle.getState().phase === "Ready") return
    this.lifecycle.beginConnect(this.backendKind)
    try {
      await this.sqlExecutor.exec("CREATE EXTENSION IF NOT EXISTS vector").catch(() => undefined)
      await this.sqlExecutor.exec(
        "CREATE TABLE IF NOT EXISTS eliza_plugin_sql_migrations (revision integer PRIMARY KEY, checksum text NOT NULL)",
      )
      for (const migration of SQL_SCHEMA_MIGRATIONS) {
        const applied = await this.sqlExecutor.query(
          "SELECT checksum FROM eliza_plugin_sql_migrations WHERE revision = $1",
          [migration.revision],
        )
        if (applied.rows.length === 0) {
          await this.sqlExecutor.exec(migration.sql)
          await this.sqlExecutor.query(
            "INSERT INTO eliza_plugin_sql_migrations (revision, checksum) VALUES ($1, $2)",
            [migration.revision, migration.checksum],
          )
        }
      }
      if (this.backendKind === "PgBackend") {
        await installRLSFunctions(this.sqlExecutor).catch(() => undefined)
        if (this.serverId) {
          await getOrCreateRlsServer(this.sqlExecutor, this.serverId).catch(() => undefined)
        }
      }
      const spaceRow = await this.sqlExecutor.query(
        "SELECT space_id, dimension FROM embedding_spaces WHERE agent_id = $1 LIMIT 1",
        [this.agentId],
      )
      if (spaceRow.rows[0]) {
        this.embeddingSpaceId = spaceRow.rows[0].space_id ? String(spaceRow.rows[0].space_id) : null
        this.embeddingDimension = Number(spaceRow.rows[0].dimension)
      }
      this.lifecycle.completeConnect(SQL_SCHEMA_MIGRATIONS.length)
      this.db = await this.rawConnection()
    } catch (err) {
      this.lifecycle.failConnect()
      throw err
    }
  }

  override async runPluginMigrations(
    _plugins: Parameters<DatabaseAdapter["runPluginMigrations"]>[0],
  ): Promise<void> {
    await this.initialize()
  }

  override isReady(): Promise<boolean> {
    return Promise.resolve(this.lifecycle.getState().phase === "Ready")
  }

  override async close(): Promise<void> {
    if (this.lifecycle.getState().phase === "Ready") {
      this.lifecycle.beginShutdown()
    }
    await this.closeBackend()
    this.lifecycle.finishClose()
  }

  override getConnection(): Promise<DB> {
    return this.rawConnection()
  }

  override async transaction<T>(
    callback: (tx: IDatabaseAdapter<DB>) => Promise<T>,
    options?: { entityContext?: UUID },
  ): Promise<T> {
    const withEntity = Boolean(options?.entityContext)
    const tracked = this.lifecycle.beginTransaction(withEntity)
    try {
      return await this.sqlExecutor.transaction(async (tx) => {
        if (options?.entityContext) {
          await tx
            .query("SELECT set_config('app.entity_id', $1, true)", [options.entityContext])
            .catch(() => undefined)
        }
        return callback(this.createTransactionAdapter(tx))
      })
    } finally {
      if (tracked) this.lifecycle.endTransaction()
    }
  }

  override publishMessageContentSegments(params: MessageContentPublicationParams) {
    return publishSqlMessageContentSegments(this.sqlExecutor, params)
  }

  override readMessageContentRange(params: MessageContentRangeReadParams) {
    return readSqlMessageContentRange(this.sqlExecutor, params)
  }

  override queryDocuments(params: DocumentListQueryParams) {
    return querySqlDocuments(this.sqlExecutor, this.agentId, params)
  }

  override getDocument(params: DocumentGetQueryParams) {
    return getSqlDocument(this.sqlExecutor, this.agentId, params)
  }

  override queryDocumentFragments(params: DocumentFragmentQueryParams) {
    return querySqlDocumentFragments(this.sqlExecutor, this.agentId, this.embeddingDimension, params)
  }

  override compareAndSwapDocument(params: DocumentCompareAndSwapParams) {
    return compareAndSwapSqlDocument(this.sqlExecutor, params)
  }

  override updateDocumentDirectGrants(params: DocumentDirectGrantUpdateParams) {
    return updateSqlDocumentDirectGrants(this.sqlExecutor, params)
  }

  override replaceDocumentRevision(params: DocumentRevisionReplaceParams) {
    return replaceSqlDocumentRevision(this.sqlExecutor, params)
  }

  override deleteDocumentWithSnapshot(params: DocumentDeleteParams) {
    return deleteSqlDocumentWithSnapshot(this.sqlExecutor, params)
  }

  override compareAndSwapWorldMetadata(params: WorldMetadataCompareAndSwapParams) {
    return compareAndSwapSqlWorldMetadata(this.sqlExecutor, params)
  }

  override async ensureEmbeddingDimension(dimension: number): Promise<void> {
    if (!Number.isSafeInteger(dimension) || dimension <= 0) {
      throw new ElizaError("Embedding dimension must be a positive integer", {
        code: "SQL_EMBEDDING_DIMENSION_INVALID",
      })
    }
    this.embeddingDimension = dimension
    if (dimension === 384 || dimension === 768 || dimension === 1536) {
      this.lifecycle.pinEmbeddingSpace(dimension)
    }
    await this.sqlExecutor.query(
      `INSERT INTO embedding_spaces (agent_id, space_id, dimension, updated_at)
       VALUES ($1, $2, $3, $4)
       ON CONFLICT (agent_id) DO UPDATE SET dimension = EXCLUDED.dimension, updated_at = EXCLUDED.updated_at`,
      [this.agentId, this.embeddingSpaceId, dimension, Date.now()],
    )
  }

  async ensureEmbeddingSpace(spaceId: string): Promise<UUID[]> {
    const trimmed = spaceId.trim()
    if (!trimmed || trimmed !== spaceId) {
      throw new ElizaError("Embedding representation requires a canonical identifier", {
        code: "EMBEDDING_SPACE_INVALID",
      })
    }
    if (this.embeddingSpaceId !== null && this.embeddingSpaceId !== trimmed) {
      throw new ElizaError("Embedding space mismatch", { code: "EMBEDDING_SPACE_CHANGED" })
    }
    this.embeddingSpaceId = trimmed
    await this.sqlExecutor.query(
      `INSERT INTO embedding_spaces (agent_id, space_id, dimension, updated_at)
       VALUES ($1, $2, $3, $4)
       ON CONFLICT (agent_id) DO UPDATE SET space_id = EXCLUDED.space_id, updated_at = EXCLUDED.updated_at`,
      [this.agentId, trimmed, this.embeddingDimension, Date.now()],
    )
    const pending = await this.sqlExecutor.query(
      "SELECT id FROM memories WHERE agent_id = $1 AND embedding IS NULL",
      [this.agentId],
    )
    return pending.rows.map((r) => String(r.id) as UUID)
  }

  override async clearEmbeddingsOutsideActiveDimension(): Promise<UUID[]> {
    const res = await this.sqlExecutor.query(
      "SELECT id, embedding FROM memories WHERE agent_id = $1 AND embedding IS NOT NULL",
      [this.agentId],
    )
    const cleared: UUID[] = []
    for (const row of res.rows) {
      const emb = Array.isArray(row.embedding) ? row.embedding : []
      if (emb.length !== this.embeddingDimension) {
        const id = String(row.id) as UUID
        await this.sqlExecutor.query("UPDATE memories SET embedding = NULL WHERE id = $1", [id])
        cleared.push(id)
      }
    }
    return cleared
  }

  override async getAgents(): Promise<Partial<Agent>[]> {
    const res = await this.sqlExecutor.query("SELECT * FROM agents ORDER BY created_at ASC")
    return res.rows.map(rowToAgent)
  }

  override async getAgentsByIds(agentIds: UUID[]): Promise<Agent[]> {
    if (agentIds.length === 0) return []
    const res = await this.sqlExecutor.query("SELECT * FROM agents WHERE id = ANY($1::uuid[])", [agentIds])
    return res.rows.map(rowToAgent)
  }

  override async createAgents(agents: Partial<Agent>[]): Promise<UUID[]> {
    const ids: UUID[] = []
    const now = Date.now()
    for (const agent of agents) {
      const id = agent.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO agents (id, enabled, status, name, username, system, bio, topics, adjectives, plugins, settings, style, created_at, updated_at)
         VALUES ($1,$2,$3,$4,$5,$6,$7::jsonb,$8::jsonb,$9::jsonb,$10::jsonb,$11::jsonb,$12::jsonb,$13,$14)
         ON CONFLICT (id) DO NOTHING`,
        [
          id,
          agent.enabled ?? true,
          agent.status ?? "active",
          agent.name ?? "Agent",
          agent.username ?? null,
          agent.system ?? null,
          encodeJsonb(Array.isArray(agent.bio) ? agent.bio : agent.bio ? [agent.bio] : []),
          encodeJsonb(agent.topics ?? []),
          encodeJsonb(agent.adjectives ?? []),
          encodeJsonb(agent.plugins ?? []),
          encodeJsonb(agent.settings ?? {}, true),
          encodeJsonb(agent.style ?? {}),
          agent.createdAt ?? now,
          agent.updatedAt ?? now,
        ],
      )
      ids.push(id)
    }
    return ids
  }

  override async updateAgents(updates: Array<{ agentId: UUID; agent: Partial<Agent> }>): Promise<boolean> {
    const now = Date.now()
    for (const { agentId, agent } of updates) {
      const existing = (await this.getAgentsByIds([agentId]))[0]
      if (!existing) return false
      const merged = { ...existing, ...agent, id: agentId, updatedAt: now }
      await this.sqlExecutor.query(
        `UPDATE agents SET enabled=$2, status=$3, name=$4, username=$5, system=$6, bio=$7::jsonb,
          topics=$8::jsonb, adjectives=$9::jsonb, plugins=$10::jsonb, settings=$11::jsonb, style=$12::jsonb, updated_at=$13
         WHERE id = $1`,
        [
          agentId,
          merged.enabled ?? true,
          merged.status ?? "active",
          merged.name,
          merged.username ?? null,
          merged.system ?? null,
          encodeJsonb(Array.isArray(merged.bio) ? merged.bio : merged.bio ? [merged.bio] : []),
          encodeJsonb(merged.topics ?? []),
          encodeJsonb(merged.adjectives ?? []),
          encodeJsonb(merged.plugins ?? []),
          encodeJsonb(merged.settings ?? {}, true),
          encodeJsonb(merged.style ?? {}),
          now,
        ],
      )
    }
    return true
  }

  override async upsertAgents(agents: Partial<Agent>[]): Promise<void> {
    for (const agent of agents) {
      const id = agent.id ?? randomUuid()
      const existing = await this.getAgentsByIds([id])
      if (existing.length > 0) {
        await this.updateAgents([{ agentId: id, agent }])
      } else {
        await this.createAgents([{ ...agent, id }])
      }
    }
  }

  override async deleteAgents(agentIds: UUID[]): Promise<boolean> {
    if (agentIds.length === 0) return false
    const res = await this.sqlExecutor.query("DELETE FROM agents WHERE id = ANY($1::uuid[])", [agentIds])
    return (res.affectedRows ?? 0) > 0
  }

  override async countAgents(): Promise<number> {
    const res = await this.sqlExecutor.query("SELECT count(*)::int AS total FROM agents")
    return Number(res.rows[0]?.total ?? 0)
  }

  override async cleanupAgents(): Promise<void> {
    await this.sqlExecutor.query("DELETE FROM agents WHERE id = $1", [this.agentId])
  }

  override async getEntitiesByIds(entityIds: UUID[]): Promise<Entity[]> {
    if (entityIds.length === 0) return []
    const res = await this.sqlExecutor.query("SELECT * FROM entities WHERE id = ANY($1::uuid[])", [entityIds])
    return res.rows.map(rowToEntity)
  }

  override async createEntities(entities: Entity[]): Promise<UUID[]> {
    const ids: UUID[] = []
    const now = Date.now()
    for (const entity of entities) {
      const id = entity.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO entities (id, agent_id, names, metadata, created_at)
         VALUES ($1,$2,$3::jsonb,$4::jsonb,$5)
         ON CONFLICT (id) DO NOTHING`,
        [id, entity.agentId ?? this.agentId, encodeJsonb(entity.names ?? []), encodeJsonb(entity.metadata ?? {}, true), now],
      )
      ids.push(id)
    }
    return ids
  }

  override async updateEntities(entities: Entity[]): Promise<void> {
    for (const entity of entities) {
      if (!entity.id) continue
      await this.sqlExecutor.query(
        "UPDATE entities SET names = $2::jsonb, metadata = $3::jsonb WHERE id = $1",
        [entity.id, encodeJsonb(entity.names ?? []), encodeJsonb(entity.metadata ?? {}, true)],
      )
    }
  }

  override async upsertEntities(entities: Entity[]): Promise<void> {
    const now = Date.now()
    for (const entity of entities) {
      const id = entity.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO entities (id, agent_id, names, metadata, created_at)
         VALUES ($1,$2,$3::jsonb,$4::jsonb,$5)
         ON CONFLICT (id) DO UPDATE SET names = EXCLUDED.names, metadata = EXCLUDED.metadata`,
        [id, entity.agentId ?? this.agentId, encodeJsonb(entity.names ?? []), encodeJsonb(entity.metadata ?? {}, true), now],
      )
    }
  }

  override async deleteEntities(entityIds: UUID[]): Promise<void> {
    if (entityIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM entities WHERE id = ANY($1::uuid[])", [entityIds])
  }

  override async searchEntitiesByName(params: {
    query: string
    agentId: UUID
    limit?: number
  }): Promise<Entity[]> {
    const res = await this.sqlExecutor.query("SELECT * FROM entities WHERE agent_id = $1", [params.agentId])
    const q = params.query.toLowerCase()
    return res.rows
      .map(rowToEntity)
      .filter((e) => e.names.some((n) => n.toLowerCase().includes(q)))
      .slice(0, params.limit ?? 20)
  }

  override async getEntitiesByNames(params: { names: string[]; agentId: UUID }): Promise<Entity[]> {
    const wanted = new Set(params.names.map((n) => n.toLowerCase()))
    const res = await this.sqlExecutor.query("SELECT * FROM entities WHERE agent_id = $1", [params.agentId])
    return res.rows.map(rowToEntity).filter((e) => e.names.some((n) => wanted.has(n.toLowerCase())))
  }

  override async getEntitiesForRooms(
    roomIds: UUID[],
    includeComponents = false,
  ): Promise<EntitiesForRoomsResult> {
    if (roomIds.length === 0) return []
    const partRes = await this.sqlExecutor.query(
      "SELECT DISTINCT room_id, entity_id FROM participants WHERE room_id = ANY($1::uuid[])",
      [roomIds],
    )
    const allEntityIds = [...new Set(partRes.rows.map((r) => String(r.entity_id) as UUID))]
    const entities = await this.getEntitiesByIds(allEntityIds)
    const components = includeComponents ? await this.getComponentsForEntities(allEntityIds) : []
    const byId = new Map(
      entities.map((e) => [
        e.id,
        includeComponents ? { ...e, components: components.filter((c) => c.entityId === e.id) } : e,
      ]),
    )
    return roomIds.map((roomId) => ({
      roomId,
      entities: partRes.rows
        .filter((r) => String(r.room_id) === roomId)
        .map((r) => byId.get(String(r.entity_id) as UUID))
        .filter((e): e is Entity => e !== undefined),
    }))
  }

  override async queryEntities(params: {
    componentType?: string
    componentDataFilter?: Record<string, unknown>
    agentId?: UUID
    entityIds?: UUID[]
    worldId?: UUID
    limit?: number
    offset?: number
    includeAllComponents?: boolean
  }): Promise<Entity[]> {
    const agent = params.agentId ?? this.agentId
    const res = params.entityIds?.length
      ? await this.sqlExecutor.query(
          "SELECT * FROM entities WHERE agent_id = $1 AND id = ANY($2::uuid[])",
          [agent, params.entityIds],
        )
      : await this.sqlExecutor.query("SELECT * FROM entities WHERE agent_id = $1", [agent])
    let list = res.rows.map(rowToEntity)
    if (params.componentType || params.componentDataFilter || params.includeAllComponents) {
      const comps = await this.getComponentsForEntities(
        list.map((e) => e.id).filter((id): id is UUID => Boolean(id)),
        params.worldId,
      )
      list = list
        .filter((entity) => {
          if (!params.componentType) return true
          return comps.some(
            (c) =>
              c.entityId === entity.id &&
              c.type === params.componentType &&
              matchesMetadataFilter(c.data, params.componentDataFilter),
          )
        })
        .map((entity) =>
          params.includeAllComponents
            ? { ...entity, components: comps.filter((c) => c.entityId === entity.id) }
            : entity,
        )
    }
    const offset = params.offset ?? 0
    return params.limit !== undefined ? list.slice(offset, offset + params.limit) : list.slice(offset)
  }

  private async writeComponentRow(c: Component, onConflictUpdate: boolean): Promise<UUID> {
    const id = c.id ?? randomUuid()
    const suffix = onConflictUpdate ? " ON CONFLICT (id) DO UPDATE SET data = EXCLUDED.data" : ""
    await this.sqlExecutor.query(
      `INSERT INTO components (id, entity_id, agent_id, room_id, world_id, source_entity_id, type, data, created_at)
       VALUES ($1,$2,$3,$4,$5,$6,$7,$8::jsonb,$9)${suffix}`,
      [
        id,
        c.entityId,
        c.agentId ?? this.agentId,
        c.roomId,
        c.worldId,
        c.sourceEntityId,
        c.type,
        encodeJsonb(c.data ?? {}, true),
        c.createdAt ?? Date.now(),
      ],
    )
    return id
  }

  override async createComponents(components: Component[]): Promise<UUID[]> {
    const ids: UUID[] = []
    for (const c of components) {
      ids.push(await this.writeComponentRow(c, false))
    }
    return ids
  }

  override async getComponentsByIds(componentIds: UUID[]): Promise<Component[]> {
    if (componentIds.length === 0) return []
    const res = await this.sqlExecutor.query("SELECT * FROM components WHERE id = ANY($1::uuid[])", [componentIds])
    return res.rows.map(rowToComponent)
  }

  override async getComponentsByNaturalKeys(
    keys: Array<{ entityId: UUID; type: string; worldId?: UUID; sourceEntityId?: UUID }>,
  ): Promise<(Component | null)[]> {
    const out: (Component | null)[] = []
    for (const k of keys) {
      const res = await this.sqlExecutor.query(
        `SELECT * FROM components WHERE entity_id = $1 AND type = $2
         AND ($3::uuid IS NULL OR world_id = $3::uuid)
         AND ($4::uuid IS NULL OR source_entity_id = $4::uuid) LIMIT 1`,
        [k.entityId, k.type, k.worldId ?? null, k.sourceEntityId ?? null],
      )
      out.push(res.rows[0] ? rowToComponent(res.rows[0]) : null)
    }
    return out
  }

  override async getComponentsForEntities(
    entityIds: UUID[],
    worldId?: UUID,
    sourceEntityId?: UUID,
  ): Promise<Component[]> {
    if (entityIds.length === 0) return []
    const res = await this.sqlExecutor.query(
      `SELECT * FROM components WHERE entity_id = ANY($1::uuid[])
       AND ($2::uuid IS NULL OR world_id = $2::uuid)
       AND ($3::uuid IS NULL OR source_entity_id = $3::uuid)`,
      [entityIds, worldId ?? null, sourceEntityId ?? null],
    )
    return res.rows.map(rowToComponent)
  }

  override async updateComponents(components: Component[]): Promise<void> {
    for (const c of components) {
      await this.sqlExecutor.query("UPDATE components SET data = $2::jsonb WHERE id = $1", [
        c.id,
        encodeJsonb(c.data ?? {}, true),
      ])
    }
  }

  override async upsertComponents(components: Component[]): Promise<void> {
    for (const c of components) {
      await this.writeComponentRow(c, true)
    }
  }

  override async patchComponents(updates: Array<{ componentId: UUID; ops: PatchOp[] }>): Promise<void> {
    for (const u of updates) {
      const existing = (await this.getComponentsByIds([u.componentId]))[0]
      if (!existing) continue
      const patched = applyPatchOps(existing.data ?? {}, u.ops)
      await this.sqlExecutor.query("UPDATE components SET data = $2::jsonb WHERE id = $1", [
        u.componentId,
        encodeJsonb(patched, true),
      ])
    }
  }

  override async deleteComponents(componentIds: UUID[]): Promise<void> {
    if (componentIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM components WHERE id = ANY($1::uuid[])", [componentIds])
  }

  private async writeMemoryRow(
    memory: Memory,
    tableName: string,
    unique: boolean,
    onConflictUpdate: boolean,
  ): Promise<UUID> {
    const id = memory.id ?? randomUuid()
    const conflict = onConflictUpdate
      ? "ON CONFLICT (id) DO UPDATE SET content = EXCLUDED.content, metadata = EXCLUDED.metadata, embedding = EXCLUDED.embedding"
      : "ON CONFLICT (id) DO NOTHING"
    await this.sqlExecutor.query(
      `INSERT INTO memories (id, type, agent_id, entity_id, room_id, world_id, content, metadata, embedding, embedding_space, is_unique, created_at)
       VALUES ($1,$2,$3,$4,$5,$6,$7::jsonb,$8::jsonb,$9::jsonb,$10,$11,$12)
       ${conflict}`,
      [
        id,
        tableName,
        memory.agentId ?? this.agentId,
        memory.entityId,
        memory.roomId,
        memory.worldId ?? null,
        encodeJsonb(memory.content ?? {}, true),
        encodeJsonb(memory.metadata ?? {}, true),
        memory.embedding ? JSON.stringify(memory.embedding) : null,
        this.embeddingSpaceId,
        unique,
        memory.createdAt ?? Date.now(),
      ],
    )
    return id
  }

  override async createMemories(
    memories: Array<{ memory: Memory; tableName: string; unique?: boolean }>,
  ): Promise<UUID[]> {
    const ids: UUID[] = []
    for (const item of memories) {
      ids.push(
        await this.writeMemoryRow(
          item.memory,
          item.tableName,
          Boolean(item.unique ?? item.memory.unique),
          false,
        ),
      )
    }
    return ids
  }

  override async updateMemories(
    memories: Array<Partial<Memory> & { id: UUID; metadata?: MemoryMetadata }>,
  ): Promise<void> {
    for (const m of memories) {
      const current = (await this.getMemoriesByIds([m.id]))[0]
      if (!current) continue
      await this.sqlExecutor.query(
        "UPDATE memories SET content = $2::jsonb, metadata = $3::jsonb, embedding = $4::jsonb WHERE id = $1",
        [
          m.id,
          encodeJsonb(m.content ?? current.content, true),
          encodeJsonb(m.metadata ?? current.metadata ?? {}, true),
          m.embedding ? JSON.stringify(m.embedding) : current.embedding ? JSON.stringify(current.embedding) : null,
        ],
      )
    }
  }

  override async upsertMemories(
    memories: Array<{ memory: Memory; tableName: string }>,
  ): Promise<void> {
    for (const item of memories) {
      await this.writeMemoryRow(item.memory, item.tableName, Boolean(item.memory.unique), true)
    }
  }

  override async updateMemoryEmbedding(update: MemoryEmbeddingUpdate): Promise<boolean> {
    const res = await this.sqlExecutor.query(
      "UPDATE memories SET embedding = $2::jsonb, embedding_space = $3 WHERE id = $1",
      [update.id, JSON.stringify(update.embedding), this.embeddingSpaceId],
    )
    return (res.affectedRows ?? 0) > 0
  }

  override async deleteMemories(memoryIds: UUID[]): Promise<void> {
    if (memoryIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM memories WHERE id = ANY($1::uuid[])", [memoryIds])
  }

  override async deleteAllMemories(roomIds: UUID[], tableName: string): Promise<void> {
    if (roomIds.length === 0) return
    await this.sqlExecutor.query(
      "DELETE FROM memories WHERE room_id = ANY($1::uuid[]) AND type = $2",
      [roomIds, tableName],
    )
  }

  override async getMemoriesByIds(memoryIds: UUID[], tableName?: string): Promise<Memory[]> {
    if (memoryIds.length === 0) return []
    const res = tableName
      ? await this.sqlExecutor.query(
          "SELECT * FROM memories WHERE id = ANY($1::uuid[]) AND type = $2",
          [memoryIds, tableName],
        )
      : await this.sqlExecutor.query("SELECT * FROM memories WHERE id = ANY($1::uuid[])", [memoryIds])
    return res.rows.map((r) => rowToMemory(r, true))
  }

  override async getMemories(params: {
    entityId?: UUID
    authorEntityIds?: UUID[]
    agentId?: UUID
    limit?: number
    count?: number
    offset?: number
    cursor?: { createdAt: number; id: UUID }
    unique?: boolean
    tableName: string
    start?: number
    end?: number
    roomId?: UUID
    excludeRoomIds?: UUID[]
    worldId?: UUID
    metadata?: Record<string, unknown>
    textContains?: string
    orderBy?: "createdAt"
    orderDirection?: "asc" | "desc"
    includeEmbedding?: boolean
    accessContext?: AccessContext
  }): Promise<Memory[]> {
    const order = params.orderDirection === "asc" ? "ASC" : "DESC"
    const res = await this.sqlExecutor.query(
      `SELECT * FROM memories WHERE type = $1 AND agent_id = $2 ORDER BY created_at ${order}, id ${order}`,
      [params.tableName, params.agentId ?? this.agentId],
    )
    const excluded = new Set(params.excludeRoomIds ?? [])
    const authors = params.authorEntityIds ? new Set(params.authorEntityIds) : null
    const textNeedle = params.textContains?.toLowerCase()
    const filtered = res.rows
      .map((r) => rowToMemory(r, params.includeEmbedding !== false))
      .filter((m) => {
        if (params.entityId && m.entityId !== params.entityId) return false
        if (authors && !authors.has(m.entityId)) return false
        if (params.roomId && m.roomId !== params.roomId) return false
        if (excluded.has(m.roomId)) return false
        if (params.worldId && m.worldId !== params.worldId) return false
        if (params.unique && !m.unique) return false
        if (params.start !== undefined && (m.createdAt ?? 0) < params.start) return false
        if (params.end !== undefined && (m.createdAt ?? 0) > params.end) return false
        if (!matchesMetadataFilter(asRecord(m.metadata), params.metadata)) return false
        if (textNeedle) {
          const text = typeof m.content.text === "string" ? m.content.text.toLowerCase() : ""
          if (!text.includes(textNeedle)) return false
        }
        return memoryAllowedByAccess(m, params.accessContext)
      })
    const offset = params.offset ?? 0
    const limit = params.limit ?? params.count
    return limit !== undefined ? filtered.slice(offset, offset + limit) : filtered.slice(offset)
  }

  override async getMemoriesByRoomIds(params: {
    roomIds: UUID[]
    tableName: string
    limit?: number
    offset?: number
    textContains?: string
    includeEmbedding?: boolean
    accessContext?: AccessContext
  }): Promise<Memory[]> {
    if (params.roomIds.length === 0) return []
    const res = await this.sqlExecutor.query(
      "SELECT * FROM memories WHERE room_id = ANY($1::uuid[]) AND type = $2 ORDER BY created_at DESC",
      [params.roomIds, params.tableName],
    )
    const needle = params.textContains?.toLowerCase()
    const list = res.rows
      .map((r) => rowToMemory(r, params.includeEmbedding !== false))
      .filter((m) => {
        if (needle && !(typeof m.content.text === "string" && m.content.text.toLowerCase().includes(needle))) {
          return false
        }
        return memoryAllowedByAccess(m, params.accessContext)
      })
    const offset = params.offset ?? 0
    return params.limit !== undefined ? list.slice(offset, offset + params.limit) : list.slice(offset)
  }

  override async getMemoriesByWorldId(params: {
    worldIds?: UUID[]
    limit?: number
    tableName?: string
  }): Promise<Memory[]> {
    const res = params.worldIds?.length
      ? await this.sqlExecutor.query(
          "SELECT * FROM memories WHERE world_id = ANY($1::uuid[]) AND ($2::text IS NULL OR type = $2::text) ORDER BY created_at DESC",
          [params.worldIds, params.tableName ?? null],
        )
      : await this.sqlExecutor.query(
          "SELECT * FROM memories WHERE agent_id = $1 AND ($2::text IS NULL OR type = $2::text) ORDER BY created_at DESC",
          [this.agentId, params.tableName ?? null],
        )
    const rows = res.rows.map((r) => rowToMemory(r, false))
    return params.limit !== undefined ? rows.slice(0, params.limit) : rows
  }

  override async searchMemories(params: {
    tableName: string
    embedding: number[]
    includeEmbedding?: boolean
    excludeRoomIds?: UUID[]
    match_threshold?: number
    count?: number
    limit?: number
    offset?: number
    unique?: boolean
    query?: string
    roomId?: UUID
    worldId?: UUID
    entityId?: UUID
    accessContext?: AccessContext
  }): Promise<Memory[]> {
    const candidates = await this.getMemories({
      tableName: params.tableName,
      roomId: params.roomId,
      excludeRoomIds: params.excludeRoomIds,
      worldId: params.worldId,
      entityId: params.entityId,
      unique: params.unique,
      includeEmbedding: true,
      accessContext: params.accessContext,
    })
    const threshold = params.match_threshold ?? 0
    const scored = candidates
      .map((m) => {
        const emb = readEmbeddingVector(m.embedding, this.embeddingSpaceId)
        const similarity = emb ? cosineSimilarity(params.embedding, emb) : 0
        return { memory: m, similarity }
      })
      .filter((entry) => entry.similarity >= threshold)
      .sort((a, b) => b.similarity - a.similarity)
    const offset = params.offset ?? 0
    const limit = params.limit ?? params.count ?? 10
    return scored.slice(offset, offset + limit).map(({ memory, similarity }) => ({
      ...memory,
      ...(params.includeEmbedding === false ? { embedding: undefined } : {}),
      similarity,
    }))
  }

  override async searchMessages(params: {
    roomIds: UUID[]
    query: string
    tableName?: string
    limit?: number
    offset?: number
    since?: number
    until?: number
    accessContext?: AccessContext
  }): Promise<MessageSearchHit[]> {
    const memories = await this.getMemoriesByRoomIds({
      roomIds: params.roomIds,
      tableName: params.tableName ?? "messages",
      textContains: params.query,
      includeEmbedding: false,
      accessContext: params.accessContext,
    })
    const filtered = memories.filter((m) => {
      const ts = m.createdAt ?? 0
      if (params.since !== undefined && ts < params.since) return false
      if (params.until !== undefined && ts > params.until) return false
      return true
    })
    const offset = params.offset ?? 0
    const limit = params.limit ?? 20
    return filtered.slice(offset, offset + limit).map((memory) => ({
      memory,
      score: 1,
    })) as unknown as MessageSearchHit[]
  }

  override async getCachedEmbeddings(params: {
    query_table_name: string
    query_threshold: number
    query_input: string
    query_field_name: string
    query_field_sub_name: string
    query_match_count: number
  }): Promise<{ embedding: number[]; levenshtein_score: number }[]> {
    const memories = await this.getMemories({
      tableName: params.query_table_name,
      includeEmbedding: true,
    })
    const out: { embedding: number[]; levenshtein_score: number }[] = []
    for (const m of memories) {
      if (!m.embedding?.length) continue
      const text = typeof m.content.text === "string" ? m.content.text : ""
      if (text === params.query_input) {
        out.push({ embedding: m.embedding, levenshtein_score: 0 })
      }
      if (out.length >= params.query_match_count) break
    }
    return out
  }

  override async countMemories(params: {
    roomIds?: UUID[]
    unique?: boolean
    tableName?: string
  }): Promise<number> {
    const memories = await this.getMemories({
      tableName: params.tableName ?? "messages",
      unique: params.unique,
      includeEmbedding: false,
    })
    if (!params.roomIds?.length) return memories.length
    const wanted = new Set(params.roomIds)
    return memories.filter((m) => wanted.has(m.roomId)).length
  }

  override async getAllWorlds(): Promise<World[]> {
    const res = await this.sqlExecutor.query("SELECT * FROM worlds WHERE agent_id = $1", [this.agentId])
    return res.rows.map(rowToWorld)
