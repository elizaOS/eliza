  }

  private async writeRoomRow(r: Room, onConflictUpdate: boolean): Promise<UUID> {
    const id = r.id ?? randomUuid()
    const conflict = onConflictUpdate
      ? "ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, metadata = EXCLUDED.metadata"
      : "ON CONFLICT (id) DO NOTHING"
    await this.sqlExecutor.query(
      `INSERT INTO rooms (id, agent_id, name, source, type, channel_id, message_server_id, world_id, metadata, created_at)
       VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9::jsonb,$10) ${conflict}`,
      [
        id,
        this.agentId,
        r.name ?? null,
        r.source,
        r.type,
        r.channelId ?? null,
        r.messageServerId ?? null,
        r.worldId ?? null,
        encodeJsonb(r.metadata ?? {}, true),
        Date.now(),
      ],
    )
    return id
  }

  override async createRooms(rooms: Room[]): Promise<UUID[]> {
    const ids: UUID[] = []
    for (const r of rooms) {
      ids.push(await this.writeRoomRow(r, false))
    }
    return ids
  }

  override async upsertRooms(rooms: Room[]): Promise<void> {
    for (const r of rooms) {
      await this.writeRoomRow(r, true)
    }
  }

  override async updateRooms(rooms: Room[]): Promise<void> {
    for (const r of rooms) {
      await this.sqlExecutor.query(
        "UPDATE rooms SET name = $2, metadata = $3::jsonb WHERE id = $1",
        [r.id, r.name ?? null, encodeJsonb(r.metadata ?? {}, true)],
      )
    }
  }

  override async deleteRooms(roomIds: UUID[]): Promise<void> {
    if (roomIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM rooms WHERE id = ANY($1::uuid[])", [roomIds])
  }

  override async deleteRoomsByWorldIds(worldIds: UUID[]): Promise<void> {
    if (worldIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM rooms WHERE world_id = ANY($1::uuid[])", [worldIds])
  }

  override async getRoomsForParticipants(entityIds: UUID[]): Promise<UUID[]> {
    if (entityIds.length === 0) return []
    const res = await this.sqlExecutor.query(
      "SELECT DISTINCT room_id FROM participants WHERE entity_id = ANY($1::uuid[])",
      [entityIds],
    )
    return res.rows.map((r) => String(r.room_id) as UUID)
  }

  override async createRoomParticipants(entityIds: UUID[], roomId: UUID): Promise<UUID[]> {
    const ids: UUID[] = []
    const now = Date.now()
    for (const entityId of entityIds) {
      const id = randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO participants (id, entity_id, room_id, agent_id, created_at)
         VALUES ($1,$2,$3,$4,$5) ON CONFLICT (entity_id, room_id, agent_id) DO NOTHING`,
        [id, entityId, roomId, this.agentId, now],
      )
      ids.push(id)
    }
    return ids
  }

  override async deleteParticipants(participants: Array<{ entityId: UUID; roomId: UUID }>): Promise<boolean> {
    let deleted = false
    for (const p of participants) {
      const res = await this.sqlExecutor.query(
        "DELETE FROM participants WHERE entity_id = $1 AND room_id = $2 AND agent_id = $3",
        [p.entityId, p.roomId, this.agentId],
      )
      if ((res.affectedRows ?? 0) > 0) deleted = true
    }
    return deleted
  }

  override async updateParticipants(
    participants: Array<{ entityId: UUID; roomId: UUID; updates: { roomState?: "FOLLOWED" | "MUTED" | null } }>,
  ): Promise<void> {
    for (const p of participants) {
      await this.sqlExecutor.query(
        "UPDATE participants SET room_state = $1 WHERE entity_id = $2 AND room_id = $3 AND agent_id = $4",
        [p.updates.roomState ?? null, p.entityId, p.roomId, this.agentId],
      )
    }
  }

  override async getParticipantsForEntities(entityIds: UUID[]): Promise<Participant[]> {
    if (entityIds.length === 0) return []
    const res = await this.sqlExecutor.query(
      "SELECT * FROM participants WHERE entity_id = ANY($1::uuid[])",
      [entityIds],
    )
    const entities = await this.getEntitiesByIds(entityIds)
    const byId = new Map(entities.map((e) => [e.id, e]))
    return res.rows
      .map((r) => {
        const entity = byId.get(String(r.entity_id) as UUID)
        return entity ? { id: String(r.id) as UUID, entity } : null
      })
      .filter((p): p is Participant => p !== null)
  }

  override async getParticipantsForRooms(roomIds: UUID[]): Promise<Array<{ roomId: UUID; entityIds: UUID[] }>> {
    if (roomIds.length === 0) return []
    const res = await this.sqlExecutor.query(
      "SELECT room_id, entity_id FROM participants WHERE room_id = ANY($1::uuid[])",
      [roomIds],
    )
    return roomIds.map((roomId) => ({
      roomId,
      entityIds: res.rows
        .filter((r) => String(r.room_id) === roomId)
        .map((r) => String(r.entity_id) as UUID),
    }))
  }

  override async areRoomParticipants(pairs: Array<{ roomId: UUID; entityId: UUID }>): Promise<boolean[]> {
    const out: boolean[] = []
    for (const pair of pairs) {
      const res = await this.sqlExecutor.query(
        "SELECT 1 FROM participants WHERE room_id = $1 AND entity_id = $2 LIMIT 1",
        [pair.roomId, pair.entityId],
      )
      out.push(res.rows.length > 0)
    }
    return out
  }

  override async getParticipantUserStates(
    pairs: Array<{ roomId: UUID; entityId: UUID }>,
  ): Promise<Array<"FOLLOWED" | "MUTED" | null>> {
    const out: Array<"FOLLOWED" | "MUTED" | null> = []
    for (const pair of pairs) {
      const res = await this.sqlExecutor.query(
        "SELECT room_state FROM participants WHERE room_id = $1 AND entity_id = $2 LIMIT 1",
        [pair.roomId, pair.entityId],
      )
      const state = res.rows[0]?.room_state
      out.push(state === "FOLLOWED" || state === "MUTED" ? state : null)
    }
    return out
  }

  override async updateParticipantUserStates(
    updates: Array<{ roomId: UUID; entityId: UUID; state: "FOLLOWED" | "MUTED" | null }>,
  ): Promise<void> {
    await this.updateParticipants(
      updates.map((u) => ({ roomId: u.roomId, entityId: u.entityId, updates: { roomState: u.state } })),
    )
  }

  override async createRelationships(
    relationships: Array<{
      sourceEntityId: UUID
      targetEntityId: UUID
      tags?: string[]
      metadata?: Metadata
    }>,
  ): Promise<UUID[]> {
    const ids: UUID[] = []
    const now = Date.now()
    for (const rel of relationships) {
      const id = randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO relationships (id, source_entity_id, target_entity_id, agent_id, tags, metadata, created_at)
         VALUES ($1,$2,$3,$4,$5::jsonb,$6::jsonb,$7)
         ON CONFLICT (source_entity_id, target_entity_id, agent_id) DO UPDATE SET tags = EXCLUDED.tags, metadata = EXCLUDED.metadata`,
        [
          id,
          rel.sourceEntityId,
          rel.targetEntityId,
          this.agentId,
          encodeJsonb(rel.tags ?? []),
          encodeJsonb(rel.metadata ?? {}, true),
          now,
        ],
      )
      ids.push(id)
    }
    return ids
  }

  override async getRelationshipsByIds(relationshipIds: UUID[]): Promise<Relationship[]> {
    if (relationshipIds.length === 0) return []
    const res = await this.sqlExecutor.query(
      "SELECT * FROM relationships WHERE id = ANY($1::uuid[])",
      [relationshipIds],
    )
    return res.rows.map(rowToRelationship)
  }

  override async getRelationshipsByPairs(
    pairs: Array<{ sourceEntityId: UUID; targetEntityId: UUID }>,
  ): Promise<(Relationship | null)[]> {
    const out: (Relationship | null)[] = []
    for (const pair of pairs) {
      const res = await this.sqlExecutor.query(
        "SELECT * FROM relationships WHERE source_entity_id = $1 AND target_entity_id = $2 AND agent_id = $3 LIMIT 1",
        [pair.sourceEntityId, pair.targetEntityId, this.agentId],
      )
      out.push(res.rows[0] ? rowToRelationship(res.rows[0]) : null)
    }
    return out
  }

  override async getRelationships(params: {
    entityIds?: UUID[]
    tags?: string[]
    limit?: number
    offset?: number
  }): Promise<Relationship[]> {
    const res = await this.sqlExecutor.query("SELECT * FROM relationships WHERE agent_id = $1", [this.agentId])
    let list = res.rows.map(rowToRelationship)
    if (params.entityIds?.length) {
      const set = new Set(params.entityIds)
      list = list.filter((r) => set.has(r.sourceEntityId) || set.has(r.targetEntityId))
    }
    if (params.tags?.length) {
      list = list.filter((r) => params.tags!.every((tag) => r.tags.includes(tag)))
    }
    const offset = params.offset ?? 0
    return params.limit !== undefined ? list.slice(offset, offset + params.limit) : list.slice(offset)
  }

  override async updateRelationships(relationships: Relationship[]): Promise<void> {
    for (const rel of relationships) {
      await this.sqlExecutor.query(
        "UPDATE relationships SET tags = $2::jsonb, metadata = $3::jsonb WHERE id = $1",
        [rel.id, encodeJsonb(rel.tags ?? []), encodeJsonb(rel.metadata ?? {}, true)],
      )
    }
  }

  override async deleteRelationships(relationshipIds: UUID[]): Promise<void> {
    if (relationshipIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM relationships WHERE id = ANY($1::uuid[])", [relationshipIds])
  }

  override async createLogs(
    params: Array<{ body: LogBody; entityId: UUID; roomId: UUID; type: string; createdAt?: Date }>,
  ): Promise<void> {
    const now = Date.now()
    for (const item of params) {
      await this.sqlExecutor.query(
        "INSERT INTO logs (id, entity_id, room_id, type, body, created_at) VALUES ($1,$2,$3,$4,$5::jsonb,$6)",
        [
          randomUuid(),
          item.entityId,
          item.roomId,
          item.type,
          encodeJsonb(item.body),
          item.createdAt ? item.createdAt.getTime() : now,
        ],
      )
    }
  }

  override async getLogs(params: {
    entityId?: UUID
    roomId?: UUID
    type?: string
    limit?: number
    offset?: number
  }): Promise<Log[]> {
    const res = await this.sqlExecutor.query(
      `SELECT * FROM logs
       WHERE ($1::uuid IS NULL OR entity_id = $1::uuid)
         AND ($2::uuid IS NULL OR room_id = $2::uuid)
         AND ($3::text IS NULL OR type = $3::text)
       ORDER BY created_at DESC`,
      [params.entityId ?? null, params.roomId ?? null, params.type ?? null],
    )
    const offset = params.offset ?? 0
    const list = res.rows.map(rowToLog)
    return params.limit !== undefined ? list.slice(offset, offset + params.limit) : list.slice(offset)
  }

  override async getLogInventory(params: { excludeTypes?: readonly string[] }): Promise<LogInventoryRow[]> {
    const res = await this.sqlExecutor.query(
      "SELECT type, count(*)::int AS total, max(created_at) AS latest FROM logs GROUP BY type",
    )
    const excluded = new Set(params.excludeTypes ?? [])
    return res.rows
      .filter((r) => !excluded.has(String(r.type)))
      .map((r) => ({
        type: String(r.type),
        count: Number(r.total),
        latestCreatedAt: new Date(Number(r.latest)),
      })) as unknown as LogInventoryRow[]
  }

  override async getLogsByIds(logIds: UUID[]): Promise<Log[]> {
    if (logIds.length === 0) return []
    const res = await this.sqlExecutor.query("SELECT * FROM logs WHERE id = ANY($1::uuid[])", [logIds])
    return res.rows.map(rowToLog)
  }

  override async updateLogs(logs: Array<{ id: UUID; updates: Partial<Log> }>): Promise<void> {
    for (const item of logs) {
      if (item.updates.body) {
        await this.sqlExecutor.query("UPDATE logs SET body = $2::jsonb WHERE id = $1", [
          item.id,
          encodeJsonb(item.updates.body),
        ])
      }
    }
  }

  override async deleteLogs(logIds: UUID[]): Promise<void> {
    if (logIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM logs WHERE id = ANY($1::uuid[])", [logIds])
  }

  override async getCaches<T>(keys: string[]): Promise<Map<string, T>> {
    const out = new Map<string, T>()
    if (keys.length === 0) return out
    const res = await this.sqlExecutor.query(
      "SELECT key, value FROM cache WHERE agent_id = $1 AND key = ANY($2::text[])",
      [this.agentId, keys],
    )
    for (const row of res.rows) {
      out.set(String(row.key), row.value as T)
    }
    return out
  }

  override async setCaches<T>(entries: Array<{ key: string; value: T }>): Promise<boolean> {
    const now = Date.now()
    for (const entry of entries) {
      await this.sqlExecutor.query(
        `INSERT INTO cache (key, agent_id, value, created_at)
         VALUES ($1,$2,$3::jsonb,$4)
         ON CONFLICT (key, agent_id) DO UPDATE SET value = EXCLUDED.value, created_at = EXCLUDED.created_at`,
        [entry.key, this.agentId, encodeJsonb(entry.value, true), now],
      )
    }
    return true
  }

  override async deleteCaches(keys: string[]): Promise<boolean> {
    if (keys.length === 0) return true
    await this.sqlExecutor.query("DELETE FROM cache WHERE agent_id = $1 AND key = ANY($2::text[])", [
      this.agentId,
      keys,
    ])
    return true
  }

  override compareAndSetCache<T>(key: string, expected: unknown, replacement: T): Promise<boolean> {
    return compareAndSetSqlCache(this.sqlExecutor, this.agentId, key, expected, replacement)
  }

  override async createTasks(tasks: Task[]): Promise<UUID[]> {
    const ids: UUID[] = []
    const now = Date.now()
    for (const task of tasks) {
      const id = task.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO tasks (id, name, description, room_id, world_id, entity_id, agent_id, tags, metadata, created_at, updated_at)
         VALUES ($1,$2,$3,$4,$5,$6,$7,$8::jsonb,$9::jsonb,$10,$10)`,
        [
          id,
          task.name,
          task.description ?? "",
          task.roomId ?? null,
          task.worldId ?? null,
          task.entityId ?? null,
          this.agentId,
          encodeJsonb(task.tags ?? []),
          encodeJsonb(task.metadata ?? {}, true),
          now,
        ],
      )
      ids.push(id)
    }
    return ids
  }

  override async getTasks(params: {
    roomId?: UUID
    worldId?: UUID
    tags?: string[]
    entityId?: UUID
    agentIds: UUID[]
    limit?: number
    offset?: number
  }): Promise<Task[]> {
    const res = await this.sqlExecutor.query(
      `SELECT * FROM tasks
       WHERE agent_id = ANY($1::uuid[])
         AND ($2::uuid IS NULL OR room_id = $2::uuid)
         AND ($3::uuid IS NULL OR world_id = $3::uuid)
         AND ($4::uuid IS NULL OR entity_id = $4::uuid)
       ORDER BY created_at ASC`,
      [params.agentIds.length ? params.agentIds : [this.agentId], params.roomId ?? null, params.worldId ?? null, params.entityId ?? null],
    )
    let list = res.rows.map(rowToTask)
    if (params.tags?.length) {
      list = list.filter((t) => params.tags!.every((tag) => t.tags?.includes(tag)))
    }
    const offset = params.offset ?? 0
    return params.limit !== undefined ? list.slice(offset, offset + params.limit) : list.slice(offset)
  }

  override async getTasksByName(name: string): Promise<Task[]> {
    const res = await this.sqlExecutor.query(
      "SELECT * FROM tasks WHERE agent_id = $1 AND name = $2",
      [this.agentId, name],
    )
    return res.rows.map(rowToTask)
  }

  override async getTasksByIds(taskIds: UUID[]): Promise<Task[]> {
    if (taskIds.length === 0) return []
    const res = await this.sqlExecutor.query("SELECT * FROM tasks WHERE id = ANY($1::uuid[])", [taskIds])
    return res.rows.map(rowToTask)
  }

  override async updateTasks(updates: Array<{ id: UUID; task: Partial<Task> }>): Promise<void> {
    const now = Date.now()
    for (const u of updates) {
      const existing = (await this.getTasksByIds([u.id]))[0]
      if (!existing) continue
      const merged = { ...existing, ...u.task }
      await this.sqlExecutor.query(
        `UPDATE tasks SET name=$2, description=$3, tags=$4::jsonb, metadata=$5::jsonb, updated_at=$6 WHERE id = $1`,
        [
          u.id,
          merged.name,
          merged.description ?? "",
          encodeJsonb(merged.tags ?? []),
          encodeJsonb(merged.metadata ?? {}, true),
          now,
        ],
      )
    }
  }

  override async deleteTasks(taskIds: UUID[]): Promise<void> {
    if (taskIds.length === 0) return
    await this.sqlExecutor.query("DELETE FROM tasks WHERE id = ANY($1::uuid[])", [taskIds])
  }

  override getPairingRequests(queries: PairingRequestQuery[]) {
    return listSqlPairingRequests(this.sqlExecutor, queries)
  }

  override getPairingAllowlists(queries: PairingAllowlistQuery[]) {
    return listSqlPairingAllowlists(this.sqlExecutor, queries)
  }

  override async createPairingRequests(requests: PairingRequest[]): Promise<UUID[]> {
    const ids: UUID[] = []
    for (const req of requests) {
      const id = req.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO pairing_requests (id, channel, sender_id, code, agent_id, metadata, created_at, last_seen_at)
         VALUES ($1,$2,$3,$4,$5,$6::jsonb,$7,$8)`,
        [
          id,
          req.channel,
          req.senderId,
          req.code,
          req.agentId,
          encodeJsonb(req.metadata ?? {}),
          req.createdAt.getTime(),
          req.lastSeenAt.getTime(),
        ],
      )
      ids.push(id)
    }
    return ids
  }

  override async updatePairingRequests(requests: PairingRequest[]): Promise<void> {
    for (const req of requests) {
      await this.sqlExecutor.query(
        "UPDATE pairing_requests SET code=$2, metadata=$3::jsonb, last_seen_at=$4 WHERE id = $1",
        [req.id, req.code, encodeJsonb(req.metadata ?? {}), req.lastSeenAt.getTime()],
      )
    }
  }

  override async deletePairingRequests(ids: UUID[]): Promise<void> {
    if (ids.length === 0) return
    await this.sqlExecutor.query("DELETE FROM pairing_requests WHERE id = ANY($1::uuid[])", [ids])
  }

  override async createPairingAllowlistEntries(entries: PairingAllowlistEntry[]): Promise<UUID[]> {
    const ids: UUID[] = []
    for (const entry of entries) {
      const id = entry.id ?? randomUuid()
      await this.sqlExecutor.query(
        `INSERT INTO pairing_allowlist (id, channel, sender_id, agent_id, metadata, created_at)
         VALUES ($1,$2,$3,$4,$5::jsonb,$6)`,
        [
          id,
          entry.channel,
          entry.senderId,
          entry.agentId,
          encodeJsonb(entry.metadata ?? {}),
          entry.createdAt.getTime(),
        ],
      )
      ids.push(id)
    }
    return ids
  }

  override async updatePairingAllowlistEntries(entries: PairingAllowlistEntry[]): Promise<void> {
    for (const entry of entries) {
      await this.sqlExecutor.query("UPDATE pairing_allowlist SET metadata = $2::jsonb WHERE id = $1", [
        entry.id,
        encodeJsonb(entry.metadata ?? {}),
      ])
    }
  }

  override async deletePairingAllowlistEntries(ids: UUID[]): Promise<void> {
    if (ids.length === 0) return
    await this.sqlExecutor.query("DELETE FROM pairing_allowlist WHERE id = ANY($1::uuid[])", [ids])
  }

  override listConnectorAccounts(params?: ListConnectorAccountsParams) {
    return listSqlConnectorAccounts(this.sqlExecutor, this.agentId, params)
  }

  override getConnectorAccount(params: GetConnectorAccountParams) {
    return getSqlConnectorAccount(this.sqlExecutor, this.agentId, params)
  }

  override upsertConnectorAccount(params: UpsertConnectorAccountParams) {
    return upsertSqlConnectorAccount(this.sqlExecutor, this.agentId, params)
  }

  override deleteConnectorAccount(params: DeleteConnectorAccountParams) {
    return deleteSqlConnectorAccount(this.sqlExecutor, this.agentId, params)
  }

  override setConnectorAccountCredentialRef(params: SetConnectorAccountCredentialRefParams) {
    return setSqlConnectorCredentialRef(this.sqlExecutor, this.agentId, params)
  }

  override getConnectorAccountCredentialRef(params: GetConnectorAccountCredentialRefParams) {
    return getSqlConnectorCredentialRef(this.sqlExecutor, this.agentId, params)
  }

  override listConnectorAccountCredentialRefs(params: ListConnectorAccountCredentialRefsParams) {
    return listSqlConnectorCredentialRefs(this.sqlExecutor, this.agentId, params)
  }

  override deleteConnectorAccountCredentialRefs(params: DeleteConnectorAccountCredentialRefsParams) {
    return deleteSqlConnectorCredentialRefs(this.sqlExecutor, this.agentId, params)
  }

  override appendConnectorAccountAuditEvent(params: AppendConnectorAccountAuditEventParams) {
    return appendSqlConnectorAuditEvent(this.sqlExecutor, this.agentId, params)
  }

  override createOAuthFlowState(params: CreateOAuthFlowStateParams) {
    return createSqlOAuthFlowState(this.sqlExecutor, this.agentId, params)
  }

  override getOAuthFlowState(params: GetOAuthFlowStateParams) {
    return getSqlOAuthFlowState(this.sqlExecutor, this.agentId, params)
  }

  override consumeOAuthFlowState(params: ConsumeOAuthFlowStateParams) {
    return consumeSqlOAuthFlowState(this.sqlExecutor, this.agentId, params)
  }

  override updateOAuthFlowState(params: UpdateOAuthFlowStateParams) {
    return updateSqlOAuthFlowState(this.sqlExecutor, this.agentId, params)
  }

  override deleteOAuthFlowState(params: DeleteOAuthFlowStateParams) {
    return deleteSqlOAuthFlowState(this.sqlExecutor, this.agentId, params)
  }
}

export class PgliteDatabaseAdapter extends BaseSqlDatabaseAdapter<SqlExecutor> {
  private readonly manager: PGliteClientManager

  constructor(agentId: UUID, manager: PGliteClientManager, executor?: SqlExecutor) {
    super(agentId, executor ?? manager, "PgliteBackend")
    this.manager = manager
  }

  protected override createTransactionAdapter(tx: SqlExecutor): BaseSqlDatabaseAdapter<SqlExecutor> {
    return new PgliteDatabaseAdapter(this.agentId, this.manager, tx)
  }

  protected override closeBackend(): Promise<void> {
    return this.manager.close()
  }

  protected override async rawConnection(): Promise<SqlExecutor> {
    await this.manager.initialize()
    return this.sqlExecutor
  }
}

export class PgDatabaseAdapter extends BaseSqlDatabaseAdapter<SqlExecutor> {
  private readonly manager: PostgresConnectionManager

  constructor(
    agentId: UUID,
    manager: PostgresConnectionManager,
    options?: { serverId?: UUID; executor?: SqlExecutor },
  ) {
    super(agentId, options?.executor ?? manager, "PgBackend", options?.serverId)
    this.manager = manager
  }

  protected override createTransactionAdapter(tx: SqlExecutor): BaseSqlDatabaseAdapter<SqlExecutor> {
    return new PgDatabaseAdapter(this.agentId, this.manager, {
      serverId: this.serverId,
      executor: tx,
    })
  }

  protected override closeBackend(): Promise<void> {
    return this.manager.close()
  }

  protected override rawConnection(): Promise<SqlExecutor> {
    return Promise.resolve(this.sqlExecutor)
  }
}

export function createDatabaseAdapter(
  config: SqlAdapterConfig,
  agentId: UUID,
): PgliteDatabaseAdapter | PgDatabaseAdapter {
  if (config.postgresUrl && config.postgresUrl.trim() !== "") {
    const manager = new PostgresConnectionManager(config.postgresUrl, {
      serverId: config.serverId,
      max: config.maxPoolSize,
    })
    return new PgDatabaseAdapter(agentId, manager, { serverId: config.serverId })
  }
  const manager = new PGliteClientManager({ dataDir: config.dataDir ?? "memory://" })
  return new PgliteDatabaseAdapter(agentId, manager)
}
