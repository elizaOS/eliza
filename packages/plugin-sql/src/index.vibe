// spec/sql/index.md, "Story: Attach a SQL adapter only after its schema is ready"
import { classifyMigration, sqlReady, sqlScopeAllows, type MigrationEntry, type SqlActor, type SqlRecordScope } from "../gen/sql.effect.vibe"
import { PGlite, type Transaction } from "@electric-sql/pglite"
import { vector } from "@electric-sql/pglite/vector"

export error SqlMigrationFailed { reason: string }

export interface SqlMigration extends MigrationEntry {
  readonly sql: string
}

export interface MigrationTransaction {
  ledger(): MigrationEntry[]!SqlMigrationFailed
  apply(migration: SqlMigration): void!SqlMigrationFailed
  vectorInstalled(): boolean!SqlMigrationFailed
  tenantPoliciesReady(): boolean!SqlMigrationFailed
}

export service SqlMigrationStore {
  exclusive<A, E, R>(run: (transaction: MigrationTransaction) => A!E!R): A!(E | SqlMigrationFailed)!R
}

export effect function prepareSqlStore(desired: readonly SqlMigration[]) {
  if (desired.some((migration, index) => migration.revision !== index + 1 || migration.checksum === "" || migration.sql === "")) {
    throw new SqlMigrationFailed({ reason: "invalid migration sequence" })
  }
  const store = try SqlMigrationStore
  return try store.exclusive(effect (transaction) => {
    const expected = desired.map(({ revision, checksum }) => ({ revision, checksum }))
    const applied = try transaction.ledger()
    const status = classifyMigration(applied, expected)
    if (status === "MigrationConflict") throw new SqlMigrationFailed({ reason: "applied migrations differ from the requested history" })
    for (const migration of desired.slice(applied.length)) {
      try transaction.apply(migration)
    }
    const settled = try transaction.ledger()
    if (!sqlReady(settled, expected, try transaction.vectorInstalled(), try transaction.tenantPoliciesReady())) {
      throw new SqlMigrationFailed({ reason: "schema, extension, or tenant policy is not ready" })
    }
    return settled
  })
}

export function sqlRecordVisible(actor: SqlActor, record: SqlRecordScope) {
  return sqlScopeAllows(actor, record)
}

const ledgerSchema = Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({
  revision: Schema.Int,
  checksum: Schema.NonEmptyString,
})))

const countsSchema = Schema.decodeUnknownEffect(Schema.Array(Schema.Struct({ matched: Schema.Int })))

function embeddedTransaction(tx: Transaction, tenantTables: readonly string[]): MigrationTransaction {
  return {
    effect ledger() {
      const stored = try tryPromise({
        try: () => tx.query("SELECT revision, checksum FROM eliza_plugin_sql_migrations ORDER BY revision"),
        catch: () => new SqlMigrationFailed({ reason: "migration ledger read failed" }),
      })
      const entries = ledgerSchema(stored.rows) catch effect () => {
        throw new SqlMigrationFailed({ reason: "migration ledger has malformed rows" })
      }
      return [...entries]
    },
    effect apply(migration) {
      try tryPromise({
        try: async () => {
          await tx.exec(migration.sql)
          await tx.query("INSERT INTO eliza_plugin_sql_migrations (revision, checksum) VALUES ($1, $2)", [migration.revision, migration.checksum])
        },
        catch: () => new SqlMigrationFailed({ reason: "migration statement failed" }),
      })
    },
    effect vectorInstalled() {
      const result = try tryPromise({
        try: () => tx.query("SELECT count(*)::int AS matched FROM pg_catalog.pg_extension WHERE extname = 'vector'"),
        catch: () => new SqlMigrationFailed({ reason: "extension catalog read failed" }),
      })
      const decoded = countsSchema(result.rows) catch () => []
      return decoded[0]?.matched === 1
    },
    effect tenantPoliciesReady() {
      const expected = [...new Set(tenantTables)]
      if (expected.length === 0) return true
      const result = try tryPromise({
        try: () => tx.query(
          "SELECT count(*)::int AS matched FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'public' AND c.relname = ANY($1::text[]) AND c.relrowsecurity AND EXISTS (SELECT 1 FROM pg_catalog.pg_policy p WHERE p.polrelid = c.oid)",
          [expected],
        ),
        catch: () => new SqlMigrationFailed({ reason: "tenant policy catalog read failed" }),
      })
      const decoded = countsSchema(result.rows) catch () => []
      return decoded[0]?.matched === expected.length
    },
  }
}

export effect function prepareEmbeddedPostgres(dataDir: string, tenantTables: readonly string[], desired: readonly SqlMigration[]) {
  const db = try tryPromise({
    try: () => PGlite.create({ dataDir, extensions: { vector } }),
    catch: () => new SqlMigrationFailed({ reason: "PGlite open failed" }),
  })
  return try ensuring(tryPromise({
    try: () => db.transaction(async (tx) => {
      await tx.exec("CREATE EXTENSION IF NOT EXISTS vector")
      await tx.exec("CREATE TABLE IF NOT EXISTS eliza_plugin_sql_migrations (revision integer PRIMARY KEY, checksum text NOT NULL)")
      const transaction = embeddedTransaction(tx, tenantTables)
      const store: SqlMigrationStore.Shape = { exclusive: (run) => run(transaction) }
      return await runPromise(Effect.provideService(prepareSqlStore(desired), SqlMigrationStore, store))
    }),
    catch: () => new SqlMigrationFailed({ reason: "PGlite preparation failed" }),
  }), effect { tryPromise(() => db.close()) catch () => undefined })
}
