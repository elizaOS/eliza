// spec/meetings/index.md, "Story: Join a meeting as a disclosed transcription guest"; spec/meetings/urlAndDisclosure.md, "Story: Enforce HTTPS provider matching, fail-closed transcript disclosure, and clean segment admission"
import type { IAgentRuntime, Plugin } from "@elizaos/core"
import { Machine, stored, type MeetingProvider, type TranscriptSegment } from "../gen/meetings.effect.vibe"
import {
  activeMeetingsProvider,
  getMeetingTranscriptAction,
  joinMeetingAction,
  leaveMeetingAction,
  meetingsRoutes,
  type MeetingsRouteDescriptor,
} from "./actions.vibe"
import { MeetingService, getMeetingService } from "./service.vibe"
import { shouldEnableMeetings } from "./url-and-disclosure.vibe"

export error MeetingProviderFailure { sessionKey: string; operation: string; reason: string }
export error MeetingIdentityMissing

export interface MeetingRequest {
  readonly ownerId: string
  readonly sessionKey: string
  readonly provider: MeetingProvider
  readonly verifiedJoinUrl: string
}

export service MeetingTransport {
  waitForAdmission(request: MeetingRequest): boolean!MeetingProviderFailure
  disclose(request: MeetingRequest): boolean!MeetingProviderFailure
  stop(request: MeetingRequest): void!MeetingProviderFailure
  saveTranscript(request: MeetingRequest, transcript: readonly TranscriptSegment[]): void!MeetingProviderFailure
}

export effect function captureMeeting(request: MeetingRequest) {
  const key = try meetingKey(request.ownerId, request.sessionKey)
  const transport = try MeetingTransport
  provide stored(key) {
    const meeting = try Machine
    try meeting.send({ type: "requestJoin", sessionKey: request.sessionKey, provider: request.provider })
    const accepted = try transport.waitForAdmission(request)
    const admitted = try meeting.send({ type: "observeJoin", sessionKey: request.sessionKey, accepted })
    if (admitted.capturePhase !== "Admitted") return admitted
    const disclosed = try transport.disclose(request)
    return try meeting.send({ type: "observeDisclosure", sessionKey: request.sessionKey, disclosed })
  }
}

export effect function keepTranscriptSegment(ownerId: string, sessionKey: string, segment: unknown) {
  const key = try meetingKey(ownerId, sessionKey)
  provide stored(key) {
    return try (try Machine).receive({ type: "appendSegment", sessionKey, segment })
  }
}

export effect function finishMeeting(request: MeetingRequest) {
  const key = try meetingKey(request.ownerId, request.sessionKey)
  const transport = try MeetingTransport
  provide stored(key) {
    const meeting = try Machine
    const snapshot = try meeting.get()
    if (snapshot.capturePhase === "CompleteMeeting") return snapshot
    const finalizing =
      snapshot.capturePhase === "Finalizing"
        ? snapshot
        : try meeting.send({ type: "stopCapture", sessionKey: request.sessionKey })
    try transport.stop(request)
    try transport.saveTranscript(request, finalizing.transcript)
    return try meeting.send({ type: "finishTranscript", sessionKey: request.sessionKey, saved: true })
  }
}

export effect function getMeetingTranscript(ownerId: string, sessionKey: string) {
  const key = try meetingKey(ownerId, sessionKey)
  provide stored(key) {
    return (try (try Machine).get()).transcript
  }
}

effect function meetingKey(ownerId: string, sessionKey: string) {
  if (ownerId === "" || sessionKey === "") throw new MeetingIdentityMissing()
  return "meeting:" + ownerId.length + ":" + ownerId + ":" + sessionKey
}

export type MeetingsPlugin = Plugin & {
  readonly routes: readonly MeetingsRouteDescriptor[]
  readonly dispose: (runtime: IAgentRuntime) => Promise<void>
}

export const meetingsPlugin: MeetingsPlugin = {
  name: "@elizaos/plugin-meetings",
  description: "Meeting transcription for Google Meet, Microsoft Teams, and Zoom with disclosed guest capture and Zoom cloud import",
  services: [MeetingService],
  actions: [joinMeetingAction, leaveMeetingAction, getMeetingTranscriptAction],
  providers: [activeMeetingsProvider],
  routes: meetingsRoutes,
  autoEnable: {
    shouldEnable: (env, config) =>
      shouldEnableMeetings({
        env,
        config,
        isNativePlatform: env.CAPACITOR_PLATFORM === "ios" || env.CAPACITOR_PLATFORM === "android",
      }),
  },
  dispose: async (runtime: IAgentRuntime): Promise<void> => {
    const svc = getMeetingService(runtime)
    if (svc) await svc.stop()
  },
}

export default meetingsPlugin

export * from "./types.vibe"
export * from "./url-and-disclosure.vibe"
export * from "./pipeline.vibe"
export * from "./transcript-writer.vibe"
export * from "./service.vibe"
export * from "./actions.vibe"
