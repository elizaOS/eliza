{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,
    "paths": {},
    "types": ["node", "bun"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**", "test/**/*"]
}
