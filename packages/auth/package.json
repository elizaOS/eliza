  "scripts": {
    "clean": "node ../scripts/rm-path-recursive.ts dist",
    "prepublishOnly": "bun run build",
    "build": "bun run clean && tsc6 --noCheck -p tsconfig.build.json && bun scripts/copy-assets.ts && node ../scripts/prepare-package-dist.ts packages/auth && node ../scripts/rewrite-dist-relative-imports-node-esm.ts packages/auth",
    "test": "bun run build && bun run test:credentials && bun run test:login && bun run test:native-host",
    "test:watch": "node ../scripts/run-vitest.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vault.json && tsc --noEmit -p tsconfig.login.json",
    "lint": "biome check src test scripts native-host",
    "lint:check": "biome check src test scripts native-host",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "start:embedded": "bun src/server/embedded.ts",
    "start": "bun src/server/start.ts",
    "test:railpack": "bun test test/login/railpack-runtime.test.ts",
    "test:browser": "bun run build && bun test test/login/browser-login.test.ts",
    "test:credentials": "node ../scripts/run-vitest.ts run",
    "test:login": "bun test --timeout 30000 --isolate src/sdk/__tests__ src/server/__tests__ && bun run test:railpack",
    "test:native-host": "node --test native-host/*.test.mjs native-host/staging-acceptance.process-test.mjs",
    "test:postgres": "LOGIN_REQUIRE_POSTGRES_TESTS=1 bun test src/server/__tests__/postgres-login.integration.test.ts",
    "test:integration": "bun run test:browser && bun run test:postgres"
  },
