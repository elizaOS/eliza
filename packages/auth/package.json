{
  "name": "@elizaos/auth",
  "version": "2.0.3-beta.7",
  "description": "Leaf auth package for Eliza agents: account credential storage, OAuth/subscription flows, direct-API-key probing, and refresh coordination. Sits below @elizaos/agent and @elizaos/app-core so both consume it without a dependency cycle.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/elizaOS/eliza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elizaOS/eliza.git",
    "directory": "packages/auth"
  },
  "keywords": [
    "elizaos",
    "auth",
    "credentials",
    "oauth"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "eliza-source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "bun": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./account-storage": {
      "types": "./dist/account-storage.d.ts",
      "eliza-source": {
        "types": "./src/account-storage.ts",
        "import": "./src/account-storage.ts",
        "default": "./src/account-storage.ts"
      },
      "bun": {
        "types": "./src/account-storage.ts",
        "import": "./src/account-storage.ts",
        "default": "./src/account-storage.ts"
      },
      "import": "./dist/account-storage.js",
      "default": "./dist/account-storage.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "eliza-source": "./src/anthropic.ts",
      "bun": "./src/anthropic.ts",
      "import": "./dist/anthropic.js",
      "default": "./dist/anthropic.js"
    },
    "./codex-usage": {
      "types": "./dist/codex-usage.d.ts",
      "eliza-source": "./src/codex-usage.ts",
      "bun": "./src/codex-usage.ts",
      "import": "./dist/codex-usage.js",
      "default": "./dist/codex-usage.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "eliza-source": "./src/credentials.ts",
      "bun": "./src/credentials.ts",
      "import": "./dist/credentials.js",
      "default": "./dist/credentials.js"
    },
    "./direct-api-probe": {
      "types": "./dist/direct-api-probe.d.ts",
      "eliza-source": "./src/direct-api-probe.ts",
      "bun": "./src/direct-api-probe.ts",
      "import": "./dist/direct-api-probe.js",
      "default": "./dist/direct-api-probe.js"
    },
    "./oauth-flow": {
      "types": "./dist/oauth-flow.d.ts",
      "eliza-source": "./src/oauth-flow.ts",
      "bun": "./src/oauth-flow.ts",
      "import": "./dist/oauth-flow.js",
      "default": "./dist/oauth-flow.js"
    },
    "./openai-codex": {
      "types": "./dist/openai-codex.d.ts",
      "eliza-source": "./src/openai-codex.ts",
      "bun": "./src/openai-codex.ts",
      "import": "./dist/openai-codex.js",
      "default": "./dist/openai-codex.js"
    },
    "./refresh-mutex": {
      "types": "./dist/refresh-mutex.d.ts",
      "eliza-source": "./src/refresh-mutex.ts",
      "bun": "./src/refresh-mutex.ts",
      "import": "./dist/refresh-mutex.js",
      "default": "./dist/refresh-mutex.js"
    },
    "./subscription-auth/adopt-codex-cli-login": {
      "types": "./dist/subscription-auth/adopt-codex-cli-login.d.ts",
      "eliza-source": "./src/subscription-auth/adopt-codex-cli-login.ts",
      "bun": "./src/subscription-auth/adopt-codex-cli-login.ts",
      "import": "./dist/subscription-auth/adopt-codex-cli-login.js",
      "default": "./dist/subscription-auth/adopt-codex-cli-login.js"
    },
    "./token-expiry": {
      "types": "./dist/token-expiry.d.ts",
      "eliza-source": "./src/token-expiry.ts",
      "bun": "./src/token-expiry.ts",
      "import": "./dist/token-expiry.js",
      "default": "./dist/token-expiry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "eliza-source": "./src/types.ts",
      "bun": "./src/types.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "clean": "node ../scripts/rm-path-recursive.mjs dist",
    "prepublishOnly": "bun run build",
    "build": "node ../scripts/rm-path-recursive.mjs dist && tsc6 --noCheck -p tsconfig.build.json && node ../scripts/prepare-package-dist.mjs packages/auth",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write src",
    "lint:check": "bunx @biomejs/biome check src",
    "format": "bunx @biomejs/biome format --write src",
    "format:check": "bunx @biomejs/biome format src"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/shared": "workspace:*",
    "@elizaos/vault": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "elizaos": {
    "scripts": {
      "testLanes": [
        "server"
      ]
    }
  }
}
