{
  "name": "@elizaos/plugin-personal-assistant",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Personal assistance: reminders, time zones, follow-ups, check-ins, goals, todos and routines.",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@elizaos/agent": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/plugin-calendar": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./reminders": {
      "eliza-source": "./src/reminders.vibe",
      "types": "./dist/src/reminders.d.ts",
      "import": "./dist/src/reminders.js",
      "default": "./dist/src/reminders.js"
    },
    "./clock": {
      "eliza-source": "./src/clock.vibe",
      "types": "./dist/src/clock.d.ts",
      "import": "./dist/src/clock.js",
      "default": "./dist/src/clock.js"
    },
    "./review": {
      "eliza-source": "./src/review.vibe",
      "types": "./dist/src/review.d.ts",
      "import": "./dist/src/review.js",
      "default": "./dist/src/review.js"
    },
    "./goals": {
      "eliza-source": "./src/goals.vibe",
      "types": "./dist/src/goals.d.ts",
      "import": "./dist/src/goals.js",
      "default": "./dist/src/goals.js"
    },
    "./todos": {
      "eliza-source": "./src/todos.vibe",
      "types": "./dist/src/todos.d.ts",
      "import": "./dist/src/todos.js",
      "default": "./dist/src/todos.js"
    }
  }
}
