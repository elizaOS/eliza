// spec/assistant/reminders.md, "Story: Propose a reminder or alarm on my phone only as I asked"; spec/assistant/reminders.md, "A phone reminder is proposed only when the assistant keeps no reminders here or the phone's reminder is selected"; spec/assistant/reminders.md, "A selected or named phone reminder is the one the owner gave, and a change to it needs the owner's own ask"; spec/assistant/reminders.md, "A new phone reminder is due when the owner's words say, counted from the turn's start for a relative time"; spec/assistant/timezone.md, "A phone reminder or Clock alarm uses the zone the phone reported for this turn"
import type { ActionParameterSchema } from "@elizaos/core"
import { readResult, type DeviceOperation } from "@elizaos/agent"
import type { DeviceProposalFamily, DeviceTurn, Grounding, NegotiatedDevice, PendingRequest, ProposalForm, ProposalText } from "@elizaos/agent-host"
import { declinesInWords, namedInWords, parseExplicitLocalDate, parseStatedClockTimes, wordsInWords } from "@elizaos/plugin-calendar"
import { alertAt, newReminderStated, phoneReminderProposed, relativeDueAt, reminderChangeAsked, reminderLead, reminderTargetGrounded, reminderTimeAdmitted, reminderWordsKept } from "../gen/assistant__reminders.effect.vibe"
import { localDueGrounded, phoneZoneGrounded, reminderShownZone } from "../gen/assistant__timezone.effect.vibe"
import { clockCapability, clockHandoffDispatch, clockRepeatCapability, describeClockHandoff, normalizeClockTimeZone } from "./clock.vibe"
import { ownerRemindersAction } from "./reminders.vibe"
import { recordTimeText, wallText, zonedInstant } from "./time.vibe"

type Op<T extends DeviceOperation["type"]> = Extract<DeviceOperation, { readonly type: T }>
type ReminderTarget = Op<"reminder_read_selected">["target"]
type CreateSchedule = Op<"reminder_create">["fields"]["schedule"]
type SelectedType = "reminder_read_selected" | "reminder_update" | "reminder_complete" | "reminder_snooze" | "reminder_cancel"

const recordV1 = "reminders.local-record.v1"
const recordV2 = "reminders.local-record.v2"
const createCapability = "reminders.create.v1"
const namedTarget = "device.named-target.v1"
const selectedTypes: readonly SelectedType[] = ["reminder_read_selected", "reminder_update", "reminder_complete", "reminder_snooze", "reminder_cancel"]

const identifier = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/
const reminderId = /^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$/
const revision = /^[a-f0-9]{64}$/
const cancelWords = /\b(?:cancel|delete|remove|stop|clear|drop|get\s+rid\s+of|turn\s+off)\b/i
const updateWords = /\b(?:change|edit|update|move|reschedule|push|shift|postpone|delay|rename|retitle|set|make)\b/i
const completeWords = /\b(?:complete|completed|done|finish(?:ed)?|check(?:ed)?\s+(?:it\s+)?off|mark(?:ed)?)\b/i
const snoozeWords = /\b(?:snooze|remind\s+me\s+(?:again\s+)?later)\b/i
const askedBy: Readonly<Partial<Record<DeviceOperation["type"], RegExp>>> = {
  reminder_update: updateWords, reminder_complete: completeWords, reminder_snooze: snoozeWords, reminder_cancel: cancelWords,
}
const counts: Readonly<Record<string, number>> = {
  a: 1, an: 1, one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, nine: 9, ten: 10, fifteen: 15, twenty: 20, thirty: 30, forty: 40, "forty-five": 45, fifty: 50, ninety: 90,
}
const relativeWords = /\bin\s+(half\s+an?|\d+(?:\.\d+)?|an?|one|two|three|four|five|six|seven|eight|nine|ten|fifteen|twenty|thirty|forty-five|forty|fifty|ninety)\s*(seconds?|secs?|minutes?|mins?|hours?|hrs?|days?)\b/giu
const unitMs = (unit: string) => /^s/i.test(unit) ? 1_000 : /^m/i.test(unit) ? 60_000 : /^h/i.test(unit) ? 3_600_000 : 86_400_000

const string = { type: "string" } satisfies ActionParameterSchema
const typed = (value: string | number) => ({ type: typeof value === "number" ? "integer" : "string", enum: [value] }) satisfies ActionParameterSchema

function object(properties: Record<string, ActionParameterSchema>, required: readonly string[] = Object.keys(properties)): ActionParameterSchema {
  return { type: "object", additionalProperties: false, required: [...required], properties }
}

const targetSchema = object({
  sourceId: string, sourceRevision: string, reminderId: string, occurrenceId: string, revision: string,
  timingVersion: { ...typed(2), description: "Copy the selected reminder timing version exactly when present." },
}, ["sourceId", "sourceRevision", "reminderId", "occurrenceId", "revision"])
const alertMinutes: ActionParameterSchema = {
  description: "Minutes before dueAt to alert; null saves without a notification.",
  anyOf: [{ type: "integer", minimum: 0, maximum: 10_080 }, { type: "null" }],
}
const recurrence: ActionParameterSchema = {
  anyOf: [{ type: "null" }, object({ rule: { type: "string", enum: ["daily", "weekdays", "weekly"] }, zone: string, date: string, time: string, leadMinutes: { type: "integer" } })],
}
const at = { type: "number", description: "UTC epoch milliseconds of the alert, or of the due instant when no alert is chosen." } satisfies ActionParameterSchema
const dueAt = { type: "number", description: "The due instant in UTC epoch milliseconds; supply it together with alertMinutes." } satisfies ActionParameterSchema
const updateFields = object({ title: string, body: string, schedule: object({ at, recurrence, dueAt, alertMinutes }, ["at", "recurrence"]) }, ["title", "body"])
const createFields = object({
  title: { type: "string", description: "The reminder title in the owner's own words." },
  body: { type: "string", description: "Only a note the owner stated; otherwise empty." },
  schedule: object({ at, recurrence, dueAt, alertMinutes }),
})
const recordName = { type: "string", description: "The reminder name exactly as the owner said it. Never an ID or revision." } satisfies ActionParameterSchema

const has = (device: NegotiatedDevice, name: string) => device.capabilities.includes(name)
const keepsRecords = (device: NegotiatedDevice) => has(device, recordV1) || has(device, recordV2)

type Selection = NonNullable<NonNullable<DeviceTurn["observation"]>["selectedObject"]>

function selectedReminder(selected: Selection | undefined): ReminderTarget | undefined {
  if (selected?.kind !== "reminder" || selected.accountId === undefined || selected.sourceRevision === undefined || selected.occurrenceId === undefined || selected.revision === undefined) return undefined
  const target = {
    sourceId: selected.accountId, sourceRevision: selected.sourceRevision, reminderId: selected.id, occurrenceId: selected.occurrenceId, revision: selected.revision,
    ...(selected.timingVersion === 2 ? { timingVersion: 2 as const } : {}),
  }
  return identifier.test(target.sourceId) && reminderId.test(target.reminderId) && identifier.test(target.occurrenceId) && revision.test(target.sourceRevision) && revision.test(target.revision)
    ? target : undefined
}

function screenSelection(turn: DeviceTurn): { readonly reminder: ReminderTarget | undefined; readonly phoneRecord: boolean } {
  const observed = turn.observation
  const selected = observed === undefined || observed.sensitive ? undefined : observed.selectedObject
  const reminder = selectedReminder(selected)
  return { reminder, phoneRecord: reminder !== undefined || (selected?.kind === "reminder-source" && selected.revision !== undefined) }
}

function recordsProposed(turn: DeviceTurn): boolean {
  return phoneReminderProposed(turn.runtime.actions.some(({ name }) => name === ownerRemindersAction.name), screenSelection(turn).phoneRecord)
}

const recordsNow: NonNullable<ProposalForm["now"]> = {
  unavailable: "the assistant keeps the owner's reminders here and no phone reminder is selected on the owner's screen on this message, so a reminder uses the owner's reminders action",
  available: recordsProposed,
}
const selectedNow: NonNullable<ProposalForm["now"]> = {
  unavailable: "no phone reminder is selected on the owner's screen on this message, so ask the owner to select it",
  available: (turn) => recordsProposed(turn) && screenSelection(turn).reminder !== undefined,
}

const sameTarget = (left: ReminderTarget, right: ReminderTarget) =>
  left.sourceId === right.sourceId && left.sourceRevision === right.sourceRevision && left.reminderId === right.reminderId
  && left.occurrenceId === right.occurrenceId && left.revision === right.revision && left.timingVersion === right.timingVersion

const reminderForms: readonly ProposalForm[] = [
  ...selectedTypes.map((type): ProposalForm => ({
    types: [type],
    schema: object({ type: typed(type), target: targetSchema, ...(type === "reminder_update" ? { fields: updateFields } : {}) }),
    guidance: ["Selected reminder read, update, complete, snooze and cancel need the exact selected target. Supply dueAt and alertMinutes together; alertMinutes null means no notification, at equals dueAt, and any recurrence leadMinutes is zero. Numeric alerts need at = dueAt - alertMinutes * 60000 and the same recurrence leadMinutes. A no-alert reminder cannot be snoozed; only a reviewed schedule edit gives it an alert. Cancel stops all future repeats; snooze is ten minutes."],
    offered: keepsRecords, now: selectedNow,
  })),
  {
    types: ["reminder_named"],
    schema: object({ type: typed("reminder_named"), action: typed("update"), name: recordName, fields: updateFields }),
    guidance: ["To change or cancel a phone reminder by its name, use reminder_named with action, the spoken name and, for an update, its declared fields."],
    offered: (device) => has(device, namedTarget) && keepsRecords(device), now: recordsNow,
  },
  {
    types: ["reminder_named"],
    schema: object({ type: typed("reminder_named"), action: typed("cancel"), name: recordName }),
    offered: (device) => has(device, namedTarget) && keepsRecords(device), now: recordsNow,
  },
  {
    types: ["reminder_create"],
    schema: object({ type: typed("reminder_create"), fields: createFields }),
    guidance: ["Create reviewed phone reminders with reminder_create: alertMinutes null means no alert, recurrence is null or an exact repeat, at = dueAt - (alertMinutes ?? 0) * 60000 and the recurrence leadMinutes matches. For a relative time (\"in 20 minutes\") or a stated day and time the host sets dueAt from the owner's words and the phone's clock; a relative reminder alerts when due, or not at all. The title uses the owner's words and the body stays empty unless the owner gave a note. A reminder without an alert is pending, not delivered. Use a returned reminderTiming dueAtDisplay and alertAtDisplay verbatim when present; they already use the phone's time zone. Otherwise keep its UTC instants explicit, without inventing a local time zone."],
    offered: (device) => has(device, createCapability), now: recordsNow,
  },
  {
    types: ["create_reminder"],
    schema: object({ type: typed("create_reminder"), title: string, dueAt: { type: "string", description: "Absolute UTC ISO timestamp." } }),
    guidance: ["The older create_reminder takes only a title and dueAt and always alerts; never drop requested timing: a no-alert, lead or repeating reminder needs reminder_create."],
    offered: (device) => device.capabilities.some((name) => !name.startsWith("clock.")), now: recordsNow,
  },
]

const clockGuidance = "Clock handoffs use clock_handoff. Set takes the phone's current time zone. Keep requested repeat days exactly; never silently drop a repeat or replace an alarm with a reminder. Only show is navigation. After the owner approves, set, dismiss and snooze may change alarms at once: dismiss can turn off the active one-off alarm or skip a repeating one, and snooze can affect every ringing alarm; Clock may use its own snooze length or ask. Clock alarms are not readable here: asked which alarms exist, say Clock keeps the list and offer show. Never promise a second confirmation in Clock, target one alarm, or say an opened receipt proves an alarm was set, dismissed, snoozed or rang. A request to be woken at a time is an alarm set, not a reminder."
const clocked = (device: NegotiatedDevice) => has(device, clockCapability) || has(device, clockRepeatCapability)
const setSchema = (withDays: boolean) => object({
  type: typed("clock_handoff"), action: typed("set"), hour: { type: "integer", minimum: 0, maximum: 23 }, minute: { type: "integer", minimum: 0, maximum: 59 },
  label: { type: "string", maxLength: 200 }, timeZone: { type: "string", maxLength: 100 },
  ...(withDays ? { days: { type: "array", items: { type: "integer", enum: [1, 2, 3, 4, 5, 6, 7] }, description: "Exact unique days, Sunday 1 through Saturday 7: [] is one-off, [1,2,3,4,5,6,7] daily, [2,3,4,5,6] weekdays. Never omit requested repeat days." } } : {}),
})

const clockForms: readonly ProposalForm[] = [
  ...(["show", "dismiss"] as const).map((action): ProposalForm => ({
    types: ["clock_handoff"], schema: object({ type: typed("clock_handoff"), action: typed(action) }), guidance: [clockGuidance], offered: clocked,
  })),
  { types: ["clock_handoff"], schema: setSchema(false), guidance: [clockGuidance], offered: (turn) => has(turn, clockCapability) && !has(turn, clockRepeatCapability) },
  { types: ["clock_handoff"], schema: setSchema(true), guidance: [clockGuidance], offered: (turn) => has(turn, clockRepeatCapability) },
  {
    types: ["clock_handoff"], schema: object({ type: typed("clock_handoff"), action: typed("snooze"), snoozeMinutes: { type: "integer", minimum: 1, maximum: 60 } }),
    guidance: [clockGuidance], offered: clocked,
  },
]

const refused = (code: string, forModel: string, forOwner: string): Grounding => ({ kind: "Refused", code, forModel, forOwner })
const sourceMismatch = refused("REMINDER_RECORD_SOURCE_MISMATCH",
  "Ordinary reminders use OWNER_REMINDERS in this agent's own reminder store. Phone reminder operations need a phone reminder or reminder list selected. No device proposal was created.",
  "I'll keep that reminder here instead; ask me to remind you, or open the reminder on your phone.")
const notSelected = refused("DEVICE_REMINDER_TARGET_NOT_SELECTED", "The proposed reminder is not the one selected on the phone. Copy the selected target exactly. No device proposal was created.",
  "Select that reminder on your phone, then ask again.")
const unnamed = refused("REMINDER_NAMED_NOT_REQUESTED", "The reminder name is not in the owner's words. Use the name exactly as the owner said it. No device proposal was created.",
  "Which reminder do you mean?")
const notAsked = refused("REMINDER_CHANGE_NOT_REQUESTED", "The owner did not ask for this change to the reminder, or turned it down. Nothing was proposed; do not propose it again unless the owner asks.",
  "I left that reminder as it is.")
const untitled = refused("REMINDER_TITLE_NOT_STATED", "The reminder title is not in the owner's words. Use the title as the owner said it. No device proposal was created.",
  "What should I call that reminder?")
const passed = refused("REMINDER_TIME_PASSED", "The reminder's due time or its alert has passed; ask for a new time. No device proposal was created.", "That time has already passed. When should I remind you?")
const relativeRepeat = refused("REMINDER_RELATIVE_REPEAT", "A relative reminder repeats nothing; propose recurrence null, or a stated day and time for a repeat. No device proposal was created.",
  "Should that reminder repeat? Tell me the day and time it starts.")
const noZone = refused("REMINDER_ZONE_UNAVAILABLE", "The phone did not report its time zone this turn, so a stated local time cannot be placed. No device proposal was created.",
  "I couldn't read your phone's time zone. Try again with the phone unlocked.")
const skipped = refused("REMINDER_LOCAL_TIME_AMBIGUOUS", "That local time is skipped or repeated in the phone's time zone. No device proposal was created.",
  "That time is skipped or repeated in your time zone. Choose an unambiguous time.")

const clockZoneChanged = (observed: string) => refused("CLOCK_OBSERVATION_CHANGED",
  observed === "" ? "A Clock set needs the phone's time zone this turn, which it did not report. No device proposal was created."
    : `A Clock set takes the phone's time zone this turn, ${observed}. No device proposal was created.`,
  "I couldn't confirm your phone's time zone for that alarm. Try again with the phone unlocked.")

function relativeAfter(text: string): number | undefined {
  const found = [...text.matchAll(relativeWords)]
  if (found.length !== 1) return undefined
  const [, amount = "", unit = ""] = found[0] ?? []
  const word = amount.toLowerCase().replace(/\s+/g, " ")
  const size = /^half/.test(word) ? 0.5 : /^\d/.test(word) ? Number(word) : counts[word]
  const ms = size === undefined ? undefined : Math.round(size * unitMs(unit))
  return ms !== undefined && Number.isSafeInteger(ms) && ms > 0 ? ms : undefined
}

const pad = (value: number) => String(value).padStart(2, "0")

function phoneZoneOf(turn: DeviceTurn): string | undefined {
  const observed = turn.observation
  return observed === undefined || observed.sensitive ? undefined : normalizeClockTimeZone(observed.timeZone)
}

const wallRepeats = (instant: number, zone: string) =>
  [1_800_000, 3_600_000].some((shift) => wallText(instant - shift, zone) === wallText(instant, zone) || wallText(instant + shift, zone) === wallText(instant, zone))

type Due = { readonly dueAt: number; readonly recurrence: CreateSchedule["recurrence"]; readonly relative: boolean }

function statedDue(turn: DeviceTurn, recurrence: CreateSchedule["recurrence"], proposedLead: number): Due | Grounding | undefined {
  const zone = phoneZoneOf(turn)
  const day = parseExplicitLocalDate(turn.ownerText, zone ?? "UTC", new Date(turn.startedAt))
  const stated = parseStatedClockTimes(turn.ownerText)
  if (stated.kind === "one" && stated.end === undefined && day !== undefined) {
    const date = `${day.year}-${pad(day.month)}-${pad(day.day)}`, time = `${pad(stated.start.hour)}:${pad(stated.start.minute)}`
    const instant = zone === undefined ? undefined : zonedInstant(date, time, zone)
    if (!localDueGrounded(zone !== undefined, instant !== undefined, zone !== undefined && instant !== undefined && wallRepeats(instant, zone)) || zone === undefined || instant === undefined) {
      return zone === undefined ? noZone : skipped
    }
    const lead = reminderLead(false, proposedLead)
    return { dueAt: instant, recurrence: recurrence === null ? null : { ...recurrence, zone, date, time, leadMinutes: lead }, relative: false }
  }
  const after = relativeAfter(turn.ownerText)
  if (after === undefined) return undefined
  if (recurrence !== null) return relativeRepeat
  return { dueAt: relativeDueAt(turn.startedAt, after), recurrence: null, relative: true }
}

const isDue = (value: Due | Grounding): value is Due => !("kind" in value)

function groundedSchedule(schedule: CreateSchedule, turn: DeviceTurn, now: number): CreateSchedule | Grounding {
  const alerts = schedule.alertMinutes !== null
  const due = statedDue(turn, schedule.recurrence, schedule.alertMinutes ?? 0)
  if (due !== undefined && !isDue(due)) return due
  const lead = reminderLead(due?.relative ?? false, schedule.alertMinutes ?? 0)
  const grounded: CreateSchedule = due === undefined ? schedule
    : { at: alertAt(due.dueAt, lead, alerts), recurrence: due.recurrence, dueAt: due.dueAt, alertMinutes: alerts ? lead : null }
  return reminderTimeAdmitted(grounded.dueAt, grounded.at, alerts, now) ? grounded : passed
}

const isSchedule = (value: CreateSchedule | Grounding): value is CreateSchedule => !("kind" in value)

function changeGrounded(type: DeviceOperation["type"], text: string): boolean {
  const verbs = askedBy[type]
  return verbs === undefined || reminderChangeAsked(verbs.test(text), declinesInWords(text, verbs))
}

function groundReminder(operation: DeviceOperation, turn: DeviceTurn, now: number): Grounding {
  if (operation.type === "clock_handoff") {
    const handoff = clockHandoffDispatch(operation)
    if (handoff === undefined) return refused("CLOCK_HANDOFF_INVALID", "The Clock request is not well formed. No device proposal was created.", "I couldn't prepare that alarm.")
    if (handoff.action !== "set") return { kind: "Grounded", operation: handoff }
    const observed = normalizeClockTimeZone(turn.observation?.timeZone) ?? ""
    return phoneZoneGrounded(turn.observation?.sensitive ?? true, observed, handoff.timeZone) ? { kind: "Grounded", operation: handoff } : clockZoneChanged(observed)
  }
  if (!recordsProposed(turn)) return sourceMismatch
  const text = turn.ownerText
  switch (operation.type) {
    case "reminder_read_selected":
    case "reminder_update":
    case "reminder_complete":
    case "reminder_snooze":
    case "reminder_cancel": {
      const selected = screenSelection(turn).reminder
      if (!reminderTargetGrounded(selected !== undefined, selected !== undefined && sameTarget(selected, operation.target))) return notSelected
      return changeGrounded(operation.type, text) ? { kind: "Grounded", operation } : notAsked
    }
    case "reminder_named":
      if (!namedInWords(operation.name, text)) return unnamed
      return changeGrounded(operation.action === "cancel" ? "reminder_cancel" : "reminder_update", text) ? { kind: "Grounded", operation } : notAsked
    case "reminder_create": {
      const { title, body } = operation.fields
      const schedule = groundedSchedule(operation.fields.schedule, turn, now)
      if (!isSchedule(schedule)) return schedule
      return newReminderStated(wordsInWords(title, text), true)
        ? { kind: "Grounded", operation: { ...operation, fields: { title, body: reminderWordsKept(wordsInWords(body, text), body), schedule } } }
        : untitled
    }
    case "create_reminder": {
      const due = statedDue(turn, null, 0)
      if (due !== undefined && !isDue(due)) return due
      const dueAt = due?.dueAt ?? Date.parse(operation.dueAt)
      if (!reminderTimeAdmitted(dueAt, dueAt, true, now)) return passed
      return newReminderStated(wordsInWords(operation.title, text), true) ? { kind: "Grounded", operation: { ...operation, dueAt: new Date(dueAt).toISOString() } } : untitled
    }
    default:
      return refused("DEVICE_OPERATION_NOT_OFFERED", "This is not a phone reminder or Clock operation. No device proposal was created.", "I couldn't prepare that on your phone.")
  }
}

function reminderDueText(dueAt: number, repeatZone: string | undefined, phoneZone: string | undefined): string {
  const zone = reminderShownZone(repeatZone ?? "", normalizeClockTimeZone(phoneZone) ?? "")
  return `${wallText(dueAt, zone)} (${zone})`
}

function alertText(alertMinutes: number | null | undefined): string {
  if (alertMinutes === null) return " It won't alert you."
  return alertMinutes === undefined || alertMinutes === 0 ? "" : ` It alerts you ${alertMinutes} minute${alertMinutes === 1 ? "" : "s"} before.`
}

function reminderTiming(operation: DeviceOperation, timeZone: string | undefined) {
  if (operation.type !== "reminder_create") return undefined
  const { dueAt, at, alertMinutes } = operation.fields.schedule
  const zone = normalizeClockTimeZone(timeZone)
  const dueAtDisplay = zone === undefined ? undefined : recordTimeText(dueAt, zone)
  const alertAtDisplay = alertMinutes === null || zone === undefined ? undefined : recordTimeText(at, zone)
  return {
    dueAt: new Date(dueAt).toISOString(), alertAt: alertMinutes === null ? null : new Date(at).toISOString(),
    ...(zone === undefined || dueAtDisplay === undefined ? {} : { timeZone: zone, dueAtDisplay, alertAtDisplay: alertAtDisplay ?? null }),
  }
}

function withTiming(operation: DeviceOperation, timeZone: string | undefined, text: ProposalText | undefined): ProposalText | undefined {
  const timing = reminderTiming(operation, timeZone)
  return timing === undefined ? text : { ...text, data: { ...text?.data, reminderTiming: timing } }
}

function proposedReminderText(operation: DeviceOperation, { timeZone }: PendingRequest): ProposalText | undefined {
  const review = reviewSentence(operation, timeZone)
  return withTiming(operation, timeZone, review === undefined ? undefined : { forOwner: review })
}

function reviewSentence(operation: DeviceOperation, timeZone: string | undefined): string | undefined {
  switch (operation.type) {
    case "reminder_create": {
      const { title, schedule } = operation.fields
      return `Review the reminder “${title}” for ${reminderDueText(schedule.dueAt, schedule.recurrence?.zone, timeZone)} on your phone.${alertText(schedule.alertMinutes)}`
    }
    case "create_reminder": return `Review the reminder “${operation.title}” for ${reminderDueText(Date.parse(operation.dueAt), undefined, timeZone)} on your phone.`
    case "reminder_read_selected": return "Share the selected reminder on your phone to continue."
    case "reminder_update": return `Review the changes to “${operation.fields.title}” on your phone. Nothing has changed yet.`
    case "reminder_complete": return "Review completing the selected reminder on your phone."
    case "reminder_snooze": return "Review snoozing the selected reminder on your phone."
    case "reminder_cancel": return "Review cancelling the selected reminder on your phone. Cancelling stops all its repeats."
    case "reminder_named": return `Choose “${operation.name}” in Reminders on your phone to review ${operation.action === "cancel" ? "cancelling it" : "the change"}.`
    case "clock_handoff": return `Review on your phone: ${describeClockHandoff(operation, "I")}`
    default: return undefined
  }
}

const clockSettledModelText = "Retrieved the historical approved Clock handoff receipt. Opened records dispatch of the approved Clock request, not proof of its final alarm state. The request may already have changed an alarm; check Clock before requesting another. It does not establish creation, snoozing, dismissal or ringing. No new dispatch occurred."

function settledReminderText(operation: DeviceOperation, result: unknown, timeZone: string | undefined): ProposalText | undefined {
  const settled = settledSentence(operation, result)
  if (operation.type === "clock_handoff") return { forModel: clockSettledModelText, ...(settled === undefined ? {} : { forOwner: settled }) }
  return withTiming(operation, timeZone, settled === undefined ? undefined : { forOwner: settled })
}

function settledSentence(operation: DeviceOperation, result: unknown): string | undefined {
  switch (operation.type) {
    case "reminder_create": {
      const title = operation.fields.title
      switch (readResult<"reminder_create">(operation, result)?.status) {
        case "pending": return `Your phone saved “${title}” without an alert.`
        case "permission-denied": return `Your phone saved “${title}”, but its notifications are off, so it can't alert you.`
        case "scheduling-failed": return `Your phone saved “${title}”, but couldn't schedule its alert.`
        default: return `Your phone saved the reminder “${title}”.`
      }
    }
    case "create_reminder": return `Your phone saved the reminder “${operation.title}”.`
    case "reminder_update": return "Your phone updated that reminder."
    case "reminder_complete": return "Your phone marked that reminder done."
    case "reminder_snooze": return "Your phone snoozed that reminder."
    case "reminder_cancel": return "Your phone cancelled that reminder."
    case "reminder_named":
      return readResult<"reminder_named">(operation, result)?.basis === "owner-chosen"
        ? operation.action === "cancel" ? "Your phone cancelled that reminder." : "Your phone updated that reminder."
        : "No reminder on your phone matched that name, so nothing changed."
    case "clock_handoff": return clockSettledText[operation.action]
    default: return undefined
  }
}

const clockSettledText: Readonly<Record<Op<"clock_handoff">["action"], string>> = {
  set: "Clock opened with that alarm. It may already be set; check Clock before asking for another. I can't confirm it was set or that it will ring.",
  dismiss: "Clock opened to dismiss an alarm. It may already have changed one; check Clock before asking again. I can't confirm an alarm was dismissed.",
  snooze: "Clock opened to snooze an alarm. It may already have changed one; check Clock before asking again. I can't confirm an alarm was snoozed.",
  show: "Clock opened to show your alarms; Clock keeps the list.",
}

function reminderGuidance(turn: NegotiatedDevice): readonly string[] {
  return [
    ...(keepsRecords(turn) && !has(turn, recordV2) ? ["This phone does not take timingVersion 2 targets or schedules with dueAt plus alertMinutes."] : []),
    ...(clocked(turn) && !has(turn, clockRepeatCapability) ? ["This phone supports only a one-off Clock set without days."] : []),
    ...(turn.capabilities.length > 0 && turn.capabilities.every((name) => name.startsWith("clock."))
      ? ["This connection supports only the Clock handoff operations in this schema. App navigation uses its registered view tools, not a phone proposal."] : []),
  ]
}

export const reminderProposalFamily: DeviceProposalFamily = {
  name: "reminders",
  types: [...selectedTypes, "reminder_named", "reminder_create", "create_reminder", "clock_handoff"],
  forms: [...reminderForms, ...clockForms],
  guidance: reminderGuidance,
  ground: effect (proposed, turn) => {
    const now = try Clock.currentTimeMillis
    return groundReminder(proposed.operation, turn, now)
  },
  proposedText: proposedReminderText,
  settledText: settledReminderText,
}
