// spec/assistant/travel.md, "Story: Keep my trip to the day I said I am back"; spec/assistant/travel.md, "A return ends the trip, a trip starts at the message, and anything else leaves the trip as it was"; spec/assistant/travel.md, "The return is the stated day, or the same day next year when no year was named and the day has passed"; spec/assistant/travel.md, "A trip ends at the return within thirty days, and otherwise thirty days after the message"
import type { RegisteredEvaluator } from "@elizaos/core"
import { noReturn, noTrip, travelAfter, travellingAt, tripEndAt, type StatedReturn, type TravelSignal } from "../gen/assistant__travel.effect.vibe"
import { Facts, onAgent } from "./host.vibe"
import { civilDate, longDate, zonedInstant } from "./time.vibe"
import { keepTrip, ownerClockAt, ownerFacts } from "./timezone.vibe"

module node {
  /** @throws {never} */
  export function isCalendarDay(year: number, month: number, day: number): boolean {
    const date = new Date(Date.UTC(year, month - 1, day))
    return year >= 1000 && date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day
  }
}
import { isCalendarDay } from node

const isoDate = /^(\d{4})-(\d{2})-(\d{2})$/u
const monthDay = /^(\d{2})-(\d{2})$/u
const signals: Readonly<Record<string, TravelSignal>> = { away: "SaysAway", back: "SaysBack", none: "SaysNothing" }

export interface TravelReading {
  readonly signal: TravelSignal
  readonly until: string | undefined
}

interface CalendarDay {
  readonly year: number
  readonly month: number
  readonly day: number
}

interface ReadDate {
  readonly month: number
  readonly day: number
  readonly year: number | undefined
}

function readDate(written: string): ReadDate | undefined {
  const iso = isoDate.exec(written)
  if (iso !== null) return { year: Number(iso[1]), month: Number(iso[2]), day: Number(iso[3]) }
  const short = monthDay.exec(written)
  return short === null ? undefined : { month: Number(short[1]), day: Number(short[2]), year: undefined }
}

const dayKey = (day: CalendarDay) => day.year * 10_000 + day.month * 100 + day.day
const dateText = (day: CalendarDay) => `${day.year}-${String(day.month).padStart(2, "0")}-${String(day.day).padStart(2, "0")}`
const midnight = (day: CalendarDay, zone: string) => isCalendarDay(day.year, day.month, day.day) ? zonedInstant(dateText(day), "00:00", zone) : undefined

function todayKey(now: number, zone: string): number {
  return Number(civilDate(now, zone).replace(/-/gu, ""))
}

function statedReturn(written: string | undefined, now: number, zone: string): StatedReturn {
  if (written === undefined) return noReturn
  const read = readDate(written)
  if (read === undefined) return { ...noReturn, named: true }
  const stated = { year: read.year ?? Number(civilDate(now, zone).slice(0, 4)), month: read.month, day: read.day }
  const following = { ...stated, year: stated.year + 1 }
  const at = midnight(stated, zone)
  const nextAt = midnight(following, zone)
  return {
    named: true, real: at !== undefined, yearGiven: read.year !== undefined, day: dayKey(stated), at: at ?? 0,
    nextReal: nextAt !== undefined, nextDay: dayKey(following), nextAt: nextAt ?? 0,
  }
}

export effect function stateTravel({ signal, until }: TravelReading) {
  if (signal === "SaysNothing") return undefined
  const now = try (try Facts).now()
  const zone = try ownerClockAt(now)
  const before = (try ownerFacts()).travel ?? { ...noTrip, zone: "" }
  const endAt = tripEndAt(statedReturn(until, now, zone), todayKey(now, zone), now)
  const trip = { ...travelAfter(signal, before, now, endAt), zone: "" }
  try keepTrip(trip)
  const travelling = travellingAt(trip, now)
  return { signal, trip, travelling, until: travelling ? new Date(trip.endAt).toISOString() : undefined }
}

function travelReading(output: unknown): TravelReading | null {
  if (typeof output !== "object" || output === null || Array.isArray(output)) return null
  if (Object.keys(output).some((key) => key !== "signal" && key !== "until")) return null
  const signal = Reflect.get(output, "signal")
  const until = Reflect.get(output, "until")
  if (typeof signal !== "string" || !Object.hasOwn(signals, signal) || typeof until !== "string") return null
  const written = until.trim()
  return { signal: signals[signal] ?? "SaysNothing", until: written === "" ? undefined : written.slice(0, 40) }
}

const travelSignals: ReadonlySet<unknown> = new Set(Object.values(signals))

function isReading(output: unknown): output is TravelReading {
  if (typeof output !== "object" || output === null) return false
  const until = Reflect.get(output, "until")
  return travelSignals.has(Reflect.get(output, "signal")) && (until === undefined || typeof until === "string")
}

function todayOf(prepared: unknown): string | undefined {
  const today = typeof prepared === "object" && prepared !== null ? Reflect.get(prepared, "today") : undefined
  return typeof today === "string" ? today : undefined
}

function dayTable(today: string): string {
  const noon = Date.parse(`${today}T12:00:00Z`)
  return Array.from({ length: 14 }, (_, offset) => {
    const day = new Date(noon + offset * 86_400_000).toISOString().slice(0, 10)
    return `${longDate(day)} is ${day}${offset === 0 ? " (today)" : ""}`
  }).join("; ")
}

function travelPrompt(text: string, today: string | undefined): string {
  return [
    "Read the owner's latest message and say whether it tells you that they themselves are away now or are back.",
    "signal: \"away\" when the owner says they are travelling, on a trip or vacation, or out of town or the office now; \"back\" when they say they are back, home or in the office again; \"none\" for anything else, including someone else's trip, a trip they only plan or ask about, and a message that does not say where they are.",
    "until: when the signal is \"away\" and the owner names the day they are away until or will be back, that day as YYYY-MM-DD; write MM-DD instead when they named a month and day without a year. Write the day they said even if the calendar has no such day. Otherwise an empty string.",
    ...(today === undefined ? [] : [`Read a weekday or a relative day from these days on the owner's clock: ${dayTable(today)}.`]),
    `The owner's message: ${JSON.stringify(text)}`,
  ].join("\n")
}

export const ownerTravelEvaluator: RegisteredEvaluator = {
  name: "PERSONAL_ASSISTANT_OWNER_TRAVEL",
  description: "Keeps the trip the owner states, such as \"I'm traveling until November 21st\", and ends it when they say they are back.",
  schema: {
    type: "object", additionalProperties: false, required: ["signal", "until"],
    properties: { signal: { type: "string", enum: ["away", "back", "none"] }, until: { type: "string" } },
  },
  inputScope: "current_message",
  shouldRun: async ({ runtime, message }) => message.entityId !== runtime.agentId && typeof message.content.text === "string" && message.content.text.trim() !== "",
  prepare: async ({ runtime }) => ({ today: await onAgent(runtime, effect {
    const now = try (try Facts).now()
    return civilDate(now, try ownerClockAt(now))
  }) }),
  prompt: ({ message, prepared }) => travelPrompt(message.content.text ?? "", todayOf(prepared)),
  parse: (output) => travelReading(output),
  processors: [{
    name: "keep-owner-trip",
    process: async ({ runtime, output }) => {
      if (!isReading(output) || output.signal === "SaysNothing") return undefined
      const kept = await onAgent(runtime, stateTravel(output))
      if (kept === undefined) return undefined
      return { success: true, text: kept.until === undefined ? "Owner is not travelling." : `Owner is travelling until ${kept.until}.`, data: { travelling: kept.travelling, until: kept.until ?? null } }
    },
  }],
}
