// spec/assistant/travel.md, "Story: Keep my trip to the day I said I am back"; spec/assistant/travel.md, "A return ends the trip, a trip starts at the message, and anything else leaves the trip as it was"; spec/assistant/travel.md, "The return is the stated day, or the same day next year when no year was named and the day has passed"; spec/assistant/travel.md, "A trip ends at the return within thirty days, and otherwise thirty days after the message"
import type { RegisteredEvaluator } from "@elizaos/core"
import { noReturn, noTrip, travelAfter, travellingAt, tripEndAt, type StatedReturn, type TravelSignal } from "../gen/assistant__travel.effect.vibe"
import { Facts, onAgent } from "./host.vibe"
import { civilDate, zonedInstant } from "./time.vibe"
import { keepTrip, ownerClockAt, ownerFacts } from "./timezone.vibe"

module node {
  /** @throws {never} */
  export function isCalendarDay(year: number, month: number, day: number): boolean {
    const date = new Date(Date.UTC(year, month - 1, day))
    return year >= 1000 && date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day
  }
}
import { isCalendarDay } from node

const backPattern = /\b(?:i['’]?m\s+back|i\s+am\s+back|back\s+home|(?:i['’]?m|i\s+am)\s+home\s+now|got\s+(?:back|home)|(?:i['’]?m|i\s+am)\s+(?:back\s+)?in\s+(?:town|the\s+office))\b/iu
const awayPattern = /\b(?:i['’]?m|i\s+am)\s+(?:traveling|travelling|away|on\s+(?:a\s+)?(?:trip|vacation|holiday)|out\s+of\s+(?:town|(?:the\s+)?office))\b/iu
const untilPattern = /\b(?:until|till|til|through|thru|back\s+(?:on|by))\s+([A-Za-z0-9 ,/.'’-]{3,40})/iu

const isoDate = /^(\d{4})-(\d{2})-(\d{2})$/u
const inFigures = /^(\d{1,2})\/(\d{1,2})(?:\/(\d{4}))?$/u
const monthFirst = /^(?:(?:mon|tue|wed|thu|fri|sat|sun)[a-z]*\.?,?\s+)?(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|june?|july?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\.?\s+(\d{1,2})(?:st|nd|rd|th)?(?:,?\s+(\d{4}))?$/iu
const dayFirst = /^(?:(?:mon|tue|wed|thu|fri|sat|sun)[a-z]*\.?,?\s+)?(?:the\s+)?(\d{1,2})(?:st|nd|rd|th)?\s+(?:of\s+)?(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|june?|july?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\.?(?:,?\s+(\d{4}))?$/iu
const monthWords = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]

interface CalendarDay {
  readonly year: number
  readonly month: number
  readonly day: number
}

interface ReadDate {
  readonly month: number
  readonly day: number
  readonly year: number | undefined
}

/** Whether a message says the owner is back, says they are away, or says neither; a return is read first. */
function travelSignal(text: string): TravelSignal {
  if (backPattern.test(text)) return "SaysBack"
  return awayPattern.test(text) ? "SaysAway" : "SaysNothing"
}

const monthOf = (word: string) => monthWords.indexOf(word.slice(0, 3).toLowerCase()) + 1
const yearOf = (digits: string | undefined) => digits === undefined ? undefined : Number(digits)

function readDate(phrase: string): ReadDate | undefined {
  const plain = phrase.trim().replace(/[.,]+$/u, "")
  const iso = isoDate.exec(plain)
  if (iso !== null) return { year: Number(iso[1]), month: Number(iso[2]), day: Number(iso[3]) }
  const figures = inFigures.exec(plain)
  if (figures !== null) return { month: Number(figures[1]), day: Number(figures[2]), year: yearOf(figures[3]) }
  const named = monthFirst.exec(plain)
  if (named !== null) return { month: monthOf(named[1]), day: Number(named[2]), year: yearOf(named[3]) }
  const reversed = dayFirst.exec(plain)
  return reversed === null ? undefined : { month: monthOf(reversed[2]), day: Number(reversed[1]), year: yearOf(reversed[3]) }
}

const dayKey = (day: CalendarDay) => day.year * 10_000 + day.month * 100 + day.day
const dateText = (day: CalendarDay) => `${day.year}-${String(day.month).padStart(2, "0")}-${String(day.day).padStart(2, "0")}`
const midnight = (day: CalendarDay, zone: string) => isCalendarDay(day.year, day.month, day.day) ? zonedInstant(dateText(day), "00:00", zone) : undefined

/** Today on the owner's clock, as the travel rules order days. */
function todayKey(now: number, zone: string): number {
  return Number(civilDate(now, zone).replace(/-/gu, ""))
}

/** The return a phrase after "until" names, on the owner's clock in `zone` at `now`. */
function statedReturn(phrase: string | undefined, now: number, zone: string): StatedReturn {
  if (phrase === undefined) return noReturn
  const read = readDate(phrase)
  if (read === undefined) return { ...noReturn, named: true }
  const stated = { year: read.year ?? Number(civilDate(now, zone).slice(0, 4)), month: read.month, day: read.day }
  const following = { ...stated, year: stated.year + 1 }
  const at = midnight(stated, zone)
  const nextAt = midnight(following, zone)
  return {
    named: true, real: at !== undefined, yearGiven: read.year !== undefined, day: dayKey(stated), at: at ?? 0,
    nextReal: nextAt !== undefined, nextDay: dayKey(following), nextAt: nextAt ?? 0,
  }
}

/** Applies what a message says about the owner's travel: a trip from now to the return it names, or the end of the trip. */
export effect function stateTravel(text: string) {
  const signal = travelSignal(text)
  if (signal === "SaysNothing") return undefined
  const now = try (try Facts).now()
  const zone = try ownerClockAt(now)
  const before = (try ownerFacts()).travel ?? { ...noTrip, zone: "" }
  const endAt = tripEndAt(statedReturn(untilPattern.exec(text)?.[1], now, zone), todayKey(now, zone), now)
  const trip = { ...travelAfter(signal, before, now, endAt), zone: "" }
  try keepTrip(trip)
  const travelling = travellingAt(trip, now)
  return { signal, trip, travelling, until: travelling ? new Date(trip.endAt).toISOString() : undefined }
}

/** Keeps the trip the owner states in conversation, and ends it when they say they are back. */
export const ownerTravelEvaluator: RegisteredEvaluator = {
  name: "PERSONAL_ASSISTANT_OWNER_TRAVEL",
  description: "Keeps the trip the owner states, such as \"I'm traveling until November 21st\", and ends it when they say they are back.",
  schema: { type: "object", properties: { signal: { type: "string" } }, required: ["signal"] },
  inputScope: "current_message",
  shouldRun: async ({ runtime, message }) => message.entityId !== runtime.agentId && typeof message.content.text === "string" && travelSignal(message.content.text) !== "SaysNothing",
  resolveOutputWhen: () => true,
  resolveOutput: ({ message }) => ({ signal: travelSignal(message.content.text ?? "") }),
  prompt: () => "",
  processors: [{
    name: "keep-owner-trip",
    process: async ({ runtime, message }) => {
      const kept = await onAgent(runtime, stateTravel(message.content.text ?? ""))
      if (kept === undefined) return { success: true, text: "No trip was stated." }
      return { success: true, text: kept.until === undefined ? "Owner is not travelling." : `Owner is travelling until ${kept.until}.`, data: { travelling: kept.travelling, until: kept.until ?? null } }
    },
  }],
}
