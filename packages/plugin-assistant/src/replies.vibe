// spec/assistant/replies.md, "Story: Hear a brief acknowledgment while my request is pending, and the whole answer after"; spec/assistant/replies.md, "A cue is heard only while the work is pending, and never in place of an answer"; spec/assistant/replies.md, "Story: Hear what this turn proves about my request"; spec/assistant/replies.md, "A claim that something was done needs a result that applied it to that record"; spec/assistant/replies.md, "A claim that something was not done needs a cited result that failed and was not superseded"
import { revertedEffectReceiptIds, type ActionResult, type EffectReceipt, type ProviderDataRecord } from "@elizaos/core"
import { claimSupported, heardWhile, type ReplyKind, type ResultEnd, type TurnResult, type WorkPhase } from "../gen/assistant__replies.effect.vibe"

export type { ReplyKind, TurnResult, WorkPhase }

const waitCue = /^(?:on it|(?:one|just a) (?:sec|second|moment))$/iu
const progressLead = /^(?:let me (?:check|look|open|pull up|take a look|have a look)|checking|looking|searching|reading)\b/iu
const statedFact = /\b(?:zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|fifteen|twenty|thirty|forty|fifty|sixty|hundred|thousand|million|half|quarter|dozen|minutes?|seconds?|hours?|days?|weeks?|months?|years?|ms|milliseconds?|ago|after|before|until|tomorrow|today|tonight|noon|midnight|am|pm|set|saved|done|created|sent|deleted)\b/iu

export function replyKind(text: string): ReplyKind {
  const reply = text.trim()
  if (reply === "") return "EmptyReply"
  if (reply.length > 120 || /[?\d]/u.test(reply)) return "AnswerReply"
  const pieces = reply.split(/\s*(?:[.!…]+|[,;:]|\s[—–-]\s)\s*/u).filter((piece) => piece !== "")
  const cue = (piece: string) => waitCue.test(piece)
  const progress = (piece: string) => progressLead.test(piece) && !statedFact.test(piece)
  return pieces.length > 0 && pieces.length <= 3 && pieces.every((piece) => cue(piece) || progress(piece)) ? "CueReply" : "AnswerReply"
}

export function heardReply(phase: WorkPhase, text: string): string | undefined {
  return heardWhile(phase, replyKind(text)) === "EmptyReply" ? undefined : text
}

export interface Attempt {
  readonly actionName: string
  readonly success: boolean
  readonly receipts: readonly EffectReceipt[]
}

function receiptTarget(receipt: EffectReceipt): string {
  return `${receipt.resource.kind}:${receipt.resource.id}`
}

function ended(receipt: EffectReceipt, reverted: ReadonlySet<string>): ResultEnd {
  if (reverted.has(receipt.receiptId)) return "EndRefused"
  switch (receipt.outcome) {
    case "applied": return "EndApplied"
    case "noop": return receipt.idempotency.replayed ? "EndApplied" : "EndRefused"
    case "preview": return "EndPreviewed"
    case "failed": return receipt.failure.acceptance === "unknown" ? "EndUnknown" : "EndRefused"
    case "rolled_back": return "EndRefused"
  }
}

export function turnResults(attempts: readonly Attempt[]): TurnResult[] {
  const reverted = revertedEffectReceiptIds(attempts.flatMap((attempt) => attempt.receipts))
  return attempts.flatMap(({ actionName, success, receipts }) => receipts.length === 0
    ? [{ actionName, target: "", ended: success ? "EndApplied" : "EndRefused" } satisfies TurnResult]
    : receipts.filter((receipt) => receipt.outcome !== "rolled_back")
      .map((receipt) => ({ actionName, target: receiptTarget(receipt), ended: ended(receipt, reverted) } satisfies TurnResult)))
}

export type Proven =
  | { readonly kind: "done" }
  | { readonly kind: "notDone"; readonly cited: number }
  | { readonly kind: "unproven" }

export function proven(attempts: readonly Attempt[], target: string): Proven {
  const results = turnResults(attempts)
  if (claimSupported(results, "ClaimedDone", target, 0)) return { kind: "done" }
  const cited = results.findIndex((_, index) => claimSupported(results, "ClaimedNotDone", target, index) && results[index]?.target === target)
  return cited >= 0 ? { kind: "notDone", cited } : { kind: "unproven" }
}

export interface Telling {
  readonly done: string
  readonly notDone: string
  readonly unproven: string
}

export function attributed(attempts: readonly Attempt[], target: string, telling: Telling, data: ProviderDataRecord = {}): ActionResult {
  const effectReceipts = attempts.flatMap((attempt) => attempt.receipts)
  const proof = proven(attempts, target)
  switch (proof.kind) {
    case "done": return { success: true, text: telling.done, effectReceipts, data }
    case "notDone": return { success: false, text: telling.notDone, effectReceipts, data: { ...data, failedResult: proof.cited + 1 } }
    case "unproven": return { success: false, text: telling.unproven, effectReceipts, data }
  }
}

interface ReceiptFacts {
  readonly operation: string
  readonly kind: string
  readonly id: string
  readonly key: string | null
  readonly at: number
}

function base({ operation, kind, id, key, at }: ReceiptFacts, replayed: boolean, outcome: string) {
  return {
    receiptId: `personal-assistant:${operation}:${kind}:${id}:${outcome}:${at}`, operation, resource: { kind, id }, artifacts: [],
    idempotency: { key, replayed }, observedAt: new Date(at).toISOString(),
  }
}

export function appliedReceipt(facts: ReceiptFacts, replayed = false): EffectReceipt {
  return replayed
    ? { ...base(facts, true, "noop"), outcome: "noop", reason: "Replayed the committed result of this request" }
    : { ...base(facts, false, "applied"), outcome: "applied", commit: { kind: "durable", id: `${facts.kind}:${facts.id}`, committedAt: new Date(facts.at).toISOString() } }
}

export function failedReceipt(facts: ReceiptFacts, code: string, acceptance: "rejected" | "unknown"): EffectReceipt {
  return { ...base(facts, false, "failed"), outcome: "failed", failure: { code, retryable: acceptance === "unknown", acceptance } }
}

export function unchangedReceipt(facts: ReceiptFacts, reason: string): EffectReceipt {
  return { ...base(facts, false, "noop"), outcome: "noop", reason }
}

export function previewReceipt(facts: ReceiptFacts): EffectReceipt {
  return { ...base(facts, false, "preview"), outcome: "preview" }
}
