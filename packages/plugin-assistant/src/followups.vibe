// spec/assistant/followups.md, "Story: Remind me about approvals I left open, and stop once I answered"; spec/assistant/followups.md, "Each tick reconciles every follow-up against its approval before any is delivered"; spec/assistant/followups.md, "A follow-up is never delivered after its tick saw the approval resolved"; spec/assistant/followups.md, "A follow-up keeps its prompt exactly until it is retired"; spec/assistant/followups.md, "Every resolved approval's follow-up is retired"
import { createReminderPresentation } from "@elizaos/core"
import { canDeliverFollowup, canReconcileFails, canReconcileTick, deliverFollowup, fresh, reconcileFails, reconcileTick, type ApprovalState, type Followup, type Followups } from "../gen/assistant__followups.effect.vibe"
import { Approvals, Facts, Presenter, readRecord, writeRecord, type ApprovalView, type DeliveryAnswer } from "./host.vibe"

/** The scheduled-task kind of the tick that reconciles and delivers approval follow-ups. */
export const followupTickKind = "personal-assistant.followup-tick"
/** How often the follow-up tick runs. */
export const followupTickCron = "*/15 * * * *"

const firstAfter = 30 * 60_000
const repeatAfter = 120 * 60_000

const FollowupRecord = Schema.Struct({
  followupId: Schema.Number, approvalId: Schema.String, title: Schema.String,
  seenResolved: Schema.Boolean, completed: Schema.Boolean, prompt: Schema.Boolean, sent: Schema.Boolean, nextAt: Schema.Number,
})
/** One follow-up on an approval the owner left open. */
export type FollowupRecord = typeof FollowupRecord.Type
const decodeIndex = Schema.decodeUnknownOption(Schema.Struct({ nextId: Schema.Number, followups: Schema.Array(FollowupRecord) }))
const indexKey = "followups"

function approvalOf(view: ApprovalView | undefined): ApprovalState {
  if (view === undefined) return "ApprovalResolved"
  switch (view.state) {
    case "pending": return "ApprovalPending"
    case "approved":
    case "retryable":
    case "reconciliation_required": return "ApprovalProcessing"
    case "done":
    case "rejected":
    case "expired": return "ApprovalResolved"
  }
}

/** The follow-ups the assistant keeps, and the id the next one takes. */
export effect function followupIndex() {
  return (try readRecord(indexKey, decodeIndex)) ?? { nextId: 1, followups: [] }
}

/** What one tick did: which follow-ups it delivered and which it retired. */
export interface TickReport {
  readonly delivered: readonly string[]
  readonly retired: readonly string[]
  readonly held: readonly string[]
  readonly readFailed: boolean
}

/** One tick: a single read of the owner's approval queue reconciles every follow-up, retiring resolved ones within the limit, before any is delivered. */
export effect function followupTick() {
  const now = try (try Facts).now()
  const index = try followupIndex()
  const queue = (try Approvals).list() catch () => undefined
  const byId = new Map((queue ?? []).map((view) => [view.id, view]))
  let nextId = index.nextId
  const records: FollowupRecord[] = [...index.followups]
  for (const view of queue ?? []) {
    if (view.state !== "pending" || records.some((record) => record.approvalId === view.id)) continue
    records.push({ followupId: nextId, approvalId: view.id, title: view.reason.trim() || view.action, seenResolved: false, completed: false, prompt: true, sent: false, nextAt: now + firstAfter })
    nextId += 1
  }
  const state: Followups = {
    tickPhase: "Reconciling", retired: 0,
    followups: records.map((record): Followup => ({
      ...fresh, followupId: record.followupId, seenResolved: record.seenResolved, completed: record.completed, prompt: record.prompt, sent: record.sent,
      approval: queue === undefined ? (record.seenResolved ? "ApprovalResolved" : "ApprovalPending") : approvalOf(byId.get(record.approvalId)),
    })),
  }
  let fired = queue === undefined ? (canReconcileFails(state) ? reconcileFails(state) : state) : (canReconcileTick(state) ? reconcileTick(state) : state)
  const presenter = try Presenter
  const delivered: string[] = []
  const due = new Map<number, number>()
  for (const record of records) {
    if (record.nextAt > now || !canDeliverFollowup(fired, record.followupId)) continue
    const body = `An approval is still waiting for you: ${record.title}. Review it in your approvals.`
    const presentation = Effect.try({ try: () => createReminderPresentation(body, body, "Approval waiting"), catch: () => "unpresentable" }) catch () => undefined
    if (presentation === undefined) continue
    const shown = Effect.as(presenter.present({ taskId: `followup:${record.approvalId}`, kind: followupTickKind, roomId: undefined, presentation }), true) catch () => false
    if (!shown) continue
    fired = deliverFollowup(fired, record.followupId)
    due.set(record.followupId, now + repeatAfter)
    delivered.push(record.approvalId)
  }
  const kept = records.map((record) => {
    const after = fired.followups.find((followup) => followup.followupId === record.followupId)
    return after === undefined ? record : {
      ...record, seenResolved: after.seenResolved, completed: after.completed, prompt: after.prompt, sent: after.sent, nextAt: due.get(record.followupId) ?? record.nextAt,
    }
  })
  try writeRecord(indexKey, { nextId, followups: kept.filter((record) => !record.completed) })
  return {
    delivered,
    retired: kept.filter((record) => record.completed && !(index.followups.find((before) => before.followupId === record.followupId)?.completed ?? false)).map((record) => record.approvalId),
    held: fired.followups.filter((followup) => followup.held && !followup.completed).map((followup) => records.find((record) => record.followupId === followup.followupId)?.approvalId ?? ""),
    readFailed: queue === undefined,
  } satisfies TickReport
}

/** Runs one follow-up tick when its scheduled task fires. */
export effect function deliverFollowupTick() {
  try followupTick()
  return { kind: "delivered" } satisfies DeliveryAnswer
}
