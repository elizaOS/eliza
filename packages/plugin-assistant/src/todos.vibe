// spec/assistant/todos.md, "Story: Keep my to-do list as I asked, once"; spec/assistant/todos.md, "A mutation is applied once per idempotency key"; spec/assistant/todos.md, "An item is added unless an open item already says the same, unless the owner confirms the duplicate"; spec/assistant/todos.md, "A change by text applies only when exactly one item matches"; spec/assistant/todos.md, "An item's completion time is set exactly while it is completed"; spec/assistant/todos.md, "Clearing the list removes only the previewed items, and only after the owner confirms"; spec/assistant/todos.md, "A miss offers the items that share most of its words, and changes nothing"
import { isAffirmativeConfirmationReply, type Action, type ActionResult, type Memory, type Provider } from "@elizaos/core"
import { Machine, Rejected, matching, nearMiss, stored, type Event, type Todo, type TodoStatus, type Todos } from "../gen/assistant__todos.effect.vibe"
import { Facts, onAgent, parametersOf, readRecord, requestOf, writeRecord } from "./host.vibe"
import { appliedReceipt, attributed, failedReceipt, forTheOwner, previewReceipt, unchangedReceipt } from "./replies.vibe"
import { TodoRequest } from "./requests.schema.vibe"

const listKey = "todos"
const questionKey = "todos:duplicate-question"
const questionLifetime = 5 * 60_000
const todoActionName = "TODO"

const statusOf = { start: "TodoInProgress", complete: "TodoCompleted", cancel: "TodoCancelled", reopen: "TodoPending" } as const satisfies Record<string, TodoStatus>
const statusWords: Readonly<Record<string, string>> = { start: "in progress", complete: "completed", cancel: "cancelled", reopen: "open again" }
const marks: Readonly<Record<TodoStatus, string>> = { TodoPending: "[ ]", TodoInProgress: "[→]", TodoCompleted: "[x]", TodoCancelled: "[-]" }

export effect function currentTodos() {
  provide stored(listKey) {
    return try (try Machine).get()
  }
}

export function renderTodos(todos: readonly Todo[], includeClosed: boolean): string {
  const shown = todos.filter((todo) => includeClosed || todo.todoStatus === "TodoPending" || todo.todoStatus === "TodoInProgress")
  return shown.length === 0 ? "" : ["# Current todos", ...shown.map((todo) => `- ${marks[todo.todoStatus]} ${todo.content} (t-${todo.todoId})`)].join("\n")
}

export const plain = (text: string) => text.normalize("NFKC").toLowerCase().replace(/[\p{P}\p{S}]+/gu, " ").replace(/\s+/gu, " ").trim()
const isOpen = (todo: Todo) => todo.todoStatus === "TodoPending" || todo.todoStatus === "TodoInProgress"
const wordsOf = (text: string) => new Set(plain(text).split(" ").filter((word) => word !== ""))

function nearMisses(list: Todos, target: string): readonly Todo[] {
  const asked = wordsOf(target)
  return list.todos.filter((todo) => {
    const kept = wordsOf(todo.content)
    return nearMiss([...asked].filter((word) => kept.has(word)).length, asked.size, kept.size)
  })
}

function namedTexts(list: Todos, words: string): readonly string[] {
  const target = words.trim()
  const ref = /^t-(\d+)$/u.exec(target)
  const byRef = ref === null ? undefined : list.todos.find((todo) => todo.todoId === Number(ref[1]))
  if (byRef !== undefined) return [byRef.content]
  if (list.todos.some((todo) => todo.content === target)) return [target]
  const loose = [...new Set(list.todos.filter((todo) => plain(todo.content) === plain(target)).map((todo) => todo.content))]
  return loose.length === 0 ? [target] : loose
}

const decodeRequest = Schema.decodeUnknownOption(TodoRequest, { onExcessProperty: "error" })
const decodeQuestion = Schema.decodeUnknownOption(Schema.Struct({ content: Schema.String, at: Schema.Number }))

export effect function changeTodos(input: unknown, message: Memory) {
  const { messageId } = requestOf(message)
  const decoded = decodeRequest(input)
  if (Option.isNone(decoded)) return { success: false, text: "Say what to add or which to-do to change.", data: { outcome: "TODO_REQUEST_INVALID" } } satisfies ActionResult
  const request = decoded.value
  const at = try (try Facts).now()
  provide stored(listKey) {
    const list = try Machine
    const before = try list.get()
    if (request.op === "list") return { success: true, text: renderTodos(before.todos, true) || "Your to-do list is empty.", data: { todos: before.todos } } satisfies ActionResult
    const targetText = request.op === "create" || request.op === "clear" ? undefined : request.target
    const named = targetText === undefined ? [] : namedTexts(before, targetText)
    if (targetText !== undefined && named.length > 1) {
      const candidates = before.todos.filter((todo) => named.includes(todo.content))
      return {
        success: false, effectReceipts: [unchangedReceipt({ operation: `todo.${request.op}`, kind: "todo", id: targetText, key: `${messageId}:${request.op}:${targetText}`, at }, "ambiguous")],
        text: `${candidates.length} to-dos match "${targetText}", so nothing was changed. Which one did you mean: ${candidates.map((todo) => `"${todo.content}" (t-${todo.todoId})`).join(", ")}?`,
        data: { outcome: "ambiguous", candidates: candidates.map((todo) => todo.todoId), awaitingUserInput: true },
      } satisfies ActionResult
    }
    const content = request.op === "create" ? request.content.trim() : request.op === "clear" ? "" : named[0] ?? request.target.trim()
    const key = `${messageId}:${request.op}:${content}`
    const facts = { operation: `todo.${request.op}`, kind: request.op === "clear" ? "todo-list" : "todo", id: request.op === "clear" ? listKey : content, key, at }
    const target = `${facts.kind}:${facts.id}`
    const asked = try readRecord(questionKey, decodeQuestion)
    const affirmed = isAffirmativeConfirmationReply(message) && (request.op === "clear" || (asked !== undefined && plain(asked.content) === plain(content) && at - asked.at <= questionLifetime))
    const twin = request.op === "create" && !affirmed ? before.todos.find((todo) => isOpen(todo) && plain(todo.content) === plain(content))?.content : undefined
    const event: Event = request.op === "create" ? { type: "createTodo", key, content: twin ?? content, affirmed }
      : request.op === "delete" ? { type: "deleteTodo", key, content }
      : request.op === "rename" ? { type: "renameTodo", key, content, renamed: request.content.trim() }
      : request.op === "clear" ? (before.clearPreviewed ? { type: "confirmClear", key, affirmed } : { type: "previewClear", key })
      : { type: "setTodoStatus", key, content, status: statusOf[request.op], at }
    const replay = before.mutations.some((mutation) => mutation.key === key)
    const after = list.send(event) catch (refused) => refused
    if (after instanceof Rejected) {
      const receipt = failedReceipt(facts, "TODO_IDEMPOTENCY_CONFLICT", "rejected")
      return attributed([{ actionName: todoActionName, success: false, receipts: [receipt] }], target, { done: "", notDone: "That request was already used for a different change, so nothing was changed.", unproven: "" })
    }
    if (replay) {
      return {
        success: true, effectReceipts: [unchangedReceipt(facts, "already_recorded")],
        text: "That request was already recorded. Nothing changed.", data: { outcome: "replayed", todos: after.todos },
      } satisfies ActionResult
    }
    switch (after.lastOutcome) {
      case "AlreadySet": {
        const status = request.op === "reopen" ? "open" : request.op === "rename" ? `called "${content}"` : statusWords[request.op]
        return {
          success: true, effectReceipts: [unchangedReceipt(facts, request.op === "rename" ? "already_named" : "already_at_status")],
          text: `"${content}" was already ${status}.`, data: { outcome: "unchanged", todos: after.todos },
        } satisfies ActionResult
      }
      case "Duplicate": {
        try writeRecord(questionKey, { content, at })
        return { success: false, effectReceipts: [unchangedReceipt(facts, "duplicate")], text: `"${twin ?? content}" is already on your list. Add another copy anyway? Reply yes to confirm or no to cancel.`, data: { outcome: "duplicate", awaitingUserInput: true } } satisfies ActionResult
      }
      case "Missed": {
        const candidates = matching(before, content)
        const offered = candidates.length === 0 ? nearMisses(before, content) : []
        return {
          success: false, effectReceipts: [unchangedReceipt(facts, candidates.length === 0 ? "no_match" : "ambiguous")],
          text: candidates.length > 0 ? `${candidates.length} to-dos say "${content}", so nothing was changed. Which one did you mean: ${candidates.map((todo) => `t-${todo.todoId}`).join(", ")}?`
            : offered.length === 0 ? `No to-do says "${content}", so nothing was changed.`
            : `No to-do says "${content}", so nothing was changed. Did you mean ${offered.map((todo) => `"${todo.content}" (t-${todo.todoId})`).join(" or ")}?`,
          data: {
            outcome: candidates.length === 0 ? "not_found" : "ambiguous", candidates: candidates.map((todo) => todo.todoId), offered: offered.map((todo) => todo.todoId),
            awaitingUserInput: candidates.length > 0 || offered.length > 0,
          },
        } satisfies ActionResult
      }
      default: break
    }
    if (event.type === "previewClear") {
      const count = after.previewIds.length
      return { success: true, effectReceipts: [previewReceipt(facts)], text: count === 0 ? "Your to-do list is already empty." : `This clears ${count} ${count === 1 ? "to-do" : "to-dos"}. Reply yes to clear them, or anything else to keep them.`, data: { outcome: "preview", previewIds: after.previewIds, awaitingUserInput: count > 0 } } satisfies ActionResult
    }
    if (event.type === "confirmClear" && !event.affirmed) {
      return { success: true, effectReceipts: [unchangedReceipt(facts, "cancelled")], text: "Kept your to-do list as it was.", data: { outcome: "cancelled" } } satisfies ActionResult
    }
    const done = event.type === "createTodo" ? `Added "${content}".` : event.type === "deleteTodo" ? `Deleted "${content}".`
      : event.type === "renameTodo" ? `Renamed "${content}" to "${event.renamed}".`
      : event.type === "confirmClear" ? `Cleared ${before.todos.length - after.todos.length} to-dos.`
      : `"${content}" is now ${statusWords[request.op]}.`
    return attributed([{ actionName: todoActionName, success: true, receipts: [appliedReceipt(facts)] }], target, { done, notDone: "", unproven: "" }, { todos: after.todos })
  }
}

export const todosAction: Action = {
  name: todoActionName,
  description: "Owner's to-do list. Changes match one item by text (case/punctuation-insensitive) or t-N ref; clear asks first.",
  descriptionCompressed: "Create, start, complete, rename, delete, list, or clear owner to-dos.",
  similes: ["TODOS", "CREATE_TODO", "ADD_TODO", "COMPLETE_TODO", "FINISH_TODO", "CANCEL_TODO", "RENAME_TODO", "UPDATE_TODO", "DELETE_TODO", "LIST_TODOS", "CLEAR_TODOS"],
  toolSchemaStrict: true,
  cacheStable: true,
  parameters: [
    { name: "content", required: false, description: "create/rename text.", schema: { type: "string" } },
    { name: "op", required: true, description: "Op.", schema: { type: "string", enum: ["create", "start", "complete", "cancel", "reopen", "rename", "delete", "list", "clear"] } },
    { name: "target", required: false, description: "Item text or t-N ref.", schema: { type: "string" } },
  ],
  summarize: (result) => result?.text?.slice(0, 160),
  tags: ["domain:todos", "capability:write", "effect:receipt-required"],
  roleGate: { minRole: "OWNER" },
  validate: async () => true,
  handler: async (runtime, message, _state, options) => {
    return onAgent(runtime, Effect.catch(changeTodos(parametersOf(options), message), (failed) => Effect.succeed({ success: false, text: "The to-do list could not be changed.", ...forTheOwner("Your to-do list couldn't be reached just now."), data: { outcome: failed._tag } } satisfies ActionResult)))
  },
}

export const currentTodosProvider: Provider = {
  name: "CURRENT_TODOS",
  description: "The owner's open to-dos, with their t-N references.",
  dynamic: true,
  private: true,
  get: async (runtime) => {
    const list = await onAgent(runtime, Effect.orElseSucceed(currentTodos(), () => undefined))
    return { text: list === undefined ? "" : renderTodos(list.todos, false), data: { todos: list?.todos ?? [] } }
  },
}
