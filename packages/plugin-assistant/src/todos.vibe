// spec/assistant/todos.md, "Story: Keep my to-do list as I asked, once"; spec/assistant/todos.md, "A mutation is applied once per idempotency key"; spec/assistant/todos.md, "An item is added unless an open item already says the same, unless the owner confirms the duplicate"; spec/assistant/todos.md, "A change by text applies only when exactly one item matches"; spec/assistant/todos.md, "An item's completion time is set exactly while it is completed"; spec/assistant/todos.md, "Clearing the list removes only the previewed items, and only after the owner confirms"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import type { Action, ActionResult, Provider } from "@elizaos/core"
import { NotAState, Rejected, decodeState, initial, machineOver, matching, statusTargets, type Event, type Todo, type TodoStatus, type Todos } from "../gen/assistant__todos.effect.vibe"
import { Facts, onAgent, readRecord, requestOf, writeRecord } from "./host.vibe"
import { appliedReceipt, attributed, failedReceipt, previewReceipt, unchangedReceipt } from "./replies.vibe"
import { TodoRequest } from "./requests.schema.vibe"

const listKey = "todos"
const questionKey = "todos:duplicate-question"
const questionLifetime = 5 * 60_000
const todoActionName = "TODO"

const statusOf = { start: "TodoInProgress", complete: "TodoCompleted", cancel: "TodoCancelled", reopen: "TodoPending" } as const satisfies Record<string, TodoStatus>
const statusWords: Readonly<Record<string, string>> = { start: "in progress", complete: "completed", cancel: "cancelled", reopen: "open again" }
const marks: Readonly<Record<TodoStatus, string>> = { TodoPending: "[ ]", TodoInProgress: "[→]", TodoCompleted: "[x]", TodoCancelled: "[-]" }
const writers = new WeakMap<KeyValueStore.KeyValueStore, ReturnType<typeof Semaphore.makeUnsafe>>()
const affirmative = /^\s*(?:yes|yeah|yep|yup|sure|ok(?:ay)?|confirm(?:ed)?|do it|go ahead|please do)\b/iu

export function affirms(text: string): boolean {
  return affirmative.test(text)
}

function upgradeTodoSnapshot(input: unknown): unknown {
  if (typeof input !== "object" || input === null || !("mutations" in input) || !Array.isArray(input.mutations)) return input
  return { ...input, mutations: input.mutations.map((entry: unknown) => {
    if (typeof entry !== "object" || entry === null || !("key" in entry) || !("request" in entry) || Object.keys(entry).length !== 2) return entry
    const request = entry.request
    if (typeof request !== "object" || request === null || "requestItem" in request) return entry
    return { ...entry, request: { ...request, requestItem: 0 }, statusItemId: 0, statusAppliedAt: 0, appliedStatus: false }
  }) }
}

effect function loadTodos(store: KeyValueStore.KeyValueStore) {
  const found = try store.get(listKey)
  if (found === undefined) return initial
  const raw = try Effect.try({ try: () => JSON.parse(found) as unknown, catch: () => new NotAState({ input: found }) })
  return try decodeState(upgradeTodoSnapshot(raw))
}

export effect function currentTodos() {
  return try loadTodos(try KeyValueStore.KeyValueStore)
}

export function renderTodos(todos: readonly Todo[], includeClosed: boolean): string {
  const shown = todos.filter((todo) => includeClosed || todo.todoStatus === "TodoPending" || todo.todoStatus === "TodoInProgress")
  return shown.length === 0 ? "" : ["# Current todos", ...shown.map((todo) => `- ${marks[todo.todoStatus]} ${todo.content} (t-${todo.todoId})`)].join("\n")
}

const plain = (text: string) => text.normalize("NFKC").toLowerCase().replace(/[\p{P}\p{S}]+/gu, " ").replace(/\s+/gu, " ").trim()
const isOpen = (todo: Todo) => todo.todoStatus === "TodoPending" || todo.todoStatus === "TodoInProgress"

function namedTexts(list: Todos, words: string): readonly string[] {
  const target = words.trim()
  const ref = /^t-(\d+)$/u.exec(target)
  const byRef = ref === null ? undefined : list.todos.find((todo) => todo.todoId === Number(ref[1]))
  if (byRef !== undefined) return [byRef.content]
  if (list.todos.some((todo) => todo.content === target)) return [target]
  const loose = [...new Set(list.todos.filter((todo) => plain(todo.content) === plain(target)).map((todo) => todo.content))]
  return loose.length === 0 ? [target] : loose
}

const decodeRequest = Schema.decodeUnknownOption(TodoRequest, { onExcessProperty: "error" })
const decodeQuestion = Schema.decodeUnknownOption(Schema.Struct({ content: Schema.String, at: Schema.Number }))

export effect function changeTodos(input: unknown, messageId: string, text: string) {
  const store = try KeyValueStore.KeyValueStore
  const writer = writers.get(store) ?? Semaphore.makeUnsafe(1)
  writers.set(store, writer)
  return try writer.withPermits(1)(changeList(store, input, messageId, text))
}

effect function changeList(store: KeyValueStore.KeyValueStore, input: unknown, messageId: string, text: string) {
  const decoded = decodeRequest(input)
  if (Option.isNone(decoded)) return { success: false, text: "Say what to add or which to-do to change.", data: { outcome: "TODO_REQUEST_INVALID" } } satisfies ActionResult
  const request = decoded.value
  const at = try (try Facts).now()
  const list = try machineOver(() => loadTodos(store), (next) => orDie(store.set(listKey, JSON.stringify(next))))
  const before = try list.get()
  if (request.op === "list") return { success: true, text: renderTodos(before.todos, true) || "Your to-do list is empty.", data: { todos: before.todos } } satisfies ActionResult
  const targetText = request.op === "create" || request.op === "clear" ? undefined : request.target
  const isStatus = request.op === "start" || request.op === "complete" || request.op === "cancel" || request.op === "reopen"
  const ref = !isStatus || targetText === undefined ? null : /^t-([0-9]+)$/u.exec(targetText.trim())
  const item = ref === null ? 0 : Number(ref[1])
  if (ref !== null && (!Number.isSafeInteger(item) || item < 1)) {
    return { success: false, text: "Which to-do did you mean? Give me its full text or a valid t-N reference.", data: { outcome: "not_found" } } satisfies ActionResult
  }
  const named = targetText === undefined || item > 0 ? [] : namedTexts(before, targetText)
  if (targetText !== undefined && named.length > 1) {
    const candidates = before.todos.filter((todo) => named.includes(todo.content))
    return {
      success: false, effectReceipts: [unchangedReceipt({ operation: `todo.${request.op}`, kind: "todo", id: targetText, key: `${messageId}:${request.op}:${targetText}`, at }, "ambiguous")],
      text: `${candidates.length} to-dos match "${targetText}", so nothing was changed. Which one did you mean: ${candidates.map((todo) => `"${todo.content}" (t-${todo.todoId})`).join(", ")}?`,
      data: { outcome: "ambiguous", candidates: candidates.map((todo) => todo.todoId), awaitingUserInput: true },
    } satisfies ActionResult
  }
  const content = request.op === "create" ? request.content.trim() : request.op === "clear" || item > 0 ? "" : named[0] ?? request.target.trim()
  const candidates = isStatus ? statusTargets(before, content, item) : []
  const selected = candidates.length === 1 ? candidates[0] : undefined
  const display = item === 0 ? content : selected?.content ?? `t-${item}`
  const priorPrefix = `${messageId}:${request.op}:`
  const key = item > 0 ? `todo-status:${JSON.stringify([messageId, request.op, item])}` : priorPrefix + content
  const seen = before.mutations.find((mutation) => mutation.key === key)
  if (item > 0 && seen === undefined && before.mutations.some((mutation) => mutation.request.op === "StatusOp" && mutation.request.requestItem === 0 && mutation.key.startsWith(priorPrefix))) {
    return { success: true, text: "That request was already recorded. Nothing changed.", data: { outcome: "replayed", todos: before.todos } } satisfies ActionResult
  }
  const selectedId = seen?.statusItemId || selected?.todoId
  const facts = { operation: `todo.${request.op}`, kind: request.op === "clear" ? "todo-list" : "todo", id: request.op === "clear" ? listKey : selectedId === undefined ? display : `t-${selectedId}`, key, at }
  const target = `${facts.kind}:${facts.id}`
  const asked = try readRecord(questionKey, decodeQuestion)
  const affirmed = affirms(text) && (request.op === "clear" || (asked !== undefined && plain(asked.content) === plain(content) && at - asked.at <= questionLifetime))
  const twin = request.op === "create" && !affirmed ? before.todos.find((todo) => isOpen(todo) && plain(todo.content) === plain(content))?.content : undefined
  const event: Event = request.op === "create" ? { type: "createTodo", key, content: twin ?? content, affirmed }
    : request.op === "delete" ? { type: "deleteTodo", key, content }
    : request.op === "rename" ? { type: "renameTodo", key, content, renamed: request.content.trim() }
    : request.op === "clear" ? (before.clearPreviewed ? { type: "confirmClear", key, affirmed } : { type: "previewClear", key })
    : { type: "setTodoStatus", key, content, targetId: item, status: statusOf[request.op], at }
  const after = list.send(event) catch (refused) => refused
  if (after instanceof Rejected) {
    const receipt = failedReceipt(facts, "TODO_IDEMPOTENCY_CONFLICT", "rejected")
    return attributed([{ actionName: todoActionName, success: false, receipts: [receipt] }], target, { done: "", notDone: "That request was already used for a different change, so nothing was changed.", unproven: "" })
  }
  if (seen !== undefined) {
    return {
      success: true, effectReceipts: [seen.statusAppliedAt > 0 ? statusReceipt({ ...facts, at: seen.statusAppliedAt }, true) : unchangedReceipt(facts, "already_recorded")],
      text: "That request was already recorded. Nothing changed.", data: { outcome: "replayed", todos: after.todos },
    } satisfies ActionResult
  }
  switch (after.lastOutcome) {
    case "ReplayedStatus": {
      const recorded = after.mutations.at(-1)
      const prior = recorded?.statusAppliedAt ?? 0
      if (prior === 0) return { success: false, text: "I couldn't verify the earlier to-do change." } satisfies ActionResult
      return {
        success: true, effectReceipts: [statusReceipt({ ...facts, at: prior }, true)],
        text: `"${display}" was already ${statusWords[request.op]}.`, data: { outcome: "replayed", todos: after.todos },
      } satisfies ActionResult
    }
    case "AlreadySet": {
      const status = request.op === "reopen" ? "open" : request.op === "rename" ? `called "${content}"` : statusWords[request.op]
      return {
        success: true, effectReceipts: [unchangedReceipt(facts, request.op === "rename" ? "already_named" : "already_at_status")],
        text: `"${display}" was already ${status}.`, data: { outcome: "unchanged", todos: after.todos },
      } satisfies ActionResult
    }
    case "Duplicate": {
      try writeRecord(questionKey, { content, at })
      return { success: false, effectReceipts: [unchangedReceipt(facts, "duplicate")], text: `"${twin ?? content}" is already on your list. Add another copy anyway? Reply yes to confirm or no to cancel.`, data: { outcome: "duplicate", awaitingUserInput: true } } satisfies ActionResult
    }
    case "Missed": {
      const matches = isStatus ? candidates : matching(before, content)
      return {
        success: false, effectReceipts: [unchangedReceipt(facts, matches.length === 0 ? "no_match" : "ambiguous")],
        text: matches.length === 0 ? (item > 0 ? `No to-do has reference "${display}", so nothing was changed.` : `No to-do says "${display}", so nothing was changed.`)
          : `${matches.length} to-dos say "${display}", so nothing was changed. Which one did you mean: ${matches.map((todo) => `t-${todo.todoId}`).join(", ")}?`,
        data: { outcome: matches.length === 0 ? "not_found" : "ambiguous", candidates: matches.map((todo) => todo.todoId), awaitingUserInput: matches.length > 0 },
      } satisfies ActionResult
    }
    default: break
  }
  if (event.type === "previewClear") {
    const count = after.previewIds.length
    return { success: true, effectReceipts: [previewReceipt(facts)], text: count === 0 ? "Your to-do list is already empty." : `This clears ${count} ${count === 1 ? "to-do" : "to-dos"}. Reply yes to clear them, or anything else to keep them.`, data: { outcome: "preview", previewIds: after.previewIds, awaitingUserInput: count > 0 } } satisfies ActionResult
  }
  if (event.type === "confirmClear" && !event.affirmed) {
    return { success: true, effectReceipts: [unchangedReceipt(facts, "cancelled")], text: "Kept your to-do list as it was.", data: { outcome: "cancelled" } } satisfies ActionResult
  }
  const done = event.type === "createTodo" ? `Added "${content}".` : event.type === "deleteTodo" ? `Deleted "${content}".`
    : event.type === "renameTodo" ? `Renamed "${content}" to "${event.renamed}".`
    : event.type === "confirmClear" ? `Cleared ${before.todos.length - after.todos.length} to-dos.`
    : `"${display}" is now ${statusWords[request.op]}.`
  const receipt = isStatus ? statusReceipt(facts, false) : appliedReceipt(facts)
  return attributed([{ actionName: todoActionName, success: true, receipts: [receipt] }], target, { done, notDone: "", unproven: "" }, { todos: after.todos })
}

function statusReceipt(facts: Parameters<typeof appliedReceipt>[0], replayed: boolean) {
  const receipt = appliedReceipt(facts, replayed)
  return { ...receipt, receiptId: `${receipt.receiptId}:${facts.key}` }
}

function parametersOf(options: unknown): Readonly<Record<string, unknown>> {
  const given = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
  return typeof given === "object" && given !== null ? Object.fromEntries(Object.entries(given).filter(([, value]) => value !== undefined && value !== null)) : {}
}

export const todosAction: Action = {
  name: todoActionName,
  description: "The owner's to-do list: create, start, complete, cancel, reopen, rename, delete, list or clear. A change names the item by its text, case and punctuation aside, or its t-N reference and applies only when exactly one item matches; clearing asks first.",
  similes: ["TODOS", "CREATE_TODO", "ADD_TODO", "COMPLETE_TODO", "FINISH_TODO", "CANCEL_TODO", "RENAME_TODO", "UPDATE_TODO", "DELETE_TODO", "LIST_TODOS", "CLEAR_TODOS"],
  parameters: [
    { name: "op", required: true, description: "create, start, complete, cancel, reopen, rename, delete, list or clear.", schema: { type: "string", enum: ["create", "start", "complete", "cancel", "reopen", "rename", "delete", "list", "clear"] } },
    { name: "content", required: false, description: "For create: the to-do's text. For rename: its new text.", schema: { type: "string" } },
    { name: "target", required: false, description: "For a change: the to-do's text or its t-N reference.", schema: { type: "string" } },
  ],
  tags: ["domain:todos", "capability:write", "effect:receipt-required"],
  roleGate: { minRole: "OWNER" },
  validate: async () => true,
  handler: async (runtime, message, _state, options) => {
    const { messageId, text } = requestOf(message)
    return onAgent(runtime, Effect.catch(changeTodos(parametersOf(options), messageId, text), (failed) => Effect.succeed({ success: false, text: "The to-do list could not be changed.", data: { outcome: failed._tag } } satisfies ActionResult)))
  },
}

export const currentTodosProvider: Provider = {
  name: "CURRENT_TODOS",
  description: "The owner's open to-dos, with their t-N references.",
  dynamic: true,
  private: true,
  get: async (runtime) => {
    const list = await onAgent(runtime, Effect.orElseSucceed(currentTodos(), () => undefined))
    return { text: list === undefined ? "" : renderTodos(list.todos, false), data: { todos: list?.todos ?? [] } }
  },
}
