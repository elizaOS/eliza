// spec/assistant/evaluatorProgress.md, "Story: Resume validated output without redoing its inference"; spec/assistant/evaluatorProgress.md, "Only the selected sources, references, removals and trigger fence output"; spec/assistant/evaluatorProgress.md, "Durable staging retains the first output and its binding until settlement"; spec/assistant/evaluatorProgress.md, "Commit acknowledges selected evidence only after all reducers succeed"; spec/assistant/evaluatorProgress.md, "Story: Retire stale evidence with a recoverable audit record"; spec/assistant/evaluatorProgress.md, "Stale evidence prepares an audit before any reducer can retire it"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { hashStableJson, type Memory } from "@elizaos/core"
import {
  Machine, canCapture, canCommitProgress, canFinishReconciliation, canPrepareReconciliation, canRetireProgress, canRetireReducers, canStageOutput, staleObserved, stored,
  type Evidence, type EvaluatorProgress, type ProgressFailure, type SourceRevision,
} from "../../gen/assistant__evaluatorProgress.effect.vibe"

export interface ProgressScope {
  readonly agentId: string
  readonly roomId: string
  readonly entityId: string
  readonly evaluator: string
  readonly schemaVersion: number
}

const progressKey = ({ agentId, roomId, entityId, evaluator, schemaVersion }: ProgressScope) =>
  `evaluator-progress:${agentId}:${roomId}:${entityId}:${encodeURIComponent(evaluator)}:v${schemaVersion}`
const outputKey = (scope: ProgressScope, binding: string) => `${progressKey(scope)}:output:${binding}`

export function sourceOf(message: Memory): SourceRevision {
  return { sourceId: message.id ?? "", revision: hashStableJson({ id: message.id, entityId: message.entityId, roomId: message.roomId, createdAt: message.createdAt, content: message.content }) }
}

export function evidenceOf(evidenceId: string, trigger: Memory, selected: readonly Memory[], references: readonly Memory[], removed: readonly string[]): Evidence {
  return { evidenceId, trigger: sourceOf(trigger), selected: selected.map(sourceOf), references: references.map(sourceOf), removed: [...removed] }
}

const bytesOf = (text: string) => new TextEncoder().encode(text).length

type ProgressAnswer =
  | { readonly kind: "kept"; readonly state: EvaluatorProgress }
  | { readonly kind: "refused"; readonly failure: ProgressFailure; readonly state: EvaluatorProgress }

const answer = (state: EvaluatorProgress): ProgressAnswer => state.failure === "NoProgressFailure" ? { kind: "kept", state } : { kind: "refused", failure: state.failure, state }

effect function writes(key: string, value: string) {
  const store = try KeyValueStore.KeyValueStore
  return Effect.as(store.set(key, value), true) catch () => false
}

export effect function stagedOutput(scope: ProgressScope) {
  provide stored(progressKey(scope)) {
    const pending = (try (try Machine).get()).record.pending
    if (pending.payload === 0) return undefined
    const store = try KeyValueStore.KeyValueStore
    const raw = try orDie(store.get(outputKey(scope, pending.binding)))
    return raw === undefined ? undefined : { evidence: pending.evidence, binding: pending.binding, output: raw, payload: pending.payload }
  }
}

export effect function stageEvaluatorOutput(scope: ProgressScope, observed: readonly SourceRevision[], evidence: Evidence, output: string, binding: string) {
  provide stored(progressKey(scope)) {
    const progress = try Machine
    const refreshed = try orDie(progress.send({ type: "refreshSources", observed: [...observed] }))
    if (!canCapture(refreshed, evidence)) return { kind: "refused", failure: "StaleEvidence", state: refreshed } satisfies ProgressAnswer
    const captured = try orDie(progress.send({ type: "capture", evidence }))
    const payload = bytesOf(output)
    if (!canStageOutput(captured, captured.snapshot.handle, payload)) return { kind: "refused", failure: "ProgressNotStaged", state: captured } satisfies ProgressAnswer
    const pending = captured.record.pending
    if (pending.payload > 0 && pending.binding === binding) {
      const store = try KeyValueStore.KeyValueStore
      const previous = try orDie(store.get(outputKey(scope, binding)))
      if (previous !== output) return { kind: "refused", failure: "ProgressConflict", state: captured } satisfies ProgressAnswer
    }
    const durable = pending.payload > 0 || (try writes(outputKey(scope, binding), output))
    return answer(try orDie(progress.send({ type: "stageOutput", handle: captured.snapshot.handle, payload, binding, durable })))
  }
}

export effect function commitEvaluatorProgress(scope: ProgressScope, effectsSucceeded: boolean, checkpoint: number) {
  provide stored(progressKey(scope)) {
    const progress = try Machine
    const state = try progress.get()
    if (!canCommitProgress(state, state.snapshot.handle, checkpoint)) return { kind: "refused", failure: "InvalidSnapshot", state } satisfies ProgressAnswer
    const binding = state.record.pending.binding
    const committed = answer(try orDie(progress.send({ type: "commitProgress", handle: state.snapshot.handle, effectsSucceeded, checkpoint, durable: true })))
    if (committed.kind === "kept" && binding !== "") (try KeyValueStore.KeyValueStore).remove(outputKey(scope, binding)) catch () => undefined
    return committed
  }
}

// eslint-disable-next-line @typescript-eslint/no-unused-vars -- the shell path for the spec's retireReducers event, which no caller reaches yet
effect function reconcileEvaluatorEvidence(scope: ProgressScope, observed: readonly SourceRevision[], retire: (reprocess: readonly string[]) => boolean!unknown) {
  provide stored(progressKey(scope)) {
    const progress = try Machine
    const refreshed = try orDie(progress.send({ type: "refreshSources", observed: [...observed] }))
    if (!canPrepareReconciliation(refreshed)) return { kind: "kept", state: refreshed } satisfies ProgressAnswer
    const affected = [...new Set(staleObserved(refreshed).map((source) => source.sourceId))]
    const prepared = try orDie(progress.send({ type: "prepareReconciliation", durable: true }))
    if (prepared.failure !== "NoProgressFailure" || !canRetireReducers(prepared, affected)) return answer(prepared)
    const effectsSucceeded = retire(affected) catch () => false
    const reduced = try orDie(progress.send({ type: "retireReducers", reprocess: affected, effectsSucceeded }))
    if (!canRetireProgress(reduced)) return answer(reduced)
    const retired = try orDie(progress.send({ type: "retireProgress", durable: true }))
    if (!canFinishReconciliation(retired)) return answer(retired)
    return answer(try orDie(progress.send({ type: "finishReconciliation", durable: true })))
  }
}
