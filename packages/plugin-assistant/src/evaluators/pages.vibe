// spec/assistant/evaluatorEvidencePages.md, "Story: Request an earlier complete page without applying the current response"; spec/assistant/evaluatorEvidencePages.md, "The preceding page includes only whole records before its cursor"; spec/assistant/evaluatorEvidencePages.md, "Restoration checks visibility and repeats before reading another page"
import type { Memory } from "@elizaos/core"
import { previousPage, restorationDecision, type EvidencePage, type EvidencePageStatus, type EvidenceRow } from "../../gen/assistant__evaluatorEvidencePages.effect.vibe"

export type { EvidencePageStatus }

const transportFields = new Set(["recovery", "recoveryToken", "transport", "clientMessageId"])

function modelFacing(message: Memory): string {
  const content = Object.fromEntries(Object.entries(message.content).filter(([name]) => !transportFields.has(name)))
  return JSON.stringify({ id: message.id, entityId: message.entityId, createdAt: message.createdAt, content })
}

export function evidenceRows(messages: readonly Memory[]): EvidenceRow[] {
  return [...messages].sort((a, b) => (a.createdAt ?? 0) - (b.createdAt ?? 0)).map((message) => {
    const body = modelFacing(message)
    return { identity: message.id ?? "", body, bytes: new TextEncoder().encode(body).length }
  })
}

export interface Restoration {
  readonly status: EvidencePageStatus
  readonly records: readonly Memory[]
  readonly hasEarlier: boolean
}

export function restoreEarlier(messages: readonly Memory[], cursor: string, visible: readonly string[], requested: readonly string[], referenceBytes: number, maxBytes: number): Restoration {
  const rows = evidenceRows(messages)
  const page: EvidencePage = previousPage(rows, cursor, maxBytes)
  const restoredBytes = page.rows.reduce((sum, row) => sum + row.bytes, 0)
  const existingArrayBytes = referenceBytes === 0 ? 2 : referenceBytes
  const separators = referenceBytes > 2 ? page.rows.length : Math.max(0, page.rows.length - 1)
  const totalBytes = referenceBytes < 0 ? referenceBytes : existingArrayBytes + restoredBytes + separators
  const status = restorationDecision(cursor, [...visible], [...requested], page, totalBytes, maxBytes)
  if (status !== "PageAccepted") return { status, records: [], hasEarlier: false }
  const byId = new Map(messages.map((message) => [message.id ?? "", message]))
  const records = page.rows.flatMap((row) => {
    const message = byId.get(row.identity)
    return message === undefined ? [] : [message]
  })
  return { status, records, hasEarlier: page.hasEarlier }
}
