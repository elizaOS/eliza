// spec/assistant/reminders.md, "Story: Create the reminder I asked for, and only that"; spec/assistant/goals.md, "Story: Keep my goals and check in on them when I asked"; spec/assistant/todos.md, "Story: Keep my to-do list as I asked, once"; spec/assistant/routines.md, "Story: Keep my habits on their cadence"; spec/assistant/routines.md, "Story: Keep my habits from the conversation"; spec/assistant/checkin.md, "Story: Summarize my day only from a real answer"; spec/assistant/timezone.md, "Story: Run my day on my own clock"; spec/assistant/travel.md, "Story: Keep my trip to the day I said I am back"; spec/assistant/reminderEscalation.md, "Story: Nudge me again about a reminder I did not answer, never in my quiet hours"; spec/assistant/reminders.md, "Story: Propose a reminder or alarm on my phone only as I asked"; spec/assistant/checkin.md, "Story: Check in on me at the times I chose"; spec/assistant/checkin.md, "Story: Brief me on my morning, evening or week when I ask"
import { Service, type EvaluatorRunResult, type IAgentRuntime, type Provider, type RegisteredEvaluator } from "@elizaos/core"
import type { AgentPlugin } from "@elizaos/agent"
import { registerDeviceProposalFamily } from "@elizaos/agent/device-actions"
import { briefAction } from "./brief.vibe"
import { checkinKind, checkinRoutes, deliverCheckin, followOwnerClock } from "./checkin.vibe"
import { reminderProposalFamily } from "./device-proposals.vibe"
import { dossierRoutes } from "./dossier.vibe"
import { deliverEscalation, escalationKind } from "./escalation.vibe"
import { runEvaluators, type EvaluatorRun } from "./evaluators/runner.vibe"
import { deliverFollowupTick, followupTickCron, followupTickKind } from "./followups.vibe"
import { deliverGoalCheckin, goalCheckinKind, ownerGoalsAction, ownerGoalsProvider } from "./goals.vibe"
import { Facts, Scheduler, onAgent, isAgentScheduledTasks, scheduledTasksServiceType, type AssistantPorts, type DeliveryAnswer, type TaskRow } from "./host.vibe"
import { deliverReminder, ownerRemindersAction, ownerRemindersProvider, reminderKind, remindersContext } from "./reminders.vibe"
import { deliverRoutine, deliverRoutineNudge, ownerRoutinesAction, ownerRoutinesProvider, routineKind, routineNudgeKind, routineRoutes } from "./routines.vibe"
import { ownerCalendarZone, ownerClockAt, stateOwnerZone, statedZone } from "./timezone.vibe"
import { currentTodosProvider, todosAction } from "./todos.vibe"
import { ownerTravelEvaluator } from "./travel.vibe"

export { proven, turnResults, type Attempt, type Proven, type TurnResult } from "./replies.vibe"
export { runtimeLayer, onAgent, type AssistantPorts } from "./host.vibe"
export { runEvaluators, orderedEntries, type EvaluatorRun } from "./evaluators/runner.vibe"
export { restoreEarlier, evidenceRows, type Restoration } from "./evaluators/pages.vibe"
export { followupTick, type TickReport } from "./followups.vibe"
export { ownerActivity, setDossier, dossierControl, presentDossier } from "./dossier.vibe"
export { BriefSources, PriorityModel, ownerBrief, rankOwnerEntries } from "./owner-brief.vibe"
export { BillEvidencePort, keepObservedBill, findBillReceipt } from "./bill-evidence.vibe"
export { reminderProposalFamily } from "./device-proposals.vibe"

export const personalAssistantPluginName = "@elizaos/plugin-personal-assistant"

type Deliverer = (task: TaskRow) => DeliveryAnswer!unknown!AssistantPorts

const deliverers: ReadonlyArray<readonly [string, Deliverer]> = [
  [reminderKind, deliverReminder],
  [escalationKind, deliverEscalation],
  [goalCheckinKind, deliverGoalCheckin],
  [routineKind, deliverRoutine],
  [routineNudgeKind, deliverRoutineNudge],
  [checkinKind, deliverCheckin],
  [followupTickKind, (task) => effect {
    const now = try (try Facts).now()
    followOwnerClock(`tick:${task.taskId}:${now}`) catch effect (failure) => {
      try annotateLogs(logWarning("the owner's clock could not be followed for the standing tasks"), { failure: failure._tag })
    }
    return try deliverFollowupTick()
  }],
]

effect function scheduleStandingTasks() {
  const now = try Clock.currentTimeMillis
  const zone = try followOwnerClock(`start:${now}`)
  const scheduler = try Scheduler
  try scheduler.create({
    kind: followupTickKind, ownerVisible: false, promptInstructions: "Follow up on approvals left open",
    trigger: { kind: "cron", expression: followupTickCron, tz: zone }, metadata: {}, idempotencyKey: "followups:tick",
  })
}

export class PersonalAssistantService extends Service {
  static override serviceType = "personal-assistant"
  override capabilityDescription = "Delivers the owner's reminders, goal check-ins, routines and daily check-in at the owner's local time"

  static override async start(runtime: IAgentRuntime): Promise<Service> {
    const tasks = await runtime.getServiceLoadPromise(scheduledTasksServiceType)
    if (!isAgentScheduledTasks(tasks)) throw new TypeError("The agent's scheduled-tasks service cannot deliver the assistant's tasks")
    for (const [kind, deliver] of deliverers) tasks.deliverKind(kind, (task) => onAgent(runtime, deliver(task)))
    await onAgent(runtime, scheduleStandingTasks())
    return new PersonalAssistantService(runtime)
  }

  // spec/assistant/timezone.md, "The calendar reads the stored zone, or the agent's zone when none is stored"
  ownerCalendarZone(): Promise<string> {
    return onAgent(this.runtime, ownerCalendarZone())
  }

  override stop(): Promise<void> {
    return Promise.resolve()
  }
}

export class PersonalAssistantEvaluators extends Service {
  static override serviceType = "personal-assistant-evaluators"
  override capabilityDescription = "Runs registered evaluators in batches by input route, with durable incremental progress"

  static override async start(runtime: IAgentRuntime): Promise<Service> {
    return new PersonalAssistantEvaluators(runtime)
  }

  run(run: Omit<EvaluatorRun, "runtime">): Promise<EvaluatorRunResult> {
    return onAgent(this.runtime, runEvaluators({ ...run, runtime: this.runtime }))
  }

  override stop(): Promise<void> {
    return Promise.resolve()
  }
}

const ownerClockProvider: Provider = {
  name: "PERSONAL_ASSISTANT_CLOCK",
  description: "The zone the owner's reminders and check-ins follow now.",
  dynamic: true,
  private: true,
  get: async (runtime) => {
    const zone = await onAgent(runtime, effect { return try ownerClockAt(try Clock.currentTimeMillis) })
    return { text: `Owner time zone: ${zone}. Name reminder and check-in times on this clock.`, values: { ownerTimeZone: zone }, data: { zone } }
  },
}

const ownerTimezoneEvaluator: RegisteredEvaluator = {
  name: "PERSONAL_ASSISTANT_OWNER_TIMEZONE",
  description: "Keeps the time zone the owner states, such as \"my timezone is America/New_York\", for reminders, check-ins, routines and the calendar, and reschedules them on it.",
  schema: { type: "object", properties: { zone: { type: "string" } }, required: ["zone"] },
  inputScope: "current_message",
  shouldRun: async ({ runtime, message }) => message.entityId !== runtime.agentId && typeof message.content.text === "string" && statedZone(message.content.text) !== undefined,
  resolveOutputWhen: () => true,
  resolveOutput: ({ message }) => ({ zone: statedZone(message.content.text ?? "") ?? "" }),
  prompt: () => "",
  processors: [{
    name: "keep-owner-zone",
    process: async ({ runtime, message }) => {
      const kept = await onAgent(runtime, stateOwnerZone(message.content.text ?? ""))
      const followed = kept.changed ? await onAgent(runtime, Effect.orElseSucceed(Effect.as(followOwnerClock(`zone:${message.id ?? kept.zone}`), true), () => false)) : false
      return { success: true, text: `Owner time zone is ${kept.zone}${kept.changed && !followed ? "; what fires on it moves over when the assistant next starts" : ""}.`, data: { zone: kept.zone, changed: kept.changed, rescheduled: followed } }
    },
  }],
}

let running: IAgentRuntime | undefined

export const personalAssistantPlugin = {
  name: personalAssistantPluginName,
  description: "Personal assistance: reminders, time zones, check-ins, goals, to-dos and routines, kept in the owner's agent.",
  init: async (_config: Record<string, string>, runtime: IAgentRuntime) => {
    running = runtime
    runtime.contexts.tryRegister(remindersContext)
    await runPromise(registerDeviceProposalFamily(runtime, reminderProposalFamily))
  },
  actions: [ownerRemindersAction, ownerGoalsAction, todosAction, ownerRoutinesAction, briefAction],
  providers: [ownerRemindersProvider, ownerGoalsProvider, currentTodosProvider, ownerRoutinesProvider, ownerClockProvider],
  evaluators: [ownerTimezoneEvaluator, ownerTravelEvaluator],
  services: [PersonalAssistantService, PersonalAssistantEvaluators],
  routes: [...routineRoutes(() => running), ...dossierRoutes(() => running), ...checkinRoutes(() => running)],
} satisfies AgentPlugin

export default personalAssistantPlugin
