// spec/assistant/reminders.md, "A reminder intent is proposed with a plan and what the original message asked"; spec/assistant/todos.md, "A mutation is applied once per idempotency key"; spec/assistant/goals.md, "A goal's check-ins are reconciled with its status and cadence on every change"; spec/assistant/routines.md, "A creation with an idempotency key creates at most one definition"

const Text = (most: number) => Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(most))
const Minutes = (least: number, most: number) => Schema.Int.check(Schema.isBetween({ minimum: least, maximum: most }))

export const ReminderDue = Schema.Union([
  Schema.Struct({ kind: Schema.Literal("in"), minutes: Minutes(1, 525_600) }),
  Schema.Struct({ kind: Schema.Literal("at"), instant: Text(40) }),
  Schema.Struct({ kind: Schema.Literal("local"), date: Text(10), time: Text(5) }),
])

export const Destination = Schema.NullOr(Schema.Literals(["chat", "device"]))
export const Alert = Schema.NullOr(Schema.Literals(["alert", "silent"]))

export const ReminderPlan = Schema.Struct({
  title: Text(200),
  body: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(2_000))),
  due: ReminderDue,
  destination: Destination,
  alert: Alert,
})
export type ReminderPlan = typeof ReminderPlan.Type

export const ReminderCheck = Schema.Struct({
  requested: Schema.Boolean,
  clock: Schema.Literals(["utc", "owner_local"]),
  destination: Destination,
  alert: Alert,
})
export type ReminderCheck = typeof ReminderCheck.Type

export const ReminderAnswer = Schema.Struct({
  op: Schema.Literals(["complete", "dismiss", "snooze", "acknowledge"]),
  target: Text(200),
  minutes: Schema.optionalKey(Minutes(1, 1_440)),
})
export type ReminderAnswer = typeof ReminderAnswer.Type

export const GoalRequest = Schema.Union([
  Schema.Struct({ op: Schema.Literal("create"), title: Text(200), description: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(2_000))), cadence: Schema.Literals(["none", "daily", "weekly"]) }),
  Schema.Struct({ op: Schema.Literal("update"), target: Text(200), status: Schema.Literals(["active", "paused", "archived", "satisfied"]), cadence: Schema.optionalKey(Schema.Literals(["none", "daily", "weekly"])) }),
  Schema.Struct({ op: Schema.Literal("delete"), target: Text(200) }),
  Schema.Struct({ op: Schema.Literal("dismiss_checkin"), target: Text(200), slot: Schema.Literals(["morning", "evening", "weekly"]) }),
  Schema.Struct({ op: Schema.Literal("checkin"), target: Text(200), progress: Schema.Literals(["on_track", "at_risk", "needs_attention"]), note: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(2_000))) }),
])
export type GoalRequest = typeof GoalRequest.Type

export const TodoRequest = Schema.Union([
  Schema.Struct({ op: Schema.Literal("create"), content: Text(500) }),
  Schema.Struct({ op: Schema.Literals(["start", "complete", "cancel", "reopen", "delete"]), target: Text(500) }),
  Schema.Struct({ op: Schema.Literal("clear") }),
  Schema.Struct({ op: Schema.Literal("list") }),
])
export type TodoRequest = typeof TodoRequest.Type

export const RoutineCreate = Schema.Struct({
  idempotencyKey: Text(256),
  title: Text(200),
  windows: Schema.Array(Schema.Literals(["morning", "afternoon", "evening", "night"])).check(Schema.isMinLength(1), Schema.isMaxLength(4)),
})
export type RoutineCreate = typeof RoutineCreate.Type

export const RoutineUpdate = Schema.Struct({ status: Schema.Literals(["active", "paused", "archived"]) })
export type RoutineUpdate = typeof RoutineUpdate.Type

export const OccurrenceAnswer = Schema.Struct({ op: Schema.Literals(["complete", "skip", "snooze", "mute", "unmute"]) })
export type OccurrenceAnswer = typeof OccurrenceAnswer.Type
