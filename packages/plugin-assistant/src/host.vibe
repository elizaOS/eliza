// spec/assistant/reminders.md, "A reminder is written at most once, and a refusal writes nothing"; spec/assistant/reminderEscalation.md, "A reminder, nudge or check-in that may have reached the owner is never sent again"; spec/assistant/reminderEscalation.md, "A step nudges only while its firing is unanswered, and a phone step inside quiet hours is held"; spec/assistant/goals.md, "A goal's check-ins are reconciled with its status and cadence on every change"; spec/assistant/reminderPresentation.md, "Issuance requires a nonblank body and title and a chat text beginning with the body"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { ModelType, ServiceType, type IAgentRuntime, type Memory, type NotificationService, type ReminderPresentation, type Service, type UUID } from "@elizaos/core"
import type { ScheduledTasksApi } from "@elizaos/agent"
import { sentAgain, type DeliveryEnd } from "../gen/assistant__reminderEscalation.effect.vibe"

export error SchedulerUnavailable { reason: string }
export error ModelUnavailable { reason: string }
export error DeliveryFailed { reason: string; ending: DeliveryEnd }
export error RecordUnreadable { key: string }

export type TaskTrigger =
  | { readonly kind: "once"; readonly atIso: string }
  | { readonly kind: "cron"; readonly expression: string; readonly tz: string }
  | { readonly kind: "manual" }

export interface AssistantTask {
  readonly kind: string
  readonly ownerVisible: boolean
  readonly promptInstructions: string
  readonly trigger: TaskTrigger
  readonly metadata: Readonly<Record<string, unknown>>
  readonly idempotencyKey: string
}

export interface TaskRow {
  readonly taskId: string
  readonly kind: string
  readonly promptInstructions: string
  readonly trigger: TaskTrigger
  readonly metadata: Readonly<Record<string, unknown>>
  readonly status: string
  readonly revision: number
}

export interface TaskEdit {
  readonly promptInstructions?: string
  readonly trigger?: TaskTrigger
}

export type TaskVerb =
  | { readonly tag: "SnoozeUntil"; readonly until: number }
  | { readonly tag: "SnoozeFor"; readonly minutes: number }
  | { readonly tag: "Skip" }
  | { readonly tag: "Complete" }
  | { readonly tag: "Dismiss" }
  | { readonly tag: "Acknowledge" }
  | { readonly tag: "Reopen" }

export type VerbAnswer =
  | { readonly kind: "applied" }
  | { readonly kind: "refused"; readonly reason: string }
  | { readonly kind: "notFound" }

export type DeliveryAnswer =
  | { readonly kind: "delivered" }
  | { readonly kind: "retry"; readonly afterMs: number; readonly reason: string }
  | { readonly kind: "undeliverable"; readonly error: string }

export interface Presented {
  readonly taskId: string
  readonly kind: string
  readonly roomId: UUID | undefined
  readonly presentation: ReminderPresentation
  readonly conversationOnly?: boolean
}

export service Scheduler {
  create(task: AssistantTask): { readonly created: boolean; readonly task: TaskRow }!SchedulerUnavailable
  answer(taskId: string, verb: TaskVerb, key: string): VerbAnswer!SchedulerUnavailable
  edit(taskId: string, change: TaskEdit, key: string): VerbAnswer!SchedulerUnavailable
  find(taskId: string): (TaskRow | undefined)!SchedulerUnavailable
  list(): (readonly TaskRow[])!SchedulerUnavailable
}

export service Model {
  complete(system: string, prompt: string, thinking?: "low" | "off"): string!ModelUnavailable
}

export service Presenter {
  present(presented: Presented): void!DeliveryFailed
}

export error ApprovalsUnavailable { reason: string }
export error CalendarUnavailable { reason: string }

export interface ApprovalView {
  readonly id: string
  readonly state: "pending" | "approved" | "retryable" | "reconciliation_required" | "done" | "rejected" | "expired"
  readonly action: string
  readonly reason: string
}

export service Approvals {
  list(): (readonly ApprovalView[])!ApprovalsUnavailable
}

export interface CalendarEventFacts {
  readonly title: string
  readonly startAt: number
  readonly endAt?: number
  readonly location?: string
  readonly synced: boolean
  readonly metadataValid: boolean
  readonly providerEditedAt: string | undefined
  readonly providerCreatedAt: string | undefined
  readonly copyUpdatedAt: number
}

export service Calendar {
  events(startAt: number, endAt: number): (readonly CalendarEventFacts[])!CalendarUnavailable
}

export service Facts {
  schedulingZone(): string!!
  runtimeZone(): string!!
  hostZone(): string!!
  now(): number!!
}

export const scheduledTasksServiceType = "scheduled-tasks"

const storePrefix = "eliza:personal-assistant:v1:"

function runtimeStore(runtime: IAgentRuntime): KeyValueStore.KeyValueStore {
  const refused = (method: string, key?: string) => (cause: unknown) => new KeyValueStore.KeyValueStoreError({ message: `The agent store refused ${method}`, method, key, cause })
  const unlisted = (method: string) => Effect.fail(new KeyValueStore.KeyValueStoreError({ message: "The agent store keeps no key listing", method }))
  return KeyValueStore.makeStringOnly({
    get: (key) => effect {
      const found = try tryPromise({ try: () => runtime.getCache<unknown>(storePrefix + key), catch: refused("get", key) })
      return typeof found === "string" ? found : undefined
    },
    set: (key, value) => effect {
      const kept = try tryPromise({ try: () => runtime.setCache(storePrefix + key, value), catch: refused("set", key) })
      if (!kept) throw refused("set", key)(undefined)
    },
    remove: (key) => effect {
      try tryPromise({ try: () => runtime.deleteCache(storePrefix + key), catch: refused("remove", key) })
    },
    clear: unlisted("clear"),
    size: unlisted("size"),
    keys: unlisted("keys"),
  })
}

export effect function readRecord<A>(key: string, decode: (raw: unknown) => Option.Option<A>) {
  const store = try KeyValueStore.KeyValueStore
  const raw = try orDie(store.get(key))
  if (raw === undefined) return undefined
  const parsed = try Effect.try({ try: () => JSON.parse(raw) as unknown, catch: () => new RecordUnreadable({ key }) })
  const decoded = decode(parsed)
  if (Option.isNone(decoded)) throw new RecordUnreadable({ key })
  return decoded.value
}

export effect function writeRecord(key: string, value: unknown) {
  const store = try KeyValueStore.KeyValueStore
  try orDie(store.set(key, JSON.stringify(value)))
}

export effect function removeRecord(key: string) {
  const store = try KeyValueStore.KeyValueStore
  try orDie(store.remove(key))
}

export function isAgentScheduledTasks(service: Service | null): service is ScheduledTasksApi {
  return service !== null && ["create", "deliverKind", "get", "list", "applyVerb"].every((name) => typeof Reflect.get(service, name) === "function")
}

function schedulerOf(runtime: IAgentRuntime): ScheduledTasksApi | undefined {
  const service = runtime.getService<Service>(scheduledTasksServiceType)
  return isAgentScheduledTasks(service) ? service : undefined
}

effect function agentScheduler(runtime: IAgentRuntime) {
  const tasks = schedulerOf(runtime)
  if (tasks === undefined) throw new SchedulerUnavailable({ reason: "The agent has no scheduled-tasks service" })
  return tasks
}

const unavailable = (cause: unknown) => new SchedulerUnavailable({ reason: cause instanceof Error ? cause.message : String(cause) })

function runtimeScheduler(runtime: IAgentRuntime): Scheduler.Shape {
  return {
    effect create(task) {
      const tasks = try agentScheduler(runtime)
      const made = try tryPromise({ try: () => tasks.create(task), catch: unavailable })
      return { created: made.kind === "created", task: made.task }
    },
    effect answer(taskId, verb, key) {
      const tasks = try agentScheduler(runtime)
      const reply = try tryPromise({ try: () => tasks.applyVerb(taskId, { kind: "verb", verb }, { tag: "Keyed", key }), catch: unavailable })
      return (reply.kind === "applied" ? { kind: "applied" } : reply) satisfies VerbAnswer
    },
    effect edit(taskId, change, key) {
      const tasks = try agentScheduler(runtime)
      const reply = try tryPromise({ try: () => tasks.applyVerb(taskId, { kind: "edit", edit: change }, { tag: "Keyed", key }), catch: unavailable })
      return (reply.kind === "applied" ? { kind: "applied" } : reply) satisfies VerbAnswer
    },
    effect find(taskId) {
      const tasks = try agentScheduler(runtime)
      return try tryPromise({ try: () => tasks.get(taskId), catch: unavailable })
    },
    effect list() {
      const tasks = try agentScheduler(runtime)
      return try tryPromise({ try: () => tasks.list({ ownerVisibleOnly: false }), catch: unavailable })
    },
  }
}

function runtimeModel(runtime: IAgentRuntime): Model.Shape {
  return {
    effect complete(system, prompt, thinking) {
      const text = try tryPromise({
        try: () => runtime.useModel(ModelType.TEXT_SMALL, thinking === undefined ? { system, prompt } : { system, prompt, providerOptions: { eliza: { thinking } } }),
        catch: (cause) => new ModelUnavailable({ reason: cause instanceof Error ? cause.message : String(cause) }),
      })
      if (typeof text !== "string") throw new ModelUnavailable({ reason: "The model returned no text" })
      return text
    },
  }
}

function runtimePresenter(runtime: IAgentRuntime): Presenter.Shape {
  const failed = (ending: DeliveryEnd) => (cause: unknown) => new DeliveryFailed({ reason: cause instanceof Error ? cause.message : String(cause), ending })
  return {
    effect present({ taskId, kind, roomId, presentation, conversationOnly }) {
      if (conversationOnly === true && roomId === undefined) throw new DeliveryFailed({ reason: "The reminder has no conversation to post in", ending: "NothingSent" })
      if (conversationOnly !== true) {
        const notifications = runtime.getService<NotificationService>(ServiceType.NOTIFICATION)
        if (notifications === null) throw new DeliveryFailed({ reason: "No notification service is registered", ending: "NothingSent" })
        try tryPromise({
          try: () => notifications.notify({
            title: presentation.title, body: presentation.body, category: "reminder", source: "personal-assistant",
            groupKey: taskId, data: { taskId, kind },
          }),
          catch: failed("AcceptanceUnknown"),
        })
      }
      if (roomId === undefined) return
      try tryPromise({
        try: () => runtime.createMemory({
          entityId: runtime.agentId, agentId: runtime.agentId, roomId,
          content: { text: presentation.chatText, source: "reminder", reminderPresentation: presentation },
        }, "messages"),
        catch: failed(conversationOnly === true ? "NothingSent" : "AcceptanceUnknown"),
      })
    },
  }
}

export effect function presentOnce(presented: Presented) {
  const shown = (try Presenter).present(presented) catch (failed) => failed
  return shown instanceof DeliveryFailed && sentAgain(shown.ending)
    ? { kind: "retry", afterMs: 60_000, reason: shown.reason } satisfies DeliveryAnswer
    : { kind: "delivered" } satisfies DeliveryAnswer
}

module node {
  /** @throws {never} */
  export function hostZoneName(): string {
    return Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC"
  }
}
import { hostZoneName } from node

function runtimeFacts(runtime: IAgentRuntime): Facts.Shape {
  const setting = (name: string) => {
    const zone = runtime.getSetting(name)
    return typeof zone === "string" ? zone.trim() : ""
  }
  return {
    effect schedulingZone() { return setting("DEFAULT_TIMEZONE") },
    effect runtimeZone() { return setting("TIMEZONE") },
    effect hostZone() { return hostZoneName() },
    effect now() { return try Clock.currentTimeMillis },
  }
}

const ownerApprovalsServiceType = "owner_approvals"

interface OwnerApprovals extends Service {
  list(query: { readonly phases: { readonly tag: "AllPhases" }; readonly limit: number }): Promise<readonly ApprovalView[]>
}

const isOwnerApprovals = (service: Service | null): service is OwnerApprovals => service !== null && typeof Reflect.get(service, "list") === "function"

function runtimeApprovals(runtime: IAgentRuntime): Approvals.Shape {
  return {
    effect list() {
      const queue = runtime.getService<Service>(ownerApprovalsServiceType)
      if (!isOwnerApprovals(queue)) throw new ApprovalsUnavailable({ reason: "The agent has no owner approval queue" })
      return try tryPromise({ try: () => queue.list({ phases: { tag: "AllPhases" }, limit: 200 }), catch: (cause) => new ApprovalsUnavailable({ reason: String(cause) }) })
    },
  }
}

const calendarServiceType = "calendar"

interface CalendarReads extends Service {
  eventsBetween(window: { readonly startAt: number; readonly endAt: number }): Promise<readonly CalendarEventFacts[]>
}

const isCalendarReads = (service: Service | null): service is CalendarReads => service !== null && typeof Reflect.get(service, "eventsBetween") === "function"

function runtimeCalendar(runtime: IAgentRuntime): Calendar.Shape {
  return {
    effect events(startAt, endAt) {
      const reads = runtime.getService<Service>(calendarServiceType)
      if (!isCalendarReads(reads)) return []
      return try tryPromise({ try: () => reads.eventsBetween({ startAt, endAt }), catch: (cause) => new CalendarUnavailable({ reason: String(cause) }) })
    },
  }
}

export function runtimeLayer(runtime: IAgentRuntime) {
  return Layer.mergeAll(
    Layer.succeed(KeyValueStore.KeyValueStore, runtimeStore(runtime)),
    Layer.succeed(Scheduler, runtimeScheduler(runtime)),
    Layer.succeed(Model, runtimeModel(runtime)),
    Layer.succeed(Presenter, runtimePresenter(runtime)),
    Layer.succeed(Facts, runtimeFacts(runtime)),
    Layer.succeed(Approvals, runtimeApprovals(runtime)),
    Layer.succeed(Calendar, runtimeCalendar(runtime)),
  )
}

export type AssistantPorts = KeyValueStore.KeyValueStore | Scheduler | Model | Presenter | Facts | Approvals | Calendar

export function requestOf(message: Memory) {
  return {
    messageId: message.id ?? "", text: typeof message.content.text === "string" ? message.content.text : "", roomId: message.roomId,
    askedAt: typeof message.createdAt === "number" && Number.isSafeInteger(message.createdAt) ? message.createdAt : undefined,
  }
}

export type OwnerRequest = ReturnType<typeof requestOf>

export function onAgent<A, E>(runtime: IAgentRuntime, program: A!E!AssistantPorts): Promise<A> {
  return runPromise(Effect.provide(program, runtimeLayer(runtime)))
}
