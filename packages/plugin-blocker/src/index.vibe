// spec/blocker/index.md, "Story: Block distractions for a chosen interval"; spec/blocker/index.md, "A requested app is named by the id its device installed, whatever its letter case"
import { Machine, installedAppId, stored, type BlockKind, type FocusBlock } from "../gen/blocker.effect.vibe"
import { AppBlocker, applyAppBlock, type AppBlockerPlugin } from "@elizaos/capacitor-appblocker"
import { WebsiteBlocker, applyWebsiteBlock, type WebsiteBlockerPlugin } from "@elizaos/capacitor-websiteblocker"
import { logger, type IAgentRuntime, type Plugin } from "@elizaos/core"
import { AppBlockerService } from "./app-blocker.vibe"
import { appBlockerProvider, websiteBlockerProvider } from "./providers.vibe"
import { BLOCKER_LOG_PREFIX } from "./types.vibe"
import {
  getSelfControlStatus,
  registerWebsiteBlockerTaskWorker,
  setSelfControlPluginConfig,
  WebsiteBlockerService,
  type SelfControlPluginConfig,
} from "./website-blocker.vibe"

export * from "./access.vibe"
export * from "./app-blocker.vibe"
export * from "./providers.vibe"
export * from "./types.vibe"
export * from "./website-blocker.vibe"

export error FocusBackendFailed { operation: "apply" | "read" | "clear"; reason: string }
export error FocusIdentityMissing

export service FocusBackend {
  apply(block: FocusBlock): boolean!FocusBackendFailed
  read(block: FocusBlock): boolean!FocusBackendFailed
  clear(block: FocusBlock): boolean!FocusBackendFailed
  installedApps(): (readonly string[])!FocusBackendFailed
}

export function createNativeFocusBackend(app: AppBlockerPlugin = AppBlocker, website: WebsiteBlockerPlugin = WebsiteBlocker): FocusBackend.Shape {
  return {
    effect apply(block) {
      const durationMinutes = Math.floor((block.expiry - (try Clock.currentTimeMillis)) / 60_000)
      if (durationMinutes <= 0) return false
      const failure = () => new FocusBackendFailed({ operation: "apply", reason: "device refused focus selection" })
      const result = block.blockKind === "ApplicationBlock"
        ? applyAppBlock({ packageNames: [...block.targets], durationMinutes }, app) catch effect () => { throw failure() }
        : applyWebsiteBlock({ domains: block.targets, durationMinutes }, website) catch effect () => { throw failure() }
      return result.success
    },
    effect read(block) {
      const current = try nativeFocusStatus(block.blockKind, app, website)
      return current.active && matchesTargets(current.targets, block.targets)
    },
    effect clear(block) {
      const current = try nativeFocusStatus(block.blockKind, app, website)
      if (!current.active) return true
      if (!matchesTargets(current.targets, block.targets)) return false
      const result = try tryPromise({
        try: () => block.blockKind === "ApplicationBlock" ? app.unblockApps() : website.stopBlock(),
        catch: () => new FocusBackendFailed({ operation: "clear", reason: "device refused to clear focus" }),
      })
      return result.success
    },
    effect installedApps() {
      const listed = try tryPromise({
        try: () => app.getInstalledApps(),
        catch: () => new FocusBackendFailed({ operation: "read", reason: "installed apps are unavailable" }),
      })
      return listed.apps.map((installed) => installed.packageName)
    },
  }
}

const foldCase = (id: string) => id.toLowerCase()

function requestedTargets(blockKind: BlockKind, targets: readonly string[]): readonly string[] {
  return [...new Set(targets.map((target) => blockKind === "WebsiteBlock" ? target.trim().toLowerCase() : target.trim()).filter((target) => target !== ""))]
}

function asInstalled(requested: readonly string[], installedIds: readonly string[]): readonly string[] {
  const installed = installedIds.map((appId) => ({ appId, foldedId: foldCase(appId) }))
  return [...new Set(requested.map((id) => installedAppId(id, foldCase(id), installed)))]
}

effect function installedTargets(backend: FocusBackend.Shape, blockKind: BlockKind, requested: readonly string[]) {
  if (blockKind !== "ApplicationBlock" || requested.length === 0) return requested
  const installedIds: readonly string[] = backend.installedApps() catch () => []
  return asInstalled(requested, installedIds)
}

function matchesTargets(seen: readonly string[], expected: readonly string[]): boolean {
  const unique = new Set(seen)
  return unique.size === expected.length && expected.every((target) => unique.has(target))
}

effect function nativeFocusStatus(kind: BlockKind, app: AppBlockerPlugin, website: WebsiteBlockerPlugin) {
  return try tryPromise({
    try: async () => {
      if (kind === "ApplicationBlock") {
        const status = await app.getStatus()
        return { active: status.active, targets: status.blockedPackageNames }
      }
      const status = await website.getStatus()
      return { active: status.active, targets: status.blockedWebsites }
    },
    catch: () => new FocusBackendFailed({ operation: "read", reason: "device focus status is unavailable" }),
  })
}

export interface FocusRequest {
  readonly ownerId: string
  readonly blockKind: BlockKind
  readonly targets: readonly string[]
  readonly deadline: number
}

export effect function enableFocus(request: FocusRequest) {
  const key = try blockKey(request.ownerId, request.blockKind)
  const now = try Clock.currentTimeMillis
  const backend = try FocusBackend
  const requested = requestedTargets(request.blockKind, request.targets)
  const targets = try installedTargets(backend, request.blockKind, requested)
  provide stored(key) {
    const gate = try Machine
    const block = try gate.receive({
      type: "requestBlock",
      ownerId: request.ownerId,
      blockKind: request.blockKind,
      targets: [...targets],
      now,
      deadline: request.deadline,
    }, request.ownerId)
    const applied = try backend.apply(block)
    return try gate.send({ type: "observeApplied", generation: block.generation, applied }, "device")
  }
}

export effect function reconcileFocus(ownerId: string, blockKind: BlockKind) {
  const key = try blockKey(ownerId, blockKind)
  const backend = try FocusBackend
  provide stored(key) {
    const gate = try Machine
    const block = try gate.get()
    if (block.phase === "ApplyingBlock") {
      const applied = try backend.read(block)
      return try gate.send({ type: "observeApplied", generation: block.generation, applied }, "device")
    }
    if (block.phase === "ClearingBlock") {
      const stillBlocked = try backend.read(block)
      return try gate.send({ type: "observeCleared", generation: block.generation, cleared: !stillBlocked }, "device")
    }
    return block
  }
}

export effect function clearFocus(ownerId: string, blockKind: BlockKind, generation: number, expired: boolean) {
  const key = try blockKey(ownerId, blockKind)
  const now = try Clock.currentTimeMillis
  const backend = try FocusBackend
  provide stored(key) {
    const gate = try Machine
    const block = try gate.send({ type: "requestClear", generation, now }, expired ? "scheduler" : ownerId)
    const cleared = try backend.clear(block)
    return try gate.send({ type: "observeCleared", generation, cleared }, "device")
  }
}

effect function blockKey(ownerId: string, blockKind: BlockKind) {
  if (ownerId === "" || ownerId === "device" || ownerId === "scheduler") throw new FocusIdentityMissing()
  return "focus:" + blockKind + ":" + ownerId
}

export const blockerPlugin: Plugin = {
  name: "@elizaos/plugin-blocker",
  description:
    "Focus / distraction control — website blocking via the SelfControl-style hosts engine and native app blocking. Exposes websiteBlockerProvider + appBlockerProvider and WebsiteBlockerService + AppBlockerService.",
  providers: [websiteBlockerProvider, appBlockerProvider],
  services: [WebsiteBlockerService, AppBlockerService],
  init: async (pluginConfig: Record<string, unknown>, runtime: IAgentRuntime) => {
    registerWebsiteBlockerTaskWorker(runtime)
    setSelfControlPluginConfig(pluginConfig as SelfControlPluginConfig)
    const status = await getSelfControlStatus()
    if (status.available) {
      logger.info(
        `${BLOCKER_LOG_PREFIX} Hosts-file blocker ready${
          status.active && status.endsAt !== null
            ? ` until ${status.endsAt}`
            : status.active
              ? " until manually unblocked"
              : ""
        }`,
      )
    } else {
      logger.warn(
        `${BLOCKER_LOG_PREFIX} Plugin loaded, but local website blocking is unavailable: ${status.reason ?? "unknown reason"}`,
      )
    }
  },
  dispose: async (runtime: IAgentRuntime) => {
    const website = runtime.getService<WebsiteBlockerService>(WebsiteBlockerService.serviceType)
    await website?.stop()
    const app = runtime.getService<AppBlockerService>(AppBlockerService.serviceType)
    await app?.stop()
  },
}

export default blockerPlugin
