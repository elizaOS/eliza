      { key: "member", name: "Member", color: "#57F287", permissions: ["ViewChannel", "SendMessages", "ReadMessageHistory"] },
    ],
    categories: [
      { key: "info", name: "Information" },
      { key: "general", name: "General" },
      { key: "voice", name: "Voice" },
    ],
    channels: [
      { key: "announcements", name: "announcements", type: "announcement", category: "info", overwrites: [{ role: "@everyone", deny: ["SendMessages"] }] },
      { key: "chat", name: "general", type: "text", category: "general" },
