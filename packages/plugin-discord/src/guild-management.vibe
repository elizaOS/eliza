}

export function renderTemplateString(template: string, variables: Readonly<Record<string, string>>): string {
  return template.replace(/\{\{\s*([a-zA-Z0-9_.-]+)\s*\}\}/g, (_match, key: string) => variables[key] ?? "")
}

export function validateGuildTemplate(template: GuildTemplate): { readonly valid: boolean; readonly errors: readonly string[] } {
  const errors: string[] = []
  if (!template.id.trim()) errors.push("Template id is required.")
  if (!template.name.trim()) errors.push("Template name is required.")
  if (template.roles.length > GUILD_TEMPLATE_LIMITS.maxRoles) errors.push(`Too many roles (max ${GUILD_TEMPLATE_LIMITS.maxRoles}).`)
  if (template.categories.length > GUILD_TEMPLATE_LIMITS.maxCategories) errors.push(`Too many categories (max ${GUILD_TEMPLATE_LIMITS.maxCategories}).`)
  if (template.channels.length > GUILD_TEMPLATE_LIMITS.maxChannels) errors.push(`Too many channels (max ${GUILD_TEMPLATE_LIMITS.maxChannels}).`)
  const roleKeys = new Set<string>(["@everyone"])
  for (const role of template.roles) {
    if (!role.key.trim()) errors.push("Role key is required.")
    if (roleKeys.has(role.key)) errors.push(`Duplicate role key: ${role.key}`)
    roleKeys.add(role.key)
    for (const perm of role.permissions ?? []) {
      if (perm.trim().toLowerCase() === "administrator") {
        errors.push(`Role "${role.key}" may not grant Administrator permission.`)
      }
    }
  }
  const categoryKeys = new Set<string>()
  for (const category of template.categories) {
    if (!category.key.trim()) errors.push("Category key is required.")
    if (categoryKeys.has(category.key)) errors.push(`Duplicate category key: ${category.key}`)
    categoryKeys.add(category.key)
  }
  const channelKeys = new Set<string>()
  for (const channel of template.channels) {
    if (!channel.key.trim()) errors.push("Channel key is required.")
    if (channelKeys.has(channel.key)) errors.push(`Duplicate channel key: ${channel.key}`)
    channelKeys.add(channel.key)
    if (channel.category && !categoryKeys.has(channel.category)) {
      errors.push(`Channel "${channel.key}" references unknown category "${channel.category}".`)
    }
    for (const overwrite of channel.overwrites ?? []) {
      if (!roleKeys.has(overwrite.role)) {
        errors.push(`Channel "${channel.key}" overwrite references unknown role "${overwrite.role}".`)
      }
      for (const perm of [...(overwrite.allow ?? []), ...(overwrite.deny ?? [])]) {
        if (perm.trim().toLowerCase() === "administrator") {
          errors.push(`Channel "${channel.key}" overwrite may not reference Administrator.`)
        }
      }
    }
  }
  return { valid: errors.length === 0, errors }
}
