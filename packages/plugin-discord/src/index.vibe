// spec/discord/index.md, "Account DM and guild rules decide admission before an agent turn"; spec/discord/index.md, "Every accepted Discord event keeps the captured account and channel"; spec/discord/index.md, "A stale response is tagged, suppressed, or left alone by its policy"
import { Client, Events, GatewayIntentBits, Partials, type AttachmentPayload, type Message } from "discord.js"
import { ChannelType, Service, checkPairingAllowed, chunkText, createUniqueUuid, fetchRemoteMedia, type Content, type IAgentRuntime, type Memory, type Plugin, type SendHandlerOutcome, type TargetInfo, requireConfirmedSendHandlerDelivery } from "@elizaos/core"
import { initial, machineOver, discordStalenessDecision, type DiscordPolicy } from "../gen/discord.effect.vibe"

export interface DiscordConnection {
  readonly accountId: string
  readonly token: Redacted.Redacted<string>
  readonly channelIds: ReadonlySet<string>
  readonly guildIds: ReadonlySet<string>
  readonly directSenderIds: ReadonlySet<string>
  readonly dmMode: DiscordPolicy["dmMode"]
  readonly groupMode: DiscordPolicy["groupMode"]
  readonly requireMention: boolean
  readonly replyMode: "DiscordTagStale" | "DiscordSkipStale" | "DiscordIgnoreStale"
  readonly replyThreshold: number
  readonly allowAutoThreads: boolean
}

export error DiscordRequestFailed { stage: string }

export effect function connectDiscordAccount(runtime: IAgentRuntime, config: DiscordConnection) {
  const client = try Effect.try({ try: () => new Client({ intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages, GatewayIntentBits.DirectMessages, GatewayIntentBits.MessageContent], partials: [Partials.Channel] }), catch: () => new DiscordRequestFailed({ stage: "client" }) })
  const state = try Ref.make(initial)
  const admission = try machineOver(() => Ref.get(state), next => Ref.set(state, next))
  const epoch = (try admission.send({ type: "connectDiscord", accountId: config.accountId }, "DiscordGateway")).state.epoch
  const sequence = new Map<string, number>()

  effect function send(target: TargetInfo, content: Content): SendHandlerOutcome!DiscordRequestFailed {
    const channelId = target.threadId ?? target.channelId
    if (channelId === undefined || target.accountId !== undefined && target.accountId !== config.accountId || !(try admission.get()).connected) return { kind: "not_delivered", code: "DISCORD_INVALID_TARGET", message: "The selected Discord account or channel is unavailable." }
    const text = content.text?.trim() ?? ""
    const attachments = content.attachments ?? []
    if ((text === "" && attachments.length === 0) || attachments.length > 10) return { kind: "not_delivered", code: "DISCORD_INVALID_CONTENT", message: "Discord requires text or up to ten attachments." }
    const files: AttachmentPayload[] = []
    for (const attachment of attachments) {
      const media = try tryPromise({ try: signal => fetchRemoteMedia({ url: attachment.url, maxBytes: 8 * 1024 * 1024, signal }), catch: () => new DiscordRequestFailed({ stage: "media" }) })
      files.push({ attachment: media.buffer, name: media.fileName ?? attachment.filename ?? "attachment" })
    }
    const channel = try tryPromise({ try: () => client.channels.fetch(channelId), catch: () => new DiscordRequestFailed({ stage: "channel" }) })
    if (!channel?.isSendable() || !(try admission.get()).connected) return { kind: "not_delivered", code: "DISCORD_CHANNEL_UNAVAILABLE", message: "The selected Discord channel does not accept messages." }
    const parts = text === "" ? [""] : try Effect.try({ try: () => chunkText(text, 2000), catch: () => new DiscordRequestFailed({ stage: "text" }) })
    const ids: string[] = []
    for (const [index, part] of parts.entries()) {
      if (!(try admission.get()).connected) break
      const post: () => Promise<{ id: string }> = () => channel.send({
        ...(part === "" ? {} : { content: part }),
        ...(index === 0 && files.length > 0 ? { files } : {}),
        allowedMentions: { parse: [] },
      })
      const answer = tryPromise(post) catch () => undefined
      if (answer === undefined || answer.id === "") break
      ids.push(answer.id)
    }
    const [first, ...rest] = ids
    if (first === undefined) throw new DiscordRequestFailed({ stage: "delivery-unknown" })
    const providerMessageIds: [string, ...string[]] = [first, ...rest]
    const receipt = { providerMessageIds, acceptedAt: try Clock.currentTimeMillis, persistence: { status: "not_attempted" as const, reason: "Discord returned provider message identifiers." } }
    return ids.length === parts.length ? { kind: "delivered", receipt, memories: [] } : { kind: "partially_delivered", receipt, memories: [], code: "DISCORD_PARTIAL_SEND", message: "Discord confirmed part of the send. Repeating it may duplicate messages." }
  }

  effect function inbound(message: Message) {
    const bot = client.user
    const messageService = runtime.messageService
    if (bot === null || message.author.bot || !messageService || message.system) return
    const prior = (sequence.get(message.channelId) ?? 0) + 1
    sequence.set(message.channelId, prior)
    const thread = try Effect.orDie(Effect.try({
      try: () => message.channel.isThread() ? message.channel : undefined,
      catch: (error) => error,
    }))
    const parentId = thread?.parentId
    const channelAllowed = config.channelIds.has(message.channelId) || (parentId != null && config.channelIds.has(parentId))
    const pairing = message.guildId === null && config.dmMode === "DiscordDmPairing" && !config.directSenderIds.has(message.author.id) ? tryPromise(() => checkPairingAllowed(runtime, { channel: "discord", senderId: message.author.id, metadata: { username: message.author.username } })) catch () => undefined : undefined
    if (pairing?.replyMessage) send({ source: "discord", accountId: config.accountId, channelId: message.channelId }, { text: pairing.replyMessage }) catch () => undefined
    const policy: DiscordPolicy = { dmMode: config.dmMode, groupMode: config.groupMode, guildAllowed: message.guildId !== null && (config.guildIds.size === 0 || config.guildIds.has(message.guildId)), channelListConfigured: config.channelIds.size > 0, channelAllowed, actorAllowed: config.directSenderIds.has(message.author.id), admin: false, paired: pairing?.allowed === true, channelAddressing: config.requireMention ? "DiscordRequireMention" : "DiscordDoNotRequireMention", guildAddressing: "DiscordDefaultMention", botAutoThread: config.allowAutoThreads && thread?.ownerId === bot.id }
    const accepted = admission.send({ type: "admitDiscord", inbound: { accountId: config.accountId, epoch, channelId: message.channelId, messageId: message.id, senderId: message.author.id, scope: thread !== undefined ? "DiscordThread" : message.guildId === null ? "DiscordDirect" : "DiscordGuild", inboundKind: "DiscordMessage", mentioned: message.mentions.users.has(bot.id), commandAllowed: false }, policy }, "DiscordGateway") catch () => undefined
    if (accepted === undefined) return
    const scope = `discord:${config.accountId}`
    const id = try Effect.try(() => createUniqueUuid(runtime, `${scope}:message:${message.id}`))
    const entityId = try Effect.try(() => createUniqueUuid(runtime, `${scope}:user:${message.author.id}`))
    const roomId = try Effect.try(() => createUniqueUuid(runtime, `${scope}:channel:${message.channelId}`))
    const worldId = try Effect.try(() => createUniqueUuid(runtime, `${scope}:world:${message.guildId ?? message.author.id}`))
    const channelType = message.guildId === null ? ChannelType.DM : ChannelType.GROUP
    try tryPromise(() => runtime.ensureConnection({ entityId, roomId, worldId, source: "discord", name: message.author.displayName, userName: message.author.username, channelId: message.channelId, serverId: message.guildId ?? message.author.id, type: channelType, metadata: { accountId: config.accountId } }))
    const incoming: Memory = { id, entityId, roomId, worldId, agentId: runtime.agentId, createdAt: message.createdTimestamp, content: { text: message.content, source: "discord", channelType, attachments: Array.from(message.attachments.values(), attachment => ({ id: attachment.id, url: attachment.url, title: attachment.name, ...(attachment.contentType ? { mimeType: attachment.contentType } : {}), source: "discord" })) } }
    try tryPromise(() => messageService.handleMessage(runtime, incoming, async reply => {
      const decision = discordStalenessDecision(config.replyMode, true, config.replyThreshold, prior, sequence.get(message.channelId) ?? prior)
      if (decision !== "DiscordSuppressReply") {
        const text = reply.text ?? ""
        const content = decision === "DiscordSendTagged" && text !== "" && !/^\s*\(catching up:\)/i.test(text) ? { ...reply, text: `(catching up:) ${text}` } : reply
        requireConfirmedSendHandlerDelivery(await runPromise(send({ source: "discord", accountId: config.accountId, channelId: message.channelId }, content)))
      }
      return []
    }))
  }

  client.on(Events.MessageCreate, (message) => {
    void runPromise(exit(inbound(message)))
  })
  try tryPromise({ try: () => client.login(Redacted.value(config.token)), catch: () => new DiscordRequestFailed({ stage: "login" }) })
  try Effect.try({ try: () => runtime.registerMessageConnector({ source: "discord", accountId: config.accountId, accountRouting: "connector", label: "Discord", sendHandler: (_runtime, target, content) => runPromise(send(target, content)) }), catch: () => new DiscordRequestFailed({ stage: "registration" }) })
  return {
    send,
    effect stop() {
      admission.send({ type: "disconnectDiscord" }, "DiscordGateway") catch () => undefined
      try tryPromise({ try: () => client.destroy(), catch: () => new DiscordRequestFailed({ stage: "stop" }) })
    },
  }
}

function readIds(value: unknown): Set<string> {
  return new Set(typeof value === "string" ? value.split(",").map(id => id.trim()).filter(id => /^\d+$/.test(id)) : [])
}

class DiscordConnector extends Service {
  static override serviceType = "discord"
  override capabilityDescription = "Connects authorized Discord bot channels to the agent"

  constructor(runtime?: IAgentRuntime)
  constructor(runtime: IAgentRuntime, close: () => Promise<void>)
  constructor(runtime?: IAgentRuntime, readonly close: () => Promise<void> = () => Promise.resolve()) { super(runtime) }

  static override async start(runtime: IAgentRuntime): Promise<DiscordConnector> {
    const token = runtime.getSetting("DISCORD_API_TOKEN")
    if (typeof token !== "string" || token.trim() === "") return new DiscordConnector(runtime)
    const dmSetting = runtime.getSetting("DISCORD_DM_POLICY")
    const groupSetting = runtime.getSetting("DISCORD_GROUP_POLICY")
    const connection = await runPromise(connectDiscordAccount(runtime, {
      accountId: "default", token: Redacted.make(token), channelIds: readIds(runtime.getSetting("CHANNEL_IDS")), guildIds: readIds(runtime.getSetting("DISCORD_GUILD_IDS")), directSenderIds: readIds(runtime.getSetting("DISCORD_ALLOW_FROM")),
      dmMode: dmSetting === "open" ? "DiscordDmOpen" : dmSetting === "disabled" ? "DiscordDmDisabled" : dmSetting === "allowlist" ? "DiscordDmAllowlist" : "DiscordDmPairing",
      groupMode: groupSetting === "disabled" ? "DiscordGroupDisabled" : groupSetting === "open" ? "DiscordGroupOpen" : "DiscordGroupAllowlist",
      requireMention: runtime.getSetting("DISCORD_REQUIRE_MENTION") !== "false", replyMode: "DiscordTagStale", replyThreshold: 3, allowAutoThreads: false,
    }))
    return new DiscordConnector(runtime, () => runPromise(connection.stop()))
  }

  override stop(): Promise<void> { return this.close() }
}

export const discordPlugin: Plugin = { name: "@elizaos/plugin-discord", description: "Discord connector", services: [DiscordConnector] }
export { discordPlugin as default }
