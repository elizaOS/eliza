module node {
  import { randomBytes } from "node:crypto"
  export function nextDiscordNonce(): string { return randomBytes(12).toString("hex") }
}
import { nextDiscordNonce } from node

export interface DiscordConnection {
  readonly accountId: string
  readonly token: Redacted.Redacted<string>
  readonly channelIds: ReadonlySet<string>
  readonly guildIds: ReadonlySet<string>
  readonly directSenderIds: ReadonlySet<string>
  readonly dmMode: DiscordPolicy["dmMode"]
  readonly groupMode: DiscordPolicy["groupMode"]
  readonly requireMention: boolean
  readonly replyMode: "DiscordTagStale" | "DiscordSkipStale" | "DiscordIgnoreStale"
  readonly replyThreshold: number
  readonly allowAutoThreads: boolean
}

export error DiscordRequestFailed { stage: string }

export type DiscordSessionMachineHandle = DiscordSenderMachineHandle<
  DiscordSession,
  DiscordSessionEvent,
  DiscordCaller,
  DiscordEffect
>

export function createDiscordSessionHandle(): DiscordSessionMachineHandle {
  const created = runSync(effect {
    provide machine() {
      const m = try Machine
      return m
    }
  })
  return wrapDiscordSenderMachineHandle(created)
}

export effect function postDiscordPart(channel: SendableChannels, part: string, files: readonly AttachmentPayload[]) {
  const nonce = try Effect.try({ try: () => nextDiscordNonce(), catch: () => new DiscordRequestFailed({ stage: "nonce" }) })
  const post: () => Promise<{ id: string }> = () => channel.send({
    ...(part === "" ? {} : { content: part }),
    ...(files.length > 0 ? { files: [...files] } : {}),
    allowedMentions: { parse: [] },
    nonce,
    enforceNonce: true,
  })
  const answer = tryPromise(post) catch () => undefined
  return answer === undefined || answer.id === "" ? undefined : answer.id
}

export effect function connectDiscordAccount(runtime: IAgentRuntime, config: DiscordConnection) {
  const client = try Effect.try({
    try: () => new Client({
      intents: [
        GatewayIntentBits.Guilds,
        GatewayIntentBits.GuildMessages,
        GatewayIntentBits.DirectMessages,
        GatewayIntentBits.MessageContent,
      ],
      partials: [Partials.Channel],
    }),
    catch: () => new DiscordRequestFailed({ stage: "client" }),
  })
  const state = try Ref.make(initial)
  const admission = try machineOver(() => Ref.get(state), (next) => Ref.set(state, next))
  const epoch = (try admission.send({ type: "connectDiscord", accountId: config.accountId }, "DiscordGateway")).state.epoch
  const sequence = new Map<string, number>()

  effect function send(target: TargetInfo, content: Content): SendHandlerOutcome!DiscordRequestFailed {
    const channelId = target.threadId ?? target.channelId
    if (channelId === undefined || (target.accountId !== undefined && target.accountId !== config.accountId) || !(try admission.get()).connected) {
      return { kind: "not_delivered", code: "DISCORD_INVALID_TARGET", message: "The selected Discord account or channel is unavailable." }
    }
    const text = content.text?.trim() ?? ""
    const attachments = content.attachments ?? []
    if ((text === "" && attachments.length === 0) || attachments.length > 10) {
      return { kind: "not_delivered", code: "DISCORD_INVALID_CONTENT", message: "Discord requires text or up to ten attachments." }
    }
    const files: AttachmentPayload[] = []
    for (const attachment of attachments) {
      const media = try tryPromise({
        try: (signal) => fetchRemoteMedia({ url: attachment.url, maxBytes: 8 * 1024 * 1024, signal }),
        catch: () => new DiscordRequestFailed({ stage: "media" }),
      })
      files.push({ attachment: media.buffer, name: media.fileName ?? attachment.filename ?? "attachment" })
    }
    const channel = try tryPromise({ try: () => client.channels.fetch(channelId), catch: () => new DiscordRequestFailed({ stage: "channel" }) })
    if (!channel?.isSendable() || !(try admission.get()).connected) {
      return { kind: "not_delivered", code: "DISCORD_CHANNEL_UNAVAILABLE", message: "The selected Discord channel does not accept messages." }
    }
    const parts = text === "" ? [""] : try Effect.try({ try: () => chunkText(text, 2000), catch: () => new DiscordRequestFailed({ stage: "text" }) })
    const ids: string[] = []
    for (const [index, part] of parts.entries()) {
      if (!(try admission.get()).connected) break
      const id = try postDiscordPart(channel, part, index === 0 ? files : [])
      if (id === undefined) break
      ids.push(id)
    }
    const [first, ...rest] = ids
    if (first === undefined) throw new DiscordRequestFailed({ stage: "delivery-unknown" })
    const providerMessageIds: [string, ...string[]] = [first, ...rest]
    const receipt = {
      providerMessageIds,
      acceptedAt: try Clock.currentTimeMillis,
      persistence: { status: "not_attempted" as const, reason: "Discord returned provider message identifiers." },
    }
    return ids.length === parts.length
      ? { kind: "delivered", receipt, memories: [] }
      : { kind: "partially_delivered", receipt, memories: [], code: "DISCORD_PARTIAL_SEND", message: "Discord confirmed part of the send. Repeating it may duplicate messages." }
  }

  effect function inbound(message: Message) {
    const bot = client.user
    const messageService = runtime.messageService
    if (bot === null || message.author.bot || !messageService || message.system) return
    const prior = (sequence.get(message.channelId) ?? 0) + 1
    sequence.set(message.channelId, prior)
    const thread = try Effect.orDie(Effect.try({
      try: () => (message.channel.isThread() ? message.channel : undefined),
      catch: (error) => error,
    }))
    const parentId = thread?.parentId
    const channelAllowed = config.channelIds.has(message.channelId) || (parentId != null && config.channelIds.has(parentId))
    const pairing = message.guildId === null && config.dmMode === "DiscordDmPairing" && !config.directSenderIds.has(message.author.id)
      ? tryPromise(() => checkPairingAllowed(runtime, { channel: "discord", senderId: message.author.id, metadata: { username: message.author.username } })) catch () => undefined
      : undefined
    if (pairing?.replyMessage) send({ source: "discord", accountId: config.accountId, channelId: message.channelId }, { text: pairing.replyMessage }) catch () => undefined
    const policy: DiscordPolicy = {
      dmMode: config.dmMode,
      groupMode: config.groupMode,
      guildAllowed: message.guildId !== null && (config.guildIds.size === 0 || config.guildIds.has(message.guildId)),
      channelListConfigured: config.channelIds.size > 0,
      channelAllowed,
      actorAllowed: config.directSenderIds.has(message.author.id),
      admin: false,
      paired: pairing?.allowed === true,
      channelAddressing: config.requireMention ? "DiscordRequireMention" : "DiscordDoNotRequireMention",
      guildAddressing: "DiscordDefaultMention",
      botAutoThread: config.allowAutoThreads && thread?.ownerId === bot.id,
    }
    const accepted = admission.send({
      type: "admitDiscord",
      inbound: {
        accountId: config.accountId,
        epoch,
        channelId: message.channelId,
        messageId: message.id,
        senderId: message.author.id,
        scope: thread !== undefined ? "DiscordThread" : message.guildId === null ? "DiscordDirect" : "DiscordGuild",
        inboundKind: "DiscordMessage",
        mentioned: message.mentions.users.has(bot.id),
        commandAllowed: false,
      },
      policy,
    }, "DiscordGateway") catch () => undefined
    if (accepted === undefined) return
    const scope = `discord:${config.accountId}`
    const id = try Effect.try(() => createUniqueUuid(runtime, `${scope}:message:${message.id}`))
    const entityId = try Effect.try(() => createUniqueUuid(runtime, `${scope}:user:${message.author.id}`))
    const roomId = try Effect.try(() => createUniqueUuid(runtime, `${scope}:channel:${message.channelId}`))
    const worldId = try Effect.try(() => createUniqueUuid(runtime, `${scope}:world:${message.guildId ?? message.author.id}`))
    const channelType = message.guildId === null ? ChannelType.DM : ChannelType.GROUP
    try tryPromise(() => runtime.ensureConnection({
      entityId,
      roomId,
      worldId,
      source: "discord",
      name: message.author.displayName,
      userName: message.author.username,
      channelId: message.channelId,
      serverId: message.guildId ?? message.author.id,
      type: channelType,
      metadata: { accountId: config.accountId },
    }))
    const incoming: Memory = {
      id,
      entityId,
      roomId,
      worldId,
      agentId: runtime.agentId,
      createdAt: message.createdTimestamp,
      content: {
        text: message.content,
        source: "discord",
        channelType,
        attachments: Array.from(message.attachments.values(), (attachment) => ({
          id: attachment.id,
          url: attachment.url,
          title: attachment.name,
          ...(attachment.contentType ? { mimeType: attachment.contentType } : {}),
          source: "discord",
        })),
      },
    }
    try tryPromise(() => messageService.handleMessage(runtime, incoming, async (reply) => {
      const decision = discordStalenessDecision(config.replyMode, true, config.replyThreshold, prior, sequence.get(message.channelId) ?? prior)
      if (decision !== "DiscordSuppressReply") {
        const text = reply.text ?? ""
        const content = decision === "DiscordSendTagged" && text !== "" && !/^\s*\(catching up:\)/i.test(text)
          ? { ...reply, text: `(catching up:) ${text}` }
          : reply
        requireConfirmedSendHandlerDelivery(await runPromise(send({ source: "discord", accountId: config.accountId, channelId: message.channelId }, content)))
      }
      return []
    }))
  }

  client.on(Events.MessageCreate, (message) => {
    void runPromise(exit(inbound(message)))
  })
  try tryPromise({ try: () => client.login(Redacted.value(config.token)), catch: () => new DiscordRequestFailed({ stage: "login" }) })
  try Effect.try({
    try: () => runtime.registerMessageConnector({
      source: "discord",
      accountId: config.accountId,
      accountRouting: "connector",
      label: "Discord",
      sendHandler: (_runtime, target, content) => runPromise(send(target, content)),
    }),
    catch: () => new DiscordRequestFailed({ stage: "registration" }),
  })
  return {
    client,
    send,
    effect stop() {
      admission.send({ type: "disconnectDiscord" }, "DiscordGateway") catch () => undefined
      try tryPromise({ try: () => client.destroy(), catch: () => new DiscordRequestFailed({ stage: "stop" }) })
    },
  }
}

function readSnowflakeSet(value: unknown): Set<string> {
  return new Set(typeof value === "string" ? value.split(",").map((id) => id.trim()).filter((id) => /^\d+$/.test(id)) : [])
}

export class DiscordService extends Service {
  static override serviceType = DISCORD_SERVICE_NAME
  override capabilityDescription = "Connects authorized Discord bot channels, threads, voice targets, and server management to the agent."

  readonly pool = new DiscordAccountClientPool()
  readonly dmRegistry = new DmChannelRegistry()
  readonly voiceTargets = new DiscordVoiceTargetRegistry()
  readonly drainRegistry = createTurnDrainRegistry()
  readonly speakerLeases = createInMemorySpeakerLeaseStore()
  private readonly closeHandlers: Array<() => Promise<void>> = []
  private readonly sendHandlers = new Map<string, (target: TargetInfo, content: Content) => Promise<SendHandlerOutcome>>()
  private readonly knownRooms = new Map<string, MessageConnectorTarget>()
  private readonly recentChannelMemories = new Map<string, Memory[]>()

  constructor(runtime?: IAgentRuntime) {
    super(runtime)
  }

  static override async start(runtime: IAgentRuntime): Promise<DiscordService> {
    const service = new DiscordService(runtime)
    const policy = await readDiscordAccountPolicy(runtime).catch(() => ({}))
    const accounts = listEnabledDiscordAccounts(runtime).filter((acc) => !isDiscordAccountDisabledByPolicy(policy, acc))
    const settings = getDiscordSettings(runtime)
    for (const account of accounts) {
      const dmMode: DiscordPolicy["dmMode"] =
        settings.DISCORD_DM_POLICY === "open"
          ? "DiscordDmOpen"
          : settings.DISCORD_DM_POLICY === "disabled"
            ? "DiscordDmDisabled"
            : settings.DISCORD_DM_POLICY === "allowlist"
              ? "DiscordDmAllowlist"
              : "DiscordDmPairing"
      const groupMode: DiscordPolicy["groupMode"] =
        settings.DISCORD_GROUP_POLICY === "disabled"
          ? "DiscordGroupDisabled"
          : settings.DISCORD_GROUP_POLICY === "open"
            ? "DiscordGroupOpen"
            : "DiscordGroupAllowlist"
      const connection = await runPromise(connectDiscordAccount(runtime, {
        accountId: account.accountId,
        token: Redacted.make(account.token),
        channelIds: readSnowflakeSet(account.config.channelIds?.join(",") ?? settings.CHANNEL_IDS),
        guildIds: readSnowflakeSet(settings.DISCORD_GUILD_IDS),
        directSenderIds: readSnowflakeSet(settings.DISCORD_ALLOW_FROM),
        dmMode,
        groupMode,
        requireMention: settings.DISCORD_REQUIRE_MENTION,
        replyMode: "DiscordTagStale",
        replyThreshold: 3,
        allowAutoThreads: false,
      }))
      service.pool.set(account.accountId, connection.client, connection.client.isReady(), connection.client.user?.id)
      service.sendHandlers.set(account.accountId, (target, content) => runPromise(connection.send(target, content)))
      service.closeHandlers.push(() => runPromise(connection.stop()))
    }
    return service
  }

  getClient(accountId?: string): Client | null {
    return this.pool.getClient(accountId)
  }

  registerConnectorRoom(room: MessageConnectorTarget): void {
    if (room.target.channelId) this.knownRooms.set(room.target.channelId, room)
  }

  recordChannelMemory(channelId: string, memory: Memory): void {
    const existing = this.recentChannelMemories.get(channelId) ?? []
    existing.push(memory)
    if (existing.length > 200) existing.splice(0, existing.length - 200)
    this.recentChannelMemories.set(channelId, existing)
  }

  setSendHandlerForAccount(accountId: string, handler: (target: TargetInfo, content: Content) => Promise<SendHandlerOutcome>): void {
    this.sendHandlers.set(normalizeAccountId(accountId), handler)
  }

  async listConnectorRooms(_context: MessageConnectorQueryContext): Promise<MessageConnectorTarget[]> {
    return Array.from(this.knownRooms.values())
  }

  async fetchConnectorMessages(
    _context: MessageConnectorQueryContext,
    params: { readonly target?: TargetInfo; readonly channelId?: string; readonly limit?: number; readonly before?: string; readonly after?: string },
  ): Promise<Memory[]> {
    const channelId = params.channelId ?? params.target?.channelId
    if (!channelId) return []
    const stored = this.recentChannelMemories.get(channelId) ?? []
    const limit = Math.max(1, params.limit ?? 25)
    return stored.slice(-limit)
  }

  async handleSendMessage(
    _runtime: IAgentRuntime,
    target: TargetInfo,
    content: Content,
  ): Promise<SendHandlerOutcome> {
    const accountId = normalizeAccountId(target.accountId ?? DEFAULT_ACCOUNT_ID)
    const handler = this.sendHandlers.get(accountId) ?? this.sendHandlers.values().next().value
    if (!handler) {
      return { kind: "not_delivered", code: "DISCORD_NOT_CONNECTED", message: "No active Discord account send handler." }
    }
    return handler(target, content)
  }

  resolveManageServerDestination(
    params: { readonly target?: TargetInfo; readonly serverId: string },
    accountId = DEFAULT_ACCOUNT_ID,
  ): MessageConnectorManageServerDestination {
    return resolveDiscordManageServerDestination(this.runtime, params, normalizeAccountId(accountId))
  }

  override async stop(): Promise<void> {
    await this.drainRegistry.drain(DISCORD_SHUTDOWN_DRAIN_TIMEOUT_MS)
    const closers = [...this.closeHandlers]
    this.closeHandlers.length = 0
    for (const close of closers) {
      await close().catch(() => undefined)
    }
    await this.pool.destroyAll()
    this.voiceTargets.clear()
  }
}

export type DiscordPlugin = Plugin & {
  readonly routes: readonly DiscordRoute[]
}

export const discordPlugin: DiscordPlugin = {
  name: "@elizaos/plugin-discord",
  description: "Discord service plugin for integration with Discord servers, channels, threads, voice, and local IPC",
  connectorSources: [
    {
      source: "discord",
      aliases: ["discord", "discord-local"],
      sourceKind: "passive",
      isPassive: true,
    },
  ],
  services: [
    DiscordService,
    DiscordLocalService,
    DiscordOwnerPairingServiceImpl,
    DiscordUserAccountScraperImpl,
  ],
  routes: [...discordSetupRoutes, ...discordDataRoutes],
  actions: [],
  providers: [],
  schema: discordCoordinationSchema,
  autoEnable: {
    connectorKeys: ["discord"],
    shouldEnable,
  },
  init: async (_config: Record<string, string>, runtime: IAgentRuntime) => {
    try {
      const manager = getConnectorAccountManager(runtime)
      manager.registerProvider(createDiscordConnectorAccountProvider(runtime))
    } catch (err) {
      logger.warn({ src: "plugin:discord", err: err instanceof Error ? err.message : String(err) }, "Failed to register Discord provider with ConnectorAccountManager")
    }
    registerDiscordDmSensitiveRequestAdapter(runtime)
    registerDiscordTriageAdapter()
    registerDiscordTargetSource(runtime)
  },
  async dispose(runtime: IAgentRuntime) {
    const svc = runtime.getService<DiscordService>(DISCORD_SERVICE_NAME)
    await svc?.stop()
  },
}

export default discordPlugin

