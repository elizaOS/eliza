    updatedAt: "timestamptz not null default now()",
  },
  primaryKey: ["server_id", "trust_group_id", "channel_id", "edge_epoch", "lane", "slot_index"],
  indexes: [
    "discord_coord_reply_slots_bot_inbound_uq",
    "discord_coord_reply_slots_nonce_idx",
