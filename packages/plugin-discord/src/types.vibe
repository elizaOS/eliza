export const discordCoordinationSchema = {
  discordCoordinationTrustMembersTable,
  discordCoordinationHumanEdgesTable,
  discordCoordinationReplySlotsTable,
  discordCoordinationReceiptsTable,
} as const

export interface DiscordMachineHandle<S, E> {
  readonly state: () => S
  readonly dispatch: (event: E) => Promise<"accepted" | "refused">
  readonly receive: (raw: unknown) => Promise<"accepted" | "refused">
}

export function wrapDiscordMachineHandle<S, E>(created: {
  readonly get: () => S!never!never
  readonly send: (event: E) => unknown!({ readonly _tag: "Rejected" })!never
  readonly receive: (raw: unknown) => unknown!({ readonly _tag: "NotAnEvent" | "Rejected" })!never
}): DiscordMachineHandle<S, E> {
  return {
    state: () => runSync(created.get()),
    dispatch: (event) => runPromise(created.send(event).pipe(
      Effect.as("accepted" as const),
      Effect.catchTag("Rejected", () => Effect.succeed("refused" as const)),
    )),
    receive: (raw) => runPromise(created.receive(raw).pipe(
      Effect.as("accepted" as const),
      Effect.catchTag("NotAnEvent", () => Effect.succeed("refused" as const)),
      Effect.catchTag("Rejected", () => Effect.succeed("refused" as const)),
    )),
  }
}

export interface DiscordSenderMachineHandle<S, E, C, O> {
  readonly state: () => S
  readonly lastOutput: () => readonly O[]
  readonly dispatch: (event: E, by: C) => Promise<"accepted" | "refused">
  readonly receive: (raw: unknown, by: C) => Promise<"accepted" | "refused">
}

export function wrapDiscordSenderMachineHandle<S, E, C, O>(created: {
  readonly get: () => S!never!never
  readonly send: (event: E, by: C) => ({ readonly state: S; readonly out: readonly O[] })!({ readonly _tag: "Rejected" })!never
  readonly receive: (raw: unknown, by: C) => ({ readonly state: S; readonly out: readonly O[] })!({ readonly _tag: "NotAnEvent" | "Rejected" })!never
}): DiscordSenderMachineHandle<S, E, C, O> {
  let latestOut: readonly O[] = []
  return {
    state: () => runSync(created.get()),
    lastOutput: () => latestOut,
    dispatch: (event, by) => runPromise(created.send(event, by).pipe(
      Effect.map((step) => {
        latestOut = step.out
        return "accepted" as const
      }),
      Effect.catchTag("Rejected", () => {
        latestOut = []
        return Effect.succeed("refused" as const)
      }),
    )),
    receive: (raw, by) => runPromise(created.receive(raw, by).pipe(
      Effect.map((step) => {
        latestOut = step.out
        return "accepted" as const
      }),
      Effect.catchTag("NotAnEvent", () => {
        latestOut = []
        return Effect.succeed("refused" as const)
      }),
      Effect.catchTag("Rejected", () => {
        latestOut = []
        return Effect.succeed("refused" as const)
      }),
    )),
  }
}
