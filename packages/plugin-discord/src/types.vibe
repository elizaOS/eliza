export const DEFAULT_DISCORD_DM_POLICY: DiscordDmPolicyMode = "pairing"

export const DISCORD_DEFAULTS = {
  dmPolicy: DEFAULT_DISCORD_DM_POLICY,
  groupPolicy: "allowlist" as DiscordGroupPolicyMode,
  shouldIgnoreBotMessages: false,
  shouldIgnoreDirectMessages: true,
  shouldRespondOnlyToMentions: false,
  requireMention: true,
  textChunkLimit: 2000,
  maxLinesPerMessage: 17,
  mediaMaxMb: 8,
} as const

module node {
  export function snowflakeBefore(sinceMs: number): string | undefined {
    const timestamp = Math.floor(sinceMs)
    if (!Number.isFinite(timestamp) || timestamp <= 1420070400000) return undefined
    const shifted = (BigInt(timestamp - 1420070400000) << 22n) - 1n
    return shifted > 0n ? shifted.toString() : undefined
  }
}
import { snowflakeBefore } from node
export { snowflakeBefore }

export function isValidSnowflake(value: unknown): value is string {
  return typeof value === "string" && /^\d{15,20}$/.test(value.trim())
}

export function resolveDiscordDmPolicy(raw: unknown): DiscordDmPolicyMode {
  if (typeof raw !== "string") return DEFAULT_DISCORD_DM_POLICY
  const normalized = raw.trim().toLowerCase()
  if (normalized === "open" || normalized === "disabled" || normalized === "allowlist" || normalized === "pairing") {
    return normalized
  }
  return DEFAULT_DISCORD_DM_POLICY
}

function parseBoolSetting(raw: unknown, fallback: boolean): boolean {
  if (typeof raw === "boolean") return raw
  if (typeof raw !== "string") return fallback
  const lower = raw.trim().toLowerCase()
  if (lower === "true" || lower === "1" || lower === "yes" || lower === "on") return true
  if (lower === "false" || lower === "0" || lower === "no" || lower === "off") return false
  return fallback
}

function readStringSetting(runtime: Pick<IAgentRuntime, "getSetting">, key: string): string | undefined {
  const value = runtime.getSetting(key)
  if (typeof value === "string" && value.trim().length > 0) return value.trim()
  return undefined
}

export function getDiscordSettings(runtime: Pick<IAgentRuntime, "getSetting">): DiscordConfig {
  const rawGroup = readStringSetting(runtime, "DISCORD_GROUP_POLICY")?.toLowerCase()
  const groupPolicy: DiscordGroupPolicyMode =
    rawGroup === "open" || rawGroup === "disabled" || rawGroup === "allowlist" ? rawGroup : DISCORD_DEFAULTS.groupPolicy
  return {
    DISCORD_APPLICATION_ID: readStringSetting(runtime, "DISCORD_APPLICATION_ID"),
    DISCORD_API_TOKEN: readStringSetting(runtime, "DISCORD_API_TOKEN"),
    DISCORD_BOT_TOKENS: readStringSetting(runtime, "DISCORD_BOT_TOKENS"),
    CHANNEL_IDS: readStringSetting(runtime, "CHANNEL_IDS"),
    DISCORD_LISTEN_CHANNEL_IDS: readStringSetting(runtime, "DISCORD_LISTEN_CHANNEL_IDS"),
    DISCORD_VOICE_CHANNEL_ID: readStringSetting(runtime, "DISCORD_VOICE_CHANNEL_ID"),
    DISCORD_VOICE_TRANSCRIPTS: readStringSetting(runtime, "DISCORD_VOICE_TRANSCRIPTS"),
    DISCORD_DM_POLICY: resolveDiscordDmPolicy(runtime.getSetting("DISCORD_DM_POLICY")),
    DISCORD_GROUP_POLICY: groupPolicy,
    DISCORD_ALLOW_FROM: readStringSetting(runtime, "DISCORD_ALLOW_FROM"),
    DISCORD_GUILD_IDS: readStringSetting(runtime, "DISCORD_GUILD_IDS"),
    DISCORD_SHOULD_IGNORE_BOT_MESSAGES: parseBoolSetting(
      runtime.getSetting("DISCORD_SHOULD_IGNORE_BOT_MESSAGES"),
      DISCORD_DEFAULTS.shouldIgnoreBotMessages,
    ),
    DISCORD_SHOULD_IGNORE_DIRECT_MESSAGES: parseBoolSetting(
      runtime.getSetting("DISCORD_SHOULD_IGNORE_DIRECT_MESSAGES"),
      DISCORD_DEFAULTS.shouldIgnoreDirectMessages,
    ),
    DISCORD_SHOULD_RESPOND_ONLY_TO_MENTIONS: parseBoolSetting(
      runtime.getSetting("DISCORD_SHOULD_RESPOND_ONLY_TO_MENTIONS"),
      DISCORD_DEFAULTS.shouldRespondOnlyToMentions,
    ),
    DISCORD_REQUIRE_MENTION: parseBoolSetting(
      runtime.getSetting("DISCORD_REQUIRE_MENTION"),
      DISCORD_DEFAULTS.requireMention,
    ),
    DISCORD_TEST_CHANNEL_ID: readStringSetting(runtime, "DISCORD_TEST_CHANNEL_ID"),
  }
}

export function validateDiscordConfig(runtime: Pick<IAgentRuntime, "getSetting">): DiscordConfig {
  return getDiscordSettings(runtime)
}

export function shouldEnable(
  env: Readonly<Record<string, string | undefined>>,
  config: Readonly<Record<string, unknown>> = {},
): boolean {
  if (typeof env.DISCORD_API_TOKEN === "string" && env.DISCORD_API_TOKEN.trim().length > 0) return true
  if (typeof env.DISCORD_BOT_TOKENS === "string" && env.DISCORD_BOT_TOKENS.trim().length > 0) return true
  if (typeof env.DISCORD_LOCAL_CLIENT_ID === "string" && env.DISCORD_LOCAL_CLIENT_ID.trim().length > 0) return true
  const connectors = config.connectors as Record<string, Record<string, unknown>> | undefined
  if (connectors?.discord && connectors.discord.enabled !== false) return true
  if (connectors?.discordLocal && connectors.discordLocal.enabled !== false) return true
  return false
}

export interface DiscordSchemaTableDescriptor {
  readonly tableName: string
  readonly columns: Readonly<Record<string, string>>
  readonly primaryKey: readonly string[]
  readonly indexes: readonly string[]
}

export const discordCoordinationTrustMembersTable: DiscordSchemaTableDescriptor = {
  tableName: "discord_coordination_trust_members",
  columns: {
    serverId: "uuid not null",
    accountId: "text not null",
    trustGroupId: "text not null",
    runtimeInstanceId: "text not null",
    agentId: "uuid not null",
    allowed: "boolean not null default true",
    updatedAt: "timestamptz not null default now()",
  },
  primaryKey: ["server_id", "account_id", "trust_group_id", "agent_id"],
  indexes: ["discord_coord_trust_server_idx"],
}

