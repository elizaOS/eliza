}

export const discordCoordinationReceiptsTable: DiscordSchemaTableDescriptor = {
  tableName: "discord_coordination_receipts",
  columns: {
    id: "uuid primary key",
    serverId: "uuid not null",
    accountId: "text not null",
    trustGroupId: "text not null",
    channelId: "text not null",
    edgeMessageId: "text not null",
    edgeEpoch: "text",
