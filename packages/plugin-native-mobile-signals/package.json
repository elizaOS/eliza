{
  "name": "@elizaos/capacitor-mobile-signals",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Bridges mobile wake, lock, battery, and protected-data state into LifeOps.",
  "license": "MIT",
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "typecheck": "vibelang --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/core": "8.4.0",
    "@elizaos/os-bridges": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios",
      "podName": "ElizaosCapacitorMobileSignals"
    }
  },
  "files": [
    "dist",
    "android/src/main",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "ios/Sources",
    "*.podspec"
  ]
}
