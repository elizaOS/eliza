#!/bin/bash
# Stage a self-contained recovery boot before mkosi snapshots the root trees.
set -euo pipefail

mapfile -t kernels < <(find /boot -maxdepth 1 -type f \( -name 'vmlinuz-*' -o -name 'vmlinux-*' \) -print | LC_ALL=C sort)
if [ "${#kernels[@]}" -ne 1 ]; then
    echo "[mkosi.finalize] expected exactly one kernel, found ${#kernels[@]}" >&2
    exit 1
fi

kernel="${kernels[0]}"
kernel_version="${kernel#/boot/vmlinuz-}"
kernel_version="${kernel_version#/boot/vmlinux-}"
module_dir="/usr/lib/modules/${kernel_version}"
if [ ! -e "$module_dir" ] || [ -L "$module_dir" ]; then
    echo "[mkosi.finalize] required boot input is missing or linked: $module_dir" >&2
    exit 1
fi
for command in cpio find mkinitramfs python3 sort zstd; do
    command -v "$command" >/dev/null || {
        echo "[mkosi.finalize] required boot tool is missing: $command" >&2
        exit 1
    }
done

workdir="$(mktemp -d)"
trap 'rm -rf -- "$workdir"' EXIT

mkinitramfs -o "${workdir}/initrd" "$kernel_version"

# mkosi appends this archive to the distribution initramfs for the normal boot
# path. Embed the same two archives in the fallback EFI executable so GRUB does
# not depend on firmware-specific RISC-V block-device drivers. Level 3 keeps
# this target-architecture step practical under qemu-user while remaining
# deterministic and substantially smaller than an uncompressed archive.
archive_paths=("usr/lib/modules/${kernel_version}")
[ ! -d /usr/lib/firmware ] || archive_paths+=(usr/lib/firmware)
(
    cd /
    find "${archive_paths[@]}" -xdev -print0 \
        | LC_ALL=C sort -z \
        | cpio --null --create --format=newc --reproducible 2>/dev/null
) | zstd --quiet --threads=1 -3 -o "${workdir}/kernel-modules.initrd"

recovery=/efi/elizaos-recovery
install -d -m 0755 "$recovery"
install -m 0644 "$kernel" "$recovery/vmlinuz"
cat "${workdir}/initrd" "${workdir}/kernel-modules.initrd" >"$recovery/initrd"
chmod 0644 "$recovery/initrd"

# KernelCommandLine is supplied by mkosi configuration, not necessarily by the
# distribution's /etc/kernel/cmdline. Keep recovery's console settings aligned.
ELIZAOS_KERNEL_CMDLINE="$(python3 - "${MKOSI_CONFIG:?mkosi configuration is required}" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    arguments = json.load(stream)["KernelCommandLine"]
if not isinstance(arguments, list) or any(
    not isinstance(argument, str) or any(c in argument for c in "\n\r\0")
    for argument in arguments
):
    raise SystemExit("invalid mkosi KernelCommandLine")
print(" ".join(arguments))
PY
)"
export ELIZAOS_KERNEL_CMDLINE

# Keep recovery boot inputs on the ESP: mkosi's GRUB does not embed an ext4
# reader, and loading unsigned filesystem modules would break Secure Boot.
# mkosi writes its own ESP menu; it never runs update-grub or /etc/grub.d.
# Its normal entry is appended after this recovery entry, hence default=1.
install -d -m 0700 /efi/grub
{
    printf 'set default=1\nset timeout=5\n'
    /etc/grub.d/42_elizaos_recovery
} >/efi/grub/grub.cfg
chmod 0600 /efi/grub/grub.cfg
