# elizaOS Linux canonical Debian image recipes.

default:
    @just --list

setup:
    @command -v docker >/dev/null 2>&1 || { echo "Install Docker first." >&2; exit 1; }
    @docker info >/dev/null 2>&1 || { echo "Docker is not running or unavailable." >&2; exit 1; }
    @echo "Docker OK"


build:
    make -C elizaos build ARCH="${ELIZAOS_ARCH:-amd64}" PROFILE="${ELIZAOS_PROFILE:-gui}"

config:
    make -C elizaos lint

static-smoke:
    make -C elizaos lint

lint:
    make -C elizaos lint


test:
    make -C elizaos lint

clean:
    node ../../scripts/rm-path-recursive.ts elizaos/out
