# elizaOS desktop profile. This overlay is included only when
# ELIZAOS_PROFILE=gui.

# Electrobun is GTK/WebKit-based.
# trixie renamed the GTK3 runtime to libgtk-3-0t64 in the 64-bit time_t (t64)
# ABI transition; the unsuffixed libgtk-3-0 has no installation candidate and
# fails the apt chroot stage on every arch.
libwebkit2gtk-4.1-0
libgtk-3-0t64
libdbusmenu-gtk3-4
libgl1-mesa-dri
libegl1

# GNOME desktop with an elizaOS taskbar. Xorg is required by the current
# Electrobun Linux GTK wrapper; Epiphany remains the non-Electrobun fallback on
# architectures without a packaged native app.
xorg
gdm3
gnome-session
gnome-shell
gnome-terminal
gnome-control-center
nautilus
gnome-shell-extension-dashtodock
gnome-shell-extension-appindicator
network-manager
network-manager-gnome
pipewire
pipewire-pulse
wireplumber
pulseaudio-utils
epiphany-browser
xserver-xorg-video-modesetting

# GUI validation helper (GNOME/Xorg screenshot capture).
scrot

# Boot splash.
plymouth
plymouth-themes
plymouth-label
