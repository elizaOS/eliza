#!/bin/sh
set -eu

self=/usr/local/lib/elizaos/capability-runner

usage() {
    echo "usage: capability-runner <root-status|service|package|network|power> [args...]" >&2
    exit 64
}

need_admin_mode() {
    [ "$(/usr/bin/cat /etc/elizaos/admin-mode 2>/dev/null || printf disabled)" = enabled ] || {
        echo "elizaOS owner admin mode is disabled." >&2
        exit 77
    }
}

need_root() {
    if [ "$(/usr/bin/id -u)" -ne 0 ]; then
        exec /usr/bin/sudo -n "${self}" "$@"
    fi
}

audit() {
    /usr/bin/logger -p authpriv.notice -t elizaos-capability \
        "caller_uid=${SUDO_UID:-$(/usr/bin/id -u)} caller_user=${SUDO_USER:-$(/usr/bin/id -un)} action=$*" || {
        echo "elizaOS capability audit failed; refusing privileged operation." >&2
        exit 74
    }
}

valid_unit() {
    case "$1" in ""|-*|*[!A-Za-z0-9@_.:-]*) return 1 ;; *) return 0 ;; esac
}

valid_package() {
    case "$1" in ""|-*|*[!A-Za-z0-9.+:-]*) return 1 ;; *) return 0 ;; esac
}

[ "$#" -ge 1 ] || usage
command_name="$1"
shift

case "${command_name}" in
    root-status)
        [ "$#" -eq 0 ] || usage
        need_root "${command_name}"
        audit "root-status"
        printf 'root=yes\nbase=debian\nuid=%s\n' "$(/usr/bin/id -u)"
        ;;
    service)
        [ "$#" -eq 2 ] || usage
        action="$1"; unit="$2"
        case "${action}" in start|stop|restart|enable|disable) ;; *) usage ;; esac
        valid_unit "${unit}" || usage
        need_admin_mode
        need_root "${command_name}" "${action}" "${unit}"
        audit "service ${action} ${unit}"
        exec /usr/bin/systemctl "${action}" -- "${unit}"
        ;;
    package)
        [ "$#" -ge 1 ] || usage
        action="$1"; shift
        case "${action}" in
            update) [ "$#" -eq 0 ] || usage ;;
            install|remove)
                [ "$#" -ge 1 ] || usage
                for package_name in "$@"; do valid_package "${package_name}" || usage; done
                ;;
            *) usage ;;
        esac
        need_admin_mode
        need_root "${command_name}" "${action}" "$@"
        audit "package ${action} $*"
        export DEBIAN_FRONTEND=noninteractive
        case "${action}" in
            update) exec /usr/bin/apt-get update ;;
            install) exec /usr/bin/apt-get -y --no-install-recommends install "$@" ;;
            remove) exec /usr/bin/apt-get -y remove "$@" ;;
        esac
        ;;
    network)
        [ "$#" -eq 2 ] || usage
        action="$1"; connection="$2"
        case "${action}" in up|down) ;; *) usage ;; esac
        case "${connection}" in ""|*'
'*|*''*) usage ;; esac
        need_admin_mode
        need_root "${command_name}" "${action}" "${connection}"
        audit "network ${action} ${connection}"
        exec /usr/bin/nmcli connection "${action}" id "${connection}"
        ;;
    power)
        [ "$#" -eq 1 ] || usage
        action="$1"
        case "${action}" in reboot|poweroff) ;; *) usage ;; esac
        need_admin_mode
        need_root "${command_name}" "${action}"
        audit "power ${action}"
        exec /usr/bin/systemctl "${action}"
        ;;
    *) usage ;;
esac
