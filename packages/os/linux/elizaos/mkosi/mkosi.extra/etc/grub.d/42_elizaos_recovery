#!/bin/sh
# Called explicitly by mkosi.finalize.chroot; mkosi does not run update-grub.
set -efu

prefix='($recovery)/usr/lib/elizaos/recovery'
search='    search --no-floppy --label --set=recovery elizaos-recovery'
case "${1:-}" in
    '') ;;
    --embedded) prefix='(memdisk)'; search='' ;;
    *) echo "unsupported recovery menu mode: $1" >&2; exit 2 ;;
esac
for file in /usr/lib/elizaos/recovery/vmlinuz /usr/lib/elizaos/recovery/initrd; do
    [ -s "$file" ] || { echo "missing recovery boot input: $file" >&2; exit 1; }
done

# Preserve serial-console and diagnostic settings without inheriting the normal
# root partition or boot target. Kernel arguments here are trusted build inputs.
cmdline=''
for argument in $(cat /etc/kernel/cmdline); do
    case "$argument" in root=*|ro|rw|systemd.unit=*|elizaos.recovery=*) continue ;; esac
    cmdline="$cmdline $argument"
done
cat <<EOF
menuentry 'elizaOS Recovery' --id elizaos-recovery --hotkey=r {
$search
    linux $prefix/vmlinuz root=LABEL=elizaos-recovery ro systemd.unit=rescue.target elizaos.recovery=1$cmdline
    initrd $prefix/initrd
}
EOF
