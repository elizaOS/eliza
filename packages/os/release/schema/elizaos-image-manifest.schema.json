{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elizaos.ai/schemas/elizaos-image-manifest.v1.json",
  "title": "elizaOS disk image release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "elizaOS" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "product",
        "version",
        "channel",
        "sequence",
        "expires",
        "architecture",
        "url",
        "compressedSize",
        "expandedSize",
        "sha256Compressed",
        "sha256Expanded",
        "signatureUrl",
        "minDeviceBytes"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "product": { "const": "elizaOS" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "channel": { "enum": ["stable", "beta", "nightly"] },
        "sequence": { "type": "integer", "minimum": 1 },
        "expires": { "type": "string", "format": "date-time" },
        "architecture": { "enum": ["x86_64", "arm64", "riscv64"] },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.+\\.raw\\.zst$"
        },
        "compressedSize": { "type": "integer", "minimum": 1 },
        "expandedSize": { "type": "integer", "minimum": 1 },
        "sha256Compressed": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha256Expanded": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signatureUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.+\\.sig$"
        },
        "minDeviceBytes": { "type": "integer", "minimum": 32000000000 },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
