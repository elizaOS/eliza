// spec/os/build/runtimePayload.md, "Story: Ship the agent with a pinned Node runtime"; spec/os/build/runtimePayload.md, "Story: Ship only the files my build listed"
import { HttpClient } from "effect/http"
import { ChildProcess } from "effect/process"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import {
  allAbis,
  contentAllowed,
  launchWorker,
  listedOnce,
  modelSuffixes,
  nativeMode,
  nodeLibraryName,
  payloadVerdict,
  runtimeAdmitted,
  runtimeCount,
  workerStaging,
  type Abi,
  type FileKind,
  type InventoryRow,
  type NodeLock,
  type PayloadRefusal,
  type Profile,
  type RuntimeCandidate,
  type StagedFile,
  type StagedPayload,
  type WorkerArtifact,
  type WorkerPin,
  type WorkflowWorker,
} from "../../gen/os__build__runtimePayload.effect.vibe"
import { BundleFacts, NodeLockFile, NodeRuntimeBuild, type AndroidAbi } from "./runtime-payload.schema.vibe"

module node {
  import { createHash } from "node:crypto"
  import { existsSync } from "node:fs"
  import { lstat, readdir } from "node:fs/promises"
  import { availableParallelism } from "node:os"
  import { dirname, join } from "node:path"
  import { fileURLToPath } from "node:url"
  import { inflateRawSync } from "node:zlib"

  export type Listing =
    | { readonly kind: "files"; readonly files: readonly string[] }
    | { readonly kind: "irregular"; readonly path: string }

  const MACHINE = { "arm64-v8a": 183, x86_64: 62 } as const
  type ElfAbi = keyof typeof MACHINE
  const LINKER = "/system/bin/linker64\0"

  /** @throws {never} */
  export function sha256Hex(bytes: Uint8Array): string {
    return createHash("sha256").update(bytes).digest("hex")
  }

  /** @throws {never} */
  export function cpuCount(): number {
    return availableParallelism()
  }

  export function defaultNodeLockPath(moduleUrl: string): string {
    let dir = dirname(fileURLToPath(moduleUrl))
    for (let depth = 0; depth < 6; depth += 1) {
      const candidate = join(dir, "aosp", "runtime", "node.lock.json")
      if (existsSync(candidate)) return candidate
      const parent = dirname(dir)
      if (parent === dir) break
      dir = parent
    }
    throw new Error("The packaged Node lock cannot be found")
  }

  export async function listRegularFiles(root: string): Promise<Listing> {
    const files: string[] = []
    for (const entry of await readdir(root, { recursive: true })) {
      const info = await lstat(join(root, entry))
      if (info.isDirectory()) continue
      if (!info.isFile()) return { kind: "irregular", path: entry }
      files.push(entry.split("\\").join("/"))
    }
    return { kind: "files", files: files.sort() }
  }

  function header(bytes: Uint8Array, abi: ElfAbi): DataView | undefined {
    const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength)
    const elf = bytes.length >= 64 && view.getUint32(0) === 0x7f454c46 && bytes[4] === 2 && bytes[5] === 1
    return elf && view.getUint16(18, true) === MACHINE[abi] ? view : undefined
  }

  /** @throws {never} */
  export function zipEntry(archive: Uint8Array, name: string): Uint8Array | undefined {
    const view = new DataView(archive.buffer, archive.byteOffset, archive.byteLength)
    let end = archive.length - 22
    while (end >= 0 && view.getUint32(end, true) !== 0x06054b50) end--
    if (end < 0) return undefined
    let entry = view.getUint32(end + 16, true)
    for (let index = 0; index < view.getUint16(end + 10, true); index++) {
      if (entry + 46 > archive.length || view.getUint32(entry, true) !== 0x02014b50) return undefined
      const nameLength = view.getUint16(entry + 28, true)
      const next = entry + 46 + nameLength + view.getUint16(entry + 30, true) + view.getUint16(entry + 32, true)
      if (new TextDecoder().decode(archive.subarray(entry + 46, entry + 46 + nameLength)) === name) {
        const method = view.getUint16(entry + 10, true)
        const size = view.getUint32(entry + 20, true)
        const local = view.getUint32(entry + 42, true)
        if (local + 30 > archive.length || view.getUint32(local, true) !== 0x04034b50) return undefined
        const start = local + 30 + view.getUint16(local + 26, true) + view.getUint16(local + 28, true)
        if (start + size > archive.length) return undefined
        const data = archive.subarray(start, start + size)
        try {
          const bytes = method === 0 ? data : method === 8 ? new Uint8Array(inflateRawSync(data)) : undefined
          return bytes !== undefined && bytes.length === view.getUint32(entry + 24, true) ? bytes : undefined
        } catch {
          return undefined
        }
      }
      entry = next
    }
    return undefined
  }

  /** @throws {never} */
  export function isElfFor(bytes: Uint8Array, abi: ElfAbi): boolean {
    return header(bytes, abi) !== undefined
  }

  /** @throws {never} */
  export function isAndroidExecutable(bytes: Uint8Array, abi: ElfAbi): boolean {
    const view = header(bytes, abi)
    if (view === undefined || view.getUint16(16, true) !== 3) return false
    const offset = view.getBigUint64(32, true)
    const length = view.getUint16(54, true)
    const count = view.getUint16(56, true)
    if (length !== 56 || offset + BigInt(length * count) > BigInt(bytes.length)) return false
    for (let index = 0; index < count; index++) {
      const entry = Number(offset) + index * length
      if (view.getUint32(entry, true) !== 3) continue
      const start = view.getBigUint64(entry + 8, true)
      const size = view.getBigUint64(entry + 32, true)
      if (start + size > BigInt(bytes.length)) return false
      return new TextDecoder().decode(bytes.subarray(Number(start), Number(start + size))) === LINKER
    }
    return false
  }
}
import { cpuCount, defaultNodeLockPath, isAndroidExecutable, isElfFor, listRegularFiles, sha256Hex, zipEntry, type Listing } from node

export type { AndroidAbi }

export type RuntimeInput =
  | { readonly kind: "built"; readonly dir: string }
  | { readonly kind: "fetched"; readonly abi: AndroidAbi; readonly url: string }

export interface PinnedFile {
  readonly path: string
  readonly sha256: string
}

export interface ExtraAssetTree {
  readonly dir: string
  readonly name: string
  readonly files: readonly PinnedFile[]
}

export interface ConsumerLibrary {
  readonly abi: AndroidAbi
  readonly file: string
  readonly sha256: string
}

export interface WorkflowWorkerArtifact {
  readonly dir: string
  readonly executable: string
}

export interface StageRuntimePayload {
  readonly abi: readonly AndroidAbi[]
  readonly bundleDir: string
  readonly extraAssets?: readonly ExtraAssetTree[]
  readonly nativeLibraries?: readonly ConsumerLibrary[]
  readonly workflowWorker?: WorkflowWorkerArtifact
  readonly output: string
  readonly lock?: string
  readonly runtimes?: readonly RuntimeInput[]
}

interface StagedRuntimePayload {
  readonly output: string
  readonly inventory: readonly InventoryRow[]
  readonly workflowWorker: WorkflowWorker | undefined
}

export interface BuildNodeRuntime {
  readonly source: string
  readonly ndk: string
  readonly abi: AndroidAbi
  readonly output: string
  readonly jobs?: number
  readonly lock?: string
}

interface BuiltNodeRuntime {
  readonly dir: string
  readonly abi: AndroidAbi
  readonly version: string
  readonly sha256: string
  readonly size: number
}

error PayloadInputInvalid { reason: string }
export error PayloadRefused { reason: PayloadRefusal; subject: string }
error RuntimeFetchFailed { url: string; message: string }
error RuntimeNotAndroidExecutable { abi: AndroidAbi; path: string }
error PayloadOutputExists { output: string }
error NodeBuildRefused { reason: string }
error NodeBuildFailed { command: string; code: number; output: string }

export const INVENTORY_ASSET = "assets/agent/inventory.json"
const WORKER_RUNTIME_DIR = "agent/workflow-worker"

const ANDROID_MAIN = "android/app/src/main"
export const INFERENCE_LIBRARY = /^(?:lib(?:llama|llama-common|ggml|mtmd|eliza-llama|elizainference)[^/]*\.so(?:\.\d[^/]*)?|llama-server|llama-omnivoice-server)$/
const LIBRARY_NAME = /^lib[A-Za-z0-9_.+-]+\.so$/
const ASSET_NAME = /^[A-Za-z0-9][A-Za-z0-9_.-]*$/
const CONFIGURE_ARCH: Readonly<Record<AndroidAbi, string>> = { "arm64-v8a": "arm64", x86_64: "x86_64" }

interface Staged {
  readonly file: StagedFile
  readonly bytes: Uint8Array
  readonly listed: string | undefined
}

interface Runtime {
  readonly candidate: RuntimeCandidate
  readonly abi: AndroidAbi
  readonly bytes: Uint8Array
}

const specAbi = (abi: AndroidAbi): Abi => abi === "arm64-v8a" ? "Arm64" : "X86_64"
const androidAbi = (abi: Abi): AndroidAbi => abi === "Arm64" ? "arm64-v8a" : "x86_64"
const baseName = (path: string) => path.slice(path.lastIndexOf("/") + 1)
const safeRelative = (path: string) => path !== "" && !path.startsWith("/") && !path.includes("\\") && !path.includes("\0") && !path.split("/").some((part) => part === "" || part === "." || part === "..")

function kindOf(path: string, origin: FileKind): FileKind {
  const name = baseName(path).toLowerCase()
  if (name.endsWith(".node")) return "NodeAddon"
  if (modelSuffixes.some((suffix) => name.endsWith(suffix))) return "ModelFile"
  if (INFERENCE_LIBRARY.test(name)) return "InferenceLibrary"
  return origin
}

function staged(path: string, origin: FileKind, bytes: Uint8Array, listed: string | undefined): Staged {
  return { file: { path, kind: kindOf(path, origin), sha256: sha256Hex(bytes), size: bytes.byteLength }, bytes, listed }
}

function subjectOf(reason: PayloadRefusal, payload: StagedPayload): string {
  switch (reason) {
    case "RuntimeLayoutInvalid":
      return allAbis.filter((abi) => runtimeCount(payload.runtimes, abi) !== (payload.targets.includes(abi) ? 1 : 0)).map(androidAbi).join(", ")
    case "RuntimeNotPinned":
      return payload.runtimes.filter((candidate) => !runtimeAdmitted(payload.lock, candidate)).map((candidate) => androidAbi(candidate.abi)).join(", ")
    case "ForbiddenContent":
      return payload.files.filter((file) => !contentAllowed(payload.profile, file)).map((file) => file.path).join(", ")
    case "WorkerNotPinned":
      return "workflow worker"
    case "InventoryInexact":
      return [
        ...payload.files.filter((file) => !listedOnce(payload.inventory, file)).map((file) => file.path),
        ...payload.inventory.filter((row) => !payload.files.some((file) => file.path === row.path)).map((row) => row.path),
      ].join(", ")
  }
}

effect function decodeJson<S extends Schema.Constraint>(schema: S, file: string) {
  const files = try FileSystem.FileSystem
  const text = try files.readFileString(file)
  return try mapError(Schema.decodeUnknownEffect(Schema.fromJsonString(schema))(text), (cause) => new PayloadInputInvalid({ reason: `${file}: ${cause.message}` }))
}

effect function regularFiles(root: string) {
  const listing: Listing = try tryPromise({ try: () => listRegularFiles(root), catch: (cause) => new PayloadInputInvalid({ reason: `${root} cannot be listed: ${String(cause)}` }) })
  if (listing.kind === "irregular") throw new PayloadInputInvalid({ reason: `${root}/${listing.path} is not a regular file` })
  return listing.files
}

effect function readLock(file: string | undefined) {
  const path = file ?? (try Effect.try({ try: () => defaultNodeLockPath(import.meta.url), catch: (cause) => new PayloadInputInvalid({ reason: `The packaged Node lock cannot be found: ${String(cause)}` }) }))
  return try decodeJson(NodeLockFile, path)
}

effect function download(url: string) {
  const failed = (cause: { readonly message: string }) => new RuntimeFetchFailed({ url, message: cause.message })
  const response = try mapError(HttpClient.get(url), failed)
  if (response.status !== 200) throw new RuntimeFetchFailed({ url, message: `HTTP ${response.status}` })
  return new Uint8Array(try mapError(response.arrayBuffer, failed))
}

effect function builtRuntime(dir: string) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const record = try decodeJson(NodeRuntimeBuild, path.join(dir, "node-runtime.json"))
  const bytes = try files.readFile(path.join(dir, nodeLibraryName))
  const runtime: Runtime = {
    abi: record.abi,
    bytes,
    candidate: { abi: specAbi(record.abi), version: record.version, ndk: record.ndk, apiLevel: record.apiLevel, sha256: sha256Hex(bytes), source: { tag: "LocalBuild" } },
  }
  return runtime
}

effect function fetchedRuntime(lock: NodeLock, abi: AndroidAbi, url: string) {
  const bytes = zipEntry(try download(url), nodeLibraryName)
  if (bytes === undefined) throw new RuntimeFetchFailed({ url, message: `The release archive carries no readable ${nodeLibraryName}` })
  const runtime: Runtime = {
    abi,
    bytes,
    candidate: { abi: specAbi(abi), version: lock.version, ndk: lock.ndk, apiLevel: lock.apiLevel, sha256: sha256Hex(bytes), source: { tag: "Fetched", url } },
  }
  return runtime
}

effect function runtimesFor(options: StageRuntimePayload, lock: typeof NodeLockFile.Type) {
  const nodeLock: NodeLock = { version: lock.version, ndk: lock.ndk, apiLevel: lock.apiLevel, entries: lock.entries.map((entry) => ({ abi: specAbi(entry.abi), sha256: entry.sha256, url: entry.url })) }
  const runtimes: Runtime[] = []
  for (const input of options.runtimes ?? []) {
    runtimes.push(input.kind === "built" ? try builtRuntime(input.dir) : try fetchedRuntime(nodeLock, input.abi, input.url))
  }
  for (const abi of options.abi.filter((target) => !runtimes.some((runtime) => runtime.abi === target))) {
    const entry = lock.entries.find((candidate) => candidate.abi === abi)
    if (entry === undefined) throw new PayloadRefused({ reason: "RuntimeNotPinned", subject: `${abi} has no entry in the Node lock` })
    runtimes.push(try fetchedRuntime(nodeLock, abi, entry.url))
  }
  return { nodeLock, runtimes }
}

effect function bundleFiles(bundleDir: string) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const names = try regularFiles(bundleDir)
  for (const required of ["agent.mjs", "manifest.json"]) {
    if (!names.includes(required)) throw new PayloadInputInvalid({ reason: `The agent bundle has no ${required}` })
  }
  const reserved = names.find((name) => name === "inventory.json" || name.startsWith("workflow-worker/"))
  if (reserved !== undefined) throw new PayloadInputInvalid({ reason: `The agent bundle carries ${reserved}, a path the payload reserves` })
  const facts = try decodeJson(BundleFacts, path.join(bundleDir, "manifest.json"))
  const out: Staged[] = []
  for (const name of names) {
    const bytes = try files.readFile(path.join(bundleDir, name))
    out.push(staged(`assets/agent/${name}`, "BundleFile", bytes, name === "agent.mjs" ? facts.bundleSha256 : sha256Hex(bytes)))
  }
  return { facts, files: out }
}

effect function consumerAssets(trees: readonly ExtraAssetTree[]) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const out: Staged[] = []
  const phantom: InventoryRow[] = []
  const seen = new Set<string>()
  for (const tree of trees) {
    if (!ASSET_NAME.test(tree.name) || tree.name === "agent" || seen.has(tree.name)) throw new PayloadInputInvalid({ reason: `Extra asset tree name ${JSON.stringify(tree.name)} is not one free asset directory name` })
    seen.add(tree.name)
    const unsafe = tree.files.find((pin) => !safeRelative(pin.path))
    if (unsafe !== undefined) throw new PayloadInputInvalid({ reason: `Extra asset ${tree.name} pins an unsafe path ${JSON.stringify(unsafe.path)}` })
    const names = try regularFiles(tree.dir)
    for (const name of names) {
      const bytes = try files.readFile(path.join(tree.dir, name))
      out.push(staged(`assets/${tree.name}/${name}`, "ConsumerAsset", bytes, tree.files.find((pin) => pin.path === name)?.sha256))
    }
    for (const pin of tree.files) {
      if (!names.includes(pin.path)) phantom.push({ path: `assets/${tree.name}/${pin.path}`, sha256: pin.sha256, size: 0 })
    }
  }
  return { files: out, phantom }
}

effect function consumerLibraries(libraries: readonly ConsumerLibrary[], targets: readonly AndroidAbi[]) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const out: Staged[] = []
  const runtimes: Runtime[] = []
  for (const library of libraries) {
    const name = path.basename(library.file)
    if (!targets.includes(library.abi)) throw new PayloadInputInvalid({ reason: `${name} is for ${library.abi}, which this payload does not target` })
    if (!LIBRARY_NAME.test(name)) throw new PayloadInputInvalid({ reason: `${name} is not a native library name` })
    const bytes = try files.readFile(library.file)
    if (!isElfFor(bytes, library.abi)) throw new PayloadInputInvalid({ reason: `${name} is not an ELF library for ${library.abi}` })
    const origin: FileKind = name === nodeLibraryName ? "NodeRuntime" : "ConsumerLibrary"
    out.push(staged(`lib/${library.abi}/${name}`, origin, bytes, library.sha256))
    if (origin === "NodeRuntime") {
      runtimes.push({ abi: library.abi, bytes, candidate: { abi: specAbi(library.abi), version: "", ndk: "", apiLevel: 0, sha256: sha256Hex(bytes), source: { tag: "LocalBuild" } } })
    }
  }
  return { files: out, runtimes }
}

effect function workerFiles(worker: WorkflowWorkerArtifact | undefined) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const none: { files: Staged[]; artifact: WorkerArtifact } = { files: [], artifact: { tag: "NoWorkerArtifact" } }
  if (worker === undefined) return none
  if (!safeRelative(worker.executable)) throw new PayloadInputInvalid({ reason: `The workflow worker executable ${JSON.stringify(worker.executable)} is not a path inside its directory` })
  const names = try regularFiles(worker.dir)
  if (!names.includes(worker.executable)) throw new PayloadInputInvalid({ reason: `The workflow worker has no executable ${worker.executable}` })
  const out: Staged[] = []
  let built = ""
  for (const name of names) {
    const bytes = try files.readFile(path.join(worker.dir, name))
    const file = staged(`assets/${WORKER_RUNTIME_DIR}/${name}`, "WorkerFile", bytes, sha256Hex(bytes))
    if (name === worker.executable) built = file.file.sha256
    out.push(file)
  }
  const artifact: WorkerArtifact = { tag: "WorkerBuilt", builtSha256: built }
  return { files: out, artifact }
}

effect function publish(output: string, payload: readonly Staged[], inventory: readonly InventoryRow[]) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const destination = path.resolve(output)
  if (try files.exists(destination)) throw new PayloadOutputExists({ output: destination })
  try files.makeDirectory(path.dirname(destination), { recursive: true })
  const scratch = try files.makeTempDirectory({ directory: path.dirname(destination), prefix: `${path.basename(destination)}.staging-` })
  try ensuring(effect {
    const main = path.join(scratch, ANDROID_MAIN)
    for (const entry of payload) {
      const target = path.join(main, entry.file.path.startsWith("lib/") ? `jniLibs/${entry.file.path.slice(4)}` : entry.file.path)
      try files.makeDirectory(path.dirname(target), { recursive: true })
      try files.writeFile(target, entry.bytes, { flag: "wx" })
      try files.chmod(target, entry.file.path.startsWith("lib/") && nativeMode(baseName(entry.file.path)) === "Executable" ? 0o755 : 0o644)
    }
    try files.writeFileString(path.join(main, INVENTORY_ASSET), `${JSON.stringify({ schema: 1, files: inventory }, null, 2)}\n`, { flag: "wx" })
    try files.rename(scratch, destination)
  }, Effect.ignore(files.remove(scratch, { recursive: true, force: true })))
  return destination
}

export effect function stageRuntimePayload(options: StageRuntimePayload) {
  if (options.abi.length === 0 || new Set(options.abi).size !== options.abi.length) throw new PayloadInputInvalid({ reason: "A payload targets one or more distinct ABIs" })
  const lock = try readLock(options.lock)
  const { nodeLock, runtimes } = try runtimesFor(options, lock)
  const bundle = try bundleFiles(options.bundleDir)
  const assets = try consumerAssets(options.extraAssets ?? [])
  const libraries = try consumerLibraries(options.nativeLibraries ?? [], options.abi)
  const worker = try workerFiles(options.workflowWorker)
  const allRuntimes = [...runtimes, ...libraries.runtimes]
  const payload: Staged[] = [
    ...runtimes.map((runtime) => staged(`lib/${runtime.abi}/${nodeLibraryName}`, "NodeRuntime", runtime.bytes, runtime.candidate.sha256)),
    ...bundle.files,
    ...assets.files,
    ...libraries.files,
    ...worker.files,
  ]
  const inventory: InventoryRow[] = [
    ...payload.flatMap((entry) => entry.listed === undefined ? [] : [{ path: entry.file.path, sha256: entry.listed, size: entry.file.size }]),
    ...assets.phantom,
  ].sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0)
  const profile: Profile = bundle.facts.localInference ? "LocalInference" : "CloudOnly"
  const workerPin: WorkerPin = bundle.facts.workflowWorkerSha256 === undefined ? { tag: "NoWorkerPin" } : { tag: "WorkerPinned", pinnedSha256: bundle.facts.workflowWorkerSha256 }
  const checked: StagedPayload = {
    lock: nodeLock,
    targets: options.abi.map(specAbi),
    runtimes: allRuntimes.map((runtime) => runtime.candidate),
    profile,
    files: payload.map((entry) => entry.file),
    inventory,
    workerPin,
    workerArtifact: worker.artifact,
  }
  const verdict = payloadVerdict(checked)
  if (verdict.tag === "PayloadRefused") throw new PayloadRefused({ reason: verdict.reason, subject: subjectOf(verdict.reason, checked) })
  for (const runtime of runtimes) {
    if (!isAndroidExecutable(runtime.bytes, runtime.abi)) throw new RuntimeNotAndroidExecutable({ abi: runtime.abi, path: `lib/${runtime.abi}/${nodeLibraryName}` })
  }
  const named = launchWorker(workerStaging(workerPin, worker.artifact), WORKER_RUNTIME_DIR, options.workflowWorker?.executable ?? "")
  const result: StagedRuntimePayload = {
    output: try publish(options.output, payload, inventory),
    inventory,
    workflowWorker: named.tag === "NamedWorker" ? { runtimeDir: named.runtimeDir, executable: named.executable, sha256: named.sha256 } : undefined,
  }
  return result
}

effect function run(command: string, args: readonly string[], cwd: string) {
  const spawner = try ChildProcessSpawner
  return try scoped(effect {
    const child = try spawner.spawn(ChildProcess.make(command, [...args], { cwd, extendEnv: true, stdin: "ignore" }))
    const [stdout, stderr] = try.all [Stream.mkString(Stream.decodeText(child.stdout)), Stream.mkString(Stream.decodeText(child.stderr))]
    const code: number = try child.exitCode
    if (code !== 0) throw new NodeBuildFailed({ command: [command, ...args].join(" "), code, output: `${stdout}${stderr}`.slice(-4000) })
  })
}

export effect function buildNodeRuntime(options: BuildNodeRuntime) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const lock = try readLock(options.lock)
  const header = try files.readFileString(path.join(options.source, "src", "node_version.h"))
  const part = (name: string) => new RegExp(`#define NODE_${name}_VERSION (\\d+)`).exec(header)?.[1]
  const version = `${part("MAJOR")}.${part("MINOR")}.${part("PATCH")}`
  if (version !== lock.version) throw new NodeBuildRefused({ reason: `The Node source is ${version}; the lock pins ${lock.version}` })
  const revision = /^Pkg\.Revision\s*=\s*(\S+)\s*$/m.exec(try files.readFileString(path.join(options.ndk, "source.properties")))?.[1]
  if (revision !== lock.ndk) throw new NodeBuildRefused({ reason: `The NDK is ${revision ?? "unknown"}; the lock pins ${lock.ndk}` })
  const destination = path.resolve(options.output)
  if (try files.exists(destination)) throw new PayloadOutputExists({ output: destination })
  try run("./android-configure", [options.ndk, String(lock.apiLevel), CONFIGURE_ARCH[options.abi]], options.source)
  try run("make", [`-j${options.jobs ?? cpuCount()}`], options.source)
  const bytes = try files.readFile(path.join(options.source, "out", "Release", "node"))
  if (!isAndroidExecutable(bytes, options.abi)) throw new RuntimeNotAndroidExecutable({ abi: options.abi, path: path.join(options.source, "out", "Release", "node") })
  const sha256 = sha256Hex(bytes)
  try files.makeDirectory(path.dirname(destination), { recursive: true })
  const scratch = try files.makeTempDirectory({ directory: path.dirname(destination), prefix: `${path.basename(destination)}.staging-` })
  try ensuring(effect {
    try files.writeFile(path.join(scratch, nodeLibraryName), bytes, { flag: "wx" })
    try files.chmod(path.join(scratch, nodeLibraryName), 0o755)
    try files.writeFileString(path.join(scratch, "node-runtime.json"), `${JSON.stringify({ schema: 1, abi: options.abi, version: lock.version, ndk: lock.ndk, apiLevel: lock.apiLevel, sha256 }, null, 2)}\n`, { flag: "wx" })
    try files.rename(scratch, destination)
  }, Effect.ignore(files.remove(scratch, { recursive: true, force: true })))
  const built: BuiltNodeRuntime = { dir: destination, abi: options.abi, version: lock.version, sha256, size: bytes.byteLength }
  return built
}
