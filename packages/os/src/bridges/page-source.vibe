// spec/os/browser/tabHost/reading.md, "A sensitive page refuses Ask and an unavailable isolated world opens an empty review"
import { isWebAddress } from "../browser/address.ts"
import { MAX_READING_EXCERPT, sensitiveReadingDocument, sensitiveReadingText, sensitiveReadingUrl } from "./page-reading.vibe"

module web {
  /** @throws {never} */
  export function templateParser(html: string): DocumentFragment {
    const template = document.createElement("template")
    template.innerHTML = html
    return template.content
  }

  /** @throws {never} */
  export function requestSignal(signal: AbortSignal, timeoutMs: number): AbortSignal {
    return AbortSignal.any([signal, AbortSignal.timeout(timeoutMs)])
  }

  /** @throws {never} */
  export function publicRequest(url: string, signal: AbortSignal, fetcher: typeof globalThis.fetch = globalThis.fetch): Promise<Response> {
    return fetcher(url, {
      signal,
      mode: "cors",
      credentials: "omit",
      redirect: "error",
      referrerPolicy: "no-referrer",
      cache: "no-store",
      headers: { Accept: "text/html,text/plain" },
    })
  }
}
import { publicRequest, requestSignal, templateParser } from web

export type PageSource =
  | { readonly text: string; readonly truncated: boolean; readonly blocked?: false }
  | { readonly blocked: true }

export interface PageSourcePorts {
  readonly fetch?: typeof globalThis.fetch
  readonly parseHtml?: (html: string) => DocumentFragment
  readonly timeoutMs?: number
}

export const MAX_PAGE_SOURCE_BYTES = 262_144
export const MAX_PLAIN_SOURCE_CHARS = 20_000
export const PAGE_SOURCE_TIMEOUT_MS = 5_000

const BLOCKED: PageSource = { blocked: true }
const REMOVED =
  'script,style,noscript,template,iframe,object,embed,svg,form,input,textarea,select,option,button,frame,nav,aside,header,footer,head,[contenteditable]:not([contenteditable="false"]),[role="navigation"],[role="textbox"],[role="button"],[hidden],[inert],[aria-hidden="true"]'
const BLOCK = /^(P|DIV|SECTION|ARTICLE|MAIN|H[1-6]|LI|BR|TR|BLOCKQUOTE|PRE)$/
const ELEMENT_NODE = 1
const TEXT_NODE = 3

export function pageSourceText(root: DocumentFragment): string | undefined {
  if (sensitiveReadingDocument(root)) return undefined
  for (const node of root.querySelectorAll(REMOVED)) node.remove()
  for (const node of root.querySelectorAll<HTMLElement>("[style]"))
    if (node.style.display === "none" || node.style.visibility === "hidden") node.remove()
  const parts: string[] = []
  const walk = (node: Node): void => {
    if (node.nodeType === TEXT_NODE) {
      parts.push(node.textContent ?? "")
      return
    }
    const tag = node.nodeType === ELEMENT_NODE ? (node as Element).tagName.toUpperCase() : ""
    const block = BLOCK.test(tag)
    if (block) parts.push("\n")
    for (const child of node.childNodes) walk(child)
    if (block && tag !== "BR") parts.push("\n")
  }
  walk(root.querySelector('article,main,[role="main"]') ?? root)
  return parts.join("")
}

export function pageSourceExcerpt(source: string): PageSource | undefined {
  const text = source
    .replace(/\r\n?/g, "\n")
    .replace(/[\t \f\v]+/g, " ")
    .replace(/ *\n */g, "\n")
    .replace(/\n{3,}/g, "\n\n")
    .trim()
  return text === "" ? undefined : { text: text.slice(0, MAX_READING_EXCERPT), truncated: text.length > MAX_READING_EXCERPT }
}

type Body =
  | { readonly kind: "read"; readonly source: string }
  | { readonly kind: "too-large" }
  | { readonly kind: "unreadable" }

async function boundedBody(response: Response, signal: AbortSignal): Promise<Body> {
  const reader = response.body?.getReader()
  if (reader === undefined) return { kind: "unreadable" }
  const decoder = new TextDecoder("utf-8", { fatal: true })
  let bytes = 0
  let source = ""
  try {
    for (;;) {
      signal.throwIfAborted()
      const next = await reader.read()
      if (next.done) break
      bytes += next.value.length
      if (bytes > MAX_PAGE_SOURCE_BYTES) return { kind: "too-large" }
      source += decoder.decode(next.value, { stream: true })
    }
    return { kind: "read", source: source + decoder.decode() }
  } finally {
    await reader.cancel().catch(() => undefined)
    reader.releaseLock()
  }
}

async function publicSource(url: string, request: AbortSignal, ports: PageSourcePorts): Promise<PageSource | undefined> {
  const response = await publicRequest(url, request, ports.fetch)
  const type = response.headers.get("content-type")?.split(";")[0]?.trim().toLowerCase()
  if (!response.ok || (type !== "text/html" && type !== "text/plain")) {
    await response.body?.cancel()
    return undefined
  }
  if (Number(response.headers.get("content-length") ?? 0) > MAX_PAGE_SOURCE_BYTES) {
    await response.body?.cancel()
    return BLOCKED
  }
  const body = await boundedBody(response, request)
  if (body.kind === "too-large") return BLOCKED
  if (body.kind === "unreadable") return undefined
  if (type === "text/html") {
    const text = pageSourceText((ports.parseHtml ?? templateParser)(body.source))
    return text === undefined ? BLOCKED : pageSourceExcerpt(text)
  }
  return body.source.length > MAX_PLAIN_SOURCE_CHARS || sensitiveReadingText(body.source) ? BLOCKED : pageSourceExcerpt(body.source)
}

export async function readPublicPageSource(address: string, signal: AbortSignal, ports: PageSourcePorts = {}): Promise<PageSource | undefined> {
  if (sensitiveReadingUrl(address)) return BLOCKED
  if (!isWebAddress(address)) return undefined
  let source: PageSource | undefined
  try {
    const request = requestSignal(signal, ports.timeoutMs ?? PAGE_SOURCE_TIMEOUT_MS)
    source = await publicSource(address, request, ports)
    request.throwIfAborted()
  } catch (failure) {
    if (signal.aborted) throw failure
    return undefined
  }
  return source
}
