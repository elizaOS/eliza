// spec/os/voice/invocation.md, "Story: Start voice from a trusted gesture, once"; spec/os/voice/invocation.md, "Without an admitted listener a listener launch only opens the assistant"; spec/os/voice/invocation.md, "Each arrival starts voice at most once"; spec/os/voice/invocation.md, "The renderer starts voice from a voice answer only while unlocked, visible, with no dialog, no connection prompt and no active voice"
import { listenerStartsVoice as startsVoiceOnScreen } from "../../gen/os__voice__invocation.effect.vibe"
import type { Answer, Origin } from "../../gen/os__voice__invocation.ts"
import { LISTENER_STATES } from "./definitions/sense.ts"
import type {
  AssistantInvocation,
  InvocationSessionKey,
  ListenerState,
  ListenerStatus,
  ListenerStopAction,
  ListenerStopReceipt,
  ListenerVoiceInput,
  SenseInvocationController,
  SenseInvocationHost,
  SenseInvocationNative,
  SensePlugin,
  SenseScreen,
  SenseVoiceEntryPolicy,
} from "./definitions/sense.ts"

export type * from "./definitions/sense.ts"
export { LISTENER_STATES }

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { SensePlugin } from "./definitions/sense.ts"

  /** @throws {never} */
  export function sensePlugin(name = "ElizaSense"): SensePlugin {
    return registerPlugin<SensePlugin>(name, {
      web: {
        status: async () => ({ available: false }),
        pause: async () => ({ available: false }),
        turnOff: async () => ({ available: false }),
        openSettings: async () => ({ opened: false }),
        bindInvocationSession: async () => {},
        takeInvocation: async () => ({ assistant: false, invocation: null, locked: true }),
      },
    })
  }
}
import { sensePlugin } from capacitor
export { sensePlugin }

module renderer {
  import type { SenseScreen } from "./definitions/sense.ts"

  const MODAL = 'dialog[open], [role="dialog"][aria-modal="true"], [role="alertdialog"]'

  /** @throws {never} */
  export function documentScreen(): SenseScreen {
    return {
      hidden: () => document.hidden,
      dialogOpen: () => document.querySelector(MODAL) !== null,
      watch: (events, changed) => {
        for (const event of events) window.addEventListener(event, changed)
        document.addEventListener("visibilitychange", changed)
        return () => {
          for (const event of events) window.removeEventListener(event, changed)
          document.removeEventListener("visibilitychange", changed)
        }
      },
    }
  }

  /** @throws {never} */
  export function bindingId(): string {
    return globalThis.crypto.randomUUID()
  }

  /** @throws {never} */
  export async function sha256Hex(text: string): Promise<string> {
    const bytes = await globalThis.crypto.subtle.digest("SHA-256", new TextEncoder().encode(text))
    return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("")
  }

  /** @throws {never} */
  export function within<T>(ms: number, run: () => Promise<T>, message: string): Promise<T> {
    let timer: ReturnType<typeof setTimeout> | undefined
    return Promise.race([run(), new Promise<never>((_, reject) => { timer = setTimeout(() => reject(new Error(message)), ms) })])
      .finally(() => clearTimeout(timer))
  }

  /** @throws {never} */
  export function repeat(every: number, times: number, run: () => void): () => void {
    let rounds = 0
    const timer = setInterval(() => {
      run()
      rounds += 1
      if (rounds >= times) clearInterval(timer)
    }, every)
    return () => clearInterval(timer)
  }
}
import { bindingId, documentScreen, repeat, sha256Hex, within } from renderer
export { documentScreen }

export const SENSE_INVOCATION_EVENT = "eliza:sense-invocation"
export const SENSE_BRIDGE_TIMEOUT_MS = 10_000
export const LISTENER_STOP_TIMEOUT_MS = 5_000
const LABEL_LIMIT = 80
const OFF_LABEL = "Listening off"
const INITIAL_CHECKS = 50
const INITIAL_CHECK_EVERY_MS = 100

const PAUSE_STOP_STATES: ReadonlySet<ListenerState> = new Set<ListenerState>([
  "OFF",
  "PERMISSION_REQUIRED",
  "NOTIFICATIONS_REQUIRED",
  "STOPPED_AFTER_ERRORS",
  "STOPPED_INDICATOR_LOST",
  "PAUSED_OTHER_USER",
  "WAITING_FOR_UNLOCK",
  "SPEECH_UNAVAILABLE",
  "PAUSED_USER",
])

export const CONVERSATION_ONLY_VOICE_ENTRY: SenseVoiceEntryPolicy = Object.freeze({ externalInvocation: false })
export const ASSISTANT_INVOCATION_VOICE_ENTRY: SenseVoiceEntryPolicy = Object.freeze({ externalInvocation: true })

function fields(value: unknown): Record<string, unknown> {
  return typeof value === "object" && value !== null ? (value as Record<string, unknown>) : {}
}

function absentListener(value: Record<string, unknown>): boolean {
  return value.available === false && value.reason === "not-installed" && value.state === undefined
    && (value.listening === undefined || value.listening === false)
    && (value.microphoneOpen === undefined || value.microphoneOpen === false)
}

export function parseListenerStatus(raw: unknown): ListenerStatus {
  const value = fields(raw)
  if (value.available !== true) return absentListener(value) ? { available: false, reason: "not-installed" } : { available: false }
  const state = LISTENER_STATES.find((candidate) => candidate === value.state)
  if (state === undefined) return { available: false }
  return {
    available: true,
    state,
    label: typeof value.label === "string" && value.label.length > 0 && value.label.length <= LABEL_LIMIT ? value.label : OFF_LABEL,
    consented: value.consented === true,
    listening: state === "LISTENING" && value.listening === true,
    microphoneOpen: value.microphoneOpen === true,
  }
}

export function parseListenerStopReceipt(raw: unknown, action: ListenerStopAction): ListenerStopReceipt {
  const value = fields(raw)
  if (value.saved !== true || value.listening !== false || value.microphoneOpen !== false) return { available: false }
  const status = parseListenerStatus(value)
  if (!status.available) return { available: false }
  const stopped = action === "turnOff" ? status.state === "OFF" : PAUSE_STOP_STATES.has(status.state)
  return stopped ? { ...status, saved: true, listening: false, microphoneOpen: false } : { available: false }
}

export function parseAssistantInvocation(raw: unknown): AssistantInvocation {
  const value = fields(raw)
  if (value.assistant !== true) return null
  return value.invocation === "listener" || value.invocation === "system" || value.invocation === "power" ? value.invocation : "assist"
}

export function parseInvocationUnlocked(raw: unknown): boolean {
  return fields(raw).locked === false
}

function originOf(invocation: "listener" | "system" | "power"): Origin {
  switch (invocation) {
    case "listener": return "Listener"
    case "system": return "System"
    case "power": return "Power"
  }
}

function answerOf(invocation: AssistantInvocation): Answer {
  if (invocation === null) return { tag: "NoAnswer" }
  if (invocation === "assist") return { tag: "OpenOnly", arrival: 1 }
  return { tag: "VoiceStart", origin: originOf(invocation), arrival: 1, claim: "WarmClaim", age: 0 }
}

export function listenerStartsVoice(input: ListenerVoiceInput): boolean {
  return startsVoiceOnScreen(answerOf(input.invocation), {
    unlocked: input.unlocked,
    visible: !input.hidden,
    dialogOpen: input.dialogOpen,
    connectionPrompt: input.connectionOpen,
    voiceActive: input.voiceActive,
  })
}

export async function invocationSessionKey(authority: string): Promise<InvocationSessionKey> {
  return (await sha256Hex(authority)) as InvocationSessionKey
}

export function listenerStatus(plugin: SensePlugin = sensePlugin()): Promise<ListenerStatus> {
  return plugin.status().then(parseListenerStatus, () => ({ available: false }))
}

export function stopListener(action: ListenerStopAction, plugin: SensePlugin = sensePlugin()): Promise<ListenerStopReceipt> {
  return (action === "pause" ? plugin.pause() : plugin.turnOff()).then((reply) => parseListenerStopReceipt(reply, action), () => ({ available: false }))
}

export function mobileVoiceEntryPolicy(aosp: boolean): SenseVoiceEntryPolicy {
  return aosp ? ASSISTANT_INVOCATION_VOICE_ENTRY : CONVERSATION_ONLY_VOICE_ENTRY
}

export effect function stopListenerForChatOnly(native: Pick<SensePlugin, "turnOff"> | undefined): boolean!! {
  if (native === undefined) return false
  const reply = timeout(tryPromise(() => native.turnOff()), LISTENER_STOP_TIMEOUT_MS) catch () => undefined
  return absentListener(fields(reply)) || parseListenerStopReceipt(reply, "turnOff").available
}

export function stopSenseListenerForChatOnly(native: Pick<SensePlugin, "turnOff"> | undefined): Promise<boolean> {
  return runPromise(stopListenerForChatOnly(native))
}

let invocationOperation: Promise<void> = Promise.resolve()
let activeInvocationBinding: string | null = null
let nextInvocationGeneration = 0

function serializeInvocation<T>(run: () => Promise<T>): Promise<T> {
  const bounded = () => within(SENSE_BRIDGE_TIMEOUT_MS, run, "Sense bridge did not complete")
  const result = invocationOperation.then(bounded, bounded)
  invocationOperation = result.then(() => {}, () => {})
  return result
}

export function createSenseInvocationController(
  native: SenseInvocationNative,
  host: SenseInvocationHost,
  policy: SenseVoiceEntryPolicy = ASSISTANT_INVOCATION_VOICE_ENTRY,
  screen: SenseScreen = documentScreen(),
): SenseInvocationController {
  if (!policy.externalInvocation) return { check() {}, dispose() {} }
  const id = bindingId()
  const generation = ++nextInvocationGeneration
  activeInvocationBinding = id
  const binding = { generation, bindingId: id }
  let digestAuthority: string | null | undefined
  let digestKey: InvocationSessionKey | null = null
  let disposed = false
  let checking = false
  let dirty = false
  let initialized = false
  let bound: InvocationSessionKey | null = null
  let coldLaunchAttempted = false
  const current = (authority: string | null) => !disposed && activeInvocationBinding === id && host.authority() === authority
  const blocked = () => screen.hidden() || host.voiceActive() || screen.dialogOpen()
  const check = async (): Promise<void> => {
    if (disposed) return
    if (checking) {
      dirty = true
      return
    }
    checking = true
    try {
      const authority = host.authority()
      const key = authority === digestAuthority ? digestKey : authority === null ? null : await invocationSessionKey(authority)
      if (!current(authority)) return
      digestAuthority = authority
      digestKey = key
      if (!initialized || bound !== key) {
        await serializeInvocation(async () => {
          if (current(authority)) await native.bindInvocationSession({ ...binding, sessionKey: key })
        })
        if (!current(authority)) return
        bound = key
        initialized = true
      }
      const initialRestore = host.initialRestorePending?.() === true
      if (blocked() || (!initialRestore && (key === null || !host.ready()))) {
        coldLaunchAttempted = true
        await serializeInvocation(async () => {
          if (current(authority)) await native.discardProtectedPowerLaunch?.({ ...binding, sessionKey: key })
        })
      }
      if (key === null) return
      if (blocked() || !host.ready()) {
        await serializeInvocation(async () => {
          if (current(authority)) await native.discardProtectedPowerInvocation?.({ ...binding, sessionKey: key })
        })
        return
      }
      const accountRef = host.powerAccountRef?.() ?? null
      const receipt = await serializeInvocation(async (): Promise<unknown> => {
        if (!current(authority)) return undefined
        if (!initialRestore && !coldLaunchAttempted && host.powerAccountRef) {
          coldLaunchAttempted = true
          const launch = accountRef === null ? undefined : await native.claimProtectedPowerLaunch?.({ ...binding, sessionKey: key, accountRef })
          if (parseAssistantInvocation(launch) === "power") return launch
        }
        return current(authority) ? native.takeInvocation({ ...binding, sessionKey: key }) : undefined
      })
      if (!current(authority) || !host.ready() || host.voiceActive() || (host.powerAccountRef && host.powerAccountRef() !== accountRef)) return
      const starts = listenerStartsVoice({
        invocation: parseAssistantInvocation(receipt),
        unlocked: parseInvocationUnlocked(receipt),
        hidden: screen.hidden(),
        dialogOpen: screen.dialogOpen(),
        connectionOpen: !host.ready(),
        voiceActive: host.voiceActive(),
      })
      if (starts) host.startVoice()
    } catch {
      return
    } finally {
      checking = false
      if (dirty && !disposed) {
        dirty = false
        void check()
      }
    }
  }
  const changed = () => {
    void check()
  }
  const unwatch = screen.watch([SENSE_INVOCATION_EVENT, ...(host.events ?? [])], changed)
  const unsubscribe = host.subscribe?.(changed)
  const stopInitial = repeat(INITIAL_CHECK_EVERY_MS, INITIAL_CHECKS, changed)
  changed()
  return {
    check: changed,
    dispose() {
      disposed = true
      if (activeInvocationBinding === id) activeInvocationBinding = null
      stopInitial()
      unsubscribe?.()
      unwatch()
      void serializeInvocation(async () => {
        await native.discardProtectedPowerLaunch?.({ ...binding, sessionKey: bound })
        await native.bindInvocationSession({ ...binding, sessionKey: null })
      }).catch(() => {})
    },
  }
}
