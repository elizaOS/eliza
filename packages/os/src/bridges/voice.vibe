// spec/os/voice/cloudSpeech.md, "Story: Talk to the agent through the cloud speech relay"; spec/os/voice/cloudSpeech.md, "A provider speech edge belongs to the capture live when it began, and a retired capture owns none"; spec/os/voice/cloudSpeech.md, "A reply settles once: completed when all its audio has played, or cancelled"; spec/os/voice/cloudSpeech.md, "Every end of a session releases the microphone, settles the reply, revokes the session and reports a failure once"; spec/os/voice/cloudSpeech.md, "An open session and every waiting batch request run under the current key, and a key change ends them"; spec/os/voice/cloudSpeech.md, "The speaker is muted for the whole session without ending voice, and only an open session whose bridge can mute it applies the mute"
import type {
  AssistantCapture,
  AssistantListenHandlers,
  CloudSpeechListenerHandle,
  CloudStreamEvent,
  CloudStreamingSpeech,
  CloudStreamingSpeechOptions,
  CloudStreamPort,
  NativeSpeechRequestBinding,
  NativeSpeechRequestId,
  NativeSpeechRequestRunner,
  NativeSpeechRequestWork,
  SpeechSessionId,
  UtteranceId,
} from "./definitions/voice.ts"

export type * from "./definitions/voice.ts"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { ElizaCloudSpeechPlugin } from "./definitions/voice.ts"

  /** @throws {never} */
  export function cloudSpeechPlugin(name = "ElizaCloudSpeech"): ElizaCloudSpeechPlugin {
    return registerPlugin<ElizaCloudSpeechPlugin>(name)
  }
}
import { cloudSpeechPlugin } from capacitor
export { cloudSpeechPlugin }

module renderer {
  /** @throws {never} */
  export function abortError(message: string): Error {
    return typeof DOMException === "function" ? new DOMException(message, "AbortError") : Object.assign(new Error(message), { name: "AbortError" })
  }

  /** @throws {never} */
  export function randomId(): string {
    return globalThis.crypto.randomUUID()
  }

  /** @throws {never} */
  export function now(): number {
    return Date.now()
  }

  /** @throws {never} */
  export function after(ms: number, run: () => void): () => void {
    const timer = setTimeout(run, ms)
    return () => clearTimeout(timer)
  }

  /** @throws {never} */
  export function ownedAbort(): AbortController {
    return new AbortController()
  }
}
import { abortError, after, now, ownedAbort, randomId } from renderer

export error CloudSpeechUnavailable { code: string; data: object | undefined }

export error CloudSpeechRefused {
  reason: "owner-changed" | "session-changed" | "not-connected" | "output-mute-unavailable" | "phrase-too-long" | "mute-unconfirmed" | "ended-without-audio"
}

export error CloudSpeechInterrupted { code: string }

export error CloudSpeechCleanupUnconfirmed {
  utteranceId: UtteranceId
  get code() {
    return "speech-cleanup-unconfirmed"
  }
}

const SAMPLE_RATE = 16000
const MAX_HEARD_TEXT = 16384
const MAX_PHRASE = 4096
const MUTE_CONFIRM_MS = 2500

const Heard = Schema.String.check(Schema.isMaxLength(MAX_HEARD_TEXT))
const session = { sessionId: Schema.String }
const StreamEvent = Schema.Union([
  Schema.Struct({ ...session, type: Schema.Literal("error"), code: Schema.optionalKey(Schema.Unknown), data: Schema.optionalKey(Schema.Unknown) }),
  Schema.Struct({ ...session, type: Schema.Literals(["audio-start", "audio-end"]), utteranceId: Schema.String, interrupted: Schema.optionalKey(Schema.String) }),
  Schema.Struct({ ...session, type: Schema.Literal("speech-start") }),
  Schema.Struct({ ...session, type: Schema.Literals(["speech-end", "transcript"]), text: Heard }),
  Schema.Struct({ ...session, type: Schema.Literal("level"), peak: Schema.Finite }),
])

type Stale = { readonly error: unknown } | undefined

interface PendingUtterance {
  started: boolean
  onStarted(): void
  resolve(): void
  reject(error: unknown): void
}

function unavailable(event: { readonly code?: unknown; readonly data?: unknown }): CloudSpeechUnavailable {
  return new CloudSpeechUnavailable({
    code: typeof event.code === "string" ? event.code : "cloud-stream",
    data: typeof event.data === "object" && event.data !== null ? event.data : undefined,
  })
}

function settleAudio(utterances: Map<string, PendingUtterance>, type: "audio-start" | "audio-end", utteranceId: string, interrupted: string | undefined) {
  const pending = utterances.get(utteranceId)
  if (!pending) return
  if (type === "audio-start") {
    if (pending.started) return
    pending.started = true
    pending.onStarted()
    return
  }
  utterances.delete(utteranceId)
  if (interrupted !== undefined) pending.reject(new CloudSpeechInterrupted({ code: interrupted }))
  else if (pending.started) pending.resolve()
  else pending.reject(new CloudSpeechRefused({ reason: "ended-without-audio" }))
}

export function createCloudStreamingSpeech(input: CloudStreamingSpeechOptions, port: CloudStreamPort = cloudSpeechPlugin()): CloudStreamingSpeech {
  const sessionId = randomId() as SpeechSessionId
  const stopped = () => abortError("Cloud speech stopped")
  const utterances = new Map<string, PendingUtterance>()
  let handle: CloudSpeechListenerHandle | undefined
  let opening: Promise<void> | undefined
  let stopping: Promise<void> | undefined
  let opened = false
  let retired = false
  let echoCancelled = false
  let speechActive = false
  let captureGeneration = 0
  let speechGeneration: number | undefined
  let listening: AssistantListenHandlers | undefined
  let lifecycle: AssistantListenHandlers | undefined
  let ownerSignal: AbortSignal | undefined
  let ended: () => void = () => {}

  const stale = (): Stale => {
    if (retired) return { error: stopped() }
    try {
      input.assertCurrent()
      return undefined
    } catch (error) {
      return { error }
    }
  }

  const ownerAborted = () => {
    void stop().catch(() => {})
  }

  const rejectAll = (error: unknown) => {
    for (const pending of utterances.values()) pending.reject(error)
    utterances.clear()
  }

  const stop = (): Promise<void> => {
    if (stopping) return stopping
    retired = true
    opened = false
    speechActive = false
    ended()
    ownerSignal?.removeEventListener("abort", ownerAborted)
    ownerSignal = undefined
    rejectAll(stopped())
    stopping = (async () => {
      try {
        await port.stopCloudSpeech({ sessionId })
      } finally {
        await handle?.remove()
        handle = undefined
      }
    })()
    return stopping
  }

  const fail = (error: unknown) => {
    const capture = lifecycle
    listening = lifecycle = undefined
    rejectAll(error)
    void stop().catch(() => {})
    try {
      capture?.onEnd(error)
    } catch {
      return
    }
  }

  const receive = (raw: CloudStreamEvent) => {
    const decoded = Schema.decodeUnknownOption(StreamEvent)(raw)
    if (Option.isNone(decoded) || retired || decoded.value.sessionId !== sessionId) return
    const event = decoded.value
    const failure = stale()
    if (failure) return fail(failure.error)
    try {
      const capture = listening && !listening.signal.aborted ? listening : undefined
      switch (event.type) {
        case "error":
          return fail(unavailable(event))
        case "audio-start":
        case "audio-end":
          return settleAudio(utterances, event.type, event.utteranceId, event.interrupted)
        case "speech-start":
          if (speechActive) return
          speechActive = true
          speechGeneration = capture ? captureGeneration : undefined
          return capture?.onSpeechStart(now())
        case "speech-end": {
          const owns = speechActive && speechGeneration === captureGeneration
          speechActive = false
          speechGeneration = undefined
          if (capture && owns) {
            capture.onSpeechEnd(now())
            capture.onSegment(event.text.trim() || null)
          }
          return ended()
        }
        case "level":
          return capture?.onLevel?.(Math.max(0, Math.min(1, event.peak)))
        case "transcript":
          if (capture && speechActive && speechGeneration === captureGeneration) input.onInterim?.(event.text)
          return
      }
    } catch (error) {
      fail(error)
    }
  }

  const open = () =>
    (opening ??= (async () => {
      try {
        const before = stale()
        if (before) throw before.error
        const registered = await port.addListener("cloudSpeechEvent", receive)
        if (retired) {
          await registered.remove()
          throw stopped()
        }
        handle = registered
        const registeredStale = stale()
        if (registeredStale) throw registeredStale.error
        const result = await port.startCloudSpeech({ sessionId, environment: input.environment, credentialId: input.credentialId })
        const startedStale = stale()
        if (startedStale) throw startedStale.error
        if (result.sessionId !== sessionId || result.sampleRate !== SAMPLE_RATE) throw new CloudSpeechRefused({ reason: "session-changed" })
        opened = true
        echoCancelled = result.echoCancelled === true
      } catch (error) {
        await stop().catch(() => {})
        throw error
      }
    })())

  const muteAndDrain = async () => {
    const failure = stale()
    if (failure) throw failure.error
    const final = speechActive ? new Promise<void>((resolve) => (ended = resolve)) : Promise.resolve()
    let cancelTimer = () => {}
    try {
      await Promise.race([
        port.setCloudSpeechMuted({ sessionId, muted: true }).then(() => final),
        new Promise<void>((_, reject) => {
          cancelTimer = after(MUTE_CONFIRM_MS, () => reject(new CloudSpeechRefused({ reason: "mute-unconfirmed" })))
        }),
      ])
    } finally {
      cancelTimer()
      ended = () => {}
    }
  }

  const listen = async (handlers: AssistantListenHandlers): Promise<AssistantCapture> => {
    const failure = stale()
    if (failure) throw failure.error
    handlers.signal.throwIfAborted()
    if (ownerSignal && ownerSignal !== handlers.signal) throw new CloudSpeechRefused({ reason: "owner-changed" })
    if (!ownerSignal) {
      ownerSignal = handlers.signal
      ownerSignal.addEventListener("abort", ownerAborted, { once: true })
    }
    try {
      if (speechActive) await muteAndDrain()
      const drained = stale()
      if (drained) throw drained.error
      handlers.signal.throwIfAborted()
      ++captureGeneration
      listening = lifecycle = handlers
      speechActive = false
      await open()
      const connected = stale()
      if (connected) throw connected.error
      handlers.signal.throwIfAborted()
      await port.setCloudSpeechMuted({ sessionId, muted: false })
      const unmuted = stale()
      if (unmuted) throw unmuted.error
    } catch (error) {
      await stop().catch(() => {})
      throw error
    }
    const release = () => {
      if (listening !== handlers) return
      listening = undefined
      speechActive = false
    }
    return {
      fullDuplex: echoCancelled,
      async close() {
        try {
          await muteAndDrain()
        } finally {
          release()
        }
      },
      async cancel() {
        release()
        if (lifecycle === handlers) lifecycle = undefined
        await stop()
      },
    }
  }

  const speak = async (text: string, signal: AbortSignal, onStarted: () => void): Promise<void> => {
    const failure = stale()
    if (failure) throw failure.error
    signal.throwIfAborted()
    if (!opened) throw new CloudSpeechRefused({ reason: "not-connected" })
    const value = text.trim()
    if (!value) return
    if (value.length > MAX_PHRASE) throw new CloudSpeechRefused({ reason: "phrase-too-long" })
    const utteranceId = randomId() as UtteranceId
    let reject: (error: unknown) => void = () => {}
    const done = new Promise<void>((resolve, failed) => {
      reject = failed
      utterances.set(utteranceId, { started: false, onStarted, resolve, reject: failed })
    })
    void done.catch(() => {})
    let retiring: Promise<void> | undefined
    const abort = () => {
      if (retiring) return
      retiring = Promise.resolve()
        .then(() => port.cancelCloudSpeech({ sessionId, utteranceId }))
        .then(() => undefined, () => Promise.reject(new CloudSpeechCleanupUnconfirmed({ utteranceId })))
      void retiring.then(() => reject(signal.reason ?? stopped()), (error: unknown) => reject(error))
    }
    signal.addEventListener("abort", abort, { once: true })
    if (signal.aborted) abort()
    try {
      signal.throwIfAborted()
      const before = stale()
      if (before) throw before.error
      await port.speakCloudSpeech({ sessionId, utteranceId, text: value })
      await done
      signal.throwIfAborted()
      const after = stale()
      if (after) throw after.error
    } finally {
      signal.removeEventListener("abort", abort)
      utterances.delete(utteranceId)
      await retiring
    }
  }

  return {
    async setOutputMuted(muted: boolean) {
      const failure = stale()
      if (failure) throw failure.error
      if (!opened || !port.setCloudSpeechOutputMuted) throw new CloudSpeechRefused({ reason: "output-mute-unavailable" })
      await port.setCloudSpeechOutputMuted({ sessionId, muted })
      const after = stale()
      if (after) throw after.error
    },
    listen,
    speak,
    stop,
  }
}

export function createNativeSpeechRequests(binding: NativeSpeechRequestBinding): NativeSpeechRequestRunner {
  return async <T,>(signal: AbortSignal, work: NativeSpeechRequestWork<T>): Promise<T> => {
    binding.check()
    signal.throwIfAborted()
    const owned = ownedAbort()
    const requestId = binding.newRequestId?.() ?? (randomId() as NativeSpeechRequestId)
    let reject: (reason: unknown) => void = () => {}
    const interrupted = new Promise<never>((_, fail) => {
      reject = fail
    })
    void interrupted.catch(() => {})
    const cancelBridge = () => {
      try {
        return binding.cancel(requestId)
      } catch {
        return undefined
      }
    }
    const cancel = () => {
      if (owned.signal.aborted) return
      void cancelBridge()?.catch(() => {})
      owned.abort(abortError(binding.cancelledMessage ?? "Voice cancelled"))
      reject(owned.signal.reason)
    }
    const unwatch = binding.watch(() => {
      try {
        binding.check()
      } catch {
        cancel()
      }
    })
    signal.addEventListener("abort", cancel, { once: true })
    try {
      const result = await work(requestId, interrupted, owned.signal)
      binding.check()
      signal.throwIfAborted()
      return result
    } finally {
      signal.removeEventListener("abort", cancel)
      unwatch()
    }
  }
}
