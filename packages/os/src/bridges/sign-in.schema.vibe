// spec/os/signIn/flow.md, "Story: Sign in with a code, Google or a second factor"; spec/os/signIn/flow.md, "Story: Cancel or resend exactly the request I mean"; spec/os/signIn/readiness.md, "Story: Show only the methods the cloud is ready for"; spec/os/signIn/readiness.md, "Story: Read the service's own terms"
import type { SignInCode, SignInRequestId } from "./definitions/sign-in.ts"

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
const CODE = /^[0-9]{6}$/

const uuid = Schema.String.check(Schema.isPattern(UUID))
const Text = Schema.String.check(Schema.isMinLength(1))
const Instant = Schema.Int.check(Schema.isGreaterThan(0))
export const RequestId = uuid.pipe(Schema.brand("SignInRequestId"))
const AttemptId = uuid.pipe(Schema.brand("SignInAttemptId"))
const CredentialId = Text.pipe(Schema.brand("CredentialId"))
const Code = Schema.String.check(Schema.isPattern(CODE)).pipe(Schema.brand("SignInCode"))
const Factor = Schema.Literals(["totp", "sms"])
const OpenStep = Schema.Literals(["starting", "code-sent", "verifying", "second-factor", "exchanging"])
const Google = Schema.Literals(["not-requested", "held", "connected", "refused"])

export const FailureCode = Schema.Literals([
  "cancelled",
  "busy",
  "invalid-request",
  "invalid-code",
  "expired",
  "too-many-attempts",
  "unavailable",
  "refused",
  "google-unavailable",
  "storage",
])

const CodeSent = Schema.Struct({ step: Schema.Literal("code-sent"), requestId: RequestId, attemptId: AttemptId, expiresAt: Instant, resendAt: Instant })
const FactorAsked = Schema.Struct({ step: Schema.Literal("second-factor"), requestId: RequestId, attemptId: AttemptId, methods: Schema.NonEmptyArray(Factor), expiresAt: Instant })
export const SignedIn = Schema.Struct({ step: Schema.Literal("signed-in"), requestId: RequestId, attemptId: AttemptId, credentialId: CredentialId, google: Google })
export const Failed = Schema.Struct({ step: Schema.Literal("failed"), requestId: RequestId, attemptId: AttemptId, google: Google, failure: FailureCode })

export const Progress = Schema.Union([CodeSent, FactorAsked, SignedIn])
export const Settled = Schema.Union([SignedIn, Failed])

export const Kept = Schema.Struct({ kept: Schema.Literal(true), requestId: RequestId, step: OpenStep })
export const Later = Schema.Struct({ resendAt: Instant })
export const Rejected = Schema.Struct({ code: FailureCode, data: Schema.optionalKey(Schema.Unknown) })

export const FactorCodeSent = Schema.Struct({ requestId: RequestId })
export const Cancelled = Schema.Struct({ cancelled: Schema.Boolean })

export const Account = Schema.Union([
  Schema.Struct({ signedIn: Schema.Literal(false) }),
  Schema.Struct({ signedIn: Schema.Literal(true), userId: Text, organizationId: Text, credentialId: CredentialId, keyExpiresAt: Instant }),
])

export const SignedOut = Schema.Struct({ account: Account })

const ReadinessFields = {
  environment: Text.pipe(Schema.brand("EnvironmentName")),
  methodsKnown: Schema.Boolean,
  email: Schema.Boolean,
  sms: Schema.Boolean,
  google: Schema.Boolean,
  googleMode: Schema.Literals(["picker", "browser"]),
}

export const Readiness = Schema.Struct(ReadinessFields)
export const Status = Schema.Struct({ ...ReadinessFields, account: Account })

export const Service = Schema.Union([
  Schema.Struct({ outcome: Schema.Literal("service_shown"), service: Schema.Struct({ name: Text, terms: Text, privacy: Text }) }),
  Schema.Struct({ outcome: Schema.Literals(["service_unavailable", "service_unknown_environment"]) }),
])

export function requestIdOf(text: string): Option.Option<SignInRequestId> {
  return Schema.decodeUnknownOption(RequestId)(text)
}

export function signInCode(typed: string): Option.Option<SignInCode> {
  return Schema.decodeUnknownOption(Code)(typed.replace(/[\s-]/g, ""))
}
