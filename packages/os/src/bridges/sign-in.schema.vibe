// spec/os/signIn/flow.md, "Story: Sign in with a code, Google or a second factor"; spec/os/signIn/flow.md, "Story: Cancel or resend exactly the request I mean"; spec/os/signIn/readiness.md, "Story: Show only the methods the cloud is ready for"; spec/os/signIn/readiness.md, "Story: Read the service's own terms"
import type { SignInCode } from "./definitions/sign-in.ts"

const CODE = /^[0-9]{6}$/

const Text = Schema.String.check(Schema.isMinLength(1))
const Count = Schema.Int.check(Schema.isGreaterThan(0))
const Instant = Schema.Int.check(Schema.isGreaterThan(0))
const Request = Count.pipe(Schema.brand("SignInRequest"))
const Attempt = Count.pipe(Schema.brand("SignInAttempt"))
const CredentialId = Text.pipe(Schema.brand("CredentialId"))
const Code = Schema.String.check(Schema.isPattern(CODE)).pipe(Schema.brand("SignInCode"))
const Factor = Schema.Literals(["totp", "sms"])

export const FailureWire = Schema.Literals([
  "cancelled",
  "busy",
  "invalid-input",
  "wrong-code",
  "expired",
  "too-many-attempts",
  "unavailable",
  "google-unavailable",
  "wrong-account",
  "rejected",
])
export const GoogleWire = Schema.Literals(["not-requested", "connected", "refused"])

export schema CodeOnItsWay { request: Request; attempt: Attempt; verdict: "code-on-its-way"; expiresAt: Instant; resendAt: Instant }
export schema FactorAsked { request: Request; attempt: Attempt; verdict: "factor-asked"; factors: Factor[]; expiresAt: Instant }
export schema SignedInAs { request: Request; attempt: Attempt; verdict: "signed-in-as"; credentialId: CredentialId; google: GoogleWire }
export schema AccountConfirmed { request: Request; attempt: Attempt; verdict: "account-confirmed" }
export schema TryAgain { request: Request; attempt: Attempt; verdict: "try-again"; retry: FailureWire }
export schema Ended { request: Request; attempt: Attempt; verdict: "ended"; problem: FailureWire }

export const Receipt = Schema.Union([CodeOnItsWay, FactorAsked, SignedInAs, AccountConfirmed, TryAgain, Ended])

export schema Rejected { code: FailureWire }
export schema FactorCodeSent { attempt: Attempt }
export schema Cancelled { cancelled: boolean }

export const Account = Schema.Union([
  Schema.Struct({ signedIn: Schema.Literal(false) }),
  Schema.Struct({ signedIn: Schema.Literal(true), userId: Text, organizationId: Text, credentialId: CredentialId, keyExpiresAt: Instant }),
])

export schema SignedOut { account: Account }

const ReadinessFields = {
  environment: Text.pipe(Schema.brand("EnvironmentName")),
  methodsKnown: Schema.Boolean,
  email: Schema.Boolean,
  sms: Schema.Boolean,
  google: Schema.Boolean,
  googleMode: Schema.Literals(["picker", "browser"]),
}

export const Readiness = Schema.Struct(ReadinessFields)
export const Status = Schema.Struct({ ...ReadinessFields, account: Account })

const Section = Schema.Struct({ title: Text, paragraphs: Schema.NonEmptyArray(Text) })
const LegalDocument = Schema.Struct({ title: Text, revision: Text, sections: Schema.NonEmptyArray(Section) })

export const Service = Schema.Union([
  Schema.Struct({ outcome: Schema.Literal("service_shown"), service: Schema.Struct({ name: Text, terms: LegalDocument, privacy: LegalDocument }) }),
  Schema.Struct({ outcome: Schema.Literals(["service_unavailable", "service_unknown_environment"]) }),
])

export function signInCode(typed: string): Option.Option<SignInCode> {
  return Schema.decodeUnknownOption(Code)(typed.replace(/[\s-]/g, ""))
}
