// spec/os/android/passwords/vault.md, "The page sees vault entries only as metadata, and only while it is unlocked"; spec/os/android/passwords/vault.md, "A vault page opens only when the bridge, a secure screen lock and the host's admission all allow it"; spec/os/android/passwords/vault.md, "Reset needs the owner's review and a fresh Android authentication after it, in the same visit"
const text = (max: number) => Schema.String.check(Schema.isMaxLength(max))
const orElse = <A>(fallback: A) => Schema.catchDecoding<Schema.Codec<A>>(() => succeed(Option.some(fallback)))
const lenient = <A>(shape: Schema.Codec<A>, fallback: A) => shape.pipe(orElse(fallback), Schema.withDecodingDefault(succeed(fallback)))
const dropped = () => succeed(Option.none())

const EntryId = text(128)
const Elapsed = lenient(Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0)), 0)
const Revision = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: Number.MAX_SAFE_INTEGER }))
const TransferCount = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 100000 }))

export schema PasswordsErrorCode = "locked" | "cancelled" | "no-screen-lock" | "invalid" | "key-invalidated" | "busy" | "conflict" | "not-admitted" | "unavailable"

const BindingText = text(512)

export schema PasswordBinding {
  kind: "web" | "android"
  facet: BindingText
  display: BindingText
}

export const PasswordEntrySummary = Schema.Struct({
  id: EntryId,
  label: text(200),
  username: text(1024),
  bindings: Schema.Array(PasswordBinding).check(Schema.isMaxLength(20)),
  updatedAt: Elapsed,
  revision: Elapsed,
})

const Autofill = Schema.Struct({
  supported: lenient<boolean | null>(Schema.NullOr(Schema.Boolean), null),
  selected: lenient(Schema.Literals(["this-app", "other", "none", "unknown"]), "unknown"),
})

export const PasswordsStatus = Schema.Struct({
  available: lenient(Schema.Boolean, false),
  reason: Schema.optionalKey(Schema.Literals(["no-screen-lock", "unsupported"]).pipe(Schema.catchDecoding(dropped))),
  locked: lenient(Schema.Boolean, true),
  unlockRemainingMs: Elapsed,
  unlockSeconds: Elapsed,
  biometric: lenient(Schema.Boolean, false),
  autofill: lenient(Autofill, { supported: null, selected: "unknown" }),
})

export schema PasswordEditorInput {
  entryId: string
  expectedRevision: Revision
}

export const PasswordEditorResult = Schema.Union([
  Schema.Struct({ status: Schema.Literal("saved"), id: EntryId, revision: Revision.check(Schema.isGreaterThan(0)) }),
  Schema.Struct({ status: Schema.Literal("cancelled") }),
])

export schema PasswordExportResult { exported: TransferCount }
export schema PasswordImportResult { imported: TransferCount; skipped: TransferCount }

export const Listed = Schema.Struct({ entries: Schema.Array(PasswordEntrySummary).check(Schema.isMaxLength(1000)) })
export const Unlocked = Schema.Struct({ unlocked: Schema.Literal(true), unlockRemainingMs: Elapsed })
export schema Locked { locked: true }
export schema Removed { removed: true }
export schema Reset { reset: true }
export const Revealed = Schema.Struct({ shown: Schema.Literal(true), hidesAfterMs: Elapsed })
export const Copied = Schema.Struct({ copied: Schema.Literal(true), clearsAfterMs: Elapsed })
export const SettingsOpened = Schema.Struct({
  status: Schema.Literal("opened"),
  destination: lenient(Schema.Literals(["autofill-picker", "system-settings"]), "system-settings"),
})

export const Saved = Schema.Union([
  Schema.Struct({ id: EntryId, generated: Schema.Literal(true), length: Elapsed }),
  Schema.Struct({ id: EntryId }),
])

export const Rejection = Schema.Struct({
  code: lenient(PasswordsErrorCode, "unavailable"),
  message: Schema.optionalKey(Schema.String.check(Schema.isPattern(/^[A-Za-z ,.'-]{1,80}$/)).pipe(Schema.catchDecoding(dropped))),
})
