// spec/os/android/passwords/vault.md, "The page sees vault entries only as metadata, and only while it is unlocked"; spec/os/android/passwords/vault.md, "A vault page opens only when the bridge, a secure screen lock and the host's admission all allow it"; spec/os/android/passwords/vault.md, "Reset needs the owner's review and a fresh Android authentication after it, in the same visit"
const text = (max: number) => Schema.String.check(Schema.isMaxLength(max))
const lenient = <S extends Schema.Constraint>(shape: S, fallback: S["Type"] & S["Encoded"]) =>
  Schema.withDecodingDefault<Schema.middlewareDecoding<S, S["DecodingServices"]>>(succeed(fallback))(Schema.catchDecoding<S>(() => succeed(Option.some(fallback)))(shape))
const dropped = () => succeed(Option.none())

const EntryId = text(128)
const Elapsed = lenient(Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0)), 0)
const Revision = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: Number.MAX_SAFE_INTEGER }))
const TransferCount = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 100000 }))

export schema PasswordsErrorCode = "locked" | "cancelled" | "no-screen-lock" | "invalid" | "key-invalidated" | "busy" | "conflict" | "not-admitted" | "unavailable"

const BindingText = text(512)

export schema PasswordBinding {
  kind: "web" | "android"
  facet: BindingText
  display: BindingText
}

export const PasswordEntrySummary = Schema.Struct({
  id: Schema.mutableKey(EntryId),
  label: Schema.mutableKey(text(200)),
  username: Schema.mutableKey(text(1024)),
  bindings: Schema.mutableKey(Schema.mutable(Schema.Array(PasswordBinding).check(Schema.isMaxLength(20)))),
  updatedAt: Schema.mutableKey(Elapsed),
  revision: Schema.mutableKey(Elapsed),
})

const Autofill = Schema.Struct({
  supported: Schema.mutableKey(lenient(Schema.NullOr(Schema.Boolean), null)),
  selected: Schema.mutableKey(lenient(Schema.Literals(["this-app", "other", "none", "unknown"]), "unknown")),
})

export const PasswordsStatus = Schema.Struct({
  available: Schema.mutableKey(lenient(Schema.Boolean, false)),
  reason: Schema.mutableKey(Schema.optionalKey(Schema.Literals(["no-screen-lock", "unsupported"]).pipe(Schema.catchDecoding(dropped)))),
  locked: Schema.mutableKey(lenient(Schema.Boolean, true)),
  unlockRemainingMs: Schema.mutableKey(Elapsed),
  unlockSeconds: Schema.mutableKey(Elapsed),
  biometric: Schema.mutableKey(lenient(Schema.Boolean, false)),
  autofill: Schema.mutableKey(lenient(Autofill, { supported: null, selected: "unknown" })),
})

export schema PasswordEditorInput {
  entryId: string
  expectedRevision: Revision
}

export const PasswordEditorResult = Schema.Union([
  Schema.Struct({ status: Schema.Literal("saved"), id: EntryId, revision: Revision.check(Schema.isGreaterThan(0)) }),
  Schema.Struct({ status: Schema.Literal("cancelled") }),
])

export schema PasswordExportResult { exported: TransferCount }
export schema PasswordImportResult { imported: TransferCount; skipped: TransferCount }

export const Listed = Schema.Struct({ entries: Schema.mutableKey(Schema.mutable(Schema.Array(PasswordEntrySummary).check(Schema.isMaxLength(1000)))) })
export const Unlocked = Schema.Struct({ unlocked: Schema.mutableKey(Schema.Literal(true)), unlockRemainingMs: Schema.mutableKey(Elapsed) })
export schema Locked { locked: true }
export schema Removed { removed: true }
export schema Reset { reset: true }
export const Revealed = Schema.Struct({ shown: Schema.mutableKey(Schema.Literal(true)), hidesAfterMs: Schema.mutableKey(Elapsed) })
export const Copied = Schema.Struct({ copied: Schema.mutableKey(Schema.Literal(true)), clearsAfterMs: Schema.mutableKey(Elapsed) })
export const SettingsOpened = Schema.Struct({
  status: Schema.mutableKey(Schema.Literal("opened")),
  destination: Schema.mutableKey(lenient(Schema.Literals(["autofill-picker", "system-settings"]), "system-settings")),
})

export const Saved = Schema.Union([
  Schema.Struct({ id: EntryId, generated: Schema.Literal(true), length: Elapsed }),
  Schema.Struct({ id: EntryId }),
])

export const Rejection = Schema.Struct({
  code: Schema.mutableKey(lenient(PasswordsErrorCode, "unavailable")),
  message: Schema.mutableKey(Schema.optionalKey(Schema.String.check(Schema.isPattern(/^[A-Za-z ,.'-]{1,80}$/)).pipe(Schema.catchDecoding(dropped)))),
})

export type PasswordEntrySummary = typeof PasswordEntrySummary.Type

export type PasswordsStatus = typeof PasswordsStatus.Type

export type Listed = typeof Listed.Type

export type Unlocked = typeof Unlocked.Type

export type Revealed = typeof Revealed.Type

export type Copied = typeof Copied.Type

export type SettingsOpened = typeof SettingsOpened.Type

export type Rejection = typeof Rejection.Type

export type PasswordEditorResult = typeof PasswordEditorResult.Type
