// spec/os/android/passwords/vault.md, "The page sees vault entries only as metadata, and only while it is unlocked"; spec/os/android/passwords/vault.md, "Opening a vault page in timed custody requires the bridge, a secure screen lock and the host's admission"; spec/os/android/passwords/vault.md, "A row action acts on the revision the owner selected"; spec/os/android/passwords/vault.md, "Resetting a vault in timed custody requires the owner's review followed by fresh Android authentication in the same visit"; spec/os/android/passwords/autofill.md, "A form is fillable only for one exact HTTPS origin or one other app"; spec/os/android/passwords/vault.md, "Device-unlocked custody requires a foreground window and the current owner, even on a device without a screen lock"
import type {
  ElizaPasswordTransferPlugin,
  ElizaPasswordsPlugin,
  PasswordBindingKind,
  PasswordEditorInput,
  PasswordEditorResult,
  PasswordEntrySummary,
  PasswordExportResult,
  PasswordImportResult,
  PasswordSaveInput,
  PasswordSaveResult,
  PasswordsErrorCode,
  PasswordsStatus,
} from "./definitions/passwords.ts"
import {
  Copied,
  Listed,
  Locked,
  PasswordEditorInput as EditorInput,
  PasswordEditorResult as EditorResult,
  PasswordExportResult as Exported,
  PasswordImportResult as Imported,
  PasswordsStatus as Status,
  Rejection,
  Removed,
  Reset,
  Revealed,
  Saved,
  SettingsOpened,
  Unlocked,
} from "./passwords.schema.vibe"

export type * from "./definitions/passwords.ts"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { ElizaPasswordTransferPlugin, ElizaPasswordsPlugin } from "./definitions/passwords.ts"

  /** @throws {never} */
  export function passwordsPlugin(name = "ElizaPasswords"): ElizaPasswordsPlugin {
    return registerPlugin<ElizaPasswordsPlugin>(name)
  }

  /** @throws {never} */
  export function passwordTransferPlugin(name = "ElizaPasswordTransfer"): ElizaPasswordTransferPlugin {
    return registerPlugin<ElizaPasswordTransferPlugin>(name)
  }
}
import { passwordTransferPlugin, passwordsPlugin } from capacitor
export { passwordTransferPlugin, passwordsPlugin }

module boundary {
  import { Option, Schema } from "effect"
  import type { PasswordEntrySummary, PasswordsStatus } from "./definitions/passwords.ts"
  import { Listed, PasswordsStatus as Status } from "./passwords.schema.vibe"
  import { entriesOf, invalid, secretFieldIn, statusOf, unavailable } from "./passwords.vibe"

  const WEBSITE = "Enter a website address."
  const BARE_HOST_WITH_PORT = /^([a-z0-9-]+(\.[a-z0-9-]+)+\.?|localhost):\d{1,5}([/?#]|$)/i
  const SCHEME = /^[a-z][a-z0-9+.-]*:/i
  const HOST = /^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$/
  const MAX_ADDRESS = 512
  const MAX_HOST = 253

  /** @throws {PasswordsClientError} */
  export function assertNoSecretFields(value: unknown): void {
    if (secretFieldIn(value)) throw unavailable()
  }

  /** @throws {PasswordsClientError} */
  export function parseEntries(value: unknown): PasswordEntrySummary[] {
    assertNoSecretFields(value)
    const listed = Schema.decodeUnknownOption(Listed)(value)
    if (Option.isNone(listed)) throw unavailable()
    return entriesOf(listed.value)
  }

  /** @throws {PasswordsClientError} */
  export function parseStatus(value: unknown): PasswordsStatus {
    assertNoSecretFields(value)
    const status = Schema.decodeUnknownOption(Status)(value)
    if (Option.isNone(status)) throw unavailable()
    return statusOf(status.value)
  }

  /** @throws {PasswordsClientError} */
  function address(text: string): URL {
    const withScheme = !BARE_HOST_WITH_PORT.test(text) && SCHEME.test(text) ? text : `https://${text}`
    try {
      return new URL(withScheme)
    } catch {
      throw invalid(WEBSITE)
    }
  }

  /** @throws {PasswordsClientError} */
  export function normalizeWebsite(input: string): string {
    const text = typeof input === "string" ? input.trim() : ""
    if (!text || text.length > MAX_ADDRESS) throw invalid(WEBSITE)
    const url = address(text)
    if (url.protocol !== "https:") throw invalid("Use an HTTPS website address.")
    if (url.username || url.password) throw invalid("Remove the user name from the address.")
    const host = url.hostname.replace(/\.$/, "").toLowerCase()
    if (!HOST.test(host) || host.length > MAX_HOST) throw invalid(WEBSITE)
    return `https://${host}${url.port ? `:${url.port}` : ""}`
  }
}
import { assertNoSecretFields, normalizeWebsite, parseEntries, parseStatus } from boundary
export { assertNoSecretFields, normalizeWebsite, parseEntries, parseStatus }

export error PasswordsClientError { code: PasswordsErrorCode; message: string }

export const SECRET_FIELD_NAMES: readonly string[] = [
  "password",
  "passwd",
  "secret",
  "totp",
  "otp",
  "otpsecret",
  "passkey",
  "privatekey",
  "credential",
  "credentials",
]

const SECRET_DEPTH = 12
const ANDROID_FACET = /^android:\/\/[a-f0-9]{64}@[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$/
const WEB_FACET = /^https:\/\/[a-z0-9.-]+(:\d{1,5})?$/
const exact = { onExcessProperty: "error" } as const

const MESSAGES: Record<PasswordsErrorCode, string> = {
  locked: "Unlock saved passwords first.",
  cancelled: "Unlock was cancelled.",
  "no-screen-lock": "Set a screen lock to use saved passwords.",
  invalid: "Check the entry and try again.",
  "key-invalidated": "Saved passwords can no longer be decrypted on this device.",
  busy: "Finish the current unlock first.",
  conflict: "This password changed. Reload it and try again.",
  "not-admitted": "Saved passwords are not available here.",
  unavailable: "Saved passwords are unavailable.",
}

export function unavailable(message = MESSAGES.unavailable): PasswordsClientError {
  return new PasswordsClientError({ code: "unavailable", message })
}

export function invalid(message: string): PasswordsClientError {
  return new PasswordsClientError({ code: "invalid", message })
}

export function secretFieldIn(value: unknown, depth = 0): boolean {
  if (depth > SECRET_DEPTH) return true
  if (Array.isArray(value)) return value.some((item) => secretFieldIn(item, depth + 1))
  if (typeof value !== "object" || value === null) return false
  return Object.entries(value).some(
    ([key, item]) => SECRET_FIELD_NAMES.includes(key.toLowerCase().replace(/[^a-z]/g, "")) || secretFieldIn(item, depth + 1),
  )
}

export function entriesOf(listed: typeof Listed.Type): PasswordEntrySummary[] {
  return listed.entries.map((entry) => ({ ...entry, bindings: [...entry.bindings] }))
}

export function statusOf(status: typeof Status.Type): PasswordsStatus {
  const { supported, selected } = status.autofill
  return {
    ...status,
    unlockRemainingMs: status.custody === "device-unlocked" ? status.unlockRemainingMs : status.unlockRemainingMs ?? 0,
    autofill: { supported: supported ?? null, selected: selected ?? "unknown" },
  }
}

export function listReplyOf(value: unknown) {
  return secretFieldIn(value) ? "CarriesSecretField" : "MetadataOnly"
}

export function passwordsError(error: unknown): PasswordsClientError {
  if (error instanceof PasswordsClientError) return error
  const rejection = Option.getOrUndefined(Schema.decodeUnknownOption(Rejection)(error))
  if (rejection === undefined) return unavailable()
  const { code, message } = rejection
  return new PasswordsClientError({ code, message: code === "invalid" && message !== undefined ? message : MESSAGES[code] })
}

export function bindingKind(facet: string): PasswordBindingKind | null {
  if (typeof facet !== "string") return null
  if (ANDROID_FACET.test(facet)) return "android"
  return WEB_FACET.test(facet) ? "web" : null
}

export function filterEntries(entries: readonly PasswordEntrySummary[], query: string): PasswordEntrySummary[] {
  const needle = (query || "").trim().toLowerCase()
  const sorted = [...entries].sort((a, b) => a.label.localeCompare(b.label) || a.username.localeCompare(b.username))
  if (!needle) return sorted
  return sorted.filter((entry) =>
    [entry.label, entry.username, ...entry.bindings.flatMap((binding) => [binding.display, binding.facet])].some((value) =>
      value.toLowerCase().includes(needle),
    ),
  )
}

effect function reply<A>(shape: Schema.Decoder<A>, run: () => Promise<unknown>, malformed = MESSAGES.unavailable, options = {}) {
  const raw = try tryPromise({ try: () => run(), catch: passwordsError })
  if (secretFieldIn(raw)) throw unavailable()
  return try mapError(Schema.decodeUnknownEffect(shape)(raw, options), () => unavailable(malformed))
}

effect function rowOf(id: string, expectedRevision: number | undefined) {
  if (expectedRevision === undefined) return { id }
  if (!Number.isSafeInteger(expectedRevision) || expectedRevision < 0) throw invalid("Choose a saved password.")
  return { id, expectedRevision }
}

export interface PasswordsClient {
  status(): Promise<PasswordsStatus>
  unlock(): Promise<{ unlockRemainingMs: PasswordsStatus["unlockRemainingMs"] }>
  lock(): Promise<void>
  list(): Promise<PasswordEntrySummary[]>
  save(input: PasswordSaveInput): Promise<PasswordSaveResult>
  openEditor(input?: PasswordEditorInput): Promise<PasswordEditorResult>
  remove(id: string, expectedRevision?: number): Promise<void>
  reset(): Promise<void>
  reveal(id: string, expectedRevision?: number): Promise<{ hidesAfterMs: number }>
  copy(id: string, expectedRevision?: number): Promise<{ clearsAfterMs: number }>
  openAutofillSettings(): Promise<{ destination: "autofill-picker" | "system-settings" }>
}

export interface PasswordTransferClient {
  exportVault(): Promise<PasswordExportResult>
  importVault(): Promise<PasswordImportResult>
}

export function createPasswordsClient(plugin: ElizaPasswordsPlugin = passwordsPlugin()): PasswordsClient {
  return {
    status: () =>
      runPromise(effect {
        return statusOf(try reply(Status, () => plugin.status()))
      }),
    unlock: () =>
      runPromise(effect {
        const { unlockRemainingMs } = try reply(Unlocked, () => plugin.unlock())
        return { unlockRemainingMs }
      }),
    lock: () =>
      runPromise(effect {
        try reply(Locked, () => plugin.lock())
      }),
    list: () =>
      runPromise(effect {
        return entriesOf(try reply(Listed, () => plugin.list()))
      }),
    save: (input) =>
      runPromise(effect {
        if (input.password !== undefined && input.generate !== undefined) throw invalid("Choose a typed or generated password.")
        return try reply(Saved, () => plugin.save(input))
      }),
    openEditor: (input) =>
      runPromise(effect {
        if (input === undefined) return try reply(EditorResult, () => plugin.openEditor())
        const asked = try mapError(Schema.decodeUnknownEffect(EditorInput)(input), () => invalid("Choose a saved password."))
        return try reply(EditorResult, () => plugin.openEditor(asked))
      }),
    remove: (id, expectedRevision) =>
      runPromise(effect {
        const row = try rowOf(id, expectedRevision)
        try reply(Removed, () => plugin.remove(row))
      }),
    reset: () =>
      runPromise(effect {
        try reply(Reset, () => plugin.reset())
      }),
    reveal: (id, expectedRevision) =>
      runPromise(effect {
        const row = try rowOf(id, expectedRevision)
        const { hidesAfterMs } = try reply(Revealed, () => plugin.reveal(row))
        return { hidesAfterMs }
      }),
    copy: (id, expectedRevision) =>
      runPromise(effect {
        const row = try rowOf(id, expectedRevision)
        const { clearsAfterMs } = try reply(Copied, () => plugin.copy(row))
        return { clearsAfterMs }
      }),
    openAutofillSettings: () =>
      runPromise(effect {
        const { destination } = try reply(SettingsOpened, () => plugin.openAutofillSettings(), "Android settings did not open.")
        return { destination }
      }),
  }
}

export function createTransferClient(plugin: ElizaPasswordTransferPlugin = passwordTransferPlugin()): PasswordTransferClient {
  return {
    exportVault: () => runPromise(reply(Exported, () => plugin.exportVault(), MESSAGES.unavailable, exact)),
    importVault: () => runPromise(reply(Imported, () => plugin.importVault(), MESSAGES.unavailable, exact)),
  }
}
