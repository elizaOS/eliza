// spec/os/android/networkPolicy.md, "A metered hint is Android's own flag for the active network, and anything Android did not answer is unknown"
import type { HostFacts, PluginPresence } from "../../gen/os__android__bridge.ts"
import { meteredHint, type CostRead } from "../../gen/os__android__networkPolicy.effect.vibe"
import { nativeReply } from "./bridge.vibe"
import type { MeteredHint, NetworkPolicyPlugin } from "./definitions/network-policy.ts"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { NetworkPolicyPlugin } from "./definitions/network-policy.ts"

  /** @throws {never} */
  export function networkPolicyPlugin(name = "ElizaNetworkPolicy"): NetworkPolicyPlugin {
    return registerPlugin<NetworkPolicyPlugin>(name)
  }
}
import { networkPolicyPlugin } from capacitor
export { networkPolicyPlugin }

const ANSWERED: HostFacts = { foreground: true, unlocked: true, focused: true, granted: true, featurePresent: true }

const NOT_REGISTERED = new Set(["UNIMPLEMENTED", "DISABLED"])

schema Metered { metered: boolean | null; source: "android-os" }

effect function hint(name: string, plugin: NetworkPolicyPlugin) {
  const read = try result(nativeReply(name, "getMeteredHint", Metered, () => plugin.getMeteredHint()))
  const code = Result.isSuccess(read) ? undefined : match (read.failure) {
    when { _tag: "BridgeUnavailable" }: "UNIMPLEMENTED";
    when { _tag: "NativeRejection", let code }: code;
    default: undefined;
  }
  const presence: PluginPresence = code !== undefined && NOT_REGISTERED.has(code) ? "PluginNotRegistered" : "PluginRegistered"
  const metered = Result.isSuccess(read) ? read.success.metered : null
  const androidCost: CostRead = { answered: Result.isSuccess(read), activeNetwork: metered !== null, capabilitiesRead: metered !== null, notMetered: metered === false }
  const cost = meteredHint(presence, ANSWERED, androidCost)
  const answer: MeteredHint = { metered: cost === "LinkMetered" ? true : cost === "LinkUnmetered" ? false : null, source: "android-os" }
  return answer
}

export function networkPolicyClient(plugin: NetworkPolicyPlugin = networkPolicyPlugin(), name = "ElizaNetworkPolicy"): NetworkPolicyPlugin {
  return {
    getMeteredHint: () => runPromise(hint(name, plugin)),
  }
}
