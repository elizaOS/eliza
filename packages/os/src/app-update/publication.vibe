// spec/os/appUpdate/admission.md, "Story: Publish an app update only with authorized versions"; spec/os/appUpdate/admission.md, "Publisher role floors only ratchet"; spec/os/appUpdate/admission.md, "A publication is authorized only when one approved graph at the floors binds the plan and every descriptor is approved and preflighted"
import { ChildProcess } from "effect/process"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import {
  advancePublisherFloors,
  authorizePublication,
  completeVersions,
  planWellFormed,
  type Channel,
  type ChannelRoles,
  type Distribution,
  type PublicationGraph,
  type PublicationPlan,
  type PublicationProblem,
  type RoleKeys,
  type RoleVersions,
  type SignedDescriptor,
  type SourceEvidence,
  type TargetPath,
} from "../../gen/os__appUpdate__admission.effect.vibe"
import type { Digest } from "../../gen/os__image__apk.effect.vibe"
import { parseDigest } from "../image/apk.vibe"

module node {
  import { createHash } from "node:crypto"
  import { closeSync, fsyncSync, lstatSync, openSync } from "node:fs"
  import { dirname, resolve } from "node:path"
  import { DatabaseSync } from "node:sqlite"
  import { isDeepStrictEqual } from "node:util"

  export type FloorRows = readonly (readonly [string, number])[]
  export type Stored<T> = { readonly kind: "stored"; readonly value: T } | { readonly kind: "unreadable"; readonly reason: string }
  export type StrictJson = { readonly kind: "json"; readonly value: unknown } | { readonly kind: "invalid"; readonly offset: number; readonly reason: string }

  const MAX_DESCRIPTOR_BYTES = 1024 * 1024
  const MAX_STRING = 4096
  const MAX_KEYS = 256
  const MAX_ITEMS = 4096
  const MAX_DEPTH = 32
  const NUMBER = /^-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/

  class Invalid extends Error {
    readonly offset: number
    constructor(offset: number) {
      super(`invalid descriptor JSON at offset ${offset}`)
      this.offset = offset
    }
  }

  /** @throws {never} */
  export function sha256Hex(bytes: Uint8Array): string {
    return createHash("sha256").update(bytes).digest("hex")
  }

  /** @throws {never} */
  export function base64(bytes: Uint8Array): string {
    return Buffer.from(bytes).toString("base64")
  }

  /** @throws {never} */
  export function sameJson(one: unknown, other: unknown): boolean {
    return isDeepStrictEqual(one, other)
  }

  /** @throws {never} */
  export function parseJson(bytes: Uint8Array): unknown {
    try {
      return JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes))
    } catch {
      return undefined
    }
  }

  function strict(text: string): unknown {
    let i = 0
    const fail = (): never => {
      throw new Invalid(i)
    }
    const whitespace = () => {
      while (text[i] === " " || text[i] === "\t" || text[i] === "\r" || text[i] === "\n") i++
    }
    const string = (): string => {
      const start = i
      if (text[i++] !== '"') fail()
      while (i < text.length) {
        const c = text[i++]
        if (c === '"') {
          const result: unknown = JSON.parse(text.slice(start, i))
          if (typeof result !== "string" || result.length > MAX_STRING || !result.isWellFormed()) fail()
          return result as string
        }
        if (c === "\\") i++
      }
      return fail()
    }
    const value = (depth: number): unknown => {
      if (depth > MAX_DEPTH) fail()
      whitespace()
      const c = text[i]
      if (c === '"') return string()
      if (c === "{") {
        i++
        const result: Record<string, unknown> = {}
        const seen = new Set<string>()
        whitespace()
        if (text[i] === "}") {
          i++
          return result
        }
        while (true) {
          whitespace()
          const key = string()
          if (seen.has(key) || seen.size >= MAX_KEYS) fail()
          seen.add(key)
          whitespace()
          if (text[i++] !== ":") fail()
          Object.defineProperty(result, key, { value: value(depth + 1), enumerable: true, writable: true, configurable: true })
          whitespace()
          const end = text[i++]
          if (end === "}") return result
          if (end !== ",") fail()
        }
      }
      if (c === "[") {
        i++
        const result: unknown[] = []
        whitespace()
        if (text[i] === "]") {
          i++
          return result
        }
        while (true) {
          if (result.length >= MAX_ITEMS) fail()
          result.push(value(depth + 1))
          whitespace()
          const end = text[i++]
          if (end === "]") return result
          if (end !== ",") fail()
        }
      }
      for (const [literal, result] of [["true", true], ["false", false], ["null", null]] as const) {
        if (text.startsWith(literal, i)) {
          i += literal.length
          return result
        }
      }
      const number = NUMBER.exec(text.slice(i))
      if (number === null) return fail()
      i += number[0].length
      const n = Number(number[0])
      if (!Number.isSafeInteger(n) || /[.eE]/.test(number[0]) || Object.is(n, -0)) fail()
      return n
    }
    const result = value(0)
    whitespace()
    if (i !== text.length) fail()
    return result
  }

  /** @throws {never} */
  export function parseStrictJson(bytes: Uint8Array): StrictJson {
    if (bytes.byteLength > MAX_DESCRIPTOR_BYTES) return { kind: "invalid", offset: 0, reason: `the descriptor exceeds ${MAX_DESCRIPTOR_BYTES} bytes` }
    let text: string
    try {
      text = new TextDecoder("utf-8", { fatal: true }).decode(bytes)
    } catch {
      return { kind: "invalid", offset: 0, reason: "the descriptor is not UTF-8" }
    }
    try {
      return { kind: "json", value: strict(text) }
    } catch (cause) {
      return cause instanceof Invalid ? { kind: "invalid", offset: cause.offset, reason: cause.message } : { kind: "invalid", offset: 0, reason: String(cause) }
    }
  }

  function message(cause: unknown): string {
    return cause instanceof Error ? cause.message : String(cause)
  }

  function open(file: string): DatabaseSync {
    const stat = lstatSync(file)
    if (!stat.isFile() || stat.isSymbolicLink()) throw new Error("the publisher policy is not a regular file")
    const db = new DatabaseSync(file)
    db.exec("PRAGMA busy_timeout=10000; PRAGMA journal_mode=DELETE; PRAGMA synchronous=FULL; PRAGMA fullfsync=ON")
    return db
  }

  function rows(db: DatabaseSync): FloorRows {
    const schema = db.prepare("PRAGMA user_version").get()
    if (schema?.user_version !== 1) throw new Error("the publisher policy has an unsupported schema")
    return db.prepare("SELECT role, version FROM floors").all().map((row) => [String(row.role), Number(row.version)] as const)
  }

  /** @throws {never} */
  export function createFloors(file: string, floors: FloorRows): Stored<undefined> {
    try {
      closeSync(openSync(file, "wx", 0o600))
      const db = open(file)
      try {
        db.exec("BEGIN IMMEDIATE; CREATE TABLE floors (role TEXT PRIMARY KEY, version INTEGER NOT NULL CHECK(version > 0)); PRAGMA user_version=1")
        const insert = db.prepare("INSERT INTO floors VALUES (?, ?)")
        for (const [role, version] of floors) insert.run(role, version)
        db.exec("COMMIT")
      } finally {
        db.close()
      }
      const directory = openSync(dirname(resolve(file)), "r")
      try {
        fsyncSync(directory)
      } finally {
        closeSync(directory)
      }
      return { kind: "stored", value: undefined }
    } catch (cause) {
      return { kind: "unreadable", reason: message(cause) }
    }
  }

  /** @throws {never} */
  export function readFloors(file: string): Stored<FloorRows> {
    try {
      const db = open(file)
      try {
        db.exec("BEGIN")
        const value = rows(db)
        db.exec("COMMIT")
        return { kind: "stored", value }
      } finally {
        db.close()
      }
    } catch (cause) {
      return { kind: "unreadable", reason: message(cause) }
    }
  }

  /** @throws {never} */
  export function updateFloors<T>(file: string, decide: (before: FloorRows) => { readonly write: FloorRows | undefined; readonly result: T }): Stored<T> {
    let db: DatabaseSync | undefined
    try {
      db = open(file)
      db.exec("BEGIN IMMEDIATE")
      const decision = decide(rows(db))
      const update = db.prepare("UPDATE floors SET version = ? WHERE role = ?")
      for (const [role, version] of decision.write ?? []) update.run(version, role)
      db.exec(decision.write === undefined ? "ROLLBACK" : "COMMIT")
      return { kind: "stored", value: decision.result }
    } catch (cause) {
      try {
        db?.exec("ROLLBACK")
      } catch {}
      return { kind: "unreadable", reason: message(cause) }
    } finally {
      db?.close()
    }
  }
}
import { base64, createFloors, parseJson, parseStrictJson, readFloors, sameJson, sha256Hex, updateFloors, type FloorRows } from node

export interface PublisherPolicy {
  readonly trustedUpperMs: number
  readonly minimumVersions: RoleVersions
}

export interface PublicationFile {
  readonly name: string
  readonly bytes: Uint8Array
}

export interface PublicationBundle {
  readonly timestamp: Uint8Array
  readonly dependencies: readonly PublicationFile[]
}

export interface GraphReport {
  readonly timestampSha256: string
  readonly versions: RoleVersions
  readonly descriptors: Readonly<Record<string, unknown>>
}

export interface GraphInput {
  readonly root: Uint8Array
  readonly bundle: PublicationBundle
  readonly policy: PublisherPolicy
}

export interface GraphVerifier extends GraphInput {
  readonly executable: string
  readonly timeout: Duration.Duration
}

export interface DescriptorSubject {
  readonly path: string
  readonly descriptor: unknown
  readonly descriptorSha256: string
}

export interface PublicationPorts<E, R> {
  readonly readPolicy: () => PublisherPolicy!E!R
  readonly verifyGraph: (input: GraphInput) => GraphReport!E!R
  readonly approveSource: (subject: DescriptorSubject) => boolean!E!R
  readonly preflight: (subject: DescriptorSubject) => unknown!E!R
  readonly advancePolicy: (versions: RoleVersions) => RoleVersions!E!R
}

export interface AuthorizedPublication {
  readonly timestampSha256: string
  readonly versions: RoleVersions
  readonly descriptors: readonly string[]
}

export error DescriptorInvalid { offset: number; reason: string }
export error PublisherPolicyRefused { file: string; reason: string }
export error PublisherPolicyUnreadable { file: string; reason: string }
export error FloorsRefused { file: string; floors: RoleVersions; versions: RoleVersions }
export error GraphUnverified { reason: string }
export error PublicationRefused { why: PublicationProblem }

type RawRecord = Readonly<Record<string, unknown>>
type Advanced = { readonly kind: "advanced"; readonly floors: RoleVersions } | { readonly kind: "refused"; readonly floors: RoleVersions } | { readonly kind: "corrupt" }

interface PlannedDescriptor {
  readonly path: string
  readonly signed: SignedDescriptor
  readonly value: unknown
}

const ROLES = ["root", "timestamp", "snapshot", "targets", "stable", "beta"] as const
const NO_VERSIONS: RoleVersions = { root: 0, timestamp: 0, snapshot: 0, targets: 0, stable: 0, beta: 0 }
const NO_ROLE: RoleKeys = { threshold: 0, members: [] }
const NOT_A_DIGEST: Digest = { tag: "NotADigest" }
const DESCRIPTOR_FILE = /^targets\/(stable|beta)\/([a-f0-9]{64})\.(launcher|standalone)\.json$/
const TARGET = /^(stable|beta)\/(launcher|standalone)\.json$/
const INCOMPLETE_FLOORS = "the publisher policy does not hold six complete role floors"

function isRecord(value: unknown): value is RawRecord {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

function field(value: unknown, ...keys: readonly string[]): unknown {
  let at = value
  for (const key of keys) at = isRecord(at) ? at[key] : undefined
  return at
}

function channelOf(name: unknown): Channel | undefined {
  return name === "stable" ? "Stable" : name === "beta" ? "Beta" : undefined
}

function distributionOf(name: unknown): Distribution | undefined {
  return name === "launcher" ? "Launcher" : name === "standalone" ? "Standalone" : undefined
}

function targetOf(path: string): TargetPath | undefined {
  const match = TARGET.exec(path)
  const channel = channelOf(match?.[1])
  const distribution = distributionOf(match?.[2])
  return channel === undefined || distribution === undefined ? undefined : { channel, distribution }
}

function hexOf(digest: Digest): string {
  return digest.tag === "Sha256" ? digest.hex : ""
}

function parseRoleVersions(value: unknown): RoleVersions | undefined {
  if (!isRecord(value) || Object.keys(value).length !== ROLES.length) return undefined
  const versions = { ...NO_VERSIONS }
  for (const role of ROLES) {
    const version = value[role]
    if (typeof version !== "number" || !Number.isSafeInteger(version)) return undefined
    versions[role] = version
  }
  return completeVersions(versions) ? versions : undefined
}

function versionsOf(rows: FloorRows): RoleVersions | undefined {
  return rows.length === ROLES.length ? parseRoleVersions(Object.fromEntries(rows)) : undefined
}

function rowsOf(versions: RoleVersions): FloorRows {
  return ROLES.map((role) => [role, versions[role]] as const)
}

function copyBundle(bundle: PublicationBundle): PublicationBundle {
  return { timestamp: bundle.timestamp.slice(), dependencies: bundle.dependencies.map(({ name, bytes }) => ({ name, bytes: bytes.slice() })) }
}

export effect function parseDescriptorJson(bytes: Uint8Array) {
  const parsed = parseStrictJson(bytes)
  if (parsed.kind === "invalid") throw new DescriptorInvalid({ offset: parsed.offset, reason: parsed.reason })
  return parsed.value
}

effect function requireVersions(file: string, versions: RoleVersions) {
  const parsed = parseRoleVersions(versions)
  if (parsed === undefined) throw new PublisherPolicyRefused({ file, reason: "complete safe role versions are required" })
  return parsed
}

export effect function initializePublisherPolicy(file: string, versions: RoleVersions) {
  const floors = try requireVersions(file, versions)
  const created = createFloors(file, rowsOf(floors))
  if (created.kind === "unreadable") throw new PublisherPolicyRefused({ file, reason: created.reason })
  return floors
}

export effect function readPublisherPolicy(file: string, trustedUpperMs: number) {
  if (!Number.isSafeInteger(trustedUpperMs) || trustedUpperMs <= 0) throw new PublisherPolicyRefused({ file, reason: "qualified publisher time is required" })
  const stored = readFloors(file)
  if (stored.kind === "unreadable") throw new PublisherPolicyUnreadable({ file, reason: stored.reason })
  const minimumVersions = versionsOf(stored.value)
  if (minimumVersions === undefined) throw new PublisherPolicyUnreadable({ file, reason: INCOMPLETE_FLOORS })
  const policy: PublisherPolicy = { trustedUpperMs, minimumVersions }
  return policy
}

export effect function advancePublisherPolicy(file: string, versions: RoleVersions) {
  const verified = try requireVersions(file, versions)
  const stored = updateFloors(file, (before): { readonly write: FloorRows | undefined; readonly result: Advanced } => {
    const floors = versionsOf(before)
    if (floors === undefined) return { write: undefined, result: { kind: "corrupt" } }
    const advance = advancePublisherFloors(floors, verified)
    return advance.tag === "FloorsAdvanced" ? { write: rowsOf(advance.floors), result: { kind: "advanced", floors: advance.floors } } : { write: undefined, result: { kind: "refused", floors } }
  })
  if (stored.kind === "unreadable") throw new PublisherPolicyUnreadable({ file, reason: stored.reason })
  const result = stored.value
  switch (result.kind) {
    case "advanced":
      return result.floors
    case "refused":
      throw new FloorsRefused({ file, floors: result.floors, versions: verified })
    case "corrupt":
      throw new PublisherPolicyUnreadable({ file, reason: INCOMPLETE_FLOORS })
    default: {
      const _exhaustive: never = result
      return _exhaustive
    }
  }
}

effect function parseGraphReport(output: string) {
  const report = parseJson(new TextEncoder().encode(output))
  if (!isRecord(report) || report.graphVerified !== true || typeof report.timestampSha256 !== "string" || !isRecord(report.descriptors)) {
    throw new GraphUnverified({ reason: "the verifier report does not verify a graph" })
  }
  const parsed: GraphReport = { timestampSha256: report.timestampSha256, versions: parseRoleVersions(report.versions) ?? NO_VERSIONS, descriptors: report.descriptors }
  return parsed
}

export effect function verifyPublicationGraph(verifier: GraphVerifier) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const spawner = try ChildProcessSpawner
  if (!path.isAbsolute(verifier.executable)) throw new GraphUnverified({ reason: "the verifier executable must be an absolute path" })
  if (!Duration.isPositive(verifier.timeout)) throw new GraphUnverified({ reason: "a positive verifier deadline is required" })
  const bundled: Record<string, string> = { "timestamp.json": base64(verifier.bundle.timestamp) }
  for (const { name, bytes } of verifier.bundle.dependencies) {
    if (Object.hasOwn(bundled, name)) throw new GraphUnverified({ reason: `the publication names ${name} twice` })
    bundled[name] = base64(bytes)
  }
  const encoder = new TextEncoder()
  const run = scoped(effect {
    const directory = try files.makeTempDirectoryScoped({ prefix: "ota-publication-graph-" })
    try files.chmod(directory, 0o700)
    const write = effect function (name: string, data: Uint8Array) {
      const file = path.join(directory, name)
      try files.writeFile(file, data, { flag: "wx", mode: 0o400 })
      return file
    }
    const args = [
      "-root", try write("root.json", verifier.root),
      "-bundle", try write("bundle.json", encoder.encode(JSON.stringify({ files: bundled }))),
      "-policy", try write("policy.json", encoder.encode(JSON.stringify(verifier.policy))),
    ]
    const child = try spawner.spawn(ChildProcess.make(verifier.executable, args, { stdin: "ignore" }))
    const [stdout, stderr] = try.all [Stream.mkString(Stream.decodeText(child.stdout)), Stream.mkString(Stream.decodeText(child.stderr))]
    const code: number = try child.exitCode
    return { code, stdout, stderr }
  })
  const result = try mapError(timeout(run, verifier.timeout), (cause) => new GraphUnverified({ reason: `the verifier did not finish: ${String(cause)}` }))
  if (result.code !== 0) throw new GraphUnverified({ reason: `the verifier refused the graph (${result.code}): ${(result.stderr || result.stdout).trim()}` })
  return try parseGraphReport(result.stdout)
}

function graphOf(report: GraphReport, bundle: PublicationBundle, root: Uint8Array, planned: readonly PlannedDescriptor[], identities: Map<string, number>) {
  const named = (name: string): unknown => {
    const file = bundle.dependencies.find((dependency) => dependency.name === name)
    return file === undefined ? undefined : parseJson(file.bytes)
  }
  const identity = (key: unknown, id: string): number => {
    const material = field(key, "keyval", "public")
    const name = typeof material === "string" ? `key:${material}` : `missing:${id}`
    const known = identities.get(name)
    if (known !== undefined) return known
    identities.set(name, identities.size + 1)
    return identities.size
  }
  const versions = report.versions
  const delegations = field(named(`${versions.targets}.targets.json`), "signed", "delegations")
  const delegatedKey = (id: unknown) => identity(field(delegations, "keys", String(id)), String(id))
  const roleKeys = (name: string): RoleKeys => {
    const roles = field(delegations, "roles")
    const role = Array.isArray(roles) ? roles.find((entry) => field(entry, "name") === name) : undefined
    const keyIds = field(role, "keyids")
    const threshold = field(role, "threshold")
    return Array.isArray(keyIds) && typeof threshold === "number" ? { threshold, members: keyIds.map(delegatedKey) } : NO_ROLE
  }
  const approvers = (name: string, version: number): number[] => {
    const signatures = field(named(`${version}.${name}.json`), "signatures")
    return Array.isArray(signatures) ? signatures.map((signature) => delegatedKey(field(signature, "keyid"))) : []
  }
  const provisioned = parseJson(root)
  const rootDocument = named(`${versions.root}.root.json`) ?? (field(provisioned, "signed", "version") === versions.root ? provisioned : undefined)
  const rootKeys = field(rootDocument, "signed", "keys")
  const roles: ChannelRoles = { stableKeys: roleKeys("stable"), betaKeys: roleKeys("beta") }
  const graph: PublicationGraph = {
    timestamp: parseDigest(report.timestampSha256),
    versions,
    roles,
    stableApprovers: approvers("stable", versions.stable),
    betaApprovers: approvers("beta", versions.beta),
    descriptors: Object.entries(report.descriptors).flatMap(([path, value]) => {
      const target = targetOf(path)
      const plannedAt = planned.find((entry) => entry.path === path)
      return target === undefined ? [] : [{ path: target, sha256: plannedAt !== undefined && sameJson(plannedAt.value, value) ? plannedAt.signed.sha256 : NOT_A_DIGEST }]
    }),
  }
  return { graph, rootKeys: Object.entries(isRecord(rootKeys) ? rootKeys : {}).map(([id, key]) => identity(key, `root:${id}`)) }
}

function preflightedOf(report: unknown): SignedDescriptor[] {
  const channel = channelOf(field(report, "channel"))
  const distribution = distributionOf(field(report, "distribution"))
  const descriptorSha256 = field(report, "descriptorSha256")
  return channel === undefined || distribution === undefined || typeof descriptorSha256 !== "string" ? [] : [{ path: { channel, distribution }, sha256: parseDigest(descriptorSha256) }]
}

export function createPublicationAuthorizer<E, R>(ports: PublicationPorts<E, R>, root: Uint8Array) {
  const trustedRoot = root.slice()
  return effect function authorizeBundle(input: PublicationBundle) {
    const bundle = copyBundle(input)
    const timestampSha256 = sha256Hex(bundle.timestamp)
    const planned: PlannedDescriptor[] = []
    for (const { name, bytes } of bundle.dependencies) {
      const match = DESCRIPTOR_FILE.exec(name)
      const target = targetOf(`${match?.[1]}/${match?.[3]}.json`)
      if (match === null || target === undefined) continue
      try parseDescriptorJson(bytes)
      planned.push({ path: `${match[1]}/${match[3]}.json`, value: parseJson(bytes), signed: { path: target, sha256: sha256Hex(bytes) === match[2] ? parseDigest(match[2]) : NOT_A_DIGEST } })
    }
    planned.sort((one, other) => one.path.localeCompare(other.path))
    const plan: PublicationPlan = { planTimestamp: parseDigest(timestampSha256), planDescriptors: planned.map((entry) => entry.signed) }
    if (!planWellFormed(plan)) throw new PublicationRefused({ why: "PlanMalformed" })
    const identities = new Map<string, number>()
    const verify = effect function () {
      const policy = try ports.readPolicy()
      const report = try ports.verifyGraph({ root: trustedRoot.slice(), bundle: copyBundle(bundle), policy: structuredClone(policy) })
      return { floors: policy.minimumVersions, ...graphOf(report, bundle, trustedRoot, planned, identities) }
    }
    const first = try verify()
    const assumed: SourceEvidence = { approved: plan.planDescriptors.map((entry) => entry.sha256), preflighted: plan.planDescriptors }
    const bound = authorizePublication(plan, first.rootKeys, first.floors, first.graph, assumed, first.floors, first.graph)
    if (bound.tag === "PublicationRefused") throw new PublicationRefused({ why: bound.why })
    const subject = (entry: PlannedDescriptor): DescriptorSubject => ({ path: entry.path, descriptor: structuredClone(entry.value), descriptorSha256: hexOf(entry.signed.sha256) })
    const approved: Digest[] = []
    for (const entry of planned) {
      if (try ports.approveSource(subject(entry))) approved.push(entry.signed.sha256)
    }
    const preflighted: SignedDescriptor[] = []
    if (approved.length === planned.length) {
      for (const entry of planned) preflighted.push(...preflightedOf(try ports.preflight(subject(entry))))
    }
    const recheck = try verify()
    const decision = authorizePublication(plan, first.rootKeys, first.floors, first.graph, { approved, preflighted }, recheck.floors, recheck.graph)
    if (decision.tag === "PublicationRefused") throw new PublicationRefused({ why: decision.why })
    try ports.advancePolicy({ ...decision.versions })
    const authorized: AuthorizedPublication = { timestampSha256, versions: { ...decision.versions }, descriptors: planned.map((entry) => entry.path) }
    return authorized
  }
}
