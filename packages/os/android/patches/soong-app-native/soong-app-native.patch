+func TestPrebuiltAppNativeProductInstallPath(t *testing.T) {
+	for _, test := range []struct {
+		moduleType string
+		directory  string
+	}{
+		{"prebuilt_app_native", "app"},
+		{"prebuilt_priv_app_native", "priv-app"},
+	} {
+		t.Run(test.moduleType, func(t *testing.T) {
+			result := android.GroupFixturePreparers(
+				prepareForPrebuiltEtcTest,
+				android.PrepareForTestWithNeverallowRules(nil),
+			).RunTestWithBp(t, test.moduleType+` {
+			name: "alpha_native",
+			src: "foo.conf",
+			filename: "libalpha.so",
+			relative_install_path: "AlphaPhone/lib/arm64",
+			product_specific: true,
+		}
+	`)
+			p := result.Module("alpha_native", "android_arm64_armv8-a").(*PrebuiltEtc)
+			android.AssertPathRelativeToTopEquals(t, "install dir", "out/target/product/test_device/product/"+test.directory+"/AlphaPhone/lib/arm64", p.installDirPaths[0])
+			android.AssertStringEquals(t, "installed filename", "libalpha.so", p.outputFilePaths[0].Base())
+		})
+	}
+}
+
+func TestPrebuiltPrivAppRemainsReservedForGeneratedRules(t *testing.T) {
+	android.GroupFixturePreparers(
+		prepareForPrebuiltEtcTest,
+		android.PrepareForTestWithNeverallowRules(nil),
+	).ExtendWithErrorHandler(android.FixtureExpectsOneErrorPattern("module type not allowed to be defined in bp file")).
+		RunTestWithBp(t, `
+			prebuilt_priv_app {
+				name: "reserved_native",
+				src: "foo.conf",
+				relative_install_path: "AlphaPhone/lib/arm64",
+				product_specific: true,
+			}
+		`)
+}
