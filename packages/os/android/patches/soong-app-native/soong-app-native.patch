+
+func TestPrebuiltAppNativeProductInstallPath(t *testing.T) {
+	result := prepareForPrebuiltEtcTest.RunTestWithBp(t, `
+		prebuilt_app_native {
+			name: "alpha_native",
+			src: "foo.conf",
+			filename: "libalpha.so",
+			relative_install_path: "AlphaPhone/lib/arm64",
+			product_specific: true,
+		}
+	`)
+	p := result.Module("alpha_native", "android_arm64_armv8-a").(*PrebuiltEtc)
+	android.AssertPathRelativeToTopEquals(t, "install dir", "out/target/product/test_device/product/app/AlphaPhone/lib/arm64", p.installDirPaths[0])
+	android.AssertStringEquals(t, "installed filename", "libalpha.so", p.outputFilePaths[0].Base())
+}
