+
+// PrebuiltAppNativeFactory installs admitted native APK payloads beside a prebuilt
+// application in <partition>/app/<relative_install_path>. APK import modules may
+// require these modules without relying on legacy Android.mk JNI installation.
+func PrebuiltAppNativeFactory() android.Module {
+	return prebuiltAppNativeFactory("app")
+}
+
+// PrebuiltPrivAppNativeFactory installs admitted native APK payloads beside a
+// privileged application. Keep the base fixed; prebuilt_priv_app is reserved
+// for generated build rules and cannot be used in Android.bp.
+func PrebuiltPrivAppNativeFactory() android.Module {
+	return prebuiltAppNativeFactory("priv-app")
+}
+
+func prebuiltAppNativeFactory(installDir string) android.Module {
+	module := &PrebuiltEtc{}
+	InitPrebuiltEtcModule(module, installDir)
+	android.InitAndroidArchModule(module, android.DeviceSupported, android.MultilibFirst)
+	android.InitDefaultableModule(module)
+	return module
+}
