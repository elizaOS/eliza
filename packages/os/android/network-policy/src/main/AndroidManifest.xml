<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      ACCESS_NETWORK_STATE is required to call
      `ConnectivityManager.getNetworkCapabilities`. Without it the reader
      answers `metered: null` (unknown, so a download asks first) instead of
      throwing a SecurityException to the caller.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
