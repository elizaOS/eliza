// Android 17 Cuttlefish builds compare the Kati PRODUCT_PACKAGES system file
// list with a Soong-defined android_system_image. The upstream shared image
// cannot name downstream product modules, so extend the same image defaults
// here.
//
// The Eliza launcher is a nonprivileged product app (vendor/eliza/launcher,
// staged by scripts/android/image-launcher.ts) and installs nothing in the
// system partition, so it is not a dependency of this image. Nothing here
// overrides or removes a stock package.
android_system_image {
    name: "eliza_aosp_shared_system_image",
    defaults: ["system_image_defaults"],
    dirs: [
        "system_ext",
        "product",
    ],
    symlinks: [
        {
            target: "/product",
            name: "system/product",
        },
        {
            target: "/system_ext",
            name: "system/system_ext",
        },
        {
            target: "/data/cache",
            name: "cache",
        },
        {
            target: "/odm/odm_dlkm/etc",
            name: "odm_dlkm/etc",
        },
        {
            target: "/vendor/vendor_dlkm/etc",
            name: "vendor_dlkm/etc",
        },
    ],
    type: "erofs",
    erofs: {
        compressor: "lz4hc,9",
        compress_hints: "erofs_compress_hints.txt",
    },
    deps: [
        "logpersist.start",
    ],
}
