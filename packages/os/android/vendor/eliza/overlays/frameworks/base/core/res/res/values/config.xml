<resources>
    <!--
      Role defaults read by PermissionController on first boot.

      Eliza's images use the nonprivileged-launcher profile: default HOME, the
      assistant role and the Autofill offer come from the staged launcher's
      provisioning overlay (vendor/eliza/launcher/provisioning, generated from
      the admitted APK manifest). The dialer and SMS roles are not preassigned;
      the stock apps hold them until the person chooses otherwise.

      Reference: packages/modules/Permission/PermissionController/res/xml/roles.xml
    -->
    <string name="config_defaultBrowser" translatable="false">ai.elizaos.app</string>
</resources>
