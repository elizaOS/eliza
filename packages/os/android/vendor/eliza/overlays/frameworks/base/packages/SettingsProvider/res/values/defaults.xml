<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SetupWizard is disabled for this product (ro.setupwizard.mode). Seed
         the Android framework completion state for fresh settings databases so
         assist keys and other setup-gated framework features work. Eliza's
         account/provider onboarding remains owned by the application. These
         defaults do not rewrite an existing user's settings on boot. -->
    <bool name="def_device_provisioned">true</bool>
    <bool name="def_user_setup_complete">true</bool>
</resources>
