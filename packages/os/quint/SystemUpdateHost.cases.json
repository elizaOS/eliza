  "conformance": "packages/os/quint/check-system-update.mjs",
  "bounds": "One device, one candidate, binary eligibility and verification-space availability. Completed download and cryptographic acceptance are inputs. A verified journal is distinct from a successful check in the current job. Android scheduling, platform authentication, engine effects and physical storage recovery require native qualification.",
  "cases": [
    {
      "name": "interleavings",
