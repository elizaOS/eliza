  "conformance": "packages/os/quint/check-system-update.mjs",
  "bounds": "One device, one candidate, one pre-apply scratch slot, binary eligibility and verification-space availability. Completed download, cryptographic acceptance, retained payload availability and engine readiness are inputs. A verified journal is distinct from a successful check in the current job. The scratch state abstracts the private directory and its ownership checks. Android scheduling, platform authentication, engine effects and physical storage recovery require native qualification.",
  "cases": [
    {
      "name": "interleavings",
      "main": "SystemUpdateHost",
      "init": "init",
      "step": "step",
      "invariants": [
        "NoUnverifiedApply",
        "NoReplay",
        "UnknownNeverActive",
        "ScratchNeverApplied"
      ],
      "temporal": [],
      "maxSteps": 20,
      "samples": 200
    },
    {
      "name": "delivery-after-space-recovers",
      "main": "SystemUpdateHost",
      "init": "storageBlockedInit",
      "step": "stableStep",
      "invariants": [
        "NoUnverifiedApply",
        "NoReplay",
        "UnknownNeverActive",
        "ScratchNeverApplied"
      ],
      "temporal": ["StableDeliveryCompletes", "DeliveryWithoutStorageFairness"],
      "temporalChecks": [
        {
          "property": "StableDeliveryCompletes",
          "expect": "holds",
          "assumptions": [
            "Eligibility stays true, the retained package and payload are valid, and the engine reports reboot readiness after apply.",
            "No stop, crash, rejection or engine failure occurs in this case.",
            "Enough storage eventually becomes available and stays available.",
            "Scheduling, download, storage deferral, verification, engine completion and reboot observation are weakly fair."
          ]
        },
        {
          "property": "DeliveryWithoutStorageFairness",
          "expect": "counterexample",
          "assumptions": [
            "Job actions remain weakly fair, but sufficient storage might never become available."
          ]
        }
      ],
      "maxSteps": 20,
      "samples": 200
    },
    {
      "name": "delivery-after-scratch-recovery",
      "main": "SystemUpdateHost",
      "init": "scratchRecoveryInit",
      "step": "stableStep",
      "invariants": [
        "NoUnverifiedApply",
        "NoReplay",
        "UnknownNeverActive",
        "ScratchNeverApplied"
      ],
      "temporal": ["StableDeliveryCompletes", "DeliveryWithoutScratchFairness"],
      "temporalChecks": [
        {
          "property": "StableDeliveryCompletes",
          "expect": "holds",
          "assumptions": [
            "The initial scratch is an owned slot left by a pre-apply process death.",
            "Eligibility and sufficient space stay true, the retained package and payload are valid, and the engine reports reboot readiness after apply.",
            "No later crash, stop, rejection or engine failure occurs in this case.",
            "Scratch cleanup, scheduling, verification, engine completion and reboot observation are weakly fair."
          ]
        },
        {
          "property": "DeliveryWithoutScratchFairness",
          "expect": "counterexample",
          "assumptions": [
            "Other job actions remain weakly fair, but the owned scratch might never be removed."
          ]
        }
      ],
      "maxSteps": 20,
      "samples": 200
    }
  ]
}
