+
+namespace Bun {
+using namespace JSC;
+
+JSC_DEFINE_HOST_FUNCTION(jsFunction_openNodeInspector, (JSGlobalObject* globalObject, CallFrame*))
+{
+    auto& vm = JSC::getVM(globalObject);
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    throwException(globalObject, scope, createError(globalObject, "Node inspector is unavailable in the RISC-V C-loop build"_s));
+    return {};
+}
+
+JSC_DEFINE_HOST_FUNCTION(jsFunction_waitForNodeInspectorConnection, (JSGlobalObject* globalObject, CallFrame*))
+{
+    auto& vm = JSC::getVM(globalObject);
+    auto scope = DECLARE_THROW_SCOPE(vm);
+    throwException(globalObject, scope, createError(globalObject, "Node inspector is unavailable in the RISC-V C-loop build"_s));
+    return {};
+}
+
