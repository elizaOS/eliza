{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["setup/dist/**", "usb-installer/dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "lint:check": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "format": {
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "format:check": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "clean": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "passThroughEnv": ["ELIZAOS_ELIZA_ROOT"]
    }
  },
  "extends": ["//"]
}
