{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package.json",
    "bun.lock",
    "turbo.json",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "globalPassThroughEnv": [
    "ELIZAOS_ELIZA_ROOT",
    "ELIZAOS_GRIZZLY_RENDERENGINE_BACKEND",
    "ELIZAOS_GRIZZLY_RENDERENGINE_GRAPHITE",
    "ELIZAOS_GRIZZLY_EGL",
    "ELIZAOS_GRIZZLY_EARLY_BOOT_PROBES",
    "ELIZAOS_GRIZZLY_CONSERVATIVE_F2FS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:check": {
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
