// spec/os/android/camera.md, "A preview binds its photo stream only at an aspect ratio the device lists"; spec/os/android/noticeRoutes.md, "An approval notice's title is part of its receipt, and a call that names no title means the configured one"; spec/os/android/notificationProjection.md, "A new-mail count counts the notices still unread, a notice the shade cap withdrew included"; spec/cloud/services/google/mailRead.md, "Story: Hear about new mail while my phone is idle"; spec/os/signIn/cloudRequests.md, "A mail or calendar route is sent only with the lease, never with the device key"; spec/os/android/files/storage.md, "A listing or folder walk shows dot entries only when asked, and never the Trash under any spelling"; spec/os/android/files/storage.md, "A move into another volume takes the copy path, and its copy is written and cleaned up on that volume"; spec/os/android/calendar.md, "Story: Delete the event, one occurrence or the whole series as I chose"; spec/os/android/calendar.md, "The provider resolves the selected instance and decides the permitted scope"; spec/os/android/calendar.md, "A confirmed deletion is staged on the review clock and dispatched only through its claim"
import { assert, it } from "@effect/vitest"
import { ANDROID_CALENDAR_METHODS } from "@elizaos/os-bridges"

module node {
  import { execFileSync } from "node:child_process"
  import path from "node:path"
  import { compileAdapter, orgJsonAdapterClasspath } from "./drivers/jvm-adapter.ts"
  import { androidTools } from "./support/android-tools.ts"

  const java = process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", "java") : "java"

  export function aspectRatioChecks(): string {
    const main = "ai.eliza.plugins.camera.CaptureAspectRatiosTest"
    return execFileSync(java, ["-cp", compileAdapter(main), main], { encoding: "utf8", timeout: 120_000 }).trim()
  }

  export async function hostChecks(check: "NoticeTitlesTest" | "MailCountTest" | "MailBackgroundDeliveryTest"): Promise<string> {
    const main = `ai.eliza.plugins.notifications.${check}`
    return execFileSync(java, ["-cp", await orgJsonAdapterClasspath(main), main], { encoding: "utf8", timeout: 120_000 }).trim()
  }

  export async function calendarDeletion(methods: readonly string[]): Promise<unknown> {
    const tools = androidTools()
    if (tools.kind === "missing") throw new Error(tools.reason)
    const main = "ai.eliza.plugins.calendar.CalendarDeletionJourney"
    const classpath = [await orgJsonAdapterClasspath(main, ["android/calendar/src/main/java", "test/fixtures/calendar-deletion"]), tools.androidJar].join(path.delimiter)
    return JSON.parse(execFileSync(java, ["-cp", classpath, main, ...methods], { encoding: "utf8", timeout: 120_000 }))
  }

  export async function storageBrowsing(): Promise<string> {
    const main = "ai.eliza.files.StorageBrowsingCheck"
    return execFileSync(java, ["-cp", await orgJsonAdapterClasspath(main), main], { encoding: "utf8", timeout: 120_000 }).trim()
  }
}
import { aspectRatioChecks, calendarDeletion, hostChecks, storageBrowsing } from node

it.effect("A preview binds its photo stream only at an aspect ratio the device lists (spec/os/android/camera.md, \"A preview binds its photo stream only at an aspect ratio the device lists\")", () => effect {
  const answer = try Effect.try(() => aspectRatioChecks())
  try Effect.try(() => assert.strictEqual(answer, "CaptureAspectRatiosTest checks: 12"))
}, 180_000)

it.effect(`An approval notice's title is part of its receipt, and a call that names no title means the configured one (spec/os/android/noticeRoutes.md, "An approval notice's title is part of its receipt, and a call that names no title means the configured one")`, () => effect {
  const answer = try tryPromise(() => hostChecks("NoticeTitlesTest"))
  try Effect.try(() => assert.strictEqual(answer, "NoticeTitlesTest checks: 24"))
}, 180_000)

it.effect('A new-mail count counts the notices still unread, a notice the shade cap withdrew included (spec/os/android/notificationProjection.md, "A new-mail count counts the notices still unread, a notice the shade cap withdrew included")', () => effect {
  const answer = try tryPromise(() => hostChecks("MailCountTest"))
  try Effect.try(() => assert.strictEqual(answer, "MailCountTest checks: 6"))
}, 180_000)

it.effect('A leased background mail check is admitted only in the foreground for the lease\'s owner, reads only the account list and inbox-v1 history, and retires its notices once the lease rotates (spec/cloud/services/google/mailRead.md, "Story: Hear about new mail while my phone is idle"; spec/os/signIn/cloudRequests.md, "A mail or calendar route is sent only with the lease, never with the device key")', () => effect {
  const answer = try tryPromise(() => hostChecks("MailBackgroundDeliveryTest"))
  try Effect.try(() => assert.strictEqual(answer, "MailBackgroundDeliveryTest checks: 34"))
}, 180_000)

it.effect('Browse hidden entries only when asked, never the Trash, and move or copy into another volume (spec/os/android/files/storage.md, "A listing or folder walk shows dot entries only when asked, and never the Trash under any spelling"; spec/os/android/files/storage.md, "A move into another volume takes the copy path, and its copy is written and cleaned up on that volume")', () => effect {
  const answer = try tryPromise(() => storageBrowsing())
  try Effect.try(() => assert.match(answer, /^StorageBrowsingCheck checks: (18|21)$/))
}, 180_000)

const HOUR = 3_600_000
const WEEK = 7 * 24 * HOUR
const FIRST = 1_791_766_800_000
const EVERY_WEEK = [0, 168, 336, 504]
const CONFLICT = { status: "conflict" }
const evidence = (changes: object = {}) => ({
  selectedRow: "ParentRow", sync: "LocalUnsynced", sourceCurrent: true, bounded: true, otherExceptions: false, liveException: "NoLiveException",
  instances: 1, begin: FIRST, finish: FIRST + HOUR, exceptionOriginal: -1, ...changes,
})
const ready = (recurrence: string, scope: object, writable = true) => ({ status: "ready", recurrence, writable, revision: "sha256", sourceRevision: "sha256", evidence: scope })
const committed = (changes: object) => ({
  status: "committed",
  readback: { parentAfter: "ParentLive", fieldsMatch: false, exclusionExact: false, cancelledAtStart: 0, instanceRemains: false, ...changes },
})
const kept = (title: string, instanceHours: number[], changes: object = {}) => ({ row: { title, deleted: 0, status: 1, exdate: null, ...changes }, instanceHours })
const GONE = { row: null, instanceHours: [] }
const after = (batches: number, rows: object, exceptionsOf5 = 1) => ({ ...rows, batches, exceptionsOf5 })
const SECOND_WEEK = evidence({ begin: FIRST + WEEK, finish: FIRST + WEEK + HOUR })

it.effect('Delete one event, one occurrence or the whole series through the compiled ElizaCalendar plugin, which has every method the bridge calls (spec/os/android/calendar.md, "Story: Delete the event, one occurrence or the whole series as I chose"; spec/os/android/calendar.md, "The provider resolves the selected instance and decides the permitted scope"; spec/os/android/calendar.md, "A confirmed deletion is staged on the review clock and dispatched only through its claim")', () => effect {
  const seen = try tryPromise(() => calendarDeletion(ANDROID_CALENDAR_METHODS))
  try Effect.try(() => assert.deepStrictEqual(seen, {
    missing: [],
    journeys: {
      single: { inspected: ready("one-off", evidence()), dispatched: committed({ parentAfter: "ParentGone" }), again: CONFLICT, after: after(1, { 1: GONE, 2: kept("Probe single conflict", [2]) }) },
      singleChangedSince: { dispatched: CONFLICT, staleSelection: CONFLICT, after: after(0, { 2: kept("Probe single conflict, moved", [2]) }) },
      localOccurrence: { inspected: ready("rule", SECOND_WEEK), dispatched: committed({ exclusionExact: true }), after: after(1, { 3: kept("Probe weekly", [0, 336, 504], { exdate: "20261019T010000Z" }) }) },
      wholeSeries: { inspected: ready("rule", SECOND_WEEK), dispatched: committed({ parentAfter: "ParentGone" }), after: after(1, { 3: GONE }) },
      seriesChangedSince: { dispatched: CONFLICT, after: after(0, { 3: kept("Probe weekly", EVERY_WEEK) }) },
      changedDuringBatch: { dispatched: CONFLICT, after: after(1, { 3: kept("Probe weekly, renamed", EVERY_WEEK) }) },
      syncedOccurrence: {
        inspected: ready("rule", evidence({ sync: "SyncedSeries", otherExceptions: true })),
        dispatched: committed({ cancelledAtStart: 1 }),
        after: after(1, { 5: kept("Team sync", [336, 504]) }, 2),
      },
      movedException: {
        inspected: ready("rule", evidence({ selectedRow: "ExceptionRow", sync: "SyncedSeries", liveException: "SelectedException", begin: FIRST + WEEK + 2 * HOUR, finish: FIRST + WEEK + 3 * HOUR, exceptionOriginal: FIRST + WEEK })),
        dispatched: committed({ cancelledAtStart: 1 }),
        after: after(1, { 5: kept("Team sync", [0, 336, 504]), 6: { row: { title: "Team sync (moved)", deleted: 0, status: 2, exdate: null }, instanceHours: [] } }),
      },
      changeTheFamilyRefuses: {
        excludeRemote: CONFLICT, insertRemote: CONFLICT, deleteWithAnOccurrence: CONFLICT, cancelTheParent: CONFLICT, excludeSynced: CONFLICT,
        after: after(0, { 5: kept("Team sync", [0, 336, 504]), 11: kept("Exchange standup", EVERY_WEEK) }),
      },
      editorEvidence: {
        remoteUnsynced: ready("rule", evidence({ sync: "RemoteUnsynced" })),
        readOnly: ready("one-off", evidence({ sync: "RemoteUnsynced" }), false),
        localWithAnEdit: ready("rule", { ...SECOND_WEEK, otherExceptions: true }),
        notAnInstance: ready("one-off", evidence({ instances: 0, begin: FIRST + HOUR, finish: FIRST + 2 * HOUR })),
      },
      permissionRequired: { inspected: { status: "permission-required" }, dispatched: { status: "permission-required" }, after: after(0, { 1: kept("Probe single", [0]) }) },
      lockedAfterReview: { inspected: { status: "unavailable" }, dispatched: committed({ parentAfter: "ParentGone" }), after: after(1, { 1: GONE }) },
      replyLost: { dispatched: { status: "unknown" }, after: after(1, { 1: GONE }) },
    },
  }))
}, 180_000)
