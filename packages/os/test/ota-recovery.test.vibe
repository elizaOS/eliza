// spec/os/update/operator.md, "Story: Get back if the update fails"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { Machine } from "../gen/os__update__operator.effect.vibe"
import { applyUpdate, deviceRunner, journalMachine, otaMain, readChannel, readJournal, withInstallLock, type ApplyRequest } from "../src/image/ota-operator.vibe"
import { fallbackProblems, fallbackToOriginalSlot, knownGoodRecoveryPlan, type KnownGoodManifest } from "../src/image/ota-recovery.vibe"
import { device, fakeAdb, type Device, type FakeAdb, type Image } from "./support/fake-adb.ts"
import { scratch } from "./support/scratch.vibe"

module node {
  import { execFileSync } from "node:child_process"
  import { createHash } from "node:crypto"
  import { mkdirSync, writeFileSync } from "node:fs"
  import path from "node:path"

  /** @throws {never} */
  export function sha256(bytes: string | Uint8Array): string {
    return createHash("sha256").update(bytes).digest("hex")
  }

  /** @throws {Error} */
  export function zip(archive: string, entries: Readonly<Record<string, string>>): void {
    const root = `${archive}.entries`
    for (const [name, content] of Object.entries(entries)) {
      mkdirSync(path.dirname(path.join(root, name)), { recursive: true })
      writeFileSync(path.join(root, name), content)
    }
    execFileSync("zip", ["-q", "-X", "-r", archive, ...Object.keys(entries)], { cwd: root })
  }
}
import { sha256, zip } from node

const SERIAL = "FAKE0001"
const OTA_CERT = "b".repeat(64)
const AVB_KEY = "a".repeat(64)
const STOCK_BUILD = "CP3A.261005.005"
const STOCK_FINGERPRINT = `google/example/example:17/${STOCK_BUILD}/14300000:user/release-keys`
const VBMETA = "signed vbmeta"
const fingerprint = (build: string, keys = "user/release-keys") => `example/example_phone/example:17/BP2A.${build}/1:${keys}`
const INSTALLED = { build: "261005.001", dateUtc: "1790000000", securityPatch: "2026-10-05" }
const CANDIDATE = { build: "261105.001", dateUtc: "1792000000", securityPatch: "2026-11-05" }
const UPDATED_SLOTS = { "current-slot": "b", "slot-successful:b": "no", "slot-unbootable:a": "no", "snapshot-update-status": "snapshotted" }

type Release = typeof INSTALLED

const channelJson = (stockSha256: string) => ({
  schema: 1,
  channel: "stable",
  product: "example_phone",
  device: "example",
  otaCertificateSha256: OTA_CERT,
  avbPublicKeySha256: AVB_KEY,
  downgradeAllowed: false,
  recovery: { stockFactoryImage: { filename: "example-factory.zip", sha256: stockSha256 } },
})

function record(release: Release, change: { readonly keys?: string; readonly product?: string } = {}) {
  return {
    schema: 1,
    kind: "aosp-release-compatibility",
    product: change.product ?? "example_phone",
    device: "example",
    channel: "stable",
    build: { fingerprint: fingerprint(release.build, change.keys), securityPatch: release.securityPatch, vendorSecurityPatch: release.securityPatch, dateUtc: release.dateUtc },
    artifacts: {
      signedTargetFiles: { file: "signed-target_files.zip", sha256: sha256(`tf ${release.build}`) },
      ota: { file: "ota.zip", sha256: sha256(`ota ${release.build}`), sizeBytes: `ota ${release.build}`.length, type: "full", incrementalFrom: null },
    },
    verifiedBoot: { publicKeySha256: AVB_KEY, rollbackIndexes: [0, 1, 2].map((location) => ({ location, index: "1" })), images: { vbmeta: sha256(VBMETA) } },
    payload: { metadata: { "post-build": fingerprint(release.build), "post-timestamp": release.dateUtc } },
    certificates: { releasekey: OTA_CERT, platform: "c".repeat(64) },
    problems: [],
    imageBooted: false,
    signedUpdateApplied: false,
    releaseQualified: false,
    deviceAcceptanceVerified: false,
  }
}

function image(props: Readonly<Record<string, string>>, selinux: "Enforcing" | "Permissive" = "Enforcing"): Image {
  return { props: { "sys.boot_completed": "1", "ro.product.device": "example", "ro.boot.verifiedbootstate": "yellow", "ro.boot.flash.locked": "1", "ro.virtual_ab.enabled": "true", ...props }, selinux }
}

const booted = (release: Release, slot: "a" | "b", selinux: "Enforcing" | "Permissive" = "Enforcing") =>
  image({ "ro.build.fingerprint": fingerprint(release.build), "ro.boot.slot_suffix": `_${slot}`, "ro.build.version.security_patch": release.securityPatch }, selinux)

interface Bench {
  readonly root: string
  readonly phone: FakeAdb
  readonly request: ApplyRequest
}

const journey = <A, E>(body: A!E!(NodeServices.NodeServices | Scope.Scope)) => Effect.provide(Effect.scoped(body), NodeServices.layer)

effect function write(file: string, value: unknown) {
  const files = try FileSystem.FileSystem
  try files.writeFileString(file, typeof value === "string" ? value : JSON.stringify(value))
  return file
}

effect function failedUpdate(name: string) {
  const files = try FileSystem.FileSystem
  const root = try scratch(name)
  try files.makeDirectory(`${root}/phone`)
  const toSideload = { tool: "adb" as const, args: ["-s", SERIAL, "reboot", "recovery"], answer: { status: 0 }, become: "sideload" as const }
  const phone = try Effect.try(() => fakeAdb(`${root}/phone`, device(SERIAL, { image: booted(INSTALLED, "a"), boots: [booted(CANDIDATE, "b", "Permissive")], scripted: [toSideload] })))
  const request: ApplyRequest = {
    device: try deviceRunner({ serial: SERIAL, adb: phone.adb, fastboot: phone.fastboot }),
    channel: (try readChannel(try write(`${root}/channel.json`, channelJson("0".repeat(64))))).channel,
    from: try write(`${root}/installed.json`, record(INSTALLED)),
    to: try write(`${root}/candidate.json`, record(CANDIDATE)),
    ota: try write(`${root}/ota.zip`, `ota ${CANDIDATE.build}`),
    journal: `${root}/journal.json`,
    lockDirectory: `${root}/locks`,
    timing: { rebootMs: 1500, operatorMs: 500, sideloadMs: 30_000, pollMs: 100 },
  }
  const refused = try Effect.flip(applyUpdate({ ...request, execute: true, confirm: true }))
  assert.strictEqual(refused._tag, "VerificationFailed")
  const left = try readJournal(request.journal)
  assert.strictEqual(left.state.phase, "VerificationFailed")
  assert.deepStrictEqual(left.state.lock, { tag: "LeftLocked" })
  for (const name of try files.readDirectory(`${root}/locks`)) try files.remove(`${root}/locks/${name}`)
  const bench: Bench = { root, phone, request }
  return bench
}

effect function setPhone(bench: Bench, change: Partial<Device>) {
  try Effect.try(() => bench.phone.set(change))
}

effect function fallback(bench: Bench, execute: boolean, confirm: boolean) {
  const read = try readJournal(bench.request.journal)
  const journal = try journalMachine(bench.request.journal, read.binding)
  const device = bench.request.device
  if (!execute) {
    provide Machine = journal {
      return try fallbackToOriginalSlot({ device, execute, confirm })
    }
  }
  return try withInstallLock(journal, device.serial, "ota-fallback", bench.request.lockDirectory ?? "", effect (lock) => {
    provide Machine = journal {
      return try fallbackToOriginalSlot({ device, execute, confirm, lock, timing: { rebootMs: 1500, pollMs: 100 } })
    }
  })
}

effect function slotWrites(phone: FakeAdb) {
  const calls = try Effect.try(() => phone.calls())
  return calls.filter((call) => ["set_active", "flash", "flashing", "erase", "update", "sideload"].includes(call.args[2] ?? "")).map((call) => [call.tool, ...call.args.slice(2)].join(" "))
}

it.live('Fall back to the original slot only while it is still safe, and roll back only when the installed build boots (spec/os/update/operator.md, "Story: Get back if the update fails")', () => journey(effect {
  const files = try FileSystem.FileSystem
  const bench = try failedUpdate("ota-fallback")
  const onAndroid = try fallback(bench, false, false)
  assert.strictEqual(onAndroid.kind, "Refused")
  assert.deepStrictEqual(onAndroid.problems.map((problem) => problem.kind), ["NotInBootloader"])
  for (const [variables, refusal] of [
    [{ ...UPDATED_SLOTS, "slot-successful:b": "yes" }, "UpdatedSlotConfirmed"],
    [{ "current-slot": "b", "slot-successful:b": "no", "slot-unbootable:a": "no" }, "NotSnapshotted"],
  ] as const) {
    try setPhone(bench, { mode: "bootloader", variables })
    const refused = try fallback(bench, true, true)
    assert.strictEqual(refused.kind, "Refused", refusal)
    assert.include(refused.problems.map((problem) => problem.kind), refusal)
  }
  const stalled = try readJournal(bench.request.journal)
  assert.strictEqual(stalled.state.phase, "VerificationFailed")
  const noSnapshot = { currentSlot: "SlotB", updatedUnconfirmed: true, originalBootable: true, snapshot: "NoSnapshot" } as const
  const kinds = (slots: typeof noSnapshot | { readonly currentSlot: "SlotA" | "SlotB"; readonly updatedUnconfirmed: boolean; readonly originalBootable: boolean; readonly snapshot: "Snapshotted" | "Merging" | "NoSnapshot" }) => fallbackProblems(stalled.state, slots).map((problem) => problem.kind)
  assert.deepStrictEqual(kinds({ ...noSnapshot, snapshot: "Merging" }), ["MergeRunning"])
  assert.deepStrictEqual(kinds(noSnapshot), ["NotSnapshotted"])
  assert.deepStrictEqual(kinds({ ...noSnapshot, snapshot: "Snapshotted", currentSlot: "SlotA" }), ["NotOnUpdatedSlot"])
  assert.deepStrictEqual(kinds({ ...noSnapshot, snapshot: "Snapshotted", originalBootable: false }), ["OriginalSlotUnbootable"])
  assert.deepStrictEqual(fallbackProblems({ ...stalled.state, start: { ...stalled.state.start, virtualAb: false } }, noSnapshot), [])
  assert.deepStrictEqual(fallbackProblems({ ...stalled.state, phase: "AwaitingSideload" }, { ...noSnapshot, snapshot: "Snapshotted" }).map((problem) => problem.kind), ["NothingToFallBackFrom"])

  try setPhone(bench, { mode: "bootloader", variables: UPDATED_SLOTS, boots: [booted(INSTALLED, "a")] })
  const dry = try fallback(bench, false, false)
  assert.strictEqual(dry.kind, "Admitted")
  assert.deepStrictEqual(try slotWrites(bench.phone), ["adb sideload " + bench.request.ota])
  const unconfirmed = try Effect.flip(fallback(bench, true, false))
  assert.strictEqual(unconfirmed._tag, "FallbackUnconfirmed")
  const rolledBack = try fallback(bench, true, true)
  assert.strictEqual(rolledBack.kind, "RolledBack", JSON.stringify(rolledBack.problems))
  const settled = try readJournal(bench.request.journal)
  assert.strictEqual(settled.state.phase, "RolledBack")
  assert.deepStrictEqual(settled.state.lock, { tag: "Unlocked" })
  assert.deepStrictEqual(try files.readDirectory(`${bench.root}/locks`), [])
  assert.deepStrictEqual(try slotWrites(bench.phone), ["adb sideload " + bench.request.ota, "fastboot set_active a"])
  try setPhone(bench, { mode: "bootloader", variables: UPDATED_SLOTS })
  const again = try fallback(bench, true, true)
  assert.deepStrictEqual(again.problems.map((problem) => problem.kind), ["NothingToFallBackFrom"])
  assert.strictEqual((try readJournal(bench.request.journal)).state.phase, "RolledBack")
}))

it.live('Never record a rollback when the original slot boots anything but the installed build (spec/os/update/operator.md, "Story: Get back if the update fails")', () => journey(effect {
  const files = try FileSystem.FileSystem
  const bench = try failedUpdate("ota-fallback-failed")
  try setPhone(bench, { mode: "bootloader", variables: UPDATED_SLOTS, boots: [booted(CANDIDATE, "a")] })
  const failed = try fallback(bench, true, true)
  assert.strictEqual(failed.kind, "FallbackFailed")
  assert.match(failed.problems.map((problem) => problem.detail).join("\n"), /not the installed/)
  const journal = try readJournal(bench.request.journal)
  assert.strictEqual(journal.state.phase, "FallbackFailed")
  assert.deepStrictEqual(journal.state.lock, { tag: "LeftLocked" })
  assert.lengthOf(try files.readDirectory(`${bench.root}/locks`), 1)
}))

effect function ota(...argv: readonly string[]) {
  return try otaMain(argv)
}

effect function refusal(...argv: readonly string[]) {
  const failed = try Effect.flip(otaMain(argv))
  return failed._tag === "UpdateRefused" ? failed.problems.join("\n") : failed._tag
}

it.live('Print the stock recovery plan only for the locked factory archive and verify the stock build read-only (spec/os/update/operator.md, "Story: Get back if the update fails")', () => journey(effect {
  const files = try FileSystem.FileSystem
  const root = try scratch("ota-stock")
  const top = `example-${STOCK_BUILD.toLowerCase()}`
  const layout = {
    [`${top}/flash-all.sh`]: "flash",
    [`${top}/bootloader-example-1.2.img`]: "bootloader",
    [`${top}/radio-example-g5.img`]: "radio",
    [`${top}/image-example-${STOCK_BUILD.toLowerCase()}.zip`]: "image",
  }
  try Effect.try(() => zip(`${root}/example-factory.zip`, layout))
  const bytes = try files.readFile(`${root}/example-factory.zip`)
  const factory = { filename: "example-factory.zip", sha256: sha256(bytes), sizeBytes: bytes.byteLength, buildId: STOCK_BUILD }
  const lock = try write(`${root}/lock.json`, { device: { codename: "example" }, factory })
  const channel = try write(`${root}/channel.json`, channelJson(factory.sha256))
  const plan = try ota("stock-archive", "--channel", channel, "--source-lock", lock, "--archive", `${root}/example-factory.zip`) as { readonly steps: readonly (readonly string[])[]; readonly executed: boolean }
  assert.isFalse(plan.executed)
  assert.deepStrictEqual(plan.steps.map((step) => step.slice(3).join(" ")), [
    "reboot bootloader",
    "flashing unlock",
    "erase avb_custom_key",
    `flash bootloader ${top}/bootloader-example-1.2.img`,
    "reboot-bootloader",
    `flash radio ${top}/radio-example-g5.img`,
    "reboot-bootloader",
    `-w update ${top}/image-example-${STOCK_BUILD.toLowerCase()}.zip`,
  ])
  const otherImage = try write(`${root}/other-channel.json`, channelJson("1".repeat(64)))
  assert.match(try refusal("stock-archive", "--channel", otherImage, "--source-lock", lock, "--archive", `${root}/example-factory.zip`), /not the channel's stock factory image/)
  const { [`${top}/radio-example-g5.img`]: _radio, ...withoutRadio } = layout
  try Effect.try(() => zip(`${root}/partial/example-factory.zip`, withoutRadio))
  const partial = try files.readFile(`${root}/partial/example-factory.zip`)
  const partialLock = try write(`${root}/partial-lock.json`, { device: { codename: "example" }, factory: { ...factory, sha256: sha256(partial), sizeBytes: partial.byteLength } })
  assert.match(try refusal("stock-archive", "--channel", try write(`${root}/partial-channel.json`, channelJson(sha256(partial))), "--source-lock", partialLock, "--archive", `${root}/partial/example-factory.zip`), /0 radio entries/)
  const newerLock = try write(`${root}/newer-lock.json`, { device: { codename: "example" }, factory: { ...factory, buildId: "CP4A.270101.001" } })
  assert.match(try refusal("stock-archive", "--channel", channel, "--source-lock", newerLock, "--archive", `${root}/example-factory.zip`), /not the locked build CP4A/)

  try files.makeDirectory(`${root}/phone`)
  const phone = try Effect.try(() => fakeAdb(`${root}/phone`, device(SERIAL, { image: image({ "ro.build.fingerprint": STOCK_FINGERPRINT, "ro.boot.verifiedbootstate": "green", "ro.boot.slot_suffix": "_a" }) })))
  const verified = try ota("verify-stock", "--serial", SERIAL, "--source-lock", lock, "--adb", phone.adb, "--fastboot", phone.fastboot) as { readonly passed: boolean }
  assert.isTrue(verified.passed)
  try Effect.try(() => phone.set({ image: booted(INSTALLED, "a") }))
  assert.match(try refusal("verify-stock", "--serial", SERIAL, "--source-lock", lock, "--adb", phone.adb, "--fastboot", phone.fastboot), /not stock CP3A/)
  const calls = try Effect.try(() => phone.calls())
  assert.isTrue(calls.every((call) => call.tool === "adb" && ["get-state", "shell"].includes(call.args[2] ?? "")), JSON.stringify(calls))
}))

it.live('Retain a known-good release only from release-keys bytes it names, and re-verify them before every plan (spec/os/update/operator.md, "Story: Get back if the update fails")', () => journey(effect {
  const files = try FileSystem.FileSystem
  const root = try scratch("ota-known-good")
  const channel = try write(`${root}/channel.json`, channelJson("0".repeat(64)))
  const recordFile = try write(`${root}/release.json`, record(INSTALLED))
  const targetFiles = try write(`${root}/signed-target_files.zip`, `tf ${INSTALLED.build}`)
  try Effect.try(() => zip(`${root}/signed-image.zip`, { "vbmeta.img": VBMETA, "boot.img": "boot" }))
  const retain = (...change: readonly string[]) => ["retain-known-good", "--channel", channel, "--record", recordFile, "--signed-target-files", targetFiles, "--signed-image", `${root}/signed-image.zip`, "--archive-dir", `${root}/known-good`, ...change]
  const retained = try ota(...retain()) as { readonly manifest: KnownGoodManifest; readonly archiveDir: string }
  assert.strictEqual(retained.manifest.fingerprint, fingerprint(INSTALLED.build))
  assert.deepStrictEqual(retained.manifest.knownGood, { tag: "KnownGoodRelease", buildFingerprint: fingerprint(INSTALLED.build), updatePackage: { tag: "Sha256", hex: sha256(`ota ${INSTALLED.build}`) } })
  assert.strictEqual((try files.stat(retained.archiveDir)).mode & 0o777, 0o555)
  assert.strictEqual((try files.stat(`${retained.archiveDir}/signed-image.zip`)).mode & 0o777, 0o444)
  assert.match(try refusal(...retain()), /already exists/)

  const parsed = (try readChannel(channel)).channel
  const plan = try knownGoodRecoveryPlan({ channel: parsed, directory: retained.archiveDir })
  assert.deepStrictEqual(plan.problems, [])
  assert.deepStrictEqual(plan.steps.map((step) => step.slice(3).join(" ")), ["reboot bootloader", "flashing unlock", "-w update signed-image.zip"])

  for (const [name, change, expected] of [
    ["test-keys", record(INSTALLED, { keys: "userdebug/test-keys" }), /not a release-keys user build/],
    ["placeholder", record(INSTALLED, { product: "UNSET" }), /unset or a placeholder/],
  ] as const) {
    const other = try write(`${root}/${name}.json`, change)
    assert.match(try refusal("retain-known-good", "--channel", channel, "--record", other, "--signed-target-files", targetFiles, "--signed-image", `${root}/signed-image.zip`, "--archive-dir", `${root}/${name}`), expected)
    assert.isFalse(try files.exists(`${root}/${name}`))
  }
  try Effect.try(() => zip(`${root}/other/signed-image.zip`, { "vbmeta.img": "another vbmeta" }))
  assert.match(try refusal("retain-known-good", "--channel", channel, "--record", recordFile, "--signed-target-files", targetFiles, "--signed-image", `${root}/other/signed-image.zip`, "--archive-dir", `${root}/other-vbmeta`), /not the record's signed vbmeta/)

  try files.chmod(retained.archiveDir, 0o755)
  try files.chmod(`${retained.archiveDir}/signed-image.zip`, 0o644)
  try files.writeFileString(`${retained.archiveDir}/signed-image.zip`, "replaced")
  const changed = try knownGoodRecoveryPlan({ channel: parsed, directory: retained.archiveDir })
  assert.deepStrictEqual(changed.steps, [])
  assert.deepStrictEqual(changed.problems.map((problem) => problem.detail), ["the retained signedImage changed since it was retained"])
}))
