// spec/os/appUpdate/admission.md, "Story: Publish an app update only with authorized versions"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import {
  advancePublisherPolicy,
  createPublicationAuthorizer,
  initializePublisherPolicy,
  parseDescriptorJson,
  readPublisherPolicy,
  verifyPublicationGraph,
  type DescriptorSubject,
  type FloorsRefused,
  type GraphUnverified,
  type PublicationBundle,
  type PublisherPolicyRefused,
  type PublisherPolicyUnreadable,
} from "../src/app-update/publication.vibe"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { scratch, writeTree } from "./support/scratch.vibe"

module node {
  import { createHash } from "node:crypto"

  /** @throws {never} */
  export function sha256(bytes: Uint8Array): string {
    return createHash("sha256").update(bytes).digest("hex")
  }
}
import { sha256 } from node

const VERIFIER = `#!/usr/bin/env node
import { createHash } from "node:crypto"
import { readFileSync } from "node:fs"
import path from "node:path"
const args = {}
for (let i = 2; i < process.argv.length; i += 2) args[process.argv[i]] = process.argv[i + 1]
const files = JSON.parse(readFileSync(args["-bundle"], "utf8")).files
const policy = JSON.parse(readFileSync(args["-policy"], "utf8"))
const root = JSON.parse(readFileSync(args["-root"], "utf8"))
const versions = JSON.parse(readFileSync(path.join(path.dirname(process.argv[1]), "versions.json"), "utf8"))
if (root.signed.version < 1) process.exit(2)
for (const [role, version] of Object.entries(versions)) {
  if (version < policy.minimumVersions[role]) {
    console.error("publication " + role + " version rollback")
    process.exit(1)
  }
}
const bytes = (name) => Buffer.from(files[name], "base64")
const descriptors = {}
for (const name of Object.keys(files)) {
  const match = /^targets\\/(stable|beta)\\/[a-f0-9]{64}\\.(launcher|standalone)\\.json$/.exec(name)
  if (match) descriptors[match[1] + "/" + match[2] + ".json"] = JSON.parse(bytes(name).toString("utf8"))
}
console.log(JSON.stringify({ graphVerified: true, timestampSha256: createHash("sha256").update(bytes("timestamp.json")).digest("hex"), versions, descriptors }))
`

const FLOORS = { root: 1, timestamp: 1, snapshot: 1, targets: 1, stable: 1, beta: 1 }
const SIGNED = { ...FLOORS, timestamp: 2, snapshot: 2 }
const encoder = new TextEncoder()
const json = (value: unknown) => encoder.encode(JSON.stringify(value))
const key = (material: string) => ({ keytype: "ed25519", scheme: "ed25519", keyval: { public: material } })
const ROOT = json({ signed: { version: 1, keys: { r1: key("root-1") } } })
const DESCRIPTOR = json({ schema: 1, channel: "stable", distribution: "launcher", sequence: 2 })

function bundleOf(stableSigners: readonly string[], descriptor: Uint8Array = DESCRIPTOR): PublicationBundle {
  return {
    timestamp: json({ signed: { version: 2, meta: { "snapshot.json": { version: 2 } } } }),
    dependencies: [
      { name: "2.snapshot.json", bytes: json({ signed: { version: 2 } }) },
      { name: "1.targets.json", bytes: json({ signed: { version: 1, delegations: { keys: { s1: key("stable-1"), s2: key("stable-2"), b1: key("beta-1") }, roles: [{ name: "stable", keyids: ["s1", "s2"], threshold: 2 }, { name: "beta", keyids: ["b1"], threshold: 1 }] } } }) },
      { name: "1.stable.json", bytes: json({ signatures: stableSigners.map((keyid) => ({ keyid, sig: "00" })), signed: { version: 1 } }) },
      { name: "1.beta.json", bytes: json({ signatures: [{ keyid: "b1", sig: "00" }], signed: { version: 1 } }) },
      { name: `targets/stable/${sha256(descriptor)}.launcher.json`, bytes: descriptor },
    ],
  }
}

it.effect("Publish an app update only with authorized versions (spec/os/appUpdate/admission.md, \"Story: Publish an app update only with authorized versions\"; spec/os/appUpdate/admission.md, \"Publisher role floors only ratchet\"; spec/os/appUpdate/admission.md, \"A publication is authorized only when one approved graph at the floors binds the plan and every descriptor is approved and preflighted\")", effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const root = try scratch("publication")
    const policyFile = `${root}/floors.sqlite`
    const verifier = `${root}/verifier/verify-publication.mjs`
    try writeTree(root, { "verifier/verify-publication.mjs": { kind: "executable", content: VERIFIER }, "verifier/versions.json": JSON.stringify(SIGNED) })

    const unprovisioned = (readPublisherPolicy(policyFile, 1_000) catch (error) => error._tag)
    const initialized = try initializePublisherPolicy(policyFile, FLOORS)
    const again = (initializePublisherPolicy(policyFile, SIGNED) catch (error) => error._tag)
    const timeless = (readPublisherPolicy(policyFile, 0) catch (error) => error._tag)
    try Effect.try(() => assert.deepStrictEqual([unprovisioned, initialized, again, timeless], ["PublisherPolicyUnreadable", FLOORS, "PublisherPolicyRefused", "PublisherPolicyRefused"]))

    const asked: string[] = []
    let approve = true
    let changeGraph = false
    const authorize = createPublicationAuthorizer<PublisherPolicyRefused | PublisherPolicyUnreadable | GraphUnverified | FloorsRefused, FileSystem.FileSystem | Path.Path | ChildProcessSpawner>({
      readPolicy: () => readPublisherPolicy(policyFile, 1_000),
      verifyGraph: (input) => verifyPublicationGraph({ ...input, executable: verifier, timeout: Duration.seconds(30) }),
      approveSource: effect function (subject: DescriptorSubject) {
        asked.push(`approve ${subject.path} ${subject.descriptorSha256}`)
        if (changeGraph) try Effect.orDie(files.writeFileString(`${root}/verifier/versions.json`, JSON.stringify({ ...SIGNED, timestamp: 3 })))
        return approve
      },
      preflight: effect function (subject: DescriptorSubject) {
        asked.push(`preflight ${subject.path}`)
        return { descriptorSha256: subject.descriptorSha256, channel: "stable", distribution: "launcher" }
      },
      advancePolicy: (versions) => advancePublisherPolicy(policyFile, versions),
    }, ROOT)
    const refusal = effect function (bundle: PublicationBundle) {
      return (effect { try authorize(bundle); return "PublicationAuthorized" } catch (error) => error._tag === "PublicationRefused" ? error.why : error._tag)
    }
    const descriptorSha256 = sha256(DESCRIPTOR)

    const oneKey = try refusal(bundleOf(["s1", "s1"]))
    const duplicateKey = try refusal(bundleOf(["s1", "s2"], encoder.encode('{"schema":1,"schema":2}')))
    const askedBeforeApproval = [...asked]
    approve = false
    const unapproved = try refusal(bundleOf(["s1", "s2"]))
    approve = true
    changeGraph = true
    const changed = try refusal(bundleOf(["s1", "s2"]))
    changeGraph = false
    try files.writeFileString(`${root}/verifier/versions.json`, JSON.stringify(SIGNED))
    const floorsAfterRefusals = (try readPublisherPolicy(policyFile, 1_000)).minimumVersions
    try Effect.try(() => assert.deepStrictEqual(
      [oneKey, duplicateKey, askedBeforeApproval, unapproved, changed, floorsAfterRefusals],
      ["GraphNotApproved", "DescriptorInvalid", [], "SourceNotApproved", "GraphChanged", FLOORS],
    ))

    asked.length = 0
    const authorized = try authorize(bundleOf(["s1", "s2"]))
    const retried = try authorize(bundleOf(["s1", "s2"]))
    const floors = (try readPublisherPolicy(policyFile, 1_000)).minimumVersions
    const expected = { timestampSha256: sha256(bundleOf(["s1", "s2"]).timestamp), versions: SIGNED, descriptors: ["stable/launcher.json"] }
    try Effect.try(() => assert.deepStrictEqual(
      [authorized, retried, floors, asked],
      [expected, expected, SIGNED, [`approve stable/launcher.json ${descriptorSha256}`, "preflight stable/launcher.json", `approve stable/launcher.json ${descriptorSha256}`, "preflight stable/launcher.json"]],
    ))

    const rollback = (advancePublisherPolicy(policyFile, FLOORS) catch (error) => error._tag)
    const incomplete = (advancePublisherPolicy(policyFile, { ...SIGNED, beta: 0 }) catch (error) => error._tag)
    const kept = (try readPublisherPolicy(policyFile, 1_000)).minimumVersions
    try files.writeFileString(policyFile, "not a database")
    const corrupt = (readPublisherPolicy(policyFile, 1_000) catch (error) => error._tag)
    const parsed = try parseDescriptorJson(DESCRIPTOR)
    const nonInteger = (parseDescriptorJson(encoder.encode('{"sequence":1.5}')) catch (error) => error._tag)
    try Effect.try(() => assert.deepStrictEqual(
      [rollback, incomplete, kept, corrupt, parsed, nonInteger],
      ["FloorsRefused", "PublisherPolicyRefused", SIGNED, "PublisherPolicyUnreadable", { schema: 1, channel: "stable", distribution: "launcher", sequence: 2 }, "DescriptorInvalid"],
    ))
  }
})
