// spec/os/image/signing.md, "Story: Sign a release only with keys I enrolled"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { allDrillsPassed } from "../gen/os__image__signing.effect.vibe"
import {
  TEST_KEYS_MARKER,
  channelDistributionProblems,
  decrypt,
  encodeAvbPublicKey,
  generate,
  loadKeyManifest,
  parseArgs,
  releaseDescriptorProblems,
  releaseRecordProblems,
  signRelease,
  signingRecordOf,
  type SignReleaseOptions,
  type SigningProblem,
} from "../src/image/signing.vibe"
import { fixture, scratch, scratchRepo } from "./support/scratch.vibe"

module node {
  import { execFileSync } from "node:child_process"
  import { createHash } from "node:crypto"
  import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs"
  import { tmpdir } from "node:os"
  import path from "node:path"

  const DEV = "build/make/target/product/security"
  const DEV_DIGEST = "d".repeat(64)
  const MISC = [
    "avb_enable=true",
    "avb_vbmeta_algorithm=SHA256_RSA4096",
    "avb_vbmeta_key_path=external/avb/test/data/testkey_rsa4096.pem",
    "avb_vbmeta_system_key_path=external/avb/test/data/testkey_rsa4096.pem",
    "avb_vbmeta_system_rollback_index_location=1",
    "avb_vbmeta_vendor_key_path=external/avb/test/data/testkey_rsa4096.pem",
    "avb_vbmeta_vendor_rollback_index_location=2",
  ].join("\n")
  const BUILD_PROP = ["ro.system.build.fingerprint=acme/acme_stallion/stallion:17/CP3A/1:user/release-keys", "ro.build.date.utc=1767225600", "ro.build.version.security_patch=2026-01-05", "ro.build.version.release=17"].join("\n")

  /** @throws {never} */
  export function sha256(bytes: Uint8Array | string): string {
    return createHash("sha256").update(bytes).digest("hex")
  }

  function zipBytes(entries: Readonly<Record<string, string | Uint8Array>>): Uint8Array {
    const work = mkdtempSync(path.join(tmpdir(), "eliza-zip-"))
    try {
      for (const [name, content] of Object.entries(entries)) {
        mkdirSync(path.dirname(path.join(work, "tree", name)), { recursive: true })
        writeFileSync(path.join(work, "tree", name), content)
      }
      execFileSync("zip", ["-q", "-X", "-D", "-r", path.join(work, "out.zip"), "."], { cwd: path.join(work, "tree") })
      return readFileSync(path.join(work, "out.zip"))
    } finally {
      rmSync(work, { recursive: true, force: true })
    }
  }

  function apkcerts(rows: readonly (readonly [string, string])[]): string {
    return rows.map(([name, certificate]) => `name="${name}" certificate="${certificate}" private_key="${certificate.replace(/\.x509\.pem$/, ".pk8")}"`).join("\n")
  }

  /** @throws {Error} when zip cannot write the archive */
  export function targetFiles(extraCertificates: readonly (readonly [string, string])[] = []): Uint8Array {
    const rows: (readonly [string, string])[] = [["Launcher.apk", `${DEV}/platform.x509.pem`], ["Settings.apk", `${DEV}/testkey.x509.pem`], ["Prebuilt.apk", "PRESIGNED"], ["Tests.apk", `${DEV}/testkey.x509.pem`], ...extraCertificates]
    return zipBytes({
      "META/misc_info.txt": MISC,
      "META/apkcerts.txt": apkcerts(rows),
      "META/apexkeys.txt": `name="com.example.module.apex" public_key="system/apex/key.avbpubkey" private_key="system/apex/key.pem" container_certificate="${DEV}/testkey.x509.pem" container_private_key="${DEV}/testkey.pk8"`,
      "SYSTEM/build.prop": BUILD_PROP,
      "SYSTEM/app/Launcher/Launcher.apk": zipBytes({ CERT: DEV_DIGEST }),
      "SYSTEM/priv-app/Settings/Settings.apk": zipBytes({ CERT: DEV_DIGEST }),
      "SYSTEM/app/Prebuilt/Prebuilt.apk": zipBytes({ CERT: "e".repeat(64) }),
      "SYSTEM/apex/com.example.module.apex": zipBytes({ CERT: DEV_DIGEST, apex_pubkey: "test payload key" }),
      ...Object.fromEntries(extraCertificates.map(([name]) => [`PRODUCT/app/${name}`, zipBytes({ CERT: DEV_DIGEST })])),
    })
  }

  /** @throws {never} */
  export function json(text: string): unknown {
    try {
      return JSON.parse(text)
    } catch {
      return undefined
    }
  }
}
import { json, sha256, targetFiles } from node

const PASSPHRASE = "correct horse battery staple 2026\n"
const RSA = ["releasekey", "platform", "shared", "media", "networkstack", "sdk_sandbox", "bluetooth", "nfc", "apex"]
const MANIFEST = {
  schemaVersion: 1,
  reviewedAt: "2026-11-01",
  keys: [
    ...RSA.map((name) => ({ name, kind: "x509-pk8", bits: 4096, storage: "offline-encrypted", rotatable: false })),
    { name: "apex_payload", kind: "avb-rsa", bits: 4096, storage: "offline-encrypted" },
    { name: "avb", kind: "avb-rsa", bits: 4096, storage: "offline-encrypted" },
    { name: "manifest", kind: "ed25519", storage: "offline-encrypted" },
    { name: "acme_app", kind: "x509-pk8", bits: 4096, storage: "offline-encrypted", rotatable: "only through an APK signature scheme v3 rotation lineage", subject: "CN=Acme" },
  ],
}

function kinds(problems: readonly SigningProblem[]): string[] {
  return problems.map((problem) => (problem.kind === "Descriptor" || problem.kind === "Channel" ? `${problem.kind}:${problem.problem}` : problem.kind))
}

effect function failure<A, E, R>(run: A!E!R) {
  return (effect { try run; return undefined } catch (error) => error)
}

effect function tagOf<A, E extends { readonly _tag: string }, R>(run: A!E!R) {
  return (effect { try run; return "Succeeded" } catch (error) => error._tag)
}

it.effect("Run the key ceremony from my own manifest, decrypt only what it recorded, and refuse unsafe outputs (spec/os/image/signing.md, \"Story: Sign a release only with keys I enrolled\"; \"The key set comes only from the consumer manifest, as x509-pk8 or avb-rsa keys of RSA-4096 or ed25519 keys\"; \"Keys are generated and decrypted only into a new owner-only directory outside every work tree, under an owner-only passphrase of at least 20 characters\"; \"A key is decrypted only when the fingerprints list it and its private half and public identity match what the ceremony recorded\")", effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const work = try scratch("signing-keys")
    const pass = path.join(work, "pass")
    try files.writeFileString(pass, PASSPHRASE, { mode: 0o600 })
    const manifest = path.join(work, "keys.json")
    try files.writeFileString(manifest, JSON.stringify(MANIFEST))
    const loaded = try loadKeyManifest(manifest)
    assert.strictEqual(loaded.keys.length, 13)
    assert.strictEqual(loaded.keys.find((key) => key.name === "acme_app")?.subject, "CN=Acme")

    const keys = path.join(work, "ceremony")
    assert.strictEqual(try tagOf(parseArgs(["--output", keys, "--passphrase-file", pass, "--test-keys"])), "KeyArgumentsRefused", "there is no built-in key list")
    const generated = try generate(try parseArgs(["--output", keys, "--passphrase-file", pass, "--manifest", manifest, "--test-keys"]))
    assert.isTrue(generated.fingerprints.testKeys)
    assert.strictEqual(generated.fingerprints.keys.length, 13)
    assert.isTrue(try files.exists(path.join(keys, TEST_KEYS_MARKER)))
    assert.strictEqual((try files.stat(keys)).mode & 0o777, 0o700)
    assert.strictEqual((try files.stat(path.join(keys, "platform.pk8.enc"))).mode & 0o077, 0)
    assert.match(try files.readFileString(path.join(keys, "avb.pem.enc")), /^-----BEGIN ENCRYPTED PRIVATE KEY-----/)
    assert.notInclude(try files.readFileString(path.join(keys, "fingerprints.json")), "PRIVATE KEY")
    const avb = generated.fingerprints.keys.find((key) => key.name === "avb")
    assert.strictEqual(sha256(try files.readFile(path.join(keys, "avb_pkmd.bin"))), avb?.avbPublicKeySha256)
    assert.include(generated.fingerprints.keys.find((key) => key.name === "platform")?.subject ?? "", "TEST-ONLY platform")

    const repo = try scratchRepo("signing-repo", { "README.txt": "a work tree\n" })
    assert.strictEqual(try tagOf(generate(try parseArgs(["--output", path.join(repo.root, "keys"), "--passphrase-file", pass, "--manifest", manifest, "--test-keys"]))), "KeyOutputRefused", "keys never land inside a Git working tree")
    assert.strictEqual(try tagOf(generate(try parseArgs(["--output", keys, "--passphrase-file", pass, "--manifest", manifest, "--test-keys"]))), "KeyOutputRefused", "an existing directory is refused")
    const loosePass = path.join(work, "open-pass")
    try files.writeFileString(loosePass, PASSPHRASE, { mode: 0o644 })
    try files.chmod(loosePass, 0o644)
    assert.strictEqual(try tagOf(generate(try parseArgs(["--output", path.join(work, "k2"), "--passphrase-file", loosePass, "--manifest", manifest, "--test-keys"]))), "KeyOutputRefused", "a group-readable passphrase is refused")
    const briefPass = path.join(work, "short-pass")
    try files.writeFileString(briefPass, "nineteen characters\n", { mode: 0o600 })
    assert.strictEqual(try tagOf(generate(try parseArgs(["--output", path.join(work, "k3"), "--passphrase-file", briefPass, "--manifest", manifest, "--test-keys"]))), "KeyOutputRefused", "a passphrase under 20 characters is refused")
    for (const [name, keyList] of [["weak", [{ name: "avb", kind: "avb-rsa", bits: 2048 }]], ["repeated", [{ name: "releasekey", kind: "x509-pk8", bits: 4096 }, { name: "releasekey", kind: "x509-pk8", bits: 4096 }]], ["empty", []]] as const) {
      const file = path.join(work, `${name}.json`)
      try files.writeFileString(file, JSON.stringify({ schemaVersion: 1, keys: keyList }))
      assert.strictEqual(try tagOf(loadKeyManifest(file)), "KeyManifestRefused", `a ${name} manifest is refused`)
    }
    assert.isFalse(try files.exists(path.join(work, "k2")))

    const plain = path.join(work, "plain")
    const misspelt = path.join(work, "misspelt")
    assert.strictEqual(try tagOf(decrypt({ input: keys, output: misspelt, passphraseFile: pass, only: "releasekey,platfrom" })), "KeyDecryptionRefused")
    assert.isFalse(try files.exists(misspelt), "a misspelled --only name decrypts nothing")
    const decrypted = try decrypt({ input: keys, output: plain, passphraseFile: pass })
    assert.strictEqual(decrypted.written.length, 13)
    assert.isTrue(decrypted.testKeys)
    for (const name of ["platform.pk8", "platform.x509.pem", "avb.pem", "avb_pkmd.bin", "apex_payload.avbpubkey", "manifest.pem"]) {
      const mode = (try files.stat(path.join(plain, name))).mode
      assert.strictEqual(mode & 0o077, 0, `${name} is owner-only`)
    }
    assert.match(try files.readFileString(path.join(plain, "avb.pem")), /^-----BEGIN PRIVATE KEY-----/)

    const swapped = path.join(work, "swapped")
    try files.copy(keys, swapped)
    try files.copyFile(path.join(keys, "releasekey.x509.pem"), path.join(swapped, "platform.x509.pem"))
    assert.strictEqual(try tagOf(decrypt({ input: swapped, output: path.join(work, "swapped-plain"), passphraseFile: pass, only: "platform" })), "KeyDecryptionRefused", "a private key whose certificate was swapped is not decrypted")
    try files.remove(path.join(swapped, "fingerprints.json"))
    const recorded = json(try files.readFileString(path.join(keys, "fingerprints.json")))
    const forged = { ...(recorded as object), keys: ((recorded as { keys: { name: string }[] }).keys).map((key) => (key.name === "avb" ? { ...key, avbPublicKeySha256: "0".repeat(64) } : key)) }
    try files.writeFileString(path.join(swapped, "fingerprints.json"), JSON.stringify(forged))
    assert.strictEqual(try tagOf(decrypt({ input: swapped, output: path.join(work, "forged-plain"), passphraseFile: pass, only: "avb" })), "KeyDecryptionRefused", "a key whose AVB public key differs from the recorded fingerprint is not decrypted")
  }
})

it.effect("Encode AVB public keys byte-for-byte as avbtool does (spec/os/image/signing.md, \"Verified boot is signed with SHA256_RSA4096 and chains exactly vbmeta_system and vbmeta_vendor\")", effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const vectors = json(try files.readFileString(try path.fromFileUrl(new URL("./fixtures/avb-known-answer-vectors.json", import.meta.url)))) as { vectors: { bits: number; avbtoolSha256: string; publicKeyPem: string }[] }
    assert.isAbove(vectors.vectors.length, 0)
    for (const vector of vectors.vectors) assert.strictEqual(sha256(try encodeAvbPublicKey(vector.publicKeyPem)), vector.avbtoolSha256, `RSA-${vector.bits}`)
    assert.strictEqual(try tagOf(encodeAvbPublicKey("not a key")), "AvbKeyRefused")
  }
})

it.effect("Sign target files only with enrolled keys, verify every re-signed package before the update package, and record outputs by digest (spec/os/image/signing.md, \"Story: Sign a release only with keys I enrolled\"; \"An unmapped APK, APEX or verified-boot key refuses signing\"; \"The update package is built only after every re-signed APK and APEX verifies with a release certificate\"; \"The release record binds the target files, the signed outputs and the certificates by digest and carries no key material\"; \"A release descriptor is refused while a field is unset, a signer or AVB key is unpinned, the lock hash differs or the lock is development-only\"; \"A channel signs only for its product and device, under a pinned OTA certificate and the descriptor's AVB key, with downgrades refused\"; \"The key directory used for signing is owner-only, outside every work tree, and gets the token-backed signing options all together or not at all\")", effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const work = try scratch("signing-release")
    const pass = path.join(work, "pass")
    try files.writeFileString(pass, PASSPHRASE, { mode: 0o600 })
    const manifest = path.join(work, "keys.json")
    try files.writeFileString(manifest, JSON.stringify(MANIFEST))
    const ceremony = try generate(try parseArgs(["--output", path.join(work, "ceremony"), "--passphrase-file", pass, "--manifest", manifest, "--test-keys"]))
    const keysDir = (try decrypt({ input: ceremony.output, output: path.join(work, "keys"), passphraseFile: pass })).target
    const certificate = (name: string) => ceremony.fingerprints.keys.find((key) => key.name === name)?.certificateSha256 ?? ""
    const avbKey = ceremony.fingerprints.keys.find((key) => key.name === "avb")?.avbPublicKeySha256 ?? ""
    const payloadKey = ceremony.fingerprints.keys.find((key) => key.name === "apex_payload")?.avbPublicKeySha256 ?? ""
    const releasetools = try fixture("aosp-releasetools")
    for (const tool of ["sign_target_files_apks", "ota_from_target_files", "apksigner"]) try files.chmod(path.join(releasetools, tool), 0o755)
    const calls = path.join(releasetools, "calls.jsonl")

    const root = try scratch("signing-root")
    const lock = JSON.stringify({ schemaVersion: 1, profiles: { pixel10a: { developmentOnly: false } } })
    const channel = {
      schema: 1,
      channel: "stable",
      product: "acme_stallion",
      device: "stallion",
      otaCertificateSha256: certificate("releasekey"),
      avbPublicKeySha256: avbKey,
      downgradeAllowed: false,
      recovery: { stockFactoryImage: { filename: "stallion-factory.zip", sha256: "f".repeat(64) } },
      drills: { signedUpdate: "not run", interruptedUpdate: "not run", compatibleRollback: "not run", stockRecovery: "not run" },
    }
    const descriptor = {
      schema: 1,
      product: "acme_stallion",
      sourceLock: { file: "aosp.lock.json", sha256: sha256(lock) },
      signer: {
        applicationCertificateSha256: certificate("acme_app"),
        platformCertificateSha256: certificate("platform"),
        releaseCertificates: Object.fromEntries(["shared", "media", "networkstack", "sdk_sandbox", "bluetooth", "nfc", "apex"].map((name) => [name, certificate(name)])),
        apexPayloadAvbPublicKeySha256: payloadKey,
      },
      avb: { algorithm: "SHA256_RSA4096", publicKeySha256: avbKey, vbmetaKey: "avb.pem", publicKeyMetadata: "avb_pkmd.bin", chainedPartitions: ["vbmeta_system", "vbmeta_vendor"] },
      ota: { channel: "channel.json" },
    }
    const composition = {
      schemaVersion: 1,
      target: "pixel10a",
      sourceProfile: "pixel10a",
      vendorDirectory: "acme",
      productName: "acme_stallion",
      model: "Acme",
      brand: "Acme",
      manufacturer: "Acme",
      releaseConfig: "bp4a",
      launcher: { moduleName: "AcmeHome", packageName: "com.acme.home" },
      pixelConfig: { moduleName: "AcmeConfig", packageName: "com.acme.config", mimeType: "vnd.android.cursor.dir/vnd.acme.flags" },
    }
    try files.writeFileString(path.join(root, "aosp.lock.json"), lock)
    try files.writeFileString(path.join(root, "channel.json"), JSON.stringify(channel))
    try files.writeFileString(path.join(root, "release.json"), JSON.stringify(descriptor))
    try files.writeFileString(path.join(root, "product.json"), JSON.stringify(composition))
    const unsigned = path.join(work, "unsigned-target_files.zip")
    try files.writeFile(unsigned, try Effect.try(() => targetFiles()))
    const options = (out: string, overrides: Partial<SignReleaseOptions> = {}): SignReleaseOptions => ({
      root,
      descriptorFile: "release.json",
      productFile: "product.json",
      targetFiles: unsigned,
      targetFilesSha256: "",
      keysDir,
      releasetools,
      out: path.join(work, out),
      ...overrides,
    })
    const targetSha = sha256(try files.readFile(unsigned))

    const plan = try signRelease({ ...options("dry"), targetFilesSha256: targetSha, dryRun: true })
    assert.strictEqual(plan.kind, "DryRun")
    if (plan.kind === "DryRun") {
      assert.deepStrictEqual(plan.problems.map((problem) => problem.detail), [], "a release with enrolled keys has no problems")
      const signArgs = plan.commands[0]?.args ?? []
      for (const flag of ["--avb_vbmeta_system_key", "--avb_vbmeta_vendor_key", "--extra_apks", "--extra_apex_payload_key", "--package_key"]) assert.include(signArgs, flag)
      assert.include(signArgs, "SHA256_RSA4096")
    }
    assert.isFalse(try files.exists(calls), "a dry run runs nothing")

    const vendorTarget = path.join(work, "vendor-target_files.zip")
    try files.writeFile(vendorTarget, try Effect.try(() => targetFiles([["Vendor.apk", "vendor/acme/security/vendorkey.x509.pem"]])))
    const unmapped = try failure(signRelease(options("unmapped", { targetFiles: vendorTarget, targetFilesSha256: sha256(try files.readFile(vendorTarget)) })))
    assert.strictEqual(unmapped?._tag, "SigningRefused")
    if (unmapped?._tag === "SigningRefused") assert.deepStrictEqual(unmapped.problems.map((problem) => problem.kind === "Unmapped" ? problem.key : problem.kind), ["apk:vendor/acme/security/vendorkey"])
    assert.isFalse(try files.exists(path.join(work, "unmapped")), "nothing is signed while a key is unmapped")
    assert.isFalse(try files.exists(calls))

    try files.writeFileString(path.join(releasetools, "mock.json"), JSON.stringify({ skip: ["Settings.apk"] }))
    const leftover = try failure(signRelease(options("leftover", { targetFilesSha256: targetSha })))
    assert.strictEqual(leftover?._tag, "SignedOutputRefused")
    if (leftover?._tag === "SignedOutputRefused") assert.deepStrictEqual(leftover.problems.map((problem) => problem.kind === "Package" ? problem.entry : problem.kind), ["SYSTEM/priv-app/Settings/Settings.apk"])
    try files.writeFileString(path.join(releasetools, "mock.json"), JSON.stringify({ keepApexKey: true }))
    const testPayload = try failure(signRelease(options("payload", { targetFilesSha256: targetSha })))
    assert.strictEqual(testPayload?._tag, "SignedOutputRefused")
    if (testPayload?._tag === "SignedOutputRefused") assert.include(testPayload.message, "APEX payload key")
    const refusedCalls = (try files.readFileString(calls)).trim().split("\n").map((line) => (json(line) as string[])[0])
    assert.deepStrictEqual(refusedCalls, ["sign_target_files_apks", "sign_target_files_apks"], "no update package is built after a refused signed target-files")
    try files.remove(path.join(releasetools, "mock.json"))
    try files.remove(calls)

    const signed = try signRelease(options("release", { targetFilesSha256: targetSha }))
    assert.strictEqual(signed.kind, "Signed")
    const recordText = try files.readFileString(path.join(work, "release", "release-record.json"))
    const record = json(recordText) as { verifiedBoot: { rollbackIndexes: { partition: string; location: number }[]; publicKeySha256: string }; artifacts: { ota: { sha256: string } }; certificates: Record<string, string>; problems: string[] }
    assert.deepStrictEqual(record.problems, [])
    assert.deepStrictEqual(record.verifiedBoot.rollbackIndexes.map((row) => [row.partition, row.location]), [["vbmeta", 0], ["vbmeta_system", 1], ["vbmeta_vendor", 2]])
    assert.strictEqual(record.verifiedBoot.publicKeySha256, avbKey)
    assert.strictEqual(record.artifacts.ota.sha256, sha256(try files.readFile(path.join(work, "release", "ota.zip"))))
    assert.strictEqual(record.certificates.releasekey, certificate("releasekey"))
    assert.notInclude(recordText, "PRIVATE KEY")
    assert.notInclude(recordText, "Qualified")
    assert.deepStrictEqual(releaseRecordProblems(record, signingRecordOf(record)), [])
    assert.strictEqual(sha256(try files.readFile(path.join(work, "release", "avb_pkmd.bin"))), avbKey)
    if (signed.kind === "Signed") assert.include(signed.distributionProblems.map((problem) => problem.detail).join("\n"), "--test-keys")
    assert.deepStrictEqual((try files.readFileString(calls)).trim().split("\n").map((line) => (json(line) as string[])[0]), ["sign_target_files_apks", "ota_from_target_files"])
    const tampered = { ...record, artifacts: { ...record.artifacts, ota: { sha256: "0".repeat(64) } }, releaseQualified: false }
    assert.deepStrictEqual(releaseRecordProblems(tampered, signingRecordOf(record)).map((problem) => problem.kind === "Record" ? problem.field : problem.kind).sort(), ["QualificationClaim", "UpdatePackageDigest"])

    try files.writeFileString(path.join(root, "unset.json"), JSON.stringify({ ...descriptor, signer: { ...descriptor.signer, applicationCertificateSha256: "UNSET" }, releaseQualified: true }))
    try files.writeFileString(path.join(root, "downgrade.json"), JSON.stringify({ ...channel, downgradeAllowed: true }))
    try files.writeFileString(path.join(root, "downgrade-release.json"), JSON.stringify({ ...descriptor, ota: { channel: "downgrade.json" } }))
    const unset = try signRelease({ ...options("unset", { descriptorFile: "unset.json", targetFilesSha256: targetSha }), dryRun: true })
    if (unset.kind === "DryRun") assert.deepStrictEqual(kinds(unset.problems).filter((kind) => kind.startsWith("Descriptor")).sort(), ["Descriptor:EvidenceClaimed", "Descriptor:FieldUnset", "Descriptor:SignerUnpinned"])
    const downgrade = try signRelease({ ...options("downgrade", { descriptorFile: "downgrade-release.json", targetFilesSha256: targetSha }), dryRun: true })
    if (downgrade.kind === "DryRun") assert.deepStrictEqual(kinds(downgrade.problems), ["Channel:DowngradeAllowed"])
    try files.writeFileString(path.join(root, "aosp.lock.json"), JSON.stringify({ schemaVersion: 1, profiles: { pixel10a: { developmentOnly: true } } }))
    assert.deepStrictEqual((try releaseDescriptorProblems({ root, descriptorFile: "release.json", sourceProfile: "pixel10a" })).map((problem) => problem.kind === "Descriptor" ? problem.problem : problem.kind).sort(), ["LockDevelopmentOnly", "LockHashDiffers"])
    try files.writeFileString(path.join(root, "aosp.lock.json"), lock)

    const helper = path.join(work, "helper")
    try files.writeFileString(helper, "#!/bin/sh\nexit 0\n", { mode: 0o755 })
    const partial = try signRelease({ ...options("partial", { targetFilesSha256: targetSha, pkcs11Config: helper }), dryRun: true })
    if (partial.kind === "DryRun") assert.include(partial.problems.map((problem) => problem.detail).join("\n"), "token-backed signing needs")
    const token = try signRelease({ ...options("token", { targetFilesSha256: targetSha, pkcs11Config: helper, avbSigningHelper: helper, payloadSigner: helper, payloadSignerSignatureSize: "512" }), dryRun: true })
    assert.strictEqual(token.kind === "DryRun" ? token.signingMode : "", "managed")
    if (token.kind === "DryRun") {
      assert.include(token.commands[0]?.args ?? [], "--payload_signer")
      assert.include(token.problems.map((problem) => problem.detail).join("\n"), "holds platform.pk8", "a token-backed key directory holds no private key")
    }
    const repo = try scratchRepo("signing-keys-repo", { "README.txt": "a work tree\n" })
    const inside = path.join(repo.root, "keys")
    try files.copy(keysDir, inside)
    const leaked = try signRelease({ ...options("leaked", { targetFilesSha256: targetSha, keysDir: inside }), dryRun: true })
    if (leaked.kind === "DryRun") assert.include(leaked.problems.map((problem) => problem.detail).join("\n"), "inside the Git working tree")
  }
})

it.effect("Distribute a channel only with all four drills passed, a retained known-good release and release keys (spec/os/image/signing.md, \"A channel is distributable only with a retained known-good release, release keys, and the signed-update, interrupted-update, compatible-rollback and stock-recovery drills all passed\")", effect () => {
  const passed = { signedUpdate: "passed", interruptedUpdate: "passed", compatibleRollback: "passed", stockRecovery: "passed" }
  const knownGood = { knownGoodRelease: { buildFingerprint: "acme/acme_stallion/stallion:17/CP3A/1:user/release-keys", otaSha256: "a".repeat(64) } }
  assert.deepStrictEqual(channelDistributionProblems({ drills: passed, recovery: knownGood }, false), [])
  assert.deepStrictEqual(channelDistributionProblems({ drills: { ...passed, stockRecovery: "failed" }, recovery: knownGood }, false).map((problem) => problem.detail), ["the stockRecovery drill is failed, not passed"])
  assert.strictEqual(channelDistributionProblems({ drills: passed, recovery: knownGood }, true).length, 1)
  assert.strictEqual(channelDistributionProblems({ drills: passed, recovery: { knownGoodRelease: { buildFingerprint: "UNSET", otaSha256: "a".repeat(64) } } }, false).length, 1)
  assert.strictEqual(channelDistributionProblems({}, false).length, 5)
  assert.strictEqual(Object.keys(allDrillsPassed).length, 4)
})
