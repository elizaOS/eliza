// spec/os/build/runtimePayload.md, "Story: Ship the agent with a pinned Node runtime"; spec/os/build/runtimePayload.md, "Story: Ship only the files my build listed"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { FetchHttpClient } from "effect/http"
import { INVENTORY_ASSET, PayloadRefused, stageRuntimePayload, type StageRuntimePayload } from "../src/build/runtime-payload.vibe"
import type { NodeLockFile } from "../src/build/runtime-payload.schema.vibe"
import { startCheck, type DeviceFile, type Extraction, type Observed } from "../gen/os__build__runtimePayload.effect.vibe"
import { fixture, scratch, writeTree } from "./support/scratch.vibe"

module node {
  import { execFileSync } from "node:child_process"
  import { createHash } from "node:crypto"
  import { createServer, type Server } from "node:http"
  import type { AddressInfo } from "node:net"
  import path from "node:path"
  import { crc32 } from "node:zlib"
  import { compileAdapter } from "./drivers/jvm-adapter.ts"

  /** @throws {never} */
  export const sha256 = (bytes: Uint8Array | string) => createHash("sha256").update(bytes).digest("hex")

  /** @throws {never} */
  export function storedZip(entries: Readonly<Record<string, Uint8Array>>): Uint8Array {
    const locals: Buffer[] = []
    const centrals: Buffer[] = []
    let offset = 0
    for (const [name, data] of Object.entries(entries)) {
      const nameBytes = Buffer.from(name)
      const local = Buffer.alloc(30)
      local.writeUInt32LE(0x04034b50, 0)
      local.writeUInt16LE(20, 4)
      local.writeUInt32LE(crc32(data), 14)
      local.writeUInt32LE(data.length, 18)
      local.writeUInt32LE(data.length, 22)
      local.writeUInt16LE(nameBytes.length, 26)
      const central = Buffer.alloc(46)
      central.writeUInt32LE(0x02014b50, 0)
      central.writeUInt16LE(20, 4)
      central.writeUInt16LE(20, 6)
      central.writeUInt32LE(crc32(data), 16)
      central.writeUInt32LE(data.length, 20)
      central.writeUInt32LE(data.length, 24)
      central.writeUInt16LE(nameBytes.length, 28)
      central.writeUInt32LE(offset, 42)
      locals.push(local, nameBytes, Buffer.from(data))
      centrals.push(central, nameBytes)
      offset += 30 + nameBytes.length + data.length
    }
    const directory = Buffer.concat(centrals)
    const end = Buffer.alloc(22)
    end.writeUInt32LE(0x06054b50, 0)
    end.writeUInt16LE(Object.keys(entries).length, 8)
    end.writeUInt16LE(Object.keys(entries).length, 10)
    end.writeUInt32LE(directory.length, 12)
    end.writeUInt32LE(offset, 16)
    return new Uint8Array(Buffer.concat([...locals, directory, end]))
  }

  export interface Release {
    readonly server: Server
    readonly base: string
  }

  export async function serveRelease(assets: Readonly<Record<string, Uint8Array>>): Promise<Release> {
    const server = createServer((request, response) => {
      const asset = assets[request.url ?? ""]
      response.writeHead(asset === undefined ? 404 : 200, { "content-type": "application/zip" })
      response.end(asset)
    })
    await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve))
    return { server, base: `http://127.0.0.1:${(server.address() as AddressInfo).port}` }
  }

  export async function closeRelease(release: Release): Promise<void> {
    await new Promise<void>((resolve) => release.server.close(() => resolve()))
  }

  /** @throws {Error} */
  export function payloadStartErrors(assets: string, nativeLibraries: string, runtime: string): string[] {
    const main = "ai.eliza.os.agent.PayloadStart"
    const java = process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", "java") : "java"
    const out = execFileSync(java, ["-cp", compileAdapter(main), main, assets, nativeLibraries, runtime, "7", "arm64-v8a"], { encoding: "utf8", timeout: 120_000 })
    return out.split("\n").filter((line) => line !== "")
  }
}
import { closeRelease, payloadStartErrors, serveRelease, sha256, storedZip, type Release } from node

const VERSION = "26.13.1"
const NDK = "29.0.14206865"
const ARM_ASSET = "/android-node/node-android-arm64-v8a.zip"
const X86_ASSET = "/android-node/node-android-x86_64.zip"
const BUILD_COMMIT = "c".repeat(40)
const NOTICE_PATH = "assets/agent/notices/node/LICENSE"
const NOTICE_TEXT = "Node.js fixture license\n"

function runtimeZip(elf: Uint8Array, notice?: string): Uint8Array {
  const entries = { "manifest.json": new TextEncoder().encode("{}"), "libeliza_node.so": elf }
  return storedZip(notice === undefined ? entries : { ...entries, LICENSE: new TextEncoder().encode(notice) })
}

effect function release(assets: Readonly<Record<string, Uint8Array>>) {
  return try acquireRelease(tryPromise(() => serveRelease(assets)), (served: Release) => orDie(tryPromise(() => closeRelease(served))))
}

effect function lockFile(root: string, entries: typeof NodeLockFile.Type.entries) {
  const path = try Path.Path
  const file = path.join(root, "node.lock.json")
  try writeTree(root, {
    "node.lock.json": JSON.stringify({ version: VERSION, ndk: NDK, apiLevel: 29, sourceSha256: "e".repeat(64), buildCommit: BUILD_COMMIT, entries }),
  })
  return file
}

effect function refusal(options: StageRuntimePayload) {
  return (effect { try stageRuntimePayload(options); return "PayloadAdmitted" } catch (error) => match (error) {
    when PayloadRefused: `${error.reason} ${error.subject}`;
    default: error._tag;
  })
}

effect function pinnedBundle(root: string, agent: string, manifest: Readonly<Record<string, unknown>>, pin: string) {
  const path = try Path.Path
  const dir = path.join(root, `bundle-${pin}`)
  try writeTree(dir, { "agent.mjs": agent, "manifest.json": JSON.stringify({ ...manifest, workflowWorkerSha256: pin }) })
  return dir
}

it.effect("Ship the agent with a pinned Node runtime and only the files my build listed: stage a two-file bundle and refuse every broken rule (spec/os/build/runtimePayload.md, \"Story: Ship the agent with a pinned Node runtime\"; spec/os/build/runtimePayload.md, \"A Node runtime file is used only when it matches its ABI's lock entry\"; spec/os/build/runtimePayload.md, \"The APK carries exactly one Node runtime for each targeted ABI and none for another\"; spec/os/build/runtimePayload.md, \"Story: Ship only the files my build listed\"; spec/os/build/runtimePayload.md, \"The inventory lists every staged payload file once, by digest and size, and nothing else\"; spec/os/build/runtimePayload.md, \"The bundle carries no Node-API addon and a cloud-only payload carries no model or inference library\"; spec/os/build/runtimePayload.md, \"The workflow worker is staged only under the digest the bundle manifest pins\"; spec/os/build/runtimePayload.md, \"A payload is admitted only when every staging rule holds\")", effect () => {
  provide NodeServices.layer, FetchHttpClient.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const fixtures = try fixture("runtime-payload")
    const root = try scratch("payload")
    const bundleDir = path.join(fixtures, "bundle")
    const elf = try files.readFile(path.join(fixtures, "node-arm64-v8a.so"))
    const x86Elf = try files.readFile(path.join(fixtures, "node-x86_64.so"))
    const armZip = runtimeZip(elf, NOTICE_TEXT)
    const x86Zip = runtimeZip(x86Elf, NOTICE_TEXT)
    const differentNoticeZip = runtimeZip(x86Elf, "Different notice\n")
    const noNoticeZip = runtimeZip(elf)
    const served = try release({ [ARM_ASSET]: armZip, [X86_ASSET]: x86Zip, "/elsewhere/node.zip": armZip, "/different-notice.zip": differentNoticeZip, "/no-notice.zip": noNoticeZip })
    const url = `${served.base}${ARM_ASSET}`
    const armEntry = { abi: "arm64-v8a", sha256: sha256(elf), url, archiveSha256: sha256(armZip) } as const
    const x86Entry = { abi: "x86_64", sha256: sha256(x86Elf), url: `${served.base}${X86_ASSET}`, archiveSha256: sha256(x86Zip) } as const
    const lock = try lockFile(root, [armEntry, x86Entry])
    const base = { abi: ["arm64-v8a"] as const, bundleDir, lock, runtimes: [{ kind: "fetched", abi: "arm64-v8a", url }] as const }
    const out = (name: string) => path.join(root, "out", name)

    const staged = try stageRuntimePayload({ ...base, output: out("admitted") })
    const main = path.join(staged.output, "android", "app", "src", "main")
    const inventoryText = try files.readFileString(path.join(main, INVENTORY_ASSET))
    const agentText = try files.readFileString(path.join(bundleDir, "agent.mjs"))
    const manifestText = try files.readFileString(path.join(bundleDir, "manifest.json"))
    assert.deepStrictEqual(try Effect.try(() => JSON.parse(inventoryText)), {
      schema: 1,
      files: [
        { path: "assets/agent/agent.mjs", sha256: sha256(agentText), size: agentText.length },
        { path: "assets/agent/manifest.json", sha256: sha256(manifestText), size: manifestText.length },
        { path: NOTICE_PATH, sha256: sha256(NOTICE_TEXT), size: NOTICE_TEXT.length },
        { path: "lib/arm64-v8a/libeliza_node.so", sha256: sha256(elf), size: elf.length },
      ],
    })
    assert.strictEqual(try files.readFileString(path.join(main, NOTICE_PATH)), NOTICE_TEXT)
    assert.strictEqual((try files.stat(path.join(main, "jniLibs", "arm64-v8a", "libeliza_node.so"))).mode & 0o777, 0o755)
    assert.strictEqual(staged.workflowWorker, undefined)
    assert.strictEqual(try refusal({ ...base, output: out("admitted") }), "PayloadOutputExists")

    const abis = ["arm64-v8a", "x86_64"] as const
    const bothAbis = try stageRuntimePayload({ ...base, abi: abis, output: out("both-abis") })
    assert.deepStrictEqual(bothAbis.inventory.filter((row) => row.path === NOTICE_PATH), [{ path: NOTICE_PATH, sha256: sha256(NOTICE_TEXT), size: NOTICE_TEXT.length }])

    const wrongDigest = try lockFile(path.join(root, "wrong-digest"), [{ ...armEntry, sha256: "0".repeat(64) }])
    assert.strictEqual(try refusal({ ...base, lock: wrongDigest, output: out("digest") }), "RuntimeNotPinned arm64-v8a")
    assert.strictEqual(try refusal({ ...base, runtimes: [{ kind: "fetched", abi: "arm64-v8a", url: `${served.base}/elsewhere/node.zip` }], output: out("url") }), "RuntimeNotPinned arm64-v8a")
    const missingArchive = try lockFile(path.join(root, "missing-archive"), [{ ...armEntry, url: `${served.base}/missing.zip` }])
    assert.strictEqual(try refusal({ ...base, lock: missingArchive, runtimes: [], output: out("missing") }), "RuntimeFetchFailed")
    const changedArchive = try lockFile(path.join(root, "changed-archive"), [{ ...armEntry, url: `${served.base}/no-notice.zip` }])
    assert.strictEqual(try refusal({ ...base, lock: changedArchive, runtimes: [], output: out("archive-digest") }), "RuntimeNotPinned arm64-v8a")
    const noNotice = try lockFile(path.join(root, "no-notice"), [{ ...armEntry, url: `${served.base}/no-notice.zip`, archiveSha256: sha256(noNoticeZip) }])
    assert.strictEqual(try refusal({ ...base, lock: noNotice, runtimes: [], output: out("no-notice") }), "RuntimeFetchFailed")
    const differingNotice = try lockFile(path.join(root, "different-notice"), [armEntry, { ...x86Entry, url: `${served.base}/different-notice.zip`, archiveSha256: sha256(differentNoticeZip) }])
    assert.strictEqual(try refusal({ ...base, abi: abis, lock: differingNotice, output: out("different-notice") }), "PayloadInputInvalid")

    const built = path.join(root, "built")
    try writeTree(built, {
      "libeliza_node.so": elf,
      "node-runtime.json": JSON.stringify({ schema: 1, abi: "arm64-v8a", version: VERSION, ndk: NDK, apiLevel: 29, sha256: sha256(elf) }),
    })
    assert.strictEqual(try refusal({ ...base, runtimes: [...base.runtimes, { kind: "built", dir: built }], output: out("second") }), "RuntimeLayoutInvalid arm64-v8a")
    assert.strictEqual(try refusal({ ...base, nativeLibraries: [{ abi: "arm64-v8a", file: path.join(built, "libeliza_node.so"), sha256: sha256(elf) }], output: out("library") }), "RuntimeLayoutInvalid arm64-v8a")
    const builtX86 = path.join(root, "built-x86")
    try writeTree(builtX86, {
      "libeliza_node.so": x86Elf,
      "node-runtime.json": JSON.stringify({ schema: 1, abi: "x86_64", version: VERSION, ndk: NDK, apiLevel: 29, sha256: sha256(x86Elf) }),
    })
    assert.strictEqual(try refusal({ ...base, runtimes: [...base.runtimes, { kind: "built", dir: builtX86 }], output: out("untargeted") }), "RuntimeLayoutInvalid x86_64")
    const onlyBuilt = try stageRuntimePayload({ ...base, runtimes: [{ kind: "built", dir: built }], output: out("built") })
    assert.deepStrictEqual(onlyBuilt.inventory.filter((row) => row.path === NOTICE_PATH), [])
    assert.strictEqual(try refusal({ abi: base.abi, bundleDir, runtimes: [{ kind: "built", dir: built }], output: out("packaged-lock") }), "RuntimeNotPinned arm64-v8a")

    const addonBundle = path.join(root, "addon-bundle")
    try writeTree(addonBundle, { "agent.mjs": agentText, "manifest.json": manifestText, "native/sqlite.node": "addon" })
    assert.strictEqual(try refusal({ ...base, bundleDir: addonBundle, output: out("addon") }), "ForbiddenContent assets/agent/native/sqlite.node")
    const noticeBundle = path.join(root, "notice-bundle")
    try writeTree(noticeBundle, { "agent.mjs": agentText, "manifest.json": manifestText, "notices/node/LICENSE": "Bundle-supplied notice" })
    assert.strictEqual(try refusal({ ...base, bundleDir: noticeBundle, runtimes: [{ kind: "built", dir: built }], output: out("notice-collision") }), "PayloadInputInvalid")

    const models = path.join(root, "models")
    try writeTree(models, { "small.gguf": "weights" })
    assert.strictEqual(try refusal({ ...base, extraAssets: [{ dir: models, name: "models", files: [{ path: "small.gguf", sha256: sha256("weights") }] }], output: out("model") }), "ForbiddenContent assets/models/small.gguf")

    const sounds = path.join(root, "sounds")
    try writeTree(sounds, { "chime.ogg": "chime", "extra.ogg": "unlisted" })
    assert.strictEqual(try refusal({ ...base, extraAssets: [{ dir: sounds, name: "sounds", files: [{ path: "chime.ogg", sha256: sha256("chime") }] }], output: out("unlisted") }), "InventoryInexact assets/sounds/extra.ogg")
    const withSounds = try stageRuntimePayload({ ...base, extraAssets: [{ dir: sounds, name: "sounds", files: [{ path: "chime.ogg", sha256: sha256("chime") }, { path: "extra.ogg", sha256: sha256("unlisted") }] }], output: out("sounds") })
    assert.deepStrictEqual(withSounds.inventory.filter((row) => row.path.startsWith("assets/sounds/")).map((row) => row.path), ["assets/sounds/chime.ogg", "assets/sounds/extra.ogg"])

    const worker = path.join(root, "worker")
    try writeTree(worker, { "worker.mjs": "export const worker = 1\n", "lib/helper.mjs": "export {}\n" })
    const manifest: Record<string, unknown> = try Effect.try(() => JSON.parse(manifestText))
    const workerSha = sha256("export const worker = 1\n")
    const workflowWorker = { dir: worker, executable: "worker.mjs" }
    assert.strictEqual(try refusal({ ...base, bundleDir: try pinnedBundle(root, agentText, manifest, "1".repeat(64)), workflowWorker, output: out("worker-mismatch") }), "WorkerNotPinned workflow worker")
    assert.strictEqual(try refusal({ ...base, bundleDir: try pinnedBundle(root, agentText, manifest, workerSha), output: out("pin-only") }), "WorkerNotPinned workflow worker")
    assert.strictEqual(try refusal({ ...base, workflowWorker, output: out("worker-only") }), "WorkerNotPinned workflow worker")
    const withWorker = try stageRuntimePayload({ ...base, bundleDir: try pinnedBundle(root, agentText, manifest, workerSha), workflowWorker, output: out("worker") })
    assert.deepStrictEqual(withWorker.workflowWorker, { runtimeDir: "agent/workflow-worker", executable: "worker.mjs", sha256: workerSha })
    assert.includeMembers(withWorker.inventory.map((row) => row.path), ["assets/agent/workflow-worker/worker.mjs", "assets/agent/workflow-worker/lib/helper.mjs"])

    const leftovers = (try files.readDirectory(path.join(root, "out"))).sort()
    assert.deepStrictEqual(leftovers, ["admitted", "both-abis", "built", "sounds", "worker"])
  }
})

it.effect('Start the agent only on an intact payload: a damaged extraction is replaced once from the APK, and a payload that still differs fails the start (spec/os/build/runtimePayload.md, "Story: Start the agent only on an intact payload"; spec/os/build/runtimePayload.md, "The agent spawns only when every inventory digest matches on the device"; spec/os/build/runtimePayload.md, "A damaged extracted file is extracted again once before the start fails")', effect () => {
  provide NodeServices.layer, FetchHttpClient.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const fixtures = try fixture("runtime-payload")
    const root = try scratch("payload-start")
    const elf = try files.readFile(path.join(fixtures, "node-arm64-v8a.so"))
    const zip = runtimeZip(elf, NOTICE_TEXT)
    const url = `${(try release({ [ARM_ASSET]: zip })).base}${ARM_ASSET}`
    const staged = try stageRuntimePayload({ abi: ["arm64-v8a"], bundleDir: path.join(fixtures, "bundle"), lock: try lockFile(root, [{ abi: "arm64-v8a", sha256: sha256(elf), url, archiveSha256: sha256(zip) }]), runtimes: [{ kind: "fetched", abi: "arm64-v8a", url }], output: path.join(root, "out") })
    const main = path.join(staged.output, "android", "app", "src", "main")
    const apkAgent = path.join(main, "assets", "agent", "agent.mjs")
    const library = path.join(main, "jniLibs", "arm64-v8a", "libeliza_node.so")
    const agentText = try files.readFileString(apkAgent)
    const releases = path.join(root, "runtime", "releases")
    try files.makeDirectory(path.join(releases, "6-stale"), { recursive: true })
    const start = () => Effect.try(() => payloadStartErrors(path.join(main, "assets"), path.dirname(library), path.join(root, "runtime")))
    const found = (bytes: Uint8Array | string): Observed => ({ tag: "Present", observedSha256: sha256(bytes), observedSize: bytes.length })
    const device = (agent: string, node: Uint8Array | string): DeviceFile[] => [
      { path: "assets/agent/agent.mjs", sha256: sha256(agentText), size: agentText.length, extracted: true, observed: found(agent) },
      { path: "lib/arm64-v8a/libeliza_node.so", sha256: sha256(elf), size: elf.length, extracted: false, observed: found(node) },
    ]
    const none: Extraction = { tag: "NotExtracted" }
    const current: Extraction = { tag: "ExtractedFor", versionCode: 7 }

    assert.deepStrictEqual([startCheck(none, 7, false, [], false), startCheck(current, 7, true, device(agentText, elf), false)], ["ExtractPayload", "PayloadReady"])
    assert.deepStrictEqual(try start(), [])
    const extractions = try files.readDirectory(releases)
    assert.deepStrictEqual(extractions.map((name) => name.slice(0, 2)), ["7-"])
    const extractedAgent = path.join(releases, extractions[0] ?? "", "agent", "agent.mjs")
    assert.strictEqual(try files.readFileString(path.join(releases, extractions[0] ?? "", NOTICE_PATH.slice("assets/".length))), NOTICE_TEXT)

    try writeTree(releases, { [`${extractions[0]}/agent/agent.mjs`]: "damaged", [`${extractions[0]}/agent/unlisted.mjs`]: "unlisted" })
    assert.deepStrictEqual([startCheck(current, 7, false, device("damaged", elf), true), startCheck(current, 7, true, device(agentText, elf), false)], ["ExtractPayload", "PayloadReady"])
    assert.deepStrictEqual(try start(), [])
    assert.deepStrictEqual([try files.readFileString(extractedAgent), try files.exists(path.join(path.dirname(extractedAgent), "unlisted.mjs"))], [agentText, false])

    try files.writeFileString(extractedAgent, "damaged")
    try files.remove(apkAgent)
    assert.deepStrictEqual([startCheck(current, 7, false, device("damaged", elf), false), startCheck(none, 7, true, [], false)], ["ExtractPayload", "PayloadFailed"])
    assert.deepStrictEqual(try start(), ["Missing assets/agent/agent.mjs in the APK"])
    try files.writeFileString(apkAgent, agentText)
    assert.deepStrictEqual(try start(), [])

    try files.writeFileString(library, "other")
    assert.deepStrictEqual(startCheck(current, 7, false, device(agentText, "other"), false), "PayloadFailed")
    assert.deepStrictEqual(try start(), [`Size of lib/arm64-v8a/libeliza_node.so differs: expected ${elf.length}, found 5`])
  }
}, 180_000)
