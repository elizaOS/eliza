// spec/os/build/sourceIntegrity.md, "Story: Build and register only the plugins my host selected"; spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device in and keep its key"; spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device out"; spec/cloud/identity/sessions.md, "Story: Stay signed in"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { consumerBuildNames, consumerImageNames, consumerPathNames, consumerPaths, withdrawnFromConsumers } from "../gen/os.effect.vibe"
import * as buildEntry from "../src/build/index.vibe"
import * as imageEntry from "../src/image/index.vibe"
import { scratch, writeTree } from "./support/scratch.vibe"

module node {
  import { execFileSync } from "node:child_process"
  import path from "node:path"
  import { orgJsonAdapterClasspath } from "./drivers/jvm-adapter.ts"

  const ACCOUNT_JOURNEY = "ai.eliza.plugins.securestore.nativeonly.CloudDeviceAccountJourney"
  const ACCOUNT_SOURCES = ["android/secure-store/src/main/java", "test/fixtures/cloud-account", "test/drivers/java/media-checks/android-stubs"]
  const java = process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", "java") : "java"

  export async function walkDeviceAccount(): Promise<unknown> {
    const classpath = await orgJsonAdapterClasspath(ACCOUNT_JOURNEY, ACCOUNT_SOURCES)
    return JSON.parse(execFileSync(java, ["-cp", classpath, ACCOUNT_JOURNEY], { encoding: "utf8", timeout: 120_000 }))
  }
}
import { walkDeviceAccount } from node

interface ConsumerHost {
  readonly generateAndroidConsumerHost: (options: Readonly<Record<string, unknown>>) => void
}

const CAPACITOR = { name: "capacitor-android", source: { root: "dependencies", path: "@capacitor/android/capacitor" } }
const IDENTITY = { appId: "example.consumer", appName: "Consumer", version: "1.0", versionCode: 1 }
const PROFILE = {
  schema: 1,
  sdk: { min: 29, target: 36, compile: 36 },
  releaseMinify: false,
  modules: [CAPACITOR],
  dependencies: [],
  manifest: { root: "consumer", path: "main.xml" },
  flavors: [{ name: "standalone" }],
}

effect function generateFor(consumerRoot: string, dependencyRoot: string, profile: object = PROFILE, runtimeDirectory?: string) {
  const path = try Path.Path
  const host: ConsumerHost = try Effect.promise(() => import(path.join(import.meta.dirname, "../android/consumer-host.mjs")))
  try writeTree(consumerRoot, { "main.xml": '<manifest xmlns:android="http://schemas.android.com/apk/res/android"><application/></manifest>' })
  const options = { consumerRoot, upstreamRoot: path.resolve(import.meta.dirname, "../../.."), dependencyRoot, output: path.join(consumerRoot, "android"), identity: IDENTITY, profile, runtimeDirectory }
  return (effect {
    try Effect.try({ try: () => host.generateAndroidConsumerHost(options), catch: (cause) => (cause instanceof Error ? cause.message : String(cause)) })
    return "generated"
  } catch (message) => message)
}

it.effect('Build and register only the plugins my host selected: a parent pnpm workspace admits its packages only when it holds the consumer (spec/os/build/sourceIntegrity.md, "The host profile chooses native modules and names their source roots")', effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const workspace = try scratch("workspace")
    const outsider = try scratch("outsider")
    try writeTree(workspace, {
      "pnpm-workspace.yaml": "packages: []\n",
      "packages/capacitor-android/package.json": JSON.stringify({ name: "@capacitor/android" }),
      "packages/capacitor-android/capacitor/build.gradle": "",
      "apps/host/node_modules/@capacitor/android": { kind: "symlink", target: path.join(workspace, "packages/capacitor-android") },
    })
    const dependencyRoot = path.join(workspace, "apps/host/node_modules")

    assert.match(try generateFor(outsider, dependencyRoot), /dependency link escapes/)
    assert.isFalse(try files.exists(path.join(outsider, "android")))

    const member = path.join(workspace, "apps/consumer")
    assert.strictEqual(try generateFor(member, dependencyRoot), "generated")
    assert.isTrue(try files.exists(path.join(member, "android/.eliza-consumer-host.json")))

    const payload = path.join(member, "runtime")
    try writeTree(member, {
      "runtime/android/app/src/main/assets/agent/agent.mjs": "",
      "runtime/android/app/src/main/assets/agent/inventory.json": "{}",
      "agent/host.json": JSON.stringify({
        schema: 1, service: "example.consumer.EmbeddedService", persistMemory: false,
        notification: { channel: "Agent", title: "Agent", text: "Running" },
        cloud: { baseUrl: "https://cloud.example.invalid", smallModel: "small", largeModel: "large" },
        routes: [{ method: "GET", path: "/api/health", stream: false }],
      }),
      "agent/character.json": JSON.stringify({ name: "Fixture", system: "You are the fixture agent." }),
      "agent/policy.json": JSON.stringify({ schema: 1, actions: { allowed: { REPLY: {} } }, plugins: { load: [] } }),
    })
    const embedded = { ...PROFILE, embeddedAgent: {
      host: { root: "consumer", path: "agent/host.json" },
      character: { root: "consumer", path: "agent/character.json" },
      policy: { root: "consumer", path: "agent/policy.json" },
    } }
    const java = path.join(member, "android/eliza-embedded-agent/src/main/java")
    const copied = [
      "ai/eliza/plugins/agent/runtime/AndroidRuntimeDirectories.java",
      "ai/eliza/plugins/securestore/nativeonly/JsonCredentialSlots.java",
      "ai/eliza/plugins/securestore/nativeonly/CloudDeviceAccount.java",
      "ai/eliza/plugins/securestore/nativeonly/MailReadRoutes.java",
      "ai/eliza/plugins/securestore/nativeonly/PasswordBackupApproval.java",
      "ai/eliza/plugins/securestore/nativeonly/CloudPasswordBackup.java",
      "ai/eliza/plugins/securestore/google/NativeGoogleAuthorization.java",
    ]
    assert.strictEqual(try generateFor(member, dependencyRoot, embedded, payload), "generated")
    for (const entry of copied) assert.isTrue(try files.exists(path.join(java, entry)), entry)
    const canonical = ["sign-in", "secure-store", "agent-service", "runtime-files"].map((module) => ({
      name: `eliza-${module}`, source: { root: "upstream", path: `packages/os/android/${module}` },
    }))
    assert.strictEqual(try generateFor(member, dependencyRoot, { ...embedded, modules: [CAPACITOR, ...canonical] }, payload), "generated")
    for (const entry of copied) assert.isFalse(try files.exists(path.join(java, entry)), entry)
    const normalized = try files.readFileString(path.join(member, "android/.eliza-consumer-profile.json"))
    assert.match(normalized, /"embeddedAgentProjects":\s*\[\s*"eliza-runtime-files",\s*"eliza-secure-store"\s*\]/)
    assert.isTrue(try files.exists(path.join(java, "ai/eliza/plugins/agent/embedded/EmbeddedAgentService.java")))
  }
})

it.effect('Keep building my product against the paths and names I import (spec/os/index.md, "Story: Keep building my product against the paths and names I import"; spec/os/index.md, "Every promised path and name is still published")', effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const root = path.resolve(import.meta.dirname, "..")
    const paths: string[] = []
    for (const file of consumerPaths) {
      if (try files.exists(path.join(root, file))) paths.push(file)
    }
    const names: string[] = []
    for (const promised of consumerPathNames) {
      const [file = "", name = ""] = promised.split("#")
      const loaded: Readonly<Record<string, unknown>> = try Effect.promise(() => import(path.join(root, file)))
      if (name in loaded) names.push(promised)
    }
    assert.deepStrictEqual(
      { paths: withdrawnFromConsumers(paths, consumerPaths), names: withdrawnFromConsumers(names, consumerPathNames), build: withdrawnFromConsumers(Object.keys(buildEntry), consumerBuildNames), image: withdrawnFromConsumers(Object.keys(imageEntry), consumerImageNames) },
      { paths: [], names: [], build: [], image: [] },
    )
  }
})

it.effect('The packaged device account keeps mail on a lease the agent never holds: it rotates the lease once for every waiting reader, presents the same refresh again after a lost reply, renews its key only past half its life, signs out completely when the lease is revoked, and keeps the lease of a native Google or email sign-in on the canonical routes (spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device in and keep its key"; spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device out"; spec/cloud/identity/sessions.md, "Story: Stay signed in"; spec/os/signIn/flow.md, "Story: Sign in with a code, Google or a second factor")', effect () => {
  const seen = try tryPromise(() => walkDeviceAccount())
  try Effect.try(() => assert.deepStrictEqual(seen, {
    signedIn: true,
    legacyVaultBindingMatches: true,
    renewedBeforeHalfLife: false,
    refreshesForFourReaders: 1,
    readersShareOneAccess: true,
    scopedMailRead: [true, true, 200],
    search: "200 limit=10&q=from%3Aanna%20is%3Aunread",
    created: '200 tea-2026-11-22 {"summary":"Tea"}',
    deleted: '200 "v7"',
    redirectNotFollowed: true,
    refusedRoutes: 5,
    lostReply: [true, true, 200, 0],
    renewedAfterHalfLife: true,
    vaultBindingAfterRenewalRestart: true,
    renewal: [true, true, true, 1],
    afterRenewal: [0, 200, 0],
    signedOut: [401, true, true, true, 1],
    dutiesAfterRefusedRevoke: 0,
    signedInAgain: true,
    leaseOutlivesKey: [true, true],
    lapsedKeyRevokedByLease: ["lease 204", true, true, 0],
    nativeSignedIn: true,
    nativeMail: 200,
    nativeRenewed: true,
    nativeRenewal: [true, true, true, 200],
    nativeSignedOut: [true, true, 0],
    nativeNeverUsedWorkerRoutes: true,
    cookieOrOrigin: false,
    newEnrollmentSurvivedLateRefreshRefusal: true,
    newEnrollmentSurvivedLateRenewalRefusal: true,
  }))
}, 300_000)
