// spec/os/android/files/storage.md, "Story: Change files only as reviewed"; spec/os/android/files/storage.md, "Story: Get back exactly what I trashed"; spec/os/android/files/handoff.md, "Story: Open or share a file without granting write"; spec/os/android/files/storageWatch.md, "Story: Watch a folder with one live observer"
import { assert, it } from "@effect/vitest"
import { BridgeUnavailable, MalformedReply } from "../src/bridges/bridge.vibe"
import { filesClient, filesPlugin } from "../src/bridges/files.vibe"

module android {
  import { execFileSync } from "node:child_process"
  import { createHash, randomUUID } from "node:crypto"
  import path from "node:path"
  import type { ElizaFilesPlugin, FileOutcomeRow, TrashEntry } from "../src/bridges/definitions/files.ts"
  import { compileAdapter } from "./drivers/jvm-adapter.ts"

  const BROWSING = "ai.eliza.files.StorageBrowsingCheck"
  const java = process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", "java") : "java"

  export function storageBrowsing(): string {
    return execFileSync(java, ["-cp", compileAdapter(BROWSING), BROWSING], { encoding: "utf8", timeout: 120_000 }).trim()
  }

  interface Stored {
    readonly version: number
    readonly size: number
  }

  export interface Device {
    files: Map<string, Stored>
    trash: Map<string, TrashEntry>
    unlisted: Set<string>
    malformed: boolean
    erasures: number
    generation: number
    watching: number
    listeners: Set<() => void>
  }

  /** @throws {never} */
  export function device(paths: readonly string[]): Device {
    return { files: new Map(paths.map((path) => [path, { version: 1, size: 10 }])), trash: new Map(), unlisted: new Set(), malformed: false, erasures: 0, generation: 0, watching: 0, listeners: new Set() }
  }

  /** @throws {never} */
  export function change(phone: Device, path: string) {
    const file = phone.files.get(path)
    if (file !== undefined) phone.files.set(path, { ...file, version: file.version + 1 })
    if (phone.watching > 0 && phone.watching === phone.generation) for (const heard of phone.listeners) heard()
  }

  const parent = (path: string) => (path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "")
  const base = (path: string) => path.slice(path.lastIndexOf("/") + 1)
  const join = (folder: string, name: string) => (folder === "" ? name : `${folder}/${name}`)
  const token = (path: string, file: Stored) => createHash("sha256").update(`${path}:${file.version}:${file.size}`).digest("base64url")

  /** @throws {never} */
  export function androidFiles(phone: Device): ElizaFilesPlugin {
    const current = (path: string, reviewed: readonly string[] | undefined, at: number): FileOutcomeRow | Stored => {
      const file = phone.files.get(path)
      if (file === undefined) return { path, status: "missing" }
      return reviewed !== undefined && reviewed[at] !== token(path, file) ? { path, status: "changed" } : file
    }
    return {
      storageState: async () => (phone.malformed ? { status: "fine" } as never : { status: "ready", access: "granted", legacy: false, volumes: [{ id: "primary", name: "Internal storage", primary: true, free: 100, total: 200 }] }),
      storageRequestAccess: async () => ({ status: "ready", access: "granted", legacy: false }),
      storageList: async ({ path }) => ({ status: "ready", truncated: false, entries: [...phone.files].filter(([at]) => parent(at) === path).map(([at, file]) => ({ path: at, name: base(at), directory: false, mimeType: "text/plain", size: file.size, modified: file.version })) }),
      storageCategory: async () => ({ status: "ready", count: 0, entries: [], truncated: false, folders: [] }),
      storageQuery: async () => ({ status: "ready", entries: [] }),
      storageReviewedIdentities: async ({ paths }) => {
        const tokens = paths.flatMap((path) => { const file = phone.files.get(path); return file === undefined ? [] : [token(path, file)] })
        return tokens.length === paths.length ? { status: "ready", reviewed: tokens } : { status: "changed", message: "A file couldn't be verified. Nothing changed." }
      },
      storageTransfer: async ({ paths, dest, copy, reviewed }) => ({
        status: "ready",
        outcomes: paths.map((path, at): FileOutcomeRow => {
          if (!copy && parent(path) === dest) return { path, status: "unchanged", to: path }
          const found = current(path, reviewed, at)
          if ("status" in found) return found
          const to = join(dest, base(path))
          phone.files.set(to, found)
          if (!copy) phone.files.delete(path)
          return phone.unlisted.has(path) ? { path, status: copy ? "copied" : "moved" } : { path, status: copy ? "copied" : "moved", to }
        }),
      }),
      storageRename: async ({ path, name }) => ({ status: "ready", path: join(parent(path), name) }),
      storageCreateFolder: async ({ parent: folder, name }) => ({ status: "ready", path: join(folder, name) }),
      storageTrash: async ({ paths, reviewed }) => ({
        status: "ready",
        outcomes: paths.map((path, at): FileOutcomeRow => {
          const found = current(path, reviewed, at)
          if ("status" in found) return found
          const id = randomUUID()
          phone.trash.set(id, { id, name: base(path), origin: path, directory: false, mimeType: "text/plain", size: found.size, deletedAt: 1 })
          phone.files.delete(path)
          return { path, status: "trashed", to: id }
        }),
      }),
      storageTrashList: async () => ({ status: "ready", items: [...phone.trash.values()] }),
      storageRestore: async ({ ids }) => ({
        status: "ready",
        outcomes: ids.map((id): FileOutcomeRow => {
          const item = phone.trash.get(id)
          if (item === undefined) return { path: id, status: "missing" }
          phone.trash.delete(id)
          phone.files.set(item.origin, { version: 1, size: item.size })
          return { path: id, status: "restored", to: item.origin }
        }),
      }),
      storageEmptyTrash: async ({ ids, confirmed }) => {
        phone.erasures += 1
        if (!confirmed) return { status: "confirmation-required", message: "Confirm before deleting permanently." }
        return { status: "ready", count: ids.filter((id) => phone.trash.delete(id)).length }
      },
      storageShare: async ({ paths }) => (paths.every((path) => phone.files.has(path)) ? { status: "opened", count: paths.length } : { status: "missing", message: "This item is no longer there." }),
      storageOpen: async ({ path }) => (phone.files.has(path) ? { status: "opened", count: 1 } : { status: "missing", message: "This item is no longer there." }),
      storageSelect: async ({ path }) => ({ status: "selected", action: "files", selectionId: `selection-${path}`, name: base(path), mimeType: "text/plain", canRename: false }),
      storageWatch: async () => {
        phone.generation += 1
        phone.watching = phone.generation
        return { status: "ready" }
      },
      storageUnwatch: async () => {
        phone.generation += 1
        phone.watching = 0
        return { status: "ready" }
      },
      addListener: async (_event, listener) => {
        const heard = () => listener()
        phone.listeners.add(heard)
        return { remove: async () => { phone.listeners.delete(heard) } }
      },
    }
  }
}
import { androidFiles, change, device, storageBrowsing } from android

effect function refusal(call: () => Promise<unknown>) {
  const { cause } = try flip(tryPromise(() => call()))
  if (cause instanceof MalformedReply) return `malformed ${cause.method}`
  if (cause instanceof BridgeUnavailable) return `unavailable ${cause.plugin}.${cause.method}`
  return cause
}

it.live("Move only what I reviewed, trash and restore it, erase Trash only when I confirm, hand files over read-only and watch a folder (spec/os/android/files/storage.md, \"Story: Change files only as reviewed\"; spec/os/android/files/storage.md, \"Story: Get back exactly what I trashed\"; spec/os/android/files/handoff.md, \"Story: Open or share a file without granting write\"; spec/os/android/files/storageWatch.md, \"Story: Watch a folder with one live observer\")", () => effect {
  const phone = device(["a.txt", "b.txt", "c.txt", "Docs/d.txt"])
  const files = filesClient(androidFiles(phone))
  const state = try promise(() => files.storageState())

  const review = try promise(() => files.storageReviewedIdentities({ paths: ["a.txt", "b.txt"] }))
  change(phone, "b.txt")
  const moved = try promise(() => files.storageTransfer({ paths: ["a.txt", "b.txt"], dest: "Docs", copy: false, reviewed: review.reviewed }))
  const inPlace = try promise(() => files.storageTransfer({ paths: ["Docs/d.txt"], dest: "Docs", copy: false }))
  phone.unlisted.add("c.txt")
  const unacknowledged = try promise(() => files.storageTransfer({ paths: ["c.txt"], dest: "Docs", copy: true }))
  const docs = try promise(() => files.storageList({ path: "Docs" }))

  const trashReview = try promise(() => files.storageReviewedIdentities({ paths: ["Docs/a.txt"] }))
  const trashed = try promise(() => files.storageTrash({ paths: ["Docs/a.txt"], reviewed: trashReview.reviewed }))
  const id = trashed.outcomes?.[0]?.to ?? ""
  const listed = try promise(() => files.storageTrashList())
  const restored = try promise(() => files.storageRestore({ ids: [id] }))
  const afterRestore = try promise(() => files.storageTrashList())

  const again = try promise(() => files.storageTrash({ paths: ["Docs/a.txt"] }))
  const againId = again.outcomes?.[0]?.to ?? ""
  const unconfirmed = try promise(() => files.storageEmptyTrash({ ids: [againId], confirmed: false }))
  const keptUnconfirmed = try promise(() => files.storageTrashList())
  const erasuresBeforeConfirm = phone.erasures
  const erased = try promise(() => files.storageEmptyTrash({ ids: [againId], confirmed: true }))
  const afterErase = try promise(() => files.storageTrashList())

  const shared = try promise(() => files.storageShare({ paths: ["b.txt", "Docs/d.txt"] }))
  const opened = try promise(() => files.storageOpen({ path: "b.txt" }))
  const goneOpen = try promise(() => files.storageOpen({ path: "Docs/a.txt" }))
  const selected = try promise(() => files.storageSelect({ path: "b.txt" }))

  let heard = 0
  const handle = try promise(() => files.addListener("storageChanged", () => { heard += 1 }))
  const watched = try promise(() => files.storageWatch({ path: "Docs" }))
  change(phone, "Docs/d.txt")
  const heardWatching = heard
  const unwatched = try promise(() => files.storageUnwatch())
  change(phone, "Docs/d.txt")
  const heardAfterUnwatch = heard
  try promise(() => handle.remove())

  phone.malformed = true
  const malformed = try refusal(() => files.storageState())
  const absent = try refusal(() => filesClient(filesPlugin("DeviceFiles"), "DeviceFiles").storageState())

  try Effect.try(() => assert.deepStrictEqual(
    { state, reviewedTokens: review.reviewed?.map((value) => value.length), moved, inPlace, unacknowledged, docs: docs.entries?.map((entry) => entry.path), trashed: trashed.outcomes?.map((row) => row.status), listed: listed.items?.map((item) => [item.id === id, item.origin]), restored, afterRestore, unconfirmed, keptUnconfirmed: keptUnconfirmed.items?.length, erasuresBeforeConfirm, erased, afterErase, shared, opened, goneOpen, selected, watched, heardWatching, unwatched, heardAfterUnwatch, listeners: phone.listeners.size, malformed, absent },
    {
      state: { status: "ready", access: "granted", legacy: false, volumes: [{ id: "primary", name: "Internal storage", primary: true, free: 100, total: 200 }] },
      reviewedTokens: [43, 43],
      moved: { status: "ready", outcomes: [{ path: "a.txt", status: "moved", to: "Docs/a.txt" }, { path: "b.txt", status: "changed" }] },
      inPlace: { status: "ready", outcomes: [{ path: "Docs/d.txt", status: "unchanged", to: "Docs/d.txt" }] },
      unacknowledged: { status: "ready", outcomes: [{ path: "c.txt", status: "failed" }] },
      docs: ["Docs/d.txt", "Docs/a.txt", "Docs/c.txt"],
      trashed: ["trashed"],
      listed: [[true, "Docs/a.txt"]],
      restored: { status: "ready", outcomes: [{ path: id, status: "restored", to: "Docs/a.txt" }] },
      afterRestore: { status: "ready", items: [] },
      unconfirmed: { status: "confirmation-required", message: "Confirm before deleting permanently." },
      keptUnconfirmed: 1,
      erasuresBeforeConfirm: 0,
      erased: { status: "ready", count: 1 },
      afterErase: { status: "ready", items: [] },
      shared: { status: "opened", count: 2 },
      opened: { status: "opened", count: 1 },
      goneOpen: { status: "missing", message: "This item is no longer there." },
      selected: { status: "selected", action: "files", selectionId: "selection-b.txt", name: "b.txt", mimeType: "text/plain", canRename: false },
      watched: { status: "ready" },
      heardWatching: 1,
      unwatched: { status: "ready" },
      heardAfterUnwatch: 1,
      listeners: 0,
      malformed: "malformed storageState",
      absent: "unavailable DeviceFiles.storageState",
    },
  ))
})

it.effect('Browse hidden entries only when asked, never the Trash, and move or copy into another volume (spec/os/android/files/storage.md, "A listing or folder walk shows dot entries only when asked, and never the Trash under any spelling"; spec/os/android/files/storage.md, "A move into another volume takes the copy path, and its copy is written and cleaned up on that volume")', () => effect {
  const answer = try Effect.try(() => storageBrowsing())
  try Effect.try(() => assert.match(answer, /^StorageBrowsingCheck checks: (18|21)$/))
}, 180_000)
