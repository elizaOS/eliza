// spec/os/image/sourceLock.md, "Story: Build only from the source I pinned"; spec/os/image/listener.md, "Story: Put the wake listener in an image only as reviewed"; spec/os/image/listener.md, "Story: Activate my listener only from an enrolled record for this image"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { listenerGates, type ListenerRequest } from "../gen/os__image__listener.effect.vibe"
import { parseDigest, readApkSigner } from "../src/image/apk.vibe"
import { prepareListenerSystemui, prepareListenerSystemuiSet, stageListener, verifyListenerQualification, verifyListenerSystemui } from "../src/image/listener.vibe"
import { packageParts, wakeWords } from "../src/image/listener-admission.vibe"
import { admitPatchEnvelope, assertStockVendorApi, loadProfile, verifySource } from "../src/image/source-lock.vibe"
import { androidTools, buildApk, testSigner } from "./support/android-tools.ts"
import { commitTree, fixture, git, scratch, writeTree, type Tree } from "./support/scratch.vibe"

module node {
  import { createHash } from "node:crypto"

  /** @throws {never} */
  export function sha256(value: string | Uint8Array) {
    return createHash("sha256").update(value).digest("hex")
  }
}
import { sha256 } from node

const tools = androidTools()
const skipped = tools.kind === "missing" ? tools.reason : null
const tagObject = "7a9e46ba6ed424f922a3457f4964e67e0b966201"
const manifestTag = { tag: "android-17.0.0_r1", tagObject, url: "https://android.example.invalid/platform/manifest" }
const asFile = (path: string, content: string) => ({ path, sizeBytes: new TextEncoder().encode(content).length, sha256: sha256(content) })

effect function repoAt(directory: string, tree: Tree) {
  const files = try FileSystem.FileSystem
  try files.makeDirectory(directory, { recursive: true })
  try git(directory, ["init", "--quiet", "--initial-branch=main"])
  return try commitTree(directory, tree, "Pin resettable platform source")
}

effect function checkout(work: string) {
  const path = try Path.Path
  const board = 'name: "RELEASE_BOARD_API_LEVEL"\nvalue: { string_value: "202604" }\n'
  const boardConfiguration = "build/release/flag_values/rel_fixture/RELEASE_BOARD_API_LEVEL.textproto"
  const stockVendor = "<manifest><sepolicy><version>202604</version></sepolicy></manifest>\n"
  const vendorManifest = "vendor/google_devices/fixture/vintf/vendor/manifest.xml"
  const aosp = path.join(work, "aosp")
  const commit = try repoAt(path.join(aosp, ".repo/manifests"), { "default.xml": "<manifest />\n" })
  const project = "build/release"
  const revision = try repoAt(path.join(aosp, project), { [boardConfiguration.slice(project.length + 1)]: board, "etc/rules": "stable\n" })
  const configuration: Readonly<Record<string, string>> = {
    ".repo/manifest.xml": "<manifest><include name=\"default.xml\" /></manifest>\n",
    ".repo/project.list": `${project}\n`,
  }
  const manifest = { ...manifestTag, commit, configuration: Object.entries(configuration).map(([name, content]) => asFile(name, content)) }
  const projects = [{ path: project, commit: revision }]
  const factoryName = "fixture-factory.zip"
  const factoryBytes = "factory archive bytes\n"
  const inventory = { schema: 1, target: "fixture", device: { codename: "fixture", androidRelease: "17" }, developmentOnly: false, releaseQualified: false,
    manifest, factory: { filename: factoryName, ...asFile(factoryName, factoryBytes) }, projects, overrides: [], ignoredInputs: [],
    generated: { root: "vendor/google_devices/fixture", files: [asFile(vendorManifest, stockVendor)] } }
  const inventoryText = JSON.stringify(inventory)
  const physical = {
    kind: "physical", manifest, targets: ["fixture"], sourceInventory: { path: "sources/fixture.json", sha256: sha256(inventoryText) },
    device: { sourceTarget: "fixture", codename: "fixture", androidRelease: "17", vendorApiLevel: "202604" },
  }
  const virtual = { kind: "virtual", manifest, manifestConfiguration: manifest.configuration, projects, targets: ["cf_x86_64_phone"], developmentOnly: true }
  const lockFile = path.join(work, "aosp.lock.json")
  const factory = path.join(work, factoryName)
  try writeTree(work, { "aosp.lock.json": JSON.stringify({ schemaVersion: 1, profiles: { physical, virtual } }), [factoryName]: factoryBytes, "sources/fixture.json": inventoryText })
  try writeTree(aosp, { ...configuration, [vendorManifest]: stockVendor })
  const profile = try loadProfile({ name: "physical", lockFile })
  return { aosp, project, revision, board, lockFile, options: { profile, sourceRoot: aosp, boardConfiguration, vendorManifest, factory } }
}

it.live('Verify actual release flags against pinned physical and virtual sources without mutating the checkout (spec/os/image/sourceLock.md, "Story: Build only from the source I pinned"; spec/os/image/sourceLock.md, "A physical device matches only with its factory archive and the vendor API level its stock vendor declares"; spec/os/image/sourceLock.md, "A reviewed patch is admitted only when every file has its preimage at the pinned revision and its postimage in the checkout")', effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const work = try scratch("image-source")
    const { aosp, project, revision, board, lockFile, options } = try checkout(work)
    const observed = try verifySource(options)
    assert.deepStrictEqual([observed.state.verdict, observed.problems, observed.state.read.boardApi, observed.releaseQualified], ["Match", [], 202604, false])
    assert.strictEqual((try exit(verifySource({ ...options, factory: undefined })))._tag, "Failure")

    try writeTree(aosp, { [options.boardConfiguration]: board.replace("202604", "202504"), [`${project}/etc/rules`]: "different\n" })
    const dirty = try git(path.join(aosp, project), ["status", "--porcelain"])
    const drifted = try verifySource(options)
    assert.deepStrictEqual(drifted.problems, ["SourceChangeDiffers", "BoardApiDiffers"])
    assert.strictEqual((try exit(assertStockVendorApi(options)))._tag, "Failure")
    assert.strictEqual(try git(path.join(aosp, project), ["status", "--porcelain"]), dirty)
    try writeTree(aosp, { [options.boardConfiguration]: board, [`${project}/etc/rules`]: "stable\n" })

    const patch = "--- a/etc/rules\n+++ b/etc/rules\n@@ -1 +1 @@\n-stable\n+reviewed\n"
    const manifest = JSON.stringify({ schema: 1, baselineLockSha256: observed.state.lock.digest, project, revision, patch: "review.patch", patchSha256: sha256(patch),
      files: [{ path: "etc/rules", beforeSha256: sha256("stable\n"), afterSha256: sha256("reviewed\n") }] })
    try writeTree(work, { "review.patch": patch, "patch.json": manifest, "different.patch": patch })
    const pinned = { name: "review", manifestFile: path.join(work, "patch.json"), manifestSha256: sha256(manifest), patchFile: path.join(work, "review.patch") }
    try writeTree(aosp, { [`${project}/etc/rules`]: "reviewed\n" })
    assert.deepStrictEqual((try verifySource(options)).problems, ["SourceChangeDiffers"])
    const admitted = try admitPatchEnvelope(options, pinned)
    assert.deepStrictEqual([admitted.source.state.verdict, admitted.source.state.patches.map((one) => one.name)], ["Match", ["review"]])
    assert.strictEqual((try exit(admitPatchEnvelope(options, { ...pinned, patchFile: path.join(work, "different.patch") })))._tag, "Failure")
    try writeTree(work, { "review.patch": "tampered\n" })
    assert.strictEqual((try exit(admitPatchEnvelope(options, pinned)))._tag, "Failure")

    try writeTree(aosp, { [`${project}/etc/rules`]: "stable\n" })
    const virtual = { profile: try loadProfile({ name: "virtual", lockFile }), sourceRoot: aosp }
    const real = try verifySource(virtual)
    assert.deepStrictEqual([real.state.verdict, real.state.lock.developmentOnly, real.state.lock.targets], ["Match", true, ["cf_x86_64_phone"]])
    try writeTree(aosp, { ".repo/local_manifests/extra.xml": "<manifest />\n" })
    assert.deepStrictEqual((try verifySource(virtual)).problems, ["ManifestConfigurationDiffers"])
    assert.isFalse(try files.exists(path.join(aosp, "review.patch")))
  }
})

it.live(`Stage reviewed SystemUI patches away from the source and refuse exclusive combinations (spec/os/image/listener.md, "A listener is staged only from a matched source that carries the chip and ops SystemUI patches"; spec/os/image/provisioning.md, "Listener activation enables exactly the launcher's disabled plain assist activity and, for power voice, its protected power child, given the power bundle without the assist bundle and the long-press overlay")`, effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const original = try fixture("sense-systemui")
    const work = try scratch("listener-systemui")
    const source = path.join(work, "aosp")
    try files.makeDirectory(source)
    try files.copy(original, path.join(source, "frameworks", "base"))
    const before = try verifyListenerSystemui(source, "before", "chip")
    assert.strictEqual(before.files.length, 9)
    const inside = path.join(source, "refused-output")
    assert.strictEqual((try exit(prepareListenerSystemui(source, inside, "chip")))._tag, "Failure")
    assert.isFalse(try files.exists(inside))
    const output = path.join(work, "chip")
    const staged = try prepareListenerSystemui(source, output, "chip")
    assert.deepStrictEqual(try verifyListenerSystemui(output, "after", "chip"), staged)
    assert.deepStrictEqual(try verifyListenerSystemui(source, "before", "chip"), before)
    assert.strictEqual((try exit(prepareListenerSystemui(source, output, "chip")))._tag, "Failure")
    const both = path.join(work, "both")
    assert.strictEqual((try exit(prepareListenerSystemuiSet(source, both, ["assist", "power"])))._tag, "Failure")
    assert.isFalse(try files.exists(both))
    const power = path.join(work, "power")
    assert.strictEqual((try prepareListenerSystemui(source, power, "power")).files.length, 2)
    assert.strictEqual((try verifyListenerSystemui(power, "after", "power")).files.length, 2)
    const together = try prepareListenerSystemuiSet(source, path.join(work, "chip-power"), ["chip", "power"])
    assert.deepStrictEqual(together.map((one) => [one.bundle, one.state]), [["chip", "after"], ["power", "after"]])
  }
})

it.live.skipIf(skipped !== null)(`Bind qualification to observed APK, package and source bytes${skipped === null ? "" : ` (skipped: ${skipped})`} (spec/os/image/listener.md, "Story: Activate my listener only from an enrolled record for this image"; spec/os/image/listener.md, "A qualification record counts only when its bytes are the enrolled ones and it names every input of this image")`, effect () => {
  provide NodeServices.layer {
    if (tools.kind === "missing") return
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const work = try scratch("listener-qualification")
    const { options } = try checkout(work)
    const source = (try verifySource(options)).state
    const name = "com.example.launcher"
    const signer = try Effect.try(() => testSigner(tools, work, "launcher"))
    const manifest = (id: string) => `<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="${id}"><application android:label="fixture"/></manifest>\n`
    const { apk: launcher } = try Effect.try(() => buildApk(tools, { directory: work, name: "launcher", manifest: manifest(name), signer }))
    const { apk: listener } = try Effect.try(() => buildApk(tools, { directory: work, name: "listener", manifest: manifest(`${name}.sense`), signer }))
    const launcherDigest = sha256(try files.readFile(launcher))
    const listenerDigest = sha256(try files.readFile(listener))
    const launcherSigner = try readApkSigner(launcher, { apksigner: tools.apksigner })
    const listenerSigner = try readApkSigner(listener, { apksigner: tools.apksigner })
    const product = path.join(work, "product")
    try writeTree(product, { "product.mk": "# Existing product\n" })
    const refused = try Effect.flip(stageListener({ apk: listener, componentPackage: `${name}.sense`, launcher: { apk: launcher, descriptor: path.join(work, "launcher.json") },
      moduleName: "Listener", output: product, wakeNames: ["hey"], policyCertificate: path.join(work, "public.pem"), sdkCommit: "e".repeat(40), source: options }))
    assert.strictEqual(refused._tag, "ListenerAdmissionRefused")
    assert.strictEqual(try files.readFileString(path.join(product, "product.mk")), "# Existing product\n")
    assert.isFalse(try files.exists(path.join(product, "listener")))

    const signing = parseDigest(signer.certificateSha256)
    assert.deepStrictEqual([launcherSigner, listenerSigner], [{ tag: "OneSigner", certificate: signing }, { tag: "OneSigner", certificate: signing }])
    const sdkCommit = "e".repeat(40)
    const sepolicy = sha256("policy bytes")
    const launcherDescriptor = sha256(JSON.stringify({ packageName: name, apkSha256: launcherDigest }))
    const listenerDescriptor = sha256(JSON.stringify({ packageName: `${name}.sense`, apkSha256: listenerDigest }))
    const request: Omit<ListenerRequest, "qualification" | "enrolledQualification"> = {
      launcherPackage: name, launcherSigner: signing, launcherApk: parseDigest(launcherDigest), launcherDescriptor: parseDigest(launcherDescriptor),
      descriptor: { tag: "ListenerReviewed", packageName: packageParts(`${name}.sense`), apk: parseDigest(listenerDigest),
        certificate: signing, bytes: parseDigest(listenerDescriptor) },
      listener: { packageName: packageParts(`${name}.sense`), sha256: parseDigest(listenerDigest), signer: listenerSigner,
        buildType: "ReleaseBuild", requested: [], layout: "ZipAligned", speech: "SpeechNotPinned" },
      wakeNames: wakeWords(["hey"]), overlay: { roles: [], microphoneToggle: false, powerAssistant: false, powerMenuChord: false, gesturesUntouched: false },
      policyCertificate: signing, sepolicy: parseDigest(sepolicy), sdkCommit,
    }
    const record = (policy: string) => JSON.stringify({ schemaVersion: 1, qualified: true,
      inputs: { packageName: `${name}.sense`, launcher: launcherDigest, listener: listenerDigest, launcherDescriptor, listenerDescriptor,
        certificate: signer.certificateSha256, sourceLock: source.lock.digest, sdkCommit, sepolicy: policy, patches: [] },
      gates: listenerGates.map((gate) => ({ gate, result: { status: "pass", evidenceSha256: sha256(gate) } })) })
    const file = path.join(work, "qualification.json")
    try files.writeFileString(file, record(sepolicy))
    const pin = { file, sha256: sha256(record(sepolicy)) }
    const reviewed = try verifyListenerQualification(pin, request, source, true)
    assert.strictEqual(reviewed.qualification.tag, "QualificationRecord")
    assert.strictEqual((try exit(verifyListenerQualification({ ...pin, sha256: "f".repeat(64) }, request, source, true)))._tag, "Failure")
    try files.writeFileString(file, record("0".repeat(64)))
    assert.strictEqual((try exit(verifyListenerQualification({ file, sha256: sha256(record("0".repeat(64))) }, request, source, true)))._tag, "Failure")
  }
}, 240_000)
