// spec/os/android/camera.md, "Story: See the live view I opened"; spec/os/android/camera.md, "Story: Capture with the camera only from the live view"
import { assert, it } from "@effect/vitest"
import {
  cameraAccessDenied,
  cameraClient,
  cameraPlugin,
  createCameraSession,
  keepCapture,
  scanDimensionsAdmitted,
  scanExportRetryable,
  scanImageAdmitted,
  scanPagesRefusal,
  SCAN_LIMITS,
  type CameraClient,
  type VideoResult,
} from "../../src/bridges/camera.vibe"

module android {
  import { CapacitorException } from "@capacitor/core"
  import { execFileSync } from "node:child_process"
  import path from "node:path"
  import type { CameraGrant, CameraPlugin, CameraPreviewResult, VideoCaptureOptions, VideoResult } from "../../src/bridges/definitions/camera.ts"
  import { compileAdapter } from "../drivers/jvm-adapter.ts"

  const ASPECT_RATIOS = "ai.eliza.plugins.camera.CaptureAspectRatiosTest"
  const java = process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", "java") : "java"

  export function aspectRatioChecks(): string {
    return execFileSync(java, ["-cp", compileAdapter(ASPECT_RATIOS), ASPECT_RATIOS], { encoding: "utf8", timeout: 120_000 }).trim()
  }

  export interface Device {
    camera: CameraGrant
    microphone: CameraGrant
    previewing: boolean
    recording: boolean
    zoom: number
    holdPreviews: boolean
    previewLostOnRecord: boolean
    video: unknown
    calls: string[]
    held: (() => void)[]
    waiting: (() => void)[]
  }

  /** @throws {never} */
  export function device(changes: Partial<Device> = {}): Device {
    return {
      camera: "granted",
      microphone: "granted",
      previewing: false,
      recording: false,
      zoom: 1,
      holdPreviews: false,
      previewLostOnRecord: false,
      video: { path: "/data/user/0/app/cache/clip-1.mp4", duration: 3.2, width: 1920, height: 1080, fileSize: 524288, mimeType: "video/mp4" },
      calls: [],
      held: [],
      waiting: [],
      ...changes,
    }
  }

  /** @throws {never} */
  export function previewHeld(phone: Device): Promise<void> {
    return phone.held.length > 0 ? Promise.resolve() : new Promise((resolve) => phone.waiting.push(resolve))
  }

  /** @throws {never} */
  export function answerHeld(phone: Device): void {
    for (const answer of phone.held.splice(0)) answer()
  }

  /** @throws {never} */
  export function androidCamera(phone: Device): CameraPlugin {
    const rejection = (message: string, code: string) => Object.assign(new CapacitorException(message), { code })
    const receipt: CameraPreviewResult = { width: 1280, height: 720, deviceId: "back", minZoom: 1, maxZoom: 8, zoom: 1, hasFlash: true, flash: "off" }
    const live = async (method: string) => {
      phone.calls.push(method)
      if (!phone.previewing) throw rejection("Camera preview is not active", "CAMERA_INACTIVE")
    }
    return {
      checkCameraPermission: async () => ({ camera: phone.camera }),
      requestCameraPermission: async () => ({ camera: phone.camera }),
      getDevices: async () => ({ devices: [{ deviceId: "back", label: "Camera 0 (back)", direction: "back", hasFlash: true, hasZoom: true, maxZoom: 8, supportedResolutions: [{ width: 1920, height: 1080 }], supportedFrameRates: [30] }] }),
      startPreview: async () => {
        phone.calls.push("startPreview")
        if (phone.camera !== "granted") {
          phone.camera = "denied"
          throw rejection("Camera permission denied", "CAMERA_PERMISSION_DENIED")
        }
        if (!phone.holdPreviews) {
          phone.previewing = true
          return receipt
        }
        return new Promise<CameraPreviewResult>((resolve) => {
          phone.held.push(() => {
            phone.previewing = true
            resolve(receipt)
          })
          for (const wake of phone.waiting.splice(0)) wake()
        })
      },
      stopPreview: async () => {
        phone.calls.push("stopPreview")
        phone.previewing = false
      },
      setCaptureMode: async () => live("setCaptureMode"),
      switchCamera: async () => {
        await live("switchCamera")
        return receipt
      },
      capturePhoto: async (options) => {
        await live("capturePhoto")
        const libraryId = options?.saveToGallery === true ? "m:external_primary:i:42" : undefined
        return { base64: "/9j/AA==", format: "jpeg", width: 1920, height: 1080, ...(libraryId === undefined ? {} : { libraryId }) }
      },
      startRecording: async (options?: VideoCaptureOptions) => {
        await live("startRecording")
        if (options?.audio === true && phone.microphone !== "granted") throw rejection("Microphone permission denied for the requested audio recording", "MICROPHONE_DENIED")
        if (phone.previewLostOnRecord) {
          phone.previewing = false
          throw rejection("Recording did not start and the camera preview stopped", "PREVIEW_STOPPED")
        }
        phone.recording = true
      },
      stopRecording: async () => {
        phone.calls.push("stopRecording")
        if (!phone.recording) throw rejection("Not recording", "NOT_RECORDING")
        phone.recording = false
        return phone.video as VideoResult
      },
      getRecordingState: async () => ({ isRecording: phone.recording, duration: 0, fileSize: 0 }),
      getSettings: async () => ({ settings: { flash: "off", zoom: phone.zoom, focusMode: "continuous", exposureMode: "continuous", exposureCompensation: 0, whiteBalance: "auto" } }),
      setSettings: async () => live("setSettings"),
      setZoom: async ({ zoom }) => {
        await live("setZoom")
        phone.zoom = zoom
      },
      setFocusPoint: async () => live("setFocusPoint"),
      setExposurePoint: async () => live("setExposurePoint"),
      checkPermissions: async () => ({ camera: phone.camera, microphone: phone.microphone, photos: "granted" }),
      requestPermissions: async () => ({ camera: phone.camera, microphone: phone.microphone, photos: "granted" }),
      addListener: async () => ({ remove: async () => {} }),
      removeAllListeners: async () => {},
    }
  }

  export interface Gate {
    readonly passed: Promise<void>
    open(): void
  }

  /** @throws {never} */
  export function gate(): Gate {
    let open = () => {}
    const passed = new Promise<void>((resolve) => { open = resolve })
    return { passed, open: () => open() }
  }
}
import { androidCamera, answerHeld, aspectRatioChecks, device, gate, previewHeld, type Device } from android

interface Host {
  readonly adopted: string[]
  refuseAdoption: boolean
  finishing: number
  failed: number
}

function sessionOn(phone: Device, client: CameraClient, host: Host, registered = true) {
  return createCameraSession({
    camera: client,
    registered: () => registered,
    preview: () => ({ direction: "back" as const }),
    recording: () => ({ audio: true, quality: "high" as const }),
    hooks: {
      recordingSaved: async (video: VideoResult) => {
        if (host.refuseAdoption) throw new Error("The media store did not list the recording")
        host.adopted.push(video.path)
      },
      recordingFinishing: () => {
        host.finishing += 1
      },
      recordingFailed: () => {
        host.failed += 1
      },
    },
  })
}

effect function refusal(call: () => Promise<unknown>) {
  const { cause } = try flip(tryPromise(() => call()))
  if (typeof cause !== "object" || cause === null) return cause
  return "_tag" in cause ? cause._tag : "code" in cause ? cause.code : cause instanceof Error ? cause.message : cause
}

it.live("See the live view I opened (spec/os/android/camera.md, \"Story: See the live view I opened\"; spec/os/android/camera.md, \"Only the answer to the current foreground start can make the viewfinder ready\"; spec/os/android/camera.md, \"Only Android's explicit permission refusal counts as a denial\"; spec/os/android/camera.md, \"Permission recovery rearms the view only on a read of the current grant\")", () => effect {
  const phone = device({ camera: "prompt" })
  const host: Host = { adopted: [], refuseAdoption: false, finishing: 0, failed: 0 }
  const session = sessionOn(phone, cameraClient(androidCamera(phone)), host)

  const refused = try promise(() => session.start())
  const afterRefusal = session.snapshot()
  const resumedWithoutGrant = try promise(() => session.rearm())
  const notRetried = try promise(() => session.start())
  phone.camera = "granted"
  const resumedWithGrant = try promise(() => session.rearm())
  const afterGrant = session.phase
  const opened = try promise(() => session.start())
  const openedView = session.snapshot()

  try promise(() => session.stop())
  phone.holdPreviews = true
  phone.calls.length = 0
  const pending = fork promise(() => session.start())
  try promise(() => previewHeld(phone))
  try promise(() => session.stop())
  answerHeld(phone)
  const late = join pending
  const afterLate = { phase: session.phase, previewing: phone.previewing, calls: [...phone.calls] }

  phone.holdPreviews = false
  const reopened = try promise(() => session.start())
  const tokenNow = session.token()

  const unbuilt = device()
  const missing = try promise(() => sessionOn(unbuilt, cameraClient(androidCamera(unbuilt)), host, false).start())
  const absent = try refusal(() => cameraClient(cameraPlugin("NoSuchCamera")).getDevices())

  const malformed = cameraClient({ ...androidCamera(device()), startPreview: async () => ({ width: 1280 }) as never })
  const malformedSession = sessionOn(device(), malformed, host)
  const malformedStart = try promise(() => malformedSession.start())
  const malformedRefusal = try refusal(() => malformed.startPreview({}))

  try Effect.try(() => assert.deepStrictEqual(
    {
      refused,
      afterRefusal,
      resumedWithoutGrant,
      notRetried,
      resumedWithGrant,
      afterGrant,
      opened,
      openedView,
      late,
      afterLate,
      reopened,
      current: session.current(tokenNow),
      missing,
      unbuiltCalls: unbuilt.calls,
      absent,
      malformedStart: malformedStart.status,
      malformedRefusal,
      denials: [cameraAccessDenied({ code: "CAMERA_PERMISSION_DENIED" }), cameraAccessDenied({ code: "MICROPHONE_DENIED" }), cameraAccessDenied(new Error("camera permission denied")), cameraAccessDenied({ code: "PERMISSION_DENIED" })],
    },
    {
      refused: { status: "denied" },
      afterRefusal: { phase: "error", denied: "camera", controlBusy: false, capturing: false, recording: false, recordingStarting: false, finalizing: false },
      resumedWithoutGrant: false,
      notRetried: { status: "skipped" },
      resumedWithGrant: true,
      afterGrant: "off",
      opened: { status: "ready" },
      openedView: { phase: "ready", denied: undefined, controlBusy: false, capturing: false, recording: false, recordingStarting: false, finalizing: false },
      late: { status: "stale" },
      afterLate: { phase: "off", previewing: false, calls: ["startPreview", "stopPreview", "stopPreview"] },
      reopened: { status: "ready" },
      current: true,
      missing: { status: "unavailable", reason: "missing" },
      unbuiltCalls: [],
      absent: "BridgeUnavailable",
      malformedStart: "unavailable",
      malformedRefusal: "MalformedReply",
      denials: ["camera", "microphone", undefined, undefined],
    },
  ))
})

it.live("Capture with the camera only from the live view (spec/os/android/camera.md, \"Story: Capture with the camera only from the live view\"; spec/os/android/camera.md, \"A capture, a viewfinder control and a recording share one slot\"; spec/os/android/camera.md, \"A recording start that still owns the view came from its ready preview\"; spec/os/android/camera.md, \"A recording is confirmed only by a complete bridge receipt that the host read back\")", () => effect {
  const phone = device({ microphone: "prompt" })
  const host: Host = { adopted: [], refuseAdoption: false, finishing: 0, failed: 0 }
  const client = cameraClient(androidCamera(phone))
  const session = sessionOn(phone, client, host)

  const earlyControl = try promise(() => session.control(() => client.setZoom({ zoom: 2 })))
  try promise(() => session.start())
  const zoomed = try promise(() => session.control(() => client.setZoom({ zoom: 2 })))
  const nested = { control: "", capture: "" }
  const captured = try promise(() => session.exclusive(async () => {
    nested.control = await session.control(() => client.setZoom({ zoom: 4 }))
    nested.capture = (await session.exclusive(async () => "second")).status
    return client.capturePhoto({ format: "jpeg", saveToGallery: true })
  }))
  const failedCapture = try refusal(() => session.exclusive(async () => {
    throw new Error("The scan page was not added")
  }))
  const freedAfterFailure = session.busy

  const microphoneRefused = try promise(() => session.startRecording())
  const afterMicrophone = { denied: session.denied, phase: session.phase, busy: session.busy }
  session.clearDenied("camera")
  const keptMicrophoneDenial = session.denied
  session.clearDenied("microphone")
  phone.microphone = "granted"

  const recording = try promise(() => session.startRecording())
  const whileRecording = session.snapshot()
  const blockedControl = try promise(() => session.control(() => client.setZoom({ zoom: 3 })))
  phone.calls.length = 0
  const shared = try promise(() => Promise.all([session.finishRecording(), session.finishRecording()]))
  const stopCalls = phone.calls.filter((call) => call === "stopRecording").length
  const nothingToFinish = try promise(() => session.finishRecording())
  const stopCallsAfterNothing = phone.calls.filter((call) => call === "stopRecording").length

  phone.video = { path: "/data/user/0/app/cache/clip-2.mp4", duration: 0, width: 1920, height: 1080, fileSize: 0, mimeType: "video/mp4" }
  try promise(() => session.startRecording())
  const incomplete = try promise(() => session.finishRecording())

  phone.video = { path: "/data/user/0/app/cache/clip-3.mp4", duration: 1.5, width: 1920, height: 1080, fileSize: 2048, mimeType: "video/mp4" }
  host.refuseAdoption = true
  try promise(() => session.startRecording())
  const notReadBack = try promise(() => session.finishRecording())
  host.refuseAdoption = false

  phone.video = { path: "/data/user/0/app/cache/clip-4.mp4", duration: 2, width: 1920, height: 1080, fileSize: 4096, mimeType: "video/mp4" }
  try promise(() => session.startRecording())
  try promise(() => session.stop())
  const closedWhileRecording = { phase: session.phase, busy: session.busy, previewing: phone.previewing, recording: phone.recording, finished: session.view().finished }
  const captureWhileClosed = try promise(() => session.exclusive(async () => "late"))

  try promise(() => session.start())
  phone.previewLostOnRecord = true
  const previewLost = try promise(() => session.startRecording())
  const afterLost = session.phase
  phone.previewLostOnRecord = false
  const retried = try promise(() => session.start(true))

  const keep = {
    thrown: try promise(() => keepCapture({ label: "Keep", run: async () => { throw new Error("store offline") } }, { format: "jpeg", width: 1, height: 1 }, "op-1")),
    failed: try promise(() => keepCapture({ label: "Keep", run: async () => ({ status: "failed", message: "" }) }, { format: "jpeg", width: 1, height: 1 }, "op-2")),
    malformed: try promise(() => keepCapture({ label: "Keep", run: async () => ({ status: "done" }) as never }, { format: "jpeg", width: 1, height: 1 }, "op-3", "video")),
    saved: try promise(() => keepCapture({ label: "Keep", run: async (_, id) => ({ status: "saved", id }) }, { format: "jpeg", width: 1, height: 1 }, "op-4")),
  }
  const page = { type: "image/jpeg", size: 1024 }
  const scan = {
    jpeg: scanImageAdmitted(page),
    gif: scanImageAdmitted({ type: "image/gif", size: 1024 }),
    empty: scanImageAdmitted({ type: "image/png", size: 0 }),
    oversized: scanImageAdmitted({ type: "image/webp", size: SCAN_LIMITS.pageBytes + 1 }),
    pixels: [scanDimensionsAdmitted(8000, 4000), scanDimensionsAdmitted(8000, 4001), scanDimensionsAdmitted(Number.NaN, 1)],
    pages: [
      scanPagesRefusal([page, page]),
      scanPagesRefusal(Array.from({ length: SCAN_LIMITS.pages + 1 }, () => page)),
      scanPagesRefusal(Array.from({ length: 5 }, () => ({ type: "image/png", size: SCAN_LIMITS.pageBytes }))),
      scanPagesRefusal([{ type: "application/pdf", size: 10 }]),
    ],
    retry: ["cancelled", "failed", "unavailable", "too-large", "exported", "unconfirmed"].map(scanExportRetryable),
  }

  try Effect.try(() => assert.deepStrictEqual(
    {
      earlyControl,
      zoomed,
      nested,
      captured,
      failedCapture,
      freedAfterFailure,
      microphoneRefused,
      afterMicrophone,
      keptMicrophoneDenial,
      recording,
      whileRecording,
      blockedControl,
      shared,
      stopCalls,
      nothingToFinish,
      stopCallsAfterNothing,
      incomplete,
      notReadBack,
      closedWhileRecording,
      captureWhileClosed,
      previewLost,
      afterLost,
      retried,
      adopted: host.adopted,
      finishing: host.finishing,
      failed: host.failed,
      zoom: phone.zoom,
      keep,
      scan,
    },
    {
      earlyControl: "skipped",
      zoomed: "done",
      nested: { control: "skipped", capture: "busy" },
      captured: { status: "done", value: { base64: "/9j/AA==", format: "jpeg", width: 1920, height: 1080, libraryId: "m:external_primary:i:42" } },
      failedCapture: "The scan page was not added",
      freedAfterFailure: false,
      microphoneRefused: "denied",
      afterMicrophone: { denied: "microphone", phase: "ready", busy: false },
      keptMicrophoneDenial: "microphone",
      recording: "recording",
      whileRecording: { phase: "ready", denied: undefined, controlBusy: false, capturing: false, recording: true, recordingStarting: false, finalizing: false },
      blockedControl: "skipped",
      shared: ["saved", "saved"],
      stopCalls: 1,
      nothingToFinish: "failed",
      stopCallsAfterNothing: 1,
      incomplete: "failed",
      notReadBack: "failed",
      closedWhileRecording: { phase: "off", busy: false, previewing: false, recording: false, finished: "RecordingConfirmed" },
      captureWhileClosed: { status: "closed" },
      previewLost: "failed",
      afterLost: "error",
      retried: { status: "ready" },
      adopted: ["/data/user/0/app/cache/clip-1.mp4", "/data/user/0/app/cache/clip-4.mp4"],
      finishing: 4,
      failed: 2,
      zoom: 2,
      keep: {
        thrown: { status: "unknown", message: "Keeping this photo could not be confirmed. Check the library before trying again." },
        failed: { status: "failed", message: "The photo was not kept." },
        malformed: { status: "unknown", message: "Keeping this video could not be confirmed. Check the library before trying again." },
        saved: { status: "saved", id: "op-4" },
      },
      scan: {
        jpeg: true,
        gif: false,
        empty: false,
        oversized: false,
        pixels: [true, false, false],
        pages: [null, "too-many-pages", "document-too-large", "unsupported-image"],
        retry: [true, true, true, true, false, false],
      },
    },
  ))
})

it.live("While a recording runs, only one zoom or torch change runs at a time (spec/os/android/camera.md, \"While a recording runs, only one zoom or torch change runs at a time\"; spec/os/android/camera.md, \"A capture, a viewfinder control and a recording share one slot\")", () => effect {
  const phone = device()
  const host: Host = { adopted: [], refuseAdoption: false, finishing: 0, failed: 0 }
  const plugin = androidCamera(phone)
  const recordingStart = gate()
  const client = cameraClient({ ...plugin, startRecording: async (options) => {
    await recordingStart.passed
    return plugin.startRecording(options)
  } })
  const session = sessionOn(phone, client, host)
  try promise(() => session.start())

  const starting = session.startRecording()
  const whileStarting = try promise(() => session.control(() => client.setZoom({ zoom: 2 }), "zoom"))
  recordingStart.open()
  const recording = try promise(() => starting)

  const unnamed = try promise(() => session.control(() => client.setSettings({ settings: { flash: "on" } })))
  const zoomHeld = gate()
  const zoom = session.control(async () => {
    await zoomHeld.passed
    await client.setZoom({ zoom: 3 })
  }, "zoom")
  const torchBesideZoom = try promise(() => session.control(async () => {}, "torch"))
  const besideZoom = {
    controlBusy: session.controlBusy,
    recording: session.recording,
    capture: try promise(() => session.exclusive(async () => "photo")),
    secondStart: try promise(() => session.startRecording()),
  }
  zoomHeld.open()
  const zoomed = try promise(() => zoom)
  const torch = try promise(() => session.control(async () => {}, "torch"))
  const torchRefused = try promise(() => session.control(async () => {
    throw new Error("no torch")
  }, "torch"))
  const afterChanges = { controlBusy: session.controlBusy, recording: session.recording }

  const finishing = session.finishRecording()
  const whileFinishing = try promise(() => session.control(async () => {}, "torch"))
  const finished = try promise(() => finishing)
  const readyAgain = try promise(() => session.control(() => client.setSettings({ settings: { flash: "off" } })))

  try promise(() => session.startRecording())
  const staleHeld = gate()
  const staleZoom = session.control(async () => {
    await staleHeld.passed
  }, "zoom")
  try promise(() => session.control(async () => {}, "torch"))
  try promise(() => session.stop())
  staleHeld.open()
  const settledAfterStop = try promise(() => staleZoom)

  try Effect.try(() => assert.deepStrictEqual(
    { whileStarting, recording, unnamed, torchBesideZoom, besideZoom, zoomed, torch, torchRefused, afterChanges, whileFinishing, finished, readyAgain, settledAfterStop, zoom: phone.zoom, adopted: host.adopted.length },
    {
      whileStarting: "skipped",
      recording: "recording",
      unnamed: "skipped",
      torchBesideZoom: "skipped",
      besideZoom: { controlBusy: true, recording: true, capture: { status: "busy" }, secondStart: "skipped" },
      zoomed: "done",
      torch: "done",
      torchRefused: "failed",
      afterChanges: { controlBusy: false, recording: true },
      whileFinishing: "skipped",
      finished: "saved",
      readyAgain: "done",
      settledAfterStop: "stale",
      zoom: 3,
      adopted: 2,
    },
  ))
})

it.effect("A preview binds its photo stream only at an aspect ratio the device lists (spec/os/android/camera.md, \"A preview binds its photo stream only at an aspect ratio the device lists\")", () => effect {
  const answer = try Effect.try(() => aspectRatioChecks())
  try Effect.try(() => assert.strictEqual(answer, "CaptureAspectRatiosTest checks: 12"))
}, 180_000)
