// spec/os/agentService/channel.md, "Story: Ask the agent only on the routes my app allows"; spec/os/agentService/channel.md, "Story: Stream a reply and stop it"; spec/os/agentService/channel.md, "Story: Receive the agent's live events for my screen"
import { assert, it } from "@effect/vitest"
import { BridgeUnavailable, MalformedReply, rejectionCode } from "../../src/bridges/bridge.vibe"
import { agentClient } from "../../src/bridges/agent.vibe"

module android {
  import { CapacitorException } from "@capacitor/core"
  import type { AgentEvents, ElizaAgentPlugin } from "../../src/bridges/definitions/agent.ts"

  export type Reply = { kind: "reply"; value: unknown } | { kind: "reject"; code: string }

  export interface Recording {
    replies: Map<string, Reply[]>
    calls: string[]
    listeners: Map<string, (event: unknown) => void>
  }

  /** @throws {never} */
  export function recording(): Recording {
    return { replies: new Map(), calls: [], listeners: new Map() }
  }

  /** @throws {never} */
  export function answers(phone: Recording, method: keyof ElizaAgentPlugin, ...replies: Reply[]) {
    phone.replies.set(method, [...(phone.replies.get(method) ?? []), ...replies])
  }

  /** @throws {never} */
  export function emit(phone: Recording, name: keyof AgentEvents, event: unknown) {
    phone.listeners.get(name)?.(JSON.parse(JSON.stringify(event)))
  }

  /** @throws {never} */
  export function replayed(phone: Recording): ElizaAgentPlugin {
    const native = <A,>(method: string) => async (options?: unknown): Promise<A> => {
      phone.calls.push(options === undefined ? method : `${method} ${JSON.stringify(options)}`)
      const next = phone.replies.get(method)?.shift() ?? { kind: "reject", code: "UNIMPLEMENTED" }
      if (next.kind === "reject") throw Object.assign(new CapacitorException(next.code), { code: next.code })
      return JSON.parse(JSON.stringify(next.value))
    }
    return {
      getStatus: native("getStatus"), start: native("start"), stop: native("stop"), restart: native("restart"),
      request: native("request"), requestStream: native("requestStream"), abort: native("abort"),
      subscribeEvents: native("subscribeEvents"), unsubscribeEvents: native("unsubscribeEvents"),
      reviewRecovery: native("reviewRecovery"), archiveRecovery: native("archiveRecovery"),
      addListener: async (eventName, listener) => {
        phone.listeners.set(eventName, (event: unknown) => listener(event as never))
        return { remove: async () => void phone.listeners.delete(eventName) }
      },
    }
  }
}
import { answers, emit, recording, replayed } from android

effect function refusal(call: () => Promise<unknown>) {
  const { cause } = try flip(tryPromise(() => call()))
  if (cause instanceof MalformedReply) return `malformed ${cause.method}`
  if (cause instanceof BridgeUnavailable) return `unavailable ${cause.method}`
  return `rejected ${rejectionCode(cause)}`
}

const reply = (value: unknown) => ({ kind: "reply" as const, value })
const reject = (code: string) => ({ kind: "reject" as const, code })
const running = { available: true, state: "running", epoch: 3, requestBodyLimit: 1048576 }

it.live("Ask the agent only on the routes my app allows, and read its status without the plugin (spec/os/agentService/channel.md, \"Story: Ask the agent only on the routes my app allows\"; spec/os/agentService/channel.md, \"A call is refused before any I/O unless the agent is serving, its id is free and its list admits it\"; spec/os/agentService/channel.md, \"The launch's root token stays inside the service\")", () => effect {
  const phone = recording()
  const agent = agentClient(replayed(phone))
  const storageFailure = { available: true, state: "failed", failure: "storage", error: "store opened under another account", epoch: 4, requestBodyLimit: 1048576 }
  answers(phone, "getStatus", reply(running), reply(storageFailure), reply({ ...storageFailure, failure: undefined }), reply({ ...storageFailure, failure: "disk" }), reject("UNIMPLEMENTED"))
  answers(phone, "request", reply({ status: 200, data: { ready: true } }), reject("RouteRefused"), reply({ status: "200" }))
  answers(phone, "reviewRecovery", reply({ kind: "reviewable", reviewToken: "review-7", retainedCount: 2 }))
  answers(phone, "archiveRecovery", reply({ kind: "unavailable" }))

  const status = try promise(() => agent.getStatus())
  const health = try promise(() => agent.request({ method: "GET", path: "/api/health" }))
  const refused = try refusal(() => agent.request({ method: "DELETE", path: "/api/agent/state" }))
  const garbled = try refusal(() => agent.request({ method: "GET", path: "/api/health" }))
  const failed = try promise(() => agent.getStatus())
  const unnamed = try refusal(() => agent.getStatus())
  const unknownCause = try refusal(() => agent.getStatus())
  const review = try promise(() => agent.reviewRecovery())
  const archive = try promise(() => agent.archiveRecovery({ reviewToken: "review-7" }))
  const missing = try promise(() => agent.getStatus())
  const startMissing = try refusal(() => agent.start())

  try Effect.try(() => assert.deepStrictEqual(
    { status, health, refused, garbled, failed, unnamed, unknownCause, review, archive, missing, startMissing, calls: phone.calls },
    {
      status: running,
      health: { status: 200, data: { ready: true } },
      refused: "rejected RouteRefused",
      garbled: "malformed request",
      failed: storageFailure,
      unnamed: "malformed getStatus",
      unknownCause: "malformed getStatus",
      review: { kind: "reviewable", reviewToken: "review-7", retainedCount: 2 },
      archive: { kind: "unavailable" },
      missing: { available: false, state: "unavailable", epoch: 0, requestBodyLimit: 0 },
      startMissing: "unavailable start",
      calls: [
        "getStatus",
        "request {\"method\":\"GET\",\"path\":\"/api/health\"}",
        "request {\"method\":\"DELETE\",\"path\":\"/api/agent/state\"}",
        "request {\"method\":\"GET\",\"path\":\"/api/health\"}",
        "getStatus", "getStatus", "getStatus",
        "reviewRecovery",
        "archiveRecovery {\"reviewToken\":\"review-7\"}",
        "getStatus", "start",
      ],
    },
  ))
})

it.live("Stream a reply in order, stop it once, and hear my screen's live events (spec/os/agentService/channel.md, \"Story: Stream a reply and stop it\"; spec/os/agentService/channel.md, \"A stream delivers its frames in order and ends once with End, Error or Aborted\"; spec/os/agentService/channel.md, \"Story: Receive the agent's live events for my screen\"; spec/os/agentService/channel.md, \"A subscription's events arrive in order to its owner, and it ends once with End or Restarted\")", () => effect {
  const phone = recording()
  const agent = agentClient(replayed(phone))
  const heard: string[] = []
  const last = Promise.withResolvers<void>()
  const hear = (line: string) => {
    heard.push(line)
    if (line.startsWith("status")) last.resolve()
  }
  try promise(() => agent.addListener("streamData", (frame) => hear(frame.kind === "head" ? `head ${frame.status}` : `chunk ${frame.index} ${frame.dataBase64}`)))
  try promise(() => agent.addListener("streamEnd", (end) => hear(end.kind === "failed" ? `failed ${end.code}` : `end ${end.kind}`)))
  try promise(() => agent.addListener("agentEvent", (event) => hear(event.kind === "event" ? `event ${event.index} ${String(event.event.type)}` : event.kind === "failed" ? `event-failed ${event.code}` : "event-end")))
  try promise(() => agent.addListener("status", (status) => hear(`status ${status.state} ${status.epoch}`)))
  answers(phone, "requestStream", reply({ id: "reply-0001" }), reject("IdInUse"))
  answers(phone, "abort", reply({ aborted: true }), reply({ aborted: false }))
  answers(phone, "subscribeEvents", reply({ id: "voice-0001" }), reject("TopicInUse"))
  answers(phone, "unsubscribeEvents", reply({ aborted: "yes" }))

  const opened = try promise(() => agent.requestStream({ id: "reply-0001", method: "POST", path: "/api/conversations/messages/stream", body: { text: "hello" } }))
  const reused = try refusal(() => agent.requestStream({ id: "reply-0001", method: "POST", path: "/api/conversations/messages/stream" }))
  emit(phone, "streamData", { id: "reply-0001", kind: "head", index: 0, status: 200, headers: { "content-type": "text/event-stream" } })
  emit(phone, "streamData", { id: "reply-0001", kind: "chunk", index: 1, dataBase64: "aGk=" })
  emit(phone, "streamData", { id: "reply-0001", kind: "chunk", index: 2 })
  const stopped = try promise(() => agent.abort({ id: "reply-0001" }))
  emit(phone, "streamEnd", { id: "reply-0001", kind: "aborted" })
  emit(phone, "streamEnd", { id: "reply-0001", kind: "failed", code: "Gone" })
  const again = try promise(() => agent.abort({ id: "reply-0001" }))
  const voice = try promise(() => agent.subscribeEvents({ id: "voice-0001", topic: "voice" }))
  const second = try refusal(() => agent.subscribeEvents({ id: "voice-0002", topic: "voice" }))
  emit(phone, "agentEvent", { id: "voice-0001", kind: "event", index: 0, event: { type: "voice-transcript", text: "lights on" } })
  emit(phone, "agentEvent", { id: "voice-0001", kind: "failed", code: "Restarted" })
  const closed = try refusal(() => agent.unsubscribeEvents({ id: "voice-0001" }))
  emit(phone, "status", { available: true, state: "starting", epoch: 4, requestBodyLimit: 1048576 })
  try promise(() => last.promise)

  try Effect.try(() => assert.deepStrictEqual(
    { opened, reused, stopped, again, voice, second, closed, heard },
    {
      opened: { id: "reply-0001" },
      reused: "rejected IdInUse",
      stopped: { aborted: true },
      again: { aborted: false },
      voice: { id: "voice-0001" },
      second: "rejected TopicInUse",
      closed: "malformed unsubscribeEvents",
      heard: ["head 200", "chunk 1 aGk=", "end aborted", "event 0 voice-transcript", "event-failed Restarted", "status starting 4"],
    },
  ))
})
