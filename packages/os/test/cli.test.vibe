// spec/os/image/staging.md, "Story: Stage my launcher into an image exactly once"; spec/os/update/operator.md, "Story: Update a device by cable"; spec/os/image/signing.md, "Story: Sign a release only with keys I enrolled"; spec/os/browser/chromium.md, "Story: Use the owned browser only with its expected identity"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { beforeAll } from "vitest"
import { buildApk, testSigner, type AndroidTools } from "./support/android-tools.ts"
import { device, fakeAdb } from "./support/fake-adb.ts"
import { scratch, scratchRepo, writeTree, type Tree } from "./support/scratch.vibe"

module node {
  import { execFile } from "node:child_process"
  import { createHash, createPrivateKey, X509Certificate } from "node:crypto"
  import { mkdtemp, rm, stat } from "node:fs/promises"
  import path from "node:path"
  import { fileURLToPath } from "node:url"
  import { promisify } from "node:util"
  import { compilerCommand, findCompiler } from "vibelang/project"
  import { androidTools, type AndroidTools } from "./support/android-tools.ts"

  export interface Run {
    readonly status: number | null
    readonly stdout: string
    readonly stderr: string
  }

  export interface CompiledCli {
    readonly cwd: string
    readonly executable: string
    readonly leases: string
    readonly children: Set<Promise<Run>>
    remove(): Promise<void>
  }

  export async function compileCli(root: URL): Promise<CompiledCli> {
    const cwd = fileURLToPath(root)
    const output = await mkdtemp(path.join(cwd, ".cli-test-"))
    const removeOutput = () => rm(output, { recursive: true, force: true })
    try {
      const [compiler, args] = compilerCommand(findCompiler(cwd), ["-p", "tsconfig.build.json", "--outDir", output])
      await promisify(execFile)(compiler, args, { cwd, timeout: 120_000, killSignal: "SIGKILL", encoding: "utf8", maxBuffer: 16 * 1024 * 1024 })
      const executable = path.join(output, "src", "cli.js")
      if (!(await stat(executable)).isFile()) throw new Error("OS CLI build did not emit a regular executable")
      const children = new Set<Promise<Run>>()
      return {
        cwd, executable, children, leases: path.join(output, "device-leases"),
        async remove() {
          await Promise.allSettled(children)
          await removeOutput()
        },
      }
    } catch (failure) {
      await removeOutput()
      throw failure
    }
  }

  /** @throws {never} */
  export function eliza(cli: CompiledCli, args: readonly string[]): Promise<Run> {
    const child = new Promise<Run>((resolve) => {
      execFile(process.execPath, ["--no-warnings", cli.executable, ...args], { cwd: cli.cwd, env: { ...process.env, ELIZA_DEVICE_LEASE_DIR: cli.leases }, encoding: "utf8", timeout: 120_000, maxBuffer: 16 * 1024 * 1024 }, (failure, stdout, stderr) => {
        resolve({ status: failure === null ? 0 : typeof failure.code === "number" ? failure.code : null, stdout, stderr })
      })
    })
    cli.children.add(child)
    const settled = () => cli.children.delete(child)
    void child.then(settled, settled)
    return child
  }

  /** @throws {never} */
  export function sdk(): AndroidTools {
    try {
      return androidTools()
    } catch (cause) {
      return { kind: "missing", reason: String(cause) }
    }
  }

  /** @throws {never} */
  export function textSha256(text: string): string {
    return createHash("sha256").update(text).digest("hex")
  }

  /** @throws {Error} */
  export function certificateSha256(pem: string): string {
    return new X509Certificate(pem).fingerprint256.replaceAll(":", "").toLowerCase()
  }

  /** @throws {Error} */
  export function pairsWithCertificate(pk8: Uint8Array, pem: string): boolean {
    return new X509Certificate(pem).checkPrivateKey(createPrivateKey({ key: Buffer.from(pk8), format: "der", type: "pkcs8" }))
  }

  /** @throws {Error} */
  export function extensionAssets(packageDir: string): Promise<readonly string[]> {
    return import(path.join(packageDir, "browser/chromium/component/chromium-component.mjs")).then((component: { assetNames: readonly string[] }) => component.assetNames)
  }
}
import { certificateSha256, compileCli, eliza, extensionAssets, pairsWithCertificate, sdk, textSha256, type CompiledCli, type Run } from node
import { qualificationGateProblems } from "../src/image/index.vibe"

export error ChildFailed { step: string; cause: unknown }

const PASSPHRASE = "a passphrase only this test knows"
const CERTIFICATE = "c".repeat(64)
const USAGE_LINE = "eliza-os stage-launcher --descriptor FILE"
const TOOLS = sdk()
let compiledCli: CompiledCli | undefined

beforeAll(async () => {
  const cli = await compileCli(new URL("..", import.meta.url))
  compiledCli = cli
  return cli.remove
}, 130_000)

const failed = (step: string) => (cause: unknown) => new ChildFailed({ step, cause })

effect function packageDir() {
  const path = try Path.Path
  return try path.fromFileUrl(new URL("..", import.meta.url))
}

effect function run(...args: string[]) {
  const cli = compiledCli
  if (cli === undefined) throw new ChildFailed({ step: "prepare OS CLI", cause: "No compiled CLI fixture" })
  return try tryPromise({ try: () => eliza(cli, args), catch: failed(args.slice(0, 2).join(" ")) })
}

effect function parsed(step: string, result: Run) {
  const value: Record<string, unknown> = try Effect.try({ try: () => JSON.parse(result.stdout), catch: (cause) => new ChildFailed({ step, cause: { cause, ...result } }) })
  return value
}

effect function listed(directory: string) {
  const files = try FileSystem.FileSystem
  return (try files.readDirectory(directory)).sort()
}

effect function readJson(file: string) {
  const files = try FileSystem.FileSystem
  const text = try files.readFileString(file)
  const value: unknown = try Effect.try({ try: () => JSON.parse(text), catch: failed(`read ${file}`) })
  return value
}

const journey = <A, E>(body: A!E!(NodeServices.NodeServices | Scope.Scope)) => Effect.provide(Effect.scoped(body), NodeServices.layer)


it.live("Refuse a malformed command line with exit 2 and write nothing (spec/os/image/staging.md, \"Story: Stage my launcher into an image exactly once\"; spec/os/image/signing.md, \"Story: Sign a release only with keys I enrolled\"; spec/os/browser/chromium.md, \"Story: Use the owned browser only with its expected identity\")", () => journey(effect {
  const root = try scratch("cli-usage")
  const out = `${root}/out`
  const stage = ["stage-launcher", "--descriptor", `${root}/descriptor.json`, "--apk", `${root}/launcher.apk`, "--output", out]
  const chromiumBuild = ["chromium", "build", "--source", `${root}/src`, "--extension", `${root}/ext`, "--out", out, "--certificate", CERTIFICATE, "--build", `${root}/build`, "--args-file", `${root}/args.gn`]
  const refusals: ReadonlyArray<readonly [string, readonly string[], string]> = [
    ["no command", [], "a command is required"],
    ["unknown command", ["frobnicate"], "unknown command frobnicate"],
    ["unknown flag", [...stage, "--bogus", "x"], "unknown argument --bogus"],
    ["missing value", ["stage-launcher", "--output", out, "--descriptor"], "--descriptor needs a value"],
    ["value that is a flag", ["stage-launcher", "--descriptor", "--apk", `${root}/launcher.apk`], "--descriptor needs a value"],
    ["flag given twice", [...stage, "--output", out], "--output is given twice"],
    ["switch given twice", [...stage, "--development", "--development"], "--development is given twice"],
    ["missing required flags", ["stage-launcher", "--output", out], "--descriptor, --apk required"],
    ["defer and admission-only", [...stage, "--defer-soong", "--admission-only"], "choose one of --defer-soong, --admission-only"],
    ["defer and finalize", ["stage-launcher", "--output", out, "--defer-soong", "--finalize-soong"], "choose one of --defer-soong, --finalize-soong"],
    ["finalize with a descriptor", ["stage-launcher", "--finalize-soong", "--output", out, "--descriptor", `${root}/descriptor.json`], "--finalize-soong takes only --output"],
    ["finalize with a switch", ["stage-launcher", "--finalize-soong", "--output", out, "--development"], "--finalize-soong takes only --output"],
    ["finalize with a companion", ["stage-launcher", "--finalize-soong", "--output", out, "--companion", "Helper=a.apk"], "--finalize-soong takes only --output"],
    ["companion without a module", [...stage, "--companion", "helper.apk"], "--companion takes MODULE=FILE, not helper.apk"],
    ["companion with a lower-case module", [...stage, "--companion", "helper=helper.apk"], "--companion takes MODULE=FILE, not helper=helper.apk"],
    ["companion given twice", [...stage, "--companion", "Helper=a.apk", "--companion", "Helper=b.apk"], "--companion Helper is given twice"],
    ["native ABI outside the targets", [...stage, "--native-abi", "armeabi-v7a"], "--native-abi must be one of"],
    ["native install outside the rules", [...stage, "--native-abi", "arm64-v8a", "--native-install", "ninja"], "--native-install must be one of"],
    ["jobs of zero", [...chromiumBuild, "--jobs", "0"], "--jobs must be a whole number from 1 to 999"],
    ["jobs above the range", [...chromiumBuild, "--jobs", "1000"], "--jobs must be a whole number from 1 to 999"],
    ["jobs that are not a number", [...chromiumBuild, "--jobs", "many"], "--jobs must be a whole number from 1 to 999"],
    ["embed-host that is not a boolean", [...chromiumBuild, "--embed-host", "yes"], "--embed-host must be true or false"],
    ["keys without a subcommand", ["keys"], "keys takes generate or decrypt, not nothing"],
    ["keys with an unknown subcommand", ["keys", "rotate"], "keys takes generate or decrypt, not rotate"],
    ["keys decrypt with an unknown flag", ["keys", "decrypt", "--input", root, "--output", out, "--passphrase-file", `${root}/pass`, "--test-keys"], "unknown argument --test-keys"],
    ["chromium without a subcommand", ["chromium"], "chromium takes prepare or build, not nothing"],
    ["chromium with an unknown subcommand", ["chromium", "clean"], "chromium takes prepare or build, not clean"],
    ["chromium prepare without a certificate", ["chromium", "prepare", "--source", `${root}/src`, "--extension", `${root}/ext`, "--out", out], "--certificate required"],
    ["sign-release without a request", ["sign-release"], "--request required"],
    ["release-record with a switch it does not take", ["release-record", "--request", `${root}/request.json`, "--dry-run"], "unknown argument --dry-run"],
  ]
  const results = try Effect.forEach(refusals, ([, argv]) => run(...argv), { concurrency: 8 })
  refusals.forEach(([name, , message], index) => {
    const result = results[index]
    assert.strictEqual(result?.status, 2, `${name}: ${result?.stderr}`)
    assert.strictEqual(result?.stdout, "", name)
    assert.include(result?.stderr, message, name)
    assert.include(result?.stderr, USAGE_LINE, name)
  })
  assert.deepStrictEqual(try listed(root), [])
}))

it.live("Generate test release keys and decrypt them again (spec/os/image/signing.md, \"Story: Sign a release only with keys I enrolled\")", () => journey(effect {
  const root = try scratch("cli-keys")
  const files = try FileSystem.FileSystem
  const manifest = {
    schemaVersion: 1,
    reviewedAt: "2026-10-02",
    keys: [
      { name: "releasekey", kind: "x509-pk8", bits: 4096, storage: "offline-encrypted" },
      { name: "avb", kind: "avb-rsa", bits: 4096, storage: "offline-encrypted" },
      { name: "release_ed25519", kind: "ed25519", storage: "offline-encrypted" },
    ],
  }
  const tree: Tree = { "key-manifest.json": JSON.stringify(manifest), "secret/passphrase": PASSPHRASE }
  try writeTree(root, tree)
  try files.chmod(`${root}/secret/passphrase`, 0o600)
  try files.chmod(`${root}/secret`, 0o700)
  const keys = `${root}/keys`
  const generate = ["keys", "generate", "--output", keys, "--passphrase-file", `${root}/secret/passphrase`, "--manifest", `${root}/key-manifest.json`, "--test-keys"]
  const generated = try run(...generate)
  assert.strictEqual(generated.status, 0, generated.stderr)
  const result = try parsed("keys generate", generated)
  const fingerprints = result.fingerprints as { testKeys: boolean; keys: Array<{ name: string; kind: string; certificateSha256?: string }> }
  assert.strictEqual(fingerprints.testKeys, true)
  assert.deepStrictEqual(fingerprints.keys.map((key) => [key.name, key.kind]), manifest.keys.map((key) => [key.name, key.kind]))
  const written = try listed(keys)
  for (const file of ["TEST-KEYS-DO-NOT-SHIP", "fingerprints.json", "releasekey.x509.pem", "releasekey.pk8.enc", "avb.avbpubkey", "avb.pem.enc", "release_ed25519.pem.enc", "release_ed25519.pub.pem"]) assert.include(written, file)
  assert.notInclude(written, "releasekey.pk8")
  const certificate = try files.readFileString(`${keys}/releasekey.x509.pem`)
  assert.strictEqual(fingerprints.keys[0]?.certificateSha256, try Effect.try({ try: () => certificateSha256(certificate), catch: failed("read the certificate") }))
  assert.include(try files.readFileString(`${keys}/avb.pem.enc`), "ENCRYPTED PRIVATE KEY")
  assert.strictEqual((try files.stat(`${keys}/releasekey.pk8.enc`)).mode & 0o077, 0)

  const plain = `${root}/plain`
  const decrypted = try run("keys", "decrypt", "--input", keys, "--output", plain, "--passphrase-file", `${root}/secret/passphrase`, "--only", "releasekey")
  assert.strictEqual(decrypted.status, 0, decrypted.stderr)
  assert.deepStrictEqual(try listed(plain), ["releasekey.pk8", "releasekey.x509.pem"])
  const pk8 = try files.readFile(`${plain}/releasekey.pk8`)
  assert.isTrue(try Effect.try({ try: () => pairsWithCertificate(pk8, certificate), catch: failed("pair the key") }))

  const again = try run(...generate)
  assert.notStrictEqual(again.status, 0)
  assert.notStrictEqual(again.status, 2)
  assert.strictEqual(again.stdout, "")
}))

effect function admission(tools: Extract<AndroidTools, { kind: "present" }>) {
  const root = try scratch("cli-stage")
  const files = try FileSystem.FileSystem
  const signer = try Effect.try({ try: () => testSigner(tools, root, "launcher"), catch: failed("make the signer") })
  const manifest = [
    "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\" package=\"org.example.launcher\">",
    "  <application android:label=\"Launcher\" android:hasCode=\"false\">",
    "    <activity android:name=\".Home\" android:exported=\"true\">",
    "      <intent-filter>",
    "        <action android:name=\"android.intent.action.MAIN\"/>",
    "        <category android:name=\"android.intent.category.HOME\"/>",
    "        <category android:name=\"android.intent.category.DEFAULT\"/>",
    "      </intent-filter>",
    "    </activity>",
    "  </application>",
    "</manifest>",
  ].join("\n")
  const built = try Effect.try({ try: () => buildApk(tools, { directory: `${root}/apk`, manifest, signer, name: "launcher" }), catch: failed("build the launcher") })
  const descriptor = { schemaVersion: 1, brand: "example", moduleName: "ExampleLauncher", packageName: "org.example.launcher", apkSha256: built.sha256, certificateSha256: signer.certificateSha256 }
  try writeTree(root, { "descriptor.json": JSON.stringify(descriptor) })
  const output = `${root}/overlay`
  const stage = ["stage-launcher", "--descriptor", `${root}/descriptor.json`, "--apk", built.apk, "--output", output, "--aapt", tools.aapt, "--apksigner", tools.apksigner]
  const admitted = try run(...stage, "--admission-only")
  assert.strictEqual(admitted.status, 0, admitted.stderr)
  try parsed("stage-launcher --admission-only", admitted)
  assert.isFalse(try files.exists(output))

  try writeTree(root, { "descriptor.json": JSON.stringify({ ...descriptor, apkSha256: "0".repeat(64) }) })
  const refused = try run(...stage, "--admission-only")
  assert.notStrictEqual(refused.status, 0)
  assert.notStrictEqual(refused.status, 2)
  assert.strictEqual(refused.stdout, "")
  assert.isFalse(try files.exists(output))
}

it.live.skipIf(TOOLS.kind === "missing")(`Check a launcher for admission without writing an overlay (spec/os/image/staging.md, "Story: Stage my launcher into an image exactly once")${TOOLS.kind === "missing" ? `: ${TOOLS.reason}` : ""}`, () => journey(effect {
  if (TOOLS.kind === "present") try admission(TOOLS)
}))

it.live('Read only the two authorized fastboot values from the CLI and keep their original capture (spec/os/image/qualification.md, "Story: Qualify a device read-only")', () => journey(effect {
  const root = try scratch("cli-qualification")
  const files = try FileSystem.FileSystem
  const serial = "FAKE0001"
  const bootloader = "(bootloader) product:example\n(bootloader) unlocked:no\n(bootloader) unlock_ability:1\n"
  const partition = "partition-type:avb_custom_key: raw\n"
  const bulkArgs = ["-s", serial, "getvar", "all"]
  const keyArgs = ["-s", serial, "getvar", "partition-type:avb_custom_key"]
  const phone = try Effect.try({ try: () => fakeAdb(root, device(serial, { mode: "bootloader", scripted: [
    { tool: "fastboot", args: bulkArgs, answer: { stderr: bootloader, status: 0 } },
    { tool: "fastboot", args: keyArgs, answer: { stderr: partition, status: 0 } },
  ] })), catch: failed("start fake fastboot") })
  const out = `${root}/qualification`
  const args = ["qualify-device", "--serial", serial, "--fastboot", "--fastboot-bin", phone.fastboot, "--out", out]
  const misplaced = try run(...args, "--adb", phone.adb)
  assert.strictEqual(misplaced.status, 2)
  assert.include(misplaced.stderr, "chosen probe mode")
  assert.isFalse(try files.exists(out))

  const result = try run(...args)
  assert.strictEqual(result.status, 0, result.stderr)
  const report = try parsed("qualify-device", result)
  const summary = try Schema.decodeUnknownEffect(Schema.Struct({ mode: Schema.String,
    evaluation: Schema.Struct({ verdict: Schema.String, evidenceLevel: Schema.String }) }))(report)
  const calls = try Effect.try({ try: () => phone.calls(), catch: failed("read the fastboot calls") })
  assert.deepStrictEqual({
    summary, calls, captured: try files.readFileString(`${out}/raw/getvarAll.txt`),
    record: try readJson(`${out}/record.json`),
  }, {
    summary: { mode: "fastboot", evaluation: { verdict: "pass", evidenceLevel: "bootloader-observation" } },
    calls: [{ tool: "fastboot", args: bulkArgs }, { tool: "fastboot", args: keyArgs }],
    captured: bootloader, record: report,
  })
}))

it.live("Read an update's status from the device by cable (spec/os/update/operator.md, \"Story: Update a device by cable\")", () => journey(effect {
  const root = try scratch("cli-ota")
  const files = try FileSystem.FileSystem
  const serial = "FAKE0001"
  const phone = try Effect.try({ try: () => fakeAdb(root, device(serial, { mode: "sideload" })), catch: failed("start the fake adb") })
  const journal = {
    schema: 1,
    kind: "aosp-ota-update-journal",
    serial,
    createdAt: "2026-01-01T00:00:00.000Z",
    release: { product: "example", device: "example_device", channel: "stable", fingerprint: "example/example_device:16/BP2A.260101.001/2:user/release-keys", securityPatch: "2026-01-05", type: "full", otaFile: "update.zip", otaSha256: "d".repeat(64), recordSha256: "e".repeat(64) },
    from: { fingerprint: "example/example_device:16/BP2A.251201.001/1:user/release-keys", slot: "a", securityPatch: "2025-12-05", verifiedBootState: "green", flashLocked: true, virtualAb: true, recordSha256: "f".repeat(64) },
    state: "sideloading",
    events: [],
    signedUpdateApplied: false,
    drillRecorded: false,
  }
  try files.writeFileString(`${root}/journal.json`, JSON.stringify(journal), { mode: 0o600 })
  const before = try files.readFileString(`${root}/journal.json`)
  const statusArgs = ["ota", "status", "--serial", serial, "--journal", `${root}/journal.json`, "--adb", phone.adb, "--fastboot", phone.fastboot]
  const status = try run(...statusArgs)
  assert.strictEqual(status.status, 0, status.stderr)
  const result = try parsed("ota status", status)
  assert.deepStrictEqual([result.deviceState, result.next, result.slots], ["sideload", "sideload", null])

  const variables = { product: journal.release.device, "current-slot": "b", "slot-successful:b": "no", "slot-unbootable:a": "no", "snapshot-update-status": "snapshotted" }
  try Effect.try({ try: () => phone.set({ mode: "bootloader", variables }), catch: failed("enter the bootloader") })
  const bootloader = try run(...statusArgs)
  assert.strictEqual(bootloader.status, 0, bootloader.stderr)
  const observed = try parsed("ota status in the bootloader", bootloader)
  assert.deepStrictEqual([observed.deviceState, observed.next, observed.slots], ["bootloader", "bootloader",
    { currentSlot: "SlotB", updatedUnconfirmed: true, originalBootable: true, snapshot: "Snapshotted" }])

  const beforeForeign = (try Effect.try({ try: () => phone.calls(), catch: failed("read the cable calls") })).length
  try Effect.try({ try: () => phone.set({ variables: { ...variables, product: "another_device" } }), catch: failed("change the reported product") })
  const foreign = try run(...statusArgs)
  assert.strictEqual(foreign.status, 0, foreign.stderr)
  const untrusted = try parsed("ota status for an unexpected product", foreign)
  assert.deepStrictEqual(untrusted.slots, { currentSlot: "NoSlot", updatedUnconfirmed: false, originalBootable: false, snapshot: "SnapshotUnread" })
  assert.strictEqual(try files.readFileString(`${root}/journal.json`), before)
  const calls = try Effect.try({ try: () => phone.calls(), catch: failed("read the cable calls") })
  assert.isTrue(calls.every((call) => call.args[0] === "-s" && call.args[1] === serial &&
    (call.tool === "adb" ? call.args[2] === "get-state" : call.args[2] === "getvar")))
  assert.deepStrictEqual(calls.slice(beforeForeign).filter((call) => call.tool === "fastboot").map((call) => call.args[3]), ["product", "product"])

  try Effect.try({ try: () => phone.set({ mode: "device", image: { selinux: "Enforcing", props: {
    "sys.boot_completed": "1", "ro.product.device": journal.release.device, "ro.build.fingerprint": journal.from.fingerprint,
    "ro.boot.slot_suffix": "_a", "ro.boot.verifiedbootstate": "green", "ro.boot.flash.locked": "1",
    "ro.build.version.security_patch": journal.from.securityPatch,
  } } }), catch: failed("boot the installed build on its original slot") })
  for (const [flashLocked, state, phase, wasLocked] of [
    ["0", "sideload", "Sideloading", false],
    ["1", "interrupted", "AwaitingSideload", true],
  ] as const) {
    const legacy = JSON.stringify({ ...journal, state, from: { ...journal.from, flashLocked } })
    try files.writeFileString(`${root}/journal.json`, legacy, { mode: 0o600 })
    const legacyStatus = try run(...statusArgs)
    assert.strictEqual(legacyStatus.status, 0, legacyStatus.stderr)
    const observedLegacy = try parsed("ota status for an earlier journal", legacyStatus)
    assert.deepStrictEqual([observedLegacy.executed, observedLegacy.next, observedLegacy.state], [false, "retry", {
      phase, lock: { tag: "Unlocked" }, start: {
        device: journal.release.device, installedBuild: journal.from.fingerprint, candidateBuild: journal.release.fingerprint,
        candidatePatch: 20260105, originalSlot: "SlotA", originalBoot: "Green", wasLocked, virtualAb: true,
      },
    }])
    if (state === "interrupted") {
      const repeated = try run(...statusArgs)
      assert.strictEqual(repeated.status, 0, repeated.stderr)
      assert.deepStrictEqual(try parsed("repeat ota status for an earlier journal", repeated), observedLegacy)
    }
    assert.strictEqual(try files.readFileString(`${root}/journal.json`), legacy)
  }

  const readCalls = try Effect.try({ try: () => phone.calls(), catch: failed("read the cable calls") })
  assert.isTrue(readCalls.slice(calls.length).every(({ tool, args }) => tool === "adb" && args[0] === "-s" && args[1] === serial &&
    (args[2] === "get-state" || (args[2] === "shell" && (args[3] === "getprop" || args[3] === "getenforce")))))
  for (const invalid of [
    { ...journal, from: { ...journal.from, flashLocked: "unknown" } },
    { ...journal, serial: "OTHER", from: { ...journal.from, flashLocked: "1" } },
  ]) {
    const rejected = JSON.stringify(invalid)
    try files.writeFileString(`${root}/journal.json`, rejected, { mode: 0o600 })
    const refusal = try run(...statusArgs)
    assert.strictEqual(refusal.status, 1, refusal.stderr)
    assert.strictEqual(refusal.stdout, "")
    assert.strictEqual(try files.readFileString(`${root}/journal.json`), rejected)
  }
  assert.deepStrictEqual(try Effect.try({ try: () => phone.calls(), catch: failed("read the cable calls") }), readCalls)

  const interrupted = { ...journal, state: "interrupted", from: { ...journal.from, flashLocked: "1" } }
  try files.writeFileString(`${root}/interrupted.json`, JSON.stringify(interrupted), { mode: 0o600 })
  try Effect.try({ try: () => phone.set({ mode: "sideload", variables: {} }), catch: failed("return to sideload") })
  const earlierArgs = ["--serial", serial, "--journal", `${root}/interrupted.json`, "--adb", phone.adb, "--fastboot", phone.fastboot]
  const earlier = try run("ota", "status", ...earlierArgs)
  assert.strictEqual(earlier.status, 0, earlier.stderr)
  assert.deepNestedInclude(try parsed("ota status of an interrupted earlier journal", earlier), { next: "sideload", "state.phase": "AwaitingSideload", "state.start.wasLocked": true })
  const refusedFallback = try run("ota", "fallback", ...earlierArgs)
  assert.strictEqual(refusedFallback.status, 1, refusedFallback.stdout)
  assert.include(refusedFallback.stderr, "Fallback is not done")
}), 120_000)

it.live("Fall back to the original slot from an unconfirmed update by cable (spec/os/update/operator.md, \"Story: Get back if the update fails\")", () => journey(effect {
  const root = try scratch("cli-ota-fallback")
  const files = try FileSystem.FileSystem
  const serial = "FAKE0002"
  const installed = "example/example_device:16/BP2A.251201.001/1:user/release-keys"
  const start = { device: "example_device", installedBuild: installed, candidateBuild: "example/example_device:16/BP2A.260101.001/2:user/release-keys",
    candidatePatch: 20260105, originalSlot: "SlotA", originalBoot: "Green", wasLocked: true, virtualAb: true }
  const binding = { serial, channel: "a".repeat(64), installedRecord: "b".repeat(64), candidateRecord: "c".repeat(64), ota: "d".repeat(64) }
  try files.writeFileString(`${root}/journal.json`, JSON.stringify({ schema: 1, kind: "aosp-ota-update-journal", binding, events: [],
    state: { phase: "Transferred", lock: { tag: "Unlocked" }, start } }), { mode: 0o600 })
  const original = { selinux: "Enforcing" as const, props: { "sys.boot_completed": "1", "ro.product.device": start.device, "ro.build.fingerprint": installed,
    "ro.boot.slot_suffix": "_a", "ro.boot.verifiedbootstate": "green", "ro.boot.flash.locked": "1", "ro.build.version.security_patch": "2025-12-05" } }
  const phone = try Effect.try({ try: () => fakeAdb(root, device(serial, { mode: "bootloader", boots: [original], variables: { product: start.device,
    "current-slot": "b", "slot-successful:b": "no", "slot-unbootable:a": "no", "snapshot-update-status": "snapshotted" } })), catch: failed("start the fake adb") })
  const args = ["ota", "fallback", "--serial", serial, "--journal", `${root}/journal.json`, "--adb", phone.adb, "--fastboot", phone.fastboot]

  const plan = try run(...args)
  assert.strictEqual(plan.status, 0, plan.stderr)
  assert.deepNestedInclude(try parsed("ota fallback plan", plan), { executed: false, admitted: true, "state.phase": "Transferred", "slots.currentSlot": "SlotB" })

  const fell = try run(...args, "--execute", "--confirm-fallback")
  assert.strictEqual(fell.status, 0, fell.stderr)
  const result = try parsed("ota fallback", fell)
  const rolledBack = { phase: "RolledBack", lock: { tag: "Unlocked" }, start }
  const stored = try Schema.decodeUnknownEffect(Schema.Struct({ state: Schema.Unknown,
    events: Schema.Array(Schema.Struct({ phase: Schema.String, lock: Schema.String })) }))(try readJson(`${root}/journal.json`))
  const [calls, now] = try Effect.try({ try: () => [phone.calls(), phone.device()] as const, catch: failed("read the cable") })
  assert.deepStrictEqual({
    state: result.state,
    stored: stored.state,
    phases: stored.events.map(({ phase, lock }) => `${phase}/${lock}`),
    writes: calls.filter(({ tool, args }) => tool === "fastboot" && (args[2] === "set_active" || args[2] === "reboot")).map(({ args }) => args.slice(2)),
    mode: now.mode,
  }, {
    state: rolledBack, stored: rolledBack,
    phases: ["Transferred/Locked", "FallingBack/Locked", "RolledBack/Locked", "RolledBack/Unlocked"],
    writes: [["set_active", "a"], ["reboot"]],
    mode: "device",
  })

  const settled = try files.readFileString(`${root}/journal.json`)
  const repeated = try run(...args, "--execute", "--confirm-fallback")
  assert.strictEqual(repeated.status, 1, repeated.stdout)
  assert.strictEqual(try files.readFileString(`${root}/journal.json`), settled)
}), 120_000)

it.live("Refuse a malformed signing request and judge the release gates by their evidence (spec/os/image/signing.md, \"Story: Sign a release only with keys I enrolled\"; spec/os/image/signing.md, \"Story: Record my release's qualification gates honestly\"; spec/os/image/signing.md, \"A gate passes only on release evidence, source admission only for the pinned production lock, signed-update recovery only for a distributable channel, and user acceptance last\")", () => journey(effect {
  const root = try scratch("cli-release")
  const files = try FileSystem.FileSystem
  try writeTree(root, { "request.json": JSON.stringify({ descriptor: "descriptor.json" }) })
  const signing = try run("sign-release", "--request", `${root}/request.json`, "--dry-run")
  const recording = try run("release-record", "--request", `${root}/request.json`)
  assert.deepStrictEqual([signing.status, recording.status, signing.stdout, recording.stdout], [1, 1, "", ""])
  assert.include(signing.stderr, "Invalid signing request")
  assert.include(recording.stderr, "Invalid release record request")

  const lock = JSON.stringify({ developmentOnly: false })
  const lockSha256 = textSha256(lock)
  try writeTree(root, {
    "locks/source.json": lock,
    "evidence/source-admission.json": JSON.stringify({ sourceLockSha256: lockSha256, developmentOnly: false }),
    "evidence/run.json": "{}",
  })
  const release = (ref: string) => ({ status: "passed", evidence: [{ level: "release", ref }] })
  const gates = {
    sourceAdmission: release("evidence/source-admission.json"),
    apkVariants: release("evidence/run.json"),
    cuttlefishBoot: release("evidence/run.json"),
    physicalDevice: { status: "development", evidence: [{ level: "development", ref: "evidence/run.json" }] },
    signedUpdateRecovery: release("https://example.invalid/drills"),
    userAcceptance: { status: "not run", evidence: [] },
  }
  const channel = {
    recovery: { knownGoodRelease: { buildFingerprint: "acme/stallion:17/BP1A/1:user/release-keys", recordFile: "known-good/release-record.json", otaSha256: "a".repeat(64) } },
    drills: { signedUpdate: "passed", interruptedUpdate: "passed", compatibleRollback: "passed", stockRecovery: "passed" },
  }
  const review = (record: unknown, recordChannel: unknown = channel) => qualificationGateProblems({ record, root, product: "acme", target: "pixel10a", sourceLock: { file: "locks/source.json", sha256: lockSha256 }, channel: recordChannel })
  const record = { schema: 1, target: "pixel10a", product: "acme", gates }
  const consistent = try review(record)
  const acceptedEarly = try review({ ...record, gates: { ...gates, userAcceptance: release("evidence/run.json") } })
  const developmentPass = try review({ ...record, gates: { ...gates, physicalDevice: { status: "passed", evidence: [{ level: "development", ref: "evidence/run.json" }] } } })
  const undrilled = try review(record, { ...channel, drills: { ...channel.drills, stockRecovery: "not run" } })
  const missingEvidence = try review({ ...record, gates: { ...gates, apkVariants: release("evidence/absent.json") } })
  try files.writeFileString(`${root}/locks/source.json`, JSON.stringify({ developmentOnly: true }))
  const developmentLock = try review(record)
  assert.deepStrictEqual([consistent, acceptedEarly, developmentPass, undrilled, missingEvidence, developmentLock].map((result) => result.problems), [
    [], ["AcceptanceBeforeGates"], ["GatePassedOnDevelopment"], ["RecoveryUndistributable"], ["GateEvidenceUnread"], ["SourceAdmissionUnproved"],
  ])
  assert.deepStrictEqual(consistent.gates, ["sourceAdmission", "apkVariants", "cuttlefishBoot", "physicalDevice", "signedUpdateRecovery", "userAcceptance"])
}))

it.live("Prepare the owned browser's component against the pinned sources (spec/os/browser/chromium.md, \"Story: Use the owned browser only with its expected identity\")", () => journey(effect {
  const root = try scratch("cli-chromium")
  const files = try FileSystem.FileSystem
  const browser = `${try packageDir()}/browser`
  const pin = (try readJson(`${browser}/chromium/upstream.json`)) as { revision: string; sha256: Record<string, string> }
  const sources: Record<string, string> = {}
  for (const name of Object.keys(pin.sha256)) sources[name] = try files.readFileString(`${browser}/chromium/fixtures/${name}`)
  const repo = try scratchRepo("chromium-source", sources)
  try writeTree(repo.root, { ".git/HEAD": `${pin.revision}\n` })
  const application = "org.example.launcher"
  const host = { application, androidCertificates: [CERTIFICATE.toUpperCase()] }
  const identity = (try readJson(`${browser}/identity.json`)) as { chromeDevManifestKey: string }
  const assets = try tryPromise({ try: () => extensionAssets(`${browser}/..`), catch: failed("read the asset names") })
  const extension: Record<string, string> = Object.fromEntries(assets.map((name) => [name, "// fixture\n"]))
  extension["manifest.json"] = JSON.stringify({
    manifest_version: 3,
    name: "Test",
    version: "1.0",
    key: identity.chromeDevManifestKey,
    permissions: ["tabs", "scripting", "webNavigation", "webRequest", "storage", "unlimitedStorage", "nativeMessaging", "alarms"],
    host_permissions: ["http://*/*", "https://*/*", "ws://*/*", "wss://*/*"],
    background: { service_worker: "background.mjs", type: "module" },
  })
  extension["runtime-config.mjs"] = `export const nativeHost = ${JSON.stringify(host)};\n`
  try writeTree(`${root}/extension`, extension)
  const prepare = ["chromium", "prepare", "--source", repo.root, "--extension", `${root}/extension`, "--certificate", CERTIFICATE, "--application", application]
  const prepared = try run(...prepare, "--out", `${root}/component`, "--revision", pin.revision)
  assert.strictEqual(prepared.status, 0, prepared.stderr)
  const report = try parsed("chromium prepare", prepared)
  assert.deepStrictEqual(report.nativeHost, host)
  assert.strictEqual(report.releaseQualified, false)
  assert.strictEqual(try files.readFileString(`${repo.root}/chrome/browser/resources/eliza_browser/runtime-config.mjs`), `export const nativeHost = ${JSON.stringify(host)};\n`)

  const stale = try run(...prepare, "--out", `${root}/again`, "--revision", "0".repeat(40))
  assert.notStrictEqual(stale.status, 0)
  assert.strictEqual(stale.stdout, "")
  assert.isFalse(try files.exists(`${root}/again`))
}))
