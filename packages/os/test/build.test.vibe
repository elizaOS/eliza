// spec/os/build/androidHost.md, "Story: Generate my app's Android host from data"; spec/os/build/androidHost.md, "Story: Build my release only with the toolchain and signing I pinned"; spec/os/build/androidBuild.md, "Story: Replace published APKs only with this run's verified set"
import { assert, it } from "@effect/vitest"
import { buildAndroid, generateAndroidHost } from "../src/build/index.vibe"
import { aaptManifestTree, listAndroidArtifactEntries, manifestFacts, parseXmlTree, readApkSignerDigest } from "../src/image/apk.vibe"
import { androidTools, standInElf, testSigner } from "./support/android-tools.ts"
import { fixture } from "./support/scratch.vibe"

module node {
  import { createHash } from "node:crypto"
  import { existsSync } from "node:fs"
  import path from "node:path"
  import type { AndroidTools } from "./support/android-tools.ts"

  export const FLAVORS = ["store", "sideload"] as const
  export const SIGNING = ["FIXTURE_STORE", "FIXTURE_STORE_PASSWORD", "FIXTURE_KEY_ALIAS", "FIXTURE_KEY_PASSWORD"] as const
  export const REQUESTED = ["android.permission.INTERNET", "android.permission.POST_NOTIFICATIONS", "android.permission.FOREGROUND_SERVICE", "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"]
  export const SPECIAL_USE = "0x40000000"
  export const INFERENCE = /(\.gguf|\.onnx|\.tflite|\.safetensors)$|libllama|libggml|llama-server|^assets\/models\//

  /** @throws {never} */
  export function absence(tools: AndroidTools, environment: NodeJS.ProcessEnv): string | null {
    if (tools.kind === "missing") return tools.reason
    const home = environment.JAVA_HOME
    return home !== undefined && existsSync(path.join(home, "bin", "javac")) ? null : "JAVA_HOME does not name a Java 21 development kit"
  }

  /** @throws {never} */
  export const sha256 = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex")

  /** @throws {never} */
  export function rowsOf(manifest: unknown): readonly Readonly<Record<string, unknown>>[] {
    const rows = Array.isArray(manifest) ? manifest : Object.values(manifest as Record<string, unknown>).find(Array.isArray) ?? []
    return rows.filter((row): row is Readonly<Record<string, unknown>> => typeof row === "object" && row !== null)
  }

  /** @throws {never} */
  export const message = (error: unknown) => String((error as { readonly message?: unknown } | null)?.message ?? error)

  /** @throws {never} */
  export const releaseName = (flavor: string, signed: boolean) => `${flavor}-release${signed ? "" : "-unsigned"}.apk`
}
import { FLAVORS, INFERENCE, REQUESTED, SIGNING, SPECIAL_USE, absence, message, releaseName, rowsOf, sha256 } from node

const tools = androidTools()
const skipped = absence(tools, process.env)

effect function published(output: string) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const names = (try files.readDirectory(output)).filter((name) => name.endsWith(".apk")).sort()
  const digests: Record<string, string> = {}
  for (const name of names) digests[name] = sha256(try files.readFile(path.join(output, name)))
  return digests
}

effect function stageRuntime(consumer: string) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const runtime = path.join(consumer, "runtime")
  try files.makeDirectory(path.join(runtime, "jniLibs", "x86_64"), { recursive: true })
  try files.makeDirectory(path.join(runtime, "assets", "agent", "bundle"), { recursive: true })
  try files.writeFile(path.join(runtime, "jniLibs", "x86_64", "libeliza_node.so"), standInElf("x86_64"))
  try files.writeFileString(path.join(runtime, "assets", "agent", "bundle", "agent.mjs"), "export {}\n")
  try files.writeFileString(path.join(runtime, "assets", "agent", "bundle", "manifest.json"), JSON.stringify({ localInference: false }))
  return runtime
}

it.effect.skipIf(skipped !== null)(`Generate the fixture host, refuse a partial signing set before Gradle, and replace the published APKs only with a verified set${skipped === null ? "" : ` (skipped: ${skipped})`} (spec/os/build/androidHost.md, "Story: Generate my app's Android host from data"; spec/os/build/androidHost.md, "Release signing names all four environment variables or none, and a partial set is refused"; spec/os/build/androidHost.md, "A build with every signing variable set fails when a release comes out unsigned"; spec/os/build/androidHost.md, "A host without local inference carries no on-device model or inference library"; spec/os/build/androidHost.md, "An os module adds no permission or exported component the profile did not request"; spec/os/build/androidHost.md, "The APK manifest lists every flavor's APK of this build with its digest and one signer"; spec/os/build/androidBuild.md, "Story: Replace published APKs only with this run's verified set")`, effect () => {
  if (tools.kind === "missing") return
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const consumer = try fixture("android-host")
  const signer = testSigner(tools, consumer)
  const identity = JSON.parse(try files.readFileString(path.join(consumer, "identity.json")))
  const profile = JSON.parse(try files.readFileString(path.join(consumer, "profile.json")))
  const host = path.join(consumer, "host")
  const output = path.join(consumer, "artifacts")
  try generateAndroidHost({ consumerRoot: consumer, output: host, identity, profile, runtime: try stageRuntime(consumer) })

  const base = { ...process.env, ANDROID_HOME: tools.sdk }
  for (const name of SIGNING) delete base[name]
  const signed = { ...base, FIXTURE_STORE: signer.keystore, FIXTURE_STORE_PASSWORD: signer.password, FIXTURE_KEY_ALIAS: signer.alias, FIXTURE_KEY_PASSWORD: signer.password }
  const passes = { command: process.execPath, args: ["-e", ""] }
  const fails = { command: process.execPath, args: ["-e", "process.exit(3)"] }
  const build = (environment: NodeJS.ProcessEnv, verify: typeof passes) =>
    buildAndroid({ root: consumer, project: "host", output: "artifacts", variants: [...FLAVORS], environment, verify, lint: false, androidTest: false })

  const partial = (effect { try build({ ...base, FIXTURE_STORE: signer.keystore, FIXTURE_KEY_ALIAS: signer.alias }, passes); return "built" } catch (error) => message(error))
  assert.match(partial, /FIXTURE_STORE_PASSWORD/)
  assert.match(partial, /FIXTURE_KEY_PASSWORD/)
  assert.isFalse(try files.exists(path.join(host, "app", "build")), "a partial signing set is refused before Gradle runs")

  try build(signed, passes)
  const first = try published(output)
  assert.deepStrictEqual(Object.keys(first).filter((name) => name.includes("-release")).sort(), FLAVORS.map((flavor) => releaseName(flavor, true)).sort())
  const rows = rowsOf(JSON.parse(try files.readFileString(path.join(output, "apk-manifest.json"))))
  for (const flavor of FLAVORS) {
    const apk = path.join(output, releaseName(flavor, true))
    const signerDigest = try readApkSignerDigest(apk, { apksigner: tools.apksigner })
    assert.strictEqual(signerDigest, signer.certificateSha256)
    const matching = rows.filter((row) => Object.values(row).includes(flavor) && Object.values(row).includes(first[releaseName(flavor, true)]))
    assert.strictEqual(matching.length, 1, `one manifest row for ${flavor} with its digest`)
    assert.include(Object.values(matching[0] ?? {}), signerDigest, `the ${flavor} row names its signer`)

    const entries = try listAndroidArtifactEntries(apk)
    assert.include(entries, "lib/x86_64/libeliza_node.so")
    assert.deepStrictEqual(entries.filter((entry) => INFERENCE.test(entry)), [])

    const tree = try aaptManifestTree(apk, { aapt: tools.aapt })
    const facts = manifestFacts(tree)
    assert.deepStrictEqual(facts.permissions.filter((permission) => !permission.startsWith(`${identity.appId}.`)).sort(), [...REQUESTED].sort())
    assert.deepStrictEqual(facts.exported.map((component) => component.name), ["example.fixture.host.MainActivity"])
    const services = (function walk(node: ReturnType<typeof parseXmlTree>): ReturnType<typeof parseXmlTree>[] {
      return node.children.flatMap((child) => [...(child.name === "service" ? [child] : []), ...walk(child)])
    })(parseXmlTree(tree))
    const agent = services.find((service) => service.attrs.name === "example.fixture.host.FixtureAgentService")
    assert.strictEqual(agent?.attrs.foregroundServiceType, SPECIAL_USE, "the agent service declares the specialUse type")
  }

  const gradleFile = path.join(host, "app", "build.gradle")
  const gradle = try files.readFileString(gradleFile)
  const stripped = gradle.replace("if (hostSigning) signingConfig signingConfigs.release", "")
  assert.notStrictEqual(stripped, gradle, "the generated host signs the release through hostSigning")
  try files.writeFileString(gradleFile, stripped)
  const unsigned = (effect { try build(signed, passes); return "built" } catch (error) => message(error))
  try files.writeFileString(gradleFile, gradle)
  assert.notStrictEqual(unsigned, "built", "every signing variable is set, so an unsigned release fails the build")
  assert.deepStrictEqual(try published(output), first)

  const unverified = (effect { try build(base, fails); return "built" } catch (error) => message(error))
  assert.notStrictEqual(unverified, "built", "a failed verification publishes nothing")
  assert.deepStrictEqual(try published(output), first)

  try build(base, passes)
  const second = try published(output)
  assert.deepStrictEqual(Object.keys(second).filter((name) => name.includes("-release")).sort(), FLAVORS.map((flavor) => releaseName(flavor, false)).sort())
}, 1_800_000)
