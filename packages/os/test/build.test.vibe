// spec/os/build/androidHost.md, "Story: Generate my app's Android host from data"; spec/os/build/androidHost.md, "Story: Build my release only with the toolchain and signing I pinned"; spec/os/build/androidBuild.md, "Story: Replace published APKs only with this run's verified set"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { FetchHttpClient } from "effect/http"
import { buildAndroid, generateAndroidHost, stageRuntimePayload } from "../src/build/index.vibe"
import { aaptManifestTree, listAndroidArtifactEntries, manifestFacts, parseXmlTree, readApkSignerDigest } from "../src/image/apk.vibe"
import { archiveDigest } from "../src/image/signing-archive.vibe"
import { androidTools, testSigner } from "./support/android-tools.ts"
import { commitTree, fixture, git, writeTree } from "./support/scratch.vibe"

module node {
  import { execFileSync } from "node:child_process"
  import { createHash } from "node:crypto"
  import { existsSync, readFileSync } from "node:fs"
  import path from "node:path"
  import type { AndroidTools, TestSigner } from "./support/android-tools.ts"

  export const FLAVORS = ["store", "sideload"] as const
  export const SIGNING = ["FIXTURE_STORE", "FIXTURE_STORE_PASSWORD", "FIXTURE_KEY_ALIAS", "FIXTURE_KEY_PASSWORD"] as const
  export const REQUESTED = ["android.permission.INTERNET", "android.permission.POST_NOTIFICATIONS", "android.permission.FOREGROUND_SERVICE", "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"]
  export const SPECIAL_USE = "0x40000000"
  export const NODE = { version: "26.13.1", ndk: "29.0.14206865", apiLevel: 29 }
  export const INFERENCE = /(\.gguf|\.onnx|\.tflite|\.safetensors)$|libllama|libggml|llama-server|^assets\/models\//

  /** @throws {never} */
  function isJava21(home: string): boolean {
    try {
      return existsSync(path.join(home, "bin", "javac")) && /^JAVA_VERSION="21[."]/m.test(readFileSync(path.join(home, "release"), "utf8"))
    } catch {
      return false
    }
  }

  /** @throws {never} */
  export function java21(): string | null {
    const home = process.env.JAVA_HOME
    if (home !== undefined && isJava21(home)) return home
    try {
      const found = execFileSync("/usr/libexec/java_home", ["-v", "21"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim()
      return isJava21(found) ? found : null
    } catch {
      return null
    }
  }

  /** @throws {never} */
  export function absence(tools: AndroidTools, javaHome: string | null): string | null {
    if (tools.kind === "missing") return tools.reason
    return javaHome === null ? "no Java 21 development kit in JAVA_HOME or /usr/libexec/java_home" : null
  }

  export interface Environments {
    readonly none: NodeJS.ProcessEnv
    readonly partial: NodeJS.ProcessEnv
    readonly all: NodeJS.ProcessEnv
  }

  /** @throws {never} */
  export function environments(sdk: string, javaHome: string, signer: TestSigner): Environments {
    const none: NodeJS.ProcessEnv = { ...process.env, ANDROID_HOME: sdk, JAVA_HOME: javaHome }
    for (const name of SIGNING) delete none[name]
    return {
      none,
      partial: { ...none, FIXTURE_STORE: signer.keystore, FIXTURE_KEY_ALIAS: signer.alias },
      all: { ...none, FIXTURE_STORE: signer.keystore, FIXTURE_STORE_PASSWORD: signer.password, FIXTURE_KEY_ALIAS: signer.alias, FIXTURE_KEY_PASSWORD: signer.password },
    }
  }

  export interface Command {
    readonly command: string
    readonly args: readonly string[]
  }

  /** @throws {never} */
  export const passes = (consumer: string): Command => ({ command: process.execPath, args: [path.join(consumer, "verify-apks.mjs")] })
  export const FAILS: Command = { command: process.execPath, args: ["-e", "process.exit(3)"] }

  /** @throws {never} */
  export const sha256 = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex")

  export interface ManifestRow {
    readonly flavor: string
    readonly name: string
    readonly sha256: string
    readonly signer: string | null
  }

  /** @throws {never} */
  export const message = (error: unknown) => String((error as { readonly message?: unknown } | null)?.message ?? error)

  /** @throws {never} */
  export const releaseName = (flavor: string, signed: boolean) => `${flavor}-release${signed ? "" : "-unsigned"}.apk`
}
import { FAILS, FLAVORS, INFERENCE, NODE, REQUESTED, SPECIAL_USE, absence, environments, java21, message, passes, releaseName, sha256, type Command, type ManifestRow } from node

const tools = androidTools()
const javaHome = java21()
const skipped = absence(tools, javaHome)

effect function published(output: string) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const names = (try files.readDirectory(output)).filter((name) => name.endsWith(".apk")).sort()
  const digests: Record<string, string> = {}
  for (const name of names) digests[name] = sha256(try files.readFile(path.join(output, name)))
  return digests
}

effect function stageRuntime(consumer: string) {
  const files = try FileSystem.FileSystem
  const path = try Path.Path
  const payload = try fixture("runtime-payload")
  const elf = try files.readFile(path.join(payload, "node-x86_64.so"))
  const digest = sha256(elf)
  const built = path.join(payload, "node-x86_64")
  try writeTree(built, { "libeliza_node.so": elf, "node-runtime.json": JSON.stringify({ schema: 1, abi: "x86_64", ...NODE, sha256: digest }) })
  try writeTree(payload, {
    "node.lock.json": JSON.stringify({ ...NODE, sourceSha256: "e".repeat(64), buildCommit: "c".repeat(40), entries: [{ abi: "x86_64", sha256: digest, archiveSha256: "a".repeat(64), url: "https://example.invalid/node-x86_64.zip" }] }),
  })
  const staged = try stageRuntimePayload({ abi: ["x86_64"], bundleDir: path.join(payload, "bundle"), lock: path.join(payload, "node.lock.json"), runtimes: [{ kind: "built", dir: built }], output: path.join(consumer, "runtime") })
  return staged.output
}

it.effect.skipIf(skipped !== null)(`Generate the fixture host, refuse a partial signing set before Gradle, and replace the published APKs only with a verified set${skipped === null ? "" : ` (skipped: ${skipped})`} (spec/os/build/androidHost.md, "Story: Generate my app's Android host from data"; spec/os/build/androidHost.md, "Version override and release signing each name all of their distinct environment variables or none"; spec/os/build/androidHost.md, "The agent entry, its notification and its launch hook need the agent service module and extracted 16 KiB aligned native libraries"; spec/os/build/androidHost.md, "An os module adds no permission or exported component the profile did not request"; spec/os/build/androidHost.md, "A release is published signed only when every signing variable is set and the output is signed, and unsigned only when none is set and the output is unsigned"; spec/os/build/androidHost.md, "A host without local inference carries no model, inference library, model server or model directory"; spec/os/build/androidHost.md, "The APK manifest lists each flavor's own published APK of this build once, fresh, with its digest and one shared signer unless the release is unsigned"; spec/os/build/androidBuild.md, "Story: Replace published APKs only with this run's verified set"; spec/os/build/androidBuild.md, "A request is admitted only when well formed, built from the pinned source and an identified payload"; spec/os/build/androidBuild.md, "The private set is verified against the pin, the payload and a fresh APK manifest before it can be published"; spec/os/build/androidBuild.md, "Only a verified set replaces the published APKs, in one rename, with an honest receipt")`, effect () => {
  if (tools.kind === "missing" || javaHome === null) return
  provide NodeServices.layer, FetchHttpClient.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const consumer = try fixture("android-host")
    const signer = try Effect.try(() => testSigner(tools, path.dirname(consumer)))
    const identityText = try files.readFileString(path.join(consumer, "identity.json"))
    const profileText = try files.readFileString(path.join(consumer, "profile.json"))
    const identity: { readonly appId: string } = try Effect.try(() => JSON.parse(identityText))
    const profile: unknown = try Effect.try(() => JSON.parse(profileText))
    try git(consumer, ["init", "--quiet", "--initial-branch=main"])
    const pin = try commitTree(consumer, {}, "Pin the fixture consumer")
    const host = path.join(consumer, "host")
    const output = path.join(consumer, "artifacts")
    const runtime = try stageRuntime(consumer)
    try generateAndroidHost({ consumerRoot: consumer, output: host, identity, profile, runtime })

    const signing = environments(tools.sdk, javaHome, signer)
    const PASSES = passes(consumer)
    const build = (environment: NodeJS.ProcessEnv, verify: Command) =>
      buildAndroid({ root: consumer, project: "host", output: "artifacts", variants: [...FLAVORS], environment, verify, pin, lint: false, androidTest: false })

    const partial = (effect { try build(signing.partial, PASSES); return "built" } catch (error) => message(error))
    assert.match(partial, /FIXTURE_STORE_PASSWORD/)
    assert.match(partial, /FIXTURE_KEY_PASSWORD/)
    assert.isFalse(try files.exists(path.join(host, "app", "build")), "a partial signing set is refused before Gradle runs")

    try build(signing.all, PASSES)
    const first = try published(output)
    assert.deepStrictEqual(Object.keys(first).filter((name) => name.includes("-release")).sort(), FLAVORS.map((flavor) => releaseName(flavor, true)).sort())
    const manifestText = try files.readFileString(path.join(output, "apk-manifest.json"))
    const rows: readonly ManifestRow[] = try Effect.try(() => JSON.parse(manifestText))
    for (const flavor of FLAVORS) {
      const apk = path.join(output, releaseName(flavor, true))
      const signerDigest = try readApkSignerDigest(apk, { apksigner: tools.apksigner })
      assert.strictEqual(signerDigest, signer.certificateSha256)
      assert.deepStrictEqual(rows.filter((row) => row.flavor === flavor), [{ flavor, name: releaseName(flavor, true), sha256: first[releaseName(flavor, true)], signer: signerDigest }])

      const entries = try listAndroidArtifactEntries(apk)
      assert.include(entries, "lib/x86_64/libeliza_node.so")
      assert.deepStrictEqual(entries.filter((entry) => INFERENCE.test(entry)), [])
      for (const name of ["host.json", "character.json", "policy.json"]) {
        assert.strictEqual((try archiveDigest(apk, `assets/agent/${name}`)).sha256, sha256(try files.readFile(path.join(consumer, "agent", name))))
      }

      const tree = try aaptManifestTree(apk, { aapt: tools.aapt })
      const facts = manifestFacts(tree)
      assert.deepStrictEqual(facts.permissions.filter((permission) => !permission.startsWith(`${identity.appId}.`)).sort(), [...REQUESTED].sort())
      assert.deepStrictEqual(facts.exported.map((component) => component.name), ["example.fixture.host.MainActivity"])
      const services = (function walk(node: ReturnType<typeof parseXmlTree>): ReturnType<typeof parseXmlTree>[] {
        return node.children.flatMap((child) => [...(child.name === "service" ? [child] : []), ...walk(child)])
      })(parseXmlTree(tree))
      const agent = services.find((service) => service.attrs.name === "example.fixture.host.FixtureAgentService")
      assert.strictEqual(agent?.attrs.foregroundServiceType, SPECIAL_USE, "the agent service declares the specialUse type")
    }

    const gradleFile = path.join(host, "app", "build.gradle")
    const gradle = try files.readFileString(gradleFile)
    const stripped = gradle.replace("if (hostSigning) signingConfig signingConfigs.release", "")
    assert.notStrictEqual(stripped, gradle, "the generated host signs the release through hostSigning")
    try files.writeFileString(gradleFile, stripped)
    const unsigned = (effect { try build(signing.all, PASSES); return "built" } catch (error) => message(error))
    try files.writeFileString(gradleFile, gradle)
    assert.notStrictEqual(unsigned, "built", "every signing variable is set, so an unsigned release fails the build")
    assert.deepStrictEqual(try published(output), first)

    const unverified = (effect { try build(signing.none, FAILS); return "built" } catch (error) => message(error))
    assert.notStrictEqual(unverified, "built", "a failed verification publishes nothing")
    assert.deepStrictEqual(try published(output), first)

    try build(signing.none, PASSES)
    const second = try published(output)
    assert.deepStrictEqual(Object.keys(second).filter((name) => name.includes("-release")).sort(), FLAVORS.map((flavor) => releaseName(flavor, false)).sort())
    const unsignedText = try files.readFileString(path.join(output, "apk-manifest.json"))
    const unsignedRows: readonly ManifestRow[] = try Effect.try(() => JSON.parse(unsignedText))
    assert.deepStrictEqual(unsignedRows, FLAVORS.map((flavor) => ({ flavor, name: releaseName(flavor, false), sha256: second[releaseName(flavor, false)], signer: null })), "an unsigned release build lists each flavor's unsigned release APK with no signer")
  }
}, 1_800_000)
