// spec/os/image/staging.md, "Story: Stage my launcher into an image exactly once"; spec/os/image/harness.md, "Story: Run instrumentation on a device I hold alone"; spec/os/image/harness.md, "Story: Run a test in a fresh Android user that is removed afterwards"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { NATIVE_INSTALLS, NATIVE_TARGETS, createDevelopmentLauncherDescriptor, finalizeNative, readNativeLibraries, renderOverlay, stageLauncher, validateDescriptor, type LauncherDescriptor } from "../src/image/stage-launcher.vibe"
import { androidTools, buildApk, testSigner, type NativeAbi } from "./support/android-tools.ts"
import { commitTree, git, pinnedCheckout, readTree, scratch, writeTree } from "./support/scratch.vibe"
import { composeProduct } from "../src/image/compose-product.vibe"
import { reviewedPrivilegedPermissions } from "../gen/os__image__staging.effect.vibe"
import { loadProfile, verifySource, verifyDeviceSource, admitPatchEnvelope } from "../src/image/source-lock.vibe"
import { main as qualify, qualifyDevice } from "../src/image/device-qualification.vibe"
import { readOnlyCommands } from "../src/image/device-qualification-facts.vibe"
import { verifyImage } from "../src/image/verify-device.vibe"
import { listenerPermissions, prepareListenerSystemui, verifyListenerSystemui } from "../src/image/listener.vibe"
import { AdbFailed, captureCommand, rebootAndroidFixture } from "../src/image/device.vibe"
import {
  HELD_FOR_THE_RUN, acquireDeviceLease, instrumentationDeclarations, leaseStateDirectory, readDeviceLease,
  requireInstrumentationInterruption, requireInstrumentationSuccess, withIsolatedAndroidUser,
} from "../src/image/index.vibe"

module node {
  import { spawnSync } from "node:child_process"
  import { createHash } from "node:crypto"
  import { chmod, cp, mkdir, readFile, stat, symlink, utimes, writeFile } from "node:fs/promises"
  import { join } from "node:path"
  import type { Tree } from "./support/scratch.vibe"
  const sourceDigest = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex")
  const sourceText = (value: string) => new TextEncoder().encode(value)
  export async function changeMode(file: string, mode: number): Promise<void> { await chmod(file, mode) }
  /** @throws {never} */
  export function swapVariable(name: string, value: string | undefined): string | undefined {
    const previous = process.env[name]
    if (value === undefined) delete process.env[name]
    else process.env[name] = value
    return previous
  }
  export async function directoryMode(directory: string): Promise<number> { return (await stat(directory)).mode & 0o777 }
  export async function linkTo(target: string, link: string): Promise<void> { await symlink(target, link) }
  export async function copySystemui(folder: string, fixture: string): Promise<string> {
    const source = join(folder, "source")
    const project = join(source, "frameworks/base")
    await mkdir(join(source, "frameworks"), { recursive: true })
    await cp(fixture, project, { recursive: true, force: false, errorOnExist: true })
    return source
  }
  export async function qualificationBinary(directory: string, fixture: string, commands: Readonly<Record<string, string>>, failed?: string) {
    const binary = join(directory, failed ?? "adb-fixture")
    const log = join(directory, `${failed ?? "adb-fixture"}.jsonl`)
    const script = `#!/usr/bin/env node\nimport { appendFileSync, readFileSync, existsSync } from "node:fs";\nimport { join } from "node:path";\nconst args = process.argv.slice(2);\nappendFileSync(${JSON.stringify(log)}, JSON.stringify(args) + "\\n");\nif (args[0] !== "-s" || args[1] !== "emulator-4242") process.exit(77);\nif (args.length === 3 && args[2] === "get-state") { process.stdout.write("device\\n"); process.exit(0); }\nconst command = Object.entries(${JSON.stringify(commands)}).find(([, value]) => value === args[3]);\nif (args.length !== 4 || args[2] !== "shell" || command === undefined) process.exit(78);\nconst [key] = command;\nconst input = join(${JSON.stringify(fixture)}, key + ".txt");\nif (existsSync(input)) process.stdout.write(readFileSync(input));\nif (key === ${JSON.stringify(failed ?? "")}) { process.stderr.write("Capture unavailable\\n"); process.exit(79); }\n`
    await writeFile(binary, script, { mode: 0o700 })
    return { binary, log, fixture }
  }
  export async function verificationBinary(directory: string, name: string, responses: Readonly<Record<string, string | string[]>>, serial = "127.0.0.1:6520") {
    const binary = join(directory, `${name}.mjs`)
    const log = join(directory, `${name}.jsonl`)
    const script = `#!/usr/bin/env node\nimport { appendFileSync, readFileSync, existsSync } from "node:fs";\nconst args = process.argv.slice(2);\nif (args[0] !== "-s" || args[1] !== ${JSON.stringify(serial)} || args[2] !== "shell") process.exit(80);\nconst key = args.slice(3).join(" ");\nconst log = ${JSON.stringify(log)};\nconst past = existsSync(log) ? readFileSync(log, "utf8").trim().split("\\n").filter(Boolean).map((row) => JSON.parse(row)) : [];\nappendFileSync(log, JSON.stringify(key) + "\\n");\nconst answers = ${JSON.stringify(responses)};\nif (!Object.hasOwn(answers, key)) process.exit(81);\nconst row = answers[key];\nprocess.stdout.write(Array.isArray(row) ? row[past.filter((value) => value === key).length] ?? "" : row);\n`
    await writeFile(binary, script, { mode: 0o700 })
    return { binary, log }
  }
  export function platformProjectTree(): Tree {
    return { ".gitignore": "ignored/**\n", "input.txt": "reviewed source\n", "board.mk": "RELEASE_BOARD_API_LEVEL := 202604\n" }
  }
  export async function fixedSourceStat(file: string): Promise<void> { await utimes(file, 1700000000, 1700000000) }
  export async function rewriteWithSameStat(file: string, value: string): Promise<void> {
    const before = await stat(file)
    if ((await readFile(file)).byteLength !== sourceText(value).byteLength) throw new Error("The stat-cache fixture must preserve the actual byte length")
    await writeFile(file, value)
    await fixedSourceStat(file)
    const after = await stat(file)
    if (before.ino !== after.ino || before.size !== after.size || before.mtimeMs !== after.mtimeMs) throw new Error("The stat-cache fixture did not preserve inode, size and modification time")
  }
  export async function sourceLockFixture(root: string, manifestCommit: string, projectCommit: string) {
    const manifest = "<manifest/>\n"
    const projectList = "project-a\n"
    const ignored = "locally generated but explicitly inventoried\n"
    const vendor = "<manifest><sepolicy><version>202604</version></sepolicy></manifest>\n"
    const factory = "bounded resettable factory fixture, never flashed\n"
    await mkdir(join(root, ".repo"), { recursive: true })
    await mkdir(join(root, "project-a/ignored"), { recursive: true })
    await mkdir(join(root, "vendor/generated"), { recursive: true })
    await writeFile(join(root, ".repo/manifest.xml"), manifest)
    await writeFile(join(root, ".repo/project.list"), projectList)
    await writeFile(join(root, "project-a/ignored/input.bin"), ignored)
    await writeFile(join(root, "vendor/generated/manifest.xml"), vendor)
    await writeFile(join(root, "factory.img"), factory)
    const files = (path: string, value: string) => ({ path, sizeBytes: sourceText(value).byteLength, sha256: sourceDigest(sourceText(value)) })
    const manifestIdentity = { commit: manifestCommit, tag: "fixture", tagObject: manifestCommit }
    const ignoredRow = files("project-a/ignored/input.bin", ignored)
    const inventory = { schema: 1, target: "fixture", device: { codename: "fixture", androidRelease: "17" }, developmentOnly: true, releaseQualified: false,
      manifest: { ...manifestIdentity, configuration: [files(".repo/manifest.xml", manifest), files(".repo/project.list", projectList)] },
      factory: { filename: "factory.img", sizeBytes: sourceText(factory).byteLength, sha256: sourceDigest(sourceText(factory)) }, projects: [{ path: "project-a", commit: projectCommit }],
      overrides: [], generated: { root: "vendor/generated", files: [files("vendor/generated/manifest.xml", vendor)] },
      ignoredInputs: [{ project: "project-a", files: 1, sha256: sourceDigest(sourceText(JSON.stringify(ignoredRow) + "\n")) }] }
    const sourceBytes = sourceText(JSON.stringify(inventory) + "\n")
    await writeFile(join(root, "source-inventory.json"), sourceBytes)
    const profile = { kind: "physical", targets: ["fixture"], manifest: manifestIdentity, sourceInventory: { path: "source-inventory.json", sha256: sourceDigest(sourceBytes) },
      device: { sourceTarget: "fixture", codename: "fixture", androidRelease: "17", vendorApiLevel: "202604" } }
    const lockFile = join(root, "aosp.lock.json")
    await writeFile(lockFile, JSON.stringify({ schemaVersion: 1, profiles: { fixture: profile, partial: { kind: "virtual", targets: ["fixture"], manifest: manifestIdentity, projects: [{ path: "project-a", commit: projectCommit }] } } }))
    return { lockFile, factory: join(root, "factory.img"), manifest, projectList, ignored, vendor }
  }

  export async function patchFixture(root: string, baseline: string, revision: string) {
    const patch = "resettable source patch fixture\n"
    const patchFile = join(root, "reviewed.patch")
    const manifestFile = join(root, "patch-manifest.json")
    await writeFile(patchFile, patch)
    const manifest = JSON.stringify({ baselineLockSha256: baseline, project: "project-a", revision, patchSha256: sourceDigest(sourceText(patch)), files: [{ path: "input.txt", beforeSha256: sourceDigest(sourceText("reviewed source\n")), afterSha256: sourceDigest(sourceText("reviewed patched source\n")) }] })
    await writeFile(manifestFile, manifest)
    return { name: "fixture-patch", patchFile, manifestFile, manifestSha256: sourceDigest(sourceText(manifest)) }
  }
  import { standInElf, type NativeAbi } from "./support/android-tools.ts"

  export interface StagedJson {
    readonly abi?: string
    readonly apkSha256?: string
    readonly installRule?: string
    readonly deferred?: boolean
    readonly soongPatch?: { readonly name: string; readonly patchSha256: string }
    readonly libraries?: readonly { readonly installPath: string; readonly mode: string }[]
    readonly descriptor?: unknown
    readonly evidence?: { readonly conversion?: string }
    readonly state?: { readonly phase: { readonly tag: string } }
  }

  export interface PathStager {
    readonly REVIEWED_PRIVILEGED_PERMISSIONS: readonly string[]
    readonly validateDescriptor: (value: unknown) => unknown
    readonly launcherInstallDirectory: (descriptor: object) => string
    readonly renderOverlay: (descriptor: object) => { readonly blueprint: string; readonly product: string; readonly permissions: string | null; readonly privilegedPermissions: string | null }
    readonly renderNativeOverlay: (descriptor: object, abi: NativeAbi, libraries: readonly { readonly name: string; readonly sha256: string }[], install: "make" | "soong") => {
      readonly blueprint: string
      readonly makefile: string | null
      readonly config: string
      readonly report: { readonly soongPatch?: { readonly name: string } }
    }
    readonly stageLauncher: (options: Readonly<Record<string, unknown>>) => { readonly output: string; readonly provisioning: Readonly<Record<string, string | null>> | null }
  }

  export interface StandInApk {
    readonly packageName: string
    readonly signers: readonly string[]
    readonly home?: boolean
    readonly debuggable?: boolean
    readonly permissions?: readonly string[]
  }

  export interface StandInCall {
    readonly apk: string
    readonly companions?: Readonly<Record<string, string>>
    readonly development?: boolean
  }

  /** @throws {never} */
  export function standInApk(shape: StandInApk): Uint8Array {
    const named = (indent: number, value: string) => `${" ".repeat(indent)}A: android:name(0x01010003)="${value}" (Raw: "${value}")`
    const permissions = shape.permissions ?? []
    const xml = [
      "N: android=http://schemas.android.com/apk/res/android",
      "  E: manifest (line=2)",
      `    A: package="${shape.packageName}" (Raw: "${shape.packageName}")`,
      ...permissions.flatMap((permission) => ["    E: uses-permission (line=3)", named(6, permission)]),
      "    E: application (line=4)",
      ...(shape.debuggable === true ? ["      A: android:debuggable(0x0101000f)=(type 0x12)0xffffffff"] : []),
      "      E: activity (line=5)",
      named(8, ".MainActivity"),
      "        A: android:exported(0x01010010)=(type 0x12)0xffffffff",
      "        E: intent-filter (line=6)",
      "          E: action (line=7)",
      named(12, "android.intent.action.MAIN"),
      "          E: category (line=8)",
      named(12, shape.home === false ? "android.intent.category.LAUNCHER" : "android.intent.category.HOME"),
      "          E: category (line=9)",
      named(12, "android.intent.category.DEFAULT"),
    ].join("\n")
    const answers = {
      badging: [`package: name='${shape.packageName}' versionCode='3' versionName='1.3'`, ...permissions.map((permission) => `uses-permission: name='${permission}'`)].join("\n"),
      xml,
      signatures: shape.signers.map((certificate, index) => `Signer #${index + 1} certificate SHA-256 digest: ${certificate}`).join("\n"),
    }
    const emptyDirectory = new Uint8Array(22)
    emptyDirectory.set([0x50, 0x4b, 0x05, 0x06])
    return Buffer.concat([Buffer.from(JSON.stringify(answers)), emptyDirectory])
  }

  /** @throws {never} */
  export function standInTool(): string {
    return `#!${process.execPath}
const { readFileSync } = require("node:fs")
const args = process.argv.slice(2)
const bytes = readFileSync(args.find((value) => value.endsWith(".apk")))
const answers = JSON.parse(bytes.subarray(0, bytes.length - 22).toString("utf8"))
process.stdout.write(args[0] === "verify" ? answers.signatures : args[1] === "badging" ? answers.badging : answers.xml)
`
  }

  /** @throws {never} */
  export function digestOf(bytes: Uint8Array): string {
    return sourceDigest(bytes)
  }

  /** @throws {never} */
  export function runByPath(file: string, argv: readonly string[]) {
    const run = spawnSync(process.execPath, [file, ...argv], { encoding: "utf8" })
    return { status: run.status, stdout: String(run.stdout).trim(), failure: String(run.stderr) }
  }

  /** @throws {never} */
  export function overlayDeclarations(tree: Readonly<Record<string, string>>) {
    const uncommented = (text: string | undefined) => text?.split("\n").filter((line) => !line.startsWith("<!--")).join("\n")
    return {
      files: Object.keys(tree).filter((name) => !name.startsWith("sepolicy/")).sort(),
      modules: soongModules(tree["Android.bp"]),
      packages: (tree["product.mk"] ?? "").split("\n").filter((line) => line.startsWith("PRODUCT_PACKAGES")),
      grants: uncommented(tree["default-permissions.xml"]),
      allowList: uncommented(tree["privapp-permissions.xml"]),
      apks: Object.entries(tree).filter(([name]) => name.endsWith(".apk")),
    }
  }

  /** @throws {never} */
  export function soongModules(blueprint: string | undefined): string[] {
    return [...(blueprint ?? "").matchAll(/^\w+ \{\n(?: {4}.*\n)*\}$/gm)].map((block) => block[0])
  }

  export const ARM_ELF = standInElf("arm64-v8a")
  export const X86_ELF = standInElf("x86_64")

  /** @throws {never} */
  export function parsed(text: string | undefined): StagedJson {
    try {
      return JSON.parse(text ?? "{}") as StagedJson
    } catch {
      return {}
    }
  }

  /** @throws {never} */
  export function launcherManifest(packageName: string, debuggable: boolean): string {
    return `<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="${packageName}" android:versionCode="3" android:versionName="1.3">
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
  <application android:label="Home" android:debuggable="${debuggable}" android:allowBackup="false">
    <activity android:name=".HomeActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
  </application>
</manifest>
`
  }

  /** @throws {never} */
  export function companionManifest(packageName: string): string {
    return `<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="${packageName}" android:versionCode="1" android:versionName="1.0">
  <application android:label="Updater" android:debuggable="false" android:allowBackup="false">
    <activity android:name=".UpdaterActivity" android:exported="false" />
  </application>
</manifest>
`
  }

  /** @throws {never} */
  export function runtimeNatives(abi: NativeAbi): Readonly<Record<string, Uint8Array>> {
    const elf = abi === "x86_64" ? X86_ELF : ARM_ELF
    return { "libeliza_node.so": elf, "libagent.so": elf }
  }
}
import { ARM_ELF, X86_ELF, companionManifest, digestOf, launcherManifest, overlayDeclarations, parsed, runByPath, runtimeNatives, soongModules, standInApk, standInTool, type PathStager, type StandInApk, type StandInCall } from node

import { changeMode, copySystemui, directoryMode, linkTo, swapVariable, fixedSourceStat, patchFixture, platformProjectTree, qualificationBinary, rewriteWithSameStat, sourceLockFixture, verificationBinary } from node

const tools = androidTools()
const skipped = tools.kind === "missing" ? tools.reason : null
const LAUNCHER = "example.fixture.home"
const COMPANION = "example.fixture.updater"
const IDENTITY = { brand: "example", moduleName: "ExampleHome", packageName: LAUNCHER }
const PRIVILEGED = "android.permission.READ_PRIVILEGED_PHONE_STATE"
const suffix = skipped === null ? "" : ` (skipped: ${skipped})`

effect function kit(prefix: string) {
  const path = try Path.Path
  if (tools.kind === "missing") return undefined
  const work = try scratch(prefix)
  const signer = try Effect.try(() => testSigner(tools, work, "launcher"))
  const otherSigner = () => Effect.try(() => testSigner(tools, work, "other"))
  const out = path.join(work, "apks")
  const build = (name: string, manifest: string, natives: Readonly<Partial<Record<NativeAbi, Readonly<Record<string, Uint8Array>>>>> = {}, key = signer) =>
    Effect.try(() => buildApk(tools, { directory: out, manifest, signer: key, name, natives }))
  return { work, signer, otherSigner, build, aapt: tools.aapt, apksigner: tools.apksigner, checkout: path.join(work, "aosp", "device", "google", "cuttlefish", "vendor") }
}

effect function writeDescriptor(file: string, descriptor: unknown) {
  const files = try FileSystem.FileSystem
  try files.writeFileString(file, `${JSON.stringify(descriptor, null, 2)}\n`)
  return file
}

effect function leftovers(directory: string) {
  const files = try FileSystem.FileSystem
  return (try files.readDirectory(directory)).filter((name) => name.startsWith(".launcher-stage-"))
}

effect function outcome(options: Parameters<typeof stageLauncher>[0]) {
  return (effect { const staged = try stageLauncher(options); return staged.evidence.tag } catch (error) => error._tag === "StagingRefused" ? error.reason : error._tag)
}

effect function standIns(prefix: string) {
  const path = try Path.Path
  const work = try scratch(prefix)
  try writeTree(work, { tool: { kind: "executable", content: standInTool() } })
  const apk = effect (name: string, shape: StandInApk) => {
    const bytes = standInApk(shape)
    try writeTree(work, { [`apks/${name}.apk`]: bytes })
    return { apk: path.join(work, "apks", `${name}.apk`), sha256: digestOf(bytes) }
  }
  return { work, tool: path.join(work, "tool"), apk, checkout: path.join(work, "aosp", "vendor") }
}

effect function pathStaged(stager: PathStager, options: Readonly<Record<string, unknown>>) {
  return ((Effect.try({ try: () => stager.stageLauncher(options), catch: (cause) => (cause instanceof Error ? cause.message : String(cause)) }) |> map(%, () => "staged")) catch (message) => message)
}

effect function finalized(output: string) {
  return (effect { const done = try finalizeNative(output); return done.evidence.tag === "OverlayStaged" ? done.evidence.conversion : done.evidence.tag } catch (error) => error._tag)
}

effect function compositionSource(root: string) {
  const profile = try pinnedCheckout(root)
  const lockFile = `${root}/aosp.lock.json`
  try writeTree(root, { "aosp.lock.json": JSON.stringify({ schemaVersion: 1, profiles: { cuttlefish: profile(["cf_x86_64_phone"], true) } }) })
  return { profile: try loadProfile({ name: "cuttlefish", lockFile }), sourceRoot: root }
}

effect function compositionFailure(request: Parameters<typeof composeProduct>[0]) {
  return (effect { try composeProduct(request); return "published" } catch (failure) =>
    failure._tag === "ProductRefused" ? failure.problems.join(",") : failure._tag)
}

it.effect.skipIf(skipped !== null)(`Stage a development launcher and a signer-pinned privileged launcher with a companion into a Cuttlefish add-on, and refuse every other APK${suffix} (spec/os/image/staging.md, "Story: Stage my launcher into an image exactly once"; spec/os/image/staging.md, "A descriptor names a valid launcher, at most 32 unique first-boot grants, only reviewed privileged permissions, and distinct companions"; spec/os/image/staging.md, "The launcher is the descriptor's APK, home launcher and only signer, and declares every permission the descriptor names"; spec/os/image/staging.md, "The overlay grants only declared permissions, and places the launcher in priv-app with its allow-list and the agent socket policy only when it names privileged permissions"; spec/os/image/staging.md, "The staging evidence names the staged APK and mode and nothing beyond staging")`, effect () => {
  provide NodeServices.layer {
    const k = try kit("image-stage")
    if (k === undefined) return
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const debug = try k.build("debug", launcherManifest(LAUNCHER, true))
    const release = try k.build("release", launcherManifest(LAUNCHER, false))
    const foreignSigner = try k.otherSigner()
    const foreign = try k.build("foreign", launcherManifest(LAUNCHER, false), {}, foreignSigner)
    const updater = try k.build("updater", companionManifest(COMPANION))
    const base = { aapt: k.aapt, apksigner: k.apksigner }

    const outsideDevelopment = (createDevelopmentLauncherDescriptor({ identity: IDENTITY, apk: debug.apk, apksigner: k.apksigner, development: false }) |> map(%, () => "created")) catch (error) => error._tag
    assert.strictEqual(outsideDevelopment, "DevelopmentRequired")
    const developmentDescriptor = try createDevelopmentLauncherDescriptor({ identity: IDENTITY, apk: debug.apk, apksigner: k.apksigner, development: true })
    assert.deepStrictEqual(developmentDescriptor, { schemaVersion: 1, ...IDENTITY, apkSha256: debug.sha256, certificateSha256: k.signer.certificateSha256 })
    const developmentFile = try writeDescriptor(path.join(k.work, "development.json"), { ...developmentDescriptor, defaultPermissions: ["android.permission.CAMERA"] })
    assert.strictEqual(try outcome({ ...base, descriptor: developmentFile, apk: debug.apk, output: path.join(k.checkout, "production-debug"), development: false }), "BuildNotAllowed")
    const development = try stageLauncher({ ...base, descriptor: developmentFile, apk: debug.apk, output: path.join(k.checkout, "development"), development: true })
    assert.deepStrictEqual(development.evidence, { tag: "OverlayStaged", apkSha256: { tag: "Sha256", hex: debug.sha256 }, stagingMode: "StageDevelopment", conversion: "NoConversion" })
    const developmentTree = try readTree(development.output)
    assert.deepStrictEqual(Object.keys(developmentTree).sort(), ["Android.bp", "Launcher.apk", "default-permissions.xml", "launcher.json", "product.mk"])
    assert.include(developmentTree["default-permissions.xml"] ?? "", `<permission name="android.permission.CAMERA" fixed="false"/>`)
    assert.notInclude(developmentTree["Android.bp"] ?? "", "privileged")
    assert.strictEqual(developmentTree["product.mk"], "PRODUCT_PACKAGES += ExampleHome ExampleHomeDefaultPermissions\n")
    assert.strictEqual(path.dirname(development.output), k.checkout)

    const pinned: LauncherDescriptor = try validateDescriptor({
      schemaVersion: 1,
      ...IDENTITY,
      apkSha256: release.sha256,
      certificateSha256: k.signer.certificateSha256,
      defaultPermissions: ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      privilegedPermissions: [PRIVILEGED],
      companions: [{ moduleName: "ExampleUpdater", packageName: COMPANION, apkSha256: updater.sha256 }],
    })
    const pinnedFile = try writeDescriptor(path.join(k.work, "pinned.json"), pinned)
    const refusedDescriptors = [
      { ...pinned, privilegedPermissions: ["android.permission.CAMERA"] },
      { ...pinned, defaultPermissions: [PRIVILEGED] },
      { ...pinned, privilegedPermissions: [] },
      { ...pinned, moduleName: "bad name" },
      { ...pinned, partition: "vendor" },
      { ...pinned, companions: [{ moduleName: "ExampleHome", packageName: COMPANION, apkSha256: updater.sha256 }] },
    ]
    for (const descriptor of refusedDescriptors) assert.strictEqual((validateDescriptor(descriptor) |> map(%, () => "valid")) catch (error) => error._tag, "DescriptorRefused")

    const production = { ...base, descriptor: pinnedFile, companions: { ExampleUpdater: updater.apk }, development: false }
    assert.strictEqual(try outcome({ ...production, apk: foreign.apk, output: path.join(k.checkout, "foreign") }), "LauncherDigestMismatch")
    const foreignFile = try writeDescriptor(path.join(k.work, "foreign.json"), { ...pinned, apkSha256: foreign.sha256 })
    assert.strictEqual(try outcome({ ...production, descriptor: foreignFile, apk: foreign.apk, output: path.join(k.checkout, "foreign") }), "SignerNotTheDescriptors")
    assert.strictEqual(try outcome({ ...production, apk: release.apk, companions: {}, output: path.join(k.checkout, "no-companion") }), "CompanionRefused")
    assert.strictEqual(try outcome({ ...production, apk: release.apk, companions: { ExampleUpdater: release.apk }, output: path.join(k.checkout, "home-companion") }), "CompanionRefused")
    assert.deepStrictEqual(try leftovers(k.checkout), [])
    assert.deepStrictEqual((try files.readDirectory(k.checkout)).sort(), ["development"])

    const staged = try stageLauncher({ ...production, apk: release.apk, output: path.join(k.checkout, "launcher") })
    assert.deepStrictEqual(staged.evidence, { tag: "OverlayStaged", apkSha256: { tag: "Sha256", hex: release.sha256 }, stagingMode: "StageProduction", conversion: "NoConversion" })
    assert.strictEqual(staged.provisioning, null)
    const tree = try readTree(staged.output)
    assert.deepStrictEqual(Object.keys(tree).sort(), ["Android.bp", "ExampleUpdater.apk", "Launcher.apk", "default-permissions.xml", "launcher.json", "privapp-permissions.xml", "product.mk", "sepolicy/eliza_agent_socket.te"])
    assert.deepStrictEqual(tree, { ...tree, ...renderOverlay(pinned) })
    const blueprint = tree["Android.bp"] ?? ""
    assert.include(blueprint, `name: "ExampleHome",\n    apk: "Launcher.apk",\n    presigned: true,\n    preprocessed: true,\n    privileged: true,\n    product_specific: true,`)
    assert.include(blueprint, `name: "ExampleUpdater",\n    apk: "ExampleUpdater.apk",\n    presigned: true,\n    preprocessed: true,\n    product_specific: true,`)
    assert.include(tree["privapp-permissions.xml"] ?? "", `<permission name="${PRIVILEGED}"/>`)
    assert.notInclude(tree["default-permissions.xml"] ?? "", PRIVILEGED)
    assert.notInclude(tree["default-permissions.xml"] ?? "", COMPANION)
    assert.strictEqual(tree["sepolicy/eliza_agent_socket.te"], "allow priv_app_all privapp_data_file:sock_file { create unlink getattr setattr write rename };\n")
    assert.include(tree["product.mk"] ?? "", "PRODUCT_PACKAGES += ExampleHome ExampleHomeDefaultPermissions ExampleHomePrivappPermissions ExampleUpdater\n")
    assert.include(tree["product.mk"] ?? "", "SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(launcher_policy_dir)\n")
    assert.strictEqual(new Uint8Array(try files.readFile(path.join(staged.output, "Launcher.apk"))).byteLength, new Uint8Array(try files.readFile(release.apk)).byteLength)
    const record = parsed(tree["launcher.json"])
    assert.deepStrictEqual(record.descriptor, pinned)
    assert.strictEqual(record.state?.phase.tag, "Published")
    assert.deepStrictEqual(try leftovers(k.checkout), [])
  }
}, 240_000)

it.effect.skipIf(skipped !== null)(`Stage a non-privileged launcher that carries the runtime on cuttlefish_x86_64 with its natives, and refuse it without them${suffix} (spec/os/image/staging.md, "An APK that carries the Node runtime is staged only with its natives for the image ABI, under the install rules the target supports"; spec/os/image/staging.md, "The overlay grants only declared permissions, and places the launcher in priv-app with its allow-list and the agent socket policy only when it names privileged permissions")`, effect () => {
  provide NodeServices.layer {
    const k = try kit("image-natives")
    if (k === undefined) return
    const path = try Path.Path
    const files = try FileSystem.FileSystem
    const launcher = try k.build("runtime", launcherManifest(LAUNCHER, false), { x86_64: runtimeNatives("x86_64") })
    const armOnly = try k.build("arm", launcherManifest(LAUNCHER, false), { "arm64-v8a": runtimeNatives("arm64-v8a"), x86_64: { "libagent.so": X86_ELF } })
    const wrongElf = try k.build("wrong-elf", launcherManifest(LAUNCHER, false), { x86_64: { "libeliza_node.so": ARM_ELF } })
    const natives = try readNativeLibraries(new Uint8Array(try files.readFile(launcher.apk)), launcher.apk)
    assert.deepStrictEqual(natives.map((native) => [native.entry, native.library.check]), [["lib/x86_64/libagent.so", "EntryValid"], ["lib/x86_64/libeliza_node.so", "EntryValid"]])
    const wrongNatives = try readNativeLibraries(new Uint8Array(try files.readFile(wrongElf.apk)), wrongElf.apk)
    assert.deepStrictEqual(wrongNatives.map((native) => native.library.check), ["EntryNotElfForAbi"])
    const descriptorFor = (sha256: string, name: string) => writeDescriptor(path.join(k.work, `${name}.json`), { schemaVersion: 1, ...IDENTITY, apkSha256: sha256, certificateSha256: k.signer.certificateSha256, partition: "system" })
    const options = { aapt: k.aapt, apksigner: k.apksigner, descriptor: try descriptorFor(launcher.sha256, "runtime"), apk: launcher.apk, development: false }
    assert.strictEqual(try outcome({ ...options, output: path.join(k.checkout, "unstaged") }), "RuntimeNativesNotStaged")
    assert.strictEqual(try outcome({ ...options, nativeAbi: "arm64-v8a", output: path.join(k.checkout, "arm") }), "NoNativesForAbi")
    assert.strictEqual(try outcome({ ...options, descriptor: try descriptorFor(armOnly.sha256, "arm"), apk: armOnly.apk, nativeAbi: "x86_64", output: path.join(k.checkout, "arm") }), "RuntimeMissingForAbi")
    assert.strictEqual(try outcome({ ...options, descriptor: try descriptorFor(wrongElf.sha256, "wrong"), apk: wrongElf.apk, nativeAbi: "x86_64", output: path.join(k.checkout, "wrong") }), "NativeEntryInvalid")
    assert.strictEqual(try outcome({ ...options, nativeAbi: "x86_64", nativeInstall: "make", soongOnly: true, output: path.join(k.checkout, "soong-only") }), "MakeRulesOnSoongOnlyTarget")
    assert.deepStrictEqual(try leftovers(k.checkout), [])

    const staged = try stageLauncher({ ...options, nativeAbi: "x86_64", nativeInstall: "make", output: path.join(k.checkout, "launcher") })
    const tree = try readTree(staged.output)
    assert.deepStrictEqual(Object.keys(tree).sort(), ["Android.bp", "Android.mk", "Launcher.apk", "config.fs", "launcher.json", "native-libraries.json", "native-x86_64/libagent.so", "native-x86_64/libeliza_node.so", "product.mk"])
    assert.include(tree["Android.mk"] ?? "", "LOCAL_MODULE := ExampleHome\n")
    assert.include(tree["Android.mk"] ?? "", "LOCAL_MODULE_TARGET_ARCH := x86_64\n")
    assert.include(tree["Android.mk"] ?? "", "LOCAL_PREBUILT_JNI_LIBS := native-x86_64/libagent.so native-x86_64/libeliza_node.so\n")
    assert.notInclude(tree["Android.mk"] ?? "", "LOCAL_PRIVILEGED_MODULE")
    assert.notInclude(tree["Android.mk"] ?? "", "LOCAL_PRODUCT_MODULE")
    assert.strictEqual(tree["config.fs"], "[system/app/ExampleHome/lib/x86_64/libagent.so]\nmode: 0644\nuser: AID_ROOT\ngroup: AID_ROOT\ncaps: 0\n\n[system/app/ExampleHome/lib/x86_64/libeliza_node.so]\nmode: 0755\nuser: AID_ROOT\ngroup: AID_ROOT\ncaps: 0\n\n")
    for (const native of natives)
      assert.deepStrictEqual(new Uint8Array(try files.readFile(path.join(staged.output, `native-${NATIVE_TARGETS.x86_64.arch}`, native.library.name))), new Uint8Array(native.data))
    const report = parsed(tree["native-libraries.json"])
    assert.deepStrictEqual({ abi: report.abi, installRule: report.installRule, deferred: report.deferred, apkSha256: report.apkSha256 }, { abi: "x86_64", installRule: "android-mk", deferred: false, apkSha256: launcher.sha256 })
    assert.deepStrictEqual((report.libraries ?? []).map((library) => [library.installPath, library.mode]), [["/system/app/ExampleHome/lib/x86_64/libagent.so", "0644"], ["/system/app/ExampleHome/lib/x86_64/libeliza_node.so", "0755"]])
    assert.notProperty(tree, "sepolicy/eliza_agent_socket.te")
  }
}, 240_000)

it.effect.skipIf(skipped !== null)(`Defer the Soong conversion of a privileged runtime launcher, finalize it once after composition, and refuse a tampered overlay${suffix} (spec/os/image/staging.md, "A deferred Soong conversion runs once, only on a published overlay, and only over its unchanged admitted bytes"; spec/os/image/staging.md, "An APK that carries the Node runtime is staged only with its natives for the image ABI, under the install rules the target supports"; spec/os/image/product.md, "Story: Compose my product from a pinned device profile"; spec/os/image/product.md, "The product's launcher is the staged launcher, and on a Pixel it stays off the system partition and apart from the hardware config identity")`, effect () => {
  provide NodeServices.layer {
    const k = try kit("image-soong")
    if (k === undefined) return
    const path = try Path.Path
    const files = try FileSystem.FileSystem
    const launcher = try k.build("runtime", launcherManifest(LAUNCHER, false), { x86_64: runtimeNatives("x86_64") })
    const descriptor = try writeDescriptor(path.join(k.work, "privileged.json"), { schemaVersion: 1, ...IDENTITY, apkSha256: launcher.sha256, certificateSha256: k.signer.certificateSha256, privilegedPermissions: [PRIVILEGED] })
    const options = { aapt: k.aapt, apksigner: k.apksigner, descriptor, apk: launcher.apk, development: false, nativeAbi: "x86_64" as const, nativeInstall: "soong" as const, deferSoong: true, soongOnly: true }

    const output = path.join(k.checkout, "launcher")
    const source = try compositionSource(path.join(k.work, "aosp"))
    const verified = (try verifySource(source)).state
    assert.deepStrictEqual([verified.verdict, verified.lock.developmentOnly], ["Match", true])
    const product = {
      schemaVersion: 1, target: "cuttlefish_x86_64", sourceProfile: "cuttlefish", vendorDirectory: "example",
      productName: "example_cf_x86_64_phone", model: "Example Phone", brand: "example", manufacturer: "Example",
      releaseConfig: "aosp_current", launcher: { moduleName: IDENTITY.moduleName, packageName: LAUNCHER },
    }
    const productDescriptor = try writeDescriptor(path.join(k.work, "product.json"), product)
    const compose = {
      descriptor: productDescriptor, source, purpose: "Development",
      provisioning: { assistant: { tag: "NoAssistant" }, requires: { autofill: false, allFilesAccess: false }, telephonyRoles: false, lockScreen: "SystemOwnsLockScreen" },
    } as const
    const staged = try stageLauncher({ ...options, output })
    assert.deepStrictEqual(staged.evidence, { tag: "OverlayStaged", apkSha256: { tag: "Sha256", hex: launcher.sha256 }, stagingMode: "StageProduction", conversion: "ConversionPending" })
    const before = try readTree(output)
    assert.include(before["Android.mk"] ?? "", "LOCAL_PRIVILEGED_MODULE := true\n")
    const deferredReport = parsed(before["native-libraries.json"])
    assert.deepStrictEqual([deferredReport.installRule, deferredReport.deferred, deferredReport.soongPatch?.name], ["soong-app-native", true, "soong-app-native"])

    for (const name of ["different_cf_x86_64_phone", "example_stallion"]) {
      const bad = try writeDescriptor(path.join(k.work, `${name}.json`), { ...product, productName: name })
      assert.strictEqual(try compositionFailure({ ...compose, descriptor: bad, output }), "SourceNotAdmitted")
    }
    assert.strictEqual(try compositionFailure({ ...compose, purpose: "Production", output }), "SourceNotAdmitted,CuttlefishHostUnpinned")
    assert.deepStrictEqual(try readTree(output), before)

    const composed = try composeProduct({ ...compose, output })
    assert.deepStrictEqual([composed.product, composed.launcher.apkSha256, composed.claims], [product.productName, launcher.sha256, ["ProductStaged"]])
    const after = try readTree(output)
    assert.property(after, "physical-product.json")
    assert.property(after, `${product.productName}.mk`)
    assert.notProperty(after, "Android.mk")
    assert.include(after["Android.bp"] ?? "", `required: ["ExampleHome_native_0", "ExampleHome_native_1"],`)
    assert.include(after["Android.bp"] ?? "", `prebuilt_priv_app_native {\n    name: "ExampleHome_native_1",\n    src: "native-x86_64/libeliza_node.so",\n    filename: "libeliza_node.so",\n    relative_install_path: "ExampleHome/lib/x86_64",\n    product_specific: true,\n}`)
    const report = parsed(after["native-libraries.json"])
    assert.deepStrictEqual([report.installRule, report.deferred, report.soongPatch?.patchSha256], ["soong-app-native", false, deferredReport.soongPatch?.patchSha256])
    assert.strictEqual(after["config.fs"], before["config.fs"])
    assert.strictEqual(after["sepolicy/eliza_agent_socket.te"], before["sepolicy/eliza_agent_socket.te"])
    assert.strictEqual(parsed(after["launcher.json"]).evidence?.conversion, "Converted")
    assert.strictEqual(try finalized(output), "NativeFinalizeRefused")

    const tampered = path.join(k.checkout, "tampered")
    try stageLauncher({ ...options, output: tampered })
    try files.writeFile(path.join(tampered, "native-x86_64", "libagent.so"), ARM_ELF)
    const beforeRefusal = try readTree(tampered)
    assert.strictEqual(try compositionFailure({ ...compose, output: tampered }), "ProductInputUnreadable")
    assert.deepStrictEqual(try readTree(tampered), beforeRefusal)
    assert.strictEqual(try finalized(tampered), "NativeFinalizeRefused")
    const refused = try readTree(tampered)
    assert.property(refused, "Android.mk")
    assert.strictEqual(parsed(refused["launcher.json"]).evidence?.conversion, "ConversionRefused")
    assert.strictEqual(try finalized(tampered), "NativeFinalizeRefused")

    const make = try stageLauncher({ ...options, deferSoong: false, nativeInstall: "make", soongOnly: false, output: path.join(k.checkout, "make") })
    assert.strictEqual(try finalized(make.output), "NativeFinalizeRefused")
    try files.writeFile(path.join(make.output, "Launcher.apk"), ARM_ELF)
    assert.strictEqual(try compositionFailure({ ...compose, output: make.output }), "ProductInputUnreadable")
    assert.isFalse(try files.exists(path.join(make.output, "physical-product.json")))

    const development = try stageLauncher({ ...options, development: true, output: path.join(k.checkout, "development") })
    const beforeDevelopment = try readTree(development.output)
    assert.strictEqual(try compositionFailure({ ...compose, purpose: "Production", output: development.output }), "LauncherDiffers")
    assert.deepStrictEqual(try readTree(development.output), beforeDevelopment)

    assert.strictEqual(try finalized(development.output), "Converted")
    const resumed = try composeProduct({ ...compose, output: development.output })
    assert.deepStrictEqual([resumed.product, resumed.claims], [product.productName, ["ProductStaged"]])
  }
}, 240_000)

it.effect('The stager a consumer runs by path declares the modules, native rules and file modes of the staged overlay (spec/os/image/staging.md, "An APK that carries the Node runtime is staged only with its natives for the image ABI, under the install rules the target supports"; spec/os/image/staging.md, "The overlay grants only declared permissions, and places the launcher in priv-app with its allow-list and the agent socket policy only when it names privileged permissions")', effect () => {
  provide NodeServices.layer {
    const path = try Path.Path
    const stager: PathStager = try Effect.promise(() => import(path.join(import.meta.dirname, "../aosp/stage-launcher-overlay.ts")))
    const pinned: LauncherDescriptor = { schemaVersion: 1, ...IDENTITY, apkSha256: "a".repeat(64), certificateSha256: "b".repeat(64) }
    const libraries = [{ name: "libagent.so", sha256: "c".repeat(64) }, { name: "libeliza_node.so", sha256: "d".repeat(64) }]
    const descriptors: readonly LauncherDescriptor[] = [
      pinned,
      { ...pinned, privilegedPermissions: [PRIVILEGED] },
      { ...pinned, partition: "system", defaultPermissions: ["android.permission.CAMERA"], companions: [{ moduleName: "ExampleUpdater", packageName: COMPANION, apkSha256: "e".repeat(64) }] },
    ]
    for (const descriptor of descriptors) {
      for (const rule of NATIVE_INSTALLS) {
        const byPath = try Effect.try(() => stager.renderNativeOverlay(descriptor, "x86_64", libraries, rule))
        const staged = renderOverlay(descriptor, { abi: "x86_64", rule, libraries })
        const makefile = byPath.makefile === null ? undefined : byPath.makefile.slice(byPath.makefile.indexOf("\n") + 1)
        assert.deepStrictEqual(
          { modules: soongModules(byPath.blueprint), modes: byPath.config, makefile, patch: byPath.report.soongPatch?.name },
          { modules: soongModules(staged["Android.bp"]), modes: staged["config.fs"], makefile: staged["Android.mk"], patch: rule === "soong" ? "soong-app-native" : undefined },
          `${rule} rules for a launcher with ${descriptor.privilegedPermissions?.length ?? 0} privileged permissions on ${descriptor.partition ?? "product"}`,
        )
      }
    }
  }
})

it.effect(`The stager a consumer runs by path takes the descriptors, launchers and companions the staging rules take, refuses the ones they refuse and stages nothing then, and publishes once the modules, packages, grants and allow-list the rule-bound stager publishes; the agent socket policy of a privileged launcher is left to its caller (spec/os/image/staging.md, "Story: Stage my launcher into an image exactly once"; spec/os/image/staging.md, "A descriptor names a valid launcher, at most 32 unique first-boot grants, only reviewed privileged permissions, and distinct companions"; spec/os/image/staging.md, "The launcher is the descriptor's APK, home launcher and only signer, and declares every permission the descriptor names"; spec/os/image/staging.md, "The overlay grants only declared permissions, and places the launcher in priv-app with its allow-list and the agent socket policy only when it names privileged permissions"; spec/os/image/staging.md, "Only an admitted, rendered overlay is published, once, and never over an existing output")`, effect () => {
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const file = path.join(import.meta.dirname, "../aosp/stage-launcher-overlay.ts")
    const stager: PathStager = try Effect.promise(() => import(file))
    const s = try standIns("path-stager")
    const certificate = "b".repeat(64)
    const other = "c".repeat(64)
    const declared = ["android.permission.CAMERA", PRIVILEGED]
    const release = try s.apk("release", { packageName: LAUNCHER, signers: [certificate], permissions: declared })
    const debug = try s.apk("debug", { packageName: LAUNCHER, signers: [certificate], debuggable: true })
    const foreign = try s.apk("foreign", { packageName: LAUNCHER, signers: [other] })
    const twice = try s.apk("twice", { packageName: LAUNCHER, signers: [certificate, certificate] })
    const renamed = try s.apk("renamed", { packageName: "example.fixture.other", signers: [certificate] })
    const shortcut = try s.apk("shortcut", { packageName: LAUNCHER, signers: [certificate], home: false })
    const updater = try s.apk("updater", { packageName: COMPANION, signers: [certificate], home: false })
    const updaterHome = try s.apk("updater-home", { packageName: COMPANION, signers: [certificate] })
    const updaterForeign = try s.apk("updater-foreign", { packageName: COMPANION, signers: [other], home: false })
    const updaterRenamed = try s.apk("updater-renamed", { packageName: "example.fixture.other", signers: [certificate], home: false })

    const plain: LauncherDescriptor = { schemaVersion: 1, ...IDENTITY, apkSha256: release.sha256, certificateSha256: certificate }
    const reviewed: LauncherDescriptor = { ...plain, defaultPermissions: ["android.permission.CAMERA"], privilegedPermissions: [PRIVILEGED] }
    const companion = { moduleName: "ExampleUpdater", packageName: COMPANION, apkSha256: updater.sha256 }
    const pinned: LauncherDescriptor = { ...reviewed, companions: [companion] }
    const admitted: readonly unknown[] = [plain, reviewed, pinned, { ...plain, partition: "system" }]
    const refusedDescriptors: readonly unknown[] = [
      null, { ...plain, schemaVersion: 2 }, { ...plain, brand: '../evil"' }, { ...plain, moduleName: '../evil"' }, { ...plain, packageName: '../evil"' }, { ...plain, apkSha256: "A".repeat(64) }, { ...plain, certificateSha256: "short" },
      { ...plain, defaultPermissions: [] }, { ...plain, defaultPermissions: ["android.permission.CAMERA", "android.permission.CAMERA"] }, { ...plain, defaultPermissions: ['android.permission.X"/><permission name="android.permission.Y'] },
      { ...plain, defaultPermissions: ["com.example.permission.PRIVATE"] }, { ...plain, defaultPermissions: Array.from({ length: 33 }, (_, index) => `android.permission.P${index}`) },
      { ...plain, privilegedPermissions: [] }, { ...plain, privilegedPermissions: PRIVILEGED }, { ...plain, privilegedPermissions: [PRIVILEGED, PRIVILEGED] }, { ...plain, privilegedPermissions: ["android.permission.WRITE_SECURE_SETTINGS"] },
      { ...plain, privilegedPermissions: [null] }, { ...reviewed, defaultPermissions: ["android.permission.CAMERA", PRIVILEGED] }, { ...plain, partition: "vendor" },
      { ...plain, companions: [] }, { ...plain, companions: [{ ...companion, moduleName: IDENTITY.moduleName }] }, { ...plain, companions: [{ ...companion, moduleName: "Launcher" }] },
      { ...plain, companions: [{ ...companion, moduleName: "ExampleHomeDefaultPermissions" }] }, { ...plain, companions: [{ ...companion, packageName: LAUNCHER }] },
      { ...plain, companions: [companion, { ...companion, packageName: "example.fixture.other" }] }, { ...plain, companions: [{ ...companion, apkSha256: "C".repeat(64) }] },
      { ...plain, companions: [{ ...companion, certificateSha256: certificate }] },
    ]
    for (const [verdict, candidates] of [["valid", admitted], ["refused", refusedDescriptors]] as const) {
      for (const candidate of candidates) {
        const byPath = (Effect.try(() => stager.validateDescriptor(candidate)) |> map(%, () => "valid")) catch () => "refused"
        const byRule = (validateDescriptor(candidate) |> map(%, () => "valid")) catch () => "refused"
        assert.deepStrictEqual([byPath, byRule], [verdict, verdict], JSON.stringify(candidate))
      }
    }
    assert.deepStrictEqual([...stager.REVIEWED_PRIVILEGED_PERMISSIONS], reviewedPrivilegedPermissions)
    const installed: readonly LauncherDescriptor[] = [plain, pinned, { ...pinned, partition: "system" }]
    for (const descriptor of installed) {
      const installedAt = try Effect.try(() => stager.launcherInstallDirectory(descriptor))
      assert.include(renderOverlay(descriptor, { abi: "x86_64", rule: "make", libraries: [{ name: "libagent.so", sha256: other }] })["config.fs"] ?? "", `[${installedAt.slice(1)}/lib/x86_64/libagent.so]`)
    }

    const base = { aapt: s.tool, apksigner: s.tool, development: false }
    const companions = { ExampleUpdater: updater.apk }
    const staged: readonly (readonly [string, LauncherDescriptor, StandInCall])[] = [
      ["phone", reviewed, { apk: release.apk }],
      ["phone-development", { ...plain, apkSha256: debug.sha256, partition: "system" }, { apk: debug.apk, development: true }],
      ["companion", pinned, { apk: release.apk, companions }],
    ]
    for (const [name, descriptor, call] of staged) {
      const described = try writeDescriptor(path.join(s.work, `${name}.json`), descriptor)
      const output = path.join(s.checkout, "staged", name)
      const run = runByPath(file, [
        "--descriptor", described, "--apk", call.apk, "--output", output, "--aapt", s.tool, "--apksigner", s.tool,
        ...Object.entries(call.companions ?? {}).flatMap(([module, apk]) => ["--companion", `${module}=${apk}`]), ...(call.development === true ? ["--development"] : []),
      ])
      assert.deepStrictEqual([run.status, run.stdout], [0, output], run.failure)
      assert.strictEqual(try outcome({ ...base, ...call, descriptor: described, output: path.join(s.checkout, "ruled", name) }), "OverlayStaged", name)
      const tree = try readTree(output)
      assert.deepStrictEqual(overlayDeclarations(tree), overlayDeclarations(try readTree(path.join(s.checkout, "ruled", name))), name)
      const rendered = try Effect.try(() => stager.renderOverlay(descriptor))
      assert.deepStrictEqual(
        [tree["Android.bp"], tree["product.mk"], tree["default-permissions.xml"] ?? null, tree["privapp-permissions.xml"] ?? null, tree["launcher.json"]],
        [rendered.blueprint, rendered.product, rendered.permissions, rendered.privilegedPermissions, `${JSON.stringify({ ...descriptor, development: call.development === true }, null, 2)}\n`],
        name,
      )
    }

    const pinnedTo = (apk: { readonly sha256: string }, extra: Partial<LauncherDescriptor> = {}): LauncherDescriptor => ({ ...plain, apkSha256: apk.sha256, ...extra })
    const withCompanion = (apk: { readonly sha256: string }): LauncherDescriptor => ({ ...plain, companions: [{ ...companion, apkSha256: apk.sha256 }] })
    const refused: readonly (readonly [string, unknown, StandInCall, RegExp, string])[] = [
      ["digest", plain, { apk: debug.apk }, /Launcher APK hash mismatch/, "LauncherDigestMismatch"],
      ["package", pinnedTo(renamed), { apk: renamed.apk }, /Launcher package mismatch/, "NotTheLauncherPackage"],
      ["not-home", pinnedTo(shortcut), { apk: shortcut.apk }, /not a MAIN\/HOME\/DEFAULT launcher/, "NotTheLauncherPackage"],
      ["debuggable", pinnedTo(debug), { apk: debug.apk }, /Debug launcher requires --development/, "BuildNotAllowed"],
      ["signer", pinnedTo(foreign), { apk: foreign.apk }, /signer mismatch or multiple signers/, "SignerNotTheDescriptors"],
      ["two-signers", pinnedTo(twice), { apk: twice.apk }, /Exactly one valid launcher signer/, "SignerNotTheDescriptors"],
      ["undeclared", pinnedTo(debug, { defaultPermissions: ["android.permission.RECORD_AUDIO"] }), { apk: debug.apk, development: true }, /does not declare android\.permission\.RECORD_AUDIO/, "PermissionUndeclared"],
      ["unreviewed", { ...plain, privilegedPermissions: ["android.permission.CAMERA"] }, { apk: release.apk }, /Invalid privileged permissions/, "DescriptorInvalid"],
      ["no-companion", pinned, { apk: release.apk }, /exactly one APK for each descriptor companion/, "CompanionRefused"],
      ["unnamed-companion", pinned, { apk: release.apk, companions: { ...companions, Other: updater.apk } }, /exactly one APK for each descriptor companion/, "CompanionRefused"],
      ["companion-digest", pinned, { apk: release.apk, companions: { ExampleUpdater: release.apk } }, /ExampleUpdater APK hash mismatch/, "CompanionRefused"],
      ["companion-home", withCompanion(updaterHome), { apk: release.apk, companions: { ExampleUpdater: updaterHome.apk } }, /ExampleUpdater must not be a launcher/, "CompanionRefused"],
      ["companion-signer", withCompanion(updaterForeign), { apk: release.apk, companions: { ExampleUpdater: updaterForeign.apk } }, /ExampleUpdater signer differs from the launcher signer/, "CompanionRefused"],
      ["companion-package", withCompanion(updaterRenamed), { apk: release.apk, companions: { ExampleUpdater: updaterRenamed.apk } }, /ExampleUpdater package mismatch/, "CompanionRefused"],
    ]
    for (const [name, descriptor, call, pattern, reason] of refused) {
      const described = try writeDescriptor(path.join(s.work, `${name}.json`), descriptor)
      assert.match(try pathStaged(stager, { ...base, ...call, descriptor: described, output: path.join(s.checkout, "refused", name) }), pattern, name)
      assert.strictEqual(try outcome({ ...base, ...call, descriptor: described, output: path.join(s.checkout, "ruled-refused", name) }), reason, name)
    }
    const untooled = { development: false, aapt: "must-not-run", apksigner: "must-not-run", output: path.join(s.checkout, "refused", "untooled") }
    assert.match(try pathStaged(stager, { ...untooled, descriptor: path.join(s.work, "digest.json"), apk: debug.apk }), /Launcher APK hash mismatch/, "a digest is checked before any SDK tool runs")
    assert.match(try pathStaged(stager, { ...untooled, descriptor: path.join(s.work, "companion-digest.json"), apk: release.apk, companions: { ExampleUpdater: release.apk } }), /ExampleUpdater APK hash mismatch/)
    assert.deepStrictEqual(try files.readDirectory(path.join(s.checkout, "refused")), [], "a refusal stages nothing and leaves no private copy")
    assert.deepStrictEqual(try files.readDirectory(path.join(s.checkout, "ruled-refused")), [])

    const again = { ...base, descriptor: path.join(s.work, "companion.json"), apk: release.apk, companions }
    const before = try readTree(path.join(s.checkout, "staged", "companion"))
    assert.match(try pathStaged(stager, { ...again, output: path.join(s.checkout, "staged", "companion") }), /Output exists/)
    assert.strictEqual(try outcome({ ...again, output: path.join(s.checkout, "ruled", "companion") }), "OutputNotPublished")
    assert.deepStrictEqual(try readTree(path.join(s.checkout, "staged", "companion")), before)

    const home = { ...base, descriptor: try writeDescriptor(path.join(s.work, "plain.json"), plain), apk: release.apk }
    const provisioned = try Effect.try(() => stager.stageLauncher({ ...home, output: path.join(s.checkout, "staged", "provisioned"), provisioning: { assistant: false } }))
    assert.deepStrictEqual(provisioned.provisioning, { home: `${LAUNCHER}.MainActivity`, assistant: null, autofill: null })
    const provisioning = try readTree(provisioned.output)
    assert.include(provisioning["provisioning/preferred-apps/launcher-home.xml"] ?? "", `<set name="${LAUNCHER}/${LAUNCHER}.MainActivity" />`)
    assert.include(provisioning["product.mk"] ?? "", "PRODUCT_PACKAGE_OVERLAYS += $(launcher_provisioning_dir)/overlay\n")
    assert.match(try pathStaged(stager, { ...home, output: path.join(s.checkout, "staged", "assistant"), provisioning: { assistant: true } }), /exactly one ACTION_ASSIST activity; found 0/)
    assert.deepStrictEqual((try files.readDirectory(path.join(s.checkout, "staged"))).sort(), ["companion", "phone", "phone-development", "provisioned"], "first-boot defaults the APK cannot back stage nothing: the overlay is renamed into place whole")
  }
}, 240_000)

it.effect.skipIf(skipped !== null)(`Refuse to stage over an existing output and stop at admission when asked, leaving nothing behind${suffix} (spec/os/image/staging.md, "Only an admitted, rendered overlay is published, once, and never over an existing output"; spec/os/image/staging.md, "A call settles as published, refused or admission-checked, with its private copy cleaned up")`, effect () => {
  provide NodeServices.layer {
    const k = try kit("image-publish")
    if (k === undefined) return
    const path = try Path.Path
    const files = try FileSystem.FileSystem
    const launcher = try k.build("release", launcherManifest(LAUNCHER, false))
    const descriptor = try writeDescriptor(path.join(k.work, "launcher.json"), { schemaVersion: 1, ...IDENTITY, apkSha256: launcher.sha256, certificateSha256: k.signer.certificateSha256 })
    const options = { aapt: k.aapt, apksigner: k.apksigner, descriptor, apk: launcher.apk, development: false }

    const existing = path.join(k.checkout, "existing")
    try files.makeDirectory(existing, { recursive: true })
    try files.writeFileString(path.join(existing, "keep.txt"), "mine\n")
    assert.strictEqual(try outcome({ ...options, output: existing }), "OutputNotPublished")
    assert.deepStrictEqual(try readTree(existing), { "keep.txt": "mine\n" })
    assert.deepStrictEqual(try leftovers(k.checkout), [])

    const checked = path.join(k.checkout, "checked")
    assert.strictEqual(try outcome({ ...options, output: checked, admissionOnly: true }), "AdmissionChecked")
    assert.isFalse(try files.exists(checked))
    assert.strictEqual(try outcome({ ...options, output: checked, admissionOnly: true, deferSoong: true, nativeAbi: "x86_64", nativeInstall: "soong" }), "StagingOptionsInvalid")
    assert.strictEqual(try outcome({ ...options, apk: path.join(k.work, "missing.apk"), output: checked }), "StagingInputUnreadable")
    assert.deepStrictEqual(try leftovers(k.checkout), [])

    const published = try stageLauncher({ ...options, output: checked })
    assert.strictEqual(published.evidence.tag, "OverlayStaged")
    assert.strictEqual(try outcome({ ...options, output: checked }), "OutputNotPublished")
    assert.deepStrictEqual((try files.readDirectory(k.checkout)).sort(), ["checked", "existing"])
  }
}, 240_000)

it.live('Verify every pinned platform input before admitting a reviewed source patch (spec/os/image/sourceLock.md, "Story: Build only from the source I pinned"; spec/os/image/sourceLock.md, "Every observed platform project and manifest input is bound by the lock")', effect () => {
  provide NodeServices.layer {
    try scoped(effect {
      const files = try FileSystem.FileSystem
      const root = try scratch("platform-source")
      const retainedProfile = try loadProfile({ name: "pixel10a" })
      const manifests = `${root}/.repo/manifests`
      const project = `${root}/project-a`
      for (const directory of [manifests, project]) {
        try files.makeDirectory(directory, { recursive: true })
        try git(directory, ["init", "--quiet", "--initial-branch=main"])
      }
      const manifestPin = try commitTree(manifests, { "default.xml": "<manifest/>\n" }, "Pin the resettable manifest")
      const treePin = try commitTree(project, try Effect.try(platformProjectTree), "Pin the resettable project")
      try git(project, ["update-index", "--add", "--cacheinfo", `160000,${treePin},opaque-child`])
      try git(project, ["-c", "commit.gpgsign=false", "commit", "--quiet", "--no-verify", "--message", "Pin an opaque child repository"])
      const projectPin = try git(project, ["rev-parse", "HEAD"])
      try files.makeDirectory(`${project}/opaque-child`)
      try tryPromise(() => fixedSourceStat(`${project}/input.txt`))
      try git(project, ["config", "core.trustctime", "false"])
      try git(project, ["update-index", "--refresh"])
      const fixture = try tryPromise(() => sourceLockFixture(root, manifestPin, projectPin))
      const profile = try loadProfile({ name: "fixture", lockFile: fixture.lockFile })
      const options = { profile, sourceRoot: root, factory: fixture.factory, boardConfiguration: "project-a/board.mk", vendorManifest: "vendor/generated/manifest.xml" }
      const baseline = try verifyDeviceSource(options)
      const partial = try loadProfile({ name: "partial", lockFile: fixture.lockFile })
      const incomplete = try exit(verifySource({ ...options, profile: partial }))
      const observations: { input: string; problems: readonly string[] }[] = []
      try tryPromise(() => rewriteWithSameStat(`${project}/input.txt`, "tampered source\n"))
      observations.push({ input: "stat-cache", problems: (try verifySource(options)).problems })
      try tryPromise(() => rewriteWithSameStat(`${project}/input.txt`, "reviewed source\n"))
      try git(project, ["rm", "--quiet", "input.txt"])
      observations.push({ input: "deleted-tracked", problems: (try verifySource(options)).problems })
      try git(project, ["restore", "--source", "HEAD", "--staged", "--worktree", "input.txt"])
      try tryPromise(() => changeMode(`${project}/input.txt`, 0o755))
      observations.push({ input: "execute-bits", problems: (try verifySource(options)).problems })
      try tryPromise(() => changeMode(`${project}/input.txt`, 0o644))
      try writeTree(project, { "input.txt": { kind: "symlink", target: "reviewed source\n" } })
      observations.push({ input: "same-digest-link", problems: (try verifySource(options)).problems })
      try writeTree(project, { "input.txt": "reviewed source\n" })
      try writeTree(root, { "project-a/ignored/input.bin": fixture.ignored + "changed\n" })
      observations.push({ input: "ignored", problems: (try verifySource(options)).problems })
      try writeTree(root, { "project-a/ignored/input.bin": fixture.ignored })
      try writeTree(root, { "vendor/generated/manifest.xml": fixture.vendor.replace("202604", "202504") })
      observations.push({ input: "vendor", problems: (try verifySource(options)).problems })
      try writeTree(root, { "vendor/generated/manifest.xml": fixture.vendor })
      try writeTree(root, { "project-a/board.mk": "RELEASE_BOARD_API_LEVEL := 202504\n" })
      observations.push({ input: "board", problems: (try verifySource(options)).problems })
      try writeTree(root, { "project-a/board.mk": "RELEASE_BOARD_API_LEVEL := 202604\n" })
      try writeTree(root, { ".repo/manifest.xml": fixture.manifest + "<!-- unreviewed -->\n" })
      observations.push({ input: "manifest", problems: (try verifySource(options)).problems })
      try writeTree(root, { ".repo/manifest.xml": fixture.manifest })
      try files.writeFileString(`${manifests}/.git/info/exclude`, "unreviewed.xml\n")
      try writeTree(manifests, { "unreviewed.xml": "<manifest/>\n" })
      observations.push({ input: "ignored-manifest-file", problems: (try verifySource(options)).problems })
      try files.remove(`${manifests}/unreviewed.xml`)
      try git(project, ["update-index", "--assume-unchanged", "input.txt"])
      observations.push({ input: "hidden-index", problems: (try verifySource(options)).problems })
      try git(project, ["update-index", "--no-assume-unchanged", "input.txt"])
      try git(project, ["update-index", "--cacheinfo", `160000,${projectPin},opaque-child`])
      observations.push({ input: "changed-gitlink", problems: (try verifySource(options)).problems })
      try git(project, ["restore", "--source", "HEAD", "--staged", "opaque-child"])
      const extraProject = `${root}/project-b`
      try files.makeDirectory(extraProject)
      try git(extraProject, ["init", "--quiet", "--initial-branch=main"])
      try commitTree(extraProject, { "input.txt": "unbound project\n" }, "Create an observed but unpinned project")
      try writeTree(root, { ".repo/project.list": fixture.projectList + "project-b\n" })
      observations.push({ input: "project-coverage", problems: (try verifySource(options)).problems })
      try writeTree(root, { ".repo/project.list": fixture.projectList })
      const patch = try tryPromise(() => patchFixture(root, baseline.state.lock.digest, projectPin))
      try writeTree(project, { "input.txt": "reviewed patched source\n" })
      const admitted = try admitPatchEnvelope(options, patch)
      try git(project, ["add", "input.txt"])
      const stagedAdmitted = try admitPatchEnvelope(options, patch)
      try writeTree(project, { "input.txt": "reviewed source\n" })
      const indexOnly = try verifySource({ ...options, patches: [patch] })
      try git(project, ["restore", "--staged", "input.txt"])
      try writeTree(project, { "input.txt": "changed after earlier admission\n" })
      const drift = try verifySource({ ...options, patches: [patch] })
      const changedPatch = try exit(admitPatchEnvelope(options, patch))
      try writeTree(project, { "input.txt": "reviewed source\n" })
      try writeTree(root, { "factory.img": "wrong factory of equal intent but different actual bytes\n" })
      const changedFactory = try verifyDeviceSource(options)
      try Effect.try(() => assert.deepStrictEqual({ baseline: { verdict: baseline.state.verdict, problems: baseline.problems, projects: baseline.projectsChecked, releaseQualified: baseline.releaseQualified },
        retainedProfile: retainedProfile.name, partialRefused: Exit.isFailure(incomplete), observations, patched: { verdict: admitted.source.state.verdict, problems: admitted.source.problems },
        stagedPatch: stagedAdmitted.source.state.verdict, indexOnly: indexOnly.problems,
        drift: drift.problems, changedPatchRefused: Exit.isFailure(changedPatch), changedFactory: changedFactory.problems }, {
        baseline: { verdict: "Match", problems: [], projects: 1, releaseQualified: false }, retainedProfile: "pixel10a", partialRefused: true,
        observations: [{ input: "stat-cache", problems: ["SourceChangeDiffers"] }, { input: "deleted-tracked", problems: ["SourceChangeDiffers"] }, { input: "execute-bits", problems: ["SourceChangeDiffers"] }, { input: "same-digest-link", problems: ["SourceChangeDiffers"] }, { input: "ignored", problems: ["SourceChangeDiffers"] }, { input: "vendor", problems: ["GeneratedDiffers", "VintfApiDiffers"] },
          { input: "board", problems: ["SourceChangeDiffers", "BoardApiDiffers"] }, { input: "manifest", problems: ["ManifestConfigurationDiffers"] }, { input: "ignored-manifest-file", problems: ["ManifestDiffers"] },
          { input: "hidden-index", problems: ["HiddenIndexEntries"] }, { input: "changed-gitlink", problems: ["SourceChangeDiffers"] }, { input: "project-coverage", problems: ["ManifestConfigurationDiffers", "RevisionDiffers"] }],
        patched: { verdict: "Match", problems: [] }, stagedPatch: "Match", indexOnly: ["PatchRefused"], drift: ["SourceChangeDiffers", "PatchRefused"], changedPatchRefused: true, changedFactory: ["ArchiveDiffers"],
      }))
    })
  }
}, { timeout: 180_000 })

it.live('Prepare and recheck the reviewed SystemUI chip without changing the supplied source (spec/os/image/listener.md, "Story: Put the wake listener in an image only as reviewed")', effect () => {
  provide NodeServices.layer {
    try scoped(effect {
      const path = try Path.Path
      const files = try FileSystem.FileSystem
      const work = try scratch("listener-systemui")
      const fixture = try path.fromFileUrl(new URL("./fixtures/sense-systemui/", import.meta.url))
      const source = try tryPromise(() => copySystemui(work, fixture))
      const output = path.join(work, "output")
      const before = try verifyListenerSystemui(source, "before", "chip")
      const staged = try prepareListenerSystemui(source, output, "chip")
      const after = try verifyListenerSystemui(output, "after", "chip")
      assert.deepStrictEqual(after, staged)
      assert.deepStrictEqual(try verifyListenerSystemui(source, "before", "chip"), before)
      assert.strictEqual(after.indicatorHealthLeaseImplemented, true)
      assert.strictEqual((try exit(prepareListenerSystemui(source, output, "chip")))._tag, "Failure")
      const first = after.files[0]?.path ?? assert.fail("The prepared image has no reviewed files")
      try files.writeFileString(path.join(output, "frameworks/base", first), "modified after staging")
      assert.strictEqual((try exit(verifyListenerSystemui(output, "after", "chip")))._tag, "Failure")
    })
  }
}, 120_000)

it.effect.skipIf(skipped !== null)(`Read the listener's real APK grants and reject a network permission${suffix} (spec/os/image/listener.md, "Story: Put the wake listener in an image only as reviewed")`, effect () => {
  provide NodeServices.layer {
    const k = try kit("listener-permissions")
    if (k === undefined) return
    const packageName = `${LAUNCHER}.sense`
    const manifest = (extra: string) => `<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="${packageName}" android:versionCode="1">
      <uses-permission android:name="android.permission.CAPTURE_AUDIO_HOTWORD" />
      <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
      <uses-permission android:name="android.permission.RECORD_AUDIO" />
      <permission android:name="${packageName}.CONTROL" android:protectionLevel="signature" />
      <uses-permission android:name="${packageName}.CONTROL" />
      ${extra}
      <application android:debuggable="false" />
    </manifest>`
    const approved = try k.build("reviewed", manifest(""))
    const rejected = try k.build("forbidden", manifest('<uses-permission android:name="android.permission.INTERNET" />'))
    const read = (apk: string) => effect {
      const dump = try captureCommand(k.aapt, ["dump", "permissions", apk], 60_000)
      assert.strictEqual(dump.code, 0)
      return try listenerPermissions(new TextDecoder().decode(dump.stdout), packageName)
    }
    const grants = try read(approved.apk)
    assert.deepStrictEqual(grants, {
      packageName,
      requested: ["android.permission.CAPTURE_AUDIO_HOTWORD", "android.permission.FOREGROUND_SERVICE_MICROPHONE", "android.permission.RECORD_AUDIO", "android.permission.START_ACTIVITIES_FROM_BACKGROUND"],
      privileged: ["android.permission.CAPTURE_AUDIO_HOTWORD", "android.permission.START_ACTIVITIES_FROM_BACKGROUND"],
    })
    assert.strictEqual((try exit(read(rejected.apk)))._tag, "Failure")
  }
}, 240_000)

it.live('Qualify a device through the read-only command set and keep the captures (spec/os/image/qualification.md, "Story: Qualify a device read-only"; spec/os/image/qualification.md, "Story: Read the verdict against my requirements")', effect () => {
  provide NodeServices.layer {
    try scoped(effect {
      const work = try scratch("device-qualification")
      const files = try FileSystem.FileSystem
      const path = try Path.Path
      const source = try path.fromFileUrl(new URL("../aosp/device-requirements/treble-gsi.json", import.meta.url))
      const fixture = try path.fromFileUrl(new URL("./fixtures/device-qualify/android15-emulator/", import.meta.url))
      const first = try tryPromise(() => qualificationBinary(work, fixture, readOnlyCommands))
      const output = path.join(work, "qualified")
      const qualified = try qualify(["--serial", "emulator-4242", "--requirements", source, "--out", output, "--adb", first.binary])
      const input = try files.readFileString(path.join(first.fixture, "getprop.txt"))
      const retained = try files.readFileString(path.join(output, "raw", "getprop.txt"))
      const calls = (try files.readFileString(first.log)).trim().split("\n")
      const requirements = try Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Unknown))(try files.readFileString(source))
      const partial = try tryPromise(() => qualificationBinary(work, fixture, readOnlyCommands, "getprop"))
      const incomplete = try qualifyDevice({ serial: "emulator-4242", requirements, binary: partial.binary })
      try Effect.try(() => assert.deepStrictEqual({
        qualification: [qualified.evaluation.verdict, qualified.evaluation.evidenceLevel, qualified.evaluation.warnings],
        observations: [qualified.facts.vendorApiLevel, qualified.facts.abi, qualified.facts.kernel?.gkiBranch, qualified.facts.cameras?.length],
        retained,
        calls,
        unavailable: [incomplete.evaluation.verdict, incomplete.evaluation.evidenceLevel, incomplete.evaluation.results.find((item) => item.id === "treble")?.result, incomplete.collectionErrors["getprop"]],
        retainedFailedCapture: incomplete.raw["getprop"],
      }, {
        qualification: ["pass", "emulator-observation", ["ab-updates"]],
        observations: [35, "arm64-v8a", "android15-6.6", 1],
        retained: input,
        calls: [
          JSON.stringify(["-s", "emulator-4242", "get-state"]),
          ...Object.values(readOnlyCommands).map((command) => JSON.stringify(["-s", "emulator-4242", "shell", command])),
        ],
        unavailable: ["incomplete", "emulator-observation", "unknown", "Capture unavailable"],
        retainedFailedCapture: input,
      }))
    })
  }
})

it.live('Check the exact booted image and report a change during readback (spec/os/image/verification.md, "Story: Know whether a booted image is what I staged")', effect () => {
  provide NodeServices.layer {
    try scoped(effect {
      const work = try scratch("booted-image")
      const packageName = "ai.elizaos.app"
      const launcher = `${packageName}/.MainActivity`
      const system = "com.android.launcher3"
      const camera = "com.android.camera2"
      const apkPath = "/product/app/Eliza/Eliza.apk"
      const apkSha256 = "a".repeat(64)
      const fingerprint = "elizaOS/eliza_cf/vsoc_x86_64_only:17/test:userdebug/test-keys"
      const expected = { packageName, apkPath, apkSha256, certificateSha256: "b".repeat(64), fingerprint, defaultPermissions: ["android.permission.RECORD_AUDIO"] }
      const home = "--user 0 -a android.intent.action.MAIN -c android.intent.category.HOME"
      const defaultCategory = "-c android.intent.category.DEFAULT"
      const query = "cmd package query-activities --brief --components --user 0 -a"
      const sum = `sha256sum ${apkPath}`
      const provider = "dumpsys webviewupdate"
      const responses: Record<string, string | string[]> = {
        "getprop ro.hardware": "cutf_cvm",
        "getprop ro.product.device": "vsoc_x86_64_only",
        "getprop sys.boot_completed": "1",
        "cat /proc/sys/kernel/random/boot_id": "12345678-1234-1234-1234-123456789abc",
        "am get-current-user": "0",
        "am get-started-user-state 0": "RUNNING_UNLOCKED",
        "getprop ro.build.fingerprint": fingerprint,
        "getenforce": "Enforcing",
        [`pm path --user 0 ${packageName}`]: `package:${apkPath}`,
        [sum]: `${apkSha256}  ${apkPath}`,
        [`cmd package resolve-activity --brief ${home}`]: launcher,
        [`cmd package query-activities --brief --components ${home}`]: `${launcher}\n${system}/.Launcher`,
        [`pm list packages --user 0 -s -e ${system}`]: `package:${system}`,
        [provider]: "Current WebView package (name, version): (com.android.webview, 145.0.1)",
        [`dumpsys package ${packageName}`]: "privateFlags=[ ]\n  User 0:\n    runtime permissions:\n      android.permission.RECORD_AUDIO: granted=true, flags=[ GRANTED_BY_DEFAULT ]\n  User 10:\n    runtime permissions:\n      android.permission.READ_SMS: granted=true, flags=[ SYSTEM_FIXED ]",
        "pm list packages --user 0 -s -e com.android.deskclock": "package:com.android.deskclock",
        [`pm list packages --user 0 -s -e ${camera}`]: `package:${camera}`,
        "cmd overlay lookup --user 0 android android:bool/config_cameraDoubleTapPowerGestureEnabled": "true",
        "cmd overlay lookup --user 0 com.android.systemui com.android.systemui:string/config_cameraGesturePackage": camera,
        "settings --user 0 get secure camera_double_tap_power_gesture_disabled": "null",
        "pm list features": "feature:android.hardware.camera.any\nfeature:android.hardware.wifi",
      }
      for (const action of ["SET_ALARM", "SHOW_ALARMS", "SNOOZE_ALARM", "DISMISS_ALARM"]) {
        responses[`${query} android.intent.action.${action} ${defaultCategory} -p com.android.deskclock`] = "com.android.deskclock/.HandleApiCalls"
      }
      for (const action of ["STILL_IMAGE_CAMERA_SECURE", "IMAGE_CAPTURE_SECURE"]) {
        responses[`${query} android.media.action.${action} ${defaultCategory} -p ${camera}`] = `${camera}/com.android.camera.SecureCameraActivity`
        responses[`${query} android.media.action.${action} ${defaultCategory} -p ${packageName}`] = "No activities found"
      }
      const healthy = try tryPromise(() => verificationBinary(work, "healthy", responses))
      const changed = try tryPromise(() => verificationBinary(work, "changed", { ...responses, [sum]: [`${apkSha256}  ${apkPath}`, `${"b".repeat(64)}  ${apkPath}`], [provider]: "Unrecognized provider status" }))
      const gestureOff = try tryPromise(() => verificationBinary(work, "gesture-off", { ...responses, "settings --user 0 get secure camera_double_tap_power_gesture_disabled": "1" }))
      const options = { serial: "127.0.0.1:6520", user: "0", target: "cuttlefish" as const, expected }
      const serial = "FAKEPIXEL01"
      const badBoot = try tryPromise(() => verificationBinary(work, "pixel-weak-boot", {
        ...responses, "getprop ro.hardware": "google", "getprop ro.product.device": "stallion",
        "getprop ro.boot.verifiedbootstate": "orange", "getprop ro.boot.slot_suffix": "_b", "getenforce": "Permissive",
        [sum]: `${"c".repeat(64)}  ${apkPath}`,
      }, serial))
      const wrongTarget = try exit(verifyImage({ ...options, target: "pixel10a", adb: badBoot.binary }))
      const [stable, raced, pixel, cameraOff] = try.all [
        verifyImage({ ...options, adb: healthy.binary }),
        verifyImage({ ...options, adb: changed.binary }),
        verifyImage({ ...options, serial, target: "pixel10a", adb: badBoot.binary }),
        verifyImage({ ...options, adb: gestureOff.binary }),
      ]
      try Effect.try(() => assert.deepStrictEqual({
        staged: stable.passed,
        checks: stable.checks.every(({ outcome }) => outcome === "pass"),
        capture: stable.captures.every(({ status }) => status === 0),
        measuredTwice: stable.captures.filter(({ args }) => args[0] === "sha256sum").length,
        actual: raced.verdict,
        wrongTarget: wrongTarget._tag,
        boot: pixel.verifiedBoot,
        weakened: pixel.checks.filter(({ outcome }) => outcome !== "pass"),
        changed: raced.checks.filter(({ outcome }) => outcome !== "pass"),
        gestureTurnedOff: cameraOff.checks.filter(({ outcome }) => outcome !== "pass"),
      }, {
        staged: true, checks: true, capture: true, measuredTwice: 2, actual: "fail", wrongTarget: "Failure",
        boot: { state: "orange", slotSuffix: "_b" },
        weakened: [{ check: "LauncherBytes", outcome: "fail" }, { check: "SelinuxEnforcing", outcome: "fail" }, { check: "VerifiedBoot", outcome: "fail" }],
        changed: [{ check: "WebViewProvider", outcome: "unknown" }, { check: "SameBootThroughout", outcome: "fail" }],
        gestureTurnedOff: [{ check: "SecureCamera", outcome: "fail" }],
      }))
    })
  }
})

const RUNNER_TREE = [
  "N: android=http://schemas.android.com/apk/res/android",
  "  E: manifest (line=2)",
  '    A: package="ai.example.app.test" (Raw: "ai.example.app.test")',
  "    E: instrumentation (line=7)",
  '      A: android:name(0x01010003)="androidx.test.runner.AndroidJUnitRunner" (Raw: "androidx.test.runner.AndroidJUnitRunner")',
  '      A: android:targetPackage(0x01010021)="ai.example.app" (Raw: "ai.example.app")',
  "    E: instrumentation (line=9)",
  '      A: android:name(0x01010003)="ai.example.app.ProcessRunner" (Raw: "ai.example.app.ProcessRunner")',
  '      A: android:targetPackage(0x01010021)="ai.example.app" (Raw: "ai.example.app")',
  "    E: application (line=11)",
  "      A: android:debuggable(0x0101000f)=(type 0x12)0xffffffff",
].join("\n")

function statusBlock(code: number, stream: string): string {
  return ["class=ai.example.app.FlowTest", "current=1", "id=AndroidJUnitRunner", "numtests=1", `stream=${stream}`, "test=opensHome"]
    .map((field) => `INSTRUMENTATION_STATUS: ${field}`).join("\n") + `\nINSTRUMENTATION_STATUS_CODE: ${code}\n`
}

const PASSED_RUN = `${statusBlock(1, "")}${statusBlock(0, ".")}INSTRUMENTATION_RESULT: stream=\n\nTime: 0.1\n\nOK (1 test)\n\n\nINSTRUMENTATION_CODE: -1\n`
const CRASHED_RUN = `${statusBlock(1, "")}INSTRUMENTATION_RESULT: shortMsg=Process crashed.\nINSTRUMENTATION_CODE: 0\n`

it.live('Hold one device alone in a private lease directory the caller or the environment names (spec/os/image/harness.md, "Story: Run instrumentation on a device I hold alone"; spec/os/image/harness.md, "A lease lives in the caller\'s directory, else the one the environment names, in a real directory the operator owns"; spec/os/image/harness.md, "A lease is active only while its holder lives within its time, or while it is marked for writes")', effect () => {
  provide NodeServices.layer {
    try scoped(effect {
      const files = try FileSystem.FileSystem
      const work = try scratch("device-lease")
      const fresh = `${work}/state/leases`
      const key = "android:emulator-5554"
      const during = try scoped(effect {
        try acquireDeviceLease(key, { stateDir: fresh, waitMs: 0 })
        return (try readDeviceLease(key, { stateDir: fresh })).status
      })
      const after = (try readDeviceLease(key, { stateDir: fresh })).status
      const loose = `${work}/loose`
      try files.makeDirectory(loose, { mode: 0o755 })
      try tryPromise(() => changeMode(loose, 0o755))
      try scoped(effect { try acquireDeviceLease(key, { stateDir: loose, waitMs: 0 }) })
      try tryPromise(() => linkTo(loose, `${work}/linked`))
      const linked = try exit(scoped(effect { try acquireDeviceLease(key, { stateDir: `${work}/linked`, waitMs: 0 }) }))
      try acquireRelease(sync(() => ({ lease: swapVariable("ELIZA_DEVICE_LEASE_DIR", `${work}/from-lease`), state: swapVariable("ELIZA_STATE_DIR", `${work}/from-state`) })),
        (previous) => sync(() => { swapVariable("ELIZA_DEVICE_LEASE_DIR", previous.lease); swapVariable("ELIZA_STATE_DIR", previous.state) }))
      const byLeaseVariable = leaseStateDirectory()
      const explicit = leaseStateDirectory(`${work}/explicit`)
      try sync(() => swapVariable("ELIZA_DEVICE_LEASE_DIR", "  "))
      const byStateVariable = leaseStateDirectory()
      const freshMode = try tryPromise(() => directoryMode(fresh))
      const narrowed = try tryPromise(() => directoryMode(loose))
      try Effect.try(() => assert.deepStrictEqual({
        during, after, freshMode, narrowed, linked: linked._tag, byLeaseVariable, explicit, byStateVariable,
      }, {
        during: "LeaseActive", after: "LeaseMissing", freshMode: 0o700, narrowed: 0o700,
        linked: "Failure", byLeaseVariable: `${work}/from-lease`, explicit: `${work}/explicit`, byStateVariable: `${work}/from-state/device-leases`,
      }))
    })
  }
})

it.effect('Tell a passing run, an interrupted test and the reviewed runners apart (spec/os/image/harness.md, "A run passes only when every requested class completes its advertised tests with no failure, skip or crash"; spec/os/image/harness.md, "An interruption is one started test ended by a process crash, and is never a pass"; spec/os/image/harness.md, "A test APK declares exactly the reviewed runners, each aimed at the app under test")', effect () => {
  const passed = try requireInstrumentationSuccess(PASSED_RUN, ["ai.example.app.FlowTest"])
  const interrupted = try requireInstrumentationInterruption(CRASHED_RUN, "ai.example.app.FlowTest", "opensHome")
  const crashedAsPass = try exit(requireInstrumentationSuccess(CRASHED_RUN, ["ai.example.app.FlowTest"]))
  const passAsInterruption = try exit(requireInstrumentationInterruption(PASSED_RUN, "ai.example.app.FlowTest", "opensHome"))
  const otherMethod = try exit(requireInstrumentationInterruption(CRASHED_RUN, "ai.example.app.FlowTest", "closesHome"))
  try Effect.try(() => assert.deepStrictEqual({
    passed: passed.cases, interrupted: interrupted.case, crashedAsPass: crashedAsPass._tag, passAsInterruption: passAsInterruption._tag, otherMethod: otherMethod._tag,
    runners: instrumentationDeclarations(RUNNER_TREE),
  }, {
    passed: ["ai.example.app.FlowTest#opensHome"], interrupted: "ai.example.app.FlowTest#opensHome",
    crashedAsPass: "Failure", passAsInterruption: "Failure", otherMethod: "Failure",
    runners: [{ name: "androidx.test.runner.AndroidJUnitRunner", targetPackage: "ai.example.app" }, { name: "ai.example.app.ProcessRunner", targetPackage: "ai.example.app" }],
  }))
})

it.live('Run a scenario in a fresh Android user and keep the user when the scenario does not prove its packages clean (spec/os/image/harness.md, "Story: Run a test in a fresh Android user that is removed afterwards"; spec/os/image/harness.md, "A test user is created only on a leased emulator with the owner in the foreground"; spec/os/image/harness.md, "The owner is restored first, and the test user is removed only when the run proved its packages clean")', effect () => {
  provide NodeServices.layer {
    try scoped(effect {
      const work = try scratch("isolated-user")
      const serial = "emulator-5554"
      const home = "com.android.launcher3/.uioverrides.QuickstepLauncher"
      const phone = { current: "0", users: ["0"], next: 10, calls: [] as string[] }
      const run = effect (...args: readonly string[]) => {
        const command = args.join(" ")
        phone.calls.push(command)
        const switched = /^shell am switch-user (\d+)$/.exec(command)?.[1]
        if (switched !== undefined) phone.current = switched
        const removed = /^shell pm remove-user --wait (\d+)$/.exec(command)?.[1]
        if (removed !== undefined) phone.users = phone.users.filter((user) => user !== removed)
        if (command === "emu avd name") return "fixture_avd\nOK"
        if (command === "shell am get-current-user") return phone.current
        if (command.startsWith("shell pm create-user ")) {
          const id = String(phone.next++)
          phone.users.push(id)
          return `Success: created user id ${id}`
        }
        if (command.startsWith("shell cmd package resolve-activity ")) return `priority=0 preferredOrder=0 match=0x108000 specificIndex=-1 isDefault=true\n${home}`
        if (command.startsWith("shell cmd package set-home-activity ")) return "Success"
        if (command === "shell dumpsys activity activities") return `  topResumedActivity=ActivityRecord{1f2e u${phone.current} ${home} t12}`
        if (command.startsWith("shell am is-user-stopped ")) return "true"
        if (removed !== undefined) return "Success: removed user"
        if (command === "shell pm list users") return `Users:\n${phone.users.map((user) => `\tUserInfo{${user}:${user === "0" ? "Owner" : "isolated-test"}:400}`).join("\n")}\n`
        return ""
      }
      const deviceLease = try acquireDeviceLease(`android:${serial}`, { stateDir: `${work}/leases`, ttlMs: HELD_FOR_THE_RUN, waitMs: 0 })
      const reports: unknown[] = []
      const options = { run, serial, deviceLease, stateDir: `${work}/leases`, expectedAvdName: "fixture_avd", homePackage: "com.android.launcher3", name: "isolated-test",
        record: (report: unknown) => effect { reports.push(report) }, waitMs: 1000, homeWaitMs: 1000, pollMs: 1 }
      const clean = try withIsolatedAndroidUser({ ...options, scenario: (user: number) => effect { return { cleaned: true, user } } })
      const afterClean = { current: phone.current, users: [...phone.users] }
      const kept = try exit(withIsolatedAndroidUser({ ...options, scenario: (user: number) => effect { return { cleaned: false, user } } }))
      const wrongAvd = try exit(withIsolatedAndroidUser({ ...options, expectedAvdName: "other_avd", scenario: (user: number) => effect { return { cleaned: true, user } } }))
      const boot = { id: "11111111-1111-1111-1111-111111111111", offline: 0 }
      const rebooting = effect (...args: readonly string[]) => {
        const command = args.join(" ")
        if (command === "reboot") {
          boot.id = "22222222-2222-2222-2222-222222222222"
          boot.offline = 2
          return ""
        }
        if (command.startsWith("shell ") && boot.offline > 0) {
          boot.offline--
          throw new AdbFailed({ args, code: 1, stderr: "error: device offline" })
        }
        if (command === "shell cat /proc/sys/kernel/random/boot_id") return boot.id
        if (command === "shell getprop sys.boot_completed") return "1"
        if (command === "shell am get-current-user") return "10"
        if (command === "shell am get-started-user-state 10") return "RUNNING_UNLOCKED"
        return command === "emu avd name" ? "fixture_avd\nOK" : ""
      }
      const rebooted = try rebootAndroidFixture({ run: rebooting, serial, androidUser: 10, deviceLease, stateDir: `${work}/leases` }, { expectedAvdName: "fixture_avd", timeoutMs: 1000, pollMs: 1 })
      try Effect.try(() => assert.deepStrictEqual({
        clean: [clean.result.user, clean.removed, clean.cleanupDeferred, clean.ownerRestored], afterClean,
        kept: kept._tag, keptUsers: phone.users, current: phone.current, wrongAvd: wrongAvd._tag, reports: reports.length, rebooted,
        removals: phone.calls.filter((call) => call.startsWith("shell pm remove-user")),
      }, {
        clean: [10, true, false, true], afterClean: { current: "0", users: ["0"] },
        kept: "Failure", keptUsers: ["0", "11"], current: "0", wrongAvd: "Failure", reports: 4,
        rebooted: { before: "11111111-1111-1111-1111-111111111111", after: "22222222-2222-2222-2222-222222222222", androidUser: 10 },
        removals: ["shell pm remove-user --wait 10"],
      }))
    })
  }
})
