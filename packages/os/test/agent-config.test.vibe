// spec/os/agentService/config.md, "Story: Start my agent with my character, policy and model"; spec/agent/host/launch.md, "Story: Keep the credential out of every file and reply"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { decodeLaunchDocument, decodeLaunchFrame } from "@elizaos/agent"
import { ownKeyMaxUnits } from "../gen/agent__host__launch.ts"
import { AGENT_ASSETS, AgentConfigRefused, admitAgentBytes, admitAgentData, type AgentFile } from "../src/build/agent-config.vibe"
import { peerTrusted } from "../gen/os__agentService__channel.effect.vibe"
import { scratch, writeTree } from "./support/scratch.vibe"

module node {
  import { execFileSync, spawnSync } from "node:child_process"
  import { existsSync } from "node:fs"
  import path from "node:path"
  import { compileAdapter } from "./drivers/jvm-adapter.ts"

  const MAIN = "ai.eliza.os.agent.LaunchProjection"
  const java = process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", "java") : "java"

  export interface Ask {
    readonly host: string
    readonly character: string
    readonly policy: string
    readonly account?: { readonly userId: string; readonly organizationId: string }
    readonly workflowWorker?: { readonly runtimeDir: string; readonly executable: string; readonly sha256: string }
    readonly frame?: { readonly token: string; readonly epoch: number; readonly credential?: { readonly version: number; readonly value: string }; readonly storageKey?: string }
    readonly google?: { readonly gmailChanges: boolean; readonly calendarEdits: boolean }
    readonly broker?: "open" | "failing" | "absent"
  }

  export type Answer =
    | { readonly kind: "refused"; readonly cause: "Config"; readonly reason: string }
    | {
      readonly kind: "admitted"
      readonly service: string
      readonly notification: { readonly channel: string; readonly title: string; readonly text: string; readonly failure: { readonly channel: string; readonly title: string; readonly text: string } }
      readonly rendererGroups: number
      readonly nativeGroups: number
      readonly needsAccount: boolean
      readonly document: string
      readonly frame?: string
      readonly shown?: string
      readonly next?: string
      readonly pushOfHeldVersion?: boolean
      readonly broker?: readonly (readonly [string, string])[]
    }

  /** @throws {Error} */
  export function project(asks: readonly Ask[]): Answer[] {
    const out = execFileSync(java, ["-Duser.timezone=Asia/Tokyo", "-cp", compileAdapter(MAIN), MAIN], { input: asks.map((ask) => JSON.stringify(ask)).join("\n") + "\n", encoding: "utf8", timeout: 120_000 })
    return out.trim().split("\n").map((line) => JSON.parse(line) as Answer)
  }

  export interface LifecycleStep {
    readonly outcome: "accepted" | "refused"
    readonly state: { readonly phase: Readonly<Record<string, string>>; readonly notice: string; readonly epoch: number; readonly attempt: number }
    readonly out: readonly Readonly<Record<string, string | number>>[]
  }

  /** @throws {Error} */
  export function lifecycle(events: readonly object[]): LifecycleStep[] {
    const main = "ai.eliza.os.agent.LifecycleAdapter"
    const out = execFileSync(java, ["-cp", compileAdapter(main), main], { input: events.map((event) => JSON.stringify({ event })).join("\n") + "\n", encoding: "utf8", timeout: 120_000 })
    return out.trim().split("\n").map((line) => JSON.parse(line) as LifecycleStep)
  }

  export interface PeerAnswer {
    readonly peer: number | null
    readonly appUid: number
    readonly trusted: boolean
  }

  /** @throws {Error} */
  export function peerAnswers(): PeerAnswer[] {
    const main = "ai.eliza.os.agent.PeerCheck"
    const out = execFileSync(java, ["-cp", compileAdapter(main), main], { encoding: "utf8", timeout: 120_000 })
    return out.trim().split("\n").map((line) => JSON.parse(line) as PeerAnswer)
  }

  export interface PatternField {
    readonly field: string
    readonly flags: number
    readonly source: string
  }

  /** @throws {Error} */
  export function patternFlags(): PatternField[] {
    const main = "ai.eliza.os.agent.PatternFlags"
    const out = execFileSync(java, ["-cp", compileAdapter(main), main], { encoding: "utf8", timeout: 120_000 })
    return out.trim().split("\n").map((line) => JSON.parse(line) as PatternField)
  }

  /** @throws {Error} */
  export function launchOutcome(cli: string, root: string, frame: string): { readonly exit: number | null; readonly stateCreated: boolean } {
    const invoke = `import { runAgentCli } from ${JSON.stringify(cli)}; runAgentCli({ bundled: [] });`
    const state = path.join(root, "state")
    const child = spawnSync(process.execPath, [
      "--input-type=module", "--eval", invoke, "--", "eliza-agent", "serve", "--launch", path.join(root, "launch.json"),
      "--state", state, "--socket", path.join(root, "agent.sock"),
    ], { input: frame, timeout: 120_000 })
    if (child.error !== undefined) throw child.error
    return { exit: child.status, stateCreated: existsSync(state) }
  }
}
import { launchOutcome, lifecycle, patternFlags, peerAnswers, project, type Answer, type Ask } from node

type Files = Readonly<Record<AgentFile, string>>

error LaunchProjectionRefused { answer: string }

const ROUTES = [
  { method: "GET", path: "/api/status" },
  { method: "POST", path: "/api/conversations/{id}/messages" },
  { method: "POST", path: "/api/conversations/{id}/messages/stream", stream: true },
]
const HOST = {
  schema: 1,
  service: "app.example.AgentService",
  notification: { channel: "Agent", title: "Agent", text: "  Your agent is running  ", failure: { channel: " Agent alerts ", title: "Agent stopped", text: "Open the app to check your agent" } },
  routes: ROUTES,
}
const NOTICE_WORDS = { channel: "Agent", title: "Agent", text: "Your agent is running", failure: { channel: "Agent alerts", title: "Agent stopped", text: "Open the app to check your agent" } }
const CHARACTER = { name: "Agent", system: "Answer briefly." }
const POLICY = { schema: 1, actions: { allowed: ["REPLY"] }, plugins: { load: ["inbox"] } }
const ACCOUNT = { userId: "user-1", organizationId: "org-1" }
const WORKER = { runtimeDir: "agent/workflow-worker", executable: "worker.mjs", sha256: "a".repeat(64) }
const OWN_KEY_HOST = { ...HOST, model: { backend: "own-key", ownKeyBaseUrl: "https://own.example/v1", ownKeySmall: "small", ownKeyLarge: "large" } }

const files = (host: object, character: object = CHARACTER, policy: object = POLICY): Files =>
  ({ host: JSON.stringify(host), character: JSON.stringify(character), policy: JSON.stringify(policy) })

const credentialFrame = (units: number) => ({ token: "launch-token", epoch: 1, credential: { version: 1, value: "k".repeat(units) } })

const ADMITTED: readonly { readonly name: string; readonly files: Files; readonly ask: Omit<Ask, AgentFile> }[] = [
  {
    name: "cloud model with every launch object",
    files: files({
      ...HOST,
      model: { backend: "cloud", cloudBaseUrl: "https://cloud.example", smallModel: "small", largeModel: "large", imageModel: "image" },
      nativeRoutes: [{ prefixes: ["/api/native"], id: "[a-z]+", routes: [{ method: "PUT", path: "/api/native/{id}", maxBodyBytes: 4096 }] }],
      embeddings: "local",
      embeddingDimensions: 384,
      persistMemory: true,
      callerRole: "user",
      views: [{ id: "chat", label: "Chat", path: "/chat", aliases: ["home"] }, { id: "notes", label: "Notes", path: "/notes" }],
      timeZone: "Europe/Paris",
      hostContextRevision: Number.MAX_SAFE_INTEGER,
      privacy: { secretSwap: true, piiSwap: false },
      google: { gmailChanges: false, calendarEdits: true },
      retention: { days: 0.5, maxRowsPerRoom: 1000, intervalMinutes: 60 },
      environment: { PLUGIN_SETTING: "on" },
    }),
    ask: { account: ACCOUNT, workflowWorker: WORKER, frame: { token: "launch-token", epoch: 3, credential: { version: 7, value: "device-key" }, storageKey: "storage-key" } },
  },
  {
    name: "schema 1 cloud record",
    files: files({ ...HOST, cloud: { baseUrl: "https://cloud.example" } }),
    ask: { account: ACCOUNT, frame: { token: "launch-token", epoch: 1, credential: { version: 1, value: "device-key" } } },
  },
  {
    name: "host consent replaced by the owner's saved consent",
    files: files({ ...HOST, model: { backend: "none" }, google: { gmailChanges: false, calendarEdits: false } }),
    ask: { account: ACCOUNT, google: { gmailChanges: true, calendarEdits: true } },
  },
  {
    name: "the owner's saved consent with none in the host file",
    files: files({ ...HOST, model: { backend: "none" } }),
    ask: { account: ACCOUNT, google: { gmailChanges: false, calendarEdits: true } },
  },
  {
    name: "own key without a signed-in account",
    files: files(OWN_KEY_HOST),
    ask: { frame: { token: "launch-token", epoch: 1 } },
  },
  {
    name: "keyless agent with a named action map, a product plugin and examples",
    files: files(
      { ...HOST, model: { backend: "none" } },
      { ...CHARACTER, bio: ["Kind"], adjectives: ["calm"], style: { chat: ["short"] }, messageExamples: [[{ name: "user", content: { text: "hi" } }], { examples: [{ name: "Agent", content: { text: "hello", actions: ["REPLY"] } }] }] },
      { schema: 1, actions: { allowed: { REPLY: true, SEARCH: true }, refused: { DELETE: true } }, plugins: { load: ["inbox"], product: "assistant" } },
    ),
    ask: { account: ACCOUNT },
  },
  {
    name: "own-key launch without a provider credential while signed in",
    files: files(OWN_KEY_HOST),
    ask: { account: ACCOUNT, frame: { token: "launch-token", epoch: 1 } },
  },
]

const REFUSED: readonly { readonly name: string; readonly files: Files }[] = [
  { name: "a host file over 256 KiB", files: { ...files(HOST), host: JSON.stringify({ ...HOST, cloud: { baseUrl: "https://cloud.example" } }) + " ".repeat(262_144) } },
  { name: "a host file with a UTF-8 byte order mark", files: { ...files(HOST), host: `\uFEFF${JSON.stringify({ ...HOST, model: { backend: "none" } })}` } },
  { name: "a schema 2 policy", files: files({ ...HOST, cloud: { baseUrl: "https://cloud.example" } }, CHARACTER, { ...POLICY, schema: 2 }) },
  { name: "an unqualified service class", files: files({ ...HOST, service: "AgentService", model: { backend: "none" } }) },
  { name: "notification text of 201 characters", files: files({ ...HOST, notification: { ...HOST.notification, text: "x".repeat(201) }, model: { backend: "none" } }) },
  { name: "no failure words", files: files({ ...HOST, notification: { channel: "Agent", title: "Agent", text: "Running" }, model: { backend: "none" } }) },
  { name: "a blank failure title", files: files({ ...HOST, notification: { ...HOST.notification, failure: { ...HOST.notification.failure, title: "   " } }, model: { backend: "none" } }) },
  { name: "failure words on the status channel's name", files: files({ ...HOST, notification: { ...HOST.notification, failure: { ...HOST.notification.failure, channel: " Agent" } }, model: { backend: "none" } }) },
  { name: "an empty renderer route list", files: files({ ...HOST, routes: [], model: { backend: "none" } }) },
  { name: "a model named twice", files: files({ ...HOST, model: { backend: "none" }, cloud: { baseUrl: "https://cloud.example" } }) },
  { name: "a cloud address with a path", files: files({ ...HOST, cloud: { baseUrl: "https://cloud.example/api/v1" } }) },
  ...[0, -1, 1.5, "1", null, Number.MAX_SAFE_INTEGER + 1].map((hostContextRevision) => ({
    name: `an invalid host context revision ${JSON.stringify(hostContextRevision)}`,
    files: files({ ...HOST, model: { backend: "none" }, hostContextRevision }),
  })),
  { name: "a reserved environment key", files: files({ ...HOST, model: { backend: "none" }, environment: { NODE_OPTIONS: "--inspect" } }) },
  { name: "local embeddings without dimensions", files: files({ ...HOST, model: { backend: "none" }, embeddings: "local" }) },
  { name: "two views sharing a name", files: files({ ...HOST, model: { backend: "none" }, views: [{ id: "chat", label: "Chat", path: "/chat" }, { id: "notes", label: "Notes", path: "/notes", aliases: ["chat"] }] }) },
  { name: "an agent id in the host file", files: files({ ...HOST, model: { backend: "none" }, agentId: "agent-1" }) },
  { name: "a character name of 51 characters", files: files({ ...HOST, model: { backend: "none" } }, { ...CHARACTER, name: "n".repeat(51) }) },
  { name: "a policy allowing nothing", files: files({ ...HOST, model: { backend: "none" } }, CHARACTER, { ...POLICY, actions: { allowed: [] } }) },
  { name: "a product plugin also in the load list", files: files({ ...HOST, model: { backend: "none" } }, CHARACTER, { ...POLICY, plugins: { load: ["inbox"], product: "inbox" } }) },
]

const bytes = (data: Files) => ({
  host: new TextEncoder().encode(data.host),
  character: new TextEncoder().encode(data.character),
  policy: new TextEncoder().encode(data.policy),
})

effect function buildVerdict(data: Files) {
  return (effect { const admitted = try admitAgentBytes(bytes(data)); return admitted } catch (error) => match (error) {
    when AgentConfigRefused: error.detail;
  })
}

effect function admittedAnswer(answer: Answer | undefined) {
  if (answer?.kind !== "admitted") throw new LaunchProjectionRefused({ answer: JSON.stringify(answer) })
  return answer
}

it.effect('Start my agent with my character, policy and model: the service and the build admit the same files, and the agent admits only ready launches with the required credential (spec/os/agentService/config.md, "Story: Start my agent with my character, policy and model"; spec/os/agentService/config.md, "Each data file is at most 256 KiB, and the host and policy files are schema 1"; spec/os/agentService/config.md, "The host file names a qualified service class, and status and failure notification words of 1 to 200 characters on two differently named channels"; spec/os/agentService/config.md, "The renderer\'s route list is admitted whole by the route gate\'s own rule"; spec/os/agentService/config.md, "The character, policy and launch settings are admitted exactly as the agent admits them"; spec/os/agentService/config.md, "The launch carries the active key\'s account and the staged worker, and never an agent id"; spec/os/agentService/config.md, "A launch carries the Google consent the owner saved, else the host file\'s"; spec/os/agentService/config.md, "A ready launch is admitted unless its backend needs a fitting credential and the frame lacks one"; spec/agent/host/launch.md, "The launch document is accepted whole or refused whole"; spec/agent/access/routes.md, "A list is loaded whole or not at all")', effect () => {
  provide NodeServices.layer {
    const provider = { ...files(OWN_KEY_HOST), account: ACCOUNT }
    const invalidProvider = { ...files({ ...OWN_KEY_HOST, schema: 2 }), account: ACCOUNT }
    const oversized = credentialFrame(ownKeyMaxUnits + 1)
    const answers = try Effect.try(() => project([
      ...ADMITTED.map((entry) => ({ ...entry.files, ...entry.ask })),
      ...REFUSED.map((entry) => entry.files),
      { ...provider, frame: credentialFrame(ownKeyMaxUnits - 1) },
      { ...provider, frame: credentialFrame(ownKeyMaxUnits) },
      { ...provider, frame: oversized },
      { ...invalidProvider, frame: oversized },
      invalidProvider,
      { ...files({ ...HOST, cloud: { baseUrl: "https://cloud.example" } }), account: ACCOUNT, frame: oversized },
    ]))
    for (const [index, entry] of ADMITTED.entries()) {
      const answer = try admittedAnswer(answers[index])
      const built = try buildVerdict(entry.files)
      assert.deepStrictEqual(built, { service: answer.service, notification: answer.notification, needsAccount: answer.needsAccount }, entry.name)
      assert.deepStrictEqual(answer.notification, NOTICE_WORDS)
      const document = try decodeLaunchDocument(answer.document)
      const raw: Record<string, unknown> = try Effect.try(() => JSON.parse(answer.document))
      assert.notProperty(raw, "agentId")
      assert.deepStrictEqual(document.account, entry.ask.account, entry.name)
      assert.deepStrictEqual(document.workflowWorker, entry.ask.workflowWorker, entry.name)
    }
    const [full, record, replaced, savedOnly, ownKey, keyless, missingOwnKey] = ADMITTED.map((_, index) => answers[index])
    const fullAnswer = try admittedAnswer(full)
    assert.deepStrictEqual([fullAnswer.rendererGroups, fullAnswer.nativeGroups, fullAnswer.needsAccount], [1, 1, true])
    const fullDocument = try decodeLaunchDocument(fullAnswer.document)
    assert.deepStrictEqual(
      [fullDocument.model, fullDocument.embeddingDimensions, fullDocument.callerRole, fullDocument.views, fullDocument.retention, fullDocument.environment, fullDocument.timeZone],
      [{ backend: "cloud", cloudBaseUrl: "https://cloud.example", smallModel: "small", largeModel: "large", imageModel: "image" }, 384, "user",
        [{ id: "chat", label: "Chat", path: "/chat", aliases: ["home"] }, { id: "notes", label: "Notes", path: "/notes" }],
        { days: 0.5, maxRowsPerRoom: 1000, intervalMinutes: 60 }, { PLUGIN_SETTING: "on" }, "Europe/Paris"],
    )
    assert.strictEqual(fullDocument.hostContextRevision, Number.MAX_SAFE_INTEGER)
    const recordDocument = try decodeLaunchDocument((try admittedAnswer(record)).document)
    assert.deepStrictEqual([recordDocument.model, recordDocument.timeZone, recordDocument.hostContextRevision],
      [{ backend: "cloud", cloudBaseUrl: "https://cloud.example", smallModel: "", largeModel: "", imageModel: "" }, "Asia/Tokyo", undefined])
    // spec/os/agentService/config.md, "A launch carries the Google consent the owner saved, else the host file's"
    const consents: unknown[] = []
    for (const answer of [full, record, replaced, savedOnly]) consents.push((try decodeLaunchDocument((try admittedAnswer(answer)).document)).google)
    assert.deepStrictEqual(consents,
      [{ gmailChanges: false, calendarEdits: true }, undefined, { gmailChanges: true, calendarEdits: true }, { gmailChanges: false, calendarEdits: true }])
    const [hostOnly] = try Effect.try(() => project([{ ...ADMITTED[2]!.files, account: ACCOUNT }]))
    const replacedText = (try admittedAnswer(replaced)).document
    const hostText = (try admittedAnswer(hostOnly)).document
    const replacedDocument: unknown = try Effect.try(() => JSON.parse(replacedText))
    const hostDocument: Record<string, unknown> = try Effect.try(() => JSON.parse(hostText))
    assert.deepStrictEqual(replacedDocument, { ...hostDocument, google: { gmailChanges: true, calendarEdits: true } })
    assert.isFalse((try admittedAnswer(ownKey)).needsAccount)
    const keylessDocument = try decodeLaunchDocument((try admittedAnswer(keyless)).document)
    assert.deepStrictEqual(keylessDocument.policy, { actions: { allowed: ["REPLY", "SEARCH"] }, plugins: { load: ["inbox"], product: "assistant" } })

    const frameText = fullAnswer.frame ?? ""
    assert.isTrue(frameText.endsWith("\n") && frameText.indexOf("\n") === frameText.length - 1)
    assert.deepStrictEqual(Object.keys(try Effect.try(() => JSON.parse(frameText))), ["version", "token", "epoch", "credential", "storageKey"])
    const frame = try decodeLaunchFrame(frameText.trimEnd())
    const next = try decodeLaunchFrame((fullAnswer.next ?? "").trimEnd())
    assert.deepStrictEqual([frame.epoch, frame.credential?.version, next.epoch, next.credential?.version, next.storageKey], [3, 7, 4, 8, undefined])
    assert.strictEqual(fullAnswer.shown, "LaunchFrame(epoch=3, credentialVersion=7)")
    for (const secret of ["launch-token", "device-key", "storage-key"]) assert.notInclude(fullAnswer.shown ?? "", secret)
    assert.isFalse(fullAnswer.pushOfHeldVersion)
    const keyFree = try decodeLaunchFrame(((try admittedAnswer(ownKey)).frame ?? "").trimEnd())
    assert.deepStrictEqual([keyFree.epoch, keyFree.credential, keyFree.storageKey], [1, undefined, undefined])

    const missingProvider = try admittedAnswer(missingOwnKey)
    const launchRoot = try scratch("missing-own-key")
    try writeTree(launchRoot, { "launch.json": missingProvider.document })
    const agentCli = import.meta.resolve("@elizaos/agent-host")
    assert.deepStrictEqual(try Effect.try(() => launchOutcome(agentCli, launchRoot, missingProvider.frame ?? "")), { exit: 77, stateCreated: false })

    for (const [index, entry] of REFUSED.entries()) {
      assert.strictEqual(answers[ADMITTED.length + index]?.kind, "refused", `the service admitted ${entry.name}`)
      assert.isString(try buildVerdict(entry.files), `the build admitted ${entry.name}`)
    }
    const [below, at, over, badConfig, badConfigWithoutKey, cloud] = answers.slice(ADMITTED.length + REFUSED.length)
    const admittedFrames = [below, at, cloud]
    const expectedUnits = [ownKeyMaxUnits - 1, ownKeyMaxUnits, ownKeyMaxUnits + 1]
    for (const [index, admitted] of admittedFrames.entries()) {
      const answer = try admittedAnswer(admitted)
      const wire = answer.frame ?? ""
      const frame = try decodeLaunchFrame(wire.trimEnd())
      assert.deepStrictEqual([frame.credential?.version, wire.match(/k{2,}/)?.[0].length], [1, expectedUnits[index]])
    }
    assert.deepStrictEqual(
      [over, badConfig].map((answer) => answer?.kind === "refused" ? [answer.cause, Object.keys(answer).sort()] : answer?.kind),
      [["Config", ["cause", "kind", "reason"]], ["Config", ["cause", "kind", "reason"]]],
    )
    assert.deepStrictEqual(badConfig, badConfigWithoutKey)
    const providerReason = over?.kind === "refused" ? over.reason : ""
    assert.isNotEmpty(providerReason)
    assert.notStrictEqual(providerReason, badConfig?.kind === "refused" ? badConfig.reason : "")
  }
}, 180_000)

it.effect('Only a cloud launch whose broker opened is handed the mail broker, by its loopback address and a launch bearer, and the launch document never names it (spec/os/agentService/config.md, "Only a cloud launch is handed the mail broker, by its address and a bearer for that launch, never a credential")', effect () => {
  const cases = ADMITTED.flatMap((entry) => (["open", "failing", "absent"] as const).map((broker) => ({ entry, broker })))
  const answers = try Effect.try(() => project(cases.map(({ entry, broker }) => ({ ...entry.files, ...entry.ask, broker }))))
  const url = "http://127.0.0.1:40123/__owner-gmail"
  for (const [index, { entry, broker }] of cases.entries()) {
    const answer = try admittedAnswer(answers[index])
    const handed: readonly (readonly [string, string])[] = answer.needsAccount && entry.ask.account !== undefined && broker === "open"
      ? [["ELIZA_MANAGED_GMAIL_READ_BROKER", url], ["ELIZA_MANAGED_GMAIL_READ_BROKER_TOKEN", "bearer"]]
      : []
    assert.deepStrictEqual(answer.broker, handed, `${entry.name} with a broker that is ${broker}`)
    for (const name of ["ELIZA_MANAGED_GMAIL_READ_BROKER", "__owner-gmail", "b".repeat(64)]) {
      assert.notInclude(answer.document, name, `${entry.name}: the launch document names ${name}`)
    }
  }
  assert.isTrue(cases.some(({ broker }, index) => broker === "open" && answers[index]?.kind === "admitted" && (answers[index]?.broker ?? []).length === 2))
}, 180_000)

const UNICODE_CHARACTER_CLASS = 0x100
const INLINE_UNICODE_CHARACTER_CLASS = /(?:^|[^\\])(?:\\\\)*\(\?[a-zA-Z-]*U[a-zA-Z-]*[:)]/

const refusedOnAndroid = (pattern: { readonly flags: number; readonly source: string }) =>
  (pattern.flags & UNICODE_CHARACTER_CLASS) !== 0 || INLINE_UNICODE_CHARACTER_CLASS.test(pattern.source)

const OWN_KEY_ADDRESSES: readonly { readonly name: string; readonly url: string }[] = [
  { name: "a user in the authority", url: "https://user@own.example/v1" },
  { name: "a byte order mark", url: "https://own.example/v1\uFEFF" },
  { name: "a fragment", url: "https://own.example/v1#models" },
  { name: "plain http", url: "http://own.example/v1" },
  { name: "an ideographic space", url: "https://own.example/v\u30001" },
  { name: "a no-break space", url: "https://own.example/v\u00A01" },
  { name: "a next-line character", url: "https://own.example/v\u00851" },
  { name: "a query", url: "https://own.example/v1?key=1" },
]

it.effect('The service compiles its address patterns with no flag Android refuses, admits a cloud and an own-key https address, and refuses an own-key address with a user, a space of any script, a byte order mark, a query, a fragment or plain http (spec/os/agentService/config.md, "Story: Start my agent with my character, policy and model"; spec/os/agentService/config.md, "The character, policy and launch settings are admitted exactly as the agent admits them")', effect () => {
  const fields = try Effect.try(() => patternFlags())
  assert.include(fields.map((entry) => entry.field), "HTTPS_URL")
  assert.deepStrictEqual(fields.filter(refusedOnAndroid), [])
  const cloud = files({ ...HOST, model: { backend: "cloud", cloudBaseUrl: "https://cloud.example", smallModel: "small", largeModel: "large", imageModel: "image" } })
  const ownKey = (url: string) => files({ ...OWN_KEY_HOST, model: { ...OWN_KEY_HOST.model, ownKeyBaseUrl: url } })
  const answers = try Effect.try(() => project([
    { ...cloud, account: ACCOUNT },
    ownKey("https://own.example/v1"),
    ...OWN_KEY_ADDRESSES.map((entry) => ownKey(entry.url)),
  ]))
  assert.deepStrictEqual(answers.slice(0, 2).map((answer) => answer.kind), ["admitted", "admitted"])
  assert.deepStrictEqual(
    answers.slice(2).map((answer, index) => [OWN_KEY_ADDRESSES[index]?.name, answer.kind === "refused" ? answer.reason : answer.kind]),
    OWN_KEY_ADDRESSES.map((entry) => [entry.name, "The agent own-key address is an https URL"]),
  )
}, 120_000)

it('The Android flag guard catches the flag passed to compile and every inline (?U) group, and nothing else (spec/os/agentService/config.md, "The character, policy and launch settings are admitted exactly as the agent admits them")', () => {
  const caught = [
    { flags: UNICODE_CHARACTER_CLASS, source: "https://[^\\s]+" },
    { flags: UNICODE_CHARACTER_CLASS | 0x40, source: "x" },
    { flags: 0, source: "(?U)https://[^\\s]+" },
    { flags: 0, source: "(?iU)x" },
    { flags: 0, source: "a(?U:\\s)b" },
    { flags: 0, source: "a(?i-U)b" },
    { flags: 0, source: "\\\\(?U)x" },
  ]
  const passed = [
    { flags: 0, source: "https://[^\\p{IsWhite_Space}\\ufeff?#@]+" },
    { flags: 0x02, source: "(?i)x" },
    { flags: 0, source: "(?<U>x)" },
    { flags: 0, source: "\\(?U\\)" },
  ]
  assert.deepStrictEqual(caught.filter((pattern) => !refusedOnAndroid(pattern)), [])
  assert.deepStrictEqual(passed.filter(refusedOnAndroid), [])
})

it.effect('The build reads the three agent data files from their asset names and refuses a missing one (spec/os/agentService/config.md, "Story: Start my agent with my character, policy and model"; spec/os/agentService/config.md, "Each data file is at most 256 KiB, and the host and policy files are schema 1")', effect () => {
  provide NodeServices.layer {
    const path = try Path.Path
    const root = try scratch("agent-config")
    const data = files({ ...HOST, cloud: { baseUrl: "https://cloud.example" } })
    try writeTree(root, { [AGENT_ASSETS.host]: data.host, [AGENT_ASSETS.character]: data.character, [AGENT_ASSETS.policy]: data.policy })
    const paths = { host: path.join(root, AGENT_ASSETS.host), character: path.join(root, AGENT_ASSETS.character), policy: path.join(root, AGENT_ASSETS.policy) }
    assert.deepStrictEqual(try admitAgentData(paths), { service: HOST.service, notification: NOTICE_WORDS, needsAccount: true })
    const missing = (effect { try admitAgentData({ ...paths, policy: path.join(root, "agent", "absent.json") }); return "admitted" } catch (error) => match (error) {
      when AgentConfigRefused: error.detail;
    })
    assert.strictEqual(missing, "The agent policy file is missing")
  }
})

it.effect('A launch that never answers ready, or exits before it does, is restarted after a growing pause, and a configuration exit still fails it (spec/os/agentService/lifecycle.md, "The agent runs only once it answers ready for this launch, and a launch that never does is restarted after the health delay")', effect () => {
  const spawn = [{ type: "reapStale" }, { type: "launchHook", refused: false }, { type: "spawn" }]
  const steps = try Effect.try(() => lifecycle([
    { type: "credentialArrived", version: 1 }, { type: "start" }, ...spawn,
    { type: "timeout" }, { type: "observeExit", code: 137 }, ...spawn,
    { type: "observeExit", code: 70 }, ...spawn,
    { type: "observeExit", code: 78 },
  ]))
  assert.deepStrictEqual([5, 6, 10, 14].map((at) => [steps[at]?.outcome, steps[at]?.state.phase, steps[at]?.state.epoch, steps[at]?.state.attempt, steps[at]?.out]), [
    ["accepted", { tag: "Stopping" }, 1, 0, [{ tag: "Kill", epoch: 1 }]],
    ["accepted", { tag: "Starting", stage: "Checking" }, 2, 1, [{ tag: "Check", epoch: 2, account: "account-a", delayMs: 1000 }]],
    ["accepted", { tag: "Starting", stage: "Checking" }, 3, 2, [{ tag: "Check", epoch: 3, account: "account-a", delayMs: 2000 }]],
    ["accepted", { tag: "Failed", cause: "Config" }, 3, 2, []],
  ])
}, 120_000)

it.effect('See a failed agent even when I silence its status: starting, running and stopping keep the status channel, and only the failure moves the notice to the alerts channel (spec/os/agentService/lifecycle.md, "Story: See a failed agent even when I silence its status"; spec/os/agentService/lifecycle.md, "A failed agent\'s notice is on the alerts channel with the failure words, and a starting, running or stopping agent\'s on the status channel")', effect () => {
  const spawn = [{ type: "reapStale" }, { type: "launchHook", refused: false }, { type: "spawn" }]
  const steps = try Effect.try(() => lifecycle([
    { type: "credentialArrived", version: 1 }, { type: "start" }, ...spawn, { type: "observeReady", epoch: 1 },
    { type: "stop" }, { type: "observeExit", code: 0 },
    { type: "start" }, ...spawn, { type: "observeExit", code: 78 },
    { type: "start" }, { type: "signedOut" },
  ]))
  assert.deepStrictEqual(steps.map((step) => [step.outcome, step.state.phase.tag, step.state.notice]), [
    ["accepted", "Stopped", "NoNotice"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Running", "StatusChannel"],
    ["accepted", "Stopping", "StatusChannel"],
    ["accepted", "Stopped", "NoNotice"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Failed", "AlertsChannel"],
    ["accepted", "Starting", "StatusChannel"],
    ["accepted", "Failed", "AlertsChannel"],
  ])
}, 120_000)

it.effect('The service writes to the agent socket only when the kernel names this app as its peer, as the rule decides for every peer (spec/os/agentService/channel.md, "The token is written only to a socket whose peer is this app")', effect () => {
  const answers = try Effect.try(() => peerAnswers())
  assert.deepStrictEqual(answers.map((answer) => [answer.peer, answer.appUid, answer.trusted]), [[1, 1, true], [1, 2, false], [2, 1, false], [2, 2, true], [null, 1, false], [null, 2, false]])
  assert.deepStrictEqual(answers.map((answer) => peerTrusted(answer.peer === null ? { tag: "PeerUnread" } : { tag: "PeerOfUser", uid: answer.peer }, answer.appUid)), answers.map((answer) => answer.trusted))
}, 120_000)
