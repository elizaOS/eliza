// spec/os/agentService/config.md, "Story: Start my agent with my character, policy and model"; spec/agent/host/launch.md, "Story: Keep the credential out of every file and reply"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { decodeLaunchDocument, decodeLaunchFrame } from "@elizaos/agent/launch"
import { AGENT_ASSETS, AgentConfigRefused, admitAgentBytes, admitAgentData, type AgentFile } from "../src/build/agent-config.vibe"
import { scratch, writeTree } from "./support/scratch.vibe"

module node {
  import { execFileSync } from "node:child_process"
  import path from "node:path"
  import { compileAdapter } from "./drivers/jvm-adapter.ts"

  const MAIN = "ai.eliza.os.agent.LaunchProjection"
  const java = process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", "java") : "java"

  export interface Ask {
    readonly host: string
    readonly character: string
    readonly policy: string
    readonly account?: { readonly userId: string; readonly organizationId: string }
    readonly workflowWorker?: { readonly runtimeDir: string; readonly executable: string; readonly sha256: string }
    readonly frame?: { readonly token: string; readonly epoch: number; readonly credential?: { readonly version: number; readonly value: string }; readonly storageKey?: string }
    readonly google?: { readonly gmailChanges: boolean; readonly calendarEdits: boolean }
  }

  export type Answer =
    | { readonly kind: "refused"; readonly reason: string }
    | {
      readonly kind: "admitted"
      readonly service: string
      readonly notification: string
      readonly rendererGroups: number
      readonly nativeGroups: number
      readonly needsAccount: boolean
      readonly document: string
      readonly frame?: string
      readonly shown?: string
      readonly next?: string
      readonly pushOfHeldVersion?: boolean
    }

  /** @throws {Error} */
  export function project(asks: readonly Ask[]): Answer[] {
    const out = execFileSync(java, ["-cp", compileAdapter(MAIN), MAIN], { input: asks.map((ask) => JSON.stringify(ask)).join("\n") + "\n", encoding: "utf8", timeout: 120_000 })
    return out.trim().split("\n").map((line) => JSON.parse(line) as Answer)
  }
}
import { project, type Answer, type Ask } from node

type Files = Readonly<Record<AgentFile, string>>

error LaunchProjectionRefused { answer: string }

const ROUTES = [
  { method: "GET", path: "/api/status" },
  { method: "POST", path: "/api/conversations/{id}/messages" },
  { method: "POST", path: "/api/conversations/{id}/messages/stream", stream: true },
]
const HOST = {
  schema: 1,
  service: "app.example.AgentService",
  notification: { channel: "Agent", title: "Agent", text: "  Your agent is running  " },
  routes: ROUTES,
}
const CHARACTER = { name: "Agent", system: "Answer briefly." }
const POLICY = { schema: 1, actions: { allowed: ["REPLY"] }, plugins: { load: ["inbox"] } }
const ACCOUNT = { userId: "user-1", organizationId: "org-1" }
const WORKER = { runtimeDir: "agent/workflow-worker", executable: "worker.mjs", sha256: "a".repeat(64) }

const files = (host: object, character: object = CHARACTER, policy: object = POLICY): Files =>
  ({ host: JSON.stringify(host), character: JSON.stringify(character), policy: JSON.stringify(policy) })

const ADMITTED: readonly { readonly name: string; readonly files: Files; readonly ask: Omit<Ask, AgentFile> }[] = [
  {
    name: "cloud model with every launch object",
    files: files({
      ...HOST,
      model: { backend: "cloud", cloudBaseUrl: "https://cloud.example", smallModel: "small", largeModel: "large", imageModel: "image" },
      nativeRoutes: [{ prefixes: ["/api/native"], id: "[a-z]+", routes: [{ method: "PUT", path: "/api/native/{id}", maxBodyBytes: 4096 }] }],
      embeddings: "local",
      embeddingDimensions: 384,
      persistMemory: true,
      callerRole: "user",
      views: [{ id: "chat", label: "Chat", path: "/chat", aliases: ["home"] }, { id: "notes", label: "Notes", path: "/notes" }],
      timeZone: "Europe/Paris",
      privacy: { secretSwap: true, piiSwap: false },
      google: { gmailChanges: false, calendarEdits: true },
      retention: { days: 0.5, maxRowsPerRoom: 1000, intervalMinutes: 60 },
      environment: { PLUGIN_SETTING: "on" },
    }),
    ask: { account: ACCOUNT, workflowWorker: WORKER, frame: { token: "launch-token", epoch: 3, credential: { version: 7, value: "device-key" }, storageKey: "storage-key" } },
  },
  {
    name: "schema 1 cloud record",
    files: files({ ...HOST, cloud: { baseUrl: "https://cloud.example" } }),
    ask: { account: ACCOUNT, frame: { token: "launch-token", epoch: 1, credential: { version: 1, value: "device-key" } } },
  },
  {
    name: "host consent replaced by the owner's saved consent",
    files: files({ ...HOST, model: { backend: "none" }, google: { gmailChanges: false, calendarEdits: false } }),
    ask: { account: ACCOUNT, google: { gmailChanges: true, calendarEdits: true } },
  },
  {
    name: "the owner's saved consent with none in the host file",
    files: files({ ...HOST, model: { backend: "none" } }),
    ask: { account: ACCOUNT, google: { gmailChanges: false, calendarEdits: true } },
  },
  {
    name: "own key without a signed-in account",
    files: files({ ...HOST, model: { backend: "own-key", ownKeyBaseUrl: "https://own.example/v1", ownKeySmall: "small", ownKeyLarge: "large" } }),
    ask: { frame: { token: "launch-token", epoch: 1 } },
  },
  {
    name: "keyless agent with a named action map, a product plugin and examples",
    files: files(
      { ...HOST, model: { backend: "none" } },
      { ...CHARACTER, bio: ["Kind"], adjectives: ["calm"], style: { chat: ["short"] }, messageExamples: [[{ name: "user", content: { text: "hi" } }], { examples: [{ name: "Agent", content: { text: "hello", actions: ["REPLY"] } }] }] },
      { schema: 1, actions: { allowed: { REPLY: true, SEARCH: true }, refused: { DELETE: true } }, plugins: { load: ["inbox"], product: "assistant" } },
    ),
    ask: { account: ACCOUNT },
  },
]

const REFUSED: readonly { readonly name: string; readonly files: Files }[] = [
  { name: "a host file over 256 KiB", files: { ...files(HOST), host: JSON.stringify({ ...HOST, cloud: { baseUrl: "https://cloud.example" } }) + " ".repeat(262_144) } },
  { name: "a schema 2 policy", files: files({ ...HOST, cloud: { baseUrl: "https://cloud.example" } }, CHARACTER, { ...POLICY, schema: 2 }) },
  { name: "an unqualified service class", files: files({ ...HOST, service: "AgentService", model: { backend: "none" } }) },
  { name: "notification text of 201 characters", files: files({ ...HOST, notification: { ...HOST.notification, text: "x".repeat(201) }, model: { backend: "none" } }) },
  { name: "an empty renderer route list", files: files({ ...HOST, routes: [], model: { backend: "none" } }) },
  { name: "a model named twice", files: files({ ...HOST, model: { backend: "none" }, cloud: { baseUrl: "https://cloud.example" } }) },
  { name: "a cloud address with a path", files: files({ ...HOST, cloud: { baseUrl: "https://cloud.example/api/v1" } }) },
  { name: "a reserved environment key", files: files({ ...HOST, model: { backend: "none" }, environment: { NODE_OPTIONS: "--inspect" } }) },
  { name: "local embeddings without dimensions", files: files({ ...HOST, model: { backend: "none" }, embeddings: "local" }) },
  { name: "two views sharing a name", files: files({ ...HOST, model: { backend: "none" }, views: [{ id: "chat", label: "Chat", path: "/chat" }, { id: "notes", label: "Notes", path: "/notes", aliases: ["chat"] }] }) },
  { name: "an agent id in the host file", files: files({ ...HOST, model: { backend: "none" }, agentId: "agent-1" }) },
  { name: "a character name of 51 characters", files: files({ ...HOST, model: { backend: "none" } }, { ...CHARACTER, name: "n".repeat(51) }) },
  { name: "a policy allowing nothing", files: files({ ...HOST, model: { backend: "none" } }, CHARACTER, { ...POLICY, actions: { allowed: [] } }) },
  { name: "a product plugin also in the load list", files: files({ ...HOST, model: { backend: "none" } }, CHARACTER, { ...POLICY, plugins: { load: ["inbox"], product: "inbox" } }) },
]

const bytes = (data: Files) => ({
  host: new TextEncoder().encode(data.host),
  character: new TextEncoder().encode(data.character),
  policy: new TextEncoder().encode(data.policy),
})

effect function buildVerdict(data: Files) {
  return (effect { const admitted = try admitAgentBytes(bytes(data)); return admitted } catch (error) => match (error) {
    when AgentConfigRefused: error.detail;
  })
}

effect function admittedAnswer(answer: Answer | undefined) {
  if (answer?.kind !== "admitted") throw new LaunchProjectionRefused({ answer: JSON.stringify(answer) })
  return answer
}

it.effect('Start my agent with my character, policy and model: the service and the build admit the same files, and the agent accepts every launch the service writes (spec/os/agentService/config.md, "Story: Start my agent with my character, policy and model"; spec/os/agentService/config.md, "Each data file is at most 256 KiB, and the host and policy files are schema 1"; spec/os/agentService/config.md, "The host file names a qualified service class and notification words of 1 to 200 characters"; spec/os/agentService/config.md, "The renderer\'s route list is admitted whole by the route gate\'s own rule"; spec/os/agentService/config.md, "The character, policy and launch settings are admitted exactly as the agent admits them"; spec/os/agentService/config.md, "The launch carries the active key\'s account and the staged worker, and never an agent id"; spec/os/agentService/config.md, "A launch carries the Google consent the owner saved, else the host file\'s"; spec/os/agentService/config.md, "The agent admits every launch the service writes, given a launch frame with a key"; spec/agent/host/launch.md, "The launch document is accepted whole or refused whole"; spec/agent/access/routes.md, "A list is loaded whole or not at all")', effect () => {
  provide NodeServices.layer {
    const answers = try Effect.try(() => project([...ADMITTED.map((entry) => ({ ...entry.files, ...entry.ask })), ...REFUSED.map((entry) => entry.files)]))
    for (const [index, entry] of ADMITTED.entries()) {
      const answer = try admittedAnswer(answers[index])
      const built = try buildVerdict(entry.files)
      assert.deepStrictEqual(built, { service: answer.service, notification: { channel: "Agent", title: "Agent", text: answer.notification }, needsAccount: answer.needsAccount }, entry.name)
      assert.strictEqual(answer.notification, "Your agent is running")
      const document = try decodeLaunchDocument(answer.document)
      const raw: Record<string, unknown> = try Effect.try(() => JSON.parse(answer.document))
      assert.notProperty(raw, "agentId")
      assert.deepStrictEqual(document.account, entry.ask.account, entry.name)
      assert.deepStrictEqual(document.workflowWorker, entry.ask.workflowWorker, entry.name)
    }
    const [full, record, replaced, savedOnly, ownKey, keyless] = ADMITTED.map((_, index) => answers[index])
    const fullAnswer = try admittedAnswer(full)
    assert.deepStrictEqual([fullAnswer.rendererGroups, fullAnswer.nativeGroups, fullAnswer.needsAccount], [1, 1, true])
    const fullDocument = try decodeLaunchDocument(fullAnswer.document)
    assert.deepStrictEqual(
      [fullDocument.model, fullDocument.embeddingDimensions, fullDocument.callerRole, fullDocument.views, fullDocument.retention, fullDocument.environment, fullDocument.timeZone],
      [{ backend: "cloud", cloudBaseUrl: "https://cloud.example", smallModel: "small", largeModel: "large", imageModel: "image" }, 384, "user",
        [{ id: "chat", label: "Chat", path: "/chat", aliases: ["home"] }, { id: "notes", label: "Notes", path: "/notes" }],
        { days: 0.5, maxRowsPerRoom: 1000, intervalMinutes: 60 }, { PLUGIN_SETTING: "on" }, "Europe/Paris"],
    )
    assert.deepStrictEqual((try decodeLaunchDocument((try admittedAnswer(record)).document)).model,
      { backend: "cloud", cloudBaseUrl: "https://cloud.example", smallModel: "", largeModel: "", imageModel: "" })
    // spec/os/agentService/config.md, "A launch carries the Google consent the owner saved, else the host file's": the host file's consent stands
    // until the subclass gives the owner's, which replaces it whole and changes nothing else in the document.
    const consents: unknown[] = []
    for (const answer of [full, record, replaced, savedOnly]) consents.push((try decodeLaunchDocument((try admittedAnswer(answer)).document)).google)
    assert.deepStrictEqual(consents,
      [{ gmailChanges: false, calendarEdits: true }, undefined, { gmailChanges: true, calendarEdits: true }, { gmailChanges: false, calendarEdits: true }])
    const [hostOnly] = try Effect.try(() => project([{ ...ADMITTED[2]!.files, account: ACCOUNT }]))
    const replacedDocument: unknown = try Effect.try(() => JSON.parse((try admittedAnswer(replaced)).document))
    const hostDocument: Record<string, unknown> = try Effect.try(() => JSON.parse((try admittedAnswer(hostOnly)).document))
    assert.deepStrictEqual(replacedDocument, { ...hostDocument, google: { gmailChanges: true, calendarEdits: true } })
    assert.isFalse((try admittedAnswer(ownKey)).needsAccount)
    const keylessDocument = try decodeLaunchDocument((try admittedAnswer(keyless)).document)
    assert.deepStrictEqual(keylessDocument.policy, { actions: { allowed: ["REPLY", "SEARCH"] }, plugins: { load: ["inbox"], product: "assistant" } })

    const frameText = fullAnswer.frame ?? ""
    assert.isTrue(frameText.endsWith("\n") && frameText.indexOf("\n") === frameText.length - 1)
    assert.deepStrictEqual(Object.keys(try Effect.try(() => JSON.parse(frameText))), ["version", "token", "epoch", "credential", "storageKey"])
    const frame = try decodeLaunchFrame(frameText.trimEnd())
    const next = try decodeLaunchFrame((fullAnswer.next ?? "").trimEnd())
    assert.deepStrictEqual([frame.epoch, frame.credential?.version, next.epoch, next.credential?.version, next.storageKey], [3, 7, 4, 8, undefined])
    assert.strictEqual(fullAnswer.shown, "LaunchFrame(epoch=3, credentialVersion=7)")
    for (const secret of ["launch-token", "device-key", "storage-key"]) assert.notInclude(fullAnswer.shown ?? "", secret)
    assert.isFalse(fullAnswer.pushOfHeldVersion)
    const keyFree = try decodeLaunchFrame(((try admittedAnswer(ownKey)).frame ?? "").trimEnd())
    assert.deepStrictEqual([keyFree.epoch, keyFree.credential, keyFree.storageKey], [1, undefined, undefined])

    for (const [index, entry] of REFUSED.entries()) {
      assert.strictEqual(answers[ADMITTED.length + index]?.kind, "refused", `the service admitted ${entry.name}`)
      assert.isString(try buildVerdict(entry.files), `the build admitted ${entry.name}`)
    }
  }
}, 180_000)

it.effect('The build reads the three agent data files from their asset names and refuses a missing one (spec/os/agentService/config.md, "Story: Start my agent with my character, policy and model"; spec/os/agentService/config.md, "Each data file is at most 256 KiB, and the host and policy files are schema 1")', effect () => {
  provide NodeServices.layer {
    const path = try Path.Path
    const root = try scratch("agent-config")
    const data = files({ ...HOST, cloud: { baseUrl: "https://cloud.example" } })
    try writeTree(root, { [AGENT_ASSETS.host]: data.host, [AGENT_ASSETS.character]: data.character, [AGENT_ASSETS.policy]: data.policy })
    const paths = { host: path.join(root, AGENT_ASSETS.host), character: path.join(root, AGENT_ASSETS.character), policy: path.join(root, AGENT_ASSETS.policy) }
    assert.deepStrictEqual(try admitAgentData(paths), { service: HOST.service, notification: { channel: "Agent", title: "Agent", text: "Your agent is running" }, needsAccount: true })
    const missing = (effect { try admitAgentData({ ...paths, policy: path.join(root, "agent", "absent.json") }); return "admitted" } catch (error) => match (error) {
      when AgentConfigRefused: error.detail;
    })
    assert.strictEqual(missing, "The agent policy file is missing")
  }
})
