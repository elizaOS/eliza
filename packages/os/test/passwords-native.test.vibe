// spec/os/android/passwords/autofill.md, "Story: Fill a form only for its site, from my choice"; spec/os/android/passwords/autofill.md, "Story: Save a password only when I choose Save and unlock"; spec/os/android/passwords/vault.md, "Story: Keep secrets typed only in an unlocked page"
import { assert, it } from "@effect/vitest"

module node {
  import { execFileSync } from "node:child_process"
  import { mkdtempSync, rmSync } from "node:fs"
  import { tmpdir } from "node:os"
  import path from "node:path"
  import { compileAdapter } from "./drivers/jvm-adapter.ts"

  export type Group = "generator" | "fill" | "save" | "match" | "offer" | "editor"

  export interface Checked {
    readonly checks: number
    readonly failed: readonly string[]
  }

  const MAIN = "ai.eliza.passwords.PasswordPolicyCheck"
  const javaTool = (name: "java" | "javac") => process.env.JAVA_HOME ? path.join(process.env.JAVA_HOME, "bin", name) : name

  export async function policy(group: Group): Promise<Checked> {
    const answer = execFileSync(javaTool("java"), ["-cp", compileAdapter(MAIN), MAIN, group], { encoding: "utf8", timeout: 60_000 })
    return JSON.parse(answer) as Checked
  }
  export async function checkSharedBackup(directory: string): Promise<string> {
    const classes = mkdtempSync(path.join(tmpdir(), "shared-password-backup-"))
    const fixture = path.join(directory, "fixtures", "shared-password-backup")
    const source = path.resolve(directory, "../../auth/android/src/main/java")
    const main = "ai.eliza.auth.cloud.SharedPasswordBackupCheck"
    try {
      execFileSync(javaTool("javac"), [
        "--release", "17", "-d", classes, "--source-path", [source, fixture].join(path.delimiter),
        path.join(fixture, "org/json/JSONObject.java"), path.join(fixture, "ai/eliza/auth/cloud/SharedPasswordBackupCheck.java"),
      ], { timeout: 30_000 })
      return execFileSync(javaTool("java"), ["-cp", classes, main], { encoding: "utf8", timeout: 30_000 }).trim()
    } finally {
      rmSync(classes, { recursive: true, force: true })
    }
  }
}
import { checkSharedBackup, policy, type Group } from node

const testDirectory = import.meta.dirname

effect function checked(group: Group) {
  const result = try tryPromise(() => policy(group))
  try Effect.try(() => assert.deepStrictEqual({ ran: result.checks > 0, failed: result.failed }, { ran: true, failed: [] }))
}

it.effect('A fill request binds one exact HTTPS origin or the framework-reported app, never the host, a frame or a mixed form (spec/os/android/passwords/autofill.md, "A form is fillable only for one exact HTTPS origin or one other app")', effect () => {
  try checked("fill")
}, 120_000)

it.effect('A saved entry matches only its exact origin, or its app with the current signer (spec/os/android/passwords/autofill.md, "Only the current offer\'s live picker publishes a dataset, for an entry of the exact facet")', effect () => {
  try checked("match")
}, 120_000)

it.effect('A fill offer opens once within its window, a newer offer retires the older picker, and a picker publishes once (spec/os/android/passwords/autofill.md, "Only the current offer\'s live picker publishes a dataset, for an entry of the exact facet")', effect () => {
  try checked("offer")
}, 120_000)

it.effect('A save capture needs one agreed password and opens its review once with its proved facet (spec/os/android/passwords/autofill.md, "A save capture keeps its proved facet and cannot be recovered from a consumed intent")', effect () => {
  try checked("save")
}, 120_000)

it.effect('A generated password has every chosen class, only the declared alphabet and a bounded length (spec/os/android/passwords/vault.md, "A typed password lives only in an open form of an unlocked page")', effect () => {
  try checked("generator")
}, 120_000)

it.effect('The native editor edits only a named entry at its selected revision, never takes a draft password and keeps app bindings (spec/os/android/passwords/vault.md, "A row action acts on the revision the owner selected"; spec/os/android/passwords/vault.md, "A typed password lives only in an open form of an unlocked page")', effect () => {
  try checked("editor")
}, 120_000)

it.effect('One shared backup approval acts once for the current account and issuer (spec/os/android/passwords/vault.md, "Story: Approve a password backup in the shared cloud")', effect () => {
  const outcome = try tryPromise(() => checkSharedBackup(testDirectory))
  try Effect.try(() => assert.strictEqual(outcome, "Shared password approval remained current and single use"))
}, 120_000)
