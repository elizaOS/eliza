+    /** The child named by the selected activity's meta-data, in the selected activity's package. */
+    private static ComponentName powerVoiceComponent(ActivityInfo selected) {
+        if (selected.metaData == null) {
+            return null;
+        }
+        final String name = selected.metaData.getString(POWER_VOICE_ACTIVITY);
+        if (name == null || name.isEmpty() || name.indexOf('/') >= 0) {
+            return null;
+        }
+        return new ComponentName(selected.packageName,
+                name.startsWith(".") ? selected.packageName + name : name);
+    }
