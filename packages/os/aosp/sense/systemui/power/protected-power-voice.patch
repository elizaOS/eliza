+            final PackageManager pm = userContext.getPackageManager();
+            final ActivityInfo selected =
+                    pm.getActivityInfo(assistComponent, PackageManager.GET_META_DATA);
+            final ComponentName powerVoice = powerVoiceComponent(selected);
+            if (powerVoice == null) {
+                return false;
