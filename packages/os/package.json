{
  "name": "@elizaos/os",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Android device image, Android host build, app updates, owned Chromium browser and inference.",
  "license": "MIT",
  "bin": {
    "eliza-os": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "imports": {
    "#chromium-component": "./browser/chromium/component/chromium-component.mjs",
    "#chromium-android-host": "./browser/chromium/component/android-host.mjs"
  },
  "files": [
    "dist",
    "android",
    "aosp",
    "browser",
    "native",
    "android/browser-surface/resources/control-channel.js",
    "!android/browser-surface/native-control-channel.mjs",
    "!android/**/build/**"
  ],
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js",
        "default": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vibelang -p tsconfig.build.json && node --input-type=module -e \"import { writeFileSync } from 'node:fs'; import { nativeControlProgram } from './android/browser-surface/native-control-channel.mjs'; writeFileSync('android/browser-surface/resources/control-channel.js', nativeControlProgram());\"",
    "typecheck": "vibelang --noEmit -p .",
    "test": "vitest run",
    "jvm:prepare": "node test/drivers/jvm-adapter.ts --compile",
    "driver:os__agentService__channel": "node test/drivers/os__agentService__channel.ts",
    "driver:os__agentService__lifecycle": "node test/drivers/os__agentService__lifecycle.ts",
    "driver:os__browser__chromium": "node test/drivers/os__browser__chromium.ts",
    "driver:os__browser__surface__profiles": "node test/drivers/os__browser__surface__profiles.ts",
    "driver:os__browser__surface__pageRequests": "node test/drivers/os__browser__surface__pageRequests.ts",
    "driver:os__image__firstRun": "node test/drivers/os__image__firstRun.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/platform-node-shared": "4.1.1",
    "effect": "4.1.1",
    "esbuild": "catalog:",
    "jsonc-parser": "3.3.1",
    "punycode": "catalog:",
    "tldts": "catalog:",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@elizaos/agent": "workspace:*",
    "@elizaos/agent-host": "workspace:*",
    "@elizaos/os-bridges": "workspace:*",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vibestack": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
