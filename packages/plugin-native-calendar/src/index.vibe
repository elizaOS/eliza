// spec/nativeCalendar/index.md, "Story: View and write the device calendar within the access I granted"
import { nativeReply } from "@elizaos/os-bridges"
import { mayUseNativeCalendar, validCalendarRange, type CalendarGrant, type CalendarOperation } from "../gen/nativeCalendar.effect.vibe"

export { calendarClient, calendarPlugin, calendarFieldsProblem } from "@elizaos/os-bridges"
export type { AndroidCalendarExpected, AndroidCalendarRow, AndroidCalendarEvent, AndroidCalendarSelection, AndroidCalendarEditorFields, AndroidCalendarSave, AndroidCalendarHandoffEvent, AndroidCalendarDeletionScope, AndroidCalendarRecurrence, AndroidCalendarScopeEvidence, AndroidCalendarDeletionTarget, AndroidCalendarReadback, AndroidCalendarAccess, AndroidCalendarPermissionState, AndroidCalendarList, AndroidCalendarInspection, AndroidCalendarSaveReply, AndroidCalendarDeletionInspection, AndroidCalendarDeletionReply, AndroidCalendarInsertHandoff, AndroidCalendarPlugin, CalendarTicket, CalendarRange, CalendarPick, CalendarInspectionResult, CalendarFieldsProblem, CalendarHandoffReport, CalendarReview, CalendarClient, CalendarClientOptions } from "@elizaos/os-bridges"

const ApplePermission = Schema.Struct({ calendar: Schema.Literals(["granted", "write_only", "denied", "prompt", "restricted"]), canRequest: Schema.Boolean })
const APPLE_CALENDAR = "AppleCalendar"

export interface AppleCalendarAccessPort {
  checkPermissions(): Promise<unknown>
}

export error CalendarNotGranted { operation: CalendarOperation }
export error CalendarIntervalInvalid { startsAt: number; endsAt: number }

export effect function checkAppleCalendarAccess(native: AppleCalendarAccessPort, operation: CalendarOperation) {
  const permission = try nativeReply(APPLE_CALENDAR, "checkPermissions", ApplePermission, () => native.checkPermissions())
  const grant: CalendarGrant =
    permission.calendar === "granted" ? "CalendarFull" :
    permission.calendar === "write_only" ? "CalendarWriteOnly" : "CalendarDenied"
  if (!mayUseNativeCalendar(grant, operation)) throw new CalendarNotGranted({ operation })
  return grant
}

export function validNativeCalendarInterval(startsAt: number, endsAt: number): boolean {
  return Number.isSafeInteger(startsAt) && Number.isSafeInteger(endsAt) && validCalendarRange({ startsAt, endsAt })
}

export type * from "./apple-calendar.vibe"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { AppleCalendarPlugin } from "./apple-calendar.vibe"

  export const appleCalendar = registerPlugin<AppleCalendarPlugin>("AppleCalendar")
}
import { appleCalendar } from capacitor

export const AppleCalendar = appleCalendar
