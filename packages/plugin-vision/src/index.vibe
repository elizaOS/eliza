export const visionPlugin: Plugin = {
  name: "@elizaos/plugin-vision",
  description:
    "Owner-authorized camera and desktop vision with OCR, tiling, Set-of-Marks grounding, entity tracking, and backpressure control.",
  contexts: ["media", "browser", "screen_time", "automation"],
  services: [VisionService, ScreenCaptureBridgeService, OcrBridgeService],
  actions: [visionAction],
  providers: [visionProvider],
  autoEnable: {
    envKeys: ["VISION_MODE", "VISION_CAMERA_INPUT"],
    shouldEnable: (env, config) => {
      const mode = env.VISION_MODE?.trim().toLowerCase()
      if (mode && mode !== "off" && mode !== "false" && mode !== "0") return true
      const media = config.media
      if (typeof media === "object" && media !== null && "vision" in media) {
        const vision = (media as Record<string, unknown>).vision
        if (typeof vision === "object" && vision !== null) {
          const rec = vision as Record<string, unknown>
          return rec.enabled !== false && typeof rec.provider === "string" && rec.provider.length > 0
        }
      }
      return false
    },
  },
  init: () => {
    if (!getOcrWithCoordsService()) {
      registerOcrWithCoordsService(new TesseractCoordOcrService())
    }
  },
  dispose: async (runtime) => {
    const vision = runtime.getService<VisionService>(VisionServiceType.VISION)
    await vision?.stop()
    const screenBridge = runtime.getService<ScreenCaptureBridgeService>(
      SCREEN_CAPTURE_BRIDGE_SERVICE_TYPE,
    )
    await screenBridge?.stop()
    const ocrBridge = runtime.getService<OcrBridgeService>(OCR_BRIDGE_SERVICE_TYPE)
    await ocrBridge?.stop()
  },
}

export const plugin = visionPlugin
export default visionPlugin
