// spec/nativeCanvas/index.md, "Story: Render and interact with the current canvas only"
import type { CanvasPlugin } from "./native-contract.vibe"

export type * from "./native-contract.vibe"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { CanvasPlugin } from "./native-contract.vibe"

  export const native = registerPlugin<CanvasPlugin>("ElizaCanvas")
}
import { native } from capacitor

export const Canvas = native

import { nativeCall, nativeReply } from "@elizaos/os-bridges"
import { mayUseCanvas, type CanvasFrame } from "../gen/nativeCanvas.effect.vibe"
import type { CanvasDrawBatchCommand } from "./native-contract.vibe"

const Layers = Schema.Struct({ layers: Schema.Array(Schema.Struct({ id: Schema.String })) })

export error CanvasLayerUnavailable { canvasId: string; layerId: string }

function targetsLayer(command: CanvasDrawBatchCommand, layerId: string): boolean {
  return command.type === "clear" ? command.args.layerId === layerId : command.args.drawOptions?.layerId === layerId
}

export effect function drawCanvasLayer(input: { frame: CanvasFrame; canvasId: string; layerId: string; commands: readonly CanvasDrawBatchCommand[] }, port: CanvasPlugin = Canvas) {
  const { canvasId, layerId, commands } = input
  if (!Number.isSafeInteger(input.frame.widthPx) || !Number.isSafeInteger(input.frame.heightPx)) {
    throw new CanvasLayerUnavailable({ canvasId, layerId })
  }
  const layers = try nativeReply("ElizaCanvas", "getLayers", Layers, () => port.getLayers({ canvasId }))
  const layerExists = layerId !== "" && layers.layers.some((layer) => layer.id === layerId)
  if (!mayUseCanvas(input.frame, canvasId, "DrawCanvas", layerExists) || !commands.every((command) => targetsLayer(command, layerId))) {
    throw new CanvasLayerUnavailable({ canvasId, layerId })
  }
  try nativeCall("ElizaCanvas", "drawBatch", () => port.drawBatch({ canvasId, commands: [...commands] }))
}
