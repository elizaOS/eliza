// spec/cloud/identity/accounts.md, "Story: Get one account on first sign-in"; spec/cloud/identity/accounts.md, "Story: Read my account"; spec/cloud/identity/accounts.md, "Story: Attribute a referral without paying for it"
import { type NotAState, type Rejected, accountView, admitsSignIn, alreadyLinked, apply, canLink, canUnlink, closedRefusal, decodeState, emailProven, firstSight, inUseRefusal, initial, lastMethodRefusal, referralDecision, type Account, type AccountEffect, type AccountStatus, type CodeOwner, type Event, type Identity, type Owner, type ReferralApplied } from "../../gen/cloud__identity__accounts.effect.vibe"
import { fundsRows } from "../billing/funds.vibe"
import { refused, Refused } from "../http/refusal.vibe"
import { json, jsonBody, owner, type Route, type RouteContext } from "../http/routes.vibe"
import { newId, secretText } from "../shared/sealing.vibe"
import { loadRow, outputRows, stepRow, type RowConflict, type RowCorrupt, type Columns } from "../store/rows.vibe"
import { Store, type StoreFailure, toText, type Row, type Tx } from "../store/connection.vibe"

export type { Account, Identity }

export interface Landed {
  readonly userId: string
  readonly organizationId: string
  readonly email: string | null
  readonly created: boolean
}

export interface LinkedIdentity extends Identity {
  readonly provenEmail?: string
}

export type AccountFailure = StoreFailure | RowCorrupt | RowConflict | Rejected | Refused

const accountRows = outputRows<Account, Event, AccountEffect[], Rejected, NotAState>("accounts", { initial, decodeState, apply })

const providers = { EmailSignIn: "email", PhoneSignIn: "sms", GoogleSignIn: "google" } as const satisfies Record<Identity["method"], string>
const statusOfColumn: Readonly<Record<string, AccountStatus>> = { active: "Active", deleting: "Deleting", erased: "Erased" }
const columnOfStatus: Readonly<Record<AccountStatus, string | null>> = { Unopened: null, Active: "active", Deleting: "deleting", Erased: "erased" }
const unowned: Owner = { tag: "Unowned" }

function normalEmail(text: string | undefined): string | undefined {
  const email = text?.trim().toLowerCase()
  return email === undefined || email === "" ? undefined : email
}

function plain(identity: Identity): Identity {
  return { method: identity.method, subject: identity.method === "EmailSignIn" ? normalEmail(identity.subject) ?? "" : identity.subject }
}

function ownerOf(row: Row | undefined): Owner {
  return row === undefined ? unowned : { tag: "OwnedBy", userId: toText(row.key) ?? "", status: statusOfColumn[toText(row.status) ?? ""] ?? "Erased" }
}

function displayName(identity: Identity, email: string | undefined, givenName: string | undefined): string {
  const given = givenName?.trim()
  if (given !== undefined && given !== "") return given
  if (email !== undefined) return email.split("@")[0]
  return identity.method === "PhoneSignIn" ? `User ***${identity.subject.slice(-4)}` : "User"
}

effect function lock(tx: Tx, names: ReadonlyArray<string>): void!StoreFailure {
  for (const name of [...names].sort()) try tx.query("SELECT pg_advisory_xact_lock(hashtextextended($1, 0))", [name])
}

effect function subjectOwner(tx: Tx, identity: Identity): Owner!StoreFailure {
  return ownerOf((try tx.query(
    "SELECT a.key, a.status FROM cloud_sign_in_identities p JOIN accounts a ON a.key = p.account_id WHERE p.provider = $1 AND p.provider_subject = $2 FOR UPDATE OF a",
    [providers[identity.method], identity.subject]
  ))[0])
}

effect function holdsMethod(tx: Tx, userId: string, identity: Identity): boolean!StoreFailure {
  return (try tx.query("SELECT 1 FROM cloud_sign_in_identities WHERE account_id = $1 AND provider = $2", [userId, providers[identity.method]])).length > 0
}

effect function insertIdentity(tx: Tx, userId: string, identity: Identity): void!StoreFailure {
  try tx.query("INSERT INTO cloud_sign_in_identities (provider, provider_subject, account_id) VALUES ($1, $2, $3)", [providers[identity.method], identity.subject, userId])
}

export effect function stepAccount(tx: Tx, userId: string, event: Event, now: number, columns: Columns = {}): ReferralApplied!(StoreFailure | RowCorrupt | RowConflict | Rejected) {
  const opened: Columns = event.type === "openAccount" ? { organization_id: event.organizationId, created_at: now } : {}
  return (try stepRow(tx, accountRows, userId, event, (state) => ({ status: columnOfStatus[state.status], updated_at: now, ...opened, ...columns }))).out
}

export effect function readAccount(tx: Tx, userId: string): Account!(StoreFailure | RowCorrupt) {
  return (try loadRow(tx, accountRows, userId, false)).state
}

effect function landed(tx: Tx, userId: string, created: boolean): Landed!(StoreFailure | Refused) {
  const row = (try tx.query("SELECT organization_id, email FROM accounts WHERE key = $1", [userId]))[0]
  if (row === undefined) throw new Refused({ refusal: closedRefusal })
  return { userId, organizationId: toText(row.organization_id) ?? "", email: toText(row.email) ?? null, created }
}

export effect function landAccount(tx: Tx, given: Identity, verifiedEmail: string | undefined, now: number, givenName?: string): Landed!AccountFailure {
  const identity = plain(given)
  const proven = emailProven(identity, normalEmail(verifiedEmail) !== undefined)
  const email = proven ? normalEmail(identity.method === "EmailSignIn" ? identity.subject : verifiedEmail) : undefined
  try lock(tx, [`subject:${providers[identity.method]}:${identity.subject}`, ...(email === undefined ? [] : [`email:${email}`])])
  const bySubject = try subjectOwner(tx, identity)
  const byEmail = email === undefined ? unowned : ownerOf((try tx.query("SELECT key, status FROM accounts WHERE email = $1 FOR UPDATE", [email]))[0])
  const landing = firstSight(identity, proven, bySubject, byEmail)
  if (!admitsSignIn(landing)) throw new Refused({ refusal: closedRefusal })
  if (landing.tag === "SignInAs") return try landed(tx, landing.account, false)
  if (landing.tag === "AttachTo") {
    if (try holdsMethod(tx, landing.target, identity)) throw new Refused({ refusal: inUseRefusal })
    try stepAccount(tx, landing.target, { type: "link", identity, subjectOwner: bySubject }, now)
    try insertIdentity(tx, landing.target, identity)
    return try landed(tx, landing.target, false)
  }
  const userId = newId()
  const organizationId = newId()
  const referralCode = secretText("", 5, "hex").toUpperCase()
  const name = displayName(identity, email, givenName)
  try tx.query("INSERT INTO organizations (id, name, created_at) VALUES ($1, $2, $3)", [organizationId, name, now])
  try stepAccount(tx, userId, { type: "openAccount", userId, organizationId, identity, verifiedEmail: proven, subjectOwner: bySubject, emailOwner: byEmail, referralCode }, now, {
    email: email ?? null,
    phone: identity.method === "PhoneSignIn" ? identity.subject : null,
    name
  })
  try insertIdentity(tx, userId, identity)
  try tx.query("INSERT INTO referral_codes (code, user_id) VALUES ($1, $2)", [referralCode, userId])
  try tx.query("INSERT INTO funds (key, state, revision, updated_at) VALUES ($1, $2::jsonb, 1, $3)", [organizationId, JSON.stringify(fundsRows.initial), now])
  return { userId, organizationId, email: email ?? null, created: true }
}

export effect function linkIdentity(tx: Tx, userId: string, given: LinkedIdentity, now: number): void!AccountFailure {
  const identity = plain(given)
  const email = normalEmail(given.provenEmail)
  try lock(tx, [`subject:${providers[identity.method]}:${identity.subject}`, ...(email === undefined ? [] : [`email:${email}`])])
  const bySubject = try subjectOwner(tx, identity)
  const { state } = try loadRow(tx, accountRows, userId)
  if (alreadyLinked(state, bySubject)) return
  if (bySubject.tag !== "Unowned" || (try holdsMethod(tx, userId, identity))) throw new Refused({ refusal: inUseRefusal })
  if (!canLink(state, identity, bySubject)) throw new Refused({ refusal: closedRefusal })
  try stepAccount(tx, userId, { type: "link", identity, subjectOwner: bySubject }, now)
  try insertIdentity(tx, userId, identity)
  if (identity.method === "PhoneSignIn") try tx.query("UPDATE accounts SET phone = $2 WHERE key = $1", [userId, identity.subject])
  if (email !== undefined && emailProven(identity, true)) {
    try tx.query("UPDATE accounts SET email = $2 WHERE key = $1 AND email IS NULL AND NOT EXISTS (SELECT 1 FROM accounts WHERE email = $2)", [userId, email])
  }
}

export effect function unlinkIdentity(tx: Tx, userId: string, given: Identity, now: number): void!AccountFailure {
  const identity = plain(given)
  const { state } = try loadRow(tx, accountRows, userId)
  if (!state.identities.some((held) => held.method === identity.method && held.subject === identity.subject)) throw refused("NotFound")
  if (!canUnlink(state, identity)) throw new Refused({ refusal: state.status === "Active" ? lastMethodRefusal : closedRefusal })
  try stepAccount(tx, userId, { type: "unlink", identity }, now)
  try tx.query("DELETE FROM cloud_sign_in_identities WHERE provider = $1 AND provider_subject = $2 AND account_id = $3", [providers[identity.method], identity.subject, userId])
  if (identity.method === "PhoneSignIn") try tx.query("UPDATE accounts SET phone = NULL WHERE key = $1 AND phone = $2", [userId, identity.subject])
  if (identity.method === "EmailSignIn") try tx.query("UPDATE accounts SET email = NULL WHERE key = $1 AND email = $2", [userId, identity.subject])
  if (identity.method === "GoogleSignIn") {
    try tx.query("UPDATE accounts a SET email = NULL WHERE a.key = $1 AND NOT EXISTS (SELECT 1 FROM cloud_sign_in_identities p WHERE p.account_id = a.key AND p.provider = 'email' AND p.provider_subject = a.email)", [userId])
  }
}

effect function applyReferralCode(tx: Tx, userId: string, given: string, now: number): void!AccountFailure {
  const code = given.trim().toUpperCase()
  if (code === "") throw refused("InvalidRequest")
  const holder = toText((try tx.query("SELECT user_id FROM referral_codes WHERE code = $1", [code]))[0]?.user_id)
  const codeOwner: CodeOwner = holder === undefined ? { tag: "UnknownCode" } : { tag: "CodeOf", ownerUserId: holder }
  try tx.query("SELECT key FROM accounts WHERE key = ANY($1) ORDER BY key FOR UPDATE", [holder === undefined ? [userId] : [userId, holder]])
  const decision = referralDecision(try readAccount(tx, userId), code, codeOwner)
  if (decision.tag === "RefuseReferral") throw refused(decision.refusal)
  if (decision.tag === "SameCodeAgain") return
  const applied = try stepAccount(tx, userId, { type: "applyReferral", code, codeOwner }, now)
  try tx.query("INSERT INTO referral_uses (user_id, code, referrer_user_id, created_at) VALUES ($1, $2, $3, $4)", [userId, code, holder, now])
  for (const counted of applied.out) try stepAccount(tx, counted.referrerUserId, { type: "countReferral" }, now)
}

effect function caller(context: RouteContext): { readonly userId: string; readonly organizationId: string }!Refused {
  const signed = owner(context.caller)
  if (signed === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return signed
}

schema ReferralRequest { code: string }

export const routes: ReadonlyArray<Route> = [
  {
    method: "GET",
    path: "/api/v1/user",
    auth: "ServiceAccess",
    handler: (context) => effect {
      const { userId } = try caller(context)
      const store = try Store
      const row = (try store.transaction((tx) => tx.query(
        "SELECT a.key, a.email, a.phone, a.name, o.id AS organization_id, o.name AS organization_name FROM accounts a JOIN organizations o ON o.id = a.organization_id WHERE a.key = $1",
        [userId]
      )))[0]
      if (row === undefined) throw refused("NotFound")
      const organizationId = toText(row.organization_id) ?? ""
      const email = toText(row.email)
      const phone = toText(row.phone)
      const name = toText(row.name)
      return json({
        success: true,
        data: {
          id: userId,
          ...(email === undefined ? {} : { email }),
          ...(phone === undefined ? {} : { phone }),
          ...(name === undefined ? {} : { name }),
          organization_id: organizationId,
          organization: { id: organizationId, name: toText(row.organization_name) ?? "" }
        }
      })
    }
  },
  {
    method: "GET",
    path: "/api/v1/referrals",
    auth: "ServiceAccess",
    handler: (context) => effect {
      const { userId } = try caller(context)
      const store = try Store
      const view = accountView(try store.transaction((tx) => readAccount(tx, userId)))
      return json({ code: view.referralCode, total_referrals: view.totalReferrals, is_active: true })
    }
  },
  {
    method: "POST",
    path: "/api/v1/referrals/apply",
    auth: "ServiceAccess",
    handler: (context) => effect {
      const { userId } = try caller(context)
      const { code } = try jsonBody(context, ReferralRequest)
      const store = try Store
      try store.transaction((tx) => applyReferralCode(tx, userId, code, context.now))
      return json({ success: true })
    }
  }
]
