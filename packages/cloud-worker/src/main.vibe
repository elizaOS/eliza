#!/usr/bin/env node
// spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile"; spec/cloud/operator.md, "Story: Operate the deployment without reading secrets"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { cloudLayer, prepare } from "./server.vibe"
import { formatInet } from "effect/net/NetAddress"
import { checkCatalog } from "./billing/plans.vibe"
import { guardMigration, runOperator } from "./operator/admin.vibe"
import { deploymentLayer, parseEnvironment, readProfile } from "@elizaos/cloud"
import { migrate, parseStoreLocation, storeLayer } from "./store/store.vibe"

module node {
  /** @throws {never} */
  export function commandLine(): ReadonlyArray<string> {
    return process.argv.slice(2)
  }
}
import { commandLine } from node

export error UsageInvalid { message: string }

const usage = "usage: elizaos-cloud serve --profile <file> --environment production|staging --store pg-url|pglite[:<file>] [--seed <file>] [--port <n>] [--host <address>] | migrate --profile <file> --environment <e> --store <s> | prices check --profile <file> --environment <e> | credits add|account devices|account revoke-devices … --profile <file> --environment <e> --store <s>"

effect function flags(args: ReadonlyArray<string>, allowed: ReadonlyArray<string>): ReadonlyMap<string, string>!UsageInvalid {
  const found = new Map<string, string>()
  for (let index = 0; index < args.length; index += 2) {
    const name = args[index] ?? ""
    const value = args[index + 1]
    const key = name.slice(2)
    if (!name.startsWith("--") || !allowed.includes(key) || value === undefined || found.has(key)) throw new UsageInvalid({ message: usage })
    found.set(key, value)
  }
  return found
}

effect function required(found: ReadonlyMap<string, string>, name: string): string!UsageInvalid {
  const value = found.get(name)
  if (value === undefined) throw new UsageInvalid({ message: `--${name} is required; ${usage}` })
  return value
}

effect function port(found: ReadonlyMap<string, string>): number!UsageInvalid {
  const text = found.get("port") ?? "8080"
  const value = Number(text)
  if (!/^\d{1,5}$/.test(text) || value > 65535) throw new UsageInvalid({ message: `--port must be 0 to 65535` })
  return value
}

effect function serve(args: ReadonlyArray<string>) {
  const found = try flags(args, ["profile", "environment", "store", "seed", "port", "host"])
  const environment = try required(found, "environment")
  const options = try prepare({
    profile: try readProfile(try required(found, "profile")),
    environment,
    store: try required(found, "store"),
    seed: found.get("seed"),
    port: try port(found),
    host: found.get("host") ?? "0.0.0.0"
  })
  provide cloudLayer(options) {
    const { address } = try HttpServer.HttpServer
    if ("port" in address) try annotateLogs(logInfo("serving"), { url: `http://${formatInet(address)}`, environment: options.environment })
    try never
  }
}

effect function migrateOnly(args: ReadonlyArray<string>) {
  const found = try flags(args, ["profile", "environment", "store"])
  const profile = try readProfile(try required(found, "profile"))
  const environment = try parseEnvironment(try required(found, "environment"))
  const location = try parseStoreLocation(try required(found, "store"))
  const settings = profile.environments[environment]
  provide storeLayer(location), deploymentLayer(profile, environment) {
    try guardMigration()
    const report = try migrate({ digest: settings.databaseIdentity, environment, now: try Clock.currentTimeMillis })
    try annotateLogs(logInfo("migrated"), { applied: report.applied.join(", ") || "none" })
  }
}

effect function checkPrices(args: ReadonlyArray<string>) {
  const found = try flags(args, ["profile", "environment"])
  const profile = try readProfile(try required(found, "profile"))
  const environment = try parseEnvironment(try required(found, "environment"))
  if (profile.environments[environment].billing === undefined) throw new UsageInvalid({ message: "the selected environment has no payment catalog configured" })
  provide deploymentLayer(profile, environment), FetchHttpClient.layer {
    try checkCatalog()
    try annotateLogs(logInfo("price catalog verified"), { environment })
  }
}

effect function main() {
  const [command, ...rest] = commandLine()
  if (command === "serve") return try serve(rest)
  if (command === "migrate") return try migrateOnly(rest)
  if (command === "prices" && rest[0] === "check") return try checkPrices(rest.slice(1))
  if (command === undefined) throw new UsageInvalid({ message: usage })
  try runOperator(command, rest)
}

NodeRuntime.runMain(Effect.provide(main(), NodeServices.layer))
