// spec/cloud/services/google/mailRead.md, "Story: Read my mail through the grant I chose"
// spec/cloud/services/google/mailRead.md, "Story: Notice new mail while I sign in privately"
import { htmlMaxBytes, inboxWatchCanAnswer, mailMaxBytes, mebibyte, offeredReads, replyAddressOf, threadMaxMessages, threadOutcome, threadPageMax, type MailSurface, type ThreadAsk } from "../../../gen/cloud__services__google__mailRead.effect.vibe"
import { refused, Refused } from "../../http/refusal.vibe"
import { json, owner as ownerOf, type Route, type RouteContext } from "../../http/routes.vibe"
import { bearerToken, recheckAccess, signed } from "../../http/request-auth.vibe"
import { Deployment } from "@elizaos/cloud"
import { seal, sha256Hex, tokenDigest, unseal } from "../../shared/sealing.vibe"
import { googleJson, type GoogleFailure } from "../../providers/google.vibe"
import { holds, knownScopes, readGrantStatus, requireSameMailGrant, useGrant, useMailReadGrant, type GoogleCapability } from "./grant-access.vibe"
import { decodeInboxWatch, inboxArrivalBodyLimit, inboxArrivalPath, inboxWatchBinding, inboxWatchInput, observeInboxWatch } from "./inbox-arrival.vibe"
import * as GoogleRead from "../../google-read.vibe"
import type { OperationKind } from "./mail-operations.vibe"

module node {
  import { createHash } from "node:crypto"

  /** @throws {never} */
  export function partBytes(data: string): { readonly dataBase64: string; readonly size: number; readonly sha256: string } {
    const bytes = Buffer.from(data, "base64url")
    return { dataBase64: bytes.toString("base64"), size: bytes.length, sha256: createHash("sha256").update(bytes).digest("hex") }
  }

  /** @throws {never} */
  export function utf8Length(text: string): number {
    return Buffer.byteLength(text, "utf8")
  }

  /** @throws {never} */
  export function encodeCursor(value: string): string {
    return Buffer.from(value, "utf8").toString("hex")
  }

  /** @throws {never} */
  export function cursorEnvelope(cursor: string): string {
    if (cursor.length % 2 !== 0) return ""
    const envelope = Buffer.from(cursor, "hex").toString("utf8")
    return /^v1\.[^.]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(envelope) ? envelope : ""
  }
}
import { cursorEnvelope, encodeCursor, partBytes, utf8Length } from node

schema MailMessage {
  id: string; threadId: string; historyId?: string; snippet?: string; internalDate?: string; labelIds?: string[]; payload?: GoogleRead.MailPart
}
schema MessageRef { id: string }
schema MessageList { messages?: MessageRef[]; nextPageToken?: string }
schema Profile { historyId: string }
schema Thread { id: string; historyId: string; messages: Schema.Unknown[] }
schema DraftList { drafts?: MessageRef[]; nextPageToken?: string }
schema DraftMessage { id: string; raw?: string; snippet?: string; internalDate?: string; payload?: GoogleRead.MailPart }
schema Draft { id: string; message: DraftMessage }

export interface ReadGrant {
  readonly accessToken: string
}

interface Grant extends ReadGrant {
  readonly email: string
  readonly scopes: ReadonlyArray<string>
}

interface Attachment {
  readonly name: string
  readonly mimeType: string
  readonly size: number
  readonly dataBase64: string
  readonly sha256: string
}

type Format = "metadata" | "full"

const gmail = "/gmail/v1/users/me"
const providerId = /^[A-Za-z0-9_-]{1,256}$/
const historyPattern = /^\d{1,20}$/
const partIdPattern = /^[0-9.]{1,32}$/
const threadPageMaxBytes = 1.5 * mebibyte
const draftPage = 25
const messageMaxBytes = Math.ceil(GoogleRead.attachmentMaxBytes / 3) * 4 + 65536
const threadMaxBytes = 12 * 1024 * 1024
const trashQuery = /(?:^|[\s({])in:(?:spam|trash|anywhere)(?=[\s)}]|$)/i

const kindsByCapability: ReadonlyArray<readonly [GoogleCapability, ReadonlyArray<OperationKind>]> = [
  ["google.gmail.send", ["send"]],
  ["google.gmail.drafts", ["draft-create", "draft-replace", "draft-delete"]],
  ["google.gmail.manage", ["archive", "unarchive", "trash", "untrash", "mark-read", "mark-unread", "star", "unstar"]]
]

const readNames: Readonly<Record<MailSurface, string>> = {
  TriageSurface: "triage", SearchSurface: "search", MessageSurface: "read",
  ThreadSurface: "thread", AttachmentSurface: "attachment",
  DraftsSurface: "drafts", DraftSurface: "draft", CapabilitiesSurface: "capabilities"
}

export function googleRefused(failure: GoogleFailure): Refused {
  switch (failure._tag) {
    case "NotFound": return refused("NotFound")
    case "InvalidGrant": return refused("GoogleReauthRequired")
    case "ContentTooLarge": return refused("ContentTooLarge")
    case "InvalidResponse": return refused("ProviderInvalidResponse")
    case "PreconditionFailed":
    case "Duplicate":
    case "Rejected":
    case "Unavailable": return refused("ProviderUnavailable")
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

effect function google(grant: ReadGrant, path: string, maxBytes?: number) {
  const answer = googleJson(grant.accessToken, "GET", `${gmail}${path}`, maxBytes === undefined ? {} : { maxBytes }) catch effect (failure) => { throw googleRefused(failure) }
  return answer
}

effect function parsed<A>(schema: Schema.Codec<A>, raw: unknown): A!Refused {
  const value = Schema.decodeUnknownOption(schema)(raw)
  if (Option.isNone(value)) throw refused("ProviderInvalidResponse")
  return value.value
}

function headerValues(part: GoogleRead.MailPart | undefined, name: string): ReadonlyArray<string> {
  return (part?.headers ?? []).filter((header) => header.name.toLowerCase() === name).map((header) => header.value)
}

function header(part: GoogleRead.MailPart | undefined, name: string): string {
  return headerValues(part, name).at(-1) ?? ""
}

effect function mailCard(message: MailMessage, selfEmail: string) {
  const receivedAt = GoogleRead.isoMailDate(message.internalDate)
  if (!providerId.test(message.id) || !providerId.test(message.threadId) || receivedAt === null) {
    throw refused("ProviderInvalidResponse")
  }
  const headers = GoogleRead.headerMap(message.payload)
  const labels = (message.labelIds ?? []).map((label) => label.trim()).filter((label) => label !== "")
  return {
    id: message.id, externalId: message.id, threadId: message.threadId, subject: headers.get("subject") ?? "", from: headers.get("from") ?? "",
    snippet: message.snippet ?? "", receivedAt, labels, ...GoogleRead.mailTriageFields(labels, headers, selfEmail),
    hasAttachments: GoogleRead.mailAttachmentHint(message.payload, headers),
    metadata: { historyId: message.historyId ?? null }
  }
}

effect function readMessage(grant: ReadGrant, id: string, format: Format) {
  if (!providerId.test(id)) throw refused("InvalidRequest")
  const query = new URLSearchParams({ format })
  if (format === "metadata") for (const name of GoogleRead.mailMetadataHeaders) query.append("metadataHeaders", name)
  const message = try parsed(MailMessage, try google(grant, `/messages/${id}?${query}`, format === "full" ? messageMaxBytes : undefined))
  if (message.id !== id) throw refused("ProviderInvalidResponse")
  return message
}

export effect function readAtHistory(grant: ReadGrant, messageId: string, historyId: string) {
  if (!historyPattern.test(historyId)) throw refused("InvalidRequest")
  const message = try readMessage(grant, messageId, "full")
  if (message.historyId !== historyId) throw refused("StaleRevision")
  return message
}

effect function mailParts(root: GoogleRead.MailPart | undefined, maxParts?: number) {
  return GoogleRead.scanMailParts(root, "depth-first", maxParts) catch effect (failure) => {
    if (failure instanceof GoogleRead.GoogleReadTooLarge) throw refused("ContentTooLarge")
    throw refused("ProviderInvalidResponse")
  }
}

function charsetOf(part: GoogleRead.MailPart): string {
  return /charset="?([^";\s]+)"?/i.exec(header(part, "content-type"))?.[1] ?? "utf-8"
}

effect function partData(grant: ReadGrant, messageId: string, part: GoogleRead.MailPart, maxBytes: number) {
  const body = part.body
  if (body === undefined) throw refused("ProviderInvalidResponse")
  if ((body.size ?? 0) > maxBytes) throw refused("ContentTooLarge")
  if (body.data !== undefined) return body.data
  if (body.attachmentId === undefined) {
    if (body.size === 0) return ""
    throw refused("ProviderInvalidResponse")
  }
  if (!providerId.test(body.attachmentId)) throw refused("ProviderInvalidResponse")
  const fetched = try parsed(GoogleRead.MessageBody, try google(grant, `/messages/${messageId}/attachments/${body.attachmentId}`, Math.ceil(maxBytes / 3) * 4 + 4096))
  if (fetched.data === undefined) throw refused("ProviderInvalidResponse")
  return fetched.data
}

effect function bodyPart(grant: ReadGrant, messageId: string, part: GoogleRead.MailPart | undefined, maxBytes: number) {
  if (part === undefined) return undefined
  const data = try partData(grant, messageId, part, maxBytes)
  return GoogleRead.decodeMailText(data, charsetOf(part), maxBytes) catch effect (failure) => {
    if (failure instanceof GoogleRead.GoogleReadTooLarge) throw refused("ContentTooLarge")
    throw refused("ProviderInvalidResponse")
  }
}

effect function messageView(grant: ReadGrant, message: MailMessage, selfEmail: string) {
  const parts = try mailParts(message.payload)
  const plain = try bodyPart(grant, message.id, parts.plain, mailMaxBytes)
  const omitHtml = plain !== undefined && !parts.partsWithinLimit
  const html = bodyPart(grant, message.id, omitHtml ? undefined : parts.html, plain === undefined ? mailMaxBytes : htmlMaxBytes) catch effect (failure) => {
    if (plain !== undefined && failure.refusal.code === "ContentTooLarge") return null
    throw failure
  }
  const text = plain ?? (typeof html === "string" ? GoogleRead.htmlText(html) : message.snippet)
  const bodyText = text ?? ""
  if (utf8Length(bodyText) > mailMaxBytes) throw refused("ContentTooLarge")
  const replyHeaders = headerValues(message.payload, "reply-to")
  const address = GoogleRead.composeMailboxAddress((replyHeaders[0] ?? "").trim())
  const replyAddress = replyAddressOf(replyHeaders.length, address !== undefined)
  return {
    message: {
      ...(try mailCard(message, selfEmail)),
      ...(replyAddress === "NoReplyOverride" ? {} : { replyTo: replyAddress === "ReplyOverride" ? address ?? null : null }),
    },
    bodyText,
    bodyTextAvailable: text !== undefined,
    ...GoogleRead.mailHtmlView(html, parts.partsWithinLimit),
    attachments: parts.attachments.map(GoogleRead.attachmentDescriptor),
    authenticationResults: GoogleRead.receivedAuthentication(message.payload?.headers ?? [])
  }
}

export effect function attachmentBytes(grant: ReadGrant, messageId: string, partId: string, historyId: string) {
  if (!partIdPattern.test(partId)) throw refused("InvalidRequest")
  const message = try readAtHistory(grant, messageId, historyId)
  const matching = (try mailParts(message.payload)).attachments.filter((part) => part.partId === partId)
  const part = matching[0]
  if (part === undefined || matching.length !== 1) throw refused("NotFound")
  const declared = part.body?.size
  if (declared === undefined || !Number.isSafeInteger(declared) || declared < 0) throw refused("ProviderInvalidResponse")
  const data = try partData(grant, message.id, part, GoogleRead.attachmentMaxBytes)
  if (!/^[A-Za-z0-9_-]*={0,2}$/.test(data)) throw refused("ProviderInvalidResponse")
  const bytes = partBytes(data)
  if (bytes.size !== declared) throw refused("ProviderInvalidResponse")
  const { name, mimeType } = GoogleRead.attachmentDescriptor(part)
  return { name, mimeType, ...bytes } satisfies Attachment
}

effect function mailboxHistory(grant: ReadGrant) {
  const profile = try parsed(Profile, try google(grant, "/profile?fields=historyId"))
  if (!historyPattern.test(profile.historyId)) throw refused("ProviderInvalidResponse")
  return profile.historyId
}

effect function listed(grant: Grant, query: URLSearchParams, limit: number, pageToken: string | undefined) {
  const page = try parsed(MessageList, try google(grant, `/messages?${query}`))
  const next = page.nextPageToken
  if ((page.messages ?? []).length > limit || (next !== undefined && (next === "" || next.length > 4096 || next === pageToken))) throw refused("ProviderInvalidResponse")
  const messages = try Effect.forEach(page.messages ?? [], effect (entry) => {
    return try mailCard(try readMessage(grant, entry.id, "metadata"), grant.email)
  }, { concurrency: 8 })
  return { messages, nextPageToken: next ?? null }
}

effect function grantOf(context: RouteContext, surface: MailSurface) {
  const owner = ownerOf(context.caller)
  if (owner === undefined) throw refused("AuthenticationRequired")
  const grantId = context.query.get("grantId") ?? ""
  const grant = try useMailReadGrant(owner, grantId === "" ? undefined : grantId, context.query.get("side"), surface)
  return { ...grant, accountId: owner.userId }
}

effect function param(context: RouteContext, name: string, pattern: RegExp) {
  const value = context.query.get(name) ?? ""
  if (!pattern.test(value)) throw refused("InvalidRequest")
  return value
}

effect function pageTokenOf(context: RouteContext) {
  const token = context.query.get("pageToken")
  if (token === null) return undefined
  if (token === "" || token.length > 4096 || /[\r\n\0]/.test(token)) throw refused("InvalidRequest")
  return token
}

const syncedAt = (context: RouteContext) => new Date(context.now).toISOString()

effect function triageRoute(context: RouteContext) {
  const { limit, folder, label, q } = GoogleRead.gmailTriageInput(context.query) catch effect () => { throw refused("InvalidRequest") }
  const pageToken = try pageTokenOf(context)
  const grant = try grantOf(context, "TriageSurface")
  const mailboxHistoryId = try mailboxHistory(grant)
  const query = new URLSearchParams({ maxResults: String(limit), labelIds: label })
  if (label === "TRASH") query.set("includeSpamTrash", "true")
  if (q !== "") query.set("q", q)
  if (pageToken !== undefined) query.set("pageToken", pageToken)
  const page = try listed(grant, query, limit, pageToken)
  const messages = page.messages.filter(({ labels }) => labels.includes(label) && (label === "TRASH" || !(labels.includes("TRASH") || labels.includes("SPAM"))))
  if (folder === "inbox") messages.sort(GoogleRead.compareMailTriage)
  return json({ ...page, accountId: grant.accountId, folder, q, messages, syncedAt: syncedAt(context), mailboxHistoryId })
}

effect function searchRoute(context: RouteContext) {
  const query = (context.query.get("query") ?? "").trim()
  if (query === "" || query.length > 2048) throw refused("InvalidRequest")
  const limit = GoogleRead.mailListCount("SearchList", context.query.get("maxResults"))
  if (limit === null) throw refused("InvalidRequest")
  const pageToken = try pageTokenOf(context)
  const grant = try grantOf(context, "SearchSurface")
  const mailboxHistoryId = try mailboxHistory(grant)
  const search = new URLSearchParams({ q: query, maxResults: String(limit), includeSpamTrash: String(trashQuery.test(query)) })
  if (pageToken !== undefined) search.set("pageToken", pageToken)
  const page = try listed(grant, search, limit, pageToken)
  return json({ ...page, accountId: grant.accountId, q: query, syncedAt: syncedAt(context), mailboxHistoryId, supportsSpamTrash: true })
}

// spec/cloud/services/google/mailRead.md, "A message read answers the message whole, with inert HTML whole or absent, or is refused as too large"
effect function readRoute(context: RouteContext) {
  const messageId = try param(context, "messageId", providerId)
  const grant = try grantOf(context, "MessageSurface")
  const message = try readMessage(grant, messageId, "full")
  const historyId = message.historyId !== undefined && historyPattern.test(message.historyId) ? message.historyId : null
  const view = try messageView(grant, message, grant.email)
  try requireSameMailGrant(grant)
  return json({ accountId: grant.accountId, historyId, ...view })
}

effect function capabilitiesRoute(context: RouteContext) {
  const grant = try grantOf(context, "CapabilitiesSurface")
  const kinds = kindsByCapability.flatMap(([capability, granted]) => holds(grant.scopes, capability) ? granted : [])
  const reads = offeredReads(knownScopes(grant.scopes)).map((surface) => readNames[surface])
  return json({
    version: 1, from: grant.email, reads, kinds,
    attachmentPolicy: { mimeTypes: GoogleRead.attachmentMimeTypes, maxBytes: GoogleRead.attachmentMaxBytes },
    providerExactlyOnce: false
  })
}

effect function arrivalRoute(context: RouteContext) {
  const caller = signed(context.caller)
  const authorization = context.request.headers.authorization
  const token = bearerToken(authorization)
  if (caller === undefined || token === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const mode = caller.kind === "deviceKey" ? "DeviceWatch" : "BrowserWatch"
  const input = inboxWatchInput(context.query, mode) catch effect () => { throw refused("InvalidRequest") }
  const now = try Clock.currentTimeMillis
  const selection = try readGrantStatus(caller, input.grant, context.query.get("side"), now)
  const grantId = selection.connectionId
  const subject = selection.identity?.id
  const capability = "google.gmail.triage"
  if (!grantId || !subject || !selection.grantedCapabilities.includes(capability)) throw refused("GoogleReauthRequired")
  const { settings } = try Deployment
  const identity = JSON.stringify([grantId, subject])
  const binding = sha256Hex(inboxWatchBinding(settings.api, caller.userId, caller.organizationId, identity, {
    kind: mode === "DeviceWatch" ? "device" : "browser", hash: tokenDigest(token)
  })) + ":"
  const presentedCursor = input.cursor
  const watch = presentedCursor === undefined ? undefined : try (effect {
    const claim = unseal("gmail-arrival", cursorEnvelope(presentedCursor)) catch effect () => { throw refused("GoogleReauthRequired") }
    if (!claim.startsWith(binding)) throw refused("GoogleReauthRequired")
    return decodeInboxWatch(claim.slice(binding.length), now) catch effect () => { throw refused("GoogleReauthRequired") }
  })
  const grant = try useGrant(caller, grantId, capability, subject)
  // Grant refresh must settle before the HTTP server can interrupt this read.
  return try Effect.interruptible(effect {
    const answer = observeInboxWatch(watch, now, effect (path) => {
      return googleJson(grant.accessToken, "GET", gmail + path, { maxBytes: inboxArrivalBodyLimit }) catch effect (failure) => {
        if (failure._tag === "Rejected" && failure.status === 403) throw refused("GoogleReauthRequired")
        throw googleRefused(failure)
      }
    }) catch effect (failure) => {
      if (failure._tag === "InboxHistoryInvalid") throw refused("ProviderInvalidResponse")
      throw failure
    }
    const cursor = presentedCursor ?? encodeCursor(try seal("gmail-arrival", binding + JSON.stringify(answer.watch)))
    const current = try readGrantStatus(caller, grantId, null, try Clock.currentTimeMillis)
    try recheckAccess(authorization, caller, "ServiceAccess")
    const grantCurrent = current.connected && current.connectionId === grantId && current.identity?.id === subject && current.grantedCapabilities.includes(capability)
    if (!inboxWatchCanAnswer(answer.watch, try Clock.currentTimeMillis, grantCurrent, true, true)) throw refused("GoogleReauthRequired")
    return json({ cursor, arrived: answer.arrived })
  })
}

effect function threadRoute(context: RouteContext) {
  const threadId = try param(context, "threadId", providerId)
  const offset = Number(context.query.get("offset") ?? "0")
  const expected = context.query.get("historyId") ?? undefined
  if (!Number.isSafeInteger(offset) || offset < 0 || offset > threadMaxMessages || (offset > 0 && expected === undefined) ||
      (expected !== undefined && !historyPattern.test(expected))) throw refused("InvalidRequest")
  const grant = try grantOf(context, "ThreadSurface")
  const thread = try parsed(Thread, try google(grant, `/threads/${threadId}?format=full`, threadMaxBytes))
  if (thread.id !== threadId || !historyPattern.test(thread.historyId)) throw refused("ProviderInvalidResponse")
  const ask: ThreadAsk = { offset, asked: expected === undefined ? { tag: "AnyRevision" } : { tag: "AtRevision", historyId: expected } }
  const snapshot = { threadRevision: thread.historyId, total: thread.messages.length, fitting: threadPageMax, oversized: false }
  const window = threadOutcome(ask, snapshot)
  if (window.tag === "ThreadRefused") throw new Refused({ refusal: window.refusal })
  const all = (try Effect.forEach(thread.messages, (raw) => parsed(MailMessage, raw))).toSorted((left, right) => Number(left.internalDate) - Number(right.internalDate))
  if (all.some((message) => message.threadId !== threadId)) throw refused("ProviderInvalidResponse")

  const receipt = effect (messages: ReadonlyArray<unknown>) => {
    const chosen = threadOutcome(ask, { ...snapshot, fitting: messages.length })
    if (chosen.tag === "ThreadRefused") throw new Refused({ refusal: chosen.refusal })
    return json({
      version: 1, threadId, historyId: thread.historyId, total: snapshot.total, offset: chosen.first,
      nextOffset: chosen.rest.tag === "NextAt" ? chosen.rest.nextOffset : null, messages
    })
  }
  const messages: unknown[] = []
  let served: ReturnType<typeof json> | undefined
  for (const message of all.slice(window.first, window.first + window.count)) {
    messages.push({ ...(try messageView(grant, message, grant.email)), historyId: message.historyId ?? null })
    const candidate = try receipt(messages)
    if (candidate.body._tag !== "Uint8Array" || candidate.body.contentLength > threadPageMaxBytes) {
      if (served === undefined) throw refused("ContentTooLarge")
      break
    }
    served = candidate
  }
  return served ?? (try receipt(messages))
}

effect function attachmentRoute(context: RouteContext) {
  const messageId = try param(context, "messageId", providerId)
  const partId = try param(context, "partId", partIdPattern)
  const historyId = try param(context, "historyId", historyPattern)
  const grant = try grantOf(context, "AttachmentSurface")
  const file = try attachmentBytes(grant, messageId, partId, historyId)
  return json({ version: 1, messageId, partId, historyId, ...file, supported: GoogleRead.attachmentMimeTypes.includes(file.mimeType) })
}

effect function draftsRoute(context: RouteContext) {
  const pageToken = try pageTokenOf(context)
  const grant = try grantOf(context, "DraftsSurface")
  const query = new URLSearchParams({ maxResults: String(draftPage) })
  if (pageToken !== undefined) query.set("pageToken", pageToken)
  const page = try parsed(DraftList, try google(grant, `/drafts?${query}`))
  const next = page.nextPageToken
  if ((page.drafts ?? []).length > draftPage || (next !== undefined && (next === "" || next.length > 4096 || next === pageToken))) throw refused("ProviderInvalidResponse")
  const drafts = try Effect.forEach(page.drafts ?? [], effect (entry) => {
    if (!providerId.test(entry.id)) throw refused("ProviderInvalidResponse")
    const draft = try parsed(Draft, try google(grant, `/drafts/${entry.id}?format=metadata`))
    if (draft.id !== entry.id || !providerId.test(draft.message.id)) throw refused("ProviderInvalidResponse")
    const updated = Number(draft.message.internalDate ?? "")
    return {
      draftId: draft.id, messageId: draft.message.id, subject: header(draft.message.payload, "subject"),
      to: GoogleRead.mailAddresses(header(draft.message.payload, "to")), snippet: draft.message.snippet ?? "",
      updatedAt: Number.isSafeInteger(updated) && updated > 0 ? new Date(updated).toISOString() : null
    }
  }, { concurrency: 8 })
  return json({ version: 1, drafts, nextPageToken: next ?? null })
}

effect function draftRoute(context: RouteContext) {
  const draftId = try param(context, "draftId", providerId)
  const grant = try grantOf(context, "DraftSurface")
  const raw = try parsed(Draft, try google(grant, `/drafts/${draftId}?format=raw`, threadMaxBytes))
  const full = try parsed(Draft, try google(grant, `/drafts/${draftId}?format=full`, threadMaxBytes))
  if (raw.id !== draftId || raw.message.raw === undefined || !providerId.test(raw.message.id)) throw refused("ProviderInvalidResponse")
  if (full.id !== draftId || full.message.id !== raw.message.id) throw refused("StaleRevision")
  const parts = try mailParts(full.message.payload, GoogleRead.mailMaxParts)
  const payload = full.message.payload
  return json({
    version: 1, id: draftId, messageId: raw.message.id, providerDigest: sha256Hex(raw.message.raw),
    content: {
      to: GoogleRead.mailAddresses(header(payload, "to")), cc: GoogleRead.mailAddresses(header(payload, "cc")), bcc: GoogleRead.mailAddresses(header(payload, "bcc")),
      subject: header(payload, "subject"),
      bodyText: (try bodyPart(grant, full.message.id, parts.plain, mailMaxBytes)) ?? "",
      plainText: parts.plain !== undefined || parts.html === undefined,
      threaded: header(payload, "in-reply-to") !== "" || header(payload, "references") !== "",
      attachmentCount: parts.attachments.length
    }
  })
}

const gmailPath = "/api/v1/eliza/google/gmail"

export const mailReadRoutes: ReadonlyArray<Route> = [
  { method: "GET", path: `${gmailPath}/triage`, auth: "MailAccess", area: "GoogleRoutes", handler: triageRoute },
  { method: "GET", path: `${gmailPath}/search`, auth: "MailAccess", area: "GoogleRoutes", handler: searchRoute },
  { method: "GET", path: `${gmailPath}/read`, auth: "MailAccess", area: "GoogleRoutes", handler: readRoute },
  { method: "GET", path: inboxArrivalPath, auth: "ServiceAccess", area: "GoogleRoutes", handler: arrivalRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/capabilities`, auth: "MailAccess", area: "GoogleRoutes", handler: capabilitiesRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/thread`, auth: "MailAccess", area: "GoogleRoutes", handler: threadRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/attachment`, auth: "MailAccess", area: "GoogleRoutes", handler: attachmentRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/drafts`, auth: "MailAccess", area: "GoogleRoutes", handler: draftsRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/draft`, auth: "MailAccess", area: "GoogleRoutes", handler: draftRoute }
]
