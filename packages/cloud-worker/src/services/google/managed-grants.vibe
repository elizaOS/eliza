// spec/cloud/services/google/connection.md, "Story: Connect my Google account with the access I chose"; spec/cloud/services/google/connection.md, "A later grant for the same Google subject, or a native code for a new one, replaces the connection's tokens and scopes and makes it active"
// spec/cloud/identity/federatedSignIn.md, "A native connect stores tokens only for the signed-in account's own Google identity and only the scopes Google granted"
import { nativeConnectAttempts, nativeConnectStores, nativeConnectStoresAny, nativeConnectWindowSeconds } from "../../../gen/cloud__identity__federatedSignIn.effect.vibe"
import { millisPerSecond } from "../../../gen/cloud__shared__types.effect.vibe"
import type { Signed } from "../../http/request-auth.vibe"
import { refused } from "../../http/refusal.vibe"
import { rateLimitRetryAt } from "../../identity-store.vibe"
import { decodeGrant, inspectKey, isFlatGrant } from "../../native-clients/grants.vibe"
import { capabilityEnabled, Deployment } from "@elizaos/cloud"
import { googleSubjectPattern, readIdToken } from "../../providers/google-identity.vibe"
import { googleJson, tokenForm, type GoogleProfile } from "../../providers/google.vibe"
import { Store, toText, type Tx } from "../../store/connection.vibe"
import { capabilitiesOf, holds, issueManagedGrant, type GoogleCapability, type ManagedLanding, type Owner } from "./grant-access.vibe"

export const ServerAuthCode = Schema.String.check(Schema.isMinLength(10), Schema.isMaxLength(2048), Schema.isPattern(/^[A-Za-z0-9/_.~-]+$/))
export const GoogleSubject = Schema.String.check(Schema.isPattern(googleSubjectPattern))
schema ServerCodeReply { access_token: string; expires_in: number; refresh_token?: string; scope?: string; id_token?: string }
const UserInfo = Schema.Struct({ id: GoogleSubject, email: Schema.optionalKey(Schema.String), verified_email: Schema.optionalKey(Schema.Boolean), name: Schema.optionalKey(Schema.String) })

export type GoogleLinkFault = "google_not_configured" | "google_code_rejected" | "google_scopes_missing" | "google_account_mismatch" | "google_reconnect_required" | "google_unavailable"
export type GoogleLink =
  | { readonly connected: true; readonly connectionId: string; readonly email: string | null; readonly scopes: ReadonlyArray<string>; readonly refreshTokenIssued: boolean }
  | { readonly connected: false; readonly code: GoogleLinkFault }

type ProviderLanding = Omit<ManagedLanding, "owner"> & { readonly displayName: string | undefined }

type GrantIdentity = { readonly subject: string; readonly email: string | undefined; readonly displayName: string | undefined }

export function unlinked(code: GoogleLinkFault): Extract<GoogleLink, { readonly connected: false }> {
  return { connected: false, code }
}

function named(text: string | undefined): string | undefined {
  return text?.trim() || undefined
}

effect function identityOf(google: GoogleProfile, reply: typeof ServerCodeReply.Type, audience: "browser" | "native") {
  if (reply.id_token !== undefined) {
    const claims = try readIdToken(google, { idToken: reply.id_token, audience })
    if (!claims.signatureOk || !claims.issuerOk || !claims.audienceOk || claims.subject === undefined) return undefined
    return { subject: claims.subject, email: claims.verifiedEmail, displayName: claims.givenName } satisfies GrantIdentity
  }
  const raw = try googleJson(reply.access_token, "GET", "/oauth2/v2/userinfo", { maxBytes: 64 * 1024 })
  const info = Option.getOrUndefined(Schema.decodeUnknownOption(UserInfo)(raw))
  if (info === undefined) return undefined
  return { subject: info.id, email: info.verified_email === true ? named(info.email)?.toLowerCase() : undefined, displayName: named(info.name) } satisfies GrantIdentity
}

export type ManagedCode =
  | { readonly kind: "browser"; readonly code: string; readonly verifier: string; readonly redirect: string }
  | { readonly kind: "native"; readonly code: string; readonly expectedSubject: string | undefined }

export effect function redeemManagedCode(google: GoogleProfile, request: ManagedCode) {
  const secret = try orDie((try Deployment).secret(google.clientSecretEnv))
  const form = new URLSearchParams({ grant_type: "authorization_code", code: request.code, client_secret: secret })
  if (request.kind === "native") {
    form.set("client_id", google.serverClientId)
    form.set("redirect_uri", "")
  } else {
    form.set("client_id", google.clientId)
    form.set("redirect_uri", request.redirect)
    form.set("code_verifier", request.verifier)
  }
  const answer = try tokenForm(google.tokenUrl, form)
  if (answer.status >= 400 && answer.status < 500) return unlinked("google_code_rejected")
  if (answer.status < 200 || answer.status >= 300) return unlinked("google_unavailable")
  const reply = Option.getOrUndefined(Schema.decodeUnknownOption(ServerCodeReply)(answer.body))
  if (reply === undefined || reply.access_token === "") return unlinked("google_unavailable")
  const lifetime = reply.expires_in * millisPerSecond
  if (!Number.isSafeInteger(lifetime) || lifetime <= 0) return unlinked("google_unavailable")
  const grantedScopes = [...new Set((reply.scope ?? "").split(/\s+/).filter((scope) => scope !== ""))]
  if (grantedScopes.length === 0) return unlinked("google_scopes_missing")
  const identity = try identityOf(google, reply, request.kind)
  if (identity === undefined || (request.kind === "native" && request.expectedSubject !== undefined && identity.subject !== request.expectedSubject)) return unlinked("google_account_mismatch")
  const now = try Clock.currentTimeMillis
  const expiresAt = now + lifetime
  if (!Number.isSafeInteger(expiresAt)) return unlinked("google_unavailable")
  const landing: ProviderLanding = { ...identity, grantedScopes, tokens: { accessToken: reply.access_token, refreshToken: reply.refresh_token ?? "", expiresAt }, now }
  return { connected: true, landing } as const
}

type LinkAuthority =
  | { readonly kind: "standalone"; readonly subject: string | undefined }
  | { readonly kind: "enrolled"; readonly subject: string; readonly grantKey?: string }

effect function enrolledSubject(tx: Tx, owner: Owner) {
  const row = (try tx.query(
    "SELECT i.provider_subject FROM accounts a JOIN cloud_sign_in_identities i ON i.account_id=a.key AND i.provider='google' " +
      "WHERE a.key=$1 AND a.organization_id=$2 AND a.status='active' FOR UPDATE OF a",
    [owner.userId, owner.organizationId]
  ))[0]
  return toText(row?.provider_subject)
}

effect function nativeRegistration(tx: Tx, owner: Owner, grantKey: string, environment: string, now: number) {
  const row = (try tx.query(
    "SELECT g.state, g.phase, g.key_expires_at, g.device_epoch AS grant_epoch, a.device_epoch AS account_epoch, " +
      "n.client_id AS registered_client, n.enabled, n.native_google FROM device_grants g JOIN accounts a ON a.key=g.user_id " +
      "LEFT JOIN LATERAL (SELECT client_id, enabled, native_google FROM native_clients " +
        "WHERE client_id=g.client_id AND environment=$4 FOR SHARE) n ON true " +
      "WHERE g.key=$1 AND a.key=$2 AND a.organization_id=$3 AND a.status='active' FOR UPDATE OF a, g",
    [grantKey, owner.userId, owner.organizationId, environment]
  ))[0]
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialRevoked")
  const live = inspectKey(row, now) catch effect () => { throw refused("ServiceUnavailable") }
  if (live.reason !== "NoReason") throw refused("AuthenticationRequired", live.reason)
  const legacyNative = isFlatGrant(row.state)
  const grant = live.authority.tag === "GrantAuthority" ? live.authority.grant
    : legacyNative ? undefined : (decodeGrant(row.state) catch effect () => { throw refused("ServiceUnavailable") })
  const bound = grant?.client.tag === "BoundClient" ? grant.client : undefined
  if (!legacyNative && bound === undefined && row.registered_client === null) return false
  if (bound !== undefined && (bound.clientId !== row.registered_client || bound.environment !== (environment === "production" ? "Production" : "Staging"))) {
    throw refused("InvalidClient")
  }
  if (row.enabled !== true || row.native_google !== true) throw refused("ClientDisabled")
  return true
}

effect function linkNativeGoogle(owner: Owner, code: string, authority: LinkAuthority) {
  const { settings } = try Deployment
  if (settings.google === undefined || !capabilityEnabled(settings, "managedGoogle")) return unlinked("google_not_configured")
  const redeemed = redeemManagedCode(settings.google, { kind: "native", code, expectedSubject: authority.subject }) catch effect (failure) => {
    try annotateLogs(logWarning("Google could not exchange the managed authorization code"), { failure: failure._tag })
    return unlinked("google_unavailable")
  }
  if (!redeemed.connected) return authority.kind === "enrolled" && redeemed.code !== "google_unavailable"
    ? unlinked("google_reconnect_required") : redeemed
  const { landing } = redeemed
  const store = try Store
  if (authority.kind === "standalone") {
    const stored = try store.transaction((tx) => issueManagedGrant(tx, { ...landing, owner }))
    return { connected: true, ...stored, displayName: landing.displayName ?? null, scopes: landing.grantedScopes } as const
  }
  const granted = landing.grantedScopes
  const consent = nativeConnectStores(authority.subject, landing.subject, landing.tokens.refreshToken !== "", {
    readMail: holds(granted, "google.gmail.triage"),
    sendMail: holds(granted, "google.gmail.send"),
    trashMail: holds(granted, "google.gmail.manage"),
    readCalendar: holds(granted, "google.calendar.read"),
    writeCalendar: holds(granted, "google.calendar.write"),
  })
  if (!nativeConnectStoresAny(consent)) return unlinked("google_reconnect_required")
  const allowed: Partial<Record<GoogleCapability, boolean>> = {
    "google.gmail.triage": consent.readMail,
    "google.gmail.send": consent.sendMail,
    "google.gmail.manage": consent.trashMail,
    "google.gmail.mailbox": consent.trashMail,
    "google.calendar.read": consent.readCalendar,
    "google.calendar.write": consent.writeCalendar,
  }
  const scopes = granted.filter((scope) => capabilitiesOf([scope]).every((capability) => allowed[capability] !== false))
  const { environment } = try Deployment
  return try store.transaction(effect (tx: Tx) => {
    if (authority.grantKey !== undefined && !(try nativeRegistration(tx, owner, authority.grantKey, environment, try Clock.currentTimeMillis))) {
      return unlinked("google_reconnect_required")
    }
    if ((try enrolledSubject(tx, owner)) !== authority.subject) return unlinked("google_reconnect_required")
    const stored = try issueManagedGrant(tx, { ...landing, grantedScopes: scopes, owner })
    return { connected: true, ...stored, displayName: landing.displayName ?? null, scopes } as const
  })
}

export effect function linkNativeSignInGoogle(owner: Owner, code: string, subject: string) {
  return try linkNativeGoogle(owner, code, { kind: "enrolled", subject })
}

export effect function linkAuthorizedGoogle(caller: Signed, code: string, expectedSubject?: string) {
  if (caller.kind === "session") return try linkNativeGoogle(caller, code, { kind: "standalone", subject: expectedSubject })
  const store = try Store
  const { environment } = try Deployment
  const now = try Clock.currentTimeMillis
  const native = try store.transaction((tx) => nativeRegistration(tx, caller, caller.grantKey, environment, now))
  if (!native) return try linkNativeGoogle(caller, code, { kind: "standalone", subject: expectedSubject })
  const retryAt = try store.transaction((tx) => rateLimitRetryAt(tx, {
    scope: "google:native:connect", subject: caller.userId, maximum: nativeConnectAttempts, seconds: nativeConnectWindowSeconds,
  }, now))
  if (retryAt !== undefined) throw refused("RateLimited", "NoReason", retryAt)
  const subject = try store.transaction((tx) => enrolledSubject(tx, caller))
  if (subject === undefined || (expectedSubject !== undefined && expectedSubject !== subject)) return unlinked("google_reconnect_required")
  return try linkNativeGoogle(caller, code, { kind: "enrolled", subject, grantKey: caller.grantKey })
}
