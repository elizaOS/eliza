// spec/cloud/shared/metering.md, "Story: Settle every call once"; spec/cloud/index.md, "Story: Transcribe a recording"; spec/cloud/services/speech.md, "Each batch request holds once under its organization and its request id, and spends one request of the plan's standard limit"
import { billedSeconds, providerRetryMs, synthesisCourseOf, withMarkup } from "../../gen/cloud__services__speech.effect.vibe"
import type { HoldKey } from "../../gen/cloud__shared__types.ts"
import { refused, Refused } from "../http/refusal.vibe"
import { signed } from "../http/request-auth.vibe"
import { jsonBody, type CloudContext, type Route, type RouteContext } from "../http/routes.vibe"
import { Deployment, type EnvironmentProfile, IdempotencyKey, SynthesisBody } from "@elizaos/cloud"
import { synthesize, synthesizeTimed, prepareTranscription, ProviderInvalidResponse, type SpeechFailure, type Synthesis, type TimedFrame, type Transcription } from "../providers/speech.vibe"
import { requestDigest } from "../shared/dispatch-once.vibe"
import { keepStanding, markDispatched, reserve, settle, type Settlement } from "../shared/metering.vibe"

type SpeechSettings = NonNullable<EnvironmentProfile["speech"]>

const uploadLimit = 25 * 1024 * 1024
const timedBytesLimit = 8 * 1024 * 1024
const timedFrameLimit = 2048
const audioTypes: ReadonlyArray<string> = ["audio/mp3", "audio/mpeg", "audio/mp4", "audio/m4a", "audio/x-m4a", "audio/wav", "audio/x-wav", "audio/webm", "audio/ogg"]

const uploadFields: ReadonlyArray<string> = ["audio", "languageCode", "provider"]
const kilobitsPerSecond: Readonly<Record<string, number>> = { "audio/wav": 1411, "audio/x-wav": 1411, "audio/webm": 96, "audio/ogg": 96 }
const encoder = new TextEncoder()
const decodeKey = Schema.decodeUnknownOption(IdempotencyKey)

interface Upload {
  readonly audio: Uint8Array
  readonly mimeType: string
  readonly languageCode?: string
  readonly durationMs: number
}

function ttsQuote(text: string, settings: SpeechSettings): number {
  return withMarkup(text.length * settings.tts.microsPerCharacter)
}

function sttCharge(durationMs: number, settings: SpeechSettings): number {
  return withMarkup(billedSeconds(durationMs) * settings.stt.microsPerSecond)
}

function readUint32(bytes: Uint8Array, at: number): number {
  return ((bytes[at] ?? 0) | ((bytes[at + 1] ?? 0) << 8) | ((bytes[at + 2] ?? 0) << 16)) + (bytes[at + 3] ?? 0) * 0x1000000
}

function ascii(bytes: Uint8Array, at: number, length: number): string {
  return String.fromCharCode(...bytes.subarray(at, at + length))
}

function wavDurationMs(bytes: Uint8Array): number | undefined {
  if (ascii(bytes, 0, 4) !== "RIFF" || ascii(bytes, 8, 4) !== "WAVE") return undefined
  let at = 12
  let byteRate = 0
  while (at + 8 <= bytes.length) {
    const id = ascii(bytes, at, 4)
    const size = readUint32(bytes, at + 4)
    if (id === "fmt " && size >= 16) byteRate = readUint32(bytes, at + 16)
    if (id === "data") {
      if (byteRate <= 0) return undefined
      return Math.ceil(Math.min(size, bytes.length - at - 8) * 1000 / byteRate)
    }
    at += 8 + size + (size % 2)
  }
  return undefined
}

function uploadDurationMs(audio: Uint8Array, mimeType: string): number | undefined {
  if (mimeType === "audio/wav" || mimeType === "audio/x-wav") return wavDurationMs(audio)
  return Math.max(1000, Math.ceil(audio.length * 8 / (kilobitsPerSecond[mimeType] ?? 128)))
}

effect function speechSettings(): SpeechSettings!Refused!Deployment {
  const settings = (try Deployment).settings.speech
  if (settings === undefined) throw refused("CapabilityUnavailable")
  return settings
}

function failedSettlement(failure: SpeechFailure): Settlement {
  if (failure._tag === "ProviderRefused" && failure.status >= 400 && failure.status < 500) return { kind: "known", actual: 0 }
  return { kind: "unknown" }
}

function providerRefusal(failure: SpeechFailure, now: number): Refused {
  switch (failure._tag) {
    case "ProviderRefused":
      return failure.status === 429 || failure.status >= 500 ? refused("ProviderUnavailable", "NoReason", now + (failure.retryAfter ?? providerRetryMs)) : refused("ProviderInvalidResponse")
    case "ProviderUnreachable":
    case "ProviderTimedOut":
      return refused("ProviderUnavailable", "NoReason", now + providerRetryMs)
    case "ProviderInvalidResponse":
      return refused("ProviderInvalidResponse")
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

effect function heldCall<A, R>(context: RouteContext, requestId: string, quote: number, call: A!SpeechFailure!R, charge: (answer: A) => number, repeatable: boolean) {
  const caller = signed(context.caller)
  if (caller === undefined) throw refused("AuthenticationRequired")
  const key: HoldKey = { service: "MeteredSpeech", caller: caller.userId, requestId, part: { tag: "WholeRequest" } }
  const ticket = try reserve(caller, key, quote)
  if (ticket.replayed) {
    if (!repeatable || synthesisCourseOf(true, ticket.hold) !== "SpeakAgain") throw refused("IdempotencyConflict")
    const again = call catch effect (failure) => { throw providerRefusal(failure, try Clock.currentTimeMillis) }
    return again
  }
  try keepStanding(context.request.headers.authorization, caller, "MeteredSpeech", ticket)
  try markDispatched(ticket.key)
  const answer = call catch effect (failure) => {
    try settle(ticket.key, failedSettlement(failure))
    throw providerRefusal(failure, try Clock.currentTimeMillis)
  }
  try settle(ticket.key, { kind: "known", actual: charge(answer) })
  return answer
}

effect function synthesisOf(body: SynthesisBody, settings: SpeechSettings): Synthesis!Refused {
  const voiceId = body.voiceId ?? settings.tts.defaultVoiceId
  const modelId = body.modelId ?? settings.tts.defaultModelId
  if (!settings.tts.voiceIds.includes(voiceId) || !settings.tts.modelIds.includes(modelId)) throw refused("InvalidRequest")
  if (body.withTimestamps === true && body.format === "wav") throw refused("InvalidRequest")
  return {
    text: body.text,
    ...(body.previousText === undefined ? {} : { previousText: body.previousText }),
    ...(body.nextText === undefined ? {} : { nextText: body.nextText }),
    voiceId,
    modelId,
    format: body.format ?? "mp3",
    speed: body.speed ?? 1,
    applyTextNormalization: body.applyTextNormalization ?? "auto"
  }
}

effect function synthesisRequestId(context: RouteContext, synthesis: Synthesis, timed: boolean): string!Refused {
  const given = context.request.headers["idempotency-key"]
  if (given === undefined) return context.requestId
  const key = Option.getOrUndefined(decodeKey(given))
  if (key === undefined) throw refused("InvalidRequest")
  return `${key}:${requestDigest({ synthesis, timed })}`
}

effect function boundedFrames<R>(frames: ReadonlyArray<TimedFrame>!SpeechFailure!R): Uint8Array!SpeechFailure!R {
  const read = try frames
  const lines = [
    ...read.map((frame, sequence) => JSON.stringify({ type: "audio", sequence, audioBase64: frame.audioBase64, alignment: frame.alignment })),
    JSON.stringify({ type: "done" })
  ]
  const bytes = encoder.encode(lines.map((line) => `${line}\n`).join(""))
  if (read.length === 0 || read.length > timedFrameLimit || bytes.length > timedBytesLimit) throw new ProviderInvalidResponse()
  return bytes
}

effect function speak(context: RouteContext): HttpServerResponse.HttpServerResponse!{ readonly _tag: string }!CloudContext {
  const settings = try speechSettings()
  const body = try jsonBody(context, SynthesisBody)
  const synthesis = try synthesisOf(body, settings)
  const quote = ttsQuote(body.text, settings)
  const requestId = try synthesisRequestId(context, synthesis, body.withTimestamps === true)
  const headers = { "cache-control": "no-store", "x-eliza-tts-provider": settings.provider, "x-eliza-tts-speed": String(synthesis.speed) }
  if (body.withTimestamps === true) {
    const timed = try heldCall(context, requestId, quote, boundedFrames(synthesizeTimed(settings, synthesis)), () => quote, true)
    return HttpServerResponse.uint8Array(timed, { status: 200, contentType: "application/x-ndjson", headers: { ...headers, "x-eliza-tts-timing": "character-v1" } })
  }
  const audio = try heldCall(context, requestId, quote, synthesize(settings, synthesis), () => quote, true)
  return HttpServerResponse.uint8Array(audio.audio, { status: 200, contentType: audio.contentType, headers })
}

function baseType(contentType: string): string {
  return (contentType.split(";")[0] ?? "").trim().toLowerCase()
}

effect function readUpload(context: RouteContext, settings: SpeechSettings): Upload!Refused {
  if (baseType(context.request.headers["content-type"] ?? "") !== "multipart/form-data") throw refused("InvalidRequest")
  const seen = new Set<string>()
  let audio: { readonly bytes: Uint8Array; readonly mimeType: string } | undefined
  let languageCode: string | undefined
  let provider: string | undefined
  const parts = effect {
    for try (const part of context.request.multipartStream) {
      if (!uploadFields.includes(part.key)) throw refused("InvalidRequest", "UnsupportedField")
      if (seen.has(part.key)) throw refused("InvalidRequest")
      seen.add(part.key)
      if (part._tag === "File") {
        if (part.key !== "audio") throw refused("InvalidRequest")
        audio = { bytes: try part.contentEffect, mimeType: baseType(part.contentType) }
      } else if (part.key === "languageCode") {
        languageCode = part.value
      } else if (part.key === "provider") {
        provider = part.value
      } else {
        throw refused("InvalidRequest")
      }
    }
  }
  parts catch effect (failure) => match (failure) {
    when Refused: throw failure;
    default: throw failure.reason._tag === "BodyTooLarge" || failure.reason._tag === "FileTooLarge" ? refused("ContentTooLarge") : refused("InvalidRequest");
  }
  if (audio === undefined || audio.bytes.length === 0 || !audioTypes.includes(audio.mimeType)) throw refused("InvalidRequest")
  if (audio.bytes.length > uploadLimit) throw refused("ContentTooLarge")
  if (provider !== undefined && provider !== settings.provider) throw refused("InvalidRequest")
  if (languageCode !== undefined && !settings.stt.languageCodes.includes(languageCode)) throw refused("InvalidRequest")
  const durationMs = uploadDurationMs(audio.bytes, audio.mimeType)
  if (durationMs === undefined || durationMs <= 0) throw refused("InvalidRequest")
  return { audio: audio.bytes, mimeType: audio.mimeType, durationMs, ...(languageCode === undefined ? {} : { languageCode }) }
}

effect function hear(context: RouteContext): HttpServerResponse.HttpServerResponse!{ readonly _tag: string }!CloudContext {
  const settings = try speechSettings()
  const upload = try readUpload(context, settings)
  const request = { audio: upload.audio, mimeType: upload.mimeType, ...(upload.languageCode === undefined ? {} : { languageCode: upload.languageCode }) }
  const call = prepareTranscription(settings, request) catch effect (failure) => { throw providerRefusal(failure, context.now) }
  const heard: Transcription = try heldCall(context, context.requestId, sttCharge(upload.durationMs, settings), call, (answer: Transcription) => sttCharge(answer.durationMs, settings), false)
  return HttpServerResponse.jsonUnsafe({
    transcript: heard.transcript,
    duration_ms: heard.durationMs,
    ...(heard.segments === undefined ? {} : { segments: heard.segments }),
    ...(heard.words === undefined ? {} : { words: heard.words })
  }, { status: 200, headers: { "cache-control": "no-store", "x-eliza-stt-provider": settings.provider } })
}

export const batchSpeechRoutes: ReadonlyArray<Route> = [
  { method: "POST", path: "/api/v1/voice/tts", auth: "ServiceAccess", capability: "speech", rateClass: "StandardRequests", handler: speak },
  { method: "POST", path: "/api/v1/voice/stt", auth: "ServiceAccess", capability: "speech", rateClass: "StandardRequests", maxBodyBytes: uploadLimit, handler: hear }
]
