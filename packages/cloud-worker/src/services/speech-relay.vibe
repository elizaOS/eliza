// spec/cloud/services/speechRelay.md, "Story: Speak the relay protocol on one socket"; spec/cloud/services/speechRelay.md, "Story: Keep a live session funded and close it with receipts"; spec/cloud/index.md, "Story: Use a cloud speech session"; spec/cloud/index.md, "A speech window bounds the audio and text sent to providers"
import { Socket } from "effect/socket"
import {
  acceptsAudio, helloDeadline, isSttFrame, maxDownlinkPcmBytes, relayAtUpgrade, relayChannels, relaySampleRate, relayStep, speaking, stageIs, windowLength, windowTtsChars,
  type Relay, type RelayInput, type ServerFrame, type Shortfall
} from "../../gen/cloud__services__speechRelay.effect.vibe"
import { readDevice, validUplink, writeRelay, type RelayWire } from "@elizaos/cloud"
import { refused, type Refused } from "../http/refusal.vibe"
import type { CloudContext, Route, RouteContext } from "../http/routes.vibe"
import { openStt, openTts, type SttEdge, type SttLink, type TtsEdge, type TtsLink } from "../providers/speech.vibe"
import { relaySession } from "./speech-session.vibe"

export type Failure = { readonly _tag: string }

export type WindowAdmission =
  | { readonly kind: "admitted"; readonly expiresAt: number }
  | { readonly kind: "short"; readonly shortfall: Shortfall }

export interface WindowUsage {
  readonly pcmBytes: number
  readonly ttsChars: number
  readonly sttFinal: boolean
  readonly ttsFinal: boolean
  readonly dispatched: boolean
}

export type SessionEnd = "SessionOver" | "CredentialRefused"

export interface RelaySession {
  readonly openSocket: (sessionId: string) => void!Refused!CloudContext
  readonly tokenMatches: (sessionId: string, token: string) => boolean!Failure!CloudContext
  readonly admitWindow: (sessionId: string, window: number) => WindowAdmission!Failure!CloudContext
  readonly dispatchWindow: (sessionId: string, window: number) => void!Failure!CloudContext
  readonly settleWindow: (sessionId: string, window: number, usage: WindowUsage) => void!Failure!CloudContext
  readonly retire: (sessionId: string) => void!Failure!CloudContext
  readonly ended: (sessionId: string) => SessionEnd!!CloudContext
}

interface SpeechLinks {
  readonly openStt: () => SttLink!Failure!(Scope.Scope | CloudContext)
  readonly openTts: () => TtsLink!Failure!(Scope.Scope | CloudContext)
}

interface RelayPorts {
  readonly session: RelaySession
  readonly links: SpeechLinks
}

type DeviceFrame =
  | { readonly kind: "hello"; readonly token: string; readonly errorReasons: boolean; readonly extend: boolean }
  | { readonly kind: "prepare"; readonly id: string }
  | { readonly kind: "tts"; readonly id: string; readonly text: string; readonly flush: boolean }
  | { readonly kind: "finish"; readonly id: string }
  | { readonly kind: "cancel"; readonly id: string }
  | { readonly kind: "stop" }
  | { readonly kind: "audio"; readonly pcm: Uint8Array }

const windowBudget = {
  pcmBytes: (windowLength / 1000) * relaySampleRate * relayChannels * 2,
  ttsChars: windowTtsChars,
  outputBytes: 8 * 1024 * 1024,
  queuedFrames: 64,
  renewLeadMs: 10_000
} as const

interface Window {
  readonly number: number
  readonly expiresAt: number
  dispatched: boolean
  settled: boolean
  pcmBytes: number
  ttsChars: number
  outputBytes: number
}

interface Shell {
  relay: Relay
  readonly windows: Window[]
  current: number
  refusal: Shortfall | undefined
  stt: SttLink | undefined
  tts: TtsLink | undefined
  readonly transcripts: string[]
  readonly spoken: Set<string>
  ttsUncertain: boolean
  graceful: boolean
  queued: number
  gone: boolean
  renewal: Deferred.Deferred<void> | undefined
  settling: Deferred.Deferred<void> | undefined
}

type Arrival =
  | { readonly kind: "device"; readonly data: string | Uint8Array }
  | { readonly kind: "gone" }
  | { readonly kind: "edge"; readonly input: RelayInput }
  | { readonly kind: "opened" }
  | { readonly kind: "stt"; readonly edge: SttEdge }
  | { readonly kind: "tts"; readonly edge: TtsEdge }
  | { readonly kind: "renewed"; readonly window: Window }
  | { readonly kind: "refusedRenewal"; readonly shortfall: Shortfall }
  | { readonly kind: "deadline"; readonly window: number }

type Arrivals = Queue.Queue<Arrival>

type Sent = "sent" | "unwritable" | "gone"

const providerFailed: Arrival = { kind: "edge", input: { tag: "ProviderFailed" } }
const utf8 = new TextEncoder()
const fromUtf8 = new TextDecoder()

function bytesOf(text: string): number[] {
  return Array.from(utf8.encode(text))
}

function textOf(bytes: ReadonlyArray<number>): string {
  return fromUtf8.decode(Uint8Array.from(bytes))
}

function decodeDeviceFrame(data: string | Uint8Array): DeviceFrame | undefined {
  if (typeof data !== "string") return validUplink(data.byteLength) ? { kind: "audio", pcm: data } : undefined
  const wire = readDevice(bytesOf(data), false)
  switch (wire.kind) {
    case "Hello": return { kind: "hello", token: textOf(wire.token), errorReasons: wire.errorReasons, extend: wire.extend }
    case "Prepare": return { kind: "prepare", id: textOf(wire.id) }
    case "Tts": return { kind: "tts", id: textOf(wire.id), text: textOf(wire.text), flush: wire.flush }
    case "Finish": return { kind: "finish", id: textOf(wire.id) }
    case "Cancel": return { kind: "cancel", id: textOf(wire.id) }
    case "Stop": return { kind: "stop" }
    case "Uplink":
    case "DeviceRefused":
      return undefined
    default: {
      const _exhaustive: never = wire
      return _exhaustive
    }
  }
}

function windowOf(shell: Shell, number: number): Window | undefined {
  return shell.windows.find((window) => window.number === number)
}

function openWindow(number: number, expiresAt: number): Window {
  return { number, expiresAt, dispatched: false, settled: false, pcmBytes: 0, ttsChars: 0, outputBytes: 0 }
}

function iso(at: number): string {
  return new Date(at).toISOString()
}

function wireOf(shell: Shell, frame: ServerFrame, pcm: Uint8Array | undefined): RelayWire | number {
  return match (frame) {
    when { tag: "CloseFrame", let closeCode }: closeCode;
    when { tag: "ReadyFrame" }: { kind: "Ready", expiresAt: bytesOf(iso(windowOf(shell, shell.current)?.expiresAt ?? 0)) };
    when { tag: "ExtendedFrame" }: { kind: "Extended", expiresAt: bytesOf(iso(shell.windows.at(-1)?.expiresAt ?? 0)) };
    when { tag: "SttFrame", let kind }: { kind: "Stt", event: kind, transcript: bytesOf(shell.transcripts.shift() ?? "") };
    when { tag: "PreparedFrame", let id }: { kind: "Prepared", id: bytesOf(id) };
    when { tag: "FlushedFrame", let id }: { kind: "Flushed", id: bytesOf(id) };
    when { tag: "CompleteFrame", let id }: { kind: "Completed", id: bytesOf(id) };
    when { tag: "AudioFrame", let id }: { kind: "Audio", id: bytesOf(id), pcm: Array.from(pcm ?? new Uint8Array()) };
    when { tag: "ErrorFrame", let code, let reason }: { kind: "Failed", code, reason };
  }
}

function encodeWire(wire: RelayWire): string | Uint8Array | undefined {
  const written = writeRelay(wire)
  if (written.kind === "Unwritable") return undefined
  return wire.kind === "Audio" ? Uint8Array.from(written.bytes) : textOf(written.bytes)
}

effect function write(shell: Shell, writer: Socket.Writer, frame: ServerFrame, pcm: Uint8Array | undefined): Sent!! {
  const wire = wireOf(shell, frame, pcm)
  if (typeof wire === "number") {
    writer.write(new Socket.CloseEvent(wire)) catch () => { shell.gone = true }
    return shell.gone ? "gone" : "sent"
  }
  const chunk = encodeWire(wire)
  if (chunk === undefined) return "unwritable"
  writer.write(chunk) catch () => { shell.gone = true }
  return shell.gone ? "gone" : "sent"
}

effect function advance(shell: Shell, writer: Socket.Writer, input: RelayInput, payload: { readonly transcript?: string; readonly pcm?: Uint8Array } = {}) {
  const held = shell.relay.pending.length
  const answer = relayStep(shell.relay, input)
  shell.relay = answer.relay
  if (payload.transcript !== undefined && (answer.frames.some(isSttFrame) || answer.relay.pending.length > held)) {
    shell.transcripts.push(payload.transcript)
  }
  for (const frame of answer.frames) {
    if (frame.tag === "AudioFrame" && payload.pcm !== undefined) {
      const window = windowOf(shell, shell.current)
      if (window !== undefined) window.outputBytes += payload.pcm.length
    }
    const sent = try write(shell, writer, frame, payload.pcm)
    if (sent === "gone") return
    if (sent === "unwritable") {
      try advance(shell, writer, { tag: "ProviderFailed" })
      return
    }
  }
}

function inputOf(frame: DeviceFrame, tokenMatches: boolean): RelayInput {
  switch (frame.kind) {
    case "hello": return { tag: "ClientHello", tokenMatches, errorReasons: frame.errorReasons, extend: frame.extend }
    case "prepare": return { tag: "ClientPrepare", id: frame.id }
    case "tts": return { tag: "ClientSpeak", id: frame.id, flush: frame.flush }
    case "finish": return { tag: "ClientFinish", id: frame.id }
    case "cancel": return { tag: "ClientCancel", id: frame.id }
    case "stop": return { tag: "ClientStop" }
    case "audio": return { tag: "ClientAudio" }
    default: {
      const _exhaustive: never = frame
      return _exhaustive
    }
  }
}

function breaksBudget(shell: Shell, before: Relay, frame: DeviceFrame): boolean {
  const window = windowOf(shell, shell.current)
  if (window === undefined) return false
  if (frame.kind === "tts") return window.ttsChars + frame.text.length > windowBudget.ttsChars
  if (frame.kind === "audio") return acceptsAudio(before) && window.pcmBytes + frame.pcm.length > windowBudget.pcmBytes
  return false
}

effect function deviceEffects(shell: Shell, before: Relay, frame: DeviceFrame): void!Failure {
  const window = windowOf(shell, shell.current)
  const tts = shell.tts
  switch (frame.kind) {
    case "audio":
      if (!acceptsAudio(before) || shell.relay.phase !== "RelayLive" || shell.stt === undefined || window === undefined) return
      window.pcmBytes += frame.pcm.length
      try shell.stt.send(frame.pcm)
      return
    case "tts":
      if (!stageIs(shell.relay, frame.id, "UtteranceOpen") || tts === undefined || window === undefined) return
      window.ttsChars += frame.text.length
      shell.spoken.add(frame.id)
      try tts.speak(frame.id, frame.text, frame.flush)
      return
    case "finish":
      if (stageIs(before, frame.id, "UtteranceOpen") && stageIs(shell.relay, frame.id, "UtteranceFinishing") && tts !== undefined) try tts.finish(frame.id)
      return
    case "cancel":
      if (shell.relay.phase !== "RelayLive" || !speaking(before, frame.id) || tts === undefined) return
      shell.ttsUncertain = true
      try tts.cancel(frame.id)
      return
    case "stop":
      if (before.phase === "RelayLive" && shell.relay.phase === "RelayEnded") shell.graceful = true
      return
    case "hello":
    case "prepare":
      return
    default: {
      const _exhaustive: never = frame
      return _exhaustive
    }
  }
}

effect function deviceFrame(shell: Shell, ports: RelayPorts, sessionId: string, writer: Socket.Writer, data: string | Uint8Array): boolean!!CloudContext {
  const frame = decodeDeviceFrame(data)
  const before = shell.relay
  if (frame === undefined || breaksBudget(shell, before, frame)) {
    try advance(shell, writer, { tag: "ClientViolation" })
    return false
  }
  const tokenMatches = frame.kind === "hello" && before.phase === "RelayAwaitingHello"
    ? ports.session.tokenMatches(sessionId, frame.token) catch () => false
    : false
  try advance(shell, writer, inputOf(frame, tokenMatches))
  deviceEffects(shell, before, frame) catch effect () => {
    try advance(shell, writer, { tag: "ProviderFailed" })
  }
  return before.phase === "RelayAwaitingHello" && shell.relay.phase === "RelayOpening"
}

effect function pump<A>(edges: Stream.Stream<A, Failure>, arrivals: Arrivals, wrap: (edge: A) => Arrival) {
  const pumped = effect {
    for try (const edge of edges) {
      try Queue.offer(arrivals, wrap(edge))
    }
  }
  pumped catch () => undefined
  try Queue.offer(arrivals, providerFailed)
}

effect function openProviders(shell: Shell, ports: RelayPorts, sessionId: string, arrivals: Arrivals) {
  const admission = try ports.session.admitWindow(sessionId, 1)
  if (admission.kind === "short") {
    try Queue.offer(arrivals, { kind: "edge", input: { tag: "FundingRefused", funding: admission.shortfall } })
    return
  }
  const window = openWindow(1, admission.expiresAt)
  shell.windows.push(window)
  shell.current = 1
  const dispatched = effect {
    try ports.session.dispatchWindow(sessionId, 1)
    window.dispatched = true
  }
  const [, stt, tts] = try Effect.all([dispatched, ports.links.openStt(), ports.links.openTts()], { concurrency: "unbounded" })
  shell.stt = stt
  shell.tts = tts
  fork.scoped pump(stt.edges, arrivals, (edge) => ({ kind: "stt", edge }))
  fork.scoped pump(tts.edges, arrivals, (edge) => ({ kind: "tts", edge }))
  try Queue.offer(arrivals, { kind: "opened" })
}

effect function openFirstWindow(shell: Shell, ports: RelayPorts, sessionId: string, arrivals: Arrivals) {
  openProviders(shell, ports, sessionId, arrivals) catch effect (failure) => {
    try annotateLogs(logError("a speech relay could not open its first window"), { sessionId, failure: failure._tag })
    try Queue.offer(arrivals, providerFailed)
  }
}

effect function untilAt(at: number) {
  const now = try Clock.currentTimeMillis
  try sleep(Duration.millis(Math.max(0, at - now)))
}

effect function renew(ports: RelayPorts, sessionId: string, window: Window): Arrival!Failure!CloudContext {
  const admission = try ports.session.admitWindow(sessionId, window.number + 1)
  return match (admission) {
    when { kind: "admitted", let expiresAt }: { kind: "renewed", window: openWindow(window.number + 1, expiresAt) };
    when { kind: "short", let shortfall }: { kind: "refusedRenewal", shortfall };
  }
}

effect function watchWindow(shell: Shell, ports: RelayPorts, sessionId: string, arrivals: Arrivals, window: Window) {
  try untilAt(window.expiresAt - windowBudget.renewLeadMs)
  if (shell.relay.extend && shell.relay.phase === "RelayLive") {
    const renewal = try Deferred.make<void>()
    shell.renewal = renewal
    const outcome = try ensuring(effect {
      const arrival = renew(ports, sessionId, window) catch effect (failure) => {
        try annotateLogs(logError("a speech window could not be renewed"), { sessionId, window: window.number + 1, failure: failure._tag })
        return providerFailed
      }
      if (arrival.kind === "renewed") shell.windows.push(arrival.window)
      return arrival
    }, Deferred.succeed(renewal, undefined))
    try Queue.offer(arrivals, outcome)
  }
  try untilAt(window.expiresAt)
  try Queue.offer(arrivals, { kind: "deadline", window: window.number })
}

effect function settleEnded(shell: Shell, ports: RelayPorts, sessionId: string, window: Window) {
  const previous = shell.settling
  const settling = try Deferred.make<void>()
  shell.settling = settling
  fork.scoped ensuring(effect {
    if (previous !== undefined) try Deferred.await(previous)
    const usage: WindowUsage = { pcmBytes: window.pcmBytes, ttsChars: window.ttsChars, sttFinal: true, ttsFinal: true, dispatched: window.dispatched }
    const settled = (effect {
      try ports.session.settleWindow(sessionId, window.number, usage)
      return true
    }) catch effect (failure) => {
      try annotateLogs(logError("an ended speech window could not be settled"), { sessionId, window: window.number, failure: failure._tag })
      return false
    }
    window.settled = settled
  }, Deferred.succeed(settling, undefined))
}

effect function windowEnds(shell: Shell, ports: RelayPorts, sessionId: string, arrivals: Arrivals, writer: Socket.Writer, number: number) {
  if (number !== shell.current) return
  const next = windowOf(shell, number + 1)
  if (next === undefined) {
    try advance(shell, writer, shell.refusal === undefined ? { tag: "SessionOver" } : { tag: "FundingRefused", funding: shell.refusal })
    return
  }
  const dispatched = (effect {
    try ports.session.dispatchWindow(sessionId, next.number)
    return true
  }) catch () => false
  if (!dispatched) {
    try advance(shell, writer, { tag: "ProviderFailed" })
    return
  }
  next.dispatched = true
  shell.current = next.number
  fork.scoped watchWindow(shell, ports, sessionId, arrivals, next)
  const ended = windowOf(shell, number)
  if (ended !== undefined) try settleEnded(shell, ports, sessionId, ended)
}

effect function ttsEdge(shell: Shell, writer: Socket.Writer, edge: TtsEdge) {
  switch (edge.kind) {
    case "audio":
      for (let offset = 0; offset < edge.pcm.length; offset += maxDownlinkPcmBytes) {
        const slice = edge.pcm.subarray(offset, offset + maxDownlinkPcmBytes)
        const window = windowOf(shell, shell.current)
        const over = window !== undefined && window.outputBytes + slice.length > windowBudget.outputBytes
        try advance(shell, writer, over ? { tag: "ClientViolation" } : { tag: "ProviderAudio", id: edge.id }, { pcm: slice })
      }
      return
    case "flushed":
      try advance(shell, writer, { tag: "ProviderFlushed", id: edge.id })
      return
    case "completed":
      if (stageIs(shell.relay, edge.id, "UtteranceOpen")) shell.ttsUncertain = true
      try advance(shell, writer, { tag: "ProviderCompleted", id: edge.id })
      return
    default: {
      const _exhaustive: never = edge
      return _exhaustive
    }
  }
}

effect function arrive(shell: Shell, ports: RelayPorts, sessionId: string, arrivals: Arrivals, writer: Socket.Writer, arrival: Arrival) {
  switch (arrival.kind) {
    case "device":
      shell.queued -= 1
      if (try deviceFrame(shell, ports, sessionId, writer, arrival.data)) {
        fork.scoped openFirstWindow(shell, ports, sessionId, arrivals)
      }
      return
    case "gone":
      shell.gone = true
      return
    case "edge":
      try advance(shell, writer, arrival.input)
      return
    case "opened": {
      const first = windowOf(shell, 1)
      if (first !== undefined) fork.scoped watchWindow(shell, ports, sessionId, arrivals, first)
      try advance(shell, writer, { tag: "Admitted" })
      return
    }
    case "stt":
      try advance(shell, writer, { tag: "ProviderStt", kind: arrival.edge.kind, transcriptChars: arrival.edge.transcript.length }, { transcript: arrival.edge.transcript })
      return
    case "tts":
      try ttsEdge(shell, writer, arrival.edge)
      return
    case "renewed":
      try advance(shell, writer, { tag: "WindowRenewed" })
      return
    case "refusedRenewal":
      shell.refusal = arrival.shortfall
      return
    case "deadline":
      try windowEnds(shell, ports, sessionId, arrivals, writer, arrival.window)
      return
    default: {
      const _exhaustive: never = arrival
      return _exhaustive
    }
  }
}

effect function readDeviceFrames(reader: Socket.Reader, shell: Shell, arrivals: Arrivals) {
  while (true) {
    const chunk = reader.pull catch () => undefined
    if (chunk === undefined) {
      try Queue.offer(arrivals, { kind: "gone" })
      return
    }
    for (const data of chunk) {
      shell.queued += 1
      if (shell.queued > windowBudget.queuedFrames) {
        try Queue.offer(arrivals, { kind: "edge", input: { tag: "ClientViolation" } })
        return
      }
      try Queue.offer(arrivals, { kind: "device", data })
    }
  }
}

effect function settleAll(shell: Shell, ports: RelayPorts, sessionId: string) {
  const stt = shell.stt
  const drained = shell.graceful && stt !== undefined ? try stt.drain() : false
  const forwarded = shell.windows.reduce((sum, window) => sum + window.pcmBytes, 0)
  const sttFinal = shell.graceful && (forwarded === 0 || drained)
  const ttsFinal = shell.graceful && !shell.ttsUncertain && shell.relay.utterances.every((utterance) => utterance.stage === "UtteranceDone" || !shell.spoken.has(utterance.id))
  ports.session.retire(sessionId) catch effect (failure) => {
    try annotateLogs(logError("a speech session could not be retired"), { sessionId, failure: failure._tag })
  }
  const renewal = shell.renewal
  if (renewal !== undefined) try Deferred.await(renewal)
  const settling = shell.settling
  if (settling !== undefined) try Deferred.await(settling)
  for (const window of shell.windows) {
    if (window.settled) continue
    const usage: WindowUsage = { pcmBytes: window.pcmBytes, ttsChars: window.ttsChars, sttFinal, ttsFinal, dispatched: window.dispatched }
    ports.session.settleWindow(sessionId, window.number, usage) catch effect (failure) => {
      try annotateLogs(logError("a speech window could not be settled"), { sessionId, window: window.number, failure: failure._tag })
    }
  }
}

effect function serve(ports: RelayPorts, sessionId: string, socket: Socket.Socket) {
  const shell: Shell = {
    relay: relayAtUpgrade, windows: [], current: 0, refusal: undefined, stt: undefined, tts: undefined,
    transcripts: [], spoken: new Set(), ttsUncertain: false, graceful: false, queued: 0, gone: false, renewal: undefined, settling: undefined
  }
  const session = effect {
    const reader = try socket.reader
    const writer = try socket.writer
    const arrivals = try Queue.unbounded<Arrival>()
    fork.scoped readDeviceFrames(reader, shell, arrivals)
    fork.scoped (effect {
      try sleep(Duration.millis(helloDeadline))
      try Queue.offer(arrivals, { kind: "edge", input: { tag: "HelloTimedOut" } })
    })
    fork.scoped (effect {
      const end = try ports.session.ended(sessionId)
      try Queue.offer(arrivals, { kind: "edge", input: { tag: end } })
    })
    while (shell.relay.phase !== "RelayEnded" && !shell.gone) {
      const arrival = try Queue.take(arrivals)
      try arrive(shell, ports, sessionId, arrivals, writer, arrival)
    }
  }
  try ensuring(Effect.ignore(session), settleAll(shell, ports, sessionId))
}

effect function relay(ports: RelayPorts, context: RouteContext): HttpServerResponse.HttpServerResponse!Refused!CloudContext {
  const sessionId = context.query.get("sessionId") ?? ""
  if (sessionId === "" || (context.request.headers.upgrade ?? "").toLowerCase() !== "websocket") throw refused("InvalidRequest")
  try ports.session.openSocket(sessionId)
  const socket = context.request.upgrade catch effect () => {
    ports.session.retire(sessionId) catch () => undefined
    throw refused("InvalidRequest")
  }
  try scoped(serve(ports, sessionId, socket))
  return HttpServerResponse.empty()
}

function relayRoutes(ports: RelayPorts): ReadonlyArray<Route> {
  return [{ method: "GET", path: "/api/v1/voice/speech/ws", auth: "Public", area: "SpeechRelayRoutes", handler: (context) => relay(ports, context) }]
}

export const relaySpeechRoutes: ReadonlyArray<Route> = relayRoutes({ session: relaySession, links: { openStt, openTts } })
