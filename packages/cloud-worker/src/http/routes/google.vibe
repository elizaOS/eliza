// spec/cloud/services/google/connection.md, "Story: See my Google connection as the cloud holds it"; spec/cloud/services/google/connection.md, "Story: Disconnect it"; spec/cloud/services/google/connection.md, "Story: Connect my Google account with the access I chose"
import { refuse, refuseFor, statusOf, type Refusal } from "../../../gen/cloud__shared__types.effect.vibe"
import { json, jsonBody, owner, type Area, type RouteContext } from "../routes.vibe"
import { refusalBody, refused } from "../refusal.vibe"
import { signed } from "../request-auth.vibe"
import { disconnectGrant, readGrantAccounts, readGrantStatus } from "../../services/google/grant-access.vibe"
import { GoogleSubject, linkAuthorizedGoogle, ServerAuthCode, type GoogleLinkFault } from "../../services/google/managed-grants.vibe"
import { browserConnectRoutes, browserConnectSweep } from "../../services/google/managed-browser.vibe"
import { mailHistoryRoutes } from "../../services/google/mail-history.vibe"
import { mailReadRoutes } from "../../services/google/mail-read.vibe"
import { calendarRoutes, calendarSweeps } from "../../services/google/calendar.vibe"
import { mailOperationRoutes, mailOperationSweeps } from "../../services/google/mail-operations.vibe"

effect function status(context: RouteContext) {
  const caller = owner(context.caller)
  if (caller === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  if (context.query.has("purpose")) throw refused("InvalidRequest")
  const grantId = context.query.get("grantId")?.trim() || undefined
  return json({ accountId: caller.userId, ...try readGrantStatus(caller, grantId, context.query.get("side"), context.now) })
}

effect function accounts(context: RouteContext) {
  const caller = owner(context.caller)
  if (caller === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return json(try readGrantAccounts(caller, context.query.get("side"), context.now))
}

const grantName = Schema.String.check(Schema.isMinLength(1), Schema.isTrimmed())
const disconnectBody = Schema.fromJsonString(Schema.Struct({
  side: Schema.optionalKey(Schema.String),
  connectionId: Schema.optionalKey(Schema.NullOr(grantName)),
  grantId: Schema.optionalKey(Schema.NullOr(grantName))
}))

effect function disconnect(context: RouteContext) {
  const caller = owner(context.caller)
  if (caller === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const raw = context.request.text catch effect () => { throw refused("InvalidRequest") }
  const { side, connectionId, grantId } = Schema.decodeUnknownEffect(disconnectBody, { onExcessProperty: "error" })(raw.trim() === "" ? "{}" : raw) catch effect () => { throw refused("InvalidRequest") }
  if (connectionId != null && grantId != null && connectionId !== grantId) throw refused("InvalidRequest")
  try disconnectGrant(caller, connectionId ?? grantId ?? undefined, side ?? null)
  return json({ ok: true })
}

const nativeBody = Schema.Struct({ serverAuthCode: ServerAuthCode, expectedGoogleSubject: Schema.optionalKey(GoogleSubject) })

const nativeFaults = {
  google_not_configured: refuseFor("ProviderUnavailable", "GoogleNotConfigured"),
  google_code_rejected: refuse("InvalidRequest"),
  google_scopes_missing: refuse("InvalidRequest"),
  google_account_mismatch: refuse("InvalidRequest"),
  google_reconnect_required: refuse("GoogleReauthRequired"),
  google_unavailable: refuse("ProviderUnavailable")
} satisfies Readonly<Record<GoogleLinkFault, Refusal>>

effect function connectNative(context: RouteContext) {
  const caller = signed(context.caller)
  if (caller === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const body = try jsonBody(context, nativeBody)
  const linked = try linkAuthorizedGoogle(caller, body.serverAuthCode, body.expectedGoogleSubject)
  if (linked.connected) return json(linked)
  const refusal = nativeFaults[linked.code]
  return json({ ...refusalBody(refusal), code: linked.code }, { status: statusOf(refusal.code) })
}

const googlePath = "/api/v1/eliza/google"

export const area: Area = {
  routes: [
    { method: "GET", path: `${googlePath}/status`, auth: "MailAccess", handler: status },
    { method: "GET", path: `${googlePath}/accounts`, auth: "MailAccess", handler: accounts },
    { method: "POST", path: `${googlePath}/disconnect`, auth: "SignedSession", handler: disconnect },
    { method: "POST", path: `${googlePath}/connect/native`, auth: "ServiceAccess", maxBodyBytes: 16 * 1024, handler: connectNative },
    ...browserConnectRoutes,
    ...mailReadRoutes,
    ...mailHistoryRoutes,
    ...calendarRoutes,
    ...mailOperationRoutes
  ],
  sweeps: [
    browserConnectSweep,
    ...calendarSweeps,
    ...mailOperationSweeps
  ]
}
