// spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile"
import { listening } from "./node-listener.vibe"
import { respond as respondWithFallback } from "./transport.vibe"
import type { Area, CloudContext, Route, Sweep } from "./routes.vibe"
import { area as foundation } from "./routes/foundation.vibe"
import { area as identity } from "./routes/identity.vibe"
import { area as nativeClients } from "./routes/native-clients.vibe"
import { area as checkout } from "./routes/checkout.vibe"
import { area as providerEvents } from "./routes/provider-events.vibe"
import { area as billing } from "./routes/billing.vibe"
import { area as inference } from "./routes/inference.vibe"
import { area as speech } from "./routes/speech.vibe"
import { area as maps } from "./routes/maps.vibe"
import { area as google } from "./routes/google.vibe"
import { area as operator } from "./routes/operator.vibe"
import { returnPageRoute } from "../native-clients/return-routes.vibe"

export { listening }

export const areas: ReadonlyArray<Area> = [foundation, identity, nativeClients, checkout, providerEvents, billing, inference, speech, maps, google, operator]

export function respond(routes: ReadonlyArray<Route>) {
  return respondWithFallback(routes, returnPageRoute)
}

export function cloudServer(served: ReadonlyArray<Area> = areas) {
  return HttpServer.serve(respond(served.flatMap((each) => each.routes)))
}

effect function runSweep(sweep: Sweep): void!!CloudContext {
  try repeat(sweep.run, Schedule.spaced(Duration.millis(sweep.everyMs)))
}

export function sweepsLayer(served: ReadonlyArray<Area> = areas): Layer.Layer<never, never, CloudContext> {
  return Layer.effectDiscard(effect {
    for (const sweep of served.flatMap((each) => each.sweeps)) {
      fork.scoped runSweep(sweep)
    }
  })
}
