// spec/cloud/nativeClients/deviceKeys.md, "An older active key keeps its recorded expiry, while a pending grant without its original binding must restart"; spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device in and keep its key"
import { ackAnswer, apply, authorityExpiry, authorityRefusal, decodeState, initial, keyRefusal, legacyBinding, legacyGrant, NotAState, type Rejected, type Event, type Grant, type GrantClient, type GrantStep, type KeyAuthority, type LegacyGrantPhase, type RecordedKeyPhase } from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import { loadRow, outputRows, stepRow, type Columns } from "../store/rows.vibe"
import type { Row, Tx } from "../store/connection.vibe"

const NonEmpty = Schema.String.check(Schema.isMinLength(1))
const Return = Schema.Struct({ origin: NonEmpty, path: NonEmpty })
const Client = Schema.Struct({ clientId: NonEmpty, environment: Schema.Literals(["Production", "Staging"]), signInReturn: Return })
const BoundClient = Schema.Struct({ tag: Schema.Literal("BoundClient"), ...Client.fields })
const OldState = Schema.Struct({
  credentialTtl: Schema.optionalKey(Schema.Unknown),
  clientId: Schema.optionalKey(Schema.Unknown),
  environment: Schema.optionalKey(Schema.Unknown),
  signInReturn: Schema.optionalKey(Schema.Unknown),
  client: Schema.optionalKey(Schema.Unknown)
})
const Legacy = Schema.Struct({ legacyDeviceGrant: Schema.Struct({
  state: Schema.Unknown,
  phase: Schema.Literals(["code_issued", "exchanged", "active", "expired", "ended"]),
  clientId: Schema.String,
  credentialId: Schema.String,
  codeExpiresAt: Schema.Int,
  keyExpiresAt: Schema.Int,
  epoch: Schema.Int,
  observedAt: Schema.Int
}) })
const phases: Readonly<Record<(typeof Legacy.Type)["legacyDeviceGrant"]["phase"], LegacyGrantPhase>> = {
  code_issued: "OldCodeIssued", exchanged: "OldExchanged", active: "OldActive", expired: "OldExpired", ended: "OldEnded"
}

export effect function decodeGrant(input: unknown): Grant!NotAState {
  const old = Option.getOrUndefined(Schema.decodeUnknownOption(Legacy)(input))?.legacyDeviceGrant
  if (old === undefined) return try decodeState(input)
  const stored = Option.getOrUndefined(Schema.decodeUnknownOption(OldState)(old.state))
  const nested = Option.getOrUndefined(Schema.decodeUnknownOption(BoundClient)(stored?.client))
  const flat = Option.getOrUndefined(Schema.decodeUnknownOption(Client)(stored))
  const flatClient: GrantClient = flat === undefined ? { tag: "UnrecordedClient" } : { tag: "BoundClient", ...flat }
  const nestedClient: GrantClient = nested === undefined ? { tag: "UnrecordedClient" } : nested
  const client = legacyBinding({ rowClientId: old.clientId, flat: flatClient, nested: nestedClient })
  const credentialTtl = Option.getOrUndefined(Schema.decodeUnknownOption(Schema.Int)(stored?.credentialTtl)) ?? 0
  return try decodeState(legacyGrant({
    phase: phases[old.phase], client, codeExpiresAt: old.codeExpiresAt, credentialTtl,
    credentialId: old.credentialId, keyExpiresAt: old.keyExpiresAt, epoch: old.epoch, now: old.observedAt
  }))
}

const Integer = Schema.Union([Schema.Int, Schema.NumberFromString.check(Schema.isInt())])
const KeyRow = Schema.Struct({
  state: Schema.Unknown,
  phase: Schema.Literals(["code_issued", "exchanged", "active", "expired", "ended"]),
  key_expires_at: Integer,
  grant_epoch: Integer,
  account_epoch: Integer
})
const Flat = Schema.Struct({ flatDeviceGrant: Schema.Literal("FlatTokenStarted") })
const recordedPhases: Readonly<Record<typeof KeyRow.Type.phase, RecordedKeyPhase>> = {
  code_issued: "RecordedPending", exchanged: "RecordedPending", active: "RecordedActive", expired: "RecordedExpired", ended: "RecordedRevoked"
}

export function isFlatGrant(input: unknown): boolean {
  return Option.isSome(Schema.decodeUnknownOption(Flat)(input))
}

effect function authorityOf(parsed: typeof KeyRow.Type): KeyAuthority!NotAState {
  const legacy = Option.getOrUndefined(Schema.decodeUnknownOption(Legacy)(parsed.state))?.legacyDeviceGrant
  if (isFlatGrant(parsed.state) || (legacy?.phase === "active" && legacy.keyExpiresAt === parsed.key_expires_at && legacy.epoch === parsed.grant_epoch)) {
    return { tag: "RecordedAuthority", key: { phase: recordedPhases[parsed.phase], lifetime: { epoch: parsed.grant_epoch, keyExpiresAt: parsed.key_expires_at } } }
  }
  return { tag: "GrantAuthority", grant: try decodeGrant(parsed.state) }
}

export effect function inspectKey(row: Row, now: number) {
  const parsed = Option.getOrUndefined(Schema.decodeUnknownOption(KeyRow)(row))
  if (parsed === undefined) throw new NotAState({ input: row })
  const authority = try authorityOf(parsed)
  return { authority, reason: authorityRefusal(authority, now, parsed.account_epoch), expiresAt: authorityExpiry(authority) }
}

export effect function currentGrant(grant: Grant, now: number): Grant!Rejected {
  return now > grant.now ? (try apply(grant, { type: "elapse", elapsed: now - grant.now })).state : grant
}

effect function applyAt(grant: Grant, event: Event): GrantStep!Rejected {
  const now = try Clock.currentTimeMillis
  return try apply(try currentGrant(grant, now), event)
}

const grants = outputRows("device_grants", { initial, decodeState: decodeGrant, apply: applyAt })

export effect function observeGrant(tx: Tx, key: string) {
  const loaded = try loadRow(tx, grants, key, false)
  return try currentGrant(loaded.state, try Clock.currentTimeMillis)
}

export effect function stepGrant(tx: Tx, key: string, event: Event, columns: (grant: Grant) => Columns) {
  return try stepRow(tx, grants, key, event, columns)
}

export effect function endKey(tx: Tx, row: Row, now: number) {
  const key = try inspectKey(row, now)
  if (key.reason !== "NoReason") return key.reason
  if (key.authority.tag === "GrantAuthority") {
    const parsed = Option.getOrUndefined(Schema.decodeUnknownOption(KeyRow)(row))
    if (parsed === undefined) throw new NotAState({ input: row })
    const identity = Option.getOrUndefined(Schema.decodeUnknownOption(NonEmpty)(row.key))
    if (identity === undefined) throw new NotAState({ input: row })
    const ended = stepGrant(tx, identity, { type: "selfRevoke", deviceEpoch: parsed.account_epoch }, (grant) => ({ phase: phaseColumn(grant), sealed_copy: null, updated_at: grant.now })) catch effect (failure) => {
      if (failure._tag !== "Rejected") throw failure
      const reason = keyRefusal(failure.state, failure.state.now, parsed.account_epoch)
      if (reason === "NoReason") throw failure
      return reason
    }
    if (typeof ended === "string") return ended
  } else {
    try tx.query("UPDATE device_grants SET phase = 'ended', state = state || jsonb_build_object('endedBy', 'SelfRevoked'), sealed_copy = NULL, revision = revision + 1, updated_at = $2 WHERE key = $1", [row.key, now])
  }
  return "NoReason" as const
}

effect function endByLease(tx: Tx, key: string, event: { readonly type: "endForLeaseTheft" | "supersede" }) {
  const row = (try tx.query("SELECT key, state FROM device_grants WHERE key = $1 FOR UPDATE", [key]))[0]
  if (row === undefined) return false
  if (isFlatGrant(row.state)) {
    const endedBy = event.type === "supersede" ? "Superseded" : "LeaseReused"
    const ended = try tx.query("UPDATE device_grants SET phase = 'ended', state = state || jsonb_build_object('endedBy', $2::text), sealed_copy = NULL, revision = revision + 1, updated_at = $3 WHERE key = $1 AND phase IN ('active', 'expired') RETURNING key", [key, endedBy, try Clock.currentTimeMillis])
    return ended.length === 1
  }
  const stepped = stepGrant(tx, key, event, (grant) => ({ phase: phaseColumn(grant), sealed_copy: null, sealed_lease: null, updated_at: grant.now })) catch effect (failure) => {
    if (failure._tag !== "Rejected") throw failure
    return undefined
  }
  return stepped !== undefined
}

export effect function cancelLegacySuccessor(tx: Tx, key: string) {
  const row = (try tx.query("SELECT sign_in_at FROM device_grants WHERE key = $1 FOR UPDATE", [key]))[0]
  const legacy = row?.sign_in_at !== undefined && row.sign_in_at !== null
  return try stepGrant(tx, key, { type: "cancelLegacySuccessor", legacy },
    (grant) => ({ phase: phaseColumn(grant), sealed_copy: null, sealed_lease: null, updated_at: grant.now }))
}

export effect function endGrantForLeaseTheft(tx: Tx, key: string) {
  return try endByLease(tx, key, { type: "endForLeaseTheft" })
}

export effect function supersedeGrant(tx: Tx, key: string) {
  return try endByLease(tx, key, { type: "supersede" })
}

export function phaseColumn(grant: Grant): string {
  return match (grant.phase.tag) {
    when "Unissued": "ended";
    when "CodeIssued": "code_issued";
    when "Exchanged": "exchanged";
    when "Active": "active";
    when "LegacyActive": "active";
    when "Expired": "expired";
    when "Ended": "ended";
  }
}

export function keyExpiresAt(grant: Grant): number {
  return ackAnswer(grant).expiresAt
}
