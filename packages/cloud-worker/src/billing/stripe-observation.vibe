// spec/cloud/billing/subscriptions.md, "Story: Keep my plan as the provider says it is"; spec/cloud/billing/allowance.md, "Story: Spend my plan's allowance before my credits, and never carry it over"
import Stripe from "stripe"
import { workerFetch } from "../worker-platform.ts"
import { amountCentsOf } from "../../gen/cloud__billing__plans.effect.vibe"
import type { Payment, SubscriptionObservation } from "./stripe-ledger.vibe"

export type StripeCatalog = {
  STRIPE_PRICE_ID: string
  STRIPE_PRODUCT_ID: string
  STRIPE_PLAN: "plus_monthly" | "pro_monthly"
  CLOUD_ENVIRONMENT: "staging" | "production"
}

export function stripeClient(secret: string, apiUrl?: string) {
  const base = apiUrl === undefined ? undefined : new URL(apiUrl)
  const client = Stripe.createFetchHttpClient(base === undefined ? undefined : (path, options) => {
    const url = new URL(typeof path === "string" ? path : path instanceof URL ? path.href : path.url)
    return workerFetch(`${base.origin}${base.pathname.replace(/\/$/, "")}${url.pathname}${url.search}`, { ...options, redirect: "manual" })
  })
  return new Stripe(secret, { httpClient: client, maxNetworkRetries: 1, timeout: 6000 })
}

function resourceId(value: string | { id: string } | null | undefined) {
  return typeof value === "string" ? value : value?.id
}

type VerifiedPayment = { payment: Payment; chargeIds: string[] }

async function paidWindow(stripe: Stripe, priceId: string, customer: string, invoice: Stripe.Invoice, item: Stripe.SubscriptionItem): Promise<VerifiedPayment | undefined> {
  const invoiceId = invoice.id
  if (!invoiceId || invoice.status !== "paid" || invoice.amount_paid <= 0 || invoice.currency !== "usd" ||
      (invoice.billing_reason !== "subscription_create" && invoice.billing_reason !== "subscription_cycle")) return undefined
  const line = invoice.lines.data.find((line) => resourceId(line.pricing?.price_details?.price) === priceId &&
    line.parent?.subscription_item_details?.subscription_item === item.id && !line.parent.subscription_item_details.proration && line.quantity === 1)
  if (!line || line.period.end !== item.current_period_end || line.period.start !== item.current_period_start) return undefined
  let condition: Payment["condition"] = "paid"
  let received = 0
  const charges = new Set<string>()
  for await (const payment of stripe.invoicePayments.list({invoice: invoiceId, status:"paid", limit:100})) {
    if (!payment.amount_paid || payment.amount_paid < 1) continue
    const detail = payment.payment
    let chargeId = resourceId(detail.charge)
    if (detail.type === "payment_intent" && detail.payment_intent) {
      const intentId = resourceId(detail.payment_intent)
      if (!intentId) continue
      const intent = await stripe.paymentIntents.retrieve(intentId)
      chargeId = resourceId(intent.latest_charge)
    }
    if (!chargeId) continue
    const charge = await stripe.charges.retrieve(chargeId)
    if (charge.id !== chargeId || charge.livemode !== invoice.livemode || resourceId(charge.customer) !== customer ||
        !charge.paid || !charge.captured || charge.currency !== "usd") continue
    charges.add(charge.id)
    received += payment.amount_paid
    if (charge.amount_refunded > 0) condition = "refunded"
    else if (charge.disputed && condition !== "refunded") {
      for await (const dispute of stripe.disputes.list({charge: charge.id, limit:100})) {
        if (dispute.status !== "won" && dispute.status !== "warning_closed") condition = "disputed"
      }
    }
  }
  if (received < invoice.amount_paid) return undefined
  return { payment: { id: invoice.id, startsAt: line.period.start * 1000, endsAt: line.period.end * 1000, condition }, chargeIds: [...charges].sort() }
}

export async function readStripeSubscription(stripe: Stripe, env: StripeCatalog, customer: string) {
  return observeCatalog(stripe, [env], customer, env.STRIPE_PRICE_ID)
}

export async function readStripeSubscriptionFromCatalog(stripe: Stripe, catalog: readonly [StripeCatalog, ...StripeCatalog[]], customer: string) {
  return observeCatalog(stripe, catalog, customer)
}

async function observeCatalog(stripe: Stripe, catalog: readonly [StripeCatalog, ...StripeCatalog[]], customer: string, price?: string) {
  const live = catalog[0].CLOUD_ENVIRONMENT === "production"
  let last: Stripe.Subscription | undefined
  let current: Stripe.Subscription | undefined
  for await (const subscription of stripe.subscriptions.list({ customer, ...(price === undefined ? {} : { price }), status:"all", limit:100 })) {
    if (resourceId(subscription.customer) !== customer || subscription.livemode !== live) throw new Error("Unexpected subscription owner or environment")
    if (!last || last.created < subscription.created) last = subscription
    if (subscription.status === "canceled" || subscription.status === "incomplete_expired") continue
    if (current) throw new Error("Multiple current subscriptions for this customer")
    current = subscription
  }
  const subscription = current ?? last
  const item = subscription?.items.data[0]
  const env = catalog.find((entry) => entry.STRIPE_PRICE_ID === item?.price.id)
  if (subscription && (!item || !env || item.quantity !== 1 || subscription.items.has_more || subscription.items.data.length !== 1)) throw new Error("Unexpected subscription items")
  let chargeIds: string[] = []
  let observation: SubscriptionObservation = {customerId:customer, subscriptionId:null, plan:"free", status:"none", startsAt:0, endsAt:0, cancelAtPeriodEnd:false, latestInvoice:"PeriodInvoiceOpen"}
  if (subscription && item && env) {
    if (!await catalogMatches(stripe, env, false)) throw new Error("Unexpected subscription catalog terms")
    const states = {active:"active", canceled:"canceled", incomplete:"incomplete", incomplete_expired:"incomplete_expired", past_due:"past_due", unpaid:"unpaid", trialing:"incomplete", paused:"incomplete"} as const
    const status = Object.entries(states).find(([name]) => name === subscription.status)?.[1]
    if (!status) throw new Error("Unknown subscription status")
    const invoiceId = resourceId(subscription.latest_invoice)
    const invoice = status === "active" && invoiceId ? await stripe.invoices.retrieve(invoiceId) : undefined
    if (invoice && (invoice.id !== invoiceId || invoice.livemode !== subscription.livemode || resourceId(invoice.customer) !== customer ||
        resourceId(invoice.parent?.subscription_details?.subscription) !== subscription.id)) throw new Error("Unexpected subscription invoice")
    const reason = invoice?.billing_reason
    if (invoice && reason !== "subscription_update" && reason !== "subscription_create" && reason !== "subscription_cycle")
      throw new Error("Unexpected subscription invoice reason")
    const verified = invoice && reason !== "subscription_update" ? await paidWindow(stripe, env.STRIPE_PRICE_ID, customer, invoice, item) : undefined
    const payment = verified?.payment
    chargeIds = verified?.chargeIds ?? []
    const failed = status === "past_due" || status === "unpaid" || invoice?.status === "uncollectible" ||
      (invoice?.status === "open" && invoice.attempted && invoice.attempt_count > 0)
    observation = { customerId:customer, subscriptionId:subscription.id, plan:env.STRIPE_PLAN, status, startsAt:item.current_period_start * 1000, endsAt:item.current_period_end * 1000,
      cancelAtPeriodEnd:subscription.cancel_at_period_end, latestInvoice: reason === "subscription_update" ? "PlanChangeInvoice" : payment?.condition === "paid" ? "PeriodInvoicePaid" : failed ? "PeriodInvoiceFailed" : "PeriodInvoiceOpen", payment }
  }
  return { observation, chargeIds, ongoing: Boolean(current) }
}

async function catalogMatches(stripe: Stripe, env: StripeCatalog, forSale: boolean) {
  if (env.STRIPE_PLAN !== "plus_monthly" && env.STRIPE_PLAN !== "pro_monthly") return false
  const plan = env.STRIPE_PLAN === "plus_monthly" ? "PlusMonthly" : "ProMonthly"
  const price = await stripe.prices.retrieve(env.STRIPE_PRICE_ID, { expand: ["product"] })
  const product = price.product
  return typeof product === "object" && !product.deleted && product.id === env.STRIPE_PRODUCT_ID &&
    (!forSale || (product.active && price.active)) && price.livemode === (env.CLOUD_ENVIRONMENT === "production") &&
    product.livemode === price.livemode && price.type === "recurring" && price.currency === "usd" &&
    price.unit_amount === amountCentsOf(plan) && price.billing_scheme === "per_unit" && price.transform_quantity === null &&
    price.recurring?.interval === "month" && price.recurring.interval_count === 1 && price.recurring.usage_type === "licensed" &&
    price.recurring.trial_period_days === null
}
