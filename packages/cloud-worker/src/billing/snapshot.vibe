// spec/cloud/billing/subscriptions.md, "Story: Keep my plan as the provider says it is"; spec/cloud/billing/subscriptions.md, "Story: Change my plan one command at a time"; spec/cloud/billing/plans.md, "Story: Apply the plan that funds a call"
import { controlOf, dunningEndsAt, type ControlAction, type Subscription } from "../../gen/cloud__billing__subscriptions.effect.vibe"
import type { FundingLane } from "../../gen/cloud__shared__metering.effect.vibe"
import { json, owner, type Route } from "../http/routes.vibe"
import { refused, wireName } from "../http/refusal.vibe"
import { allowanceStatus, periodRows, type WireAllowanceState } from "../shared/metering.vibe"
import { loadRow, type RowCorrupt } from "../store/rows.vibe"
import { Store, type StoreFailure, toInt, toText, type Tx } from "../store/connection.vibe"
import { fundsRows } from "./funds.vibe"
import { readSubscription } from "./subscriptions.vibe"
import { parsePlanKey, wirePlanKey, type PaidPlanKey, type WirePlanKey } from "./plans.vibe"
import { fundingOf, planSummary, readPolicy, type PolicyUnreadable, type FundingClass, type PlanSource } from "./policy.vibe"

export type AccountStatus = "active" | "deleting" | "erased"
export type WireSubscriptionStatus = "pending" | "incomplete" | "active" | "dunning" | "past_due" | "unpaid" | "canceled" | "incomplete_expired"
export type WireControlAction = "cancel" | "undo" | "none"
export type { WireAllowanceState }
export type WireFundingLane = "allowanceThenCredits" | "creditsOnly" | "refused"

export interface SnapshotSubscription {
  readonly id: string
  readonly planKey: WirePlanKey
  readonly status: WireSubscriptionStatus
  readonly periodStart: number
  readonly periodEnd: number
  readonly cancelAtPeriodEnd: boolean
  readonly pendingPlanKey: WirePlanKey | null
  readonly dunningEndsAt: number | null
  readonly revision: number
  readonly control: { readonly action: WireControlAction; readonly eligible: boolean; readonly expectedSubscriptionRevision: number }
}

export interface SnapshotGrant {
  readonly id: string
  readonly planKey: PaidPlanKey
  readonly family: string
  readonly effectiveFrom: number
  readonly effectiveUntil: number | null
  readonly revoked: boolean
}

export interface SnapshotAllowance {
  readonly state: WireAllowanceState
  readonly granted: number
  readonly adjustment: number
  readonly available: number
  readonly reserved: number
  readonly settled: number
  readonly expired: number
  readonly clawedBack: number
  readonly periodStart: number
  readonly resetsAt: number
}

export interface BillingSnapshot {
  readonly schemaVersion: 3
  readonly observedAt: number
  readonly account: { readonly status: AccountStatus }
  readonly balance: { readonly usdMicros: number; readonly revision: number }
  readonly plan: { readonly key: WirePlanKey; readonly source: PlanSource; readonly effectiveUntil: number | null }
  readonly subscription: SnapshotSubscription | null
  readonly grant: SnapshotGrant | null
  readonly allowance: SnapshotAllowance | null
  readonly funding: Readonly<Record<FundingClass, WireFundingLane>>
}

error SnapshotUnreadable { organizationId: string; problem: string }

const accountStatuses: ReadonlyArray<AccountStatus> = ["active", "deleting", "erased"]

const controlActions: Readonly<Record<ControlAction, WireControlAction>> = { CancelAction: "cancel", UndoAction: "undo", NoAction: "none" }

const fundingLanes: Readonly<Record<FundingLane, WireFundingLane>> = { AllowanceThenCredits: "allowanceThenCredits", CreditsOnly: "creditsOnly", Refused: "refused" }

function subscriptionView(subscription: Subscription): SnapshotSubscription | null {
  if (subscription.status === "NoSubscription") return null
  const control = controlOf(subscription)
  const planned = subscription.planned
  const dunningEnd = dunningEndsAt(subscription.dunning)
  return {
    id: subscription.subscriptionId,
    planKey: wirePlanKey(subscription.planKey),
    status: wireName(subscription.status) as WireSubscriptionStatus,
    periodStart: subscription.periodStart,
    periodEnd: subscription.periodEnd,
    cancelAtPeriodEnd: subscription.cancelAtPeriodEnd,
    pendingPlanKey: planned.tag === "DowngradeAtRenewal" ? wirePlanKey(planned.planKey) : null,
    dunningEndsAt: dunningEnd > 0 ? dunningEnd : null,
    revision: subscription.revision,
    control: { action: controlActions[control.offer], eligible: control.eligible, expectedSubscriptionRevision: control.expectedRevision }
  }
}

effect function grantView(tx: Tx, organizationId: string, now: number): (SnapshotGrant | null)!(StoreFailure | SnapshotUnreadable) {
  const row = (try tx.query(
    "SELECT id, family, plan_key, effective_from, effective_until, revoked FROM grants WHERE organization_id = $1 ORDER BY (NOT revoked AND effective_from <= $2 AND (effective_until IS NULL OR effective_until > $2)) DESC, created_at DESC, id LIMIT 1",
    [organizationId, now]
  ))[0]
  if (row === undefined) return null
  const planKey = parsePlanKey(row.plan_key)
  const id = toText(row.id)
  const family = toText(row.family)
  const paidKey = planKey === undefined ? undefined : wirePlanKey(planKey)
  if (paidKey === undefined || paidKey === "free" || id === undefined || family === undefined) throw new SnapshotUnreadable({ organizationId, problem: "grant row" })
  return {
    id,
    planKey: paidKey,
    family,
    effectiveFrom: toInt(row.effective_from),
    effectiveUntil: row.effective_until === null ? null : toInt(row.effective_until),
    revoked: row.revoked === true
  }
}

effect function allowanceView(tx: Tx, organizationId: string, now: number): (SnapshotAllowance | null)!(StoreFailure | RowCorrupt | SnapshotUnreadable) {
  const row = (try tx.query(
    "SELECT key FROM allowance_periods WHERE organization_id = $1 ORDER BY (status = 'open' AND period_start <= $2 AND $2 < period_end) DESC, period_end DESC, key LIMIT 1",
    [organizationId, now]
  ))[0]
  const key = toText(row?.key)
  if (key === undefined) return null
  const period = (try loadRow(tx, periodRows, key, false)).state
  const state = allowanceStatus(period.phase)
  if (state === null) throw new SnapshotUnreadable({ organizationId, problem: "allowance period" })
  return {
    state,
    granted: period.granted,
    adjustment: period.adjustment,
    available: period.available,
    reserved: period.reserved,
    settled: period.settled,
    expired: period.expired,
    clawedBack: period.clawedBack,
    periodStart: period.startsAt,
    resetsAt: period.endsAt
  }
}

effect function readSnapshot(tx: Tx, caller: { readonly userId: string; readonly organizationId: string }, now: number): BillingSnapshot!(StoreFailure | RowCorrupt | PolicyUnreadable | SnapshotUnreadable) {
  const organizationId = caller.organizationId
  const status = toText((try tx.query("SELECT status FROM accounts WHERE key = $1 AND organization_id = $2", [caller.userId, organizationId]))[0]?.status)
  const account = accountStatuses.find((candidate) => candidate === status)
  if (account === undefined) throw new SnapshotUnreadable({ organizationId, problem: "account row" })
  const funds = try loadRow(tx, fundsRows, organizationId, false)
  const policy = try readPolicy(tx, organizationId, now)
  const funding = fundingOf(policy)
  return {
    schemaVersion: 3,
    observedAt: now,
    account: { status: account },
    balance: { usdMicros: funds.state.creditBalance, revision: funds.revision },
    plan: planSummary(policy),
    subscription: subscriptionView(try readSubscription(tx, organizationId)),
    grant: try grantView(tx, organizationId, now),
    allowance: try allowanceView(tx, organizationId, now),
    funding: { inference: fundingLanes[funding.inference], speech: fundingLanes[funding.speech], maps: fundingLanes[funding.maps] }
  }
}

export const routes: ReadonlyArray<Route> = [
  {
    method: "GET",
    path: "/api/v1/billing/limits",
    auth: "ServiceAccess",
    capability: "billing",
    rateClass: "StandardRequests",
    handler: (context) => effect {
      const signed = owner(context.caller)
      if (signed === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
      const store = try Store
      const snapshot = store.transaction((tx) => readSnapshot(tx, signed, context.now)) catch effect (failure) => {
        try annotateLogs(logError("the billing snapshot could not be read"), { requestId: context.requestId, failure: failure._tag })
        throw refused("ServiceUnavailable", "NoReason", context.now + 5000)
      }
      return json({ data: snapshot })
    }
  }
]
