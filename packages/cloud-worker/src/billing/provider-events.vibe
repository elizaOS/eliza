// spec/cloud/billing/providerEvents.md, "Story: Apply each payment event once, whatever the delivery order"; spec/core/sessions.md, "Story: Retry an interaction without repeating its external effect"
import {
  apply, canClaim, drainBatch, drainBudget, drainEvery, drainOwner, elapse, holdsLease, initial, intakeAnswer,
  noExpiry, nowOf, parseState, verifiedDelivery, type Event, type HandlerError, type HandlerResult, type ProviderEvent, type ProviderEventType
} from "../../gen/cloud__billing__providerEvents.effect.vibe"
import { parseState as parseClaim, type SessionOwner } from "../../gen/core__sessions.effect.vibe"
import { refused } from "../http/refusal.vibe"
import { json, type CloudContext, type Route, type RouteContext, type Sweep } from "../http/routes.vibe"
import { Deployment } from "@elizaos/cloud"
import { retrieveCharge, retrieveInvoice, StripeCharge, StripeCheckoutSession, StripeDispute, StripeEvent, StripeInvoice, StripeSubscription, StripeUnavailable, verifiedWebhookTime } from "../providers/stripe.vibe"
import { sha256Hex } from "../shared/sealing.vibe"
import { Store, StoreFailure, toInt, toText, type Row, type Tx } from "../store/connection.vibe"
import { RowCorrupt } from "../store/rows.vibe"
import { changeInvoiceAllowance, type InvoiceAllowanceChange } from "./allowance.vibe"
import { applyCheckoutEvent } from "./checkout.vibe"
import { observeSubscription, reconcileSubscription } from "./subscriptions.vibe"

export const webhookPath = "/api/stripe/webhook"
const maxWebhookBytes = 256 * 1024
const legacyOwner: SessionOwner = { agentId: "cloud", actorId: "payment-provider", connector: "provider-events" }
const stripeTypes: ReadonlyMap<string, ProviderEventType> = new Map<string, ProviderEventType>([
  ["checkout.session.completed", "CheckoutSessionCompleted"],
  ["checkout.session.expired", "CheckoutSessionExpired"],
  ["invoice.paid", "InvoicePaid"],
  ["invoice.payment_failed", "InvoicePaymentFailed"],
  ["customer.subscription.updated", "SubscriptionUpdated"],
  ["customer.subscription.deleted", "SubscriptionDeleted"],
  ["charge.refunded", "ChargeRefunded"],
  ["charge.dispute.funds_withdrawn", "DisputeFundsWithdrawn"],
  ["charge.dispute.funds_reinstated", "DisputeFundsReinstated"]
])

error ProviderEventMalformed { id: string; type: string }

type Sink =
  | { readonly kind: "checkout"; readonly session: StripeCheckoutSession }
  | { readonly kind: "subscription"; readonly customerId: string | null }
  | { readonly kind: "refund"; readonly charge: StripeCharge }
  | { readonly kind: "dispute"; readonly dispute: StripeDispute; readonly funds: "withdrawn" | "reinstated" }

type Settled =
  | { readonly kind: "done" }
  | { readonly kind: "retried"; readonly code: string }
  | { readonly kind: "deadLettered"; readonly code: string }
  | { readonly kind: "stale" }

interface Claimed {
  readonly id: string
  readonly token: number
}

export interface DrainReport {
  readonly done: number
  readonly retried: number
  readonly deadLettered: number
  readonly released: number
}

function decoded<A>(schema: Schema.Codec<A>, raw: unknown): A | undefined {
  return Option.getOrUndefined(Schema.decodeUnknownOption(schema)(raw))
}

function parsedJson(text: string): unknown {
  try {
    return JSON.parse(text) as unknown
  } catch {
    return undefined
  }
}

function eventType(type: string): ProviderEventType {
  return stripeTypes.get(type) ?? "OtherEventType"
}

export function providerEventName(type: ProviderEventType): string {
  return [...stripeTypes].find(([, known]) => known === type)?.[0] ?? "customer.created"
}

export const emptyProviderEvent = initial

export function providerEventAt(state: ProviderEvent, now: number): ProviderEvent {
  return now > nowOf(state) ? elapse(state, now - nowOf(state)) : state
}

function storedClaim(state: ProviderEvent): string {
  return JSON.stringify({ ...state.lease, owner: legacyOwner })
}

export function queuedState(row: Row): ProviderEvent | undefined {
  const claim = parseClaim(row.claim)
  const type = toText(row.type)
  const leaseUntil = row.lease_until === null ? null : toInt(row.lease_until)
  if (claim === undefined || type === undefined || !claim.rowPresent || !claim.authorized ||
    claim.owner.agentId !== legacyOwner.agentId || claim.owner.actorId !== legacyOwner.actorId ||
    claim.owner.connector !== legacyOwner.connector ||
    (claim.phase === "Claimed" && claim.digest !== row.payload_digest) ||
    (row.state === "Leased" ? leaseUntil !== claim.leaseUntil : leaseUntil !== null)) return undefined
  const phase = row.state === "DeadLettered"
    ? { tag: "DeadLettered", cause: row.last_error_code === "ProviderEventMalformed" ? "PayloadUnreadable" : "AttemptsSpent" }
    : { tag: row.state }
  return parseState({
    phase, eventId: row.id, eventType: eventType(type), payloadDigest: row.payload_digest,
    attempts: toInt(row.attempts), dueAt: toInt(row.next_attempt_at), revivals: toInt(row.revivals),
    lease: { ...claim, owner: drainOwner }
  })
}

export effect function lockedEvent(tx: Tx, id: string) {
  return (try tx.query("SELECT * FROM provider_events WHERE id = $1 FOR UPDATE", [id]))[0]
}

effect function keepEvent(tx: Tx, event: ProviderEvent, code: string | null) {
  const leaseEnds = event.lease.phase === "Claimed" ? event.lease.leaseUntil : 0
  try tx.query(
    `UPDATE provider_events SET state=$2, attempts=$3, next_attempt_at=$4, lease_until=$5, claim=$6::jsonb,
      last_error_code=$7, updated_at=$8, revivals=$9, payload=CASE WHEN $2='Done' THEN NULL ELSE payload END WHERE id=$1`,
    [event.eventId, event.phase.tag, event.attempts, Math.max(event.dueAt, leaseEnds),
      event.phase.tag === "Leased" ? leaseEnds : null, storedClaim(event), code, nowOf(event), event.revivals]
  )
}

export effect function advanceProviderEvent(tx: Tx, state: ProviderEvent, event: Event, code: string | null) {
  const next = try apply(state, event)
  if (next.phase.tag !== "NotStored") try keepEvent(tx, next, code)
  return next
}

export effect function appendProviderEvent(tx: Tx, event: Extract<Event, { readonly type: "receive" }>,
  envelope: { readonly type: string; readonly payload: string; readonly now: number }) {
  const received = try apply(providerEventAt(initial, envelope.now), event)
  const inserted = try tx.query(
    `INSERT INTO provider_events (id, type, livemode, payload, payload_digest, state, attempts, next_attempt_at, claim, created_at, updated_at)
     VALUES ($1, $2, $3, $4::jsonb, $5, $6, $7, $8, $9::jsonb, $8, $8) ON CONFLICT (id) DO NOTHING RETURNING id`,
    [received.eventId, envelope.type, event.livemode, envelope.payload, received.payloadDigest, received.phase.tag,
      received.attempts, received.dueAt, storedClaim(received)]
  )
  return inserted.length === 1
}

type Intake = "stored" | "revived" | "duplicate"

effect function record(tx: Tx, event: StripeEvent, payload: string, signedAt: number, liveEnvironment: boolean, now: number) {
  const payloadDigest = sha256Hex(payload)
  const delivery = { payloadDigest, signatureValid: true, signedAt, livemode: event.livemode, liveEnvironment }
  const inserted = try appendProviderEvent(tx, { type: "receive", eventId: event.id, eventType: eventType(event.type), ...delivery },
    { type: event.type, payload, now })
  if (inserted) return "stored" satisfies Intake
  const row = try lockedEvent(tx, event.id)
  if (row === undefined || row.payload_digest !== payloadDigest) throw refused("IdempotencyConflict")
  if (row.state !== "DeadLettered") return "duplicate" satisfies Intake
  const retained = queuedState(row)
  if (retained === undefined) return "duplicate" satisfies Intake
  const ready = providerEventAt(retained, now)
  if (intakeAnswer(ready, payloadDigest, true) !== "RevivedResend") return "duplicate" satisfies Intake
  const revived = try advanceProviderEvent(tx, ready, { type: "revive", ...delivery, signedAt: nowOf(ready) - (now - signedAt) }, null)
  try annotateLogs(logInfo("a dead-lettered provider event was revived"), { eventId: revived.eventId, revivals: revived.revivals })
  return "revived" satisfies Intake
}

effect function receive(context: RouteContext) {
  const deployment = try Deployment
  const billing = deployment.settings.billing
  if (billing === undefined) throw refused("CapabilityUnavailable")
  const secret = deployment.secret(billing.webhookSecretEnv) catch effect () => { throw refused("ServiceUnavailable", "NoReason", context.now + 5_000) }
  const raw = context.request.text catch effect () => { throw refused("InvalidRequest") }
  const signedAt = verifiedWebhookTime(raw, context.request.headers["stripe-signature"] ?? "", secret, context.now)
  if (signedAt === undefined) throw refused("InvalidRequest")
  const liveEnvironment = deployment.environment === "production"
  const event = decoded(StripeEvent, parsedJson(raw))
  if (event === undefined || event.id === "" || !verifiedDelivery(providerEventAt(initial, context.now), true, signedAt, event.livemode, liveEnvironment))
    throw refused("InvalidRequest")
  const payload = JSON.stringify(event)
  const store = try Store
  const intake = try store.transaction((tx) => record(tx, event, payload, signedAt, liveEnvironment, context.now))
  return json(intake === "duplicate" ? { received: true, duplicate: true } : { received: true, queued: true })
}

function sinkOf(type: ProviderEventType, object: unknown): Sink | undefined {
  switch (type) {
    case "CheckoutSessionCompleted":
    case "CheckoutSessionExpired": {
      const session = decoded(StripeCheckoutSession, object)
      return session === undefined ? undefined : { kind: "checkout", session }
    }
    case "InvoicePaid":
    case "InvoicePaymentFailed": {
      const invoice = decoded(StripeInvoice, object)
      return invoice === undefined ? undefined : { kind: "subscription", customerId: invoice.customer }
    }
    case "SubscriptionUpdated":
    case "SubscriptionDeleted": {
      const subscription = decoded(StripeSubscription, object)
      return subscription === undefined ? undefined : { kind: "subscription", customerId: subscription.customer }
    }
    case "ChargeRefunded": {
      const charge = decoded(StripeCharge, object)
      return charge === undefined ? undefined : { kind: "refund", charge }
    }
    case "DisputeFundsWithdrawn":
    case "DisputeFundsReinstated": {
      const dispute = decoded(StripeDispute, object)
      return dispute === undefined ? undefined : { kind: "dispute", dispute, funds: type === "DisputeFundsWithdrawn" ? "withdrawn" : "reinstated" }
    }
    case "OtherEventType": return undefined
    default: {
      const _exhaustive: never = type
      return _exhaustive
    }
  }
}

effect function organizationOf(tx: Tx, customerId: string) {
  const rows = try tx.query(
    "SELECT organization_id AS organization FROM cloud_checkout_customers WHERE customer_id = $1 UNION SELECT key AS organization FROM subscriptions WHERE customer_id = $1",
    [customerId]
  )
  if (rows.length > 1) throw new RowCorrupt({ table: "cloud_checkout_customers", key: customerId, cause: "one provider customer is pinned to two organizations" })
  return toText(rows[0]?.organization)
}

const applied: HandlerResult = { tag: "Applied" }
const nothing: HandlerResult = { tag: "NothingToApply" }

effect function reconcileCustomer(tx: Tx, customerId: string | null, now: number) {
  const organizationId = customerId === null ? undefined : try organizationOf(tx, customerId)
  return organizationId === undefined ? nothing : try reconcileOrganization(tx, organizationId, now)
}

effect function reconcileOrganization(tx: Tx, organizationId: string, now: number) {
  try tx.query("SELECT id FROM organizations WHERE id = $1 FOR UPDATE", [organizationId])
  try reconcileSubscription(tx, organizationId, try observeSubscription(tx, organizationId), now)
  return applied
}

effect function settleInvoiceCharge(tx: Tx, charge: StripeCharge, funds: "refunded" | "withdrawn" | "reinstated", deadline: number, now: number) {
  const live = (try Deployment).environment === "production"
  const invoiceId = charge.invoice ?? null
  const customerId = charge.customer
  if (invoiceId === null || customerId === null || charge.livemode !== live || (funds === "refunded" && charge.amount_refunded <= 0)) return nothing
  const invoice = try retrieveInvoice(invoiceId, { timeout: Math.max(1, deadline - now) })
  if (invoice.id !== invoiceId || invoice.customer !== customerId || invoice.livemode !== live || !invoice.parent?.subscription_details?.subscription) return nothing
  const organizationId = try organizationOf(tx, customerId)
  if (organizationId === undefined) return nothing
  const change: InvoiceAllowanceChange = funds === "reinstated"
    ? { type: "restore", now }
    : { type: "clawBack", cause: funds === "refunded" ? "RefundClawback" : "DisputeClawback" }
  try changeInvoiceAllowance(tx, { organizationId, invoiceId }, change, now)
  return try reconcileOrganization(tx, organizationId, now)
}

effect function applySink(tx: Tx, sink: Sink, deadline: number, now: number) {
  switch (sink.kind) {
    case "checkout": return (try applyCheckoutEvent(tx, sink.session, now)) === undefined ? nothing : applied
    case "subscription": return try reconcileCustomer(tx, sink.customerId, now)
    case "refund": return try settleInvoiceCharge(tx, sink.charge, "refunded", deadline, now)
    case "dispute": {
      if (sink.dispute.livemode !== ((try Deployment).environment === "production")) return nothing
      const charge = try retrieveCharge(sink.dispute.charge, { timeout: Math.max(1, deadline - now) })
      return charge.id === sink.dispute.charge ? try settleInvoiceCharge(tx, charge, sink.funds, deadline, now) : nothing
    }
    default: {
      const _exhaustive: never = sink
      return _exhaustive
    }
  }
}

effect function heldEvent(tx: Tx, claimed: Claimed, now: number) {
  const row = try lockedEvent(tx, claimed.id)
  if (row === undefined || row.state !== "Leased") return undefined
  const parsed = queuedState(row)
  if (parsed === undefined) throw new RowCorrupt({ table: "provider_events", key: claimed.id, cause: "provider event lease" })
  const state = providerEventAt(parsed, now)
  return holdsLease(state, claimed.token) ? { row, state } : undefined
}

error ProviderLeaseElapsed { id: string }

effect function settleDone(claimed: Claimed, deadline: number, now: number) {
  const started = try Clock.currentTimeMillis
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const held = try heldEvent(tx, claimed, now)
    if (held === undefined) return { kind: "stale" } satisfies Settled
    let result: HandlerResult = nothing
    if (held.state.eventType !== "OtherEventType") {
      const event = decoded(StripeEvent, held.row.payload)
      const sink = event === undefined || event.id !== claimed.id || event.type !== held.row.type || event.livemode !== held.row.livemode
        ? undefined : sinkOf(held.state.eventType, event.data.object)
      if (sink === undefined) throw new ProviderEventMalformed({ id: claimed.id, type: toText(held.row.type) ?? "" })
      result = try applySink(tx, sink, deadline, now)
    }
    const completed = providerEventAt(held.state, now + (try Clock.currentTimeMillis) - started)
    if (!holdsLease(completed, claimed.token)) throw new ProviderLeaseElapsed({ id: claimed.id })
    try advanceProviderEvent(tx, completed, { type: "finish", claimToken: claimed.token, result }, null)
    return { kind: "done" } satisfies Settled
  })
}

function handlerErrorOf(failure: unknown): HandlerError {
  if (failure instanceof ProviderEventMalformed) return "PayloadParseFailed"
  if (failure instanceof StripeUnavailable) return failure.status === 429 ? "ProviderThrottled" : "ProviderDown"
  if (failure instanceof StoreFailure) return "StoreBusy"
  return "UnclassifiedError"
}

effect function logDeadLetter(id: string, eventType: string, attempts: number, code: string) {
  try annotateLogs(logWarning("a provider event was dead-lettered"), { eventId: id, eventType, attempts, code })
}

effect function settleFailed(claimed: Claimed, failure: unknown, code: string, now: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const held = try heldEvent(tx, claimed, now)
    if (held === undefined) return { kind: "stale" } satisfies Settled
    const result: HandlerResult = { tag: "Failed", error: handlerErrorOf(failure) }
    const next = try advanceProviderEvent(tx, held.state, { type: "finish", claimToken: claimed.token, result }, code)
    if (next.phase.tag !== "DeadLettered") return { kind: "retried", code } satisfies Settled
    try logDeadLetter(claimed.id, next.eventType, next.attempts, code)
    return { kind: "deadLettered", code } satisfies Settled
  })
}

effect function release(claimed: Claimed, now: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const held = try heldEvent(tx, claimed, now)
    if (held === undefined) return false
    try advanceProviderEvent(tx, held.state, { type: "release", claimToken: claimed.token }, toText(held.row.last_error_code) ?? null)
    return true
  })
}

type ClaimOutcome = { readonly kind: "claimed"; readonly claim: Claimed } | { readonly kind: "deadLettered" } | { readonly kind: "skipped" }

effect function claimRow(tx: Tx, row: Row, now: number) {
  const id = toText(row.id)
  if (id === undefined) throw new RowCorrupt({ table: "provider_events", key: "", cause: "provider event identity" })
  const parsed = queuedState(row)
  if (parsed === undefined) {
    const code = "ClaimCorrupt"
    try tx.query("UPDATE provider_events SET state='DeadLettered', lease_until=NULL, last_error_code=$2, updated_at=$3 WHERE id=$1", [id, code, now])
    try logDeadLetter(id, toText(row.type) ?? "", toInt(row.attempts), code)
    return { kind: "deadLettered" } satisfies ClaimOutcome
  }
  const clocked = providerEventAt(parsed, now)
  const current = clocked.lease.expiresAt <= now && clocked.lease.leaseUntil <= now
    ? { ...clocked, lease: { ...clocked.lease, expiresAt: noExpiry } } : clocked
  if (!canClaim(current)) return { kind: "skipped" } satisfies ClaimOutcome
  const code = current.phase.tag === "Leased" ? "LeaseLapsed" : toText(row.last_error_code) ?? null
  const next = try advanceProviderEvent(tx, current, { type: "claim" }, code)
  if (next.phase.tag === "DeadLettered") {
    try logDeadLetter(id, next.eventType, next.attempts, "LeaseLapsed")
    return { kind: "deadLettered" } satisfies ClaimOutcome
  }
  return { kind: "claimed", claim: { id, token: next.lease.currentClaim } } satisfies ClaimOutcome
}

effect function claimDue(now: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const due = try tx.query(
      `SELECT * FROM provider_events
       WHERE (state = 'Pending' AND next_attempt_at <= $1) OR (state = 'Leased' AND lease_until <= $1)
       ORDER BY created_at, id LIMIT $2 FOR UPDATE SKIP LOCKED`,
      [now, drainBatch]
    )
    const claimed: Array<Claimed> = []
    let deadLettered = 0
    for (const row of due) {
      const result = try claimRow(tx, row, now)
      if (result.kind === "claimed") claimed.push(result.claim)
      if (result.kind === "deadLettered") deadLettered += 1
    }
    return { claimed, deadLettered }
  })
}

effect function settle(claimed: Claimed, deadline: number, now: number) {
  const started = try Clock.currentTimeMillis
  return settleDone(claimed, deadline, now) catch effect (failure) => {
    if (failure instanceof ProviderLeaseElapsed) return { kind: "stale" } satisfies Settled
    try annotateLogs(logWarning("a provider event failed"), { eventId: claimed.id, code: failure._tag })
    return try settleFailed(claimed, failure, failure._tag, now + (try Clock.currentTimeMillis) - started)
  }
}

export effect function drainProviderEvents(now: number): DrainReport!!CloudContext {
  const started = try Clock.currentTimeMillis
  const claimed = claimDue(now) catch effect (failure) => {
    try annotateLogs(logWarning("provider events could not be claimed"), { failure: failure._tag })
    return { claimed: [], deadLettered: 0 }
  }
  const deadline = now + drainBudget
  const report = { done: 0, retried: 0, deadLettered: claimed.deadLettered, released: 0 }
  for (const each of claimed.claimed) {
    const at = now + (try Clock.currentTimeMillis) - started
    if (at >= deadline) {
      const released = release(each, at) catch effect (failure) => {
        try annotateLogs(logWarning("a provider event could not be released"), { eventId: each.id, failure: failure._tag })
        return false
      }
      if (released) report.released += 1
      continue
    }
    const settled = settle(each, deadline, at) catch effect (failure) => {
      try annotateLogs(logWarning("a provider event failure could not be recorded"), { eventId: each.id, failure: failure._tag })
      return { kind: "stale" } satisfies Settled
    }
    switch (settled.kind) {
      case "done": report.done += 1; break
      case "retried": report.retried += 1; break
      case "deadLettered": report.deadLettered += 1; break
      case "stale": break
      default: {
        const _exhaustive: never = settled
        return _exhaustive
      }
    }
  }
  return report satisfies DrainReport
}

effect function drainDue() {
  try drainProviderEvents(try Clock.currentTimeMillis)
}

export const routes: ReadonlyArray<Route> = [
  { method: "POST", path: webhookPath, auth: "ProviderSignature", capability: "billing", maxBodyBytes: maxWebhookBytes, handler: receive }
]

export const sweeps: ReadonlyArray<Sweep> = [{ name: "provider events", everyMs: drainEvery, run: drainDue() }]
