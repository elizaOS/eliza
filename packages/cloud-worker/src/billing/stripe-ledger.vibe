// spec/cloud/billing/allowance.md, "Story: Spend my plan's allowance before my credits, and never carry it over"
import type { CloudEnvironment } from "@elizaos/cloud"
import { allowanceStatus, decodeAllowancePeriod, encodeAllowancePeriod } from "../shared/metering.vibe"
import { toText, type Tx } from "../store/connection.vibe"
import {
  apply, initial, canClawBack, canRestore, canClose, canExpire,
  type Event, type Period
} from "../../gen/cloud__billing__allowance.effect.vibe"
import type { LatestInvoice } from "../../gen/cloud__billing__subscriptions.ts"
import type { PlanKey } from "../../gen/cloud__billing__plans.ts"

export type Payment = { id: string; startsAt: number; endsAt: number; condition: "paid" | "refunded" | "disputed" }
export type SubscriptionObservation = {
  customerId: string
  subscriptionId: string | null
  plan: "free" | "plus_monthly" | "pro_monthly"
  status: "none" | "active" | "incomplete" | "incomplete_expired" | "past_due" | "unpaid" | "canceled"
  startsAt: number
  endsAt: number
  cancelAtPeriodEnd: boolean
  latestInvoice: LatestInvoice
  payment?: Payment
}

export error InvalidAllowancePeriod { key: string }

export function renewalKey(environment: CloudEnvironment, invoiceId: string): string {
  return `renewal/${environment}/${invoiceId}`
}

effect function savePeriod(tx: Tx, org: string, key: string, period: Period, event: Event, now: number) {
  const next = try apply(period, event)
  const status = allowanceStatus(next.phase)
  if (status === null) throw new InvalidAllowancePeriod({ key })
  try tx.query(`INSERT INTO allowance_periods (key, state, revision, organization_id, status, period_start, period_end, updated_at)
    VALUES ($1,$2,1,$3,$4,$5,$6,$7) ON CONFLICT (key) DO UPDATE SET state=excluded.state, revision=allowance_periods.revision+1, status=excluded.status, updated_at=excluded.updated_at WHERE allowance_periods.organization_id=excluded.organization_id`,
    [key, JSON.stringify(encodeAllowancePeriod(next)), org, status, next.startsAt, next.endsAt, now])
}

export effect function existingRenewalPeriod(tx: Tx, organizationId: string, invoiceId: string, environment?: CloudEnvironment) {
  const legacyKey = "invoice/" + invoiceId
  const rows = try tx.query(
    `SELECT key,state FROM allowance_periods WHERE organization_id=$1
      AND (key=$2 OR key=$4 OR ($4::text IS NULL AND starts_with(key,'renewal/') AND split_part(key,'/',3)=$3 AND split_part(key,'/',4)=''))
      ORDER BY key FOR UPDATE`,
    [organizationId, legacyKey, invoiceId, environment === undefined ? null : renewalKey(environment, invoiceId)]
  )
  if (rows.length === 0) return undefined
  const key = toText(rows[0]?.key)
  if (key === undefined || rows.length !== 1) throw new InvalidAllowancePeriod({ key: legacyKey })
  const period = decodeAllowancePeriod(rows[0]?.state) catch effect () => { throw new InvalidAllowancePeriod({ key }) }
  if (period.source.tag !== "RenewalInvoice" || period.source.invoiceId !== invoiceId) throw new InvalidAllowancePeriod({ key })
  return { key, period }
}

export effect function settleSubscriptionAllowance(tx: Tx, org: string, subscription: SubscriptionObservation, ended: boolean, now: number, environment?: CloudEnvironment) {
  const retiring = try tx.query(
    `SELECT key,state FROM allowance_periods WHERE organization_id=$1 AND status='open' AND (period_end <= $2 OR $3)
      AND (starts_with(key,'invoice/') OR starts_with(key,$4)) FOR UPDATE`,
    [org, now, ended, environment === undefined ? "renewal/" : renewalKey(environment, "")])
  for (const row of retiring) {
    const key = toText(row.key)
    if (key === undefined) throw new InvalidAllowancePeriod({ key: org })
    const period = try decodeAllowancePeriod(row.state)
    if (canExpire(period, now)) try savePeriod(tx, org, key, period, {type:"expire",now}, now)
    else if (ended && canClose(period, "SubscriptionEnded")) try savePeriod(tx, org, key, period, {type:"close",closeReason:"SubscriptionEnded"}, now)
  }
  if (!subscription.payment || subscription.plan === "free") return
  const payment = subscription.payment
  const key = "invoice/" + payment.id
  const plan: PlanKey = subscription.plan === "plus_monthly" ? "PlusMonthly" : "ProMonthly"
  const existing = try existingRenewalPeriod(tx, org, payment.id, environment)
  if (existing === undefined) {
    if (environment === undefined && payment.condition === "paid" && subscription.status === "active" && payment.startsAt <= now && now < payment.endsAt) {
      try savePeriod(tx,org,key,initial,{type:"openRenewal",invoiceId:payment.id,planKey:plan,startsAt:payment.startsAt,endsAt:payment.endsAt},now)
    }
    return
  }
  const { key: existingKey, period } = existing
  if (payment.startsAt !== period.startsAt || payment.endsAt !== period.endsAt)
    throw new InvalidAllowancePeriod({ key: existingKey })
  if (payment.condition === "paid" && canRestore(period, now)) try savePeriod(tx,org,existingKey,period,{type:"restore",now},now)
  if (payment.condition !== "paid") {
    const cause = payment.condition === "refunded" ? "RefundClawback" : "DisputeClawback"
    if (canClawBack(period, cause)) try savePeriod(tx,org,existingKey,period,{type:"clawBack",cause},now)
  }
}
