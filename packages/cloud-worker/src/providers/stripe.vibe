// spec/cloud/billing/checkout.md, "Story: Subscribe once, whichever screen or payer finishes it"; spec/cloud/billing/providerEvents.md, "Story: Apply each payment event once, whatever the delivery order"; spec/cloud/shared/dispatchOnce.md, "Story: Send a change once and recover its outcome without sending it again"; spec/cloud/billing/subscriptionCommands.md, "Story: Change or cancel my plan without paying twice"
import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import type { LookupResult } from "../../gen/cloud__shared__dispatchOnce.ts"
import { Deployment } from "@elizaos/cloud"
import { sameText } from "../shared/credential-crypto.vibe"
import { requestDigest } from "../shared/dispatch-once.vibe"
import type { ProviderReply } from "../shared/dispatch-once.vibe"

module node {
  import { createHmac } from "node:crypto"

  /** @throws {never} */
  export function signatureOf(secret: string, signedPayload: string): string {
    return createHmac("sha256", secret).update(signedPayload, "utf8").digest("hex")
  }
}
import { signatureOf } from node

export error StripeRefused { path: string; status: number; type: string; code: string | null; declineCode: string | null }
export error StripeUnavailable { path: string; status: number | null }
export error StripeInvalidResponse { path: string; status: number }
export type StripeFailure = StripeRefused | StripeUnavailable | StripeInvalidResponse

export type StripeContext = Deployment | HttpClient.HttpClient

export interface StripeRead {
  readonly timeout: number
}

export interface StripeMutation extends StripeRead {
  readonly idempotencyKey: string
}

const webhookTolerance = 300_000

export schema StripeCustomer { readonly id: string; readonly livemode: boolean; readonly metadata: Record<string, string> }

export schema StripeCheckoutSession {
  readonly id: string
  readonly mode: string
  readonly status: "open" | "complete" | "expired" | null
  readonly payment_status: "paid" | "unpaid" | "no_payment_required"
  readonly customer: string | null
  readonly client_reference_id?: string | null
  readonly subscription: string | null
  readonly invoice?: string | null
  readonly metadata: Record<string, string> | null
  readonly ui_mode?: string | null
  readonly url: string | null
  readonly client_secret?: string | null
  readonly currency: string | null
  readonly amount_total: number | null
  readonly expires_at: number
  readonly created: number
  readonly livemode: boolean
}

schema SubscriptionItem {
  readonly id: string
  readonly price: { readonly id: string }
  readonly quantity?: number
  readonly current_period_start: number
  readonly current_period_end: number
}

export schema StripeSubscription {
  readonly id: string
  readonly customer: string
  readonly status: "incomplete" | "incomplete_expired" | "trialing" | "active" | "past_due" | "canceled" | "unpaid" | "paused"
  readonly livemode: boolean
  readonly created: number
  readonly cancel_at_period_end: boolean
  readonly canceled_at?: number | null
  readonly ended_at?: number | null
  readonly latest_invoice: string | null
  readonly schedule?: string | null
  readonly metadata: Record<string, string>
  readonly items: { readonly data: ReadonlyArray<SubscriptionItem>; readonly has_more: boolean }
}

schema InvoiceLine {
  readonly id: string
  readonly amount: number
  readonly currency: string
  readonly quantity?: number | null
  readonly period: { readonly start: number; readonly end: number }
  readonly pricing?: { readonly price_details?: { readonly price: string } | null } | null
  readonly parent?: { readonly subscription_item_details?: { readonly subscription_item: string; readonly proration: boolean } | null } | null
}

export schema StripeInvoice {
  readonly id: string
  readonly customer: string | null
  readonly status: "draft" | "open" | "paid" | "uncollectible" | "void" | null
  readonly billing_reason?: string | null
  readonly amount_due: number
  readonly amount_paid: number
  readonly currency: string
  readonly attempted?: boolean
  readonly attempt_count?: number
  readonly livemode: boolean
  readonly created: number
  readonly period_start: number
  readonly period_end: number
  readonly hosted_invoice_url?: string | null
  readonly parent?: { readonly subscription_details?: { readonly subscription: string } | null } | null
  readonly lines: { readonly data: ReadonlyArray<InvoiceLine>; readonly has_more: boolean }
}

export schema StripeCharge {
  readonly id: string
  readonly customer: string | null
  readonly invoice?: string | null
  readonly payment_intent?: string | null
  readonly amount: number
  readonly amount_refunded: number
  readonly refunded: boolean
  readonly disputed: boolean
  readonly paid: boolean
  readonly captured: boolean
  readonly currency: string
  readonly livemode: boolean
}

export schema StripeDispute { readonly id: string; readonly charge: string; readonly status: string; readonly livemode: boolean }

export schema StripeEvent {
  readonly id: string
  readonly type: string
  readonly created: number
  readonly livemode: boolean
  readonly data: { readonly object: Schema.Unknown }
}


schema ErrorBody { readonly error: { readonly type: string; readonly code?: string | null; readonly decline_code?: string | null } }

type Params = ReadonlyArray<readonly [string, string]>

interface Call {
  readonly method: "GET" | "POST" | "DELETE"
  readonly path: string
  readonly params: Params
  readonly timeout: number
  readonly idempotencyKey?: string
  readonly apiVersion?: string
}

function parsed(text: string): unknown {
  try {
    return text === "" ? undefined : JSON.parse(text) as unknown
  } catch {
    return undefined
  }
}

function decoded<A>(schema: Schema.Codec<A>, raw: unknown): A | undefined {
  return Option.getOrUndefined(Schema.decodeUnknownOption(schema)(raw))
}

function failureOf(path: string, status: number, body: unknown): StripeFailure {
  const error = decoded(ErrorBody, body)?.error
  if (status === 409 || status === 429 || status >= 500 || error?.type === "api_error" || error?.type === "rate_limit_error") return new StripeUnavailable({ path, status })
  if (status < 400 || error === undefined) return new StripeInvalidResponse({ path, status })
  return new StripeRefused({ path, status, type: error.type, code: error.code ?? null, declineCode: error.decline_code ?? null })
}

effect function send(call: Call) {
  const deployment = try Deployment
  const billing = deployment.settings.billing
  if (billing === undefined) throw new StripeUnavailable({ path: call.path, status: null })
  const key = deployment.secret(billing.secretKeyEnv) catch effect () => { throw new StripeUnavailable({ path: call.path, status: null }) }
  const form = new URLSearchParams(call.params.map(([name, value]) => [name, value])).toString()
  const query = call.method === "GET" && form !== "" ? `?${form}` : ""
  let request = HttpClientRequest.make(call.method)(`${billing.apiUrl}${call.path}${query}`).pipe(HttpClientRequest.bearerToken(key), HttpClientRequest.acceptJson)
  if (call.idempotencyKey !== undefined) request = HttpClientRequest.setHeader(request, "idempotency-key", call.idempotencyKey)
  if (call.apiVersion !== undefined) request = HttpClientRequest.setHeader(request, "stripe-version", call.apiVersion)
  if (call.method === "POST") request = HttpClientRequest.bodyText(request, form, "application/x-www-form-urlencoded")
  const answered = effect {
    const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "manual" }) catch effect () => { throw new StripeUnavailable({ path: call.path, status: null }) }
    const text = response.text catch effect () => { throw new StripeUnavailable({ path: call.path, status: response.status }) }
    return { status: response.status, body: parsed(text), requestId: response.headers["request-id"], idempotencyKey: response.headers["idempotency-key"] }
  }
  const answer = try timeoutOrElse(answered, { duration: Duration.millis(Math.max(1, call.timeout)), orElse: () => fail(new StripeUnavailable({ path: call.path, status: null })) })
  if (answer.status >= 200 && answer.status < 300 && answer.body !== undefined) return answer
  throw failureOf(call.path, answer.status, answer.body)
}

effect function read<A>(schema: Schema.Codec<A>, call: Call): A!StripeFailure!StripeContext {
  const body = try send(call)
  const value = decoded(schema, body.body)
  if (value === undefined) throw new StripeInvalidResponse({ path: call.path, status: 200 })
  return value
}

effect function everyPage<A extends { readonly id: string }>(item: Schema.Codec<A>, path: string, params: Params, timeout: number): ReadonlyArray<A>!StripeFailure!StripeContext {
  const page: Schema.Codec<{ readonly data: ReadonlyArray<A>; readonly has_more: boolean }> = Schema.Struct({ data: Schema.Array(item), has_more: Schema.Boolean })
  const all: Array<A> = []
  let after: string | undefined = undefined
  let more = true
  while (more) {
    const listed: { readonly data: ReadonlyArray<A>; readonly has_more: boolean } = try read(page, { method: "GET", path, timeout, params: [...params, ["limit", "100"], ...(after === undefined ? [] : [["starting_after", after] as const])] })
    all.push(...listed.data)
    const last = listed.data.at(-1)
    if (listed.has_more && (last === undefined || last.id === after)) throw new StripeInvalidResponse({ path, status: 200 })
    more = listed.has_more
    after = last?.id
  }
  return all
}

effect function livemode(): boolean!!Deployment {
  return (try Deployment).environment === "production"
}

function id(value: string): string {
  return encodeURIComponent(value)
}

function seconds(millis: number): string {
  return String(Math.floor(millis / 1000))
}

export effect function createCustomer(organizationId: string, mutation: StripeMutation): StripeCustomer!StripeFailure!StripeContext {
  const path = "/v1/customers"
  const customer = try read(StripeCustomer, { method: "POST", path, ...mutation, params: [["metadata[organizationId]", organizationId]] })
  if (customer.metadata.organizationId !== organizationId || customer.livemode !== try livemode()) throw new StripeInvalidResponse({ path, status: 200 })
  return customer
}

export type CheckoutReturns =
  | { readonly kind: "hosted"; readonly successUrl: string; readonly cancelUrl: string }
  | { readonly kind: "embedded" }

export interface CheckoutTerms {
  readonly organizationId: string
  readonly commandId: string
  readonly customerId: string
  readonly priceId: string
  readonly expiresAt: number
  readonly returns: CheckoutReturns
}

function returnParams(returns: CheckoutReturns): Params {
  switch (returns.kind) {
    case "hosted": return [["success_url", returns.successUrl], ["cancel_url", returns.cancelUrl]]
    case "embedded": return [["ui_mode", "embedded"], ["redirect_on_completion", "never"]]
    default: {
      const _exhaustive: never = returns
      return _exhaustive
    }
  }
}

function checkoutParams(terms: CheckoutTerms): Params {
  const identity: Params = [["organizationId", terms.organizationId], ["commandId", terms.commandId]]
  return [
    ["mode", "subscription"],
    ["customer", terms.customerId],
    ["client_reference_id", terms.commandId],
    ["currency", "usd"],
    ["line_items[0][price]", terms.priceId],
    ["line_items[0][quantity]", "1"],
    ["payment_method_types[0]", "card"],
    ["allow_promotion_codes", "false"],
    ["automatic_tax[enabled]", "false"],
    ...identity.map(([name, value]) => [`metadata[${name}]`, value] as const),
    ...identity.map(([name, value]) => [`subscription_data[metadata][${name}]`, value] as const),
    ["expires_at", seconds(terms.expiresAt)],
    ...returnParams(terms.returns)
  ]
}

function sessionFits(session: StripeCheckoutSession, terms: CheckoutTerms, live: boolean): boolean {
  const opened = terms.returns.kind === "hosted" ? session.url !== null : (session.client_secret ?? null) !== null
  return session.mode === "subscription" && session.customer === terms.customerId && session.livemode === live &&
    session.metadata?.commandId === terms.commandId && session.metadata.organizationId === terms.organizationId &&
    session.expires_at === Math.floor(terms.expiresAt / 1000) && (session.status !== "open" || opened)
}

export effect function createCheckoutSession(terms: CheckoutTerms, mutation: StripeMutation): StripeCheckoutSession!StripeFailure!StripeContext {
  const path = "/v1/checkout/sessions"
  const session = try read(StripeCheckoutSession, { method: "POST", path, ...mutation, params: checkoutParams(terms) })
  if (!sessionFits(session, terms, try livemode())) throw new StripeInvalidResponse({ path, status: 200 })
  return session
}

export effect function retrieveCheckoutSession(sessionId: string, call: StripeRead): StripeCheckoutSession!StripeFailure!StripeContext {
  return try read(StripeCheckoutSession, { method: "GET", path: `/v1/checkout/sessions/${id(sessionId)}`, params: [], timeout: call.timeout })
}

effect function listCheckoutSessions(customerId: string, call: StripeRead): ReadonlyArray<StripeCheckoutSession>!StripeFailure!StripeContext {
  return try everyPage(StripeCheckoutSession, "/v1/checkout/sessions", [["customer", customerId]], call.timeout)
}

export effect function findCheckoutSession(customerId: string, commandId: string, call: StripeRead): (StripeCheckoutSession | undefined)!StripeFailure!StripeContext {
  return (try listCheckoutSessions(customerId, call)).find((session) => session.metadata?.commandId === commandId && session.customer === customerId)
}

export effect function expireCheckoutSession(sessionId: string, mutation: StripeMutation): StripeCheckoutSession!StripeFailure!StripeContext {
  return try read(StripeCheckoutSession, { method: "POST", path: `/v1/checkout/sessions/${id(sessionId)}/expire`, params: [], ...mutation })
}

export effect function listSubscriptions(customerId: string, call: StripeRead): ReadonlyArray<StripeSubscription>!StripeFailure!StripeContext {
  return try everyPage(StripeSubscription, "/v1/subscriptions", [["customer", customerId], ["status", "all"]], call.timeout)
}

export effect function retrieveSubscription(subscriptionId: string, call: StripeRead): StripeSubscription!StripeFailure!StripeContext {
  return try read(StripeSubscription, { method: "GET", path: `/v1/subscriptions/${id(subscriptionId)}`, params: [], timeout: call.timeout })
}

export effect function cancelSubscriptionNow(subscriptionId: string, call: StripeRead): StripeSubscription!StripeFailure!StripeContext {
  return try read(StripeSubscription, { method: "DELETE", path: `/v1/subscriptions/${id(subscriptionId)}`, params: [], timeout: call.timeout })
}

export schema StripePlanBinding {
  readonly customerId: string
  readonly subscriptionItemId: string
  readonly sourcePriceId: string
  readonly targetPriceId: string
  readonly scheduleId?: string | null
}

export interface StripePlanSource {
  readonly subscriptionId: string
  readonly customerId: string
  readonly sourcePriceId: string
  readonly targetPriceId: string
  readonly periodStart: number
  readonly periodEnd: number
  readonly cancelAtPeriodEnd?: boolean
}

export effect function bindPlanChange(source: StripePlanSource, call: StripeRead): StripePlanBinding!StripeFailure!StripeContext {
  const subscription = try retrieveSubscription(source.subscriptionId, call)
  const [item] = subscription.items.data
  if (subscription.id !== source.subscriptionId || subscription.customer !== source.customerId ||
    subscription.livemode !== try livemode() || subscription.status !== "active" || subscription.cancel_at_period_end !== (source.cancelAtPeriodEnd ?? false) ||
    subscription.items.has_more || subscription.items.data.length !== 1 || item === undefined || item.quantity !== 1 ||
    !/^si_[A-Za-z0-9]{1,250}$/.test(item.id) || item.price.id !== source.sourcePriceId ||
    item.current_period_start * 1000 !== source.periodStart || item.current_period_end * 1000 !== source.periodEnd)
    throw new StripeInvalidResponse({ path: "/v1/subscriptions", status: 200 })
  return { customerId: source.customerId, subscriptionItemId: item.id, sourcePriceId: source.sourcePriceId, targetPriceId: source.targetPriceId,
    ...(subscription.schedule === undefined ? {} : { scheduleId: subscription.schedule }) }
}

export type StripePlanPreview =
  | { readonly kind: "recurring"; readonly expectedCents: number }
  | { readonly kind: "proration"; readonly date: number; readonly periodEnd: number }

function proratedLinesFit(lines: ReadonlyArray<typeof InvoiceLine.Type>, binding: StripePlanBinding, date: number, periodEnd: number): boolean {
  return lines.length === 2 && lines.every((line) => line.currency === "usd" && line.quantity === 1 &&
    line.parent?.subscription_item_details?.subscription_item === binding.subscriptionItemId &&
    line.parent?.subscription_item_details?.proration === true && Number.isSafeInteger(line.amount) &&
    line.period.start * 1000 === date && line.period.end * 1000 === periodEnd) &&
    lines.some((line) => line.pricing?.price_details?.price === binding.sourcePriceId && line.amount <= 0) &&
    lines.some((line) => line.pricing?.price_details?.price === binding.targetPriceId && line.amount >= 0)
}

effect function ownedPlanPreview(subscriptionId: string, binding: StripePlanBinding, params: Params, call: StripeRead) {
  const path = "/v1/invoices/create_preview"
  const invoice = try read(StripeInvoice, { method: "POST", path, timeout: call.timeout, params })
  const lines = invoice.lines.data
  if (!invoice.id.startsWith("upcoming_in_") || invoice.status !== "draft" || invoice.customer !== binding.customerId ||
    invoice.parent?.subscription_details?.subscription !== subscriptionId || invoice.livemode !== try livemode() ||
    invoice.currency !== "usd" || invoice.amount_paid !== 0 || !Number.isSafeInteger(invoice.amount_due) || invoice.amount_due < 0 ||
    invoice.lines.has_more || !lines.every((line) => line.currency === "usd" && line.quantity === 1 &&
      line.parent?.subscription_item_details?.subscription_item === binding.subscriptionItemId && Number.isSafeInteger(line.amount)))
    throw new StripeInvalidResponse({ path, status: 200 })
  return invoice
}

export effect function previewPlanChange(subscriptionId: string, binding: StripePlanBinding, preview: StripePlanPreview, call: StripeRead): number!StripeFailure!StripeContext {
  const params: Params = [
    ["customer", binding.customerId], ["subscription", subscriptionId],
    ["preview_mode", preview.kind === "recurring" ? "recurring" : "next"],
    ["subscription_details[items][0][id]", binding.subscriptionItemId],
    ["subscription_details[items][0][price]", binding.targetPriceId],
    ["subscription_details[items][0][quantity]", "1"]
  ]
  const invoice = try ownedPlanPreview(subscriptionId, binding, preview.kind === "recurring" ? params : [...params,
    ["subscription_details[proration_behavior]", "always_invoice"], ["subscription_details[proration_date]", seconds(preview.date)]], call)
  const lines = invoice.lines.data
  const [first] = lines
  const fits = preview.kind === "recurring"
    ? lines.length === 1 && first !== undefined && first.parent?.subscription_item_details?.proration === false &&
      first.pricing?.price_details?.price === binding.targetPriceId && first.period.start < first.period.end &&
      first.amount === preview.expectedCents && invoice.amount_due === preview.expectedCents
    : proratedLinesFit(lines, binding, preview.date, preview.periodEnd)
  if (!fits) throw new StripeInvalidResponse({ path: "/v1/invoices/create_preview", status: 200 })
  return invoice.amount_due
}

export effect function previewUndoRenewal(subscriptionId: string, binding: StripePlanBinding, periodEnd: number, expectedCents: number, call: StripeRead) {
  const invoice = try ownedPlanPreview(subscriptionId, binding, [
    ["customer", binding.customerId], ["subscription", subscriptionId], ["preview_mode", "next"],
    ["subscription_details[cancel_at_period_end]", "false"], ["subscription_details[proration_behavior]", "none"]
  ], call)
  const [line] = invoice.lines.data
  if (invoice.lines.data.length !== 1 || line === undefined || line.parent?.subscription_item_details?.proration !== false ||
      line.pricing?.price_details?.price !== binding.sourcePriceId || line.period.start * 1000 !== periodEnd ||
      line.period.end <= line.period.start || line.amount !== expectedCents || invoice.amount_due !== expectedCents)
    throw new StripeInvalidResponse({ path: "/v1/invoices/create_preview", status: 200 })
}

export interface StripeUpgradeTerms {
  readonly subscriptionId: string
  readonly binding: StripePlanBinding
  readonly effectiveAt: number
  readonly periodStart: number
  readonly periodEnd: number
  readonly dueNowCents: number
  readonly sentAt: number
}

export interface StripeUpgradeOrigin {
  readonly invoiceId: string
  readonly requestId: string
}

const providerRequestId = /^req_[A-Za-z0-9]+$/
const providerInvoiceId = /^in_[A-Za-z0-9]+$/

function ownsUpgradeInvoice(invoice: typeof StripeInvoice.Type, terms: StripeUpgradeTerms, live: boolean, now: number): boolean {
  return providerInvoiceId.test(invoice.id) && invoice.customer === terms.binding.customerId &&
    invoice.parent?.subscription_details?.subscription === terms.subscriptionId && invoice.livemode === live &&
    invoice.billing_reason === "subscription_update" && invoice.currency === "usd" &&
    Number.isSafeInteger(invoice.created) && invoice.created >= Math.floor(terms.sentAt / 1000) && invoice.created <= Math.floor(now / 1000)
}

export effect function dispatchPlanUpgrade(terms: StripeUpgradeTerms, mutation: StripeMutation): StripeUpgradeOrigin!StripeFailure!StripeContext {
  const path = `/v1/subscriptions/${id(terms.subscriptionId)}`
  const response = try send({
    method: "POST", path, ...mutation, params: [
      ["items[0][id]", terms.binding.subscriptionItemId], ["items[0][price]", terms.binding.targetPriceId],
      ["items[0][quantity]", "1"], ["payment_behavior", "pending_if_incomplete"], ["proration_behavior", "always_invoice"],
      ["proration_date", seconds(terms.effectiveAt)], ["expand[]", "latest_invoice"]
    ]
  })
  const shape = Schema.Struct({ id: Schema.String, customer: Schema.String, livemode: Schema.Boolean, latest_invoice: StripeInvoice })
  const subscription = decoded(shape, response.body)
  const live = try livemode()
  const now = try Clock.currentTimeMillis
  if (response.status !== 200 || response.requestId === undefined || !providerRequestId.test(response.requestId) ||
    response.idempotencyKey !== mutation.idempotencyKey || subscription === undefined ||
    subscription.id !== terms.subscriptionId || subscription.customer !== terms.binding.customerId ||
    subscription.livemode !== live || !ownsUpgradeInvoice(subscription.latest_invoice, terms, live, now))
    throw new StripeInvalidResponse({ path, status: response.status })
  return { invoiceId: subscription.latest_invoice.id, requestId: response.requestId }
}

effect function operationEvent(type: string, sentAt: number, operationKey: string, call: StripeRead) {
  const Event = Schema.Struct({
    id: Schema.String, type: Schema.String, created: Schema.Number, livemode: Schema.Boolean,
    account: Schema.optionalKey(Schema.NullOr(Schema.String)), context: Schema.optionalKey(Schema.NullOr(Schema.String)),
    request: Schema.NullOr(Schema.Struct({ id: Schema.NullOr(Schema.String), idempotency_key: Schema.NullOr(Schema.String) })),
    data: Schema.Struct({ object: Schema.Unknown })
  })
  const path = "/v1/events"
  const now = try Clock.currentTimeMillis
  const live = try livemode()
  const reply = try timeoutOrElse(everyPage(Event, path, [["type", type], ["created[gte]", seconds(sentAt)]], call.timeout), {
    duration: Duration.millis(call.timeout), orElse: () => fail(new StripeUnavailable({ path, status: null }))
  })
  const seen = reply.filter((event) => event.type === type && event.livemode === live &&
    event.account == null && event.context == null && /^evt_[A-Za-z0-9]+$/.test(event.id) &&
    event.request?.idempotency_key === operationKey)
  const [event] = seen
  if (seen.length !== 1 || event === undefined || event.request?.id == null || !providerRequestId.test(event.request.id) ||
    !Number.isSafeInteger(event.created) || event.created < Math.floor(sentAt / 1000) || event.created > Math.floor(now / 1000)) return undefined
  return { ...event, requestId: event.request.id }
}

export effect function findUpgradeOrigin(terms: StripeUpgradeTerms, operationKey: string, call: StripeRead): (StripeUpgradeOrigin | undefined)!StripeFailure!StripeContext {
  const event = try operationEvent("invoice.created", terms.sentAt, operationKey, call)
  if (event === undefined) return undefined
  const invoice = decoded(StripeInvoice, event.data.object)
  if (invoice === undefined || !ownsUpgradeInvoice(invoice, terms, event.livemode, try Clock.currentTimeMillis) ||
    event.created < invoice.created) return undefined
  return { invoiceId: invoice.id, requestId: event.requestId }
}

export type StripeUndoTerms = Omit<StripeUpgradeTerms, "effectiveAt" | "dueNowCents">

function ownsUndo(subscription: typeof StripeSubscription.Type, terms: StripeUndoTerms, live: boolean): boolean {
  const [item] = subscription.items.data
  return subscription.id === terms.subscriptionId && subscription.customer === terms.binding.customerId &&
    subscription.livemode === live && subscription.status === "active" && !subscription.cancel_at_period_end &&
    (subscription.schedule ?? null) === terms.binding.scheduleId && !subscription.items.has_more &&
    subscription.items.data.length === 1 && item !== undefined && item.id === terms.binding.subscriptionItemId && item.quantity === 1 &&
    item.price.id === terms.binding.targetPriceId && item.current_period_start * 1000 === terms.periodStart &&
    item.current_period_end * 1000 === terms.periodEnd
}

export effect function dispatchPlanUndo(terms: StripeUndoTerms, mutation: StripeMutation): void!StripeFailure!StripeContext {
  const path = `/v1/subscriptions/${id(terms.subscriptionId)}`
  const response = try send({ method: "POST", path, ...mutation, params: [["cancel_at_period_end", "false"]] })
  const subscription = decoded(StripeSubscription, response.body)
  if (response.status !== 200 || response.requestId === undefined || !providerRequestId.test(response.requestId) ||
      response.idempotencyKey !== mutation.idempotencyKey || subscription === undefined || !ownsUndo(subscription, terms, try livemode()))
    throw new StripeInvalidResponse({ path, status: response.status })
}

export effect function findUndoOutcome(terms: StripeUndoTerms, operationKey: string, call: StripeRead): (LookupResult | undefined)!StripeFailure!StripeContext {
  const event = try operationEvent("customer.subscription.updated", terms.sentAt, operationKey, call)
  if (event === undefined) return undefined
  const subscription = decoded(StripeSubscription, event.data.object)
  return subscription !== undefined && ownsUndo(subscription, terms, event.livemode) ? { tag: "EffectSeen" } : undefined
}

export effect function upgradeInvoice(terms: StripeUpgradeTerms, origin: StripeUpgradeOrigin, call: StripeRead) {
  const invoice = try retrieveInvoice(origin.invoiceId, call)
  const live = try livemode()
  const now = try Clock.currentTimeMillis
  if (invoice.id !== origin.invoiceId || !ownsUpgradeInvoice(invoice, terms, live, now) ||
    invoice.lines.has_more || invoice.amount_due !== terms.dueNowCents ||
    !Number.isSafeInteger(invoice.amount_paid) || invoice.amount_paid < 0 ||
    (invoice.status === "paid" && invoice.amount_paid < invoice.amount_due) ||
    !proratedLinesFit(invoice.lines.data, terms.binding, terms.effectiveAt, terms.periodEnd))
    throw new StripeInvalidResponse({ path: "/v1/invoices", status: 200 })
  return invoice
}

export interface StripeUpgradeApplication {
  readonly periodStart: number
  readonly periodEnd: number
}

export effect function upgradedSubscription(terms: StripeUpgradeTerms, call: StripeRead) {
  const subscription = try retrieveSubscription(terms.subscriptionId, call)
  const [item] = subscription.items.data
  if (subscription.id !== terms.subscriptionId || subscription.customer !== terms.binding.customerId ||
    subscription.livemode !== try livemode() || subscription.status !== "active" || subscription.cancel_at_period_end ||
    subscription.items.has_more || subscription.items.data.length !== 1 || item === undefined ||
    item.id !== terms.binding.subscriptionItemId || item.price.id !== terms.binding.targetPriceId || item.quantity !== 1) return undefined
  const periodStart = item.current_period_start * 1000
  const periodEnd = item.current_period_end * 1000
  const originalPeriod = periodStart === terms.periodStart && periodEnd === terms.periodEnd
  if (!Number.isSafeInteger(periodStart) || !Number.isSafeInteger(periodEnd) || periodStart >= periodEnd ||
    periodStart > (try Clock.currentTimeMillis) || (!originalPeriod && periodStart < terms.periodEnd)) return undefined
  return { periodStart, periodEnd } satisfies StripeUpgradeApplication
}

export schema StripeScheduleBinding {
  readonly scheduleId: string
  readonly phaseDigest: string
  readonly currentProration: "none" | "create_prorations"
}

export interface StripeDowngradeTerms {
  readonly subscriptionId: string
  readonly binding: StripePlanBinding
  readonly periodStart: number
  readonly periodEnd: number
  readonly recurringCents: number
}

export type StripeScheduleEffect = "attach" | "configure"

export schema StripeScheduleOrigin { readonly scheduleId: string; readonly requestId: string }

const scheduleVersion = "2024-11-20.acacia"
const schedulePath = "/v1/subscription_schedules"
const scheduleIdPattern = /^sub_sched_[A-Za-z0-9]+$/

schema StripeSchedule {
  readonly id: string
  readonly status: string
  readonly subscription: string | null
  readonly released_subscription?: string | null
  readonly customer: string
  readonly livemode: boolean
  readonly end_behavior: string
  readonly default_settings?: Schema.Unknown
  readonly current_phase: { readonly start_date: number; readonly end_date: number } | null
  readonly phases: ReadonlyArray<Readonly<Record<string, Schema.Unknown>>>
}

function neutralSetting(value: unknown): boolean {
  return value == null || value === false || value === 0 || value === "" ||
    (typeof value === "object" && Object.keys(value).length === 0)
}

function currentPhaseSupported(phase: Readonly<Record<string, unknown>>, priceId: string, start: number, end: number): boolean {
  const row = decoded(Schema.Struct({
    start_date: Schema.Number, end_date: Schema.Number, items: Schema.Array(Schema.Record(Schema.String, Schema.Unknown))
  }), phase)
  const item = row?.items[0]
  return row !== undefined && row.start_date * 1000 === start && row.end_date * 1000 === end && row.items.length === 1 &&
    item !== undefined && item.price === priceId && item.quantity === 1 &&
    Object.entries(item).every(([key, value]) => key === "price" || key === "quantity" || (key === "plan" && value === priceId) || neutralSetting(value)) &&
    Object.entries(phase).every(([key, value]) =>
      key === "start_date" || key === "end_date" || key === "items" ||
      (key === "currency" && value === "usd") || (key === "proration_behavior" && (value === "none" || value === "create_prorations")) ||
      neutralSetting(value))
}

function scheduleOwns(schedule: StripeSchedule, terms: StripeDowngradeTerms, live: boolean): boolean {
  return scheduleIdPattern.test(schedule.id) && schedule.customer === terms.binding.customerId &&
    schedule.livemode === live && schedule.end_behavior === "release"
}

function scheduleBinds(schedule: StripeSchedule, terms: StripeDowngradeTerms, live: boolean): boolean {
  return scheduleOwns(schedule, terms, live) && schedule.status === "active" && schedule.subscription === terms.subscriptionId &&
    schedule.current_phase !== null && schedule.current_phase.start_date * 1000 === terms.periodStart &&
    schedule.current_phase.end_date * 1000 === terms.periodEnd
}

export effect function readScheduleToConfigure(terms: StripeDowngradeTerms, scheduleId: string, call: StripeRead) {
  const path = `${schedulePath}/${id(scheduleId)}`
  const schedule = try read(StripeSchedule, { method: "GET", path, timeout: call.timeout, params: [], apiVersion: scheduleVersion })
  const phase = schedule.phases[0]
  const currentProration = phase?.proration_behavior
  if (schedule.id !== scheduleId || !scheduleBinds(schedule, terms, try livemode()) ||
    schedule.phases.length !== 1 || phase === undefined || (currentProration !== "none" && currentProration !== "create_prorations") ||
    !currentPhaseSupported(phase, terms.binding.sourcePriceId, terms.periodStart, terms.periodEnd))
    throw new StripeInvalidResponse({ path, status: 200 })
  return { scheduleId, currentProration, phaseDigest: requestDigest({ phase, defaults: schedule.default_settings ?? null }) } satisfies StripeScheduleBinding
}

function downgradeParams(terms: StripeDowngradeTerms, binding: StripeScheduleBinding): Params {
  return [
    ["end_behavior", "release"], ["proration_behavior", "none"],
    ["phases[0][start_date]", seconds(terms.periodStart)], ["phases[0][end_date]", seconds(terms.periodEnd)],
    ["phases[0][proration_behavior]", binding.currentProration], ["phases[0][items][0][price]", terms.binding.sourcePriceId], ["phases[0][items][0][quantity]", "1"],
    ["phases[1][start_date]", seconds(terms.periodEnd)], ["phases[1][iterations]", "1"],
    ["phases[1][items][0][price]", terms.binding.targetPriceId], ["phases[1][items][0][quantity]", "1"],
    ["phases[1][proration_behavior]", "none"]
  ]
}

schema StripeSchedulePreview {
  readonly id: string
  readonly status: "draft"
  readonly customer: string
  readonly subscription: string
  readonly currency: "usd"
  readonly amount_due: number
  readonly amount_paid: number
  readonly livemode: boolean
  readonly lines: { readonly has_more: boolean; readonly data: ReadonlyArray<{
    readonly price: { readonly id: string }
    readonly quantity: number
    readonly amount: number
    readonly proration: boolean
    readonly period: { readonly start: number; readonly end: number }
  }> }
}

export effect function verifySchedulePreview(terms: StripeDowngradeTerms, binding: StripeScheduleBinding, call: StripeRead) {
  const path = "/v1/invoices/create_preview"
  const invoice = try read(StripeSchedulePreview, { method: "POST", path, timeout: call.timeout, apiVersion: scheduleVersion, params: [
    ["customer", terms.binding.customerId], ["schedule", binding.scheduleId], ["preview_mode", "next"],
    ...downgradeParams(terms, binding).filter(([key]) => key !== "proration_behavior").map(([key, value]) => {
      const field = key.indexOf("[")
      return [field === -1 ? `schedule_details[${key}]` : `schedule_details[${key.slice(0, field)}]${key.slice(field)}`, value] as const
    })
  ] })
  const [line] = invoice.lines.data
  if (invoice.customer !== terms.binding.customerId || invoice.subscription !== terms.subscriptionId ||
      invoice.livemode !== try livemode() || invoice.amount_due !== terms.recurringCents || invoice.amount_paid !== 0 ||
      !invoice.id.startsWith("upcoming_in_") || invoice.lines.has_more || invoice.lines.data.length !== 1 ||
      line === undefined || line.price.id !== terms.binding.targetPriceId || line.quantity !== 1 || line.proration ||
      line.amount !== terms.recurringCents || line.period.start * 1000 !== terms.periodEnd || line.period.end <= line.period.start)
    throw new StripeInvalidResponse({ path, status: 200 })
}

export effect function dispatchScheduleChange(terms: StripeDowngradeTerms, effectKind: StripeScheduleEffect, binding: StripeScheduleBinding | undefined, mutation: StripeMutation) {
  const path = effectKind === "attach" ? schedulePath : `${schedulePath}/${id(binding?.scheduleId ?? "")}`
  if ((effectKind === "configure") !== (binding !== undefined)) throw new StripeInvalidResponse({ path, status: 0 })
  const response = try send({ method: "POST", path, ...mutation, apiVersion: scheduleVersion,
    params: binding === undefined ? [["from_subscription", terms.subscriptionId]] : downgradeParams(terms, binding) })
  const schedule = decoded(StripeSchedule, response.body)
  if (response.status !== 200 || response.requestId === undefined || !providerRequestId.test(response.requestId) ||
    response.idempotencyKey !== mutation.idempotencyKey || schedule === undefined ||
    !scheduleBinds(schedule, terms, try livemode()) || (binding !== undefined && binding.scheduleId !== schedule.id))
    throw new StripeInvalidResponse({ path, status: response.status })
  return { scheduleId: schedule.id, requestId: response.requestId } satisfies StripeScheduleOrigin
}

export effect function recoverScheduleChange(terms: StripeDowngradeTerms, effectKind: StripeScheduleEffect, operationKey: string, sentAt: number, call: StripeRead) {
  const event = try operationEvent(effectKind === "attach" ? "subscription_schedule.created" : "subscription_schedule.updated", sentAt, operationKey, call)
  if (event === undefined) return undefined
  const schedule = decoded(StripeSchedule, event.data.object)
  return schedule !== undefined && scheduleBinds(schedule, terms, event.livemode)
    ? { scheduleId: schedule.id, requestId: event.requestId } satisfies StripeScheduleOrigin : undefined
}

export effect function configuredSchedule(terms: StripeDowngradeTerms, binding: StripeScheduleBinding, call: StripeRead) {
  const path = `${schedulePath}/${id(binding.scheduleId)}`
  const schedule = try read(StripeSchedule, { method: "GET", path, timeout: call.timeout, params: [], apiVersion: scheduleVersion })
  const [current, future] = schedule.phases
  const futureEnd = decoded(Schema.Number, future?.end_date)
  const live = try livemode()
  const now = try Clock.currentTimeMillis
  const activeTargetPhase = schedule.status === "active" && schedule.subscription === terms.subscriptionId &&
    schedule.current_phase !== null && schedule.current_phase.start_date * 1000 === terms.periodEnd &&
    schedule.current_phase.end_date === futureEnd
  const released = (schedule.status === "released" || schedule.status === "completed") &&
    schedule.released_subscription === terms.subscriptionId && schedule.current_phase === null &&
    futureEnd !== undefined && now >= futureEnd * 1000
  return schedule.id === binding.scheduleId && scheduleOwns(schedule, terms, live) && schedule.phases.length === 2 &&
    (scheduleBinds(schedule, terms, live) || (now >= terms.periodEnd && (activeTargetPhase || released))) &&
    current !== undefined && currentPhaseSupported(current, terms.binding.sourcePriceId, terms.periodStart, terms.periodEnd) &&
    requestDigest({ phase: current, defaults: schedule.default_settings ?? null }) === binding.phaseDigest &&
    future !== undefined && futureEnd !== undefined && futureEnd * 1000 > terms.periodEnd &&
    future.proration_behavior === "none" && currentPhaseSupported(future, terms.binding.targetPriceId, terms.periodEnd, futureEnd * 1000)
}

export effect function retrieveInvoice(invoiceId: string, call: StripeRead): StripeInvoice!StripeFailure!StripeContext {
  return try read(StripeInvoice, { method: "GET", path: `/v1/invoices/${id(invoiceId)}`, params: [], timeout: call.timeout })
}

export effect function retrieveCharge(chargeId: string, call: StripeRead): StripeCharge!StripeFailure!StripeContext {
  return try read(StripeCharge, { method: "GET", path: `/v1/charges/${id(chargeId)}`, params: [], timeout: call.timeout })
}

export function verifiedWebhookTime(raw: string, header: string, secret: string, now: number): number | undefined {
  const fields = header.split(",").map((field) => {
    const at = field.indexOf("=")
    return at === -1 ? ["", ""] as const : [field.slice(0, at).trim(), field.slice(at + 1).trim()] as const
  })
  const stamps = fields.filter(([name]) => name === "t").map(([, value]) => value)
  const stamp = stamps.length === 1 ? stamps[0] : undefined
  if (stamp === undefined || !/^\d{1,12}$/.test(stamp) || secret === "" || Math.abs(now - Number(stamp) * 1000) > webhookTolerance) return undefined
  const expected = signatureOf(secret, `${stamp}.${raw}`)
  return fields.filter(([name]) => name === "v1").reduce((matched, [, signature]) => sameText(signature, expected) || matched, false)
    ? Number(stamp) * 1000 : undefined
}

function refusalCode(failure: StripeRefused): string {
  if (failure.status === 404 || failure.code === "resource_missing") return "NotFoundAtProvider"
  if (failure.status === 401 || failure.status === 403) return "AuthorizationLost"
  return failure.code ?? failure.type
}

export function failureReply(failure: StripeFailure): ProviderReply<never> {
  switch (failure._tag) {
    case "StripeRefused": return { kind: "refused", code: refusalCode(failure) }
    case "StripeUnavailable": return { kind: "unknown", cause: `the provider did not answer ${failure.path} (${failure.status ?? "no status"})` }
    case "StripeInvalidResponse": return { kind: "unknown", cause: `the provider's answer to ${failure.path} could not be read (${failure.status})` }
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

export effect function providerReply<A, R>(call: A!StripeFailure!R): ProviderReply<A>!!R {
  return try Effect.match(call, {
    onFailure: (failure): ProviderReply<A> => failureReply(failure),
    onSuccess: (value): ProviderReply<A> => ({ kind: "applied", value })
  })
}
