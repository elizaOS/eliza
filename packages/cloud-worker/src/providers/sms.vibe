// spec/cloud/identity/codeChallenges.md, "A challenge sends one code, only to an email address or to a phone in a country the deployment allows"; spec/cloud/deployment.md, "A sign-in method is offered only when its adapter is configured"
import { HttpClientRequest } from "effect/http"
import { refused, type Refused } from "../http/refusal.vibe"
import { Deployment } from "@elizaos/cloud"
import { keepLoopback, posted, type DeliveryContext } from "./delivery.vibe"

export interface Sms {
  readonly to: string
  readonly text: string
}

export effect function deliverSms(sms: Sms): void!Refused!DeliveryContext {
  const deployment = try Deployment
  const adapter = deployment.settings.sms
  switch (adapter.kind) {
    case "none":
      throw refused("ProviderUnavailable")
    case "loopback":
      return try keepLoopback(sms.to, sms.text)
    case "https": {
      const account = deployment.secret(adapter.accountEnv) catch effect () => { throw refused("ProviderUnavailable") }
      const token = deployment.secret(adapter.tokenEnv) catch effect () => { throw refused("ProviderUnavailable") }
      const form = new URLSearchParams({ To: sms.to, From: adapter.from, Body: sms.text })
      return try posted(HttpClientRequest.post(adapter.url).pipe(
        HttpClientRequest.basicAuth(account, token),
        HttpClientRequest.bodyText(form.toString(), "application/x-www-form-urlencoded")
      ))
    }
  }
}
