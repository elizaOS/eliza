// spec/cloud/shared/types.md, "Story: Speak one refusal language"
import { Deployment, type SecretMissing } from "@elizaos/cloud"

module node {
  import { createCipheriv, createDecipheriv, createHmac, randomBytes } from "node:crypto"

  /** @throws {never} */
  export function hmacHex(key: string, text: string): string {
    return createHmac("sha256", key).update(text, "utf8").digest("hex")
  }

  /** @throws {unknown} */
  export function sealWith(key: string, purpose: string, plaintext: string): { iv: string; tag: string; data: string } {
    const secret = Buffer.from(key, "base64")
    if (secret.length !== 32) throw new RangeError("a sealing key is 32 bytes, base64")
    const iv = randomBytes(12)
    const cipher = createCipheriv("aes-256-gcm", secret, iv)
    cipher.setAAD(Buffer.from(purpose, "utf8"))
    const data = Buffer.concat([cipher.update(plaintext, "utf8"), cipher.final()])
    return { iv: iv.toString("base64url"), tag: cipher.getAuthTag().toString("base64url"), data: data.toString("base64url") }
  }

  /** @throws {unknown} */
  export function unsealWith(key: string, purpose: string, iv: string, tag: string, data: string): string {
    const decipher = createDecipheriv("aes-256-gcm", Buffer.from(key, "base64"), Buffer.from(iv, "base64url"))
    decipher.setAAD(Buffer.from(purpose, "utf8"))
    decipher.setAuthTag(Buffer.from(tag, "base64url"))
    return Buffer.concat([decipher.update(Buffer.from(data, "base64url")), decipher.final()]).toString("utf8")
  }
}
import { hmacHex, sealWith, unsealWith } from node
export { sealWith, unsealWith }
export { newId, secretText, tokenDigest, sameText, sha256Hex } from "./credential-crypto.vibe"

export type SealPurpose = "device-key" | "google-tokens" | "gmail-arrival" | "totp-secret" | "provider-secret"

export error SealingFailed { purpose: SealPurpose; cause: unknown }

export effect function keyedDigest(text: string): string!SecretMissing!Deployment {
  const deployment = try Deployment
  return hmacHex(try deployment.secret(deployment.settings.digestKeyEnv), text)
}

export effect function seal(purpose: SealPurpose, plaintext: string): string!(SecretMissing | SealingFailed)!Deployment {
  const deployment = try Deployment
  const { currentKeyId, keys } = deployment.settings.sealing
  const entry = keys.find((key) => key.keyId === currentKeyId)
  if (entry === undefined) throw new SealingFailed({ purpose, cause: `no sealing key ${currentKeyId}` })
  const key = try deployment.secret(entry.env)
  const sealed = try Effect.try({ try: () => sealWith(key, purpose, plaintext), catch: (cause) => new SealingFailed({ purpose, cause }) })
  return ["v1", currentKeyId, sealed.iv, sealed.tag, sealed.data].join(".")
}

export effect function unseal(purpose: SealPurpose, sealed: string): string!(SecretMissing | SealingFailed)!Deployment {
  const deployment = try Deployment
  const [version, keyId, iv, tag, data] = sealed.split(".")
  const entry = deployment.settings.sealing.keys.find((key) => key.keyId === keyId)
  if (version !== "v1" || entry === undefined || iv === undefined || tag === undefined || data === undefined) {
    throw new SealingFailed({ purpose, cause: "not a sealed value of this deployment" })
  }
  const key = try deployment.secret(entry.env)
  return try Effect.try({ try: () => unsealWith(key, purpose, iv, tag, data), catch: (cause) => new SealingFailed({ purpose, cause }) })
}
