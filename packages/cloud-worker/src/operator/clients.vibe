// spec/cloud/operator.md, "Story: Operate the deployment without reading secrets"; spec/cloud/nativeClients/registry.md, "Story: Admit only a registered native client"; spec/cloud/nativeClients/registry.md, "Story: Apply my app's registration from its reviewed file"
import { applyAction, defaultCredentialTtl, fileCheck, withRegistration, type ApplyAction, type Registration, type ReturnUrl } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import { millisPerDay } from "../../gen/cloud__shared__types.effect.vibe"
import { decodeRegistration, disableClient, readClient, readRegistry, registerClient, updateClient } from "../native-clients/registry.vibe"
import { registrationText } from "../native-registry.vibe"
import { Deployment } from "@elizaos/cloud"
import { sha256Hex } from "../shared/credential-crypto.vibe"
import type { Tx } from "../store/store.vibe"
import type { OperatorCommandHandler, OperatorDocument, OperatorFlags } from "./admin.vibe"

error ClientFlagsInvalid { problem: string }
error ClientUnknown { clientId: string }

interface RegistrationInput {
  readonly clientId: string
  readonly environment: "production" | "staging"
  readonly displayName: string
  readonly androidPackage: string
  readonly certFingerprints: ReadonlyArray<string>
  readonly signInReturn: string
  readonly billingReturn: string
  readonly connectReturn?: string
  readonly credentialTtlMs: number
  readonly nativeGoogle: boolean
  readonly enabled: boolean
}

const ClientEntry = Schema.Struct({
  clientId: Schema.String,
  displayName: Schema.String,
  androidPackage: Schema.String,
  certFingerprints: Schema.Array(Schema.String),
  signInReturn: Schema.String,
  billingReturn: Schema.String,
  connectReturn: Schema.optionalKey(Schema.String),
  credentialTtlDays: Schema.optionalKey(Schema.Int),
  nativeGoogle: Schema.optionalKey(Schema.Boolean),
  enabled: Schema.optionalKey(Schema.Boolean)
})
const SeedClients = Schema.Array(ClientEntry)
const RegistrationFile = Schema.Struct({
  environment: Schema.Literals(["production", "staging"]),
  clients: Schema.Array(ClientEntry)
})

interface ClientReceipt {
  readonly clientId: string
  readonly action: "registered" | "updated" | "unchanged"
  readonly registration: string
}

interface ApplyReceipt {
  readonly receipt: "client-apply"
  readonly environment: "production" | "staging"
  readonly database: string
  readonly file: string
  readonly appliedAt: number
  readonly clients: ReadonlyArray<ClientReceipt>
}

const receiptAction: Readonly<Record<ApplyAction, ClientReceipt["action"]>> = {
  AppliedNew: "registered",
  AppliedChanged: "updated",
  AppliedSame: "unchanged"
}

const valued = ["client-id", "display-name", "android-package", "sign-in-return", "billing-return", "connect-return", "credential-ttl-days"] as const
const repeated = ["cert"] as const
const switches = ["native-google"] as const

function urlText(url: ReturnUrl): string {
  return url.origin + url.path
}

function inputOf(registration: Registration): RegistrationInput {
  return {
    clientId: registration.clientId,
    environment: registration.environment === "Production" ? "production" : "staging",
    displayName: registration.displayName,
    androidPackage: registration.androidPackage,
    certFingerprints: registration.certFingerprints,
    signInReturn: urlText(registration.signInReturn),
    billingReturn: urlText(registration.billingReturn),
    ...(registration.connectReturn.tag === "ConnectsTo" ? { connectReturn: urlText(registration.connectReturn.url) } : {}),
    credentialTtlMs: registration.credentialTtl,
    nativeGoogle: registration.nativeGoogle,
    enabled: registration.enabled
  }
}

effect function ttlMs(days: string | number | undefined): number!ClientFlagsInvalid {
  if (days === undefined) return defaultCredentialTtl
  const count = typeof days === "number" ? days : /^\d{1,3}$/.test(days) ? Number(days) : Number.NaN
  if (!Number.isSafeInteger(count)) throw new ClientFlagsInvalid({ problem: "--credential-ttl-days must be a whole number of days" })
  return count * millisPerDay
}

function single(flags: OperatorFlags, name: string): string | undefined {
  return flags.values(name)[0]
}

effect function needed(flags: OperatorFlags, name: string): string!ClientFlagsInvalid {
  const value = single(flags, name)
  if (value === undefined) throw new ClientFlagsInvalid({ problem: `--${name} is required` })
  return value
}

effect function served() {
  return (try Deployment).environment
}

effect function registerFromFlags(tx: Tx, flags: OperatorFlags, now: number) {
  const connectReturn = single(flags, "connect-return")
  const input: RegistrationInput = {
    clientId: try needed(flags, "client-id"),
    environment: try served(),
    displayName: try needed(flags, "display-name"),
    androidPackage: try needed(flags, "android-package"),
    certFingerprints: flags.values("cert"),
    signInReturn: try needed(flags, "sign-in-return"),
    billingReturn: try needed(flags, "billing-return"),
    ...(connectReturn === undefined ? {} : { connectReturn }),
    credentialTtlMs: try ttlMs(single(flags, "credential-ttl-days")),
    nativeGoogle: flags.has("native-google"),
    enabled: true
  }
  const registration = try registerClient(tx, try decodeRegistration(input), now)
  return [`registered ${registration.clientId} (${input.environment})`]
}

effect function updateFromFlags(tx: Tx, flags: OperatorFlags, now: number) {
  const clientId = try needed(flags, "client-id")
  const current = try readClient(tx, clientId)
  if (current === undefined) throw new ClientUnknown({ clientId })
  const before = inputOf(current)
  const connectReturn = single(flags, "connect-return") ?? before.connectReturn
  const days = single(flags, "credential-ttl-days")
  const given = flags.values("cert")
  const input: RegistrationInput = {
    ...before,
    displayName: single(flags, "display-name") ?? before.displayName,
    androidPackage: single(flags, "android-package") ?? before.androidPackage,
    certFingerprints: given.length === 0 ? before.certFingerprints : given,
    signInReturn: single(flags, "sign-in-return") ?? before.signInReturn,
    billingReturn: single(flags, "billing-return") ?? before.billingReturn,
    ...(connectReturn === undefined ? {} : { connectReturn }),
    credentialTtlMs: days === undefined ? before.credentialTtlMs : try ttlMs(days),
    nativeGoogle: flags.has("native-google") || before.nativeGoogle
  }
  const registration = try updateClient(tx, try decodeRegistration(input), now)
  return [`updated ${registration.clientId} (${input.environment})`]
}

effect function disableFromFlags(tx: Tx, flags: OperatorFlags, now: number) {
  const clientId = try needed(flags, "client-id")
  try disableClient(tx, clientId, now)
  return [`disabled ${clientId}`]
}

effect function entryRegistration(entry: typeof ClientEntry.Type, environment: "production" | "staging") {
  const { credentialTtlDays, nativeGoogle, enabled, ...rest } = entry
  const input: RegistrationInput = {
    ...rest,
    environment,
    credentialTtlMs: try ttlMs(credentialTtlDays),
    nativeGoogle: nativeGoogle ?? false,
    enabled: enabled ?? true
  }
  return try decodeRegistration(input)
}

type SeedClientFailure =
  | ClientFlagsInvalid
  | Effect.Error<ReturnType<typeof entryRegistration>>
  | Effect.Error<ReturnType<typeof registerClient>>

export effect function seedClients(tx: Tx, entries: unknown, now: number): string[]!SeedClientFailure!Deployment {
  const parsed = try Effect.mapError(
    Schema.decodeUnknownEffect(SeedClients, { onExcessProperty: "error" })(entries),
    (error) => new ClientFlagsInvalid({ problem: `seed clients: ${error.message}` })
  )
  const environment = try served()
  const registered: string[] = []
  for (const entry of parsed) {
    const registration = try registerClient(tx, try entryRegistration(entry, environment), now)
    registered.push(registration.clientId)
  }
  return registered
}

effect function applyFile(tx: Tx, _flags: OperatorFlags, now: number, _verdict: unknown, document: OperatorDocument | undefined) {
  if (document === undefined) throw new ClientFlagsInvalid({ problem: "client apply needs --file" })
  const file = try Effect.mapError(
    Schema.decodeUnknownEffect(RegistrationFile, { onExcessProperty: "error" })(document.value),
    (error) => new ClientFlagsInvalid({ problem: `registration file: ${error.message}` })
  )
  const deployment = try Deployment
  const environment = deployment.environment
  const wire = (value: "production" | "staging") => value === "production" ? "Production" as const : "Staging" as const
  const checked = fileCheck(wire(file.environment), wire(environment), file.clients.map((entry) => entry.clientId))
  if (checked === "FileForOtherEnvironment") throw new ClientFlagsInvalid({ problem: `the file registers ${file.environment} clients and this command serves ${environment}` })
  if (checked === "FileRepeatsClient") throw new ClientFlagsInvalid({ problem: "the file names a client id more than once" })
  try tx.query("LOCK TABLE native_clients IN SHARE ROW EXCLUSIVE MODE")
  let registry: ReadonlyArray<Registration> = try readRegistry(tx)
  const clients: ClientReceipt[] = []
  for (const entry of file.clients) {
    const registration = try entryRegistration(entry, environment)
    const action = applyAction([...registry], registration)
    if (action !== "AppliedSame") try registerClient(tx, registration, now)
    registry = withRegistration([...registry], registration)
    clients.push({ clientId: registration.clientId, action: receiptAction[action], registration: `sha256:${sha256Hex(registrationText(registration))}` })
  }
  const receipt: ApplyReceipt = {
    receipt: "client-apply", environment, database: deployment.settings.databaseIdentity, file: document.digest, appliedAt: now, clients
  }
  return [JSON.stringify(receipt)]
}

export const commands: ReadonlyArray<OperatorCommandHandler> = [
  { words: ["client", "register"], operatorCommand: "RegisterClient", valued, repeated, switches, run: registerFromFlags },
  { words: ["client", "update"], operatorCommand: "RegisterClient", valued, repeated, switches, run: updateFromFlags },
  { words: ["client", "apply"], operatorCommand: "RegisterClient", valued: ["file"], repeated: [], switches: [], document: "file", run: applyFile },
  { words: ["client", "disable"], operatorCommand: "DisableClient", valued: ["client-id"], repeated: [], switches: [], run: disableFromFlags }
]
