// spec/cloud/client.md, "Story: Tell an account that needs attention from a failing service"
import { assert, describe, it } from "@effect/vitest"
import { addCredits } from "../src/billing/funds.vibe"
import { Store } from "../src/store/store.vibe"
import { check, testCloud } from "./support/cloud.vibe"
import { signedIn } from "./support/identity-fixture.ts"
import { accountUsable, creditFromSnapshot, grantFromSnapshot, planFromSnapshot, redeemFailureForStatus, redeemResultFromResponse, snapshotFromResponse, subscriptionView } from "@elizaos/cloud"
import { CloudError } from "@elizaos/cloud"

describe("Cloud account views (spec/cloud/client.md, \"Story: Tell an account that needs attention from a failing service\")", () => {
  it.live("Read a free and a granted account from the snapshots the cloud answers, and refuse a snapshot of another version", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "views@example.com")
    const headers = { authorization: `Bearer ${signed.accessToken}` }
    const free = try snapshotFromResponse((try cloud.call("/api/v1/billing/limits", { headers })).body)
    provide Store = cloud.store {
      try addCredits({ organizationId: signed.organizationId, amount: 2_000_000, requestKey: "views-credits" })
    }
    try cloud.store.transaction((tx) => tx.query("INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('g1', $1, 'pilot', 'plus_monthly', $2, $3, $2)", [signed.organizationId, now - 1000, now + 600_000]))
    const granted = try snapshotFromResponse((try cloud.call("/api/v1/billing/limits", { headers })).body)
    const bad = try Effect.flip(snapshotFromResponse({ data: { ...free, schemaVersion: 2 } }))
    const redeemed = try redeemResultFromResponse({ replayed: true, grant: granted.grant, entitlement: { plan: granted.plan } }, now)
    const refusal = redeemFailureForStatus(new CloudError({ failure: { tag: "CloudRefused", code: "SubscriptionGrantPaidPlanActive" } as never, cause: null }))
    try check(() => assert.deepStrictEqual(
      {
        free: [accountUsable(free), planFromSnapshot(free), creditFromSnapshot(free, now).kind, grantFromSnapshot(free, now).kind],
        granted: [accountUsable(granted), planFromSnapshot(granted), creditFromSnapshot(granted, now).kind, grantFromSnapshot(granted, now).kind, subscriptionView(granted, now).admission],
        bad: bad.failure.tag,
        redeemed: [redeemed.kind, redeemed.kind === "redeemed" && redeemed.replayed],
        refusal
      },
      {
        free: [false, { tag: "PlanNone" }, "zero", "none"],
        granted: [true, { tag: "PlanPaid", planKey: "PlusMonthly", warning: false }, "funded", "active", "Admit"],
        bad: "CloudProviderIssue",
        redeemed: ["redeemed", true],
        refusal: { kind: "PaidPlanActive" }
      }
    ))
  }))
})
