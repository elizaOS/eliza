// spec/cloud/identity/sessions.md, "Story: Admit a request only for a live credential of an active account"; spec/cloud/identity/sessions.md, "Story: Keep a tablet signed in to mail and calendar"
import { activateLease, offerLease } from "../../src/identity/sessions.vibe"
import { tokenDigest } from "../../src/shared/sealing.vibe"
import type { Tx } from "../../src/store/connection.vibe"
import { organization, type TestCloud } from "./cloud.vibe"
import { legacyGrant } from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"

interface SignedCaller {
  readonly bearer: string
  readonly organizationId: string
  readonly userId: string
  readonly credentialId: string
  readonly headers: Readonly<Record<string, string>>
}

export effect function signedCaller(cloud: TestCloud, name: string) {
  const now = try Clock.currentTimeMillis
  const token = `eliza_mobile_${tokenDigest(`caller-${name}`)}`
  const organizationId = `org-${name}`
  const userId = `user-${name}`
  const credentialId = `cred-${name}`
  const grant = legacyGrant({ phase: "OldActive", client: { tag: "UnrecordedClient" }, codeExpiresAt: now - 1000, credentialTtl: 0, credentialId, keyExpiresAt: now + 24 * 3_600_000, epoch: 0, now })
  try organization(cloud, organizationId)
  try cloud.store.transaction(effect (tx: Tx) => {
    try tx.query("INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'active', $3, $4, $4)", [userId, organizationId, `${name}@example.com`, now])
    try tx.query(
      "INSERT INTO device_grants (key, state, revision, user_id, client_id, phase, credential_id, secret_digest, code_expires_at, key_expires_at, issued_at, updated_at) VALUES ($1, $7::jsonb, 1, $2, 'test-client', 'active', $3, $4, $5, $6, $5, $5)",
      [`grant-${name}`, userId, credentialId, tokenDigest(token), now - 1000, now + 24 * 3_600_000, JSON.stringify(grant)]
    )
  })
  const caller: SignedCaller = { bearer: token, organizationId, userId, credentialId, headers: { authorization: `Bearer ${token}` } }
  return caller
}

export effect function leasedCaller(cloud: TestCloud, name: string) {
  const caller = try signedCaller(cloud, name)
  const now = try Clock.currentTimeMillis
  const refresh = try cloud.store.transaction(effect (tx: Tx) => {
    const offered = try offerLease(tx, { userId: caller.userId, grantKey: `grant-${name}`, now })
    try activateLease(tx, `grant-${name}`, now)
    return offered.refresh
  })
  const pair = try cloud.call("/api/v1/app-auth/mobile/lease", { method: "POST", headers: { authorization: `Bearer ${refresh}` } })
  const access = (pair.body as { readonly access: string }).access
  const leased: SignedCaller & { readonly deviceKey: string } = { ...caller, bearer: access, headers: { authorization: `Bearer ${access}` }, deviceKey: caller.bearer }
  return leased
}
