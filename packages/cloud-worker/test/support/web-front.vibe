// spec/cloud/returnPages.md, "A return URL on the web origin shows ReturnToApp only for the one enabled registration of the served environment that holds it"; spec/cloud/nativeClients/registry.md, "A return URL names at most one enabled registration and purpose, and the cloud serves it only on the environment's web origin"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import seed from "../fixtures/seed.json" with { type: "json" }
import { testCloud } from "./cloud.vibe"

module node {
  import { createServer, request } from "node:http"

  /** @throws {unknown} */
  export async function frontDoor(upstream: URL, webHost: string) {
    const front = createServer((incoming, outgoing) => {
      const target = new URL(incoming.url ?? "/", upstream)
      const headers = Object.fromEntries(Object.entries(incoming.headers).filter(([name]) =>
        name !== "host" && name !== "forwarded" && !name.startsWith("x-forwarded-")))
      const forwarded = request(upstream, {
        method: incoming.method,
        path: `${target.pathname}${target.search}`,
        headers: { ...headers, host: upstream.host, "x-forwarded-host": webHost, "x-forwarded-proto": "https" }
      }, (answer) => {
        outgoing.writeHead(answer.statusCode ?? 502, answer.headers)
        answer.pipe(outgoing)
      })
      forwarded.on("error", () => {
        if (outgoing.headersSent) outgoing.destroy()
        else outgoing.writeHead(502).end()
      })
      outgoing.on("close", () => forwarded.destroy())
      incoming.pipe(forwarded)
    })
    await new Promise<void>((resolve, reject) => front.once("error", reject).listen(0, "127.0.0.1", resolve))
    const address = front.address()
    if (address === null || typeof address === "string") throw new Error("Expected a TCP listener")
    return { port: address.port, close: () => new Promise<void>((resolve) => {
      front.close(() => resolve())
      front.closeAllConnections()
    }) }
  }
}
import { frontDoor } from node

export error FrontDoorFailed { upstream: string }

const fixtureReturn = new URL(seed.clients[0]?.signInReturn ?? "")
const fixtureState = "AbCdEfGhIjKlMnOpQrStUvWxYz0123456789_-abcde"

effect function main() {
  const cloud = try testCloud({ seed: "test/fixtures/seed.json" })
  const front = try acquireRelease(
    tryPromise({ try: () => frontDoor(new URL(cloud.url), fixtureReturn.host), catch: () => new FrontDoorFailed({ upstream: cloud.url }) }),
    (listener) => promise(() => listener.close())
  )
  const local = `http://127.0.0.1:${front.port}${fixtureReturn.pathname}?state=${fixtureState}`
  try annotateLogs(logInfo("serving the web origin"), { url: local, returnUrl: fixtureReturn.href })
  try never
}

NodeRuntime.runMain(Effect.provide(Effect.scoped(main()), NodeServices.layer))
