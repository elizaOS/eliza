  it.live("Trash a message as reviewed, lose Google's reply, and learn by lookup that it succeeded once (spec/cloud/services/google/mailOperations.md, \"Story: Change or send from my mailbox once, as I reviewed it\"; spec/cloud/shared/dispatchOnce.md, \"Story: Send a change once and recover its outcome without sending it again\")", () => scoped(effect {
    const { mailbox, switches, operation, grantId } = try mailOperationSetup("ops-trash", sessionMailCaller("ops-trash"))
    const requestId = "6f1c2a3b-4d5e-4f60-8a7b-1c2d3e4f5a6b"
    const proposal = { kind: "trash", messageId: "msg-plan", expectedHistoryId: "1001" }
    const prepared = try operation("", { grantId, requestId, proposal })
    const reviewDigest = (prepared.body as OperationAnswer).receipt.reviewDigest
    const again = try operation("", { grantId, requestId, proposal })
    const otherKind = try operation("", { grantId, requestId, proposal: { ...proposal, kind: "archive" } })
    const wrongDigest = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest: "0".repeat(64), proposal })
    try check(() => assert.deepStrictEqual(switches.calls, []))
    switches.dropNextReply = true
    const lost = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    const looked = try operation(`/${requestId}?grantId=${grantId}`)
    const replayed = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    const unknown = try operation(`/9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d?grantId=${grantId}`)
    const trashed = mailbox.messages.get("msg-plan")
    try check(() => assert.deepStrictEqual(
      {
        prepared: [prepared.status, receiptOf(prepared), (prepared.body as OperationAnswer).review, (prepared.body as OperationAnswer).providerExactlyOnce, (prepared.body as OperationAnswer).version],
        again: [again.status, (again.body as OperationAnswer).receipt.reviewDigest === reviewDigest, receiptOf(again)],
        otherKind: errorOf(otherKind),
        wrongDigest: errorOf(wrongDigest),
        lost: [lost.status, receiptOf(lost)],
        looked: [looked.status, receiptOf(looked), (looked.body as OperationAnswer).receipt.providerResult],
        replayed: [replayed.status, receiptOf(replayed)],
        unknown: errorOf(unknown),
        mailbox: [trashed?.labelIds, switches.calls.filter((call) => call.path === "/messages/msg-plan/trash").length]
      },
      {
        prepared: [200, ["trash", "prepared", null, false, false], { kind: "trash", messageId: "msg-plan", expectedHistoryId: "1001", from: "ops-ops-trash@example.com" }, false, 1],
        again: [200, true, ["trash", "prepared", null, false, false]],
        otherKind: [409, "idempotency_conflict"],
        wrongDigest: [409, "stale_revision"],
        lost: [200, ["trash", "outcome-unknown", null, true, false]],
        looked: [200, ["trash", "succeeded", null, true, true], { messageId: "msg-plan", threadId: "thr-plan", labelIds: ["UNREAD", "TRASH"], historyId: "1002" }],
        replayed: [200, ["trash", "succeeded", null, true, true]],
        unknown: [404, "not_found"],
        mailbox: [["UNREAD", "TRASH"], 1]
      }
    ))
  }))

  it.live("Send a message with an attachment once though the dispatch is replayed, and refuse a forward at a stale history id (spec/cloud/services/google/mailOperations.md, \"Story: Change or send from my mailbox once, as I reviewed it\"; spec/cloud/services/google/mailRead.md, \"Story: Read my mail through the grant I chose\")", () => scoped(effect {
    const { mailbox, switches, operation, grantId } = try mailOperationSetup("ops-send", sessionMailCaller("ops-send"))
    const requestId = "1b2c3d4e-5f60-4a7b-8c9d-0e1f2a3b4c5d"
    const note = btoa("Agenda for Monday")
    const proposal = { kind: "send", mode: "compose", to: ["ada@example.org"], subject: "Agenda", bodyText: "See the note.", attachments: [{ name: "agenda.txt", mimeType: "text/plain", dataBase64: note }] }
    const prepared = try operation("", { grantId, requestId, proposal })
    const reviewDigest = (prepared.body as OperationAnswer).receipt.reviewDigest
    const changed = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal: { ...proposal, bodyText: "Something else." } })
    try check(() => assert.deepStrictEqual(switches.calls, []))
    const sent = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    try check(() => assert.equal(sent.status, 200, JSON.stringify(sent.body)))
    const replayed = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    const looked = try operation(`/${requestId}?grantId=${grantId}`)
    const sends = switches.calls.filter((call) => call.path === "/messages/send").length
    const outgoing = try Effect.try(() => sentTexts(mailbox))
    const raw = outgoing[0] ?? ""
    const forward = (historyId: string) => ({ kind: "send", mode: "forward", to: ["grace@example.org"], subject: "Fwd: Quarterly plan", bodyText: "Forwarding the plan.", forwardAttachments: { messageId: "msg-plan", historyId, partIds: ["1"] } })
    const forwarded = try operation("", { grantId, requestId: "2c3d4e5f-6071-4b8c-9d0e-1f2a3b4c5d6e", proposal: forward("1001") })
    try Effect.try(() => touchMessage(mailbox, "msg-plan"))
    const stale = try operation("", { grantId, requestId: "3d4e5f60-7182-4c9d-8e1f-2a3b4c5d6e7f", proposal: forward("1001") })
    const review = (prepared.body as OperationAnswer).review as { readonly to: ReadonlyArray<string>; readonly attachments: ReadonlyArray<unknown> }
    try check(() => assert.deepStrictEqual(
      {
        prepared: [prepared.status, receiptOf(prepared), review.to, review.attachments],
        changed: errorOf(changed),
        sent: [sent.status, receiptOf(sent), ((sent.body as OperationAnswer).receipt.providerResult as { readonly labelIds: ReadonlyArray<string> }).labelIds],
        replayed: [replayed.status, receiptOf(replayed), (replayed.body as OperationAnswer).receipt.providerResult === null],
        looked: [looked.status, receiptOf(looked)],
        once: [sends, outgoing.length, raw.includes(`Message-ID: <eliza-${requestId}@message.invalid>`), raw.includes(`filename*=UTF-8''agenda.txt`), raw.includes(note)],
        forwarded: [forwarded.status, receiptOf(forwarded), ((forwarded.body as OperationAnswer).review as { readonly forwardedAttachments: ReadonlyArray<{ readonly name: string }> }).forwardedAttachments.map((file) => file.name)],
        stale: errorOf(stale)
      },
      {
        prepared: [200, ["send", "prepared", null, false, false], ["ada@example.org"], [{ name: "agenda.txt", mimeType: "text/plain", size: 17, sha256: sha256Hex("Agenda for Monday") }]],
        changed: [409, "stale_revision"],
        sent: [200, ["send", "succeeded", null, true, true], ["SENT"]],
        replayed: [200, ["send", "succeeded", null, true, true], false],
        looked: [200, ["send", "succeeded", null, true, true]],
        once: [1, 1, true, true, true],
        forwarded: [200, ["send", "prepared", null, false, false], ["plan.pdf"]],
        stale: [409, "stale_revision"]
      }
    ))
  }), 30_000)
})

type OperationAnswer = {
  readonly version: number
  readonly providerExactlyOnce: boolean
  readonly review?: unknown
  readonly receipt: { readonly kind: string; readonly state: string; readonly reviewDigest: string; readonly rejectionCode: string | null; readonly providerResult: unknown; readonly createdAt: string; readonly dispatchedAt: string | null; readonly finishedAt: string | null }
}

function receiptOf(answer: { readonly body: unknown }): ReadonlyArray<unknown> {
  const receipt = (answer.body as OperationAnswer).receipt
  return [receipt.kind, receipt.state, receipt.rejectionCode, receipt.dispatchedAt !== null, receipt.finishedAt !== null]
}

function sessionMailCaller(name: string) {
  return (cloud: TestCloud, now: number) => effect {
    const owner = try signedCaller(cloud, name)
    const session = try cloud.store.transaction((tx) => issueSession(tx, { ...owner, assurance: "SingleFactor", accountCreated: false, now }))
    const caller: MailCaller = { token: session.accessToken, owner: { organizationId: owner.organizationId, userId: owner.userId } }
    return caller
  }
}

effect function grantRefusal<A, E extends { readonly _tag: string }, R>(program: A!E!R): string!!R {
  return match (try exit(program)) {
    when Exit.Success: "granted";
    when Exit.Failure(let cause): Cause.findErrorOption(cause).pipe(Option.map((error) => "refusal" in error ? (refusalBody(error.refusal as Parameters<typeof refusalBody>[0]).reason ?? refusalBody(error.refusal as Parameters<typeof refusalBody>[0]).error) : error._tag), Option.getOrElse(() => "defect"));
  }
}

describe("WP8 Managed Google: grant access (spec/cloud/services/google/connection.md)", () => {
  it.live("See my Google connection and list only my accounts (spec/cloud/services/google/connection.md, \"Story: See my Google connection as the cloud holds it\")", () => scoped(effect {
    const clock = try sync(() => manualClock())
    const start = 1_800_000_000_000
    try sync(() => clock.set(start))
    provide Clock.Clock = clock.clock {
    const google = try sync(() => googleFakeState())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", mountGoogleToken(google)) })
    const caller = try leasedCaller(cloud, "google-status")
    const other = try signedCaller(cloud, "google-status-other")
    const session = try cloud.store.transaction((tx) => issueSession(tx, { ...caller, assurance: "SingleFactor", accountCreated: false, now: start }))
    const sibling = { organizationId: caller.organizationId, userId: other.userId }
    const path = "/api/v1/eliza/google"
    const read = (tail: string) => cloud.call(`${path}/${tail}`, { headers: caller.headers })
    const client = try sync(() => createCloudClient({ baseUrl: cloud.url, credential: () => session.accessToken }))
    const clientStatus = () => promise(() => client.googleStatus())
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage"), "https://www.googleapis.com/auth/contacts.readonly"]
    const expiry = start + 1000
    const link = (tx: Tx, owner: Owner, connectionId: string) => storeGrant(tx, {
      connectionId, owner, subject: `subject-${connectionId}`, email: `${connectionId}@example.com`, grantedScopes: scopes,
      tokens: { accessToken: `access-${connectionId}`, refreshToken: "", expiresAt: expiry }, now: start
    })
    const missing = try clientStatus()
    const unauthorized = try cloud.call(`${path}/accounts`)
    try cloud.inside(cloud.store.transaction(effect (tx: Tx) => {
      try link(tx, caller, "status-live")
      try link(tx, other, "status-foreign")
      try link(tx, sibling, "status-sibling")
    }))
    const [live, accounts, foreign, sameOrg, wrongSide, unsupportedConsent] = try all([
      clientStatus(), read("accounts?side=owner"), read("status?grantId=status-foreign"),
      read("status?grantId=status-sibling"), read("accounts?side=agent"), read("status?purpose=personal_google_context_v1")
    ], { concurrency: "unbounded" })
    try sync(() => clock.set(expiry))
    const lapsed = try clientStatus()

    const sealed = try cloud.inside(sealTokens({ accessToken: "legacy-access", refreshToken: "legacy-refresh", expiresAt: expiry }))
    for (const [key, tokens, linked] of [["verified-old", sealed, start + 100], ["unverified-old", "bad", start + 200]] as const) {
      const legacy = { status: "Active", scopes, tokens, expiresAt: expiry, refreshingUntil: 0 }
      try sql(cloud, `INSERT INTO google_connections (key, state, revision, organization_id, user_id, subject, email, status, tokens, granted_scopes, expires_at, linked_at, last_used_at) VALUES ($1, $2::jsonb, 1, $3, $4, $1, $5, 'Active', $6, $7::jsonb, $8, $9, $9)`, [key, JSON.stringify(legacy), caller.organizationId, caller.userId, `${key}@example.com`, tokens, JSON.stringify(scopes), expiry, linked])
    }
    try cloud.inside(cloud.store.transaction(effect (tx: Tx) => {
      try link(tx, caller, "status-revoked")
      try stepRow(tx, connectionRows, "status-revoked", { at: expiry, event: { type: "disconnect" } }, connectionColumns())
    }))
    const [several, named, listed] = try all([
      read("status"), read("status?grantId=verified-old"), read("accounts?side=owner")
    ], { concurrency: "unbounded" })
    const unchanged = try sql(cloud, "SELECT key, revision, last_used_at FROM google_connections WHERE user_id = $1 ORDER BY key", [caller.userId])

    const off = try serveOnStore(cloud, areas.flatMap((area) => area.routes), (profile) => {
      const { google: _google, ...staging } = profile.environments.staging
      return { ...profile, environments: { ...profile.environments, staging: { ...staging, capabilities: staging.capabilities.filter((capability) => capability !== "managedGoogle") } } }
    })
    const [offStatus, offAccounts] = try promise(() => Promise.all([
      callCloud(off, `${path}/status?grantId=verified-old`, { headers: caller.headers }),
      callCloud(off, `${path}/accounts`, { headers: caller.headers })
    ]))

    const empty = { provider: "google", side: "owner", mode: "cloud_managed", configured: true, connected: false, reason: "disconnected", identity: null, grantedCapabilities: [], grantedScopes: [], expiresAt: null, hasRefreshToken: false, connectionId: null, linkedAt: null, lastUsedAt: null }
    const active = { ...empty, connected: true, reason: "connected", identity: { email: "status-live@example.com" }, grantedCapabilities: ["google.basic_identity", "google.gmail.triage"], grantedScopes: scopes, expiresAt: new Date(expiry).toISOString(), connectionId: "status-live", linkedAt: new Date(start).toISOString() }
    const legacyStatus = (connectionId: string, linked: number, connected: boolean) => ({ ...active, connectionId, identity: { id: connectionId, email: `${connectionId}@example.com`, name: null, avatarUrl: null }, connected, reason: connected ? "connected" : "needs_reauth", hasRefreshToken: connected, linkedAt: new Date(linked).toISOString(), lastUsedAt: new Date(linked).toISOString() })
    const full = { ...active, identity: { id: "subject-status-live", email: "status-live@example.com", name: null, avatarUrl: null } }
    const old = legacyStatus("verified-old", start + 100, true)
    const revoked = { ...empty, connectionId: "status-revoked", identity: { id: "subject-status-revoked", email: "status-revoked@example.com", name: null, avatarUrl: null }, linkedAt: new Date(start).toISOString() }
    try check(() => assert.deepStrictEqual({
      missing, unauthorized: unauthorized.status, live, accounts: [accounts.status, accounts.headers["cache-control"], accounts.body],
      denied: [errorOf(foreign), errorOf(sameOrg), errorOf(wrongSide), errorOf(unsupportedConsent)], lapsed,
      several: [errorOf(several), (several.body as { readonly reason: string }).reason], named: [named.status, named.body], listed: [listed.status, listed.body],
      unchanged: unchanged.map((row) => [row.key, Number(row.revision), row.last_used_at === null ? null : Number(row.last_used_at)]), refreshes: google.tokenCalls,
      off: [offStatus.status, offStatus.body, offAccounts.status, offAccounts.body]
    }, {
      missing: empty, unauthorized: 401, live: active, accounts: [200, "no-store", [full]],
      denied: [[404, "not_found"], [404, "not_found"], [400, "invalid_request"], [400, "invalid_request"]], lapsed: { ...active, connected: false, reason: "token_missing" },
      several: [[400, "invalid_request"], "grant_required"], named: [200, { ...old, accountId: caller.userId }],
      listed: [200, [legacyStatus("unverified-old", start + 200, false), old, { ...full, connected: false, reason: "token_missing" }, revoked]],
      unchanged: [["status-live", 1, null], ["status-revoked", 2, null], ["unverified-old", 1, start + 200], ["verified-old", 1, start + 100]], refreshes: 0,
      off: [200, { ...empty, configured: false, reason: "config_missing", accountId: caller.userId }, 200, []]
    }))
    }
  }), 120_000)

  it.live("Disconnect only my chosen Google grant and discard a refresh that arrives afterwards (spec/cloud/services/google/connection.md, \"Story: Disconnect it\")", () => scoped(effect {
    const google = try sync(() => googleFakeState())
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage")]
    const refreshToken = try sync(() => seedGrant(google, { subject: "subject-racing", email: "racing@example.com", scopes }))
    const refreshAnswered = try Deferred.make<void>()
    const releaseRefresh = try acquireRelease(Deferred.make<void>(), (gate) => Deferred.succeed(gate, undefined))
    const provider = try Effect.try(() => mountGoogleToken(google))
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", async (request) => {
      const answer = await provider(request)
      if (request.path === "/token" && new URLSearchParams(request.body).get("refresh_token") === refreshToken) {
        await Effect.runPromise(Deferred.succeed(refreshAnswered, undefined))
        await Effect.runPromise(Deferred.await(releaseRefresh))
      }
      return answer
    }) })
    const caller = try leasedCaller(cloud, "disconnect-owner")
    const other = try signedCaller(cloud, "disconnect-other")
    const now = try Clock.currentTimeMillis
    const session = try cloud.store.transaction((tx) => issueSession(tx, { ...caller, assurance: "SingleFactor", accountCreated: false, now }))
    const client = try sync(() => createCloudClient({ baseUrl: cloud.url, credential: () => session.accessToken }))
    try cloud.inside(linkedGrant(cloud, caller, "racing", refreshToken, scopes, now - 1_000))
    try cloud.inside(linkedGrant(cloud, { organizationId: caller.organizationId, userId: other.userId }, "another-owner", "", scopes, now + 600_000))
    const accessToken = "legacy-access-only"
    const expiresAt = now + 600_000
    const legacy = try cloud.inside(sealTokens({ accessToken, refreshToken: "", expiresAt }))
    const state = { status: "Active", scopes, tokens: legacy, expiresAt, refreshingUntil: 0 }
    try sql(cloud, `INSERT INTO google_connections (key, state, revision, organization_id, user_id, subject, email, status, tokens, granted_scopes, expires_at, linked_at) VALUES ('legacy', $1::jsonb, 1, $2, $3, 'legacy-subject', 'legacy@example.com', 'Active', $4, $5::jsonb, $6, $7)`, [JSON.stringify(state), caller.organizationId, caller.userId, legacy, JSON.stringify(scopes), expiresAt, now])

    const root = "/api/v1/eliza/google"
    const disconnect = (json?: unknown) => cloud.call(`${root}/disconnect`, { method: "POST", headers: { authorization: `Bearer ${session.accessToken}` }, json })
    const revokes = () => cloud.fakes.seen.filter(({ path }) => path === "/google/revoke").map(({ body }) => new URLSearchParams(body).get("token"))
    const unauthenticated = try cloud.call(`${root}/disconnect`, { method: "POST" })
    const mailAccess = try cloud.call(`${root}/disconnect`, { method: "POST", headers: caller.headers, json: { grantId: "racing" } })
    const [ambiguous, foreign, wrongSide, conflict] = try all([
      disconnect(), disconnect({ connectionId: "another-owner" }), disconnect({ side: "agent", connectionId: "racing" }),
      disconnect({ connectionId: "legacy", grantId: "racing" })
    ], { concurrency: "unbounded" })
    const refusedCalls = try sync(revokes)
    const reading = try forkChild(cloud.call(`${root}/gmail/triage?grantId=racing`, { headers: caller.headers }))
    try Deferred.await(refreshAnswered)
    try promise(() => client.googleDisconnect({ grantId: "racing" }))
    try Deferred.succeed(releaseRefresh, undefined)
    const dropped = try Fiber.join(reading)
    const repeated = try disconnect({ side: "owner", connectionId: "racing" })
    try sync(() => { google.switches.failNext = { status: 503, body: {} } })
    const failedRevoke = try disconnect({ connectionId: null })
    const clean = try sql(cloud, "SELECT key, status, tokens IS NULL AS erased, expires_at, refreshing_until, granted_scopes, revision FROM google_connections ORDER BY key", [])
    const ended = try promise(() => client.googleStatus({ grantId: "legacy" }))
    try check(() => assert.deepStrictEqual({
      denied: [unauthenticated.status, errorOf(mailAccess), errorOf(ambiguous), errorOf(foreign), errorOf(wrongSide), errorOf(conflict)],
      ambiguousReason: (ambiguous.body as { readonly reason: string }).reason, refusedCalls,
      dropped: errorOf(dropped), repeated: [repeated.status, repeated.body], failedRevoke: [failedRevoke.status, failedRevoke.body],
      revokes: revokes(), providerRevoked: [...google.revoked], refreshes: google.tokenCalls,
      clean: clean.map((row) => [row.key, row.status, row.erased, Number(row.expires_at), Number(row.refreshing_until), row.granted_scopes, Number(row.revision)]),
      ended: [ended.connected, ended.reason, ended.expiresAt, ended.hasRefreshToken, ended.grantedScopes, ended.grantedCapabilities]
    }, {
      denied: [401, [403, "access_denied"], [400, "invalid_request"], [404, "not_found"], [400, "invalid_request"], [400, "invalid_request"]],
      ambiguousReason: "grant_required", refusedCalls: [], dropped: [409, "google_reauth_required"],
      repeated: [200, { ok: true }], failedRevoke: [200, { ok: true }], revokes: [refreshToken, accessToken], providerRevoked: [refreshToken], refreshes: 1,
      clean: [["another-owner", "Active", false, expiresAt, 0, scopes, 1], ["legacy", "Revoked", true, 0, 0, [], 3], ["racing", "Revoked", true, 0, 0, [], 3]],
      ended: [false, "disconnected", null, false, [], []]
    }))
  }), 120_000)

  it.live("Refresh a held grant once for concurrent callers and mark it Expired when Google refuses it (spec/cloud/services/google/connection.md, \"Story: Connect my Google account with the access I chose\")", () => scoped(effect {
    const google = try Effect.try(() => googleFakeState())
    google.tokenDelayMs = 300
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", mountGoogleToken(google)) })
    const profileInput = try Effect.try(() => testProfile(cloud.fakes.url))
    const profile = try parseProfile(profileInput)
    const deployment = deploymentLayer(profile, "staging").pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets }))))
    const now = try Clock.currentTimeMillis
    const held: Owner = { organizationId: "org-google-held", userId: "user-google-held" }
    const lost: Owner = { organizationId: "org-google-lost", userId: "user-google-lost" }
    for (const owner of [held, lost]) {
      try organization(cloud, owner.organizationId)
      try sql(cloud, "INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'active', $3, $4, $4)", [owner.userId, owner.organizationId, `${owner.userId}@example.com`, now])
    }
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage")]
    const heldToken = try Effect.try(() => seedGrant(google, { subject: "subject-conn-held", email: "conn-held@example.com", scopes }))
    const lostToken = try Effect.try(() => seedGrant(google, { subject: "subject-conn-lost", email: "conn-lost@example.com", scopes }))
    google.revoked.add(lostToken)
    provide Store = cloud.store, deployment, FetchHttpClient.layer {
      try linkedGrant(cloud, held, "conn-held", heldToken, scopes, now - 1000)
      try linkedGrant(cloud, lost, "conn-lost", lostToken, scopes, now - 1000)
      const both = try all([useGrant(held, undefined, "google.gmail.triage"), useGrant(held, "conn-held", "google.gmail.triage")], { concurrency: 2 })
      const again = try useGrant(held, undefined, "google.gmail.triage", "subject-conn-held")
      const refusals = {
        missing: try grantRefusal(useGrant(held, undefined, "google.gmail.send")),
        changed: try grantRefusal(useGrant(held, undefined, "google.gmail.triage", "subject-elsewhere")),
        foreign: try grantRefusal(useGrant(held, "conn-lost", "google.gmail.triage")),
        side: try grantRefusal(useGrant(held, "conn-none", "google.gmail.triage")),
        invalidGrant: try grantRefusal(useGrant(lost, undefined, "google.gmail.triage")),
        afterwards: try grantRefusal(useGrant(lost, undefined, "google.gmail.triage"))
      }
      const rows = try sql(cloud, "SELECT key, status, tokens IS NULL AS erased, refreshing_until FROM google_connections ORDER BY key", [])
      try check(() => assert.deepStrictEqual(
        {
          singleFlight: [google.tokenCalls, both[0].accessToken === both[1].accessToken, again.accessToken === both[0].accessToken, both[0].connectionId, both[0].email],
          refusals,
          rows: rows.map((row) => [row.key, row.status, row.erased, Number(row.refreshing_until)])
        },
        {
          singleFlight: [2, true, true, "conn-held", "conn-held@example.com"],
          refusals: { missing: "capability_missing", changed: "google_account_changed", foreign: "not_found", side: "not_found", invalidGrant: "google_reauth_required", afterwards: "google_reauth_required" },
          rows: [["conn-held", "Active", false, 0], ["conn-lost", "Expired", false, 0]]
        }
      ))
    }
  }))
})
effect function calendarSetup(email: string) {
  const google = try Effect.try(() => googleFakeState())
  const cloud = try testCloud({ mount: (fakes) => {
    fakes.mount("/google/", mountGoogleToken(google))
    fakes.mount("/google/", mountGoogleCalendar(google))
  } })
  const signed = try signedIn(cloud, email)
  const owner: Owner = { organizationId: signed.organizationId, userId: signed.user.id }
  const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.calendar.write")]
  const refreshToken = try Effect.try(() => seedGrant(google, { subject: "subject-cal", email: "cal@example.com", scopes }))
  const now = try Clock.currentTimeMillis
  try cloud.inside(linkedGrant(cloud, owner, "cal", refreshToken, scopes, now - 1000))
  try Effect.try(() => {
    seedCalendar(google, { id: "own@example.com", summary: "Own", accessRole: "owner", primary: true, timeZone: "Europe/Berlin" })
    seedCalendar(google, { id: "team@example.com", summary: "Team", accessRole: "reader", timeZone: "UTC" })
    seedEvent(google, "own@example.com", "standup", { summary: "Standup", start: { dateTime: "2026-12-01T09:00:00Z" }, end: { dateTime: "2026-12-01T09:15:00Z" } })
  })
  return { google, cloud, accountId: signed.user.id, headers: { authorization: `Bearer ${signed.accessToken}` } }
}

function calendarRefusal(body: unknown): ReadonlyArray<unknown> {
  const answer = body as { readonly error?: string; readonly reason?: string; readonly outcome?: string }
  return [answer.error, answer.reason, answer.outcome]
}

describe("WP8 Managed Google: calendar (spec/cloud/services/google/calendar.md)", () => {
  const calendarBase = "/api/v1/eliza/google/calendar"

  it.live("Read my calendars, a window of events and one event, refusing a window that is empty or in no time zone (spec/cloud/services/google/calendar.md, \"Story: Read my calendar for a window\")", () => scoped(effect {
    const { google, cloud, accountId, headers } = try calendarSetup("calendar-reads@example.com")
    try Effect.try(() => seedEvent(google, "own@example.com", "standup-moved", {
      summary: "Moved standup", start: { dateTime: "2026-12-01T10:00:00Z" }, end: { dateTime: "2026-12-01T10:15:00Z" },
      recurringEventId: "daily-standup", originalStartTime: { dateTime: "2026-12-01T09:00:00Z" },
    }))
    const window = "timeMin=2026-12-01T00:00:00Z&timeMax=2026-12-02T00:00:00Z"
    const calendars = try cloud.call(`${calendarBase}/calendars`, { headers })
    const feed = try cloud.call(`${calendarBase}/feed?${window}&timeZone=Europe/Berlin`, { headers })
    const reversed = try cloud.call(`${calendarBase}/feed?timeMin=2026-12-02T00:00:00Z&timeMax=2026-12-01T00:00:00Z`, { headers })
    const empty = try cloud.call(`${calendarBase}/feed?timeMin=2026-12-01T00:00:00Z&timeMax=2026-12-01T00:00:00Z`, { headers })
    const noZone = try cloud.call(`${calendarBase}/feed?${window}&timeZone=Mars/Olympus`, { headers })
    const one = try cloud.call(`${calendarBase}/events/standup?expectedAccountId=subject-cal`, { headers })
    const wrongOwner = try cloud.call(`${calendarBase}/feed?${window}&expectedAccountId=subject-other`, { headers })
    const wrongEventOwner = try cloud.call(`${calendarBase}/events/standup?expectedAccountId=subject-other`, { headers })
    const missing = try cloud.call(`${calendarBase}/events/nothere`, { headers })
    const anonymous = try cloud.call(`${calendarBase}/calendars`)
    const feedBody = try Schema.decodeUnknownEffect(Schema.Struct({
      accountId: Schema.String, calendarId: Schema.String, syncedAt: Schema.String, nextPageToken: Schema.Null,
      events: Schema.Array(Schema.Struct({
        externalId: Schema.String, title: Schema.String, etag: Schema.NullOr(Schema.String),
        seriesId: Schema.NullOr(Schema.String), metadata: Schema.Struct({ originalStartTime: Schema.optional(Schema.String) }),
      })),
    }))(feed.body)
    try check(() => assert.deepStrictEqual(
      {
        calendars: [calendars.status, calendars.body],
        feed: [feed.status, feedBody.accountId, feedBody.calendarId, feedBody.nextPageToken, feedBody.events.map((event) => [event.externalId, event.title, event.etag !== null]), typeof feedBody.syncedAt],
        moved: [feedBody.events[1]?.seriesId, feedBody.events[1]?.metadata.originalStartTime],
        wrongOwner: [wrongOwner, wrongEventOwner].map((reply) => [reply.status, ...calendarRefusal(reply.body)]),
        refused: [reversed.status, empty.status, noZone.status, calendarRefusal(reversed.body)],
        one: [one.status, (one.body as { readonly event: { readonly externalId: string } }).event.externalId],
        missing: [missing.status, calendarRefusal(missing.body)],
        anonymous: anonymous.status
      },
      {
        calendars: [200, [
          { calendarId: "own@example.com", accountId: "subject-cal", accountEmail: "cal@example.com", label: "Own", accessRole: "owner", read: true, write: true, recurrenceLines: true, privateCreate: true },
          { calendarId: "team@example.com", accountId: "subject-cal", accountEmail: "cal@example.com", label: "Team", accessRole: "reader", read: true, write: false }
        ]],
        feed: [200, accountId, "primary", null, [["standup", "Standup", true], ["standup-moved", "Moved standup", true]], "string"],
        moved: ["daily-standup", "2026-12-01T09:00:00Z"],
        wrongOwner: [[403, "access_denied", "google_account_changed", undefined], [403, "access_denied", "google_account_changed", undefined]],
        refused: [400, 400, 400, ["invalid_request", undefined, undefined]],
        one: [200, "standup"],
        missing: [404, ["not_found", undefined, undefined]],
        anonymous: 401
      }
    ))
  }))

  it.live("Create an event once per key and change or delete it only at the revision I read (spec/cloud/services/google/calendar.md, \"Story: Change an event only at the revision I read\"; spec/cloud/shared/dispatchOnce.md, \"Story: Send a change once and recover its outcome without sending it again\")", () => scoped(effect {
    const { google, cloud, headers } = try calendarSetup("calendar-writes@example.com")
    const create = (key: string | undefined, json: unknown) => cloud.call(`${calendarBase}/events`, { method: "POST", headers: key === undefined ? headers : { ...headers, "idempotency-key": key }, json })
    const lunch = { title: "Lunch", startAt: "2026-12-01T12:00:00Z", endAt: "2026-12-01T13:00:00Z" }
    const unkeyed = try create(undefined, lunch)
    const first = try create("lunch-key-0001", lunch)
    const again = try create("lunch-key-0001", lunch)
    const other = try create("lunch-key-0001", { ...lunch, title: "Dinner" })
    const inserts = google.calls.filter((call) => call.method === "POST" && call.path.endsWith("/events")).length
    google.switches.dropNextReply = true
    const dropped = try create("coffee-key-0001", { title: "Coffee", startAt: "2026-12-01T15:00:00Z", endAt: "2026-12-01T15:30:00Z" })
    const changedAccount = try create("tea-key-00000001", { ...lunch, title: "Tea", expectedAccountId: "subject-elsewhere" })
    try check(() => assert.equal(first.status, 201, JSON.stringify(first.body)))
    const created = (first.body as { readonly event: { readonly externalId: string; readonly etag: string; readonly title: string } }).event
    const eventPath = `${calendarBase}/events/${created.externalId}`
    const patch = (etag: string | undefined, json: unknown) => cloud.call(eventPath, { method: "PATCH", headers: etag === undefined ? headers : { ...headers, "if-match": etag }, json })
    const noRevision = try patch(undefined, { title: "Long lunch" })
    const changed = try patch(created.etag, { title: "Long lunch" })
    const stale = try patch(created.etag, { title: "Late lunch" })
    const current = (changed.body as { readonly event: { readonly etag: string; readonly title: string } }).event
    const staleDelete = try cloud.call(eventPath, { method: "DELETE", headers: { ...headers, "if-match": created.etag } })
    const deleted = try cloud.call(eventPath, { method: "DELETE", headers: { ...headers, "if-match": current.etag } })
    const rows = try sql(cloud, "SELECT kind, phase FROM calendar_writes ORDER BY kind, phase", [])
    try check(() => assert.deepStrictEqual(
      {
        unkeyed: [unkeyed.status, calendarRefusal(unkeyed.body)],
        once: [first.status, created.title, again.status, (again.body as { readonly event: { readonly externalId: string } }).event.externalId === created.externalId, inserts],
        other: [other.status, calendarRefusal(other.body)],
        dropped: [dropped.status, (dropped.body as { readonly event: { readonly title: string } }).event.title],
        changedAccount: [changedAccount.status, calendarRefusal(changedAccount.body)],
        noRevision: [noRevision.status, calendarRefusal(noRevision.body)],
        changed: [changed.status, current.title, current.etag !== created.etag, changed.headers.etag === current.etag],
        stale: [stale.status, calendarRefusal(stale.body)],
        staleDelete: [staleDelete.status, calendarRefusal(staleDelete.body)],
        deleted: [deleted.status, deleted.body, google.events.has(`own@example.com/${created.externalId}`)],
        rows: rows.map((row) => [row.kind, row.phase])
      },
      {
        unkeyed: [400, ["invalid_request", undefined, "not_accepted"]],
        once: [201, "Lunch", 201, true, 1],
        other: [409, ["idempotency_conflict", undefined, "not_accepted"]],
        dropped: [201, "Coffee"],
        changedAccount: [403, ["access_denied", "google_account_changed", "not_accepted"]],
        noRevision: [400, ["invalid_request", undefined, "not_accepted"]],
        changed: [200, "Long lunch", true, true],
        stale: [412, ["precondition_failed", undefined, "not_accepted"]],
        staleDelete: [412, ["precondition_failed", undefined, "not_accepted"]],
        deleted: [200, { ok: true }, false],
        rows: [["change", "rejected"], ["change", "succeeded"], ["create", "succeeded"], ["create", "succeeded"], ["delete", "rejected"], ["delete", "succeeded"]]
      }
    ))
  }))

  it.live("Read back a reviewed repeating create and recover a lost reply without repeating it (spec/cloud/services/google/calendar.md, \"Story: Change an event only at the revision I read\")", () => scoped(effect {
    const { google, cloud, headers } = try calendarSetup("calendar-series@example.com")
    const create = (key: string, json: unknown) => cloud.call(`${calendarBase}/events`, { method: "POST", headers: { ...headers, "idempotency-key": key }, json })
    const day = { title: "Daily note", allDay: true, startAt: "2026-12-01", endAt: "2026-12-02", privateCreate: true,
      recurrence: ["RRULE:FREQ=DAILY;UNTIL=20261212", "EXDATE;VALUE=DATE:20261204"] }
    const made = try create("calendar-series-01", day)
    const repeat = try create("calendar-series-01", day)
    const conflict = try create("calendar-series-01", { ...day, recurrence: ["RRULE:FREQ=WEEKLY"] })
    const timed = { title: "Weekly note", startAt: "2026-12-01T09:00:00+01:00", endAt: "2026-12-01T09:20:00+01:00", recurrence: ["RRULE:FREQ=WEEKLY"] }
    const unzoned = try create("calendar-series-02", timed)
    google.switches.dropNextReply = true
    const recovered = try create("calendar-series-02", { ...timed, timeZone: "Europe/Berlin" })
    const written = (reply: typeof made) => (reply.body as { readonly event: { readonly externalId: string; readonly recurrence: readonly string[]; readonly etag: string } }).event
    const patch = try cloud.call(`${calendarBase}/events/${written(made).externalId}`, {
      method: "PATCH", headers: { ...headers, "if-match": written(made).etag }, json: { recurrence: ["RRULE:FREQ=WEEKLY"] },
    })
    const stored = google.events.get(`own@example.com/${written(made).externalId}`)
    const privacy = [stored?.body.visibility, stored?.body.reminders]
    if (stored !== undefined) stored.body = { ...stored.body, visibility: "public" }
    const changedPrivacy = try create("calendar-series-01", day)
    try check(() => assert.deepStrictEqual({
      first: [made.status, written(made).recurrence],
      replay: [repeat.status, written(repeat).externalId === written(made).externalId],
      privacy,
      changedPrivacy: calendarRefusal(changedPrivacy.body),
      conflict: [conflict.status, calendarRefusal(conflict.body)],
      unzoned: [unzoned.status, calendarRefusal(unzoned.body)],
      recovered: [recovered.status, written(recovered).recurrence],
      patches: google.calls.filter((call) => call.method === "PATCH").length,
      inserts: google.calls.filter((call) => call.method === "POST" && call.path.endsWith("/events")).length,
      patch: patch.status,
    }, {
      first: [201, day.recurrence],
      replay: [201, true],
      privacy: ["private", { useDefault: false }],
      changedPrivacy: ["provider_unavailable", undefined, "unknown"],
      conflict: [409, ["idempotency_conflict", undefined, "not_accepted"]],
      unzoned: [400, ["invalid_request", "unsupported_field", "not_accepted"]],
      recovered: [201, timed.recurrence],
      patches: 0,
      inserts: 2,
      patch: 400,
    }))
  }))
})
describe("WP9 Client library (spec/cloud/client.md, \"Story: Use the cloud from the device as configured\")", () => {
  const unknownKey = `eliza_mobile_${"0".repeat(64)}`

  function serverClass(auth: AuthClass): Route["auth"] {
    switch (auth) {
      case "Public": return "Public"
      case "KeyOrSession": return "ServiceAccess"
      case "Mail": return "MailAccess"
      case "Session": return "SignedSession"
      case "SessionFamily": return "SessionFamily"
      case "FreshSession": return "FreshSession"
      case "StepUp": return "StepUp"
    }
  }

  function patternOf(route: DeviceRoute): string {
    return route.path.map((segment) => `/${segment.tag === "Param" ? `:${segment.name}` : segment.text}`).join("")
  }

  function clientOf(baseUrl: string, credential: () => string): CloudClient {
    return createCloudClient({ baseUrl, credential })
  }


  effect function refusingServer(cloud: TestCloud, refusals: ReadonlyArray<Refused>) {
    let next = 0
    const models: Route = {
      method: "GET",
      path: "/api/v1/models",
      auth: "Public",
      handler: () => effect {
        const refusal = refusals[next] ?? refused("NotFound")
        next += 1
        throw refusal
      }
    }
    return try serveOnStore(cloud, [models])
  }

  it.live("Read every refusal as one CloudError and leave the credential to its holder (spec/cloud/client.md, \"Every refusal reads as one CloudError and none touches the credential\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const live = try entitledDevice(cloud, "custody", now)
    const expiring = try entitledDevice(cloud, "expiring", now)
    const ended = try entitledDevice(cloud, "ended", now)
    try sql(cloud, "UPDATE device_grants SET key_expires_at = $2, state = jsonb_set(state, '{phase,keyExpiresAt}', to_jsonb($2::bigint)) WHERE credential_id = $1", ["cred-expiring", now - 1])
    try cloud.store.transaction((tx) => revokeAll(tx, "user-ended", now))
    let held = unknownKey
    const read: Array<string> = []
    const client = clientOf(cloud.url, () => {
      read.push(held)
      return held
    })
    const unknown = try clientFailure(() => client.account())
    held = expiring
    const expired = try clientFailure(() => client.account())
    held = ended
    const revoked = try clientFailure(() => client.account())
    held = live
    const kept = try clientFailure(() => client.account())

    const resetsAt = now + 3_600_000
    const retryAt = now + 60_000
    const backAt = now + 30_000
    const probe = try refusingServer(cloud, [refused("InsufficientCredits"), refused("AllowanceExhausted", "NoReason", resetsAt), refused("RateLimited", "NoReason", retryAt), refused("ServiceUnavailable", "NoReason", backAt)])
    const refusing = clientOf(probe, () => live)
    const answers = [
      try clientFailure(() => refusing.models()),
      try clientFailure(() => refusing.models()),
      try clientFailure(() => refusing.models()),
      try clientFailure(() => refusing.models())
    ]
    try check(() => assert.deepStrictEqual(
      { unknown, expired, revoked, kept, answers, read, held },
      {
        unknown: { tag: "CloudCredentialInvalid", reason: "CredentialUnknown" },
        expired: { tag: "CloudCredentialInvalid", reason: "CredentialExpired" },
        revoked: { tag: "CloudCredentialInvalid", reason: "CredentialRevoked" },
        kept: "succeeded",
        answers: [
          { tag: "CloudInsufficientCredits" },
          { tag: "CloudAllowanceExhausted", resetsAt },
          { tag: "CloudRateLimited", retryAt },
          { tag: "CloudUnavailable", retryAfter: backAt }
        ],
        read: [unknownKey, expiring, ended, live],
        held: live
      }
    ))
  }))

  it.live("Send the credential the getter holds now, with the same client (spec/cloud/client.md, \"Every call reads the credential when it is sent\")", () => scoped(effect {
    const cloud = try testCloud()
    try operator(cloud, ["prices", "set", "--model", "test-chat", "--input-per-1k", "150", "--output-per-1k", "600"])
    const now = try Clock.currentTimeMillis
    const first = try entitledDevice(cloud, "first", now)
    const second = try entitledDevice(cloud, "second", now)
    let held = first
    const client = clientOf(cloud.url, () => held)
    const before = try promise(() => client.account())
    const models = try promise(() => client.models())
    held = second
    const after = try promise(() => client.account())
    held = unknownKey
    const replaced = try clientFailure(() => client.models())
    try check(() => assert.deepStrictEqual(
      { before: before.id, after: after.id, models: models.data.map((model) => model.id), replaced },
      { before: "user-first", after: "user-second", models: ["test-chat"], replaced: { tag: "CloudCredentialInvalid", reason: "CredentialUnknown" } }
    ))
  }))

  it.live("Tell an unfunded account it cannot be used until it is funded (spec/cloud/client.md, \"An account is usable when it is active, funded and its lane is open\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const token = try entitledDevice(cloud, "unfunded", now)
    const client = clientOf(cloud.url, () => token)
    const unfunded = try promise(() => client.snapshot())
    provide Store = cloud.store {
      try addCredits({ organizationId: "org-unfunded", amount: 5_000_000, requestKey: "wp9-funding" })
    }
    const funded = try promise(() => client.snapshot())
    try check(() => assert.deepStrictEqual(
      { unfunded: [accountUsable(unfunded), creditFromSnapshot(unfunded, unfunded.observedAt).kind], funded: [accountUsable(funded), creditFromSnapshot(funded, funded.observedAt).kind] },
      { unfunded: [false, "zero"], funded: [true, "funded"] }
    ))
  }))

  it.live("Verify an entitlement the service signed for my account and audience (spec/cloud/billing/entitlements.md, \"Story: Read my plan without substituting another account or source\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const token = try entitledDevice(cloud, "verified", now)
    const bearer = { headers: { authorization: `Bearer ${token}` } }
    const published = try cloud.call("/api/v1/subscription/entitlement-keys")
    const answer = try cloud.call("/api/v1/subscription/entitlement", bearer)
    const signed = (answer.body as { readonly entitlement: string }).entitlement
    const account = try promise(() => clientOf(cloud.url, () => token).account())
    const expected = {
      keys: parseEntitlementKeys(published.body) ?? [], issuer: "https://api.staging.example.com", audience: "cloud-subscription",
      userId: account.id, organizationId: account.organization_id, now
    }
    const refusalOf = (result: Promise<unknown>) => result.then(
      () => "verified",
      (error: unknown) => error instanceof EntitlementInvalid ? error.check : `threw ${String(error)}`
    )
    const checked = try promise(() => checkEntitlement(signed, expected))
    const laterVersion = try promise(() => verifyOnDevice(resignedEntitlement(signed, { ver: 4 }, secrets.CLOUD_ENTITLEMENT_KEY ?? ""), expected))
    const otherAudience = try promise(() => refusalOf(verifyOnDevice(signed, { ...expected, audience: "another-service" })))
    const otherUser = try promise(() => refusalOf(verifyOnDevice(signed, { ...expected, userId: "user-another" })))
    const otherOrganization = try promise(() => refusalOf(checkEntitlement(signed, { ...expected, organizationId: "org-another" })))
    try check(() => assert.deepStrictEqual(
      { user: checked.userId, organization: checked.organizationId, plan: checked.plan, lifetime: checked.expiresAt - checked.issuedAt, laterVersion: laterVersion.ver, otherAudience, otherUser, otherOrganization },
      { user: "user-verified", organization: "org-verified", plan: { id: "free", name: "Free", status: "none" }, lifetime: 1_800_000, laterVersion: 4, otherAudience: "WrongAudience", otherUser: "WrongSubject", otherOrganization: "WrongOrganization" }
    ))
  }))

  it.live("Every route a device sends is one the service serves, with the same credential class (spec/cloud/client.md, \"A device sends only the routes of one table, each with its own headers\")", () => effect {
    const served = areas.flatMap((area) => area.routes)
    const mismatched = deviceRoutes.flatMap((route) => {
      const pattern = patternOf(route)
      const found = matchRoute(served, httpVerb(route.method), pattern)
      const same = found.kind === "route" && found.route.path === pattern && found.route.auth === serverClass(route.auth)
      return same ? [] : [`${httpVerb(route.method)} ${pattern} ${route.auth}: ${found.kind === "route" ? `${found.route.path} ${found.route.auth}` : found.kind}`]
    })
    try check(() => assert.deepStrictEqual({ unlisted: unlistedRoutes, mismatched }, { unlisted: [], mismatched: [] }))
  })
})
describe("WP10 Operator and deletion (spec/cloud/identity/deletion.md, \"Story: Delete an account once the person asked support\")", () => {
  effect function hostedCheckout(cloud: TestCloud, owner: Owner, request: string) {
    try openAccount(cloud, owner)
    const now = try Clock.currentTimeMillis
    const key = try deviceKey(cloud, owner.userId, { deviceName: "Phone", createdAt: now - 1000, expiresAt: now + 86_400_000 })
    const answer = try cloud.call("/api/v1/subscriptions/checkout", {
      headers: { authorization: `Bearer ${key}`, "idempotency-key": request },
      json: { planKey: "plus_monthly", idempotencyKey: request, presentation: "shared" }
    })
    try check(() => assert.equal(answer.status, 200, JSON.stringify(answer.body)))
    return Schema.decodeUnknownSync(Schema.Struct({ sessionId: Schema.String }))(answer.body).sessionId
  }

  effect function requestRemoval(cloud: TestCloud, owner: Owner) {
    const result = try printed(operator(cloud, ["account", "delete", "--user", owner.userId, "--confirmed-with-owner"]))
    try check(() => assert.ok(Exit.isSuccess(result.exit), result.err.join("\n")))
  }

  effect function shareOrganization(cloud: TestCloud, userId: string, organizationId: string) {
    try sql(cloud, "ALTER TABLE accounts DROP CONSTRAINT accounts_organization_id_key", [])
    try sql(cloud, "UPDATE accounts SET organization_id=$2, state=jsonb_set(state,'{organizationId}',to_jsonb($2::text)) WHERE key=$1", [userId, organizationId])
  }

  effect function checkoutDeletion(cloud: TestCloud, owner: Owner) {
    return (try sql(cloud, "SELECT phase,step FROM deletion_requests WHERE key=$1", [owner.userId]))[0]
  }

  it.live("Fund an active account, list and revoke a lost device, and refuse every command on another or an unreadable database (spec/cloud/operator.md, \"Story: Operate the deployment without reading secrets\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try openAccount(cloud, { userId: "user-operated", organizationId: "org-operated" })
    const shown = (result: { readonly exit: Exit.Exit<unknown, unknown>; readonly out: ReadonlyArray<string>; readonly err: ReadonlyArray<string> }) =>
      [Exit.isSuccess(result.exit), result.out, result.err.map((line) => /"error":"([a-z_]+)"/.exec(line)?.[1])]
    const credits = ["credits", "add", "--organization", "org-operated", "--amount", "5000000", "--request", "pilot-1"]
    const added = try printed(operator(cloud, credits))
    const replayed = try printed(operator(cloud, credits))
    const missing = try printed(operator(cloud, ["credits", "add", "--organization", "org-missing", "--amount", "1", "--request", "pilot-2"]))
    const device = { deviceName: "Lost phone", createdAt: now - 1000, expiresAt: now + 86_400_000 }
    const key = try deviceKey(cloud, "user-operated", device)
    const entitlement = effect () => (try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${key}` } }))
    const before = try entitlement()
    const listed = try printed(operator(cloud, ["account", "devices", "--user", "user-operated"]))
    const revoked = try printed(operator(cloud, ["account", "revoke-devices", "--user", "user-operated"]))
    const after = try entitlement()
    const listedAfter = try printed(operator(cloud, ["account", "devices", "--user", "user-operated"]))
    const otherDatabase = try printed(operator(cloud, [...credits.slice(0, -1), "pilot-3"], {
      edit: (profile) => ({ ...profile, environments: { ...profile.environments, staging: { ...profile.environments.staging, databaseIdentity: "c".repeat(64) } } })
    }))
    try sql(cloud, "DELETE FROM cloud_identity", [])
    const unreadable = try printed(operator(cloud, [...credits.slice(0, -1), "pilot-4"]))
    const balance = try sql(cloud, "SELECT count(*)::int AS entries FROM credit_entries WHERE organization_id = 'org-operated' AND kind = 'add'", [])
    const body = after.body as { readonly error?: string; readonly reason?: string }
    try check(() => assert.deepStrictEqual(
      {
        added: shown(added), replayed: shown(replayed), missing: shown(missing),
        before: before.status, listed: shown(listed), revoked: shown(revoked), after: [after.status, body.error, body.reason], listedAfter: shown(listedAfter),
        otherDatabase: shown(otherDatabase), unreadable: shown(unreadable), entries: balance[0]?.entries
      },
      {
        added: [true, ["organization org-operated: 5000000 µUSD added, balance 5000000 µUSD"], []],
        replayed: [true, ["organization org-operated: credits already added by this request, balance 5000000 µUSD"], []],
        missing: [false, [], ["not_found"]],
        before: 200,
        listed: [true, [JSON.stringify(device)], []],
        revoked: [true, ["user user-operated: 1 device keys ended, every session ended"], []],
        after: [401, "authentication_required", "credential_revoked"],
        listedAfter: [true, [], []],
        otherDatabase: [false, [], ["precondition_failed"]],
        unreadable: [false, [], ["service_unavailable"]],
        entries: 1
      }
    ))
  }), 30_000)
  it.live("Delete an account the person asked support to delete: fence it at once, cancel billing and revoke Google once though both replies are lost, retry a phase after a crashed sweep's claim expires, and erase the person (spec/cloud/identity/deletion.md, \"Story: Delete an account once the person asked support\"; spec/cloud/operator.md, \"An account deletion starts only for an active account, after the operator confirmed the request with its owner\")", () => scoped(effect {
    const providers = try Effect.try(() => deletionProviders())
    const cloud = try testCloud({ stripe: providers.stripe, mount: (fakes) => { providers.mount(fakes) } })
    const now = try Clock.currentTimeMillis
    const owner = { userId: "user-leaving", organizationId: "org-leaving" }
    try openAccount(cloud, owner)
    const subscribed = try Effect.try(() => providers.subscribe(catalogPrices[0].priceId))
    const replacement = try Effect.try(() => providers.subscribe(catalogPrices[0].priceId))
    try sql(cloud, "INSERT INTO cloud_checkout_customers (organization_id, customer_id) VALUES ($1, $2)", [owner.organizationId, subscribed.customerId])
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage")]
    const connectionId = "90111111-1111-4111-8111-111111111111"
    const refreshToken = try Effect.try(() => providers.grant("subject-conn-leaving"))
    try cloud.inside(linkedGrant(cloud, owner, connectionId, refreshToken, scopes, now - 1000))
    const legacyKey = "b".repeat(64)
    const legacyOrigin = "https://worker-custody.example.test"
    const legacySubject = "worker-conn-leaving"
    const workerRefresh = try sync(() => providers.grant(legacySubject))
    const cipher = try sync(() => workerRefreshCipher(legacyKey, legacyOrigin, owner.userId, legacySubject, workerRefresh))
    try sql(cloud, `INSERT INTO cloud_google_connections (account_id, id, subject, email, mail, calendar, send_mail, refresh_cipher)
      VALUES ($1, $2, $3, 'worker-conn-leaving@example.test', true, false, true, $4)`, [owner.userId, connectionId, legacySubject, cipher])
    const key = try deviceKey(cloud, owner.userId, { deviceName: "Phone", createdAt: now - 1000, expiresAt: now + 86_400_000 })
    try sql(cloud, "INSERT INTO cloud_sign_in_identities (provider, provider_subject, account_id) VALUES ('google', 'google-leaving', $1)", [owner.userId])
    try sql(cloud, `INSERT INTO oauth_attempts (key, state, revision, client_id, redirect_uri, expires_at, updated_at, route, pending, google_subject, verified_email, given_name)
      VALUES ('attempt-leaving', '{}'::jsonb, 1, 'google-web-client', 'https://app.example.test/return', $1, $1, 'browser', false, 'google-leaving', 'user-leaving@example.com', 'Lee')`, [now - 1000])
    const entitlement = effect () => {
      const answer = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${key}` } })
      return [answer.status, (answer.body as { readonly reason?: string }).reason]
    }
    const shown = (result: { readonly exit: Exit.Exit<unknown, unknown>; readonly out: ReadonlyArray<string>; readonly err: ReadonlyArray<string> }) =>
      [Exit.isSuccess(result.exit), result.out, result.err.map((line) => /"error":"([a-z_]+)"/.exec(line)?.[1])]
    const remove = ["account", "delete", "--user", owner.userId]
    const funded = try printed(operator(cloud, ["credits", "add", "--organization", owner.organizationId, "--amount", "1000000", "--request", "pilot-leaving"]))
    const before = try entitlement()
    const unconfirmed = try printed(operator(cloud, remove))
    const requested = try printed(operator(cloud, [...remove, "--confirmed-with-owner"]))
    const fenced = try entitlement()
    const status = effect () => (try sql(cloud, "SELECT status, email, phone, name, device_epoch::int FROM accounts WHERE key = $1", [owner.userId]))[0]
    const closing = try status()
    const later = try sync(() => shiftedClock())
    const legacyBindings: Readonly<Record<string, string>> = {
      GOOGLE_CONNECT_TOKEN_KEY: legacyKey, PUBLIC_API_ORIGIN: legacyOrigin,
      GOOGLE_CONNECT_CLIENT_ID: "legacy-google-client", GOOGLE_CONNECT_CLIENT_SECRET: "legacy-google-secret"
    }
    const sweep = () => provideService(cloud.inside(effect {
      const deployed = try Deployment
      return try provideService(sweepDeletions(), Deployment, {
        ...deployed, secret: effect (name: string) => name in legacyBindings ? legacyBindings[name] : try deployed.secret(name)
      })
    }), Clock.Clock, later.clock)
    try Effect.try(() => providers.loseNextCancelReply(subscribed.subscriptionId))
    const billing = try sweep()
    const phase = effect () => (try sql(cloud, "SELECT phase, step, attempts FROM deletion_requests WHERE key = $1", [owner.userId]))[0]
    const afterBilling = try phase()
    try cloud.inside(claimDue(try later.clock.currentTimeMillis))
    const whileClaimed = try sweep()
    try Effect.try(() => later.advance(10 * 60_000 + 1))
    const pinned = (try sql(cloud, "SELECT target FROM deletion_receipts WHERE user_id = $1 AND step = 'cancel_billing'", [owner.userId]))[0]?.target
    try sql(cloud, "UPDATE cloud_checkout_customers SET customer_id = $2 WHERE organization_id = $1", [owner.organizationId, replacement.customerId])
    try sync(() => providers.revealCanceled(subscribed.subscriptionId))
    const recovered = try sweep()
    const afterRecovery = try phase()
    try sync(() => {
      providers.loseNextRevokeReply(refreshToken)
      providers.loseNextRevokeReply(workerRefresh)
    })
    const missingKey = try provideService(cloud.inside(sweepDeletions()), Clock.Clock, later.clock)
    const afterMissingKey = try phase()
    const preserved = (try sql(cloud, "SELECT refresh_cipher FROM cloud_google_connections WHERE account_id = $1", [owner.userId]))[0]?.refresh_cipher === cipher
    const google = try sweep()
    const afterGoogle = try phase()
    const erasing = try sweep()
    const idle = try sweep()
    const again = try printed(operator(cloud, [...remove, "--confirmed-with-owner"]))
    const erased = try status()
    const left = try sql(cloud, "SELECT (SELECT count(*) FROM sessions WHERE user_id = $1)::int AS sessions, (SELECT count(*) FROM device_grants WHERE user_id = $1)::int AS devices, (SELECT count(*) FROM google_connections WHERE user_id = $1)::int AS google, (SELECT count(*) FROM cloud_google_connections WHERE account_id = $1)::int AS worker_google, (SELECT count(*) FROM cloud_sign_in_identities WHERE account_id = $1)::int AS identities, (SELECT count(*) FROM credit_entries WHERE organization_id = $2)::int AS ledger, (SELECT count(*) FROM oauth_attempts WHERE google_subject = 'google-leaving')::int AS attempts, (SELECT name FROM organizations WHERE id = $2) AS organization", [owner.userId, owner.organizationId])
    const googleTargets = try sql(cloud, "SELECT target FROM deletion_receipts WHERE user_id=$1 AND step='revoke_google' ORDER BY target", [owner.userId])
    const outside = try Effect.try(() => ({
      stripe: [providers.subscriptionStatus(subscribed.subscriptionId), providers.cancelCalls(cloud.fakes, subscribed.subscriptionId),
        providers.subscriptionStatus(replacement.subscriptionId), providers.cancelCalls(cloud.fakes, replacement.subscriptionId)],
      google: [providers.revoked(refreshToken), providers.revoked(workerRefresh), providers.revokeCalls()],
      checkedOAuthClients: cloud.fakes.seen.filter((request) => request.path === "/google/token")
        .map((request) => new URLSearchParams(request.body).get("client_id"))
    }))
    try check(() => assert.deepStrictEqual(
      {
        funded: Exit.isSuccess(funded.exit), before, unconfirmed: shown(unconfirmed), requested: shown(requested), fenced, closing: [closing?.status, closing?.device_epoch],
        sweeps: [billing, whileClaimed, recovered, missingKey, google, erasing, idle], afterBilling, afterRecovery, afterMissingKey, afterGoogle,
        ...outside, pinned, googleTargets: googleTargets.map((row) => row.target), preserved, erased, left: left[0],
        again: shown(again)
      },
      {
        funded: true, before: [200, undefined], unconfirmed: [false, [], ["invalid_request"]],
        requested: [true, ["user user-leaving: every session and device key ended; deletion running at cancel_billing, 0 of 12 attempts, no provider call"], []],
        fenced: [401, "credential_revoked"], closing: ["deleting", 1],
        sweeps: [1, 0, 1, 1, 1, 1, 0], afterBilling: { phase: "running", step: "cancel_billing", attempts: 1 },
        afterRecovery: { phase: "running", step: "revoke_google", attempts: 0 }, afterMissingKey: { phase: "running", step: "revoke_google", attempts: 1 },
        afterGoogle: { phase: "running", step: "erase_data", attempts: 0 },
        stripe: ["canceled", 1, "active", 0], google: [true, true, 2],
        checkedOAuthClients: ["google-web-client", "legacy-google-client"],
        pinned: JSON.stringify({ kind: "stripe", customerId: subscribed.customerId, subscriptionId: subscribed.subscriptionId }),
        googleTargets: [JSON.stringify({ kind: "google-layered", key: connectionId }), JSON.stringify({ kind: "google-worker", key: connectionId }), JSON.stringify({ kind: "google-worker", key: connectionId })],
        preserved: true,
        erased: { status: "erased", email: null, phone: null, name: null, device_epoch: 1 },
        left: { sessions: 0, devices: 0, google: 0, worker_google: 0, identities: 0, ledger: 1, attempts: 0, organization: "Deleted account" },
        again: [true, ["user user-leaving: already requested; deletion erased at erase_data, 0 of 12 attempts, no provider call"], []]
      }
    ))
  }), 60_000)
  it.live("Wait for an authoritative checkout result before finishing deletion billing (spec/cloud/identity/deletion.md, \"Story: Delete an account once the person asked support\")", () => scoped(effect {
    const stripe = try sync(() => createStripeFake())
    const cloud = try testCloud({ stripe })
    const owner = { userId: "user-deletion-open-checkout", organizationId: "org-deletion-open-checkout" }
    const sessionId = try hostedCheckout(cloud, owner, "pending-deletion-checkout")
    const expirePath = `/v1/checkout/sessions/${sessionId}/expire`
    try requestRemoval(cloud, owner)
    try sync(() => stripe.failNext(expirePath, { status: 500, type: "api_error" }))
    try cloud.inside(sweepDeletions())
    const pending = try checkoutDeletion(cloud, owner)
    const now = try Clock.currentTimeMillis
    const checked = try cloud.inside(readBackCheckouts(now + 180_000))
    const idle = try cloud.inside(readBackCheckouts(now + 360_000))
    try cloud.inside(sweepDeletions())
    const finished = try checkoutDeletion(cloud, owner)
    const checkout = (try sql(cloud, "SELECT status FROM checkouts WHERE provider_session_id=$1", [sessionId]))[0]?.status
    const provider = try sync(() => stripe.object(sessionId))
    if (provider.object !== "checkout.session") throw new Error("the provider fixture did not hold a checkout session")
    const expiry = try sync(() => cloud.fakes.seen.filter((request) => request.method === "POST" && request.path === `/stripe${expirePath}`).map((request) => request.headers["idempotency-key"]))
    try check(() => assert.deepStrictEqual([pending, checked, idle, checkout, provider.status, finished, expiry],
      [{ phase: "running", step: "cancel_billing" }, 1, 0, "expired", "expired", { phase: "running", step: "revoke_google" }, [`expire_${sessionId}`, `expire_${sessionId}`]]))

    const shared = { userId: "user-deletion-shared-checkout", organizationId: "org-deletion-shared-checkout" }
    const peer = { userId: "user-deletion-checkout-peer", organizationId: "org-deletion-checkout-peer" }
    const sharedId = try hostedCheckout(cloud, shared, "shared-deletion-checkout")
    try openAccount(cloud, peer)
    try shareOrganization(cloud, peer.userId, shared.organizationId)
    try requestRemoval(cloud, shared)
    try cloud.inside(sweepDeletions())
    try cloud.inside(readBackCheckouts((try Clock.currentTimeMillis) + 180_000))
    const saved = try sync(() => stripe.object(sharedId))
    if (saved.object !== "checkout.session") throw new Error("the provider fixture did not hold a shared checkout")
    const sharedStep = try checkoutDeletion(cloud, shared)
    const peerStatus = (try sql(cloud, "SELECT status FROM accounts WHERE key=$1", [peer.userId]))[0]?.status
    try check(() => assert.deepStrictEqual([sharedStep, saved.status, peerStatus], [{ phase: "running", step: "revoke_google" }, "open", "active"]))
  }), 90_000)

  it.live("Resolve paid Node checkout and an issued Worker checkout before finishing deletion billing (spec/cloud/identity/deletion.md, \"Story: Delete an account once the person asked support\")", () => scoped(effect {
    const stripe = try sync(() => createStripeFake())
    const cloud = try testCloud({ stripe })
    const owner = { userId: "user-deletion-paid-checkout", organizationId: "org-deletion-paid-checkout" }
    const sessionId = try hostedCheckout(cloud, owner, "paid-deletion-checkout")
    const paid = try sync(() => stripe.completeSession(sessionId))
    if (paid.kind !== "paid") throw new Error("the provider fixture did not hold a paid checkout")
    try requestRemoval(cloud, owner)
    try cloud.inside(sweepDeletions())
    const node = try checkoutDeletion(cloud, owner)
    const saved = (try sql(cloud, "SELECT target FROM deletion_receipts WHERE user_id=$1 AND step='cancel_billing'", [owner.userId]))[0]?.target
    const canceled = try sync(() => stripe.object(paid.subscription.id))
    if (canceled.object !== "subscription") throw new Error("the provider fixture did not hold a subscription")

    const worker = { userId: "user-deletion-worker-checkout", organizationId: "org-deletion-worker-checkout" }
    try openAccount(cloud, worker)
    const localStripe = stripeClient(fakeSecretKey, `${cloud.fakes.url}/stripe`)
    const customerId = (try promise(() => localStripe.customers.create())).id
    const legacyId = (try promise(() => localStripe.checkout.sessions.create({
      mode: "subscription", customer: customerId, client_reference_id: worker.organizationId,
      line_items: [{ price: catalogPrices[0].priceId, quantity: 1 }],
      success_url: "https://example.test/paid", cancel_url: "https://example.test/cancel"
    }))).id
    try sql(cloud, "INSERT INTO cloud_checkout_customers (organization_id,customer_id,checkout_id) VALUES ($1,$2,$3)", [worker.organizationId, customerId, legacyId])
    try requestRemoval(cloud, worker)
    try cloud.inside(sweepDeletions())
    const legacy = try checkoutDeletion(cloud, worker)
    const expired = try sync(() => stripe.object(legacyId))
    if (expired.object !== "checkout.session") throw new Error("the provider fixture did not hold a Worker checkout")
    try check(() => assert.deepStrictEqual([node, saved, canceled.status, legacy, expired.status],
      [{ phase: "running", step: "revoke_google" }, JSON.stringify({ kind: "stripe", customerId: paid.subscription.customer, subscriptionId: paid.subscription.id }),
        "canceled", { phase: "running", step: "revoke_google" }, "expired"]))
  }), 90_000)

  it.live("Keep an in-progress Google receipt when retained billing still needs settlement (spec/cloud/identity/deletion.md, \"Story: Delete an account once the person asked support\")", () => scoped(effect {
    const stripe = try sync(() => createStripeFake())
    const cloud = try testCloud({ stripe })
    const owner = { userId: "user-deletion-retained-checkout", organizationId: "org-deletion-retained-checkout" }
    const sessionId = try hostedCheckout(cloud, owner, "retained-deletion-checkout")
    const paid = try sync(() => stripe.completeSession(sessionId))
    if (paid.kind !== "paid") throw new Error("the provider fixture did not hold a paid checkout")
    try requestRemoval(cloud, owner)
    const now = try Clock.currentTimeMillis
    const target = JSON.stringify({ kind: "google-layered", key: "known-google-connection" })
    try cloud.store.transaction(effect (tx: Tx) => {
      try stepDeletion(tx, owner.userId, { type: "completeStep", workLeft: false, billingBoundary: "BillingSettled" }, now)
      try stepDeletion(tx, owner.userId, { type: "prepareCall", providerKey: { providerKind: "GoogleGrant", providerId: "del_retained_google" },
        staleAfter: 30_000, expiresAt: now + 60_000, billingBoundary: "BillingSettled",
        digest: requestDigest({ step: "RevokeGoogle", userId: owner.userId, organizationId: owner.organizationId, target }) }, now, target)
      const claim = try stepDeletion(tx, owner.userId, { type: "claimCall" }, now)
      try stepDeletion(tx, owner.userId, { type: "sendCall", claimToken: claim.state.receipt.session.currentClaim }, now)
    })
    const receipts = () => sql(cloud, "SELECT step,target,state FROM deletion_receipts WHERE user_id=$1 ORDER BY provider_key", [owner.userId])
    const before = try receipts()
    const clock = try sync(() => shiftedClock())
    try sync(() => clock.advance(45_000))
    try provideService(cloud.inside(sweepDeletions()), Clock.Clock, clock.clock)
    const held = try checkoutDeletion(cloud, owner)
    const after = try receipts()
    try check(() => assert.deepStrictEqual([held, after], [{ phase: "running", step: "revoke_google" }, before]))

    const older = { userId: "user-deletion-retained-erase", organizationId: "org-deletion-retained-erase" }
    const olderSession = try hostedCheckout(cloud, older, "retained-erase-checkout")
    const olderPayment = try sync(() => stripe.completeSession(olderSession))
    if (olderPayment.kind !== "paid") throw new Error("the provider fixture did not hold a paid checkout")
    try requestRemoval(cloud, older)
    const retainedAt = try Clock.currentTimeMillis
    try cloud.store.transaction(effect (tx: Tx) => {
      try stepDeletion(tx, older.userId, { type: "completeStep", workLeft: false, billingBoundary: "BillingSettled" }, retainedAt)
      try stepDeletion(tx, older.userId, { type: "completeStep", workLeft: false, billingBoundary: "BillingSettled" }, retainedAt)
    })
    try cloud.inside(sweepDeletions())
    const beforeRecovery = try checkoutDeletion(cloud, older)
    const localStripe = stripeClient(fakeSecretKey, `${cloud.fakes.url}/stripe`)
    const canceled = try promise(() => localStripe.subscriptions.cancel(olderPayment.subscription.id))
    try cloud.inside(sweepDeletions())
    const afterRecovery = try checkoutDeletion(cloud, older)
    try check(() => assert.deepStrictEqual([beforeRecovery, canceled.status, afterRecovery],
      [{ phase: "running", step: "erase_data" }, "canceled", { phase: "erased", step: "erase_data" }]))
  }), 90_000)

  it.live("Keep shared billing and a retained unaddressable cancellation intact (spec/cloud/identity/deletion.md, \"Each provider call of a step is one receipt of that step's kind, owned by the account, under a provider key never used before\")", () => scoped(effect {
    const providers = try sync(() => deletionProviders())
    const cloud = try testCloud({ stripe: providers.stripe, mount: (fakes) => { providers.mount(fakes) } })
    const shared = { userId: "user-shared-leaving", organizationId: "org-shared" }
    const retained = { userId: "user-legacy-leaving", organizationId: "org-legacy" }
    const peer = { userId: "user-shared-remaining", organizationId: "org-peer" }
    try openAccount(cloud, shared)
    try openAccount(cloud, retained)
    try openAccount(cloud, peer)
    try shareOrganization(cloud, peer.userId, shared.organizationId)
    const prepare = effect (owner: Owner) => {
      const subscription = try sync(() => providers.subscribe(catalogPrices[0].priceId))
      try sql(cloud, "INSERT INTO cloud_checkout_customers (organization_id,customer_id) VALUES ($1,$2)", [owner.organizationId, subscription.customerId])
      const command = ["account", "delete", "--user", owner.userId, "--confirmed-with-owner"]
      try operator(cloud, command)
      return { subscription, command }
    }
    const kept = try prepare(shared)
    const previous = try prepare(retained)
    const now = try Clock.currentTimeMillis
    try cloud.store.transaction(effect (tx: Tx) => {
      const target = retained.organizationId
      try stepDeletion(tx, retained.userId, {
        type: "prepareCall", providerKey: { providerKind: "SubscriptionUpdate", providerId: "del_retained_org_only" }, staleAfter: 30_000,
        expiresAt: now + 60_000, billingBoundary: "BillingCheckoutSettled", digest: requestDigest({ step: "CancelBilling", userId: retained.userId, organizationId: target, target })
      }, now, target)
      const claimed = try stepDeletion(tx, retained.userId, { type: "claimCall" }, now)
      try stepDeletion(tx, retained.userId, { type: "sendCall", claimToken: claimed.state.receipt.session.currentClaim }, now)
    })
    const peerKey = try deviceKey(cloud, peer.userId, { deviceName: "Peer phone", createdAt: now - 1000, expiresAt: now + 86_400_000 })
    const clock = try sync(() => shiftedClock())
    try sync(() => clock.advance(31_000))
    const sweep = provideService(cloud.inside(sweepDeletions()), Clock.Clock, clock.clock)
    try sweep
    try sweep
    try sweep
    const reasked = try printed(operator(cloud, previous.command))
    const peerAnswer = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${peerKey}` } })
    const accounts = try sql(cloud, "SELECT key,status FROM accounts ORDER BY key", [])
    const receipts = try sql(cloud, "SELECT user_id,target FROM deletion_receipts ORDER BY user_id", [])
    const accessed = try sync(() => cloud.fakes.seen.filter((request) => request.path.startsWith("/stripe/v1/subscriptions")))
    try check(() => {
      assert.deepStrictEqual(accounts, [{ key: retained.userId, status: "deleting" }, { key: shared.userId, status: "erased" }, { key: peer.userId, status: "active" }])
      assert.deepStrictEqual(receipts, [{ user_id: retained.userId, target: retained.organizationId }])
      assert.deepStrictEqual([providers.subscriptionStatus(kept.subscription.subscriptionId), providers.subscriptionStatus(previous.subscription.subscriptionId), peerAnswer.status, accessed.length], ["active", "active", 200, 0])
      assert.match(reasked.out[0] ?? "", /provider target unresolved/)
    })
  }), 60_000)
})
describe("WP10 Operator and deletion: clients (spec/cloud/operator.md)", () => {
  it.live("Register, update and disable a native client from the operator command line (spec/cloud/operator.md, \"Story: Operate the deployment without reading secrets\"; spec/cloud/nativeClients/registry.md, \"A registration is accepted only when the registry stays valid and no return lies on the API origin, and it never changes how another client is admitted\")", () => scoped(effect {
    const cloud = try testCloud()
    const fingerprint = "E3:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"
    const rotated = "A1:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"
    const web = "https://www.staging.example.com"
    const flagsOf = (name: string, signInReturn = `${web}/apps/${name}/sign-in`) => [
      "--client-id", `com.example.${name}`, "--display-name", name, "--android-package", `com.example.${name}`, "--cert", fingerprint,
      "--sign-in-return", signInReturn, "--billing-return", `${web}/apps/${name}/billing`, "--credential-ttl-days", "7"
    ]
    const config = (name: string) => cloud.call(`/api/v1/app-auth/mobile/config?${new URLSearchParams({ clientId: `com.example.${name}`, environment: "staging", redirectUri: `${web}/apps/${name}/sign-in` }).toString()}`)
    const run = (args: ReadonlyArray<string>) => failureTag(operator(cloud, args))
    const answers = [
      try run(["client", "register", ...flagsOf("one"), "--native-google"]),
      try run(["client", "register", ...flagsOf("two")]),
      try run(["client", "register", ...flagsOf("five"), "--cert", fingerprint, "--cert", fingerprint, "--cert", fingerprint, "--cert", fingerprint]),
      try run(["client", "register", ...flagsOf("api", "https://api.staging.example.com/apps/api")]),
      try run(["client", "register", "--client-id", "com.example.bare"]),
      try run(["client", "update", "--client-id", "com.example.two", "--display-name", "Two", "--cert", fingerprint, "--cert", rotated]),
      try run(["client", "update", "--client-id", "com.example.nobody", "--display-name", "Nobody"])
    ]
    const one = try config("one")
    const twoBefore = try config("two")
    const linksBefore = try cloud.call("/.well-known/assetlinks.json")
    const disabled = try run(["client", "disable", "--client-id", "com.example.two"])
    const twoAfter = try config("two")
    const oneAfter = try config("one")
    const linksAfter = try cloud.call("/.well-known/assetlinks.json")
    const links = (body: unknown) => (body as ReadonlyArray<{ readonly target: { readonly package_name: string; readonly sha256_cert_fingerprints: ReadonlyArray<string> } }>).map((statement) => [statement.target.package_name, statement.target.sha256_cert_fingerprints.length])
    try check(() => assert.deepStrictEqual(
      {
        answers,
        one: [one.status, (one.body as { readonly credentialTtlMs?: number }).credentialTtlMs],
        twoBefore: twoBefore.status,
        linksBefore: links(linksBefore.body),
        disabled,
        twoAfter: [twoAfter.status, (twoAfter.body as { readonly error?: string }).error],
        oneAfter: [oneAfter.status, oneAfter.body],
        linksAfter: links(linksAfter.body)
      },
      {
        answers: [
          'succeeded with {"kind":"done","lines":["registered com.example.one (staging)"]}',
          'succeeded with {"kind":"done","lines":["registered com.example.two (staging)"]}',
          "RegistrationInvalid", "RegistrationRefused", "ClientFlagsInvalid",
          'succeeded with {"kind":"done","lines":["updated com.example.two (staging)"]}',
          "ClientUnknown"
        ],
        one: [200, 7 * 86_400_000],
        twoBefore: 200,
        linksBefore: [["com.example.one", 1], ["com.example.two", 2]],
        disabled: 'succeeded with {"kind":"done","lines":["disabled com.example.two"]}',
        twoAfter: [403, "client_disabled"],
        oneAfter: [one.status, one.body],
        linksAfter: [["com.example.one", 1]]
      }
    ))
  }))
})
describe("WP10 Operator and deletion: prices (spec/cloud/operator.md)", () => {
  it.live("Price an offered model from the operator command line so its calls are admitted, and check prices and catalog (spec/cloud/operator.md, \"Story: Operate the deployment without reading secrets\"; spec/cloud/services/models.md, \"Story: Price a model call before it runs\")", () => scoped(effect {
    const cloud = try testCloud()
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    const settings = profile.environments.staging.inference
    if (settings === undefined) return try fail(new Error("the test profile offers no inference"))
    const caller = try signedCaller(cloud, "pricer")
    const run = (args: ReadonlyArray<string>) => failureTag(operator(cloud, args))
    const admission = cloud.store.transaction((tx) => chooseFor(tx, settings, "test-chat", false)).pipe(
      Effect.map((chosen) => `admitted ${chosen.model.id} at ${chosen.model.inputPer1K}/${chosen.model.outputPer1K} via ${chosen.provider.id}`),
      Effect.catchTag("Refused", (error) => Effect.succeed(refusalBody(error.refusal).error))
    )
    const listed = effect () => {
      const answer = try cloud.call("/api/v1/models", { headers: caller.headers })
      return [answer.status, (answer.body as { readonly data: ReadonlyArray<{ readonly id: string }> }).data.map((model) => model.id)]
    }
    const checkBefore = try run(["prices", "check"])
    const admittedBefore = try admission
    const listedBefore = try listed()
    const refusedSets = [
      try run(["prices", "set", "--model", "unoffered", "--input-per-1k", "100", "--output-per-1k", "200"]),
      try run(["prices", "set", "--model", "test-chat", "--input-per-1k", "1.5", "--output-per-1k", "200"]),
      try run(["prices", "set", "--model", "test-chat", "--output-per-1k", "200"]),
      try run(["prices", "set", "--model", "test-chat", "--input-per-1k", "150", "--cached-input-per-1k", "151", "--output-per-1k", "600"])
    ]
    const sameAsInput = try run(["prices", "set", "--model", "test-chat", "--input-per-1k", "150", "--output-per-1k", "600"])
    const set = try run(["prices", "set", "--model", "test-chat", "--input-per-1k", "150", "--cached-input-per-1k", "0", "--output-per-1k", "600"])
    const admittedAfter = try admission
    const listedAfter = try listed()
    const checkAfter = try run(["prices", "check"])
    try check(() => assert.deepStrictEqual(
      { checkBefore, admittedBefore, listedBefore, refusedSets, sameAsInput, set, admittedAfter, listedAfter, checkAfter },
      {
        checkBefore: "PricesMismatched",
        admittedBefore: "model_unavailable",
        listedBefore: [200, []],
        refusedSets: ["Refused", "PriceFlagsInvalid", "PriceFlagsInvalid", "Refused"],
        sameAsInput: 'succeeded with {"kind":"done","lines":["priced test-chat: input 150, cached input 150, output 600 µUSD per 1,000 tokens"]}',
        set: 'succeeded with {"kind":"done","lines":["priced test-chat: input 150, cached input 0, output 600 µUSD per 1,000 tokens"]}',
        admittedAfter: "admitted test-chat at 150/600 via llm",
        listedAfter: [200, ["test-chat"]],
        checkAfter: 'succeeded with {"kind":"done","lines":["0 price mismatches; usable models: test-chat","payment catalog verified"]}'
      }
    ))
  }))
})

effect function entitledDevice(cloud: TestCloud, name: string, now: number) {
  const token = `eliza_mobile_${tokenDigest(name)}`
  const grant = legacyGrant({ phase: "OldActive", client: { tag: "UnrecordedClient" }, codeExpiresAt: now - 1000, credentialTtl: 0, credentialId: `cred-${name}`, keyExpiresAt: now + 24 * 3_600_000, epoch: 0, now })
  try organization(cloud, `org-${name}`)
  try sql(cloud, "INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'active', $3, $4, $4)", [`user-${name}`, `org-${name}`, `${name}@example.com`, now])
  try sql(cloud, "INSERT INTO device_grants (key, state, revision, user_id, client_id, phase, credential_id, secret_digest, code_expires_at, key_expires_at, issued_at, updated_at) VALUES ($1, $7::jsonb, 1, $2, 'test-client', 'active', $3, $4, $5, $6, $5, $5)", [
    `grant-${name}`, `user-${name}`, `cred-${name}`, tokenDigest(token), now - 1000, now + 24 * 3_600_000, JSON.stringify(grant)
  ])
  return token
}

effect function entitlementClaims(cloud: TestCloud, token: string, keys: ReadonlyArray<PublishedKey>) {
  const answer = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${token}` } })
  const now = try Clock.currentTimeMillis
  const verified = try promise(() => answer.status !== 200 ? Promise.reject(new Error(`entitlement answered ${answer.status}`)) : verifyEntitlement((answer.body as { readonly entitlement: string }).entitlement, keys, { issuer: "https://api.staging.example.com", audience: "cloud-subscription", nowSeconds: Math.floor(now / 1000) }))
  const claims = verified.claims
  return { status: answer.status, kid: verified.header.kid, plan: claims.plan, planEndsAt: claims.plan_ends_at, allowance: claims.plan_allowance, ver: claims.ver, sub: claims.sub, org: claims.org, services: claims.services, lifetime: Number(claims.exp) - Number(claims.iat), exp: claims.exp }
}

describe("WP4 Subscriptions and entitlements: entitlement", () => {
  it.live("Read my plan from a signed entitlement, a grant giving way to a paid plan (spec/cloud/billing/entitlements.md, \"Story: Read my plan without substituting another account or source\"; spec/cloud/billing/subscriptions.md, \"Story: Keep my plan as the provider says it is\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const token = try entitledDevice(cloud, "entitled", now)
    const published = try cloud.call("/api/v1/subscription/entitlement-keys")
    const keys = (published.body as { readonly keys: ReadonlyArray<PublishedKey> }).keys
    const anonymous = try cloud.call("/api/v1/subscription/entitlement")
    const free = try entitlementClaims(cloud, token, keys)

    const grantEnds = now + 10 * 60_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-1', 'org-entitled', 'pilot', 'plus_monthly', $1, $2, $1)", [now - 1000, grantEnds])
    const granted = try entitlementClaims(cloud, token, keys)

    const periodEnd = now + 30 * 24 * 3_600_000
    const resetsAt = now + 20 * 60_000
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, period_end, updated_at) VALUES ('org-entitled', '{}'::jsonb, 1, 'active', 'pro_monthly', $1, $2)", [periodEnd, now])
    try cloud.store.transaction((tx) => stepRow(tx, periodRows, "renewal/staging/in_1", { type: "openRenewal", invoiceId: "in_1", planKey: "ProMonthly", startsAt: now - 1000, endsAt: resetsAt }, () => ({
      organization_id: "org-entitled", status: "open", period_start: now - 1000, period_end: resetsAt, updated_at: now
    })))
    const paid = try entitlementClaims(cloud, token, keys)
    try sql(cloud, "UPDATE subscriptions SET status = 'past_due' WHERE key = 'org-entitled'", [])
    const pastDue = try entitlementClaims(cloud, token, keys)
    try sql(cloud, "UPDATE subscriptions SET status = 'unpaid' WHERE key = 'org-entitled'", [])
    const unpaidAnswer = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${token}` } })
    const unpaidAt = try Clock.currentTimeMillis
    const unpaid = try promise(() => verifyOnDevice((unpaidAnswer.body as { readonly entitlement: string }).entitlement, {
      keys: parseEntitlementKeys(published.body) ?? [], issuer: "https://api.staging.example.com", audience: "cloud-subscription",
      userId: "user-entitled", organizationId: "org-entitled", now: unpaidAt
    }))
    try sql(cloud, "UPDATE subscriptions SET plan_key = 'gold' WHERE key = 'org-entitled'", [])
    const unreadable = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${token}` } })

    const seconds = (millis: number) => Math.floor(millis / 1000)
    try check(() => assert.deepStrictEqual(
      {
        published: [published.status, published.headers["cache-control"], keys.length, keys.map((key) => [key.kid, key.kty, key.crv])],
        anonymous: [anonymous.status, (anonymous.body as { readonly error: string }).error],
        free,
        granted: [granted.plan, granted.planEndsAt, granted.exp, granted.allowance],
        paid: [paid.plan, paid.planEndsAt, paid.exp, paid.allowance],
        pastDue: [pastDue.plan, pastDue.allowance],
        unpaid: [unpaid.plan, unpaid.plan_allowance],
        unreadable: [unreadable.status, (unreadable.body as { readonly error: string }).error]
      },
      {
        published: [200, "public, max-age=60", 1, [["entitlement-1", "EC", "P-256"]]],
        anonymous: [401, "authentication_required"],
        free: { status: 200, kid: "entitlement-1", plan: { id: "free", name: "Free", status: "none" }, planEndsAt: null, allowance: null, ver: 3, sub: "user-entitled", org: "org-entitled", services: ["inference", "speech", "maps"], lifetime: 1800, exp: free.exp },
        granted: [{ id: "plus_monthly", name: "Plus", status: "active" }, seconds(grantEnds), seconds(grantEnds), null],
        paid: [{ id: "pro_monthly", name: "Pro", status: "active" }, seconds(periodEnd), seconds(resetsAt), { unit: "usd_micros", granted: 90_000_000, remaining: 90_000_000, periodStart: seconds(now - 1000), resetsAt: seconds(resetsAt) }],
        pastDue: [{ id: "pro_monthly", name: "Pro", status: "past_due" }, null],
        unpaid: [{ id: "pro_monthly", name: "Pro", status: "canceled" }, null],
        unreadable: [503, "service_unavailable"]
      }
    ))
  }))
})

import { initial as noSubscription, type Subscription } from "../gen/cloud__billing__subscriptions.ts"
import type { BillingSnapshot } from "../src/billing/snapshot.vibe"
import type { InvoiceDetail, InvoicePage } from "../src/billing/invoices.vibe"
import { createStripeInvoicesFake } from "./support/fakes/stripe-invoices.ts"

effect function subscribedTo(cloud: TestCloud, organizationId: string, customerId: string, now: number) {
  const state: Subscription = {
    ...noSubscription, status: "Active", subscriptionId: `sub_${organizationId}`, customer: { tag: "PinnedCustomer", customerId },
    planKey: "PlusMonthly", periodStart: now - 60_000, periodEnd: now + 30 * 24 * 3_600_000, revision: 4
  }
  try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, provider_subscription_id, period_end, updated_at) VALUES ($1, $2, 4, 'active', 'plus_monthly', $3, $4, $5, $6)", [
    organizationId, JSON.stringify(state), customerId, state.subscriptionId, state.periodEnd, now
  ])
  return state
}

effect function limitsOf(cloud: TestCloud, headers: Readonly<Record<string, string>>) {
  const answer = try cloud.call("/api/v1/billing/limits", { headers })
  return { status: answer.status, snapshot: (answer.body as { readonly data: BillingSnapshot }).data, error: (answer.body as { readonly error?: string }).error }
}

describe("WP4 Subscriptions and entitlements: snapshot and invoices", () => {
  it.live("Read my billing state in one snapshot as a free, granted and paid account, or a whole 503 (spec/cloud/billing/subscriptions.md, \"Story: Keep my plan as the provider says it is\"; spec/cloud/billing/subscriptions.md, \"Story: Change my plan one command at a time\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "snapshot@example.com")
    const organizationId = signed.organizationId
    const headers = { authorization: `Bearer ${signed.accessToken}` }
    const anonymous = try cloud.call("/api/v1/billing/limits")
    const free = try limitsOf(cloud, headers)

    provide Store = cloud.store {
      try addCredits({ organizationId, amount: 2_000_000, requestKey: "snapshot-credits" })
    }
    const grantEnds = now + 10 * 60_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-snapshot', $1, 'pilot', 'plus_monthly', $2, $3, $2)", [organizationId, now - 1000, grantEnds])
    const granted = try limitsOf(cloud, headers)

    const subscription = try subscribedTo(cloud, organizationId, "cus_snapshot", now)
    const resetsAt = now + 20 * 60_000
    try cloud.store.transaction((tx) => stepRow(tx, periodRows, "renewal/staging/in_snapshot", { type: "openRenewal", invoiceId: "in_snapshot", planKey: "PlusMonthly", startsAt: now - 1000, endsAt: resetsAt }, () => ({
      organization_id: organizationId, status: "open", period_start: now - 1000, period_end: resetsAt, updated_at: now
    })))
    const paid = try limitsOf(cloud, headers)
    try sql(cloud, "UPDATE subscriptions SET state = '{\"status\":\"Gold\"}'::jsonb WHERE key = $1", [organizationId])
    const unreadable = try limitsOf(cloud, headers)

    const grant = { id: "grant-snapshot", planKey: "plus_monthly", family: "pilot", effectiveFrom: now - 1000, effectiveUntil: grantEnds, revoked: false }
    try check(() => assert.deepStrictEqual(
      {
        anonymous: [anonymous.status, (anonymous.body as { readonly error: string }).error],
        free: [free.status, free.snapshot.observedAt >= now, { ...free.snapshot, observedAt: 0, balance: { ...free.snapshot.balance, revision: 0 } }, accountUsable(free.snapshot)],
        granted: [granted.status, granted.snapshot.balance.usdMicros, granted.snapshot.balance.revision > free.snapshot.balance.revision, granted.snapshot.plan, granted.snapshot.grant, granted.snapshot.subscription, granted.snapshot.funding],
        paid: [paid.status, paid.snapshot.plan, paid.snapshot.subscription, paid.snapshot.grant, paid.snapshot.allowance, paid.snapshot.funding, accountUsable(paid.snapshot)],
        unreadable: [unreadable.status, unreadable.error]
      },
      {
        anonymous: [401, "authentication_required"],
        free: [200, true, {
          schemaVersion: 3, observedAt: 0, account: { status: "active" }, balance: { usdMicros: 0, revision: 0 },
          plan: { key: "free", source: "free", effectiveUntil: null }, subscription: null, grant: null, allowance: null,
          funding: { inference: "creditsOnly", speech: "creditsOnly", maps: "creditsOnly" }
        }, false],
        granted: [200, 2_000_000, true, { key: "plus_monthly", source: "grant", effectiveUntil: grantEnds }, grant, null, { inference: "allowanceThenCredits", speech: "allowanceThenCredits", maps: "allowanceThenCredits" }],
        paid: [200, { key: "plus_monthly", source: "subscription", effectiveUntil: subscription.periodEnd }, {
          id: subscription.subscriptionId, planKey: "plus_monthly", status: "active", periodStart: subscription.periodStart, periodEnd: subscription.periodEnd,
          cancelAtPeriodEnd: false, pendingPlanKey: null, dunningEndsAt: null, revision: 4,
          control: { action: "cancel", eligible: true, expectedSubscriptionRevision: 4 }
        }, grant, {
          state: "open", granted: 25_000_000, adjustment: 0, available: 25_000_000, reserved: 0, settled: 0, expired: 0, clawedBack: 0, periodStart: now - 1000, resetsAt
        }, { inference: "allowanceThenCredits", speech: "allowanceThenCredits", maps: "allowanceThenCredits" }, true],
        unreadable: [503, "service_unavailable"]
      }
    ))
  }))

  it.live("Read only my pinned customer's invoices, a page at a time (spec/cloud/billing/subscriptions.md, \"Story: Read my invoices and open the billing portal\")", () => scoped(effect {
    const stripe = try sync(() => createStripeInvoicesFake())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/stripe/", stripe.handler) })
    const now = try Clock.currentTimeMillis
    const own = try signedIn(cloud, "invoices@example.com")
    const other = try signedIn(cloud, "other-invoices@example.com")
    const unpinned = try signedIn(cloud, "unpinned@example.com")
    try subscribedTo(cloud, own.organizationId, "cus_own", now)
    try subscribedTo(cloud, other.organizationId, "cus_other", now)
    const day = 86_400
    const at = Math.floor(now / 1000) - 60 * day
    const ids = try sync(() => ({
      first: stripe.invoice({ customer: "cus_own", amountCents: 3_000, periodStart: at, periodEnd: at + 30 * day, lines: 12 }),
      second: stripe.invoice({ customer: "cus_own", amountCents: 3_000, status: "open", periodStart: at + 30 * day, periodEnd: at + 60 * day }),
      draft: stripe.invoice({ customer: "cus_own", amountCents: 3_000, status: "draft", periodStart: at + 60 * day, periodEnd: at + 90 * day }),
      foreign: stripe.invoice({ customer: "cus_other", amountCents: 10_000, periodStart: at, periodEnd: at + 30 * day })
    }))
    const as = (signed: { readonly accessToken: string }) => ({ headers: { authorization: `Bearer ${signed.accessToken}` } })
    const firstPage = try cloud.call("/api/v1/billing/invoices?limit=2", as(own))
    const nextPage = try cloud.call(`/api/v1/billing/invoices?limit=2&cursor=${ids.second}`, as(own))
    const detail = try cloud.call(`/api/v1/billing/invoices/${ids.first}`, as(own))
    const foreign = try cloud.call(`/api/v1/billing/invoices/${ids.foreign}`, as(own))
    const draft = try cloud.call(`/api/v1/billing/invoices/${ids.draft}`, as(own))
    const otherList = try cloud.call("/api/v1/billing/invoices", as(other))
    const unpinnedList = try cloud.call("/api/v1/billing/invoices", as(unpinned))
    const unpinnedDetail = try cloud.call(`/api/v1/billing/invoices/${ids.first}`, as(unpinned))
    const badLimit = try cloud.call("/api/v1/billing/invoices?limit=500", as(own))
    const anonymous = try cloud.call("/api/v1/billing/invoices")
    const read = detail.body as InvoiceDetail
    const errorOf = (answer: { readonly status: number; readonly body: unknown }) => [answer.status, (answer.body as { readonly error: string }).error]
    try check(() => assert.deepStrictEqual(
      {
        firstPage: [firstPage.status, firstPage.body],
        nextPage: [nextPage.status, (nextPage.body as InvoicePage).invoices.map((invoice) => invoice.id), (nextPage.body as InvoicePage).nextCursor],
        detail: [detail.status, read.id, read.status, read.lines.length, read.lines.reduce((sum, line) => sum + line.amountCents, 0), read.periodStart, read.periodEnd, read.pdfUrl, read.lines[11]?.periodEnd],
        foreign: errorOf(foreign),
        draft: errorOf(draft),
        otherList: (otherList.body as InvoicePage).invoices.map((invoice) => invoice.id),
        unpinned: [unpinnedList.status, unpinnedList.body, ...errorOf(unpinnedDetail)],
        refused: [badLimit.status, anonymous.status]
      },
      {
        firstPage: [200, {
          invoices: [{ id: ids.second, number: "FAKE-0002", date: (at + 30 * day) * 1000, status: "open", amountDueCents: 3_000, amountPaidCents: 0, currency: "usd", hostedInvoiceUrl: `https://invoice.stripe.com/i/${ids.second}` }],
          nextCursor: ids.second
        }],
        nextPage: [200, [ids.first], null],
        detail: [200, ids.first, "paid", 12, 3_000, at * 1000, (at + 30 * day) * 1000, `https://pay.stripe.com/invoice/${ids.first}/pdf`, (at + 30 * day) * 1000],
        foreign: [404, "not_found"],
        draft: [404, "not_found"],
        otherList: [ids.foreign],
        unpinned: [200, { invoices: [], nextCursor: null }, 404, "not_found"],
        refused: [400, 401]
      }
    ))
  }))

  it.live("Open the billing portal only for my pinned customer with a fresh session (spec/cloud/billing/subscriptions.md, \"Story: Read my invoices and open the billing portal\")", () => scoped(effect {
    const stripe = try sync(() => createStripeInvoicesFake())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/stripe/", stripe.handler) })
    const now = try Clock.currentTimeMillis
    const own = try signedIn(cloud, "portal@example.com")
    const unpinned = try signedIn(cloud, "portal-unpinned@example.com")
    try subscribedTo(cloud, own.organizationId, "cus_portal", now)
    try sync(() => stripe.customer("cus_portal"))
    const portal = (signed: { readonly accessToken: string }) => cloud.call("/api/v1/subscriptions/portal", { method: "POST", headers: { authorization: `Bearer ${signed.accessToken}` } })
    const first = try portal(own)
    const second = try portal(own)
    const noCustomer = try portal(unpinned)
    try sql(cloud, "UPDATE sessions SET auth_at = $2 WHERE user_id = $1", [own.user.id, now - 2 * 3_600_000])
    const stale = try portal(own)
    const urls = [first.body, second.body].map((body) => (body as { readonly url: string }).url)
    const configuration = stripe.configurations[0]
    try check(() => assert.deepStrictEqual(
      {
        opened: [first.status, second.status, urls.every((url) => url.startsWith("https://billing.stripe.com/")), new Set(urls).size],
        sessions: stripe.portalSessions.map((session) => [session.customer, session.configuration]),
        configuration: [stripe.configurations.length, configuration?.features.subscription_cancel, configuration?.features.subscription_update.enabled, configuration?.features.customer_update.enabled],
        noCustomer: [noCustomer.status, (noCustomer.body as { readonly error: string }).error],
        stale: [stale.status, (stale.body as { readonly error: string }).error, stripe.portalSessions.length]
      },
      {
        opened: [200, 200, true, 2],
        sessions: [["cus_portal", configuration?.id ?? ""], ["cus_portal", configuration?.id ?? ""]],
        configuration: [1, { enabled: true, mode: "at_period_end", proration_behavior: "none" }, false, false],
        noCustomer: [409, "billing_state_conflict"],
        stale: [428, "fresh_session_required", 2]
      }
    ))
  }))
})

import { addUtcMonths, adjustForUpgrade, allowanceView, changeInvoiceAllowance, closePeriods, openGrantMonths, openRenewal, sweepAllowance } from "../src/billing/allowance.vibe"
import { settleSubscriptionAllowance, type Payment, type SubscriptionObservation } from "../src/billing/stripe-ledger.vibe"
import { loadRow as loadPeriodRow } from "../src/store/rows.vibe"

const allowanceMonth = 30 * 24 * 3_600_000

effect function periodStatuses(cloud: TestCloud, organizationId: string) {
  const rows = try sql(cloud, "SELECT key, status FROM allowance_periods WHERE organization_id = $1 ORDER BY key", [organizationId])
  return rows.map((row) => [row.key, row.status])
}

effect function storedAllowance(cloud: TestCloud, key: string) {
  return (try sql(cloud, "SELECT status, state->>'phase' AS phase, state->>'clawbackCause' AS cause, revision::int FROM allowance_periods WHERE key=$1", [key]))[0]
}

describe("WP4 Subscriptions and entitlements: allowance", () => {
  it.live("A refunded invoice claws back its allowance, and what its open hold returns, and is never restored (spec/cloud/billing/allowance.md, \"Story: Lose the allowance of a refunded invoice, and get it back if I win the dispute\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-refund")
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, period_end, updated_at) VALUES ('org-refund', '{}'::jsonb, 1, 'active', 'pro_monthly', $1, $2)", [now + allowanceMonth, now])
    const invoice = { invoiceId: "in_refund", planKey: "ProMonthly", startsAt: now - 1000, endsAt: now + allowanceMonth } as const
    const opened = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-refund", invoice, now))))
    const again = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-refund", invoice, now))))
    const ticket = try cloud.inside(reserve({ organizationId: "org-refund", userId: "user-refund" }, { service: "MeteredInference", caller: "user-refund", requestId: "refund-1", part: { tag: "WholeRequest" } }, 1_000_000))
    const clawed = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(changeInvoiceAllowance(tx, { organizationId: "org-refund", invoiceId: "in_refund" }, { type: "clawBack", cause: "RefundClawback" }, now))))
    try cloud.inside(markDispatched(ticket.key))
    try cloud.inside(settle(ticket.key, { kind: "known", actual: 400_000 }))
    const restored = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(changeInvoiceAllowance(tx, { organizationId: "org-refund", invoiceId: "in_refund" }, { type: "restore", now }, now))))
    const view = try cloud.store.transaction((tx) => allowanceView(tx, "org-refund", now))
    const usage = try sql(cloud, "SELECT from_allowance, from_credits FROM usage_records WHERE hold_key = $1", [ticket.key])
    const stored = try storedAllowance(cloud, opened.key)
    try check(() => assert.deepStrictEqual(
      {
        opened: [opened.key, opened.moved, opened.period.granted, again.moved],
        held: ticket.hold.fromAllowance > 0,
        clawed: [clawed.moved, clawed.period.phase],
        stored,
        restored: restored.moved,
        view,
        usage: usage.map((row) => [Number(row.from_allowance), Number(row.from_credits)])
      },
      {
        opened: ["renewal/staging/in_refund", true, 90_000_000, false],
        held: true,
        clawed: [true, "PeriodRefunded"],
        stored: { status: "clawed_back", phase: "PeriodClawedBack", cause: "RefundClawback", revision: 4 },
        restored: false,
        view: { state: "clawed_back", granted: 90_000_000, adjustment: 0, available: 0, reserved: 0, settled: 400_000, expired: 0, clawedBack: 89_600_000, periodStart: now - 1000, resetsAt: now + allowanceMonth },
        usage: [[400_000, 0]]
      }
    ))
    const legacyKey = "invoice/in_refund"
    try sql(cloud,
      `INSERT INTO allowance_periods (key,state,revision,organization_id,status,period_start,period_end,updated_at)
        SELECT $2,state,revision,organization_id,status,period_start,period_end,updated_at FROM allowance_periods WHERE key=$1`,
      [opened.key, legacyKey])
    const refused = try Effect.flip(cloud.inside(cloud.store.transaction((tx) => cloud.inside(
      changeInvoiceAllowance(tx, { organizationId: "org-refund", invoiceId: "in_refund" }, { type: "restore", now }, now)
    ))))
    const afterConflict = [try storedAllowance(cloud, opened.key), try storedAllowance(cloud, legacyKey)]
    try check(() => assert.deepStrictEqual([refused._tag, afterConflict], ["InvalidAllowancePeriod", [stored, stored]]))
  }))

  it.live("A won dispute restores the allowance while the period is open, and leaves an ended one clawed back (spec/cloud/billing/allowance.md, \"Story: Lose the allowance of a refunded invoice, and get it back if I win the dispute\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-dispute")
    const open = effect (invoiceId: string, startsAt: number, endsAt: number) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-dispute", { invoiceId, planKey: "PlusMonthly", startsAt, endsAt }, now))))).moved
    }
    const disputed = effect (invoiceId: string) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(changeInvoiceAllowance(tx, { organizationId: "org-dispute", invoiceId }, { type: "clawBack", cause: "DisputeClawback" }, now))))).moved
    }
    const won = effect (invoiceId: string) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(changeInvoiceAllowance(tx, { organizationId: "org-dispute", invoiceId }, { type: "restore", now }, now))))).moved
    }
    const opened = [try open("in_won", now - 1000, now + allowanceMonth), try open("in_late", now - allowanceMonth, now - 1000)]
    const clawed = [try disputed("in_won"), try disputed("in_late")]
    const oldDisputed = try storedAllowance(cloud, "renewal/staging/in_won")
    try sql(cloud, "UPDATE allowance_periods SET state=(state - 'clawbackCause') || jsonb_build_object('phase','PeriodDisputed') WHERE key=$1", ["renewal/staging/in_won"])
    const during = try cloud.store.transaction((tx) => allowanceView(tx, "org-dispute", now))
    const restored = [try won("in_won"), try won("in_late")]
    const after = try cloud.store.transaction((tx) => allowanceView(tx, "org-dispute", now))
    const refundedLate = (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(changeInvoiceAllowance(tx, { organizationId: "org-dispute", invoiceId: "in_late" }, { type: "clawBack", cause: "RefundClawback" }, now))))).moved
    const late = (try cloud.store.transaction((tx) => loadPeriodRow(tx, periodRows, "renewal/staging/in_late", false))).state
    const statuses = try periodStatuses(cloud, "org-dispute")
    try check(() => assert.deepStrictEqual(
      {
        opened, clawed,
        during: [during?.state, during?.available, during?.clawedBack],
        restored,
        after: [after?.state, after?.available, after?.clawedBack, after?.resetsAt],
        refundedLate,
        late: [late.phase, late.clawedBack, late.available],
        oldDisputed,
        statuses
      },
      {
        opened: [true, true],
        clawed: [true, true],
        during: ["clawed_back", 0, 25_000_000],
        restored: [true, false],
        after: ["open", 25_000_000, 0, now + allowanceMonth],
        refundedLate: true,
        late: ["PeriodRefunded", 25_000_000, 0],
        oldDisputed: { status: "clawed_back", phase: "PeriodClawedBack", cause: "DisputeClawback", revision: 2 },
        statuses: [["renewal/staging/in_late", "clawed_back"], ["renewal/staging/in_won", "open"]]
      }
    ))
    const restoredNode = try storedAllowance(cloud, "renewal/staging/in_won")
    try organization(cloud, "org-worker-rollout")
    const workerKey = "invoice/in_worker_rollout"
    const startsAt = now - 1000
    const endsAt = now + allowanceMonth
    const observeWorker = (condition: Payment["condition"]) => {
      const subscription: SubscriptionObservation = {
        customerId: "cus_worker_rollout", subscriptionId: "sub_worker_rollout",
        plan: "plus_monthly", status: "active", startsAt, endsAt,
        cancelAtPeriodEnd: false, latestInvoice: "PeriodInvoicePaid",
        payment: { id: "in_worker_rollout", startsAt, endsAt, condition }
      }
      return cloud.store.transaction((tx) => settleSubscriptionAllowance(tx, "org-worker-rollout", subscription, false, now))
    }
    try observeWorker("paid")
    try observeWorker("disputed")
    const disputedWorker = try storedAllowance(cloud, workerKey)
    const workerSeenByNode = try cloud.store.transaction((tx) => allowanceView(tx, "org-worker-rollout", now))
    try observeWorker("paid")
    const restoredWorker = try storedAllowance(cloud, workerKey)
    try check(() => assert.deepStrictEqual(
      [restoredNode, disputedWorker, workerSeenByNode?.state, workerSeenByNode?.clawedBack, restoredWorker],
      [
        { status: "open", phase: "PeriodOpen", cause: "NoClawback", revision: 3 },
        { status: "clawed_back", phase: "PeriodClawedBack", cause: "DisputeClawback", revision: 2 },
        "clawed_back", 25_000_000,
        { status: "open", phase: "PeriodOpen", cause: "NoClawback", revision: 3 }
      ]
    ))
  }))

  it.live("A period expires at its end and its unused allowance is forfeited, while the sweep opens the months of a grant in force (spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-renewed")
    try organization(cloud, "org-granted")
    const ended = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-renewed", { invoiceId: "in_old", planKey: "ProMonthly", startsAt: now - allowanceMonth, endsAt: now - 1000 }, now))))
    const grantFrom = now - 1000
    const firstMonthEnds = addUtcMonths(grantFrom, 1)
    const grantUntil = firstMonthEnds + 10 * 24 * 3_600_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-pilot', 'org-granted', 'pilot', 'plus_monthly', $1, $2, $1)", [grantFrom, grantUntil])
    const swept = try cloud.inside(sweepAllowance())
    const sweptAgain = try cloud.inside(sweepAllowance())
    const renewed = try cloud.store.transaction((tx) => allowanceView(tx, "org-renewed", now))
    const granted = try cloud.store.transaction((tx) => allowanceView(tx, "org-granted", now))
    const partial = (try cloud.store.transaction((tx) => loadPeriodRow(tx, periodRows, "grant/grant-pilot/1", false))).state
    const statuses = [try periodStatuses(cloud, "org-renewed"), try periodStatuses(cloud, "org-granted")]
    try check(() => assert.deepStrictEqual(
      {
        ended: ended.moved,
        swept, sweptAgain,
        renewed,
        granted: [granted?.state, granted?.granted, granted?.available, granted?.periodStart, granted?.resetsAt],
        partial: [partial.phase, partial.startsAt, partial.endsAt, partial.granted > 0 && partial.granted < 25_000_000],
        statuses
      },
      {
        ended: true,
        swept: { expired: 1, opened: 2 },
        sweptAgain: { expired: 0, opened: 0 },
        renewed: { state: "expired", granted: 90_000_000, adjustment: 0, available: 0, reserved: 0, settled: 0, expired: 90_000_000, clawedBack: 0, periodStart: now - allowanceMonth, resetsAt: now - 1000 },
        granted: ["open", 25_000_000, 25_000_000, grantFrom, firstMonthEnds],
        partial: ["PeriodOpen", firstMonthEnds, grantUntil, true],
        statuses: [[["renewal/staging/in_old", "expired"]], [["grant/grant-pilot/0", "open"], ["grant/grant-pilot/1", "open"]]]
      }
    ))
  }))

  it.live("An upgrade mid-period adds exactly the reviewed prorated difference once, and periods close when the subscription ends or a grant is revoked or superseded (spec/cloud/billing/allowance.md, \"Story: Get more allowance when I upgrade mid-period\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-upgrade")
    try organization(cloud, "org-grants")
    const day = 24 * 3_600_000
    try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-upgrade", { invoiceId: "in_up", planKey: "PlusMonthly", startsAt: now - 10 * day, endsAt: now + 20 * day }, now))))
    const reviewed = Math.floor((90_000_000 - 25_000_000) * (20 * 24 * 60) / (30 * 24 * 60))
    const upgrade = effect (amount: number) => {
      return try cloud.store.transaction((tx) => adjustForUpgrade(tx, "org-upgrade", "ProMonthly", now, amount, now))
    }
    const wrong = try upgrade(reviewed + 1)
    const right = try upgrade(reviewed)
    const twice = try upgrade(reviewed)
    const upgraded = try cloud.store.transaction((tx) => allowanceView(tx, "org-upgrade", now))
    const ended = try cloud.store.transaction((tx) => closePeriods(tx, "org-upgrade", { kind: "SubscriptionEnded" }, now))
    const closedRenewal = try cloud.store.transaction((tx) => allowanceView(tx, "org-upgrade", now))
    const lifetime = { id: "grant-life", planKey: "PlusMonthly", effectiveFrom: now - 1000, effectiveUntil: null } as const
    const monthly = { id: "grant-month", planKey: "PlusMonthly", effectiveFrom: now - 1000, effectiveUntil: addUtcMonths(now - 1000, 1) } as const
    const life = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", lifetime, now))
    const lifeAgain = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", lifetime, now))
    const month = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", monthly, now))
    const revoked = try cloud.store.transaction((tx) => closePeriods(tx, "org-grants", { kind: "GrantRevoked", grantId: "grant-life" }, now))
    const superseded = try cloud.store.transaction((tx) => closePeriods(tx, "org-grants", { kind: "SupersededByPaid" }, now))
    const statuses = try periodStatuses(cloud, "org-grants")
    try check(() => assert.deepStrictEqual(
      {
        upgrade: [wrong.moved, right.moved, right.period.planKey, right.period.adjustment, twice.moved],
        upgraded: [upgraded?.state, upgraded?.granted, upgraded?.adjustment, upgraded?.available],
        ended: ended.map((step) => [step.key, step.period.phase]),
        closedRenewal: [closedRenewal?.state, closedRenewal?.available, closedRenewal?.expired],
        opened: [life.map((step) => step.key), lifeAgain.length, month.map((step) => step.key)],
        revoked: revoked.map((step) => step.key),
        superseded: superseded.map((step) => step.key),
        statuses
      },
      {
        upgrade: [false, true, "ProMonthly", reviewed, false],
        upgraded: ["open", 25_000_000, reviewed, 25_000_000 + reviewed],
        ended: [["renewal/staging/in_up", "PeriodClosed"]],
        closedRenewal: ["closed", 0, 25_000_000 + reviewed],
        opened: [["grant/grant-life/0", "grant/grant-life/1", "grant/grant-life/2"], 0, ["grant/grant-month/0"]],
        revoked: ["grant/grant-life/0", "grant/grant-life/1", "grant/grant-life/2"],
        superseded: ["grant/grant-month/0"],
        statuses: [["grant/grant-life/0", "closed"], ["grant/grant-life/1", "closed"], ["grant/grant-life/2", "closed"], ["grant/grant-month/0", "closed"]]
      }
    ))
  }))
})

module node {
  import { Effect, Schema } from "effect"
  import { SecureRandom } from "effect/crypto"
  import { createCipheriv, createDecipheriv, createHash, randomBytes } from "node:crypto"
  import { exportJWK, generateKeyPair, SignJWT } from "jose"
  import { CLEF_DECISIONS_PATH, createClefDecisionsClient, type ClefDecisionRequest, CloudError, createCloudClient } from "@elizaos/cloud"
  import { signInWithProof } from "../src/identity-store.vibe"
  import { cloudWorker, type CloudBindings } from "../src/worker.vibe"
  import { googleRequest } from "../src/google.vibe"
  import { htmlAtLimit, htmlOverLimit, htmlReadSummary, mimeBoundaryPayload, mimeReadSummary } from "./support/fakes/google-gmail.ts"
  import { openBackupDatabase } from "./support/password-backup.ts"
  import { registerClients, workerBindings } from "./support/worker.ts"
  import { clefWorker } from "./support/clef.ts"

  export function forwardedHref(script: string, html: string, address: string): string {
    const attributes: Record<string, string> = {
      "data-purpose": /data-purpose="([^"]*)"/.exec(html)?.[1] ?? "",
      href: (/href="(intent:[^"]*)"/.exec(html)?.[1] ?? "").replaceAll("&amp;", "&")
    }
    const link = { getAttribute: (name: string) => attributes[name] ?? null, setAttribute: (name: string, value: string) => { attributes[name] = value } }
    const at = new URL(address)
    new Function("document", "location", "history", script)({ getElementById: () => link }, { hash: at.hash, search: at.search, pathname: at.pathname }, { replaceState: () => undefined })
    return attributes.href ?? ""
  }

  export async function readMailThroughClient(baseUrl: string, token: string, messageId: string) {
    const client = (beforeTheField: boolean) => createCloudClient({ baseUrl, credential: () => token, fetch: async (input, init) => {
      const answer = await fetch(input, init)
      if (!beforeTheField) return answer
      const { authenticationResults: _, ...older } = Schema.decodeUnknownSync(Schema.Record(Schema.String, Schema.Unknown))(await answer.json())
      return Response.json(older, { status: answer.status, headers: answer.headers })
    } })
    return [(await client(false).gmailRead({ messageId })).authenticationResults, (await client(true).gmailRead({ messageId })).authenticationResults]
  }

  export async function nativeGoogleFixture() {
    const { privateKey, publicKey } = await generateKeyPair("RS256", { extractable: true })
    const key = { ...await exportJWK(publicKey), kid: "google-test", alg: "RS256" }
    return {
      keys: [key],
      issue: (nonce: string) => new SignJWT({ nonce, email: "linked@example.test", email_verified: true })
        .setProtectedHeader({ alg: "RS256", kid: "google-test" })
        .setIssuer("https://accounts.google.com")
        .setAudience("google-server-client")
        .setSubject("linked-google-subject")
        .setExpirationTime("5m")
        .sign(privateKey),
    }
  }

  export async function decideForSignedInAccount() {
    const fixture = await openBackupDatabase()
    try {
      const providerInputs: string[] = []
      let chosen = "hours"
      async function run(id: string, input: Record<string, unknown>, options: { returnRawResponse: true; signal: AbortSignal }): Promise<Response>
      async function run(id: string, input: unknown): Promise<unknown>
      async function run(id: string, input: unknown, options?: unknown): Promise<unknown> {
        if (options) return Response.json({ error: "unexpected inference request" }, { status: 500 })
        providerInputs.push(JSON.stringify({ id, input }))
        if (providerInputs.length === 1) await Effect.runPromise(Effect.sleep(4_250))
        return { model: "clef-flash", answers: { target: {
          type: "choice", choice: chosen, confidence: .95, probabilities: { hours: .95, none: .05 },
        } } }
      }
      const { owner, web, api, env, worker } = await clefWorker(fixture, "d".repeat(64), "reader@example.test", { run })
      const body: ClefDecisionRequest = { kind: "choice", goal: "Find opening hours", page: "Session https://example.test/?token=private",
        candidates: [{ id: "hours", label: "Opening hours" }] }
      const headers = { origin: web, cookie: "__Host-eliza-session=" + owner.access, "X-Eliza-Account": owner.account.id }
      const post = (value: unknown, supplied: Record<string, string>) => worker.fetch(new Request(api + CLEF_DECISIONS_PATH, {
        method: "POST", headers: { ...supplied, "content-type": "application/json" }, body: JSON.stringify(value),
      }), env)
      const signedOut = await post(body, { origin: web })
      const changedAccount = await post(body, { ...headers, "X-Eliza-Account": "different-account" })
      const extraFields = await post({ ...body, form: { password: "private" } }, headers)
      const duplicateIds = await post({ ...body, candidates: [body.candidates[0], body.candidates[0]] }, headers)
      const client = createClefDecisionsClient({ baseUrl: api, headers: () => headers,
        fetch: (input, options) => worker.fetch(new Request(input, options), env) })
      const decision = await client(body)
      chosen = "older-snapshot"
      const staleChoice = await client(body)
      await fixture.db.query("UPDATE cloud_auth_limits SET hits = 2000 WHERE scope = 'clef:organization'")
      const blocked = await post(body, headers)
      const account = await fixture.db.query<{ hits: number }>("SELECT hits FROM cloud_auth_limits WHERE scope = 'clef:account'")
      return {
        refusals: [signedOut.status, changedAccount.status, extraFields.status, duplicateIds.status, blocked.status],
        decision, staleChoice, providerCalls: providerInputs.length, accountCalls: account.rows[0]?.hits,
        withheld: providerInputs.every((input) => !input.includes("token=private") && !input.includes("https://example.test")),
      }
    } finally { await fixture.close() }
  }
  export async function readSelectedAttachment() {
    const fixture = await openBackupDatabase()
    try {
      const digest = "a".repeat(64)
      await fixture.db.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, 'staging', 1)", [digest])
      const signIn = (email: string) => Effect.runPromise(Effect.provide(signInWithProof(fixture.db, { provider: "email", subject: email, email }), SecureRandom.layerWebCrypto))
      const owner = await signIn("attachment-owner@example.test")
      const other = await signIn("attachment-other@example.test")
      const web = "https://app.example.test"
      const api = "https://api.example.test"
      const key = "11".repeat(32)
      const subject = "fixture-google-subject"
      const grant = "00112233-4455-6677-8899-aabbccddeeff"
      const nonce = Buffer.alloc(12)
      const cipher = createCipheriv("aes-256-gcm", Buffer.from(key, "hex"), nonce)
      cipher.setAAD(Buffer.from(JSON.stringify(["cloud-google-token-v1", api, owner.account.id, subject, true, true])))
      const encrypted = Buffer.concat([nonce, cipher.update("fixture-refresh"), cipher.final(), cipher.getAuthTag()]).toString("hex")
      await fixture.db.query("INSERT INTO cloud_google_connections (account_id, id, subject, email, mail, calendar, refresh_cipher) VALUES ($1, $2, $3, $4, true, true, $5)",
        [owner.account.id, grant, subject, "attachment-owner@example.test", encrypted])
      const wholeText = "x".repeat(8 * 1024 * 1024)
      const externalText = "é".repeat(450 * 1024)
      const bytes = Buffer.from("%PDF-local-fixture")
      const part = { partId: "1", filename: "fixture.pdf", mimeType: "application/pdf", body: { attachmentId: "fixture-attachment", size: bytes.length } }
      const unsupported = { partId: "2", filename: "fixture.html", mimeType: "text/html", body: { attachmentId: "never-fetch", size: 10 } }
      const oversized = { partId: "3", filename: "large.pdf", mimeType: "application/pdf", body: { attachmentId: "never-fetch", size: 8 * 1024 * 1024 + 1 } }
      let attachmentFetches = 0
      let redirect = false
      let changedBytes = false
      let revokeDuringDownload = false
      let revokeListing: "grant" | "session" | undefined
      let providerRequestsValid = true
      const providerCalls: string[] = []
      const suppliedPage = "opaque+/?=%#&".padEnd(4096, "x")
      let searchReply: { historyId: string | null; messages: string[]; nextPageToken?: string } | undefined
      const searchCalls: unknown[][] = []
      const searchCards: string[] = []
      const arrivalRequests: string[] = []
      const triageLimits: Array<string | null> = []
      let mailArrived = false
      let staleHistory = false
      let rejectHistory = false
      let revokeArrival = false
      let invalidHistory = false
      let invalidTriageRevision = false
      let incompleteHistory: "cycle" | "over-budget" | undefined
      let abortArrival: AbortController | undefined
      let providerAbort: AbortSignal | undefined
      const providerFetch: typeof fetch = async (input, init) => {
        const request = new Request(input, init)
        const url = new URL(request.url)
        providerCalls.push(`${request.method} ${url.origin}${url.pathname}`)
        providerRequestsValid &&= request.redirect === "manual"
        if (url.href === "https://oauth2.googleapis.com/token" && request.method === "POST")
          return Response.json({ access_token: "fixture-access", scope: "https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.events.readonly" })
        providerRequestsValid &&= request.headers.get("authorization") === "Bearer fixture-access"
        if (url.origin === "https://www.googleapis.com" && url.pathname === "/calendar/v3/calendars/primary/events") {
          return Response.json({ timeZone: "UTC", items: [{ id: "fixture-appointment", summary: "Library visit",
            start: { dateTime: "2026-12-01T12:00:00Z" }, end: { dateTime: "2026-12-01T13:00:00Z" } }] })
        }
        if (searchReply && url.origin === "https://gmail.googleapis.com") {
          if (url.pathname === "/gmail/v1/users/me/profile") {
            searchCalls.push(["profile", url.searchParams.get("fields")])
            return Response.json(searchReply.historyId === null ? {} : { historyId: searchReply.historyId })
          }
          if (url.pathname === "/gmail/v1/users/me/messages") {
            const token = url.searchParams.get("pageToken")
            searchCalls.push(["list", url.searchParams.get("q"), url.searchParams.get("maxResults"),
              url.searchParams.get("includeSpamTrash"), token === null ? null : token === suppliedPage])
            return Response.json({ messages: searchReply.messages.map((id) => ({ id })), nextPageToken: searchReply.nextPageToken })
          }
          if (url.pathname.startsWith("/gmail/v1/users/me/messages/")) {
            searchCards.push(url.pathname.split("/").at(-1) + ":" + url.searchParams.get("format"))
          }
        }
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/profile") {
          arrivalRequests.push(url.pathname + url.search)
          return Response.json({ historyId: invalidTriageRevision ? "malformed" : "10000000000000000001" })
        }
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/history") {
          arrivalRequests.push(url.pathname + url.search)
          if (staleHistory) return Response.json({}, { status: 404 })
          if (rejectHistory) return Response.json({}, { status: 401 })
          if (invalidHistory) return Response.json({ historyId: "malformed" })
          if (incompleteHistory) {
            const page = Number(url.searchParams.get("pageToken") ?? "0")
            return Response.json({ historyId: "10000000000000000003", nextPageToken: incompleteHistory === "cycle" ? "1" : String(page + 1) })
          }
          if (abortArrival) {
            providerAbort = request.signal
            abortArrival.abort()
          }
          if (revokeArrival) await fixture.db.query("UPDATE device_grants SET key_expires_at = 0 WHERE user_id = $1", [owner.account.id])
          if (!url.searchParams.has("pageToken")) return Response.json({ historyId: "10000000000000000003", nextPageToken: "next" })
          return Response.json({ historyId: "10000000000000000003", history: mailArrived ?
            [{ id: "10000000000000000002", messagesAdded: [{ message: { id: "private-mail" } }] }] :
            [{ id: "10000000000000000002" }] })
        }
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/messages") {
          const label = url.searchParams.get("labelIds")
          if (label === "INBOX") triageLimits.push(url.searchParams.get("maxResults"))
          const found = label === "INBOX" ? ["automated-message", "fixture-message", "moved-to-trash"] : label === "TRASH" && url.searchParams.get("includeSpamTrash") === "true" &&
            url.searchParams.get("q") === "subject:plan & dates" ? ["trashed-message", "moved-message"] : []
          return Response.json({ messages: found.map((id) => ({ id })), nextPageToken: "page-two" })
        }
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/labels/INBOX")
          return Response.json({ id: "INBOX", messagesUnread: 52 })
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/labels/DRAFT") {
          if (revokeListing === "grant") await fixture.db.query("DELETE FROM cloud_google_connections WHERE account_id = $1", [owner.account.id])
          if (revokeListing === "session") await fixture.db.query("UPDATE sessions SET live = false WHERE user_id = $1", [owner.account.id])
          return Response.json({ id: "DRAFT", messagesTotal: 7 })
        }
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/messages/automated-message")
          return Response.json({ id: "automated-message", threadId: "automated-thread", internalDate: "1760000001000", historyId: "790",
            labelIds: ["INBOX", "UNREAD", "IMPORTANT"], payload: { headers: [
