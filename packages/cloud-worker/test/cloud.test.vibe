      mailbox.messages.set("page-earlier", { id: "page-earlier", threadId: "thr-pages", labelIds: ["TRASH"], historyId: String(++mailbox.history), internalDate: now - 1000, bodyText: earlierText })
      mailbox.messages.set("page-oversized", { id: "page-oversized", threadId: "thr-indivisible", labelIds: ["TRASH"], historyId: String(++mailbox.history), internalDate: now, bodyText: "\0".repeat(300 * 1024) })
    })
    type Page = { readonly historyId: string; readonly total: number; readonly offset: number; readonly nextOffset: number | null; readonly messages: ReadonlyArray<{ readonly message: { readonly id: string }; readonly historyId: string; readonly bodyText: string }> }
    const page = (suffix: string) => promise(async () => {
      const response = await openCloud(cloud.url, "/api/v1/eliza/google/gmail/inbox-v1/thread?threadId=thr-pages" + suffix, { headers: { authorization: `Bearer ${token}` } })
      const bytes = await response.arrayBuffer()
      return { status: response.status, bytes: bytes.byteLength, body: JSON.parse(new TextDecoder().decode(bytes)) as Page }
    })
    const first = try page("")
    const next = try page("&offset=1&historyId=" + first.body.historyId)
    const missingRevision = try gmail("/inbox-v1/thread?threadId=thr-pages&offset=1")
    const indivisible = try gmail("/inbox-v1/thread?threadId=thr-indivisible")
    try sync(() => touchMessage(mailbox, "page-later"))
    const changedPage = try gmail("/inbox-v1/thread?threadId=thr-pages&offset=1&historyId=" + first.body.historyId)
    const pageOf = (result: { readonly status: number; readonly bytes: number; readonly body: Page }, expected: string) => [
      result.status, result.bytes <= 1.5 * 1024 * 1024, result.body.total, result.body.offset, result.body.nextOffset,
      result.body.messages.map((message) => [message.message.id, message.historyId, message.bodyText === expected]),
    ]
    try Effect.try(() => touchMessage(mailbox, "msg-direct"))
    const staleAttachment = try gmail("/inbox-v1/attachment?messageId=msg-direct&partId=1&historyId=1001")
    const staleThread = try gmail("/inbox-v1/thread?threadId=thr-direct&historyId=1001")
    const drafts = try gmail("/inbox-v1/drafts")
    const draft = try gmail("/inbox-v1/draft?draftId=draft-1")
    const anonymous = try cloud.call("/api/v1/eliza/google/gmail/triage")
    const restricted = [
      { id: "metadata", scopes: [metadataScope] },
      { id: "readonly", scopes: scopeFor("google.gmail.triage") },
      { id: "compose", scopes: scopeFor("google.gmail.drafts") },
      { id: "send", scopes: scopeFor("google.gmail.send") },
