    }
    const surfaces = ["/triage", "/search?query=plan", "/read?messageId=msg-trashed",
      "/inbox-v1/thread?threadId=thr-direct", "/inbox-v1/attachment?messageId=mime-over-limit&partId=2&historyId=" + (mailbox.messages.get("mime-over-limit")?.historyId ?? ""),
      "/inbox-v1/drafts", "/inbox-v1/draft?draftId=draft-1", "/inbox-v1/capabilities"]
    const atSurface = (path: string, grantId: string, side = "owner") => gmail(path + (path.includes("?") ? "&" : "?") + new URLSearchParams({ grantId, side }))
    const decisions = try all(restricted.map((grant) => effect {
      const replies = try all(surfaces.map((path) => atSurface(path, grant.id)))
      return replies.map((reply) => {
        const value = reply.body as { readonly reason?: string; readonly kinds?: ReadonlyArray<string> }
        return reply.status === 200 ? value.kinds ?? 200 : [...errorOf(reply), value.reason]
      })
    }))
    const advertised = try promise(() => Promise.all(restricted.map(async (grant) => {
      const value = await client.gmailCapabilities({ grantId: grant.id })
      return ["reads" in value ? value.reads : undefined, "providerExactlyOnce" in value ? value.providerExactlyOnce : undefined]
    })))
    const beforeRejected = cloud.fakes.seen.length
    const wrongSides = try all(surfaces.map((path) => atSurface(path, "metadata", "other")))
    const foreign = try atSurface("/read?messageId=msg-direct", "no-held-grant")
    const ambiguous = try gmail("/triage")
    const afterRejected = cloud.fakes.seen.length
    const missing = [403, "access_denied", "capability_missing"]
    try check(() => assert.deepStrictEqual({
      decisions, advertised, wrongSides: wrongSides.map(errorOf), selection: [errorOf(foreign), errorOf(ambiguous)],
      providerCallsOnRejectedSelection: afterRejected - beforeRejected,
    }, {
      decisions: [
        [200, missing, missing, missing, missing, missing, missing, []],
        [200, 200, 200, 200, 200, missing, missing, []],
        [missing, missing, missing, missing, missing, 200, 200, ["draft-create", "draft-replace", "draft-delete"]],
        [missing, missing, missing, missing, missing, missing, missing, ["send"]],
      ],
      advertised: [
        [["triage", "capabilities"], false],
        [["triage", "search", "read", "thread", "attachment", "capabilities"], false],
        [["drafts", "draft", "capabilities"], false],
        [["capabilities"], false],
      ],
      wrongSides: surfaces.map(() => [400, "invalid_request"]),
      selection: [[404, "not_found"], [400, "invalid_request"]],
      providerCallsOnRejectedSelection: 0,
    }))
    const keyOnly = (path: string) => cloud.call(`/api/v1/eliza/google${path}`, { headers: { authorization: `Bearer ${tablet.deviceKey}` } })
    const deviceKey = [try keyOnly("/gmail/search?query=plan"), try keyOnly("/gmail/read?messageId=msg-direct"), try keyOnly("/gmail/inbox-v1/drafts"), try keyOnly("/status"), try keyOnly("/calendar/feed")]
      .map((answer) => [answer.status, (answer.body as { readonly reason?: string }).reason])
    const pdf = new TextEncoder().encode("%PDF-plan")
    type Card = { readonly id: string; readonly triageScore: number; readonly triageReason: string; readonly isImportant: boolean; readonly likelyReplyNeeded: boolean; readonly to: ReadonlyArray<string>; readonly metadata: { readonly historyId: string } }
    const cards = (answer: { readonly body: unknown }) => (answer.body as { readonly messages: ReadonlyArray<Card> }).messages.map((card) => [card.id, card.triageScore, card.triageReason, card.isImportant, card.likelyReplyNeeded, card.metadata.historyId])
    const readBody = read.body as { readonly message: Card; readonly bodyText: string; readonly bodyHtml: string | null; readonly bodyHtmlStatus: string; readonly attachments: ReadonlyArray<unknown>; readonly authenticationResults: string | null }
    const file = attachment.body as { readonly name: string; readonly mimeType: string; readonly size: number; readonly dataBase64: string; readonly sha256: string; readonly supported: boolean }
    const threadBody = thread.body as { readonly historyId: string; readonly total: number; readonly messages: ReadonlyArray<{ readonly bodyText: string }> }
    const draftList = drafts.body as { readonly drafts: ReadonlyArray<{ readonly draftId: string; readonly messageId: string; readonly subject: string; readonly to: ReadonlyArray<string> }>; readonly nextPageToken: string | null }
    const draftBody = draft.body as { readonly providerDigest: string; readonly content: { readonly to: ReadonlyArray<string>; readonly subject: string; readonly bodyText: string; readonly plainText: boolean } }
    try check(() => assert.deepStrictEqual(
      {
        triage: [triage.status, (triage.body as { readonly mailboxHistoryId: string }).mailboxHistoryId, triageLimit, cards(triage)],
        search: [search.status, (search.body as { readonly mailboxHistoryId: string }).mailboxHistoryId, (search.body as { readonly nextPageToken: string | null }).nextPageToken, cards(search)],
        tooMany: errorOf(tooMany),
        managed: managedResponses,
        read: [read.status, readBody.message.id, readBody.message.to, readBody.bodyText, readBody.bodyHtml, readBody.bodyHtmlStatus, readBody.attachments, readBody.authenticationResults],
        fetched: [fetched.status, (fetched.body as { readonly authenticationResults: string | null }).authenticationResults],
        client: decoded,
        text: [whole.message.id, whole.bodyText === wholeText, snippet.bodyText],
        html,
        mime: [mime, mimeAttachment.status, (mimeAttachment.body as { readonly dataBase64?: string }).dataBase64, mimeMalformed.status],
        oversized: errorOf(oversized),
        asciiOversized: errorOf(asciiOversized),
        capabilities: [capabilities.status, capabilities.body],
        attachment: [attachment.status, file.name, file.mimeType, file.size, file.dataBase64, file.sha256, file.supported],
        thread: [thread.status, threadBody.historyId, threadBody.total, threadBody.messages.map((message) => message.bodyText)],
        pages: [first.body.historyId === next.body.historyId, pageOf(first, earlierText), pageOf(next, laterText)],
        pageRefusals: [errorOf(missingRevision), errorOf(changedPage), errorOf(indivisible)],
        stale: [errorOf(staleAttachment), errorOf(staleThread)],
        drafts: [drafts.status, draftList.drafts, draftList.nextPageToken],
        draft: [draft.status, draftBody.providerDigest, draftBody.content.to, draftBody.content.subject, draftBody.content.bodyText, draftBody.content.plainText],
        anonymous: errorOf(anonymous),
        deviceKey
      },
      {
        triage: [200, "1004", "12", [
          ["msg-direct", 110, "unread, important label, directly addressed, likely needs reply", true, true, "1001"],
          ["msg-digest", 0, "directly addressed, automated sender", false, false, "1002"]
        ]],
        search: [200, "1004", null, [["msg-direct", 110, "unread, important label, directly addressed, likely needs reply", true, true, "1001"]]],
        tooMany: [400, "invalid_request"],
        managed: {
          pages: [200, 200, owner.userId, owner.userId, "inbox", "", true, null, ["msg-digest", "msg-direct"]],
          trash: [200, owner.userId, "trash", "plan", ["msg-trashed"], null],
          search: [owner.userId, "plan", ["msg-direct"]],
          preview: [owner.userId, "msg-direct", "1001", true],
          invalid: [400, "invalid_request"],
        },
        read: [200, "msg-direct", ["conn-mail@example.com"], "Please review the plan.", null, "none", [{ partId: "1", name: "plan.pdf", mimeType: "application/pdf", size: pdf.length, supported: true }],
          "mx.google.com; dkim=pass header.i=@example.org; dmarc=pass header.from=example.org"],
        fetched: [200, null],
        client: ["mx.google.com; dkim=pass header.i=@example.org; dmarc=pass header.from=example.org", undefined],
        text: ["msg-digest", true, "plan"],
        html: expectedHtmlReads,
        mime: [expectedMimeReads, 200, btoa("last.txt"), 502],
        oversized: [413, "content_too_large"],
        asciiOversized: [413, "content_too_large"],
        capabilities: [200, { version: 1, from: "conn-mail@example.com", reads: ["triage", "search", "read", "thread", "attachment", "drafts", "draft", "capabilities"],
          kinds: ["draft-create", "draft-replace", "draft-delete"], attachmentPolicy: { mimeTypes: ["application/pdf", "text/plain", "image/png", "image/jpeg", "image/webp"], maxBytes: 8 * 1024 * 1024 }, providerExactlyOnce: false }],
        attachment: [200, "plan.pdf", "application/pdf", pdf.length, btoa("%PDF-plan"), sha256Hex("%PDF-plan"), true],
        thread: [200, "1001", 1, ["Please review the plan."]],
        pages: [true, [200, true, 2, 0, 1, [["page-earlier", "1006", true]]], [200, true, 2, 1, null, [["page-later", "1005", true]]]],
        pageRefusals: [[400, "invalid_request"], [409, "stale_revision"], [413, "content_too_large"]],
        stale: [[409, "stale_revision"], [409, "stale_revision"]],
        drafts: [200, [{ draftId: "draft-1", messageId: "msg-draft-1", subject: "Re: Quarterly plan", to: ["ada@example.org"], snippet: "", updatedAt: null }], null],
        draft: [200, sha256Hex(draftRaw), ["ada@example.org"], "Re: Quarterly plan", "Looks good.", true],
        anonymous: [401, "authentication_required"],
        deviceKey: Array.from({ length: 5 }, () => [403, "device_key_not_allowed"])
      }
    ))
