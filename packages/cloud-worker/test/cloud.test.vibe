      const repeatedTablet = Schema.decodeUnknownSync(enrollment)(await replayedExchange.json())
      const bearerHeaders = (token: string) => ({ authorization: "Bearer " + token })
      const beforeAcknowledgement = await deviceOperation("lease", {}, bearerHeaders(tablet.lease.refresh))
      const acknowledged = await deviceOperation("ack", {}, bearerHeaders(tablet.token))
      const lease = await deviceOperation("lease", {}, bearerHeaders(tablet.lease.refresh))
      const pair = Schema.decodeUnknownSync(Schema.Struct({ access: Schema.String, refresh: Schema.String }))(await lease.json())
      const readTablet = (path: string, headers: Record<string, string>) =>
        worker.fetch(new Request(api + "/api/v1/eliza/google/" + path, { headers }), env)
      const tabletHeaders = bearerHeaders(pair.access)
      const mailPath = "gmail/read?" + query
      const calendarPath = "calendar/feed?timeMin=2026-12-01T00:00:00Z&timeMax=2026-12-02T00:00:00Z&grantId=" + grant
      const tabletMessage = await readTablet(mailPath, tabletHeaders)
      const messageBody = Schema.decodeUnknownSync(Schema.Struct({ accountId: Schema.String, bodyText: Schema.String }))(await tabletMessage.json())
      const tabletCalendar = await readTablet(calendarPath, tabletHeaders)
      const calendarBody = Schema.decodeUnknownSync(Schema.Struct({ accountId: Schema.String,
        events: Schema.Array(Schema.Struct({ externalId: Schema.String, title: Schema.String })) }))(await tabletCalendar.json())
      const deviceAndCookie = await readTablet(mailPath, { ...webHeaders, ...bearerHeaders(tablet.token) })
      const forbiddenWrite = await worker.fetch(new Request(api + "/api/v1/eliza/google/gmail/inbox-v1/operations", {
        method: "POST", headers: { ...webHeaders, ...tabletHeaders, "content-type": "application/json" }, body: "{}",
      }), env)
      const renewal = Schema.Struct({ token: Schema.String, credentialId: Schema.String })
      const renewed = await deviceOperation("renew", {}, bearerHeaders(pair.refresh))
      const repeatedRenewed = await deviceOperation("renew", {}, bearerHeaders(pair.refresh))
      const replacement = Schema.decodeUnknownSync(renewal)(await renewed.json())
      const repeatedReplacement = Schema.decodeUnknownSync(renewal)(await repeatedRenewed.json())
      const confirmedReplacement = await deviceOperation("ack", {}, bearerHeaders(replacement.token))
      const closedLease = await deviceOperation("revoke", {}, bearerHeaders(pair.refresh))
      const afterSignOut = [await readTablet(mailPath, tabletHeaders), await readTablet(calendarPath, tabletHeaders)]
      const mobile = (path: string, method: "POST" | "DELETE", data: object, headers: Record<string, string> = {}) =>
        worker.fetch(new Request(api + "/api/v1/app-auth/" + path, {
          method, headers: { ...headers, "content-type": "application/json" }, body: JSON.stringify(data),
        }), env)
      const mobileBinding = { clientId, environment: "staging", redirectUri }
      const state = "q".repeat(43)
      const begin = await mobile("connect", "POST", { ...mobileBinding, state, codeChallenge: challenge, codeChallengeMethod: "S256" }, bearerHeaders(owner.access))
      const { code } = Schema.decodeUnknownSync(Schema.Struct({ code: Schema.String }))(await begin.json())
      const mint = await mobile("mobile/token", "POST", { ...mobileBinding, grantType: "authorization_code", code, state, codeVerifier: verifier })
      const official = Schema.decodeUnknownSync(Schema.Struct({ credentialId: Schema.String, secret: Schema.String, lease: Schema.Struct({ refresh: Schema.String }) }))(await mint.json())
      const officialAcknowledged = await mobile("mobile/ack", "POST", { credentialId: official.credentialId, secret: official.secret })
      const officialRefresh = await mobile("mobile/lease", "POST", {}, bearerHeaders(official.lease.refresh))
      const officialPair = Schema.decodeUnknownSync(Schema.Struct({ access: Schema.String, refresh: Schema.String }))(await officialRefresh.json())
      const officialRead = await readTablet(mailPath, bearerHeaders(officialPair.access))
      const officialClosed = await mobile("mobile/lease", "DELETE", {}, bearerHeaders(officialPair.refresh))
      const officialAfter = await readTablet(mailPath, bearerHeaders(officialPair.access))
      const tabletReads = {
        canonical: [begin.status, mint.status, officialAcknowledged.status, officialRefresh.status, officialRead.status, officialClosed.status, officialAfter.status],
        enrollment: [granted.status, exchanged.status, replayedExchange.status, tablet.token === repeatedTablet.token,
          tablet.lease.refresh === repeatedTablet.lease.refresh, beforeAcknowledgement.status, acknowledged.status, lease.status],
        renewal: [renewed.status, repeatedRenewed.status, replacement.token === repeatedReplacement.token,
          replacement.credentialId === repeatedReplacement.credentialId, confirmedReplacement.status],
        mail: [tabletMessage.status, messageBody.accountId === owner.account.id, messageBody.bodyText],
        calendar: [tabletCalendar.status, calendarBody.accountId === owner.account.id, calendarBody.events],
        refused: [deviceAndCookie.status, forbiddenWrite.status, closedLease.status, ...afterSignOut.map((answer) => answer.status)],
      }
      revokeListing = "session"
      const signedOut = await get(folder, owner.access)
      const signedBackIn = await signIn("attachment-owner@example.test")
      revokeListing = "grant"
      const disconnected = await get(folder, signedBackIn.access)
      const schedule = async () => {
        const answer = await worker.fetch(new Request(api + "/api/v1/calendar-reminders/device", { headers: otherDevice }), env)
        return [answer.status, await answer.json()]
      }
      const unconnectedSchedule = await schedule()
      await fixture.db.query(`INSERT INTO google_connections (key, state, revision, organization_id, user_id, subject, email, status, tokens, linked_at)
        SELECT 'other-google', '{}'::jsonb, 1, organization_id, key, 'other-google-subject', 'attachment-other@example.test', 'Active', 'sealed', 1 FROM accounts WHERE key = $1`, [other.account.id])
      const reconnectedSchedule = await schedule()
      return {
        reminders: [unconnectedSchedule, reconnectedSchedule],
        arrivalResult, triage, search, mailboxes, deniedFolders, tabletReads, leaseOffers, signedOut: signedOut.status, disconnected: disconnected.status,
        refused, beforeDeviceRead, deviceStatus: onDevice.status, deviceReceipt, changed: changed.status, revoked: revoked.status,
        organization, grant, manifest, mailText, html, mime: [mime, mimeAttachment.status, mimeFile.dataBase64, mimeMalformed.status],
        readStatus: read.status, guardStatuses, guardedDownloads, file, fileStatus: downloaded.status,
        cache: downloaded.headers.get("cache-control"), owner: owner.account.id, expectedHash: createHash("sha256").update(bytes).digest("hex"),
        expectedData: bytes.toString("base64"), size: bytes.length, rejectedRedirect: rejectedRedirect.status, providerRequestsValid, attachmentFetches,
      }
    } finally {
      await fixture.close()
    }
  }

}
import { decideForSignedInAccount, forwardedHref, nativeGoogleFixture, readMailThroughClient, readSelectedAttachment } from node

it.live('A reviewed link decision stays within the current account and candidates (spec/cloud/index.md, "Story: Ask for a bounded decision about a browser page")', () => effect {
  const result = try tryPromise(() => decideForSignedInAccount())
  try check(() => assert.deepStrictEqual(result, {
    refusals: [401, 403, 400, 400, 429],
    decision: { status: "ok", kind: "choice", model: "clef-flash", choice: "hours", confidence: .95, probabilities: { hours: .95, none: .05 } },
    staleChoice: { status: "unavailable", reason: "provider_error" }, providerCalls: 2, accountCalls: 2, withheld: true,
  }))
}, 30_000)


it.live('Read complete mail text, open the selected named attachment, watch for new mail and read the connected calendar from a signed-in tablet (spec/cloud/identity/sessions.md, "Story: Keep a tablet signed in to mail and calendar"; spec/cloud/services/google/mailRead.md, "Story: Read my mail through the grant I chose"; "Story: Notice new mail while I sign in privately"; spec/cloud/identity/requestAuth.md, "A device key is limited to 120 requests a minute before it is looked up"; spec/cloud/index.md, "A device reminder follows the reviewed event occurrence")', () => effect {
  const got = try tryPromise(() => readSelectedAttachment())
  try check(() => assert.deepStrictEqual(
    {
      arrivals: got.arrivalResult,
      tablet: got.tabletReads,
      leaseOffers: got.leaseOffers,
      text: got.mailText,
      html: got.html,
      mime: got.mime,
      search: got.search,
      read: [got.readStatus, got.manifest.historyId, got.manifest.bodyText, got.manifest.attachments, got.manifest.authenticationResults],
      refuse: [got.guardStatuses, got.guardedDownloads, got.rejectedRedirect],
      file: [got.fileStatus, got.cache, got.file],
      provider: [got.providerRequestsValid, got.attachmentFetches],
      triage: got.triage,
      mailboxes: [got.mailboxes, got.deniedFolders, got.signedOut, got.disconnected],
      device: [got.refused, got.beforeDeviceRead, got.deviceStatus, got.deviceReceipt, got.changed, got.revoked],
      reminders: got.reminders,
    },
    {
      leaseOffers: [[200, true], [200, false], [200, false], [200, false]],
      arrivals: {
        baseline: [200, "no-store", false, true, 200, false],
        deviceAdmissionCount: 1,
        polling: [true, false, true, true],
        denied: [400, 409, 409, 401, 409, 404, 409, 502, 401],
        compatibilityRefusals: [404, 401, 409, true],
        exposedOnlyHistory: true,
        timerAndGrant: [true, 409, 409, 401, true],
        failureControls: [502, 2, 502, 8, false, true],
        requests: [
          "/gmail/v1/users/me/profile?fields=historyId",
          "/gmail/v1/users/me/profile?fields=historyId",
          ...[false, true, false, true, false, false, false, false, true].map((continued) => {
            const query = new URLSearchParams({
              startHistoryId: "10000000000000000001", historyTypes: "messageAdded", labelId: "INBOX", maxResults: "25",
              fields: "historyId,nextPageToken,history(id,messagesAdded(message(id)))",
            })
            if (continued) query.set("pageToken", "next")
            return "/gmail/v1/users/me/history?" + query
          }),
        ],
      },
      tablet: {
        canonical: [200, 200, 200, 200, 200, 204, 401],
        enrollment: [200, 200, 200, true, true, 401, 204, 200],
        renewal: [200, 200, true, true, 204],
        mail: [200, true, "hello"],
        calendar: [200, true, [{ externalId: "fixture-appointment", title: "Library visit" }]],
        refused: [403, 403, 204, 401, 401],
      },
      text: ["mail-whole", true, true, "Preview only",
        { tag: "CloudRefused", code: "ContentTooLarge", reason: "NoReason" }, { tag: "CloudRefused", code: "ContentTooLarge", reason: "NoReason" }, 502],
      html: expectedHtmlReads,
      mime: [expectedMimeReads, 200, btoa("last.txt"), 502],
      search: {
        pages: [
          [["fixture-message", "trashed-message"], "10000000000000000011", true, true],
          [["moved-to-trash"], "10000000000000000012", null, true],
        ],
        hints: [[true, false], [true]],
        providerRefusals: Array.from({ length: 3 }, () => [502, "provider_invalid_response"]),
        denied: [401, 403, 409, 403], invalid: Array.from({ length: 5 }, () => [400, "invalid_request"]), providersOnDenied: 0,
        cards: ["fixture-message:metadata", "moved-to-trash:metadata", "trashed-message:metadata"],
        requests: [
          ["profile", "historyId"], ["list", "in:anywhere subject:plan & dates", "50", "true", null],
          ["profile", "historyId"], ["list", "in:anywhere subject:plan & dates", "100", "true", true],
          ["profile", "historyId"], ["list", "in:anywhere subject:plan & dates", "50", "true", true],
          ["profile", "historyId"], ["list", "subject:plan", "1", "false", null],
          ["profile", "historyId"],
        ],
      },
      read: [200, "789", "hello", [
        { partId: "1", name: "fixture.pdf", mimeType: "application/pdf", size: got.size, supported: true },
        { partId: "2", name: "fixture.html", mimeType: "text/html", size: 10, supported: false },
        { partId: "3", name: "large.pdf", mimeType: "application/pdf", size: 8 * 1024 * 1024 + 1, supported: false },
      ], "mx.google.com; dkim=pass header.i=@example.test; spf=pass smtp.mailfrom=example.test"],
      refuse: [[401, 409, 409, 404, 415, 415], 0, 502],
      file: [200, "no-store", { version: 1, accountId: got.owner, organizationId: got.organization, grantId: got.grant, messageId: "fixture-message", partId: "1", historyId: "789",
        name: "fixture.pdf", mimeType: "application/pdf", size: got.size, dataBase64: got.expectedData, sha256: got.expectedHash, supported: true }],
      provider: [true, 5],
      triage: {
        revision: "10000000000000000001", sameAtMaximum: true, limits: ["12", "50", "1"],
        messages: [
          ["fixture-message", 75, "unread, directly addressed, likely needs reply", true, true, "789"],
          ["automated-message", 55, "unread, important label, directly addressed, automated sender", true, false, "790"],
        ],
        countRefusals: [[400, "invalid_request"], [400, "invalid_request"], [400, "invalid_request"], [502, "provider_invalid_response"]],
        revisionRefusal: [502, "provider_invalid_response"],
      },
      mailboxes: [[[200, true, "inbox", "", ["fixture-message", "automated-message"], null, "page-two"], [200, true, "trash", "subject:plan & dates", ["trashed-message"], { inboxUnread: 52, drafts: 7 }, "page-two"]], [409, 400], 401, 409],
      device: [[401, 409, 409], 1, 200, got.file, 409, 401],
      reminders: [[200, { reminders: [], nextPage: null }], [409, { error: "google_connection_unavailable" }]],
    },
  ))
}, 120_000)
