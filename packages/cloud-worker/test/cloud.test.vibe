      mailbox.messages.set("mime-over-limit", { ...message, id: "mime-over-limit", threadId: "mime-over-limit", mimePayload: mimeBoundaryPayload(201, "plain") })
      mailbox.messages.set("mime-html-only", { ...message, id: "mime-html-only", threadId: "mime-html-only", mimePayload: mimeBoundaryPayload(201, "html") })
      mailbox.messages.set("mime-malformed", { ...message, id: "mime-malformed", threadId: "mime-malformed", mimePayload: mimeBoundaryPayload(201, "malformed") })
    })
    const asciiOversized = try gmail("/read?messageId=msg-ascii-oversized")
    const htmlReads = try promise(() => Promise.all(["html-at-limit", "html-alternative", "html-over-limit"].map((messageId) => client.gmailRead({ messageId }))))
    const html = htmlReadSummary(htmlReads)
    const mimeReads = try promise(() => Promise.all(["mime-at-limit", "mime-over-limit", "mime-html-only"].map((messageId) => client.gmailRead({ messageId }))))
    const mime = mimeReadSummary(mimeReads)
    const mimeAttachment = try gmail("/inbox-v1/attachment?messageId=mime-over-limit&partId=2&historyId=" + mailbox.history)
    const mimeMalformed = try gmail("/read?messageId=mime-malformed")
    const capabilities = try gmail("/inbox-v1/capabilities")
    const attachment = try gmail("/inbox-v1/attachment?messageId=msg-direct&partId=1&historyId=1001")
    const thread = try gmail("/inbox-v1/thread?threadId=thr-direct&historyId=1001")
    const earlierText = "é".repeat(450 * 1024)
    const laterText = "new " + earlierText
