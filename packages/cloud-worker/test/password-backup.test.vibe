// spec/cloud/index.md, "Story: Back up my passwords for another device"; spec/cloud/identity/federatedSignIn.md, "Story: Confirm a shared password backup with the device’s Google account"; spec/cloud/identity/federatedSignIn.md, "Story: Connect mail and calendar from the same Google sheet"
import { assert, describe, it } from "@effect/vitest"
import { SecureRandom } from "effect/crypto"
import { apply, initial } from "../gen/cloud__identity__sessions.effect.vibe"
import { apply as applyAccount, initial as unopened } from "../gen/cloud__identity__accounts.effect.vibe"
import { signInWithProof, type BrowserSession } from "../src/identity-store.vibe"
import { s256, tokenDigest } from "../src/shared/credential-crypto.vibe"
import { migrate, storeLayer } from "../src/store/store.vibe"
import { revokeAll } from "../src/native-clients/device-keys.vibe"
import { authenticate } from "../src/http/request-auth.vibe"
import { Store } from "../src/store/connection.vibe"
import { identityRequest, inferenceAccount } from "../src/identity.vibe"
import { nativeIdTokens } from "./support/fakes/google.ts"
import { parseProfile } from "@elizaos/cloud"
import { capabilitiesOf } from "../src/services/google/grant-access.vibe"
import { fakeServer } from "./support/cloud.vibe"
import { googleIdentityFake } from "./support/google-identity-fake.ts"
import { cloudWorker, type CloudBindings } from "../src/worker.vibe"
import { androidCredentialTtlMs, coldPasswordRecovery, fixtureDevices } from "./support/cold-password-backup.vibe"
import { openBackupDatabase, webRequest } from "./support/password-backup.ts"
import type { JWTVerifyGetKey } from "jose"
import { registerClients, workerBindings } from "./support/worker.ts"

const identity = "a".repeat(64)
const clientId = "com.example.consumer"
const webOrigin = "https://consumer.example.test"
const apiOrigin = "https://api.consumer.example.test"
const redirectUri = webOrigin + "/android/auth/callback"
const path = "/api/v1/app-auth/mobile/password-backup"
const registration = { clientId, environment: "staging", displayName: "Consumer", androidPackage: clientId, signInReturn: redirectUri,
  billingReturn: webOrigin + "/billing/return", enabled: true, nativeGoogle: true, credentialTtlMs: androidCredentialTtlMs, certFingerprints: [Array(32).fill("AA").join(":")] }
const verifier = "v".repeat(43)
const state = "s".repeat(43)
const headers = { "content-type": "application/json" }

schema BrowserReturn { redirectUrl: string }
schema NativeEnrollment { token: string; accountId: string; expiresIn: number }
schema GoogleChallenge { challengeId: string; expiresAt: number; serverClientId: string }
schema NativeConfig { credentialTtlMs: number }
schema NativeChallenge { challengeId: string; nonce: string }
schema NativeConfigOffer { google: { nativeSignIn: boolean } }
schema NativeSignedIn { credentialId: string; secret: string; user: { id: string }; google?: { connected: boolean } }
schema ConnectAnswer { code?: string; error?: string; scopes?: string[] }
const Grant = Schema.Struct({ code: Schema.NullOr(Schema.String), ownerId: Schema.String, scope: Schema.String,
  revision: Schema.NullOr(Schema.String), present: Schema.Boolean })

function bindings(databaseUrl: string, fakeUrl?: string) {
  return { ...workerBindings({ api: apiOrigin, web: webOrigin, digest: identity, ...(fakeUrl === undefined ? {} : { fakeUrl }) }), DATABASE_URL: databaseUrl,
    NATIVE_CLIENT_ID: clientId, NATIVE_AUTH_CALLBACK: redirectUri, NATIVE_CLIENT_REGISTRY: JSON.stringify([registration]),
    GOOGLE_CLIENT_ID: "123456-example.apps.googleusercontent.com", GOOGLE_CLIENT_SECRET: "unusable" } satisfies CloudBindings
}

function browser(user: BrowserSession) {
  return { ...headers, origin: webOrigin, cookie: "__Host-eliza-session=" + user.access }
}

function bearer(credential: string) {
  return { ...headers, authorization: "Bearer " + credential }
}

effect function check(f: () => void) {
  try Effect.try(f)
}

effect function decode<A>(response: Response, schema: Schema.Decoder<A>) {
  try check(() => assert.equal(response.status, 200))
  return try Schema.decodeUnknownEffect(schema)(try tryPromise(() => response.json()))
}

describe("Password backup (spec/cloud/index.md, \"Story: Back up my passwords for another device\")", () => {
  it.live("a recent browser consent returns a code that only its enrolled owner can redeem", () => scoped(effect {
    const { db, databaseUrl, pendingMigrations } = try acquireRelease(tryPromise(() => openBackupDatabase(true)), (fixture) => promise(() => fixture.close()))
    try tryPromise(() => db.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, 'staging', 1)", [identity]))
    const env = bindings(databaseUrl)
    const worker = cloudWorker<CloudBindings>()
    const call = (route: string, init?: RequestInit, bound: CloudBindings = env) =>
      tryPromise(() => worker.fetch(webRequest(apiOrigin + route, init), bound))
    const post = (route: string, body: object, requestHeaders: Record<string, string>) =>
      call(route, { method: "POST", headers: requestHeaders, body: JSON.stringify(body) })
    const signIn = (name: string) => Effect.provide(signInWithProof(db, { provider: "google", subject: name + "-proof",
      email: name + "@example.test" }), SecureRandom.layerWebCrypto)
    const historicalId = "historical-account"
    const historicalAccount = try applyAccount(unopened, { type: "openAccount", userId: historicalId, organizationId: "historical-organization",
      identity: { method: "GoogleSignIn", subject: "historical-proof" }, verifiedEmail: true, subjectOwner: { tag: "Unowned" }, emailOwner: { tag: "Unowned" }, referralCode: "R-historical" })
    try tryPromise(() => db.query("INSERT INTO organizations (id, name, created_at) VALUES ('historical-organization', 'Personal', 1)"))
    try tryPromise(() => db.query("INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, $2::jsonb, 1, 'historical-organization', 'active', 'historical@example.test', 1, 1)",
      [historicalId, JSON.stringify(historicalAccount.state)]))
    try tryPromise(() => db.query("INSERT INTO cloud_sign_in_identities (provider, provider_subject, account_id) VALUES ('google', 'historical-proof', $1)", [historicalId]))
    const historicalToken = `eliza_mobile_${tokenDigest("historical-native")}`
    const historicalBytes = new Uint8Array([1, 0, 255, 10])
    const historicalAt = try Clock.currentTimeMillis
    try tryPromise(() => db.query("INSERT INTO device_grants (key,state,revision,user_id,client_id,phase,secret_digest,code_expires_at,key_expires_at,issued_at,updated_at) VALUES ('historical-device', '{\"phase\":\"Active\"}'::jsonb,1,$1,$2,'active',$3,$4,$5,$4,$4)",
      [historicalId, clientId, tokenDigest(historicalToken), historicalAt, historicalAt + androidCredentialTtlMs]))
    try tryPromise(() => db.query("INSERT INTO cloud_password_backups (client_id,organization_id,account_id,revision,snapshot) SELECT $1,organization_id,key,1,$3 FROM accounts WHERE key=$2", [clientId, historicalId, historicalBytes]))
    const migration = try Effect.provide(migrate({ digest: identity, environment: "staging", now: 2 }),
      storeLayer({ kind: "pg", url: databaseUrl }))
    const required = ["0002_identity.sql", "0002_identity_factors.sql", "0002_identity_methods.sql",
      "0003_device_keys.sql", "0003_device_keys_state.sql", "0004_provider_events.sql", "0006_inference.sql",
      "0107_sms_code_transport.sql", "0108_native_google_challenges.sql"]
    try check(() => assert.deepEqual(migration.applied, pendingMigrations))
    try check(() => assert.deepEqual(migration.applied.filter((name) => required.includes(name)), required))
    try tryPromise(() => db.query("SELECT code_challenge, state_digest, sealed_copy FROM device_grants LIMIT 0"))
    const repeated = try Effect.provide(migrate({ digest: identity, environment: "staging", now: 3 }),
      storeLayer({ kind: "pg", url: databaseUrl }))
    try check(() => assert.deepEqual(repeated.applied, []))
    const alice = try signIn("alice")
    const bob = try signIn("bob")
    const historical = try signIn("historical")
    const referable = try tryPromise(() => db.query("SELECT r.code FROM referral_codes r JOIN funds f ON f.key = (SELECT organization_id FROM accounts WHERE key = r.user_id) WHERE r.user_id = ANY($1)", [[alice.account.id, bob.account.id]]))
    try check(() => assert.deepEqual([historical.account.id, referable.rows.filter((row) => /^[0-9A-F]{10}$/.test(String(row.code))).length], [historicalId, 2]))
    try tryPromise(() => registerClients(db, [registration]))
    const configQuery = new URLSearchParams({ clientId, environment: "staging", redirectUri })
    const advertised = try decode(try call("/api/v1/app-auth/mobile/config?" + configQuery), NativeConfig)
    try check(() => assert.equal(advertised.credentialTtlMs, androidCredentialTtlMs))
    const sharedStore = storeLayer({ kind: "pg", url: databaseUrl })
    const changedAccount = try post("/api/auth/device/authorize", { challenge: s256(verifier), state, expectedAccountId: alice.account.id }, browser(bob))
    const rejection = try tryPromise(() => changedAccount.json())
    try check(() => assert.deepEqual([changedAccount.status, rejection], [409, { error: "sign_in_changed" }]))

    effect function onboard(user: BrowserSession, acknowledged: boolean) {
      const native = try decode(try post("/api/auth/device/authorize", { challenge: s256(verifier), state, expectedAccountId: user.account.id }, browser(user)), BrowserReturn)
      const code = new URL(native.redirectUrl).searchParams.get("code")
      const issued = try decode(try post("/api/auth/device/exchange", { code, verifier }, headers), NativeEnrollment)
      try check(() => assert.deepEqual([issued.accountId, issued.expiresIn], [user.account.id, androidCredentialTtlMs / 1000]))
      if (acknowledged) {
        const ack = try post("/api/auth/device/ack", {}, bearer(issued.token))
        try check(() => assert.equal(ack.status, 204))
      }
      return issued.token
    }

    const aliceNative = try onboard(alice, true)
    const alicePending = try onboard(alice, false)
    const bobNative = try onboard(bob, true)
    const aliceSpare = try onboard(alice, true)
    const proof = (purpose: string) => ({ clientId, environment: "staging", redirectUri, state, codeChallenge: s256(verifier),
      codeChallengeMethod: "S256", purpose })
    const consent = (purpose: string, user: BrowserSession, expectedOwnerId = user.account.id) =>
      post(path, { approval: proof(purpose), expectedOwnerId }, browser(user))
    const exchange = (purpose: string, code: string, token: string, suppliedVerifier = verifier) =>
      post(path + "/exchange", { clientId, environment: "staging", redirectUri, state, code, verifier: suppliedVerifier, purpose }, bearer(token))
    const run = (method: string, code: string, input: { headers?: Record<string, string>; body?: Uint8Array<ArrayBuffer> } = {}, bound?: CloudBindings) =>
      call(path, { ...input, method, headers: { authorization: "Bearer " + code, "x-backup-verifier": verifier, "x-backup-state": state, ...input.headers } },
        bound)

    effect function approve(purpose: string, user: BrowserSession) {
      const result = try decode(try consent(purpose, user), BrowserReturn)
      const callback = new URL(result.redirectUrl)
      try check(() => assert.deepEqual([Object.keys(result), callback.origin + callback.pathname, callback.searchParams.get("state")],
        [["redirectUrl"], redirectUri, state]))
      return callback.searchParams.get("code") ?? ""
    }

    effect function grant(purpose: string, user: BrowserSession, token: string) {
      const code = try approve(purpose, user)
      return try decode(try exchange(purpose, code, token), Grant)
    }

    const historicalRead = try grant("read", historical, historicalToken)
    const historicalSnapshot = try run("GET", historicalRead.code ?? "")
    const historicalRestored = new Uint8Array(try tryPromise(() => historicalSnapshot.arrayBuffer()))
    const historicalCaller = try Effect.provide(authenticate("Bearer " + historicalToken, "ServiceAccess"), sharedStore)
    const historicalScope = historicalCaller.kind === "deviceKey" ? historicalCaller.credentialScope : null
    try check(() => assert.deepEqual([historicalSnapshot.status, historicalRestored, historicalScope],
      [200, historicalBytes, "recorded-grant:historical-device"]))

    const ready = path + "/readiness?clientId=" + clientId + "&environment=staging"
    const readyResponse = try call(ready)
    const badDb = try call(ready, {}, { ...env, CLOUD_IDENTITY_DIGEST: "b".repeat(64) })
    const missingRegistration = try call(ready, {}, { ...env, NATIVE_CLIENT_REGISTRY: "[]" })
    const opened = try call(path + "/approve?" + new URLSearchParams(proof("save")))
    const foreignCallback = try call(path + "/approve?" + new URLSearchParams({ ...proof("save"), redirectUri: "https://attacker.example.test/exit" }))
    const crossOrigin = try post(path, { approval: proof("save"), expectedOwnerId: alice.account.id }, { ...browser(alice), origin: "https://attacker.example.test" })
    const switched = try consent("save", alice, bob.account.id)
    try check(() => assert.deepEqual([readyResponse.status, readyResponse.headers.get("x-password-backup-version"),
      badDb.status, badDb.headers.get("x-password-backup-version"), missingRegistration.status, opened.status,
      new URL(opened.headers.get("location") ?? apiOrigin).pathname, foreignCallback.status, crossOrigin.status, switched.status],
      [204, "2", 503, null, 503, 303, "/android/passwords/approve", 400, 403, 409]))

    const ciphertext = new Uint8Array([0, 10, 255, 17])
    const create = (body: Uint8Array<ArrayBuffer>) => ({ headers: { "content-type": "application/octet-stream", "if-none-match": "*" }, body })
    const browserCode = try approve("save", alice)
    const unauthorized = [
      (try exchange("save", browserCode, bobNative)).status, (try exchange("save", browserCode, alicePending)).status,
      (try exchange("save", browserCode, aliceNative, "w".repeat(43))).status, (try exchange("read", browserCode, aliceNative)).status,
      (try run("PUT", browserCode, create(ciphertext))).status
    ]
    const initialGrant = try decode(try exchange("save", browserCode, aliceNative), Grant)
    const operationCode = initialGrant.code ?? ""
    const replayedExchange = try exchange("save", browserCode, aliceNative)
    const wrongPurpose = try run("GET", operationCode)
    const tooLarge = try run("PUT", operationCode, create(new Uint8Array(2097153)))
    const saved = try run("PUT", operationCode, create(ciphertext))
    const replayedSave = try run("PUT", operationCode, create(ciphertext))
    try check(() => assert.deepEqual([unauthorized, initialGrant.ownerId, initialGrant.revision, initialGrant.present,
      replayedExchange.status, wrongPurpose.status, tooLarge.status, saved.status, saved.headers.get("etag"), replayedSave.status],
      [[401, 401, 401, 401, 401], alice.account.id, null, false, 401, 401, 413, 204, '"1"', 401]))

    const googlePath = "/api/v1/auth/google/native/challenge"
    const googleInput = { clientId, environment: "staging", redirectUri, codeChallenge: s256(verifier), codeChallengeMethod: "S256" }
    const started = try Clock.currentTimeMillis
    const google = try decode(try post(googlePath, googleInput, headers), GoogleChallenge)
    try check(() => {
      assert.deepEqual([google.challengeId.length, google.serverClientId], [36, "google-server-client"])
      assert.ok(google.expiresAt > started)
    })

    const other = try grant("read", bob, bobNative)
    const otherSnapshot = try run("GET", other.code ?? "")
    const read = try grant("read", alice, aliceNative)
    const snapshot = try run("GET", read.code ?? "")
    const restored = new Uint8Array(try tryPromise(() => snapshot.arrayBuffer()))
    const androidPresenter = "123456-android.apps.googleusercontent.com"
    const nativeRedirect = "https://product.example.test/android/auth/callback"
    const nativeRegistration = { ...registration, passwordBackupApproval: "native-google", androidGoogleAuthorizedParties: [androidPresenter] }
    const nativeEnv = { ...env, NATIVE_CLIENT_ID: undefined, NATIVE_AUTH_CALLBACK: undefined,
      NATIVE_CLIENT_REGISTRY: JSON.stringify([{ ...nativeRegistration, signInReturn: nativeRedirect }]) }
    const recoveryTokens = try tryPromise(() => nativeIdTokens(env.GOOGLE_CLIENT_ID))
    const nativeQuery = new URLSearchParams({ clientId, environment: "staging", redirectUri: nativeRedirect, approval: "native-google" })
    const nativeReadiness = path + "/readiness?" + nativeQuery
    const unavailableNative = try call(nativeReadiness)
    const refusedBrowser = try call(path, { method: "POST", headers: browser(alice),
      body: JSON.stringify({ approval: proof("verify"), expectedOwnerId: alice.account.id }) },
      { ...env, NATIVE_CLIENT_REGISTRY: JSON.stringify([nativeRegistration]) })
    const setSignInReturn = (target: string) => tryPromise(() => db.query(
      "UPDATE native_clients SET sign_in_return=$1 WHERE client_id=$2 AND environment='staging'", [target, clientId]))
    try setSignInReturn(nativeRedirect)
    const availableNative = try call(nativeReadiness, undefined, nativeEnv)
    const wrongNativeReturn = try call(path + "/readiness?" + configQuery + "&approval=native-google", undefined, nativeEnv)
    try check(() => assert.deepEqual([unavailableNative.status, availableNative.status,
      availableNative.headers.get("x-password-backup-version"), wrongNativeReturn.status, refusedBrowser.status], [404, 204, "3", 404, 403]))
    const identityCounts = () => tryPromise(() => db.query(`SELECT
      (SELECT count(*)::int FROM accounts) AS accounts,
      (SELECT count(*)::int FROM cloud_sign_in_identities) AS identities,
      (SELECT count(*)::int FROM sessions) AS sessions,
      (SELECT count(*)::int FROM device_grants) AS devices`))
    const beforeNative = (try identityCounts()).rows
    const googleVerifier = "g".repeat(43)
    const startNative = (approval: object, requestHeaders: Record<string, string>) =>
      call(path + "/native/challenge", { method: "POST", headers: requestHeaders,
        body: JSON.stringify({ approval, googleChallenge: s256(googleVerifier) }) },
        nativeEnv)
    const finishNative = (approval: object, challengeId: string, idToken: string, token = aliceNative, suppliedVerifier = googleVerifier,
      keys: JWTVerifyGetKey = recoveryTokens.keys) =>
      tryPromise(() => identityRequest(webRequest(apiOrigin + path + "/native/approve", { method: "POST", headers: bearer(token),
        body: JSON.stringify({ approval, challengeId, googleVerifier: suppliedVerifier, idToken, consent: true }) }), nativeEnv, db, keys))
    const verifyApproval = { ...proof("verify"), redirectUri: nativeRedirect }
    const openedVerification = try decode(try startNative(verifyApproval, bearer(aliceNative)), NativeChallenge)
    const recordedChallenge = (try tryPromise(() => db.query("SELECT link_user_id FROM oauth_attempts WHERE key = $1", [openedVerification.challengeId]))).rows[0]
    try check(() => assert.deepEqual(recordedChallenge, { link_user_id: alice.account.id }))
    const approvedToken = try tryPromise(() => recoveryTokens.issue("alice-proof", openedVerification.nonce, undefined, androidPresenter))
    const otherPresenter = try tryPromise(() => recoveryTokens.issue("alice-proof", openedVerification.nonce, undefined, "123456-other.apps.googleusercontent.com"))
    const missingPresenter = try tryPromise(() => recoveryTokens.issue("alice-proof", openedVerification.nonce))
    const otherOwner = try tryPromise(() => recoveryTokens.issue("bob-proof", openedVerification.nonce, "alice@gmail.com", androidPresenter))
    const refusals = [
      (try startNative(verifyApproval, browser(alice))).status,
      (try startNative(verifyApproval, bearer(alicePending))).status,
      (try startNative({ ...verifyApproval, redirectUri: webOrigin + "/other" }, bearer(aliceNative))).status,
      (try finishNative(verifyApproval, openedVerification.challengeId, otherPresenter)).status,
      (try finishNative(verifyApproval, openedVerification.challengeId, missingPresenter)).status,
      (try finishNative(verifyApproval, openedVerification.challengeId, otherOwner)).status,
      (try finishNative(verifyApproval, openedVerification.challengeId, approvedToken, aliceNative, "w".repeat(43))).status,
      (try finishNative(verifyApproval, openedVerification.challengeId, approvedToken, bobNative)).status,
    ]
    const verifiedResponse = try finishNative(verifyApproval, openedVerification.challengeId, approvedToken)
    const verifiedOwner = try decode(verifiedResponse, Grant)
    const verificationReplay = try finishNative(verifyApproval, openedVerification.challengeId, approvedToken)
    try check(() => assert.deepEqual([refusals, verifiedOwner.code, verifiedOwner.ownerId, verifiedOwner.scope,
      verifiedOwner.revision, verifiedOwner.present, verifiedResponse.headers.get("set-cookie"), verificationReplay.status],
      [[403, 401, 401, 401, 401, 401, 401, 401], null, alice.account.id, read.scope, null, false, null, 401]))

    effect function nativeRead(token: string) {
      const approval = { ...proof("read"), redirectUri: nativeRedirect }
      const opened = try decode(try startNative(approval, bearer(token)), NativeChallenge)
      const signed = try tryPromise(() => recoveryTokens.issue("alice-proof", opened.nonce, undefined, androidPresenter))
      return try decode(try finishNative(approval, opened.challengeId, signed, token), Grant)
    }
    const nativeRestored = try nativeRead(aliceNative)
    const nativeSnapshot = try run("GET", nativeRestored.code ?? "", {}, nativeEnv)
    const nativeBytes = new Uint8Array(try tryPromise(() => nativeSnapshot.arrayBuffer()))
    const nativeReplay = try run("GET", nativeRestored.code ?? "", {}, nativeEnv)
    const abandonedNative = try nativeRead(aliceNative)
    const afterNative = (try identityCounts()).rows
    try check(() => assert.deepEqual([nativeRestored.ownerId, nativeRestored.scope, nativeRestored.revision, nativeRestored.present,
      nativeSnapshot.status, nativeBytes, nativeReplay.status, afterNative],
      [alice.account.id, read.scope, '"1"', true, 200, ciphertext, 401, beforeNative]))

    const unlinkSql = "DELETE FROM cloud_sign_in_identities WHERE account_id=$1 AND provider='google' RETURNING provider_subject"
    const relink = (subject: string) => tryPromise(() => db.query(
      "INSERT INTO cloud_sign_in_identities (provider,provider_subject,account_id) VALUES ('google',$1,$2)", [subject, alice.account.id]))
    const approvals = () => tryPromise(() => db.query("SELECT count(*)::int AS approvals FROM cloud_password_backup_approvals"))
    const unlinkedWhileFetching: Array<string> = []
    const unlinkingKeys: JWTVerifyGetKey = async (header, token) => {
      const unlinked = await db.query<{ provider_subject: string }>(unlinkSql, [alice.account.id])
      unlinkedWhileFetching.push(...unlinked.rows.map((row) => row.provider_subject))
      return recoveryTokens.keys(header, token)
    }
    const beforeUnlink = (try identityCounts()).rows
    const approvalsBefore = (try approvals()).rows
    const keyApproval = { ...proof("read"), redirectUri: nativeRedirect }
    const keyChallenge = try decode(try startNative(keyApproval, bearer(aliceSpare)), NativeChallenge)
    const keyProof = try tryPromise(() => recoveryTokens.issue("alice-proof", keyChallenge.nonce, undefined, androidPresenter))
    const unlinkedDuringKeys = try finishNative(keyApproval, keyChallenge.challengeId, keyProof, aliceSpare, googleVerifier, unlinkingKeys)
    const keyRefusal = try tryPromise(() => unlinkedDuringKeys.json())
    const afterKeys = (try identityCounts()).rows
    const approvalsAfterKeys = (try approvals()).rows
    try relink("alice-proof")
    const pendingNative = try nativeRead(aliceSpare)
    const unlinkedBeforeUse = (try tryPromise(() => db.query(unlinkSql, [alice.account.id]))).rows
    const unlinkedRead = try run("GET", pendingNative.code ?? "", {}, nativeEnv)
    try relink("alice-proof")
    const spareSignedOut = try post("/api/auth/device/revoke", {}, bearer(aliceSpare))
    try check(() => assert.deepEqual([unlinkedDuringKeys.status, keyRefusal, unlinkedWhileFetching, afterKeys, approvalsAfterKeys,
      typeof pendingNative.code, unlinkedBeforeUse, unlinkedRead.status, spareSignedOut.status],
      [401, { error: "backup_approval_required" }, ["alice-proof"], beforeUnlink.map((row) => ({ ...row, identities: row.identities - 1 })), approvalsBefore,
        "string", [{ provider_subject: "alice-proof" }], 401, 204]))
    try setSignInReturn(redirectUri)
    const staleCreate = try grant("save", alice, aliceNative)
    const stale = try run("PUT", staleCreate.code ?? "", create(ciphertext))
    const deletion = try grant("delete", alice, aliceNative)
    const removed = try run("DELETE", deletion.code ?? "", { headers: { "if-match": '"1"' } })
    const nextRead = try grant("read", alice, aliceNative)
    const tombstone = try run("GET", nextRead.code ?? "")
    try check(() => assert.deepEqual([other.scope === initialGrant.scope, otherSnapshot.status, snapshot.status, restored,
      stale.status, removed.status, removed.headers.get("etag"), tombstone.status, tombstone.headers.get("etag")],
      [false, 404, 200, ciphertext, 412, 204, '"2"', 404, '"2"']))

    const mixedPending = try grant("read", alice, aliceNative)
    const oldPendingExchange = try decode(try post("/api/auth/device/authorize", { challenge: s256(verifier), state, expectedAccountId: alice.account.id }, browser(alice)), BrowserReturn)
    const revokedAt = try Clock.currentTimeMillis
    const ended = try Effect.provide(effect {
      const storage = try Store
      return try storage.transaction((tx) => revokeAll(tx, alice.account.id, revokedAt))
    }, sharedStore)
    const oldInference = try tryPromise(() => inferenceAccount(webRequest(apiOrigin + "/api/v1/inference", { headers: bearer(aliceNative) }), db, env))
    const oldOperation = try run("GET", mixedPending.code ?? "")
    try setSignInReturn(nativeRedirect)
    const revokedNative = try run("GET", abandonedNative.code ?? "", {}, nativeEnv)
    try setSignInReturn(redirectUri)
    try check(() => assert.equal(revokedNative.status, 401))
    const oldExchange = try post("/api/auth/device/exchange", { code: new URL(oldPendingExchange.redirectUrl).searchParams.get("code"), verifier }, headers)
    const aliceFresh = try onboard(alice, true)
    const newInference = try tryPromise(() => inferenceAccount(webRequest(apiOrigin + "/api/v1/inference", { headers: bearer(aliceFresh) }), db, env))
    const freshCaller = try Effect.provide(authenticate("Bearer " + aliceFresh, "ServiceAccess"), sharedStore)
    const oldAck = try post("/api/auth/device/ack", {}, bearer(aliceNative))
    const lateRevoke = try post("/api/auth/device/revoke", {}, bearer(aliceNative))
    const readFresh = () => tryPromise(() => db.query("SELECT d.device_epoch,a.device_epoch AS account_epoch,d.state,d.key_expires_at,d.revision FROM device_grants d JOIN accounts a ON a.key=d.user_id WHERE d.secret_digest=$1", [tokenDigest(aliceFresh)]))
    const epochs = (try readFresh()).rows[0]
    const replayedAck = try post("/api/auth/device/ack", {}, bearer(aliceFresh))
    const afterReplay = (try readFresh()).rows[0]
    try check(() => assert.deepEqual([ended, oldInference, oldOperation.status, oldExchange.status, oldAck.status, newInference, freshCaller.kind,
      Number(epochs?.device_epoch), Number(epochs?.account_epoch), epochs?.state.flatDeviceGrant, lateRevoke.status, replayedAck.status, afterReplay],
      [1, null, 401, 401, 401, alice.account.id, "deviceKey", 1, 1, "FlatTokenStarted", 401, 204, epochs]))

    const pending = try grant("read", alice, aliceFresh)
    const signOut = try post("/api/auth/device/revoke", {}, bearer(aliceFresh))
    const revoked = try run("GET", pending.code ?? "")
    const signedOutInference = try tryPromise(() => inferenceAccount(webRequest(apiOrigin + "/api/v1/inference", { headers: bearer(aliceFresh) }), db, env))
    const verified = try grant("verify", bob, bobNative)
    const now = try Clock.currentTimeMillis
    const aged = (try apply({ ...initial, now: now - 300001 }, { type: "signIn", assurance: "SingleFactor", personEpoch: 0 })).state
    try tryPromise(() => db.query(
      "UPDATE sessions SET state = $1, auth_at = $2, access_expires_at = $3, refresh_expires_at = $4 WHERE user_id = $5",
      [aged, aged.authAt, aged.accessExpiresAt, aged.refreshExpiresAt, bob.account.id]))
    const oldSession = try consent("read", bob)
    try check(() => assert.deepEqual([signOut.status, revoked.status, signedOutInference, verified.code, verified.ownerId, verified.revision, oldSession.status],
      [204, 401, null, null, bob.account.id, null, 401]))
  }))
  const androidFixture = fixtureDevices
  if (androidFixture !== undefined) {
    it.live("restore an enrolled vault after an Android cold start", () => scoped(coldPasswordRecovery(androidFixture)), 240_000)
  }

})

describe('Connect mail and calendar from the same Google sheet (spec/cloud/identity/federatedSignIn.md, "Story: Connect mail and calendar from the same Google sheet")', () => {
  it.live('a native code connects only the signed-in account\'s own Google identity, with the scopes Google granted (spec/cloud/identity/accounts.md, "A sign-in lands on the account holding its subject, else on the one holding its proven address, else on a new account, and never on an account that is not active")', () => scoped(effect {
    const { db, databaseUrl } = try acquireRelease(tryPromise(() => openBackupDatabase()), (fixture) => promise(() => fixture.close()))
    const fakes = try fakeServer()
    const env = bindings(databaseUrl, fakes.url)
    const google = try Effect.try(() => googleIdentityFake(env.GOOGLE_CLIENT_SECRET))
    let beforeUserInfo: (() => Promise<void>) | undefined
    try sync(() => fakes.mount("/google/", async (request) => {
      if (request.path === "/api/oauth2/v2/userinfo" && beforeUserInfo !== undefined) {
        const beforeReply = beforeUserInfo
        beforeUserInfo = undefined
        await beforeReply()
      }
      return google.handler(request)
    }))
    try tryPromise(() => db.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, 'staging', 1)", [identity]))
    try tryPromise(() => registerClients(db, [registration]))
    const worker = cloudWorker<CloudBindings>()
    const post = (route: string, body: object, requestHeaders: Record<string, string> = headers) =>
      tryPromise(() => worker.fetch(webRequest(apiOrigin + route, { method: "POST", headers: requestHeaders, body: JSON.stringify(body) }), env))
    const client = { clientId, environment: "staging", redirectUri }
    const person = (subject: string, email = subject + "@gmail.com") => ({ subject, email, emailVerified: true })
    const authScopes = (...names: string[]) => ["openid", ...names.map((name) => "https://www.googleapis.com/auth/" + name)]
    const newCode = (subject: string, names: string[]) => sync(() => google.serverAuthCode(person(subject), authScopes(...names)))
    effect function googleProof(subject: string, options: { readonly email?: string; readonly serverAuthCode?: string } = {}) {
      const opened = try decode(try post("/api/v1/auth/google/native/challenge", {
        ...client, codeChallenge: s256(verifier), codeChallengeMethod: "S256"
      }), NativeChallenge)
      const idToken = try tryPromise(() => google.idToken(person(subject, options.email), { audience: "google-server-client", nonce: opened.nonce }))
      return try post("/api/v1/app-auth/mobile/google", {
        ...client, state, codeVerifier: verifier, identity: { challengeId: opened.challengeId, idToken, codeVerifier: verifier }, serverAuthCode: options.serverAuthCode
      })
    }
    effect function googleDevice(subject: string, serverAuthCode?: string) {
      const signedIn = try decode(try googleProof(subject, serverAuthCode === undefined ? {} : { serverAuthCode }), NativeSignedIn)
      const ack = try post("/api/v1/app-auth/mobile/ack", { credentialId: signedIn.credentialId, secret: signedIn.secret })
      try check(() => assert.equal(ack.status, 200))
      return signedIn
    }
    const connect = effect (serverAuthCode: string, requestHeaders: Record<string, string>) => {
      const answer = try post("/api/v1/eliza/google/connect/native", { serverAuthCode }, requestHeaders)
      const body = try Schema.decodeUnknownEffect(ConnectAnswer)(try tryPromise(() => answer.json()))
      return [answer.status, body.code ?? body.error ?? capabilitiesOf(body.scopes ?? [])]
    }
    const connections = () => tryPromise(() => db.query<{ subject: string; granted_scopes: string[] }>(
      "SELECT subject, granted_scopes FROM google_connections ORDER BY subject"))
    const login = try newCode("alice-google", ["gmail.readonly", "gmail.send"])
    const alice = try googleDevice("alice-google", login)
    const bob = try googleDevice("bob-google", try newCode("alice-google", ["gmail.readonly", "calendar.readonly"]))
    const accountEmail = "alice-google@gmail.com"
    const ownerIdentity = () => tryPromise(() => db.query<{ account_id: string }>(`
      SELECT p.account_id,p.provider,p.provider_subject,a.state,a.revision
      FROM cloud_sign_in_identities p JOIN accounts a ON a.key=p.account_id WHERE a.email=$1
      ORDER BY p.provider,p.provider_subject`, [accountEmail]))
    const beforeConflict = (try ownerIdentity()).rows
    const callsBeforeConflict = google.tokenRequests.length
    const second = try googleProof("alice-alternate-google", { email: accountEmail })
    const declined = try tryPromise(() => second.json())
    const afterConflict = (try ownerIdentity()).rows
    const same = try googleDevice("alice-google")
    try check(() => {
      assert.equal(second.status, 409)
      assert.equal((declined as { error: string }).error, "identity_in_use")
      assert.deepStrictEqual([afterConflict, same.user.id, google.tokenRequests.length],
        [beforeConflict, beforeConflict[0]?.account_id, callsBeforeConflict])
    })
    const afterSignIn = (try connections()).rows
    const carol = try Effect.provide(signInWithProof(db, { provider: "email", subject: "carol@example.test", email: "carol@example.test" }), SecureRandom.layerWebCrypto)
    const codeReturn = try decode(try post("/api/auth/device/authorize", { challenge: s256(verifier), state }, browser(carol)), BrowserReturn)
    const carolCode = try Effect.try(() => new URL(codeReturn.redirectUrl).searchParams.get("code"))
    const carolKey = try decode(try post("/api/auth/device/exchange", { code: carolCode, verifier }), NativeEnrollment)
    const carolAck = try post("/api/auth/device/ack", {}, bearer(carolKey.token))
    try check(() => assert.equal(carolAck.status, 204))
    const unspent = try newCode("alice-google", ["calendar.readonly"])
    const answers = {
      signedIn: [alice.google?.connected, bob.google?.connected],
      withoutGoogleSignIn: try connect(unspent, bearer(carolKey.token)),
      otherAccount: try connect(try newCode("alice-google", ["gmail.readonly"]), bearer(bob.secret)),
      browserSession: try connect(try newCode("alice-google", ["gmail.readonly"]), browser(carol)),
      sendWithoutRead: try connect(try newCode("alice-google", ["gmail.send"]), bearer(alice.secret)),
      replayed: try connect(login, bearer(alice.secret)),
      own: try connect(unspent, bearer(alice.secret))
    }
    const stored = (try connections()).rows
    const repeats = try Effect.forEach([1, 2, 3], () => connect(login, bearer(alice.secret)))
    const callsBeforeLimit = google.tokenRequests.length
    const nextCode = try newCode("alice-google", ["gmail.readonly"])
    const limited = try connect(nextCode, bearer(alice.secret))
    const stoppedBeforeGoogle = google.tokenRequests.length === callsBeforeLimit
    const independent = try connect(nextCode, bearer(carolKey.token))
    let removed = 0
    beforeUserInfo = async () => {
      const unlinked = await db.query(
        "WITH owner AS (SELECT key FROM accounts WHERE key=$1 FOR UPDATE) DELETE FROM cloud_sign_in_identities p USING owner WHERE p.account_id=owner.key AND p.provider='google'",
        [bob.user.id]
      )
      removed = unlinked.rowCount ?? 0
    }
    try tryPromise(() => db.query("INSERT INTO cloud_sign_in_identities (provider,provider_subject,account_id) VALUES ('email',$1,$2)",
      ["bob-second@example.test", bob.user.id]))
    const stale = try sync(() => google.serverAuthCode(person("bob-google"), authScopes("gmail.readonly"), { identity: null }))
    const unlinkedDuringExchange = try connect(stale, bearer(bob.secret))
    const afterUnlink = try tryPromise(() => db.query("SELECT subject FROM google_connections WHERE user_id=$1", [bob.user.id]))
    const config = (bound: CloudBindings) => tryPromise(() => worker.fetch(webRequest(apiOrigin + "/api/v1/app-auth/mobile/config?" +
      new URLSearchParams(client)), bound))
    const raw: unknown = try Effect.try(() => JSON.parse(env.CLOUD_PROFILE))
    const profile = try parseProfile(raw)
    const { google: _google, ...withoutGoogle } = profile.environments.staging
    const off = { ...profile, environments: { ...profile.environments, staging: { ...withoutGoogle,
      capabilities: withoutGoogle.capabilities.filter((capability) => capability !== "managedGoogle") } } }
    const offered = try decode(try config(env), NativeConfigOffer)
    const absent = try decode(try config({ ...env, CLOUD_PROFILE: JSON.stringify(off) }), NativeConfigOffer)
    const reconnect = [409, "google_reconnect_required"]
    const view = (rows: typeof stored) => rows.map((row) => [row.subject, capabilitiesOf(row.granted_scopes)])
    try check(() => assert.deepStrictEqual({
      offered: [offered.google.nativeSignIn, absent.google.nativeSignIn], afterSignIn: view(afterSignIn), answers, stored: view(stored),
      limit: { repeats, limited, stoppedBeforeGoogle, independent }, unlinked: [removed, unlinkedDuringExchange, afterUnlink.rows]
    }, {
      offered: [true, false], afterSignIn: [["alice-google", ["google.basic_identity", "google.gmail.triage", "google.gmail.send"]]],
      answers: { signedIn: [true, false], withoutGoogleSignIn: reconnect, otherAccount: reconnect, browserSession: [401, "authentication_required"],
        sendWithoutRead: reconnect, replayed: reconnect, own: [200, ["google.basic_identity", "google.calendar.read"]] },
      stored: [["alice-google", ["google.basic_identity", "google.calendar.read"]]],
      limit: { repeats: [reconnect, reconnect, reconnect], limited: [429, "rate_limited"], stoppedBeforeGoogle: true, independent: reconnect },
      unlinked: [1, reconnect, []]
    }))
  }), 90_000)
})
