    {
      name: "key",
      description: "Key or combo string.",
      descriptionCompressed: "Key/combo.",
      required: false,
      schema: { type: "string" },
    },
    {
      name: "modifiers",
      description: "Modifier keys for click_with_modifiers.",
      descriptionCompressed: "Modifiers.",
      required: false,
      schema: { type: "array", items: { type: "string", enum: ["alt", "cmd", "command", "control", "ctrl", "meta", "option", "shift", "super"] } },
    },
    {
      name: "path",
      description: "Multi-point polyline [[x,y],...] for drag.",
      descriptionCompressed: "Drag polyline.",
      required: false,
      schema: { type: "array", items: { type: "array", items: { type: "number" } } },
    },
    {
      name: "scrollAmount",
      description: "Scroll clicks.",
      descriptionCompressed: "Scroll clicks.",
      required: false,
      schema: { type: "number" },
    },
    {
      name: "scrollDirection",
      description: "Scroll direction.",
      descriptionCompressed: "up|down|left|right.",
      required: false,
      schema: { type: "string", enum: ["down", "left", "right", "up"] },
    },
    {
      name: "startCoordinate",
      description: "Start [x, y] for drag.",
      descriptionCompressed: "Drag start [x,y].",
      required: false,
      schema: { type: "array", items: { type: "number" } },
    },
    {
      name: "steps",
      description: "Ordered steps for action=batch (1..16 steps executed in one turn).",
      descriptionCompressed: "Batch steps (1..16).",
      required: false,
      schema: {
        type: "array",
        items: {
          type: "object",
          required: ["action"],
          additionalProperties: true,
          properties: {
            action: { type: "string", enum: DESKTOP_ACTION_ENUM.filter((v) => v !== "batch") },
            app: { type: "string" },
            button: { type: "string", enum: ["left", "middle", "right"] },
            coordinate: { type: "array", items: { type: "number" } },
            key: { type: "string" },
            scrollAmount: { type: "number" },
            scrollDirection: { type: "string", enum: ["down", "left", "right", "up"] },
            target: { type: "string" },
            text: { type: "string" },
            waitMs: { type: "number" },
            x: { type: "number" },
            y: { type: "number" },
          },
        },
      },
    },
    {
      name: "stopOnError",
      description: "Stop batch on first failed step (default true).",
      descriptionCompressed: "Halt batch on error.",
      required: false,
      schema: { type: "boolean", default: true },
    },
    {
      name: "target",
      description: "File, folder, or URL for open.",
      descriptionCompressed: "Open target.",
      required: false,
      schema: { type: "string" },
    },
    {
      name: "text",
      description: "Text payload for type or set_value.",
      descriptionCompressed: "Text.",
      required: false,
      schema: { type: "string" },
    },
  ],
  summarize: (result, params) => {
    const action = typeof params?.action === "string" ? params.action : "screenshot"
    return `COMPUTER_USE ${action} ${result?.success ? "ok" : `err=${result?.error ?? "failed"}`}`
  },
  validate: async (runtime: IAgentRuntime): Promise<boolean> => {
    return getComputerUseService(runtime) !== null
  },
  handler: createComputerUseHandler(async ({ service, raw: rawParams, message, signal, callback, runRelayed }) => {
    const approvalDecision = parseApprovalDecision(rawParams, message)
    if (approvalDecision) {
      if (approvalDecision.ownerMismatch) {
        return { success: false, error: approvalDecision.reason, text: approvalDecision.reason ?? "Owner mismatch." }
      }
      const resolved = service.resolveApproval(approvalDecision.approvalId, approvalDecision.approved, approvalDecision.reason)
      if (!resolved) {
        return { success: false, error: `Pending approval ${approvalDecision.approvalId} not found`, text: "Pending approval not found." }
      }
      const text = `Approval ${resolved.id} (${resolved.command}) ${resolved.approved ? "approved" : "denied"}.`
      if (callback) await callback({ text })
      return {
        success: true,
        text,
        promptDataMode: "replace-data",
        promptData: { action: "resolve_approval", approvalId: resolved.id, approved: resolved.approved, command: resolved.command },
        data: { source: "computeruse", computerUseAction: "resolve_approval", resolution: resolved },
      }
    }
    const action = (typeof rawParams.action === "string" ? rawParams.action : "screenshot") as DesktopActionType
    const desktopParams: DesktopActionParams = { ...(rawParams as Omit<DesktopActionParams, "action">), action }
    const result = await runRelayed(() => service.executeDesktopAction(desktopParams, signal))
    const text = result.success
      ? (result.message ?? `Completed ${action}.`)
      : `Desktop action failed: ${result.error ?? "unknown error"}`
    if (callback) {
      await callback({ text })
    }
    return {
      success: result.success,
      text,
      ...(result.success ? {} : { error: result.error ?? "Computer-use failed" }),
      promptDataMode: "replace-data",
      promptData: compactPromptProjection(action, result),
      data: {
        source: "computeruse",
        computerUseAction: action,
        result: { ...result, hasScreenshot: Boolean(result.screenshot), screenshot: undefined },
      },
    }
  }),
}

interface ComputerUseHandlerContext {
  readonly runtime: IAgentRuntime
  readonly service: ComputerUseService
  readonly message: Memory
  readonly raw: Record<string, unknown>
  readonly signal: AbortSignal | undefined
  readonly callback: HandlerCallback | undefined
  readonly runRelayed: <R>(fn: () => Promise<R>) => Promise<R>
}

function createComputerUseHandler(
  fn: (ctx: ComputerUseHandlerContext) => Promise<ActionResult>,
): Action["handler"] {
  return async (
    runtime: IAgentRuntime,
    message: Memory,
    _state?: State,
    options?: HandlerOptions | Record<string, unknown>,
    callback?: HandlerCallback,
  ): Promise<ActionResult> => {
    const service = getComputerUseService(runtime)
    if (!service) {
      return { success: false, error: "ComputerUseService not available", text: "ComputerUseService not available." }
    }
    const raw = resolveActionParams<Record<string, unknown>>(message, options)
    const signal = (options as { readonly abortSignal?: AbortSignal } | undefined)?.abortSignal
    const ownerId = approvalOwnerIdFromMemory(message)
    return fn({
      runtime,
      service,
      message,
      raw,
      signal,
      callback,
      runRelayed: (task) => withApprovalRelay(service, callback, task, { ownerId }),
    })
  }
}

export const windowAction: Action = {
  name: "WINDOW",
  contexts: ["automation", "screen_time"],
  contextGate: { anyOf: ["automation", "screen_time"] },
  roleGate: { minRole: "USER" },
  modelClass: "TEXT_SMALL",
  toolSchemaStrict: true,
  similes: ["MANAGE_WINDOW", "USE_WINDOW", "WINDOW", "WINDOW_ACTION"],
  description:
    "Manage desktop windows: list, focus, switch, arrange, move, minimize, maximize, restore, close, or query bounds/size/position.",
  descriptionCompressed:
    "Window: list|focus|switch|arrange|move|minimize|maximize|restore|close|bounds|size|position",
  parameters: [
    {
      name: "action",
      description: "Window operation verb.",
      descriptionCompressed: "Verb.",
      required: true,
      schema: { type: "string", enum: [...WINDOW_ACTION_ENUM] },
    },
    {
      name: "appName",
      description: "Application name filter.",
      descriptionCompressed: "App filter.",
      required: false,
      schema: { type: "string" },
    },
    {
      name: "arrangement",
      description: "Layout for arrange.",
      descriptionCompressed: "tile|cascade|vertical|horizontal.",
      required: false,
      schema: { type: "string", enum: ["cascade", "horizontal", "tile", "vertical"] },
    },
    { name: "height", description: "Height for set_bounds.", descriptionCompressed: "Height.", required: false, schema: { type: "number", minimum: 1 } },
    { name: "width", description: "Width for set_bounds.", descriptionCompressed: "Width.", required: false, schema: { type: "number", minimum: 1 } },
    { name: "windowId", description: "Window identifier.", descriptionCompressed: "Window id.", required: false, schema: { type: "string" } },
    { name: "windowTitle", description: "Window title query.", descriptionCompressed: "Title query.", required: false, schema: { type: "string" } },
    { name: "x", description: "Target X coordinate.", descriptionCompressed: "X.", required: false, schema: { type: "number" } },
    { name: "y", description: "Target Y coordinate.", descriptionCompressed: "Y.", required: false, schema: { type: "number" } },
  ],
  summarize: (result, params) => {
    const action = typeof params?.action === "string" ? params.action : "list"
    return `WINDOW ${action} ${result?.success ? "ok" : `err=${result?.error ?? "failed"}`}`
  },
  validate: async (runtime: IAgentRuntime): Promise<boolean> => {
    const service = getComputerUseService(runtime)
    return service !== null && service.getCapabilities().windowList.available
  },
  handler: createComputerUseHandler(async ({ service, raw, signal, callback, runRelayed }) => {
    const token = String(raw.action ?? raw.subaction ?? raw.op ?? "list").trim().toLowerCase().replaceAll(/[\s-]+/g, "_") as WindowActionType
    const params: WindowActionParams = { ...(raw as Omit<WindowActionParams, "action">), action: token }
    const result = await runRelayed(() => service.executeWindowAction(params, signal))
    const text = result.message ?? result.error ?? `Completed window ${token}.`
    if (callback) await callback({ text })
    return {
      success: result.success,
      text,
      ...(result.success ? {} : { error: result.error ?? "Window action failed" }),
      promptDataMode: "replace-data",
      promptData: {
        action: token,
        ok: result.success,
        ...(result.windowId ? { windowId: result.windowId } : {}),
        ...(result.windows ? { windowCount: result.windows.length, windows: result.windows.slice(0, 15).map((w) => ({ id: w.id, app: w.app, title: w.title })) } : {}),
        ...(result.bounds ? { bounds: result.bounds } : {}),
      },
      data: { source: "computeruse", computerUseAction: `window:${token}`, result },
    }
  }),
}

const CLIPBOARD_PREVIEW_CODE_UNITS = 4096

export const clipboardAction: Action = {
  name: "CLIPBOARD",
  contexts: ["automation", "files", "screen_time"],
  contextGate: { anyOf: ["automation", "files", "screen_time"] },
  roleGate: { minRole: "USER" },
  modelClass: "TEXT_SMALL",
  toolSchemaStrict: true,
  similes: ["CLIPBOARD", "CLIPBOARD_ACTION", "READ_CLIPBOARD", "USE_CLIPBOARD", "WRITE_CLIPBOARD"],
  description: "Read or write the host system clipboard (approval-gated).",
  descriptionCompressed: "Clipboard: read|write",
  parameters: [
    {
      name: "action",
      description: "Clipboard operation: read or write.",
      descriptionCompressed: "read|write.",
      required: true,
      schema: { type: "string", enum: [...CLIPBOARD_ACTION_ENUM] },
    },
    {
      name: "text",
      description: "Text payload for action=write.",
      descriptionCompressed: "Write text.",
      required: false,
      schema: { type: "string" },
    },
  ],
  summarize: (result, params) => {
    const action = typeof params?.action === "string" ? params.action : "read"
    return `CLIPBOARD ${action} ${result?.success ? "ok" : `err=${result?.error ?? "failed"}`}`
  },
  validate: async (runtime: IAgentRuntime): Promise<boolean> => {
    const service = getComputerUseService(runtime)
    return service !== null && service.getCapabilities().clipboard.available
  },
  handler: createComputerUseHandler(async ({ service, raw, signal, callback, runRelayed }) => {
    const op = String(raw.action ?? raw.subaction ?? raw.op ?? "read").trim().toLowerCase()
    if (op === "read") {
      const res = await runRelayed(() => service.executeCommand("clipboard_read", {}, signal))
      if (!res.success) return { success: false, error: res.error, text: res.error ?? "Clipboard read failed." }
      const fullText = toWellFormedUnicode(String((res.data as { readonly text?: unknown } | undefined)?.text ?? ""))
      const preview = fullText.length > CLIPBOARD_PREVIEW_CODE_UNITS
        ? `${truncateWellFormed(fullText, CLIPBOARD_PREVIEW_CODE_UNITS - 1)}…`
        : fullText
      const text = fullText.length === 0 ? "Clipboard is empty." : preview
      if (callback) await callback({ text })
      return {
        success: true,
        text,
        promptDataMode: "replace-data",
        promptData: { action: "read", chars: fullText.length, truncated: fullText.length > CLIPBOARD_PREVIEW_CODE_UNITS, preview },
        data: { source: "computeruse", computerUseAction: "clipboard:read", text: fullText },
      }
    }
    if (op === "write") {
      if (typeof raw.text !== "string") {
        return { success: false, error: "text is required for clipboard write", text: "text is required for clipboard write." }
      }
      const res = await runRelayed(() => service.executeCommand("clipboard_write", { text: raw.text }, signal))
      if (!res.success) return { success: false, error: res.error, text: res.error ?? "Clipboard write failed." }
      const bytes = utf8ByteLength(raw.text)
      const text = `Wrote ${bytes} bytes to clipboard.`
      if (callback) await callback({ text })
      return {
        success: true,
        text,
        promptDataMode: "replace-data",
        promptData: { action: "write", bytes },
        data: { source: "computeruse", computerUseAction: "clipboard:write", bytes },
      }
    }
    return { success: false, error: `Unknown clipboard action: ${op}`, text: `Unknown clipboard action: ${op}` }
  }),
}

export interface ComputerUseAgentParams {
  readonly goal: string
  readonly maxSteps?: number
  readonly streamProgress?: boolean
  readonly maxDurationMs?: number
  readonly imageRetentionLast?: number
  readonly imagePolicy?: "always" | "on-escalation" | "never"
  readonly signal?: AbortSignal
}

export interface ComputerUseAgentStepProgress {
  readonly step: number
  readonly sceneSummary: string
  readonly actionKind: string
  readonly rationale: string
  readonly rois: number
  readonly result: { readonly success: boolean; readonly error?: string }
}

export interface ComputerUseAgentReport {
  readonly goal: string
  readonly steps: readonly ComputerUseAgentStepProgress[]
  readonly finished: boolean
  readonly reason: "finish" | "max_steps" | "error" | "budget" | "cancelled" | "repeated_action"
  readonly error?: string
  readonly tokensSaved: number
}

export function formatComputerUseAgentProgress(progress: ComputerUseAgentStepProgress): string {
  return `Step ${progress.step}: ${progress.actionKind} — ${progress.rationale} (${progress.result.success ? "ok" : progress.result.error ?? "failed"})`
}

export interface ComputerUseAgentDeps {
  readonly brain?: Brain
  readonly middleware?: readonly AgentMiddleware[]
  readonly computerInterface?: ComputerInterface
  readonly captureAll?: () => Promise<readonly DisplayCapture[]>
  readonly now?: () => number
  readonly onStepProgress?: (progress: ComputerUseAgentStepProgress) => Promise<void> | void
  readonly onCompactStepProgress?: (content: Content) => Promise<void> | void
}

function serviceAsComputerInterface(service: ComputerUseService): ComputerInterface {
  return {
    leftClick: async (pt) => { await service.executeDesktopAction({ action: "click", coordinate: [pt.x, pt.y], displayId: pt.displayId }) },
    doubleClick: async (pt) => { await service.executeDesktopAction({ action: "double_click", coordinate: [pt.x, pt.y], displayId: pt.displayId }) },
    rightClick: async (pt) => { await service.executeDesktopAction({ action: "right_click", coordinate: [pt.x, pt.y], displayId: pt.displayId }) },
    typeText: async ({ text }) => { await service.executeDesktopAction({ action: "type", text }) },
    pressKey: async ({ key }) => { await service.executeDesktopAction({ action: "key", key }) },
    hotkey: async ({ keys }) => { await service.executeDesktopAction({ action: "key_combo", key: keys.join("+") }) },
    scroll: async (args) => { await service.executeDesktopAction({ action: "scroll", coordinate: [args.x, args.y], displayId: args.displayId, scrollDirection: args.dy >= 0 ? "up" : "down", scrollAmount: Math.max(1, Math.abs(args.dy)) }) },
    drag: async (args) => { await service.executeDesktopAction({ action: "drag", startCoordinate: [args.startX, args.startY], coordinate: [args.endX, args.endY], displayId: args.displayId }) },
  }
}

export async function runComputerUseAgentLoop(
  runtime: IAgentRuntime,
  params: ComputerUseAgentParams,
  service: ComputerUseService,
  deps: ComputerUseAgentDeps = {},
): Promise<ComputerUseAgentReport> {
  const now = deps.now ?? (() => Date.now())
  const startedAt = now()
  const maxSteps = Math.max(1, Math.min(30, params.maxSteps ?? 10))
  const brain = deps.brain ?? new Brain({ runtime, imagePolicy: params.imagePolicy ?? service.getConfig().brainImagePolicy })
  const cascade = new Cascade({ brain, actor: getRegisteredActor() })
  const iface = deps.computerInterface ?? serviceAsComputerInterface(service)
  const trajectorySink: Array<Record<string, unknown>> = []
  const middlewares: AgentMiddleware[] = deps.middleware
    ? [...deps.middleware]
    : [
        createOperatorNormalizerMiddleware(),
        createTrajectoryMiddleware(trajectorySink),
        ...(params.maxDurationMs !== undefined ? [createBudgetMiddleware(params.maxDurationMs)] : []),
        ...(params.imageRetentionLast !== undefined ? [createImageRetentionMiddleware(params.imageRetentionLast)] : []),
      ]

  for (const mw of middlewares) mw.onRunStart?.({ goal: params.goal, maxSteps })

  const steps: ComputerUseAgentStepProgress[] = []
  let lastActionKey = ""
  let repeatCount = 0

  for (let step = 1; step <= maxSteps; step += 1) {
    if (params.signal?.aborted) {
      for (const mw of middlewares) mw.onRunEnd?.({ goal: params.goal, steps: steps.length, reason: "cancelled" })
      return { goal: params.goal, steps, finished: false, reason: "cancelled", error: "Aborted by caller", tokensSaved: brain.getStats().estimatedTokensSaved }
    }
    const elapsedMs = now() - startedAt
    for (const mw of middlewares) {
      const decision = mw.beforeStep?.({ step, maxSteps, goal: params.goal, elapsedMs })
      if (decision?.abort) {
        const reason = decision.reason ?? "budget"
        for (const mwEnd of middlewares) mwEnd.onRunEnd?.({ goal: params.goal, steps: steps.length, reason })
        return { goal: params.goal, steps, finished: false, reason, error: decision.message, tokensSaved: brain.getStats().estimatedTokensSaved }
      }
    }

    const scene = await service.refreshScene("agent-turn")
    let captures: readonly DisplayCapture[] = deps.captureAll
      ? await deps.captureAll()
      : []
    for (const mw of middlewares) {
      if (mw.onCaptures) captures = mw.onCaptures(captures, step)
    }

    const historySummary = steps
      .slice(-4)
      .map((s) => `${s.step}:${s.actionKind}(${s.result.success ? "ok" : "err"})`)
      .join(" -> ")

    const cascadeResult = await cascade.step({ goal: params.goal, scene, captures, historySummary })
    let proposed = cascadeResult.proposed
    for (const mw of middlewares) {
      if (mw.transformProposed) proposed = mw.transformProposed(proposed)
    }

    const actionKey = JSON.stringify({ kind: proposed.kind, x: proposed.x, y: proposed.y, text: proposed.text, key: proposed.key })
    if (actionKey === lastActionKey && proposed.kind !== "wait" && proposed.kind !== "finish") {
      repeatCount += 1
      if (repeatCount >= 3) {
        for (const mw of middlewares) mw.onRunEnd?.({ goal: params.goal, steps: steps.length, reason: "repeated_action" })
        return {
          goal: params.goal,
          steps,
          finished: false,
          reason: "repeated_action",
          error: `Stopped after repeating ${proposed.kind} ${repeatCount} times`,
          tokensSaved: brain.getStats().estimatedTokensSaved,
        }
      }
    } else {
      lastActionKey = actionKey
      repeatCount = 0
    }

    const dispatchRes = await dispatch(proposed, {
      interface: iface,
      listDisplays: () => service.getDisplays(),
    })

    const progress: ComputerUseAgentStepProgress = {
      step,
      sceneSummary: cascadeResult.scene_summary,
      actionKind: proposed.kind,
      rationale: proposed.rationale,
      rois: cascadeResult.rois.length,
      result: { success: dispatchRes.success, ...(dispatchRes.error ? { error: dispatchRes.error.message } : {}) },
    }
    steps.push(progress)
    for (const mw of middlewares) {
      mw.afterStep?.({ step, goal: params.goal, proposed: { ...cascadeResult, proposed }, dispatchSuccess: dispatchRes.success, error: dispatchRes.error?.message })
    }
    if (isStreamProgressEnabled(params.streamProgress)) {
      await deps.onStepProgress?.(progress)
      await deps.onCompactStepProgress?.(
        buildStepProgressContent({
          actionName: "COMPUTER_USE_AGENT",
          step,
          kind: proposed.kind,
          rationale: proposed.rationale,
          success: dispatchRes.success,
          error: dispatchRes.error?.message,
        }),
      )
    }

    if (proposed.kind === "finish") {
      for (const mw of middlewares) mw.onRunEnd?.({ goal: params.goal, steps: steps.length, reason: "finish" })
      return { goal: params.goal, steps, finished: true, reason: "finish", tokensSaved: brain.getStats().estimatedTokensSaved }
    }
  }

  for (const mw of middlewares) mw.onRunEnd?.({ goal: params.goal, steps: steps.length, reason: "max_steps" })
  return {
    goal: params.goal,
    steps,
    finished: false,
    reason: "max_steps",
    error: `Reached maxSteps (${maxSteps}) without finishing`,
    tokensSaved: brain.getStats().estimatedTokensSaved,
  }
}

export const computerUseAgentAction: Action = {
  name: "COMPUTER_USE_AGENT",
  contexts: ["admin", "automation", "screen_time"],
  contextGate: { anyOf: ["admin", "automation", "screen_time"] },
  roleGate: { minRole: "OWNER" },
  toolSchemaStrict: true,
  similes: ["DESKTOP_AGENT", "RUN_COMPUTER_AGENT", "SCREEN_AGENT"],
  description:
    "Autonomous desktop agent loop: observes the scene with dHash deduplication and text-first grounding, plans steps, and dispatches until the goal finishes.",
  descriptionCompressed: "Autonomous desktop loop for multi-step visual goals.",
  parameters: [
    { name: "goal", description: "Goal to achieve on screen.", descriptionCompressed: "Goal.", required: true, schema: { type: "string" } },
    { name: "imagePolicy", description: "Image attachment policy: on-escalation, always, or never.", descriptionCompressed: "Image policy.", required: false, schema: { type: "string", enum: ["always", "never", "on-escalation"] } },
    { name: "imageRetentionLast", description: "Max recent step screenshots retained.", descriptionCompressed: "Retain N images.", required: false, schema: { type: "number", minimum: 1 } },
    { name: "maxDurationMs", description: "Wall-clock budget in ms.", descriptionCompressed: "Budget ms.", required: false, schema: { type: "number", minimum: 0 } },
    { name: "maxSteps", description: "Maximum loop steps (default 10).", descriptionCompressed: "Max steps.", required: false, schema: { type: "number", minimum: 1, maximum: 30 } },
    { name: "streamProgress", description: "Emit compact step progress updates.", descriptionCompressed: "Stream progress.", required: false, schema: { type: "boolean", default: false } },
  ],
  summarize: (result) => `COMPUTER_USE_AGENT ${result?.success ? "finished" : `stopped(${result?.error ?? "err"})`}`,
  validate: async (runtime: IAgentRuntime): Promise<boolean> => getComputerUseService(runtime) !== null,
  handler: createComputerUseHandler(async ({ runtime, service, raw, signal, callback, runRelayed }) => {
    const params = raw as unknown as ComputerUseAgentParams
    if (!params.goal || typeof params.goal !== "string") {
      return { success: false, error: "COMPUTER_USE_AGENT requires a goal string", text: "COMPUTER_USE_AGENT requires a goal string." }
    }
    const report = await runRelayed(() => runComputerUseAgentLoop(runtime, { ...params, signal }, service, {
      onCompactStepProgress: callback ? async (content) => { await callback(content, "COMPUTER_USE_AGENT") } : undefined,
    }))
    const text = report.reason === "finish"
      ? `Computer-use agent finished after ${report.steps.length} step(s): goal="${report.goal}"`
      : `Computer-use agent stopped (${report.reason}) after ${report.steps.length} step(s): ${report.error ?? report.reason}`
    if (callback) await callback({ text })
    return {
      success: report.reason === "finish",
      ...(report.reason === "finish" ? {} : { error: report.error ?? text }),
      text,
      promptDataMode: "replace-data",
      promptData: {
        goal: report.goal,
        reason: report.reason,
        stepCount: report.steps.length,
        tokensSaved: report.tokensSaved,
        tailSteps: report.steps.slice(-3).map((s) => ({ step: s.step, kind: s.actionKind, ok: s.result.success })),
      },
      data: { source: "computeruse", computerUseAction: "COMPUTER_USE_AGENT", report },
    }
  }),
}

const EXPLICIT_COMPUTER_USE_PATTERN =
  /\b(?:use|via|with|using)\s+(?:computer\s*use|computeruse|desktop\s*control)\b|\b(?:computer\s*use|computeruse)\s+(?:to|and)\b/i

const NEGATED_COMPUTER_USE_PATTERN =
  /\b(?:do\s+not|don't|never|stop|cancel|forget|skip)\s+(?:use\s+)?(?:computer\s*use|computeruse|it|that|this|doing\s+that|clicking|typing)\b|\b(?:actually|instead|never\s*mind)[, ]+\s*(?:don't|do\s+not|cancel|skip)\b/i

export function looksLikeExplicitComputerUseRequest(text: string): boolean {
  const normalized = text.normalize("NFKC").replaceAll(/"[^"]*"|'[^']*'/g, " ").trim()
  const match = EXPLICIT_COMPUTER_USE_PATTERN.exec(normalized)
  if (!match) return false
  const trailing = normalized.slice(match.index + match[0].length)
  if (NEGATED_COMPUTER_USE_PATTERN.test(trailing)) return false
  const leading = normalized.slice(0, match.index)
  if (/\b(?:do\s+not|don't|never)\s*$/i.test(leading.trim())) return false
  return true
}

export interface DirectActionRoutingRule {
  readonly id: string
  readonly actionNames: readonly string[]
  readonly replacesActionNames: readonly string[]
  readonly requiredActionTags: readonly string[]
  readonly contexts: readonly string[]
  readonly unavailable: { readonly code: string; readonly reply: string }
  readonly matches: (text: string) => boolean
}

export function createComputerUseDirectRoutingRule(): DirectActionRoutingRule {
  return {
    id: "computer-use.explicit-host-control",
    actionNames: ["COMPUTER_USE"],
    replacesActionNames: ["BROWSER", "BROWSER_NAVIGATE", "AUTOMATION_TRIGGER", "TRIGGER", "VIEWS"],
    requiredActionTags: ["domain:computer-use", "capability:desktop-control", "effect:host-action"],
    contexts: ["automation", "admin"],
    unavailable: {
      code: "COMPUTER_USE_UNAVAILABLE",
      reply: "Computer Use is unavailable in this app session. Enable Computer Use, restart the app session, and try again. (COMPUTER_USE_UNAVAILABLE)",
    },
    matches: looksLikeExplicitComputerUseRequest,
  }
}
