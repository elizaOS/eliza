} from "./types.vibe"

export const ACTION_PROGRESS_SOURCE = "action_progress"
export const COMPUTER_USE_APPROVAL_SOURCE = "computeruse_approval"

export interface StepProgressInput {
  readonly actionName: string
  readonly step: number
  readonly kind: string
  readonly rationale?: string
  readonly success?: boolean
  readonly error?: string
  readonly source?: string
}

export interface ApprovalRelayService {
  getApprovalSnapshot(): ApprovalSnapshot
  subscribeApprovals(listener: (snapshot: ApprovalSnapshot) => void): () => void
}

export interface ApprovalRelayOptions {
  readonly ownerId?: string
}

export function isStreamProgressEnabled(value: unknown): value is true {
  return value === true
}

export function formatStepProgressText(step: number, kind: string, rationale?: string): string {
  const trimmed = rationale?.trim()
  return `Step ${step}: ${kind} — ${trimmed || "dispatched"}`
}

export function buildStepProgressContent(input: StepProgressInput): Content {
  const rationale = input.rationale?.trim() || "dispatched"
  return {
    text: formatStepProgressText(input.step, input.kind, rationale),
    source: ACTION_PROGRESS_SOURCE,
    metadata: {
      transient: true,
      compactProgress: true,
      progress: {
        source: input.source ?? "computeruse",
        actionName: input.actionName,
        step: input.step,
        kind: input.kind,
        rationale,
        ...(input.success !== undefined ? { success: input.success } : {}),
        ...(input.error !== undefined ? { error: input.error } : {}),
      },
    },
  }
}

function approvalCallbackValue(approvalId: string, decision: "approve" | "deny", ownerId?: string): string {
  return ownerId ? `cua:${approvalId}:${decision}:u${ownerId}` : `cua:${approvalId}:${decision}`
}

export function buildApprovalPromptContent(approval: PendingApproval, options: ApprovalRelayOptions = {}): Content {
  return {
    text: [
      `Computer-use approval requested for \`${approval.command}\`.`,
      `[CHOICE:computeruse-approval id=${approval.id}]`,
      `${approvalCallbackValue(approval.id, "approve", options.ownerId)}=Approve`,
      `${approvalCallbackValue(approval.id, "deny", options.ownerId)}=Deny`,
      "[/CHOICE]",
    ].join("\n"),
    source: COMPUTER_USE_APPROVAL_SOURCE,
    metadata: {
      transient: true,
      computeruse: {
        approvalId: approval.id,
        command: approval.command,
        requestedAt: approval.requestedAt,
        ...(options.ownerId ? { ownerId: options.ownerId } : {}),
      },
    },
  }
}

export async function withApprovalRelay<T>(
  service: ApprovalRelayService,
  callback: HandlerCallback | undefined,
  run: () => Promise<T>,
  options: ApprovalRelayOptions = {},
): Promise<T> {
  if (!callback) return run()
  const seen = new Set<string>(service.getApprovalSnapshot().pendingApprovals.map((a) => a.id))
  const deliveries: Array<Promise<Memory[]>> = []
  const unsubscribe = service.subscribeApprovals((snapshot) => {
    for (const approval of snapshot.pendingApprovals) {
      if (seen.has(approval.id)) continue
      seen.add(approval.id)
      deliveries.push(
        callback(buildApprovalPromptContent(approval, options), "COMPUTER_USE_APPROVAL").catch((error) => {
          logger.warn(
            { src: "plugin:computeruse", approvalId: approval.id, error: error instanceof Error ? error.message : String(error) },
            "Failed to relay computer-use approval request",
          )
          return []
        }),
      )
    }
  })
  try {
    return await run()
  } finally {
    unsubscribe()
    await Promise.allSettled(deliveries)
  }
}

function getComputerUseService(runtime: IAgentRuntime): ComputerUseService | null {
  return (runtime.getService(COMPUTERUSE_SERVICE_TYPE) as ComputerUseService | null) ?? null
}

function resolveActionParams<T>(message: Memory, options?: HandlerOptions | Record<string, unknown>): T {
  const params = (options as { readonly parameters?: unknown } | undefined)?.parameters
  if (params && typeof params === "object") {
    return { ...(params as Record<string, unknown>) } as T
  }
  return { ...(message.content as Record<string, unknown>) } as T
}

function approvalOwnerIdFromMemory(message: Memory): string | undefined {
  const metadata = message.metadata
  if (!metadata || typeof metadata !== "object") return undefined
  const id = (metadata as Record<string, unknown>).telegramUserId ?? (metadata as Record<string, unknown>).ownerId
  return typeof id === "string" && id.length > 0 ? id : undefined
}

const DESKTOP_ACTION_ENUM = [
  "batch",
  "click",
  "click_with_modifiers",
  "detect_elements",
  "double_click",
  "drag",
  "get_cursor_position",
  "key",
  "key_combo",
  "key_down",
  "key_up",
  "kill_app",
  "launch",
  "middle_click",
  "mouse_down",
  "mouse_move",
  "mouse_up",
  "ocr",
  "open",
  "resolve_approval",
  "right_click",
  "screenshot",
  "scroll",
  "set_value",
  "type",
] as const

const WINDOW_ACTION_ENUM = [
  "arrange",
  "close",
  "focus",
  "get_application_windows",
  "get_current_window_id",
  "get_window_position",
  "get_window_size",
  "list",
  "maximize",
  "minimize",
  "move",
  "restore",
  "set_bounds",
  "switch",
] as const satisfies readonly WindowActionType[]

const CLIPBOARD_ACTION_ENUM = ["read", "write"] as const
export type ClipboardActionType = (typeof CLIPBOARD_ACTION_ENUM)[number]

export interface ClipboardActionParams {
  readonly action: ClipboardActionType
  readonly text?: string
}

interface ApprovalDecision {
  readonly approvalId: string
  readonly approved: boolean
  readonly reason?: string
  readonly ownerMismatch?: boolean
}

function parseApprovalDecision(
  params: Record<string, unknown>,
  message: Memory,
): ApprovalDecision | null {
  if (params.action === "resolve_approval") {
    const approvalId = typeof params.approvalId === "string" ? params.approvalId.trim() : ""
    if (!approvalId || typeof params.approved !== "boolean") return null
    return {
      approvalId,
      approved: params.approved,
      ...(typeof params.reason === "string" ? { reason: params.reason } : {}),
    }
  }
  const text = typeof message.content?.text === "string" ? message.content.text.trim() : ""
  const compact = /^cua:([^:]+):(approve|deny)(?::u([^:]+))?$/.exec(text)
  if (compact) {
    const ownerId = compact[3]
    const messageOwnerId = approvalOwnerIdFromMemory(message)
    if (ownerId && (!messageOwnerId || ownerId !== messageOwnerId)) {
      return { approvalId: compact[1] ?? "", approved: false, reason: "Approval callback owner mismatch", ownerMismatch: true }
    }
    return { approvalId: compact[1] ?? "", approved: compact[2] === "approve", reason: `Resolved from chat (${compact[2]})` }
  }
  const simple = /^(approve|deny):([A-Za-z0-9_-]+)$/.exec(text)
  if (!simple) return null
  return { approvalId: simple[2] ?? "", approved: simple[1] === "approve", reason: `Resolved from chat (${simple[1]})` }
}

function compactPromptProjection(action: string, result: ComputerActionResult): ProviderDataRecord {
  return {
    action,
    ok: result.success,
    ...(result.message ? { message: result.message } : {}),
    ...(result.error ? { error: result.error } : {}),
    ...(result.errorCode ? { errorCode: result.errorCode } : {}),
    ...(result.coordinate ? { coordinate: [result.coordinate[0], result.coordinate[1]] } : {}),
    ...(result.cursorPosition ? { cursor: { x: result.cursorPosition.x, y: result.cursorPosition.y } } : {}),
    ...(result.pid !== undefined ? { pid: result.pid } : {}),
    ...(result.stepsExecuted !== undefined ? { stepsExecuted: result.stepsExecuted, stepsRequested: result.stepsRequested ?? 0 } : {}),
    ...(result.abortedAtStep !== undefined ? { abortedAtStep: result.abortedAtStep } : {}),
    ...(result.screenshot ? { hasScreenshot: true } : {}),
  }
}

