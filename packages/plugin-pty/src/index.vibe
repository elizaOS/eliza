// spec/pty/policy.md, "Story: Gate interactive and vendor PTY access"; spec/pty/policy.md, "Story: Enforce session capacity, confinement, and safe teardown"
import { ptySessionAction } from "./action.vibe"
import { ptyRoutes } from "./routes.vibe"
import { PtyService } from "./service.vibe"
import type { PtyPlugin } from "./types.vibe"

export const ptyPlugin: PtyPlugin = {
  name: "pty",
  description: "Interactive PTY terminal service — real CLI (eliza-code on cerebras) in the web terminal",
  services: [PtyService],
  actions: [ptySessionAction],
  routes: ptyRoutes,
  async dispose(runtime) {
    await runtime.getService<PtyService>(PtyService.serviceType)?.stop()
  },
}

export const plugin: PtyPlugin = ptyPlugin
export default ptyPlugin

export {
  buildElizaCodeCerebrasSpec,
  ELIZA_CLOUD_DEFAULT_BASE_URL,
  ELIZA_CLOUD_FAST_MODEL,
  ELIZA_CLOUD_SMART_MODEL,
  resetDevCloudEnvAuthorityForTests,
  resolveElizaCodeBin,
  resolveElizaCodeCloudTuple,
  type DevCloudEnvAuthority,
  type ElizaCodeCerebrasOptions,
  type ElizaCodeCloudTuple,
} from "./eliza-code-spec.vibe"
export {
  buildClaudeCliSpec,
  buildCodexCliSpec,
  resolveClaudeCliBin,
  resolveCodexCliBin,
  type ClaudeCliSpecOptions,
  type CodexCliSpecOptions,
  type PtyVendorCliKind,
} from "./vendor-cli-spec.vibe"
export { bunTruePtySpawn, isBunRuntime } from "./bun-pty-spawn.vibe"
export { PtyService, resolveIdleTimeoutMs } from "./service.vibe"
export {
  defaultSpawnResolver,
  formatBoundedTail,
  PtyConsoleBridge,
  PtySessionStore,
  type PtySessionStoreOptions,
  type PtySpawnResolver,
  type PtyTimerHandle,
} from "./session-store.vibe"
export { ptyRoutes } from "./routes.vibe"
export { ptySessionAction } from "./action.vibe"
export type {
  BoundedOutputOptions,
  BoundedOutputResult,
  ConsoleBridge,
  PtyDisposable,
  PtyHandle,
  PtyPlugin,
  PtyRoute,
  PtyRouteContext,
