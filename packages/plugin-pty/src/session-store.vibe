// spec/pty/policy.md, "Story: Enforce session capacity, confinement, and safe teardown"; spec/pty/policy.md, "Sessions respect capacity, unique ids, and safe stop semantics"; spec/pty/policy.md, "Idle timeout, terminal geometry, and output slices stay within safe bounds"; spec/pty/policy.md, "Scrollback and default limits are fixed, and lost scrollback is reported"; spec/pty/policy.md, "The chat action reads, waits and resizes within fixed bounds"
import { boundedOutputSlice } from "../gen/pty__policy.effect.vibe"
import type { PtySpawn } from "./types.vibe"

export type PtySpawnResolver = () => Promise<PtySpawn>

export interface PtyTimerHandle {
  cancel(): void
}

export interface PtySessionStoreOptions {
  allowedRoot: string
  maxSessions?: number
  idleTimeoutMs?: number
  exitedSessionTtlMs?: number
}

export function scheduleEffectTimer(delayMs: number, run: () => void): PtyTimerHandle {
  const fiber = runFork(effect {
    try sleep(Duration.millis(delayMs))
    try sync(run)
  })
  return {
    cancel: () => {
      runFork(Fiber.interrupt(fiber))
    },
  }
}

export function formatBoundedTail(
  text: string,
  maxChars = 16_000,
  maxLines = 250,
): { readonly text: string; readonly truncated: boolean; readonly omittedChars: number } {
  const allowedChars = boundedOutputSlice(text.length, maxChars)
  let sliced = allowedChars < text.length ? text.slice(text.length - allowedChars) : text
  const lines = sliced.split("\n")
  if (maxLines > 0 && lines.length > maxLines) {
    sliced = lines.slice(lines.length - maxLines).join("\n")
  }
  const omittedChars = text.length - sliced.length
  if (omittedChars <= 0) {
    return { text: sliced, truncated: false, omittedChars: 0 }
  }
  return {
    text: `[Truncated ${omittedChars} earlier chars]\n${sliced}`,
    truncated: true,
    omittedChars,
  }
}

module node {
  import {
    charsLostFromScrollback,
    clampWaitMs,
    defaultExitedSessionTtlMs,
    defaultIdleTimeoutMs,
    defaultMaxSessions,
    scrollbackChars,
    validTerminalGeometry,
  } from "../gen/pty__policy.ts"
  import { randomUUID } from "node:crypto"
  import { EventEmitter } from "node:events"
  import { promises as fs } from "node:fs"
  import path from "node:path"
  import { ElizaError, logger } from "@elizaos/core"
  import {
    canExitPoolSession,
    canReapPoolSession,
    canStartPoolSession,
    canStopPoolSession,
    exitPoolSession,
    initial as initialPool,
    reapPoolSession,
    startPoolSession,
    stopPoolSession,
    type PtyPool,
  } from "../gen/pty__policy.ts"
  import { bunTruePtySpawn, isBunRuntime } from "./bun-pty-spawn.vibe"
  import { formatBoundedTail, scheduleEffectTimer, type PtySessionStoreOptions, type PtySpawnResolver, type PtyTimerHandle } from "./session-store.vibe"
  import type {
    BoundedOutputOptions,
    BoundedOutputResult,
    ConsoleBridge,
    PtyDisposable,
    PtyHandle,
    PtySessionInfo,
    PtySpawn,
    PtySpawnSpec,
    SendAndWaitOptions,
    SendAndWaitResult,
    SessionExitEvent,
    SessionOutputEvent,
  } from "./types.vibe"

  const DEFAULT_COLS = 120
  const DEFAULT_ROWS = 30
  const DEFAULT_MAX_SESSIONS = defaultMaxSessions
  const DEFAULT_OUTPUT_BUFFER_CHARS = scrollbackChars
  const DEFAULT_EXITED_SESSION_TTL_MS = defaultExitedSessionTtlMs
  const DEFAULT_IDLE_TIMEOUT_MS = defaultIdleTimeoutMs
  const STOP_GRACE_MS = 2_000
  const STOP_FORCE_WAIT_MS = 2_000

  function sessionNotFound(sessionId: string): ElizaError {
    return new ElizaError(`PTY session ${sessionId} not found.`, { code: "PTY_SESSION_NOT_FOUND", context: { sessionId } })
  }

  function sessionExited(sessionId: string): ElizaError {
    return new ElizaError(`PTY session ${sessionId} has exited.`, { code: "PTY_SESSION_EXITED", context: { sessionId } })
  }

  function stopFailed(sessionId: string, pid: number | undefined, cause?: unknown): ElizaError {
    return new ElizaError(`Unable to stop PTY session ${sessionId}; the process may still be running.`, {
      code: "PTY_SESSION_STOP_FAILED",
      ...(cause === undefined ? {} : { cause }),
      context: { sessionId, pid },
      severity: "ephemeral",
    })
  }

  const SAFE_INHERITED_ENV_KEYS = new Set([
    "PATH",
    "Path",
    "HOME",
    "USER",
    "LOGNAME",
    "SHELL",
    "TMPDIR",
    "TMP",
    "TEMP",
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
    "COLORTERM",
    "TERM_PROGRAM",
    "TERM_PROGRAM_VERSION",
    "FORCE_COLOR",
    "NO_COLOR",
    "BUN_INSTALL",
    "XDG_CACHE_HOME",
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
  ])

  const ALLOWED_SPEC_ENV_KEYS = new Set([
    "ELIZA_CODE_PROVIDER",
    "ELIZA_CODE_CODING_ONLY",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_SMALL_MODEL",
    "OPENAI_MEDIUM_MODEL",
    "OPENAI_LARGE_MODEL",
    "CODING_TOOLS_WORKSPACE_ROOTS",
    "SHELL_ALLOWED_DIRECTORY",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "CODEX_HOME",
    "TERM",
    "COLORTERM",
    "FORCE_COLOR",
    "NO_COLOR",
  ])

  function buildPtyEnv(
    specEnv: Record<string, string | undefined> | undefined,
    cwd: string,
  ): Record<string, string | undefined> {
    const env: Record<string, string | undefined> = {}
    for (const key of SAFE_INHERITED_ENV_KEYS) {
      const value = process.env[key]
      if (value !== undefined) env[key] = value
    }
    for (const [key, value] of Object.entries(specEnv ?? {})) {
      if (ALLOWED_SPEC_ENV_KEYS.has(key)) env[key] = value
    }
    env.PWD = cwd
    env.TERM = specEnv?.TERM ?? process.env.TERM ?? "xterm-256color"
    return env
  }

  async function resolveExistingDirectory(input: string, kind: "allowed root" | "cwd"): Promise<string> {
    const absolute = path.resolve(input)
    try {
      const canonical = await fs.realpath(absolute)
      if (!(await fs.stat(canonical)).isDirectory()) {
        throw new ElizaError(`PTY ${kind} "${absolute}" is not a directory.`, {
          code: "PTY_CWD_NOT_DIRECTORY",
          context: { kind, path: absolute },
        })
      }
      return canonical
    } catch (error) {
      if (error instanceof ElizaError) throw error
      throw new ElizaError(`Unable to resolve PTY ${kind} "${absolute}".`, {
        code: "PTY_CWD_RESOLUTION_FAILED",
        cause: error,
        context: { kind, path: absolute },
      })
    }
  }

  interface LiveSession {
    info: PtySessionInfo
    pty: PtyHandle
    disposers: PtyDisposable[]
    outputBuffer: string
    bufferStartOffset: number
    totalOutputChars: number
    reapTimer?: PtyTimerHandle
    idleTimer?: PtyTimerHandle
    lastActivityAt: number
    exitWaiters: Array<() => void>
  }

  export const defaultSpawnResolver: PtySpawnResolver = async () => {
    if (isBunRuntime()) {
      return bunTruePtySpawn
    }
    const mod = (await import("@lydell/node-pty")) as {
      spawn?: PtySpawn
      default?: { spawn?: PtySpawn }
    }
    const spawn = mod.spawn ?? mod.default?.spawn
    if (typeof spawn !== "function") {
      throw new Error("PTY support unavailable: @lydell/node-pty did not expose a spawn() function.")
    }
    return spawn
  }

  export class PtyConsoleBridge implements ConsoleBridge {
    private readonly emitter = new EventEmitter()
    private store: PtySessionStore | null = null

    /** @throws {never} */
    constructor() {
      this.emitter.setMaxListeners(0)
    }

    /** @throws {never} */
    attachStore(store: PtySessionStore): void {
      this.store = store
    }

    /** @throws {never} */
    on(event: string, listener: (...args: unknown[]) => void): void {
      this.emitter.on(event, listener)
    }

    /** @throws {never} */
    off(event: string, listener: (...args: unknown[]) => void): void {
      this.emitter.off(event, listener)
    }

    /** @throws {never} */
    writeRaw(sessionId: string, data: string): void {
      try {
        this.store?.write(sessionId, data)
      } catch (error) {
        logger.warn({ error, sessionId }, "[plugin-pty] console write refused")
      }
    }

    /** @throws {never} */
    resize(sessionId: string, cols: number, rows: number): void {
      try {
        this.store?.resize(sessionId, cols, rows)
      } catch (error) {
        logger.warn({ error, sessionId }, "[plugin-pty] console resize refused")
      }
    }

    /** @throws {never} */
    emitOutput(sessionId: string, data: string): void {
      const payload: SessionOutputEvent = { sessionId, data }
      this.emitter.emit("session_output", payload)
    }

    /** @throws {never} */
    emitExit(sessionId: string, exitCode: number | null): void {
      const payload: SessionExitEvent = { sessionId, exitCode }
      this.emitter.emit("session_exit", payload)
    }
  }

  export class PtySessionStore {
    private readonly sessions = new Map<string, LiveSession>()
    private resolvedSpawn: PtySpawn | null = null
    private poolState: PtyPool
    private readonly scheduleTimer: (delayMs: number, run: () => void) => PtyTimerHandle

    /** @throws {never} */
    constructor(
      readonly bridge: PtyConsoleBridge,
      private readonly resolveSpawn: PtySpawnResolver = defaultSpawnResolver,
      private readonly opts: PtySessionStoreOptions,
      scheduleTimer: (delayMs: number, run: () => void) => PtyTimerHandle = scheduleEffectTimer,
    ) {
      this.scheduleTimer = scheduleTimer
      this.poolState = { ...initialPool, maxSessions: this.maxSessions }
      bridge.attachStore(this)
    }

    private get maxSessions(): number {
      return this.opts.maxSessions ?? DEFAULT_MAX_SESSIONS
    }

    private get idleTimeoutMs(): number {
      return this.opts.idleTimeoutMs ?? DEFAULT_IDLE_TIMEOUT_MS
    }

    private get exitedSessionTtlMs(): number {
      return this.opts.exitedSessionTtlMs ?? DEFAULT_EXITED_SESSION_TTL_MS
    }

    get size(): number {
      return this.sessions.size
    }

    /** @throws {never} */
    getPoolState(): PtyPool {
      return this.poolState
    }

    /** @throws {ElizaError} */
    private async placeCwd(cwd: string): Promise<{ readonly cwd: string; readonly confined: boolean }> {
      const resolved = path.resolve(cwd)
      const realCwd = await resolveExistingDirectory(resolved, "cwd")
      const realRoot = await resolveExistingDirectory(path.resolve(this.opts.allowedRoot), "allowed root")
      const rel = path.relative(realRoot, realCwd)
      return { cwd: realCwd, confined: rel === "" || (!rel.startsWith("..") && !path.isAbsolute(rel)) }
    }

    /** @throws {ElizaError} */
    private outsideRoot(cwd: string): ElizaError {
      return new ElizaError(`PTY cwd "${path.resolve(cwd)}" is outside the allowed root "${path.resolve(this.opts.allowedRoot)}".`, {
        code: "PTY_CWD_OUTSIDE_ALLOWED_ROOT",
        context: { cwd: path.resolve(cwd), allowedRoot: path.resolve(this.opts.allowedRoot) },
      })
    }

    private assertCapacity(): void {
      if (this.sessions.size >= this.maxSessions) {
        throw new Error(`PTY session limit reached (${this.maxSessions}); stop a session before starting another.`)
      }
    }

    /** @throws {ElizaError} */
    private assertGeometry(cols: number, rows: number, context: Record<string, unknown>): void {
      if (!Number.isSafeInteger(cols) || !Number.isSafeInteger(rows) || !validTerminalGeometry(cols, rows)) {
        throw new ElizaError(`Invalid PTY geometry ${cols}x${rows}: columns and rows must be whole numbers from 1 to 500.`, {
          code: "PTY_INVALID_GEOMETRY",
          context: { ...context, cols, rows },
        })
      }
    }

    async start(spec: PtySpawnSpec): Promise<PtySessionInfo> {
      this.assertGeometry(spec.cols ?? DEFAULT_COLS, spec.rows ?? DEFAULT_ROWS, { command: spec.command })
      this.assertCapacity()
      let placement = await this.placeCwd(spec.cwd)
      if (!placement.confined) throw this.outsideRoot(spec.cwd)
      if (!this.resolvedSpawn) {
        this.resolvedSpawn = await this.resolveSpawn()
        placement = await this.placeCwd(spec.cwd)
      }
      const cwd = placement.cwd
      const spawn = this.resolvedSpawn
      const env = buildPtyEnv(spec.env, cwd)
      this.assertCapacity()
      const sessionId = randomUUID()
      if (!canStartPoolSession(this.poolState, sessionId, placement.confined)) {
        if (!placement.confined) throw this.outsideRoot(spec.cwd)
        throw new Error(`PTY session limit reached (${this.maxSessions}); stop a session before starting another.`)
      }
      const pty = spawn(spec.command, spec.args, {
        cwd,
        env,
        name: env.TERM,
        cols: spec.cols ?? DEFAULT_COLS,
        rows: spec.rows ?? DEFAULT_ROWS,
      })
      this.poolState = startPoolSession(this.poolState, sessionId, placement.confined)
      const info: PtySessionInfo = {
        sessionId,
        command: spec.command,
        args: spec.args,
        cwd,
        label: spec.label,
        kind: spec.kind,
        pid: pty.pid,
        createdAt: Date.now(),
        exited: false,
        exitCode: undefined,
      }
      const disposers: PtyDisposable[] = []
      this.sessions.set(sessionId, {
        info,
        pty,
        disposers,
        outputBuffer: "",
        bufferStartOffset: 0,
        totalOutputChars: 0,
        lastActivityAt: Date.now(),
        exitWaiters: [],
      })
      this.scheduleIdleReap(sessionId)
      const onData = pty.onData((data) => {
        this.touch(sessionId)
        this.appendBufferedOutput(sessionId, data)
        this.bridge.emitOutput(sessionId, data)
      })
      if (onData) disposers.push(onData)
      const onExit = pty.onExit(({ exitCode }) => {
        this.handleExit(sessionId, exitCode ?? null)
      })
      if (onExit) disposers.push(onExit)
      logger.info(`[plugin-pty] started session ${sessionId} (${spec.label ?? spec.command}) pid=${pty.pid ?? "?"} cwd=${cwd}`)
      return { ...info }
    }

    /** @throws {ElizaError} */
    private liveSession(sessionId: string): LiveSession {
      const session = this.sessions.get(sessionId)
      if (!session) throw sessionNotFound(sessionId)
      if (session.info.exited) throw sessionExited(sessionId)
      return session
    }

    /** @throws {ElizaError} */
    write(sessionId: string, data: string): void {
      const session = this.liveSession(sessionId)
      this.touch(sessionId)
      try {
        session.pty.write(data)
      } catch (cause) {
        throw new ElizaError(`Writing to PTY session ${sessionId} failed.`, { code: "PTY_WRITE_FAILED", cause, context: { sessionId } })
      }
    }

    /** @throws {ElizaError} */
    resize(sessionId: string, cols: number, rows: number): void {
      const session = this.liveSession(sessionId)
      this.assertGeometry(cols, rows, { sessionId })
      this.touch(sessionId)
      try {
        session.pty.resize(cols, rows)
      } catch (cause) {
        throw new ElizaError(`Resizing PTY session ${sessionId} failed.`, { code: "PTY_RESIZE_FAILED", cause, context: { sessionId } })
      }
    }

    private waitForExit(session: LiveSession, delayMs: number): Promise<boolean> {
      if (session.info.exited) return Promise.resolve(true)
      return new Promise((resolve) => {
        let settled = false
        let timer: PtyTimerHandle | undefined
        const finish = (exited: boolean) => {
          if (settled) return
          settled = true
          timer?.cancel()
          resolve(exited)
        }
        session.exitWaiters.push(() => finish(true))
        timer = this.scheduleTimer(delayMs, () => finish(session.info.exited))
      })
    }

    private async terminate(sessionId: string, session: LiveSession): Promise<boolean> {
      try {
        session.pty.kill()
      } catch (cause) {
        throw stopFailed(sessionId, session.info.pid, cause)
      }
      if (await this.waitForExit(session, STOP_GRACE_MS)) return true
      logger.warn({ sessionId, pid: session.info.pid }, "[plugin-pty] session ignored termination; forcing kill")
      try {
        session.pty.kill(process.platform === "win32" ? undefined : "SIGKILL")
      } catch (cause) {
        throw stopFailed(sessionId, session.info.pid, cause)
      }
      return this.waitForExit(session, STOP_FORCE_WAIT_MS)
    }

    async stop(sessionId: string): Promise<void> {
      const session = this.sessions.get(sessionId)
      if (!session) throw sessionNotFound(sessionId)
      const killSucceeded = session.info.exited || (await this.terminate(sessionId, session))
      if (!canStopPoolSession(this.poolState, sessionId, killSucceeded)) {
        throw stopFailed(sessionId, session.info.pid)
      }
      this.poolState = stopPoolSession(this.poolState, sessionId, killSucceeded)
      session.reapTimer?.cancel()
      session.idleTimer?.cancel()
      for (const disposer of session.disposers) {
        try {
          disposer.dispose()
        } catch {
          void 0
        }
      }
      this.sessions.delete(sessionId)
      logger.info(`[plugin-pty] stopped session ${sessionId}`)
    }

    async stopAll(): Promise<void> {
      const ids = [...this.sessions.keys()]
      await Promise.all(ids.map((id) => this.stop(id)))
    }

    /** @throws {never} */
    list(): PtySessionInfo[] {
      return [...this.sessions.values()].map((s) => ({ ...s.info }))
    }

    /** @throws {never} */
    has(sessionId: string): boolean {
      return this.sessions.has(sessionId)
    }

    /** @throws {never} */
    getBufferedOutput(sessionId: string): { readonly output: string; readonly bufferStartOffset: number; readonly totalChars: number } | undefined {
      const session = this.sessions.get(sessionId)
      return session && { output: session.outputBuffer, bufferStartOffset: session.bufferStartOffset, totalChars: session.totalOutputChars }
    }

    /** @throws {never} */
    readBoundedOutput(sessionId: string, opts: BoundedOutputOptions = {}): BoundedOutputResult | undefined {
      const session = this.sessions.get(sessionId)
      if (!session) return undefined
      const requestedCursor = opts.cursor ?? 0
      const clampedCursor = Math.max(0, Math.min(requestedCursor, session.totalOutputChars))
      const sliceIndex = Math.max(0, clampedCursor - session.bufferStartOffset)
      const delta = session.outputBuffer.slice(sliceIndex)
      const bounded = formatBoundedTail(delta, opts.maxChars ?? 16_000, opts.maxLines ?? 250)
      const droppedFromScrollback = charsLostFromScrollback(clampedCursor, session.bufferStartOffset)
      const omittedChars = bounded.omittedChars + droppedFromScrollback
      const body = bounded.truncated ? bounded.text.slice(bounded.text.indexOf("\n") + 1) : bounded.text
      return {
        sessionId,
        output: omittedChars > 0 ? `[Truncated ${omittedChars} earlier chars]\n${body}` : body,
        cursor: session.totalOutputChars,
        totalChars: session.totalOutputChars,
        truncated: omittedChars > 0,
        omittedChars,
        exited: session.info.exited,
        exitCode: session.info.exitCode,
      }
    }

    async sendAndWait(sessionId: string, input: string, opts: SendAndWaitOptions = {}): Promise<SendAndWaitResult | undefined> {
      const session = this.sessions.get(sessionId)
      if (!session) return undefined
      let matcher: RegExp | undefined
      if (opts.pattern) {
        try {
          matcher = new RegExp(opts.pattern, "u")
        } catch (cause) {
          throw new ElizaError(`Invalid PTY wait pattern "${opts.pattern}".`, {
            code: "PTY_INVALID_PATTERN",
            cause,
            context: { sessionId, pattern: opts.pattern },
          })
        }
      }
      const startCursor = session.totalOutputChars
      if (input.length > 0) {
        this.write(sessionId, input)
      }
      const waitMs = clampWaitMs(Math.floor(opts.waitMs ?? 1_500))
      const idleMs = Math.max(10, Math.min(waitMs, opts.idleMs ?? 200))
      if (session.info.exited) {
        const current = this.readBoundedOutput(sessionId, { cursor: startCursor, maxChars: opts.maxChars, maxLines: opts.maxLines })
        if (!current) return undefined
        return { ...current, matched: matcher ? matcher.test(current.output) : true, timedOut: false }
      }
      const outcome = await new Promise<{ matched: boolean; timedOut: boolean }>((resolve) => {
        let settled = false
        let idleTimer: PtyTimerHandle | undefined
        let deadlineTimer: PtyTimerHandle | undefined
        const finish = (matched: boolean, timedOut: boolean) => {
          if (settled) return
          settled = true
          idleTimer?.cancel()
          deadlineTimer?.cancel()
          this.bridge.off("session_output", onOutput)
          this.bridge.off("session_exit", onExit)
          resolve({ matched, timedOut })
        }
        const readDelta = () => {
          const live = this.sessions.get(sessionId)
          if (!live) return ""
          const sliceIndex = Math.max(0, startCursor - live.bufferStartOffset)
          return live.outputBuffer.slice(sliceIndex)
        }
        const resetIdle = () => {
          idleTimer?.cancel()
          idleTimer = this.scheduleTimer(idleMs, () => {
            finish(matcher ? matcher.test(readDelta()) : true, false)
          })
        }
        const onOutput = (evt: unknown) => {
          const payload = evt as SessionOutputEvent
          if (payload.sessionId !== sessionId) return
          if (matcher && matcher.test(readDelta())) {
            finish(true, false)
            return
          }
          if (!matcher) resetIdle()
        }
        const onExit = (evt: unknown) => {
          const payload = evt as SessionExitEvent
          if (payload.sessionId !== sessionId) return
          finish(matcher ? matcher.test(readDelta()) : true, false)
        }
        this.bridge.on("session_output", onOutput)
        this.bridge.on("session_exit", onExit)
        deadlineTimer = this.scheduleTimer(waitMs, () => {
          finish(matcher ? matcher.test(readDelta()) : false, true)
        })
        if (!matcher && session.totalOutputChars > startCursor) {
          resetIdle()
        }
      })
      const snapshot = this.readBoundedOutput(sessionId, {
        cursor: startCursor,
        maxChars: opts.maxChars,
        maxLines: opts.maxLines,
      })
      if (!snapshot) return undefined
      return { ...snapshot, ...outcome }
    }

    private appendBufferedOutput(sessionId: string, data: string): void {
      if (!data) return
      const session = this.sessions.get(sessionId)
      if (!session) return
      session.totalOutputChars += data.length
      const next = session.outputBuffer + data
      if (next.length > DEFAULT_OUTPUT_BUFFER_CHARS) {
        const drop = next.length - DEFAULT_OUTPUT_BUFFER_CHARS
        session.outputBuffer = next.slice(drop)
        session.bufferStartOffset += drop
      } else {
        session.outputBuffer = next
      }
    }

    private handleExit(sessionId: string, exitCode: number | null): void {
      const session = this.sessions.get(sessionId)
      if (!session) return
      session.idleTimer?.cancel()
      session.info.exited = true
      session.info.exitCode = exitCode
      if (canExitPoolSession(this.poolState, sessionId)) {
        this.poolState = exitPoolSession(this.poolState, sessionId)
      }
      for (const waiter of session.exitWaiters.splice(0)) waiter()
      this.bridge.emitExit(sessionId, exitCode)
      logger.info(`[plugin-pty] session ${sessionId} exited (code=${exitCode ?? "null"})`)
      session.reapTimer = this.scheduleTimer(this.exitedSessionTtlMs, () => {
        const still = this.sessions.get(sessionId)
        if (!still) return
        for (const disposer of still.disposers) {
          try {
            disposer.dispose()
          } catch {
            void 0
          }
        }
        still.idleTimer?.cancel()
        if (canReapPoolSession(this.poolState, sessionId)) {
          this.poolState = reapPoolSession(this.poolState, sessionId)
        }
        this.sessions.delete(sessionId)
      })
    }

    private touch(sessionId: string): void {
      const session = this.sessions.get(sessionId)
      if (!session || session.info.exited) return
      session.lastActivityAt = Date.now()
      this.scheduleIdleReap(sessionId)
    }

    private scheduleIdleReap(sessionId: string): void {
      const session = this.sessions.get(sessionId)
      if (!session || session.info.exited) return
      session.idleTimer?.cancel()
      const timeout = this.idleTimeoutMs
      if (!Number.isFinite(timeout) || timeout <= 0) return
      session.idleTimer = this.scheduleTimer(timeout, () => {
        const current = this.sessions.get(sessionId)
        if (!current || current.info.exited) return
        if (Date.now() - current.lastActivityAt < timeout) {
          this.scheduleIdleReap(sessionId)
          return
        }
        logger.warn(`[plugin-pty] idle timeout reached for session ${sessionId}; stopping orphaned PTY`)
        void this.stop(sessionId).catch((error) => {
          logger.warn(`[plugin-pty] idle stop of session ${sessionId} failed: ${String(error)}`)
          this.scheduleIdleReap(sessionId)
        })
      })
    }
  }
}

import { defaultSpawnResolver, PtyConsoleBridge, PtySessionStore } from node
export { defaultSpawnResolver, PtyConsoleBridge, PtySessionStore }
