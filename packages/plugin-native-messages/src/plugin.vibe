  description: "Android Messages overlay: read SMS conversations and compose text messages through the native SMS bridge.",
  connectorSources: [
    {
      source: "sms",
      aliases: ["sms"],
      sourceKind: "passive",
      isPassive: true,
    },
  ],
  views: [
    {
      id: "messages",
      label: "Messages",
      description: "SMS conversations via the Android Messages bridge",
      path: "/messages",
      modalities: ["gui"],
      roleGate: { minRole: "ADMIN" },
    },
  ],
}
