function shouldEnableSlack(
  _env: Record<string, string | undefined>,
  config: Record<string, unknown>,
): boolean {
  const connector = (config.connectors as Record<string, unknown> | undefined)?.slack
  if (!connector || typeof connector !== "object") return false
  return (connector as Record<string, unknown>).enabled !== false
}

export const slackPlugin: Plugin = {
  name: "@elizaos/plugin-slack",
  description: "Slack integration plugin for ElizaOS with Socket Mode support",
  connectorSources: [
    {
      source: "slack",
      aliases: ["slack"],
      sourceKind: "passive",
      isPassive: true,
    },
  ],
  services: [SlackService],
  actions: [],
  providers: [],
  autoEnable: {
    connectorKeys: ["slack"],
    shouldEnable: shouldEnableSlack,
  },
  init: async (_config: Record<string, string>, runtime: IAgentRuntime): Promise<void> => {
    try {
      const manager = getConnectorAccountManager(runtime)
      manager.registerProvider(createSlackConnectorAccountProvider(runtime))
    } catch (err) {
      logger.warn(
        {
          src: "plugin:slack",
          err: err instanceof Error ? err.message : String(err),
        },
        "Failed to register Slack provider with ConnectorAccountManager",
      )
    }
  },
  dispose: async (runtime: IAgentRuntime): Promise<void> => {
    const svc = runtime.getService<SlackService>(SlackService.serviceType)
    await svc?.stop()
  },
}

export default slackPlugin
