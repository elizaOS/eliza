    {
      "name": "cancellation-turn-scoped",
      "case": "cancellation: scope=turn only cancels the matching turn; the other turn keeps flowing",
      "events": [
        {
          "type": "stt.partial",
          "seq": 1,
          "turnId": "tA",
          "text": "a in flight"
        },
        {
          "type": "stt.partial",
          "seq": 2,
