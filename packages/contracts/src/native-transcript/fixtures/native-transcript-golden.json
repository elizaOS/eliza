    {
      "name": "cancellation-boundary-all",
      "case": "cancellation: scope=all cancels in-flight items, drops a pre-boundary straggler, applies a post-boundary continuation",
      "events": [
        { "type": "stt.partial", "seq": 10, "turnId": "t1", "text": "start" },
        {
          "type": "agent.text",
          "seq": 11,
          "messageId": "m1",
          "turnId": "t1",
          "text": "thinking",
          "final": false
        },
        {
          "type": "tool.state",
          "seq": 12,
          "callId": "c1",
          "name": "search",
          "phase": "started",
          "turnId": "t1"
        },
        {
          "type": "tts.audio",
          "seq": 13,
          "utteranceId": "u1",
          "phase": "started",
          "messageId": "m1"
        },
        {
          "type": "cancel",
          "seq": 20,
          "scope": "all",
          "reason": "user-barge-in"
        },
        {
          "type": "agent.text",
          "seq": 15,
          "messageId": "m1",
          "turnId": "t1",
          "text": "late chunk",
          "final": false
