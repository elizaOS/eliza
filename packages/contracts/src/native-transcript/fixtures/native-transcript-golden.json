    {
      "name": "speaking-active",
      "case": "TTS/audio: playback in progress is transient view state (speaking indicator), not a row",
      "events": [
        {
          "type": "agent.text",
          "seq": 1,
          "messageId": "m1",
          "text": "hello",
          "final": true
