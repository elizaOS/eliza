{
  "name": "@elizaos/contracts",
  "version": "2.0.3-beta.7",
  "description": "Browser-safe shared domain contracts and validation for Eliza hosts, plugins and renderers.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "eliza-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./device-action-execution": {
      "eliza-source": "./src/device-action-execution.ts",
      "types": "./dist/device-action-execution.d.ts",
      "import": "./dist/device-action-execution.js",
      "default": "./dist/device-action-execution.js"
    },
    "./phone-workflow": {
      "eliza-source": "./src/phone-workflow.ts",
      "types": "./dist/phone-workflow.d.ts",
      "import": "./dist/phone-workflow.js",
      "default": "./dist/phone-workflow.js"
    },
    "./notice-routes": {
      "eliza-source": "./src/notice-routes.ts",
      "types": "./dist/notice-routes.d.ts",
      "import": "./dist/notice-routes.js",
      "default": "./dist/notice-routes.js"
    },
    "./native-notes-query": {
      "eliza-source": "./src/native-notes-query.ts",
      "types": "./dist/native-notes-query.d.ts",
      "import": "./dist/native-notes-query.js",
      "default": "./dist/native-notes-query.js"
    },
    "./calendar-linked-sync": {
      "eliza-source": "./src/calendar-linked-sync.ts",
      "types": "./dist/calendar-linked-sync.d.ts",
      "import": "./dist/calendar-linked-sync.js",
      "default": "./dist/calendar-linked-sync.js"
    },
    "./imessage-reaction": {
      "eliza-source": "./src/imessage-reaction.ts",
      "types": "./dist/imessage-reaction.d.ts",
      "import": "./dist/imessage-reaction.js",
      "default": "./dist/imessage-reaction.js"
    }
  },
  "scripts": {
    "build": "tsc6 --noCheck -p tsconfig.emit.json && node ../scripts/rewrite-dist-relative-imports-node-esm.ts packages/contracts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:check": "bunx @biomejs/biome check src",
    "lint": "bunx @biomejs/biome check --write src",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "elizaos": {
    "scripts": {
      "buildOnInstall": {},
      "testLanes": [
        "server"
      ]
    }
  }
}
