// spec/webSearch/index.md, "Story: Search the web through my selected profile"; spec/webSearch/edge.md, "Provider outages stay distinct from zero-hit searches and prompt projections stay bounded"

export type SearchResult = {
  title: string
  url: string
  description: string
  content: string
  rawContent?: string
  score: number
  publishedDate?: Date
}

export type SearchImage = {
  url: string
  description?: string
}

export type SearchResponse = {
  answer?: string
  query: string
  responseTime?: number
  images: SearchImage[]
  results: SearchResult[]
  browser?: { targetId: string; profileId: string; tabId: string; url: string }
}

export interface SearchOptions {
  offset?: number
  limit?: number
  type?: "news" | "general"
  topic?: "news" | "general"
  includeAnswer?: boolean
  searchDepth?: "basic" | "advanced"
  includeImages?: boolean
  days?: number
}

export interface CompactSearchSnippet {
  readonly url: string
  readonly title?: string
  readonly snippet: string
}

export interface CompactSearchDigest {
  readonly provider: string
  readonly query: string
  readonly count: number
  readonly totalUrls: number
  readonly truncated: boolean
  readonly results: readonly CompactSearchSnippet[]
}
