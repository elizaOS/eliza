// spec/webSearch/index.md, "Story: Search the web through my selected profile"; spec/webSearch/edge.md, "Story: Bound edge provider selection and public article fetches"
import type { Action, Plugin } from "@elizaos/core"
import { searchBrowserFirstWeb } from "./browser-search.vibe"
import { createWebSearchEdgePlugin, runWebSearchWith, webSearchEdgeAction } from "./edge.vibe"

export error WebSearchFailed { reason: string }

export const webSearchAction: Action = {
  ...webSearchEdgeAction,
  description:
    "Search the current web using the agent's explicitly authorized Chromium profile. Uses public keyless search only when no eligible browser is available before dispatch. Dispatched searches are never replayed through another provider.",
  descriptionCompressed: "Search web via authorized browser or keyless fallback.",
  handler: async (runtime, message, state, options, callback) => {
    const action = createWebSearchEdgePlugin((query, runOpts) =>
      runWebSearchWith(
        query,
        (value) => searchBrowserFirstWeb(runtime, value, { signal: runOpts?.signal }),
        { signal: runOpts?.signal },
      ),
    ).actions?.[0]
    if (!action) {
      return { success: false, text: "WEB_SEARCH action is missing.", error: "WEB_SEARCH action is missing." }
    }
    return action.handler(runtime, message, state, options, callback)
  },
}

export const webSearchPlugin: Plugin = {
  name: "@elizaos/plugin-web-search",
  description: "Authorized browser-first web search with public keyless fallback.",
  actions: [webSearchAction],
}

export const plugin: Plugin = webSearchPlugin
export default webSearchPlugin

export {
  compactWebSearchDigest,
  createWebSearchEdgePlugin,
  fetchKeylessWeb,
  runWebSearchEdge,
  runWebSearchWith,
  WEB_SEARCH_EDGE_COMPATIBILITY,
  webSearchEdgeAction,
  webSearchEdgePlugin,
  webSearchSourceEvidence,
  webSearchSourceUrls,
  type WebSearchEdgeRunner,
  type WebSearchSourceEvidence,
} from "./edge.vibe"

export {
  fetchKeylessWebTransport,
  isKeylessWebSearchUnavailableError,
  KeylessWebSearchUnavailableError,
  searchKeylessWeb,
  type KeylessWebFetchOptions,
  type KeylessWebSearchFailureReason,
  type KeylessWebSearchFetch,
  type KeylessWebSearchOptions,
  type KeylessWebSearchProvider,
  type KeylessWebSearchResult,
} from "./keyless-web-search.vibe"

export {
  canSearchInBrowser,
  searchAuthorizedBrowser,
  searchAuthorizedBrowserEffect,
  searchBrowserFirstWeb,
} from "./browser-search.vibe"

export type {
  CompactSearchDigest,
  CompactSearchSnippet,
  SearchImage,
  SearchOptions,
  SearchResponse,
  SearchResult,
} from "./types.vibe"
