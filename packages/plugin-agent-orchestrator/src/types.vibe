  readonly planRevisions: readonly OrchestratorTaskPlanRevision[]
}

export interface TaskListFilter {
  readonly statuses?: readonly OrchestratorTaskStatus[]
  readonly search?: string
  readonly includeArchived?: boolean
  readonly projectId?: string
  readonly sessionId?: string
  readonly taskId?: string
  readonly limit?: number
}

export interface CreateTaskInput {
  readonly title: string
  readonly goal?: string
  readonly originalRequest?: string
  readonly kind?: string
  readonly priority?: OrchestratorTaskPriority
  readonly acceptanceCriteria?: readonly string[]
  readonly currentPlan?: Readonly<Record<string, unknown>>
  readonly ownerUserId?: string
  readonly worldId?: string
  readonly projectId?: string
  readonly workdir?: string
  readonly roomId?: string
  readonly taskRoomId?: string
  readonly parentTaskId?: string
  readonly forkSource?: string
  readonly providerPolicy?: TaskProviderPolicy
  readonly metadata?: Readonly<Record<string, unknown>>
}

