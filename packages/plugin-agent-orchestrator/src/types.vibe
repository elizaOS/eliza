  readonly mode: "head" | "tail"
}

export interface BuiltAppRecord {
  readonly target: "custom" | "eliza-cloud"
  readonly slug: string
  readonly title: string
  readonly url: string
  readonly workdir?: string
  readonly taskId?: string
  readonly createdAt: string
}

export interface ChildSession {
  readonly childId: string
  readonly sessionId: string
  readonly label: string
  readonly running: boolean
}

export error ChildSessionFailure { childId: string; reason: string }
export error SessionCapError { activeWorkers: number; maxWorkers: number; reason: string }
export error AdmissionQueueFullError { queuedCount: number; maxQueue: number; reason: string }
export error RecoveryConflictError { taskId: string; reason: string }
export error WaveConcurrencyCapError { waveId: string; activeLanes: number; maxParallel: number }
export error WaveBudgetBreachError { waveId: string; spentCents: number; budgetCapCents: number }
export error DiffGateBlockedError { workdir: string; reasons: readonly string[] }
export error SsrfBlockedError { url: string; reason: string }
export error UnsafeGitRemoteError { remote: string; reason: string }
export error UnsafeGitRefError { ref: string; reason: string }
export error SubscriptionCodingAdapterError { adapterId: string; code: string; reason: string }
export error WorkspaceOperationError { workspaceId: string; code: string; reason: string }
export error TaskLifecycleError { taskId: string; code: string; reason: string }

export function toSpecTaskStatus(status: OrchestratorTaskStatus): TaskStatus {
  switch (status) {
    case "open": return "TaskOpen"
    case "active": return "TaskActive"
    case "waiting_on_user": return "TaskWaitingOnUser"
    case "blocked": return "TaskBlocked"
    case "validating": return "TaskValidating"
    case "done": return "TaskDone"
    case "failed": return "TaskFailed"
    case "archived": return "TaskArchived"
    case "interrupted": return "TaskInterrupted"
  }
}

export function fromSpecTaskStatus(status: TaskStatus): OrchestratorTaskStatus {
  switch (status) {
    case "TaskOpen": return "open"
    case "TaskActive": return "active"
    case "TaskWaitingOnUser": return "waiting_on_user"
    case "TaskBlocked": return "blocked"
    case "TaskValidating": return "validating"
    case "TaskDone": return "done"
    case "TaskFailed": return "failed"
    case "TaskArchived": return "archived"
    case "TaskInterrupted": return "interrupted"
  }
}

export function toSpecTaskRole(role: TaskCompletionRole): TaskRole {
  return role === "coordinator" ? "CoordinatorRole" : "ContributorRole"
}

export function toSpecPriority(priority: OrchestratorTaskPriority): PriorityLevel {
  switch (priority) {
    case "low": return "PriorityLow"
    case "normal": return "PriorityNormal"
    case "high": return "PriorityHigh"
    case "urgent": return "PriorityUrgent"
  }
}

export function toSpecSessionSlotStatus(status: SessionStatus): SessionSlotStatus {
  switch (status) {
    case "running": return "SlotRunning"
    case "ready": return "SlotReady"
    case "busy": return "SlotBusy"
    case "blocked": return "SlotBlocked"
    case "authenticating": return "SlotAuthenticating"
    case "tool_running": return "SlotToolRunning"
    case "completed": return "SlotCompleted"
    case "stopped": return "SlotStopped"
    case "errored": return "SlotErrored"
    case "cancelled": return "SlotCancelled"
  }
}

export function toSpecBackendId(adapter: string | undefined): BackendId {
  switch (adapter?.trim().toLowerCase()) {
    case "elizaos": return "BackendElizaOs"
    case "pi-agent": return "BackendPiAgent"
    case "claude": return "BackendClaude"
    case "codex": return "BackendCodex"
    case "kimi": return "BackendKimi"
    case "grok": return "BackendGrok"
    default: return "BackendNone"
  }
}

export function fromSpecBackendId(id: BackendId): KnownAdapterId | undefined {
  switch (id) {
    case "BackendElizaOs": return "elizaos"
    case "BackendPiAgent": return "pi-agent"
    case "BackendClaude": return "claude"
    case "BackendCodex": return "codex"
    case "BackendKimi": return "kimi"
    case "BackendGrok": return "grok"
    case "BackendNone": return undefined
  }
}

export type { TaskLifecycle, AdmissionPool }
