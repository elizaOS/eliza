export const orchestratorContext: ContextDefinition = {
  id: "code",
  label: "Coding Orchestration",
  description: "Spawns and coordinates coding subagents, workspaces, and verification gates.",
  descriptionCompressed: "Coding subagent orchestration.",
  sensitivity: "personal",
  cacheStable: true,
  cacheScope: "agent",
}

const runtimeCleanups = new WeakMap<object, Array<() => void>>()

export function createAgentOrchestratorPlugin(opts?: {
  readonly localCodeExecutionAllowed?: boolean
  readonly env?: Readonly<Record<string, string | undefined>>
}): Plugin {
  const localAllowed = opts?.localCodeExecutionAllowed !== false
  const terminalSupport = detectOrchestratorTerminalSupport(opts?.env)
  const enabled = localAllowed && terminalSupport.supported
  if (!enabled) {
    return {
      name: "@elizaos/plugin-agent-orchestrator",
      description: "Coding agent orchestration (disabled on unsupported host/sandbox).",
      actions: [localAllowed ? createTerminalUnsupportedTasksAction(terminalSupport) : tasksSandboxStubAction],
      providers: [],
      services: [],
    }
  }
  return {
    name: "@elizaos/plugin-agent-orchestrator",
    description: "Canonical ElizaOS plugin for spawning and orchestrating ACP coding subagents (elizaos, pi-agent, claude, codex, kimi, grok) with verified lifecycles, parallel lanes, workspaces, and Cerebras fast evaluation.",
    services: [
      AcpService,
      OrchestratorTaskService,
      SubAgentRouter,
      CodingWorkspaceService,
      TaskSupervisorService,
      TaskWatchdogService,
      WaveSupervisor,
      SwarmCoordinatorService,
    ],
    actions: buildPromotedTaskActions(),
    providers: [
      availableAgentsProvider,
      activeSubAgentsProvider,
      activeWorkspaceContextProvider,
      codingAgentExamplesProvider,
      codingSessionChangesProvider,
    ],
    responseHandlerEvaluators: [
      subAgentCompletionResponseEvaluator,
      subAgentFailureResponseEvaluator,
    ],
    widgets: [...AGENT_ORCHESTRATOR_WIDGET_DECLARATIONS],
    views: [...ORCHESTRATOR_VIEW_DECLARATIONS],
    init: async (_config, runtime: IAgentRuntime) => {
      runtime.contexts.tryRegister(orchestratorContext)
      const cleanups: Array<() => void> = []
      const inbox = new SubAgentInbox()
      cleanups.push(() => inbox.clearAll())
      const auditPath = typeof runtime.getSetting === "function"
        ? (typeof runtime.getSetting("ACP_AUDIT_LOG_PATH") === "string" ? String(runtime.getSetting("ACP_AUDIT_LOG_PATH")) : defaultAuditLogPath())
        : defaultAuditLogPath()
      const rtEvents = runtime as unknown as {
        registerEvent?: (event: string, handler: (payload: unknown) => Promise<void>) => void
      }
      if (typeof rtEvents.registerEvent === "function") {
        rtEvents.registerEvent(TASK_AUDIT_EVENT, async (payload: unknown) => {
          const rec = typeof payload === "object" && payload !== null ? payload as Record<string, unknown> : {}
          await runPromise(appendAuditLine(auditPath, {
            action: typeof rec.action === "string" ? rec.action : "audit",
            taskId: typeof rec.taskId === "string" ? rec.taskId : undefined,
            sessionId: typeof rec.sessionId === "string" ? rec.sessionId : undefined,
            actor: typeof rec.actor === "string" ? rec.actor : undefined,
            outcome: typeof rec.outcome === "string" ? rec.outcome : "ok",
            timestamp: typeof rec.timestamp === "string" ? rec.timestamp : new Date().toISOString(),
          }))
        })
      }
      const acpSvc: unknown = runtime.getService(ACP_SUBPROCESS_SERVICE_TYPE)
      if (acpSvc instanceof AcpService) {
        const unsub = acpSvc.onSessionEvent((sessionId, event) => {
          if (event === "task_complete" || event === "ready" || event === "reconnected") {
            const queued = inbox.drain(sessionId)
            for (const msg of queued) {
              void acpSvc.sendToSession(sessionId, msg)
            }
          }
        })
        cleanups.push(unsub)
      }
      runtimeCleanups.set(runtime, cleanups)
    },
    dispose: async (runtime: IAgentRuntime) => {
      for (const fn of runtimeCleanups.get(runtime) ?? []) fn()
      runtimeCleanups.delete(runtime)
      const serviceTypes = [
        ACP_SUBPROCESS_SERVICE_TYPE,
        ORCHESTRATOR_TASK_SERVICE_TYPE,
        SUB_AGENT_ROUTER_SERVICE_TYPE,
        CODING_WORKSPACE_SERVICE_TYPE,
        TASK_SUPERVISOR_SERVICE_TYPE,
        TASK_WATCHDOG_SERVICE_TYPE,
        WAVE_SUPERVISOR_SERVICE_TYPE,
        SWARM_COORDINATOR_SERVICE_TYPE,
      ]
      for (const serviceType of serviceTypes) {
        const svc = runtime.getService(serviceType) as { stop?: () => Promise<void> } | null | undefined
        if (svc && typeof svc.stop === "function") await svc.stop()
      }
    },
    autoEnable: {
      envKeys: ["ELIZA_ACP_DEFAULT_AGENT", "ELIZA_PI_AGENT_ACP_COMMAND", "CEREBRAS_API_KEY"],
      shouldEnable: (env) => detectOrchestratorTerminalSupport(env).supported,
    },
  }
}

export const agentOrchestratorPlugin: Plugin = createAgentOrchestratorPlugin()
export default agentOrchestratorPlugin

