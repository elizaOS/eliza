// spec/agentOrchestrator/index.md, "Story: Direct an authorized task to the intended subagent and evaluate its result"; spec/agentOrchestrator/taskLifecycle.md, "Story: Track an orchestrated coding task from creation through verified completion"
import type { IAgentRuntime, PluginWidgetDeclaration, ViewDeclaration } from "@elizaos/core"
import {
  ACP_SUBPROCESS_SERVICE_TYPE,
  AcpService,
  isSessionTerminal,
} from "./acp.vibe"
import {
  ORCHESTRATOR_TASK_SERVICE_TYPE,
  OrchestratorTaskService,
  buildOrchestratorWidgetSnapshot,
  summarizeUsageRows,
  toTaskThread,
} from "./tasks-service.vibe"
import {
  CODING_WORKSPACE_SERVICE_TYPE,
  CodingWorkspaceService,
} from "./workspace.vibe"
import {
  deleteBuiltApp,
  listBuiltApps,
} from "./verification.vibe"
import {
  buildOrchestratorDeviceSupportMatrix,
  ORDERED_ADAPTER_IDS,
  probeAvailableAdapters,
  resolveCodingBackend,
} from "./adapters.vibe"
import {
  isLoopbackRemoteAddress,
  resolveAllowedWorkdir,
  resolveServerAllowedWorkdirRoots,
  verifySessionBridgeToken,
} from "./security.vibe"
import {
  SUBSCRIPTION_EXECUTION_AUTHORIZATION_METADATA_KEY,
  type ApprovalPreset,
  type CreateTaskInput,
  type OrchestratorTaskPriority,
} from "./types.vibe"

export interface OrchestratorRouteRequest {
  readonly method: string
  readonly path: string
  readonly query?: Readonly<Record<string, string | undefined>>
  readonly headers?: Readonly<Record<string, string | undefined>>
  readonly body?: unknown
  readonly remoteAddress?: string
}

export interface OrchestratorRouteResponse {
  readonly status: number
  readonly body: unknown
  readonly headers?: Readonly<Record<string, string>>
}

export const CODING_AGENT_ROUTE_PATHS: readonly string[] = [
  "/api/orchestrator/built-apps",
  "/api/orchestrator/status",
  "/api/orchestrator/capacity",
  "/api/orchestrator/accounts",
  "/api/orchestrator/accounts/readiness",
  "/api/orchestrator/rooms",
  "/api/orchestrator/widgets",
  "/api/orchestrator/pause-all",
  "/api/orchestrator/resume-all",
  "/api/orchestrator/tasks",
  "/api/coding-agents",
  "/api/coding-agents/spawn",
  "/api/coding-agents/metrics",
  "/api/coding-agents/settings",
  "/api/coding-agents/approval-presets",
  "/api/coding-agents/approval-config",
  "/api/workspace/provision",
  "/api/issues",
]

export const AGENT_ORCHESTRATOR_WIDGET_DECLARATIONS: readonly PluginWidgetDeclaration[] = [
  { id: "agent-orchestrator.apps", pluginId: "agent-orchestrator", slot: "chat-sidebar", label: "App Runs", icon: "Activity", order: 150, defaultEnabled: true },
  { id: "agent-orchestrator.accounts", pluginId: "agent-orchestrator", slot: "chat-sidebar", label: "Coding accounts", icon: "Zap", order: 250, defaultEnabled: true },
  { id: "agent-orchestrator.activity", pluginId: "agent-orchestrator", slot: "chat-sidebar", label: "Activity", icon: "Activity", order: 300, defaultEnabled: true },
]

export const ORCHESTRATOR_VIEW_DECLARATIONS: readonly ViewDeclaration[] = [
  { id: "task-coordinator", label: "Task Coordinator", path: "/task-coordinator", viewKind: "preview", componentExport: "TaskCoordinatorView" },
  { id: "orchestrator", label: "Orchestrator", path: "/orchestrator", viewKind: "developer", componentExport: "OrchestratorView" },
  { id: "cockpit", label: "Cockpit", path: "/cockpit", viewKind: "developer", componentExport: "CockpitRoute" },
]

export const ORCHESTRATOR_CAPABILITY_AUTHORITY: Readonly<Record<string, "agent-callable" | "human-only">> = {
  "list-sessions": "agent-callable",
  "list-task-threads": "agent-callable",
  "get-thread": "agent-callable",
  refresh: "agent-callable",
  "stop-session": "human-only",
  "orchestrator-status": "agent-callable",
  "orchestrator-list-tasks": "agent-callable",
  "orchestrator-get-task": "agent-callable",
  "orchestrator-create-task": "agent-callable",
  "orchestrator-send-message": "agent-callable",
  "orchestrator-pause-task": "human-only",
  "orchestrator-resume-task": "human-only",
  "orchestrator-pause-all": "human-only",
  "orchestrator-resume-all": "human-only",
  "orchestrator-delete-task": "human-only",
  "orchestrator-fork-task": "human-only",
  "orchestrator-update-task": "human-only",
  "orchestrator-validate-task": "human-only",
  "orchestrator-add-agent": "human-only",
  "orchestrator-stop-agent": "human-only",
  "cockpit-terminal-interrupt": "human-only",
  "cockpit-terminal-stop": "human-only",
  "cockpit-terminal-input": "human-only",
  "cockpit-terminal-send": "human-only",
}

function asObj(value: unknown): Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : {}
}

function getHeader(headers: Readonly<Record<string, string | undefined>> | undefined, name: string): string | undefined {
  if (!headers) return undefined
  const target = name.toLowerCase()
  for (const [k, v] of Object.entries(headers)) {
    if (k.toLowerCase() === target) return v
  }
  return undefined
}

function getServices(runtime: IAgentRuntime) {
  const acpRaw: unknown = runtime.getService(ACP_SUBPROCESS_SERVICE_TYPE)
  const taskRaw: unknown = runtime.getService(ORCHESTRATOR_TASK_SERVICE_TYPE)
  const wsRaw: unknown = runtime.getService(CODING_WORKSPACE_SERVICE_TYPE)
  return {
    acp: acpRaw instanceof AcpService ? acpRaw : undefined,
    tasks: taskRaw instanceof OrchestratorTaskService ? taskRaw : undefined,
    ws: wsRaw instanceof CodingWorkspaceService ? wsRaw : undefined,
  }
}

function authorizeBridge(
  acp: AcpService | undefined,
  sessionId: string,
  req: OrchestratorRouteRequest,
): { readonly ok: true } | { readonly ok: false; readonly response: OrchestratorRouteResponse } {
  if (!isLoopbackRemoteAddress(req.remoteAddress)) {
    return { ok: false, response: { status: 403, body: { error: "loopback_only" } } }
  }
  const session = acp?.getSession(sessionId)
  if (!session || isSessionTerminal(session.status)) {
    return { ok: false, response: { status: 410, body: { error: "session_not_active" } } }
  }
  const token = getHeader(req.headers, "x-eliza-session-token")
  if (!verifySessionBridgeToken(token, session.metadata)) {
    return { ok: false, response: { status: 401, body: { error: "unauthorized" } } }
  }
  return { ok: true }
}

function parsePriority(raw: unknown): OrchestratorTaskPriority | undefined {
  return raw === "low" || raw === "normal" || raw === "high" || raw === "urgent" ? raw : undefined
}

async function handleTaskItemRoutes(
  method: string,
  taskId: string,
  sub: string | undefined,
  subArg: string | undefined,
  subAction: string | undefined,
  req: OrchestratorRouteRequest,
  acp: AcpService | undefined,
  tasks: OrchestratorTaskService,
): Promise<OrchestratorRouteResponse | undefined> {
  if (!sub && method === "GET") {
    const doc = tasks.getTask(taskId)
    return doc ? { status: 200, body: doc } : { status: 404, body: { error: "not_found" } }
  }
  if (!sub && method === "PATCH") {
    const body = asObj(req.body)
    const updated = tasks.updateTask(taskId, {
      title: typeof body.title === "string" ? body.title : undefined,
      goal: typeof body.goal === "string" ? body.goal : undefined,
      summary: typeof body.summary === "string" ? body.summary : undefined,
      priority: parsePriority(body.priority),
      acceptanceCriteria: Array.isArray(body.acceptanceCriteria) ? body.acceptanceCriteria.filter((c): c is string => typeof c === "string") : undefined,
    })
    return updated ? { status: 200, body: updated } : { status: 404, body: { error: "not_found" } }
  }
  if (!sub && method === "DELETE") {
    return tasks.deleteTask(taskId) ? { status: 200, body: { deleted: true } } : { status: 404, body: { error: "not_found" } }
  }
  if (sub === "pause" && method === "POST") {
    const updated = await runPromise(effect { return tasks.pauseTaskEffect(taskId) catch () => undefined })
    return updated ? { status: 200, body: updated } : { status: 409, body: { error: "cannot_pause" } }
  }
  if (sub === "resume" && method === "POST") {
    const updated = await runPromise(effect { return tasks.resumeTaskEffect(taskId) catch () => undefined })
    return updated ? { status: 200, body: updated } : { status: 409, body: { error: "cannot_resume" } }
  }
  if (sub === "archive" && method === "POST") {
    const updated = await runPromise(effect { return tasks.archiveTaskEffect(taskId) catch () => undefined })
    return updated ? { status: 200, body: updated } : { status: 409, body: { error: "cannot_archive" } }
  }
  if (sub === "reopen" && method === "POST") {
    const updated = await runPromise(effect { return tasks.reopenTaskEffect(taskId) catch () => undefined })
    return updated ? { status: 200, body: updated } : { status: 409, body: { error: "cannot_reopen" } }
  }
  if (sub === "restart" && method === "POST") {
    const updated = await runPromise(effect { return tasks.restartTaskEffect(taskId) catch () => undefined })
    return updated ? { status: 201, body: updated } : { status: 409, body: { error: "cannot_restart" } }
  }
  if (sub === "fork" && method === "POST") {
    const forked = tasks.forkTask(taskId)
    return forked ? { status: 201, body: forked } : { status: 404, body: { error: "not_found" } }
  }
  if (sub === "validate" && method === "POST") {
    const body = asObj(req.body)
    if (typeof body.passed !== "boolean") return { status: 400, body: { error: "passed boolean required" } }
    const updated = await runPromise(effect {
      return tasks.validateTaskEffect(taskId, {
        passed: body.passed as boolean,
        summary: typeof body.summary === "string" ? body.summary : undefined,
        evidence: typeof body.evidence === "string" ? body.evidence : undefined,
        verifier: typeof body.verifier === "string" ? body.verifier : undefined,
        humanOverride: body.humanOverride === true,
      }) catch () => undefined
    })
    return updated ? { status: 200, body: updated } : { status: 409, body: { error: "validation_rejected" } }
  }
  if (sub === "auto-validate" && method === "POST") {
    const body = asObj(req.body)
    const outcome = await runPromise(effect {
      return tasks.autoValidateTaskEffect(taskId, {
        changedFiles: Array.isArray(body.changedFiles) ? body.changedFiles.filter((f): f is string => typeof f === "string") : [],
        diffExcerpt: typeof body.diffExcerpt === "string" ? body.diffExcerpt : "",
        testSummary: typeof body.testSummary === "string" ? body.testSummary : "",
      }) catch () => undefined
    })
    return outcome ? { status: 200, body: outcome } : { status: 409, body: { error: "auto_validate_rejected" } }
  }
  const doc = tasks.getTask(taskId)
  if (!doc) return { status: 404, body: { error: "not_found" } }
  if (sub === "plan-revisions" && method === "GET") return { status: 200, body: { items: doc.planRevisions } }
  if (sub === "plan-revisions" && method === "POST") {
    const body = asObj(req.body)
    const rev = tasks.createPlanRevision(taskId, {
      plan: asObj(body.plan),
      basePlanRevisionId: typeof body.basePlanRevisionId === "string" ? body.basePlanRevisionId : undefined,
      editSummary: typeof body.editSummary === "string" ? body.editSummary : undefined,
    })
    return rev ? { status: 201, body: rev } : { status: 404, body: { error: "not_found" } }
  }
  if (sub === "messages" && method === "GET") return { status: 200, body: { items: doc.messages } }
  if (sub === "messages" && method === "POST") {
    const body = asObj(req.body)
    if (typeof body.content !== "string" || !body.content.trim()) return { status: 400, body: { error: "content required" } }
    const msg = tasks.addMessage(taskId, { senderKind: "user", direction: "stdin", content: body.content })
    return msg ? { status: 201, body: msg } : { status: 404, body: { error: "not_found" } }
  }
  if (sub === "events" && method === "GET") return { status: 200, body: { items: doc.events } }
  if (sub === "timeline" && method === "GET") {
    const items = [
      ...doc.events.map((e) => ({ kind: "event", id: e.id, createdAt: e.createdAt, summary: e.summary })),
      ...doc.messages.map((m) => ({ kind: "message", id: m.id, createdAt: m.createdAt, content: m.content })),
    ].sort((a, b) => a.createdAt.localeCompare(b.createdAt))
    return { status: 200, body: { items } }
  }
  if (sub === "usage" && method === "GET") {
    return { status: 200, body: { summary: summarizeUsageRows(doc.usage), rows: doc.usage } }
  }
  if (sub === "agents" && !subArg && method === "POST") {
    if (!acp) return { status: 503, body: { error: "acp_unavailable" } }
    const body = asObj(req.body)
    const rawWorkdir = typeof body.workdir === "string" ? body.workdir : (doc.task.boundWorkdir ?? "")
    const workdir = await runPromise(effect { return resolveAllowedWorkdir(rawWorkdir, resolveServerAllowedWorkdirRoots(), true) catch () => undefined })
    if (!workdir) return { status: 403, body: { error: "workdir_forbidden" } }
    const spawned = await runPromise(effect {
      return acp.spawnSessionEffect({
        agentType: typeof body.framework === "string" ? body.framework : undefined,
        workdir,
        task: typeof body.task === "string" ? body.task : doc.task.goal,
        label: typeof body.label === "string" ? body.label : undefined,
        model: typeof body.model === "string" ? body.model : undefined,
        taskId,
      }) catch () => undefined
    })
    if (!spawned) return { status: 429, body: { error: "admission_queue_full" } }
    const updated = spawned.queued
      ? doc
      : (tasks.attachSession(taskId, {
          id: spawned.sessionId,
          agentType: spawned.agentType,
          label: spawned.label,
          status: spawned.status,
          workdir: spawned.workdir,
        }) ?? doc)
    return { status: spawned.queued ? 202 : 201, body: updated }
  }
  if (sub === "agents" && subArg && subAction === "stop" && method === "POST") {
    if (!acp) return { status: 503, body: { error: "acp_unavailable" } }
    const stopped = await acp.stopSession(subArg)
    return stopped ? { status: 200, body: { stopped: true } } : { status: 404, body: { error: "not_found" } }
  }
  return undefined
}

async function handleOrchestratorSubroutes(
  method: string,
  pathname: string,
  req: OrchestratorRouteRequest,
  acp: AcpService | undefined,
  tasks: OrchestratorTaskService | undefined,
): Promise<OrchestratorRouteResponse | undefined> {
  if (method === "GET" && pathname === "/api/orchestrator/built-apps") {
    return { status: 200, body: { apps: listBuiltApps() } }
  }
  const delApp = pathname.match(/^\/api\/orchestrator\/built-apps\/(custom|eliza-cloud)\/([^/]+)$/u)
  if (method === "DELETE" && delApp) {
    const deleted = deleteBuiltApp(delApp[1] as "custom" | "eliza-cloud", delApp[2]!)
    return deleted ? { status: 200, body: { deleted: true } } : { status: 404, body: { error: "not_found" } }
  }
  if (!tasks) return { status: 503, body: { error: "orchestrator_initializing", status: "initializing", retryAfterMs: 1_000 } }
  if (method === "GET" && pathname === "/api/orchestrator/status") return { status: 200, body: tasks.getStatus() }
  if (method === "GET" && pathname === "/api/orchestrator/capacity") {
    return { status: 200, body: acp ? acp.getCapacity() : { activeWorkers: 0, maxSessions: 0, queuedCount: 0, maxQueue: 0, diskBlocked: false } }
  }
  if (method === "GET" && pathname === "/api/orchestrator/accounts") {
    return { status: 200, body: { adapters: probeAvailableAdapters(), matrix: buildOrchestratorDeviceSupportMatrix() } }
  }
  if (method === "GET" && pathname === "/api/orchestrator/accounts/readiness") {
    const adapters = probeAvailableAdapters()
    const ready = adapters.some((a) => a.installed && a.authenticated)
    return { status: ready ? 200 : 503, body: { ready, adapters } }
  }
  if (method === "GET" && pathname === "/api/orchestrator/rooms") {
    const rooms = new Map<string, string[]>()
    for (const s of acp?.listSessions() ?? []) {
      const room = s.roomId ?? "default"
      const list = rooms.get(room) ?? []
      list.push(s.id)
      rooms.set(room, list)
    }
    return { status: 200, body: { rooms: [...rooms.entries()].map(([roomId, sessionIds]) => ({ roomId, sessionIds })) } }
  }
  if (method === "GET" && pathname === "/api/orchestrator/widgets") {
    const limit = Math.max(1, Math.min(Number(req.query?.limit) || 20, 100))
    const includeArchived = req.query?.includeArchived === "true"
    return { status: 200, body: buildOrchestratorWidgetSnapshot(tasks.listTasks({ includeArchived, limit }), limit) }
  }
  if (method === "POST" && pathname === "/api/orchestrator/pause-all") return { status: 200, body: { paused: tasks.pauseAll() } }
  if (method === "POST" && pathname === "/api/orchestrator/resume-all") return { status: 200, body: { resumed: tasks.resumeAll() } }
  if (method === "GET" && pathname === "/api/orchestrator/tasks") {
    const list = tasks.listTasks({
      search: req.query?.search,
      includeArchived: req.query?.includeArchived === "true",
      projectId: req.query?.projectId,
      limit: Number(req.query?.limit) || 50,
    })
    return { status: 200, body: { tasks: list.map(toTaskThread) } }
  }
  if (method === "POST" && pathname === "/api/orchestrator/tasks") {
    const body = asObj(req.body)
    if (typeof body.title !== "string" || !body.title.trim()) return { status: 400, body: { error: "title is required" } }
    const created = tasks.createTask({
      title: body.title,
      goal: typeof body.goal === "string" ? body.goal : undefined,
      originalRequest: typeof body.originalRequest === "string" ? body.originalRequest : undefined,
      kind: typeof body.kind === "string" ? body.kind : undefined,
      workdir: typeof body.workdir === "string" ? body.workdir : undefined,
      projectId: typeof body.projectId === "string" ? body.projectId : undefined,
      acceptanceCriteria: Array.isArray(body.acceptanceCriteria) ? body.acceptanceCriteria.filter((c): c is string => typeof c === "string") : undefined,
    } satisfies CreateTaskInput)
    return { status: 201, body: created }
  }
  const taskMatch = pathname.match(/^\/api\/orchestrator\/tasks\/([^/]+)(?:\/([^/]+))?(?:\/([^/]+))?(?:\/([^/]+))?$/u)
  if (taskMatch) {
    return handleTaskItemRoutes(method, taskMatch[1]!, taskMatch[2], taskMatch[3], taskMatch[4], req, acp, tasks)
  }
  return undefined
}

async function handleCodingAgentSubroutes(
  runtime: IAgentRuntime,
  method: string,
  pathname: string,
  req: OrchestratorRouteRequest,
  acp: AcpService | undefined,
  tasks: OrchestratorTaskService | undefined,
): Promise<OrchestratorRouteResponse | undefined> {
  const bridgeMatch = pathname.match(/^\/api\/coding-agents\/([^/]+)\/(parent-context|memory|active-workspaces|skills|credentials)(?:\/([^/]+))?$/u)
  if (bridgeMatch) {
    const [, sessionId, endpoint] = bridgeMatch
    const auth = authorizeBridge(acp, sessionId!, req)
    if (!auth.ok) return auth.response
    const session = acp!.getSession(sessionId!)!
    const taskDoc = tasks?.getTaskForSession(sessionId!)
    if (endpoint === "parent-context") {
      return {
        status: 200,
        body: {
          sessionId,
          workdir: session.workdir,
          agentType: session.agentType,
          originatingTask: taskDoc
            ? { taskId: taskDoc.task.id, goal: taskDoc.task.goal, acceptanceCriteria: taskDoc.task.acceptanceCriteria }
            : null,
        },
      }
    }
    if (endpoint === "memory") {
      return { status: 200, body: { query: req.query?.q ?? "", limit: Number(req.query?.limit) || 10, scope: taskDoc?.task.worldId ? "world" : "room", hits: [] } }
    }
    if (endpoint === "active-workspaces") {
      const sameProjectTaskIds = new Set(
        taskDoc?.task.projectId
          ? (tasks?.listTasks({ projectId: taskDoc.task.projectId, limit: 100 }) ?? []).map((d) => d.task.id)
          : taskDoc ? [taskDoc.task.id] : [],
      )
      const scopedSessions = acp!.listSessions().filter((s) =>
        s.id === session.id
        || (s.taskId !== undefined && sameProjectTaskIds.has(s.taskId))
        || s.workdir === session.workdir,
      )
      return {
        status: 200,
        body: {
          sessionId,
          workdir: session.workdir,
          sessions: scopedSessions.map((s) => ({ id: s.id, label: s.label, workdir: s.workdir, status: s.status })),
        },
      }
    }
    if (endpoint === "skills") return { status: 200, body: { skills: [] } }
    return { status: 503, body: { error: "no_adapter" } }
  }
  if (!acp) return { status: 503, body: { error: "acp_unavailable" } }
  if (method === "GET" && pathname === "/api/coding-agents") return { status: 200, body: acp.listSessions() }
  if (method === "GET" && pathname === "/api/coding-agents/metrics") {
    const sessions = acp.listSessions()
    const byStatus: Record<string, number> = {}
    const byAgentType: Record<string, number> = {}
    for (const s of sessions) {
      byStatus[s.status] = (byStatus[s.status] ?? 0) + 1
      byAgentType[s.agentType] = (byAgentType[s.agentType] ?? 0) + 1
    }
    return {
      status: 200,
      body: { sessionCount: sessions.length, activeSessionCount: sessions.filter((s) => !isSessionTerminal(s.status)).length, byStatus, byAgentType },
    }
  }
  if (method === "GET" && pathname === "/api/coding-agents/approval-presets") {
    const presets: readonly ApprovalPreset[] = ["readonly", "standard", "permissive", "autonomous", "verifier"]
    return { status: 200, body: presets }
  }
  if (method === "GET" && pathname === "/api/coding-agents/approval-config") {
    return {
      status: 200,
      body: {
        agentType: req.query?.agentType ?? "elizaos",
        preset: req.query?.preset ?? "standard",
        transport: "acp",
      },
    }
  }
  if (method === "GET" && pathname === "/api/coding-agents/settings") {
    const preferred = resolveCodingBackend({ runtime })
    return {
      status: 200,
      body: {
        defaultApprovalPreset: "standard",
        preferredAgentType: preferred?.agentType ?? "elizaos",
        preferredAgentReason: preferred?.source ?? "default",
        frameworks: ORDERED_ADAPTER_IDS,
      },
    }
  }
  if (method === "POST" && pathname === "/api/coding-agents/spawn") {
    const body = asObj(req.body)
    const rawWorkdir = typeof body.workdir === "string" ? body.workdir : ""
    const workdir = await runPromise(effect { return resolveAllowedWorkdir(rawWorkdir, resolveServerAllowedWorkdirRoots(), true) catch () => undefined })
    if (!workdir) return { status: 403, body: { error: "workdir_forbidden" } }
    const rawMeta = asObj(body.metadata)
    const sanitizedMetadata: Record<string, unknown> = {}
    for (const [k, v] of Object.entries(rawMeta)) {
      if (k !== SUBSCRIPTION_EXECUTION_AUTHORIZATION_METADATA_KEY) sanitizedMetadata[k] = v
    }
    const spawned = await runPromise(effect {
      return acp.spawnSessionEffect({
        agentType: typeof body.agentType === "string" ? body.agentType : undefined,
        workdir,
        task: typeof body.task === "string" ? body.task : undefined,
        label: typeof body.label === "string" ? body.label : undefined,
        providerRoute: typeof body.providerRoute === "string" ? body.providerRoute : undefined,
        metadata: sanitizedMetadata,
      }) catch () => undefined
    })
    if (!spawned) return { status: 429, body: { error: "session_cap_exceeded" } }
    return { status: 201, body: spawned }
  }
  const agentMatch = pathname.match(/^\/api\/coding-agents\/([^/]+)(?:\/(send|stop|output|buffered-output))?$/u)
  if (agentMatch) {
    const [, agentId, action] = agentMatch
    if (!action && method === "GET") {
      const session = acp.getSession(agentId!)
      return session ? { status: 200, body: session } : { status: 404, body: { error: "not_found" } }
    }
    if (action === "send" && method === "POST") {
      const body = asObj(req.body)
      if (typeof body.keys === "string") return { status: 400, body: { error: "keys_not_supported_on_route" } }
      if (typeof body.input !== "string" || !body.input.trim()) return { status: 400, body: { error: "input_required" } }
      await acp.sendToSession(agentId!, body.input)
      return { status: 200, body: { success: true } }
    }
    if (action === "stop" && method === "POST") {
      const stopped = await acp.stopSession(agentId!)
      return stopped ? { status: 200, body: { success: true, sessionId: agentId } } : { status: 404, body: { error: "not_found" } }
    }
    if ((action === "output" || action === "buffered-output") && method === "GET") {
      return { status: 200, body: { sessionId: agentId, output: acp.getSessionOutput(agentId!, Number(req.query?.lines) || 200) } }
    }
  }
  return undefined
}

async function handleWorkspaceAndIssueSubroutes(
  method: string,
  pathname: string,
  req: OrchestratorRouteRequest,
  ws: CodingWorkspaceService | undefined,
): Promise<OrchestratorRouteResponse | undefined> {
  if (!ws) return { status: 503, body: { error: "workspace_unavailable" } }
  if (pathname.startsWith("/api/workspace")) {
    if (method === "POST" && pathname === "/api/workspace/provision") {
      const body = asObj(req.body)
      if (typeof body.repo !== "string") return { status: 400, body: { error: "repo_required" } }
      const created = await runPromise(effect {
        return ws.provisionWorkspaceEffect({
          repo: body.repo as string,
          baseBranch: typeof body.baseBranch === "string" ? body.baseBranch : undefined,
          branchName: typeof body.branchName === "string" ? body.branchName : undefined,
          useWorktree: body.useWorktree === true,
          parentWorkspaceId: typeof body.parentWorkspaceId === "string" ? body.parentWorkspaceId : undefined,
        }) catch () => undefined
      })
      return created ? { status: 201, body: created } : { status: 400, body: { error: "provision_failed" } }
    }
    const wsMatch = pathname.match(/^\/api\/workspace\/([^/]+)(?:\/(commit|push|pr))?$/u)
    if (wsMatch) {
      const [, wsId, sub] = wsMatch
      if (!sub && method === "GET") {
        const found = ws.getWorkspace(wsId!)
        return found ? { status: 200, body: found } : { status: 404, body: { error: "not_found" } }
      }
      if (!sub && method === "DELETE") {
        const removed = await ws.removeWorkspace(wsId!)
        return removed ? { status: 200, body: { success: true, workspaceId: wsId } } : { status: 404, body: { error: "not_found" } }
      }
      if (sub === "commit" && method === "POST") {
        const body = asObj(req.body)
        if (typeof body.message !== "string" || !body.message.trim()) return { status: 400, body: { error: "message_required" } }
        const msg = body.message
        const res = await runPromise(effect { return ws.commitEffect(wsId!, msg) catch () => undefined })
        return res ? { status: 200, body: res } : { status: 409, body: { error: "commit_blocked" } }
      }
      if (sub === "push" && method === "POST") {
        const body = asObj(req.body)
        const res = await runPromise(effect { return ws.pushEffect(wsId!, { force: body.force === true, setUpstream: body.setUpstream !== false }) catch () => undefined })
        return res ? { status: 200, body: res } : { status: 409, body: { error: "push_failed" } }
      }
      if (sub === "pr" && method === "POST") {
        const body = asObj(req.body)
        if (typeof body.title !== "string" || typeof body.body !== "string") return { status: 400, body: { error: "title_and_body_required" } }
        const res = await runPromise(effect {
          return ws.createPrEffect(wsId!, {
            title: body.title as string,
            body: body.body as string,
            baseBranch: typeof body.baseBranch === "string" ? body.baseBranch : undefined,
            draft: body.draft === true,
          }) catch () => undefined
        })
        return res ? { status: 201, body: res } : { status: 502, body: { error: "pr_failed" } }
      }
    }
  }
  if (pathname.startsWith("/api/issues")) {
    if (method === "GET" && pathname === "/api/issues") {
      const repo = req.query?.repo
      if (!repo) return { status: 400, body: { error: "repo_required" } }
      const stateVal = req.query?.state
      const state = stateVal === "closed" || stateVal === "all" ? stateVal : "open"
      const labels = req.query?.labels ? req.query.labels.split(",").map((s) => s.trim()).filter(Boolean) : undefined
      const issues = await runPromise(effect { return ws.listIssuesEffect(repo, state, labels) catch () => undefined })
      return issues ? { status: 200, body: issues } : { status: 502, body: { error: "issues_failed" } }
    }
    if (method === "POST" && pathname === "/api/issues") {
      const body = asObj(req.body)
      if (typeof body.repo !== "string" || typeof body.title !== "string") return { status: 400, body: { error: "repo_and_title_required" } }
      const created = await runPromise(effect {
        return ws.createIssueEffect(body.repo as string, {
          title: body.title as string,
          body: typeof body.body === "string" ? body.body : undefined,
          labels: Array.isArray(body.labels) ? body.labels.filter((l): l is string => typeof l === "string") : undefined,
        }) catch () => undefined
      })
      return created ? { status: 201, body: created } : { status: 502, body: { error: "issue_create_failed" } }
    }
    const issueMatch = pathname.match(/^\/api\/issues\/([^/]+)\/([^/]+)\/(\d+)(?:\/(comments|close))?$/u)
    if (issueMatch) {
      const repo = `${issueMatch[1]}/${issueMatch[2]}`
      const num = Number(issueMatch[3])
      const action = issueMatch[4]
      if (!action && method === "GET") {
        const issue = await runPromise(effect { return ws.getIssueEffect(repo, num) catch () => undefined })
        return issue ? { status: 200, body: issue } : { status: 502, body: { error: "issue_get_failed" } }
      }
      if (action === "comments" && method === "POST") {
        const body = asObj(req.body)
        if (typeof body.body !== "string" || !body.body.trim()) return { status: 400, body: { error: "body_required" } }
        const text = body.body
        const comment = await runPromise(effect { return ws.addIssueCommentEffect(repo, num, text) catch () => undefined })
        return comment ? { status: 201, body: comment } : { status: 502, body: { error: "issue_comment_failed" } }
      }
      if (action === "close" && method === "POST") {
        const closed = await runPromise(effect { return ws.updateIssueEffect(repo, num, { state: "closed" }) catch () => undefined })
        return closed ? { status: 200, body: closed } : { status: 502, body: { error: "issue_close_failed" } }
      }
    }
  }
  return undefined
}

export async function handleCodingAgentRoutes(
  runtime: IAgentRuntime,
  req: OrchestratorRouteRequest,
): Promise<OrchestratorRouteResponse> {
  const method = req.method.toUpperCase()
  const pathname = req.path.replace(/^\/api\/task-agents(?=\/|$)/u, "/api/coding-agents")
  const { acp, tasks, ws } = getServices(runtime)
  if (pathname.startsWith("/api/orchestrator/")) {
    const res = await handleOrchestratorSubroutes(method, pathname, req, acp, tasks)
    if (res) return res
  }
  if (pathname.startsWith("/api/coding-agents")) {
    const res = await handleCodingAgentSubroutes(runtime, method, pathname, req, acp, tasks)
    if (res) return res
  }
  if (pathname.startsWith("/api/workspace") || pathname.startsWith("/api/issues")) {
    const res = await handleWorkspaceAndIssueSubroutes(method, pathname, req, ws)
    if (res) return res
  }
  return { status: 404, body: { error: "not_found" } }
}

export function createCodingAgentRouteHandler(runtime: IAgentRuntime) {
  return (req: OrchestratorRouteRequest) => handleCodingAgentRoutes(runtime, req)
}

export const createTaskAgentRouteHandler = createCodingAgentRouteHandler
