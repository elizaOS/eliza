export const tasksSandboxStubAction: Action = {
  name: "TASKS",
  description: "Coding agent orchestration is unavailable in sandboxed store builds.",
  descriptionCompressed: "Coding agents disabled in sandbox build.",
  similes: [...TASKS_SIMILES],
  suppressPostActionContinuation: true,
  validate: async () => true,
  handler: async () => ({
    success: false,
    text: "Coding agents are unavailable in this sandboxed build.",
    data: { actionName: "TASKS", reason: "STORE_BUILD_BLOCKED" },
  }),
}

export function createTerminalUnsupportedTasksAction(support: OrchestratorTerminalSupport): Action {
  const reason = support.reason === "vanilla_mobile"
    ? "MOBILE_TERMINAL_UNSUPPORTED"
    : support.reason === "not_local_yolo"
      ? "AOSP_TERMINAL_REQUIRES_LOCAL_YOLO"
      : support.reason === "missing_shell"
        ? "AOSP_TERMINAL_MISSING_SHELL"
        : "TERMINAL_UNSUPPORTED"
  return {
    name: "TASKS",
    description: `Coding agent orchestration is unavailable on this platform (${reason}).`,
    descriptionCompressed: `Coding agents unavailable (${reason}).`,
    similes: [...TASKS_SIMILES],
    suppressPostActionContinuation: true,
    validate: async () => true,
    handler: async () => ({
      success: false,
      text: `Coding agent terminal execution is unsupported here (${reason}).`,
      data: { actionName: "TASKS", reason },
    }),
  }
}
