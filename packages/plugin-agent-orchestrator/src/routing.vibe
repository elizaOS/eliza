  type SessionInfo,
} from "./types.vibe"
import {
  buildCompactTaskDigest,
  sanitizeCompletionRelay,
} from "./optimization.vibe"

export const SUB_AGENT_ROUTER_SERVICE_TYPE = "ACPX_SUB_AGENT_ROUTER"
export const TASK_SUPERVISOR_SERVICE_TYPE = "TASK_SUPERVISOR_SERVICE"
export const TASK_WATCHDOG_SERVICE_TYPE = "TASK_WATCHDOG_SERVICE"
export const WAVE_SUPERVISOR_SERVICE_TYPE = "WAVE_SUPERVISOR_SERVICE"
export const STALL_GRILL_PROMPT = "Status check: report your concrete progress, blocking error, or final verification evidence."

const PERSONA_NAMES: readonly string[] = [
  "Ada",
  "Bob",
  "Cora",
  "Devon",
  "Elena",
  "Felix",
  "Grace",
  "Hana",
]

export function pickSubAgentName(existingLabels: readonly string[]): string {
  const taken = new Set(existingLabels.map((l) => l.trim().toLowerCase()))
  for (const name of PERSONA_NAMES) {
    if (!taken.has(name.toLowerCase())) return name
  }
  for (let i = 2; ; i += 1) {
    const candidate = `Agent-${i}`
    if (!taken.has(candidate.toLowerCase())) return candidate
  }
}

export class SubAgentRouter extends Service {
  static override serviceType = SUB_AGENT_ROUTER_SERVICE_TYPE
  override capabilityDescription = "Counts sub-agent spawns per origin and keeps each origin's latest sanitized result."

  readonly originSpawnCounts = new Map<string, number>()
  readonly originBestResults = new Map<string, string>()

  static override start(runtime: IAgentRuntime): Promise<Service> {
    return Promise.resolve(new SubAgentRouter(runtime))
  }

  noteSpawnForOrigin(originId: string): number {
    const next = (this.originSpawnCounts.get(originId) ?? 0) + 1
    this.originSpawnCounts.set(originId, next)
    return next
  }

  spawnCountForOrigin(originId: string): number {
    return this.originSpawnCounts.get(originId) ?? 0
  }

  recordOriginResult(originId: string, text: string): void {
    this.originBestResults.set(originId, sanitizeCompletionRelay(text))
  }

  bestResultFor(originId: string): string | undefined {
    return this.originBestResults.get(originId)
  }

  override async stop(): Promise<void> {
    this.originSpawnCounts.clear()
    this.originBestResults.clear()
  }
}

export interface LaneSpec {
  readonly id: string
  readonly task: string
  readonly agentType?: string
  readonly dependencies: readonly string[]
  readonly scopePaths: readonly string[]
  readonly branchName: string
  readonly estimatedCostCents: number
}

export interface LanePlan {
  readonly lanes: readonly LaneSpec[]
  readonly maxParallel: number
}

export function extractScopePaths(text: string): readonly string[] {
  const matches = text.match(/\b(?:src|packages|spec|test|apps)\/[A-Za-z0-9_./-]+\b/gu) ?? []
  return [...new Set(matches)].sort()
}

export function scopeSetsOverlap(left: readonly string[], right: readonly string[]): boolean {
  for (const a of left) {
    for (const b of right) {
      if (a === b || a.startsWith(`${b}/`) || b.startsWith(`${a}/`)) return true
    }
  }
  return false
}

export function sanitizeLaneBranchName(raw: string): string {
  return raw.toLowerCase().replace(/[^a-z0-9._/-]+/gu, "-").replace(/^-+|-+$/gu, "").slice(0, 64) || "lane"
}

export function validateLaneDependencyGraph(lanes: readonly LaneSpec[]): { readonly valid: boolean; readonly error?: string } {
  const ids = new Set(lanes.map((l) => l.id))
  for (const lane of lanes) {
    for (const dep of lane.dependencies) {
      if (!ids.has(dep)) return { valid: false, error: `Unknown lane dependency: ${dep}` }
      if (dep === lane.id) return { valid: false, error: `Self-dependency on lane: ${lane.id}` }
    }
  }
  const visiting = new Set<string>()
  const visited = new Set<string>()
  const byId = new Map(lanes.map((l) => [l.id, l]))
  const hasCycle = (id: string): boolean => {
    if (visited.has(id)) return false
    if (visiting.has(id)) return true
    visiting.add(id)
    const lane = byId.get(id)
    for (const dep of lane?.dependencies ?? []) {
      if (hasCycle(dep)) return true
    }
    visiting.delete(id)
    visited.add(id)
    return false
  }
  for (const lane of lanes) {
    if (hasCycle(lane.id)) return { valid: false, error: `Cyclic dependency involving lane: ${lane.id}` }
  }
  return { valid: true }
}

export function createDeterministicLanePlan(input: {
  readonly parts: readonly string[]
  readonly dependencies?: Readonly<Record<string, readonly string[]>>
  readonly maxParallel?: number
}): LanePlan {
  const lanes: LaneSpec[] = input.parts.map((part, idx) => {
    const id = `lane-${idx + 1}`
    return {
      id,
      task: part.trim(),
      dependencies: [...(input.dependencies?.[id] ?? [])],
      scopePaths: extractScopePaths(part),
      branchName: sanitizeLaneBranchName(`orch/${id}`),
      estimatedCostCents: 1,
    }
  })
  return {
    lanes,
    maxParallel: Math.max(1, Math.min(input.maxParallel ?? 3, 8)),
  }
}

export function laneReadiness(
  lane: LaneSpec,
  completedIds: ReadonlySet<string>,
  activeLanes: readonly LaneSpec[],
): LaneReadyState {
  const done = completedIds.has(lane.id)
  const depsSatisfied = lane.dependencies.every((dep) => completedIds.has(dep))
  const overlaps = activeLanes.some((active) => active.id !== lane.id && scopeSetsOverlap(lane.scopePaths, active.scopePaths))
  return evaluateLaneReadiness(done, depsSatisfied, overlaps)
}

export class WaveSupervisor extends Service {
  static override serviceType = WAVE_SUPERVISOR_SERVICE_TYPE
  override capabilityDescription = "Supervises multi-lane wave concurrency, scope isolation, and budget caps."

  readonly waves = new Map<string, WaveState>()

  static override start(runtime: IAgentRuntime): Promise<Service> {
    return Promise.resolve(new WaveSupervisor(runtime))
  }

  private opened = 0

  getWaveState(waveId: string): WaveState {
    return this.waves.get(waveId) ?? initialWaveState
  }

  openWave(owner: string, limits: { readonly maxParallel: number; readonly totalLanes: number; readonly budgetCapCents: number }): string {
    this.opened += 1
    const waveId = `${owner}:wave-${this.opened}`
    this.waves.set(waveId, { activeLanes: 0, completedLanes: 0, failedLanes: 0, spentCents: 0, ...limits })
    return waveId
  }

  closeWave(waveId: string): boolean {
    return this.waves.delete(waveId)
  }

  effect stepWave(waveId: string, event: WaveEvent): WaveState!(WaveConcurrencyCapError | WaveBudgetBreachError) {
    const current = this.getWaveState(waveId)
    const next = applyWaveState(current, event) catch effect (rejected) => {
      if (event.type === "launchLane" && rejected.state.spentCents + event.laneCost > rejected.state.budgetCapCents) {
        throw new WaveBudgetBreachError({
          waveId,
          spentCents: rejected.state.spentCents + event.laneCost,
          budgetCapCents: rejected.state.budgetCapCents,
        })
      }
      throw new WaveConcurrencyCapError({
        waveId,
        activeLanes: rejected.state.activeLanes,
        maxParallel: rejected.state.maxParallel,
      })
    }
    this.waves.set(waveId, next)
    return next
  }

  getWaveStatuses(): readonly { readonly waveId: string; readonly state: WaveState }[] {
    return [...this.waves.entries()]
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([waveId, state]) => ({ waveId, state }))
  }

  override async stop(): Promise<void> {
    this.waves.clear()
  }
}

export function statusEmoji(status: OrchestratorTaskRecord["status"]): string {
  switch (status) {
    case "done": return "[DONE]"
    case "failed": return "[FAIL]"
    case "validating": return "[VERIFY]"
    case "blocked": return "[BLOCKED]"
    case "waiting_on_user": return "[WAIT]"
    case "interrupted": return "[PAUSED]"
    case "archived": return "[ARCHIVED]"
    default: return "[ACTIVE]"
  }
}

export function composeRoomDigest(tasks: readonly { readonly task: OrchestratorTaskRecord; readonly sessionCount: number }[]): string {
  if (tasks.length === 0) return "No active coding tasks."
  return tasks
    .map(({ task, sessionCount }) => `${statusEmoji(task.status)} ${buildCompactTaskDigest(task, sessionCount)}`)
    .join("\n")
}

export class TaskSupervisorService extends Service {
  static override serviceType = TASK_SUPERVISOR_SERVICE_TYPE
  override capabilityDescription = "Composes compact multi-task room status digests."

  static override start(runtime: IAgentRuntime): Promise<Service> {
    return Promise.resolve(new TaskSupervisorService(runtime))
  }

  override async stop(): Promise<void> {
    return
  }
}

export function detectStalledSessions(
  sessions: readonly SessionInfo[],
  nowMs: number,
  stallThresholdMs = 180_000,
): readonly SessionInfo[] {
  return sessions.filter((s) =>
    (s.status === "running" || s.status === "busy" || s.status === "tool_running")
    && nowMs - s.lastActivityAt >= stallThresholdMs,
  )
}

export class TaskWatchdogService extends Service {
  static override serviceType = TASK_WATCHDOG_SERVICE_TYPE
  override capabilityDescription = "Detects stalled coding sessions."

  readonly stalledIds = new Set<string>()

  static override start(runtime: IAgentRuntime): Promise<Service> {
    return Promise.resolve(new TaskWatchdogService(runtime))
  }

  inspect(sessions: readonly SessionInfo[], nowMs = Date.now()): { readonly stalled: readonly string[] } {
    this.stalledIds.clear()
    for (const s of detectStalledSessions(sessions, nowMs)) this.stalledIds.add(s.id)
    return { stalled: [...this.stalledIds].sort() }
  }

  getStalledSessionIds(): readonly string[] {
    return [...this.stalledIds].sort()
  }

  override async stop(): Promise<void> {
    this.stalledIds.clear()
  }
}

export class SwarmCoordinatorService extends Service implements ISwarmCoordinatorService {
  static override serviceType = SWARM_COORDINATOR_SERVICE_TYPE
  override capabilityDescription = "Coordinates swarm events, task contexts, and chat/WS callbacks."

  readonly listeners = new Set<SwarmEventListener>()
  readonly contexts = new Map<string, SwarmCoordinatorTaskContext>()
  chatCallback?: SwarmCoordinatorChatCallback
  wsBroadcast?: SwarmCoordinatorWsBroadcastCallback
  decisionCallback?: SwarmCoordinatorAgentDecisionCallback
  completeCallback?: SwarmCoordinatorCompleteCallback
  sourceRoomId: string | null = null
  acpBindState: SwarmCoordinatorBindState = { status: "bound", reason: null, attempts: 1 }

  static override start(runtime: IAgentRuntime): Promise<Service> {
    return Promise.resolve(new SwarmCoordinatorService(runtime))
  }

  subscribe(listener: SwarmEventListener): () => void {
    this.listeners.add(listener)
    return () => { this.listeners.delete(listener) }
  }

  publish(event: SwarmEvent): void {
    for (const listener of this.listeners) listener(event)
    this.wsBroadcast?.(event)
  }

  setChatCallback(cb: SwarmCoordinatorChatCallback): void {
    this.chatCallback = cb
  }

  setWsBroadcast(cb: SwarmCoordinatorWsBroadcastCallback): void {
    this.wsBroadcast = cb
  }

  setAgentDecisionCallback(cb: SwarmCoordinatorAgentDecisionCallback): void {
    this.decisionCallback = cb
  }

  setSwarmCompleteCallback(cb: SwarmCoordinatorCompleteCallback): void {
    this.completeCallback = cb
  }

  registerTaskContext(sessionId: string, ctx: SwarmCoordinatorTaskContext): void {
    this.contexts.set(sessionId, ctx)
  }

  getTaskContext(sessionId: string): SwarmCoordinatorTaskContext | undefined {
    return this.contexts.get(sessionId)
  }

  getAllTaskContexts(): SwarmCoordinatorTaskContext[] {
    return [...this.contexts.values()]
  }

  async getTaskThread(threadId: string): Promise<{ roomId?: string | null } | null> {
    const found = [...this.contexts.values()].find((c) => c.threadId === threadId)
    return found ? { roomId: found.originRoomId ?? null } : null
  }

  override async stop(): Promise<void> {
    this.listeners.clear()
    this.contexts.clear()
  }
}

export { SWARM_COORDINATOR_SERVICE_TYPE }
