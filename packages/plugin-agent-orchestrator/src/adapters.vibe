  readonly dialect: PiApiDialect
  readonly billing: PiBillingMode
  readonly terms: PiTermsPolicy
  readonly credentialEnv: string
  readonly defaultModel: string
  readonly supportsPromptCaching: boolean
  readonly cacheBlockTokens: number
