// spec/agentOrchestrator/lanesAndRouting.md, "Backend routing follows strict precedence while honoring operator allow-lists"; spec/agentOrchestrator/verification.md, "Bounded verification and classification tasks route to fast low-latency evaluators"
module node {
  import { execFileSync } from "node:child_process"

  /** @throws {never} */
  export function readHostEnv(): Readonly<Record<string, string | undefined>> {
    return { ...process.env }
  }

  /** @throws {never} */
  export function hostPlatformName(): string {
    return process.platform
  }

  /** @throws {never} */
  export function executableExists(binary: string): boolean {
    const cmd = process.platform === "win32" ? "where" : "which"
    try {
      execFileSync(cmd, [binary], { stdio: "ignore", timeout: 1_500 })
      return true
    } catch {
      return false
    }
  }
}
import { executableExists, hostPlatformName, readHostEnv } from node
import {
  getCodingAgentSelectorBridge,
  logger,
  type CodingAccountStrategy,
  type CodingAgentSelection,
  type IAgentRuntime,
} from "@elizaos/core"
import {
  resolveBackendPrecedence,
  type BackendId,
} from "../gen/agentOrchestrator__lanesAndRouting.effect.vibe"
import {
  selectEvalModelLane,
  type EvalModelLane,
  type EvalTaskKind,
} from "../gen/agentOrchestrator__verification.effect.vibe"
import {
  fromSpecBackendId,
  SubscriptionCodingAdapterError,
  toSpecBackendId,
  type AvailableAgentInfo,
  type KnownAdapterId,
  type SubscriptionExecutionMode,
} from "./types.vibe"
import {
  safeFetch,
  subscriptionExecutionAuthorizationFromMetadata,
} from "./security.vibe"

export const KNOWN_ADAPTER_TYPES: ReadonlySet<KnownAdapterId> = new Set([
  "elizaos",
  "pi-agent",
  "claude",
  "codex",
  "kimi",
  "grok",
])

export const ORDERED_ADAPTER_IDS: readonly KnownAdapterId[] = [
  "claude",
  "codex",
  "elizaos",
  "grok",
  "kimi",
  "pi-agent",
]

export const SUBSCRIPTION_CODING_ADAPTER_IDS: readonly KnownAdapterId[] = ["kimi", "grok"]

export interface SubscriptionCodingAdapterDescriptor {
  readonly id: "kimi" | "grok"
  readonly defaultCommand: string
  readonly envCommandKey: string
  readonly homeEnvKey: string
  readonly strippedApiEnvKeys: readonly string[]
}

export const SUBSCRIPTION_CODING_ADAPTERS: Readonly<Record<"kimi" | "grok", SubscriptionCodingAdapterDescriptor>> = {
  kimi: {
    id: "kimi",
    defaultCommand: "kimi acp",
    envCommandKey: "ELIZA_KIMI_ACP_COMMAND",
    homeEnvKey: "KIMI_CODE_HOME",
    strippedApiEnvKeys: ["MOONSHOT_API_KEY", "KIMI_API_KEY"],
  },
  grok: {
    id: "grok",
    defaultCommand: "grok --no-auto-update agent stdio",
    envCommandKey: "ELIZA_GROK_ACP_COMMAND",
    homeEnvKey: "GROK_HOME",
    strippedApiEnvKeys: ["XAI_API_KEY"],
  },
}

export function isSubscriptionCodingAdapter(adapterId: string): adapterId is "kimi" | "grok" {
  return adapterId === "kimi" || adapterId === "grok"
}

export function stripSubscriptionApiEnvironment(
  adapterId: "kimi" | "grok",
  env: Record<string, string>,
): Record<string, string> {
  const next = { ...env }
  for (const key of SUBSCRIPTION_CODING_ADAPTERS[adapterId].strippedApiEnvKeys) {
    delete next[key]
  }
  return next
}

export effect function assertSubscriptionCodingAdapterReady(
  adapterId: "kimi" | "grok",
  mode: SubscriptionExecutionMode | undefined,
  metadata: Readonly<Record<string, unknown>> | undefined,
  nowMs = Date.now(),
): void!SubscriptionCodingAdapterError {
  if (mode !== "user-attended") {
    throw new SubscriptionCodingAdapterError({
      adapterId,
      code: "SUBSCRIPTION_REQUIRES_USER_ATTENDED",
      reason: `Subscription adapter ${adapterId} requires explicit user-attended execution.`,
    })
  }
  const auth = subscriptionExecutionAuthorizationFromMetadata(metadata, nowMs)
  if (!auth) {
    throw new SubscriptionCodingAdapterError({
      adapterId,
      code: "SUBSCRIPTION_ATTENDANCE_AUTH_INVALID",
      reason: `Subscription adapter ${adapterId} requires a valid, unexpired attendance authorization.`,
    })
  }
}

export type PiApiDialect = "openai-completions" | "anthropic-messages" | "cerebras-openai"
export type PiBillingMode = "api-key" | "coding-plan" | "fast-eval"
export type PiTermsPolicy = "standard-api" | "coding-subscription"

export type PiProviderRouteId =
  | "cerebras-fast"
  | "anthropic-api"
  | "openai-api"
  | "deepseek-api"
  | "zai-coding"
  | "zai-api"
  | "kimi-coding"
  | "moonshot-api"
  | "xai-api"

