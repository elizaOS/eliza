{
  "name": "@elizaos/test-corpus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository-wide scenario definitions and shared Vitest lane configuration.",
  "scripts": {
    "test": "bun test vitest/*.test.ts",
    "typecheck": "tsc --noEmit -p vitest/tsconfig.json",
    "format": "bunx @biomejs/biome format --write package.json scenarios vitest",
    "format:check": "bunx @biomejs/biome format package.json scenarios vitest"
  },
  "devDependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/scenario-runner": "workspace:*",
    "vitest": "*"
  },
  "elizaos": {
    "scripts": {
      "testLanes": [
        "server"
      ]
    }
  }
}
