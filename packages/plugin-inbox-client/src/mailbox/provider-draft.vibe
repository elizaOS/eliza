// spec/inbox/drafts.md, "Story: Open a provider draft without losing my saved draft"; spec/inbox/drafts.md, "Opening another provider draft first shelves the saved draft"
import { openedDraft, openWarns, type OpenedDraft } from "../../gen/inbox__drafts.effect.vibe"
import type { MailFailure } from "./failures.vibe"
import type { GmailDraftContent } from "./types.vibe"

export interface SavedLocalDraft {
  readonly draftId: string
  readonly provider?: { readonly draftId: string; readonly providerDigest: string }
}

export error DraftSlotFailed { cause: unknown }

export interface ProviderDraftPorts<S extends SavedLocalDraft> {
  readonly current: () => boolean
  saved(): (S | null)!DraftSlotFailed
  shelve(saved: S): boolean!DraftSlotFailed
  clearSlot(saved: S): boolean!DraftSlotFailed
  mountSaved(saved: S): void!!
  mountProvider(content: GmailDraftContent): void!!
}

export interface ProviderDraftReader {
  gmailDraftContent(grantId: string, draftId: string): GmailDraftContent!MailFailure
}

export interface ProviderDraftOpening {
  readonly opened: OpenedDraft
  readonly warns: boolean
}

export effect function openProviderDraft<S extends SavedLocalDraft>(reader: ProviderDraftReader, grantId: string, draftId: string, ports: ProviderDraftPorts<S>): ProviderDraftOpening!(MailFailure | DraftSlotFailed) {
  const content = try reader.gmailDraftContent(grantId, draftId)
  const saved = try ports.saved()
  const sameReference = saved !== null && saved.provider?.draftId === draftId
  const earlier = sameReference && saved.provider?.providerDigest !== content.providerDigest
  const shelved = saved === null || sameReference ? true : try ports.shelve(saved)
  const slotCleared = saved === null || sameReference ? true : shelved && (try ports.clearSlot(saved))
  const facts = { current: ports.current(), sameReference, earlier, shelved: !sameReference && shelved, slotCleared: !sameReference && slotCleared }
  const opened = openedDraft(facts)
  if (opened === "SavedDraftOpened" && saved !== null) try ports.mountSaved(saved)
  if (opened === "ProviderDraftOpened") try ports.mountProvider(content)
  return { opened, warns: openWarns(facts) }
}
