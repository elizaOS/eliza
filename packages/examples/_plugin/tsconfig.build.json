{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"sourceMap": true,
		"inlineSources": true,
		"declaration": true,
		"noEmit": false
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.test.ts",
		"**/*.spec.ts",
		"**/*.cy.ts",
		"**/*.cy.tsx",
		"src/__tests__/**"
	]
}
