// spec/browser/control.md, "Story: Offer only the Browser controls my phone negotiated"; spec/browser/control.md, "Each control needs its group's capability, and a new-tab open needs its own"; spec/browser/control.md, "Closing every tab is its own negotiated form, refused rather than narrowed, and reviewed only on a card that lists those tabs"; spec/browser/control.md, "A control is reviewed only on the unlocked phone, and closing a tab always waits for that review"; spec/browser/control.md, "Closing every tab on a phone that closes one tab at a time is refused with its reason, never narrowed"; spec/browser/control.md, "A search, tab switch or find runs without my review only on words I typed for it, and a search only as my whole message"; spec/browser/control.md, "A history move has one home: the Browser control where my phone negotiated it, or else the BROWSER command"; spec/browser/control.md, "A reload of a page my phone withheld runs only after my review on the phone, or as the BROWSER command only when the model says I asked for it"
import type { BrowserPage } from "@elizaos/agent"
import {
  closeAllApprovable, closeAllReview, closeAnswer, closeFormOffered, commandReloadRuns, controlBound, controlOffered, historyHome, withheldReload, navigationOffered, pageReopenRefused, reviewAdmitted, runsUnreviewed,
  type BrowserControl, type CarriedPage, type CloseAnswer, type HistoryHome, type HistoryMove, type Negotiated, type TabCloseForm,
} from "../gen/browser__control.effect.vibe"
import { BROWSER_SEARCH_QUERY_MAX } from "./grounding.vibe"

export const BROWSER_SEARCH_CAPABILITY = "browser.search.v1"
export const BROWSER_TABS_CAPABILITY = "browser.tabs.v1"
export const BROWSER_FIND_CAPABILITY = "browser.find.v1"
export const BROWSER_HISTORY_CAPABILITY = "browser.history.v1"
export const BROWSER_OPEN_NEW_TAB_CAPABILITY = "browser.open-new-tab.v1"
export const BROWSER_TABS_CLOSE_ALL_CAPABILITY = "browser.tabs.close-all.v1"
export const BROWSER_TABS_SHOW_CAPABILITY = "browser.tabs.show.v1"

export const BROWSER_TAB_TARGET_MAX = 128
export const BROWSER_FIND_TEXT_MAX = 256
export const BROWSER_NAVIGATE_URL_MAX = 4096
export const BROWSER_HISTORY_ACTIONS = ["back", "forward", "reload", "stop"] as const

export type BrowserHistoryAction = (typeof BROWSER_HISTORY_ACTIONS)[number]

export type BrowserControlOperation =
  | { readonly type: "browser_search"; readonly query: string }
  | { readonly type: "browser_tab_new"; readonly private?: true }
  | { readonly type: "browser_tab_switch"; readonly target: string }
  | { readonly type: "browser_tab_close"; readonly target?: string; readonly all?: true }
  | { readonly type: "browser_tabs_show" }
  | { readonly type: "browser_find"; readonly text: string }
  | { readonly type: "browser_history"; readonly action: BrowserHistoryAction }

export type BrowserControlType = BrowserControlOperation["type"]

export interface BrowserTabLine {
  readonly title: string
  readonly host?: string
  readonly private?: boolean
}

export interface BrowserNavigateOperation {
  readonly type: "browser_navigate"
  readonly url: string
  readonly newTab?: true
}

export type BrowserParse<A> = { readonly ok: true; readonly operation: A } | { readonly ok: false; readonly reason: string }

export error BrowserControlRefused { reason: string }

const CONTROLS: Readonly<Record<BrowserControlType, BrowserControl>> = {
  browser_search: "SearchControl",
  browser_tab_new: "TabNewControl",
  browser_tab_switch: "TabSwitchControl",
  browser_tab_close: "TabCloseControl",
  browser_tabs_show: "TabListControl",
  browser_find: "FindControl",
  browser_history: "HistoryControl",
}

export const BROWSER_CONTROL_TYPES: readonly BrowserControlType[] = [
  "browser_search", "browser_tab_new", "browser_tab_switch", "browser_tab_close", "browser_tabs_show", "browser_find", "browser_history",
]

export const BROWSER_CONTROL_DIRECT_TYPES: readonly BrowserControlType[] = BROWSER_CONTROL_TYPES.filter((type) =>
  runsUnreviewed({ control: CONTROLS[type], boundToMessage: true, wordsTyped: true }))

const UNLOCK_NOTICE = "Unlock the phone to review this action."
export const BROWSER_TABS_UNLISTED_NOTICE = "Browser couldn't list its open tabs for this request, or they changed after they were listed. Nothing was closed. Ask again."
export const BROWSER_NO_TABS_TO_CLOSE_NOTICE = "No tabs are open to close. Nothing was closed."
// eslint-disable-next-line no-control-regex -- Browser control evidence rejects literal control characters.
const CONTROL_CHARACTER = /[\u0000-\u001f\u007f]/

function negotiatedOf(capabilities: readonly string[] | undefined): Negotiated {
  const has = (capability: string) => capabilities?.includes(capability) === true
  return {
    searchCapability: has(BROWSER_SEARCH_CAPABILITY),
    tabsCapability: has(BROWSER_TABS_CAPABILITY),
    tabListCapability: has(BROWSER_TABS_SHOW_CAPABILITY),
    findCapability: has(BROWSER_FIND_CAPABILITY),
    historyCapability: has(BROWSER_HISTORY_CAPABILITY),
    newTabCapability: has(BROWSER_OPEN_NEW_TAB_CAPABILITY),
    closeAllCapability: has(BROWSER_TABS_CLOSE_ALL_CAPABILITY),
  }
}

export function isBrowserControlType(type: unknown): type is BrowserControlType {
  return typeof type === "string" && Object.hasOwn(CONTROLS, type)
}

export function isBrowserControl(value: unknown): value is BrowserControlOperation {
  return typeof value === "object" && value !== null && "type" in value && isBrowserControlType(value.type)
}

export function browserControlCapabilityAvailable(type: BrowserControlType, capabilities?: readonly string[]): boolean {
  return controlOffered(CONTROLS[type], negotiatedOf(capabilities))
}

const CLOSE_ALL_UNAVAILABLE = "This phone's Browser closes one tab at a time and cannot close all tabs at once. Nothing was closed. Tell the owner, and offer to close the tab that is showing or a tab they name."
const CONTROL_UNAVAILABLE = "This phone's Browser did not offer this control. Nothing was sent."

export function browserControlRefusal(operation: BrowserControlOperation, capabilities?: readonly string[]): string | undefined {
  if (operation.type !== "browser_tab_close") return browserControlCapabilityAvailable(operation.type, capabilities) ? undefined : CONTROL_UNAVAILABLE
  const answer = browserCloseAnswer(operation, capabilities)
  return answer === "CloseProposed" ? undefined : answer === "CloseEveryRefused" ? CLOSE_ALL_UNAVAILABLE : CONTROL_UNAVAILABLE
}

export function browserNavigationAvailable(newTab: boolean, capabilities?: readonly string[]): boolean {
  return navigationOffered(newTab, negotiatedOf(capabilities))
}

function closeForm(operation: BrowserControlOperation): TabCloseForm | undefined {
  if (operation.type !== "browser_tab_close") return undefined
  return operation.all === true ? "CloseEvery" : operation.target === undefined ? "CloseShowing" : "CloseNamed"
}

export function browserControlFormAvailable(operation: BrowserControlOperation, capabilities?: readonly string[]): boolean {
  const form = closeForm(operation)
  const negotiated = negotiatedOf(capabilities)
  return form === undefined
    ? controlOffered(CONTROLS[operation.type], negotiated)
    : closeFormOffered(form, negotiated, capabilities?.includes(BROWSER_TABS_CLOSE_ALL_CAPABILITY) === true)
}

export function browserCloseAnswer(operation: BrowserControlOperation, capabilities?: readonly string[]): CloseAnswer | undefined {
  const form = closeForm(operation)
  return form === undefined ? undefined : closeAnswer(form, negotiatedOf(capabilities), capabilities?.includes(BROWSER_TABS_CLOSE_ALL_CAPABILITY) === true)
}

export function browserCloseAllNotice(closing: readonly BrowserTabLine[] | null): string | undefined {
  if (closeAllReview(closing !== null, closing?.length ?? 0) === "CloseAllCard") return undefined
  return closing === null ? BROWSER_TABS_UNLISTED_NOTICE : BROWSER_NO_TABS_TO_CLOSE_NOTICE
}

export function browserCloseAllApprovable(listedInLatestReview: readonly BrowserTabLine[] | undefined): boolean {
  return closeAllApprovable(listedInLatestReview !== undefined, listedInLatestReview?.length ?? 0)
}

export function browserControlRunsUnreviewed(operation: BrowserControlOperation, binding: { readonly boundToMessage: boolean; readonly wordsTyped: boolean }): boolean {
  return runsUnreviewed({ control: CONTROLS[operation.type], boundToMessage: binding.boundToMessage, wordsTyped: binding.wordsTyped })
}

export function browserControlBound(operation: BrowserControlOperation, words: { readonly wholeMessage: boolean; readonly wordsTyped: boolean }): boolean {
  return controlBound({ control: CONTROLS[operation.type], wholeMessage: words.wholeMessage, wordsTyped: words.wordsTyped })
}

export function browserHistoryHome(capabilities: readonly string[] | undefined, commandReachable: boolean): HistoryHome {
  return historyHome(negotiatedOf(capabilities), commandReachable)
}

export const BROWSER_RELOAD_WITHHELD_REFUSAL = "The phone shares no text of the Browser page this message carried, only its title and address, and reloading does not change that. Nothing was reloaded. Answer the owner instead: tell them you cannot read the page here. Do not offer to reload it; the owner can ask for a reload themselves."

const HISTORY_MOVES: Readonly<Record<BrowserHistoryAction, HistoryMove>> = { back: "MoveBack", forward: "MoveForward", reload: "MoveReload", stop: "MoveStop" }

function carriedPage(page: BrowserPage | undefined): CarriedPage {
  if (page === undefined) return "NoPageCarried"
  if (!("withheld" in page)) return "PageTextRead"
  return page.withheld === "sensitive-page" ? "PageTextSensitive" : "PageTextUnreadable"
}

export function browserWithheldReload(action: BrowserHistoryAction, page: BrowserPage | undefined): boolean {
  return withheldReload(HISTORY_MOVES[action], carriedPage(page))
}

export function browserCommandReloadRuns(action: BrowserHistoryAction, page: BrowserPage | undefined, surface: { readonly ownerAskedReload: boolean; readonly tabObserved: boolean }): boolean {
  return commandReloadRuns({ move: HISTORY_MOVES[action], page: carriedPage(page), ...surface })
}

export function browserReopenRefused(page: BrowserPage | undefined, destination: string, exactOpen: boolean): boolean {
  if (page === undefined || !("withheld" in page)) return false
  const current = URL.parse(page.url)
  const proposed = URL.parse(destination)
  if (current === null || proposed === null) return false
  current.hash = ""
  proposed.hash = ""
  return pageReopenRefused(carriedPage(page), current.href === proposed.href, exactOpen)
}

export function browserControlReviewNotice(context: { readonly sensitive: boolean }): string | undefined {
  return reviewAdmitted(context.sensitive) ? undefined : UNLOCK_NOTICE
}

function words(value: unknown, max: number): string | undefined {
  if (typeof value !== "string" || CONTROL_CHARACTER.test(value)) return undefined
  const text = value.trim().replace(/\s+/g, " ")
  return text !== "" && text.length <= max ? text : undefined
}

function onlyKeys(value: object, keys: readonly string[]): boolean {
  return Object.keys(value).every((key) => key === "type" || keys.includes(key))
}

function field(value: object, key: string): unknown {
  return Object.getOwnPropertyDescriptor(value, key)?.value
}

const refuse = (reason: string): BrowserParse<never> => ({ ok: false, reason })

export function parseBrowserControl(value: unknown): BrowserParse<BrowserControlOperation> {
  if (!isBrowserControl(value)) return refuse("Unsupported Browser operation")
  const accept = (operation: BrowserControlOperation): BrowserParse<BrowserControlOperation> => ({ ok: true, operation })
  switch (value.type) {
    case "browser_search": {
      if (!onlyKeys(value, ["query"])) return refuse("Unexpected Browser field")
      const query = words(field(value, "query"), BROWSER_SEARCH_QUERY_MAX)
      return query === undefined ? refuse("Invalid search query") : accept({ type: value.type, query })
    }
    case "browser_tab_new": {
      if (!onlyKeys(value, ["private"])) return refuse("Unexpected Browser field")
      const privacy = field(value, "private")
      if (privacy !== undefined && typeof privacy !== "boolean") return refuse("Invalid private tab flag")
      return accept(privacy === true ? { type: value.type, private: true } : { type: value.type })
    }
    case "browser_tab_switch": {
      if (!onlyKeys(value, ["target"])) return refuse("Unexpected Browser field")
      const target = words(field(value, "target"), BROWSER_TAB_TARGET_MAX)
      return target === undefined ? refuse("Invalid tab target") : accept({ type: value.type, target })
    }
    case "browser_tab_close": {
      if (!onlyKeys(value, ["target", "all"])) return refuse("Unexpected Browser field")
      const named = field(value, "target")
      const every = field(value, "all")
      if (every !== undefined && every !== true) return refuse("Invalid all tabs flag")
      if (every === true) return named === undefined ? accept({ type: value.type, all: true }) : refuse("Close one named tab or all tabs, not both")
      if (named === undefined) return accept({ type: value.type })
      const target = words(named, BROWSER_TAB_TARGET_MAX)
      return target === undefined ? refuse("Invalid tab target") : accept({ type: value.type, target })
    }
    case "browser_tabs_show":
      return onlyKeys(value, []) ? accept({ type: value.type }) : refuse("Unexpected Browser field")
    case "browser_find": {
      if (!onlyKeys(value, ["text"])) return refuse("Unexpected Browser field")
      const text = words(field(value, "text"), BROWSER_FIND_TEXT_MAX)
      return text === undefined ? refuse("Invalid find text") : accept({ type: value.type, text })
    }
    case "browser_history": {
      if (!onlyKeys(value, ["action"])) return refuse("Unexpected Browser field")
      const action = BROWSER_HISTORY_ACTIONS.find((known) => known === field(value, "action"))
      return action === undefined ? refuse("Invalid history action") : accept({ type: value.type, action })
    }
  }
}

export effect function validateBrowserControl(value: unknown): BrowserControlOperation!BrowserControlRefused {
  const parsed = parseBrowserControl(value)
  if (!parsed.ok) throw new BrowserControlRefused({ reason: parsed.reason })
  return parsed.operation
}

export function parseBrowserNavigate(value: unknown): BrowserParse<BrowserNavigateOperation> {
  if (typeof value !== "object" || value === null || field(value, "type") !== "browser_navigate") return refuse("Unsupported Browser operation")
  const newTab = field(value, "newTab")
  if (!onlyKeys(value, ["url", "newTab"]) || (newTab !== undefined && typeof newTab !== "boolean")) return refuse("Invalid browser destination fields")
  const typed = field(value, "url")
  const text = typeof typed === "string" && !CONTROL_CHARACTER.test(typed) ? typed.trim() : ""
  const url = text === "" || text.length > BROWSER_NAVIGATE_URL_MAX ? null : URL.parse(text)
  if (url === null || url.protocol !== "https:" || url.username !== "" || url.password !== "") return refuse("Invalid browser destination")
  return { ok: true, operation: newTab === true ? { type: "browser_navigate", url: url.href, newTab: true } : { type: "browser_navigate", url: url.href } }
}

const quoted = (value: string) => `“${value}”`
const HISTORY_TITLES: Readonly<Record<BrowserHistoryAction, string>> = { back: "Go back", forward: "Go forward", reload: "Reload page", stop: "Stop loading" }
const TAB_MATCH = "\n\nYour phone finds the tab. You pick one when more than one matches. The agent does not see your tabs."
const plural = (count: number, word: string) => `${count} ${word}${count === 1 ? "" : "s"}`

function closingList(closing: readonly BrowserTabLine[]): string {
  const named = closing.filter((tab) => tab.private !== true)
  const hidden = closing.length - named.length
  return [
    ...named.map((tab) => `• ${tab.title}${tab.host !== undefined && tab.host !== tab.title ? ` (${tab.host})` : ""}`),
    ...(hidden > 0 ? [`• ${plural(hidden, "private tab")}`] : []),
  ].join("\n")
}

export function describeBrowserControl(operation: BrowserControlOperation, closing?: readonly BrowserTabLine[]): { readonly title: string; readonly description: string } {
  switch (operation.type) {
    case "browser_search":
      return { title: "Search the web", description: `${quoted(operation.query)}\n\nOpens a web search for these words in Browser, with your search engine.` }
    case "browser_tab_new":
      return operation.private === true
        ? { title: "Open a private tab", description: "Opens an empty private tab in Browser." }
        : { title: "Open a new tab", description: "Opens an empty tab in Browser." }
    case "browser_tab_switch":
      return { title: "Switch tab", description: `Tab matching ${quoted(operation.target)}${TAB_MATCH}` }
    case "browser_tab_close":
      if (operation.all === true) {
        return closing === undefined
          ? { title: "Close all tabs", description: "Closes every open tab in Browser. The agent does not see your tabs." }
          : { title: `Close ${plural(closing.length, "tab")}`, description: `${closingList(closing)}\n\nCloses every tab listed here. The agent does not see your tabs.` }
      }
      return { title: "Close tab", description: operation.target === undefined ? "Closes the tab that is showing in Browser." : `Tab matching ${quoted(operation.target)}${TAB_MATCH}` }
    case "browser_tabs_show":
      return { title: "Show open tabs", description: "Shows the list of your open tabs in Browser. The agent does not see your tabs." }
    case "browser_find":
      return { title: "Find in page", description: `${quoted(operation.text)}\n\nShows the matches on the page that is open in Browser. The agent does not see the page.` }
    case "browser_history":
      return { title: HISTORY_TITLES[operation.action], description: "Acts on the tab that is showing in Browser." }
  }
}
