{
  "name": "@elizaos/credentials",
  "version": "2.0.3-beta.7",
  "description": "Node account authentication, credential refresh and encrypted scoped storage.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/elizaOS/eliza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elizaOS/eliza.git",
    "directory": "packages/credentials"
  },
  "keywords": [
    "elizaos",
    "vault",
    "secrets",
    "keychain"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "eliza-source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "eliza-source": "./src/auth/index.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./vault": {
      "types": "./dist/vault/index.d.ts",
      "eliza-source": "./src/vault/index.ts",
      "import": "./dist/vault/index.js",
      "default": "./dist/vault/index.js"
    },
    "./auth/*": {
      "types": "./dist/auth/*.d.ts",
      "eliza-source": "./src/auth/*.ts",
      "import": "./dist/auth/*.js",
      "default": "./dist/auth/*.js"
    },
    "./vault/*": {
      "types": "./dist/vault/*.d.ts",
      "eliza-source": "./src/vault/*.ts",
      "import": "./dist/vault/*.js",
      "default": "./dist/vault/*.js"
    },
    "./package.json": "./package.json",
    "./kms": {
      "types": "./dist/kms/index.d.ts",
      "eliza-source": "./src/kms/index.ts",
      "import": "./dist/kms/index.js",
      "default": "./dist/kms/index.js"
    }
  },
  "scripts": {
    "clean": "node ../scripts/rm-path-recursive.mjs dist",
    "prepublishOnly": "bun run build",
    "build": "node ../scripts/rm-path-recursive.mjs dist && tsc6 --noCheck -p tsconfig.build.json && node ../scripts/prepare-package-dist.mjs packages/credentials",
    "test": "node ../scripts/run-vitest.mjs run",
    "test:watch": "node ../scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vault.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/shared": "workspace:*",
    "@electric-sql/pglite": "^0.4.0",
    "@napi-rs/keyring": "^1.1.6",
    "@elizaos/plugin-assistant": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "elizaos": {
    "scripts": {
      "coreBuild": true,
      "testLanes": [
        "server"
      ]
    }
  }
}
