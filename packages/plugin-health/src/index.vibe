export error HealthReadFailed { reason: string }
export error InvalidHealthWindow

export service HealthConnector {
  observations(ownerId: string, window: HealthWindow, kind: ObservationKind): HealthObservation[]!HealthReadFailed
}

export interface IntervalSummary {
  readonly observations: readonly HealthObservation[]
  readonly coveredMs: number
}

export effect function summarizeIntervals(
  ownerId: string,
  window: HealthWindow,
  kind: ObservationKind,
): IntervalSummary!(HealthReadFailed | InvalidHealthWindow)!HealthConnector {
  if (!Number.isSafeInteger(window.fromMs) || !Number.isSafeInteger(window.untilMs) || !validHealthWindow(window)) {
    throw new InvalidHealthWindow()
  }
  if (ownerId === "") return { observations: [], coveredMs: 0 }
  const connector = try HealthConnector
  const observations = observationsFor(try connector.observations(ownerId, window, kind), ownerId, window, kind)
  const spans = observations.map(({ span }) => span).sort((left, right) => left.fromMs - right.fromMs)
  return { observations, coveredMs: intervalCoverage(spans, window) }
}

export function screenSignalIsActive(signal: ScreenSignal) {
  return countsAsScreenUse(signal)
}

export type HealthPlugin = Plugin & { readonly routes: readonly HealthRoute[] }

export function createHealthPlugin(): HealthPlugin {
  let startedRuntime: IAgentRuntime | undefined
  const activeService = () => (startedRuntime === undefined ? undefined : healthServiceOf(startedRuntime))
  return {
    name: HEALTH_PLUGIN_NAME,
    description: "Owner health metrics, wearable connector OAuth/sync, sleep regularity, circadian insights, and screen-time summaries.",
    services: [HealthService],
    actions: [healthAction, screenTimeAction],
    providers: [healthProvider],
    routes: healthRoutes(activeService),
    init: async (_config, runtime) => {
      startedRuntime = runtime
      if (runtime.contexts && typeof runtime.contexts.tryRegister === "function") {
        runtime.contexts.tryRegister(healthContext)
      }
    },
    dispose: async () => {
      const svc = activeService()
      startedRuntime = undefined
      if (svc !== undefined) await svc.stop()
    },
  }
}

export const healthPlugin: HealthPlugin = createHealthPlugin()
export default healthPlugin
