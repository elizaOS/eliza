// spec/health/index.md, "Interval summaries include only valid observations for the owner and requested time range"; spec/health/lifecycle.md, "Connector authorization and sync transitions enforce owner consent and monotonic revisions"
import {
  decryptTokenEnvelope,
  encryptTokenPayload,
  generatePkcePair,
  isEncryptedTokenEnvelope,
  randomStateToken,
  resolveTokenEncryptionKey,
  type EncryptedTokenEnvelope,
} from "./crypto.vibe"
import type {
  HealthConnectorCapability,
  HealthConnectorKind,
  HealthMetricSample,
  HealthOAuthProvider,
  HealthSleepEpisode,
  HealthWorkout,
} from "./types.vibe"

export interface HealthOAuthSpec {
  readonly authorizeUrl: string
  readonly tokenUrl: string
  readonly revokeUrl: string | null
  readonly defaultScopes: readonly string[]
  readonly scopeSeparator: "comma" | "space"
  readonly usePkce: boolean
  readonly tokenRequestStyle: "form" | "basic" | "withings"
}

export interface HealthProviderSpec {
  readonly provider: HealthOAuthProvider
  readonly envPrefix: string
  readonly oauth: HealthOAuthSpec
  readonly apiBaseUrl: string
  readonly capabilities: readonly HealthConnectorCapability[]
}

export interface StoredHealthConnectorToken {
  readonly provider: HealthOAuthProvider
  readonly ownerId: string
  readonly clientId: string
  readonly clientSecret: string | null
  readonly redirectUri: string
  readonly accessToken: string
  readonly refreshToken: string | null
  readonly tokenType: string
  readonly grantedScopes: readonly string[]
  readonly expiresAt: number | null
  readonly updatedAt: string
}

export interface PendingOAuthSession {
  readonly state: string
  readonly provider: HealthOAuthProvider
  readonly ownerId: string
  readonly clientId: string
  readonly clientSecret: string | null
  readonly redirectUri: string
  readonly codeVerifier: string | null
  readonly authorizeUrl: string
  readonly createdAt: number
}

export interface NormalizedProviderPayload {
  readonly samples: readonly HealthMetricSample[]
  readonly sleepEpisodes: readonly HealthSleepEpisode[]
  readonly workouts: readonly HealthWorkout[]
}

export const HEALTH_CONNECTOR_LABELS: Readonly<Record<HealthConnectorKind, string>> = {
  apple_health: "Apple Health (HealthKit)",
  google_fit: "Google Fit",
  strava: "Strava",
  fitbit: "Fitbit",
  withings: "Withings",
  oura: "Oura",
}

