  apple_health: ["health.sleep.read", "health.activity.read", "health.workouts.read", "health.body.read", "health.vitals.read"],
  google_fit: ["health.sleep.read", "health.activity.read", "health.workouts.read", "health.body.read", "health.vitals.read"],
  strava: ["health.activity.read", "health.workouts.read"],
  fitbit: ["health.sleep.read", "health.activity.read", "health.workouts.read", "health.body.read", "health.vitals.read", "health.readiness.read"],
  withings: ["health.sleep.read", "health.body.read", "health.vitals.read"],
  oura: ["health.sleep.read", "health.activity.read", "health.workouts.read", "health.readiness.read", "health.body.read", "health.vitals.read"],
}

