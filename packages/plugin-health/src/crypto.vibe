// spec/health/lifecycle.md, "Connector authorization and sync transitions enforce owner consent and monotonic revisions"

module node {
  import * as crypto from "node:crypto"
  import * as fs from "node:fs"
  import * as path from "node:path"

  const KEY_ENV_VAR = "ELIZA_TOKEN_ENCRYPTION_KEY"
  const KEY_FILENAME = ".encryption-key"
  const KEY_BYTES = 32
  const IV_BYTES = 12
  const AUTH_TAG_BYTES = 16

  export interface EncryptedTokenEnvelope {
    readonly __enc: "aes-256-gcm"
    readonly v: 1
    readonly iv: string
    readonly tag: string
    readonly ct: string
  }

  function decodeKeyMaterial(raw: string): Buffer | undefined {
    const trimmed = raw.trim()
    if (/^[0-9a-fA-F]+$/u.test(trimmed) && trimmed.length === KEY_BYTES * 2) {
      return Buffer.from(trimmed, "hex")
    }
    const buf = Buffer.from(trimmed, "base64")
    return buf.length === KEY_BYTES ? buf : undefined
  }

  /** @throws {never} */
  export function isEncryptedTokenEnvelope(value: unknown): value is EncryptedTokenEnvelope {
    if (typeof value !== "object" || value === null) return false
    const record = value as Record<string, unknown>
    return (
      record.__enc === "aes-256-gcm" &&
      record.v === 1 &&
      typeof record.iv === "string" &&
      typeof record.tag === "string" &&
      typeof record.ct === "string"
    )
  }

  /** @throws {never} */
  export function resolveTokenEncryptionKey(credentialsDir?: string, envKey?: string): Buffer | undefined {
    const rawEnv = envKey ?? process.env[KEY_ENV_VAR]
    if (typeof rawEnv === "string" && rawEnv.trim() !== "") {
      return decodeKeyMaterial(rawEnv)
    }
    if (credentialsDir === undefined || credentialsDir.trim() === "") {
      return crypto.randomBytes(KEY_BYTES)
    }
    const filePath = path.join(credentialsDir, KEY_FILENAME)
    try {
      const existing = fs.readFileSync(filePath, "utf8")
      return decodeKeyMaterial(existing)
    } catch (cause) {
      const isMissing = cause instanceof Error && "code" in cause && (cause as { code?: unknown }).code === "ENOENT"
      if (!isMissing) return undefined
    }
    try {
      fs.mkdirSync(credentialsDir, { recursive: true, mode: 0o700 })
      const generated = crypto.randomBytes(KEY_BYTES)
      const tempPath = `${filePath}.${crypto.randomUUID()}.tmp`
      fs.writeFileSync(tempPath, generated.toString("base64"), { mode: 0o600 })
      try {
        fs.linkSync(tempPath, filePath)
        fs.unlinkSync(tempPath)
        return generated
      } catch {
        try { fs.unlinkSync(tempPath) } catch { return decodeKeyMaterial(fs.readFileSync(filePath, "utf8")) }
        return decodeKeyMaterial(fs.readFileSync(filePath, "utf8"))
      }
    } catch {
      return undefined
    }
  }

  /** @throws {never} */
  export function encryptTokenPayload(payload: unknown, key: Buffer): EncryptedTokenEnvelope | undefined {
    if (key.length !== KEY_BYTES) return undefined
    try {
      const iv = crypto.randomBytes(IV_BYTES)
      const cipher = crypto.createCipheriv("aes-256-gcm", key, iv, { authTagLength: AUTH_TAG_BYTES })
      const plaintext = Buffer.from(JSON.stringify(payload), "utf8")
      const ct = Buffer.concat([cipher.update(plaintext), cipher.final()])
      const tag = cipher.getAuthTag()
      return {
        __enc: "aes-256-gcm",
        v: 1,
        iv: iv.toString("base64"),
        tag: tag.toString("base64"),
        ct: ct.toString("base64"),
      }
    } catch {
      return undefined
    }
  }

  /** @throws {never} */
  export function decryptTokenEnvelope(envelope: EncryptedTokenEnvelope, key: Buffer): unknown | undefined {
    if (key.length !== KEY_BYTES) return undefined
    try {
      const iv = Buffer.from(envelope.iv, "base64")
      const tag = Buffer.from(envelope.tag, "base64")
      const ct = Buffer.from(envelope.ct, "base64")
      if (iv.length !== IV_BYTES || tag.length !== AUTH_TAG_BYTES) return undefined
      const decipher = crypto.createDecipheriv("aes-256-gcm", key, iv, { authTagLength: AUTH_TAG_BYTES })
      decipher.setAuthTag(tag)
      const decrypted = Buffer.concat([decipher.update(ct), decipher.final()])
      return JSON.parse(decrypted.toString("utf8")) as unknown
    } catch {
      return undefined
    }
  }

  /** @throws {never} */
  export function generatePkcePair(): { readonly verifier: string; readonly challenge: string } {
    const verifier = crypto.randomBytes(32).toString("base64url")
    const challenge = crypto.createHash("sha256").update(verifier).digest("base64url")
    return { verifier, challenge }
  }

  /** @throws {never} */
  export function randomStateToken(): string {
    return crypto.randomBytes(16).toString("hex")
  }
}

import {
  decryptTokenEnvelope,
  encryptTokenPayload,
  generatePkcePair,
  isEncryptedTokenEnvelope,
  randomStateToken,
  resolveTokenEncryptionKey,
  type EncryptedTokenEnvelope,
} from node

export {
  decryptTokenEnvelope,
  encryptTokenPayload,
  generatePkcePair,
  isEncryptedTokenEnvelope,
  randomStateToken,
  resolveTokenEncryptionKey,
  type EncryptedTokenEnvelope,
}
