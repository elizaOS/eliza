{
  "compilerOptions": {
    "customConditions": ["eliza-source"],
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": ["node", "bun", "react", "react-dom"],
    "declaration": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@elizaos/core/*": ["../core/src/*"],
      "@elizaos/plugin-native-phone/*": [
        "../../plugins/plugin-native-phone/src/*"
      ],
      "@elizaos/plugin-coding-tools/*": [
        "../../plugins/plugin-coding-tools/src/*"
      ],
      "@elizaos/ui/*": ["../ui/src/*"],
      "@elizaos/ui/api/client-types-cloud": [
        "../ui/src/api/client-types-cloud.ts"
      ],
      "@elizaos/agent/*": ["./src/*"],
      "@elizaos/auth/auth/*": ["../auth/src/auth/*"],
      "@elizaos/plugin-discord/*": ["../../plugins/plugin-discord/*"],
      "@elizaos/plugin-elizacloud/*": ["../../plugins/plugin-elizacloud/src/*"],
      "@elizaos/capacitor-*": ["../../plugins/plugin-native-*/src/index.ts"],
      "@elizaos/plugin-local-inference/*": [
        "../../plugins/plugin-local-inference/src/*"
      ],
      "@elizaos/cloud-sdk/*": ["../cloud/sdk/src/*"]
    }
  },
  "include": ["src", "test", "scripts/**/*.test.ts"]
}
