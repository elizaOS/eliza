// spec/agent/host/launch.md, "Story: Start the agent from one launch document"
import type { LaunchDocument as LaunchModel } from "../../gen/agent__host__launch.ts"
import type { LaunchDocument } from "./launch.schema.vibe"

export function launchChoices(launch: LaunchDocument): Pick<LaunchModel, "embeddings" | "persistMemory" | "callerRole" | "google"> {
  return {
    embeddings: launch.embeddings === "local" ? { tag: "LocalEmbeddings", dimensions: launch.embeddingDimensions ?? 0 } : { tag: "NoEmbeddings" },
    persistMemory: launch.persistMemory ?? false,
    callerRole: launch.callerRole === "owner" ? "ChatAsOwner" : "ChatAsUser",
    google: { gmailChanges: launch.google?.gmailChanges ?? false, calendarEdits: launch.google?.calendarEdits ?? false },
  }
}
