// spec/agent/views.md, "Story: Declare my views once"; spec/agent/views.md, "Story: Switch to the view the agent named"; spec/agent/views.md, "Closing ends every pending request with the outcome Stopped, and nothing changes after"; spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"
import { Service, type IAgentRuntime } from "@elizaos/core"
import { ModuleRefused, type AgentModule, type ModuleFactory, type PublishEvent, type ViewFeeds } from "../host/module.vibe"
import { declareViews, viewsModuleName } from "./declarations.vibe"
import { makeViewHost, type ViewFeedPort, type ViewHost } from "./host.vibe"
import { viewRoutes } from "./routes.vibe"
import { viewsShowAction } from "./show-action.vibe"

export { viewsModuleName }

export const viewHostServiceType = "agent_view_host"

const viewInteractStream = "view-interact"

function feedsOf(publishEvent: PublishEvent, viewFeeds: ViewFeeds): ViewFeedPort {
  return {
    publish: effect (clientId, frame) => {
      try Effect.try(() => publishEvent(viewInteractStream, frame, clientId))
    },
    receivers: (clientId) => viewFeeds.receivers(clientId),
    onRendererClosed: (clientId, closed) => { viewFeeds.onRendererClosed(clientId, closed) },
  }
}

function hostService(views: ViewHost.Shape) {
  return class ViewHostService extends Service {
    static override serviceType = viewHostServiceType
    override capabilityDescription = "The owner's declared views, and the navigations and questions the agent waits on"
    readonly views = views

    static override start(runtime: IAgentRuntime): Promise<Service> {
      return Promise.resolve(new ViewHostService(runtime))
    }

    override stop(): Promise<void> {
      return runPromise(views.close())
    }
  }
}

export const viewsModule: ModuleFactory<never> = effect (context) => {
  const declared = try declareViews(context.runtime.plugins, context.launch.views ?? [])
  const { publishEvent, viewFeeds } = context
  if (publishEvent === undefined || viewFeeds === undefined) {
    throw new ModuleRefused({ module: viewsModuleName, reason: "The agent has no event publisher for view interactions" })
  }
  const views = try makeViewHost(feedsOf(publishEvent, viewFeeds))
  try views.boot(declared.views)
  return {
    name: viewsModuleName,
    plugin: {
      name: viewsModuleName,
      description: "The owner's views: prepare, claim and confirm navigations, and the VIEWS show action",
      services: [hostService(views)],
      actions: [viewsShowAction(views, declared.labels)],
      routes: viewRoutes(views),
    },
  } satisfies AgentModule
}
