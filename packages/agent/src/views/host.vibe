// spec/agent/views.md, "A navigation is prepared only for a declared view and a request id not seen before"; spec/agent/views.md, "Preparing again supersedes the client's unclaimed navigation and is refused while one is claimed"; spec/agent/views.md, "A claim names its request's exact binding and succeeds once"; spec/agent/views.md, "A result is accepted once, with its claim id, and a navigation result says whether it switched"; spec/agent/views.md, "Only a confirmed switch sets the shown view, and a navigation lost after its claim makes it unknown"; spec/agent/views.md, "The agent asks only a declared view, for a capability the view grants the agent, on a live feed"; spec/agent/views.md, "A request whose renderer left, whose delivery failed or whose wait ran out ends unknown and never changes again"; spec/agent/views.md, "Closing ends every pending request with the outcome Stopped, and nothing changes after"
import { logger } from "@elizaos/core"
import {
  Machine, busy, interactionWaitMs, machine, navigationBusyWaitMs, navigationClaimLeaseMs, navigationWaitMs, openNavigationOf, shownViewOf, waiterAt,
  type Binding, type CapabilityGrant, type DeclaredView, type Event, type Reply, type ViewHost as ViewHostState, type WaitOutcome,
} from "../../gen/agent__views.effect.vibe"

module node {
  import { randomUUID } from "node:crypto"
  /** @throws {never} */
  export function newViewId(): string { return randomUUID() }
}
import { newViewId } from node

export interface ViewBinding extends Binding {
  readonly viewType: "gui"
}

export interface ViewInteractFrame {
  readonly type: "view:interact"
  readonly installationId: string
  readonly viewId: string
  readonly viewType: "gui"
  readonly capability: string
  readonly params: Readonly<Record<string, unknown>>
  readonly requestId: string
}

export interface ViewAnswer {
  readonly success: boolean
  readonly result?: unknown
  readonly error?: string
}

export type WaitResult =
  | { readonly kind: "Replied"; readonly reply: Reply; readonly answer: ViewAnswer }
  | { readonly kind: "Unknown" }
  | { readonly kind: "Superseded" }
  | { readonly kind: "Stopped" }

export interface PendingView {
  readonly binding: ViewBinding
  readonly wait: WaitResult!!
}

export type Asked =
  | { readonly kind: "asked"; readonly binding: ViewBinding; readonly wait: WaitResult!! }
  | { readonly kind: "unavailable" }
  | { readonly kind: "refused" }

export interface ViewAsk {
  readonly clientId: string
  readonly viewId: string
  readonly capability: string
  readonly params: Readonly<Record<string, unknown>>
  readonly grant: CapabilityGrant
}

export interface ViewFeedPort {
  readonly publish: (clientId: string, frame: ViewInteractFrame) => void!unknown
  readonly receivers: (clientId: string) => number
  readonly onRendererClosed: (clientId: string, closed: () => void) => void
}

export service ViewHost {
  static readonly key = "@elizaos/agent/views/ViewHost"
  boot(views: DeclaredView[]): boolean!!
  prepare(requestId: string, clientId: string, viewId: string): (PendingView | undefined)!!
  show(requestId: string, clientId: string, target: string): (PendingView | undefined)!!
  claim(binding: Binding): (string | undefined)!!
  answer(binding: Binding, claimId: string, reply: Reply, answer: ViewAnswer): boolean!!
  ask(request: ViewAsk): Asked!!
  abandon(requestId: string): boolean!!
  shownViewOf(clientId: string): (string | undefined)!!
  current(): ViewHostState!!
  close(): void!!
}

export function replyOf(answer: ViewAnswer): Reply {
  const result = answer.result
  if (typeof result !== "object" || result === null || !("switched" in result) || typeof result.switched !== "boolean") return "Answered"
  return answer.success && result.switched ? "Switched" : "NotSwitched"
}

interface Waiting {
  readonly done: Deferred.Deferred<WaitResult>
  answered?: { readonly reply: Reply; readonly answer: ViewAnswer }
}

function resultOf(outcome: WaitOutcome, waiting: Waiting): WaitResult | undefined {
  switch (outcome) {
    case "Waiting": return undefined
    case "Replied": return waiting.answered === undefined ? undefined : { kind: "Replied", ...waiting.answered }
    case "Unknown": return { kind: "Unknown" }
    case "Superseded": return { kind: "Superseded" }
    case "Stopped": return { kind: "Stopped" }
    default: {
      const unreachable: never = outcome
      return unreachable
    }
  }
}

function bindingOf(state: ViewHostState, requestId: string): ViewBinding {
  const { clientId, viewId, installationId } = waiterAt(state, requestId).req
  return { requestId, clientId, viewId, installationId, viewType: "gui" }
}

effect function viewMachine() {
  provide machine() {
    return try Machine
  }
}

export effect function makeViewHost(port: ViewFeedPort, newId: () => string = newViewId) {
  const views = try viewMachine()
  const waiting = new Map<string, Waiting>()
  const watched = new Set<string>()

  effect function settle(state: ViewHostState) {
    for (const [requestId, entry] of [...waiting]) {
      const result = resultOf(waiterAt(state, requestId).outcome, entry)
      if (result === undefined) continue
      waiting.delete(requestId)
      try Deferred.succeed(entry.done, result)
    }
  }

  effect function send(event: Event) {
    const state = views.send(event) catch () => undefined
    if (state !== undefined) try settle(state)
    return state
  }

  effect function abandonOne(requestId: string) {
    return (try send({ type: "abandonRequest", requestId })) !== undefined
  }

  effect function abandonClient(clientId: string) {
    const state = try views.get()
    for (const requestId of [...waiting.keys()]) {
      if (waiterAt(state, requestId).req.clientId === clientId) try abandonOne(requestId)
    }
  }

  effect function expire(requestId: string, done: Deferred.Deferred<WaitResult>, waitMs: number) {
    const ended = try raceFirst(as(sleep(Duration.millis(waitMs)), true), as(Deferred.await(done), false))
    if (ended) try abandonOne(requestId)
  }

  effect function wait(state: ViewHostState, requestId: string, waitMs: number) {
    const done = Deferred.makeUnsafe<WaitResult>()
    waiting.set(requestId, { done })
    const clientId = waiterAt(state, requestId).req.clientId
    if (!watched.has(clientId)) {
      watched.add(clientId)
      port.onRendererClosed(clientId, () => { runFork(abandonClient(clientId)) })
    }
    fork.detached expire(requestId, done, waitMs)
    return { binding: bindingOf(state, requestId), wait: Deferred.await(done) }
  }

  effect function settledFor(clientId: string) {
    const state = try views.get()
    const claimed = busy(state, clientId) ? waiting.get(openNavigationOf(state, clientId)) : undefined
    if (claimed !== undefined) try timeoutOption(Deferred.await(claimed.done), navigationBusyWaitMs)
  }

  effect function navigation(event: Event, requestId: string, clientId: string) {
    try settledFor(clientId)
    const state = try send(event)
    return state === undefined ? undefined : try wait(state, requestId, navigationWaitMs)
  }

  effect function publish(clientId: string, frame: ViewInteractFrame) {
    const sent = try exit(port.publish(clientId, frame))
    if (sent._tag === "Success") return
    logger.warn({ src: "views", clientId, requestId: frame.requestId, viewId: frame.viewId }, "View interact frame was not delivered")
    try abandonOne(frame.requestId)
  }

  const host: ViewHost.Shape = {
    boot: effect (declared: DeclaredView[]) => (try send({ type: "bootViews", views: declared })) !== undefined,
    prepare: (requestId: string, clientId: string, viewId: string) =>
      navigation({ type: "prepareNavigation", requestId, clientId, viewId }, requestId, clientId),
    show: (requestId: string, clientId: string, target: string) =>
      navigation({ type: "showView", requestId, clientId, target }, requestId, clientId),
    claim: effect (binding: Binding) => {
      const claimId = newId()
      const state = try send({ type: "claimRequest", binding, claimId })
      if (state === undefined) return undefined
      const entry = waiting.get(binding.requestId)
      if (entry !== undefined && waiterAt(state, binding.requestId).kind === "Navigation") fork.detached expire(binding.requestId, entry.done, navigationClaimLeaseMs)
      return claimId
    },
    answer: effect (binding: Binding, claimId: string, reply: Reply, answer: ViewAnswer) => {
      const entry = waiting.get(binding.requestId)
      if (entry !== undefined) entry.answered = { reply, answer }
      const state = try send({ type: "answerRequest", binding, claimId, reply })
      if (state === undefined && entry !== undefined) entry.answered = undefined
      return state !== undefined
    },
    ask: effect (request: ViewAsk) => {
      const requestId = newId()
      const subscribed = port.receivers(request.clientId) > 0
      const state = try send({
        type: "askView", requestId, clientId: request.clientId, viewId: request.viewId,
        capability: request.capability, grant: request.grant, subscribed,
      })
      if (state === undefined) return subscribed ? { kind: "refused" } as const : { kind: "unavailable" } as const
      const pending = try wait(state, requestId, interactionWaitMs)
      try publish(request.clientId, {
        type: "view:interact", installationId: pending.binding.installationId, viewId: request.viewId, viewType: "gui",
        capability: request.capability, params: request.params, requestId,
      })
      return { kind: "asked", ...pending } as const
    },
    abandon: abandonOne,
    shownViewOf: effect (clientId: string) => {
      const shown = shownViewOf(try views.get(), clientId)
      return shown === "" ? undefined : shown
    },
    current: () => views.get(),
    close: effect () => {
      try send({ type: "closeHost" })
    },
  }
  return host
}
