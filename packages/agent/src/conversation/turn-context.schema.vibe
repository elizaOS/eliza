// spec/agent/conversation/turnContext.md, "Story: Tell the agent what my screen shows, and nothing more"; spec/agent/conversation/turnContext.md, "A Browser page is kept only when every field is valid, it is the Browser tab the kept observation selects at that revision on a screen not sensitive, and it fits 16,384 bytes"; spec/agent/conversation/turnContext.md, "A reviewed email is kept only when every field is valid and it fits 48,000 bytes"; spec/agent/conversation/turnContext.md, "A voice-note transcript flag is kept only when true and bound to a selected canonical note on a non-sensitive screen"; spec/agent/conversation/turnContext.md, "An observation is kept only when every field is valid, a sensitive screen names no record, a civil day is on the calendar stated not sensitive in its own zone, and it fits 2,048 bytes"; spec/agent/conversation/turnContext.md, "A voice view context is accepted only when every stated field has an allowed value and direct requests have completed-action delivery and a routing identity"; spec/agent/conversation/turnContext.md, "Optional fields go only to the process instance the client compared for this turn"; spec/agent/conversation/turnContext.md, "A location is kept on any screen only when each coordinate, its accuracy and its time are in range, and it counts within the 2,048 bytes"
import type { Content } from "@elizaos/core"
import { parseViewInteractionClientId } from "@elizaos/core"
import {
  browserPageAccepted, comparePeer, emptyTextTurnAccepted, learnPeer, maxSafeInteger, observationOutcome, reviewedEmailAccepted, sendsOptionalFields, unauthoredTurnAllowsCall, voiceNoteTranscriptAccepted, voiceUiOutcome,
  type BrowserPageFacts, type NoteBinding, type ObservationFacts, type PageBinding, type PageContent, type PeerSupport, type ReviewedEmailFacts, type Sensitivity, type StatusRead, type TextField, type VoiceNoteTranscriptFacts, type VoiceUiFacts,
} from "../../gen/agent__conversation__turnContext.effect.vibe"

export { comparePeer, emptyTextTurnAccepted, learnPeer, sendsOptionalFields, unauthoredTurnAllowsCall, type PeerSupport, type StatusRead }

const Name = Schema.String.check(Schema.isPattern(/^[a-z][a-z0-9-]{0,63}$/))
const Identifier = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9][A-Za-z0-9._:@=+-]{0,511}$/))
const Token = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9][A-Za-z0-9._:@=+-]{0,255}$/))
const RecordRevision = Schema.String.check(Schema.isMaxLength(256), Schema.isPattern(/^(?:[A-Za-z0-9][A-Za-z0-9._:@=+-]{0,255}|(?:W\/)?"[!#-~]+")$/))
const ZoneName = Schema.String.check(Schema.isMaxLength(64), Schema.isPattern(/^[A-Za-z][A-Za-z0-9_+-]*(?:\/[A-Za-z0-9_+-]+){0,3}$/))

const SelectedObject = Schema.Struct({
  kind: Name,
  id: Identifier,
  revision: Schema.optionalKey(RecordRevision),
  accountId: Schema.optionalKey(Token),
  sourceRevision: Schema.optionalKey(Token),
  occurrenceId: Schema.optionalKey(Token),
  timingVersion: Schema.optionalKey(Schema.Literal(2)),
})
const CalendarDay = Schema.Struct({ date: Schema.String.check(Schema.isPattern(/^\d{4}-\d{2}-\d{2}$/)), timeZone: ZoneName })
const between = (minimum: number, maximum: number) => Schema.Number.check(Schema.isBetween({ minimum, maximum }))
const Location = Schema.Struct({
  latitude: between(-90, 90),
  longitude: between(-180, 180),
  accuracyMeters: Schema.optionalKey(between(0, 1_000_000)),
  capturedAt: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: maxSafeInteger })),
})

export const Observation = Schema.Struct({
  view: Name,
  revision: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: maxSafeInteger })),
  sensitive: Schema.Boolean,
  timeZone: Schema.optionalKey(ZoneName),
  selectedObject: Schema.optionalKey(SelectedObject),
  calendarDay: Schema.optionalKey(CalendarDay),
  location: Schema.optionalKey(Location),
})

const plainLine = (value: string) => value.isWellFormed() && !/[\p{Cc}\u2028\u2029]/u.test(value)
const plainLines = (value: string) => value.isWellFormed() && !/[^\P{Cc}\t\n]|[\u2028\u2029]/u.test(value)
const emailPlainLines = (value: string) => value.isWellFormed() && !/[^\P{Cc}\t\n\r]|[\u2028\u2029]/u.test(value)
const line = (max: number) => Schema.String.check(Schema.isMaxLength(max), Schema.makeFilter(plainLine))
const lines = (max: number) => Schema.String.check(Schema.isMaxLength(max), Schema.makeFilter(plainLines))
const emailLines = (max: number) => Schema.String.check(Schema.isMaxLength(max), Schema.makeFilter(emailPlainLines))

function webPageAddress(value: string): boolean {
  const parsed = value.length <= 2048 && !value.includes("#") ? URL.parse(value) : null
  return parsed !== null && parsed.protocol === "https:" && parsed.hostname !== "" && parsed.username === "" && parsed.password === "" && parsed.href === value
}

const PageAddress = Schema.String.check(Schema.makeFilter(webPageAddress, {
  arbitraryConstraint: { minLength: 32, patterns: [{ source: /^https:\/\/(?:[a-z][a-z0-9.-]*\.[a-z]{2,8}|127\.0\.0\.1|\[::1\])(?::[1-9][0-9]{3})?\/[a-zA-Z0-9_/?=&-]*$/.source, flags: "" }] },
}))
const PageLink = Schema.Struct({ text: line(120).check(Schema.makeFilter((value: string) => value.trim() !== "")), url: PageAddress })
const pageFields = {
  tabId: Token,
  revision: Token,
  url: PageAddress,
  title: line(300),
  capturedAt: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: maxSafeInteger })),
}
const ReadPage = Schema.Struct({
  ...pageFields,
  text: lines(6000),
  truncated: Schema.Boolean,
  selection: Schema.optionalKey(lines(1000)),
  links: Schema.optionalKey(Schema.Array(PageLink).check(Schema.isMaxLength(20))),
})
const WithheldPage = Schema.Struct({ ...pageFields, withheld: Schema.Literals(["sensitive-page", "unreadable"]) })

export const BrowserPage = Schema.Union([ReadPage, WithheldPage])
export type BrowserPage = typeof BrowserPage.Type

export const ReviewedEmail = Schema.Struct({
  from: line(512),
  to: Schema.Array(line(512)).check(Schema.isMaxLength(50)),
  subject: line(1000),
  bodyText: emailLines(48_000),
})
export type ReviewedEmail = typeof ReviewedEmail.Type

export const VoiceUiContext = Schema.Struct({
  uiViewPath: Schema.optionalKey(Schema.String),
  uiViewSubview: Schema.optionalKey(Schema.String),
  uiTimeZone: Schema.optionalKey(Schema.String),
  uiBrowserSurface: Schema.optionalKey(Schema.Literal("native")),
  viewDelivery: Schema.optionalKey(Schema.Literal("completed-action")),
  uiClientId: Schema.optionalKey(Schema.String),
  agentActionMode: Schema.optionalKey(Schema.Literals(["direct-request-v1", "direct-files-v1", "direct-files-only-v1"])),
  uiNotesEditor: Schema.optionalKey(Schema.Literal("saved-note-v1")),
})

export type Observation = typeof Observation.Type
export type VoiceUiContext = typeof VoiceUiContext.Type
export type LocationObservation = typeof Location.Type
type SelectedObject = typeof SelectedObject.Type

export interface TurnContext {
  readonly observation?: Observation
  readonly voiceUi?: VoiceUiContext
  readonly browserPage?: BrowserPage
  readonly reviewedEmail?: ReviewedEmail
  readonly useSelectedVoiceNoteTranscript?: true
}

export error ObservationDropped { facts: ObservationFacts | undefined }
export error BrowserPageDropped { facts: BrowserPageFacts | undefined }
export error ReviewedEmailDropped { facts: ReviewedEmailFacts | undefined }
export error VoiceNoteTranscriptDropped { facts: VoiceNoteTranscriptFacts | undefined }
export error VoiceUiContextInvalid { facts: VoiceUiFacts | undefined }

type Decided<A, F> = { readonly kind: "carried"; readonly value: A } | { readonly kind: "refused"; readonly facts: F | undefined }

const observationKeys: ReadonlySet<string> = new Set(["view", "revision", "sensitive", "timeZone", "selectedObject", "calendarDay", "location"])
const strict = { onExcessProperty: "error" } as const
const selectedObjectOf = Schema.decodeUnknownOption(SelectedObject, strict)
const calendarDayOf = Schema.decodeUnknownOption(CalendarDay, strict)
const locationOf = Schema.decodeUnknownOption(Location, strict)
const browserPageOf = Schema.decodeUnknownOption(BrowserPage, strict)
const reviewedEmailOf = Schema.decodeUnknownOption(ReviewedEmail, strict)
const browserPageKeys: ReadonlySet<string> = new Set(["tabId", "revision", "url", "title", "capturedAt", "withheld", "text", "truncated", "selection", "links"])
const reviewedEmailKeys: ReadonlySet<string> = new Set(["from", "to", "subject", "bodyText"])
const pageContentKeys = ["text", "truncated", "selection", "links"] as const
const isName = Schema.is(Name)
const isZoneName = Schema.is(ZoneName)

function table(value: unknown): Readonly<Record<string, unknown>> | undefined {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Readonly<Record<string, unknown>> : undefined
}

export function knownZone(name: unknown): name is string {
  if (!isZoneName(name)) return false
  try {
    new Intl.DateTimeFormat("en-US", { timeZone: name })
    return true
  } catch {
    return false
  }
}

function civilDate(date: string) {
  const year = Number(date.slice(0, 4)), month = Number(date.slice(5, 7)), day = Number(date.slice(8, 10))
  const civil = new Date(Date.UTC(year, month - 1, day))
  return year >= 1970 && civil.getUTCFullYear() === year && civil.getUTCMonth() === month - 1 && civil.getUTCDate() === day
}

function canonicalSelection(selection: SelectedObject): SelectedObject {
  return {
    kind: selection.kind,
    id: selection.id,
    ...(selection.revision === undefined ? {} : { revision: selection.revision }),
    ...(selection.accountId === undefined ? {} : { accountId: selection.accountId }),
    ...(selection.sourceRevision === undefined ? {} : { sourceRevision: selection.sourceRevision }),
    ...(selection.occurrenceId === undefined ? {} : { occurrenceId: selection.occurrenceId }),
    ...(selection.timingVersion === undefined ? {} : { timingVersion: selection.timingVersion }),
  }
}

function canonical(observation: Observation): Observation {
  return {
    view: observation.view,
    revision: observation.revision,
    sensitive: observation.sensitive,
    ...(observation.timeZone === undefined ? {} : { timeZone: observation.timeZone }),
    ...(observation.selectedObject === undefined ? {} : { selectedObject: canonicalSelection(observation.selectedObject) }),
    ...(observation.calendarDay === undefined ? {} : { calendarDay: { date: observation.calendarDay.date, timeZone: observation.calendarDay.timeZone } }),
    ...(observation.location === undefined ? {} : { location: canonicalLocation(observation.location) }),
  }
}

function canonicalLocation(location: LocationObservation): LocationObservation {
  return {
    latitude: location.latitude,
    longitude: location.longitude,
    ...(location.accuracyMeters === undefined ? {} : { accuracyMeters: location.accuracyMeters }),
    capturedAt: location.capturedAt,
  }
}

function withoutOptionalFields({ calendarDay: _day, location: _location, ...observation }: Observation): Observation {
  return observation
}

function utf8Bytes(observation: Observation) {
  return new TextEncoder().encode(JSON.stringify(observation)).byteLength
}

function decideObservation(input: unknown): Decided<Observation, ObservationFacts> {
  const fields = table(input)
  if (fields === undefined) return { kind: "refused", facts: undefined }
  const { view, revision, sensitive, timeZone, selectedObject, calendarDay, location } = fields
  const sensitivity: Sensitivity | undefined = sensitive === undefined ? "SensitivityUnstated" : sensitive === true ? "Sensitive" : sensitive === false ? "NotSensitive" : undefined
  const counted = typeof revision === "number" && Number.isInteger(revision) ? revision : undefined
  const selection = selectedObject === undefined ? undefined : Option.getOrUndefined(selectedObjectOf(selectedObject))
  const stated = calendarDay === undefined ? undefined : Option.getOrUndefined(calendarDayOf(calendarDay))
  const day = stated !== undefined && civilDate(stated.date) && knownZone(stated.timeZone) ? stated : undefined
  const position = location === undefined ? undefined : Option.getOrUndefined(locationOf(location))
  const core = canonical({
    view: isName(view) ? view : "",
    revision: counted ?? 0,
    sensitive: sensitive === true,
    ...(knownZone(timeZone) ? { timeZone } : {}),
    ...(selection === undefined ? {} : { selectedObject: selection }),
  })
  const withDay = day === undefined ? core : canonical({ ...core, calendarDay: day })
  const observation = position === undefined ? withDay : canonical({ ...withDay, location: position })
  const facts: ObservationFacts = {
    unknownField: Object.keys(fields).some((key) => !observationKeys.has(key)) || sensitivity === undefined || counted === undefined,
    view: isName(view) ? { tag: "View", viewName: view } : { tag: "MalformedView" },
    revision: counted ?? 0,
    sensitivity: sensitivity ?? "SensitivityUnstated",
    zone: timeZone === undefined ? { tag: "NoZone" } : knownZone(timeZone) ? { tag: "Zone", zoneName: timeZone } : { tag: "UnknownZone" },
    selection: selectedObject === undefined ? "NoSelectedRecord" : selection === undefined ? "MalformedRecord" : "SelectedRecord",
    day: calendarDay === undefined ? { tag: "NoDay" }
      : day === undefined ? { tag: "MalformedDay" }
      : { tag: "Day", dayZone: day.timeZone, dayBytes: utf8Bytes(withDay) - utf8Bytes(core) },
    location: location === undefined ? { tag: "NoLocation" }
      : position === undefined ? { tag: "MalformedLocation" }
      : { tag: "Located", locationBytes: utf8Bytes(observation) - utf8Bytes(withDay) },
    coreBytes: utf8Bytes(core),
  }
  switch (observationOutcome(facts)) {
    case "ContextCarried": return { kind: "carried", value: observation }
    case "ContextDropped":
    case "TurnRefused": return { kind: "refused", facts }
  }
}

function canonicalPage(page: BrowserPage): BrowserPage {
  const shared = { tabId: page.tabId, revision: page.revision, url: page.url, title: page.title, capturedAt: page.capturedAt }
  if ("withheld" in page) return { ...shared, withheld: page.withheld }
  return {
    ...shared, text: page.text, truncated: page.truncated,
    ...(page.selection === undefined ? {} : { selection: page.selection }),
    ...(page.links === undefined ? {} : { links: page.links.map(({ text, url }) => ({ text, url })) }),
  }
}

function bindingOf(tabId: unknown, revision: unknown, observation: Observation | undefined): PageBinding {
  if (observation === undefined) return "NoObservation"
  if (observation.view !== "browser") return "OtherView"
  if (observation.sensitive) return "SensitiveBrowser"
  const selected = observation.selectedObject
  return selected?.kind === "browser-tab" && selected.id === tabId && selected.revision === revision ? "SelectedTab" : "OtherTab"
}

function decideBrowserPage(input: unknown, observation: Observation | undefined): Decided<BrowserPage, BrowserPageFacts> {
  const fields = table(input)
  if (fields === undefined) return { kind: "refused", facts: undefined }
  const decoded = Option.getOrUndefined(browserPageOf(fields))
  const page = decoded === undefined ? undefined : canonicalPage(decoded)
  const content: PageContent = page !== undefined ? ("withheld" in page ? "PageWithheld" : "PageRead")
    : fields.withheld !== undefined && pageContentKeys.some((key) => fields[key] !== undefined) ? "WithheldWithContent"
    : "MalformedPage"
  const facts: BrowserPageFacts = {
    unknownField: Object.keys(fields).some((key) => !browserPageKeys.has(key)),
    fieldsValid: page !== undefined,
    content,
    binding: bindingOf(fields.tabId, fields.revision, observation),
    bytes: page === undefined ? 0 : new TextEncoder().encode(JSON.stringify(page)).byteLength,
  }
  return page !== undefined && browserPageAccepted(facts) ? { kind: "carried", value: page } : { kind: "refused", facts }
}

function canonicalEmail(email: ReviewedEmail): ReviewedEmail {
  return { from: email.from, to: [...email.to], subject: email.subject, bodyText: email.bodyText }
}

function decideReviewedEmail(input: unknown): Decided<ReviewedEmail, ReviewedEmailFacts> {
  const fields = table(input)
  if (fields === undefined) return { kind: "refused", facts: undefined }
  const decoded = Option.getOrUndefined(reviewedEmailOf(fields))
  const email = decoded === undefined ? undefined : canonicalEmail(decoded)
  const facts: ReviewedEmailFacts = {
    unknownField: Object.keys(fields).some((key) => !reviewedEmailKeys.has(key)),
    fieldsValid: email !== undefined,
    bytes: email === undefined ? 0 : new TextEncoder().encode(JSON.stringify(email)).byteLength,
  }
  return email !== undefined && reviewedEmailAccepted(facts) ? { kind: "carried", value: email } : { kind: "refused", facts }
}

function noteBindingOf(observation: Observation | undefined): NoteBinding {
  if (observation === undefined) return "NoNoteObservation"
  if (observation.sensitive) return "SensitiveNote"
  return observation.selectedObject?.kind === "canonical-note" ? "SelectedCanonicalNote" : "OtherSelectedObject"
}

function decideSelectedVoiceNoteTranscript(input: unknown, observation: Observation | undefined): Decided<true, VoiceNoteTranscriptFacts> {
  const facts: VoiceNoteTranscriptFacts = {
    requested: input === true,
    binding: noteBindingOf(observation),
  }
  return voiceNoteTranscriptAccepted(facts) ? { kind: "carried", value: true } : { kind: "refused", facts }
}

function textOf(value: unknown): TextField {
  if (value === undefined) return { tag: "NoText" }
  if (typeof value !== "string") return { tag: "NotText" }
  return { tag: "Text", units: Array.from({ length: value.length }, (_, index) => value.charCodeAt(index)) }
}

function stated<None, Allowed, Other>(value: unknown, allowed: string, none: None, chosen: Allowed, other: Other) {
  return value === undefined ? none : value === allowed ? chosen : other
}

function decideVoiceUi(input: unknown, clientId: string | undefined): Decided<VoiceUiContext, VoiceUiFacts> {
  const fields = table(input)
  if (fields === undefined) return { kind: "refused", facts: undefined }
  const { uiViewPath, uiViewSubview, uiTimeZone, uiBrowserSurface, viewDelivery, uiClientId, agentActionMode, uiNotesEditor } = fields
  const routing = parseViewInteractionClientId(uiClientId)
  const facts: VoiceUiFacts = {
    viewPath: textOf(uiViewPath),
    subview: textOf(uiViewSubview),
    timeZone: textOf(uiTimeZone),
    surface: stated(uiBrowserSurface, "native", "NoSurface", "NativeSurface", "OtherSurface"),
    delivery: stated(viewDelivery, "completed-action", "NoDelivery", "CompletedAction", "OtherDelivery"),
    routingId: uiClientId === undefined ? "NoRouting" : routing !== undefined && (clientId === undefined || routing === clientId) ? "Routing" : "MalformedRouting",
    actionMode: agentActionMode === "direct-files-v1" ? "DirectFilesRequest" : agentActionMode === "direct-files-only-v1" ? "DirectFilesOnlyRequest" : stated(agentActionMode, "direct-request-v1", "NoActionMode", "DirectRequest", "OtherActionMode"),
    noteEditor: stated(uiNotesEditor, "saved-note-v1", "NoNoteEditor", "SavedNoteEditor", "OtherNoteEditor"),
  }
  switch (voiceUiOutcome(facts)) {
    case "ContextCarried": return { kind: "carried", value: {
      ...(typeof uiViewPath === "string" ? { uiViewPath } : {}),
      ...(typeof uiViewSubview === "string" ? { uiViewSubview } : {}),
      ...(typeof uiTimeZone === "string" ? { uiTimeZone } : {}),
      ...(uiBrowserSurface === "native" ? { uiBrowserSurface } : {}),
      ...(viewDelivery === "completed-action" ? { viewDelivery } : {}),
      ...(routing === undefined ? {} : { uiClientId: routing }),
      ...(agentActionMode === "direct-request-v1" || agentActionMode === "direct-files-v1" || agentActionMode === "direct-files-only-v1" ? { agentActionMode } : {}),
      ...(uiNotesEditor === "saved-note-v1" ? { uiNotesEditor } : {}),
    } }
    case "ContextDropped":
    case "TurnRefused": return { kind: "refused", facts }
  }
}

export effect function decodeObservation(input: unknown) {
  const decided = decideObservation(input)
  if (decided.kind === "refused") throw new ObservationDropped({ facts: decided.facts })
  return decided.value
}

export effect function decodeBrowserPage(input: unknown, observation: Observation | undefined) {
  const decided = decideBrowserPage(input, observation)
  if (decided.kind === "refused") throw new BrowserPageDropped({ facts: decided.facts })
  return decided.value
}

export effect function decodeReviewedEmail(input: unknown) {
  const decided = decideReviewedEmail(input)
  if (decided.kind === "refused") throw new ReviewedEmailDropped({ facts: decided.facts })
  return decided.value
}

export effect function decodeSelectedVoiceNoteTranscript(input: unknown, observation: Observation | undefined) {
  const decided = decideSelectedVoiceNoteTranscript(input, observation)
  if (decided.kind === "refused") throw new VoiceNoteTranscriptDropped({ facts: decided.facts })
  return decided.value
}

export effect function decodeLocationObservation(input: unknown) {
  const position = Option.getOrUndefined(locationOf(input))
  if (position === undefined) throw new ObservationDropped({ facts: undefined })
  return canonicalLocation(position)
}

export effect function decodeVoiceUiContext(input: unknown, clientId?: string) {
  const decided = decideVoiceUi(input, clientId)
  if (decided.kind === "refused") throw new VoiceUiContextInvalid({ facts: decided.facts })
  return decided.value
}

export function parseVoiceUiContext(value: unknown): VoiceUiContext | null {
  const decided = decideVoiceUi(value, undefined)
  return decided.kind === "carried" ? decided.value : null
}

export function readTurnContext(message: { readonly content: Content | { readonly metadata: unknown } }): TurnContext {
  const metadata = table(message.content.metadata)
  const observation = metadata?.observation === undefined ? undefined : decideObservation(metadata.observation)
  const voiceUi = metadata?.voiceUi === undefined ? undefined : decideVoiceUi(metadata.voiceUi, undefined)
  const kept = observation?.kind === "carried" ? observation.value : undefined
  const page = metadata?.browserPage === undefined ? undefined : decideBrowserPage(metadata.browserPage, kept)
  const email = metadata?.reviewedEmail === undefined ? undefined : decideReviewedEmail(metadata.reviewedEmail)
  const voiceNote = metadata?.useSelectedVoiceNoteTranscript === undefined ? undefined : decideSelectedVoiceNoteTranscript(metadata.useSelectedVoiceNoteTranscript, kept)
  return {
    ...(kept === undefined ? {} : { observation: kept }),
    ...(voiceUi?.kind === "carried" ? { voiceUi: voiceUi.value } : {}),
    ...(page?.kind === "carried" ? { browserPage: page.value } : {}),
    ...(email?.kind === "carried" ? { reviewedEmail: email.value } : {}),
    ...(voiceNote?.kind === "carried" ? { useSelectedVoiceNoteTranscript: voiceNote.value } : {}),
  }
}

export function encodeTurnContext(context: TurnContext, peer: { readonly optionalFields: boolean }): TurnContext {
  const { observation, voiceUi, browserPage, reviewedEmail, useSelectedVoiceNoteTranscript } = context
  return {
    ...(observation === undefined ? {} : { observation: canonical(peer.optionalFields ? observation : withoutOptionalFields(observation)) }),
    ...(voiceUi === undefined ? {} : { voiceUi }),
    ...(browserPage === undefined || observation === undefined || !peer.optionalFields ? {} : { browserPage: canonicalPage(browserPage) }),
    ...(reviewedEmail === undefined || !peer.optionalFields ? {} : { reviewedEmail: canonicalEmail(reviewedEmail) }),
    ...(useSelectedVoiceNoteTranscript !== true || observation === undefined || !peer.optionalFields ? {} : { useSelectedVoiceNoteTranscript: true }),
  }
}

export const notLearned: PeerSupport = { tag: "NotLearned" }
export const statusReadFailed: StatusRead = { tag: "ReadFailed" }

export function statusRead(status: unknown): StatusRead {
  const instance = table(status)?.serverInstanceId
  return typeof instance === "string" && instance !== "" ? { tag: "Read", instance } : { tag: "NoInstance" }
}
