// spec/agent/conversation/planning.md, "A pending-work cue is spoken only before work runs and is never the reply, and an answer is delivered whole"; spec/agent/conversation/planning.md, "A turn acknowledges at most once, with a cue that comes with its first tool calls, and bare assent is a cue only with work after an instruction"; spec/agent/conversation/planning.md, "A recognized card is delivered unfenced, other multi-line tool output is fenced, and grounded prose follows unless one already holds the other"; spec/agent/conversation/planning.md, "A voice turn that ran an action answers with that action's label: its kind, whether the reply is a validated card, and whether the owner asked for exact wording"
import { looksLikeActionEnvelopeJson, looksLikeEvaluatorEnvelopeJson, parseInteractionBlocks, sanitizeUserVisibleModelOutput } from "@elizaos/core/protocol"
import { actionLabel, compose, readDraft, type ActionLabel, type Composition, type Draft, type DraftShape, type VoiceAction } from "../../gen/agent__conversation__planning.ts"

function pattern(source: string, flags: string): RegExp {
  try {
    return new RegExp(source, flags)
  } catch {
    return /(?!)/u
  }
}

const maxCueLength = 120
const waitCue = "(?:on it|(?:one|just a) (?:sec|second|moment))"
const containerNoun = "(?:calendar|schedule|agenda|notes|inbox|emails?|messages|texts|reminders|tasks|todos|files|photos|contacts|workflows|settings|account)"
const relativeDay = "(?:today|tomorrow|yesterday|tonight)'s"
const publicNews = `(?:(?:the(?: latest)?|latest|${relativeDay}) )?(?:news|headlines)`
const containers = `(?:(?:your(?: ${relativeDay})?|${relativeDay}) ${containerNoun}|the weather|${publicNews})(?:(?:,|,? and) (?:(?:your )?(?:${relativeDay} )?${containerNoun}|the weather|${publicNews}))*`
const referent = `(?:${containers}|it|that|this|both)`
const verbs: readonly (readonly [string, string])[] = [
  [`check(?: ${referent})?`, `checking ${referent}`],
  [`(?:look|dig) into ${referent}`, `(?:looking|digging) into ${referent}`],
  [`look (?:at|through) ${containers}`, `looking (?:at|through) ${containers}`],
  [`(?:take|have) a look(?: at ${containers})?`, `(?:taking|having) a look(?: at ${containers})?`],
  [`pull up ${containers}`, `pulling up ${containers}`],
  [`search(?: ${containers})?`, `searching ${containers}`],
]
const app = "(?:calendar|notes|inbox|maps|files|photos|settings|workflows|camera|browser|contacts|messages|phone|clock)"
const item = "(?:your|the|that) (?:note|reminder|event|appointment|meeting|draft|task|email|message)"
const queryNoun = "(?:meetings|events|appointments|reminders|tasks|todos|notes|emails|messages|calls)"
const query = `(?:(?:whether|if) (?:there are|you have) any ${queryNoun}(?:(?:,|,? (?:and|or)) ${queryNoun})*|what(?:'s| is) on (?:your|the) calendar)(?: (?:today|tomorrow|this week|next week))?`
const personMark = "\u{E000}"
const person = /\bcheck with \p{Lu}\p{Ll}+(?![\p{L}\p{M}\p{N}'‘’ʼ-])/gu
const intents = [`check (?:with ${personMark}|${query})`, `open (?:${app}|${item})`, `read (?:${containers}|${item})`, `(?:save|create|update) ${item}`]
const lead = "(?:let me|i'll|i will|i(?:'m| am) going to|give me (?:a|one) (?:sec|second|moment) to|(?:one|just a) (?:sec|second|moment) while i)"
const leadForm = `${lead} (?:${[...verbs.map(([base]) => base), ...intents].join("|")})`
const tail = "(?:,? (?:now|for you|real quick|quickly)){0,2}"
const progress = pattern(`^(?:${waitCue}(?:, | ?[—–:;] ?| - ))?(?:${leadForm}|(?:i(?:'m| am) )?(?:${verbs.map(([, gerund]) => gerund).join("|")}))${tail}$`, "u")
const afterAssent = pattern(`^${leadForm}${tail}$`, "u")
const waitSentence = pattern(`^${waitCue}$`, "u")
const instructionAssent = /^(?:sure|yeah)(?:$|, |[.!…]+ | ?[—–:;] ?| - )/u
const dataToken = /\p{N}|\b[ap]\.m\.|\b(?:pm|noon|midnight|o['’]clock|zero|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|(?:hundred|thousand|dozen)s?|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|eleventh|twelfth|\p{L}+(?:teenth|tieth)|few|couple|handful|several|single|only|(?:half|quarter) (?:past|to|after|till?))\b|\b(?:at|by|until|till|before|after|around) one\b|\bone [ap]m\b/iu

export const cueRule = "When you call tools, write with your first tool calls only a brief cue that you heard the request; the real reply comes after the work. A request only to open one app, with nothing to read, find or change there, still calls the tool that opens it, with no cue: write nothing with that call, and the reply after it confirms the destination. Any question or lookup gets its cue, even one about what is on the screen. For a question or a lookup, including a request asked as a question such as \"Can you text Sam?\": \"Let me check.\" or \"Let me check your calendar.\" (or your notes, inbox, messages, reminders, tasks, files, photos, contacts), or \"Let me check the weather.\" When one message asks for several lookups, or about several named people or items, use the plain \"Let me check.\"; name a source only for one simple lookup. When opening an app is part of other planned work: \"Let me open Maps.\" (the app asked for, by its bare name: Calendar, Notes, Inbox, Maps, Files, Photos, Settings, Workflows, Camera, Browser, Contacts, Messages, Phone or Clock; for any other app, \"On it.\"). For a plain command such as \"Text Sam I'm late\" or \"Set an alarm for seven\": \"Sure.\", \"Sure, one sec.\" or \"Yeah, one sec.\" For any other action: \"On it.\" or \"One sec.\" Never start with Sure or Yeah after a question; it sounds like the answer. Never name the people, items, times or outcome, never say the work is done or under way, and never repeat the request. If the person asked for silence or no acknowledgment, write nothing and still do the work. Write no text with later tool calls."

function inGrammar(words: string, assent: string | undefined): boolean {
  const opening = assent ?? (words.startsWith("sure! ") ? "sure! " : "")
  const rest = words.slice(opening.length)
  const sentences = rest ? rest.split(/[.!…]+ /u) : []
  return (sentences.length > 0 || assent !== undefined)
    && sentences.length <= (opening ? 2 : 3)
    && (!opening || assent !== undefined || afterAssent.test(sentences[0] ?? ""))
    && sentences.every((sentence) => waitSentence.test(sentence) || progress.test(sentence))
}

function shapeOf(reply: string): DraftShape {
  const text = reply.trim()
  if (!text) return "Blank"
  if (text.length > maxCueLength || text.includes("?") || text.includes(personMark) || dataToken.test(text)) return "OtherText"
  const words = text.replace(/\s+/gu, " ").replace(person, `check with ${personMark}`).toLowerCase()
    .replace(/[‘’ʼ]/gu, "'").replace(/ ?, ?/gu, ", ").replace(/[.!…]+$/u, "")
  if (inGrammar(words, undefined)) return "GrammarCue"
  const assent = instructionAssent.exec(words)?.[0]
  return assent !== undefined && inGrammar(words, assent) ? "AssentCue" : "OtherText"
}

export function draftOf(text: string, instruction: boolean, calls: number): Draft {
  return readDraft(shapeOf(text), instruction, calls)
}

const requestFiller = new Set(["hey", "hi", "hello", "ok", "okay", "alright", "so", "please", "oh", "um", "uh", "well", "yo", "and", "also", "but", "then", "now", "actually"])
const requestGreeting = new Set(["hey", "hi", "hello", "ok", "okay", "yo"])
const questionOpener = /^(?:(?:what|when|where|who|whom|whose|why|how|which)(?:s|re|d|ll|ve)?|am|is|are|was|were|do|does|did|can|could|will|would|should|shall|may|might|have|has|had|must|isnt|arent|wasnt|werent|dont|doesnt|didnt|cant|cannot|couldnt|wont|wouldnt|shouldnt|shant|havent|hasnt|hadnt|mustnt|aint)$/u
const commandVerb = new Set([
  "accept", "add", "answer", "archive", "ask", "block", "book", "bring", "call", "cancel", "capture", "change", "check", "clear", "close",
  "compose", "copy", "create", "decline", "delete", "dial", "disable", "dismiss", "draft", "edit", "email", "enable", "end", "erase", "find",
  "flag", "forward", "get", "give", "go", "hang", "invite", "launch", "let", "lets", "list", "locate", "lock", "look", "make", "mark",
  "message", "move", "mute", "navigate", "note", "open", "order", "pause", "phone", "pin", "play", "post", "pull", "put", "read", "record",
  "remember", "remind", "remove", "rename", "reply", "reschedule", "respond", "restart", "resume", "ring", "run", "save", "schedule",
  "search", "send", "set", "share", "show", "silence", "skip", "snap", "snooze", "start", "stop", "switch", "take", "tell", "text",
  "toggle", "translate", "turn", "unlock", "unmute", "update", "wake", "write",
])

// spec/agent/conversation/planning.md, "A turn acknowledges at most once, with a cue that comes with its first tool calls, and bare assent is a cue only with work after an instruction"
export function requestedNoCue(request: string): boolean {
  return /\b(?:(?:no|without|skip)(?:\s+(?:an?|any|the))?\s+(?:acknowledg(?:e?ment)s?|cues?|preamble)|(?:don['’]t|do not|no need to|never)\s+(?:acknowledge|speak|say anything)|(?:stay|keep|be)\s+(?:quiet|silent)|silently|quietly)\b/iu.test(request)
}

function clauseWords(clause: string): string[] {
  return [...clause.matchAll(/[\p{L}'‘’ʼ]+/gu)].map((match) => match[0].toLowerCase().replace(/['‘’ʼ]/gu, ""))
}

function afterFillers(words: readonly string[]): number {
  const index = words.findIndex((word) => !requestFiller.has(word))
  return index < 0 ? words.length : index
}

export function requestIsInstruction(request: string): boolean {
  const text = request.trim()
  if (!text || text.includes("?")) return false
  const clauses = text.split(/[.!…;:,\n]+|\s[—–-]+\s/u).map(clauseWords).filter((words) => words.length > 0)
  if (clauses.some((words) => questionOpener.test(words[afterFillers(words)] ?? ""))) return false
  for (const words of clauses) {
    const index = afterFillers(words)
    const first = words[index]
    if (first === undefined) continue
    if (commandVerb.has(first)) return true
    if (index === words.length - 1) continue
    return words.slice(0, index).some((word) => requestGreeting.has(word)) && commandVerb.has(words[index + 1] ?? "")
  }
  return false
}

const cardBlock = /(?:^|\n)[ \t]*\[(MAPSCARD|CHECKLIST|WORKFLOW)\][ \t]*\r?\n[ \t]*(\{[^\n]*\})[ \t]*\r?\n[ \t]*\[\/\1\][ \t]*(?=\r?\n|$)/g

function isJsonObject(body: string): boolean {
  try {
    const parsed: unknown = JSON.parse(body)
    return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
  } catch {
    return false
  }
}

function containsRenderedCard(text: string): boolean {
  if (!text.includes("[/")) return false
  return [...text.matchAll(cardBlock)].some((match) => match[2] !== undefined && isJsonObject(match[2]))
}

function shownProse(text: string): string | undefined {
  const trimmed = text.trim()
  if (!trimmed || looksLikeActionEnvelopeJson(trimmed) || looksLikeEvaluatorEnvelopeJson(trimmed)) return undefined
  const output = sanitizeUserVisibleModelOutput(trimmed)
  return output.kind === "text" ? output.text.trim() || undefined : undefined
}

export function composeReply(toolText: string | undefined, prose: string | undefined, ownCopy: boolean, alone: boolean): string {
  const verified = toolText?.trim() ?? ""
  const said = prose === undefined ? undefined : shownProse(prose)
  const shape = {
    present: verified.length > 0,
    card: containsRenderedCard(verified),
    multiline: verified.includes("\n"),
    fenced: verified.includes("```"),
    ownCopy: ownCopy || parseInteractionBlocks(verified).blocks.length > 0,
    alone,
  }
  const composition: Composition = compose(shape, said !== undefined, said?.includes(verified) ?? false, said !== undefined && verified.includes(said))
  switch (composition) {
    case "NoText": return ""
    case "ToolOnly": return verified
    case "ProseOnly": return said ?? ""
    case "ToolThenProse": return `${verified}\n\n${said ?? ""}`
    case "FencedToolThenProse": return `\`\`\`\n${verified}\n\`\`\`\n\n${said ?? ""}`
  }
}

const literalSpeech = /\b(?:verbatim|word for word|as written|read it (?:back|aloud)|spell it out|repeat (?:it|that) exactly)\b/i
const asksForField = /\b(?:read(?: back)?|spell(?: out)?|quote|repeat|recite|give me|tell me|what(?:[’']s| is| are))\s+(?:(?:me|out|aloud|the|this|that|my|its|full|exact|whole|entire|last|four)\s+){0,7}(?:(?:event|request|operation|workflow|run|order|thread|record|confirmation|reference)\s+(?:ID|identifier|number)|receipt|identifier|ID|address|number|digits|code|subject|headers?|body|draft|e-?mail|message|text)\b/i

function asksForVerbatim(request: string): boolean {
  return literalSpeech.test(request) || asksForField.test(request)
}

export function voiceActionLabel(voice: boolean, request: string, reply: string, ran: readonly string[]): VoiceAction | undefined {
  const label: ActionLabel = actionLabel(voice, [...ran], containsRenderedCard(reply), asksForVerbatim(request))
  return label.tag === "Labelled" ? label.label : undefined
}
