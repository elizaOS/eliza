// spec/agent/conversation/turns.md, "A heard report only moves the heard boundary of an agent reply back, and never changes the reply"; spec/agent/conversation/turns.md, "The heard part and the unheard remainder together are the whole reply"
module node {
  import { Schema } from "effect"
  import { messageTextSourceDescriptor, type AgentRuntime, type Memory, type UUID } from "@elizaos/core"
  import { sanitizeSpeechText } from "@elizaos/core/protocol"
  import { heardVerdict, initial, reportedUnits, type HeardReport, type Reply } from "../../gen/agent__conversation__turns.ts"
  import { storedText } from "./history.vibe"

  const reportBody = Schema.decodeUnknownOption(Schema.Union([
    Schema.Struct({ heardText: Schema.String }),
    Schema.Struct({ nothingHeard: Schema.Literal(true) }),
  ]), { onExcessProperty: "error" })
  const messageId = Schema.decodeUnknownOption(Schema.String.check(Schema.isGUID()))
  const units = (text: string) => Array.from({ length: text.length }, (_, index) => text.charCodeAt(index))
  const error = (status: number, code: string) => ({ status, body: { error: code } })

  const comparable = (text: string) => text.replace(/\s+/g, " ").trim()
  const spokenOf = (text: string) => comparable(sanitizeSpeechText(text))
  const space = (text: string, at: number) => /\s/.test(text.charAt(at))

  function collapsedEnd(stored: string, said: string): number | undefined {
    let low = 0
    let high = stored.length
    while (low < high) {
      const middle = Math.floor((low + high) / 2)
      if (comparable(stored.slice(0, middle)).length >= said.length) high = middle
      else low = middle + 1
    }
    return comparable(stored.slice(0, low)) === said ? low : undefined
  }

  function spokenEnd(stored: string, said: string, spokenWhole: string): number | undefined {
    const cuts: number[] = []
    for (let at = 1; at < stored.length; at += 1) if (space(stored, at) && !space(stored, at - 1)) cuts.push(at)
    cuts.push(stored.length)
    const end = (cut: number) => stored.slice(0, cut).trimEnd().length
    let low = 0
    let high = cuts.length - 1
    while (low < high) {
      const middle = Math.floor((low + high) / 2)
      if (spokenOf(stored.slice(0, cuts[middle] ?? stored.length)).length >= said.length) high = middle
      else low = middle + 1
    }
    const cut = cuts[low] ?? stored.length
    if (spokenOf(stored.slice(0, cut)).startsWith(said)) return end(cut)
    let marker = "ElizaSpeechWordBoundary"
    while (stored.includes(marker)) marker += "X"
    const marked: string[] = []
    let previous = 0
    for (const [index, at] of cuts.entries()) {
      let insertion = at
      while (insertion < stored.length && space(stored, insertion)) insertion += 1
      marked.push(stored.slice(previous, insertion), ` ${marker}${index.toString(36)} `)
      previous = insertion
    }
    marked.push(stored.slice(previous))
    const reached = new Map<number, number>()
    const words: string[] = []
    let length = 0
    for (const token of sanitizeSpeechText(marked.join("")).split(/\s+/)) {
      const tag = token.startsWith(marker) ? token.slice(marker.length) : undefined
      if (tag !== undefined && /^[0-9a-z]+$/.test(tag)) {
        reached.set(Number.parseInt(tag, 36), length)
        continue
      }
      if (token === "") continue
      length += (length > 0 ? 1 : 0) + token.length
      words.push(token)
    }
    if (words.join(" ") !== spokenWhole) return undefined
    const index = cuts.findIndex((_, at) => (reached.get(at) ?? -1) >= said.length)
    return index < 0 ? undefined : end(cuts[index] ?? stored.length)
  }

  function heardEnd(stored: string, heard: string): number | undefined {
    const said = comparable(heard)
    if (said === "") return undefined
    if (stored.startsWith(heard)) return heard.length
    const written = comparable(stored)
    if (said === written) return stored.length
    if (written.startsWith(said)) return collapsedEnd(stored, said)
    const spokenWhole = spokenOf(stored)
    if (said === spokenWhole) return stored.length
    return spokenWhole.startsWith(said) ? spokenEnd(stored, said, spokenWhole) : undefined
  }

  function boundaryOf(memory: Memory, length: number): number | undefined {
    const boundary = memory.content.heardBoundary
    if (typeof boundary === "number" && Number.isSafeInteger(boundary) && boundary >= 0 && boundary < length) return boundary
    return undefined
  }

  export function heardView(memory: Memory, text: string) {
    const boundary = boundaryOf(memory, text.length) ?? text.length
    return { heard: text.slice(0, boundary), unheard: text.slice(boundary) }
  }

  export function textForTurn(memory: Memory, text: string): string {
    const boundary = boundaryOf(memory, text.length)
    return boundary === undefined ? text : `${text.slice(0, boundary)}\n[Unheard remainder: ${text.slice(boundary)}]`
  }

  export async function recordHeard(runtime: AgentRuntime, roomId: UUID, id: string | undefined, body: unknown) {
    const decoded = reportBody(body)
    if (decoded._tag !== "Some") return error(400, "invalid_heard_report")
    const key = messageId(id)
    if (key._tag !== "Some") return error(404, "unknown_message")
    const sent = decoded.value
    return runtime.adapter.transaction(async (tx) => {
      const [reply] = await tx.getMemoriesByIds([key.value], "messages")
      if (reply?.roomId !== roomId || reply.entityId !== runtime.agentId) {
        return error(404, "unknown_message")
      }
      const { text: inline, inReplyTo, actions, systemNotice } = reply.content
      const stored = typeof inline === "string" || messageTextSourceDescriptor(reply.content) !== null
      if (!stored || systemNotice !== undefined || (!inReplyTo && !actions?.includes("REPLY"))) {
        return error(404, "unknown_message")
      }
      const text = await storedText(tx, reply)
      const heardAt = "heardText" in sent ? heardEnd(text, sent.heardText) : undefined
      const report: HeardReport = "heardText" in sent
        ? { tag: "HeardText", text: units(heardAt === undefined ? sent.heardText : text.slice(0, heardAt)) }
        : { tag: "NothingHeard" }
      const boundary = boundaryOf(reply, text.length)
      const held: Reply = {
        id: 1, room: 1, userMessage: 0, units: units(text), kind: { tag: "Answered" },
        heard: boundary === undefined ? { tag: "NotReported" } : { tag: "HeardUpTo", boundary },
      }
      const verdict = heardVerdict({ ...initial, replies: [held] }, held.room, held.id, report)
      if (verdict === "HeardNotAgentReply") return error(404, "unknown_message")
      if (verdict === "HeardConflict") return error(409, "CONVERSATION_HEARD_NOT_PREFIX")
      const changed = verdict === "HeardRecorded"
      if (changed) await tx.updateMemories([{ id: key.value, content: { ...reply.content, heardBoundary: reportedUnits(report) } }])
      return { status: 200, body: { ok: true, messageId: key.value, changed } }
    })
  }
}

export { heardView, recordHeard, textForTurn } from node
