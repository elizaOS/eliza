// spec/agent/conversation/turns.md, "A heard report only moves the heard boundary of an agent reply back, and never changes the reply", "The heard part and the unheard remainder together are the whole reply"
module node {
  import { Schema } from "effect"
  import type { AgentRuntime, Memory, UUID } from "@elizaos/core"
  import { heardVerdict, initial, reportedUnits, type HeardReport, type Reply } from "../../gen/agent__conversation__turns.ts"

  const reportBody = Schema.decodeUnknownOption(Schema.Union([
    Schema.Struct({ heardText: Schema.String }),
    Schema.Struct({ nothingHeard: Schema.Literal(true) }),
  ]), { onExcessProperty: "error" })
  const messageId = Schema.decodeUnknownOption(Schema.String.check(Schema.isGUID()))
  const units = (text: string) => Array.from({ length: text.length }, (_, index) => text.charCodeAt(index))
  const error = (status: number, code: string) => ({ status, body: { error: code } })

  function boundaryOf(memory: Memory, length: number): number | undefined {
    const boundary = memory.content.heardBoundary
    if (typeof boundary === "number" && Number.isSafeInteger(boundary) && boundary >= 0 && boundary < length) return boundary
    return undefined
  }

  export function heardView(memory: Memory) {
    const text = memory.content.text ?? ""
    const boundary = boundaryOf(memory, text.length) ?? text.length
    return { heard: text.slice(0, boundary), unheard: text.slice(boundary) }
  }

  export function textForTurn(memory: Memory): string | undefined {
    const text = memory.content.text
    const boundary = text === undefined ? undefined : boundaryOf(memory, text.length)
    return boundary === undefined || text === undefined
      ? text
      : `${text.slice(0, boundary)}\n[Unheard remainder: ${text.slice(boundary)}]`
  }

  export async function recordHeard(runtime: AgentRuntime, roomId: UUID, id: string | undefined, body: unknown) {
    const decoded = reportBody(body)
    if (decoded._tag !== "Some") return error(400, "invalid_heard_report")
    const key = messageId(id)
    if (key._tag !== "Some") return error(404, "unknown_message")
    const report: HeardReport = "heardText" in decoded.value
      ? { tag: "HeardText", text: units(decoded.value.heardText) }
      : { tag: "NothingHeard" }
    return runtime.adapter.transaction(async (tx) => {
      const [reply] = await tx.getMemoriesByIds([key.value], "messages")
      if (reply?.roomId !== roomId || reply.entityId !== runtime.agentId) {
        return error(404, "unknown_message")
      }
      const { text, inReplyTo, actions, systemNotice } = reply.content
      if (typeof text !== "string" || systemNotice !== undefined || (!inReplyTo && !actions?.includes("REPLY"))) {
        return error(404, "unknown_message")
      }
      const boundary = boundaryOf(reply, text.length)
      const held: Reply = {
        id: 1, room: 1, userMessage: 0, units: units(text), kind: { tag: "Answered" },
        heard: boundary === undefined ? { tag: "NotReported" } : { tag: "HeardUpTo", boundary },
      }
      const verdict = heardVerdict({ ...initial, replies: [held] }, held.room, held.id, report)
      if (verdict === "HeardNotAgentReply") return error(404, "unknown_message")
      if (verdict === "HeardConflict") return error(409, "CONVERSATION_HEARD_NOT_PREFIX")
      const changed = verdict === "HeardRecorded"
      if (changed) await tx.updateMemories([{ id: key.value, content: { ...reply.content, heardBoundary: reportedUnits(report) } }])
      return { status: 200, body: { ok: true, messageId: key.value, changed } }
    })
  }
}

export { heardView, recordHeard, textForTurn } from node
