// spec/agent/conversation/conversations.md, "Story: Create and find my conversations", "Messages and model-call log rows arrive only in a published conversation"; spec/core/turnControllers.md, "Story: Cancel room work without cancelling the cancel request"
module node {
  import { randomUUID } from "node:crypto"
  import { Schema } from "effect"
  import { ChannelType, type AgentRuntime, type Content, type Memory, type MemoryMetadata, type Room, type UUID } from "@elizaos/core"
  import { canCreate, defaultTitle, initial } from "../../gen/agent__conversation__conversations.ts"
  import type { LocalRoute } from "../access/routes.vibe"
  import { streamRoutes } from "./stream.vibe"

  export interface TurnReply {
    readonly fullText: string
  }

  const Body = Schema.Struct({ text: Schema.Trimmed.check(Schema.isMinLength(1), Schema.isMaxLength(32768)) })
  const Create = Schema.Struct({ title: Schema.optionalKey(Schema.String) })
  const Stamp = Schema.Struct({
    id: Schema.String,
    createdAt: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
    updatedAt: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
  })
  const createBody = Schema.decodeUnknownOption(Create, { onExcessProperty: "error" })
  const messageBody = Schema.decodeUnknownOption(Body, { onExcessProperty: "error" })
  const stamp = Schema.decodeUnknownOption(Stamp)
  const failure = (status: number, error: string) => ({ status, body: { error } })
  const okay = (body: object) => ({ status: 200, body })

  export function conversation(room: Room) {
    const metadata = stamp(room.metadata?.deviceConversation)
    if (metadata._tag !== "Some") return undefined
    return { ...metadata.value, roomId: room.id, title: room.name ?? defaultTitle }
  }

  export interface ConversationOwner {
    readonly user: UUID
    readonly world: UUID
  }

  export interface TurnOptions {
    readonly onStreamChunk?: (chunk: string) => void
    readonly metadata?: MemoryMetadata
  }

  function memory(runtime: AgentRuntime, owner: ConversationOwner, room: Room, text: string, metadata?: MemoryMetadata): Memory {
    return {
      id: randomUUID(), entityId: owner.user, agentId: runtime.agentId, roomId: room.id,
      worldId: owner.world, createdAt: Date.now(), content: { text, source: "device" },
      ...(metadata === undefined ? {} : { metadata }),
    }
  }

  export async function createConversation(runtime: AgentRuntime, owner: ConversationOwner, title: string) {
    const id = randomUUID()
    const roomId = randomUUID()
    const time = Date.now()
    const created = { id, roomId, title: title || defaultTitle, createdAt: time, updatedAt: time }
    await runtime.ensureConnection({
      entityId: owner.user, roomId, roomName: created.title, worldId: owner.world, userName: "person",
      name: "Person", source: "device", type: ChannelType.DM, channelId: roomId,
    })
    const room = await runtime.getRoom(roomId)
    if (!room) return undefined
    await runtime.updateRooms([{ ...room, metadata: {
      ...room.metadata, deviceConversation: { id, createdAt: time, updatedAt: time },
    } }])
    return created
  }

  export async function processTurn(runtime: AgentRuntime, owner: ConversationOwner, room: Room, text: string, signal: AbortSignal, options: TurnOptions = {}) {
    const service = runtime.messageService ?? (() => { throw new Error("A conversation requires the message service") })()
    const storeReply = async (content: Content): Promise<Memory[]> => {
      if (!content.text?.trim()) return []
      const response = { ...memory(runtime, owner, room, content.text, options.metadata), entityId: runtime.agentId, content }
      await runtime.createMessageMemory(response)
      return [response]
    }
    return runtime.roomHandlerQueue.withLease(room.id, async (lease) => {
      signal.throwIfAborted()
      const input = memory(runtime, owner, room, text, options.metadata)
      await runtime.createMessageMemory(input)
      const [current] = await runtime.adapter.getRoomsByIds([room.id])
      const metadata = stamp(current?.metadata?.deviceConversation)
      if (metadata._tag === "Some" && current !== undefined) {
        await runtime.updateRooms([{
          ...current, metadata: {
            ...current.metadata, deviceConversation: { ...metadata.value, updatedAt: Math.max(metadata.value.updatedAt, input.createdAt ?? 0) },
          },
        }])
      }
      return service.handleMessage(runtime, input, storeReply, {
        roomHandlerLease: lease, abortSignal: signal, ...(options.onStreamChunk === undefined ? {} : { onStreamChunk: options.onStreamChunk }),
      })
    }, { signal })
  }

  export function conversationRoutes(runtime: AgentRuntime, owner: ConversationOwner): LocalRoute[] {
    if (!runtime.messageService) throw new Error("A conversation requires the message service")
    const rooms = () => runtime.getRooms(owner.world)
    const find = async (id: string | undefined): Promise<Room | undefined> =>
      (await rooms()).find((room) => conversation(room)?.id === id)

    return [
      {
        method: "POST", path: "/api/conversations",
        handler: async ({body}) => {
          const payload = createBody(body ?? {})
          if (payload._tag !== "Some") return failure(400, "invalid_conversation")
          const title = payload.value.title?.trim() ?? ""
          if (!canCreate(initial, title, title.length)) return failure(400, "invalid_title")
          const created = await createConversation(runtime, owner, title)
          return created === undefined ? failure(500, "room_unavailable") : { status: 201, body: { conversation: created } }
        },
      },
      {
        method: "GET", path: "/api/conversations",
        handler: async () => okay({ conversations: (await rooms()).flatMap((room) => conversation(room) ?? [])
          .sort((a, b) => b.updatedAt - a.updatedAt || b.id.localeCompare(a.id)) }),
      },
      {
        method: "POST", path: "/api/conversations/{id}/messages",
        handler: async ({ parameters, body, signal }) => {
          const room = await find(parameters.get("id"))
          if (!room) return failure(404, "unknown_conversation")
          const payload = messageBody(body)
          if (payload._tag !== "Some") return failure(400, "invalid_message")
          const result = await processTurn(runtime, owner, room, payload.value.text, signal)
          return result.didRespond && result.responseContent?.text
            ? okay({ fullText: result.responseContent.text } satisfies TurnReply)
            : failure(502, "turn_failed")
        },
      },
      ...streamRoutes(async (id, body) => {
        const room = await find(id)
        if (!room) return { kind: "refused", status: 404, error: "unknown_conversation" }
        const payload = messageBody(body)
        if (payload._tag !== "Some") return { kind: "refused", status: 400, error: "invalid_message" }
        return { kind: "admitted", role: "streams", run: async (writer, signal) => {
          const result = await processTurn(runtime, owner, room, payload.value.text, signal, { onStreamChunk: (text) => writer.append(text) })
          const [reply] = result.responseMessages
          return result.didRespond && result.responseContent?.text && reply?.id
            ? { type: "done", fullText: result.responseContent.text, messageId: reply.id, actionResults: [] }
            : { type: "error", code: "turn_failed", message: "The turn did not complete" }
        } }
      }),
      {
        method: "POST", path: "/api/turns/{room}/abort",
        handler: async ({ parameters }) => {
          const requested = parameters.get("room")
          const room = (await rooms()).find((candidate) => candidate.id === requested && conversation(candidate) !== undefined)
          if (!room) return failure(404, "unknown_conversation")
          return okay({ aborted: runtime.turnControllers.abortTurn(room.id, "owner_requested_abort") })
        },
      },
    ]
  }
}
export { conversation as deviceConversation, conversationRoutes, createConversation, processTurn, type ConversationOwner, type TurnOptions, type TurnReply } from node
