// spec/agent/conversation/conversations.md, "Story: Create and find my conversations", "Messages and model-call log rows arrive only in a published conversation"; spec/core/turnControllers.md, "Story: Cancel room work without cancelling the cancel request"
// spec/agent/conversation/turns.md, "A message is refused, joined, replayed or admitted by its key, its room and the backend", "A room runs one turn at a time, and only an admitted or recovered message changes anything", "A heard report only moves the heard boundary of an agent reply back, and never changes the reply"
// spec/agent/conversation/turns.md, "A Stop is confirmed only when its turn ends within five seconds, and is otherwise uncertain"
// spec/agent/conversation/events.md, "Story: Hear about my conversations while my screen is open"
// spec/agent/conversation/replyStream.md, "Only a message that starts its own turn streams text, a repeat waits for its reply, and a refusal opens no stream"
module node {
  import { randomUUID } from "node:crypto"
  import { Effect, Schema } from "effect"
  import {
    ChannelType, ModelType, conversationClientUserMemoryId, hashStableJson,
    normalizeChatIdempotencyKey, readDurableConversationChatMarker, stringToUuid,
    type AgentRuntime, type Content, type DurableConversationChatMarker, type JsonObject, type Memory, type MemoryMetadata, type Room, type UUID,
  } from "@elizaos/core"
  import { canCreate, defaultTitle, initial } from "../../gen/agent__conversation__conversations.ts"
  import { decide, receiptRetentionMs, stopConfirmMs, stopWindowOpen, type KeyView } from "../../gen/agent__conversation__turns.ts"
  import type { LocalRoute } from "../access/routes.vibe"
  import { recordHeard } from "./heard.vibe"
  import { streamRoutes, type ReplyWriter, type StreamRole, type StreamStart, type Terminal } from "./stream.vibe"

  export interface TurnReply {
    readonly fullText: string
    readonly text: string
    readonly agentName: string
    readonly messageId: UUID
    readonly userMessageId: UUID
    readonly actionResults: readonly { readonly action: string; readonly data: unknown }[]
    readonly failureKind?: string
  }

  const Body = Schema.Struct({ text: Schema.Trimmed.check(Schema.isMinLength(1), Schema.isMaxLength(32768)) })
  const TurnBody = Schema.Struct({
    ...Body.fields,
    channelType: Schema.optionalKey(Schema.Literals([ChannelType.DM, ChannelType.VOICE_DM])),
    metadata: Schema.optionalKey(Schema.JsonObject),
    clientMessageId: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(128))),
  })
  type TurnBody = typeof TurnBody.Type
  const Create = Schema.Struct({ title: Schema.optionalKey(Schema.String) })
  const Stamp = Schema.Struct({
    id: Schema.String,
    createdAt: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
    updatedAt: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
  })
  const createBody = Schema.decodeUnknownOption(Create, { onExcessProperty: "error" })
  const turnBody = Schema.decodeUnknownOption(TurnBody, { onExcessProperty: "error" })
  const stopBody = Schema.decodeUnknownOption(Schema.Struct({ reason: Schema.optionalKey(Schema.String) }), { onExcessProperty: "error" })
  const stamp = Schema.decodeUnknownOption(Stamp)
  const failure = (status: number, error: string) => ({ status, body: { error } })
  const okay = <T extends object>(body: T) => ({ status: 200, body })
  const storedFailure = (content: Content | undefined) =>
    typeof content?.failureKind === "string" ? content.failureKind : undefined

  export function conversation(room: Room) {
    const metadata = stamp(room.metadata?.deviceConversation)
    if (metadata._tag !== "Some") return undefined
    return { ...metadata.value, roomId: room.id, title: room.name ?? defaultTitle }
  }

  export interface ConversationOwner {
    readonly user: UUID
    readonly world: UUID
  }

  export interface TurnOptions {
    readonly onStreamChunk?: (chunk: string) => void
    readonly metadata?: MemoryMetadata
    readonly input?: Pick<TurnBody, "channelType" | "metadata">
    readonly key?: KeyedTurn
  }

  interface KeyedTurn {
    readonly inputId: UUID
    readonly replyId: UUID
    readonly boot: UUID
    readonly marker: DurableConversationChatMarker
  }

  type SendAnswer = ReturnType<typeof okay<TurnReply>> | ReturnType<typeof failure>

  interface StreamDelivery {
    readonly admit: (role: StreamRole) => void
    readonly attached: Promise<{ readonly writer: ReplyWriter; readonly signal: AbortSignal }>
  }

  interface RunningSend {
    readonly key: KeyedTurn | undefined
    readonly admitted: Promise<boolean>
    readonly result: Promise<SendAnswer>
    readonly interrupt: AbortController
  }

  function memory(runtime: AgentRuntime, owner: ConversationOwner, room: Room, text: string, metadata?: MemoryMetadata): Memory {
    return {
      id: randomUUID(), entityId: owner.user, agentId: runtime.agentId, roomId: room.id,
      worldId: owner.world, createdAt: Date.now(), content: { text, source: "device" },
      ...(metadata === undefined ? {} : { metadata }),
    }
  }

  export async function createConversation(runtime: AgentRuntime, owner: ConversationOwner, title: string) {
    const id = randomUUID()
    const roomId = randomUUID()
    const time = Date.now()
    const created = { id, roomId, title: title || defaultTitle, createdAt: time, updatedAt: time }
    await runtime.ensureConnection({
      entityId: owner.user, roomId, roomName: created.title, worldId: owner.world, userName: "person",
      name: "Person", source: "device", type: ChannelType.DM, channelId: roomId,
    })
    const room = await runtime.getRoom(roomId)
    if (!room) return undefined
    await runtime.updateRooms([{ ...room, metadata: {
      ...room.metadata, deviceConversation: { id, createdAt: time, updatedAt: time },
    } }])
    return created
  }

  export async function processTurn(runtime: AgentRuntime, owner: ConversationOwner, room: Room, text: string, signal: AbortSignal, options: TurnOptions = {}) {
    const service = runtime.messageService ?? (() => { throw new Error("A conversation requires the message service") })()
    return runtime.roomHandlerQueue.withLease(room.id, async (lease) => {
      signal.throwIfAborted()
      const input = memory(runtime, owner, room, text, options.metadata)
      const { key } = options
      if (options.input?.channelType !== undefined) input.content.channelType = options.input.channelType
      if (options.input?.metadata !== undefined) input.content.metadata = options.input.metadata as JsonObject
      if (key !== undefined) {
        input.id = key.inputId
        input.content.chatIdempotency = { ...key.marker }
      }
      const userMessageId = await runtime.createMessageMemory(input)
      const storeReply = async (content: Content): Promise<Memory[]> => {
        if (!content.text?.trim() && storedFailure(content) === undefined) return []
        const response = {
          ...memory(runtime, owner, room, content.text ?? "", options.metadata),
          ...(key === undefined ? {} : { id: key.replyId }),
          entityId: runtime.agentId, content: { ...content, inReplyTo: userMessageId, ...(key === undefined ? {} : { turnBoot: key.boot }) },
        }
        await runtime.createMessageMemory(response)
        return [response]
      }
      const [current] = await runtime.adapter.getRoomsByIds([room.id])
      const metadata = stamp(current?.metadata?.deviceConversation)
      if (metadata._tag === "Some" && current !== undefined) {
        await runtime.updateRooms([{
          ...current, metadata: {
            ...current.metadata, deviceConversation: { ...metadata.value, updatedAt: Math.max(metadata.value.updatedAt, input.createdAt ?? 0) },
          },
        }])
      }
      const result = await service.handleMessage(runtime, input, storeReply, {
        roomHandlerLease: lease, abortSignal: signal, ...(options.onStreamChunk === undefined ? {} : { onStreamChunk: options.onStreamChunk }),
      })
      return { ...result, userMessageId }
    }, { signal })
  }

  export function conversationRoutes(runtime: AgentRuntime, owner: ConversationOwner, agentName: string, publish: (payload: unknown) => void): LocalRoute[] {
    if (!runtime.messageService) throw new Error("A conversation requires the message service")
    const rooms = () => runtime.getRooms(owner.world)
    const find = async (id: string | undefined): Promise<Room | undefined> =>
      (await rooms()).find((room) => conversation(room)?.id === id)
    const updated = (room: Room) => publish({ type: "conversation-updated", conversationId: conversation(room)?.id, roomId: room.id })
    const live = new Map<UUID, RunningSend>()
    const stopping = new Map<UUID, Promise<ReturnType<typeof okay>>>()
    const boot = randomUUID()
    const answer = (text: string, messageId: UUID, userMessageId: UUID, failureKind?: string) =>
      okay({ fullText: text, text, agentName, messageId, userMessageId, actionResults: [],
        ...(failureKind === undefined ? {} : { failureKind }) } satisfies TurnReply)

    async function send(room: Room, input: TurnBody, signal: AbortSignal, stream?: StreamDelivery): Promise<SendAnswer> {
      const id = normalizeChatIdempotencyKey(input.clientMessageId)
      if (input.clientMessageId !== undefined && id === null) return failure(400, "invalid_message")
      const { text, channelType, metadata } = input
      if (metadata !== undefined && Buffer.byteLength(JSON.stringify(metadata)) > 64 * 1024) return failure(400, "invalid_message")
      const scope = JSON.stringify([runtime.agentId, owner.user, room.id])
      const inputId = id === null ? undefined : conversationClientUserMemoryId(scope, id)
      const key: KeyedTurn | undefined = inputId === undefined || id === null ? undefined : {
        inputId, replyId: stringToUuid(`conversation-reply:${inputId}`), boot,
        marker: { version: 1, scope, clientMessageId: id, fingerprint: hashStableJson({ text, channelType: channelType ?? ChannelType.DM, metadata }) },
      }
      if (runtime.getModel(ModelType.TEXT_LARGE) === undefined) return failure(503, "INFERENCE_UNAVAILABLE")
      const current = live.get(room.id)
      const busy = current !== undefined || runtime.turnControllers.hasActiveTurn(room.id)
      if (current !== undefined && key !== undefined && current.key?.inputId === key.inputId) {
        const admission = decide(true, { tag: "HeldRunning", fingerprint: 1 }, true, true,
          current.key.marker.fingerprint === key.marker.fingerprint ? 1 : 2, 1)
        if (admission.tag !== "Duplicate") return failure(409, "CHAT_IDEMPOTENCY_CONFLICT")
        if (await current.admitted) stream?.admit("waits")
        return current.result
      }

      const admitted = Promise.withResolvers<boolean>()
      const admit = (role: StreamRole) => { admitted.resolve(true); stream?.admit(role) }

      async function sendOwned(interrupt: AbortSignal) {
        if (key !== undefined) {
          const saved = await runtime.getMemoryById(key.inputId)
          if (saved !== null) {
            const expected = readDurableConversationChatMarker(saved.content.chatIdempotency)
            if (saved.roomId !== room.id || saved.entityId !== owner.user || expected?.scope !== scope || expected.clientMessageId !== id) {
              return failure(409, "CHAT_IDEMPOTENCY_CONFLICT")
            }
            const reply = await runtime.getMemoryById(key.replyId)
            const now = Date.now()
            const answered = reply?.roomId === room.id && reply.entityId === runtime.agentId && reply.content.inReplyTo === key.inputId
            const view: KeyView = answered
              ? { tag: "HeldAnswered", fingerprint: 1, reply: 1,
                live: reply.content.turnBoot === boot && reply.createdAt !== undefined && now - reply.createdAt <= receiptRetentionMs }
              : { tag: "HeldUnanswered", fingerprint: 1 }
            const admission = decide(true, view, true, busy, expected.fingerprint === key.marker.fingerprint ? 1 : 2, 1)
            if (admission.tag === "Conflict") return failure(409, "CHAT_IDEMPOTENCY_CONFLICT")
            if (admission.tag !== "Settled") return failure(429, "conversation_busy")
            admit("waits")
            if (answered) {
              return answer(reply.content.text ?? "", key.replyId, key.inputId, storedFailure(reply.content))
            }
            const recovered = memory(runtime, owner, room, "")
            await runtime.createMessageMemory({
              ...recovered, id: key.replyId, entityId: runtime.agentId,
              content: { ...recovered.content, inReplyTo: key.inputId, failureKind: "aborted", turnBoot: boot },
            })
            return answer("", key.replyId, key.inputId, "aborted")
          }
        }
        const admission = decide(true, { tag: "NoKey" }, key !== undefined, busy, 1, 1)
        if (admission.tag === "Busy") return failure(429, "conversation_busy")
        admit("streams")
        const attached = stream === undefined ? undefined : await stream.attached
        const turnSignal = attached === undefined ? interrupt : AbortSignal.any([interrupt, attached.signal])
        const result = await processTurn(runtime, owner, room, text, turnSignal, {
          input, ...(key === undefined ? {} : { key }), ...(attached === undefined ? {} : { onStreamChunk: attached.writer.append }),
        })
        updated(room)
        const [reply] = result.responseMessages
        const failureKind = storedFailure(reply?.content)
        if (failureKind !== undefined && reply?.id !== undefined) return answer("", reply.id, result.userMessageId, failureKind)
        if (!result.didRespond || !result.responseContent?.text || reply?.id === undefined) return failure(502, "turn_failed")
        return answer(result.responseContent.text, reply.id, result.userMessageId)
      }

      if (busy) return sendOwned(signal)
      const interrupt = new AbortController()
      const result = sendOwned(AbortSignal.any([signal, interrupt.signal]))
      live.set(room.id, { key, admitted: admitted.promise, result, interrupt })
      try {
        return await result
      } finally {
        admitted.resolve(false)
        live.delete(room.id)
      }
    }

    async function stop(roomId: UUID, reason: string) {
      const pending = stopping.get(roomId)
      if (pending !== undefined) return pending
      const running = live.get(roomId)
      const result = (outcome: "nothingRunning" | "stopped" | "uncertain") =>
        okay({ aborted: outcome !== "nothingRunning", roomId, reason, outcome })
      if (running === undefined && !runtime.turnControllers.hasActiveTurn(roomId)) return result("nothingRunning")
      const requestedAt = Date.now()
      const released = running === undefined
        ? runtime.roomHandlerQueue.quiesce(roomId)
        : running.result.then(() => undefined, () => undefined)
      running?.interrupt.abort(reason)
      runtime.turnControllers.abortTurn(roomId, reason)
      const completion = Effect.runPromise(Effect.timeoutOption(Effect.promise(() => released), stopConfirmMs))
        .then((ended) => result(ended._tag === "Some" && stopWindowOpen({ tag: "Stopping", requestedAt }, Date.now()) ? "stopped" : "uncertain"))
      stopping.set(roomId, completion)
      try {
        return await completion
      } finally {
        stopping.delete(roomId)
      }
    }

    return [
      {
        method: "POST", path: "/api/conversations",
        handler: async ({body}) => {
          const payload = createBody(body ?? {})
          if (payload._tag !== "Some") return failure(400, "invalid_conversation")
          const title = payload.value.title?.trim() ?? ""
          if (!canCreate(initial, title, title.length)) return failure(400, "invalid_title")
          const created = await createConversation(runtime, owner, title)
          return created === undefined ? failure(500, "room_unavailable") : { status: 201, body: { conversation: created } }
        },
      },
      {
        method: "GET", path: "/api/conversations",
        handler: async () => okay({ conversations: (await rooms()).flatMap((room) => conversation(room) ?? [])
          .sort((a, b) => b.updatedAt - a.updatedAt || b.id.localeCompare(a.id)) }),
      },
      {
        method: "POST", path: "/api/conversations/{id}/messages",
        handler: async ({ parameters, body, signal }) => {
          const room = await find(parameters.get("id"))
          if (!room) return failure(404, "unknown_conversation")
          const payload = turnBody(body)
          if (payload._tag !== "Some") return failure(400, "invalid_message")
          return send(room, payload.value, signal)
        },
      },
      {
        method: "POST", path: "/api/conversations/{id}/messages/{messageId}/heard",
        handler: async ({ parameters, body }) => {
          const room = await find(parameters.get("id"))
          if (!room) return failure(404, "unknown_conversation")
          return recordHeard(runtime, room.id, parameters.get("messageId"), body)
        },
      },
      ...streamRoutes(async (id, body, _headers, signal) => {
        const room = await find(id)
        if (!room) return { kind: "refused", status: 404, error: "unknown_conversation" }
        const payload = turnBody(body)
        if (payload._tag !== "Some") return { kind: "refused", status: 400, error: "invalid_message" }
        const opening = Promise.withResolvers<StreamRole | Extract<StreamStart, { kind: "refused" }>>()
        const attached = Promise.withResolvers<Awaited<StreamDelivery["attached"]>>()
        const result = send(room, payload.value, signal, { admit: opening.resolve, attached: attached.promise })
        void result.then(({ status, body }) => {
          if ("error" in body) opening.resolve({ kind: "refused", status, error: body.error })
        }, opening.reject)
        const role = await opening.promise
        if (typeof role !== "string") return role
        return { kind: "admitted", role, run: async (writer, left): Promise<Terminal> => {
          attached.resolve({ writer, signal: left })
          const { body } = await result
          if ("error" in body) return { type: "error", code: body.error, message: "The turn did not complete" }
          const { fullText, messageId, userMessageId, agentName, actionResults, failureKind } = body
          return { type: "done", fullText, messageId, userMessageId, agentName, actionResults, ...(failureKind === undefined ? {} : { failureKind }) }
        } }
      }),
      {
        method: "POST", path: "/api/turns/{room}/abort",
        handler: async ({ parameters, body }) => {
          const requested = parameters.get("room")
          const room = (await rooms()).find((candidate) => candidate.id === requested && conversation(candidate) !== undefined)
          if (!room) return failure(404, "unknown_conversation")
          const payload = stopBody(body ?? {})
          if (payload._tag !== "Some") return failure(400, "invalid_stop")
          return stop(room.id, payload.value.reason ?? "owner_requested_abort")
        },
      },
    ]
  }
}
export { conversation as deviceConversation, conversationRoutes, createConversation, processTurn, type ConversationOwner, type TurnOptions, type TurnReply } from node
