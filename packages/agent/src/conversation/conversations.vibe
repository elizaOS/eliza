// spec/agent/conversation/conversations.md, "Story: Create and find my conversations"; spec/agent/conversation/conversations.md, "Creating a conversation gives it a fresh id and room, and a default title when blank"; spec/agent/conversation/conversations.md, "The list shows only published conversations, most recently updated first"; spec/agent/conversation/conversations.md, "Messages and model-call log rows arrive only in a published conversation"
module node {
  import { randomUUID } from "node:crypto"
  import { Schema } from "effect"
  import { ChannelType, type AgentRuntime, type Room, type UUID } from "@elizaos/core"
  import { canCreate, defaultTitle, initial, listedBefore, type Conversation, type Publication } from "../../gen/agent__conversation__conversations.ts"
  import type { LocalRoute } from "../access/routes.vibe"

  export interface ConversationOwner {
    readonly user: UUID
    readonly world: UUID
  }

  export interface ConversationRecord {
    readonly id: string
    readonly roomId: UUID
    readonly title: string
    readonly createdAt: number
    readonly updatedAt: number
    readonly seq: number
    readonly publication: Publication
  }

  export interface ConversationStore {
    readonly create: (title: string) => Promise<ConversationRecord>
    readonly createPending: (title: string) => Promise<ConversationRecord>
    readonly publish: (id: string) => Promise<ConversationRecord | undefined>
    readonly list: () => Promise<ConversationRecord[]>
    readonly find: (id: string) => Promise<ConversationRecord | undefined>
    readonly findPending: (id: string) => Promise<ConversationRecord | undefined>
    readonly findByRoom: (roomId: UUID) => Promise<ConversationRecord | undefined>
    readonly touch: (roomId: UUID, at: number) => Promise<void>
  }

  const Count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
  const Stored = Schema.Struct({
    id: Schema.String,
    createdAt: Count,
    updatedAt: Count,
    seq: Schema.optionalKey(Count),
    publication: Schema.optionalKey(Schema.Literals(["Published", "ForkPending"])),
  })
  const Create = Schema.Struct({ title: Schema.optionalKey(Schema.String) })
  const stored = Schema.decodeUnknownOption(Stored)
  const createBody = Schema.decodeUnknownOption(Create, { onExcessProperty: "error" })

  export function recordOf(room: Room): ConversationRecord | undefined {
    const found = stored(room.metadata?.deviceConversation)
    if (found._tag !== "Some") return undefined
    const { id, createdAt, updatedAt, seq, publication } = found.value
    return { id, roomId: room.id, title: room.name ?? defaultTitle, createdAt, updatedAt, seq: seq ?? 0, publication: publication ?? "Published" }
  }

  export const conversationView = ({ id, roomId, title, createdAt, updatedAt }: ConversationRecord) =>
    ({ id, roomId, title, createdAt: new Date(createdAt).toISOString(), updatedAt: new Date(updatedAt).toISOString() })

  const modelOf = (record: ConversationRecord): Conversation => ({
    id: record.seq, title: { text: record.title, edits: 0 }, createdAt: record.createdAt, updatedAt: record.updatedAt, publication: record.publication,
  })
  const listingOrder = (a: ConversationRecord, b: ConversationRecord) =>
    listedBefore(modelOf(a), modelOf(b)) ? -1 : listedBefore(modelOf(b), modelOf(a)) ? 1 : 0

  const stores = new WeakMap<AgentRuntime, ConversationStore>()

  export function conversationStore(runtime: AgentRuntime, owner: ConversationOwner): ConversationStore {
    const known = stores.get(runtime)
    if (known !== undefined) return known
    let queue: Promise<unknown> = Promise.resolve()
    const exclusive = <A>(work: () => Promise<A>): Promise<A> => {
      const run = queue.then(work)
      queue = run.catch(() => undefined)
      return run
    }
    const records = async () => (await runtime.getRooms(owner.world)).flatMap((room) => recordOf(room) ?? [])
    const roomOf = async (roomId: UUID) => (await runtime.adapter.getRoomsByIds([roomId]))[0]
    const keep = async (room: Room, record: ConversationRecord) => {
      const { id, createdAt, updatedAt, seq, publication } = record
      await runtime.updateRooms([{ ...room, metadata: { ...room.metadata, deviceConversation: { id, createdAt, updatedAt, seq, publication } } }])
    }

    const open = (title: string, publication: Publication) => exclusive(async () => {
      const seq = Math.max(0, ...(await records()).map((record) => record.seq)) + 1
      const roomId = randomUUID() as UUID
      const time = Date.now()
      const named = title === "" ? defaultTitle : title
      await runtime.ensureConnection({
        entityId: owner.user, roomId, roomName: named, worldId: owner.world, userName: "person",
        name: "Person", source: "device", type: ChannelType.DM, channelId: roomId,
      })
      const room = await roomOf(roomId)
      if (room === undefined) throw new Error("The conversation room was not stored")
      const record: ConversationRecord = { id: randomUUID(), roomId, title: named, createdAt: time, updatedAt: time, seq, publication }
      await keep(room, record)
      return record
    })

    const byId = async (id: string, publication: Publication) =>
      (await records()).find((record) => record.id === id && record.publication === publication)

    const store: ConversationStore = {
      create: (title) => open(title, "Published"),
      createPending: (title) => open(title, "ForkPending"),
      publish: (id) => exclusive(async () => {
        const record = (await records()).find((candidate) => candidate.id === id)
        const room = record === undefined ? undefined : await roomOf(record.roomId)
        if (record === undefined || room === undefined) return undefined
        if (record.publication === "Published") return record
        const published: ConversationRecord = { ...record, publication: "Published" }
        await keep(room, published)
        return published
      }),
      list: async () => (await records()).filter((record) => record.publication === "Published").sort(listingOrder),
      find: (id) => byId(id, "Published"),
      findPending: (id) => byId(id, "ForkPending"),
      findByRoom: async (roomId) => {
        const room = await roomOf(roomId)
        const record = room === undefined || room.worldId !== owner.world ? undefined : recordOf(room)
        return record?.publication === "Published" ? record : undefined
      },
      touch: (roomId, at) => exclusive(async () => {
        const room = await roomOf(roomId)
        const record = room === undefined ? undefined : recordOf(room)
        if (room === undefined || record?.publication !== "Published" || at <= record.updatedAt) return
        await keep(room, { ...record, updatedAt: at })
      }),
    }
    stores.set(runtime, store)
    return store
  }

  const failure = (status: number, error: string) => ({ status, body: { error } })

  export function conversationRecordRoutes(store: ConversationStore): LocalRoute[] {
    return [
      {
        method: "POST", path: "/api/conversations",
        handler: async ({ body }) => {
          const payload = createBody(body ?? {})
          if (payload._tag !== "Some") return failure(400, "invalid_conversation")
          const title = payload.value.title?.trim() ?? ""
          if (!canCreate(initial, title, title.length)) return failure(400, "invalid_title")
          return { status: 201, body: { conversation: conversationView(await store.create(title)) } }
        },
      },
      {
        method: "GET", path: "/api/conversations",
        handler: async () => ({ status: 200, body: { conversations: (await store.list()).map(conversationView) } }),
      },
    ]
  }
}
export { conversationRecordRoutes, conversationStore, conversationView, recordOf, type ConversationOwner, type ConversationRecord, type ConversationStore } from node
