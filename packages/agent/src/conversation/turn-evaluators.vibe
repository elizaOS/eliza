// spec/agent/conversation/planning.md, "Story: Let my plugins learn from a finished turn"; spec/agent/conversation/planning.md, "After the reply is stored, each evaluator that opts in runs in priority order, and one evaluator's failure stops neither its peers nor the turn"
import { type AgentRuntime, type Memory, type RegisteredEvaluator, type State, isTextGenerationModelType, logger, ModelType } from "@elizaos/core"
import { runsNext } from "../../gen/agent__conversation__planning.ts"

const defaultPriority = 100

function inline(runtime: AgentRuntime, evaluator: RegisteredEvaluator): boolean {
  if (evaluator.background === true) return false
  const incremental = typeof evaluator.incremental === "function" ? evaluator.incremental(runtime) : evaluator.incremental
  return incremental !== true
}

function byPriority<T extends { readonly name?: string; readonly priority?: number }>(entries: readonly T[]): T[] {
  return entries.map((entry, position) => ({ entry, position }))
    .sort((a, b) => (a.entry.priority ?? defaultPriority) - (b.entry.priority ?? defaultPriority)
      || (a.entry.name ?? "").localeCompare(b.entry.name ?? "") || a.position - b.position)
    .map(({ entry }) => entry)
}

function parsedJson(text: string): unknown {
  try {
    return JSON.parse(text)
  } catch {
    return text
  }
}

function outputOf(value: unknown): unknown {
  if (typeof value === "string") return parsedJson(value)
  if (typeof value === "object" && value !== null && "text" in value && typeof value.text === "string") return parsedJson(value.text)
  return value
}

async function runOne(runtime: AgentRuntime, evaluator: RegisteredEvaluator, message: Memory, state: State, responses: Memory[], signal: AbortSignal): Promise<void> {
  const context = { runtime, message, state, options: { didRespond: responses.length > 0, responses } }
  if (!await evaluator.shouldRun(context)) return
  const prepared = evaluator.prepare === undefined ? undefined : await evaluator.prepare({ ...context, state })
  const prompted = { ...context, state, prepared }
  const resolved = evaluator.resolveOutput !== undefined && (evaluator.resolveOutputWhen?.(prompted) ?? true)
  let raw: unknown
  if (resolved && evaluator.resolveOutput !== undefined) {
    raw = evaluator.resolveOutput(prompted)
  } else {
    const modelType = evaluator.modelType?.trim().toUpperCase() ?? ModelType.TEXT_SMALL
    if (!isTextGenerationModelType(modelType)) throw new Error(`Unsupported evaluator model type: ${evaluator.modelType}`)
    raw = outputOf(await runtime.useModel(modelType, { prompt: evaluator.prompt(prompted), responseSchema: evaluator.schema, reasoning: "off", signal }))
  }
  const output = evaluator.parse === undefined ? raw : evaluator.parse(raw, { ...prompted, outputSource: resolved ? "resolved" : "model" })
  if (output === null || output === undefined) return
  for (const processor of byPriority(evaluator.processors ?? [])) {
    signal.throwIfAborted()
    try {
      await processor.process({ ...prompted, output, evaluatorName: evaluator.name })
    } catch (error: unknown) {
      logger.warn({ src: "agent", evaluator: evaluator.name, processor: processor.name, error: String(error) }, "A turn evaluator's processor failed")
    }
  }
}

export async function runTurnEvaluators(runtime: AgentRuntime, message: Memory, state: State, responses: Memory[], signal: AbortSignal): Promise<void> {
  const evaluators = byPriority(runtime.evaluators.filter((evaluator) => inline(runtime, evaluator)))
  for (const [done, evaluator] of evaluators.entries()) {
    if (signal.aborted || !runsNext(done, evaluators.length, "Ran")) return
    try {
      await runOne(runtime, evaluator, message, state, responses, signal)
    } catch (error: unknown) {
      logger.warn({ src: "agent", evaluator: evaluator.name, error: String(error) }, "A turn evaluator failed")
    }
  }
}
