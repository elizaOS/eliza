// spec/agent/conversation/planning.md, "The live owner turn classifies a Notes write from its original conversation before dispatch"
import {
  beginRequestOperationIssuer, bindTaskExtractionContext, commitNotesRequestRestriction,
  createContextObject, hashStableJson, ModelType, normalizeNotesRequestInterpretation, ResponseHandlerFieldRegistry,
  type Action, type AgentContext, type AgentRuntime, type GenerateTextParams, type Memory, type ResponseHandlerFieldEvaluator, type State,
} from "@elizaos/core"
import { classifiesNotesWrite } from "../../gen/agent__conversation__planning.ts"

type ChatMessage = NonNullable<GenerateTextParams["messages"]>[number]

interface NotesTurn {
  readonly runtime: AgentRuntime
  readonly message: Memory
  readonly state: State
  readonly history: readonly ChatMessage[]
  readonly owner: boolean
  readonly signal: AbortSignal
  current(): boolean
}

const fieldName = "notesRequestEffect"
const selection = { includeFieldNames: [fieldName] }

function parseClassification(output: unknown): Record<string, unknown> | undefined {
  const text = typeof output === "string" ? output
    : typeof output === "object" && output !== null && "text" in output && typeof output.text === "string" ? output.text : undefined
  if (text === undefined) return undefined
  try {
    const parsed: unknown = JSON.parse(text)
    if (typeof parsed !== "object" || parsed === null || Object.keys(parsed).length !== 1 || !Object.hasOwn(parsed, fieldName)) return undefined
    return { [fieldName]: (parsed as Record<string, unknown>)[fieldName] }
  } catch {
    return undefined
  }
}

async function classify(turn: NotesTurn, field: ResponseHandlerFieldEvaluator, asked: string): Promise<State> {
  const { runtime, message, signal } = turn
  if (!turn.current() || message.id === undefined) return turn.state
  const requestHash = hashStableJson(message)
  const state = { ...turn.state, data: { ...turn.state.data } }
  const registry = new ResponseHandlerFieldRegistry()
  registry.register(field)
  const input = { runtime, message, state, senderRole: "OWNER" as const, turnSignal: signal }
  const prompt = await registry.composePromptSlices(input)
  if (!prompt.activeFieldNames.includes(fieldName) || !turn.current()) return turn.state
  const messages: ChatMessage[] = [...turn.history, { role: "user", content: asked }]
  const system = `Classify the current owner's request. The earlier conversation is context only. Return the requested JSON field and do not call any tools.\n\n${prompt.rendered}`
  const responseSchema = registry.composeSchema()
  const inferenceInput = hashStableJson({ system, messages, responseSchema })
  const output = await runtime.useModel(ModelType.TEXT_SMALL, { system, messages, responseSchema, signal })
  if (!turn.current()) return turn.state
  const rawParsed = parseClassification(output)
  if (rawParsed === undefined) return turn.state
  const { parsed, traces } = await registry.dispatch({ ...input, rawParsed })
  const trace = traces.find(({ fieldName: name }) => name === fieldName)
  const classification = parsed.notesRequestEffect
  const interpretation = normalizeNotesRequestInterpretation(parsed.notesRequestInterpretation)
  if (!trace?.active || trace.parseOutcome !== "ok" || !trace.handled || interpretation?.status !== "explicit" || !turn.current()) return turn.state
  if (classification !== "read_only" && classification !== "mutation_requested") return turn.state
  if (hashStableJson(message) !== requestHash) return turn.state
  const source = Object.freeze({ inferenceInput, requestHash, classification, interpretation })
  const issuer = beginRequestOperationIssuer({ runtime, message, current: turn.current })
  if (issuer === undefined || !commitNotesRequestRestriction(issuer, { classification, interpretation, source, currentSource: () => source })) return turn.state
  const context = createContextObject({
    id: message.id,
    metadata: { messageId: message.id, roomId: message.roomId, entityId: message.entityId, agentId: message.agentId },
    events: [{ id: message.id, type: "message", source: "owner-conversation", message: { id: message.id, role: "user", content: asked } }],
  })
  bindTaskExtractionContext(state, message, context, context, runtime, issuer)
  return state
}

export function ownerNotesAdmission(turn: NotesTurn) {
  const field = turn.runtime.responseHandlerFieldRegistry.list(selection)[0]
  const asked = turn.message.content.text ?? ""
  let attempt: Promise<State> | undefined
  return async (action: Action | undefined): Promise<{ state: State; activeContexts: readonly AgentContext[] }> => {
    const notes = turn.owner && action?.tags?.includes("resource:notes") === true && action.contexts?.includes("notes") === true
    const activeContexts = notes ? ["general", "notes"] as const : ["general"] as const
    const writes = notes && action?.tags?.includes("capability:write") === true
    if (field !== undefined && classifiesNotesWrite(turn.owner, writes, asked.trim() !== "")) {
      attempt ??= classify(turn, field, asked).catch(() => turn.state)
      const state = await attempt
      turn.signal.throwIfAborted()
      return { state, activeContexts }
    }
    return { state: turn.state, activeContexts }
  }
}
