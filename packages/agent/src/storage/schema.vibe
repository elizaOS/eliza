// spec/agent/storage/database.md, "Migrations run in number order, one transaction each, and a destructive or newer schema is refused"
import type { MigrationKind } from "../../gen/agent__storage__database.ts"

export interface DeviceStorageSnapshot {
  readonly schemaVersion: number
  readonly bytes: Uint8Array
}

export interface Migration {
  readonly kind: MigrationKind
  readonly sql: string
}

export const migrations: readonly Migration[] = [
  { kind: "Additive", sql: `CREATE TABLE device_owner (
    singleton boolean PRIMARY KEY CHECK (singleton),
    agent_id uuid NOT NULL,
    user_id text CHECK (length(user_id) > 0),
    organization_id text CHECK (length(organization_id) > 0),
    embedding_dimensions integer NOT NULL CHECK (embedding_dimensions >= 0),
    version integer NOT NULL CHECK (version > 0),
    CHECK ((user_id IS NULL) = (organization_id IS NULL))
  );
  CREATE TABLE device_records (
    collection text NOT NULL CHECK (collection IN ('agents', 'entities', 'worlds', 'rooms', 'participants', 'memories', 'logs', 'cache', 'components', 'relationships', 'tasks')),
    key text NOT NULL,
    data jsonb NOT NULL,
    room_id text GENERATED ALWAYS AS (data->>'roomId') STORED,
    world_id text GENERATED ALWAYS AS (data->>'worldId') STORED,
    table_name text,
    created_at bigint NOT NULL,
    PRIMARY KEY (collection, key),
    CHECK ((collection = 'memories') = (table_name IS NOT NULL))
  );
  CREATE INDEX device_records_room ON device_records (collection, room_id, created_at, key);
  CREATE INDEX device_records_world ON device_records (collection, world_id, created_at, key);
  CREATE INDEX device_records_scope ON device_records (collection, table_name, created_at, key);` },
  { kind: "Additive", sql: `CREATE TABLE schedule_triggers (
    id text PRIMARY KEY,
    revision integer NOT NULL CHECK (revision > 0),
    data jsonb NOT NULL
  );
  CREATE TABLE schedule_trigger_runs (
    trigger_id text NOT NULL REFERENCES schedule_triggers (id) ON DELETE CASCADE,
    seq integer NOT NULL CHECK (seq > 0),
    data jsonb NOT NULL,
    PRIMARY KEY (trigger_id, seq)
  );
  CREATE TABLE schedule_tasks (
    task_id text PRIMARY KEY,
    revision integer NOT NULL CHECK (revision > 0),
    idempotency_key text UNIQUE CHECK (length(idempotency_key) > 0),
    owner_visible boolean NOT NULL,
    data jsonb NOT NULL
  );
  CREATE INDEX schedule_tasks_visible ON schedule_tasks (owner_visible, task_id);` },
  { kind: "Additive", sql: `CREATE TABLE device_enrollment (
    singleton boolean PRIMARY KEY CHECK (singleton),
    revision integer NOT NULL CHECK (revision > 0),
    state jsonb NOT NULL
  );
  CREATE TABLE device_requests (
    proposal_id text PRIMARY KEY CHECK (length(proposal_id) > 0),
    revision integer NOT NULL CHECK (revision > 0),
    state jsonb NOT NULL,
    settled boolean NOT NULL,
    operation jsonb NOT NULL,
    binding text NOT NULL CHECK (binding IN ('NoBinding', 'WorkflowBinding', 'AgendaBinding')),
    bound_profile jsonb NOT NULL,
    need jsonb NOT NULL,
    result jsonb,
    created_at bigint NOT NULL
  );
  CREATE INDEX device_requests_settled ON device_requests (settled, created_at, proposal_id);
  CREATE TABLE device_view_profile (
    singleton boolean PRIMARY KEY CHECK (singleton),
    revision text NOT NULL CHECK (length(revision) > 0),
    views jsonb NOT NULL
  );` },
  { kind: "Additive", sql: `ALTER TABLE device_requests ADD COLUMN binding_authority jsonb
    CHECK (binding_authority IS NULL OR
      (jsonb_typeof(binding_authority) = 'object' AND binding <> 'NoBinding'
        AND (binding_authority->>'kind') IS NOT DISTINCT FROM binding));` },
  { kind: "Additive", sql: `ALTER TABLE device_requests ADD COLUMN wire_attempt_id uuid UNIQUE;` },
  { kind: "Additive", sql: `ALTER TABLE device_requests ADD COLUMN provider_receipt jsonb
    CHECK (provider_receipt IS NULL OR jsonb_typeof(provider_receipt) = 'object');` },
]
