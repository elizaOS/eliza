// spec/agent/deviceActions/index.md, "An offer goes only to the enrolled device, for a capability it declared"; spec/agent/deviceActions/index.md, "An unclaimed offer retires at its deadline or at the end of its turn"; spec/agent/deviceActions/operations.md, "A proposal is valid only when its shape, its need and its binding all hold"; spec/agent/conversation/turnContext.md, "Story: Tell the agent what my screen shows, and nothing more"
module node {
  import { Effect, Schema } from "effect"
  import { hashStableJson, ModelType, stringToUuid, type AgentRuntime, type Memory } from "@elizaos/core"
  import type { RouteInput } from "../access/routes.vibe"
  import { readTurnContext } from "../conversation/turn-context.schema.vibe"
  import { capabilitiesHeader, negotiation } from "./capabilities.vibe"
  import { enrollmentId, type DeviceEnrollment } from "./enrollment.vibe"
  import { firstOfLocalDay } from "./operation-schemas/device.schema.vibe"
  import { CalendarSource, day } from "./operation-schemas/personal.schema.vibe"
  import { validate } from "./operations.schema.vibe"
  import { agendaPayload, type AgendaOperation } from "./proposal-review.vibe"
  import { enrollment, offerRequest, retireRequest } from "./store.vibe"

  const NativeTurn = Schema.Struct({ clientDevice: Schema.Struct({ context: Schema.JsonObject, calendarAgendaSource: Schema.Unknown }) })
  const nativeTurn = Schema.decodeUnknownOption(NativeTurn)
  const sourceOf = Schema.decodeUnknownOption(CalendarSource, { onExcessProperty: "error" })
  const decision = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Struct({
    kind: Schema.Literals(["read_agenda", "reply"]),
  })), { onExcessProperty: "error" })
  const capability = "calendar.agenda-read.v1"

  export type AgendaOffer = (
    input: Pick<RouteInput, "headers">, context: { readonly conversationId: string; readonly message: Memory; readonly requestId: string }, signal: AbortSignal,
  ) => Promise<(() => Promise<void>) | undefined>

  export function agendaOffer(runtime: AgentRuntime, sender: DeviceEnrollment["deviceSender"]): AgendaOffer {
    return async (input, { conversationId, message, requestId }, signal) => {
      const native = nativeTurn(message.content.metadata)
      if (native._tag !== "Some" || message.id === undefined || !message.content.text) return undefined
      const source = sourceOf(native.value.clientDevice.calendarAgendaSource)
      if (source._tag !== "Some") return undefined
      const calendarAgendaSource = source.value
      const { context } = native.value.clientDevice
      const observation = readTurnContext({ content: { metadata: { observation: context } } }).observation
      if (observation?.view !== "calendar" || observation.sensitive || observation.calendarDay === undefined) return undefined
      const by = await Effect.runPromise(sender(input))
      if (by === undefined) return undefined
      const { date, timeZone } = observation.calendarDay
      const wallDay = Date.parse(`${date}T00:00:00.000Z`)
      const operation: AgendaOperation = {
        type: "read_calendar_range", calendarIds: [calendarAgendaSource.sourceId],
        start: new Date(firstOfLocalDay(wallDay, timeZone)).toISOString(),
        end: new Date(firstOfLocalDay(wallDay + day, timeZone)).toISOString(),
        timeZone, maximumEvents: 200,
      }
      const checked = validate(operation, negotiation(true, input.headers.get(capabilitiesHeader)), "AgendaBinding")
      if (checked === undefined) return undefined
      signal.throwIfAborted()
      let classification: unknown
      try {
        classification = await runtime.useModel(ModelType.TEXT_SMALL, {
          system: `The owner is viewing their Calendar on ${date} in ${timeZone}. Classify only whether the message explicitly asks to read their agenda for this displayed day. Reply with exactly {"kind":"read_agenda"} in that case or {"kind":"reply"} otherwise. Do not choose an operation, calendar, date or identity.`,
          messages: [{ role: "user", content: message.content.text }], signal,
        })
      } catch {
        signal.throwIfAborted()
        return undefined
      }
      const intent = decision(classification)
      if (intent._tag !== "Some" || intent.value.kind !== "read_agenda") return undefined
      signal.throwIfAborted()
      const enrolled = await Effect.runPromise(enrollment(runtime.adapter))
      const proposalId = stringToUuid(`agenda:${message.id}`)
      const expiresAt = Date.now() + 600_000
      const payload = agendaPayload({ operation, calendarAgendaSource }, by, enrollmentId(enrolled), message.id)
      const digest = hashStableJson({ id: proposalId, subjectUserId: by.actorId, payload, expiresAt: new Date(expiresAt).toISOString() })
      const bound = { proposalId, digest, by }
      await Effect.runPromise(offerRequest(runtime.adapter, {
        type: "offer", proposalId, digest, capability, expiresAt, readBack: true,
        origin: { requestId, conversationId, inReplyTo: message.id },
      }, by, {
        operation, binding: { kind: "AgendaBinding", ...calendarAgendaSource },
        boundProfile: { tag: "NoRevisionRead" }, need: checked.need,
      }))
      return () => Effect.runPromise(retireRequest(runtime.adapter, bound))
    }
  }
}

export { agendaOffer, type AgendaOffer } from node
