// spec/agent/deviceActions/operations.md, "A latest-sender read is answered in fixed words from its approved result, and the model is offered the whole address only when the device negotiated it"
import { Option } from "effect"
import type { Negotiation } from "../../gen/agent__deviceActions__capabilities.effect.vibe"
import { senderAnswer, senderGuidance, type SenderRead } from "../../gen/agent__deviceActions__operations.effect.vibe"
import { readLatestSender, type LatestSenderResult } from "./operation-schemas/telephony.vibe"

function readOf(result: LatestSenderResult): SenderRead {
  if ("address" in result) return "SenderAddress"
  if ("numberEnding" in result) return "SenderEnding"
  switch (result.status) {
    case "empty": return "InboxEmpty"
    case "sender-unavailable": return "SenderNotDialable"
    case "unavailable": return "SenderUnreadable"
  }
}

export function latestSenderReply(result: LatestSenderResult): string {
  switch (senderAnswer(readOf(result))) {
    case "SaysAddress": return "address" in result ? `Your latest incoming SMS came from ${result.address}.` : ""
    case "SaysEnding": return "numberEnding" in result ? `Your latest incoming SMS came from the number ending in ${result.numberEnding}.` : ""
    case "SaysNoMessages": return "There are no incoming SMS messages on this phone."
    case "SaysNoNumber": return "The latest incoming SMS has no readable phone number."
    case "SaysReadFailed": return "I couldn’t read the latest incoming SMS right now."
  }
}

export function latestSenderReplyFor(result: unknown): string | undefined {
  const decoded = readLatestSender(result)
  return Option.isSome(decoded) ? latestSenderReply(decoded.value) : undefined
}

export function latestSenderGuidance(negotiation: Negotiation): string {
  switch (senderGuidance(negotiation)) {
    case "AddressThenDraft":
      return "Use sms_latest_sender (disclosure=address) when owner asks who sent the latest SMS. To draft a text to them next, propose sms_compose with recipientKind=previous-sender and body; never give hypothetical copy."
    case "SuffixOnly":
      return "Use sms_latest_sender when owner asks who sent the newest incoming SMS: reviewed read of sender number suffix only. No history/MMS/body; don't use inbox or open-thread read."
  }
}
