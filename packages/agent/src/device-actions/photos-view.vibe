// spec/agent/deviceActions/operations.md, "A turn targets the photo open on the owner's screen only from the Photos view, never on a sensitive screen, and names its library ID only under the library capability"; spec/agent/deviceActions/operations.md, "Each operation has one capability need, which a clock-only device meets only for the Clock handoff"
import { negotiatedHas, type Negotiation } from "../../gen/agent__deviceActions__capabilities.effect.vibe"
import { shownPhotoTarget } from "../../gen/agent__deviceActions__operations.effect.vibe"
import type { Observation } from "../conversation/turn-context.schema.vibe"
import { readOperation } from "./operations.schema.vibe"

const photosView = "photos"

/** How an album or share names the photo open on the owner's screen, or `undefined` when this turn may not target it. */
export type ShownPhoto = { readonly ids: readonly []; readonly selected: true } | { readonly ids: readonly [string] }

function libraryIdOf(observation: Observation): string | undefined {
  const id = observation.selectedObject?.id
  return id !== undefined && readOperation({ type: "photos_open", id }) !== undefined ? id : undefined
}

/** The target an album or share uses for "this photo" on this turn's observation, under this request's negotiation. */
export function shownPhoto(observation: Observation | undefined, negotiation: Negotiation): ShownPhoto | undefined {
  if (observation === undefined) return undefined
  const id = libraryIdOf(observation)
  switch (shownPhotoTarget(observation.view === photosView, observation.sensitive, id !== undefined, negotiation)) {
    case "OpenPhoto": return { ids: [], selected: true }
    case "ShownLibraryId": return id === undefined ? undefined : { ids: [id] }
    case "NoPhotoTarget": return undefined
  }
}

/** What the model is told about naming the open Photos item on a device with this negotiation. */
export function photosViewGuidance(negotiation: Negotiation): string | undefined {
  if (!negotiatedHas(negotiation, "PhotosLibraryV1") || !negotiatedHas(negotiation, "PhotosViewV1")) return undefined
  const base = "With photos.library.v1 and photos.view.v1: photos_filter {from, to: epoch ms; kind image|video; favorite; album favorites|videos|camera|screenshots|custom:<id>; text} narrows the phone Photos grid behind a clearable chip and returns only how many items it shows; photos_open {id} opens one item in the Photos viewer; both run directly only when the owner's current message asked for them. photos_album_create {name, ids} and photos_share {ids} are reviewed by the owner in Photos; a share then opens Android's share sheet, and review_opened proves neither a created album nor a share. Use only library ids the phone returned; never guess them."
  return negotiatedHas(negotiation, "PhotosViewSelectedV1")
    ? `${base} With photos.view-selected.v1, photos_album_create {name, selected: true} and photos_share {selected: true} use the one item the owner has open in the Photos viewer instead of ids. Use it when the owner says this photo, this video or the open one; the phone shows that item in the review.`
    : base
}
