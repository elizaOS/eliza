// spec/agent/deviceActions/surfaces.md, "A photo is proposed only when the owner's own message asks for one now"

const greeting = /^(?:hey|hi|ok|okay)[,.!]? /
const command = /^(?:please,? )?(?:take|snap|shoot|capture) (?:a|an|one) (?:quick )?(picture|photo|photograph|pic|snapshot|selfie)( of (?:me|myself))?(?: (?:with|using|on|from) (?:the|my) (front|front-facing|selfie|back|rear|rear-facing|main) camera)?(?: now)?(?:,? (?:please|for me|thanks|thank you))?[.!]*$/
const question = /^(?:please,? )?(?:can|could|would|will) you (?:please )?(?:take|snap|shoot|capture) (?:a|an|one) (?:quick )?(picture|photo|photograph|pic|snapshot|selfie)( of (?:me|myself))?(?: (?:with|using|on|from) (?:the|my) (front|front-facing|selfie|back|rear|rear-facing|main) camera)?(?: now)?(?:,? (?:please|for me|thanks|thank you))?[?.!]*$/
const frontCamera = /^(?:front|front-facing|selfie)$/
const backCamera = /^(?:back|rear|rear-facing|main)$/

function addressed(text: string, assistantName: string): string {
  const name = assistantName.trim().toLowerCase().split(/\s+/).filter((word) => word !== "").join(" ") || "eliza"
  const mark = ["", ",", ".", "!"].find((after) => text.startsWith(`${name}${after} `))
  return mark === undefined ? text : text.slice(name.length + mark.length + 1)
}

export function requestedCameraCapture(text: string, assistantName: string): boolean {
  if (text.length > 512 || /[\u0000-\u001f\u007f]/.test(text)) return false
  const spoken = addressed(text.trim().toLowerCase().replace(/\s+/g, " ").replace(greeting, ""), assistantName)
  const match = command.exec(spoken) ?? question.exec(spoken)
  if (match === null) return false
  const [, noun, ofOwner, camera = ""] = match
  const front = noun === "selfie" || ofOwner !== undefined || frontCamera.test(camera)
  return !(front && backCamera.test(camera))
}
