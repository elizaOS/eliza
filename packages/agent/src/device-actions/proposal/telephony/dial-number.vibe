// spec/agent/deviceActions/telephony.md, "A proposed number is the owner's own, written or spoken in this message and not only inside the text to send"; spec/agent/deviceActions/telephony.md, "A contact change saves only numbers and email addresses the owner wrote, when the message writes any"; spec/agent/deviceActions/telephony.md, "A keypad, a Messages draft or a who-texted-me read runs without its card only as the owner asked"
const dialNumberShape = /^\+?[0-9]{2,20}$/
const writtenDialNumber = /^(?:\+\d{1,3}[ .-]\d(?=[ .-]\d{2})|\+?(?:\(\d+\)|\d+))(?:[ .-]?(?:\(\d{2,}\)|\d{2,}))*$/
const writtenNanpNumber = /^(?:\+?1[ .-]?)?(?:\(\d{3}\)[ .-]?|\d{3}[ .-])\d{3}[ .-]?\d{4}$/
const writtenNumber = /(?<![\p{L}\p{N}+])\+?(?:\(\d+\)|\d)[\d ().-]*\d(?![\p{L}\p{N}])/gu
const typedNumber = /\+?[\d(][\d ().-]*\d/g
const numberShaped = /(?<![\p{L}\p{N}+])\+?[\d(][\d\s()./-]*\d(?![\p{L}\p{N}])/gu
const shortestNumber = 3

function matchesOf(text: string, pattern: RegExp): RegExpExecArray[] {
  const found: RegExpExecArray[] = []
  pattern.lastIndex = 0
  for (let match = pattern.exec(text); match !== null; match = pattern.exec(text)) {
    found.push(match)
    if (match[0] === "") pattern.lastIndex += 1
  }
  pattern.lastIndex = 0
  return found
}

function withoutTrunk(written: string): string {
  return written
    .replace(/^\+(44|49|41)( ?)\(0\) ?(?=\d)/, "+$1$2")
    .replace(/^\+(39|378|225)( ?)\(0\) ?(?=\d)/, (_whole: string, code: string, space: string) => `+${code}${space}0`)
}

export function phoneDialNumber(value: string): string | undefined {
  const written = withoutTrunk(value.trim())
  const number = written.replace(/[ ().-]/g, "")
  const oneNumber = number === written || writtenNanpNumber.test(written) || (
    writtenDialNumber.test(written) && written.split("(").length <= 2 && !/[.-].* /.test(written) &&
    !/^\d{4}-\d{2}-\d{2}$/.test(written) && number.replace("+", "").length <= 15
  )
  return dialNumberShape.test(number) && oneNumber ? number : undefined
}

export function dialForms(written: string): string[] {
  const whole = phoneDialNumber(written)
  if (whole !== undefined) return [whole]
  return written.split(/\s+/).flatMap((part) => phoneDialNumber(part) ?? [])
}

export function writtenPhoneNumbers(text: string): string[] {
  const numbers = new Set<string>()
  for (const [written = ""] of matchesOf(text, writtenNumber)) {
    for (const number of dialForms(written.trim())) {
      if (number.replace("+", "").length >= shortestNumber) numbers.add(number)
    }
  }
  return [...numbers]
}

export function samePhoneNumber(a: string, b: string): boolean {
  const x = a.replace("+", ""), y = b.replace("+", "")
  return x === y || (x.length >= 10 && y.length >= 10 && x.slice(-10) === y.slice(-10))
}

export function writesUnreadableNumber(text: string, number: string): boolean {
  const wanted = number.replace(/\D/g, "")
  return matchesOf(text, numberShaped).some(([written = ""]) => {
    const digits = written.replace(/\D/g, "")
    return digits.length >= 7 && digits.length <= 15 && samePhoneNumber(digits, wanted) && phoneDialNumber(written.trim()) === undefined
  })
}

export function writesDialNumber(text: string, number: string): boolean {
  const wanted = phoneDialNumber(number)
  return wanted !== undefined && matchesOf(text, typedNumber).some(([written = ""]) => phoneDialNumber(written) === wanted)
}

function dialForm(value: unknown): unknown {
  return typeof value === "string" ? phoneDialNumber(value) ?? value : value
}

function dialFormList(value: unknown): unknown {
  return Array.isArray(value) ? value.map(dialForm) : value
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

function withDialNumbers(fields: unknown): unknown {
  return isRecord(fields) && Object.hasOwn(fields, "phoneNumbers") ? { ...fields, phoneNumbers: dialFormList(fields.phoneNumbers) } : fields
}

export function withDialNumber(operation: unknown): unknown {
  if (!isRecord(operation)) return operation
  const target = operation.target
  if (isRecord(target) && target.kind === "number") return { ...operation, target: { ...target, number: dialForm(target.number) } }
  switch (operation.type) {
    case "sms_send":
      return { ...operation, recipients: dialFormList(operation.recipients) }
    case "phone_keypad":
      return Object.hasOwn(operation, "number") ? { ...operation, number: dialForm(operation.number) } : operation
    case "contact_create":
      return { ...operation, contact: withDialNumbers(operation.contact) }
    case "contact_update":
      return Object.fromEntries(Object.entries(operation).map(([key, value]) => [key, key === "set" || key === "add" || key === "remove" ? withDialNumbers(value) : value]))
    default:
      return operation
  }
}
