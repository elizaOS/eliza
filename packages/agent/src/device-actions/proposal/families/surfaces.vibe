// spec/agent/deviceActions/surfaces.md, "Story: Propose a photo, a view, a Maps read or a Photos change only as my words and my screen name them"; spec/agent/deviceActions/surfaces.md, "A surface operation is bound to the owner's message only on a direct-request turn and as the owner asked"; spec/agent/deviceActions/surfaces.md, "A photo runs without its card only when the owner's own message asks for one now"; spec/agent/deviceActions/surfaces.md, "An app view opens with VIEWS where views arrive as completed actions, else with open_view as the installation's profile enables it"; spec/agent/deviceActions/surfaces.md, "A whole-message photo command is routed to the capture, never to opening Camera"; spec/agent/deviceActions/surfaces.md, "A new note is proposed only while the owner's Notes screen selects the phone's own Notes"; spec/agent/deviceActions/surfaces.md, "A new note runs without its card only when its title and body are the owner's own words"; spec/agent/deviceActions/surfaces.md, "A Maps read names exactly the place or route selected on the owner's Maps screen"; spec/agent/deviceActions/operations.md, "Each operation has one capability need, which a clock-only device meets only for the Clock handoff"
import type { ActionParameterSchema } from "@elizaos/core"
import { meets, negotiatedHas, revisionOf } from "../../../../gen/agent__deviceActions__capabilities.effect.vibe"
import { operationNeed, type OperationType } from "../../../../gen/agent__deviceActions__operations.effect.vibe"
import { captureVerdict, mapsVerdict, noteAvailable, noteVerdict, openViewAvailable, openViewVerdict, photoCommandRouted, surfaceBound, viewsShowsOnDevice, type SurfaceVerdict } from "../../../../gen/agent__deviceActions__surfaces.effect.vibe"
import type { Observation } from "../../../conversation/turn-context.schema.vibe"
import { openViewAllowed, supportedViews, viewProfileWire } from "../../capabilities.vibe"
import { CalendarSource, type MapsReadSelected } from "../../operation-schemas/personal.schema.vibe"
import { readOperation, type CheckedOperation, type DeviceOperation, type DeviceOperationType } from "../../operations.schema.vibe"
import { photosDecision, photosViewGuidance } from "../../photos-view.vibe"
import { viewProfile, type DeviceStoreUnavailable } from "../../store.vibe"
import { directRequests, type DeviceProposalFamily, type DeviceTurn, type Grounding, type MessageAvailability, type NegotiatedDevice, type ProposalForm, type WholeRequestRoute } from "../family.vibe"
import { cameraWords } from "../surfaces/camera-request.ts"

type Refusal = Extract<Grounding, { readonly kind: "Refused" }>

const text = (description: string): ActionParameterSchema => ({ type: "string", description })
const libraryIds = (maximum: number): ActionParameterSchema => ({
  type: "array", items: { type: "string" }, description: `1 to ${maximum} distinct library ids the phone returned; never guessed`,
})
const openItem: ActionParameterSchema = { type: "boolean", enum: [true], description: "true: the item the owner has open in the Photos viewer" }
const epoch = (description: string): ActionParameterSchema => ({ type: "integer", description })

function branch(type: DeviceOperationType, required: readonly string[], properties: Readonly<Record<string, ActionParameterSchema>>): ActionParameterSchema {
  return { type: "object", additionalProperties: false, required: ["type", ...required], properties: { type: { type: "string", enum: [type] }, ...properties } }
}

const cameraGuidance = "camera_capture_photo takes one still image and saves it in Photos; it is how a request to take a picture, photo or selfie is done. Opening the Camera view with VIEWS never takes a photo, and the owner is never asked to press the shutter instead. The photo is taken on the visible Camera viewfinder: when another view is showing, the requesting phone opens Camera itself before it takes a photo the owner asked for, so no VIEWS step is needed; if you do show Camera with VIEWS in the same turn, propose camera_capture_photo as the last step. It sends no pixels to the model. A saved-photo receipt proves the capture."
const libraryIdGuidance = "The saved-photo receipt also has libraryId, the photo's library id. When Photos operations are offered, use that id with them for the photo just taken."
const libraryGuidance = "photo_library_search {kind image|video|all, from, to: epoch ms taken, favorites, limit 1-50} lists items Android lets the phone read and returns their id, revision, kind, dates, size in pixels and video length only: no file or album names, no place, no pixels. photo_library_inspect {id} returns the same details for one item. photo_library_select {ids} selects items in Photos and runs directly only when the owner's current message asked for it. photo_library_review {action trash|share|favorite|unfavorite, items: [{id, revision}]} opens a review the owner confirms in the phone and then in Android; review_opened proves no change and no share. Search takes no words: find items by date, kind or favorite. Use only ids and revisions the phone returned; never guess them."
const mapsGuidance = "maps_read_selected requires the exact current observation selectedObject kind, id and revision of the place or route selected in Maps; never infer coordinates from the opaque identifier."
const noteGuidance = "create_note creates a text note in the phone's own Notes. It can be proposed only on a message whose Notes screen selects the phone's own Notes; on any other message a request to make or save a note uses the canonical NOTES service."
const canonicalNoteGuidance = "This phone offers no note of its own to chat: a request to make or save a note uses the canonical NOTES service."
const photoCommandLead = "The owner's whole message asks for a photo now: camera_capture_photo is proposed for it, and no other device operation is. Opening Camera with VIEWS takes no photo and is refused on this message."
const viewsLead = "Open app views with VIEWS (mode show) on this message; ordinary navigation does not need a phone approval. Use the device tool only for the remaining reviewed device actions."
const viewsUnavailable = "VIEWS cannot show a view on this message."
const recordSourceGuidance = "Phone-native Notes and Calendar data uses these device reviews. A lookup, named record or new event the phone resolves itself works from Home or the Notes or Calendar view; an operation on an exact record or source needs it selected on the phone. Other Notes and Calendar requests, and any turn with a canonical Notes or Calendar selection, use the canonical NOTES or CALENDAR service; a phone capability never redirects a canonical record."

function needed(opType: OperationType, versionTwo = false): (device: NegotiatedDevice) => boolean {
  return (device) => meets(device.negotiation, operationNeed(opType, versionTwo))
}

const recordSource = Schema.is(CalendarSource)

function phoneNotesSelected(observation: Observation): boolean {
  const selected = observation.selectedObject
  if (selected?.kind === "note-source") return recordSource({ sourceId: selected.id, sourceRevision: selected.revision })
  if (selected?.kind !== "note") return false
  const target = { sourceId: selected.accountId, sourceRevision: selected.sourceRevision, noteId: selected.id, revision: selected.revision }
  return readOperation({ type: "notes_read_selected", target }) !== undefined
}

function notesSelected(turn: DeviceTurn): boolean {
  const observation = turn.observation
  return observation !== undefined && noteAvailable(observation.view === "notes", observation.sensitive, phoneNotesSelected(observation))
}

const noteNow: MessageAvailability = {
  unavailable: "the owner's Notes screen does not select the phone's own Notes, so a request to make or save a note uses the canonical NOTES service",
  available: notesSelected,
}
const openViewNow: MessageAvailability = {
  unavailable: "views open with VIEWS on this message",
  available: (turn) => openViewAvailable(turn.completedActionNavigation),
}

const captureForm: ProposalForm = { types: ["camera_capture_photo"], schema: branch("camera_capture_photo", [], {}), guidance: cameraGuidance, offered: needed("CameraCapturePhoto") }

function ownerChat(turn: DeviceTurn): boolean {
  const channel = turn.message.content.channelType
  return channel === undefined || channel === "DM" || channel === "VOICE_DM"
}

const photoCommand: WholeRequestRoute = {
  id: "device.camera-capture",
  replaces: ["VIEWS", "VIEWS_SHOW"],
  tags: ["domain:camera", "capability:capture", "effect:receipt-required", "target:selected-device"],
  contexts: ["media", "general"],
  lead: photoCommandLead,
  claims: (turn) => photoCommandRouted(ownerChat(turn), captureForm.offered(turn), cameraWords(turn.ownerText, turn.assistantName)) ? [captureForm] : [],
}

function normalWords(text: string): string {
  return text.toLowerCase().replace(/\s+/g, " ").trim().replace(/[.!?]+$/, "")
}

function noteSaidByOwner(ownerText: string, note: { readonly title: string; readonly body: string }): boolean {
  const said = normalWords(ownerText)
  return said.includes(normalWords(note.title)) && said.includes(normalWords(note.body))
}

const forms: readonly ProposalForm[] = [
  captureForm,
  {
    types: ["photo_library_search"], guidance: libraryGuidance, offered: needed("PhotoLibrarySearch"),
    schema: branch("photo_library_search", [], {
      kind: { type: "string", enum: ["image", "video", "all"] }, from: epoch("Taken from, epoch milliseconds"), to: epoch("Taken until, epoch milliseconds"),
      favorites: { type: "boolean" }, limit: { type: "integer", minimum: 1, maximum: 50 },
    }),
  },
  { types: ["photo_library_inspect"], guidance: libraryGuidance, offered: needed("PhotoLibraryInspect"), schema: branch("photo_library_inspect", ["id"], { id: text("One library id the phone returned") }) },
  { types: ["photo_library_select"], guidance: libraryGuidance, offered: needed("PhotoLibrarySelect"), schema: branch("photo_library_select", ["ids"], { ids: libraryIds(20) }) },
  {
    types: ["photo_library_review"], guidance: libraryGuidance, offered: needed("PhotoLibraryReview"),
    schema: branch("photo_library_review", ["action", "items"], {
      action: { type: "string", enum: ["trash", "share", "favorite", "unfavorite"] },
      items: {
        type: "array", description: "1 to 20 items, each an id and revision the phone returned",
        items: { type: "object", additionalProperties: false, required: ["id", "revision"], properties: { id: { type: "string" }, revision: { type: "string" } } },
      },
    }),
  },
  {
    types: ["photos_filter"], offered: needed("PhotosFilter"),
    schema: branch("photos_filter", [], {
      from: epoch("Start, epoch milliseconds"), to: epoch("End, epoch milliseconds"), kind: { type: "string", enum: ["image", "video"] },
      favorite: { type: "boolean" }, album: text("One of favorites, videos, camera, screenshots, or custom:<album id>"), text: text("At most 80 characters"),
    }),
  },
  { types: ["photos_open"], offered: needed("PhotosOpen"), schema: branch("photos_open", ["id"], { id: text("One library id") }) },
  {
    types: ["photos_album_create"], offered: needed("PhotosAlbumCreate"),
    schema: branch("photos_album_create", ["name", "ids"], { name: text("Album name, 1 to 80 characters"), ids: libraryIds(200) }),
  },
  {
    types: ["photos_album_create"], offered: needed("PhotosAlbumCreate", true),
    schema: branch("photos_album_create", ["name", "selected"], { name: text("Album name, 1 to 80 characters"), selected: openItem }),
  },
  { types: ["photos_share"], offered: needed("PhotosShare"), schema: branch("photos_share", ["ids"], { ids: libraryIds(100) }) },
  { types: ["photos_share"], offered: needed("PhotosShare", true), schema: branch("photos_share", ["selected"], { selected: openItem }) },
  {
    types: ["create_note"], guidance: noteGuidance, offered: needed("CreateNote"), now: noteNow,
    schema: branch("create_note", ["title", "body"], { title: text("The note's title, 1 to 256 characters"), body: text("The note's text, at most 32000 characters") }),
  },
  { types: ["open_view"], offered: needed("OpenView"), now: openViewNow, schema: branch("open_view", ["view"], { view: { type: "string", enum: [...supportedViews] } }) },
  {
    types: ["maps_read_selected"], guidance: mapsGuidance, offered: needed("MapsReadSelected"),
    schema: branch("maps_read_selected", ["target"], {
      target: {
        type: "object", additionalProperties: false, required: ["kind", "id", "revision"],
        properties: { kind: { type: "string", enum: ["map-place", "map-route"] }, id: { type: "string" }, revision: { type: "string" } },
      },
    }),
  },
]

const viewDisabled: Refusal = {
  kind: "Refused", code: "DEVICE_VIEW_UNAVAILABLE",
  forModel: "This view is not enabled on the owner's phone. No device proposal was created. Do not propose it again unless the owner enables it.",
  forOwner: "That view isn't turned on for your phone.",
}
const selectionUnseen: Refusal = {
  kind: "Refused", code: "MAPS_SELECTION_UNAVAILABLE",
  forModel: "Maps observation unavailable or changed: maps_read_selected must name exactly the place or route selected on the owner's Maps screen this turn. No device proposal was created.",
  forOwner: "Select the place or route in Maps, then ask me again.",
}

function grounded(turn: DeviceTurn, verdict: SurfaceVerdict, operation: DeviceOperation): Grounding {
  return { kind: "Grounded", operation, grounding: surfaceBound(directRequests(turn), verdict) ? "GroundedAsAsked" : "GroundedForReview" }
}

function decided(turn: DeviceTurn, verdict: SurfaceVerdict, operation: DeviceOperation, refusal: Refusal): Grounding {
  return verdict === "SurfaceRefused" ? refusal : grounded(turn, verdict, operation)
}

function mapsGrounding(operation: MapsReadSelected, turn: DeviceTurn): Grounding {
  const observation = turn.observation
  const selected = observation?.selectedObject
  const extraFields = selected !== undefined &&
    (selected.accountId !== undefined || selected.sourceRevision !== undefined || selected.occurrenceId !== undefined || selected.timingVersion !== undefined)
  const sameTarget = selected !== undefined &&
    selected.kind === operation.target.kind && selected.id === operation.target.id && selected.revision === operation.target.revision
  return decided(turn, mapsVerdict(observation?.view === "maps", observation?.sensitive !== false, extraFields, sameTarget), operation, selectionUnseen)
}

effect function openViewGrounding(view: string, operation: DeviceOperation, turn: DeviceTurn): Grounding!DeviceStoreUnavailable {
  const profile = try viewProfile(turn.runtime.adapter)
  return decided(turn, openViewVerdict(openViewAllowed(profile, revisionOf(profile), view)), operation, viewDisabled)
}

function profileGuidance(device: NegotiatedDevice): string | undefined {
  const wire = device.viewProfile === undefined ? null : viewProfileWire(device.viewProfile)
  if (wire === null || !needed("OpenView")(device)) return undefined
  return `The authenticated installation enabled-view profile allows open_view only for [${wire.views.map((view) => `"${view}"`).join(",")}]. Do not offer or propose another view. This subset is not approval to execute.`
}

const types: readonly DeviceOperationType[] = [...new Set(forms.flatMap((form) => form.types))]

export const surfacesFamily: DeviceProposalFamily = {
  name: "surfaces",
  types,
  forms,
  route: photoCommand,
  guidance: (device) => {
    const notes = [
      negotiatedHas(device.negotiation, "CameraCapturePhotoV1") && negotiatedHas(device.negotiation, "CameraLibraryIdV1") ? libraryIdGuidance : undefined,
      photosViewGuidance(device.negotiation),
      needed("CreateNote")(device) ? recordSourceGuidance : canonicalNoteGuidance,
      profileGuidance(device),
    ].filter((note) => note !== undefined)
    return notes.length === 0 ? undefined : notes.join(" ")
  },
  now: (turn) => viewsShowsOnDevice(turn.completedActionNavigation) ? viewsLead : viewsUnavailable,
  wholeMessageOperation: (turn) => photoCommand.claims(turn).length > 0 ? { type: "camera_capture_photo" } : undefined,
  effect ground(proposed: CheckedOperation, turn: DeviceTurn) {
    const operation = proposed.operation
    switch (operation.type) {
      case "camera_capture_photo": return grounded(turn, captureVerdict(cameraWords(turn.ownerText, turn.assistantName)), operation)
      case "open_view": return try openViewGrounding(operation.view, operation, turn)
      case "maps_read_selected": return mapsGrounding(operation, turn)
      case "create_note": return grounded(turn, noteVerdict(noteSaidByOwner(turn.ownerText, operation)), operation)
      default: {
        const photos = try photosDecision(proposed, turn)
        return decided(turn, photos.verdict, operation, photos.refusal)
      }
    }
  },
  proposedText: (operation, { direct }) => operation.type === "camera_capture_photo" && direct ? {
    forOwner: "Opening Camera to take the photo.",
    forModel: "The requesting phone takes this requested photo right after this reply once Camera is showing, with no review. No photo has been taken yet; do not claim that one was taken or saved.",
  } : undefined,
  settledText: () => undefined,
}
