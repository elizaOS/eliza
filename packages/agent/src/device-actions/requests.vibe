// spec/agent/deviceActions/index.md, "An offer goes only to the enrolled device, for a capability it declared"; spec/agent/deviceActions/index.md, "Only the exact binding decides an open offer before its deadline"; spec/agent/deviceActions/index.md, "An unclaimed offer retires at its deadline or at the end of its turn"; spec/agent/deviceActions/index.md, "The claim commits the dispatch once, before the deadline"; spec/agent/deviceActions/index.md, "A receipt from the claimed attempt settles a dispatched request once"; spec/agent/deviceActions/index.md, "Only a confirmed review settles an uncertain request"; spec/agent/deviceActions/index.md, "The proposal shows its read reply origin only while the offer is open"; spec/agent/deviceActions/capabilities.md, "A request negotiates exactly the capabilities its header names, and only on a live enrollment"; spec/agent/deviceActions/capabilities.md, "An operation runs only on a request that negotiated what it needs"; spec/agent/deviceActions/capabilities.md, "An open-view proposal runs only on the profile revision it bound and a view the profile enables"; spec/agent/deviceActions/operations.md, "A proposal is valid only when its shape, its need and its binding all hold"; spec/agent/deviceActions/operations.md, "Only an applied receipt settles applied, and only a trusted refusal settles that nothing ran"
module node {
  import { createHash, randomUUID } from "node:crypto"
  import { isDeepStrictEqual } from "node:util"

  /** @throws {never} */
  export function freshId(): string {
    return randomUUID()
  }

  /** @throws {never} */
  export function sameResult(a: unknown, b: unknown): boolean {
    return isDeepStrictEqual(a ?? null, b ?? null)
  }

  /** @throws {never} */
  export function digestOf(value: unknown): string {
    return createHash("sha256").update(JSON.stringify(value)).digest("hex")
  }
}

import { Service, type IAgentRuntime, type Memory, type RunEventPayload, type ServiceClass, type UUID } from "@elizaos/core"
import { canEndTurn, canExpire, openOffer, showsReadReplyOrigin, type DeviceRequest, type Event, type ReviewOutcome } from "../../gen/agent__deviceActions.effect.vibe"
import { capabilityName, negotiatedHas, revisionOf, type Need, type Negotiation, type RevisionRead } from "../../gen/agent__deviceActions__capabilities.effect.vibe"
import type { OperationType, ReadBinding } from "../../gen/agent__deviceActions__operations.effect.vibe"
import type { SessionOwner } from "../../gen/core__sessions.effect.vibe"
import type { LocalRoute, RouteInput } from "../access/routes.vibe"
import { deviceConversation } from "../conversation/turns.vibe"
import type { ModuleContext } from "../host/module.vibe"
import { capabilitiesHeader, negotiation, openViewAllowed } from "./capabilities.vibe"
import { readOperation, receiptOutcome, validate, type CheckedOperation } from "./operations.schema.vibe"
import type { StoredRequest } from "./read-completion.vibe"
import { DeviceStoreUnavailable, listRequests, offerRequest, openRequest, viewProfile, type DeviceRequestRecord, type RequestRow, type RequestTerms } from "./store.vibe"
import { digestOf, freshId, sameResult } from node

export const proposeDeviceActionServiceType = "proposeDeviceAction"
export const offerLifetimeMs = 600_000

export type DeviceActionRefusal = "no_device_turn" | "device_unauthorized" | "operation_refused" | "view_unavailable" | "no_conversation" | "offer_refused"

export error DeviceActionRefused { reason: DeviceActionRefusal }

export interface DeviceActionAsk {
  readonly message: Memory
  readonly operation: unknown
  readonly binding?: ReadBinding
}

export interface DeviceActionOffer {
  readonly proposalId: string
  readonly digest: string
  readonly expiresAt: number
  readonly capability: string
  readonly readBack: boolean
}

export interface ProposeDeviceActionService extends Service {
  beginTurn(message: Pick<Memory, "id" | "roomId">, headers: ReadonlyMap<string, string>): Promise<void>
  propose(ask: DeviceActionAsk): Promise<DeviceActionOffer>
}

export type DeviceSender = (input: RouteInput) => (SessionOwner | undefined)!DeviceStoreUnavailable

export interface DeviceRequests {
  readonly service: ServiceClass
  readonly routes: LocalRoute[]
  readonly open: (proposalId: string) => (StoredRequest | undefined)!DeviceStoreUnavailable
  readonly turnEnded: (payload: RunEventPayload) => Promise<void>
}

interface AskingRequest {
  readonly requestId: string
  readonly sender: SessionOwner | undefined
  readonly negotiation: Negotiation
  readonly boundAt: number
}

type Answer = { readonly status: number; readonly body: object }

const failure = (status: number, error: string): Answer => ({ status, body: { error } })

const originalReads: ReadonlySet<OperationType> = new Set<OperationType>([
  "CalendarReadNext", "CalendarReadSelected", "ReminderReadSelected", "CalendarAvailability", "NotesSearch", "CalendarNamedRead",
  "MapsReadSelected", "NotesReadSelected", "NotesQuery", "PhotoLibrarySearch", "PhotoLibraryInspect", "MessagesReadSelected",
  "VoicemailReadSelected", "ReadSelectedNotes", "ReadCalendarRange", "ReadSelectedReminders",
])

const reviewOf = { applied: "ReviewedApplied", not_applied: "ReviewedNotApplied", unresolved: "ReviewedUnresolved" } as const satisfies Record<string, ReviewOutcome>

const Digest = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128))
const Attempt = Schema.Int.check(Schema.isGreaterThanOrEqualTo(1))
const strict = { onExcessProperty: "error" } as const
const decodeDecide = Schema.decodeUnknownOption(Schema.Struct({ digest: Digest, approved: Schema.Boolean }), strict)
const decodeClaim = Schema.decodeUnknownOption(Schema.Struct({ digest: Digest }), strict)
const decodeReceipt = Schema.decodeUnknownOption(Schema.Struct({ digest: Digest, attemptId: Attempt, receipt: Schema.Unknown }), strict)
const decodeReconcile = Schema.decodeUnknownOption(Schema.Struct({ digest: Digest, attemptId: Attempt, review: Schema.Literals(["applied", "not_applied", "unresolved"]) }), strict)

function viewOf(checked: CheckedOperation): string | undefined {
  const operation: object = checked.operation
  return checked.opType === "OpenView" && "view" in operation && typeof operation.view === "string" ? operation.view : undefined
}

function offeredCapability(need: Need, negotiated: Negotiation): string {
  const chosen = need.required[0] ?? need.oneOf.find((capability) => negotiatedHas(negotiated, capability))
  return chosen === undefined ? "" : capabilityName(chosen)
}

function proposalWire(proposalId: string, state: DeviceRequest, terms: RequestTerms) {
  return {
    id: proposalId, digest: state.digest, capability: state.capability, operation: terms.operation, phase: state.phase,
    expiresAt: state.session.expiresAt, attemptId: state.session.currentClaim,
    ...(showsReadReplyOrigin(state) ? { readReplyOrigin: state.origin } : {}),
  }
}

export function deviceRequests(context: Pick<ModuleContext, "runtime" | "launch">, deviceSender: DeviceSender): DeviceRequests {
  const runtime = context.runtime
  const adapter = runtime.adapter
  const readCompletion = context.launch.hostContextRevision !== undefined
  const lock = Semaphore.makeUnsafe(1)
  const turns = new Map<string, AskingRequest>()

  const asked = (headers: ReadonlyMap<string, string>): RouteInput => ({ parameters: new Map(), query: new Map(), headers, body: undefined, signal: new AbortController().signal })
  const negotiated = (input: RouteInput) => negotiation(true, input.headers.get(capabilitiesHeader))

  effect function sent(record: DeviceRequestRecord, event: Event, by: SessionOwner): (DeviceRequest | undefined)!DeviceStoreUnavailable {
    const done = try lock.withPermits(1)(Effect.result(record.machine.send(event, by)))
    return Result.isSuccess(done) ? done.success : undefined
  }

  effect function moved(row: RequestRow, event: Event, by: SessionOwner): (DeviceRequest | undefined)!DeviceStoreUnavailable {
    const record = try openRequest(adapter, row.proposalId)
    return record === undefined ? undefined : try sent(record, event, by)
  }

  effect function openRows(by: SessionOwner): RequestRow[]!DeviceStoreUnavailable {
    const live: RequestRow[] = []
    for (const row of try listRequests(adapter, "open")) {
      if (canExpire(row.state)) try moved(row, { type: "expire" }, by)
      else live.push(row)
    }
    return live
  }

  effect function conversationOf(roomId: UUID): (string | undefined)!DeviceStoreUnavailable {
    const room = try tryPromise({ try: () => runtime.getRoom(roomId), catch: (cause) => new DeviceStoreUnavailable({ step: "read the conversation", cause }) })
    return room === null ? undefined : try sync(() => deviceConversation(room)?.id)
  }

  effect function beginTurn(message: Pick<Memory, "id" | "roomId">, headers: ReadonlyMap<string, string>): void!DeviceStoreUnavailable {
    if (message.id === undefined) return
    const sender = try deviceSender(asked(headers))
    const boundAt = try Clock.currentTimeMillis
    turns.set(message.id, { requestId: freshId(), sender, negotiation: negotiation(sender !== undefined, headers.get(capabilitiesHeader)), boundAt })
    if (sender === undefined) return
    const conversationId = try conversationOf(message.roomId)
    for (const row of try openRows(sender)) {
      const origin = row.state.origin
      if (origin.conversationId === conversationId && origin.inReplyTo !== message.id && canEndTurn(row.state)) try moved(row, { type: "endTurn" }, sender)
    }
  }

  effect function propose(ask: DeviceActionAsk): DeviceActionOffer!(DeviceActionRefused | DeviceStoreUnavailable) {
    const asking = ask.message.id
    const turn = asking === undefined ? undefined : turns.get(asking)
    if (asking === undefined || turn === undefined) throw new DeviceActionRefused({ reason: "no_device_turn" })
    const by = turn.sender
    if (by === undefined) throw new DeviceActionRefused({ reason: "device_unauthorized" })
    const binding = ask.binding ?? "NoBinding"
    const checked = validate(ask.operation, turn.negotiation, binding)
    if (checked === undefined) throw new DeviceActionRefused({ reason: "operation_refused" })
    const view = viewOf(checked)
    const profile = view === undefined ? undefined : try viewProfile(adapter)
    const boundProfile: RevisionRead = profile === undefined ? { tag: "NoRevisionRead" } : revisionOf(profile)
    if (profile !== undefined && view !== undefined && !openViewAllowed(profile, boundProfile, view)) throw new DeviceActionRefused({ reason: "view_unavailable" })
    const conversationId = try conversationOf(ask.message.roomId)
    if (conversationId === undefined) throw new DeviceActionRefused({ reason: "no_conversation" })
    const proposalId = freshId()
    const expiresAt = (try Clock.currentTimeMillis) + offerLifetimeMs
    const capability = offeredCapability(checked.need, turn.negotiation)
    const readBack = readCompletion && binding !== "WorkflowBinding" && originalReads.has(checked.opType)
    const digest = digestOf([proposalId, by, checked.operation, expiresAt])
    const origin = { requestId: turn.requestId, conversationId, inReplyTo: asking }
    const terms: RequestTerms = { operation: checked.operation, binding, boundProfile, need: checked.need }
    const offered = try lock.withPermits(1)(Effect.result(offerRequest(adapter, { type: "offer", proposalId, digest, capability, expiresAt, readBack, origin }, by, terms)))
    if (Result.isFailure(offered)) {
      if (offered.failure instanceof DeviceStoreUnavailable) throw offered.failure
      throw new DeviceActionRefused({ reason: "offer_refused" })
    }
    return { proposalId, digest, expiresAt, capability, readBack }
  }

  effect function admitted(record: { readonly terms: RequestTerms }, header: Negotiation): boolean!DeviceStoreUnavailable {
    const checked = validate(record.terms.operation, header, record.terms.binding)
    if (checked === undefined) return false
    const view = viewOf(checked)
    return view === undefined || openViewAllowed(try viewProfile(adapter), record.terms.boundProfile, view)
  }

  effect function list(input: RouteInput): Answer!DeviceStoreUnavailable {
    const by = try deviceSender(input)
    if (by === undefined) return failure(401, "device_unauthorized")
    const header = negotiated(input)
    if (header.tag === "Refused") return failure(400, "invalid_capabilities")
    const proposals: object[] = []
    for (const row of try openRows(by)) {
      if (!openOffer(row.state.phase) || (try admitted(row, header))) proposals.push(proposalWire(row.proposalId, row.state, row.terms))
    }
    return { status: 200, body: { proposals } }
  }

  effect function onRequest(input: RouteInput, work: (record: DeviceRequestRecord, by: SessionOwner) => Answer!DeviceStoreUnavailable): Answer!DeviceStoreUnavailable {
    const by = try deviceSender(input)
    if (by === undefined) return failure(401, "device_unauthorized")
    const record = try openRequest(adapter, input.parameters.get("id") ?? "")
    return record === undefined ? failure(404, "unknown_proposal") : try work(record, by)
  }

  effect function settled(record: DeviceRequestRecord, event: Event, by: SessionOwner): Answer!DeviceStoreUnavailable {
    const next = try sent(record, event, by)
    return next === undefined ? failure(409, "request_refused") : { status: 200, body: { proposal: proposalWire(record.proposalId, next, record.terms) } }
  }

  effect function decide(input: RouteInput): Answer!DeviceStoreUnavailable {
    const body = decodeDecide(input.body)
    if (Option.isNone(body)) return failure(400, "invalid_decision")
    const { digest, approved } = body.value
    return try onRequest(input, effect function (record: DeviceRequestRecord, by: SessionOwner): Answer!DeviceStoreUnavailable {
      if (approved && !(try admitted(record, negotiated(input)))) return failure(409, "need_not_met")
      return try settled(record, { type: "decide", digest, approved }, by)
    })
  }

  effect function claim(input: RouteInput): Answer!DeviceStoreUnavailable {
    const body = decodeClaim(input.body)
    if (Option.isNone(body)) return failure(400, "invalid_claim")
    const digest = body.value.digest
    return try onRequest(input, effect function (record: DeviceRequestRecord, by: SessionOwner): Answer!DeviceStoreUnavailable {
      if (!(try admitted(record, negotiated(input)))) return failure(409, "need_not_met")
      const next = try sent(record, { type: "claim", digest }, by)
      if (next === undefined) return failure(409, "claim_refused")
      return { status: 200, body: { attemptId: next.session.currentClaim, proposal: proposalWire(record.proposalId, next, record.terms) } }
    })
  }

  effect function receipt(input: RouteInput): Answer!DeviceStoreUnavailable {
    const body = decodeReceipt(input.body)
    if (Option.isNone(body)) return failure(400, "invalid_receipt")
    const { digest, attemptId, receipt: sentReceipt } = body.value
    return try onRequest(input, effect function (record: DeviceRequestRecord, by: SessionOwner): Answer!DeviceStoreUnavailable {
      const checked = readOperation(record.terms.operation)
      if (checked === undefined) return try die(new Error(`The stored operation of ${record.proposalId} no longer reads`))
      const verdict = receiptOutcome(checked, sentReceipt, record.proposalId)
      if (verdict.kind === "refused") return failure(409, "receipt_refused")
      const before = try record.machine.get()
      if (before.phase.tag === "Receipted" && !sameResult(record.result, verdict.result)) return failure(409, "receipt_changed")
      const target = before.phase.tag === "Dispatched" && verdict.result !== undefined
        ? try openRequest(adapter, record.proposalId, { result: verdict.result })
        : record
      if (target === undefined) return failure(404, "unknown_proposal")
      return try settled(target, { type: "receipt", digest, attemptId, reportedOutcome: verdict.reported }, by)
    })
  }

  effect function reconcile(input: RouteInput): Answer!DeviceStoreUnavailable {
    const body = decodeReconcile(input.body)
    if (Option.isNone(body)) return failure(400, "invalid_review")
    const { digest, attemptId, review } = body.value
    return try onRequest(input, effect function (record: DeviceRequestRecord, by: SessionOwner): Answer!DeviceStoreUnavailable {
      return try settled(record, { type: "reconcile", digest, attemptId, review: reviewOf[review] }, by)
    })
  }

  function answered(work: Answer!DeviceStoreUnavailable): Promise<Answer> {
    return runPromise(work).catch((cause: unknown) => {
      runtime.logger.error({ src: "device-actions", cause: cause instanceof Error ? cause.message : String(cause) }, "Device request store unavailable")
      return failure(503, "store_unavailable")
    })
  }

  class DeviceRequestService extends Service implements ProposeDeviceActionService {
    static override serviceType = proposeDeviceActionServiceType
    override capabilityDescription = "Offers device operations to the owner's enrolled device during the turn that asked for them"

    static override start(started: IAgentRuntime): Promise<Service> {
      return Promise.resolve(new DeviceRequestService(started))
    }

    beginTurn(message: Pick<Memory, "id" | "roomId">, headers: ReadonlyMap<string, string>): Promise<void> {
      return runPromise(beginTurn(message, headers))
    }

    propose(ask: DeviceActionAsk): Promise<DeviceActionOffer> {
      return runPromise(propose(ask))
    }

    override stop(): Promise<void> {
      turns.clear()
      return Promise.resolve()
    }
  }

  return {
    service: DeviceRequestService,
    open: (proposalId) => openRequest(adapter, proposalId),
    turnEnded: (payload) => {
      if ((turns.get(payload.messageId)?.boundAt ?? Infinity) <= Number(payload.startTime)) turns.delete(payload.messageId)
      return Promise.resolve()
    },
    routes: [
      { method: "GET", path: "/api/client-devices/proposals", handler: (input) => answered(list(input)) },
      { method: "POST", path: "/api/client-devices/proposals/{id}/decide", handler: (input) => answered(decide(input)) },
      { method: "POST", path: "/api/client-devices/proposals/{id}/claim", handler: (input) => answered(claim(input)) },
      { method: "POST", path: "/api/client-devices/proposals/{id}/receipt", handler: (input) => answered(receipt(input)) },
      { method: "POST", path: "/api/client-devices/proposals/{id}/reconcile", handler: (input) => answered(reconcile(input)) },
    ],
  }
}
