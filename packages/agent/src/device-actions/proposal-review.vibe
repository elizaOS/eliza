// spec/agent/deviceActions/index.md, "Only the exact binding decides an open offer before its deadline"; spec/agent/deviceActions/index.md, "A proposal carries the owner's message only for a live turn that asked for it directly, so otherwise the phone shows its card"; spec/agent/deviceActions/index.md, "The claim commits the dispatch once, before the deadline"; spec/agent/deviceActions/index.md, "A receipt from the claimed attempt settles a dispatched request once"; spec/agent/deviceActions/index.md, "Only a confirmed review settles an uncertain request"; spec/agent/deviceActions/index.md, "The proposal shows its read reply origin only while the offer is open"; spec/agent/deviceActions/operations.md, "A proposal is valid only when its shape, its need and its binding all hold"; spec/agent/deviceActions/capabilities.md, "An open-view proposal runs only on the profile revision it bound and a view the profile enables"
module node {
  import { Effect, Option, Schema } from "effect"
  import type { IDatabaseAdapter } from "@elizaos/core"
  import { canExpire, reviewEvidenceAdmitted, showsReadReplyOrigin, type DeviceRequest, type ReviewEvidence, type ReviewOutcome } from "../../gen/agent__deviceActions.effect.vibe"
  import type { SessionOwner } from "../../gen/core__sessions.effect.vibe"
  import type { LocalRoute, RouteInput } from "../access/routes.vibe"
  import { capabilitiesHeader, negotiation, openViewAllowed } from "./capabilities.vibe"
  import { enrollmentId, type DeviceEnrollment } from "./enrollment.vibe"
  import { receiptOutcome, validate, type CheckedOperation, type DeviceOperation, type DeviceReceipt } from "./operations.schema.vibe"
  import {
    deviceReviewRows, recordRequestClaim, recordRequestDecision, recordRequestReceipt, recordRequestReview, requestSnapshot, viewProfile,
    type ProposalReviewScope, type RequestRow,
  } from "./store.vibe"

  const Digest = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/))
  const AttemptId = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/))
  const Decision = Schema.Struct({ digest: Digest, decision: Schema.Literals(["approve", "reject"]) })
  const Claim = Schema.Struct({ digest: Digest })
  const Receipt = Schema.Struct({ digest: Digest, attemptId: AttemptId, receipt: Schema.Unknown })
  const AppliedEvidence = Schema.Struct({ operationId: Schema.String, result: Schema.optionalKey(Schema.Unknown) })
  const Reconciliation = Schema.Struct({
    digest: Digest, attemptId: AttemptId, review: Schema.Literals(["applied", "not_applied", "unresolved"]), applied: Schema.optionalKey(AppliedEvidence),
  })
  const decision = Schema.decodeUnknownOption(Decision, { onExcessProperty: "error" })
  const claim = Schema.decodeUnknownOption(Claim, { onExcessProperty: "error" })
  const receipt = Schema.decodeUnknownOption(Receipt, { onExcessProperty: "error" })
  const reconciliation = Schema.decodeUnknownOption(Reconciliation, { onExcessProperty: "error" })
  const failure = (status: number, error: string) => ({ status, body: { error } })
  const wireTime = (instant: number) => new Date(instant).toISOString()

  type WireReview = typeof Reconciliation.Type["review"]
  const reviews = { applied: "ReviewedApplied", not_applied: "ReviewedNotApplied", unresolved: "ReviewedUnresolved" } as const satisfies Record<WireReview, ReviewOutcome>
  const reviewWire = { ReviewedApplied: "applied", ReviewedNotApplied: "not_applied", ReviewedUnresolved: "unresolved" } as const satisfies Record<ReviewOutcome, WireReview>

  export type AgendaOperation = Extract<DeviceOperation, { type: "read_calendar_range" }>
  export interface CalendarAgendaSource {
    readonly sourceId: string
    readonly sourceRevision: string
  }
  export interface WorkflowScope {
    readonly workflowId: string
    readonly versionId: string
    readonly runId: string
    readonly stepId: string
    readonly specDigest: string
  }
  export interface ReviewedTerms {
    readonly operation: DeviceOperation
    readonly calendarAgendaSource?: CalendarAgendaSource
    readonly workflow?: WorkflowScope
    readonly viewProfileRevision?: string
    readonly reviewed?: boolean
  }
  type Reviewed = ReviewedTerms & { readonly checked: CheckedOperation }
  type Request =
    | { readonly kind: "decision"; readonly value: typeof Decision.Type }
    | { readonly kind: "claim"; readonly value: typeof Claim.Type }
    | { readonly kind: "receipt"; readonly value: typeof Receipt.Type }
    | { readonly kind: "reconciliation"; readonly value: typeof Reconciliation.Type }

  type Execution = {
    readonly attemptId: string
    readonly dispatchStartedAt: string
    readonly providerIdempotencyKey: string
    readonly providerReceipt?: DeviceReceipt
    readonly reconciliation?: { readonly review: WireReview }
  }
  type ProposalState =
    | { readonly state: "pending" | "approved" | "rejected" | "expired" }
    | { readonly state: "executing" | "done" | "reconciliation_required"; readonly execution: Execution }

  function scopeOf(binding: RequestRow["terms"]["binding"]): Pick<ReviewedTerms, "calendarAgendaSource" | "workflow"> | undefined {
    if (typeof binding === "string") return binding === "NoBinding" ? {} : undefined
    switch (binding.kind) {
      case "AgendaBinding": return { calendarAgendaSource: { sourceId: binding.sourceId, sourceRevision: binding.sourceRevision } }
      case "WorkflowBinding": {
        const { kind: _kind, ...workflow } = binding
        return { workflow }
      }
    }
  }

  type AdmittedEvidence = { readonly verdict: ReviewEvidence; readonly providerReceipt?: DeviceReceipt; readonly result?: unknown }

  function reviewEvidence(checked: CheckedOperation, applied: typeof AppliedEvidence.Type | undefined, proposalId: string): AdmittedEvidence {
    if (applied === undefined) return { verdict: "NoReviewEvidence" }
    const verdict = receiptOutcome(checked, { outcome: "applied", ...applied }, proposalId)
    if (verdict.kind !== "admitted" || verdict.reported !== "ReportedApplied") return { verdict: "RefusedReviewEvidence" }
    const { outcome, operationId } = verdict.receipt
    return {
      verdict: "AppliedReviewEvidence", result: verdict.result,
      providerReceipt: { outcome, ...(operationId === undefined ? {} : { operationId }), ...(verdict.result === undefined ? {} : { result: verdict.result }) },
    }
  }

  function reviewedOf(record: Pick<RequestRow, "terms">, header: string | undefined): Reviewed | undefined {
    const { binding, boundProfile } = record.terms
    const scope = scopeOf(binding)
    if (scope === undefined) return undefined
    const checked = validate(record.terms.operation, negotiation(true, header), typeof binding === "string" ? binding : binding.kind)
    if (checked === undefined || (scope.calendarAgendaSource !== undefined && checked.operation.type !== "read_calendar_range")) return undefined
    return {
      checked, operation: checked.operation, ...scope,
      ...(boundProfile.tag === "ReadAt" ? { viewProfileRevision: boundProfile.revision } : {}),
      reviewed: record.terms.reviewed === true,
    }
  }

  export function devicePayload(terms: ReviewedTerms, by: SessionOwner, enrollment: string, requestMessageId: string) {
    return {
      action: "device_action", version: 1, installationId: by.connector, enrollmentId: enrollment, operation: terms.operation,
      ...(terms.reviewed === true || requestMessageId === "" ? {} : { requestMessageId }),
      ...(terms.calendarAgendaSource === undefined ? {} : { calendarAgendaSource: terms.calendarAgendaSource }),
      ...(terms.workflow === undefined ? {} : { workflow: terms.workflow }),
      ...(terms.viewProfileRevision === undefined ? {} : { viewProfileRevision: terms.viewProfileRevision }),
    } as const
  }

  function proposal(terms: ReviewedTerms, kept: DeviceRequest, by: SessionOwner, phase: ProposalState) {
    const resolved = phase.state === "pending" || phase.state === "expired" ? {} : {
      resolvedBy: by.actorId, resolutionReason: `Explicit device review:${kept.digest}`,
    }
    return {
      id: kept.proposalId, agentId: by.agentId, requestedBy: by.agentId, subjectUserId: by.actorId, action: "device_action",
      createdAt: wireTime(kept.createdAt), expiresAt: wireTime(kept.session.expiresAt), ...resolved, ...phase,
      payload: devicePayload(terms, by, enrollmentId(kept), kept.origin.inReplyTo),
    }
  }

  function answered(terms: ReviewedTerms, kept: DeviceRequest, by: SessionOwner, phase: ProposalState) {
    return { status: 200, body: { digest: kept.digest, proposal: proposal(terms, kept, by, phase) } }
  }

  function observedPhase({ state, claim, providerReceipt }: Pick<RequestRow, "state" | "claim" | "providerReceipt">): ProposalState | undefined {
    switch (state.phase.tag) {
      case "Offered": return { state: canExpire(state) ? "expired" : "pending" }
      case "Approved": return { state: canExpire(state) ? "expired" : "approved" }
      case "Declined": return { state: "rejected" }
      case "Expired":
      case "Retired": return { state: "expired" }
      case "Dispatched":
      case "Receipted":
      case "Reviewed": {
        if (claim === undefined || (state.phase.tag !== "Dispatched" && providerReceipt === undefined)) return undefined
        const lifecycle = state.phase.tag === "Dispatched" ? "executing"
          : state.phase.tag === "Receipted" && state.phase.reported === "ReportedUnknown" ? "reconciliation_required" : "done"
        return {
          state: lifecycle, execution: {
            attemptId: claim.wireAttemptId, dispatchStartedAt: wireTime(state.claimedAt), providerIdempotencyKey: state.proposalId,
            ...(providerReceipt === undefined ? {} : { providerReceipt }),
            ...(state.phase.tag === "Reviewed" ? { reconciliation: { review: reviewWire[state.phase.reviewed] } } : {}),
          },
        }
      }
      case "Unoffered": return undefined
    }
  }

  export function proposalReviewRoutes(adapter: IDatabaseAdapter, sender: DeviceEnrollment["deviceSender"], scope: ProposalReviewScope): LocalRoute[] {
    async function viewStillAllowed(record: Pick<RequestRow, "terms">, terms: Reviewed): Promise<boolean> {
      if (terms.operation.type !== "open_view") return true
      return openViewAllowed(await Effect.runPromise(viewProfile(adapter)), record.terms.boundProfile, terms.operation.view)
    }
    async function handle(input: RouteInput, event: Request) {
      try {
        const by = await Effect.runPromise(sender(input))
        if (by === undefined) return failure(401, "device_unauthorized")
        const proposalId = input.parameters.get("id") ?? ""
        const record = await Effect.runPromise(requestSnapshot(adapter, proposalId, scope))
        if (record === undefined) return failure(404, "unknown_proposal")
        const terms = reviewedOf(record, input.headers.get(capabilitiesHeader))
        if (terms === undefined) return failure(409, "proposal_scope_refused")
        const request = { proposalId, digest: event.value.digest, by }
        if (event.kind === "decision") {
          if (!await viewStillAllowed(record, terms)) return failure(409, "proposal_scope_refused")
          const approved = event.value.decision === "approve"
          const kept = await Effect.runPromise(recordRequestDecision(adapter, { ...request, approved }))
          return kept.kind === "decided"
            ? answered(terms, kept.state, by, { state: approved ? "approved" : "rejected" })
            : failure(409, "decision_refused")
        }
        if (event.kind === "receipt") {
          const binding = record.claim
          if (binding === undefined || binding.wireAttemptId !== event.value.attemptId) return failure(409, "attempt_refused")
          const checked = receiptOutcome(terms.checked, event.value.receipt, proposalId)
          if (checked.kind !== "admitted") return failure(409, "receipt_refused")
          const { outcome, operationId, code } = checked.receipt
          const providerReceipt = {
            outcome, ...(operationId === undefined ? {} : { operationId }), ...(code === undefined ? {} : { code }),
            ...(checked.result === undefined ? {} : { result: checked.result }),
          }
          const kept = await Effect.runPromise(recordRequestReceipt(adapter, {
            proposalId, by, providerReceipt,
            event: { type: "receipt", attemptId: binding.modelAttemptId, digest: request.digest, reportedOutcome: checked.reported },
          }))
          return kept.kind === "recorded"
            ? answered(terms, kept.state, by, {
              state: checked.reported === "ReportedUnknown" ? "reconciliation_required" : "done",
              execution: {
                attemptId: binding.wireAttemptId, dispatchStartedAt: wireTime(kept.state.claimedAt),
                providerIdempotencyKey: proposalId, providerReceipt,
              },
            })
            : failure(409, "receipt_refused")
        }
        if (event.kind === "reconciliation") {
          const review = reviews[event.value.review]
          const evidence = reviewEvidence(terms.checked, event.value.applied, proposalId)
          if (!reviewEvidenceAdmitted(review, evidence.verdict)) return failure(409, "reconciliation_refused")
          const kept = await Effect.runPromise(recordRequestReview(adapter, {
            ...request, attemptId: event.value.attemptId, review,
            ...(evidence.providerReceipt === undefined ? {} : { evidence: { providerReceipt: evidence.providerReceipt, result: evidence.result } }),
          }))
          if (kept.kind === "attempt_refused") return failure(409, "attempt_refused")
          const phase = kept.kind === "reviewed" ? observedPhase(kept) : undefined
          return kept.kind !== "reviewed" || phase === undefined ? failure(409, "reconciliation_refused") : answered(terms, kept.state, by, phase)
        }
        if (!await viewStillAllowed(record, terms)) return failure(409, "proposal_scope_refused")
        const kept = await Effect.runPromise(recordRequestClaim(adapter, request))
        return kept.kind === "claimed"
          ? answered(terms, kept.state, by, {
            state: "executing", execution: {
              attemptId: kept.binding.wireAttemptId, dispatchStartedAt: wireTime(kept.state.claimedAt), providerIdempotencyKey: proposalId,
            },
          })
          : failure(409, "claim_refused")
      } catch {
        return failure(503, "store_unavailable")
      }
    }

    const posted = <A>(event: string, decode: (body: unknown) => Option.Option<A>, kind: (value: A) => Request): LocalRoute => ({
      method: "POST", path: `/api/client-devices/proposals/{id}/${event}`,
      handler: (input) => {
        const parsed = decode(input.body)
        return Option.isSome(parsed) ? handle(input, kind(parsed.value)) : failure(400, `invalid_${event}`)
      },
    })

    return [
      {
        method: "GET", path: "/api/client-devices/proposals",
        handler: async (input) => {
          try {
            const by = await Effect.runPromise(sender(input))
            if (by === undefined) return failure(401, "device_unauthorized")
            const rows = await Effect.runPromise(deviceReviewRows(adapter, by, scope))
            const header = input.headers.get(capabilitiesHeader)
            const proposals = rows.flatMap((row) => {
              const terms = reviewedOf(row, header)
              const phase = observedPhase(row)
              if (terms === undefined || phase === undefined) return []
              const { state } = row
              return [{
                ...proposal(terms, state, by, phase), digest: state.digest,
                ...(showsReadReplyOrigin(state) ? { readReplyOrigin: { version: 1, ...state.origin } } : {}),
              }]
            })
            return { status: 200, body: { proposals } }
          } catch {
            return failure(503, "store_unavailable")
          }
        },
      },
      posted("decision", decision, (value) => ({ kind: "decision", value })),
      posted("claim", claim, (value) => ({ kind: "claim", value })),
      posted("receipt", receipt, (value) => ({ kind: "receipt", value })),
      posted("reconciliation", reconciliation, (value) => ({ kind: "reconciliation", value })),
    ]
  }
}

export { devicePayload, proposalReviewRoutes, type AgendaOperation, type CalendarAgendaSource, type ReviewedTerms, type WorkflowScope } from node
