// spec/agent/deviceActions/operations.md, "A proposal is valid only when its shape, its need and its binding all hold"; spec/agent/deviceActions/operations.md, "A receipt is admitted only when its evidence agrees with what it reports"
module node {
  import { createHash } from "node:crypto"

  export function revisionOf(fields: readonly unknown[]): string {
    return createHash("sha256").update(JSON.stringify(fields)).digest("hex")
  }
}

import type { OperationType } from "../../../gen/agent__deviceActions__operations.effect.vibe"
import { supportedViews } from "../capabilities.vibe"
import { revisionOf } from node
import type { Evidence, FamilySchemas, OperationSchema, WireOperation } from "./family.vibe"
import { civilDay, day, isoInstant, knownZone, realDate, utf8Bytes, zonedWall } from "./personal.schema.vibe"
import { telephonyOperations } from "./telephony.vibe"

const noControl = (value: string) => !/[\u0000-\u001f\u007f]/.test(value)
const filled = (maximum: number) => Schema.String.check(Schema.isMaxLength(maximum), Schema.makeFilter((value: string) => value.trim() !== "" && !value.includes("\0")))
const blank = (maximum: number) => Schema.String.check(Schema.isMaxLength(maximum), Schema.makeFilter((value: string) => !value.includes("\0")))
const bounded = (minimum: number, maximum: number) => Schema.Int.check(Schema.isBetween({ minimum, maximum }))
const operationId = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/))
const applied: Evidence = { shows: "ReportsApplied", nothingSubmitted: false }

function withoutResult<Op extends WireOperation>(operation: Schema.Decoder<Op>, opType: OperationType): OperationSchema<Op> {
  return { operation, result: undefined, classify: () => ({ opType, versionTwo: false }) }
}

const CameraCapture = Schema.Struct({ type: Schema.Literal("camera_capture_photo") })
export const CameraReceipt = Schema.Struct({
  version: Schema.Literal(1), kind: Schema.Literal("camera_capture_photo"), operationId,
  mediaId: Schema.String.check(Schema.isPattern(/^[1-9][0-9]{0,24}$/)),
  width: bounded(1, 65_536), height: bounded(1, 65_536), mime: Schema.Literal("image/jpeg")
})
const capture = {
  operation: CameraCapture,
  result: CameraReceipt,
  classify: () => ({ opType: "CameraCapturePhoto", versionTwo: false }),
  evidence: (result, _operation, receipt) => receipt.operationId === result.operationId ? applied : undefined
} satisfies OperationSchema<typeof CameraCapture.Type, typeof CameraReceipt.Type>

function fileName(value: string): boolean {
  return value.length > 0 && value.length <= 255 && value === value.trim() &&
    value !== "." && value !== ".." && noControl(value) && !value.includes("/") && !value.includes("\\")
}

const FileName = Schema.Trim.check(Schema.makeFilter(fileName))
const relativeFile = (allowRoot: boolean) => Schema.String
  .check(Schema.isMaxLength(1024), Schema.makeFilter((value: string) => !value.startsWith("/")))
  .pipe(Schema.decodeTo(
    Schema.String.check(Schema.makeFilter((value: string) => value === "" ? allowRoot : value.split("/").every(fileName))),
    SchemaTransformation.transform({ decode: (value) => value.replace(/\/+$/, ""), encode: (value) => value })
  ))
const FilePath = relativeFile(false)
const FolderPath = relativeFile(true)
const Paths = Schema.Array(FilePath).check(
  Schema.isMinLength(1), Schema.isMaxLength(50), Schema.makeFilter((paths) => new Set(paths).size === paths.length)
)
const Reviewed = Schema.Array(Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{43}$/)))
const FileDate = Schema.String.check(
  Schema.isMaxLength(40), Schema.isPattern(/^\d{4}-\d\d-\d\d(?:T[\d:.]+(?:Z|[+-]\d\d:\d\d))?$/),
  Schema.makeFilter((value: string) => Number.isFinite(Date.parse(value)))
)
const FilterText = Schema.String.check(
  Schema.isMaxLength(120), Schema.makeFilter((value: string) => noControl(value) && value.trim() !== "")
).pipe(Schema.decodeTo(Schema.Trimmed,
  SchemaTransformation.transform({ decode: (value) => value.trim(), encode: (value) => value })
))
const FilesFilter = Schema.Struct({
  type: Schema.Literal("files_filter"),
  text: Schema.optionalKey(FilterText),
  kind: Schema.optionalKey(Schema.Literals(["image", "video", "audio", "document", "pdf", "folder"])),
  folder: Schema.optionalKey(FolderPath), from: Schema.optionalKey(FileDate), to: Schema.optionalKey(FileDate)
}).check(Schema.makeFilter(({ text, kind, folder, from, to }) =>
  (text !== undefined || kind !== undefined || folder !== undefined || from !== undefined || to !== undefined) &&
  (from === undefined || to === undefined || Date.parse(from) <= Date.parse(to))
))
const FilesOpen = Schema.Union([
  Schema.Struct({ type: Schema.Literal("files_open"), path: FilePath }),
  Schema.Struct({ type: Schema.Literal("files_open"), shown: bounded(1, Number.MAX_SAFE_INTEGER) })
])
const FilesShare = Schema.Struct({ type: Schema.Literal("files_share"), paths: Paths })
const reviewMatches = ({ paths, reviewed }: { readonly paths: readonly string[]; readonly reviewed?: readonly string[] }) =>
  reviewed === undefined || reviewed.length === paths.length
const FilesMove = Schema.Struct({
  type: Schema.Literal("files_move"), paths: Paths, dest: FolderPath, reviewed: Schema.optionalKey(Reviewed)
}).check(Schema.makeFilter(reviewMatches))
const FilesTrash = Schema.Struct({
  type: Schema.Literal("files_trash"), paths: Paths, reviewed: Schema.optionalKey(Reviewed)
}).check(Schema.makeFilter(reviewMatches))
const FilesFolderCreate = Schema.Struct({ type: Schema.Literal("files_folder_create"), parent: FolderPath, name: FileName })

function absoluteUtc(value: string): boolean {
  const time = Date.parse(value)
  return Number.isFinite(time) && new Date(time).toISOString().replace(".000Z", "Z") === value.replace(".000Z", "Z")
}

const DueAt = Schema.String.check(
  Schema.isPattern(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{3})?Z$/), Schema.makeFilter(absoluteUtc)
)

function browserAddress(value: string): string | undefined {
  const address = value.trim()
  if (address.startsWith("/") && !address.startsWith("//")) return undefined
  const input = /^[A-Za-z][A-Za-z0-9+.-]*:/.test(address) ? address : address.startsWith("//") ? "https:" + address : "https://" + address
  const parsed = URL.parse(input)
  if (parsed === null || parsed.username !== "" || parsed.password !== "") return undefined
  if (parsed.protocol === "http:" && parsed.port === "") parsed.protocol = "https:"
  return parsed.protocol === "https:" ? parsed.href : undefined
}

const Address = filled(4096).pipe(Schema.decodeTo(
  Schema.String.check(Schema.makeFilter((value: string) => value !== "" && browserAddress(value) === value)),
  SchemaTransformation.transform({ decode: (value) => browserAddress(value) ?? "", encode: (value) => value })
))
const CreateNote = Schema.Struct({ type: Schema.Literal("create_note"), title: filled(256), body: blank(32_000) })
const CreateReminder = Schema.Struct({ type: Schema.Literal("create_reminder"), title: filled(200), dueAt: DueAt })
const OpenView = Schema.Struct({ type: Schema.Literal("open_view"), view: Schema.Literals(supportedViews) })
const BrowserNavigate = Schema.Struct({
  type: Schema.Literal("browser_navigate"), url: Address, newTab: Schema.optionalKey(Schema.Boolean)
}).pipe(Schema.decodeTo(
  Schema.Struct({ type: Schema.Literal("browser_navigate"), url: Schema.String, newTab: Schema.optionalKey(Schema.Literal(true)) }),
  SchemaTransformation.transform({
    decode: ({ type, url, newTab }) => newTab === true ? { type, url, newTab: true as const } : { type, url },
    encode: (value) => value
  })
))

const Revision = Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/))
const ReviewInstant = Schema.String.check(Schema.isMaxLength(30), Schema.makeFilter(isoInstant))
const ReviewDay = Schema.String.check(Schema.isPattern(/^\d{4}-\d\d-\d\d$/), Schema.makeFilter(realDate))
const ReviewZone = Schema.String.check(Schema.isMaxLength(100), Schema.makeFilter(knownZone))
const CalendarId = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/))
const NoteSelection = Schema.Struct({ id: operationId, revision: Revision })
const SelectedNotes = Schema.Struct({
  type: Schema.Literal("read_selected_notes"),
  notes: Schema.Array(NoteSelection).check(
    Schema.isMinLength(1), Schema.isMaxLength(16),
    Schema.makeFilter((notes) => new Set(notes.map(({ id }) => id)).size === notes.length)
  )
})
const NoteRead = Schema.Struct({ id: operationId, revision: Revision, title: blank(256), text: blank(32_000) })
const NotesResult = Schema.Struct({
  kind: Schema.Literal("notes"), notes: Schema.Array(NoteRead).check(Schema.isMaxLength(16))
})

function reviewedRange({ start, end, timeZone }: { readonly start: string; readonly end: string; readonly timeZone: string }): boolean {
  const first = Date.parse(start), last = Date.parse(end)
  const wall = (value: number) => zonedWall(value, timeZone) + (value - Math.floor(value / 1_000) * 1_000)
  return last > first && last - first <= 8 * day && wall(last) - wall(first) <= 7 * day
}

const CalendarRange = Schema.Struct({
  type: Schema.Literal("read_calendar_range"),
  calendarIds: Schema.Array(CalendarId).check(
    Schema.isMinLength(1), Schema.isMaxLength(16), Schema.makeFilter((ids) => new Set(ids).size === ids.length)
  ),
  start: ReviewInstant, end: ReviewInstant, timeZone: ReviewZone, maximumEvents: bounded(1, 200)
}).check(Schema.makeFilter(reviewedRange))
const CalendarOccurrence = Schema.Struct({
  id: CalendarId, calendarId: CalendarId, revision: Revision, title: blank(1_000),
  start: ReviewInstant, end: ReviewInstant, allDay: Schema.Boolean
})
const CalendarResult = Schema.Struct({
  kind: Schema.Literal("calendar"), events: Schema.Array(CalendarOccurrence).check(Schema.isMaxLength(200))
})

function firstOfLocalDay(wallDay: number, timeZone: string): number {
  let low = wallDay - 72_000_000, high = wallDay + 72_000_000
  while (high - low > 1_000) {
    const candidate = low + Math.floor((high - low) / 2_000) * 1_000
    if (civilDay(candidate, timeZone) < wallDay) low = candidate
    else high = candidate
  }
  return high
}

function reviewedOccurrence(event: typeof CalendarOccurrence.Type, range: typeof CalendarRange.Type): boolean {
  if (!range.calendarIds.includes(event.calendarId)) return false
  let from = Date.parse(event.start), to = Date.parse(event.end)
  if (to < from) return false
  if (event.allDay) {
    if (from % day !== 0 || to % day !== 0 || to === from) return false
    from = firstOfLocalDay(from, range.timeZone)
    to = firstOfLocalDay(to, range.timeZone)
  }
  const start = Date.parse(range.start), end = Date.parse(range.end)
  return (from === to ? from >= start && from < end : from < end && to > start) &&
    revisionOf([event.id, event.calendarId, event.title, event.start, event.end, event.allDay]) === event.revision
}

const SelectedReminders = Schema.Struct({
  type: Schema.Literal("read_selected_reminders"), window: Schema.Literal("open_and_completed_today"),
  day: ReviewDay, timeZone: ReviewZone, maximumItems: bounded(1, 200)
})
const reminderFields = { id: operationId, revision: Revision, title: blank(1_000), dueAt: ReviewInstant }
const ReminderRead = Schema.Union([
  Schema.Struct({ ...reminderFields, status: Schema.Literal("open") }),
  Schema.Struct({ ...reminderFields, status: Schema.Literal("completed"), completedAt: ReviewInstant })
])
const RemindersResult = Schema.Struct({
  kind: Schema.Literal("reminders"), reminders: Schema.Array(ReminderRead).check(Schema.isMaxLength(200))
})

function selectedRemindersMatch(result: typeof RemindersResult.Type, operation: typeof SelectedReminders.Type): boolean {
  const wall = Date.parse(operation.day)
  const start = firstOfLocalDay(wall, operation.timeZone), end = firstOfLocalDay(wall + day, operation.timeZone)
  return result.reminders.length <= operation.maximumItems &&
    new Set(result.reminders.map(({ id, dueAt, status }) => JSON.stringify([id, dueAt, status]))).size === result.reminders.length &&
    result.reminders.every((row) => {
      const completedAt = row.status === "completed" ? row.completedAt : null
      const within = completedAt === null ? Date.parse(row.dueAt) < end : Date.parse(completedAt) >= start && Date.parse(completedAt) < end
      return within && revisionOf([row.id, row.title, row.dueAt, row.status, completedAt]) === row.revision
    })
}

function workflowRead<Op extends WireOperation, Result>(
  operation: Schema.Decoder<Op>, result: Schema.Decoder<Result>, opType: OperationType, matches: (result: Result, operation: Op) => boolean
): OperationSchema<Op, Result> {
  return {
    operation, result, classify: () => ({ opType, versionTwo: false }),
    evidence: (value, proposed) => utf8Bytes(value) <= 65_536 && matches(value, proposed) ? applied : undefined
  }
}

const PostNotification = Schema.Struct({ type: Schema.Literal("post_notification"), title: filled(200), body: filled(2_000) })
const SpeakText = Schema.Struct({ type: Schema.Literal("speak_text"), text: filled(5_000) })

const workflowOperations = {
  read_selected_notes: workflowRead(SelectedNotes, NotesResult, "ReadSelectedNotes", (result, operation) =>
    result.notes.length === operation.notes.length && result.notes.every((row, index) => {
      const selected = operation.notes[index]
      return selected?.id === row.id && selected.revision === row.revision && revisionOf([row.title, row.text]) === row.revision
    })
  ),
  read_calendar_range: workflowRead(CalendarRange, CalendarResult, "ReadCalendarRange", (result, operation) =>
    result.events.length <= operation.maximumEvents &&
    new Set(result.events.map(({ calendarId, id, start }) => JSON.stringify([calendarId, id, start]))).size === result.events.length &&
    result.events.every((row) => reviewedOccurrence(row, operation))
  ),
  read_selected_reminders: workflowRead(SelectedReminders, RemindersResult, "ReadSelectedReminders", selectedRemindersMatch),
  post_notification: withoutResult(PostNotification, "PostNotification"),
  speak_text: withoutResult(SpeakText, "SpeakText")
} satisfies FamilySchemas

const MediaId = Schema.String.check(
  Schema.isPattern(/^(?:lib:[iv]:[1-9][0-9]{0,18}:[0-9]{1,19}|m:(?!(?:external|internal):)[A-Za-z0-9_-]{1,80}:[iv]:[1-9][0-9]{0,18})$/)
)
const MediaRevision = Schema.String.check(Schema.isPattern(/^rev-[a-z0-9]{1,16}-[1-9][0-9]{0,9}$/))
const MediaKind = Schema.Literals(["image", "video"])
const MediaAction = Schema.Literals(["trash", "share", "favorite", "unfavorite"])
const MediaMeasure = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0))
const MediaCount = bounded(0, Number.MAX_SAFE_INTEGER)
const MediaIds = (maximum: number) => Schema.Array(MediaId).check(
  Schema.isMinLength(1), Schema.isMaxLength(maximum), Schema.makeFilter((ids) => new Set(ids).size === ids.length)
)
const orderedMediaDates = ({ from, to }: { readonly from?: number; readonly to?: number }) =>
  from === undefined || to === undefined || from <= to
const mediaDates = { from: Schema.optionalKey(MediaCount), to: Schema.optionalKey(MediaCount) }
const LibrarySearch = Schema.Struct({
  type: Schema.Literal("photo_library_search"), kind: Schema.optionalKey(Schema.Literals(["image", "video", "all"])),
  ...mediaDates, favorites: Schema.optionalKey(Schema.Boolean), limit: Schema.optionalKey(bounded(1, 50))
}).check(Schema.makeFilter(orderedMediaDates))
const LibraryInspect = Schema.Struct({ type: Schema.Literal("photo_library_inspect"), id: MediaId })
const LibrarySelect = Schema.Struct({ type: Schema.Literal("photo_library_select"), ids: MediaIds(20) })
const LibraryReview = Schema.Struct({
  type: Schema.Literal("photo_library_review"), action: MediaAction,
  items: Schema.Array(Schema.Struct({ id: MediaId, revision: MediaRevision })).check(
    Schema.isMinLength(1), Schema.isMaxLength(20),
    Schema.makeFilter((items) => new Set(items.map(({ id }) => id)).size === items.length)
  )
})
const MediaSummary = Schema.Struct({
  id: MediaId, revision: MediaRevision, kind: MediaKind, takenAt: MediaMeasure, width: MediaMeasure, height: MediaMeasure,
  duration: Schema.optionalKey(MediaCount), favorite: Schema.optionalKey(Schema.Literal(true))
}).check(Schema.makeFilter(({ id, kind, duration }) => {
  const [space, first, second] = id.split(":")
  const marker = space === "lib" ? first : second
  return (marker === "v" ? "video" : "image") === kind && (kind === "video" || duration === undefined)
}))
const LibrarySearchResult = Schema.Struct({
  kind: Schema.Literal("photo_library_search"), scope: Schema.Literals(["full", "partial", "selected"]),
  items: Schema.Array(MediaSummary).check(Schema.isMaxLength(50)), more: Schema.Boolean
})
const LibraryInspectResult = Schema.Struct({ kind: Schema.Literal("photo_library_inspect"), item: MediaSummary })
const LibrarySelectResult = Schema.Struct({
  kind: Schema.Literal("photo_library_select"), selected: bounded(0, 20), missing: bounded(0, 20)
})
const LibraryReviewResult = Schema.Struct({
  kind: Schema.Literal("photo_library_review"), status: Schema.Literal("review_opened"), action: MediaAction, count: bounded(1, 20)
})

const PhotosFilter = Schema.Struct({
  type: Schema.Literal("photos_filter"), ...mediaDates, kind: Schema.optionalKey(MediaKind),
  favorite: Schema.optionalKey(Schema.Boolean), text: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(80), Schema.makeFilter(noControl))),
  album: Schema.optionalKey(Schema.Union([
    Schema.Literals(["favorites", "videos", "camera", "screenshots"]),
    Schema.String.check(Schema.isPattern(/^custom:[A-Za-z0-9_-]{1,80}$/))
  ]))
}).check(Schema.makeFilter(orderedMediaDates))
const PhotosOpen = Schema.Struct({ type: Schema.Literal("photos_open"), id: MediaId })
const AlbumName = Schema.String.check(Schema.makeFilter(noControl)).pipe(Schema.decodeTo(
  Schema.Trimmed.check(Schema.isMinLength(1), Schema.isMaxLength(80)),
  SchemaTransformation.transform({ decode: (value) => value.trim(), encode: (value) => value })
))
const PhotosAlbumCreate = Schema.Struct({ type: Schema.Literal("photos_album_create"), name: AlbumName, ids: MediaIds(200) })
const PhotosShare = Schema.Struct({ type: Schema.Literal("photos_share"), ids: MediaIds(100) })

const PhotosFilterResult = Schema.Struct({ kind: Schema.Literal("photos_filter"), shown: MediaCount, more: Schema.Boolean })
const PhotosOpenResult = Schema.Struct({ kind: Schema.Literal("photos_open"), opened: Schema.Boolean })
const photosReviewResult = <K extends string>(kind: K, maximum: number) => Schema.Struct({
  kind: Schema.Literal(kind), status: Schema.Literal("review_opened"), count: bounded(1, maximum), missing: bounded(0, maximum)
})

function photoOperation<Op extends WireOperation, Result>(
  operation: Schema.Decoder<Op>, result: Schema.Decoder<Result>, opType: OperationType, matches: (result: Result, operation: Op) => boolean
): OperationSchema<Op, Result> {
  return { operation, result, classify: () => ({ opType, versionTwo: false }), evidence: (value, proposed) => matches(value, proposed) ? applied : undefined }
}

const photoOperations = {
  photo_library_search: photoOperation(LibrarySearch, LibrarySearchResult, "PhotoLibrarySearch", (result, operation) =>
    result.items.length <= (operation.limit ?? 50)),
  photo_library_inspect: photoOperation(LibraryInspect, LibraryInspectResult, "PhotoLibraryInspect", (result, operation) => result.item.id === operation.id),
  photo_library_select: photoOperation(LibrarySelect, LibrarySelectResult, "PhotoLibrarySelect", (result, operation) =>
    result.selected + result.missing === operation.ids.length),
  photo_library_review: photoOperation(LibraryReview, LibraryReviewResult, "PhotoLibraryReview", (result, operation) =>
    result.action === operation.action && result.count === operation.items.length),
  photos_filter: photoOperation(PhotosFilter, PhotosFilterResult, "PhotosFilter", () => true),
  photos_open: photoOperation(PhotosOpen, PhotosOpenResult, "PhotosOpen", (result) => result.opened),
  photos_album_create: photoOperation(PhotosAlbumCreate, photosReviewResult("photos_album_create", 200), "PhotosAlbumCreate", (result, operation) =>
    result.count + result.missing === operation.ids.length),
  photos_share: photoOperation(PhotosShare, photosReviewResult("photos_share", 100), "PhotosShare", (result, operation) =>
    result.count + result.missing === operation.ids.length)
} satisfies FamilySchemas

const viewAndFileOperations = {
  camera_capture_photo: capture,
  files_filter: withoutResult(FilesFilter, "FilesFilter"),
  files_open: withoutResult(FilesOpen, "FilesOpen"),
  files_share: withoutResult(FilesShare, "FilesShare"),
  files_move: withoutResult(FilesMove, "FilesMove"),
  files_trash: withoutResult(FilesTrash, "FilesTrash"),
  files_folder_create: withoutResult(FilesFolderCreate, "FilesFolderCreate"),
  create_note: withoutResult(CreateNote, "CreateNote"),
  create_reminder: withoutResult(CreateReminder, "CreateReminder"),
  open_view: withoutResult(OpenView, "OpenView"),
  browser_navigate: withoutResult(BrowserNavigate, "BrowserNavigate")
} satisfies FamilySchemas

export const deviceOperations = { ...viewAndFileOperations, ...workflowOperations, ...photoOperations, ...telephonyOperations } satisfies FamilySchemas
