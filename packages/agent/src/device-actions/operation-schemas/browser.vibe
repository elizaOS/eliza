// spec/agent/deviceActions/operations.md, "The operation vocabulary is closed, and each wire type belongs to one family"; spec/agent/deviceActions/operations.md, "Each operation has one capability need, which a clock-only device meets only for the Clock handoff"; spec/browser/control.md, "Each control needs its group's capability, and a new-tab open needs its own"; spec/browser/control.md, "Closing every tab is its own negotiated form, refused rather than narrowed, and reviewed only on a card that lists those tabs"; spec/agent/deviceActions/operations.md, "A receipt is admitted only when its evidence agrees with what it reports"
import { withoutResult } from "./device.schema.vibe"
import type { FamilySchemas } from "./family.vibe"

// eslint-disable-next-line no-control-regex -- Browser operations reject literal control characters at the wire boundary.
const noControl = (value: string) => !/[\u0000-\u001f\u007f]/.test(value)
const words = (maximum: number) => Schema.String.check(Schema.makeFilter(noControl)).pipe(Schema.decodeTo(
  Schema.Trimmed.check(Schema.isMinLength(1), Schema.isMaxLength(maximum)),
  SchemaTransformation.transform({ decode: (value) => value.trim().replace(/\s+/g, " "), encode: (value) => value })
))

const BrowserSearch = Schema.Struct({ type: Schema.Literal("browser_search"), query: words(512) })
const BrowserTabNew = Schema.Struct({ type: Schema.Literal("browser_tab_new"), private: Schema.optionalKey(Schema.Boolean) }).pipe(Schema.decodeTo(
  Schema.Struct({ type: Schema.Literal("browser_tab_new"), private: Schema.optionalKey(Schema.Literal(true)) }),
  SchemaTransformation.transform({
    decode: ({ type, private: privacy }) => privacy === true ? { type, private: true as const } : { type },
    encode: (value) => value
  })
))
const BrowserTabSwitch = Schema.Struct({ type: Schema.Literal("browser_tab_switch"), target: words(128) })
const BrowserTabClose = Schema.Union([
  Schema.Struct({ type: Schema.Literal("browser_tab_close") }),
  Schema.Struct({ type: Schema.Literal("browser_tab_close"), target: words(128) }),
  Schema.Struct({ type: Schema.Literal("browser_tab_close"), all: Schema.Literal(true) }),
])
const BrowserTabsShow = Schema.Struct({ type: Schema.Literal("browser_tabs_show") })
const BrowserFind = Schema.Struct({ type: Schema.Literal("browser_find"), text: words(256) })
const BrowserHistory = Schema.Struct({ type: Schema.Literal("browser_history"), action: Schema.Literals(["back", "forward", "reload", "stop"]) })

export const browserOperations = {
  browser_search: withoutResult(BrowserSearch, "BrowserSearch"),
  browser_tab_new: withoutResult(BrowserTabNew, "BrowserTabNew"),
  browser_tab_switch: withoutResult(BrowserTabSwitch, "BrowserTabSwitch"),
  browser_tab_close: withoutResult(BrowserTabClose, "BrowserTabClose", (operation) => "all" in operation),
  browser_tabs_show: withoutResult(BrowserTabsShow, "BrowserTabsShow"),
  browser_find: withoutResult(BrowserFind, "BrowserFind"),
  browser_history: withoutResult(BrowserHistory, "BrowserHistory"),
} satisfies FamilySchemas
