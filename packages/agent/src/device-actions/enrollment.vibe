// spec/agent/deviceActions/index.md, "A device enrolls under its own key as the agent's installation"; spec/agent/deviceActions/index.md, "A revoked enrollment never returns and retires every open offer"; spec/agent/deviceActions/index.md, "The device context is served only for a live enrollment"; spec/agent/deviceActions/capabilities.md, "The capability vocabulary is closed and versioned, with one wire name per capability"; spec/agent/deviceActions/capabilities.md, "The enabled-view profile changes only against the revision the device read"
module node {
  import { createHash, timingSafeEqual } from "node:crypto"

  const sha256 = (text: string): Buffer => createHash("sha256").update(text).digest()

  export function hashOf(text: string): string {
    return sha256(text).toString("hex")
  }

  export function sameHash(presented: string, kept: string): boolean {
    return timingSafeEqual(sha256(presented), sha256(kept))
  }
}

import type { AgentRuntime } from "@elizaos/core"
import { deviceContext, enrolledKey, enrolledOwner, isEnrolled, Rejected, type DeviceRequest } from "../../gen/agent__deviceActions.effect.vibe"
import { allCapabilities, capabilityName, distinctNames, isCapabilityName } from "../../gen/agent__deviceActions__capabilities.effect.vibe"
import type { SessionOwner } from "../../gen/core__sessions.effect.vibe"
import type { LocalRoute, RouteInput } from "../access/routes.vibe"
import type { ModuleContext } from "../host/module.vibe"
import { readViewProfileChange, supportedViews, viewProfileWire } from "./capabilities.vibe"
import { changeEnrollment, changeViewProfile, enrollment, viewProfile, DeviceStoreUnavailable, type EnrollmentEvent } from "./store.vibe"
import { hashOf, sameHash } from node

export const deviceIdHeader = "x-eliza-device-id"
export const deviceKeyHeader = "x-eliza-device-key"
export const workflowProtocolLimit = 5

const deviceKeyPattern = /^[a-f0-9]{64}$/
const offeredCapabilities: readonly string[] = allCapabilities.map(capabilityName)

const Registration = Schema.Struct({
  label: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(128))),
  workflowProtocol: Schema.optionalKey(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
  capabilities: Schema.optionalKey(Schema.Array(Schema.String)),
})
const decodeRegistration = Schema.decodeUnknownOption(Registration, { onExcessProperty: "error" })

type Answer = { readonly status: number; readonly body: object }

const failure = (status: number, error: string): Answer => ({ status, body: { error } })

export interface DeviceEnrollment {
  readonly deviceSender: (input: RouteInput) => Effect.Effect<SessionOwner | undefined, DeviceStoreUnavailable>
  readonly routes: LocalRoute[]
}

function sameOwner(a: SessionOwner, b: SessionOwner): boolean {
  return a.agentId === b.agentId && a.actorId === b.actorId && a.connector === b.connector
}

export function deviceEnrollment(context: Pick<ModuleContext, "runtime" | "launch" | "ownerEntityId">): DeviceEnrollment {
  const runtime: AgentRuntime = context.runtime
  const adapter = runtime.adapter
  const agentId = runtime.agentId
  const owner: SessionOwner = { agentId, actorId: context.launch.account?.userId ?? context.ownerEntityId, connector: agentId }
  const lock = Semaphore.makeUnsafe(1)

  function presentedKeyHash(input: RouteInput): string | undefined {
    const key = input.headers.get(deviceKeyHeader)
    return input.headers.get(deviceIdHeader) === agentId && key !== undefined && deviceKeyPattern.test(key) ? hashOf(key) : undefined
  }

  function liveFor(state: DeviceRequest, keyHash: string): boolean {
    return isEnrolled(state.enrollment) && sameOwner(enrolledOwner(state.enrollment), owner) && sameHash(keyHash, enrolledKey(state.enrollment))
  }

  function enrollmentId(state: DeviceRequest): string {
    const by = enrolledOwner(state.enrollment)
    return hashOf(JSON.stringify([by.agentId, by.actorId, by.connector, enrolledKey(state.enrollment)]))
  }

  effect function deviceSender(input: RouteInput): (SessionOwner | undefined)!DeviceStoreUnavailable {
    const keyHash = presentedKeyHash(input)
    if (keyHash === undefined) return undefined
    return liveFor(try enrollment(adapter), keyHash) ? owner : undefined
  }

  effect function changed(event: EnrollmentEvent, by: SessionOwner): (DeviceRequest | undefined)!DeviceStoreUnavailable {
    return lock.withPermits(1)(changeEnrollment(adapter, event, by)) catch effect (error) => match (error) {
      when Rejected: undefined;
      default: throw error;
    }
  }

  effect function register(input: RouteInput): Answer!DeviceStoreUnavailable {
    const keyHash = presentedKeyHash(input)
    if (keyHash === undefined) return failure(401, "device_unauthorized")
    const sent = decodeRegistration(input.body ?? {})
    if (Option.isNone(sent)) return failure(400, "invalid_registration")
    const workflowProtocol = sent.value.workflowProtocol ?? 0
    const capabilities = sent.value.capabilities ?? offeredCapabilities
    if (!capabilities.every(isCapabilityName) || !distinctNames([...capabilities])) return failure(400, "invalid_capabilities")
    if (workflowProtocol > workflowProtocolLimit) return failure(409, "unsupported_workflow_protocol")
    const next = try changed({ type: "registerDevice", keyHash, capabilities: [...capabilities], workflowProtocol }, owner)
    if (next === undefined) return failure(409, "registration_refused")
    return { status: 200, body: { installationId: agentId, enrollmentId: enrollmentId(next), capabilities: offeredCapabilities, viewProfileVersion: 1 } }
  }

  effect function revoke(input: RouteInput): Answer!DeviceStoreUnavailable {
    const by = try deviceSender(input)
    if (by === undefined) return failure(401, "device_unauthorized")
    const next = try changed({ type: "revokeEnrollment" }, by)
    return next === undefined ? failure(409, "revoke_refused") : { status: 200, body: { revoked: true } }
  }

  effect function served(input: RouteInput): Answer!DeviceStoreUnavailable {
    const keyHash = presentedKeyHash(input)
    if (keyHash === undefined) return failure(401, "device_unauthorized")
    const state = try enrollment(adapter)
    if (!liveFor(state, keyHash)) return failure(401, "device_unauthorized")
    const reply = deviceContext(state)
    switch (reply.tag) {
      case "ContextRefused": return failure(401, "device_unauthorized")
      case "ContextServed": {
        const identity = { agentId: reply.agentId, enrollmentId: enrollmentId(state), installationId: reply.installationId, subjectUserId: reply.subjectUserId }
        const scope = try Effect.try({
          try: () => hashOf(JSON.stringify(identity)),
          catch: (cause) => new DeviceStoreUnavailable({ step: "device context", cause })
        })
        return { status: 200, body: { ...identity, scope } }
      }
    }
  }

  effect function profile(input: RouteInput): Answer!DeviceStoreUnavailable {
    if ((try deviceSender(input)) === undefined) return failure(401, "device_unauthorized")
    return { status: 200, body: { version: 1, supportedViews, profile: viewProfileWire(try viewProfile(adapter)) } }
  }

  effect function setProfile(input: RouteInput): Answer!DeviceStoreUnavailable {
    const change = readViewProfileChange(input.body ?? {})
    if (change === undefined) return failure(400, "invalid_view_profile")
    if ((try deviceSender(input)) === undefined) return failure(401, "device_unauthorized")
    const written = try lock.withPermits(1)(changeViewProfile(adapter, change.read, change.views))
    switch (written.kind) {
      case "stale": return failure(409, "view_profile_changed")
      case "set": return { status: 200, body: { version: 1, profile: viewProfileWire(written.profile) } }
    }
  }

  function answered(work: Answer!DeviceStoreUnavailable): Promise<Answer> {
    return runPromise(work).catch((cause: unknown) => {
      runtime.logger.error({ src: "device-actions", cause: cause instanceof Error ? cause.message : String(cause) }, "Device enrollment store unavailable")
      return failure(503, "store_unavailable")
    })
  }

  const offer: Answer = { status: 200, body: { protocol: 1, agentId, identityId: owner.actorId, deviceActions: { protocol: 1, capabilities: offeredCapabilities } } }

  return {
    deviceSender,
    routes: [
      { method: "POST", path: "/api/client-devices/register", handler: (input) => answered(register(input)) },
      { method: "POST", path: "/api/client-devices/revoke", handler: (input) => answered(revoke(input)) },
      { method: "GET", path: "/api/client-devices/context", handler: (input) => answered(served(input)) },
      { method: "GET", path: "/api/client-devices/capabilities", handler: () => offer },
      { method: "POST", path: "/api/client-devices/capabilities", handler: () => offer },
      { method: "GET", path: "/api/client-devices/view-profile", handler: (input) => answered(profile(input)) },
      { method: "POST", path: "/api/client-devices/view-profile", handler: (input) => answered(setProfile(input)) },
    ],
  }
}
