// spec/agent/voice/session.md, "A report is posted at most twice, the second 1,500 ms after a lost or missing answer, and its outcomes stay distinct"
module node {
  import {
    heardRetryMs, type Event, type HeardReceipt, type ReportOutcome, type VoiceSession,
  } from "../../gen/agent__voice__session.effect.vibe"
  import { decodeHeardResult, heardBody } from "./heuristics.vibe"
  import type { ClockPort, HeardBody, HeardPort } from "./ports.vibe"

  export interface HeardReport {
    readonly reply: number
    readonly conversationId: string
    readonly messageId: string
    readonly heardText: string
    readonly nothingHeard: boolean
  }

  export type SettledHeard = ReportOutcome

  export interface HeardReportsOptions {
    readonly heard: HeardPort
    readonly clock: ClockPort
    readonly machine: { read(): VoiceSession; send(event: Event): boolean }
    onOutcome?(report: HeardReport, outcome: SettledHeard): void
  }

  export interface HeardReports {
    report(report: HeardReport): Promise<SettledHeard>
    receipt(reply: number): HeardReceipt | undefined
  }

  export function createHeardReports(options: HeardReportsOptions): HeardReports {
    const { clock, machine } = options
    const pending = new Map<number, Promise<SettledHeard>>()
    const receipt = (reply: number) => machine.read().receipts.find((item) => item.reply === reply)

    function report(asked: HeardReport): Promise<SettledHeard> {
      const { conversationId, messageId, reply } = asked
      const repeated = pending.get(reply)
      if (repeated !== undefined) return repeated
      const reserved = receipt(reply)
      if (reserved?.phase.tag === "ReportSettled") return Promise.resolve(reserved.phase.outcome)
      const payload: HeardBody = asked.nothingHeard ? { nothingHeard: true } : heardBody(asked.heardText)
      if (reserved?.phase.tag !== "ReportDue" || reserved.attempts !== 0 ||
          reserved.nothingHeard !== ("nothingHeard" in payload)) {
        return Promise.reject(new Error("The report does not match a reserved reply"))
      }
      const complete = Promise.withResolvers<SettledHeard>()
      pending.set(reply, complete.promise)
      void complete.promise.then(() => pending.delete(reply), () => pending.delete(reply))

      function wait(since: number): void {
        const waitedMs = clock.now() - since
        if (waitedMs >= heardRetryMs) post(waitedMs)
        else clock.after(heardRetryMs - waitedMs, () => wait(since))
      }

      function post(waitedMs: number): void {
        if (!machine.send({ type: "dispatchHeard", reply, waitedMs })) {
          complete.reject(new Error("The reserved report could not be dispatched"))
          return
        }
        Promise.resolve().then(() => options.heard(conversationId, messageId, payload)).then(
          (answer) => ({ status: answer.status, body: decodeHeardResult(messageId, answer.body) }),
          () => ({ status: 0, body: "BodyOther" as const }),
        ).then((answer) => {
          if (!machine.send({ type: "heardAnswered", reply, ...answer })) {
            complete.reject(new Error("The reserved report could not accept its answer"))
            return
          }
          const phase = receipt(reply)?.phase
          if (phase?.tag === "ReportDue") {
            const since = clock.now()
            clock.after(heardRetryMs, () => wait(since))
          } else if (phase?.tag === "ReportSettled") {
            complete.resolve(phase.outcome)
            options.onOutcome?.(asked, phase.outcome)
          } else {
            complete.reject(new Error("The heard report did not settle or schedule its retry"))
          }
        }).catch(complete.reject)
      }

      void Promise.resolve().then(() => post(0)).catch(complete.reject)
      return complete.promise
    }

    return { report, receipt }
  }
}
export { createHeardReports, type HeardReport, type HeardReports, type HeardReportsOptions, type SettledHeard } from node
