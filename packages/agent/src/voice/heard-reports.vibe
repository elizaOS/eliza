// spec/agent/voice/session.md, "A report is posted at most twice, the second 1,500 ms after a lost or busy answer, and its outcomes stay distinct"
import {
  dispatchHeard, dueToPost, heardRetryMs, initial, settleHeard,
  type HeardOutcome, type HeardReceipt, type HeardWire,
} from "../../gen/agent__voice__session.effect.vibe"
import { decodeHeardReply, heardBody, type HeardBody } from "./heuristics.vibe"
import type { ClockPort, HeardPort } from "./ports.vibe"

export interface HeardReport {
  readonly conversationId: string
  readonly messageId: string
  readonly heardText: string
  readonly nothingHeard: boolean
}

export type SettledHeard = Exclude<HeardOutcome, "HeardPending">

export interface HeardReportsOptions {
  readonly heard: HeardPort
  readonly clock: ClockPort
  posted?(report: HeardReport, receipt: HeardReceipt, waitedMs: number): void
  answered?(report: HeardReport, receipt: HeardReceipt, wire: HeardWire): void
  onOutcome?(report: HeardReport, outcome: SettledHeard): void
}

export interface HeardReports {
  report(report: HeardReport): Promise<SettledHeard>
  receipt(conversationId: string, messageId: string): HeardReceipt | undefined
}

interface Entry {
  readonly report: HeardReport
  readonly body: HeardBody
  receipt: HeardReceipt
  settle(outcome: SettledHeard): void
}

const keyOf = (conversationId: string, messageId: string) => `${conversationId}\n${messageId}`

export function createHeardReports(options: HeardReportsOptions): HeardReports {
  const { clock } = options
  const entries = new Map<string, { entry: Entry; settled: Promise<SettledHeard> }>()

  function post(entry: Entry, waitedMs: number): void {
    const before = entry.receipt
    const [posted = before] = dispatchHeard({ ...initial, reply: before.reply, receipts: [before] }, before.reply, waitedMs).receipts
    entry.receipt = posted
    options.posted?.(entry.report, posted, waitedMs)
    const { conversationId, messageId } = entry.report
    options.heard(conversationId, messageId, entry.body).then(
      (answer) => decodeHeardReply(answer.status, messageId, answer.body),
      () => decodeHeardReply(0, messageId, undefined),
    ).then((wire) => answered(entry, wire))
  }

  function retry(entry: Entry, since: number): void {
    const waitedMs = clock.now() - since
    if (dueToPost(entry.receipt, entry.receipt.reply, waitedMs)) post(entry, waitedMs)
    else clock.after(heardRetryMs - waitedMs, () => retry(entry, since))
  }

  function answered(entry: Entry, wire: HeardWire): void {
    const since = clock.now()
    entry.receipt = settleHeard(entry.receipt, wire)
    options.answered?.(entry.report, entry.receipt, wire)
    const { outcome } = entry.receipt
    if (entry.receipt.phase === "HeardRetry" || outcome === "HeardPending") {
      clock.after(heardRetryMs, () => retry(entry, since))
      return
    }
    options.onOutcome?.(entry.report, outcome)
    entry.settle(outcome)
  }

  return {
    report(report) {
      const key = keyOf(report.conversationId, report.messageId)
      const known = entries.get(key)
      if (known !== undefined) return known.settled
      const body: HeardBody = report.nothingHeard ? { nothingHeard: true } : heardBody(report.heardText)
      let settle: (outcome: SettledHeard) => void = () => undefined
      const settled = new Promise<SettledHeard>((resolve) => { settle = resolve })
      const receipt: HeardReceipt = {
        reply: entries.size + 1, phase: "HeardReady", attempts: 0, outcome: "HeardPending", nothingHeard: "nothingHeard" in body,
      }
      const entry: Entry = { report, body, receipt, settle }
      entries.set(key, { entry, settled })
      post(entry, 0)
      return settled
    },
    receipt(conversationId, messageId) {
      return entries.get(keyOf(conversationId, messageId))?.entry.receipt
    },
  }
}
