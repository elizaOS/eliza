// spec/agent/voice/session.md, "Story: Send my words once I finish speaking"; spec/agent/voice/session.md, "Story: Send only what I meant"; spec/agent/voice/session.md, "A reply plays segment by segment, and a cut or broken one reserves one report"; spec/agent/voice/session.md, "The shown phase is computed from the session state, never kept apart"
import {
  canReopenCapture, enabled, endOfTurnDeadlineMs, heardRetryMs, initial, longGapMs, shortGapMs, shownPhase, step, turnAccepted,
  voiceChannelType,
  type Duplex, type EndOfTurnReply, type Event, type HeardReceipt, type InputMode, type ShownPhase, type VoiceSession as SessionState,
} from "../../gen/agent__voice__session.effect.vibe"
import { decodeHeardResult, endOfTurnText, heardBody, heardTurnFor, type HeardBody, type ReplyWindow } from "./heuristics.vibe"
import { splitSpeechSegments } from "./playback.vibe"
import type { CaptureEvents, RecognizerPort, VoiceFailure, VoiceReply, VoiceSessionPorts, VoiceTurn } from "./ports.vibe"

export type { ShownPhase }

interface Reply {
  readonly messageId: string
  readonly text: string
  readonly segments: readonly string[]
}

interface Report {
  readonly messageId: string
  readonly body: HeardBody
}

const farPastMs = Number.MAX_SAFE_INTEGER

export class VoiceSession implements RecognizerPort {
  readonly #ports: VoiceSessionPorts
  readonly #listeners = new Set<(state: SessionState) => void>()
  readonly #reports = new Map<number, Report>()
  readonly #capture: CaptureEvents
  #state: SessionState = initial
  #text: string[] = []
  #finalText = ""
  #speechEndedAt = 0
  #echoCancelled = false
  #pending: VoiceTurn | undefined
  #turnAbort: AbortController | undefined
  #endOfTurnAbort: AbortController | undefined
  #reply: Reply | undefined
  #replyEndedAt: number | undefined

  constructor(ports: VoiceSessionPorts) {
    this.#ports = ports
    this.#capture = {
      opened: (info) => {
        this.#echoCancelled = info.echoCancelled
        this.dispatch({ type: "captureOpened" })
      },
      closed: () => { this.dispatch({ type: "captureClosed" }) },
      failed: (cause) => {
        this.#fail({ kind: "capture", cause })
        this.dispatch({ type: "captureFailed" })
      },
    }
  }

  get state(): SessionState { return this.#state }
  get phase(): ShownPhase { return shownPhase(this.#state) }

  onChange(listener: (state: SessionState) => void): () => void {
    this.#listeners.add(listener)
    return () => { this.#listeners.delete(listener) }
  }

  start(mode: InputMode, duplex: Duplex): boolean { return this.dispatch({ type: "start", mode, duplex }) }
  stop(): boolean { return this.dispatch({ type: "stop" }) }

  onSpeechStart(): boolean { return this.dispatch({ type: "speechStarted" }) }

  onSpeechEnd(): boolean {
    this.#speechEndedAt = this.#ports.clock.now()
    return this.dispatch({ type: "speechEnded" })
  }

  onPartial(text: string): void { this.#ports.onPartial?.(text) }

  onFinal(text: string, startedAtMs?: number): boolean {
    this.#finalText = text
    const accepted = this.dispatch({ type: "finalTranscript", heard: heardTurnFor(text, this.#reply?.text ?? "", this.#window(startedAtMs)) })
    this.#finalText = ""
    return accepted
  }

  onHold(heldMs: number): boolean { return this.dispatch({ type: "bargeInHeld", heldMs }) }

  dispatch(event: Event): boolean {
    if (!enabled(this.#state, event)) return false
    const before = this.#state
    this.#state = step(before, event)
    this.#react(before, this.#state, event)
    for (const listener of [...this.#listeners]) listener(this.#state)
    return true
  }

  #window(startedAtMs: number | undefined): ReplyWindow {
    const endedAt = this.#replyEndedAt
    const startKnown = startedAtMs !== undefined && endedAt !== undefined
    return {
      agentSpeaking: this.#state.turn === "Playing",
      startKnown,
      startedAfterReplyEndMs: startKnown ? startedAtMs - endedAt : 0,
      replyAgeMs: endedAt === undefined ? farPastMs : this.#ports.clock.now() - endedAt,
      echoCancelled: this.#echoCancelled,
    }
  }

  #later(ms: number, event: () => Event): void {
    this.#ports.clock.after(Math.max(0, ms), () => { this.dispatch(event()) })
  }

  #fail(failure: VoiceFailure): void { this.#ports.onFailure?.(failure) }

  #react(before: SessionState, after: SessionState, event: Event): void {
    this.#captureFollows(before, after)
    this.#utteranceFollows(before, after, event)
    this.#turnFollows(before, after)
    this.#reportFollows(before, after, event)
    if (canReopenCapture(after) && !canReopenCapture(before)) this.#later(0, () => ({ type: "reopenCapture" }))
  }

  #captureFollows(before: SessionState, after: SessionState): void {
    if (before.capture === after.capture) return
    if (after.capture === "CaptureClosing") this.#ports.capture.close()
    if (after.capture === "CaptureOpening") this.#ports.capture.open({ mode: after.mode, duplex: after.duplex }, this.#capture)
  }

  #utteranceFollows(before: SessionState, after: SessionState, event: Event): void {
    if (event.type === "finalTranscript") {
      if (after.drafts > before.drafts) this.#ports.onDraft?.(this.#finalText.trim())
      if (after.hasText && turnAccepted({ ...event.heard, agentSpeaking: before.turn === "Playing" })) this.#text.push(this.#finalText)
    }
    if (before.turn === "NoTurn" && after.turn !== "NoTurn") {
      const voiceUi = this.#ports.voiceUi?.()
      this.#pending = {
        text: endOfTurnText(this.#text.join(" ")).text, channelType: voiceChannelType,
        metadata: voiceUi === undefined ? {} : { voiceUi }, clientMessageId: this.#ports.clientMessageId(),
      }
    }
    if (!after.hasText) this.#text = []
    if (before.utterance === "AskingEndOfTurn" && after.utterance !== "AskingEndOfTurn") this.#endOfTurnAbort?.abort()
    const epoch = after.epoch
    if (after.utterance === "GapWaiting" && before.utterance !== "GapWaiting") {
      this.#later(shortGapMs, () => ({ type: "shortGapElapsed", epoch, units: endOfTurnText(this.#text.join(" ")).units }))
      this.#later(longGapMs - (this.#ports.clock.now() - this.#speechEndedAt), () => ({ type: "longGapElapsed", epoch }))
    }
    if (after.utterance === "AskingEndOfTurn" && before.utterance !== "AskingEndOfTurn") this.#askEndOfTurn(epoch)
  }

  #askEndOfTurn(epoch: number): void {
    const controller = new AbortController()
    this.#endOfTurnAbort = controller
    const answered = (answer: EndOfTurnReply) => { this.dispatch({ type: "endOfTurnAnswered", epoch, answer }) }
    this.#ports.clock.after(endOfTurnDeadlineMs, () => {
      controller.abort()
      answered("ReplyLate")
    })
    this.#ports.endOfTurn(endOfTurnText(this.#text.join(" ")).text, controller.signal).then(answered, () => answered("ScoringFailed"))
  }

  #turnFollows(before: SessionState, after: SessionState): void {
    if (after.turn === "ReadyToSend" && before.turn !== "ReadyToSend") this.#later(0, () => ({ type: "sendTurn" }))
    if (before.turn === "ReadyToSend" && after.turn === "AwaitingReply") this.#sendTurn()
    if (before.turn === "AwaitingReply" && after.turn === "Playing") this.#speak(after.reply)
    if (before.turn === "Playing" && after.turn !== "Playing") {
      this.#replyEndedAt = this.#ports.clock.now()
      if (after.lastEnd === "ReplyCut") this.#ports.speaker.stop()
    }
    if (before.turn === "AwaitingReply" && after.turn === "NoTurn" && after.lastEnd === "TurnAborted") this.#abortTurn(after)
    if (after.turn === "NoTurn") {
      this.#pending = undefined
      this.#turnAbort = undefined
    }
  }

  #sendTurn(): void {
    const turn = this.#pending
    const controller = new AbortController()
    this.#turnAbort = controller
    const failed = (cause: unknown) => {
      if (this.#turnAbort !== controller) return
      this.#fail({ kind: "turn", cause })
      this.dispatch({ type: "replyFailed" })
    }
    if (turn === undefined) return failed(new Error("No voice turn was taken for sending"))
    this.#ports.turns.send(turn, controller.signal).then((reply) => { if (this.#turnAbort === controller) this.#replied(reply) }, failed)
  }

  #replied(reply: VoiceReply): void {
    this.#reply = { messageId: reply.messageId, text: reply.text, segments: splitSpeechSegments(reply.text) }
    if (this.dispatch({ type: "replyStarted", segments: this.#reply.segments.length }) && this.#state.turn === "NoTurn")
      this.#replyEndedAt = this.#ports.clock.now()
  }

  #speak(reply: number): void {
    const current = () => this.#state.turn === "Playing" && this.#state.reply === reply
    this.#ports.speaker.speak(this.#reply?.segments ?? [], {
      segmentPlayed: () => { if (current()) this.dispatch({ type: "segmentPlayed" }) },
      broke: (cause) => {
        if (!current()) return
        this.#fail({ kind: "playback", cause })
        this.dispatch({ type: "playbackBroke" })
      },
    })
  }

  #abortTurn(after: SessionState): void {
    this.#turnAbort?.abort()
    const reason = after.life === "Idle" ? "stop" : after.life === "Failed" ? "capture-failed" : "barge-in"
    this.#ports.turns.abort(this.#ports.conversationId, reason).then(undefined, (cause: unknown) => this.#fail({ kind: "abort", cause }))
  }

  #reportFollows(before: SessionState, after: SessionState, event: Event): void {
    const reserved = after.receipts.length > before.receipts.length ? after.receipts.at(-1) : undefined
    if (reserved !== undefined) {
      const played = (this.#reply?.segments ?? []).slice(0, before.played).join(" ")
      this.#reports.set(reserved.reply, {
        messageId: this.#reply?.messageId ?? "",
        body: reserved.nothingHeard ? { nothingHeard: true } : heardBody(played),
      })
      this.#later(0, () => ({ type: "dispatchHeard", reply: reserved.reply, waitedMs: 0 }))
    }
    if (event.type === "dispatchHeard") this.#postHeard(event.reply)
    if (event.type === "heardAnswered") {
      const receipt = after.receipts.find((r: HeardReceipt) => r.reply === event.reply)
      if (receipt?.phase.tag !== "ReportDue") return void this.#reports.delete(event.reply)
      const answeredAt = this.#ports.clock.now()
      this.#later(heardRetryMs, () => ({ type: "dispatchHeard", reply: event.reply, waitedMs: this.#ports.clock.now() - answeredAt }))
    }
  }

  #postHeard(reply: number): void {
    const report = this.#reports.get(reply)
    if (report === undefined) return
    const { messageId, body } = report
    this.#ports.heard(this.#ports.conversationId, messageId, body).then(
      (answer) => { this.dispatch({ type: "heardAnswered", reply, status: answer.status, body: decodeHeardResult(messageId, answer.body) }) },
      () => { this.dispatch({ type: "heardAnswered", reply, status: 0, body: "BodyOther" }) },
    )
  }
}
