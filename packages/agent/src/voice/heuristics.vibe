// spec/agent/voice/session.md, "Filler, sound annotations and the assistant's own echo are never a turn"; spec/agent/voice/session.md, "Only a complete end-of-turn score submits before the 1,200 ms long gap, which always submits"; spec/agent/voice/session.md, "A report is posted at most twice, the second 1,500 ms after a lost or missing answer, and its outcomes stay distinct"
import {
  echoWindowOpen, endOfTurnSendable, reportOutcomeOf, turnAccepted,
  type EndOfTurnReply, type HeardBody as HeardReplyBody, type HeardTurn, type ReportOutcome,
} from "../../gen/agent__voice__session.effect.vibe"
import type { ReplyWindow } from "./echo-filter.ts"
import type { HeardBody } from "./ports.vibe"

module proved {
  import { heardTurn, type ReplyWindow } from "./echo-filter.ts"
  import type { HeardTurn } from "../../gen/agent__voice__session.ts"

  /** @throws {never} */
  export function heardOf(words: string[], onlyFiller: boolean, reply: string[], window: ReplyWindow): HeardTurn {
    return heardTurn(words, onlyFiller, reply, window)
  }
}
import { heardOf } from proved

export type { ReplyWindow }

const fillers: ReadonlySet<string> = new Set(["um", "uh", "uhh", "uhm", "umm", "hmm", "hm", "mm", "mmm", "er", "erm", "ah", "eh"])
const soundLabels = ["music", "dramatic music", "background music", "noise", "silence", "inaudible", "unintelligible",
  "applause", "laughter", "laughing", "coughing", "sighing", "breathing", "tonk"]
const annotation = /\[\s*(?:music|dramatic\s+music|background\s+music|noise|silence|inaudible|unintelligible|applause|laughter|laughing|coughing|sighing|breathing|tonk)\s*\]|\(\s*(?:music|dramatic\s+music|background\s+music|noise|silence|inaudible|unintelligible|applause|laughter|laughing|coughing|sighing|breathing|tonk)\s*\)|\*\s*(?:music|dramatic\s+music|background\s+music|noise|silence|inaudible|unintelligible|applause|laughter|laughing|coughing|sighing|breathing|tonk)\s*\*/gi
const openAnnotation = /^[[(*]([^\])*]*)$/
const wordPattern = /[\p{L}\p{N}]+(?:['’-][\p{L}\p{N}]+)*/gu

export function wordsOf(text: string): string[] {
  return text.toLowerCase().match(wordPattern) ?? []
}

export function isFillerOnly(words: readonly string[]): boolean {
  return words.length > 0 && words.every((word) => fillers.has(word))
}

export function isNonSpeechVoiceTranscript(transcript: string): boolean {
  const text = transcript.trim()
  return text.length > 0 && text.replace(annotation, "").trim().length === 0
}

export function mayBecomeNonSpeechVoiceTranscript(transcript: string): boolean {
  const rest = transcript.replace(annotation, "").trim()
  if (rest === "") return transcript.trim().length > 0
  const open = openAnnotation.exec(rest)
  if (open === null) return false
  const text = (open[1] ?? "").toLowerCase().replace(/\s+/g, " ").trimStart()
  return soundLabels.some((label) => label.startsWith(text) || label === text.trimEnd())
}

export function heardTurnFor(text: string, replyText: string, window: ReplyWindow): HeardTurn {
  const words = wordsOf(text.replace(annotation, " "))
  return heardOf(words, isFillerOnly(words), wordsOf(replyText), window)
}

export interface ShouldRespondContext {
  readonly recentAgentReply?: string
  readonly replyAgeMs?: number
  readonly agentSpeaking?: boolean
  readonly turnStartedAfterReplyEndMs?: number
  readonly echoCancelled?: boolean
}

export function replyWindowOf(context: ShouldRespondContext): ReplyWindow {
  const started = context.turnStartedAfterReplyEndMs
  const startKnown = typeof started === "number" && Number.isFinite(started)
  return {
    agentSpeaking: context.agentSpeaking === true,
    startKnown,
    startedAfterReplyEndMs: startKnown ? started : 0,
    replyAgeMs: context.replyAgeMs ?? Number.POSITIVE_INFINITY,
    echoCancelled: context.echoCancelled === true,
  }
}

export function shouldRespondToVoiceTurn(transcript: string, context: ShouldRespondContext = {}): boolean {
  return turnAccepted(heardTurnFor(transcript, context.recentAgentReply ?? "", replyWindowOf(context)))
}

export interface VoiceTurnSignal {
  readonly endOfTurnProbability: number
  readonly nextSpeaker: "agent" | "user" | "unknown"
  readonly agentShouldSpeak: boolean
  readonly source: string
}

export interface VoiceTurnSpeakerAttribution {
  readonly entityId: string | null
  readonly confidence: number
  readonly isOwner?: boolean
}

export interface BuildVoiceTurnSignalContext extends ShouldRespondContext {
  readonly speaker?: VoiceTurnSpeakerAttribution
  readonly wakeWordActive?: boolean
  readonly knownSpeakerEntityIds?: readonly string[]
  readonly selfVoiceSimilarity?: number
  readonly selfVoiceThreshold?: number
}

export const SERVER_EOT_SUPPRESS_THRESHOLD = 0.4
export const BYSTANDER_SUPPRESS_CONFIDENCE = 0.7
export const AGENT_SELF_VOICE_THRESHOLD = 0.7
export const AGENT_SELF_VOICE_IMPRINT_THRESHOLD = 0.28

function confidentBystander(speaker: VoiceTurnSpeakerAttribution, known: readonly string[]): boolean {
  const enrolled = speaker.isOwner === true || (speaker.entityId !== null && known.includes(speaker.entityId))
  return !enrolled && speaker.entityId !== null && speaker.confidence >= BYSTANDER_SUPPRESS_CONFIDENCE
}

export function buildVoiceTurnSignal(transcript: string, context: BuildVoiceTurnSignalContext = {}): VoiceTurnSignal {
  const endOfTurnProbability = scoreEndOfTurnHeuristic(transcript)
  const heard = heardTurnFor(transcript, context.recentAgentReply ?? "", replyWindowOf(context))
  const wakeWord = context.wakeWordActive === true
  const speaker = context.speaker
  const bystander = speaker !== undefined && !wakeWord && confidentBystander(speaker, context.knownSpeakerEntityIds ?? [])
  const selfVoice = context.selfVoiceSimilarity !== undefined && echoWindowOpen(heard) &&
    context.selfVoiceSimilarity >= (context.selfVoiceThreshold ?? AGENT_SELF_VOICE_THRESHOLD)
  const addressed = wakeWord ? !isNonSpeechVoiceTranscript(transcript) :turnAccepted(heard) && !bystander
  const agentShouldSpeak = addressed && !selfVoice
  const nextSpeaker = !agentShouldSpeak || endOfTurnProbability < SERVER_EOT_SUPPRESS_THRESHOLD ? "user" : "agent"
  const source = selfVoice ? "client-ambient+self-voice"
    : wakeWord ? "client-ambient+wakeword"
    : speaker !== undefined ? "client-ambient+diarization"
    : "client-ambient"
  return { endOfTurnProbability, nextSpeaker, agentShouldSpeak, source }
}

const trailingConjunctions: ReadonlySet<string> = new Set(["and", "but", "or", "nor", "yet", "so", "because", "although", "though",
  "while", "whereas", "if", "unless", "until", "since", "when", "where", "which", "that", "who", "whom", "whose"])
const trailingIncomplete: ReadonlySet<string> = new Set(["a", "an", "the", "to", "of", "in", "on", "at", "by", "for", "with", "from",
  "into", "about", "through", "between", "against", "during", "before", "after", "without", "under", "over", "above", "below",
  "around", "beside", "beyond", "like", "near", "past", "via"])
const trailingFillers: ReadonlySet<string> = new Set(["um", "uh", "uhh", "umm", "erm", "er", "hmm", "hm", "ah", "maybe"])
const neverSentenceFinal: ReadonlySet<string> = new Set(["a", "an", "the", "and", "but", "or", "nor", "because", "although", "if",
  "unless", "whereas", "um", "uh", "uhh", "umm", "erm", "er", "hmm", "hm"])
const trailingContinuations: ReadonlySet<string> = new Set(["am", "is", "are", "was", "were", "be", "being", "been", "do", "does",
  "did", "have", "has", "had", "can", "could", "will", "would", "shall", "should", "may", "might", "must"])
const numberBeforePoint = /^(?:\d+|zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|(?:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:-(?:one|two|three|four|five|six|seven|eight|nine))?|hundred|thousand|million|billion)$/
const questionTags = ["right?", "yeah?", "ok?", "okay?", "correct?", "hm?", "huh?", "eh?", "right", "yeah", "correct"]

function unfinishedDecimal(words: readonly string[], fullStop: boolean): boolean {
  const beforeLast = words.at(-2) ?? ""
  if (words.at(-1)?.replace(/[',;:-]+$/, "") !== "point" || !numberBeforePoint.test(beforeLast)) return false
  return !(fullStop && (beforeLast === "one" || beforeLast === "1") && !numberBeforePoint.test(words.at(-3) ?? ""))
}

export function scoreEndOfTurnHeuristic(transcript: string): number {
  const text = transcript.trim()
  if (text.length === 0) return 0.5
  if (/(\.{2,}|…)$/.test(text)) return 0.2
  if (/[!?]$/.test(text)) return 0.95
  const lower = text.toLowerCase()
  if (questionTags.some((tag) => lower.endsWith(tag))) return 0.85
  const fullStop = text.endsWith(".")
  const body = fullStop ? text.slice(0, -1).trimEnd() : text
  if (/(\d,|\$)$/.test(body)) return 0.2
  const words = body.replace(/[^a-z0-9'\s-]/gi, "").split(/\s+/).filter((word) => word.length > 0)
    .map((word) => (word === "A" ? word : word.toLowerCase()))
  if (words.length === 0) return fullStop ? 0.95 : 0.5
  if (unfinishedDecimal(words, fullStop)) return 0.2
  const last = (words.at(-1) ?? "").replace(/[',;:-]+$/, "")
  if (fullStop && !neverSentenceFinal.has(last)) return 0.95
  if (trailingConjunctions.has(last)) return 0.15
  if (trailingFillers.has(last) || trailingIncomplete.has(last) || trailingContinuations.has(last)) return 0.2
  return words.length < 3 ? 0.7 : 0.5
}

export const END_OF_TURN_PATH = "/api/asr/local-inference/end-of-turn"

export interface EndOfTurnText {
  readonly text: string
  readonly units: number
  readonly sendable: boolean
}

export function endOfTurnText(text: string): EndOfTurnText {
  const collapsed = text.replace(/\s+/g, " ").trim()
  return { text: collapsed, units: collapsed.length, sendable: endOfTurnSendable(collapsed.length) }
}

const decodeScore = Schema.decodeUnknownOption(Schema.Union([
  Schema.Struct({ available: Schema.Literal(true), complete: Schema.Boolean }),
  Schema.Struct({ available: Schema.Literal(false) }),
]))

export function decodeEndOfTurnReply(status: number, body: unknown): EndOfTurnReply {
  if (status < 200 || status > 299) return "ScoringFailed"
  const score = Option.getOrUndefined(decodeScore(body))
  if (score === undefined) return "ReplyMalformed"
  if (!score.available) return "ScorerUnavailable"
  return score.complete ? "ScoredComplete" : "ScoredIncomplete"
}

export function endOfTurnAnswer(units: number, status: number, body: unknown): EndOfTurnReply | undefined {
  return endOfTurnSendable(units) ? decodeEndOfTurnReply(status, body) : undefined
}

export function heardPath(conversationId: string, messageId: string): string {
  return `/api/conversations/${encodeURIComponent(conversationId)}/messages/${encodeURIComponent(messageId)}/heard`
}

export type { HeardBody }

export function heardBody(heardText: string): HeardBody {
  return heardText.trim().length > 0 ? { heardText } : { nothingHeard: true }
}

const decodeRecorded = Schema.decodeUnknownOption(Schema.Struct({
  ok: Schema.Literal(true), messageId: Schema.String, changed: Schema.Boolean,
}))

export function decodeHeardResult(messageId: string, body: unknown): HeardReplyBody {
  const found = Option.getOrUndefined(decodeRecorded(body))
  if (found === undefined || found.messageId !== messageId) return "BodyOther"
  return found.changed ? "BodyRecorded" : "BodyUnchanged"
}

export function decodeHeardReply(status: number, messageId: string, body: unknown): ReportOutcome {
  return reportOutcomeOf(status, decodeHeardResult(messageId, body))
}
