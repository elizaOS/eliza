// spec/agent/conversation/replyStream.md, "Story: See a reply as it is written"; spec/agent/conversation/replyStream.md, "The frames written rebuild exactly the text the client holds"; spec/agent/conversation/replyStream.md, "The acknowledgment is written at most once, before the text and progress waiting with it, and only its own frame clears it"; spec/agent/conversation/replyStream.md, "Every stream that is not dropped ends with exactly one done or error frame, after which nothing is written"; spec/agent/conversation/planning.md, "A voice turn that ran an action answers with that action's label: its kind, whether the reply is a validated card, and whether the owner asked for exact wording"; spec/agent/conversation/turns.md, "A failed reply names the owner's fix, and only a live rate limit carries its wait"
export schema ActionResultFrame { readonly action: string; readonly data: Schema.Unknown }
export schema SnapshotFrame { readonly type: "token"; readonly text: string; readonly fullText: string; readonly provisional?: boolean }
export schema AppendFrame { readonly type: "token"; readonly text: string; readonly provisional?: boolean }
export schema ReplaceFrame { readonly type: "token"; readonly fullText: string; readonly provisional?: boolean }
export schema AcknowledgmentFrame { readonly type: "acknowledgment"; readonly text: Schema.NonEmptyString }
export schema StatusFrame { readonly type: "status"; readonly activity: string }
export schema ToolFrame { readonly type: "tool"; readonly name: string; readonly label?: Schema.NonEmptyString }
export schema ReadyFrame { readonly type: "reply_ready"; readonly fullText: string; readonly actionResults: readonly ActionResultFrame[] }
const WaitMs = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: Number.MAX_SAFE_INTEGER }))
export schema ProviderWait = WaitMs
export schema PlanAction = "sign-in" | "funding" | "retry"
export schema CloudFundsCode = "insufficient_credits" | "allowance_exhausted"
export schema VoiceActionLabel { readonly kind: Schema.NonEmptyString; readonly validatedCard: boolean; readonly verbatimAsked: boolean }
export schema DoneFrame {
  readonly type: "done"
  readonly fullText: string
  readonly messageId: Schema.NonEmptyString
  readonly userMessageId: Schema.NonEmptyString
  readonly agentName: string
  readonly actionResults: readonly ActionResultFrame[]
  readonly taskChoices?: readonly Schema.Unknown[]
  readonly failureKind?: Schema.NonEmptyString
  readonly cloudCode?: CloudFundsCode
  readonly planAction?: PlanAction
  readonly retryAfterMs?: ProviderWait
  readonly cutOffEffect?: "applied"
  readonly action?: VoiceActionLabel
}
export schema ErrorFrame { readonly type: "error"; readonly code: Schema.NonEmptyString; readonly message: string }
export schema ReplyFrame = SnapshotFrame | AppendFrame | ReplaceFrame | AcknowledgmentFrame | StatusFrame | ToolFrame | ReadyFrame | DoneFrame | ErrorFrame
