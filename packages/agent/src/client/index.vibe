// spec/agent/client/runtimeClient.md, "Story: Call the runtime for my current account", "Story: Reach a runtime that is not running yet", "Story: Understand why the runtime refused", "A stream is sent at most once and only in its generation"
module node {
  import { Effect, Schema } from "effect"
  import type { Delivery, Event, RetryAdvice, Route, StatusReport } from "../../gen/agent__client__runtimeClient.effect.vibe"
  import { createRuntimeCoordinator, pollStartup } from "./coordination.vibe"

  export interface RuntimeStatus {
    readonly available: boolean
    readonly state: "stopped" | "starting" | "running"
    readonly error?: string
    readonly requestBodyLimit?: number
  }

  export interface RuntimeJsonResponse {
    readonly status: number
    readonly data: unknown
  }

  export interface RuntimeJsonBridge {
    status(): Promise<RuntimeStatus>
    start(): Promise<RuntimeStatus>
    restart(): Promise<RuntimeStatus>
    request(input: { path: string; method: "GET" | "POST"; body?: unknown }): Promise<RuntimeJsonResponse>
    requestStream?(input: { path: string; method: "POST"; body?: unknown }, signal: AbortSignal): AsyncIterable<RuntimeStreamFrame>
  }

  export type RuntimeStreamFrame =
    | { readonly kind: "head"; readonly status: number; readonly headers: Readonly<Record<string, string>> }
    | { readonly kind: "chunk"; readonly data: Uint8Array }
    | { readonly kind: "end" | "error" | "aborted" }

  export interface RuntimeStream {
    readonly status: number
    readonly headers: Readonly<Record<string, string>>
    readonly body: AsyncIterable<Uint8Array>
  }

  export interface RuntimeClientOptions {
    readonly bridge?: () => RuntimeJsonBridge | undefined
    readonly httpBase?: URL
    readonly startupTimeoutMs: number
    readonly pollMs: number
    readonly requestTimeoutMs: number
  }

  export class RuntimeRequestError extends Error {
    constructor(message: string, readonly status: number, readonly code?: string, readonly retryAfter?: number) {
      super(message)
      this.name = "RuntimeRequestError"
    }
  }

  const Phase = { stopped: "Stopped", starting: "Starting", running: "Running" } as const
  const decodeStatus = Schema.decodeUnknownSync(Schema.Struct({
    available: Schema.Boolean,
    state: Schema.Literals(["stopped", "starting", "running"]),
    error: Schema.optionalKey(Schema.String),
    requestBodyLimit: Schema.optionalKey(Schema.Unknown),
  }))
  const decodeResponse = Schema.decodeUnknownSync(Schema.Struct({
    status: Schema.Int.check(Schema.isGreaterThanOrEqualTo(100), Schema.isLessThanOrEqualTo(599)),
    data: Schema.Unknown,
  }))
  const decodeHead = Schema.decodeUnknownSync(Schema.Struct({
    status: Schema.Int.check(Schema.isGreaterThanOrEqualTo(100), Schema.isLessThanOrEqualTo(599)),
    headers: Schema.Record(Schema.String, Schema.String),
  }))
  const refusal = Schema.decodeUnknownOption(Schema.Struct({
    error: Schema.optionalKey(Schema.String), code: Schema.optionalKey(Schema.String),
    retryAfter: Schema.optionalKey(Schema.Number),
  }))

  function status(raw: unknown): { report: StatusReport; limit?: number } {
    const found = decodeStatus(raw)
    const limit = found.requestBodyLimit
    return {
      report: found.available ? { tag: "Available", phase: Phase[found.state] } : { tag: "Unavailable" },
      ...(found.available && typeof limit === "number" && Number.isSafeInteger(limit) && limit > 0 ? { limit } : {}),
    }
  }

  function abortable<A>(signal: AbortSignal, run: () => Promise<A>): Promise<A> {
    return new Promise((resolve, reject) => {
      signal.throwIfAborted()
      const cancel = () => reject(signal.reason)
      signal.addEventListener("abort", cancel, { once: true })
      Promise.resolve().then(() => {
        signal.throwIfAborted()
        return run()
      }).then(resolve, reject).finally(() => signal.removeEventListener("abort", cancel))
    })
  }

  function rooted(path: string) {
    if (!path.startsWith("/") || path.startsWith("//") || /[\\\u0000-\u0020]/.test(path)) throw new Error("InvalidPath")
  }

  function retryOf(data: unknown): RetryAdvice {
    const said = refusal(data)
    const retryAfter = said._tag === "Some" ? said.value.retryAfter : undefined
    return typeof retryAfter === "number" && Number.isSafeInteger(retryAfter) ? { tag: "RetryAfter", seconds: retryAfter } : { tag: "NoAdvice" }
  }

  function parsedOrNull(text: string): unknown {
    try {
      return JSON.parse(text)
    } catch {
      return null
    }
  }

  interface Wire {
    readonly status: number
    readonly headers: Readonly<Record<string, string>>
    readonly chunks: AsyncIterator<Uint8Array>
  }

  interface Pending {
    path: string
    body: unknown
    delivery: Delivery
    resolve: (data: unknown) => void
    reject: (reason: unknown) => void
    bridge?: RuntimeJsonBridge
    stop?: AbortController
    opened?: RuntimeStream
  }

  export function createRuntimeJsonClient(options: RuntimeClientOptions) {
    for (const duration of [options.startupTimeoutMs, options.pollMs, options.requestTimeoutMs]) {
      if (!Number.isSafeInteger(duration) || duration <= 0 || duration > 2_147_483_647) throw new RangeError("Invalid runtime client duration")
    }
    const httpOrigin = options.httpBase?.origin
    if (options.httpBase && (!["http:", "https:"].includes(options.httpBase.protocol) || options.httpBase.username || options.httpBase.password)) {
      throw new TypeError("The runtime HTTP base must be an HTTP origin")
    }
    const coordinator = Effect.runSync(createRuntimeCoordinator())
    const pending = new Map<number, Pending>()
    let generation = new AbortController()
    let bodyLimit: number | undefined
    let lifecycle = Promise.resolve()

    function current() { return Effect.runSync(coordinator.current()) }

    function lifecycleCall(signal: AbortSignal, run: () => Promise<RuntimeStatus>) {
      const call = lifecycle.then(() => {
        signal.throwIfAborted()
        return run()
      })
      lifecycle = call.then(() => undefined, () => undefined)
      return abortable(signal, () => call)
    }

    function send(event: Event, answer?: RuntimeJsonResponse) {
      const update = Effect.runSync(coordinator.advance(event))
      if (!update) return
      for (const command of update.commands) {
        switch (command.tag) {
          case "Send": {
            const input = pending.get(command.request)
            if (input) void (input.delivery === "Stream" ? open : dispatch)(command.request, input, command.over, generation.signal)
            break
          }
          case "Open": {
            const input = pending.get(command.id)
            if (input?.opened) input.resolve(input.opened)
            break
          }
          case "Probe": {
            const input = pending.get(command.id)
            if (input) void probe(command.id, input, command.generation, generation.signal)
            break
          }
          case "Finish": {
            const input = pending.get(command.id)
            if (!input) break
            pending.delete(command.id)
            const stage = command.stage
            input.stop?.abort(new Error(stage.tag === "Failed" ? stage.why : "Settled"))
            if (stage.tag === "Failed") {
              input.reject(new Error(stage.why))
            } else if (answer && stage.tag === "Replied") {
              input.resolve(answer.data)
            } else if (answer && stage.tag === "Refused") {
              const data = refusal(answer.data)
              input.reject(new RuntimeRequestError(data._tag === "Some" ? data.value.error ?? "Runtime refused the request" : "Runtime refused the request",
                stage.httpStatus, data._tag === "Some" ? data.value.code : undefined, stage.retry.tag === "RetryAfter" ? stage.retry.seconds : undefined))
            }
          }
        }
      }
      return update
    }

    let startup: { gen: number; done: Promise<void> } | undefined
    function start(bridge: RuntimeJsonBridge, gen: number, shouldStart: boolean, signal: AbortSignal): Promise<void> {
      if (startup?.gen === gen) return startup.done
      const deadline = AbortSignal.any([signal, AbortSignal.timeout(options.startupTimeoutMs)])
      const done = (async () => {
        try {
          const first = shouldStart ? status(await lifecycleCall(deadline, () => bridge.start())) : undefined
          const observation = await Effect.runPromise(pollStartup(first, options.pollMs, () =>
            Effect.tryPromise(async () => status(await bridge.status()))), { signal: deadline })
          if (observation.report.tag !== "Available" || observation.report.phase !== "Running") throw new Error("StartupFailed")
          if (!deadline.aborted) bodyLimit = observation.limit
          send({ type: "startupRan", ofGen: gen })
        } catch {
          send({ type: "startupFailed", ofGen: gen })
        } finally {
          send({ type: "resume" })
        }
      })()
      startup = { gen, done }
      return done
    }

    async function probe(id: number, input: Pending, gen: number, signal: AbortSignal) {
      try {
        const bridge = options.bridge?.()
        const deadline = AbortSignal.any([signal, AbortSignal.timeout(options.requestTimeoutMs)])
        const found = bridge ? status(await abortable(deadline, () => bridge.status())) : { report: { tag: "Unavailable" } as const }
        if (signal.aborted) return
        bodyLimit = "limit" in found ? found.limit : undefined
        if (bridge) input.bridge = bridge
        const update = send({ type: "requestStatus", id, report: found.report, fallback: httpOrigin ? "HttpFallback" : "NoFallback" })
        if (bridge && update?.state.startup === "StartingUp" && found.report.tag === "Available" && found.report.phase !== "Running") {
          await start(bridge, gen, update.commands.some((command) => command.tag === "CallStart"), signal)
        }
      } catch {
        send({ type: "transportFailed", id })
      }
    }

    async function dispatch(id: number, input: Pending, route: "Bridge" | "Http", signal: AbortSignal) {
      try {
        const deadline = AbortSignal.any([signal, AbortSignal.timeout(options.requestTimeoutMs)])
        const method = input.body === undefined ? "GET" : "POST"
        const fields = { path: input.path, method, ...(input.body === undefined ? {} : { body: input.body }) } as const
        const answer = await abortable(deadline, async () => {
          if (route === "Bridge" && input.bridge) return decodeResponse(await input.bridge.request(fields))
          if (route !== "Http" || !httpOrigin) throw new Error("NoRoute")
          const url = new URL(input.path, httpOrigin)
          if (url.origin !== httpOrigin) throw new Error("InvalidPath")
          const response = await fetch(url, {
            method, signal: deadline, credentials: "omit", redirect: "manual",
            ...(input.body === undefined ? {} : { body: JSON.stringify(input.body), headers: { "Content-Type": "application/json" } }),
          })
          const data: unknown = response.status === 204 ? null
            : await response.json().catch((error: unknown) => {
              if (response.ok) throw error
              return null
            })
          return { status: response.status, data }
        })
        send({ type: "reply", id, httpStatus: answer.status, retry: retryOf(answer.data) }, answer)
      } catch {
        send({ type: "transportFailed", id })
      }
    }

    async function connect(input: Pending, route: Route, signal: AbortSignal): Promise<Wire> {
      const body = input.body === undefined ? {} : { body: input.body }
      if (route === "Bridge" && input.bridge) {
        if (!input.bridge.requestStream) throw new Error("NoRoute")
        const frames = input.bridge.requestStream({ path: input.path, method: "POST", ...body }, signal)[Symbol.asyncIterator]()
        const first = await frames.next()
        if (first.done || first.value.kind !== "head") throw new Error("TransportFailed")
        const head = decodeHead(first.value)
        const chunks: AsyncIterator<Uint8Array> = {
          async next() {
            const frame = await frames.next()
            if (frame.done) throw new Error("TransportFailed")
            switch (frame.value.kind) {
              case "chunk": return { done: false, value: frame.value.data }
              case "end": return { done: true, value: undefined }
              case "head":
              case "error":
              case "aborted": throw new Error("TransportFailed")
            }
          },
          async return() {
            await frames.return?.()
            return { done: true, value: undefined }
          },
        }
        return { ...head, chunks }
      }
      if (route !== "Http" || !httpOrigin) throw new Error("NoRoute")
      const url = new URL(input.path, httpOrigin)
      if (url.origin !== httpOrigin) throw new Error("InvalidPath")
      const response = await fetch(url, {
        method: "POST", signal, credentials: "omit", redirect: "manual",
        ...(input.body === undefined ? {} : { body: JSON.stringify(input.body), headers: { "Content-Type": "application/json" } }),
      })
      const head = decodeHead({ status: response.status, headers: Object.fromEntries(response.headers) })
      const reader = response.body?.getReader()
      return {
        ...head,
        chunks: {
          async next() {
            const read = reader ? await reader.read() : { done: true as const, value: undefined }
            return read.done ? { done: true, value: undefined } : { done: false, value: read.value }
          },
          async return() {
            await reader?.cancel()
            return { done: true, value: undefined }
          },
        },
      }
    }

    function body(id: number, wire: Wire, live: AbortSignal, stop: AbortController): AsyncIterable<Uint8Array> {
      let taken = false
      let finished = false
      const close = () => {
        finished = true
        void wire.chunks.return?.().catch(() => undefined)
      }
      return {
        [Symbol.asyncIterator]() {
          if (taken) throw new Error("StreamAlreadyRead")
          taken = true
          return {
            async next(): Promise<IteratorResult<Uint8Array>> {
              if (finished) return { done: true, value: undefined }
              try {
                live.throwIfAborted()
                const step = await abortable(live, () => wire.chunks.next())
                live.throwIfAborted()
                if (!step.done) return step
                finished = true
                send({ type: "streamEnded", id })
                return { done: true, value: undefined }
              } catch (error) {
                close()
                if (live.aborted) throw live.reason
                send({ type: "transportFailed", id })
                throw new Error("TransportFailed", { cause: error })
              }
            },
            async return(): Promise<IteratorResult<Uint8Array>> {
              if (!finished) {
                close()
                stop.abort(new Error("Cancelled"))
                send({ type: "cancel", id })
              }
              return { done: true, value: undefined }
            },
          }
        },
      }
    }

    async function open(id: number, input: Pending, route: Route, signal: AbortSignal) {
      const stop = input.stop ?? new AbortController()
      const live = AbortSignal.any([signal, stop.signal])
      const head = new AbortController()
      const timer = setTimeout(() => head.abort(new Error("TransportFailed")), options.requestTimeoutMs)
      try {
        const wire = await abortable(AbortSignal.any([live, head.signal]), () => connect(input, route, AbortSignal.any([live, head.signal])))
        clearTimeout(timer)
        if (wire.status >= 200 && wire.status < 300) {
          input.opened = { status: wire.status, headers: wire.headers, body: body(id, wire, live, stop) }
          send({ type: "reply", id, httpStatus: wire.status, retry: { tag: "NoAdvice" } })
          if (current().requests.find((entry) => entry.id === id)?.stage.tag !== "Streaming") void wire.chunks.return?.().catch(() => undefined)
          return
        }
        const decoder = new TextDecoder()
        let text = ""
        for (let step = await abortable(live, () => wire.chunks.next()); !step.done; step = await abortable(live, () => wire.chunks.next())) {
          text += decoder.decode(step.value, { stream: true })
        }
        const data = parsedOrNull(text + decoder.decode())
        send({ type: "reply", id, httpStatus: wire.status, retry: retryOf(data) }, { status: wire.status, data })
      } catch {
        send({ type: "transportFailed", id })
      } finally {
        clearTimeout(timer)
      }
    }

    async function refreshNativeAccount(): Promise<void> {
      const refresh = send({ type: "refreshAccount" })
      if (!refresh) return
      const ofGen = refresh.state.gen
      generation.abort(new Error("AccountChanged"))
      generation = new AbortController()
      const signal = generation.signal
      bodyLimit = undefined
      send({ type: "abandon" })
      const deadline = AbortSignal.any([signal, AbortSignal.timeout(options.startupTimeoutMs)])
      try {
        const bridge = options.bridge?.()
        const report: StatusReport = bridge ? status(await abortable(deadline, () => bridge.status())).report : { tag: "Unavailable" }
        const observed = send({ type: "refreshStatus", ofGen, report })
        if (bridge && observed?.commands.some((command) => command.tag === "CallRestart")) {
          const restarted = status(await lifecycleCall(deadline, () => bridge.restart()))
          if (restarted.report.tag === "Unavailable") throw new Error("RefreshFailed")
          const update = send({ type: "restarted", ofGen, phase: restarted.report.phase })
          if (update?.state.refresh === "AwaitRestart") {
            await start(bridge, ofGen, update.commands.some((command) => command.tag === "CallStart"), deadline)
          } else if (update) bodyLimit = restarted.limit
        }
        signal.throwIfAborted()
        if (current().refresh === "RefreshBroken") throw new Error("StartupFailed")
      } catch (error) {
        send({ type: "refreshError", ofGen })
        throw error
      } finally {
        send({ type: "resume" })
      }
    }

    function request(path: string, body?: unknown): Promise<unknown> {
      return new Promise((resolve, reject) => {
        rooted(path)
        const id = current().nextId
        pending.set(id, { path, body, delivery: "Plain", resolve, reject })
        send({ type: "submit", path: "Rooted", delivery: "Plain" })
      })
    }

    function stream(path: string, body: unknown, signal?: AbortSignal): Promise<RuntimeStream> {
      return new Promise((resolve, reject) => {
        rooted(path)
        signal?.throwIfAborted()
        const id = current().nextId
        const stop = new AbortController()
        const cancel = () => {
          stop.abort(signal?.reason)
          send({ type: "cancel", id })
        }
        signal?.addEventListener("abort", cancel, { once: true })
        stop.signal.addEventListener("abort", () => signal?.removeEventListener("abort", cancel), { once: true })
        pending.set(id, { path, body, delivery: "Stream", stop, resolve: (opened) => resolve(opened as RuntimeStream), reject })
        send({ type: "submit", path: "Rooted", delivery: "Stream" })
      })
    }

    return { request, stream, refreshNativeAccount, get requestBodyLimit() { return bodyLimit } }
  }
}

export { createRuntimeJsonClient, RuntimeRequestError, type RuntimeClientOptions, type RuntimeJsonBridge, type RuntimeJsonResponse, type RuntimeStatus, type RuntimeStream, type RuntimeStreamFrame } from node
export { DeviceExecution, type ApproveResult, type DeviceAgent, type DeviceExecutionPorts, type DeviceJournal, type DeviceProposal, type DeviceReview, type ExecutorCall, type JournalEntry, type JournalIdentity, type RecoverResult, type ReviewResult, type ScreenCheck } from "./device-execution.vibe"
export { TaskLifecycle, TaskView, TASK_PAUSE_TIMEOUT_MS, type TaskLifecycleCommand, type TaskLifecycleMessages, type TaskLifecycleRequest, type TaskLifecycleState } from "./task-lifecycle.vibe"
export { createSurfaceClient, SurfaceProtocol, SurfaceTransport, type SurfaceClient, type SurfaceClientOptions, type SurfaceCommandContext, type SurfaceFailure, type SurfaceRequest } from "./surface-client.vibe"
export { TASK_ID_PATTERN } from "@elizaos/core/task-events"
export { readReplyStream, REPLY_STREAM_PROTOCOL, type ReplyOutcome, type ReplyStreamHooks, type StreamedReply } from "./stream-reader.vibe"
