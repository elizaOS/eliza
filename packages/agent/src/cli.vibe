// spec/agent/plugins/bundle.md, "A bundle is built only when its load smoke registered each action once under a non-empty name, each promoted action under a listed top-level umbrella"; spec/agent/host/process.md, "The exit code is the boot failure's code, else 0 after a clean release and 1 after a failed one"; spec/agent/host/process.md, "The first signal stops the runtime at once, and a repeated signal joins that stop"; spec/agent/host/launch.md, "Each boot failure has one exit code, and every code outside the table is a crash"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { Stdio } from "effect/Stdio"
import { AGENT_EXIT_CODES, exitCode, readLaunch, LaunchCredentialMissing } from "./host/launch.vibe"
import { LaunchDocumentRejected } from "./host/launch.schema.vibe"
import { startAgent, AgentBootFailed } from "./host/process.vibe"
import { bundledPluginMap, BundleEntryRefused, type BundledEntry } from "./plugins/profile.vibe"
import { smokeBoot, SmokeNotReleased } from "./bundle/smoke.vibe"

const crashed = 2

module node {
  import { lstat, readFile } from "node:fs/promises"
  import { logger } from "@elizaos/core"
  import { readManifest } from "./bundle/manifest.schema.vibe"
  import type { DeviceStorageSnapshot } from "./storage/index.vibe"

  export async function bundledSnapshot(runtimeUrl: string): Promise<DeviceStorageSnapshot | undefined> {
    const file = new URL("./pglite-migrated.bin", runtimeUrl)
    try {
      const entry = await lstat(file)
      if (!entry.isFile() || entry.size > 64 * 1024 * 1024) throw new Error("Invalid agent bundle snapshot")
    } catch (error) {
      if (typeof error === "object" && error !== null && "code" in error && error.code === "ENOENT") return undefined
      throw error
    }
    const manifest = readManifest(await readFile(new URL("./manifest.json", runtimeUrl), "utf8"))
    const bytes = await readFile(file)
    return { schemaVersion: manifest.schemaVersion, bytes }
  }

  export function publishBundleActions(actions: readonly { name: string }[]): void {
    process.send?.({ kind: "bundleActionRegistry", actions: actions.map(({ name }) => name).sort() })
  }

  export function writeLine(line: string): Promise<void> {
    return new Promise((done, fail) => process.stdout.write(`${line}\n`, (error) => error ? fail(error) : done()))
  }

  export function exitOnUncaught(code: number): void {
    for (const event of ["uncaughtException", "unhandledRejection"] as const) {
      process.on(event, (error: unknown) => {
        logger.error({ src: "agent", event, error: String(error) }, "The agent crashed")
        process.exit(code)
      })
    }
  }
}
import { bundledSnapshot, exitOnUncaught, publishBundleActions, writeLine } from node

export interface AgentCli {
  readonly bundled: readonly BundledEntry[]
  readonly productPlugin?: string | undefined
}

let released: number | undefined

effect function serve(cli: AgentCli) {
  const input = try readLaunch()
  const bundled = try bundledPluginMap(cli.bundled)
  const snapshot = try tryPromise({
    try: () => bundledSnapshot(import.meta.url),
    catch: () => new AgentBootFailed({ phase: "Storage" }),
  })
  const agent = try acquireRelease(
    startAgent({ ...input, bundled, ...(snapshot === undefined ? {} : { snapshot }) }),
    (agent) => map(promise(() => agent.stop()), (code) => { released = code }),
  )
  try sync(() => publishBundleActions(agent.runtime.actions))
  try never
}

effect function smoke(cli: AgentCli, arguments_: readonly string[]) {
  const [, stateFlag, stateDirectory] = arguments_
  if (arguments_.length !== 3 || stateFlag !== "--state" || !stateDirectory) throw new LaunchDocumentRejected()
  const bundled = try bundledPluginMap(cli.bundled)
  const report = try smokeBoot({
    bundled, stateDirectory, productPlugin: cli.productPlugin,
    plugins: [...bundled.keys()].filter((name) => name !== cli.productPlugin),
  })
  try promise(() => writeLine(JSON.stringify(report)))
}

effect function main(cli: AgentCli) {
  const io = try Stdio
  const arguments_ = try io.args
  if (arguments_[0] === "smoke") return try smoke(cli, arguments_)
  return try serve(cli)
}

function exitWith(gone: Exit.Exit<unknown, unknown>): number {
  if (Exit.isSuccess(gone) || Cause.hasInterruptsOnly(gone.cause)) return released ?? AGENT_EXIT_CODES.clean
  const error = Cause.squash(gone.cause)
  if (error instanceof LaunchCredentialMissing) return AGENT_EXIT_CODES.credential
  if (error instanceof AgentBootFailed) return exitCode(error.phase)
  if (error instanceof SmokeNotReleased) return error.code
  if (error instanceof BundleEntryRefused) return AGENT_EXIT_CODES.config
  if (typeof error === "object" && error !== null && "_tag" in error
      && (error._tag === "LaunchDocumentRejected" || error._tag === "LaunchFrameRejected")) return AGENT_EXIT_CODES.config
  return crashed
}

export function runAgentCli(cli: AgentCli): void {
  exitOnUncaught(crashed)
  NodeRuntime.runMain(Effect.provide(Effect.scoped(main(cli)), NodeServices.layer), {
    disableErrorReporting: true,
    teardown: (result, settle) => settle(exitWith(result)),
  })
}
