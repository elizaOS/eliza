// spec/agent/models/binding.md, "No text handler is ever served by a model on the device"; spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call"; spec/agent/models/binding.md, "Each refusal is one account state, and the last failure records its kind and time without text"
import { MODEL_PROVIDER_ATTEMPTS, MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED, type GenerateTextParams, type IAgentRuntime, type ModelRegistrationMetadata, type StreamChunkCallback } from "@elizaos/core"
import { FetchHttpClient, HttpClient, HttpClientRequest, type HttpClientResponse } from "effect/http"
import { outcomeOf, type ModelHandler } from "../../gen/agent__models__binding.effect.vibe"
import type { BoundModels } from "./binding.vibe"
import { readCloudError, type CloudFailure } from "./cloud-error.vibe"

export type ChatHandler = Exclude<ModelHandler, "TextEmbedding">

export type Binding = Pick<BoundModels, "credential" | "startCall" | "answerCall" | "refuseCall" | "read">

export interface Endpoint {
  readonly url: string
  readonly models: Readonly<Partial<Record<ChatHandler, string>>>
}

export interface Sink {
  readonly stream?: boolean
  readonly onStreamChunk?: StreamChunkCallback
}

export error ModelRefusal { message: string; code: string | undefined; status: number | undefined; retryAt: number | undefined }

export error Refused { cloud: CloudFailure }

export error StreamConsumerFailed { cause: unknown }

schema Choice { message: { content: string } }
const Completion = Schema.Struct({ choices: Schema.Array(Choice).check(Schema.isMinLength(1)) })
const decode = Schema.decodeUnknownEffect(Completion)
const Delta = Schema.Struct({ choices: Schema.Array(Schema.Struct({ delta: Schema.Struct({
  content: Schema.optionalKey(Schema.NullOr(Schema.String)),
}) })) })
const decodeDelta = Schema.decodeUnknownOption(Schema.fromJsonString(Delta))
const Quota = Schema.Struct({ error: Schema.Struct({
  code: Schema.optionalKey(Schema.NullOr(Schema.String)),
  type: Schema.optionalKey(Schema.NullOr(Schema.String)),
}) })
const decodeQuota = Schema.decodeUnknownOption(Schema.fromJsonString(Quota))

const providerIssue = (): Refused => new Refused({ cloud: { tag: "CloudProviderIssue" } })
const networkFailure = (): Refused => new Refused({ cloud: { tag: "CloudNetwork" } })

module wireFormat {
  import type { GenerateTextParams } from "@elizaos/core"

  type ChatMessage = NonNullable<GenerateTextParams["messages"]>[number]
  type ChatMessageContentPart = Extract<NonNullable<ChatMessage["content"]>, readonly unknown[]>[number]
  type Attachment = NonNullable<GenerateTextParams["attachments"]>[number]

  type Source = string | URL | Uint8Array
  type Image = { type: "image"; image: Source; mediaType?: string }
  type File = { type: "file"; data: Source; mediaType: string; filename?: string }

  export type WirePart = { type: "text"; text: string } | { type: "image_url"; image_url: { url: string } }
  export type WireMessage = { role: "system" | "developer" | "user" | "assistant"; content: string | WirePart[] }
  export type ResponseFormat = { type: "text" } | { type: "json_object" } | { type: "json_schema"; json_schema: { name: string; schema: Record<string, unknown> } }
  export interface WireRequest {
    readonly messages: WireMessage[]
    readonly temperature?: number
    readonly max_tokens?: number
    readonly response_format?: ResponseFormat
  }
  export type Prepared = { kind: "request"; request: WireRequest } | { kind: "unsupported"; field: string }

  class Unsupported {
    constructor(readonly field: string) {}
  }

  const unsent = ["tools", "toolChoice", "stopSequences", "topP", "topK", "minP", "seed", "minTokens", "repetitionPenalty",
    "frequencyPenalty", "presencePenalty", "prefill", "grammar", "responseSkeleton"] as const

  /** @throws {Unsupported} */
  function imageUrlOf(source: Source, mediaType: string | undefined, field: string): string {
    if (typeof source === "string") return source
    if (source instanceof URL) return source.href
    if (mediaType === undefined || !mediaType.startsWith("image/")) throw new Unsupported(field)
    return `data:${mediaType};base64,${Buffer.from(source).toString("base64")}`
  }

  /** @throws {Unsupported} */
  function fileImage(data: Source, mediaType: string, field: string): WirePart {
    if (!mediaType.startsWith("image/")) throw new Unsupported(`${field} of type ${mediaType}`)
    return { type: "image_url", image_url: { url: imageUrlOf(data, mediaType, field) } }
  }

  /** @throws {Unsupported} */
  function partOf(part: ChatMessageContentPart): WirePart {
    switch (part.type) {
      case "text":
        if (typeof part.text !== "string") throw new Unsupported("text part without text")
        return { type: "text", text: part.text }
      case "image": {
        const image = part as Image
        return { type: "image_url", image_url: { url: imageUrlOf(image.image, image.mediaType, "image part") } }
      }
      case "file": {
        const file = part as File
        return fileImage(file.data, file.mediaType, "file part")
      }
      default:
        throw new Unsupported(`${part.type} part`)
    }
  }

  /** @throws {Unsupported} */
  function messageOf(message: ChatMessage): WireMessage {
    if (message.role === "tool") throw new Unsupported("tool message")
    if (message.toolCalls?.length || message.toolCallId !== undefined) throw new Unsupported("tool call")
    if (message.name !== undefined) throw new Unsupported("message name")
    const content = message.content ?? ""
    if (typeof content === "string") return { role: message.role, content }
    return { role: message.role, content: content.length === 0 ? "" : content.map(partOf) }
  }

  /** @throws {Unsupported} */
  function withAttachments(turns: WireMessage[], attachments: readonly Attachment[]): WireMessage[] {
    if (attachments.length === 0) return turns
    return [...turns, { role: "user", content: attachments.map((attachment) => fileImage(attachment.data, attachment.mediaType, "attachment")) }]
  }

  /** @throws {Unsupported} */
  function formatOf(params: GenerateTextParams): ResponseFormat | undefined {
    if (params.responseSchema !== undefined) {
      if (typeof params.responseSchema !== "object" || params.responseSchema === null) throw new Unsupported("response schema")
      return { type: "json_schema", json_schema: { name: "response", schema: params.responseSchema as Record<string, unknown> } }
    }
    const format = typeof params.responseFormat === "string" ? params.responseFormat : params.responseFormat?.type
    switch (format) {
      case undefined: return undefined
      case "text": return { type: "text" }
      case "json":
      case "json_object": return { type: "json_object" }
      default: throw new Unsupported(`response format ${format}`)
    }
  }

  /** @throws {Unsupported} */
  function requestOf(params: GenerateTextParams): WireRequest {
    const set = unsent.find((field) => {
      const value: unknown = params[field]
      return value !== undefined && !(Array.isArray(value) && value.length === 0)
    })
    if (set !== undefined) throw new Unsupported(set)
    const turns: readonly ChatMessage[] = params.messages ?? (params.prompt ? [{ role: "user", content: params.prompt }] : [])
    const said = withAttachments(turns.map(messageOf), params.attachments ?? [])
    const messages: WireMessage[] = params.system ? [{ role: "system", content: params.system }, ...said] : said
    if (messages.length === 0) throw new Unsupported("empty conversation")
    const format = formatOf(params)
    return {
      messages,
      ...(params.temperature === undefined ? {} : { temperature: params.temperature }),
      ...(params.omitMaxTokens || params.maxTokens === undefined ? {} : { max_tokens: params.maxTokens }),
      ...(format === undefined ? {} : { response_format: format }),
    }
  }

  /** @throws {never} */
  export function prepare(params: GenerateTextParams): Prepared {
    try {
      return { kind: "request", request: requestOf(params) }
    } catch (failure) {
      if (failure instanceof Unsupported) return { kind: "unsupported", field: failure.field }
      throw failure
    }
  }

  /** @throws {never} */
  export function description(prompt: string, imageUrl: string): WireRequest {
    return { messages: [{ role: "user", content: [{ type: "text", text: prompt }, { type: "image_url", image_url: { url: imageUrl } }] }] }
  }

  /** @throws {never} */
  export function titleOf(text: string): string {
    const found = /^\s*(?:\*\*)?Title(?:\*\*)?:[ \t]*([^\r\n]+)/i.exec(text)
    return found?.[1]?.replace(/\*\*/g, "").trim() || "Image Analysis"
  }
}
import { description, prepare, titleOf, type WireRequest } from wireFormat
export { description, titleOf }

module edge {
  import { Cause, Effect, Exit } from "effect"

  /** @throws {never} */
  export async function run<A>(program: Effect.Effect<A, unknown>, signal: AbortSignal | undefined): Promise<A> {
    const exit = await Effect.runPromiseExit(program, { signal })
    if (Exit.isSuccess(exit)) return exit.value
    if (Cause.hasInterruptsOnly(exit.cause)) throw new DOMException("The model call was aborted", "AbortError")
    throw Cause.squash(exit.cause)
  }

  /** @throws {never} */
  export async function relabeled<A>(call: () => Promise<A>, relabel: (failure: unknown) => unknown): Promise<A> {
    try {
      return await call()
    } catch (failure) {
      throw relabel(failure)
    }
  }
}
import { relabeled, run } from edge

function refusalOf(cloud: CloudFailure): ModelRefusal {
  const outcome = outcomeOf(cloud)
  const retryAt = cloud.tag === "CloudRateLimited" ? cloud.retryAt : undefined
  switch (outcome) {
    case "RefusedConnection": return new ModelRefusal({ message: "The model connection failed", code: "ECONNRESET", status: undefined, retryAt })
    case "RetryEnvelope": return new ModelRefusal({ message: "The model service refused the call", code: undefined, status: 503, retryAt })
    case "ExhaustedBudget": return new ModelRefusal({ message: "The model call limit was reached", code: MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED, status: 429, retryAt })
    case "FundingDenied": return new ModelRefusal({ message: "The model account has no funds", code: "MODEL_FUNDING_AUTHORITY_FAILED", status: 402, retryAt })
    case "BadRequest": return new ModelRefusal({ message: "The model service rejected the request", code: undefined, status: 400, retryAt })
    case "ProcessingDenied":
    case "Answer":
    case "ProviderAbort":
    case "CallerAbort":
      return new ModelRefusal({ message: "The model account refused the call", code: undefined, status: cloud.tag === "CloudCredentialInvalid" ? 401 : 403, retryAt })
  }
}

function unsupported(field: string): ModelRefusal {
  return new ModelRefusal({ message: `The model service cannot carry the ${field} of this call`, code: "MODEL_REQUEST_UNSUPPORTED", status: 400, retryAt: undefined })
}

function quotaSpent(raw: string): boolean {
  const body = decodeQuota(raw)
  return body._tag === "Some" && (body.value.error.code === "insufficient_quota" || body.value.error.type === "insufficient_quota")
}

effect function refusalFrom(result: HttpClientResponse.HttpClientResponse) {
  const now = try Clock.currentTimeMillis
  const raw = result.text catch effect () => { throw networkFailure() }
  if (result.status === 429 && quotaSpent(raw)) return new Refused({ cloud: { tag: "CloudInsufficientCredits" } })
  const response = { status: result.status, headers: { get: (name: string) => result.headers[name] ?? null }, text: async () => raw }
  const read = try Effect.promise(() => readCloudError(response, now))
  return new Refused({ cloud: read.failure })
}

effect function collectStream(result: HttpClientResponse.HttpClientResponse, sink: Sink) {
  let text = ""
  let terminal = false
  const lines = result.stream.pipe(Stream.decodeText(), Stream.splitLines)
  const collect = Stream.runForEach(lines, effect (line) => {
    if (!line.startsWith("data:") || terminal) return
    const payload = line.slice(5).trim()
    if (payload === "[DONE]") {
      terminal = true
      return
    }
    const decoded = decodeDelta(payload)
    if (decoded._tag !== "Some") throw providerIssue()
    const delta = decoded.value.choices[0]?.delta.content
    if (!delta) return
    text += delta
    if (sink.onStreamChunk) try tryPromise({ try: async () => sink.onStreamChunk?.(delta, undefined, text), catch: (cause) => new StreamConsumerFailed({ cause }) })
  })
  collect catch effect (failure) => {
    if (failure instanceof Refused || failure instanceof StreamConsumerFailed) throw failure
    throw networkFailure()
  }
  if (!terminal || text.trim() === "") throw providerIssue()
  return text
}

effect function send(url: string, credential: Redacted.Redacted<string>, body: object, sink: Sink) {
  const encoded = try Effect.try({ try: () => JSON.stringify(body), catch: () => providerIssue() })
  const request = HttpClientRequest.bodyText(HttpClientRequest.setHeader(
    HttpClientRequest.post(url), "authorization", "Bearer " + Redacted.value(credential),
  ), encoded, "application/json")
  const result = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "error" })
    catch effect () => { throw networkFailure() }
  if (result.status < 200 || result.status >= 300) throw try refusalFrom(result)
  if (sink.stream && result.headers["content-type"]?.startsWith("text/event-stream")) return try collectStream(result, sink)
  const raw = result.json catch effect () => { throw networkFailure() }
  const decoded = decode(raw) catch effect () => { throw providerIssue() }
  const first = decoded.choices[0]?.message.content
  if (first === undefined || first.trim() === "") throw providerIssue()
  return first
}

effect function serve(binding: Binding, handler: ChatHandler, endpoint: Endpoint, wire: WireRequest, sink: Sink) {
  const began = try Clock.currentTimeMillis
  const started = try binding.startCall(handler, began)
  if (started === "limited") {
    const view = try binding.read()
    throw refusalOf({ tag: "CloudRateLimited", retryAt: view.lastCloudFailure?.retryAt ?? began })
  }
  const body = { model: endpoint.models[handler], ...wire, stream: sink.stream === true }
  const text = send(endpoint.url, binding.credential(), body, sink) catch effect (failure) => {
    if (!(failure instanceof Refused)) throw failure
    const refused = try Clock.currentTimeMillis
    try binding.refuseCall(started, refused, failure.cloud)
    throw refusalOf(failure.cloud)
  }
  const answered = try Clock.currentTimeMillis
  try binding.answerCall(started, answered)
  return text
}

export function generateText(binding: Binding, endpoint: Endpoint, handler: ChatHandler) {
  return (_runtime: IAgentRuntime, params: GenerateTextParams): Promise<string> => {
    const prepared = prepare(params)
    if (prepared.kind === "unsupported") return Promise.reject(unsupported(prepared.field))
    return run(Effect.provide(serve(binding, handler, endpoint, prepared.request, params), FetchHttpClient.layer), params.signal)
  }
}

export function describeImage(binding: Binding, endpoint: Endpoint) {
  return (_runtime: IAgentRuntime, params: { imageUrl: string; prompt?: string; signal?: AbortSignal; stream?: boolean; onStreamChunk?: StreamChunkCallback } | string): Promise<{ title: string; description: string }> => {
    const input = typeof params === "string" ? { imageUrl: params } : params
    const wire = description(input.prompt ?? "Please analyze this image and provide a title and detailed description.", input.imageUrl)
    return run(
      Effect.provide(Effect.map(serve(binding, "ImageDescription", endpoint, wire, typeof params === "string" ? {} : params),
        (text) => ({ title: titleOf(text), description: text })), FetchHttpClient.layer),
      typeof params === "string" ? undefined : params.signal,
    )
  }
}

type Handler = Parameters<IAgentRuntime["registerModel"]>[1]

function retriedBefore(params: unknown, provider: string): boolean {
  if (typeof params !== "object" || params === null) return false
  const attempts = (params as { [MODEL_PROVIDER_ATTEMPTS]?: readonly { provider: string }[] })[MODEL_PROVIDER_ATTEMPTS] ?? []
  return attempts.filter((attempt) => attempt.provider === provider).length > 1
}

function transient(failure: unknown): failure is ModelRefusal {
  return failure instanceof ModelRefusal && (failure.code === "ECONNRESET" || (failure.status !== undefined && failure.status >= 500))
}

export function registerTwice(runtime: IAgentRuntime, provider: string, handlers: Readonly<Record<string, unknown>>, metadata: ModelRegistrationMetadata): void {
  for (const [modelType, handler] of Object.entries(handlers)) {
    const serveCall = handler as Handler
    for (let registration = 0; registration < 2; registration++) {
      runtime.registerModel(modelType, (agent, params) => relabeled(() => serveCall(agent, params), (failure) =>
        transient(failure) && retriedBefore(params, provider)
          ? new ModelRefusal({ message: failure.message, code: MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED, status: failure.status, retryAt: failure.retryAt })
          : failure), provider, undefined, metadata)
    }
  }
}
