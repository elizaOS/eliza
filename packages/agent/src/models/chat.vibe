// spec/agent/models/binding.md, "No text handler is ever served by a model on the device"; spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call for its turn to re-send once"; spec/agent/models/binding.md, "A tool call the provider could not parse, or a streamed answer silent for a minute, ends the call without a retry"; spec/agent/models/binding.md, "Each refusal is one account state, and the last failure records its kind and time without text"; spec/agent/models/binding.md, "A tool call, a structured answer and the token use reach the caller as one result"; spec/agent/models/binding.md, "A call sends an output cap only when its caller names one, and a thinking hint sets the reasoning effort only on a model that documents it"; spec/agent/models/binding.md, "A Qwen call on a Cerebras route sends the conversation cache key its caller names, and no call invents one"; spec/agent/models/binding.md, "A rate limit holds the account for the provider's whole retry time, and for at most 4 s on a Cerebras own-key endpoint"; spec/agent/conversation/turns.md, "A failed reply names the owner's fix, and only a live rate limit carries its wait"; spec/agent/models/binding.md, "A cloud refusal that names spent credits or a spent allowance carries Cloud's own code, and no other refusal carries one"
import { readCloudError, type CloudFailure } from "@elizaos/cloud/client"
import type { GenerateTextParams, GenerateTextResult, IAgentRuntime, ModelRegistrationMetadata, StreamChunkCallback, TokenUsage, ToolCall } from "@elizaos/core"
import { FetchHttpClient, HttpClient, HttpClientRequest, type HttpClientResponse } from "effect/http"
import {
  cacheKeySent, capSent, chatReturn, effortFor, failureOf, fundsCodeName, fundsCodeOf, outcomeOf, reportedRetryAt, shellOutcome, streamIdleSeconds, usageAsked,
  type CapAsk, type ChatAsk, type ChatReturn, type FundsCode, type ModelBinding, type ModelHandler, type ReasoningEffort, type ReasoningFamily, type ShellRefusal, type ThinkingHint,
} from "../../gen/agent__models__binding.effect.vibe"
import { failureKindName, type BoundModels, type FailureKind } from "./binding.vibe"

export type ChatHandler = Exclude<ModelHandler, "TextEmbedding">

export type Binding = Pick<BoundModels, "credential" | "startCall" | "answerCall" | "refuseCall" | "state">

export interface Endpoint {
  readonly url: string
  readonly models: Readonly<Partial<Record<ChatHandler, string>>>
  readonly maxTokensField: "max_tokens" | "max_completion_tokens"
  readonly reasoningHints: boolean
  readonly uniformToolStrictness: boolean | "OnCerebrasModels"
  readonly cloudRoute: boolean
}

interface Sink {
  readonly stream?: boolean
  readonly onStreamChunk?: StreamChunkCallback
}

interface Reply {
  readonly text: string
  readonly toolCalls: ToolCall[]
  readonly finishReason: string | undefined
  readonly usage: TokenUsage | undefined
  readonly reasoning: string
}

export error ModelRefusal { message: string; code: string | undefined; status: number | undefined; failureKind: FailureKind; retryAt: number | undefined; retryAfterMs: number | undefined; cloudCode?: string }

export error Refused { cloud: CloudFailure; funds?: FundsCode }

interface Hold {
  readonly retryAt: number | undefined
  readonly retryAfterMs: number | undefined
}

const unheld: Hold = { retryAt: undefined, retryAfterMs: undefined }

export error ShellRefused { refusal: ShellRefusal }

error StreamConsumerFailed { cause: unknown }

const Usage = Schema.Struct({
  prompt_tokens: Schema.Number,
  completion_tokens: Schema.Number,
  total_tokens: Schema.Number,
  prompt_tokens_details: Schema.optionalKey(Schema.NullOr(Schema.Struct({ cached_tokens: Schema.optionalKey(Schema.NullOr(Schema.Number)) }))),
  completion_tokens_details: Schema.optionalKey(Schema.NullOr(Schema.Struct({ reasoning_tokens: Schema.optionalKey(Schema.NullOr(Schema.Number)) }))),
})
type WireUsage = typeof Usage.Type
const WireToolCall = Schema.Struct({ id: Schema.String, function: Schema.Struct({ name: Schema.String, arguments: Schema.String }) })
const Completion = Schema.Struct({
  choices: Schema.Array(Schema.Struct({
    message: Schema.Struct({
      content: Schema.optionalKey(Schema.NullOr(Schema.String)),
      refusal: Schema.optionalKey(Schema.NullOr(Schema.String)),
      reasoning: Schema.optionalKey(Schema.NullOr(Schema.String)),
      tool_calls: Schema.optionalKey(Schema.NullOr(Schema.Array(WireToolCall))),
    }),
    finish_reason: Schema.optionalKey(Schema.NullOr(Schema.String)),
  })).check(Schema.isMinLength(1)),
  usage: Schema.optionalKey(Schema.NullOr(Usage)),
})
const decode = Schema.decodeUnknownEffect(Completion)
const DeltaToolCall = Schema.Struct({
  index: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
  id: Schema.optionalKey(Schema.NullOr(Schema.String)),
  function: Schema.optionalKey(Schema.NullOr(Schema.Struct({ name: Schema.optionalKey(Schema.NullOr(Schema.String)), arguments: Schema.optionalKey(Schema.NullOr(Schema.String)) }))),
})
const Delta = Schema.Struct({
  choices: Schema.Array(Schema.Struct({
    delta: Schema.optionalKey(Schema.NullOr(Schema.Struct({
      content: Schema.optionalKey(Schema.NullOr(Schema.String)),
      reasoning: Schema.optionalKey(Schema.NullOr(Schema.String)),
      tool_calls: Schema.optionalKey(Schema.NullOr(Schema.Array(DeltaToolCall))),
    }))),
    finish_reason: Schema.optionalKey(Schema.NullOr(Schema.String)),
  })),
  usage: Schema.optionalKey(Schema.NullOr(Usage)),
})
const decodeDelta = Schema.decodeUnknownOption(Schema.fromJsonString(Delta))
const ProviderFields = Schema.Struct({
  message: Schema.optionalKey(Schema.Unknown),
  type: Schema.optionalKey(Schema.Unknown),
  code: Schema.optionalKey(Schema.Unknown),
  param: Schema.optionalKey(Schema.Unknown),
})
const decodeNestedError = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Struct({ error: ProviderFields })))
const decodeFlatError = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Struct({ message: Schema.String, type: Schema.optionalKey(Schema.Unknown), code: Schema.optionalKey(Schema.Unknown) })))
const decodeFlatFields = Schema.decodeUnknownOption(Schema.fromJsonString(ProviderFields))
const decodeRefusalCode = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Struct({ error: Schema.String })))
schema Listing { data: { id: string }[] }
const decodeListing = Schema.decodeUnknownOption(Listing)

const providerIssue = (): Refused => new Refused({ cloud: { tag: "CloudProviderIssue" } })

module wireFormat {
  import type { ChatMessageContentPart, GenerateTextAttachment, GenerateTextParams, ToolCall, ToolChoice, ToolDefinition } from "@elizaos/core"

  type ChatMessage = NonNullable<GenerateTextParams["messages"]>[number]
  type Source = string | URL | Uint8Array
  type Image = { type: "image"; image: Source; mediaType?: string }
  type File = { type: "file"; data: Source; mediaType: string; filename?: string }
  type WireMessage = { role: string; content?: unknown; tool_call_id?: string; tool_calls?: { id: string }[] } & Record<string, unknown>

  /** @throws {never} */
  function urlOf(source: Source, mediaType: string | undefined): string {
    if (typeof source === "string") return source
    if (source instanceof URL) return source.href
    return `data:${mediaType ?? "application/octet-stream"};base64,${Buffer.from(source).toString("base64")}`
  }

  /** @throws {never} */
  function fileOf(data: Source, mediaType: string, filename: string | undefined): object {
    return mediaType.startsWith("image/")
      ? { type: "image_url", image_url: { url: urlOf(data, mediaType) } }
      : { type: "file", file: { file_data: urlOf(data, mediaType), ...(filename === undefined ? {} : { filename }) } }
  }

  /** @throws {never} */
  function isReasoning(part: ChatMessageContentPart): boolean {
    return (part.type === "reasoning" || part.type === "thinking") && typeof (part as { text?: unknown }).text === "string"
  }

  /** @throws {never} */
  function partOf(part: ChatMessageContentPart): object {
    if (part.type === "image") {
      const image = part as Image
      return { type: "image_url", image_url: { url: urlOf(image.image, image.mediaType) } }
    }
    if (part.type === "file") {
      const file = part as File
      return fileOf(file.data, file.mediaType, file.filename)
    }
    return part
  }

  /** @throws {never} */
  function textOf(content: ChatMessage["content"], wanted: (part: ChatMessageContentPart) => boolean): string {
    if (typeof content === "string") return content
    return (content ?? []).filter(wanted).map((part) => (part as { text?: unknown }).text).filter((text) => typeof text === "string").join("")
  }

  /** @throws {never} */
  function argumentsOf(call: ToolCall): string | undefined {
    if (typeof call.arguments === "string") return call.arguments
    try {
      return JSON.stringify(call.arguments)
    } catch {
      return undefined
    }
  }

  /** @throws {never} */
  function wireOf(message: ChatMessage): WireMessage | undefined {
    const plain = (part: ChatMessageContentPart) => part.type === "text"
    switch (message.role) {
      case "system":
      case "developer":
        return { role: "system", content: textOf(message.content, plain) }
      case "tool":
        return { role: "tool", tool_call_id: message.toolCallId ?? "", content: textOf(message.content, plain) }
      case "assistant": {
        const text = textOf(message.content, plain)
        const reasoning = textOf(typeof message.content === "string" ? [] : message.content, isReasoning)
        const calls = (message.toolCalls ?? []).map((call) => ({ id: call.id, type: "function", function: { name: call.name, arguments: argumentsOf(call) } }))
        if (calls.some((call) => call.function.arguments === undefined)) return undefined
        return {
          role: "assistant",
          content: text === "" && calls.length > 0 ? null : text,
          ...(calls.length === 0 ? {} : { tool_calls: calls }),
          ...(reasoning === "" ? {} : { reasoning }),
        }
      }
      case "user":
        return {
          role: "user",
          content: typeof message.content === "string" ? message.content : (message.content ?? []).filter((part) => !isReasoning(part)).map(partOf),
          ...(message.name === undefined ? {} : { name: message.name }),
        }
    }
  }

  /** @throws {never} */
  function paired(turns: readonly WireMessage[]): WireMessage[] {
    type Node = { message: WireMessage; responses: WireMessage[] }
    const nodes: Node[] = []
    const announcer = new Map<string, Node>()
    for (const message of turns) {
      if (message.role === "tool") {
        const owner = announcer.get(message.tool_call_id ?? "")
        if (owner !== undefined) {
          owner.responses.push(message)
          continue
        }
        nodes.push({ message: { role: "user", content: `[tool result]\n${String(message.content ?? "")}` }, responses: [] })
        continue
      }
      const node: Node = { message, responses: [] }
      nodes.push(node)
      for (const call of message.tool_calls ?? []) announcer.set(call.id, node)
    }
    return nodes.flatMap(({ message, responses }) => [message, ...responses])
  }

  /** @throws {never} */
  export function conversation(params: Pick<GenerateTextParams, "system" | "prompt" | "messages" | "attachments">): object[] | undefined {
    const attachments = params.attachments ?? []
    const wired = params.messages?.map(wireOf)
    if (wired?.includes(undefined)) return undefined
    const asked: WireMessage[] = wired !== undefined ? wired.filter((message) => message !== undefined)
      : !params.prompt ? []
      : attachments.length === 0 ? [{ role: "user", content: params.prompt }]
      : [{ role: "user", content: [{ type: "text", text: params.prompt }, ...attachments.map((file: GenerateTextAttachment) => fileOf(file.data, file.mediaType, file.filename))] }]
    const said = paired(asked)
    return params.system ? [{ role: "system", content: params.system }, ...said] : said
  }

  /** @throws {never} */
  export function toolsOf(tools: readonly ToolDefinition[] | undefined, uniformStrictness: boolean): object[] | undefined {
    if (tools === undefined || tools.length === 0) return undefined
    const strictSent = !uniformStrictness || tools.every((tool) => tool.strict === true)
    return tools.map((tool) => ({ type: "function", function: {
      name: tool.name,
      ...(tool.description === undefined ? {} : { description: tool.description }),
      parameters: tool.parameters === undefined ? { type: "object", properties: {} } : advertised(tool.parameters),
      ...(strictSent && tool.strict === true ? { strict: true } : {}),
    } }))
  }

  const dataKeywords: ReadonlySet<string> = new Set(["enum", "const", "default", "examples"])

  function advertised(schema: unknown): unknown {
    if (Array.isArray(schema)) return schema.map(advertised)
    if (typeof schema !== "object" || schema === null) return schema
    return Object.fromEntries(Object.entries(schema).flatMap(([key, value]) =>
      key === "pattern" && typeof value === "string" ? [] : [[key, dataKeywords.has(key) ? value : advertised(value)]]))
  }

  /** @throws {never} */
  export function toolChoiceOf(choice: ToolChoice | undefined): object | string | undefined {
    if (choice === undefined || typeof choice === "string") return choice
    return { type: "function", function: { name: "function" in choice ? choice.function.name : choice.name } }
  }

  /** @throws {never} */
  export function responseFormatOf(params: Pick<GenerateTextParams, "responseSchema" | "responseFormat">): object | undefined {
    if (params.responseSchema !== undefined) return { type: "json_schema", json_schema: { name: "response", schema: params.responseSchema, strict: false } }
    const format = params.responseFormat
    const type = typeof format === "string" ? format : format?.type
    return type === "json_object" || type === "json" ? { type: "json_object" } : undefined
  }

  /** @throws {never} */
  export function parsedArguments(raw: string): ToolCall["arguments"] {
    try {
      const parsed: unknown = JSON.parse(raw)
      return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed) ? parsed as Exclude<ToolCall["arguments"], string> : raw
    } catch {
      return raw
    }
  }

  /** @throws {never} */
  export function description(prompt: string, imageUrl: string): object[] {
    return [{ role: "user", content: [{ type: "text", text: prompt }, { type: "image_url", image_url: { url: imageUrl } }] }]
  }

  /** @throws {never} */
  export function titleOf(text: string): string {
    const found = /^\s*(?:\*\*)?Title(?:\*\*)?:[ \t]*([^\r\n]+)/i.exec(text)
    return found?.[1]?.replace(/\*\*/g, "").trim() || "Image Analysis"
  }
}
import { conversation, description, parsedArguments, responseFormatOf, titleOf, toolChoiceOf, toolsOf } from wireFormat

module edge {
  import { Cause, Effect, Exit } from "effect"

  /** @throws {never} */
  export async function run<A>(program: Effect.Effect<A, unknown>, signal: AbortSignal | undefined): Promise<A> {
    const exit = await Effect.runPromiseExit(program, { signal })
    if (Exit.isSuccess(exit)) return exit.value
    if (Cause.hasInterruptsOnly(exit.cause)) throw new DOMException("The model call was aborted", "AbortError")
    throw Cause.squash(exit.cause)
  }
}
import { run } from edge

module calls {
  import { randomUUID } from "node:crypto"
  import { MODEL_PROVIDER_ATTEMPTS } from "@elizaos/core"

  const keys = new WeakMap<object, string>()

  /** @throws {never} */
  export function callKeyOf(params: object): string {
    const attempts: unknown = (params as { [MODEL_PROVIDER_ATTEMPTS]?: unknown })[MODEL_PROVIDER_ATTEMPTS]
    if (typeof attempts !== "object" || attempts === null) return randomUUID()
    const kept = keys.get(attempts) ?? randomUUID()
    keys.set(attempts, kept)
    return kept
  }
}
import { callKeyOf } from calls

function refusalOf(cloud: CloudFailure, hold: Hold = unheld, funds: FundsCode = "NoFundsCode"): ModelRefusal {
  const failureKind = failureKindName(failureOf(cloud, 0))
  const cloudCode = fundsCodeName(funds)
  const refused = (message: string, status?: number, code?: string) => new ModelRefusal({ message, code, status, failureKind, ...hold, ...(cloudCode === "" ? {} : { cloudCode }) })
  const outcome = outcomeOf(cloud)
  switch (outcome) {
    case "RefusedConnection": return refused("The model connection failed", undefined, "ECONNRESET")
    case "RetryEnvelope": return refused("The model service refused the call", 503)
    case "ExhaustedBudget": return refused("The model call limit was reached", 429, "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED")
    case "FundingDenied": return refused("The model account has no funds", 402, "MODEL_FUNDING_AUTHORITY_FAILED")
    case "BadRequest": return refused("The model service rejected the request", 400)
    case "ProcessingDenied":
    case "Answer":
    case "ProviderAbort":
    case "CallerAbort":
      return refused("The model account refused the call", cloud.tag === "CloudCredentialInvalid" ? 401 : 403)
  }
}

const shellRefusals: Record<ShellRefusal, { message: string; code: string }> = {
  ToolCallUnparsed: { message: "The model provider could not read the model's tool call", code: "PROVIDER_TOOL_CALL_PARSE_FAILED" },
  SilentStream: { message: "The model provider sent nothing for a minute", code: "MODEL_ATTEMPT_IDLE_TIMEOUT" },
}

function shellRefusalOf(refusal: ShellRefusal): ModelRefusal {
  const { message, code } = shellRefusals[refusal]
  const status = shellOutcome(refusal) === "BadRequest" ? 400 : undefined
  return new ModelRefusal({ message, code, status, failureKind: "provider_issue", ...unheld })
}

function providerWords(raw: string): string | undefined {
  const nested = decodeNestedError(raw)
  const fields = nested._tag === "Some" ? nested.value.error : Option.getOrUndefined(decodeFlatError(raw))
  if (fields === undefined) return undefined
  return [fields.message, fields.type, fields.code].filter((word) => typeof word === "string").join(" ").toLowerCase()
}

function toolCallUnparsed(status: number, raw: string): boolean {
  if (status !== 400) return false
  const nested = decodeNestedError(raw)
  const fields = nested._tag === "Some" ? nested.value.error : Option.getOrUndefined(decodeFlatFields(raw))
  return fields !== undefined && (fields.code === "parser_error" || (fields.type === "generation_error" && fields.param === "tool_calls"))
}

function providerRefusal(status: number, words: string): CloudFailure | undefined {
  if (status === 429 && words.includes("insufficient_quota")) return { tag: "CloudInsufficientCredits" }
  if (status === 408 || status === 409) return { tag: "CloudProviderIssue" }
  if (status === 400 && !/invalid|unsupported|must be|required|malformed|not allowed|schema/.test(words)
    && /server error|server_error|try again|overload|capacity|temporarily|busy|\brate\b|rate.?limit/.test(words)) return { tag: "CloudProviderIssue" }
  return undefined
}

effect function refusalFrom(result: HttpClientResponse.HttpClientResponse, cloudRoute: boolean) {
  const now = try Clock.currentTimeMillis
  const raw = timeout(result.text, "20 seconds") catch effect () => { throw new Refused({ cloud: { tag: "CloudNetwork" } }) }
  if (toolCallUnparsed(result.status, raw)) return new ShellRefused({ refusal: "ToolCallUnparsed" })
  const words = providerWords(raw)
  const classified = words === undefined ? undefined : providerRefusal(result.status, words)
  if (classified !== undefined) return new Refused({ cloud: classified })
  const response = { status: result.status, headers: { get: (name: string) => result.headers[name] ?? null }, text: async () => raw }
  const read = try Effect.promise(() => readCloudError(response, now))
  const funds = fundsCodeOf(cloudRoute, result.status, Option.getOrUndefined(decodeRefusalCode(raw))?.error ?? "")
  return new Refused({ cloud: read.failure, ...(funds === "NoFundsCode" ? {} : { funds }) })
}

function usageOf(usage: WireUsage | null | undefined): TokenUsage | undefined {
  if (usage === undefined || usage === null) return undefined
  const cached = usage.prompt_tokens_details?.cached_tokens
  const reasoning = usage.completion_tokens_details?.reasoning_tokens
  return {
    promptTokens: usage.prompt_tokens,
    completionTokens: usage.completion_tokens,
    totalTokens: usage.total_tokens,
    ...(typeof cached === "number" && Number.isSafeInteger(cached) && cached >= 0 ? { cacheReadInputTokens: cached } : {}),
    ...(typeof reasoning === "number" && Number.isSafeInteger(reasoning) && reasoning >= 0 ? { reasoningTokens: reasoning } : {}),
  }
}

effect function answered(reply: Reply, ask: ChatAsk) {
  if (reply.toolCalls.some((call) => call.name.trim() === "" || call.id === "")) throw providerIssue()
  const form = chatReturn(ask, { textBlank: reply.text.trim() === "", toolCalls: reply.toolCalls.length })
  if (form === "AnswerProviderIssue") throw providerIssue()
  return { reply, form }
}

effect function collectStream(result: HttpClientResponse.HttpClientResponse, sink: Sink, ask: ChatAsk) {
  let text = ""
  let reasoning = ""
  let terminal = false
  let finishReason: string | undefined
  let usage: TokenUsage | undefined
  const calls: { id: string; name: string; arguments: string }[] = []
  const silent = () => Stream.fail(new ShellRefused({ refusal: "SilentStream" }))
  const lines = Stream.timeoutOrElse(result.stream, { duration: Duration.seconds(streamIdleSeconds), orElse: silent }).pipe(Stream.decodeText(), Stream.splitLines)
  const ended = (line: string) => line.startsWith("data:") && line.slice(5).trim() === "[DONE]"
  const collect = Stream.runForEach(Stream.takeUntil(lines, ended), effect (line) => {
    if (line.length > 262144) throw providerIssue()
    if (!line.startsWith("data:")) return
    const payload = line.slice(5).trim()
    if (payload === "[DONE]") {
      terminal = true
      return
    }
    const decoded = decodeDelta(payload)
    if (decoded._tag !== "Some") throw providerIssue()
    usage = usageOf(decoded.value.usage) ?? usage
    const choice = decoded.value.choices[0]
    if (choice === undefined) return
    finishReason = choice.finish_reason ?? finishReason
    reasoning += choice.delta?.reasoning ?? ""
    for (const piece of choice.delta?.tool_calls ?? []) {
      if (piece.index > calls.length) throw providerIssue()
      const call = calls[piece.index] ?? { id: "", name: "", arguments: "" }
      calls[piece.index] = call
      call.id ||= piece.id ?? ""
      call.name += piece.function?.name ?? ""
      call.arguments += piece.function?.arguments ?? ""
    }
    const delta = choice.delta?.content
    if (!delta) return
    text += delta
    if (sink.onStreamChunk) try tryPromise({ try: async () => sink.onStreamChunk?.(delta, undefined, text), catch: (cause) => new StreamConsumerFailed({ cause }) })
  })
  collect catch effect (failure) => {
    if (failure instanceof Refused || failure instanceof ShellRefused || failure instanceof StreamConsumerFailed) throw failure
    throw new Refused({ cloud: { tag: "CloudNetwork" } })
  }
  if (!terminal) throw providerIssue()
  const toolCalls = calls.map((call): ToolCall => ({ id: call.id, name: call.name, arguments: parsedArguments(call.arguments) }))
  return try answered({ text, toolCalls, finishReason, usage, reasoning }, ask)
}

effect function send(endpoint: Endpoint, credential: Redacted.Redacted<string>, callKey: string, body: object | undefined, sink: Sink, ask: ChatAsk) {
  if (body === undefined) throw providerIssue()
  const encoded = try Effect.try({ try: () => JSON.stringify(body), catch: () => providerIssue() })
  const request = HttpClientRequest.bodyText(HttpClientRequest.setHeaders(
    HttpClientRequest.post(endpoint.url), { authorization: "Bearer " + Redacted.value(credential), "idempotency-key": callKey },
  ), encoded, "application/json")
  const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "error" })
  const streamed = sink.stream === true
  const result = timeout(response, streamed ? Duration.seconds(streamIdleSeconds) : "90 seconds") catch effect (failure) => {
    if (streamed && Cause.isTimeoutError(failure)) throw new ShellRefused({ refusal: "SilentStream" })
    throw new Refused({ cloud: { tag: "CloudNetwork" } })
  }
  if (result.status < 200 || result.status >= 300) throw try refusalFrom(result, endpoint.cloudRoute)
  if (sink.stream && result.headers["content-type"]?.startsWith("text/event-stream")) return try collectStream(result, sink, ask)
  const raw = timeout(result.json, "20 seconds") catch effect () => { throw new Refused({ cloud: { tag: "CloudNetwork" } }) }
  const decoded = decode(raw) catch effect () => { throw providerIssue() }
  const choice = decoded.choices[0]
  if (choice === undefined) throw providerIssue()
  const message = choice.message
  const toolCalls = (message.tool_calls ?? []).map((call): ToolCall => ({ id: call.id, name: call.function.name, arguments: parsedArguments(call.function.arguments) }))
  return try answered({
    text: message.content ?? message.refusal ?? "",
    toolCalls,
    finishReason: choice.finish_reason ?? undefined,
    usage: usageOf(decoded.usage),
    reasoning: message.reasoning ?? "",
  }, ask)
}

function holdAt(retryAt: number, now: number): Hold {
  return { retryAt: retryAt > 0 ? retryAt : undefined, retryAfterMs: retryAt < 0 ? undefined : Math.max(0, retryAt - now) }
}

function reportedFor(state: ModelBinding, now: number): Hold {
  return holdAt(reportedRetryAt(state), now)
}

effect function serve(binding: Binding, handler: ChatHandler, endpoint: Endpoint, callKey: string, fields: object | undefined, sink: Sink, ask: ChatAsk) {
  const began = try Clock.currentTimeMillis
  const started = try binding.startCall(handler, began)
  if (typeof started !== "number") throw refusalOf({ tag: "CloudRateLimited", retryAt: started.limitedUntil }, holdAt(started.limitedUntil, began))
  const streamed = sink.stream === true
  const body = fields === undefined ? undefined : { model: endpoint.models[handler], stream: streamed, ...(usageAsked(streamed) ? { stream_options: { include_usage: true } } : {}), ...fields }
  const answer = send(endpoint, binding.credential(), callKey, body, sink, ask) catch effect (failure) => {
    const refused = try Clock.currentTimeMillis
    if (failure instanceof ShellRefused) {
      try binding.refuseCall(started, refused, { tag: "CloudProviderIssue" })
      throw shellRefusalOf(failure.refusal)
    }
    if (!(failure instanceof Refused)) throw failure
    try binding.refuseCall(started, refused, failure.cloud)
    throw refusalOf(failure.cloud, failure.cloud.tag === "CloudRateLimited" ? reportedFor(try binding.state(), refused) : unheld, failure.funds)
  }
  const at = try Clock.currentTimeMillis
  try binding.answerCall(started, at)
  return answer
}

const cerebrasModelPrefix = /^(?:cerebras[:/]|openai\/)/

function familyOf(model: string | undefined): ReasoningFamily {
  const id = (model ?? "").trim().toLowerCase().replace(cerebrasModelPrefix, "").replace(/:(?!free$).+$/, "")
  if (id === "qwen-3.8-27b") return "QwenReasoning"
  if (id === "gpt-oss-120b") return "GptOssReasoning"
  if (id === "zai-glm-4.7" || id === "gemma-4-31b") return "OffOnlyReasoning"
  return "OtherReasoning"
}

function hintOf(params: GenerateTextParams): ThinkingHint {
  if (params.reasoning === "low") return "ThinkingLow"
  if (params.reasoning === "off") return "ThinkingOff"
  const eliza = params.providerOptions?.eliza
  const thinking = typeof eliza === "object" && eliza !== null ? (eliza as { thinking?: unknown }).thinking : undefined
  return thinking === "low" ? "ThinkingLow" : thinking === "off" ? "ThinkingOff" : "NoThinkingHint"
}

function cacheKeyOf(params: GenerateTextParams): string | undefined {
  const cerebras = params.providerOptions?.cerebras
  const key = typeof cerebras === "object" && cerebras !== null ? (cerebras as { promptCacheKey?: unknown }).promptCacheKey : undefined
  return typeof key === "string" && key.trim() !== "" ? key : undefined
}

const efforts: Record<ReasoningEffort, string | undefined> = { ProviderDefault: undefined, EffortLow: "low", EffortNone: "none" }

function capOf(params: GenerateTextParams): CapAsk {
  const asked: CapAsk = params.maxTokens === undefined ? { tag: "NoCapAsked" } : { tag: "CapAsked", tokens: params.maxTokens }
  return capSent(asked, params.omitMaxTokens === true)
}

function requestOf(endpoint: Endpoint, handler: ChatHandler, params: GenerateTextParams): object | undefined {
  const messages = conversation(params)
  if (messages === undefined) return undefined
  const cap = capOf(params)
  const family = familyOf(endpoint.models[handler])
  const effort = endpoint.reasoningHints ? efforts[effortFor(family, hintOf(params))] : undefined
  const named = cacheKeyOf(params)
  const cacheKey = cacheKeySent(family, endpoint.reasoningHints, named !== undefined) ? named : undefined
  const tools = toolsOf(params.tools, endpoint.uniformToolStrictness === "OnCerebrasModels" ? family !== "OtherReasoning" : endpoint.uniformToolStrictness)
  const toolChoice = toolChoiceOf(params.toolChoice)
  const format = responseFormatOf(params)
  return {
    messages,
    ...(cap.tag === "CapAsked" ? { [endpoint.maxTokensField]: cap.tokens } : {}),
    ...(effort === undefined ? {} : { reasoning_effort: effort }),
    ...(cacheKey === undefined ? {} : { prompt_cache_key: cacheKey }),
    ...(params.temperature === undefined ? {} : { temperature: params.temperature }),
    ...(params.topP === undefined ? {} : { top_p: params.topP }),
    ...(params.stopSequences === undefined || params.stopSequences.length === 0 ? {} : { stop: params.stopSequences }),
    ...(params.frequencyPenalty === undefined ? {} : { frequency_penalty: params.frequencyPenalty }),
    ...(params.presencePenalty === undefined ? {} : { presence_penalty: params.presencePenalty }),
    ...(params.seed === undefined ? {} : { seed: params.seed }),
    ...(tools === undefined ? {} : { tools }),
    ...(toolChoice === undefined || tools === undefined ? {} : { tool_choice: toolChoice }),
    ...(format === undefined ? {} : { response_format: format }),
  }
}

function resultOf(reply: Reply): GenerateTextResult {
  return {
    text: reply.text,
    toolCalls: reply.toolCalls,
    ...(reply.finishReason === undefined ? {} : { finishReason: reply.finishReason }),
    ...(reply.usage === undefined ? {} : { usage: reply.usage }),
    ...(reply.reasoning === "" ? {} : { content: [{ type: "text", text: reply.text }, { type: "reasoning", text: reply.reasoning }] }),
  }
}

function askOf(params: GenerateTextParams): ChatAsk {
  return { offersTools: (params.tools?.length ?? 0) > 0, choosesTool: typeof params.toolChoice === "object", asksSchema: params.responseSchema !== undefined }
}

const textAsk: ChatAsk = { offersTools: false, choosesTool: false, asksSchema: false }

function returned(answer: { reply: Reply; form: Exclude<ChatReturn, "AnswerProviderIssue"> }): string | GenerateTextResult {
  return answer.form === "AnswerResult" ? resultOf(answer.reply) : answer.reply.text
}

export function generateText(binding: Binding, endpoint: Endpoint, handler: ChatHandler) {
  return (_runtime: IAgentRuntime, params: GenerateTextParams): Promise<string | GenerateTextResult> => run(
    Effect.provide(Effect.map(serve(binding, handler, endpoint, callKeyOf(params), requestOf(endpoint, handler, params), params, askOf(params)), returned), FetchHttpClient.layer),
    params.signal,
  )
}

export function describeImage(binding: Binding, endpoint: Endpoint) {
  return (_runtime: IAgentRuntime, params: { imageUrl: string; prompt?: string; signal?: AbortSignal; stream?: boolean; onStreamChunk?: StreamChunkCallback } | string): Promise<{ title: string; description: string }> => {
    const input = typeof params === "string" ? { imageUrl: params } : params
    const messages = description(input.prompt ?? "Please analyze this image and provide a title and detailed description.", input.imageUrl)
    return run(
      Effect.provide(Effect.map(serve(binding, "ImageDescription", endpoint, callKeyOf(input), { messages }, typeof params === "string" ? {} : params, textAsk),
        ({ reply }) => ({ title: titleOf(reply.text), description: reply.text })), FetchHttpClient.layer),
      typeof params === "string" ? undefined : params.signal,
    )
  }
}

export effect function listModels(baseUrl: string, credential: Redacted.Redacted<string>) {
  const request = HttpClientRequest.setHeader(HttpClientRequest.get(baseUrl + "/models"), "authorization", "Bearer " + Redacted.value(credential))
  const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "error" })
  const result = timeout(response, "20 seconds") catch effect () => { throw new Refused({ cloud: { tag: "CloudNetwork" } }) }
  if (result.status < 200 || result.status >= 300) throw try refusalFrom(result, false)
  const raw = timeout(result.json, "20 seconds") catch effect () => { throw new Refused({ cloud: { tag: "CloudNetwork" } }) }
  const listing = decodeListing(raw)
  if (listing._tag !== "Some") throw providerIssue()
  return listing.value.data.map(({ id }) => id)
}

type Handler = Parameters<IAgentRuntime["registerModel"]>[1]

export function registerTwice(runtime: IAgentRuntime, provider: string, handlers: Readonly<Record<string, unknown>>, metadata: ModelRegistrationMetadata): void {
  for (const [modelType, handler] of Object.entries(handlers)) {
    const serve = handler as Handler
    for (let registration = 0; registration < 2; registration++) {
      runtime.registerModel(modelType, (agent, params) => serve(agent, params), provider, undefined, metadata)
    }
  }
}
