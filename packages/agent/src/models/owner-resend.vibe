// spec/agent/models/binding.md, "One temporarily rate-limited owner model call can resend before its deadline"
module node {
  import { AsyncLocalStorage } from "node:async_hooks"

  export interface OwnerResendScope {
    readonly deadline: number
    readonly retrySpent?: boolean
    current(): boolean
  }

  const active = new AsyncLocalStorage<OwnerResendScope | undefined>()

  /** @throws {unknown} */
  export function withOwnerResend<A>(scope: OwnerResendScope | undefined, run: () => A): A {
    return active.run(scope, run)
  }

  /** @throws {never} */
  export function ownerResendScope(): OwnerResendScope | undefined {
    return active.getStore()
  }
}

import { ownerResendScope, withOwnerResend } from node
export { ownerResendScope, withOwnerResend, type OwnerResendScope } from node
