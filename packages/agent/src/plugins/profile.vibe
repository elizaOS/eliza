// spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"; spec/agent/plugins/profile.md, "The product plugin must be in the bundle"
import { ModuleRefused, type AgentPlugin, type ModuleFactory } from "../host/module.vibe"
import { isAgentPlugin } from "./product.vibe"
import { approvalsModule, approvalsModuleName } from "../approvals/module.vibe"
import { notificationsModule, notificationsModuleName } from "../notifications/module.vibe"
import { basicActionsModule, basicActionsModuleName } from "./basic-actions.vibe"
import { replyDraftModule, replyDraftModuleName } from "../device-actions/reply-draft.vibe"
import { deviceActionsModule, deviceActionsModuleName } from "../device-actions/proposal/module.vibe"
import { scheduledTasksModuleFactory, scheduledTasksModuleName } from "../schedule/scheduled-task-routes.vibe"
import { triggersModule, triggersModuleName } from "../schedule/trigger-routes.vibe"
import { openPromptTriggers } from "../schedule/triggers.vibe"
import { tasksModule, tasksModuleName } from "../tasks/module.vibe"
import { surfaceModule, surfaceModuleName } from "../tasks/surface-channel.vibe"
import { viewsModule, viewsModuleName } from "../views/module.vibe"

export const builtinModuleFactories: ReadonlyMap<string, ModuleFactory<never>> = new Map<string, ModuleFactory<never>>([
  [basicActionsModuleName, basicActionsModule],
  [approvalsModuleName, approvalsModule],
  [notificationsModuleName, notificationsModule],
  [replyDraftModuleName, replyDraftModule],
  [deviceActionsModuleName, deviceActionsModule],
  [scheduledTasksModuleName, scheduledTasksModuleFactory],
  [tasksModuleName, tasksModule()],
  [surfaceModuleName, surfaceModule],
  [triggersModuleName, triggersModule(effect ({ runtime, conversationOwner }) => {
    if (conversationOwner === undefined) throw new ModuleRefused({ module: triggersModuleName, reason: "The launch has no conversation identity" })
    return openPromptTriggers(runtime, conversationOwner)
  })],
  [viewsModuleName, viewsModule],
])

export interface BundledEntry {
  readonly packageName: string
  readonly plugin: unknown
}

export error BundleEntryRefused { packageName: string; reason: string }

function hostedEntry(packageName: string): AgentPlugin {
  return { name: packageName, description: "A bundled module whose plugin the host builds with the device services it supplies" }
}

export effect function bundledPluginMap(entries: readonly BundledEntry[], hosted: ReadonlySet<string> = new Set()) {
  const plugins = new Map<string, AgentPlugin>()
  for (const { packageName, plugin: exported } of entries) {
    const plugin = !isAgentPlugin(exported) && hosted.has(packageName) ? hostedEntry(packageName) : exported
    if (!isAgentPlugin(plugin)) throw new BundleEntryRefused({ packageName, reason: "The package does not export an agent plugin" })
    if (plugin.name !== packageName) throw new BundleEntryRefused({ packageName, reason: `The plugin is named ${plugin.name}` })
    if (plugins.has(packageName)) throw new BundleEntryRefused({ packageName, reason: "The package is bundled twice" })
    plugins.set(packageName, plugin)
  }
  return plugins as ReadonlyMap<string, AgentPlugin>
}
