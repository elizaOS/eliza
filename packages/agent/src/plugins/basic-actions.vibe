// spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"
import type { Action, ActionResult, RoleGateRole } from "@elizaos/core"
import { calculateAction as calculateDecl } from "../../gen/agent__plugins__profile.effect.vibe"
import type { Role } from "../../gen/core__authorization.effect.vibe"
import { turnFirstCalls } from "../conversation/planning.vibe"
import type { AgentModule, ModuleFactory } from "../host/module.vibe"

export const basicActionsModuleName = "@elizaos/agent/basic-actions"

export const calculationLimits = { expressionCharacters: 10_000, integerDigits: 10_000, nestingDepth: 256, exponent: 10_000 } as const

export type Refusal =
  | { readonly kind: "TooLong"; readonly limit: number }
  | { readonly kind: "TooDeep"; readonly limit: number }
  | { readonly kind: "TooManyDigits"; readonly limit: number }
  | { readonly kind: "ExponentTooLarge"; readonly limit: number }
  | { readonly kind: "ExpectedNumber"; readonly position: number }
  | { readonly kind: "UnexpectedCharacter"; readonly position: number; readonly found: string }
  | { readonly kind: "MissingParenthesis"; readonly position: number }
  | { readonly kind: "DivisionByZero" }
  | { readonly kind: "NotFinite" }

export error ExpressionRefused { expression: string; refusal: Refusal }

export interface Calculation {
  readonly expression: string
  readonly value: string
  readonly exact: boolean
}

type Num = { readonly kind: "Int"; readonly value: bigint } | { readonly kind: "Float"; readonly value: number }

interface Cursor {
  readonly src: string
  pos: number
  depth: number
}

const numberLiteral = /^(?:\d(?:\d|[,_](?=\d))*(?:\.\d+)?|\.\d+)/

const refused = (cursor: Cursor, refusal: Refusal) => new ExpressionRefused({ expression: cursor.src, refusal })
const float = (value: number): Num => ({ kind: "Float", value })
const toFloat = (n: Num): number => n.kind === "Int" ? Number(n.value) : n.value
const digits = (value: bigint): number => (value < 0n ? -value : value).toString().length

function skip(cursor: Cursor): string | undefined {
  while (cursor.pos < cursor.src.length && /\s/.test(cursor.src[cursor.pos] ?? "")) cursor.pos++
  return cursor.src[cursor.pos]
}

function refusalText(refusal: Refusal): string {
  switch (refusal.kind) {
    case "TooLong": return `the expression is longer than ${refusal.limit} characters`
    case "TooDeep": return `the expression nests deeper than ${refusal.limit} levels`
    case "TooManyDigits": return `the integer result has more than ${refusal.limit} digits`
    case "ExponentTooLarge": return `the exponent is larger than ${refusal.limit}`
    case "ExpectedNumber": return `a number was expected at position ${refusal.position}`
    case "UnexpectedCharacter": return `"${refusal.found}" at position ${refusal.position} is not supported`
    case "MissingParenthesis": return `a closing parenthesis is missing at position ${refusal.position}`
    case "DivisionByZero": return "division by zero"
    case "NotFinite": return "the result is not a finite number"
  }
}

effect function integer(cursor: Cursor, value: bigint): Num!ExpressionRefused {
  if (digits(value) > calculationLimits.integerDigits) throw refused(cursor, { kind: "TooManyDigits", limit: calculationLimits.integerDigits })
  return { kind: "Int", value }
}

effect function nested(cursor: Cursor, parse: (cursor: Cursor) => Num!ExpressionRefused): Num!ExpressionRefused {
  cursor.depth++
  if (cursor.depth > calculationLimits.nestingDepth) throw refused(cursor, { kind: "TooDeep", limit: calculationLimits.nestingDepth })
  const value = try parse(cursor)
  cursor.depth--
  return value
}

effect function sum(cursor: Cursor): Num!ExpressionRefused {
  let left = try product(cursor)
  for (;;) {
    const op = skip(cursor)
    if (op !== "+" && op !== "-") return left
    cursor.pos++
    const right = try product(cursor)
    left = left.kind === "Int" && right.kind === "Int"
      ? try integer(cursor, op === "+" ? left.value + right.value : left.value - right.value)
      : float(op === "+" ? toFloat(left) + toFloat(right) : toFloat(left) - toFloat(right))
  }
}

effect function product(cursor: Cursor): Num!ExpressionRefused {
  let left = try unary(cursor)
  for (;;) {
    const op = skip(cursor)
    if (op !== "*" && op !== "/" && op !== "%") return left
    cursor.pos++
    const right = try unary(cursor)
    if (op === "*") {
      left = left.kind === "Int" && right.kind === "Int" ? try integer(cursor, left.value * right.value) : float(toFloat(left) * toFloat(right))
    } else if (left.kind === "Int" && right.kind === "Int" && op === "%") {
      if (right.value === 0n) throw refused(cursor, { kind: "DivisionByZero" })
      left = try integer(cursor, left.value % right.value)
    } else {
      const divisor = toFloat(right)
      if (divisor === 0) throw refused(cursor, { kind: "DivisionByZero" })
      left = float(op === "/" ? toFloat(left) / divisor : toFloat(left) % divisor)
    }
  }
}

effect function unary(cursor: Cursor): Num!ExpressionRefused {
  const sign = skip(cursor)
  if (sign !== "-" && sign !== "+") return try power(cursor)
  cursor.pos++
  const value = try nested(cursor, unary)
  if (sign === "+") return value
  return value.kind === "Int" ? try integer(cursor, -value.value) : float(-value.value)
}

effect function power(cursor: Cursor): Num!ExpressionRefused {
  const base = try primary(cursor)
  if (skip(cursor) !== "^") return base
  cursor.pos++
  const exponent = try nested(cursor, unary)
  if (base.kind === "Float" || exponent.kind === "Float" || exponent.value < 0n) return float(toFloat(base) ** toFloat(exponent))
  if (exponent.value > calculationLimits.exponent) throw refused(cursor, { kind: "ExponentTooLarge", limit: calculationLimits.exponent })
  const magnitude = base.value < 0n ? -base.value : base.value
  if (magnitude > 1n && (digits(magnitude) - 1) * Number(exponent.value) + 1 > calculationLimits.integerDigits) {
    throw refused(cursor, { kind: "TooManyDigits", limit: calculationLimits.integerDigits })
  }
  return try integer(cursor, base.value ** exponent.value)
}

effect function primary(cursor: Cursor): Num!ExpressionRefused {
  if (skip(cursor) === "(") {
    cursor.pos++
    const inner = try nested(cursor, sum)
    if (skip(cursor) !== ")") throw refused(cursor, { kind: "MissingParenthesis", position: cursor.pos + 1 })
    cursor.pos++
    return inner
  }
  const literal = numberLiteral.exec(cursor.src.slice(cursor.pos))?.[0]
  if (literal === undefined) throw refused(cursor, { kind: "ExpectedNumber", position: cursor.pos + 1 })
  cursor.pos += literal.length
  const plain = literal.replace(/[_,]/g, "")
  return plain.includes(".") ? float(Number.parseFloat(plain)) : try integer(cursor, try Effect.try({ try: () => BigInt(plain), catch: () => refused(cursor, { kind: "ExpectedNumber", position: cursor.pos + 1 }) }))
}

export effect function calculate(expression: string): Calculation!ExpressionRefused {
  const cursor: Cursor = { src: expression, pos: 0, depth: 0 }
  if (expression.length > calculationLimits.expressionCharacters) throw refused(cursor, { kind: "TooLong", limit: calculationLimits.expressionCharacters })
  const result = try sum(cursor)
  if (skip(cursor) !== undefined) throw refused(cursor, { kind: "UnexpectedCharacter", position: cursor.pos + 1, found: cursor.src[cursor.pos] ?? "" })
  if (result.kind === "Int") return { expression, value: result.value.toString(), exact: true }
  if (!Number.isFinite(result.value)) throw refused(cursor, { kind: "NotFinite" })
  return { expression, value: String(Number(result.value.toPrecision(15))), exact: false }
}

export const gateRoles: Partial<Record<Role, RoleGateRole>> = { Guest: "GUEST", User: "USER", Admin: "ADMIN", Owner: "OWNER" }

function expressionOf(options: unknown): string {
  const parameters = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
  const raw = typeof parameters === "object" && parameters !== null && "expression" in parameters ? parameters.expression : undefined
  return typeof raw === "string" ? raw.trim() : ""
}

async function evaluate(options: unknown): Promise<ActionResult> {
  const expression = expressionOf(options)
  if (expression === "") {
    return { success: false, text: `${calculateDecl.name} needs an expression, such as "3847 * 292".`, data: { expression, refusal: "MissingExpression" } }
  }
  const calculated = await runPromise(Effect.result(calculate(expression)))
  if (Result.isFailure(calculated)) {
    const { refusal } = calculated.failure
    return {
      success: false,
      text: `${calculateDecl.name} could not evaluate "${expression}": ${refusalText(refusal)}. Supported: numbers with + - * / % ^ and parentheses.`,
      data: { expression, refusal: refusal.kind },
    }
  }
  const { value, exact } = calculated.success
  return { success: true, text: `${expression} = ${value}${exact ? "" : " (floating point, 15 significant digits)"}`, data: { expression, value, exact } }
}

const calculateAction: Action = {
  name: calculateDecl.name,
  description: "Exact arithmetic: evaluates a numeric expression (+ - * / % ^, parentheses, decimals, unary minus) deterministically. Use it for any multi-digit arithmetic instead of computing it yourself; integer results are exact.",
  similes: ["MATH", "COMPUTE", "ARITHMETIC", "MULTIPLY", "DIVIDE"],
  parameters: [{
    name: "expression", required: true, schema: { type: "string" },
    description: 'The bare numeric expression, such as "3847 * 292" or "(12.5 + 3) / 4". Numbers and + - * / % ^ ( ) only: no words, no variables.',
  }],
  roleGate: { minRole: gateRoles[calculateDecl.minRole] ?? "OWNER" },
  validate: async () => true,
  handler: async (_runtime, _message, _state, options) => evaluate(options),
}

const calculatorCommand = /^(?:(?:please)[, ]+|(?:can|could|would) you (?:please )?)?(?:calculate|use (?:the )?calculator (?:for|to calculate)) +([0-9,.+*\/%^()_\t -]+?)[.!?]?$/iu

// spec/agent/conversation/planning.md, "An explicit calculator command uses its literal expression first"
turnFirstCalls.set(calculateAction, (_runtime, { content }) => {
  const expression = typeof content.text === "string" ? calculatorCommand.exec(content.text.trim())?.[1]?.trim() : undefined
  return expression !== undefined && /\d/.test(expression) && expression.length <= calculationLimits.expressionCharacters ? { expression } : undefined
})

export const basicActionsModule: ModuleFactory<never> = effect () => {
  return {
    name: basicActionsModuleName,
    plugin: {
      name: basicActionsModuleName,
      description: "The agent's own basic actions: exact arithmetic with no I/O",
      actions: [calculateAction],
    },
  } satisfies AgentModule
}
