// spec/agent/approvals.md, "Story: Resolve what I reviewed, only on the screen"; spec/agent/approvals.md, "Story: See the requests waiting for me"; spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"
import type { AgentModule, ModuleContext, ModuleFactory } from "../host/module.vibe"
import { OwnerApprovalsService, ownerApprovalsServiceType } from "./queue.vibe"
import { approvalRoutes, type ApprovalsPort } from "./routes.vibe"

export const approvalsModuleName = "@elizaos/agent/approvals"

error ApprovalsNotStarted { serviceType: string }

function servicePort(context: ModuleContext): ApprovalsPort {
  const service = async () => {
    const started = await context.runtime.getServiceLoadPromise(ownerApprovalsServiceType)
    if (!(started instanceof OwnerApprovalsService)) throw new ApprovalsNotStarted({ serviceType: ownerApprovalsServiceType })
    return started
  }
  return {
    list: async (query) => (await service()).list(query),
    resolve: async (id, decision, revision) => (await service()).resolve(id, decision, revision),
  }
}

export const approvalsModule: ModuleFactory<never> = effect (context) => {
  return {
    name: approvalsModuleName,
    plugin: {
      name: approvalsModuleName,
      description: "The owner's approval queue: list requests and resolve the one the owner reviewed",
      services: [OwnerApprovalsService],
      routes: approvalRoutes(servicePort(context), context.ownerEntityId),
    },
  } satisfies AgentModule
}
