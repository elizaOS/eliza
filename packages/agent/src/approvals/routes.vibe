// spec/agent/approvals.md, "Story: Resolve what I reviewed, only on the screen"; spec/agent/approvals.md, "Story: See the requests waiting for me"; spec/agent/approvals.md, "The list shows at most 500 requests of the asked phase, newest first, and changes nothing"; spec/agent/approvals.md, "A decision applies only to an open calendar request whose revision is the one reviewed"; spec/agent/approvals.md, "Declining never runs the change, and approving never declines"; spec/agent/approvals.md, "Without the calendar executor an approval changes nothing"
import type { Decision, PageQuery, Phase, PhaseFilter, Refusal, ResolveKind } from "../../gen/agent__approvals.effect.vibe"
import type { LocalRoute } from "../access/routes.vibe"

export interface ApprovalRecord {
  readonly id: string
  readonly phase: Phase
  readonly subjectUserId: string
  readonly action: string
  readonly payload: Readonly<Record<string, unknown>>
  readonly reason: string
  readonly expiresAt: number
  readonly createdAt: number
  readonly updatedAt: number
  readonly revision: string
}

export interface ApprovalFailure {
  readonly code: string
  readonly retryable: boolean
  readonly acceptance: "not_accepted" | "unknown"
}

export type Resolution =
  | { readonly kind: "resolved"; readonly outcome: ResolveKind; readonly text?: string; readonly failure?: ApprovalFailure }
  | { readonly kind: "refused"; readonly refusal: Refusal }

export interface ApprovalsPort {
  list(query: PageQuery): Promise<readonly ApprovalRecord[]>
  resolve(id: string, decision: Decision, revision: string): Promise<Resolution>
}

export error ApprovalsFailed { cause: unknown }

const wirePhase = {
  Pending: "pending", Approved: "approved", Retryable: "retryable", ReconciliationRequired: "reconciliation_required",
  Done: "done", Declined: "rejected", Expired: "expired",
} as const satisfies Record<Phase, string>
const wireKind = {
  KindSucceeded: "succeeded", KindRejected: "rejected", KindInvalidated: "invalidated", KindRetryable: "retryable", KindBlocked: "blocked",
} as const satisfies Record<ResolveKind, string>
const refusalAnswer = {
  NotFound: { status: 404, error: "not_found" },
  Stale: { status: 409, error: "stale_revision" },
  Unavailable: { status: 503, error: "calendar_approvals_unavailable" },
} as const satisfies Record<Refusal, { status: number; error: string }>
const phaseOf = new Map(Object.entries(wirePhase).map(([phase, wire]) => [wire, phase as Phase]))
const decisionOf = { approve: "Approve", reject: "Reject" } as const satisfies Record<string, Decision>
const defaultLimit = 50
const pageCap = 500

type Phases = PhaseFilter | { readonly tag: "InFlight" }

function phasesOf(state: string | undefined): Phases | undefined {
  if (state === undefined) return { tag: "OnlyPhase", phase: "Pending" }
  if (state === "all") return { tag: "AllPhases" }
  if (state === "executing") return { tag: "InFlight" }
  const phase = phaseOf.get(state)
  return phase === undefined ? undefined : { tag: "OnlyPhase", phase }
}

function limitOf(limit: string | undefined): number | undefined {
  if (limit === undefined) return defaultLimit
  if (!/^[1-9][0-9]*$/.test(limit)) return undefined
  return Math.min(Number(limit), pageCap)
}

const ResolveBody = Schema.Struct({ decision: Schema.Literals(["approve", "reject"]), revision: Schema.NonEmptyString })
const resolveBody = Schema.decodeUnknownOption(ResolveBody, { onExcessProperty: "error" })
const failure = (status: number, error: string) => ({ status, body: { error } })

export function wireApproval(record: ApprovalRecord) {
  return {
    id: record.id, state: wirePhase[record.phase], subjectUserId: record.subjectUserId, action: record.action,
    payload: record.payload, reason: record.reason, expiresAt: new Date(record.expiresAt).toISOString(),
    createdAt: new Date(record.createdAt).toISOString(), updatedAt: new Date(record.updatedAt).toISOString(), revision: record.revision,
  }
}

function resolveAnswer(id: string, decision: keyof typeof decisionOf, resolution: Resolution) {
  switch (resolution.kind) {
    case "refused": return failure(refusalAnswer[resolution.refusal].status, refusalAnswer[resolution.refusal].error)
    case "resolved": return {
      status: 200,
      body: {
        requestId: id, decision, kind: wireKind[resolution.outcome],
        ...(resolution.text === undefined ? {} : { text: resolution.text }),
        ...(resolution.failure === undefined ? {} : { failure: resolution.failure }),
      },
    }
  }
}

effect function listed(port: ApprovalsPort, phases: Phases, limit: number) {
  if (phases.tag === "InFlight") return []
  const records = try tryPromise({ try: () => port.list({ phases, limit }), catch: (cause) => new ApprovalsFailed({ cause }) })
  return records.map(wireApproval)
}

export function approvalRoutes(port: ApprovalsPort, ownerEntityId: string): LocalRoute[] {
  return [
    {
      method: "GET", path: "/api/approvals",
      query: [{ key: "state", accepts: { kind: "any" } }, { key: "limit", accepts: { kind: "any" } }],
      handler: ({ query }) => {
        const phases = phasesOf(query.get("state"))
        if (phases === undefined) return failure(400, "invalid_state")
        const limit = limitOf(query.get("limit"))
        if (limit === undefined) return failure(400, "invalid_limit")
        return runPromise(effect {
          return { status: 200, body: { ownerEntityId, approvals: try listed(port, phases, limit) } }
        })
      },
    },
    {
      method: "POST", path: "/api/approvals/{id}/resolve",
      handler: ({ parameters, body }) => {
        const sent = Option.getOrUndefined(resolveBody(body ?? {}))
        if (sent === undefined) return failure(400, "invalid_resolution")
        const id = parameters.get("id") ?? ""
        return runPromise(effect {
          const resolution = try tryPromise({
            try: () => port.resolve(id, decisionOf[sent.decision], sent.revision),
            catch: (cause) => new ApprovalsFailed({ cause }),
          })
          return resolveAnswer(id, sent.decision, resolution)
        })
      },
    },
  ]
}
