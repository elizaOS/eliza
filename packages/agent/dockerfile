FROM node:23.3.0-slim AS builder

RUN apt-get update && apt-get install -y \
    python3 make g++ git && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@9.15.1

WORKDIR /app

# Point to the root directory for workspace files
COPY ../../package.json ../../pnpm-workspace.yaml ../../pnpm-lock.yaml* ../../turbo.json* ./

# Copy the agent package itself
COPY package.json ./packages/agent/

RUN pnpm install --no-frozen-lockfile

# Copy the rest of the project
COPY ../../ .

RUN pnpm build

FROM node:23.3.0-slim AS runner

RUN npm install -g pnpm@9.15.1
WORKDIR /app

COPY --from=builder /app ./

EXPOSE 3000

CMD ["pnpm", "--filter", "@elizaos/agent", "start"]
