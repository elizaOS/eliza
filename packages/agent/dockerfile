FROM oven/bun:1.1.26-slim AS builder

WORKDIR /app

# Copy EVERYTHING from the root context
COPY . .

# Now Bun can see pnpm-workspace.yaml and install the full monorepo
RUN bun install --frozen-lockfile

# Build everything
RUN bun run build

FROM oven/bun:1.1.26-slim AS runner
WORKDIR /app

# Copy the built files from the builder stage
COPY --from=builder /app /app

EXPOSE 3000

# Run the agent specifically
CMD ["bun", "run", "--filter", "@elizaos/agent", "start"]
