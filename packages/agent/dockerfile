# Use the official Bun image
FROM oven/bun:1.1.26-slim AS builder

WORKDIR /app

# Copy everything from the root
COPY . .

# Install dependencies using Bun
RUN bun install --frozen-lockfile

# Build the project (assuming your scripts use bun)
RUN bun run build

# Final runtime stage
FROM oven/bun:1.1.26-slim AS runner
WORKDIR /app

# Copy built files
COPY --from=builder /app /app

EXPOSE 3000

# Start the agent using bun
CMD ["bun", "run", "--filter", "@elizaos/agent", "start"]
