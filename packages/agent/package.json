{
  "name": "@elizaos/agent",
  "version": "2.0.6",
  "description": "Standalone elizaOS-based agent and backend server package.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/elizaos/eliza",
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaos/eliza.git",
    "directory": "packages/agent"
  },
  "keywords": [
    "eliza",
    "agent",
    "backend",
    "runtime",
    "elizaos"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "eliza-autonomous": "./dist/bin.js"
  },
  "scripts": {
    "clean": "bun ../scripts/rm-path-recursive.ts dist dist-mobile dist-mobile-ios dist-mobile-ios-jsc && bun ../scripts/clean-stray-dts.ts",
    "start": "bun --no-install --conditions=eliza-source src/bin.ts",
    "dev": "bun --no-install --conditions=eliza-source --hot src/bin.ts",
    "prepublishOnly": "bun run build:dist",
    "build": "bun run build:dist",
    "build:mobile": "bun run scripts/build-mobile-bundle.ts",
    "build:ios-bun": "bun run scripts/build-mobile-bundle.ts --target=ios",
    "build:ios-jsc": "bun run scripts/build-mobile-bundle.ts --target=ios-jsc",
    "perf:cerebras-chat": "bun --conditions=eliza-source ../benchmarks/scripts/eliza-benchmark-scripts/agent/cerebras-chat-flow-latency.ts",
    "perf:relevant-conversations": "bun --conditions=eliza-source ../benchmarks/scripts/eliza-benchmark-scripts/agent/bench-relevant-conversations.ts",
    "verify:mobile-workspace-resolution": "bun run scripts/build-mobile-bundle.ts --verify-workspace-resolution",
    "build:docker-dist": "bun run build:dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:dist": "bun scripts/assert-package-boundary-imports.ts && bun ../scripts/rm-path-recursive.ts dist && tsc6 --noCheck -p tsconfig.build.json && bun ../scripts/prepare-package-dist.ts packages/agent && bun ../scripts/rewrite-dist-relative-imports-node-esm.ts packages/agent",
    "lint": "bunx @biomejs/biome check --write ./src ./test ./scripts vitest*.ts",
    "lint:check": "bunx @biomejs/biome check ./src ./test ./scripts vitest*.ts",
    "format": "bunx @biomejs/biome format --write src test scripts vitest*.ts",
    "format:check": "bunx @biomejs/biome format src test scripts vitest*.ts",
    "pack:dry-run": "cd dist && npm pack --dry-run",
    "test": "bun scripts/run-vitest-batches.ts",
    "test:e2e": "bun scripts/run-vitest-batches.ts",
    "test:integration": "bun scripts/run-vitest-batches.ts",
    "test:tee:dstack": "bun scripts/run-vitest-batches.ts test/tee-dstack-admission.test.ts test/tee-dstack-protected-profile.test.ts test/tee-dstack-gpu.test.ts test/tee-gpu-nvidia-attestation.test.ts",
    "test:tee:dstack-live": "bun scripts/run-vitest-batches.ts test/tee-dstack-live.test.ts",
    "test:formal": "node ../scripts/check-quint.ts packages/agent/quint"
  },
