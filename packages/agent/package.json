    "clean": "node ../scripts/rm-path-recursive.mjs dist dist-mobile dist-mobile-ios dist-mobile-ios-jsc && node ../scripts/clean-stray-dts.mjs",
    "start": "bun --no-install --conditions=eliza-source src/bin.ts",
    "dev": "bun --no-install --conditions=eliza-source --hot src/bin.ts",
    "prepublishOnly": "bun run build:dist",
    "build": "bun run build:dist",
    "build:mobile": "bun run scripts/build-mobile-bundle.mjs",
    "build:ios-bun": "bun run scripts/build-mobile-bundle.mjs --target=ios",
    "build:ios-jsc": "bun run scripts/build-mobile-bundle.mjs --target=ios-jsc",
    "perf:cerebras-chat": "bun --conditions=eliza-source scripts/cerebras-chat-flow-latency.ts",
    "perf:relevant-conversations": "bun --conditions=eliza-source scripts/bench-relevant-conversations.ts",
    "verify:mobile-workspace-resolution": "bun run scripts/build-mobile-bundle.mjs --verify-workspace-resolution",
    "build:docker-dist": "bun run build:dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:dist": "node scripts/assert-package-boundary-imports.mjs && node ../scripts/rm-path-recursive.mjs dist && tsc6 --noCheck -p tsconfig.build.json && node ../scripts/prepare-package-dist.mjs packages/agent && node ../scripts/rewrite-dist-relative-imports-node-esm.mjs packages/agent",
    "lint": "bunx @biomejs/biome check --write ./src ./test ./scripts vitest*.ts",
    "lint:check": "bunx @biomejs/biome check ./src ./test ./scripts vitest*.ts",
    "format": "bunx @biomejs/biome format --write src test scripts vitest*.ts",
    "format:check": "bunx @biomejs/biome format src test scripts vitest*.ts",
    "pack:dry-run": "cd dist && npm pack --dry-run",
    "test": "node scripts/run-vitest-batches.ts",
    "test:e2e": "node scripts/run-vitest-batches.ts",
    "test:integration": "node scripts/run-vitest-batches.ts"
  },
