// spec/agent/conversation/turns.md, "Story: Stop a reply and know whether it stopped"; spec/agent/conversation/turns.md, "Story: Remember what of a spoken reply was heard"
import { assert, it } from "@effect/vitest"
import type { Memory, UUID } from "@elizaos/core"
import { cloudFake, call, deviceKey, host, startInProcess, stream, type InProcess } from "./support/kernel.vibe"
import type { LocalAnswer, LocalRequest, Refusal } from "./support/socket-client.ts"

module node {
  import { randomUUID } from "node:crypto"
  import type { AgentRuntime, UUID } from "@elizaos/core"
  import { heardView } from "../src/conversation/heard.vibe"

  export const fresh = Array.from({ length: 6 }, () => randomUUID() as UUID)

  export function holdRoom(runtime: AgentRuntime, roomId: UUID) {
    const gate = Promise.withResolvers<void>()
    const ended = runtime.roomHandlerQueue.withLease(roomId, () => runtime.turnControllers.runWith(roomId, () => gate.promise))
    return { release: () => gate.resolve(), ended }
  }

  export async function storedReply(runtime: AgentRuntime, id: UUID) {
    const [memory] = await runtime.adapter.getMemoriesByIds([id], "messages")
    return { text: memory?.content.text, view: memory === undefined ? undefined : heardView(memory) }
  }
}
import { fresh, holdRoom, storedReply } from node

interface Conversation { readonly id: string; readonly roomId: UUID }

const answerOf = (answer: LocalAnswer | Refusal) => "status" in answer ? { status: answer.status, body: answer.json } : { status: 0, body: answer.refused }

effect function ask(agent: InProcess, asked: LocalRequest) {
  return answerOf(try call(agent, asked))
}

effect function open(agent: InProcess) {
  const answer = try ask(agent, { method: "POST", path: "/api/conversations", body: {} })
  return (answer.body as { conversation: Conversation }).conversation
}

effect function stop(agent: InProcess, roomId: string, body: object = { reason: "client-stop" }) {
  return try ask(agent, { method: "POST", path: `/api/turns/${roomId}/abort`, body })
}

effect function until(check: () => boolean) {
  while (!check()) try sleep("20 millis")
}

effect function cloudAgent() {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({ launch: { backend: { kind: "cloud", origin: cloud.origin } }, frame: { credential: { version: 1, value: deviceKey } } })
  return { cloud, agent }
}

const receipt = (roomId: string, outcome: string) => ({ status: 200, body: { aborted: outcome !== "nothingRunning", roomId, reason: "client-stop", outcome } })

it.live('Stop a streaming turn: confirmed when it ends in time, nothing running after, and only an owned room (spec/agent/conversation/turns.md, "A Stop is confirmed only when its turn ends within five seconds, and is otherwise uncertain")', effect () => {
  const { cloud, agent } = try cloudAgent()
  const chat = try open(agent)
  try Effect.sync(() => cloud.script({ kind: "hang" }))
  const sending = fork stream(agent, { method: "POST", path: `/api/conversations/${chat.id}/messages/stream`, body: { text: "Think forever." } })
  try until(() => cloud.calls.some((made) => made.path.endsWith("/chat/completions")))
  const confirmed = try stop(agent, chat.roomId)
  const completion = cloud.calls.find((made) => made.path.endsWith("/chat/completions"))
  try host("model call cancelled", () => completion?.aborted ?? Promise.resolve())
  const streamed = try join sending
  const idle = try stop(agent, chat.roomId)
  const unowned = try stop(agent, fresh[0])
  const malformed = try stop(agent, "not-a-room")
  const noReason = try stop(agent, chat.roomId, { reason: "" })
  const omittedReason = try stop(agent, chat.roomId, {})
  try Effect.try(() => assert.deepStrictEqual({
    confirmed, idle, omittedReason, streamed: streamed.status, refused: [unowned.status, malformed.status, noReason.status],
  }, {
    confirmed: receipt(chat.roomId, "stopped"), idle: receipt(chat.roomId, "nothingRunning"),
    omittedReason: { status: 200, body: { aborted: false, roomId: chat.roomId, reason: "owner_requested_abort", outcome: "nothingRunning" } }, streamed: 200, refused: [404, 404, 400],
  }))
}, 120_000)

it.live('A turn that does not stop within five seconds is uncertain, a second Stop joins it, and a later Stop waits again (spec/agent/conversation/turns.md, "A Stop is confirmed only when its turn ends within five seconds, and is otherwise uncertain")', effect () => {
  const agent = try startInProcess()
  const chat = try open(agent)
  const runtime = agent.agent.runtime
  const holding = try Effect.sync(() => holdRoom(runtime, chat.roomId))
  const started = Date.now()
  const pair = try.all [stop(agent, chat.roomId), stop(agent, chat.roomId)]
  const waited = Date.now() - started
  const later = fork stop(agent, chat.roomId)
  try sleep("200 millis")
  try Effect.sync(() => holding.release())
  const after = try join later
  try host("held turn ended", () => holding.ended)
  const idle = try stop(agent, chat.roomId)
  try Effect.try(() => assert.deepStrictEqual({ pair, waitedEnough: waited >= 5000, after, idle }, {
    pair: [receipt(chat.roomId, "uncertain"), receipt(chat.roomId, "uncertain")], waitedEnough: true,
    after: receipt(chat.roomId, "stopped"), idle: receipt(chat.roomId, "nothingRunning"),
  }))
}, 120_000)

it.live('Report what of a spoken reply was heard: prefix, nothing heard, 409 and unchanged, with the reply kept whole (spec/agent/conversation/turns.md, "A heard report only moves the heard boundary of an agent reply back, and never changes the reply"; spec/agent/conversation/turns.md, "The heard part and the unheard remainder together are the whole reply")', effect () => {
  const agent = try startInProcess()
  const chat = try open(agent)
  const runtime = agent.agent.runtime
  const whole = "Hello there. More words."
  const at = Date.now()
  const said: Memory = { id: fresh[1], entityId: fresh[2], agentId: runtime.agentId, roomId: chat.roomId, createdAt: at, content: { text: "Say hello.", source: "device" } }
  const answered: Memory = { id: fresh[3], entityId: runtime.agentId, agentId: runtime.agentId, roomId: chat.roomId, createdAt: at + 1, content: { text: whole, inReplyTo: said.id, source: "device" } }
  try host("seed reply", () => runtime.adapter.createMemories([said, answered].map((memory) => ({ memory, tableName: "messages" }))))
  const heard = (messageId: string, body: object, conversation = chat.id) =>
    ask(agent, { method: "POST", path: `/api/conversations/${conversation}/messages/${messageId}/heard`, body })
  const stored = () => host("read reply", () => storedReply(runtime, answered.id as UUID))
  const id = String(answered.id)
  const changed = (value: boolean) => ({ status: 200, body: { ok: true, messageId: id, changed: value } })
  const conflict = { status: 409, body: { error: "CONVERSATION_HEARD_NOT_PREFIX" } }

  const wholeHeard = try heard(id, { heardText: whole })
  const untouched = try stored()
  const part = try heard(id, { heardText: "Hello there." })
  const partAgain = try heard(id, { heardText: "Hello there." })
  const partStored = try stored()
  const pastBoundary = try heard(id, { heardText: "Hello there. More" })
  const notPrefix = try heard(id, { heardText: "Goodbye" })
  const blank = try heard(id, { heardText: "   " })
  const nothing = try heard(id, { nothingHeard: true })
  const nothingAgain = try heard(id, { nothingHeard: true })
  const afterNothing = try heard(id, { heardText: "Hello" })
  const nothingStored = try stored()
  const userMessage = try heard(String(said.id), { nothingHeard: true })
  const unknownMessage = try heard(fresh[4], { nothingHeard: true })
  const unknownConversation = try heard(id, { nothingHeard: true }, fresh[5])
  const malformed = try heard(id, { heardText: "Hello", nothingHeard: true })

  try Effect.try(() => assert.deepStrictEqual({
    wholeHeard, untouched, part, partAgain, partStored, pastBoundary, notPrefix, blank, nothing, nothingAgain, afterNothing, nothingStored,
    missing: [userMessage.status, unknownMessage.status, unknownConversation.status], malformed: malformed.status,
  }, {
    wholeHeard: changed(false), untouched: { text: whole, view: { heard: whole, unheard: "" } },
    part: changed(true), partAgain: changed(false), partStored: { text: whole, view: { heard: "Hello there.", unheard: " More words." } },
    pastBoundary: conflict, notPrefix: conflict, blank: conflict,
    nothing: changed(true), nothingAgain: changed(false), afterNothing: conflict, nothingStored: { text: whole, view: { heard: "", unheard: whole } },
    missing: [404, 404, 404], malformed: 400,
  }))
}, 120_000)
