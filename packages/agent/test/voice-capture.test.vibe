// spec/agent/voice/clientAudio.md, "Story: Record and play speech in the screen without losing a segment"; spec/agent/voice/clientAudio.md, "A WAV holds every sample in order as mono PCM16 behind a 44-byte header"; spec/agent/voice/clientAudio.md, "The capture keeps a bounded prefix in arrival order while the meter keeps counting"; spec/agent/voice/clientAudio.md, "A preview offers only new speech and never offers a failed preview again"
import { assert, it } from "@effect/vitest"
import {
  AudioReadFailed, audioBlobBase64, ClipCancelled, ClipRefused, decodeRecordedClip, encodeMonoPcm16WavChunks, WavRateRefused,
} from "../src/voice/index.vibe"

module node {
  import { Effect } from "effect"
  import {
    captureBlockSamples, CapturePolicyRefused, CaptureUnavailable, SharedContextRateRefused, startCumulativeMicrophoneCapture,
    type AudioBlob, type CumulativeCapture, type CumulativeCaptureOptions, type PreviewReceiver,
  } from "../src/voice/index.vibe"
  import { FakeAudioContext, FakeMicrophone, fakeCaptureAudio, tone } from "./support/audio-fake.ts"

  type Options = CumulativeCaptureOptions<FakeMicrophone, FakeAudioContext>

  export const sampleBlob: AudioBlob = new Blob([Uint8Array.of(0, 1, 2, 255, 254)])

  const settle = (ms = 2) => new Promise<void>((resolve) => setTimeout(resolve, ms))

  function rig(overrides: Partial<Options> = {}, receiver?: PreviewReceiver) {
    const seen = { previews: [] as number[][], meter: [] as Array<[number, number, number]> }
    const audio = fakeCaptureAudio()
    const microphone = new FakeMicrophone()
    const options: Options = {
      audio, stream: microphone, sampleRate: 8000, maxSeconds: 1, minimumNewSamples: 1, previewIntervalMs: 60000, speechThreshold: 0.1,
      onPreview: receiver ?? (async (chunks) => { seen.previews.push(chunks.map((chunk) => chunk.length)) }),
      meter: (level, endSample, sampleRate) => seen.meter.push([Math.round(level * 100) / 100, endSample, sampleRate]),
      ...overrides,
    }
    return { seen, audio, microphone, options }
  }

  const start = (options: Options): Promise<CumulativeCapture> => Effect.runPromise(startCumulativeMicrophoneCapture(options))
  const refusal = (options: Options): Promise<unknown> => Effect.runPromise(Effect.flip(startCumulativeMicrophoneCapture(options)))

  export async function boundedPrefix() {
    const { seen, audio, microphone, options } = rig()
    const kept: Float32Array[] = []
    const capture = await start({ ...options, onPreview: async (chunks) => { kept.push(...chunks) } })
    const left = tone(0.5, captureBlockSamples * 4)
    left.fill(0.25, captureBlockSamples, captureBlockSamples * 2)
    microphone.say(left, tone(-0.9, left.length))
    microphone.say(tone(0.5, 100))
    microphone.say(tone(0.5, captureBlockSamples))
    const offered = await capture.snapshot()
    const pastCap = await capture.snapshot()
    capture.close()
    return {
      offered, pastCap, lengths: kept.map((chunk) => chunk.length), firstValues: kept.map((chunk) => chunk[0]),
      meter: seen.meter, contextRate: audio.opened[0]?.sampleRate, resumed: audio.opened[0]?.resumed,
    }
  }

  export async function stickySpeech() {
    const { seen, microphone, options } = rig()
    const capture = await start(options)
    microphone.say(tone(0, captureBlockSamples))
    const beforeSpeech = await capture.snapshot()
    microphone.say(tone(0.5, captureBlockSamples))
    const atSpeech = await capture.snapshot()
    microphone.say(tone(0, captureBlockSamples))
    const afterSilence = await capture.snapshot()
    const nothingNew = await capture.snapshot()
    capture.close()
    const silentPastCap = rig({ maxSeconds: 0.25 })
    const quiet = await start(silentPastCap.options)
    silentPastCap.microphone.say(tone(0, captureBlockSamples))
    silentPastCap.microphone.say(tone(0.9, captureBlockSamples))
    const speechPastCap = await quiet.snapshot()
    quiet.close()
    return { answers: [beforeSpeech, atSpeech, afterSilence, nothingNew, speechPastCap], previews: seen.previews, quietPreviews: silentPastCap.seen.previews }
  }

  export async function failedPreview(how: "rejects" | "throws") {
    let calls = 0
    const offered: number[][] = []
    const { microphone, options } = rig({}, (chunks) => {
      calls += 1
      offered.push(chunks.map((chunk) => chunk.length))
      if (calls === 1) {
        if (how === "throws") throw new Error("preview refused at once")
        return Promise.reject(new Error("preview failed"))
      }
      return Promise.resolve()
    })
    const capture = await start(options)
    microphone.say(tone(0.5, captureBlockSamples))
    const failed = await capture.snapshot()
    const again = await capture.snapshot()
    microphone.say(tone(0.5, captureBlockSamples))
    const next = await capture.snapshot()
    capture.close()
    return { answers: [failed, again, next], calls, offered }
  }

  export async function oneAtATime() {
    const gate = Promise.withResolvers<void>()
    let calls = 0
    const { microphone, options } = rig({}, async () => {
      calls += 1
      await gate.promise
    })
    const capture = await start(options)
    microphone.say(tone(0.5, captureBlockSamples))
    const first = capture.snapshot()
    const second = capture.snapshot()
    await settle()
    const callsWhileHeld = calls
    gate.resolve()
    const answers = await Promise.all([first, second])
    capture.close()
    return { answers, callsWhileHeld, calls }
  }

  export async function ticking() {
    const { seen, microphone, options } = rig({ previewIntervalMs: 5, minimumNewSamples: captureBlockSamples * 2 })
    const capture = await start(options)
    microphone.say(tone(0.5, captureBlockSamples))
    await settle(30)
    const belowMinimum = seen.previews.length
    microphone.say(tone(0.5, captureBlockSamples))
    await settle(30)
    const atMinimum = seen.previews.slice()
    await settle(30)
    const idle = seen.previews.length
    capture.close()
    microphone.say(tone(0.5, captureBlockSamples * 2))
    await settle(30)
    return { belowMinimum, atMinimum, idle, afterClose: seen.previews.length, closedSnapshot: await capture.snapshot() }
  }

  export async function custody() {
    const owned = rig()
    const ownedCapture = await start(owned.options)
    ownedCapture.close()
    ownedCapture.close()
    await settle()
    const sharedContext = new FakeAudioContext(8000)
    const shared = rig({ sharedContext })
    const sharedCapture = await start(shared.options)
    sharedCapture.close()
    await settle()
    const mismatch = await refusal(rig({ sharedContext: new FakeAudioContext(48000) }).options)
    const failingAudio = fakeCaptureAudio({ workletFails: true })
    const unavailable = await refusal(rig({ audio: failingAudio }).options)
    return {
      owned: [owned.audio.opened.length, owned.audio.opened[0]?.closed, owned.microphone.tracksStopped],
      shared: [shared.audio.opened.length, sharedContext.closed, sharedContext.resumed, shared.microphone.tracksStopped],
      mismatch: mismatch instanceof SharedContextRateRefused ? [mismatch.contextRate, mismatch.captureRate] : "other",
      unavailable: unavailable instanceof CaptureUnavailable,
      failedContextClosed: failingAudio.opened[0]?.closed,
    }
  }

  export async function refusedPolicies() {
    const cases: Array<Partial<Options>> = [
      { sampleRate: 7999 }, { sampleRate: 48001 }, { sampleRate: 16000.5 }, { maxSeconds: 0 }, { maxSeconds: Number.NaN },
      { minimumNewSamples: -1 }, { minimumNewSamples: 1.5 }, { previewIntervalMs: 0 }, { speechThreshold: Number.NaN }, { speechThreshold: -0.1 },
    ]
    const refused: string[] = []
    for (const overrides of cases) {
      const error = await refusal(rig(overrides).options)
      refused.push(error instanceof CapturePolicyRefused ? `${error.field}:${error.value}` : "other")
    }
    return refused
  }
}
import { boundedPrefix, custody, failedPreview, oneAtATime, refusedPolicies, sampleBlob, stickySpeech, ticking } from node

const story = "Record and play speech without losing a segment"

function riffField(bytes: Uint8Array, offset: number, length: number): string {
  return String.fromCharCode(...bytes.subarray(offset, offset + length))
}

it.effect(`${story}: a WAV holds every sample of every chunk in order as mono PCM16 behind a 44-byte header`, () => effect {
  const wav = try encodeMonoPcm16WavChunks([
    Float32Array.of(-1, 1, 0.5, -0.5, Number.NaN),
    Float32Array.of(),
    Float32Array.of(Number.POSITIVE_INFINITY, -2, 2, 0.0000152, -0.000016),
  ], 16000)
  const view = new DataView(wav.buffer)
  const samples = Array.from({ length: (wav.length - 44) / 2 }, (_, index) => view.getInt16(44 + index * 2, true))
  try Effect.try(() => {
    assert.strictEqual(wav.length, 44 + 2 * 10)
    assert.deepStrictEqual([riffField(wav, 0, 4), view.getUint32(4, true), riffField(wav, 8, 4), riffField(wav, 12, 4)], ["RIFF", 56, "WAVE", "fmt "])
    assert.deepStrictEqual(
      [view.getUint32(16, true), view.getUint16(20, true), view.getUint16(22, true), view.getUint32(24, true), view.getUint32(28, true), view.getUint16(32, true), view.getUint16(34, true)],
      [16, 1, 1, 16000, 32000, 2, 16],
    )
    assert.deepStrictEqual([riffField(wav, 36, 4), view.getUint32(40, true)], ["data", 20])
    assert.deepStrictEqual(samples, [-32768, 32767, 16384, -16384, 0, 0, -32768, 32767, 0, -1])
  })
})

it.effect(`${story}: a WAV rate is a whole number from 8,000 to 48,000`, () => effect {
  const refused: number[] = []
  for (const rate of [7999, 48001, 16000.5, Number.NaN]) {
    const error = try Effect.flip(encodeMonoPcm16WavChunks([Float32Array.of(0)], rate))
    refused.push(error instanceof WavRateRefused ? error.rate : -1)
  }
  const lowest = try encodeMonoPcm16WavChunks([], 8000)
  const highest = try encodeMonoPcm16WavChunks([Float32Array.of(0)], 48000)
  try Effect.try(() => {
    assert.deepStrictEqual(refused, [7999, 48001, 16000.5, Number.NaN])
    assert.deepStrictEqual([lowest.length, new DataView(highest.buffer).getUint32(24, true)], [44, 48000])
  })
})

it.effect(`${story}: an audio blob reads as base64, and a failed read is a typed error`, () => effect {
  const encoded = try audioBlobBase64(sampleBlob)
  const failed = try Effect.flip(audioBlobBase64({ arrayBuffer: () => Promise.reject(new Error("read refused")) }))
  try Effect.try(() => assert.deepStrictEqual([encoded, failed instanceof AudioReadFailed], ["AAEC//4=", true]))
})

it.effect(`${story}: the capture keeps channel 0 in 2,048-sample blocks up to its cap, clips only the block that reaches it, and meters every block`, () => effect {
  const got = try tryPromise(() => boundedPrefix())
  try Effect.try(() => assert.deepStrictEqual(got, {
    offered: true, pastCap: false, lengths: [2048, 2048, 2048, 1856], firstValues: [0.5, 0.25, 0.5, 0.5],
    meter: [[0.5, 2048, 8000], [0.25, 4096, 8000], [0.5, 6144, 8000], [0.5, 8192, 8000], [0.5, 10240, 8000]],
    contextRate: 8000, resumed: true,
  }))
})

it.effect(`${story}: only kept speech counts and it stays heard; a preview needs speech and a new sample`, () => effect {
  const got = try tryPromise(() => stickySpeech())
  try Effect.try(() => assert.deepStrictEqual(got, {
    answers: [false, true, true, false, false], previews: [[2048, 2048], [2048, 2048, 2048]], quietPreviews: [],
  }))
})

it.effect(`${story}: a preview that fails or throws at once is never offered again and leaves the recording whole`, () => effect {
  const runs = try tryPromise(() => Promise.all([failedPreview("rejects"), failedPreview("throws")]))
  try Effect.try(() => {
    for (const run of runs) assert.deepStrictEqual(run, { answers: [false, false, true], calls: 2, offered: [[2048], [2048, 2048]] })
  })
})

it.effect(`${story}: one preview is in flight at a time and a snapshot waits for it`, () => effect {
  const got = try tryPromise(() => oneAtATime())
  try Effect.try(() => assert.deepStrictEqual(got, { answers: [true, false], callsWhileHeld: 1, calls: 1 }))
})

it.effect(`${story}: a tick offers once the screen's minimum of new samples has arrived, and nothing after close`, () => effect {
  const got = try tryPromise(() => ticking())
  try Effect.try(() => assert.deepStrictEqual(got, { belowMinimum: 0, atMinimum: [[2048, 2048]], idle: 1, afterClose: 1, closedSnapshot: false }))
})

it.effect(`${story}: the capture closes only a context it opened, never the screen's tracks, and refuses a shared context at another rate`, () => effect {
  const got = try tryPromise(() => custody())
  try Effect.try(() => assert.deepStrictEqual(got, {
    owned: [1, true, 0], shared: [0, false, true, 0], mismatch: [48000, 8000], unavailable: true, failedContextClosed: true,
  }))
})

it.effect(`${story}: the capture refuses a policy outside its bounds`, () => effect {
  const got = try tryPromise(() => refusedPolicies())
  try Effect.try(() => assert.deepStrictEqual(got, [
    "sampleRate:7999", "sampleRate:48001", "sampleRate:16000.5", "maxSeconds:0", "maxSeconds:NaN",
    "minimumNewSamples:-1", "minimumNewSamples:1.5", "previewIntervalMs:0", "speechThreshold:NaN", "speechThreshold:-0.1",
  ]))
})

it.effect(`${story}: a recorded clip decodes to 16 kHz samples only when nonempty, at most 16 MB and 60 seconds, and stops when cancelled`, () => effect {
  const clip = (duration: number) => ({ decode: async () => ({ duration }), render: async (_clip: unknown, length: number) => new Float32Array(length) })
  const live = new AbortController().signal
  const samples = try decodeRecordedClip(new ArrayBuffer(8), live, clip(1.5))
  const empty = try Effect.flip(decodeRecordedClip(new ArrayBuffer(0), live, clip(1)))
  const tooLarge = try Effect.flip(decodeRecordedClip(new ArrayBuffer(16000001), live, clip(1)))
  const tooLong = try Effect.flip(decodeRecordedClip(new ArrayBuffer(8), live, clip(61)))
  const cancelled = try Effect.flip(decodeRecordedClip(new ArrayBuffer(8), AbortSignal.abort(), clip(1)))
  const later = new AbortController()
  const cancelledDuringDecode = try Effect.flip(decodeRecordedClip(new ArrayBuffer(8), later.signal, {
    decode: async () => {
      later.abort()
      return { duration: 1 }
    },
    render: async (_clip, length) => new Float32Array(length),
  }))
  try Effect.try(() => assert.deepStrictEqual(
    [samples.length, empty instanceof ClipRefused, tooLarge instanceof ClipRefused, tooLong instanceof ClipRefused ? tooLong.durationMs : 0, cancelled instanceof ClipCancelled, cancelledDuringDecode instanceof ClipCancelled],
    [24000, true, true, 61000, true, true],
  ))
})
