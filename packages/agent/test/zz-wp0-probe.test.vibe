// spec/agent/host/launch.md, "Story: Start the agent from one launch document"
import { assert, it } from "@effect/vitest"
import { call, startInProcess, stream } from "./support/kernel.vibe"
import { text } from "./support/cloud-fake.ts"

effect function turn(http: boolean) {
  const booted = try startInProcess({ http, cloud: true, launch: { callerRole: "owner" } })
  const opened = try call(booted, { method: "POST", path: "/api/conversations", body: {} })
  const id = ("json" in opened ? (opened.json as { conversation: { id: string } }).conversation.id : "")
  try Effect.sync(() => booted.cloud?.script(text("Hello", " there.")))
  const answer = try stream(booted, { method: "POST", path: `/api/conversations/${id}/messages/stream`, body: { text: "hi" } })
  return answer.text.includes('"type":"done","fullText":"Hello there."')
}

it.live('first (spec/agent/host/launch.md, "Story: Start the agent from one launch document")', effect () => {
  const done = try Effect.scoped(turn(false))
  try Effect.try(() => assert.strictEqual(done, true))
}, 300_000)

it.live('second (spec/agent/host/launch.md, "Story: Start the agent from one launch document")', effect () => {
  const done = try Effect.scoped(turn(true))
  try Effect.try(() => assert.strictEqual(done, true))
}, 300_000)
