// spec/agent/deviceActions/index.md, "Story: Enroll my device and revoke it"; spec/agent/deviceActions/index.md, "A revoked enrollment retires every open offer, and nothing offered under it is served again"; spec/agent/deviceActions/capabilities.md, "The enabled-view profile changes only against the revision the device read"; spec/agent/storage/database.md, "Migrations run in number order, one transaction each, and a destructive or newer schema is refused"
import { assert, it } from "@effect/vitest"
import type { IDatabaseAdapter } from "@elizaos/core"
import { apply } from "../gen/agent__deviceActions.effect.vibe"
import type { SessionOwner } from "../gen/core__sessions.effect.vibe"
import {
  changeEnrollment, changeViewProfile, enrollment, listRequests, offerRequest, openRequest, recordRequestClaim, recordRequestDecision, recordRequestReceipt, viewProfile,
  type AdmittedRequestReceipt, type OfferEvent, type RequestEvent, type RequestTerms,
} from "../src/device-actions/store.vibe"
import { openDeviceStorage } from "../src/storage/index.vibe"
import { migrations } from "../src/storage/schema.vibe"
import { host, scratch } from "./support/kernel.vibe"

module node {
  import { PGlite } from "@electric-sql/pglite"
  import type { IDatabaseAdapter } from "@elizaos/core"
  import type { DeviceRequest } from "../gen/agent__deviceActions.ts"
  import type { RequestTerms } from "../src/device-actions/store.vibe"

  export async function seedLegacyWorkflow(adapter: IDatabaseAdapter, state: DeviceRequest, terms: RequestTerms) {
    const db = await adapter.getConnection()
    if (!(db instanceof PGlite)) throw new Error("The migration fixture needs the real device database")
    await db.query(
      `INSERT INTO device_requests (proposal_id, revision, state, settled, operation, binding, bound_profile, need, created_at)
        VALUES ($1, 1, $2::jsonb, false, $3::jsonb, 'WorkflowBinding', $4::jsonb, $5::jsonb, $6)`,
      [state.proposalId, JSON.stringify(state), JSON.stringify(terms.operation), JSON.stringify(terms.boundProfile),
        JSON.stringify(terms.need), state.createdAt],
    )
  }

  export async function refuseRequestRetirement(adapter: IDatabaseAdapter, enabled: boolean) {
    const db = await adapter.getConnection()
    if (!(db instanceof PGlite)) throw new Error("The enrollment fixture needs the real device database")
    await db.query(enabled
      ? "ALTER TABLE device_requests ADD CONSTRAINT fixture_retirement CHECK (state->'enrollment'->>'tag' <> 'Revoked')"
      : "ALTER TABLE device_requests DROP CONSTRAINT fixture_retirement")
  }
}

import { refuseRequestRetirement, seedLegacyWorkflow } from node

const capability = "calendar.create.v1"
const owner: SessionOwner = { agentId: "agent-1", actorId: "owner-1", connector: "agent-1" }
const register: RequestEvent = { type: "registerDevice", keyHash: "key-hash-1", capabilities: [capability], workflowProtocol: 1 }
const terms: RequestTerms = {
  operation: { type: "calendar.create.v1", title: "Dentist" }, binding: "NoBinding",
  boundProfile: { tag: "NoRevisionRead" }, need: { required: ["CalendarCreateV1"], oneOf: [] },
}
const workflowTerms: RequestTerms = {
  operation: { type: "speak_text", text: "The reviewed notice" },
  binding: {
    kind: "WorkflowBinding", workflowId: "workflow-1", versionId: "version-1",
    runId: "run-1", stepId: "step-1", specDigest: "a".repeat(64),
  },
  boundProfile: { tag: "NoRevisionRead" }, need: { required: [], oneOf: ["CalendarCreateV1"] },
}
const result = { kind: "calendar", eventId: "event-1" }

const offerOf = (proposalId: string, now: number): OfferEvent => ({
  type: "offer", proposalId, digest: `digest-${proposalId}`, capability, expiresAt: now + 600_000, readBack: false,
  origin: { requestId: "", conversationId: "", inReplyTo: "" },
})

effect function open(directory: string, persistMemory: boolean, list = migrations) {
  return try host("open the store", () => openDeviceStorage({ stateDirectory: directory, persistMemory, account: null, embeddingDimensions: 0, migrations: list }))
}

effect function closed(adapter: IDatabaseAdapter) {
  try host("close the store", () => adapter.close())
}

effect function failure<A, E extends { readonly _tag: string }>(work: A!E) {
  const done = try exit(work)
  return Exit.isFailure(done) ? Option.getOrUndefined(Cause.findErrorOption(done.cause)) : undefined
}

effect function listed(adapter: IDatabaseAdapter) {
  const phases = (which: "open" | "settled") => effect {
    return (try listRequests(adapter, which)).map((row) => [row.proposalId, row.state.phase.tag, row.state.enrollment.tag])
  }
  return { open: try phases("open"), settled: try phases("settled") }
}

it.live('Keep accepted device receipts across a restart, and serve nothing offered under a revoked enrollment after the device enrolls again (spec/agent/deviceActions/index.md, "A receipt from the claimed attempt settles a dispatched request once"; spec/agent/deviceActions/index.md, "Story: Enroll my device and revoke it")', effect () => {
  const state = try scratch("device-store")
  const before = try Clock.currentTimeMillis
  const first = try open(state.file("state"), true)
  const enrolled = try changeEnrollment(first.adapter, register, owner)
  assert.strictEqual(enrolled.enrollment.tag, "Enrolled")
  assert.isAtLeast(enrolled.session.now, before)
  const otherKey = try failure(changeEnrollment(first.adapter, { ...register, keyHash: "key-hash-2" }, owner))
  assert.strictEqual(otherKey?._tag, "Rejected")
  for (const id of ["p1", "p2", "p3", "p-without-result"]) try offerRequest(first.adapter, offerOf(id, try Clock.currentTimeMillis), owner, id === "p3" ? workflowTerms : terms)
  const taken = try failure(offerRequest(first.adapter, offerOf("p1", try Clock.currentTimeMillis), owner, terms))
  assert.strictEqual(taken?._tag, "ProposalIdTaken")
  assert.strictEqual((try recordRequestDecision(first.adapter, { proposalId: "p1", digest: "digest-p1", by: owner, approved: true })).kind, "decided")
  const claimRequest = { proposalId: "p1", digest: "digest-p1", by: owner }
  const claimed = try recordRequestClaim(first.adapter, claimRequest)
  if (claimed.kind !== "claimed") return try die(new Error("The device claim was refused"))
  assert.strictEqual((try recordRequestClaim(first.adapter, claimRequest)).kind, "refused")
  const receipt: AdmittedRequestReceipt = {
    proposalId: "p1", by: owner, result,
    event: { type: "receipt", digest: "digest-p1", attemptId: claimed.binding.modelAttemptId, reportedOutcome: "ReportedApplied" },
  }
  const competingResult = { ...result, eventId: "event-2" }
  const [firstResult, secondResult] = try all([
    recordRequestReceipt(first.adapter, receipt),
    recordRequestReceipt(first.adapter, { ...receipt, result: competingResult }),
  ], { concurrency: "unbounded" })
  assert.deepStrictEqual([firstResult.kind, secondResult.kind].sort(), ["recorded", "refused"])
  const keptResult = firstResult.kind === "recorded" ? result : competingResult
  const refusedResult = firstResult.kind === "recorded" ? competingResult : result
  const noResult: AdmittedRequestReceipt = {
    proposalId: "p-without-result", by: owner, result: undefined,
    event: { type: "receipt", digest: "digest-p-without-result", attemptId: 1, reportedOutcome: "ReportedNothingRan" },
  }
  assert.strictEqual((try recordRequestDecision(first.adapter, {
    proposalId: noResult.proposalId, digest: noResult.event.digest, by: owner, approved: true,
  })).kind, "decided")
  assert.strictEqual((try recordRequestClaim(first.adapter, {
    proposalId: noResult.proposalId, digest: noResult.event.digest, by: owner,
  })).kind, "claimed")
  assert.strictEqual((try recordRequestReceipt(first.adapter, noResult)).kind, "recorded")
  assert.strictEqual((try recordRequestDecision(first.adapter, { proposalId: "p2", digest: "digest-p2", by: owner, approved: false })).kind, "decided")
  try closed(first.adapter)

  const second = try open(state.file("state"), true)
  assert.deepStrictEqual(try listed(second.adapter), {
    open: [["p3", "Offered", "Enrolled"]],
    settled: [["p1", "Receipted", "Enrolled"], ["p2", "Declined", "Enrolled"], ["p-without-result", "Receipted", "Enrolled"]],
  })
  const same = try recordRequestReceipt(second.adapter, { ...receipt, result: { eventId: keptResult.eventId, kind: keptResult.kind } })
  const changed = try recordRequestReceipt(second.adapter, { ...receipt, result: refusedResult })
  const wrongAttempt = try recordRequestReceipt(second.adapter, { ...receipt, result: keptResult, event: { ...receipt.event, attemptId: 2 } })
  const changedOutcome = try recordRequestReceipt(second.adapter, {
    ...receipt, result: keptResult, event: { ...receipt.event, reportedOutcome: "ReportedUnknown" },
  })
  const sameAbsent = try recordRequestReceipt(second.adapter, noResult)
  const changedToNull = try recordRequestReceipt(second.adapter, { ...noResult, result: null })
  assert.deepStrictEqual([same.kind, changed.kind, wrongAttempt.kind, changedOutcome.kind, sameAbsent.kind, changedToNull.kind], [
    "recorded", "refused", "refused", "refused", "recorded", "refused",
  ])
  const applied = try openRequest(second.adapter, "p1")
  assert.deepStrictEqual({ result: applied?.result, terms: applied?.terms, claim: applied?.claim, providerReceipt: applied?.providerReceipt }, {
    result: keptResult, terms, claim: claimed.binding, providerReceipt: undefined,
  })
  assert.deepStrictEqual((try openRequest(second.adapter, "p3"))?.terms, workflowTerms)
  assert.isUndefined(try openRequest(second.adapter, "missing"))

  const revoked = try changeEnrollment(second.adapter, { type: "revokeEnrollment" }, owner)
  assert.strictEqual(revoked.enrollment.tag, "Revoked")
  assert.deepStrictEqual(try listed(second.adapter), {
    open: [],
    settled: [["p1", "Receipted", "Revoked"], ["p2", "Declined", "Revoked"], ["p3", "Retired", "Revoked"], ["p-without-result", "Receipted", "Revoked"]],
  })
  const lateOffer = try failure(offerRequest(second.adapter, offerOf("p4", try Clock.currentTimeMillis), owner, terms))
  assert.strictEqual(lateOffer?._tag, "Rejected")
  assert.strictEqual((try enrollment(second.adapter)).enrollment.tag, "Revoked")

  const enrolledAgain = try changeEnrollment(second.adapter, { ...register, keyHash: "key-hash-2" }, owner)
  assert.strictEqual(enrolledAgain.enrollment.tag, "Enrolled")
  try offerRequest(second.adapter, offerOf("p4", try Clock.currentTimeMillis), owner, terms)
  const revokedReceipt = try recordRequestReceipt(second.adapter, { ...receipt, result: { eventId: keptResult.eventId, kind: keptResult.kind } })
  assert.strictEqual(revokedReceipt.kind, "refused")
  assert.deepStrictEqual(try listed(second.adapter), {
    open: [["p4", "Offered", "Enrolled"]],
    settled: [["p1", "Receipted", "Revoked"], ["p2", "Declined", "Revoked"], ["p3", "Retired", "Revoked"], ["p-without-result", "Receipted", "Revoked"]],
  })
  try closed(second.adapter)
})

it.live(`A failed enrollment replacement keeps my previous key and requests, and a successful replacement refuses revocation by the previous key (spec/agent/deviceActions/index.md, "A device enrolls under its own key as the agent's installation"; spec/agent/deviceActions/index.md, "A revoked enrollment retires every open offer, and nothing offered under it is served again")`, effect () => {
  const directory = try scratch("atomic-enrollment")
  const { adapter } = try open(directory.file("state"), false)
  const old = try changeEnrollment(adapter, register, owner)
  try offerRequest(adapter, offerOf("p1", try Clock.currentTimeMillis), owner, terms)
  const replace = { ...register, type: "replaceEnrollment" as const, keyHash: "key-hash-2" }
  try host("refuse the retirement write", () => refuseRequestRetirement(adapter, true))
  const failed = try exit(changeEnrollment(adapter, replace, owner))
  assert.isTrue(Exit.isFailure(failed))
  assert.deepStrictEqual((try enrollment(adapter)).enrollment, old.enrollment)
  assert.deepStrictEqual(try listed(adapter), { open: [["p1", "Offered", "Enrolled"]], settled: [] })

  try host("allow the retirement write", () => refuseRequestRetirement(adapter, false))
  const current = try changeEnrollment(adapter, replace, owner)
  const stale = try failure(changeEnrollment(adapter, { type: "revokeEnrolledKey", keyHash: "key-hash-1" }, owner))
  assert.strictEqual(stale?._tag, "EnrollmentKeyChanged")
  assert.deepStrictEqual((try enrollment(adapter)).enrollment, current.enrollment)
  assert.deepStrictEqual(try listed(adapter), { open: [], settled: [["p1", "Retired", "Revoked"]] })
  try closed(adapter)
})

it.effect('The view profile changes only against the revision the device read (spec/agent/deviceActions/capabilities.md, "The enabled-view profile changes only against the revision the device read")', effect () => {
  const state = try scratch("device-store-profile")
  const { adapter } = try open(state.file("memory"), false)
  assert.deepStrictEqual(try viewProfile(adapter), { tag: "NoProfile" })
  const made = try changeViewProfile(adapter, { tag: "NoRevisionRead" }, ["HomeView", "NotesView"])
  if (made.profile.tag !== "Profile") return try die(new Error("The first profile was not kept"))
  const read = { tag: "ReadAt" as const, revision: made.profile.revision }
  const stale = try changeViewProfile(adapter, { tag: "NoRevisionRead" }, ["HomeView"])
  const same = try changeViewProfile(adapter, read, ["NotesView", "HomeView"])
  const changed = try changeViewProfile(adapter, read, ["HomeView"])
  assert.deepStrictEqual([made.kind, stale.kind, stale.profile, same.kind, same.profile], ["set", "stale", made.profile, "set", made.profile])
  assert.strictEqual(changed.kind, "set")
  assert.notStrictEqual(changed.profile.tag === "Profile" ? changed.profile.revision : "", made.profile.revision)
  assert.deepStrictEqual(try viewProfile(adapter), changed.profile)
  try closed(adapter)
})

it.effect('A version 2 store gains the device request tables, and a closed store answers with a typed fault (spec/agent/storage/database.md, "Migrations run in number order, one transaction each, and a destructive or newer schema is refused")', effect () => {
  const state = try scratch("device-store-migrate")
  const older = try open(state.file("state"), true, migrations.slice(0, 2))
  try closed(older.adapter)
  const beforeAuthority = try open(state.file("state"), true, migrations.slice(0, 3))
  const enrolled = try changeEnrollment(beforeAuthority.adapter, register, owner)
  const legacy = try apply(enrolled, offerOf("legacy-workflow", try Clock.currentTimeMillis), owner)
  try host("persist the prior workflow row", () => seedLegacyWorkflow(beforeAuthority.adapter, legacy, workflowTerms))
  try closed(beforeAuthority.adapter)
  const upgraded = try open(state.file("state"), true)
  assert.deepStrictEqual((try listRequests(upgraded.adapter, "open")).map(({ proposalId }) => proposalId), ["legacy-workflow"])
  assert.deepStrictEqual((try openRequest(upgraded.adapter, "legacy-workflow"))?.terms, { ...workflowTerms, binding: "WorkflowBinding" })
  assert.deepStrictEqual(try viewProfile(upgraded.adapter), { tag: "NoProfile" })
  try closed(upgraded.adapter)
  const fault = try failure(enrollment(upgraded.adapter))
  assert.strictEqual(fault?._tag, "DeviceStoreUnavailable")
})
