// spec/agent/voice/session.md, "A report is posted at most twice, the second 1,500 ms after a lost or missing answer, and its outcomes stay distinct"; spec/agent/voice/session.md, "A turn is sent once, and a half-duplex turn only after the capture confirmed its close"
import { assert, it } from "@effect/vitest"
import { validateUuid } from "@elizaos/core"
import { voiceChannelType } from "../gen/agent__voice__session.effect.vibe"
import { voiceNetworkPorts, type JsonRequest } from "../src/voice/agent-ports.vibe"
import type { HeardReport } from "../src/voice/heard-reports.vibe"
import type { HeardAnswer } from "../src/voice/ports.vibe"
import { text } from "./support/cloud-fake.ts"
import { call, host, startInProcess } from "./support/kernel.vibe"

const conversationId = "c1"
const messageId = "6f1c1f3e-1d2b-4c55-9a0e-2f7f0c9d1a11"
const spoken: HeardReport = { reply: 1, conversationId, messageId, heardText: "  Call   Alex ", nothingHeard: false }

module node {
  import { Effect } from "effect"
  import { Machine, machine, spoken, type Event, type ReportOutcome } from "../gen/agent__voice__session.effect.vibe"
  import type { ClockPort, HeardAnswer, HeardPort } from "../src/voice/ports.vibe"
  import { createHeardReports, type HeardReport } from "../src/voice/heard-reports.vibe"

  export type Scripted = HeardAnswer | "lost"

  export function backedReports(heard: HeardPort, clock: ClockPort, report: HeardReport, onOutcome?: (outcome: ReportOutcome) => void) {
    const holder = Effect.runSync(Effect.provide(Machine, machine()))
    const read = () => Effect.runSync(holder.get())
    const send = (event: Event) => Effect.runSync(Effect.result(holder.send(event)))._tag === "Success"
    const events: Event[] = [
      { type: "start", mode: "ConversationMode", duplex: "FullDuplex" },
      { type: "captureOpened" }, { type: "speechStarted" }, { type: "speechEnded" },
      { type: "finalTranscript", heard: spoken }, { type: "longGapElapsed", epoch: 1 },
      { type: "sendTurn" }, { type: "replyStarted", segments: 2 },
    ]
    if (!report.nothingHeard && report.heardText.trim() !== "") events.push({ type: "segmentPlayed" })
    events.push({ type: "stop" })
    for (const event of events) {
      if (!send(event)) throw new Error(`The source model refused ${event.type} in the heard report journey`)
    }
    return createHeardReports({ clock, heard, machine: { read, send }, onOutcome: (_report, outcome) => onOutcome?.(outcome) })
  }

  async function flush() {
    for (let turn = 0; turn < 20; turn += 1) await Promise.resolve()
  }

  export async function walk(answers: Scripted[], report: HeardReport) {
    let now = 0
    const timers: Array<{ at: number; run: () => void }> = []
    const clock = { now: () => now, after: (ms: number, run: () => void) => { timers.push({ at: now + ms, run }) } }
    const advance = async (ms: number) => {
      const until = now + ms
      for (let due = timers.filter((timer) => timer.at <= until); due.length > 0; due = timers.filter((timer) => timer.at <= until)) {
        const next = due.reduce((first, timer) => (timer.at < first.at ? timer : first))
        timers.splice(timers.indexOf(next), 1)
        now = next.at
        next.run()
        await flush()
      }
      now = until
    }
    const posts: Array<{ at: number; path: string; body: unknown }> = []
    const outcomes: ReportOutcome[] = []
    const reports = backedReports(
      (conversation, message, body) => {
        posts.push({ at: now, path: `${conversation}/${message}`, body })
        const answer = answers.shift() ?? "lost"
        return answer === "lost" ? Promise.reject(new Error("lost")) : Promise.resolve(answer)
      },
      clock, report, (outcome) => { outcomes.push(outcome) },
    )
    const settled = reports.report(report)
    const repeated = reports.report({ ...report, heardText: "something else", nothingHeard: false })
    await flush()
    await advance(1_499)
    const beforeRetry = posts.length
    await advance(1)
    await advance(10_000)
    return {
      outcome: await settled, sameReceipt: repeated === settled, beforeRetry,
      posts: posts.map(({ at, body }) => ({ at, body })), outcomes,
      receipt: reports.receipt(report.reply),
    }
  }
}
import { backedReports, walk, type Scripted } from node
import type { ReportOutcome } from "../gen/agent__voice__session.effect.vibe"

const recorded: HeardAnswer = { status: 200, body: { ok: true, messageId, changed: true } }
const unchanged: HeardAnswer = { status: 200, body: { ok: true, messageId, changed: false } }
const status = (code: number): HeardAnswer => ({ status: code, body: { error: "x" } })
const body = { heardText: "  Call   Alex " }

const outcomeName = (outcome: ReportOutcome) => outcome.tag === "ReportAnswered" ? outcome.verdict : outcome.tag

it.effect('Report what of an interrupted reply I heard: one retry after 1,500 ms and distinct outcomes (spec/agent/voice/session.md, "A report is posted at most twice, the second 1,500 ms after a lost or missing answer, and its outcomes stay distinct")', () => effect {
  const cases: Array<[string, Scripted[], string, number]> = [
    ["recorded", [recorded], "HeardRecorded", 1],
    ["unchanged", [unchanged], "HeardUnchanged", 1],
    ["conflict", [status(409)], "HeardConflict", 1],
    ["rejected", [status(400)], "ReportRejected", 1],
    ["other reply", [{ status: 200, body: { ok: true, messageId: "another", changed: true } }], "ReportRejected", 1],
    ["missing twice", [status(404), status(404)], "HeardNotAgentReply", 2],
    ["busy twice", [status(503), status(429)], "ReportUnavailable", 2],
    ["lost then recorded", ["lost", recorded], "HeardRecorded", 2],
    ["missing then conflict", [status(404), status(409)], "HeardConflict", 2],
    ["busy then lost", [status(500), "lost"], "ReportUnavailable", 2],
  ]
  const walked = try forEach(cases, ([name, answers]) => host(name, () => walk([...answers], spoken)))
  const silent = try host("nothing heard", () => walk([recorded], { ...spoken, heardText: "", nothingHeard: true }))
  const blank = try host("blank heard text", () => walk([recorded], { ...spoken, heardText: "   " }))
  try Effect.try(() => {
    assert.deepStrictEqual(walked.map((run) => [outcomeName(run.outcome), run.posts.length, run.outcomes.map(outcomeName)]),
      cases.map(([, , outcome, posts]) => [outcome, posts, [outcome]]))
    for (const run of walked) {
      assert.isTrue(run.sameReceipt)
      assert.strictEqual(run.beforeRetry, 1)
      assert.deepStrictEqual(run.posts.map(({ at }) => at), run.posts.length === 2 ? [0, 1_500] : [0])
      assert.deepStrictEqual(run.posts.map((post) => post.body), run.posts.map(() => body))
      assert.deepStrictEqual(run.receipt, {
        reply: 1, phase: { tag: "ReportSettled", outcome: run.outcome }, attempts: run.posts.length, nothingHeard: false,
      })
    }
    assert.deepStrictEqual([silent.posts, blank.posts.map((post) => post.body)], [[{ at: 0, body: { nothingHeard: true } }], [{ nothingHeard: true }]])
    assert.deepStrictEqual([silent.receipt?.nothingHeard, blank.receipt?.nothingHeard], [true, true])
  })
})

schema Opened { conversation: { id: string; roomId: string } }

it.live('Report what of an interrupted reply I heard: a voice turn, its stop and its heard report reach the agent host (spec/agent/voice/session.md, "A turn is sent once, and a half-duplex turn only after the capture confirmed its close"; spec/agent/conversation/turns.md, "A message is refused, joined, replayed or admitted by its key, its room and the backend", "A heard report only moves the heard boundary of an agent reply back, and never changes the reply", "A Stop is confirmed only when its turn ends within five seconds, and is otherwise uncertain")', () => effect {
  const reachable = try startInProcess({ cloud: true, launch: { callerRole: "owner" } })
  const opened = try call(reachable, { method: "POST", path: "/api/conversations", body: {} })
  if (!("json" in opened)) return try die("The conversation was refused")
  const { conversation } = try Schema.decodeUnknownEffect(Opened)(opened.json)
  try Effect.sync(() => reachable.cloud?.script(text("Call  Alex.", " Or call Sam.")))
  const request: JsonRequest = (method, path, sent) => Effect.runPromise(call(reachable, { method, path, body: sent }))
    .then((answer) => ("status" in answer ? { status: answer.status, body: answer.json } : { status: 0, body: null }))
  const ports = try Effect.try(() => voiceNetworkPorts(conversation.id, request))
  const offered = {
    text: "Who should I call?", channelType: voiceChannelType, metadata: { voiceUi: { surface: "voice" } }, clientMessageId: "voice-turn-1",
  }
  const signal = new AbortController().signal
  const reply = try host("voice turn", () => ports.turns.send(offered, signal))
  const replay = try host("replay the voice turn", () => ports.turns.send(offered, signal))
  const changedOffer = try host("refuse a changed turn with the same key", () =>
    request("POST", `/api/conversations/${conversation.id}/messages`, { ...offered, text: "Who should I write?" }, signal))
  try host("stop the room", () => ports.turns.abort(conversation.roomId, "barge-in"))
  let now = 0
  const clock = { now: () => now, after: (ms: number, run: () => void) => { now += ms; run() } }
  const heard = { reply: 1, conversationId: conversation.id, messageId: reply.messageId, heardText: "Call  Alex.", nothingHeard: false }
  const first = try host("heard report", () => backedReports(ports.heard, clock, heard).report(heard))
  const again = try host("same heard report", () => backedReports(ports.heard, clock, heard).report(heard))
  const longer = try host("refuse re-extending the heard prefix", () =>
    ports.heard(conversation.id, reply.messageId, { heardText: reply.text }))
  const roomId = validateUuid(conversation.roomId)
  if (roomId === null) return try die("The conversation has no valid room id")
  const { runtime } = reachable.agent
  const [noticeId, legacyId] = try host("store a notice and an older reply", () => Promise.all([
    runtime.createMessageMemory({ roomId, entityId: runtime.agentId, content: { text: "The model is unavailable.", systemNotice: "model-unavailable", source: "device" } }),
    runtime.createMessageMemory({ roomId, entityId: runtime.agentId, content: { text: "An older reply.", actions: ["REPLY"], source: "device" } }),
  ]))
  const notice = try host("refuse a heard report on a system notice", () =>
    ports.heard(conversation.id, noticeId, { nothingHeard: true }))
  const legacy = try host("keep heard reports on older replies", () =>
    ports.heard(conversation.id, legacyId, { heardText: "An older" }))
  const history = try host("read the unmodified written reply", () =>
    request("GET", `/api/conversations/${conversation.id}/messages`, undefined, signal))
  const written = try Schema.decodeUnknownEffect(Schema.Struct({
    messages: Schema.Array(Schema.Struct({ id: Schema.String, text: Schema.String })),
  }))(history.body)
  try Effect.try(() => assert.deepStrictEqual(
    [reply.text, replay, changedOffer.status, outcomeName(first), outcomeName(again), longer.status, notice.status, legacy.status,
      written.messages.find(({ id }) => id === reply.messageId)?.text],
    ["Call  Alex. Or call Sam.", reply, 409, "HeardRecorded", "HeardUnchanged", 409, 404, 200, reply.text]))
  const cloud = reachable.cloud
  if (cloud === undefined) return try die("The Cloud fixture is missing")
  try Effect.sync(() => cloud.script({ kind: "hang" }))
  const started = try Effect.sync(() => cloud.nextCompletion())
  const held = try Effect.sync(() => request(
    "POST", `/api/conversations/${conversation.id}/messages`,
    { ...offered, text: "Keep thinking.", clientMessageId: "voice-turn-stop" }, signal))
  const inference = try host("model call started", () => started)
  const stopPath = `/api/turns/${conversation.roomId}/abort`
  const stopped = try host("confirm the active turn ended", () => request("POST", stopPath, { reason: "barge-in" }, signal))
  try host("inference stopped", () => inference.aborted)
  try host("the original response settled", () => held)
  const idle = try host("inspect the room after the stop", () => request("POST", stopPath, { reason: "stop" }, signal))
  try Effect.try(() => assert.deepStrictEqual([stopped, idle], [
    { status: 200, body: { aborted: true, roomId: conversation.roomId, reason: "barge-in", outcome: "stopped" } },
    { status: 200, body: { aborted: false, roomId: conversation.roomId, reason: "stop", outcome: "nothingRunning" } },
  ]))
}, 180_000)
