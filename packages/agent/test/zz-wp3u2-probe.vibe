// spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call"
import { FetchHttpClient } from "effect/http"
import { Refused } from "../src/models/chat.vibe"
import { probeOwnKey, type OwnKeyModels } from "../src/models/own-key-provider.vibe"

effect function probe(own: OwnKeyModels, key: string) {
  return effect {
    return try probeOwnKey(own, Redacted.make(key))
  } catch (error) => match (error) {
    when Refused: error.cloud.tag;
  }
}

export function probeOwnKeyModels(own: OwnKeyModels, key: string): Promise<readonly string[] | string> {
  return runPromise(Effect.provide(probe(own, key), FetchHttpClient.layer) as Effect.Effect<readonly string[] | string>)
}
