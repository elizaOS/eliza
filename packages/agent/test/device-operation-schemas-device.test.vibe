// spec/agent/deviceActions/operations.md, "Story: Propose only operations the device can check"; spec/agent/deviceActions/operations.md, "A Photos operation names no more items than its review takes"; spec/agent/deviceActions/operations.md, "Story: Learn exactly what the device did"; spec/agent/deviceActions/capabilities.md, "A newer operation cannot use an older capability version"
import { assert, it } from "@effect/vitest"
import { negotiation } from "../src/device-actions/capabilities.vibe"
import { deviceOperations } from "../src/device-actions/operation-schemas/device.schema.vibe"
import { mayRunDirectly, readOperation, receiptOutcome, validate, type CheckedOperation } from "../src/device-actions/operations.schema.vibe"
module node {
  import { createHash } from "node:crypto"
  export function digestOf(value: unknown): string {
    return createHash("sha256").update(JSON.stringify(value)).digest("hex")
  }
}
import { digestOf } from node

const digest = "a".repeat(64)
const noteRevision = digestOf(["List", "Milk"])
const photo = "lib:i:42:0"
const range = { type: "read_calendar_range", calendarIds: ["cal-1"], start: "2026-11-21T00:00:00.000Z", end: "2026-11-22T00:00:00.000Z", timeZone: "UTC", maximumEvents: 10 }
const sms = { type: "sms_send", recipients: ["+15550100"], body: "On my way", subscriptionId: 1 }

const samples: Record<string, unknown> = {
  CameraCapturePhoto: { type: "camera_capture_photo" },
  FilesFilter: { type: "files_filter", text: " lease ", kind: "pdf", folder: "Download" },
  FilesOpen: { type: "files_open", shown: 1 },
  FilesShare: { type: "files_share", paths: ["Download/lease.pdf"] },
  FilesMove: { type: "files_move", paths: ["Download/lease.pdf"], dest: "" },
  FilesTrash: { type: "files_trash", paths: ["Download/old.pdf"] },
  FilesFolderCreate: { type: "files_folder_create", parent: "", name: "Taxes" },
  PhotoLibrarySearch: { type: "photo_library_search", kind: "image", from: 0, to: 10, limit: 5 },
  PhotoLibraryInspect: { type: "photo_library_inspect", id: photo },
  PhotoLibrarySelect: { type: "photo_library_select", ids: [photo] },
  PhotoLibraryReview: { type: "photo_library_review", action: "trash", items: [{ id: photo, revision: "rev-abc-1" }] },
  PhotosFilter: { type: "photos_filter", album: "favorites" },
  PhotosOpen: { type: "photos_open", id: photo },
  PhotosAlbumCreate: { type: "photos_album_create", name: "Trip", ids: [photo] },
  PhotosShare: { type: "photos_share", ids: [photo] },
  SmsSend: sms,
  MmsSend: { type: "mms_send", recipients: ["+15550100"], body: "", attachments: [{ contentType: "image/jpeg", name: "a.jpg", sha256: digest, size: 10 }], subscriptionId: 1 },
  PhoneDial: { type: "phone_dial", target: { kind: "number", number: "+15550100" } },
  PhoneCall: { type: "phone_call", target: { kind: "contact", query: "Sam" } },
  ContactCreate: { type: "contact_create", contact: { displayName: "Sam", phoneNumbers: ["+15550100"], emailAddresses: [] } },
  ContactUpdate: { type: "contact_update", query: "Sam", set: { emailAddresses: ["sam@example.com"] } },
  ContactDelete: { type: "contact_delete", query: "Sam" },
  SmsCompose: { type: "sms_compose", query: "Sam", body: "Running late" },
  SmsReplySelected: { type: "sms_reply_selected", body: "Sounds good" },
  MessagesReadSelected: { type: "messages_read_selected" },
  VoicemailReadSelected: { type: "voicemail_read_selected" },
  VoicemailDeleteSelected: { type: "voicemail_delete_selected" },
  SmsLatestSender: { type: "sms_latest_sender" },
  SmsDraft: { type: "sms_compose", target: { kind: "number", number: "+15550100" }, body: "Running late", draft: true },
  PhoneKeypad: { type: "phone_keypad", number: "+15550100" },
  ContactShow: { type: "contact_show", query: "Sam" },
  ContactReadSelected: { type: "contact_read_selected" },
  ReadSelectedNotes: { type: "read_selected_notes", notes: [{ id: "note-1", revision: noteRevision }] },
  ReadCalendarRange: range,
  ReadSelectedReminders: { type: "read_selected_reminders", window: "open_and_completed_today", day: "2026-11-21", timeZone: "UTC", maximumItems: 20 },
  PostNotification: { type: "post_notification", title: "Today", body: "Two meetings" },
  SpeakText: { type: "speak_text", text: "Two meetings" },
  CreateNote: { type: "create_note", title: "Groceries", body: "" },
  CreateReminder: { type: "create_reminder", title: "Call Sam", dueAt: "2026-11-22T09:00:00Z" },
  OpenView: { type: "open_view", view: "photos" },
  BrowserNavigate: { type: "browser_navigate", url: "example.com/menu" },
  BrowserSearch: { type: "browser_search", query: " weather  in Paris " },
  BrowserTabNew: { type: "browser_tab_new", private: false },
  BrowserTabSwitch: { type: "browser_tab_switch", target: "news" },
  BrowserTabClose: { type: "browser_tab_close", all: true },
  BrowserTabsShow: { type: "browser_tabs_show" },
  BrowserFind: { type: "browser_find", text: "opening hours" },
  BrowserHistory: { type: "browser_history", action: "back" },
}

function checked(input: unknown): CheckedOperation {
  const found = readOperation(input)
  assert.isDefined(found)
  return found as CheckedOperation
}

const outcome = (op: unknown, receipt: unknown, claimKey = "claim-1") => {
  const verdict = receiptOutcome(checked(op), receipt, claimKey)
  return verdict.kind === "refused" ? "refused" : verdict.reported
}

it("Propose only operations the device can check: every media, files, telephony, workflow and base wire type reads as its own operation", () => {
  for (const [opType, input] of Object.entries(samples)) assert.strictEqual(checked(input).opType, opType, opType)
  assert.strictEqual((checked(samples.BrowserNavigate).operation as { url: string }).url, "https://example.com/menu")
  assert.deepStrictEqual(checked({ type: "browser_navigate", url: "http://example.com/menu" }).operation, { type: "browser_navigate", url: "https://example.com/menu" })
  assert.deepStrictEqual(checked({ type: "browser_navigate", url: "example.com/menu", newTab: false }).operation,
    { type: "browser_navigate", url: "https://example.com/menu" })
  const encodeBrowser = Schema.encodeUnknownOption(deviceOperations.browser_navigate.operation)
  const browser = { type: "browser_navigate", url: "https://example.com/menu", newTab: true } as const
  assert.deepStrictEqual(Option.getOrUndefined(encodeBrowser(browser)), browser)
  assert.isTrue(Option.isNone(encodeBrowser({ ...browser, url: "http://example.com/menu" })))
  assert.deepStrictEqual(checked({ type: "files_open", path: "Download/" }).operation, { type: "files_open", path: "Download" })
  assert.strictEqual((checked(samples.FilesFilter).operation as { text: string }).text, "lease")
  assert.deepStrictEqual(checked(samples.BrowserSearch).operation, { type: "browser_search", query: "weather in Paris" })
  assert.deepStrictEqual(checked(samples.BrowserTabNew).operation, { type: "browser_tab_new" })
  assert.isUndefined(readOperation({ type: "browser_tab_close", target: "news", all: true }))
  const shownShare = { type: "files_share", shown: [1, 2] }
  assert.isTrue(checked(shownShare).versionTwo)
  assert.isFalse(checked(samples.FilesShare).versionTwo)
  assert.isUndefined(validate(shownShare, negotiation(true, "files.browser.v1"), "NoBinding"))
  assert.isDefined(validate(shownShare, negotiation(true, "files.browser.v1,files.shown-target.v1"), "NoBinding"))
  assert.isUndefined(validate({ type: "browser_tab_close", all: true }, negotiation(true, "browser.tabs.v1"), "NoBinding"))
  assert.isDefined(validate({ type: "browser_tab_close", all: true }, negotiation(true, "browser.tabs.v1,browser.tabs.close-all.v1"), "NoBinding"))
  assert.isUndefined(validate({ type: "browser_navigate", url: "example.com", newTab: true }, negotiation(true, "files.browser.v1"), "NoBinding"))
  assert.isDefined(validate({ type: "browser_navigate", url: "example.com", newTab: true }, negotiation(true, "browser.open-new-tab.v1"), "NoBinding"))
})

it("Propose only operations the device can check: a proposal with a stray key or a field outside its bounds is refused", () => {
  const refused = [
    { ...sms, extra: true },
    { ...sms, recipients: ["+1555010", "+1555011", "+1555012", "+1555013", "+1555014", "+1555015"] },
    { ...sms, recipients: ["+15550100", "+15550100"] },
    { type: "files_open", path: "/etc/passwd" },
    { type: "files_open", path: "Download/../secret" },
    { type: "files_filter" },
    { type: "files_move", paths: ["a.pdf"], dest: "", reviewed: [] },
    { type: "photos_open", id: "m:external:i:1" },
    { type: "photo_library_select", ids: [photo, photo] },
    { type: "phone_dial", target: { kind: "contact", query: "Sam", number: "+15550100" } },
    { type: "contact_update", query: "Sam", set: {} },
    { type: "sms_reply_selected", body: "   " },
    { type: "browser_navigate", url: "ftp://example.com" },
    { type: "browser_navigate", url: "https://user:pw@example.com" },
    { type: "browser_tabs_show", target: "bbc" },
    { type: "browser_tabs_show", all: true },
    { type: "open_view", view: "terminal" },
    { type: "create_reminder", title: "Call", dueAt: "2026-11-22 09:00" },
    { ...range, end: "2026-11-30T00:00:00.000Z" },
    { type: "read_selected_reminders", window: "all", day: "2026-11-21", timeZone: "UTC", maximumItems: 20 },
    { type: "mms_send", recipients: ["+15550100"], body: "", attachments: [], subscriptionId: 1 },
  ]
  for (const input of refused) assert.isUndefined(readOperation(input), JSON.stringify(input))
})

it('A Photos operation names no more items than its review takes (spec/agent/deviceActions/operations.md, "A Photos operation names no more items than its review takes")', () => {
  const ids = (count: number) => Array.from({ length: count }, (_, index) => `lib:i:${index + 1}:0`)
  const items = (count: number) => ids(count).map((id) => ({ id, revision: "rev-abc-1" }))
  const bounded: ReadonlyArray<readonly [unknown, unknown]> = [
    [{ type: "photo_library_search", limit: 50 }, { type: "photo_library_search", limit: 51 }],
    [{ type: "photo_library_select", ids: ids(20) }, { type: "photo_library_select", ids: ids(21) }],
    [{ type: "photo_library_review", action: "share", items: items(20) }, { type: "photo_library_review", action: "share", items: items(21) }],
    [{ type: "photos_share", ids: ids(100) }, { type: "photos_share", ids: ids(101) }],
    [{ type: "photos_album_create", name: "Trip", ids: ids(200) }, { type: "photos_album_create", name: "Trip", ids: ids(201) }],
    [{ type: "photos_album_create", name: ` ${"a".repeat(80)} `, ids: ids(1) }, { type: "photos_album_create", name: "a".repeat(81), ids: ids(1) }],
    [{ type: "photos_filter", text: "b".repeat(80) }, { type: "photos_filter", text: "b".repeat(81) }],
  ]
  for (const [within, beyond] of bounded) {
    assert.isDefined(readOperation(within), JSON.stringify(within).slice(0, 120))
    assert.isUndefined(readOperation(beyond), JSON.stringify(beyond).slice(0, 120))
  }
  assert.isUndefined(readOperation({ type: "photos_album_create", name: "   ", ids: ids(1) }))
  assert.isUndefined(readOperation({ type: "photos_filter", text: "trip\u0007" }))
})

it("Propose only operations the device can check: each operation needs its own capability and a workflow read needs its binding", () => {
  assert.isDefined(validate(sms, negotiation(true, "sms.send.v1"), "NoBinding"))
  assert.isUndefined(validate(sms, negotiation(true, "sms.compose.v1"), "NoBinding"))
  assert.isUndefined(validate(samples.PhotosOpen, negotiation(true, "photos.library.v1"), "NoBinding"))
  assert.isDefined(validate(samples.PhotosOpen, negotiation(true, "photos.library.v1,photos.view.v1"), "NoBinding"))
  assert.isUndefined(validate(samples.CreateNote, negotiation(true, "clock.handoff.v1"), "NoBinding"))
  assert.isDefined(validate(samples.CreateNote, negotiation(true, "files.browser.v1"), "NoBinding"))
  assert.isUndefined(validate(range, negotiation(true, "files.browser.v1"), "NoBinding"))
  assert.isDefined(validate(range, negotiation(true, "files.browser.v1"), "WorkflowBinding"))
  assert.isUndefined(validate(range, negotiation(true, "files.browser.v1"), "AgendaBinding"))
  assert.isDefined(validate(range, negotiation(true, "calendar.agenda-read.v1"), "AgendaBinding"))
  assert.isUndefined(validate(samples.SpeakText, negotiation(true, "calendar.agenda-read.v1"), "AgendaBinding"))
  const whole = { type: "sms_latest_sender", includeAddress: true }
  assert.isDefined(validate(samples.SmsLatestSender, negotiation(true, "sms.latest-sender.v1"), "NoBinding"))
  assert.isDefined(validate(samples.SmsLatestSender, negotiation(true, "sms.latest-sender.v2"), "NoBinding"))
  assert.isUndefined(validate(whole, negotiation(true, "sms.latest-sender.v1"), "NoBinding"))
  assert.strictEqual(validate(whole, negotiation(true, "sms.latest-sender.v2"), "NoBinding")?.versionTwo, true)
  assert.strictEqual(readOperation({ type: "sms_latest_sender", includeAddress: false }), undefined)
  assert.isTrue(mayRunDirectly(checked(whole), "NoBinding", true))
  const newTab = { type: "browser_navigate", url: "example.com/menu", newTab: true }
  assert.isDefined(validate(samples.BrowserNavigate, negotiation(true, "files.browser.v1"), "NoBinding"))
  assert.isUndefined(validate(newTab, negotiation(true, "files.browser.v1"), "NoBinding"))
  assert.isDefined(validate(newTab, negotiation(true, "browser.open-new-tab.v1"), "NoBinding"))
  assert.isUndefined(validate(samples.BrowserTabsShow, negotiation(true, "browser.tabs.v1"), "NoBinding"))
  assert.isDefined(validate(samples.BrowserTabsShow, negotiation(true, "browser.tabs.show.v1"), "NoBinding"))
  assert.isUndefined(validate(samples.BrowserTabSwitch, negotiation(true, "browser.tabs.show.v1"), "NoBinding"))
})

it("Propose only operations the device can check: a targeted text, a draft in the sender's thread, a contact change by value and a dial to a contact need their newer capability, and a draft never reports a send", () => {
  const draft = samples.SmsDraft
  const threaded = { type: "sms_compose", target: { kind: "number", number: "+15550100" }, body: "On my way", draft: true, replyThreadId: "thread:42" }
  const targeted = { type: "sms_compose", target: { kind: "contact", query: "Sam" }, body: "On my way" }
  const byValue = { type: "contact_update", query: "Sam", add: { phoneNumbers: ["+15550100"] }, remove: { emailAddresses: ["sam@example.com"] } }
  const toContact = { type: "phone_dial", target: { kind: "contact", query: "Sam" } }
  const compose = "sms.compose.v1,sms.compose.v2"
  assert.isUndefined(validate(targeted, negotiation(true, "sms.compose.v1"), "NoBinding"))
  assert.strictEqual(validate(targeted, negotiation(true, compose), "NoBinding")?.opType, "SmsCompose")
  assert.isUndefined(validate(threaded, negotiation(true, compose), "NoBinding"))
  assert.strictEqual(validate(threaded, negotiation(true, `${compose},sms.latest-sender.v2`), "NoBinding")?.opType, "SmsDraft")
  assert.isUndefined(validate(byValue, negotiation(true, "contacts.write.v1"), "NoBinding"))
  assert.isDefined(validate(byValue, negotiation(true, "contacts.write.v1,contacts.write.v2"), "NoBinding"))
  assert.isUndefined(validate(toContact, negotiation(true, "phone.dial.v1"), "NoBinding"))
  assert.isDefined(validate(toContact, negotiation(true, "phone.dial.v1,contacts.lookup.v1"), "NoBinding"))
  for (const input of [
    { type: "sms_compose", target: { kind: "number", number: "+15550100" }, body: "On my way", replyThreadId: "thread:42" },
    { type: "sms_compose", target: { kind: "contact", query: "Sam" }, body: "On my way", draft: true, replyThreadId: "thread:42" },
    { type: "sms_compose", query: "Sam", body: "On my way", draft: true },
    { type: "contact_update", query: "Sam", set: { phoneNumbers: ["+15550100"] }, add: { phoneNumbers: ["+15550101"] } },
    { type: "contact_update", query: "Sam", add: { phoneNumbers: ["+15550100"] }, remove: { phoneNumbers: ["+15550100"] } },
    { type: "contact_update", query: "Sam", add: { phoneNumbers: [] } },
    { type: "contact_update", query: "Sam" },
    { type: "phone_keypad", number: "415-555-0100" },
  ]) assert.isUndefined(readOperation(input), JSON.stringify(input))
  assert.isTrue(mayRunDirectly(checked(draft), "NoBinding", true))
  assert.isTrue(mayRunDirectly(checked(samples.PhoneKeypad), "NoBinding", true))
  assert.isFalse(mayRunDirectly(checked(targeted), "NoBinding", true))
  assert.strictEqual(outcome(draft, { outcome: "applied", operationId: "claim-1", result: { kind: "sms-compose", status: "drafted" } }), "ReportedApplied")
  assert.strictEqual(outcome(draft, { outcome: "applied", operationId: "claim-1", result: { kind: "sms-compose", status: "sent" } }), "refused")
  assert.strictEqual(outcome(draft, { outcome: "failed", operationId: "claim-1", result: { kind: "sms-compose", status: "not-found" } }), "refused")
  assert.strictEqual(outcome(draft, { outcome: "failed", operationId: "claim-1", result: { kind: "sms-compose", status: "cancelled" } }), "ReportedNothingRan")
  assert.strictEqual(outcome(samples.PhoneKeypad, { outcome: "applied", operationId: "n1", result: { kind: "phone-keypad", status: "opened" } }), "ReportedApplied")
  assert.strictEqual(outcome(samples.ContactShow, { outcome: "failed", operationId: "n1", result: { kind: "contact-show", status: "not-found" } }), "ReportedUnknown")
  const shared = { kind: "contact-read", status: "read", contact: { displayName: null, phoneNumbers: ["(415) 555-0100"], emailAddresses: [] } }
  assert.strictEqual(outcome(samples.ContactReadSelected, { outcome: "applied", operationId: "n1", result: shared }), "ReportedApplied")
  assert.strictEqual(outcome(samples.ContactReadSelected, { outcome: "applied", operationId: "n1", result: { kind: "contact-read", status: "none-selected" } }), "refused")
})

it("Propose only operations the device can check: a keypad, a contact search or read, a single-value contact change, a text to an exact number and a Phone, Messages or Contacts view each need their own capability, a keypad never reports a call and a contact search names nobody", () => {
  const empty = { type: "phone_keypad" }
  const filled = { type: "phone_keypad", number: "+15550100" }
  const values = { type: "contact_update", query: "Maya", add: { phoneNumbers: ["+15550101"] }, remove: { emailAddresses: ["old@example.com"] } }
  const toNumber = { type: "sms_compose", target: { kind: "number", number: "+15550100" }, body: "Running late" }
  const draft = { ...toNumber, draft: true }
  const accepted = (input: unknown, capabilities: string) => validate(input, negotiation(true, capabilities), "NoBinding") !== undefined
  assert.deepStrictEqual(
    [accepted(empty, "phone.keypad.v1"), accepted(filled, "phone.keypad.v1"), accepted(empty, "phone.dial.v1,phone.call.v1"),
      accepted(samples.ContactShow, "contacts.show.v1"), accepted(samples.ContactShow, "contacts.write.v1"),
      accepted(samples.ContactReadSelected, "contacts.read.v1"), accepted(samples.ContactReadSelected, "contacts.show.v1"),
      accepted(values, "contacts.write.v1,contacts.write.v2"), accepted(values, "contacts.write.v1"), accepted(samples.ContactUpdate, "contacts.write.v1"),
      accepted(draft, "sms.compose.v1,sms.compose.v2"), accepted(toNumber, "sms.compose.v1"), accepted(samples.SmsCompose, "sms.compose.v1"),
      accepted({ type: "open_view", view: "contacts" }, "views.telephony.v1"), accepted({ type: "open_view", view: "contacts" }, "files.browser.v1")],
    [true, true, false, true, false, true, false, true, false, true, true, false, true, true, false])
  for (const input of [
    { type: "phone_keypad", number: "call 911" }, { type: "phone_keypad", number: "+15550100", dial: true },
    { type: "contact_update", query: "Maya" }, { type: "contact_update", query: "Maya", add: { phoneNumbers: [] } },
    { type: "contact_update", query: "Maya", set: { phoneNumbers: ["+15550100"] }, add: { phoneNumbers: ["+15550101"] } },
    { type: "contact_update", query: "Maya", add: { phoneNumbers: ["+15550101"] }, remove: { phoneNumbers: ["+15550101"] } },
    { type: "contact_show" }, { type: "contact_read_selected", query: "Maya" }, { ...toNumber, query: "Maya" },
  ]) assert.isUndefined(readOperation(input), JSON.stringify(input))
  assert.deepStrictEqual(
    [mayRunDirectly(checked(empty), "NoBinding", true), mayRunDirectly(checked(filled), "NoBinding", true),
      mayRunDirectly(checked(samples.ContactShow), "NoBinding", true), mayRunDirectly(checked(samples.ContactReadSelected), "NoBinding", true)],
    [true, true, false, false])
  const composed = (status: string) => ({ outcome: status === "drafted" || status === "sent" ? "applied" : status === "unknown" ? "unknown" : "failed", operationId: "claim-1", result: { kind: "sms-compose", status } })
  assert.deepStrictEqual(
    [outcome(draft, composed("drafted")), outcome(draft, composed("sent")), outcome(draft, composed("unknown")), outcome(toNumber, composed("sent")),
      outcome(toNumber, composed("not-found")), outcome(samples.SmsCompose, composed("not-found"))],
    ["ReportedApplied", "refused", "refused", "ReportedApplied", "refused", "ReportedNothingRan"])
  const shared = { displayName: "Maya", phoneNumbers: ["(555) 010-0101"], emailAddresses: [] }
  assert.deepStrictEqual(
    [outcome(filled, { outcome: "applied", operationId: "n1", result: { kind: "phone-keypad", status: "opened" } }),
      outcome(filled, { outcome: "applied", operationId: "n1", result: { kind: "phone-call", status: "placed", contact: false } }),
      outcome(samples.ContactShow, { outcome: "applied", operationId: "n1", result: { kind: "contact-show", status: "shown" } }),
      outcome(samples.ContactShow, { outcome: "applied", operationId: "n1", result: { kind: "contact-show", status: "shown", names: ["Maya"] } }),
      outcome(samples.ContactReadSelected, { outcome: "applied", operationId: "n1", result: { kind: "contact-read", status: "read", contact: shared } }),
      outcome(samples.ContactReadSelected, { outcome: "failed", operationId: "n1", result: { kind: "contact-read", status: "none-selected" } }),
      outcome(values, { outcome: "applied", operationId: "n1", result: { kind: "contact-write", status: "saved" } })],
    ["ReportedApplied", "refused", "ReportedApplied", "refused", "ReportedApplied", "ReportedUnknown", "ReportedApplied"])
})

it("Propose only operations the device can check: an album or share names the open photo only under photos.view-selected.v1, and a capture's library ID and lens each need their capability", () => {
  const view = "photos.library.v1,photos.view.v1"
  const openShare = { type: "photos_share", selected: true }
  const openAlbum = { type: "photos_album_create", name: "Trip", ids: [], selected: true }
  assert.isUndefined(validate(openShare, negotiation(true, view), "NoBinding"))
  assert.strictEqual(validate(openShare, negotiation(true, `${view},photos.view-selected.v1`), "NoBinding")?.versionTwo, true)
  assert.isDefined(validate(openAlbum, negotiation(true, `${view},photos.view-selected.v1`), "NoBinding"))
  assert.isDefined(validate(samples.PhotosShare, negotiation(true, view), "NoBinding"))
  assert.strictEqual(readOperation({ type: "photos_share", ids: [photo], selected: true }), undefined)
  const review = { outcome: "applied", operationId: "n1", result: { kind: "photos_share", status: "review_opened", count: 1, missing: 0 } }
  assert.strictEqual(outcome(openShare, review), "ReportedApplied")
  assert.strictEqual(outcome(openShare, { ...review, result: { ...review.result, count: 2 } }), "refused")
  const saved = { version: 1, kind: "camera_capture_photo", operationId: "n1", mediaId: "17", libraryId: "lib:i:17:0", width: 640, height: 480, mime: "image/jpeg" }
  const capture = (capabilities: string) => validate(samples.CameraCapturePhoto, negotiation(true, capabilities), "NoBinding") as CheckedOperation
  const settled = (capabilities: string, result: object) => {
    const verdict = receiptOutcome(capture(capabilities), { outcome: "applied", operationId: "n1", result }, "claim-1")
    return verdict.kind === "refused" ? "refused" : verdict.reported
  }
  assert.strictEqual(settled("camera.capture-photo.v1", saved), "refused")
  assert.strictEqual(settled("camera.capture-photo.v1,camera.capture-library-id.v1", saved), "ReportedApplied")
  const { libraryId: _left, ...withoutId } = saved
  assert.strictEqual(settled("camera.capture-photo.v1", withoutId), "ReportedApplied")
  const front = { type: "camera_capture_photo", lens: "front" }
  assert.isUndefined(validate(front, negotiation(true, "camera.capture-photo.v1"), "NoBinding"))
  assert.isUndefined(validate(front, negotiation(true, "camera.capture-lens.v1"), "NoBinding"))
  assert.strictEqual(validate(front, negotiation(true, "camera.capture-photo.v1,camera.capture-lens.v1"), "NoBinding")?.versionTwo, false)
  assert.strictEqual(validate({ type: "camera_capture_photo", lens: "back" }, negotiation(true, "camera.capture-photo.v1,camera.capture-lens.v1,camera.capture-library-id.v1"), "NoBinding")?.versionTwo, true)
  assert.strictEqual(readOperation({ type: "camera_capture_photo", lens: "wide" }), undefined)
})

it("Propose only operations the device can check: only a reversible local operation bound to the owner's message runs directly", () => {
  assert.isTrue(mayRunDirectly(checked(samples.FilesOpen), "NoBinding", true))
  assert.isTrue(mayRunDirectly(checked(samples.SmsReplySelected), "NoBinding", true))
  assert.isFalse(mayRunDirectly(checked(samples.FilesOpen), "NoBinding", false))
  assert.isTrue(mayRunDirectly(checked(samples.BrowserHistory), "NoBinding", true))
  assert.isTrue(mayRunDirectly(checked(samples.BrowserTabsShow), "NoBinding", true))
  assert.isFalse(mayRunDirectly(checked(samples.BrowserTabsShow), "NoBinding", false))
  for (const type of ["SmsSend", "PhoneCall", "ContactDelete", "FilesShare", "PhotosShare", "PhotoLibraryReview", "VoicemailDeleteSelected", "BrowserTabClose"])
    assert.isFalse(mayRunDirectly(checked(samples[type]), "NoBinding", true), type)
})

it("Learn exactly what the device did: a SIM send settles only on evidence that names its claim", () => {
  const { body, recipients, subscriptionId, type } = sms
  const bindingHash = digestOf({ body, recipients, subscriptionId, type })
  const sent = { kind: "sms-send", operationId: "claim-1", subscriptionId, bindingHash, status: "sent", createdAt: 1,
    parts: [{ index: 0, recipientIndex: 0, partIndex: 0, sent: "success", delivery: "unknown" }] }
  assert.strictEqual(outcome(sms, { outcome: "applied", operationId: "claim-1", result: sent }), "ReportedApplied")
  assert.strictEqual(outcome(sms, { outcome: "applied", operationId: "other", result: sent }), "refused")
  assert.strictEqual(outcome(sms, { outcome: "applied", operationId: "claim-1", result: { ...sent, subscriptionId: 2 } }), "refused")
  assert.strictEqual(outcome(sms, { outcome: "applied", operationId: "claim-1", result: { ...sent, parts: [] } }), "refused")
  assert.strictEqual(outcome(sms, { outcome: "failed", operationId: "claim-1", result: { ...sent, status: "cancelled", parts: [] } }), "ReportedNothingRan")
  assert.strictEqual(outcome(sms, { outcome: "applied", operationId: "claim-1", result: { ...sent, status: "cancelled", parts: [] } }), "refused")
  assert.strictEqual(outcome(sms, { outcome: "unknown", operationId: "claim-1", result: { ...sent, status: "failed", parts: [] } }), "ReportedUnknown")
  assert.strictEqual(outcome(sms, { outcome: "unknown", operationId: "claim-1" }), "ReportedUnknown")
  assert.strictEqual(outcome(sms, { outcome: "failed", code: "DEVICE_NOT_DISPATCHED" }), "ReportedNothingRan")
  assert.strictEqual(outcome(sms, { outcome: "applied", operationId: "claim-1", result: { ...sent, bindingHash: digest } }), "refused")
})

it("Learn exactly what the device did: phone results are evidence, and only a draft or SIM refusal is trusted", () => {
  const dial = samples.PhoneDial
  assert.strictEqual(outcome(dial, { outcome: "applied", operationId: "n1", result: { kind: "phone-dial", status: "handed-off", handler: "Phone", contact: false } }), "ReportedApplied")
  assert.strictEqual(outcome(dial, { outcome: "failed", operationId: "n1", result: { kind: "phone-dial", status: "cancelled", handler: null, contact: false } }), "ReportedUnknown")
  assert.strictEqual(outcome(dial, { outcome: "failed", operationId: "n1", result: { kind: "phone-dial", status: "handed-off", handler: "Phone", contact: false } }), "refused")
  assert.strictEqual(outcome(dial, { outcome: "failed", operationId: "n1" }), "refused")
  assert.strictEqual(outcome(samples.SmsReplySelected, { outcome: "failed", operationId: "n1", result: { kind: "sms-reply", status: "none-selected" } }), "ReportedNothingRan")
  assert.strictEqual(outcome(samples.SmsCompose, { outcome: "failed", operationId: "claim-1", result: { kind: "sms-compose", status: "cancelled" } }), "ReportedNothingRan")
  assert.strictEqual(outcome(samples.ContactCreate, { outcome: "failed", operationId: "n1", result: { kind: "contact-write", status: "stale" } }), "refused")
  assert.strictEqual(outcome(samples.ContactDelete, { outcome: "applied", operationId: "n1", result: { kind: "contact-write", status: "deleted" } }), "ReportedApplied")
  const thread = { participant: "Sam", messages: [{ direction: "in", date: 1, body: "Dinner?" }], truncated: false }
  assert.strictEqual(outcome(samples.MessagesReadSelected, { outcome: "applied", operationId: "n1", result: { kind: "messages-read", status: "read", ...thread } }), "ReportedApplied")
  assert.strictEqual(outcome(samples.MessagesReadSelected, { outcome: "applied", operationId: "n1", result: { kind: "messages-read", status: "read", ...thread, messages: [{ ...thread.messages[0], direction: "received" }] } }), "refused")
  assert.strictEqual(outcome(samples.VoicemailReadSelected, { outcome: "applied", operationId: "n1",
    result: { kind: "voicemail-read", status: "read", caller: null, date: 1, durationSeconds: 3, transcriptState: "ready", engine: null, transcript: "Hi" } }), "refused")
  const suffix = samples.SmsLatestSender, whole = { type: "sms_latest_sender", includeAddress: true }
  const sender = (result: object) => ({ outcome: "applied", operationId: "n1", result: { kind: "sms-latest-sender", ...result } })
  assert.strictEqual(outcome(suffix, sender({ status: "found", numberEnding: "0100" })), "ReportedApplied")
  assert.strictEqual(outcome(suffix, sender({ status: "found", address: "+15550100" })), "refused")
  assert.strictEqual(outcome(whole, sender({ status: "found", address: "+15550100", threadId: "thread:42" })), "ReportedApplied")
  assert.strictEqual(outcome(whole, sender({ status: "found", numberEnding: "0100" })), "refused")
  assert.strictEqual(outcome(whole, sender({ status: "found", address: "+15550100", threadId: "42" })), "refused")
  assert.strictEqual(outcome(whole, sender({ status: "found", address: "Sam" })), "refused")
  assert.strictEqual(outcome(suffix, sender({ status: "empty" })), "ReportedApplied")
  assert.strictEqual(outcome(suffix, sender({ status: "found", numberEnding: "0100", body: "Dinner?" })), "refused")
  assert.strictEqual(outcome(suffix, { outcome: "applied", operationId: "n1" }), "refused")
})

it("Learn exactly what the device did: reads carry a result exactly when applied, and presentations and base operations never do", () => {
  const saved = { version: 1, kind: "camera_capture_photo", operationId: "n1", mediaId: "17", width: 640, height: 480, mime: "image/jpeg" }
  assert.strictEqual(outcome(samples.CameraCapturePhoto, { outcome: "applied", operationId: "n1", result: saved }), "ReportedApplied")
  assert.strictEqual(outcome(samples.CameraCapturePhoto, { outcome: "applied", operationId: "n1" }), "refused")
  assert.strictEqual(outcome(samples.FilesOpen, { outcome: "applied", operationId: "n1" }), "ReportedApplied")
  assert.strictEqual(outcome(samples.FilesOpen, { outcome: "applied", operationId: "n1", result: { shown: 1 } }), "refused")
  assert.strictEqual(outcome(samples.BrowserTabsShow, { outcome: "applied", operationId: "n1" }), "ReportedApplied")
  for (const result of [{ tabs: [{ title: "BBC News", url: "https://bbc.co.uk/news" }] }, { count: 3 }])
    assert.strictEqual(outcome(samples.BrowserTabsShow, { outcome: "applied", operationId: "n1", result }), "refused", JSON.stringify(result))
  assert.strictEqual(outcome(samples.SpeakText, { outcome: "applied", operationId: "n1" }), "ReportedApplied")
  assert.strictEqual(outcome(samples.PhotosShare, { outcome: "applied", operationId: "n1", result: { kind: "photos_share", status: "review_opened", count: 1, missing: 0 } }), "ReportedApplied")
  assert.strictEqual(outcome(samples.PhotosShare, { outcome: "applied", operationId: "n1", result: { kind: "photos_share", status: "review_opened", count: 2, missing: 0 } }), "refused")
  assert.strictEqual(outcome(samples.PhotoLibraryInspect, { outcome: "applied", operationId: "n1",
    result: { kind: "photo_library_inspect", item: { id: photo, revision: "rev-abc-1", kind: "image", takenAt: 1, width: 2, height: 3 } } }), "ReportedApplied")
  assert.strictEqual(outcome(samples.PhotoLibraryInspect, { outcome: "applied", operationId: "n1",
    result: { kind: "photo_library_inspect", item: { id: photo, revision: "rev-abc-1", kind: "video", takenAt: 1, width: 2, height: 3 } } }), "refused")
  const note = { kind: "notes", notes: [{ id: "note-1", revision: noteRevision, title: "List", text: "Milk" }] }
  assert.strictEqual(outcome(samples.ReadSelectedNotes, { outcome: "applied", operationId: "n1", result: note }), "ReportedApplied")
  assert.strictEqual(outcome(samples.ReadSelectedNotes, { outcome: "applied", operationId: "n1", result: { kind: "notes", notes: [{ ...note.notes[0], revision: "b".repeat(64) }] } }), "refused")
  const eventFields = { id: "ev-1", calendarId: "cal-1", title: "Dentist", start: "2026-11-21T09:00:00.000Z", end: "2026-11-21T10:00:00.000Z", allDay: false }
  const calendarEvent = (value: typeof eventFields) => ({ ...value, revision: digestOf([value.id, value.calendarId, value.title, value.start, value.end, value.allDay]) })
  const event = calendarEvent(eventFields)
  assert.strictEqual(outcome(range, { outcome: "applied", operationId: "n1", result: { kind: "calendar", events: [event] } }), "ReportedApplied")
  assert.strictEqual(outcome(range, { outcome: "applied", operationId: "n1", result: { kind: "calendar", events: [calendarEvent({ ...eventFields, start: "2026-11-23T09:00:00.000Z", end: "2026-11-23T10:00:00.000Z" })] } }), "refused")
  assert.strictEqual(outcome(range, { outcome: "applied", operationId: "n1", result: { kind: "calendar", events: [calendarEvent({ ...eventFields, calendarId: "cal-2" })] } }), "refused")
  const reminders = samples.ReadSelectedReminders
  const completed = { id: "r-1", title: "Pay rent", dueAt: "2026-11-20T09:00:00.000Z", status: "completed", completedAt: "2026-11-21T08:00:00.000Z" }
  const reminderRow = (value: typeof completed) => ({ ...value, revision: digestOf([value.id, value.title, value.dueAt, value.status, value.completedAt]) })
  const done = reminderRow(completed)
  assert.strictEqual(outcome(reminders, { outcome: "applied", operationId: "n1", result: { kind: "reminders", reminders: [done] } }), "ReportedApplied")
  assert.strictEqual(outcome(reminders, { outcome: "applied", operationId: "n1", result: { kind: "reminders", reminders: [reminderRow({ ...completed, completedAt: "2026-11-20T08:00:00.000Z" })] } }), "refused")
  assert.strictEqual(outcome(samples.CreateNote, { outcome: "failed", code: "DEVICE_NOT_DISPATCHED" }), "ReportedNothingRan")
})
