// spec/agent/conversation/turns.md, "Story: Send one message and get one reply even when the request repeats"; spec/agent/conversation/turnContext.md, "Story: Tell the agent what my screen shows, and nothing more"; spec/agent/conversation/planning.md, "Story: Ask the agent to do something and hear what happened"
import { assert, it } from "@effect/vitest"
import type { ActionResult, EffectReceipt, Memory, UUID } from "@elizaos/core"
import { held, insufficientCredits, rateLimited, text, toolCalls, type CloudFake } from "./support/cloud-fake.ts"
import type { AgentPlugin } from "../src/host/module.vibe"
import { basicActionsModuleName } from "../src/plugins/basic-actions.vibe"
import { builtinModuleFactories } from "../src/plugins/profile.vibe"
import { call, cloudFake, deviceKey, host, scratch, startInProcess, stream, type InProcess } from "./support/kernel.vibe"
import type { Scratch } from "./support/scratch.ts"
import type { LocalAnswer, Refusal } from "./support/socket-client.ts"

interface Reply {
  readonly text: string
  readonly agentName: string
  readonly messageId: string
  readonly userMessageId: string
  readonly actionResults: readonly { readonly action: string; readonly data: { readonly executionStatus?: string } }[]
  readonly failureKind?: string
  readonly planAction?: string
  readonly retryAfterMs?: number
  readonly action?: { readonly kind: string; readonly validatedCard: boolean; readonly verbatimAsked: boolean }
}

module node {
  import { ChannelType, conversationClientUserMemoryId, hashStableJson, type AgentRuntime, type Memory, type UUID } from "@elizaos/core"
  import type { CloudFake } from "./support/cloud-fake.ts"
  import { request, type LocalAnswer, type Refusal } from "./support/socket-client.ts"

  /** @throws {never} */
  export function completions(cloud: CloudFake): number {
    return cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).length
  }

  export async function overlapping(socket: string, token: string, cloud: CloudFake, id: string, release: () => void) {
    const ask = (body: object): Promise<LocalAnswer | Refusal> =>
      request(socket, { method: "POST", path: `/api/conversations/${id}/messages`, token, body })
    const started = cloud.nextCompletion()
    const owner = ask({ text: "Take your time.", clientMessageId: "m-2" })
    await started
    const joined = ask({ text: "Take your time.", clientMessageId: "m-2" })
    const busy = await ask({ text: "Are you there?" })
    const otherBody = await ask({ text: "Something else.", clientMessageId: "m-2" })
    release()
    return { owner: await owner, joined: await joined, busy, otherBody }
  }

  export async function cutTurn(runtime: AgentRuntime, roomId: UUID, world: UUID | undefined, user: UUID, body: { text: string; clientMessageId: string }) {
    const scope = JSON.stringify([runtime.agentId, user, roomId])
    const id = conversationClientUserMemoryId(scope, body.clientMessageId)
    const fingerprint = hashStableJson({ text: body.text, channelType: ChannelType.DM, metadata: undefined })
    const memory: Memory = {
      id, roomId, entityId: user, agentId: runtime.agentId, createdAt: Date.now(),
      ...(world === undefined ? {} : { worldId: world }),
      content: { text: body.text, source: "device", chatIdempotency: { version: 1, scope, clientMessageId: body.clientMessageId, fingerprint } },
    }
    await runtime.createMessageMemory(memory)
    return id
  }

  export async function seedHistory(runtime: AgentRuntime, asked: Memory, marker: string) {
    for (let index = 0; index < 64; index += 1) {
      await runtime.createMessageMemory({
        ...asked, id: `00000000-0000-4000-8000-${String(index + 1000).padStart(12, "0")}` as UUID,
        createdAt: (asked.createdAt ?? Date.now()) - 10_000 + index,
        content: { text: index === 0 ? marker : `Filler entry ${index}.`, source: "device" },
      })
    }
  }

  export async function roomMessages(runtime: AgentRuntime, roomId: UUID): Promise<Memory[]> {
    return runtime.getMemories({ tableName: "messages", roomId, count: 1000 })
  }
}
import { completions, cutTurn, overlapping, roomMessages, seedHistory } from node

const answerOf = (answer: LocalAnswer | Refusal) => "status" in answer ? { status: answer.status, body: answer.json } : { status: 0, body: answer.refused }

effect function cloudAgent(cloud: CloudFake, state?: Scratch) {
  return try startInProcess({
    launch: { backend: { kind: "cloud", origin: cloud.origin }, persistMemory: true }, frame: { credential: { version: 1, value: deviceKey } },
    ...(state === undefined ? {} : { state }),
  })
}

effect function conversation(agent: InProcess) {
  const answer = answerOf(try call(agent, { method: "POST", path: "/api/conversations", body: {} }))
  return (answer.body as { conversation: { id: string; roomId: UUID } }).conversation
}

effect function send(agent: InProcess, id: string, body: object, headers?: Readonly<Record<string, string>>) {
  return answerOf(try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`, body, ...(headers === undefined ? {} : { headers }) }))
}

const replyOf = (answer: { readonly body: unknown }) => answer.body as Reply

it.live('A repeat joins, replays or conflicts by its key, a busy room is 429, a failed turn keeps its kind and names its fix and live wait, and a restart replays or answers a cut turn once (spec/agent/conversation/turns.md, "A message is refused, joined, replayed or admitted by its key, its room and the backend"; spec/agent/conversation/turns.md, "A room runs one turn at a time, and only an admitted or recovered message changes anything"; spec/agent/conversation/turns.md, "Every turn ends once, storing its reply with its kind, or answering that no reply exists"; spec/agent/conversation/turns.md, "A failed reply names the owner\'s fix, and only a live rate limit carries its wait"; spec/agent/conversation/turns.md, "After a restart a repeat replays the stored reply, and a turn the restart cut is never run again")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const state = try scratch("turns")
  const first = try cloudAgent(cloud, state)
  const { id, roomId } = try conversation(first)

  try Effect.sync(() => cloud.script(text("Hello ", "there.")))
  const plain = try send(first, id, { text: "Hi" })

  try Effect.sync(() => cloud.script(text("Keyed answer.")))
  const keyed = try send(first, id, { text: "Once only.", clientMessageId: "m-1" })
  const replayed = try send(first, id, { text: "Once only.", clientMessageId: "m-1" })
  const conflict = try send(first, id, { text: "Another body.", clientMessageId: "m-1" })
  const afterKeyed = completions(cloud)

  const gate = Promise.withResolvers<void>()
  try Effect.sync(() => cloud.script(held(gate.promise, text("Slow answer."))))
  const overlap = try host("overlapping sends", () => overlapping(first.transport.kind === "socket" ? first.transport.path : "", first.frame.token, cloud, id, gate.resolve))
  const afterOverlap = completions(cloud)

  try Effect.sync(() => cloud.script(insufficientCredits()))
  const unfunded = try send(first, id, { text: "Answer me.", clientMessageId: "m-3" })
  const storedFailure = try host("stored failure", () => first.agent.runtime.getMemoryById(replyOf(unfunded).messageId as UUID))
  const limitedUntil = Date.now() + 60_000
  try Effect.sync(() => cloud.script(rateLimited(limitedUntil)))
  const limited = try send(first, id, { text: "Answer me now.", clientMessageId: "m-4" })
  const limitedAgain = try send(first, id, { text: "Answer me now.", clientMessageId: "m-4" })
  const storedLimit = try host("stored limit", () => first.agent.runtime.getMemoryById(replyOf(limited).messageId as UUID))

  try host("first stop", () => first.agent.stop())
  const second = try cloudAgent(cloud, state)
  const world = (try host("room", () => second.agent.runtime.getRoom(roomId)))?.worldId
  const before = completions(cloud)
  const afterRestart = try send(second, id, { text: "Once only.", clientMessageId: "m-1" })
  const asked = try host("keyed message", () => second.agent.runtime.getMemoryById(replyOf(keyed).userMessageId as UUID))
  if (asked === null) return try Effect.die(new Error("The keyed message was not kept across the restart"))
  try host("cut turn", () => cutTurn(second.agent.runtime, roomId, world, asked.entityId, { text: "Cut short.", clientMessageId: "m-cut" }))
  const cut = try send(second, id, { text: "Cut short.", clientMessageId: "m-cut" })
  const cutAgain = try send(second, id, { text: "Cut short.", clientMessageId: "m-cut" })
  const stored = try host("messages", () => roomMessages(second.agent.runtime, roomId))

  try Effect.try(() => {
    const p = replyOf(plain)
    assert.deepStrictEqual({ status: plain.status, text: p.text, actionResults: p.actionResults, failureKind: p.failureKind }, { status: 200, text: "Hello there.", actionResults: [], failureKind: undefined })
    assert.deepStrictEqual(
      { keyed: keyed.status, replayed: replayed.status, same: replyOf(replayed).messageId === replyOf(keyed).messageId, conflict, calls: afterKeyed },
      { keyed: 200, replayed: 200, same: true, conflict: { status: 409, body: { error: "CHAT_IDEMPOTENCY_CONFLICT" } }, calls: 2 })
    const owner = answerOf(overlap.owner)
    const joined = answerOf(overlap.joined)
    assert.deepStrictEqual(
      { owner: owner.status, text: replyOf(owner).text, joinedSame: replyOf(joined).messageId === replyOf(owner).messageId, busy: answerOf(overlap.busy), otherBody: answerOf(overlap.otherBody), calls: afterOverlap },
      { owner: 200, text: "Slow answer.", joinedSame: true, busy: { status: 429, body: { error: "ROOM_BUSY" } }, otherBody: { status: 409, body: { error: "CHAT_IDEMPOTENCY_CONFLICT" } }, calls: 3 })
    assert.deepStrictEqual({ status: unfunded.status, failureKind: replyOf(unfunded).failureKind, planAction: replyOf(unfunded).planAction, stored: storedFailure?.content.failureKind },
      { status: 200, failureKind: "insufficient_credits", planAction: "funding", stored: "insufficient_credits" })
    const wait = replyOf(limited).retryAfterMs ?? -1
    assert.deepStrictEqual({
      status: limited.status, failureKind: replyOf(limited).failureKind, planAction: replyOf(limited).planAction, waits: wait > 0 && wait <= 60_000,
      replayed: [replyOf(limitedAgain).messageId === replyOf(limited).messageId, replyOf(limitedAgain).failureKind, replyOf(limitedAgain).retryAfterMs],
      stored: [storedLimit?.content.failureKind, storedLimit?.content.retryAt],
    }, { status: 200, failureKind: "limit_reached", planAction: undefined, waits: true, replayed: [true, "limit_reached", undefined], stored: ["limit_reached", undefined] })
    assert.deepStrictEqual({ status: afterRestart.status, same: replyOf(afterRestart).messageId === replyOf(keyed).messageId, text: replyOf(afterRestart).text, calls: completions(cloud) - before },
      { status: 200, same: true, text: "Keyed answer.", calls: 0 })
    assert.deepStrictEqual({ status: cut.status, text: replyOf(cut).text, failureKind: replyOf(cut).failureKind, again: replyOf(cutAgain).messageId === replyOf(cut).messageId, calls: completions(cloud) - before },
      { status: 200, text: "", failureKind: "aborted", again: true, calls: 0 })
    assert.strictEqual(stored.filter((memory: Memory) => memory.content.inReplyTo === replyOf(cut).userMessageId).length, 1)
  })
}, 240_000)

it.live('The boundary refuses a malformed body, client id or voice view context, and a launch without a text backend answers 503 and stores nothing (spec/agent/conversation/turns.md, "A message is refused, joined, replayed or admitted by its key, its room and the backend"; spec/agent/conversation/turnContext.md, "A voice view context is accepted only when every stated field has an allowed value and direct requests have completed-action delivery and a routing identity")', effect () => {
  const agent = try startInProcess()
  const { id, roomId } = try conversation(agent)
  const refusals = [
    try send(agent, id, { text: "Hi" }, { "x-elizaos-client-id": "not a client id" }),
    try send(agent, id, { text: "Hi", channelType: "GROUP" }),
    try send(agent, id, { text: "Hi", clientMessageId: "k".repeat(129) }),
    try send(agent, id, { text: "Hi", metadata: { note: "x".repeat(65536) } }),
    try send(agent, id, { text: "   " }),
    try send(agent, id, { text: "Hi", images: [{ data: "aGk=", mimeType: "image/tiff", name: "scan.tiff" }] }),
    try send(agent, id, { text: "Hi", metadata: { voiceUi: { uiViewPath: "//elsewhere" } } }),
  ]
  const unknown = try send(agent, "no-such-conversation", { text: "Hi" })
  const unavailable = try send(agent, id, { text: "Hi", channelType: "VOICE_DM", metadata: { observation: { view: "home", revision: 1, sensitive: false } } }, { "x-elizaos-client-id": "screen-1" })
  const stored = try host("messages", () => roomMessages(agent.agent.runtime, roomId))
  try Effect.try(() => assert.deepStrictEqual(
    { refusals, unknown, unavailable, stored: stored.length },
    {
      refusals: [
        { status: 400, body: { error: "invalid_client_id" } }, { status: 400, body: { error: "invalid_message" } },
        { status: 400, body: { error: "invalid_message" } }, { status: 400, body: { error: "invalid_message" } },
        { status: 400, body: { error: "invalid_message" } }, { status: 400, body: { error: "invalid_message" } },
        { status: 400, body: { error: "VOICE_UI_CONTEXT_INVALID" } },
      ],
      unknown: { status: 404, body: { error: "unknown_conversation" } },
      unavailable: { status: 503, body: { error: "INFERENCE_UNAVAILABLE" } },
      stored: 0,
    }))
}, 120_000)

const planning = 'spec/agent/conversation/planning.md'

const placeRetryFixture = {
  name: "place-retry-fixture",
  description: "A read action which needs a place name.",
  actions: [{
    name: "LOOK_UP_PLACE",
    description: "Look up one place by name or provider identifier.",
    parameters: [{ name: "place", required: true, schema: { type: "string" }, description: "The place name or identifier." }],
    validate: async () => true,
    handler: async (_runtime, _message, _state, options) => {
      const params = options?.parameters
      return typeof params === "object" && params !== null && "place" in params && params.place === "Coit Tower"
        ? { success: true, text: "Coit Tower" }
        : { success: false, error: "MAPS_SELECTION_HANDLE", text: "Retry with the place name.", data: { coachingFailure: true } }
    },
  }],
} satisfies AgentPlugin

it.live(`A planner-only refusal keeps a bundled reply from ending the owner turn (${planning}, "A failure or proposal the turn made stays reported unless a later success of the same operation supersedes it")`, effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { backend: { kind: "cloud", origin: cloud.origin }, load: [placeRetryFixture.name], allowed: ["REPLY", "IGNORE", "NONE", "LOOK_UP_PLACE"] },
    frame: { credential: { version: 1, value: deviceKey } },
    bundled: new Map<string, AgentPlugin>([[placeRetryFixture.name, placeRetryFixture]]),
  })
  const { id } = try conversation(agent)
  try Effect.sync(() => cloud.script(
    toolCalls("", { name: "LOOK_UP_PLACE", arguments: { place: "screen-selection" } }, { name: "REPLY", arguments: { text: "Already found it." } }),
    toolCalls("", { name: "LOOK_UP_PLACE", arguments: { place: "Coit Tower" } }),
    text("I found Coit Tower."),
  ))
  const answer = replyOf(try send(agent, id, { text: "Find Coit Tower." }))
  try Effect.try(() => {
    assert.strictEqual(answer.text, "I found Coit Tower.")
    assert.deepStrictEqual(answer.actionResults.map(({ action }) => action), ["LOOK_UP_PLACE", "LOOK_UP_PLACE"])
  })
}, 120_000)

it.live(`Restore original history alone and preserve one settled calculation (${planning}, "A request to restore original history runs alone and keeps the settled tool results")`, effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { callerRole: "owner", backend: { kind: "cloud", origin: cloud.origin }, load: [basicActionsModuleName], allowed: ["REPLY", "IGNORE", "NONE", "CALCULATE"] },
    frame: { credential: { version: 1, value: deviceKey } }, modules: builtinModuleFactories,
  })
  const { id, roomId } = try conversation(agent)
  try Effect.sync(() => cloud.script(text("I’m ready.")))
  const first = replyOf(try send(agent, id, { text: "Prepare for a later question." }))
  const original = try host("seeded conversation", () => agent.agent.runtime.getMemoryById(first.userMessageId as UUID))
  if (original === null) return try Effect.die(new Error("The owner message was not stored"))
  const marker = "Pebble tundra."
  try host("store original history", () => seedHistory(agent.agent.runtime, original, marker))
  const restore = (scope: string) => ({ name: "RESTORE_CONTEXT", arguments: { scope, reason: "The earlier details are needed." } })
  const calculate = (expression: string) => ({ name: "CALCULATE", arguments: { expression } })
  const discarded = "This mixed draft must stay out of the reply."
  try Effect.sync(() => cloud.script(
    toolCalls("", calculate("7 + 5")),
    toolCalls(discarded, restore("unexpected"), calculate("55 + 55")),
    toolCalls(discarded, restore("history"), calculate("99 + 1"), { name: "REPLY", arguments: { text: discarded } }),
    text("The original marker was Pebble tundra, and the total is 12."),
  ))
  const current = "Recover the earlier item and calculate 7 + 5."
  const answer = replyOf(try send(agent, id, { text: current }))
  const calls = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).slice(-4)
    .map(({ body }) => body as { messages: { role: string; content?: string }[]; tools: Array<{ function?: { name?: string } }> })
  try Effect.try(() => {
    assert.deepStrictEqual(answer.actionResults.map(({ action }) => action), ["CALCULATE"])
    assert.strictEqual(answer.text, "The original marker was Pebble tundra, and the total is 12.")
    assert.deepStrictEqual(calls.map(({ messages }) => messages.filter(({ content }) => content === marker).length), [0, 0, 0, 1])
    const final = calls[3]?.messages ?? []
    assert.strictEqual(final.filter(({ content }) => content === current).length, 1)
    assert.strictEqual(final.filter(({ role }) => role === "tool").length, 1)
    assert.isTrue(final.some(({ role, content }) => role === "tool" && content?.includes("12") === true))
    assert.strictEqual(final.filter(({ content }) => content?.includes("context restore did not run")).length, 1)
    assert.strictEqual(final.filter(({ content }) => content?.includes("deferred original history was restored")).length, 1)
    assert.notInclude(JSON.stringify(calls), discarded)
    assert.notInclude(JSON.stringify(calls), "99 + 1")
    assert.isFalse(final.some(({ role, content }) => role === "system" && content?.includes("earlier conversation messages are deferred") === true))
    assert.deepStrictEqual(calls.map(({ tools }) => tools[0]), calls.map(() => calls[0]?.tools[0]))
  })

  try Effect.sync(() => cloud.script(
    toolCalls(discarded, restore("providers"), calculate("2 + 3")),
    toolCalls(discarded, restore("providers"), calculate("6 + 7")),
  ))
  const refused = replyOf(try send(agent, id, { text: "Can you check the unavailable context?" }))
  try Effect.try(() => {
    assert.strictEqual(refused.text, "I couldn’t restore additional context for that reply.")
    assert.deepStrictEqual(refused.actionResults, [])
    assert.strictEqual(completions(cloud), 7)
  })

  const finish = Promise.withResolvers<void>()
  const { starting, restored } = try Effect.sync(() => ({ starting: cloud.nextCompletion(), restored: cloud.nextCompletion() }))
  try Effect.sync(() => cloud.script(
    toolCalls("", restore("history")),
    held(finish.promise, toolCalls("", calculate("400 + 500"))),
  ))
  const parked = fork send(agent, id, { text: "Use my earlier context one more time." })
  try promise(() => starting)
  try promise(() => restored)
  const stop = answerOf(try call(agent, { method: "POST", path: `/api/turns/${roomId}/abort`, body: {} }))
  try sync(() => finish.resolve())
  const interrupted = replyOf(try join parked)
  try Effect.try(() => {
    assert.deepStrictEqual([stop.status, (stop.body as { outcome: string }).outcome, interrupted.failureKind], [200, "stopped", "aborted"])
    assert.deepStrictEqual(interrupted.actionResults, [])
    assert.strictEqual(completions(cloud), 9)
  })
}, 120_000)

const receiptFixture = {
  name: "receipt-fixture",
  description: "Return recorded outcomes without doing external work.",
  actions: [{
    name: "RECORDED_CHANGE",
    description: "Return the recorded outcome for a fixture change.",
    parameters: [
      { name: "target", required: true, schema: { type: "string" }, description: "A fixture record." },
      { name: "key", required: true, schema: { type: "string" }, description: "The retry key." },
      { name: "phase", required: true, schema: { type: "string", enum: ["failed", "uncertain", "replayed"] }, description: "The fixture outcome." },
    ],
    validate: async () => true,
    handler: async (_runtime, _message, _state, options): Promise<ActionResult> => {
      const params = options?.parameters
      if (typeof params !== "object" || params === null || !("target" in params) || !("key" in params) || !("phase" in params)
        || typeof params.target !== "string" || typeof params.key !== "string") return { success: false }
      const { target, key, phase } = params
      const base = { receiptId: `fixture:${target}`, operation: "save", resource: { kind: "fixture", id: target },
        artifacts: [], idempotency: { key, replayed: phase === "replayed" }, observedAt: "2026-11-23T00:00:00.000Z" }
      const receipt: EffectReceipt = phase === "replayed"
        ? { ...base, outcome: "noop", reason: "Prior commit observed by retry key." }
        : { ...base, outcome: "failed", failure: { code: "FIXTURE_CHANGE_FAILED", retryable: true, acceptance: phase === "uncertain" ? "unknown" : "rejected" } }
      return { success: phase === "replayed", text: `Recorded outcome for ${target}.`, effectReceipts: [receipt] }
    },
  }],
} satisfies AgentPlugin

const claim = (quote: string, change: "None" | "Occurred" | "DidNotOccur", receiptId: string | null = null, failedResult: number | null = null) =>
  ({ quote, change, receiptId, failedResult, supported: true })

const review = (...claims: ReturnType<typeof claim>[]) => text(JSON.stringify({ grounded: true, claims }))

it.live(`The owner hears an unrelated failure and an uncertain outcome after a retry is confirmed (${planning}, "A failure or proposal the turn made stays reported unless a later success of the same operation supersedes it")`, effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { backend: { kind: "cloud", origin: cloud.origin }, load: [receiptFixture.name], allowed: ["REPLY", "IGNORE", "NONE", "RECORDED_CHANGE"] },
    frame: { credential: { version: 1, value: deviceKey } },
    bundled: new Map<string, AgentPlugin>([[receiptFixture.name, receiptFixture]]),
  })
  const { id } = try conversation(agent)
  const change = (target: string, key: string, phase: string) => ({ name: "RECORDED_CHANGE", arguments: { target, key, phase } })
  const falseFailure = "The first change failed."
  const falseCertainty = "The third change did not take effect."
  const supported = "The retry was confirmed. I couldn’t do the second change."
  try Effect.sync(() => cloud.script(toolCalls("",
    change("first", "retry", "failed"),
    change("second", "second", "failed"),
    change("third", "third", "uncertain"),
    change("confirmed-alias", "retry", "replayed"),
  ), text(`${falseFailure} ${falseCertainty} ${supported}`),
    review(claim(falseFailure, "DidNotOccur", "fixture:first", 1), claim(falseCertainty, "DidNotOccur", "fixture:third", 3),
      claim("The retry was confirmed.", "Occurred", "fixture:confirmed-alias"), claim("I couldn’t do the second change.", "DidNotOccur", "fixture:second", 2)),
    text(supported),
    review(claim("The retry was confirmed.", "Occurred", "fixture:confirmed-alias"), claim("I couldn’t do the second change.", "DidNotOccur", "fixture:second", 2))))
  const answer = try stream(agent, { method: "POST", path: `/api/conversations/${id}/messages/stream`, body: { text: "What happened to those changes?" } })
  try Effect.try(() => {
    assert.propertyVal(answer, "status", 200)
    const body = "text" in answer ? answer.text : ""
    assert.include(body, supported)
    assert.include(body, "Recorded outcome for second.")
    assert.include(body, "I couldn’t confirm whether all of the RECORDED_CHANGE work took effect.")
    assert.notInclude(body, falseFailure)
    assert.notInclude(body, falseCertainty)
    assert.strictEqual(completions(cloud), 5)
  })
}, 120_000)

it.live(`An allowed action runs as a tool, its result grounds the reply, a failure the turn proved is reported, and a cue is never the reply (${planning}, "A turn offers the model only registered actions the launch allows, and plans at most eight steps"; ${planning}, "A failure or proposal the turn made stays reported unless a later success of the same operation supersedes it"; ${planning}, "A pending-work cue is spoken only before work runs and is never the reply, and an answer is delivered whole"; ${planning}, "A voice turn that ran an action answers with that action's label: its kind, whether the reply is a validated card, and whether the owner asked for exact wording")`, effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { backend: { kind: "cloud", origin: cloud.origin }, load: [basicActionsModuleName], allowed: ["REPLY", "IGNORE", "NONE", "CALCULATE"] },
    frame: { credential: { version: 1, value: deviceKey } }, modules: builtinModuleFactories,
  })
  const { id } = try conversation(agent)

  try Effect.sync(() => cloud.script(toolCalls("Let me check.", { name: "CALCULATE", arguments: { expression: "3847 * 292" } }), text("That is 1,123,324.")))
  const solved = replyOf(try send(agent, id, { text: "What is 3847 times 292?" }))
  const [asked, grounded] = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).slice(-2).map(({ body }) => body as { tools?: { function?: { name?: string } }[]; messages: { role: string; content?: unknown }[] })

  try Effect.sync(() => cloud.script(toolCalls("", { name: "CALCULATE", arguments: { expression: "two plus two" } }), text("Done!"), text("unavailable review")))
  const failed = replyOf(try send(agent, id, { text: "Add two plus two." }))

  try Effect.sync(() => cloud.script(toolCalls("",
    { name: "CALCULATE", arguments: { expression: "8 + 9", stray: true } },
    { name: "CALCULATE", arguments: { expression: "12 * 3" } },
  ), text("The second result is 36."), review(claim("The second result is 36.", "None"))))
  const separate = replyOf(try send(agent, id, { text: "Calculate 8 plus 9 and 12 times 3." }))

  try Effect.sync(() => cloud.script(
    toolCalls("", { name: "CALCULATE", arguments: { expression: "8 + 9", stray: true } }),
    toolCalls("", { name: "CALCULATE", arguments: { expression: "8 + 9" } }),
    text("The result is 17."), review(claim("The result is 17.", "None")),
  ))
  const corrected = replyOf(try send(agent, id, { text: "Calculate 8 plus 9." }))

  try Effect.sync(() => cloud.script(text("One sec."), text("One second is 1,000 milliseconds.")))
  const duration = replyOf(try send(agent, id, { text: "How long is a second?" }))

  try Effect.sync(() => cloud.script(toolCalls("", { name: "CALCULATE", arguments: { expression: "12 * 3" } }), text("It is 36.")))
  const spoken = replyOf(try send(agent, id, { text: "Read me the number for 12 times 3.", channelType: "VOICE_DM" }))

  try Effect.try(() => assert.deepStrictEqual({
    offered: asked?.tools?.map((tool) => tool.function?.name),
    toolResult: grounded?.messages.some(({ role, content }) => role === "tool" && typeof content === "string" && content.includes("1123324")),
    solved: solved.text,
    actions: solved.actionResults.map(({ action }) => action),
    failureReported: !failed.text.includes("Done!") && failed.text.length > 0,
    separate: separate.text,
    corrected: corrected.text,
    refusalStatuses: [separate, corrected].map(({ actionResults }) => actionResults.map(({ data }) => data.executionStatus)),
    duration: duration.text,
    labels: { text: solved.action, voice: spoken.action },
  }, {
    offered: ["RESTORE_CONTEXT", "CALCULATE"],
    toolResult: true,
    solved: "That is 1,123,324.",
    actions: ["CALCULATE"],
    failureReported: true,
    separate: "The second result is 36.\n\nA CALCULATE call did not start.",
    corrected: "The result is 17.\n\nA CALCULATE call did not start.",
    refusalStatuses: [["not_started", undefined], ["not_started", undefined]],
    duration: "One second is 1,000 milliseconds.",
    labels: { text: undefined, voice: { kind: "CALCULATE", validatedCard: false, verbatimAsked: true } },
  }))
}, 120_000)
