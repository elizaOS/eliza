// spec/agent/models/binding.md, "No text handler is ever served by a model on the device"; spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call for its turn to re-send once"; spec/agent/models/binding.md, "Each refusal is one account state, and the last failure records its kind and time without text"; spec/agent/models/binding.md, "A tool call, a structured answer and the token use reach the caller as one result"; spec/agent/models/binding.md, "A key is held only in the slot of the backend it was given for, and only as a bearer credential that slot accepts"; spec/agent/models/binding.md, "A rate limit on an own key at Cerebras holds the account at most four seconds, and every other route keeps the provider's retry time"; spec/agent/models/binding.md, "A tool call the provider could not parse, or a streamed answer silent for a minute, ends the call without a retry"; spec/agent/models/binding.md, "A call sends an output cap only when its caller names one, and a thinking hint sets the reasoning effort only on a model that documents it"; spec/agent/models/binding.md, "A Qwen call on a Cerebras route sends the conversation cache key its caller names, and no call invents one"; spec/agent/conversation/planning.md, "Each call of a conversation starts with the same system prompt and tools, and what changes per turn follows the history"
import { assert, it } from "@effect/vitest"
import { FetchHttpClient } from "effect/http"
import { AgentRuntime, ModelType, type GenerateTextParams, type GenerateTextResult } from "@elizaos/core"
import { allowanceExhausted, answerJson, cachedText, dropped, echoImages, insufficientCredits, rateLimited, refusal, refusalFrame, text, unavailable, type CloudFake, type CloudReply } from "./support/cloud-fake.ts"
import { parseLaunch } from "../src/host/launch.vibe"
import { bindModels } from "../src/models/binding.vibe"
import { registerCloudModels } from "../src/models/cloud-provider.vibe"
import { probeOwnKey, registerOwnKeyModels } from "../src/models/own-key-provider.vibe"
import { conversationCache } from "../src/conversation/planning.vibe"
import { openDeviceStorage } from "../src/storage/index.vibe"
import { cloudFake, deviceKey, host, scratch } from "./support/kernel.vibe"
import { launchDocument, launchFrame, type Backend } from "./support/scratch.ts"

module node {
  import { createHash } from "node:crypto"

  /** @throws {never} */
  export function digest(text: string): string {
    return createHash("sha256").update(text).digest("hex")
  }
}
import { digest } from node

effect function bindingOf(backend: Backend, key: string) {
  const parsed = try parseLaunch(JSON.stringify(launchDocument({ backend })), JSON.stringify(launchFrame({ credential: { version: 1, value: key } })))
  return try bindModels(parsed.launch, parsed.authority)
}

effect function bound(backend: Backend, key: string) {
  const binding = try bindingOf(backend, key)
  const state = try scratch("model-providers")
  const store = try acquireRelease(host("device storage", () => openDeviceStorage({ stateDirectory: state.path, persistMemory: false, account: null, embeddingDimensions: 0 })),
    (opened) => orDie(host("device storage close", () => opened.adapter.close())))
  const runtime = try Effect.try(() => new AgentRuntime({ agentId: store.agentId, character: { name: "Eliza", bio: [] } }))
  try Effect.try(() => runtime.registerDatabaseAdapter(store.adapter))
  return { binding, runtime }
}

effect function cloudAgent(cloud: CloudFake, large = "large") {
  const made = try bound({ kind: "cloud", origin: cloud.origin, imageModel: "vision" }, deviceKey)
  registerCloudModels(made.runtime, made.binding, { baseUrl: cloud.origin, small: "small", large, image: "vision" })
  return made
}

function completions(cloud: CloudFake): number {
  return cloud.calls.filter((call) => call.method === "POST" && call.path.endsWith("/chat/completions")).length
}

function refusalOf(runtime: AgentRuntime, params: GenerateTextParams) {
  return host("refused model call", () => runtime.useModel(ModelType.TEXT_SMALL, params).then(() => undefined, (failure: unknown) => failure as { code?: unknown; status?: unknown; name?: unknown; retryAfterMs?: unknown }))
}

it.effect('A cloud text call keeps its image parts and streams, and an image description uses the image model (spec/agent/models/binding.md, "No text handler is ever served by a model on the device")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const { runtime, binding } = try cloudAgent(cloud)
  try Effect.sync(() => cloud.script(echoImages(), text("Title: A cat", "\nA cat on a mat.")))
  const chunks: string[] = []
  const said = try host("text with an image part", () => runtime.useModel(ModelType.TEXT_SMALL, {
    messages: [{ role: "user", content: [{ type: "text", text: "What is this?" }, { type: "image", image: "https://example.test/cat.png" }] }],
    stream: true, onStreamChunk: (chunk: string) => { chunks.push(chunk) },
  }))
  const described = try host("image description", () => runtime.useModel(ModelType.IMAGE_DESCRIPTION, { imageUrl: "https://example.test/cat.png", prompt: "Describe it." }))
  assert.strictEqual(said, "images:https://example.test/cat.png")
  assert.deepStrictEqual(chunks, ["images:https://example.test/cat.png"])
  assert.deepStrictEqual(described, { title: "A cat", description: "Title: A cat\nA cat on a mat." })
  assert.deepStrictEqual(cloud.calls.map((call) => {
    const body = call.body
    assert.ok(body !== null && typeof body === "object" && "model" in body)
    return [call.path, body.model, call.authorization, "max_tokens" in body ? body.max_tokens : undefined]
  }), [
    ["/api/v1/chat/completions", "small", `Bearer ${deviceKey}`, undefined],
    ["/api/v1/chat/completions", "vision", `Bearer ${deviceKey}`, undefined],
  ])
  assert.strictEqual((try binding.read()).accountState, "usable")
})

it.effect('An outage or a dropped connection is retried on the next registration under the same idempotency key and the answer clears the account state (spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call for its turn to re-send once")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const { runtime, binding } = try cloudAgent(cloud)
  try Effect.sync(() => cloud.script(unavailable(1), text("after outage"), dropped(), text("after drop"), unavailable(1), unavailable(1), unavailable(1), unavailable(1)))
  const first = try host("outage then answer", () => runtime.useModel(ModelType.TEXT_LARGE, { prompt: "One." }))
  const second = try host("drop then answer", () => runtime.useModel(ModelType.TEXT_LARGE, { prompt: "Two." }))
  const third = try refusalOf(runtime, { prompt: "Three." })
  assert.deepStrictEqual([first, second], ["after outage", "after drop"])
  assert.strictEqual(third?.status, 503)
  assert.strictEqual(completions(cloud), 8)
  const keys = cloud.calls.map((call) => call.idempotencyKey ?? "")
  assert.deepStrictEqual([keys.every((key) => /^[\da-f-]{36}$/.test(key)), keys.map((key) => [...new Set(keys)].indexOf(key))], [true, [0, 0, 1, 1, 2, 2, 2, 2]])
  const view = try binding.read()
  assert.strictEqual(view.accountState, "provider_issue")
  assert.strictEqual(view.lastCloudFailure?.kind, "provider_issue")
})

it.effect('A rate limit ends the call, blocks the next one without reaching the cloud, and funding is not retried (spec/agent/models/binding.md, "Each refusal is one account state, and the last failure records its kind and time without text")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const limited = try cloudAgent(cloud)
  const retryAt = Date.now() + 60_000
  try Effect.sync(() => cloud.script(rateLimited(retryAt)))
  const ended = try refusalOf(limited.runtime, { prompt: "Limited." })
  const blocked = try refusalOf(limited.runtime, { prompt: "Still limited." })
  assert.strictEqual(ended?.code, "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED")
  assert.strictEqual(blocked?.code, "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED")
  assert.strictEqual(completions(cloud), 1)
  const view = try limited.binding.read()
  assert.deepStrictEqual([view.accountState, view.blocked, view.lastCloudFailure?.retryAt], ["limit_reached", true, retryAt])
  const unfunded = try cloudAgent(cloud)
  try Effect.sync(() => cloud.script(insufficientCredits()))
  const denied = try refusalOf(unfunded.runtime, { prompt: "Unfunded." })
  assert.strictEqual(denied?.code, "MODEL_FUNDING_AUTHORITY_FAILED")
  assert.strictEqual(completions(cloud), 2)
  assert.strictEqual((try unfunded.binding.read()).accountState, "insufficient_credits")
  const spent = try cloudAgent(cloud)
  try Effect.sync(() => cloud.script(allowanceExhausted(Date.now() + 86_400_000)))
  const exhausted = try refusalOf(spent.runtime, { prompt: "Allowance spent." })
  assert.strictEqual(exhausted?.code, "MODEL_FUNDING_AUTHORITY_FAILED")
  assert.strictEqual(completions(cloud), 3)
  assert.strictEqual((try spent.binding.read()).accountState, "insufficient_credits")
  const replaced = try cloudAgent(cloud)
  try Effect.sync(() => cloud.acceptKey("rotated-device-key"))
  const invalid = try refusalOf(replaced.runtime, { prompt: "Old key." })
  assert.strictEqual(invalid?.status, 401)
  assert.strictEqual(completions(cloud), 4)
  assert.strictEqual((try replaced.binding.read()).accountState, "credential_invalid")
})

it.live('A caller abort ends the call without an account failure (spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call for its turn to re-send once")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const { runtime, binding } = try cloudAgent(cloud)
  try Effect.sync(() => cloud.script({ kind: "hang" }))
  const controller = new AbortController()
  const pending = try Effect.try(() => runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Wait.", signal: controller.signal }))
  while (completions(cloud) === 0) try sleep("10 millis")
  controller.abort()
  const aborted = try host("aborted call", () => pending.then(() => undefined, (failure: unknown) => failure as { name?: unknown }))
  assert.strictEqual(aborted?.name, "AbortError")
  try host("server saw the abort", () => cloud.calls[0]!.aborted)
  assert.strictEqual(completions(cloud), 1)
  const view = try binding.read()
  assert.deepStrictEqual([view.accountState, view.lastCloudFailure], ["usable", undefined])
})

it.effect('The own-key backend answers text and image description, classifies its refusals into the same states, probes its key and holds only a key its slot accepts (spec/agent/models/binding.md, "No text handler is ever served by a model on the device"; spec/agent/models/binding.md, "A key is held only in the slot of the backend it was given for, and only as a bearer credential that slot accepts")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const own = { baseUrl: cloud.ownKeyBaseUrl, small: "small", large: "large" }
  const good = try bound({ kind: "ownKey", baseUrl: own.baseUrl, smallModel: "small", largeModel: "large" }, cloud.ownKey)
  registerOwnKeyModels(good.runtime, good.binding, own)
  try Effect.sync(() => cloud.script(unavailable(1), text("own answer"), rateLimited(Date.now() + 60_000)))
  const answered = try host("own-key text", () => good.runtime.useModel(ModelType.TEXT_LARGE, { prompt: "Hi." }))
  const limited = try refusalOf(good.runtime, { prompt: "Again." })
  assert.strictEqual(answered, "own answer")
  assert.strictEqual(limited?.code, "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED")
  assert.notStrictEqual(good.runtime.getModel(ModelType.IMAGE_DESCRIPTION), undefined)
  assert.strictEqual((try good.binding.read()).accountState, "limit_reached")
  provide FetchHttpClient.layer {
    const listed = try probeOwnKey(own, Redacted.make(cloud.ownKey))
    assert.deepStrictEqual(listed, ["small", "large"])
  }
  const wrong = try bound({ kind: "ownKey", baseUrl: own.baseUrl, smallModel: "small", largeModel: "large" }, "wrong-key")
  registerOwnKeyModels(wrong.runtime, wrong.binding, own)
  const refused = try refusalOf(wrong.runtime, { prompt: "Bad key." })
  assert.strictEqual(refused?.status, 401)
  assert.strictEqual((try wrong.binding.read()).accountState, "credential_invalid")
  assert.deepStrictEqual(cloud.calls.map((call) => call.path), [
    "/own-key/v1/chat/completions", "/own-key/v1/chat/completions", "/own-key/v1/chat/completions", "/own-key/v1/models", "/own-key/v1/chat/completions",
  ])
  const keyed = (backend: Backend, key: string) => parseLaunch(JSON.stringify(launchDocument({ backend })), JSON.stringify(launchFrame({ credential: { version: 1, value: key } })))
  const oversized = try Effect.flip(keyed({ kind: "ownKey", baseUrl: own.baseUrl, smallModel: "small", largeModel: "large" }, "k".repeat(1025)))
  const unbound = try keyed({ kind: "none" }, cloud.ownKey)
  const dropped = try bindModels(unbound.launch, unbound.authority)
  const lineBreak = try Effect.flip(keyed({ kind: "ownKey", baseUrl: own.baseUrl, smallModel: "small", largeModel: "large" }, "own-key\r\nX-Injected: 1"))
  assert.deepStrictEqual(oversized._tag === "LaunchCredentialMissing" ? { tag: oversized._tag, oversized: oversized.oversized } : { tag: oversized._tag }, { tag: "LaunchCredentialMissing", oversized: true })
  assert.strictEqual(Redacted.value(dropped.credential()), "")
  assert.strictEqual(lineBreak._tag, "LaunchFrameRejected")
})

it.effect('A tool call and its token use reach the caller as one result, a streamed call asks for its token use and records the cached prompt tokens of its last chunk, each tool result follows the call that asked for it, and a thinking hint sets the reasoning effort only on a model that documents it (spec/agent/models/binding.md, "A tool call, a structured answer and the token use reach the caller as one result"; spec/agent/models/binding.md, "A call sends an output cap only when its caller names one, and a thinking hint sets the reasoning effort only on a model that documents it")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const { runtime, binding } = try cloudAgent(cloud, "cerebras/qwen-3.8-27b")
  try Effect.sync(() => cloud.route("POST", "/api/v1/chat/completions", answerJson({
    choices: [{ message: { role: "assistant", content: null, tool_calls: [{ id: "call-1", type: "function", function: { name: "CALCULATE", arguments: "{\"expression\":\"2+2\"}" } }] }, finish_reason: "tool_calls" }],
    usage: { prompt_tokens: 12, completion_tokens: 5, total_tokens: 17, prompt_tokens_details: { cached_tokens: 4 } },
  })))
  const parameters = { type: "object", properties: { expression: { type: "string" } }, required: ["expression"] }
  const result = try host("tool call", () => runtime.useModel<typeof ModelType.TEXT_LARGE, string | GenerateTextResult>(ModelType.TEXT_LARGE, {
    tools: [{ name: "CALCULATE", description: "Arithmetic.", parameters }],
    toolChoice: "auto",
    reasoning: "off",
    messages: [
      { role: "user", content: "What is 2+2?" },
      { role: "tool", toolCallId: "orphan", content: "stale" },
      { role: "assistant", content: "", toolCalls: [{ id: "call-0", name: "CALCULATE", arguments: { expression: "1+1" } }] },
      { role: "user", content: "And now?" },
      { role: "tool", toolCallId: "call-0", content: "2" },
    ],
  }))
  assert.deepStrictEqual<unknown>(result, {
    text: "", toolCalls: [{ id: "call-1", name: "CALCULATE", arguments: { expression: "2+2" } }], finishReason: "tool_calls",
    usage: { promptTokens: 12, completionTokens: 5, totalTokens: 17, cacheReadInputTokens: 4 },
  })
  const sent = cloud.calls.at(-1)?.body as { messages: Array<{ role: string } & Record<string, unknown>>; tools: unknown; tool_choice: unknown; reasoning_effort: unknown }
  assert.deepStrictEqual(sent.messages.filter((message) => message.role !== "system"), [
    { role: "user", content: "What is 2+2?" },
    { role: "user", content: "[tool result]\nstale" },
    { role: "assistant", content: null, tool_calls: [{ id: "call-0", type: "function", function: { name: "CALCULATE", arguments: "{\"expression\":\"1+1\"}" } }] },
    { role: "tool", tool_call_id: "call-0", content: "2" },
    { role: "user", content: "And now?" },
  ])
  assert.deepStrictEqual([sent.tools, sent.tool_choice, sent.reasoning_effort], [[{ type: "function", function: { name: "CALCULATE", description: "Arithmetic.", parameters } }], "auto", "none"])
  assert.strictEqual((try binding.read()).accountState, "usable")

  const scripted = try cloudFake(deviceKey)
  const streaming = try cloudAgent(scripted)
  try Effect.sync(() => scripted.script(text("Whole."), cachedText(48, "Four.")))
  try host("whole call", () => streaming.runtime.useModel(ModelType.TEXT_LARGE, { prompt: "Hi." }))
  const chunks: string[] = []
  const streamed = try host("streamed tool offer", () => streaming.runtime.useModel(ModelType.TEXT_LARGE, {
    tools: [{ name: "CALCULATE", description: "Arithmetic.", parameters }], toolChoice: "auto",
    messages: [{ role: "user", content: "What is 2+2?" }], stream: true, onStreamChunk: (chunk: string) => { chunks.push(chunk) },
  }))
  const [whole, asked] = scripted.calls.map((call) => call.body as Record<string, unknown>)
  let logged: unknown
  for (let read = 0; logged === undefined && read < 100; read++) {
    const rows = try host("model-call records", () => streaming.runtime.getLogs({ entityId: streaming.runtime.agentId }))
    logged = rows.map((log) => (log.body as { usage?: { cacheReadInputTokens?: unknown } }).usage).find((usage) => usage?.cacheReadInputTokens !== undefined)
  }
  assert.deepStrictEqual<unknown>({ streamed, chunks, options: [asked?.stream_options, whole !== undefined && "stream_options" in whole], logged }, {
    streamed: { text: "Four.", toolCalls: [], finishReason: "stop", usage: { promptTokens: 49, completionTokens: 2, totalTokens: 51, cacheReadInputTokens: 48 } },
    chunks: ["Four."],
    options: [{ include_usage: true }, false],
    logged: { promptTokens: 49, completionTokens: 2, cacheReadInputTokens: 48 },
  })
})

it.effect('An own-key overload or timeout is a provider issue and is retried, and a validation refusal ends the call (spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call for its turn to re-send once")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const own = { baseUrl: cloud.ownKeyBaseUrl, small: "small", large: "large" }
  const made = try bound({ kind: "ownKey", baseUrl: own.baseUrl, smallModel: "small", largeModel: "large" }, cloud.ownKey)
  registerOwnKeyModels(made.runtime, made.binding, own)
  try Effect.sync(() => cloud.script(refusal(400, "server_error"), text("after overload"), refusal(408, "timeout"), text("after timeout"), refusal(400, "invalid_request_error")))
  const first = try host("overload then answer", () => made.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "One.", temperature: 0.2, stopSequences: ["\n\n"] }))
  const second = try host("timeout then answer", () => made.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Two.", maxTokens: 256 }))
  const third = try refusalOf(made.runtime, { prompt: "Three." })
  assert.deepStrictEqual([first, second, third?.status], ["after overload", "after timeout", 400])
  const bodies = cloud.calls.filter((call) => call.path.endsWith("/chat/completions")).map((call) => call.body as Record<string, unknown>)
  assert.strictEqual(bodies.length, 5)
  assert.deepStrictEqual([bodies[0]?.temperature, bodies[0]?.stop, "max_tokens" in (bodies[0] ?? {}), "max_completion_tokens" in (bodies[0] ?? {}), bodies[2]?.max_completion_tokens], [0.2, ["\n\n"], false, false, 256])
})

it.effect('A rate limit on an own key at Cerebras holds the account four seconds while its refusals, the provider\'s own and the hold\'s, carry the provider\'s whole wait, every other route holds the provider\'s whole time, a limit that names no wait carries none, a parse failure is not retried, a thinking hint reaches only a model that documents it, and only a Qwen call on a Cerebras route sends the conversation cache key (spec/agent/models/binding.md, "A rate limit on an own key at Cerebras holds the account at most four seconds, and every other route keeps the provider\'s retry time"; spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call for its turn to re-send once"; spec/agent/models/binding.md, "A Qwen call on a Cerebras route sends the conversation cache key its caller names, and no call invents one"; spec/agent/models/binding.md, "A tool call the provider could not parse, or a streamed answer silent for a minute, ends the call without a retry"; spec/agent/models/binding.md, "A call sends an output cap only when its caller names one, and a thinking hint sets the reasoning effort only on a model that documents it")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const at = Date.now()
  const routes: [Backend, string][] = [
    [{ kind: "ownKey", baseUrl: "https://api.cerebras.ai/v1", smallModel: "small", largeModel: "large" }, cloud.ownKey],
    [{ kind: "ownKey", baseUrl: cloud.ownKeyBaseUrl, smallModel: "small", largeModel: "large" }, cloud.ownKey],
    [{ kind: "cloud", origin: cloud.origin, imageModel: "vision" }, deviceKey],
  ]
  const holds: unknown[] = []
  for (const [backend, key] of routes) {
    const binding = try bindingOf(backend, key)
    const id = try binding.startCall("TextLarge", at)
    if (typeof id === "number") try binding.refuseCall(id, at, { tag: "CloudRateLimited", retryAt: at + 59_000 })
    holds.push([try binding.startCall("TextLarge", at + 3_999), try binding.startCall("TextLarge", at + 4_000)])
  }
  const limitOf = (retryAt: number) => ({ limited: { tag: "LimitReached", retryAt, providerRetryAt: at + 59_000 } })
  assert.deepStrictEqual(holds, [
    [limitOf(at + 4_000), 1],
    [limitOf(at + 59_000), limitOf(at + 59_000)],
    [limitOf(at + 59_000), limitOf(at + 59_000)],
  ])

  const onCerebras = { baseUrl: cloud.ownKeyCerebrasBaseUrl, small: "small", large: "large" }
  const cerebras = try bound({ kind: "ownKey", baseUrl: onCerebras.baseUrl, smallModel: onCerebras.small, largeModel: onCerebras.large }, cloud.ownKey)
  registerOwnKeyModels(cerebras.runtime, cerebras.binding, onCerebras)
  try Effect.sync(() => cloud.script(refusal(429, "rate_limit_exceeded", { retryAfterSeconds: 59 })))
  const cerebrasSent = completions(cloud)
  const refusedAt = Date.now()
  const minute = try refusalOf(cerebras.runtime, { prompt: "Busy." })
  const heldBack = try refusalOf(cerebras.runtime, { prompt: "Still busy." })
  const heldAt = Date.now()
  const heldUntil = (try cerebras.binding.read()).lastCloudFailure?.retryAt ?? 0
  const providerWindow = (wait: unknown) => typeof wait === "number" && wait > 58_000 - (heldAt - refusedAt) && wait <= 59_000
  assert.deepStrictEqual(
    [minute?.status, heldBack?.status, providerWindow(minute?.retryAfterMs), providerWindow(heldBack?.retryAfterMs), completions(cloud) - cerebrasSent, heldUntil >= refusedAt + 4_000 && heldUntil <= heldAt + 4_000],
    [429, 429, true, true, 1, true])

  const unhinted = try cloudAgent(cloud)
  const own = { baseUrl: cloud.ownKeyBaseUrl, small: "qwen-3.8-27b", large: "large" }
  const ownKey = try bound({ kind: "ownKey", baseUrl: own.baseUrl, smallModel: own.small, largeModel: own.large }, cloud.ownKey)
  registerOwnKeyModels(ownKey.runtime, ownKey.binding, own)
  try Effect.sync(() => cloud.script(refusal(429, "rate_limited", { retryable: true }), text("cloud admitted"), refusal(429, "queue_exceeded"), text("own key admitted")))
  const sentBefore = completions(cloud)
  const cloudBusy = try refusalOf(unhinted.runtime, { prompt: "Busy." })
  const cloudAdmitted = try host("cloud call after a hintless limit", () => unhinted.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Again." }))
  const ownBusy = try refusalOf(ownKey.runtime, { prompt: "Busy." })
  const ownAdmitted = try host("own-key call after a hintless limit", () => ownKey.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Again." }))
  const hintless = (failure: { status?: unknown; retryAfterMs?: unknown } | undefined, view: { lastCloudFailure?: { kind: string; retryAt?: number } }) =>
    [failure?.status, failure?.retryAfterMs, view.lastCloudFailure?.kind, view.lastCloudFailure?.retryAt]
  assert.deepStrictEqual([
    hintless(cloudBusy, try unhinted.binding.read()), hintless(ownBusy, try ownKey.binding.read()), cloudAdmitted, ownAdmitted, completions(cloud) - sentBefore,
  ], [[429, undefined, "limit_reached", undefined], [429, undefined, "limit_reached", undefined], "cloud admitted", "own key admitted", 4])

  const hinted = try bound({ kind: "cloud", origin: cloud.origin, imageModel: "vision" }, deviceKey)
  registerCloudModels(hinted.runtime, hinted.binding, { baseUrl: cloud.origin, small: "small", large: "cerebras/qwen-3.8-27b", image: "vision" })
  const room = "00000000-0000-4000-8000-0000000000aa"
  const planner = conversationCache(hinted.runtime, room, "planner")
  try Effect.sync(() => cloud.script(text("off"), text("low"), text("other"), text("keyed"), text("unkeyed")))
  try host("thinking off on qwen", () => hinted.runtime.useModel(ModelType.TEXT_LARGE, { prompt: "Draft.", providerOptions: { eliza: { thinking: "off" } } }))
  try host("thinking low on qwen", () => hinted.runtime.useModel(ModelType.TEXT_LARGE, { prompt: "Plan.", providerOptions: { eliza: { thinking: "low" } } }))
  try host("thinking low elsewhere", () => hinted.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Plan.", providerOptions: { eliza: { thinking: "low" } } }))
  try host("planner key on qwen", () => hinted.runtime.useModel(ModelType.TEXT_LARGE, { prompt: "Plan.", providerOptions: planner }))
  try host("planner key elsewhere", () => hinted.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Plan.", providerOptions: planner }))
  const sent = cloud.calls.slice(-5).map((call) => call.body as Record<string, unknown>)
  const plannerKey = try Effect.try(() => `eliza-workflow-v1:${digest(`${JSON.stringify([hinted.runtime.agentId, room])}:planner`)}`)
  assert.deepStrictEqual(sent.map((body) => [body.reasoning_effort, "max_tokens" in body, JSON.stringify(body).includes("thinking"), body.prompt_cache_key]),
    [["none", false, false, undefined], ["low", false, false, undefined], [undefined, false, false, undefined],
      [undefined, false, false, plannerKey], [undefined, false, false, undefined]])

  try Effect.sync(() => cloud.script(refusal(400, "generation_error", { reason: "parser_error" }), text("not on cerebras")))
  const calls = completions(cloud)
  const unparsed = try refusalOf(ownKey.runtime, { prompt: "Call a tool." })
  const afterParse = [completions(cloud) - calls, (try ownKey.binding.read()).accountState]
  try host("own key off cerebras", () => ownKey.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Plan.", providerOptions: { eliza: { thinking: "low" } } }))
  assert.deepStrictEqual([unparsed?.code, unparsed?.status, ...afterParse], ["PROVIDER_TOOL_CALL_PARSE_FAILED", 400, 1, "provider_issue"])
  try Effect.sync(() => cloud.script(text("not on cerebras either")))
  try host("own key qwen off cerebras", () => ownKey.runtime.useModel(ModelType.TEXT_SMALL, { prompt: "Plan.", providerOptions: planner }))
  assert.deepStrictEqual(cloud.calls.slice(-2).map((call) => [(call.body as Record<string, unknown>).reasoning_effort, (call.body as Record<string, unknown>).prompt_cache_key]), [[undefined, undefined], [undefined, undefined]])
})

effect function refusalRead(cloud: CloudFake, replies: () => readonly CloudReply[], streamed: boolean) {
  const made = try cloudAgent(cloud)
  const before = completions(cloud)
  try Effect.sync(() => cloud.script(...replies()))
  const failure = try refusalOf(made.runtime, { prompt: "Call a tool.", ...(streamed ? { stream: true, onStreamChunk: () => undefined } : {}) })
  const view = try made.binding.read()
  return { code: failure?.code, status: failure?.status, waited: failure?.retryAfterMs, sent: completions(cloud) - before, state: view.accountState, retryAt: view.lastCloudFailure?.retryAt }
}

it.effect('A refusal inside a streamed answer is read as the HTTP refusal it names, and a cloud refusal\'s carried provider fields as a provider\'s own: an unparsed tool call is sent once, an overload is retried, a rate limit keeps its wait, a cloud refusal takes its code\'s status, and a frame naming no status is a provider issue (spec/agent/models/binding.md, "Only a network failure, an outage or a provider issue is retried, and a rate limit ends the call for its turn to re-send once"; spec/agent/models/binding.md, "A tool call the provider could not parse, or a streamed answer silent for a minute, ends the call without a retry")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const framed = (frames: readonly unknown[]) => refusalRead(cloud, () => frames.map(refusalFrame), true)
  const unparsedCall = { code: "parser_error", param: "tool_calls", providerMessage: "Failed to parse the tool call." }
  const unparsed = try framed([{ error: { provider_code: "parser_error", param: "tool_calls", message: "Bad Request", type: "invalid_request_error", code: 400, provider_message: "Failed to parse the tool call." } }])
  const cloudUnparsed = try framed([{ error: "invalid_request", errorDescription: "Invalid request.", retryable: false, ...unparsedCall }])
  const carriedUnparsed = try refusalRead(cloud, () => [refusal(400, "invalid_request", { carried: unparsedCall })], false)
  const carriedOverload = try refusalRead(cloud, () => [refusal(400, "invalid_request", { carried: { providerMessage: "The server is overloaded, please try again." } }), text("after the overload")], false)
  const limited = try framed([{ error: { message: "Rate limit exceeded. Please try again later.", type: "rate_limit_error", code: 429, retryAfterMs: 1_500 } }])
  const limitedInSeconds = try framed([{ error: { message: "Rate limited", type: "rate_limit_error", code: 429, retryAfterSeconds: 2 } }])
  const limitedWithoutWait = try framed([{ error: { message: "Rate limited", type: "rate_limit_error", code: 429, retryAfterMs: -1 } }])
  const cloudLimited = try framed([{ error: "rate_limited", errorDescription: "Rate limited.", retryable: true, retryAt: Date.now() + 60_000 }])
  const broken = try framed([1, 2, 3, 4].map(() => ({ error: { message: "Something broke." } })))
  const wait = (read: { waited?: unknown }) => typeof read.waited === "number" ? read.waited : -1
  const parseFailed = { code: "PROVIDER_TOOL_CALL_PARSE_FAILED", status: 400, waited: undefined, sent: 1, state: "provider_issue", retryAt: undefined }
  const waitedUpTo = (read: { waited?: unknown; retryAt?: unknown }, most: number) => ({ ...read, waited: wait(read) > 0 && wait(read) <= most, retryAt: typeof read.retryAt })
  assert.deepStrictEqual([unparsed, cloudUnparsed, carriedUnparsed, carriedOverload, waitedUpTo(limited, 2_000), waitedUpTo(limitedInSeconds, 2_000), limitedWithoutWait,
    waitedUpTo(cloudLimited, 60_000), broken], [
    parseFailed, parseFailed, parseFailed,
    { code: undefined, status: undefined, waited: undefined, sent: 2, state: "usable", retryAt: undefined },
    { code: "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED", status: 429, waited: true, sent: 1, state: "limit_reached", retryAt: "number" },
    { code: "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED", status: 429, waited: true, sent: 1, state: "limit_reached", retryAt: "number" },
    { code: "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED", status: 429, waited: undefined, sent: 1, state: "limit_reached", retryAt: undefined },
    { code: "MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED", status: 429, waited: true, sent: 1, state: "limit_reached", retryAt: "number" },
    { code: undefined, status: 503, waited: undefined, sent: 4, state: "provider_issue", retryAt: undefined },
  ])
})
