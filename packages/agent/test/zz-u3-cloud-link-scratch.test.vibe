// spec/agent/models/binding.md, "Plugins reach the cloud only through the cloud service of a cloud backend, and a managed Google change needs the owner's consent"
import { assert, it } from "@effect/vitest"
import { parseLaunch } from "../src/host/launch.vibe"
import { cloudLinkServices } from "../src/models/cloud-link.vibe"
import { googleProductPlugin } from "./support/product-plugin/index.ts"
import { answerJson, startCloudFake } from "./support/cloud-fake.ts"
import { launchDocument, launchFrame } from "./support/scratch.ts"

effect function attempt(origin: string, google: { gmailChanges: boolean; calendarEdits: boolean } | undefined, backend: "cloud" | "none") {
  const doc = launchDocument({ backend: backend === "cloud" ? { kind: "cloud", origin } : { kind: "none" }, ...(google === undefined ? {} : { google }) })
  const parsed = try parseLaunch(JSON.stringify(doc), JSON.stringify(launchFrame(backend === "cloud" ? { credential: { version: 1, value: "device-key" } } : {})))
  const classes = cloudLinkServices(parsed.launch, () => Redacted.make("device-key"))
  const service = classes[0] === undefined ? null : try Effect.promise(() => classes[0].start({} as any))
  const runtime = { getService: () => service } as any
  const result: any = try Effect.promise(() => googleProductPlugin.actions[0].handler(runtime, { content: {} } as any, undefined, undefined, undefined, undefined))
  return { classes: classes.length, data: result.data }
}

it.effect("u3 scratch: cloud link service and Google consent", effect () => {
  const fake = try Effect.promise(() => startCloudFake({ deviceKey: "device-key" }))
  fake.route("GET", "/api/v1/eliza/google/gmail/triage", answerJson({ threads: [] }))
  fake.route("POST", "/api/v1/eliza/google/calendar/events", answerJson({ id: "e1" }, 201))
  const off = try attempt(fake.origin, undefined, "cloud")
  assert.strictEqual(off.classes, 1)
  assert.deepStrictEqual(off.data.attempts.gmailChange, { kind: "changes-off", operation: "gmail_change" })
  assert.deepStrictEqual(off.data.attempts.calendarEdit, { kind: "changes-off", operation: "calendar_edit" })
  assert.deepStrictEqual(off.data.attempts.read, { kind: "answered", status: 200, body: { threads: [] } })
  assert.deepStrictEqual(fake.calls.map((c) => `${c.method} ${c.path}`), ["GET /api/v1/eliza/google/gmail/triage"])
  assert.strictEqual(fake.calls[0].authorization, "Bearer device-key")
  const cal = try attempt(fake.origin, { gmailChanges: false, calendarEdits: true }, "cloud")
  assert.deepStrictEqual(cal.data.attempts.gmailChange, { kind: "changes-off", operation: "gmail_change" })
  assert.deepStrictEqual(cal.data.attempts.calendarEdit, { kind: "answered", status: 201, body: { id: "e1" } })
  const none = try attempt(fake.origin, { gmailChanges: true, calendarEdits: true }, "none")
  assert.strictEqual(none.classes, 0)
  assert.deepStrictEqual(none.data, { linked: false })
  try Effect.promise(() => fake.close())
})
