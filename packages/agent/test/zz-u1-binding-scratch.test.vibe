// spec/agent/models/binding.md, "Keep the account state honest"
import { assert, it } from "@effect/vitest"
import { parseLaunch } from "../src/host/launch.vibe"
import { bindModels } from "../src/models/binding.vibe"
import { account, launchDocument, launchFrame } from "./support/scratch.ts"

const other = { userId: "someone-else", organizationId: "owner-org" }
const push = (b: any, body: unknown) => host("push", () => b.routes[0].handler({ body }))
const warm = (b: any) => host("warm", () => b.routes[1].handler({ body: undefined }))
effect function host<A>(step: string, call: () => Promise<A>) {
  return try Effect.tryPromise({ try: call, catch: (cause) => cause })
}

it.effect("u1 scratch: binding account state, push and warm", effect () => {
  const parsed = try parseLaunch(JSON.stringify(launchDocument({ backend: { kind: "cloud", origin: "https://cloud.example" } })), JSON.stringify(launchFrame({ credential: { version: 1, value: "k1" } })))
  const T = Date.now()
  const b = try bindModels(parsed.launch, parsed.authority)
  const r0 = try b.read()
  const w0 = try warm(b)
  const c1 = try b.startCall("TextSmall", T + 10)
  try b.refuseCall(c1 as number, T + 11, { tag: "CloudRateLimited", retryAt: T + 60000 })
  const r1 = try b.read()
  const limited = try b.startCall("TextSmall", T + 50)
  const w1 = try warm(b)
  const c2 = try b.startCall("TextSmall", T + 70000)
  const c3 = try b.startCall("TextLarge", T + 70000)
  try b.refuseCall(c2 as number, T + 70001, { tag: "CloudCredentialInvalid", reason: "" as any })
  const r2 = try b.read()
  const stale = try push(b, { version: 1, credential: "k1b", expiresAt: 0, account })
  const otherAcc = try push(b, { version: 2, credential: "k2", expiresAt: 0, account: other })
  const ok = try push(b, { version: 2, credential: "k2", expiresAt: 0, account })
  const r3 = try b.read()
  try b.refuseCall(c3 as number, T + 70002, { tag: "CloudCredentialInvalid", reason: "" as any })
  const r4 = try b.read()
  const c4 = try b.startCall("TextSmall", T + 70003)
  try b.answerCall(c4 as number, T + 70004)
  const r5 = try b.read()
  try Effect.try(() => assert.deepStrictEqual({
    r0, w0, r1, limited, w1, r2, stale, otherAcc, ok, r3, r4, r5, key: Redacted.value(b.credential()),
  }, {
    r0: { backend: "cloud", accountState: "usable", blocked: false },
    w0: { status: 200, body: { warm: "ready" } },
    r1: { backend: "cloud", accountState: "limit_reached", blocked: true, lastCloudFailure: { kind: "limit_reached", at: T + 11, retryAt: T + 60000 } },
    limited: "limited",
    w1: { status: 200, body: { warm: "blocked" } },
    r2: { backend: "cloud", accountState: "credential_invalid", blocked: true, lastCloudFailure: { kind: "credential_invalid", at: T + 70001 } },
    stale: { status: 409, body: { error: "credential_refused", reason: "stale_version" } },
    otherAcc: { status: 409, body: { error: "credential_refused", reason: "other_account" } },
    ok: { status: 200, body: { version: 2, accountState: "usable" } },
    r3: { backend: "cloud", accountState: "usable", blocked: false, lastCloudFailure: { kind: "credential_invalid", at: T + 70001 } },
    r4: { backend: "cloud", accountState: "usable", blocked: false, lastCloudFailure: { kind: "credential_invalid", at: T + 70001 } },
    r5: { backend: "cloud", accountState: "usable", blocked: false, lastCloudFailure: { kind: "credential_invalid", at: T + 70001 } },
    key: "k2",
  }))
})
