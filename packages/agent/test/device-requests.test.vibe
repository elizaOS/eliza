// spec/agent/deviceActions/index.md, "Story: Approve a device request once and learn exactly what happened"; spec/agent/deviceActions/capabilities.md, "Story: Offer the agent only what my device advertised"; spec/agent/deviceActions/operations.md, "Story: Propose only operations the device can check"
import { assert, it } from "@effect/vitest"
import { host, startInProcess } from "./support/kernel.vibe"

module node {
  import type { Memory, UUID } from "@elizaos/core"
  import { proposeDeviceActionServiceType, type DeviceActionAsk, type ProposeDeviceActionService } from "../src/device-actions/requests.vibe"
  import type { RunningAgent } from "../src/host/process.vibe"
  import { text, type CloudFake } from "./support/cloud-fake.ts"
  import { ask, deviceClient, openConversation } from "./support/device.ts"

  const reads = "calendar.next-read.v1"
  const creates = "calendar.create.v1"
  const both = `${reads}, ${creates}`
  const nextRead = (start: string, end: string) => ({ version: 1, kind: "calendar_read_next", window: { start, end, timeZone: "UTC" }, event: null })
  const readNext = { type: "calendar_read_next" }
  const createLocal = {
    type: "calendar_create_local",
    fields: { title: "Dentist", description: "", location: "", start: "2026-11-22T09:00:00.000Z", end: "2026-11-22T10:00:00.000Z", timeZone: "UTC" },
  }

  type Listed = { proposals: { id: string; digest: string; phase: { tag: string }; readReplyOrigin?: { requestId: string; conversationId: string; inReplyTo: string } }[] }

  export async function approveOnce(running: RunningAgent, socket: string, token: string, cloud: CloudFake) {
    const agentId = running.status.agentId
    const device = deviceClient(socket, token, agentId, reads)
    const memories = (roomId: UUID) => running.runtime.getMemories({ tableName: "messages", roomId, count: 20 })
    const service = running.runtime.getService(proposeDeviceActionServiceType) as ProposeDeviceActionService | null
    if (service === null) throw new Error("The device request service did not start")
    const propose = (asked: DeviceActionAsk) => service.propose(asked).then((offer) => offer, (error: { reason?: string }) => error.reason ?? String(error))
    const turn = (message: Memory, headers: Readonly<Record<string, string>>) => service.beginTurn(message, new Map(Object.entries(headers)))
    const listed = async (capabilities: string) => ((await device.call("GET", "/api/client-devices/proposals", undefined, capabilities)).json as Listed).proposals
    const phase = (answer: { status: number; json: unknown }) => answer.status === 200 ? (answer.json as { proposal: { phase: unknown } }).proposal.phase : answer.status

    const registered = await device.call("POST", "/api/client-devices/register", { capabilities: [reads, creates], workflowProtocol: 1 })
    const conversation = await openConversation(device)
    cloud.script(text("I will ask your phone."))
    const first = await ask(device, memories, agentId, conversation, "When is my next event?")
    await turn(first, { "x-eliza-device-capabilities": reads })
    const unauthorized = await propose({ message: first, operation: readNext })
    await turn(first, device.headers())
    const misshapen = await propose({ message: first, operation: { ...readNext, extra: 1 } })
    const unneeded = await propose({ message: first, operation: createLocal })
    const offered = await propose({ message: first, operation: readNext })
    const spare = await propose({ message: first, operation: readNext })
    if (typeof offered === "string" || typeof spare === "string") throw new Error(`The read was not offered: ${String(offered)}`)
    const p1 = `/api/client-devices/proposals/${offered.proposalId}`

    const shown = (await listed(reads)).find(({ id }) => id === offered.proposalId)
    const listedWithoutNeed = (await listed(creates)).some(({ id }) => id === offered.proposalId)
    const badHeader = (await device.call("GET", "/api/client-devices/proposals", undefined, `${reads}, ${reads}`)).status
    const wrongDigest = (await device.call("POST", `${p1}/decide`, { digest: "other", approved: true })).status
    const needNotMet = (await device.call("POST", `${p1}/decide`, { digest: offered.digest, approved: true }, creates)).status
    const approved = phase(await device.call("POST", `${p1}/decide`, { digest: offered.digest, approved: true }))
    const approvedAgain = phase(await device.call("POST", `${p1}/decide`, { digest: offered.digest, approved: true }))
    const claimed = await device.call("POST", `${p1}/claim`, { digest: offered.digest })
    const claimedAgain = (await device.call("POST", `${p1}/claim`, { digest: offered.digest })).status
    const result = nextRead("2026-11-21T00:00:00.000Z", "2026-12-21T00:00:00.000Z")
    const applied = { outcome: "applied", operationId: "native-1", result }
    const wrongAttempt = (await device.call("POST", `${p1}/receipt`, { digest: offered.digest, attemptId: 2, receipt: applied })).status
    const unsupported = (await device.call("POST", `${p1}/receipt`, { digest: offered.digest, attemptId: 1, receipt: { outcome: "applied", operationId: "native-1" } })).status
    const receipted = phase(await device.call("POST", `${p1}/receipt`, { digest: offered.digest, attemptId: 1, receipt: applied }))
    const repeated = phase(await device.call("POST", `${p1}/receipt`, { digest: offered.digest, attemptId: 1, receipt: applied }))
    const changedResult = (await device.call("POST", `${p1}/receipt`, {
      digest: offered.digest, attemptId: 1, receipt: { ...applied, result: nextRead("2026-11-22T00:00:00.000Z", "2026-12-22T00:00:00.000Z") },
    })).status
    const changedOutcome = (await device.call("POST", `${p1}/receipt`, { digest: offered.digest, attemptId: 1, receipt: { outcome: "unknown", operationId: "native-1" } })).status
    const kept = await running.runtime.adapter.transaction(async (tx) => {
      const sql = await tx.getConnection() as { query: (text: string, params: unknown[]) => Promise<{ rows: { result: unknown }[] }> }
      return (await sql.query("SELECT result FROM device_requests WHERE proposal_id = $1", [offered.proposalId])).rows[0]?.result
    })

    cloud.script(text("Let me add it."))
    const second = await ask(device, memories, agentId, conversation, "Add the dentist tomorrow at nine.")
    await turn(second, device.headers(both))
    const spareAfterTurn = (await listed(both)).some(({ id }) => id === spare.proposalId)
    const spareDecided = (await device.call("POST", `/api/client-devices/proposals/${spare.proposalId}/decide`, { digest: spare.digest, approved: true })).status
    const created = await propose({ message: second, operation: createLocal })
    if (typeof created === "string") throw new Error(`The creation was not offered: ${created}`)
    const p3 = `/api/client-devices/proposals/${created.proposalId}`
    await device.call("POST", `${p3}/decide`, { digest: created.digest, approved: true }, both)
    await device.call("POST", `${p3}/claim`, { digest: created.digest }, both)
    const uncertain = phase(await device.call("POST", `${p3}/receipt`, { digest: created.digest, attemptId: 1, receipt: { outcome: "unknown", operationId: "native-2" } }))
    const reviewed = phase(await device.call("POST", `${p3}/reconcile`, { digest: created.digest, attemptId: 1, review: "not_applied" }))
    const reviewedAgain = phase(await device.call("POST", `${p3}/reconcile`, { digest: created.digest, attemptId: 1, review: "not_applied" }))
    const reviewChanged = (await device.call("POST", `${p3}/reconcile`, { digest: created.digest, attemptId: 1, review: "applied" })).status
    const revoked = (await device.call("POST", "/api/client-devices/revoke", {})).status
    const afterRevoke = (await device.call("GET", "/api/client-devices/proposals")).status

    return {
      registered: registered.status, unauthorized, misshapen, unneeded,
      offered: { capability: offered.capability, readBack: offered.readBack, lifetime: offered.expiresAt - Date.now() > 590_000 },
      created: { capability: created.capability, readBack: created.readBack },
      shown: shown === undefined ? undefined : { phase: shown.phase.tag, origin: shown.readReplyOrigin === undefined ? undefined : { conversationId: shown.readReplyOrigin.conversationId, inReplyTo: shown.readReplyOrigin.inReplyTo } },
      expectedOrigin: { conversationId: conversation.id, inReplyTo: first.id },
      listedWithoutNeed, badHeader, wrongDigest, needNotMet, approved, approvedAgain,
      claimed: { status: claimed.status, attemptId: (claimed.json as { attemptId?: number }).attemptId }, claimedAgain,
      wrongAttempt, unsupported, receipted, repeated, changedResult, changedOutcome, kept, result,
      spareAfterTurn, spareDecided, uncertain, reviewed, reviewedAgain, reviewChanged, revoked, afterRevoke,
    }
  }
}

import { approveOnce } from node

it.effect('A device request is offered only for what the asking request negotiated, decided and claimed once, and settled by its receipt or review (spec/agent/deviceActions/index.md, "Story: Approve a device request once and learn exactly what happened")', effect () => {
  const started = try startInProcess({ cloud: true, launch: { callerRole: "owner", load: ["@elizaos/agent/device-actions"], hostContextRevision: 1 } })
  const cloud = started.cloud
  if (started.transport.kind !== "socket" || cloud === undefined) return try die(new Error("The journey needs the socket transport and the cloud fake"))
  const socket = started.transport.path
  const observed = try host("device request journey", () => approveOnce(started.agent, socket, started.frame.token, cloud))
  try Effect.try(() => assert.deepStrictEqual({ ...observed, expectedOrigin: undefined, result: undefined }, {
    registered: 200, unauthorized: "device_unauthorized", misshapen: "operation_refused", unneeded: "operation_refused",
    offered: { capability: "calendar.next-read.v1", readBack: true, lifetime: true },
    created: { capability: "calendar.create.v1", readBack: false },
    shown: { phase: "Offered", origin: observed.expectedOrigin },
    expectedOrigin: undefined,
    listedWithoutNeed: false, badHeader: 400, wrongDigest: 409, needNotMet: 409,
    approved: { tag: "Approved" }, approvedAgain: { tag: "Approved" },
    claimed: { status: 200, attemptId: 1 }, claimedAgain: 409,
    wrongAttempt: 409, unsupported: 409,
    receipted: { tag: "Receipted", reported: "ReportedApplied" }, repeated: { tag: "Receipted", reported: "ReportedApplied" },
    changedResult: 409, changedOutcome: 409, kept: observed.result, result: undefined,
    spareAfterTurn: false, spareDecided: 409,
    uncertain: { tag: "Receipted", reported: "ReportedUnknown" },
    reviewed: { tag: "Reviewed", reviewed: "ReviewedNotApplied" }, reviewedAgain: { tag: "Reviewed", reviewed: "ReviewedNotApplied" }, reviewChanged: 409,
    revoked: 200, afterRevoke: 401,
  }))
}, 180_000)
