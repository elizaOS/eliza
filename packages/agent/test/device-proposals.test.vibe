// spec/agent/deviceActions/index.md, "Story: Propose what I asked for on my phone, in my own words"
import { assert, it } from "@effect/vitest"
import { deviceActionsModuleName } from "../src/device-actions/proposal/module.vibe"
import { builtinModuleFactories } from "../src/plugins/profile.vibe"
import { cloudFake, deviceKey, host, startInProcess } from "./support/kernel.vibe"

module node {
  import { Effect, Result } from "effect"
  import type { AgentRuntime } from "@elizaos/core"
  import { registerDeviceProposalFamily, type DeviceProposalFamily, type Grounding } from "../src/device-actions/operations.vibe"
  import { text, toolCalls, type CloudFake } from "./support/cloud-fake.ts"
  import { deviceClient, type DeviceClient } from "./support/device.ts"

  export const proposeTool = "PROPOSE_DEVICE_ACTION"
  const negotiated = "notes.local-record.v1"
  const dueAt = "2026-11-23T09:00:00.000Z"
  const direct = { voiceUi: { viewDelivery: "completed-action", uiClientId: "renderer-1", agentActionMode: "direct-request-v1" } }
  const reminderForm = {
    type: "object", additionalProperties: false, required: ["type", "title", "dueAt"],
    properties: { type: { type: "string", enum: ["create_reminder"] }, title: { type: "string" }, dueAt: { type: "string" } },
  }

  const remindersFamily: DeviceProposalFamily = {
    name: "reminders", types: ["create_reminder"],
    forms: [{ types: ["create_reminder"], schema: reminderForm, guidance: "create_reminder saves a reminder the owner dictated.", offered: (turn) => turn.capabilities.includes(negotiated) }],
    guidance: () => "Reminders are saved on the owner's phone.",
    ground: (proposed, turn) => Effect.succeed<Grounding>(/\bremind\b/i.test(turn.ownerText)
      ? { kind: "Grounded", operation: proposed.operation, ...(/\bmaybe\b/i.test(turn.ownerText) ? { grounding: "GroundedForReview" as const } : {}) }
      : { kind: "Refused", code: "REMINDER_NOT_REQUESTED", forModel: "The owner did not ask for a reminder.", forOwner: "Tell me what to remind you of." }),
    proposedText: (operation) => ({ forOwner: `Review the reminder “${operation.type === "create_reminder" ? operation.title : ""}” on your phone.` }),
    settledText: () => ({ forOwner: "Your phone saved that reminder." }),
  }

  interface Turn {
    readonly text: string
    readonly userMessageId: string
  }
  interface Proposal {
    readonly id: string
    readonly digest: string
    readonly state: string
    readonly payload: Record<string, unknown>
    readonly execution?: { readonly attemptId: string; readonly reconciliation?: { readonly review: string } }
  }
  interface Completion {
    readonly messages?: readonly { readonly role?: string; readonly content?: unknown }[]
    readonly tools?: readonly { readonly function?: { readonly name?: string; readonly description?: string; readonly parameters?: { readonly properties?: { readonly operation?: { readonly anyOf?: readonly { readonly properties?: { readonly type?: { readonly enum?: readonly string[] } } }[] } } } } }[]
  }

  const reminder = (title: string) => ({ name: proposeTool, arguments: { operation: { type: "create_reminder", title, dueAt } } })
  const titled = (title: string) => ({ payload }: Proposal) => (payload.operation as { title?: string }).title === title
  const registered = async (runtime: AgentRuntime, family: DeviceProposalFamily) => {
    const result = await Effect.runPromise(Effect.result(registerDeviceProposalFamily(runtime, family)))
    return Result.isFailure(result) ? result.failure._tag : "registered"
  }

  async function proposals(client: DeviceClient): Promise<readonly Proposal[]> {
    return ((await client.call("GET", "/api/client-devices/proposals")).json as { proposals: readonly Proposal[] }).proposals
  }

  async function review(client: DeviceClient, proposal: Proposal, receipt: unknown) {
    await client.call("POST", `/api/client-devices/proposals/${proposal.id}/decision`, { digest: proposal.digest, decision: "approve" })
    const claimed = (await client.call("POST", `/api/client-devices/proposals/${proposal.id}/claim`, { digest: proposal.digest })).json as { proposal: Proposal }
    const attemptId = claimed.proposal.execution?.attemptId ?? ""
    const settled = await client.call("POST", `/api/client-devices/proposals/${proposal.id}/receipt`, { digest: proposal.digest, attemptId, receipt })
    return { attemptId, state: (settled.json as { proposal: Proposal }).proposal.state }
  }

  function lastCompletion(cloud: CloudFake, offset = 1): Completion {
    const asked = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions"))
    return asked[asked.length - offset]?.body as Completion
  }

  export async function proposeFromChat(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const registration = {
      first: await registered(runtime, remindersFamily), again: await registered(runtime, remindersFamily),
      rival: await registered(runtime, { ...remindersFamily, name: "files" }),
      foreignForm: await registered(runtime, { ...remindersFamily, name: "notes", types: ["notes_query"] }),
    }
    const client = deviceClient(socket, token, runtime.agentId, negotiated)
    const enrolled = (await client.call("POST", "/api/client-devices/register", { capabilities: [negotiated], workflowProtocol: 1 })).json as { enrollmentId: string }
    const { conversation } = (await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }
    const path = `/api/conversations/${conversation.id}/messages`
    const say = async (words: string, metadata?: object) =>
      (await client.call("POST", path, { text: words, ...(metadata === undefined ? {} : { metadata }) })).json as Turn
    const learned = (said: unknown, words: string) => JSON.stringify(said ?? "").includes(words)

    cloud.script(toolCalls("", { name: proposeTool, arguments: { operation: { type: "create_reminder", title: "Milk" } } },
      { name: proposeTool, arguments: { operation: JSON.stringify({ type: "create_reminder", title: "Milk", dueAt }) } }, reminder("Milk")), text("Done."))
    const asked = await say("Remind me to buy milk", direct)
    const offeredTool = lastCompletion(cloud, 2).tools?.find(({ function: tool }) => tool?.name === proposeTool)?.function
    const [milk] = await proposals(client)

    cloud.script(toolCalls("", reminder("Eggs")), text("Okay."))
    const refusedTurn = await say("Buy eggs too")
    const afterRefusal = (await proposals(client)).length

    cloud.script(toolCalls("", reminder("Milk")), text("Okay."))
    const heldTurn = await say("Did that go out?")
    const afterHeld = (await proposals(client)).length

    cloud.script(text("Sure."))
    await client.host("POST", path, { text: "Remind me to call mom" })
    const hostOnlyTools = (lastCompletion(cloud).tools ?? []).map(({ function: tool }) => tool?.name)

    const applied = milk === undefined ? undefined : await review(client, milk, { outcome: "applied", operationId: "reminder-1" })
    cloud.script(text("You saved a reminder about milk."))
    await say("What did I just save?")
    const remembered = lastCompletion(cloud).messages ?? []

    cloud.script(toolCalls("", reminder("Mom")), text("Done."))
    await say("Remind me to call mom")
    const mom = (await proposals(client)).find(titled("Mom"))
    const uncertain = mom === undefined ? undefined : await review(client, mom, { outcome: "unknown", operationId: "reminder-2" })
    const reconcile = (body: object) => client.call("POST", `/api/client-devices/proposals/${mom?.id}/reconciliation`, body)
    const extraField = await reconcile({ digest: mom?.digest, attemptId: uncertain?.attemptId, review: "not_applied", confirmed: true })
    const otherAttempt = await reconcile({ digest: mom?.digest, attemptId: "another-attempt", review: "not_applied" })
    const reviewed = await reconcile({ digest: mom?.digest, attemptId: uncertain?.attemptId, review: "not_applied" })
    const repeated = await reconcile({ digest: mom?.digest, attemptId: uncertain?.attemptId, review: "not_applied" })
    const reconciled = (reviewed.json as { proposal: Proposal }).proposal

    cloud.script(toolCalls("", reminder("Plants")), text("Done."))
    await say("Remind me to water the plants")
    const plants = (await proposals(client)).find(titled("Plants"))
    const declined = plants === undefined ? undefined
      : await client.call("POST", `/api/client-devices/proposals/${plants.id}/decision`, { digest: plants.digest, decision: "reject" })
    cloud.script(text("No, you declined it."))
    await say("Did the plants reminder go out?")
    const afterDecline = (lastCompletion(cloud).messages ?? []).at(-1)

    cloud.script(toolCalls("", reminder("Stretch")), text("Okay."))
    await say("Maybe remind me to stretch", direct)
    const stretch = (await proposals(client)).find(titled("Stretch"))

    return {
      registration,
      offered: {
        types: (offeredTool?.parameters?.properties?.operation?.anyOf ?? []).flatMap((form) => form.properties?.type?.enum ?? []).toSorted(),
        guided: offeredTool?.description?.includes("create_reminder saves a reminder") === true,
      },
      proposalReply: asked.text,
      milk: milk === undefined ? undefined : { state: milk.state, payload: milk.payload },
      expectedPayload: {
        action: "device_action", version: 1, installationId: runtime.agentId, enrollmentId: enrolled.enrollmentId,
        requestMessageId: asked.userMessageId, operation: { type: "create_reminder", title: "Milk", dueAt },
      },
      refusalReply: refusedTurn.text.includes("Tell me what to remind you of."), afterRefusal,
      held: { reply: heldTurn.text.includes("Review the reminder “Milk” on your phone."), afterHeld },
      hostOnlyOffered: hostOnlyTools.includes(proposeTool),
      applied: applied?.state,
      outcomeNote: {
        afterHistory: learned(remembered.at(-1), "supersedes older pending-approval dialogue") && learned(remembered.at(-1), '\\"operation\\":\\"create_reminder\\"') &&
          learned(remembered.at(-1), '\\"label\\":\\"Milk\\"') && learned(remembered.at(-1), milk?.id ?? "-"),
        inSystem: remembered.filter(({ role }) => role === "system").some((said) => learned(said, "supersedes older pending-approval dialogue")),
      },
      mom: { carriesMessage: mom === undefined ? undefined : "requestMessageId" in mom.payload, uncertain: uncertain?.state },
      reconcile: {
        extraField: extraField.status, otherAttempt: otherAttempt.status, reviewed: reviewed.status,
        state: reconciled.state, review: reconciled.execution?.reconciliation?.review, repeated: repeated.status,
      },
      decline: {
        status: declined?.status, neverRan: learned(afterDecline, "Rejected by the owner; it never ran."),
        uncertainUnlisted: !learned(afterDecline, mom?.id ?? "-"),
      },
      forReview: { state: stretch?.state, carriesMessage: stretch === undefined ? undefined : "requestMessageId" in stretch.payload },
    }
  }
}

import { proposeFromChat, proposeTool } from node

it.live(`An owner's chat request becomes one reviewed device proposal in its own words, a refusal offers nothing, and later turns learn what applied and what never ran (spec/agent/deviceActions/index.md, "Story: Propose what I asked for on my phone, in my own words"; spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/agent/deviceActions/index.md, "Each wire type belongs to at most one proposal family, and a family offers forms only of its own types"; spec/agent/deviceActions/index.md, "A proposal carries the owner's message only for a live turn that asked for it directly, so otherwise the phone shows its card"; spec/agent/deviceActions/index.md, "A proposal's identity is its request message and its operation, so a repeat returns the same request"; spec/agent/deviceActions/index.md, "A grounding refusal offers nothing and is a refusal before dispatch"; spec/agent/deviceActions/index.md, "A later turn of the same conversation learns at most six outcomes of its own requests: what changed, and what ended without running"; spec/agent/deviceActions/index.md, "Only a confirmed review settles an uncertain request"; spec/agent/conversation/planning.md, "An action may narrow its tool to the turn, never beyond its registered form"; spec/agent/conversation/planning.md, "A failure or proposal the turn made stays reported unless a later success of the same operation supersedes it"; spec/agent/conversation/planning.md, "Each call of a conversation starts with the same system prompt and tools, and what changes per turn follows the history")`, effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: {
      backend: { kind: "cloud", origin: cloud.origin }, callerRole: "owner", hostContextRevision: 1,
      load: [deviceActionsModuleName], allowed: ["REPLY", "IGNORE", "NONE", proposeTool],
    },
    frame: { credential: { version: 1, value: deviceKey } }, modules: builtinModuleFactories,
  })
  const { runtime } = agent.agent
  const socket = agent.transport.kind === "socket" ? agent.transport.path : ""
  const observed = try host("propose from chat", () => proposeFromChat(runtime, socket, agent.frame.token, cloud))
  const { expectedPayload, ...seen } = observed
  try Effect.try(() => assert.deepStrictEqual(seen, {
    registration: { first: "registered", again: "registered", rival: "FamilyConflict", foreignForm: "FamilyConflict" },
    offered: { types: ["create_reminder"], guided: true },
    proposalReply: "Review the reminder “Milk” on your phone.",
    milk: { state: "pending", payload: expectedPayload },
    refusalReply: true, afterRefusal: 1,
    held: { reply: true, afterHeld: 1 },
    hostOnlyOffered: false,
    applied: "done",
    outcomeNote: { afterHistory: true, inSystem: false },
    mom: { carriesMessage: false, uncertain: "reconciliation_required" },
    reconcile: { extraField: 400, otherAttempt: 409, reviewed: 200, state: "done", review: "not_applied", repeated: 200 },
    decline: { status: 200, neverRan: true, uncertainUnlisted: true },
    forReview: { state: "pending", carriesMessage: false },
  }))
}, 120_000)
