// spec/agent/access/auth.md, "Story: Admit only the supervising host"
import { assert, it } from "@effect/vitest"
import { authRoutes } from "../src/access/auth.vibe"
import { createRouter, refusedRoutes } from "../src/access/router.vibe"
import type { LocalRoute } from "../src/access/routes.vibe"
import type { ModuleFactory } from "../src/host/module.vibe"
import { boot, call as reach, host, ready, startInProcess } from "./support/kernel.vibe"
import { request, type LocalAnswer, type Refusal } from "./support/socket-client.ts"

const launchToken = "launch-token-epoch-1"
const agentId = "0b7c3a52-7e1f-4c55-9a4e-2f0d8b6c1e93"
const reached = (name: string) => () => ({ status: 200, body: { reached: name } })
const pluginRoutes: LocalRoute[] = [
  { method: "GET", path: "/api/plugin/x", public: true, handler: reached("plugin public") } as LocalRoute,
  { method: "GET", path: "/api/health", handler: reached("plugin health") },
  { method: "POST", path: "/api/auth/status", handler: reached("plugin auth status") },
  { method: "POST", path: "/api/conversations", handler: reached("conversations") },
  { method: "GET", path: "/api/events/stream", stream: true, handler: reached("events") },
]

const health = () => ({ status: 200, body: { ready: true, epoch: 1 } })
const router = createRouter({ token: Redacted.make(launchToken), epoch: 1, instanceId: "instance-1", health, routes: [...authRoutes(agentId), ...pluginRoutes] })

effect function call(method: string, target: string, authorization?: string) {
  const response = try host(`${method} ${target}`, () => router({ method, target, streamed: target.endsWith("/stream"), body: undefined, authorization }, new AbortController().signal))
  const body = try host("answer body", (): Promise<unknown> => response.json())
  return { status: response.status, body }
}

const callers = { none: undefined, wrong: "Bearer not-the-token", earlier: "Bearer launch-token-epoch-0", bare: launchToken }
const everyRoute = [["GET", "/api/health"], ["GET", "/api/auth/status"], ["GET", "/api/auth/me"], ["GET", "/api/plugin/x"], ["POST", "/api/conversations"], ["GET", "/api/events/stream"], ["GET", "/api/unknown"]] as const

it.effect('No token, a wrong token or an earlier launch token is Anonymous and reaches only health and auth status (spec/agent/access/auth.md, "Only the token of this launch makes a caller Root")', effect () => {
  for (const authorization of Object.values(callers)) {
    const answers = try Effect.forEach(everyRoute, ([method, target]) => call(method, target, authorization))
    try Effect.try(() => assert.deepStrictEqual(answers.map(({ status }) => status), [200, 200, 401, 401, 401, 401, 401], String(authorization)))
    try Effect.try(() => assert.deepStrictEqual(answers.slice(2).map(({ body }) => body), [0, 1, 2, 3, 4].map(() => ({ error: "unauthorized" }))))
    try Effect.try(() => assert.deepStrictEqual(answers[1].body, { authenticated: false, serverInstanceId: "instance-1" }))
  }
})

it.effect('A plugin route declared public stays Root-only and no plugin takes the two public paths (spec/agent/access/auth.md, "Only the agent\'s own health and auth status reads are public")', effect () => {
  const anonymous = try call("GET", "/api/plugin/x")
  const health = try call("GET", "/api/health")
  const status = try call("GET", "/api/auth/status")
  const postStatus = try call("POST", "/api/auth/status", `Bearer ${launchToken}`)
  try Effect.try(() => assert.deepStrictEqual(
    [anonymous.status, health.body, status.body, postStatus.status],
    [401, { ready: true, epoch: 1 }, { authenticated: false, serverInstanceId: "instance-1" }, 404]))
})

it.effect('The Root caller reaches every route and is the local owner (spec/agent/access/auth.md, "The Root caller is the local owner of this agent")', effect () => {
  const answers = try Effect.forEach(everyRoute, ([method, target]) => call(method, target, `Bearer ${launchToken}`))
  try Effect.try(() => assert.deepStrictEqual(answers.map(({ status }) => status), [200, 200, 200, 200, 200, 200, 404]))
  try Effect.try(() => assert.deepStrictEqual([answers[1].body, answers[2].body], [
    { authenticated: true, serverInstanceId: "instance-1" },
    { identity: { kind: "owner", id: agentId }, access: { role: "OWNER", mode: "local" } },
  ]))
})

it('A listener learns the delivery of the admitted route before it sets a deadline (spec/agent/access/auth.md, "A Root-only route admits only a caller holding the launch token")', () => {
  const at = (method: string, target: string) => router.delivery({ method, target, body: undefined, authorization: undefined })
  assert.deepStrictEqual(
    [at("GET", "/api/events/stream"), at("POST", "/api/conversations"), at("GET", "/api/unknown")],
    ["Streamed", "Buffered", undefined])
})

const ask = (path: string, socket: string, token?: string): Promise<LocalAnswer | Refusal> =>
  request(socket, { method: "GET", path, ...(token === undefined ? {} : { token }) })

it.effect('The token of an earlier launch is anonymous to the second child, and a User launch still answers Root as the owner (spec/agent/access/auth.md, "Story: Admit only the supervising host")', effect () => {
  const first = try boot({ launch: {}, frame: { epoch: 1 } })
  try ready(first)
  const second = try boot({ launch: { callerRole: "user" }, frame: { epoch: 2 } })
  try ready(second)
  const socket = second.state.file("agent.sock")
  const earlier = try host("earlier token", () => ask("/api/auth/me", socket, first.frame.token))
  const earlierStatus = try host("earlier status", () => ask("/api/auth/status", socket, first.frame.token))
  const current = try host("current token", () => ask("/api/auth/me", socket, second.frame.token))
  const health = try host("health", () => ask("/api/health", socket))
  try Effect.try(() => assert.deepStrictEqual(
    ["status" in earlier ? [earlier.status, earlier.json] : earlier,
      "status" in earlierStatus ? (earlierStatus.json as { authenticated: boolean }).authenticated : earlierStatus,
      "status" in current ? (current.json as { access: unknown }).access : current,
      "status" in health ? (health.json as { epoch: number }).epoch : health],
    [[401, { error: "unauthorized" }], false, { role: "OWNER", mode: "local" }, 2]))
}, 300_000)

it.effect('The chat principal of a User launch is a member, not the owner, although its requests arrive as Root (spec/agent/access/auth.md, "The Root caller is the local owner of this agent")', effect () => {
  const principal = effect (callerRole: "owner" | "user") => {
    const { agent, transport, frame } = try startInProcess({ launch: { callerRole } })
    const worlds = try host("device worlds", () => agent.runtime.getAllWorlds())
    const me = try reach({ transport, frame }, { method: "GET", path: "/api/auth/me" })
    const device = worlds.find((world) => world.name === "Device")
    return {
      owner: device?.metadata?.ownership?.ownerId === agent.runtime.agentId ? "agent" : "speaker",
      roles: Object.values(device?.metadata?.roles ?? {}),
      access: "status" in me ? (me.json as { access: unknown }).access : me,
    }
  }
  const user = try principal("user")
  const owner = try principal("owner")
  try Effect.try(() => assert.deepStrictEqual([user, owner], [
    { owner: "agent", roles: ["MEMBER"], access: { role: "OWNER", mode: "local" } },
    { owner: "speaker", roles: ["OWNER"], access: { role: "OWNER", mode: "local" } },
  ]))
}, 300_000)

const badRoute = { method: "GET", path: "/api/notes/:id", handler: reached("notes") } as LocalRoute

it('One malformed plugin route refuses the whole list and the router is never built over it (spec/agent/access/routes.md, "A list is loaded whole or not at all")', () => {
  assert.deepStrictEqual([refusedRoutes(pluginRoutes), refusedRoutes([...pluginRoutes, badRoute])], [[], ["GET /api/notes/:id"]])
  assert.throws(() => createRouter({ token: Redacted.make(launchToken), epoch: 1, instanceId: "instance-1", health, routes: [...pluginRoutes, badRoute] }), /refused whole/)
})

it.effect('A module with a malformed route stops the boot as a configuration failure (spec/agent/access/routes.md, "A list is loaded whole or not at all")', effect () => {
  const factory: ModuleFactory<never> = () => Effect.succeed({ name: "notes", plugin: { name: "notes", description: "Notes", routes: [badRoute] } })
  const started = try Effect.result(startInProcess({ launch: { load: ["notes"] }, modules: new Map([["notes", factory]]) }))
  try Effect.try(() => assert.deepStrictEqual(Result.isFailure(started) ? [started.failure._tag, "phase" in started.failure ? started.failure.phase : undefined] : "started", ["AgentBootFailed", "Config"]))
}, 300_000)
