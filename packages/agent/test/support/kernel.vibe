// spec/agent/host/launch.md, "Story: Start the agent from one launch document"; spec/agent/host/resources.md, "Story: Release everything I acquired, once"; spec/agent/access/transport.md, "Story: Answer each local request exactly once"; spec/agent/conversation/events.md, "Story: Hear about my conversations while my screen is open"
import type { DeviceStorageSnapshot } from "../../src/storage/index.vibe"
import type { AgentPlugin, ModuleFactory } from "../../src/host/module.vibe"
import type { RunningAgent } from "../../src/host/process.vibe"
import { freePort, startAgentChild, type AgentChild, type AgentRun, type Transport } from "./child.ts"
import { startCloudFake, type CloudFake } from "./cloud-fake.ts"
import { httpRequest, httpRequestStream, httpSubscribe } from "./http-client.ts"
import { launchDocument, launchFrame, scratchDirectory, writeLaunch, type FrameOptions, type LaunchFrame, type LaunchOptions, type Scratch } from "./scratch.ts"
import { request, requestStream, subscribe, type LocalAnswer, type LocalRequest, type Refusal, type StreamCut, type StreamedAnswer, type Subscription } from "./socket-client.ts"

export error SupportFailed { step: string; cause: unknown }

export effect function host<A>(step: string, call: () => Promise<A>) {
  return try tryPromise({ try: () => call(), catch: (cause) => new SupportFailed({ step, cause }) })
}

export effect function scratch(prefix: string) {
  return try acquireRelease(host("scratch", () => scratchDirectory(prefix)), (made: Scratch) => orDie(host("scratch removal", () => made.remove())))
}

export effect function cloudFake(deviceKey: string) {
  return try acquireRelease(host("cloud fake", () => startCloudFake({ deviceKey })), (fake: CloudFake) => orDie(host("cloud fake close", () => fake.close())))
}

export effect function agentChild(run: AgentRun) {
  return try acquireRelease(
    Effect.try({ try: () => startAgentChild(run), catch: (cause) => new SupportFailed({ step: "agent child", cause }) }),
    (child: AgentChild) => orDie(host("agent child stop", () => child.stop())),
  )
}

export interface Booted {
  readonly child: AgentChild
  readonly state: Scratch
  readonly frame: LaunchFrame
  readonly transport: Transport
  readonly cloud: CloudFake | undefined
}

export interface BootOptions {
  readonly launch?: LaunchOptions
  readonly frame?: FrameOptions
  readonly cloud?: boolean
  readonly http?: boolean
  readonly env?: Readonly<Record<string, string>>
  readonly state?: Scratch
  readonly entry?: string
}

export const deviceKey = "device-key-1"

effect function prepare(options: BootOptions) {
  const state = options.state === undefined ? try scratch("agent-state") : options.state
  const cloud = options.cloud === true ? try cloudFake(deviceKey) : undefined
  const launch = cloud === undefined ? options.launch : { ...options.launch, backend: options.launch?.backend ?? { kind: "cloud" as const, origin: cloud.origin } }
  const document = launchDocument(launch)
  const frame = launchFrame(cloud === undefined ? options.frame : { credential: { version: 1, value: deviceKey }, ...options.frame })
  const transport: Transport = options.http === true
    ? { kind: "http", port: try host("free port", () => freePort()) }
    : { kind: "socket", path: state.file("agent.sock") }
  return { state, cloud, document, frame, transport }
}

export effect function boot(options: BootOptions = {}) {
  const { state, cloud, document, frame, transport } = try prepare(options)
  const launchFile = try host("launch file", () => writeLaunch(state, document))
  const child = try agentChild({
    launchFile,
    stateDir: state.path,
    frame,
    transport,
    env: { ...options.env, ...(cloud === undefined ? {} : { NODE_EXTRA_CA_CERTS: cloud.caFile }) },
    ...(options.entry === undefined ? {} : { entry: options.entry }),
  })
  return { child, state, frame, transport, cloud } satisfies Booted
}

export effect function ready(booted: Booted) {
  return try host("readiness", () => booted.child.ready())
}

export interface InProcessOptions extends BootOptions {
  readonly bundled?: ReadonlyMap<string, AgentPlugin>
  readonly modules?: ReadonlyMap<string, ModuleFactory<never>>
  readonly snapshot?: DeviceStorageSnapshot
}

export interface InProcess {
  readonly agent: RunningAgent
  readonly state: Scratch
  readonly frame: LaunchFrame
  readonly transport: Transport
  readonly cloud: CloudFake | undefined
}

export effect function startInProcess(options: InProcessOptions = {}) {
  const { state, cloud, document, frame, transport } = try prepare(options)
  const [{ parseLaunch }, { startAgent }] = try host("agent host modules", () =>
    Promise.all([import("../../src/host/launch.vibe"), import("../../src/host/process.vibe")]))
  const parsed = try parseLaunch(JSON.stringify(document), JSON.stringify(frame))
  const agent = try acquireRelease(
    startAgent({
      ...parsed, stateDirectory: state.path, binding: transport,
      ...(options.bundled === undefined ? {} : { bundled: options.bundled }),
      ...(options.modules === undefined ? {} : { modules: options.modules }),
      ...(options.snapshot === undefined ? {} : { snapshot: options.snapshot }),
    }),
    (running: RunningAgent) => orDie(host("agent stop", () => running.stop())),
  )
  return { agent, state, frame, transport, cloud } satisfies InProcess
}

export interface Reachable {
  readonly transport: Transport
  readonly frame: LaunchFrame
}

const authorized = (reachable: Reachable, asked: LocalRequest): LocalRequest => ({ ...asked, token: asked.token ?? reachable.frame.token })

export effect function call(reachable: Reachable, asked: LocalRequest) {
  const transport = reachable.transport
  const signed = authorized(reachable, asked)
  return try host(`${asked.method} ${asked.path}`, (): Promise<LocalAnswer | Refusal> =>
    transport.kind === "socket" ? request(transport.path, signed) : httpRequest(transport.port, signed))
}

export effect function stream(reachable: Reachable, asked: LocalRequest, cut?: StreamCut, opened?: (status: number) => void) {
  const transport = reachable.transport
  const signed = authorized(reachable, asked)
  return try host(`${asked.method} ${asked.path} stream`, (): Promise<StreamedAnswer> =>
    transport.kind === "socket" ? requestStream(transport.path, signed, cut, opened) : httpRequestStream(transport.port, signed, cut, opened))
}

export effect function events(reachable: Reachable, streams: readonly string[], clientId?: string) {
  const transport = reachable.transport
  const options = { streams, token: reachable.frame.token, ...(clientId === undefined ? {} : { clientId }) }
  return try acquireRelease(
    Effect.sync((): Subscription => transport.kind === "socket" ? subscribe(transport.path, options) : httpSubscribe(transport.port, options)),
    (feed: Subscription) => Effect.sync(() => feed.close()),
  )
}
