// spec/agent/deviceActions/telephony.md, "The model asks which of alternative SMS recipients is meant, in its own words, before any lookup"
// spec/agent/deviceActions/telephony.md, "Story: Call or text the person I named, as I named them"; spec/agent/deviceActions/telephony.md, "Story: Draft my text to the person I addressed, and read the sender only as I asked"; spec/agent/deviceActions/telephony.md, "Story: Hear what my phone did with a call, text or contact change, as far as it shows"; spec/agent/deviceActions/capabilities.md, "A newer operation cannot use an older capability version"
import { assert, it } from "@effect/vitest"
import type { DeviceOperation } from "../src/device-actions/operations.schema.vibe"
import { phoneDialNumber, writtenPhoneNumbers } from "../src/device-actions/proposal/telephony/dial-number.vibe"
import { groundTelephonyTarget } from "../src/device-actions/proposal/telephony/grounding.vibe"
import { requestedSmsDraftRecipient } from "../src/device-actions/proposal/telephony/request.vibe"
import { deviceJourney } from "./support/device-agent.vibe"

module node {
  import { setTimeout as wait } from "node:timers/promises"
  import type { AgentRuntime } from "@elizaos/core"
  import { held, text as reply, toolCalls, type CloudFake } from "./support/cloud-fake.ts"
  import { deviceClient, type DeviceClient } from "./support/device.ts"
  import { bindingHash } from "../src/device-actions/operation-schemas/telephony.vibe"

  export const proposeTool = "PROPOSE_DEVICE_ACTION"
  const capabilities = [
    "phone.call.v1", "phone.dial.v1", "phone.keypad.v1", "sms.compose.v1", "sms.compose.v2", "sms.send.v1", "contacts.write.v1", "contacts.write.v2",
    "contacts.show.v1", "contacts.read.v1", "sms.latest-sender.v2",
  ]

  interface Turn {
    readonly text: string
    readonly userMessageId: string
  }
  interface Proposal {
    readonly id: string
    readonly digest: string
    readonly state: string
    readonly payload: { readonly requestMessageId?: string; readonly operation: unknown }
    readonly execution?: { readonly attemptId: string }
    readonly readReplyOrigin?: Record<string, unknown>
  }

  const propose = (operation: unknown) => ({ name: proposeTool, arguments: { operation } })
  const direct = { voiceUi: { viewDelivery: "completed-action", uiClientId: "renderer-1", agentActionMode: "direct-request-v1" } }
  const call = (number: string) => ({ type: "phone_call", target: { kind: "number", number } })
  const callContact = (query: string) => ({ type: "phone_call", target: { kind: "contact", query } })
  const text = (target: unknown, body: string) => ({ type: "sms_compose", target, body })
  const named = (query: string) => ({ kind: "contact", query })
  const numbered = (number: string) => ({ kind: "number", number })

  async function proposals(client: DeviceClient): Promise<readonly Proposal[]> {
    return ((await client.call("GET", "/api/client-devices/proposals")).json as { proposals: readonly Proposal[] }).proposals
  }

  const reportOf = /The step's own report: (".*")$/mu
  export const retold = "I didn't set that up, so nothing was called, sent or saved. Tell me who or what to use instead."

  function reportedTo(calls: readonly { readonly path: string; readonly body: unknown }[]): string | undefined {
    const note = calls.filter(({ path }) => path.endsWith("/chat/completions")).flatMap(({ body }) => {
      const last = (body as { messages?: readonly { content?: unknown }[] }).messages?.at(-1)?.content
      return typeof last === "string" && last.startsWith("Note from the agent host, not the person: your reply is not final yet.") ? [last] : []
    }).at(-1)
    const quoted = note === undefined ? undefined : reportOf.exec(note)?.[1]
    return quoted === undefined ? undefined : JSON.parse(quoted) as string
  }

  const sameOperation = (operation: unknown) => ({ payload }: Proposal) => JSON.stringify(payload.operation) === JSON.stringify(operation)

  async function applied(client: DeviceClient, proposal: Proposal, operationId: string, result: unknown): Promise<string> {
    const at = `/api/client-devices/proposals/${proposal.id}`
    await client.call("POST", `${at}/decision`, { digest: proposal.digest, decision: "approve" })
    const claimed = (await client.call("POST", `${at}/claim`, { digest: proposal.digest })).json as { proposal: Proposal }
    const attemptId = claimed.proposal.execution?.attemptId ?? ""
    const receipt = await client.call("POST", `${at}/receipt`, { digest: proposal.digest, attemptId, receipt: { outcome: "applied", operationId, result } })
    if (receipt.status !== 200) throw new Error("The applied receipt was refused: " + JSON.stringify(receipt.json))
    return attemptId
  }

  async function deliverSender(client: DeviceClient, read: Proposal): Promise<string | undefined> {
    const attemptId = await applied(client, read, "sender-1", { kind: "sms-latest-sender", status: "found", address: "+14155550124", threadId: "thread:42" })
    const completed = await client.call("POST", `/api/client-devices/proposals/${read.id}/read-completion`, { ...read.readReplyOrigin, proposalId: read.id, digest: read.digest, attemptId })
    return (completed.json as { reply?: { text?: string } }).reply?.text
  }

  async function offeredDuringTurn(client: DeviceClient, operation: unknown): Promise<Proposal> {
    const deadline = Date.now() + 25_000
    for (;;) {
      const offered = (await proposals(client)).find(sameOperation(operation))
      if (offered !== undefined) return offered
      if (Date.now() >= deadline) throw new Error("The turn never offered its proposal")
      await wait(20)
    }
  }

  /** @throws {never} */
  export async function roleGuidanceFromChat(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const client = deviceClient(socket, token, runtime.agentId, capabilities.join(","))
    await client.call("POST", "/api/client-devices/register", { capabilities, workflowProtocol: 1 })
    const { conversation } = (await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }
    const path = `/api/conversations/${conversation.id}/messages`
    const requests = () => cloud.calls.filter(({ path }) => path.endsWith("/chat/completions"))
    type WireTool = { readonly function?: { readonly name?: string; readonly description?: string } }
    const toolAt = (index: number) =>
      (requests()[index]?.body as { tools?: readonly WireTool[] } | undefined)?.tools?.find(({ function: tool }) => tool?.name === proposeTool)
    const turns = [
      { text: "First check.", caps: ["phone.call.v1", "sms.compose.v1", "sms.compose.v2", "contacts.show.v1"] },
      { text: "Second check.", caps: ["phone.call.v1", "sms.compose.v1", "sms.compose.v2", "contacts.show.v1"] },
      { text: "Third check.", caps: ["phone.call.v1", "sms.compose.v1", "contacts.show.v1"] },
      { text: "Fourth check.", caps: ["sms.compose.v1", "sms.compose.v2"] },
      { text: "Fifth check.", caps: ["phone.dial.v1", "phone.keypad.v1", "sms.compose.v1", "contacts.show.v1"] },
      { text: "Sixth check.", caps: ["sms.compose.v1", "sms.compose.v2", "contacts.show.v1"] },
    ]
    const offered = []
    for (const row of turns) {
      const index = requests().length
      cloud.script(reply("Okay."))
      await client.call("POST", path, { text: row.text }, row.caps.join(","))
      offered.push(toolAt(index))
    }
    const operation = callContact("dentist")
    const before = requests().length
    cloud.script(toolCalls("", propose(operation)), reply("Okay."))
    await client.call("POST", path, { text: "ring the dentist", metadata: direct })
    const submitted = await proposals(client)
    const pending = submitted.find(sameOperation(operation))
    return {
      stable: JSON.stringify(offered[0]) === JSON.stringify(offered[1]),
      guidance: offered.map((tool) => {
        const description = tool?.function?.description ?? ""
        return {
          scopes: ["phone_call or sms_compose", "phone_call", "sms_compose"].filter((scope) => description.includes(`Propose ${scope} with a contact target`)),
          mentions: description.split("names them by a role or relation").length - 1,
          skipLookup: /Do not propose contact_show first for a (call or text|call|text)\./u.exec(description)?.[1] ?? null,
        }
      }),
      calls: requests().length - before,
      proposal: pending?.state,
      proposedOperations: submitted.map(({ payload }) => payload.operation),
    }
  }

  /** @throws {never} */
  export async function smsReceiptFromChat(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const client = deviceClient(socket, token, runtime.agentId, capabilities.join(","))
    await client.call("POST", "/api/client-devices/register", { capabilities, workflowProtocol: 1 })
    const create = async () => ((await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }).conversation.id
    const own = await create()
    const other = await create()
    const send = (id: string, text: string) => client.call("POST", "/api/conversations/" + id + "/messages", { text, metadata: direct })
    const sms = { type: "sms_send", recipients: ["+1 415 555 0162"], body: "fixture text to keep out of the receipt", subscriptionId: 1 }
    cloud.script(toolCalls("", propose(sms)), reply("Review this send on your phone."))
    const response = await send(own, "Send an SMS to +1 415 555 0162 saying fixture text to keep out of the receipt")
    const turn = response.json as { actionResults?: readonly { data?: { proposalId?: string } }[] }
    const proposalId = turn.actionResults?.[0]?.data?.proposalId
    const pending = (await proposals(client)).find(({ id }) => id === proposalId)
    const operation = pending?.payload.operation as typeof sms | undefined
    if (pending === undefined || operation?.type !== "sms_send" || operation.body !== sms.body)
      throw new Error("The turn did not offer its SMS for review")
    const { body, recipients, subscriptionId, type } = operation
    await applied(client, pending, pending.id, {
      kind: "sms-send", operationId: pending.id, bindingHash: bindingHash({ body, recipients, subscriptionId, type }), subscriptionId, status: "submitted", createdAt: 1,
      parts: [{ index: 0, recipientIndex: 0, partIndex: 0, sent: "unknown", delivery: "unknown" }],
    })
    const notes = async (id: string) => {
      const starting = cloud.calls.length
      cloud.script(reply("I checked the request history."))
      await send(id, "What became of the request I approved?")
      return cloud.calls.slice(starting).flatMap(({ body }) => {
        const messages = (body as { messages?: readonly { content?: unknown }[] }).messages ?? []
        return messages.flatMap(({ content }) => typeof content === "string" && content.includes("device request outcomes, retrieved fresh") ? [content] : [])
      })
    }
    const original = await notes(own)
    const unrelated = await notes(other)
    return {
      originalStatus: original.some((line) => line.includes('"smsStatus":"submitted"') && line.includes(pending.id)),
      guidance: original.some((line) => line.includes("Submitted is not sent, and sent is not delivered")),
      privateText: original.some((line) => line.includes(sms.body)),
      otherProposal: unrelated.some((line) => line.includes(pending.id) || line.includes('"smsStatus"')),
      settled: (await proposals(client)).filter(({ id }) => id === pending.id).map(({ state }) => state),
    }
  }

  /** @throws {never} */
  export async function telephonyFromChat(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const client = deviceClient(socket, token, runtime.agentId, capabilities.join(","))
    await client.call("POST", "/api/client-devices/register", { capabilities, workflowProtocol: 1 })
    const { conversation } = (await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }
    const path = `/api/conversations/${conversation.id}/messages`
    const ask = async (words: string, operation: unknown, refused = false) => {
      const before = new Set((await proposals(client)).map(({ id }) => id))
      const sent = cloud.calls.length
      cloud.script(toolCalls("", propose(operation)), reply("Okay."), ...(refused ? [reply(retold)] : []))
      const turn = (await client.call("POST", path, { text: words, metadata: direct })).json as Turn
      const offered = (await proposals(client)).find(({ id }) => !before.has(id))
      const told = reportedTo(cloud.calls.slice(sent))
      return {
        reply: told ?? turn.text, operation: offered?.payload.operation,
        ...(told === undefined ? {} : { heard: turn.text }),
        ...(offered !== undefined && offered.payload.requestMessageId !== turn.userMessageId ? { reviewed: true } : {}),
      }
    }

    const callsBeforeChoice = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).length
    const proposalsBeforeChoice = (await proposals(client)).length
    const choices = []
    for (const [words, asked] of [["Can you text Carson or Maya that dinner is covered?", "Carson or Maya?"], ["Send an SMS to Carson or 415-555-0162 saying dinner is covered.", "To Carson, or to that number?"]] as const) {
      cloud.script(reply(asked))
      const turn = (await client.call("POST", path, { text: words, metadata: direct })).json as Turn
      choices.push(turn.text)
    }
    const choiceTools = (cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).at(-1)?.body as { tools?: readonly { readonly function?: { readonly name?: string; readonly description?: string } }[] } | undefined)?.tools ?? []
    const alternativeRecipients = {
      replies: choices,
      completionCalls: cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).length - callsBeforeChoice,
      proposals: (await proposals(client)).length - proposalsBeforeChoice,
      guided: choiceTools.some(({ function: tool }) => tool?.name === proposeTool && tool.description?.includes("A proposal has one recipient: when the owner gives alternatives") === true),
    }
    const alternativeInBody = await ask("Text Carson saying choose green or blue that matches.", text(named("Carson"), "choose green or blue that matches."))
    const toldRecipient = await ask("Thank you. Can you text Carson and tell him to bring the ice and that we've got dinner covered?", text(named("Cole"), "Please bring the ice. We have dinner covered."))
    const saidRecipient = await ask("Can you send a text to Carson and say dinner is covered?", text(named("Cole"), "dinner is covered"))
    const handedThrough = await ask("call 415-555-0100", call("6505715862"))
    const heldReply = await ask("did you set that call up?", call("4155550100"), true)
    const heldCall = { reply: heldReply.reply, requests: (await proposals(client)).filter(sameOperation(call("4155550100"))).map(({ state }) => state) }
    const separatedCall = await ask("can you call 415-555-0161 when you get a sec", call("415-555-0161"))
    const separatedSend = await ask("send an SMS to +1 415 555 0162 saying hi", { type: "sms_send", recipients: ["+1 415 555 0162"], body: "hi", subscriptionId: 1 })
    const separatedContact = await ask("save Ana as a contact with 415-555-0163", {
      type: "contact_create", contact: { displayName: "Ana", phoneNumbers: ["415-555-0163"], emailAddresses: [] },
    })
    const ownerDialForm = await ask("could you ring +44 (0)20 7946 0958 after lunch", call("+442079460958"))
    const invented = await ask("can you call 415-555-0100 when you get a sec", call("6505715862"), true)
    const noNumber = await ask("call the pharmacy back", call("6505715862"), true)
    const callBack = await ask("call mom back", callContact("Mom"))
    const authoredSurname = await ask("call Sam Back", callContact("Shaw"))
    const draftedSurname = await ask("text Sam Back saying hi", text({ kind: "contact", query: "Sam" }, "hi"))
    const surnameWithCourtesy = await ask("Call Ana Maria Silva Back please", callContact("Ana Maria Silva"))
    const prefixCallback = await ask("call back Jo", callContact("Jo"))
    const unnamed = await ask("call my landlord back today", { type: "phone_call", target: { kind: "contact", query: "Shaw" } }, true)
    const bodyNumber = await ask("text Sam saying call me at 415-555-0100", text(numbered("4155550100"), "call me at 415-555-0100"))
    const keypad = await ask("open the dialer and type 415 302 4399", { type: "phone_dial", target: numbered("6505715862") })
    const dialName = await ask("dial Sam", { type: "phone_dial", target: numbered("6505715862") }, true)
    const emergency = await ask("call an ambulance", call("911"))
    const emergencyKeypad = (await proposals(client)).find(sameOperation({ type: "phone_keypad" }))
    if (emergencyKeypad !== undefined) await applied(client, emergencyKeypad, "keypad-1", { kind: "phone-keypad", status: "opened" })
    const emptyKeypad = await ask("open the dialer", { type: "phone_keypad" })
    const writtenEmergency = await ask("call 911", call("911"))
    const spokenEmergency = await ask("call nine one one", call("911"))
    const spokenNines = await ask("call nine nine nine", call("999"))
    const spokenEmergencyByName = await ask("my dad fell, call nine one one", callContact("nine one one"))
    const nameInNumberWords = await ask("call Seven Eleven", callContact("Seven Eleven"))
    const nameInNumberWordsInvented = await ask("call Seven Eleven", call("6505715862"))
    const spokenEmergencyOtherNumber = await ask("call nine one one", call("112"))
    const contactNumber = await ask("save Ana as a contact with 415-555-0199", {
      type: "contact_create", contact: { displayName: "Ana", phoneNumbers: ["6505715862"], emailAddresses: [] },
    }, true)
    const contactEmail = await ask("save Ana as a contact with ana@example.com", {
      type: "contact_create", contact: { displayName: "Ana", phoneNumbers: [], emailAddresses: ["ana@invented.example"] },
    }, true)
    const draft = await ask("Draft a text to Sam to ask him about dinner tonight", {
      type: "sms_send", recipients: ["6505715862"], body: "Are we on for dinner tonight?", subscriptionId: 1,
    })
    const draftToNumber = await ask("Draft a text to 415-555-0124 saying hi", { type: "sms_send", recipients: ["6505715862"], body: "hi", subscriptionId: 1 })
    const draftAskFirst = await ask("Draft a text to 415-555-0124 saying hi, but ask me first", text(numbered("4155550124"), "hi"))
    const unclear = await ask("Draft a text to Sam and Ana saying hi", text(named("Sam"), "hi"), true)
    const composedNumber = await ask("I'm running late, so please let 415-555-0100 know by text", text(numbered("415-555-0100"), "I'm running late"))
    const contactUpdate = await ask("change Bob's number to 415-555-0177", { type: "contact_update", query: "Bob", set: { phoneNumbers: ["4155550177"] } })
    const contactAdd = await ask("add 415-555-0188 to Sam", { type: "contact_update", query: "Sam", add: { phoneNumbers: ["415-555-0188"] } })
    const contactDelete = await ask("delete that contact", { type: "contact_delete", query: "Bob" })
    const contactNoNumber = await ask("save the number that just texted me as Ana", {
      type: "contact_create", contact: { displayName: "Ana", phoneNumbers: ["6505715862"], emailAddresses: [] },
    })
    const contactShow = await ask("find Maya in my contacts", { type: "contact_show", query: "Maya" })
    const contactRead = await ask("use the contact I have open", { type: "contact_read_selected" })
    const simSendToName = await ask("text Sam saying I'm late", { type: "sms_send", recipients: ["6505715862"], body: "I'm late", subscriptionId: 1 }, true)
    const threadReply = await ask("Draft a reply saying I'll be there soon", { type: "sms_reply_selected", body: "I'll be there soon" })
    const draftToNobody = await ask("Draft a text to someone saying hi", text(named("someone"), "hi"), true)
    const draftToTwoNumbers = await ask("Draft a text to 415-555 0100 0199 saying hi", text(numbered("4155550100"), "hi"), true)
    const callEveryone = await ask("call everyone", { type: "phone_call", target: { kind: "contact", query: "everyone" } }, true)
    const partial = await ask("Who sent my latest text? Only the first three digits", { type: "sms_latest_sender" }, true)

    cloud.script(toolCalls("", propose(JSON.stringify(call("4155550142"))), propose({ type: "phone_call", target: { kind: "contact", query: "dad" } })), reply("Okay."))
    const both = (await client.call("POST", path, { text: "call 415-555-0142, then call dad", metadata: direct })).json as Turn
    const compound = (await proposals(client)).filter(({ payload }) => payload.requestMessageId === both.userMessageId)
      .map(({ payload }) => JSON.stringify(payload.operation)).toSorted()

    cloud.script(toolCalls("", propose(call("4155550143"))), reply("Okay."))
    const unbound = (await client.call("POST", path, { text: "call 415-555-0143" })).json as Turn
    const reviewedCall = (await proposals(client)).find(sameOperation(call("4155550143")))

    const placed = call("4155550144")
    const callStarted = Promise.withResolvers<void>()
    cloud.script(toolCalls("", propose(placed)), held(callStarted.promise, toolCalls("", propose(placed))), reply("Your phone started that call."))
    const beforeRepeat = cloud.calls.length
    const repeating = client.call("POST", path, { text: "call 415-555-0144", metadata: direct })
    try {
      await applied(client, await offeredDuringTurn(client, placed), "call-1", { kind: "phone-call", status: "placed", contact: false })
    } finally {
      callStarted.resolve()
    }
    const callTurn = (await repeating).json as Turn
    const repeatedCall = {
      toldModel: cloud.calls.slice(beforeRepeat).some(({ body }) => JSON.stringify(body).includes(
        "Retrieved the historical receipt without acting on the phone again. The owner approved and the phone started the call. This does not show whether it was answered.")),
      ownerHeardFixedWords: callTurn.text.includes("It doesn't show whether the call was answered"),
      requests: (await proposals(client)).filter(sameOperation(placed)).map(({ state }) => state),
    }

    const whole = { type: "sms_latest_sender", includeAddress: true }
    const senderRead = Promise.withResolvers<void>()
    cloud.script(toolCalls("", propose({ type: "sms_latest_sender" })), held(senderRead.promise, toolCalls("", propose({ type: "sms_latest_sender" }))),
      reply("That was the sender I read a moment ago."))
    const beforeSender = cloud.calls.length
    const repeatingSender = client.call("POST", path, { text: "Who texted me last?", metadata: direct })
    try {
      await applied(client, await offeredDuringTurn(client, whole), "sender-0", { kind: "sms-latest-sender", status: "found", address: "+14155550124" })
    } finally {
      senderRead.resolve()
    }
    const senderTurn = (await repeatingSender).json as Turn
    const repeatedSender = {
      toldModel: cloud.calls.slice(beforeSender).some(({ body }) => JSON.stringify(body).includes(
        "Retrieved the historical approved read without reading the phone again. It is not a current read. Your latest incoming SMS came from +14155550124.")),
      ownerHeardFixedWords: senderTurn.text.includes("Your latest incoming SMS came from"),
      requests: (await proposals(client)).filter(sameOperation(whole)).map(({ state }) => state),
    }

    const asked = await ask("Who sent my latest text?", { type: "sms_latest_sender" })
    const askedRead = (await proposals(client)).find(({ payload, state }) => state === "pending" && JSON.stringify(payload.operation) === JSON.stringify(asked.operation))
    const delivered = askedRead === undefined ? undefined : await deliverSender(client, askedRead)
    const toThem = await ask("Draft a text to them saying I'm on my way", { ...text(numbered("6505715862"), "I'm on my way"), draft: true })

    runtime.setSetting("ELIZA_SECRET_SWAP_ENABLED", true)
    const seen = cloud.calls.length
    const swapped = await ask("can you call 415-555-0100 when you get a sec", call("6505715862"), true)
    const toldReference = cloud.calls.slice(seen).some(({ body }) =>
      /Copy this reference verbatim as the number[^"]*__ELIZA_CONTACT_\w+__/.test(JSON.stringify(body)))
    const emergencyWithAlternatives = await ask("Text Carson or Maya that I crashed. Call an ambulance now!", call("911"))
    const completionCount = () => cloud.calls.filter(({ path: called }) => called.endsWith("/chat/completions")).length
    const alone = async (words: string, calls: readonly unknown[], negotiated?: string) => {
      const before = new Set((await proposals(client)).map(({ id }) => id))
      const [sent, counted] = [cloud.calls.length, completionCount()]
      cloud.script(toolCalls("", ...calls.map(propose)), reply("Okay."))
      const turn = (await client.call("POST", path, { text: words, metadata: direct }, negotiated)).json as Turn
      return {
        reply: turn.text, calls: completionCount() - counted, reasked: reportedTo(cloud.calls.slice(sent)) !== undefined,
        operations: (await proposals(client)).filter(({ id }) => !before.has(id)).map(({ payload }) => payload.operation),
      }
    }
    const emergencyWithoutKeypad = await alone("call an ambulance", [call("911")], capabilities.filter((name) => name !== "phone.keypad.v1").join(","))
    const emergencyWithFailure = await alone("Text Carson or Maya that I crashed. Call an ambulance now!", [call("911"), text(numbered("6505715862"), "I crashed")])

    return {
      alternativeRecipients, alternativeInBody, conversational: { told: toldRecipient, said: saidRecipient }, handedThrough, heldCall, separated: { call: separatedCall, send: separatedSend, contact: separatedContact }, ownerDialForm, invented, noNumber,
      callBack, authoredSurname, draftedSurname, surnameWithCourtesy, prefixCallback, unnamed, bodyNumber,
      keypad, dialName, emergency, emergencyWithAlternatives, emergencyWithoutKeypad, emergencyWithFailure, emptyKeypad, writtenEmergency, spokenEmergency, spokenNines, spokenEmergencyByName, nameInNumberWords, nameInNumberWordsInvented, spokenEmergencyOtherNumber, contactNumber, contactEmail, draft, draftToNumber, draftAskFirst, unclear, composedNumber,
      contactUpdate, contactAdd, contactDelete, contactNoNumber, contactShow, contactRead, simSendToName, threadReply,
      draftToNobody, draftToTwoNumbers, callEveryone, partial, compound, repeatedCall, repeatedSender,
      unbound: { reply: unbound.text, carriesMessage: reviewedCall === undefined ? undefined : reviewedCall.payload.requestMessageId !== undefined },
      asked, delivered, toThem, copyReference: { reply: swapped.reply, toldReference },
    }
  }
}

import { proposeTool, retold, roleGuidanceFromChat, smsReceiptFromChat, telephonyFromChat } from node

const review = "Review this request on your phone before it can run."
const heard = (copy: string) => `${copy}\n\nOkay.`
const numberNotWritten = "I didn't set that up, because that number isn't one you wrote in your message. Nothing was called or sent. Tell me the number to use."
const noNumberWritten = "I didn't set that up, because your message doesn't include a phone number. Nothing was called or sent. Tell me the number to use, or the name saved in Contacts."
const numberNotSaved = "I didn't save that, because that number isn't one you wrote in your message. Nothing was saved. Tell me the number to use."
const askRecipient = "Which person should receive this draft? Give one recipient."

it.live('An admitted contact target tells the planner to propose a role directly (spec/agent/deviceActions/telephony.md, "A call or text to someone the owner names by a role is proposed at once, with that word as the contact query")', effect () => {
  const observed = try deviceJourney({ allowed: ["REPLY", "IGNORE", "NONE", proposeTool], persistMemory: true }, "role guidance at the chat provider", roleGuidanceFromChat)
  try Effect.try(() => assert.deepStrictEqual(observed, {
    stable: true,
    guidance: [
      { scopes: ["phone_call or sms_compose"], mentions: 1, skipLookup: "call or text" },
      { scopes: ["phone_call or sms_compose"], mentions: 1, skipLookup: "call or text" },
      { scopes: ["phone_call"], mentions: 1, skipLookup: "call" },
      { scopes: ["sms_compose"], mentions: 1, skipLookup: null },
      { scopes: [], mentions: 0, skipLookup: null },
      { scopes: ["sms_compose"], mentions: 1, skipLookup: "text" },
    ],
    calls: 2,
    proposal: "pending",
    proposedOperations: [{ type: "phone_call", target: { kind: "contact", query: "dentist" } }],
  }))
}, 120_000)

it.live('A submitted SMS receipt remains in its originating conversation and carries no body (spec/agent/deviceActions/index.md, "A later turn of the same conversation learns at most six outcomes of its own requests: what changed, and what ended without running")', effect () => {
  const outcomes = try deviceJourney({ allowed: ["REPLY", "IGNORE", "NONE", proposeTool] }, "an SMS receipt in its originating room", smsReceiptFromChat)
  assert.deepStrictEqual(outcomes, { originalStatus: true, guidance: true, privateText: false, otherProposal: false, settled: ["done"] })
}, 120_000)

it.live(`A call, dial, keypad, text or contact change goes only to the recipient the owner wrote, drafts go to the addressed recipient, the sender is read only as asked, only what the owner asked for runs without its card, and a settled request is answered by the model from its result, while the model's words follow the action's own copy, a refusal is retold by the model and the emergency keypad's copy stands alone (spec/agent/conversation/planning.md, "A recognized card is delivered unfenced, other multi-line tool output is fenced, and grounded prose follows unless one already holds the other"; spec/agent/conversation/planning.md, "A reply that leaves a failure unreported is written again by the model once, and the failure's own words follow it only when that fails"; spec/agent/deviceActions/telephony.md, "Story: Call or text the person I named, as I named them"; spec/agent/deviceActions/telephony.md, "Story: Draft my text to the person I addressed, and read the sender only as I asked"; spec/agent/deviceActions/telephony.md, "Story: Hear what my phone did with a call, text or contact change, as far as it shows"; spec/agent/deviceActions/telephony.md, "A proposed number is the owner's own, written or spoken in this message and not only inside the text to send"; spec/agent/deviceActions/telephony.md, "A proposed contact name is one the owner wrote as whole words, outside the text to send"; spec/agent/deviceActions/telephony.md, "A whole-message call, text or dial command hands through the owner's own recipient"; spec/agent/deviceActions/telephony.md, "A request to open the dialer opens the keypad as the owner wrote it"; spec/agent/deviceActions/telephony.md, "An emergency request is never refused for its recipient, and the owner dials it themselves on the keypad"; spec/agent/deviceActions/telephony.md, "A contact change saves only numbers and email addresses the owner wrote, when the message writes any"; spec/agent/deviceActions/telephony.md, "A refused recipient is explained in a sentence that says truthfully that nothing ran"; spec/agent/deviceActions/telephony.md, "An addressed draft request drafts to the addressed recipient unless the owner asked to send it there"; spec/agent/deviceActions/telephony.md, "A draft to them goes only to the whole sender address the agent just delivered"; spec/agent/deviceActions/telephony.md, "A latest-sender read names the whole address only when the owner asked who sent it, on a phone that names it"; spec/agent/deviceActions/telephony.md, "A keypad, a Messages draft or a who-texted-me read runs without its card only as the owner asked"; spec/agent/deviceActions/telephony.md, "A settled telephony request is answered by the model from its stored result"; spec/agent/deviceActions/capabilities.md, "A newer operation cannot use an older capability version"; spec/agent/deviceActions/index.md, "A grounding refusal offers nothing and is a refusal before dispatch"; spec/agent/deviceActions/index.md, "A proposal's identity is its request message and its operation, so a repeat returns the same request"; spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/agent/deviceActions/index.md, "A proposal carries the owner's message only for a live turn that asked for it directly, so otherwise the phone shows its card"; spec/agent/deviceActions/operations.md, "Only a read whose result answers the owner's request completes that request")`, effect () => {
  const observed = try deviceJourney({ allowed: ["REPLY", "IGNORE", "NONE", proposeTool], persistMemory: true }, "telephony from chat", telephonyFromChat)
  try Effect.try(() => assert.deepStrictEqual(observed, {
    alternativeRecipients: { replies: ["Carson or Maya?", "To Carson, or to that number?"], completionCalls: 2, proposals: 0, guided: true },
    alternativeInBody: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "contact", query: "Carson" }, body: "choose green or blue that matches." } },
    conversational: {
      told: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "contact", query: "Carson" }, body: "Please bring the ice. We have dinner covered." } },
      said: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "contact", query: "Carson" }, body: "dinner is covered" } },
    },
    handedThrough: { reply: heard(review), operation: { type: "phone_call", target: { kind: "number", number: "4155550100" } } },
    heldCall: { reply: noNumberWritten, requests: ["pending"] },
    separated: {
      call: { reply: heard(review), operation: { type: "phone_call", target: { kind: "number", number: "4155550161" } } },
      send: { reply: heard(review), operation: { type: "sms_send", recipients: ["+14155550162"], body: "hi", subscriptionId: 1 } },
      contact: { reply: heard(review), operation: { type: "contact_create", contact: { displayName: "Ana", phoneNumbers: ["4155550163"], emailAddresses: [] } } },
    },
    ownerDialForm: { reply: heard(review), operation: { type: "phone_call", target: { kind: "number", number: "+442079460958" } } },
    invented: { reply: numberNotWritten, operation: undefined, heard: retold },
    noNumber: {
      reply: noNumberWritten,
      operation: undefined, heard: retold,
    },
    callBack: { reply: heard(review), operation: { type: "phone_call", target: { kind: "contact", query: "mom" } } },
    authoredSurname: { reply: heard(review), operation: { type: "phone_call", target: { kind: "contact", query: "Sam Back" } } },
    draftedSurname: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "contact", query: "Sam Back" }, body: "hi" } },
    surnameWithCourtesy: { reply: heard(review), operation: { type: "phone_call", target: { kind: "contact", query: "Ana Maria Silva Back" } } },
    prefixCallback: { reply: heard(review), operation: { type: "phone_call", target: { kind: "contact", query: "Jo" } } },
    unnamed: {
      reply: "I didn't set that up, because that name isn't one you wrote in your message. Nothing was called or sent. Tell me who, by their name as saved in Contacts or their number.",
      operation: undefined, heard: retold,
    },
    bodyNumber: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "contact", query: "Sam" }, body: "call me at 415-555-0100" } },
    keypad: { reply: heard("Opening the keypad with 4153024399."), operation: { type: "phone_keypad", number: "4153024399" } },
    dialName: { reply: "I can't set that up on this phone with that recipient. Nothing was called or sent. Tell me the number to use.", operation: undefined, heard: retold },
    emergency: {
      reply: "Opening the keypad. Dial your local emergency number (911 in the US and Canada, 112 in most of Europe) and tap Call.",
      operation: { type: "phone_keypad" },
    },
    emergencyWithAlternatives: {
      reply: "Opening the keypad. Dial your local emergency number (911 in the US and Canada, 112 in most of Europe) and tap Call.",
      operation: { type: "phone_keypad" },
    },
    emergencyWithoutKeypad: {
      reply: "Okay.\n\nI can't open the keypad on this phone. For an emergency, dial your local emergency number (911 in the US and Canada, 112 in most of Europe) on your phone's dialer now.",
      calls: 2, reasked: false, operations: [],
    },
    emergencyWithFailure: {
      reply: `Opening the keypad. Dial your local emergency number (911 in the US and Canada, 112 in most of Europe) and tap Call.\n\n${noNumberWritten}`,
      calls: 2, reasked: false, operations: [{ type: "phone_keypad" }],
    },
    emptyKeypad: { reply: heard("Opening the keypad."), operation: { type: "phone_keypad" } },
    writtenEmergency: { reply: heard(review), operation: { type: "phone_call", target: { kind: "number", number: "911" } } },
    spokenEmergency: { reply: heard(review), operation: { type: "phone_call", target: { kind: "number", number: "911" } } },
    spokenNines: { reply: heard(review), operation: { type: "phone_call", target: { kind: "number", number: "999" } } },
    spokenEmergencyByName: {
      reply: "Opening the keypad. Dial your local emergency number (911 in the US and Canada, 112 in most of Europe) and tap Call.",
      operation: { type: "phone_keypad" },
    },
    nameInNumberWords: { reply: heard(review), operation: { type: "phone_call", target: { kind: "contact", query: "Seven Eleven" } } },
    nameInNumberWordsInvented: { reply: heard(review), operation: { type: "phone_call", target: { kind: "contact", query: "Seven Eleven" } } },
    spokenEmergencyOtherNumber: {
      reply: "Opening the keypad. Dial your local emergency number (911 in the US and Canada, 112 in most of Europe) and tap Call.",
      operation: { type: "phone_keypad" },
    },
    contactNumber: { reply: numberNotSaved, operation: undefined, heard: retold },
    contactEmail: {
      reply: "I didn't save that, because that email address isn't one you wrote in your message. Nothing was saved. Tell me the email address to use.",
      operation: undefined, heard: retold,
    },
    draft: {
      reply: heard(review), operation: { type: "sms_compose", target: { kind: "contact", query: "Sam" }, body: "Are we on for dinner tonight?", draft: true }, reviewed: true,
    },
    draftToNumber: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "number", number: "4155550124" }, body: "hi", draft: true } },
    draftAskFirst: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "number", number: "4155550124" }, body: "hi", draft: true }, reviewed: true },
    unclear: { reply: askRecipient, operation: undefined, heard: retold },
    composedNumber: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "number", number: "4155550100" }, body: "I'm running late" } },
    contactUpdate: { reply: heard(review), operation: { type: "contact_update", query: "Bob", set: { phoneNumbers: ["4155550177"] } } },
    contactAdd: { reply: heard(review), operation: { type: "contact_update", query: "Sam", add: { phoneNumbers: ["4155550188"] } } },
    contactDelete: { reply: heard(review), operation: { type: "contact_delete", query: "Bob" } },
    contactNoNumber: { reply: heard(review), operation: { type: "contact_create", contact: { displayName: "Ana", phoneNumbers: ["6505715862"], emailAddresses: [] } } },
    contactShow: { reply: heard(review), operation: { type: "contact_show", query: "Maya" } },
    contactRead: { reply: heard(review), operation: { type: "contact_read_selected" } },
    simSendToName: {
      reply: "I can't set that up on this phone with that recipient. Nothing was called or sent. Tell me the number to use.",
      operation: undefined, heard: retold,
    },
    threadReply: { reply: heard(review), operation: { type: "sms_reply_selected", body: "I'll be there soon" } },
    draftToNobody: { reply: askRecipient, operation: undefined, heard: retold },
    draftToTwoNumbers: { reply: askRecipient, operation: undefined, heard: retold },
    callEveryone: {
      reply: "I didn't set that up, because that name isn't one you wrote in your message. Nothing was called or sent. Tell me who, by their name as saved in Contacts or their number.",
      operation: undefined, heard: retold,
    },
    partial: { reply: "Would you like the last four digits of the SMS sender’s number? Other partial numbers are unavailable.", operation: undefined, heard: retold },
    repeatedCall: { toldModel: true, ownerHeardFixedWords: false, requests: ["done"] },
    repeatedSender: { toldModel: true, ownerHeardFixedWords: false, requests: ["done"] },
    compound: [JSON.stringify({ type: "phone_call", target: { kind: "contact", query: "dad" } }), JSON.stringify({ type: "phone_call", target: { kind: "number", number: "4155550142" } })],
    unbound: { reply: heard(review), carriesMessage: false },
    asked: { reply: heard(review), operation: { type: "sms_latest_sender", includeAddress: true } },
    delivered: "Your latest incoming SMS came from +14155550124.",
    toThem: { reply: heard(review), operation: { type: "sms_compose", target: { kind: "number", number: "+14155550124" }, replyThreadId: "thread:42", body: "I'm on my way", draft: true } },
    copyReference: { reply: numberNotWritten, toldReference: true },
  }))
}, 180_000)

const telephony = "spec/agent/deviceActions/telephony.md"

it.effect(`A written number is read as its one dial form: one digit may follow a country code, and a trunk (0) is dropped after +44, +49 and +41 and kept as a 0 after +39, +378 and +225 (${telephony}, "A proposed number is the owner's own, written or spoken in this message and not only inside the text to send"; ${telephony}, "A whole-message call, text or dial command hands through the owner's own recipient")`, effect () => {
  const forms = [
    "+33 1 23 45 67 89", "+61 2 9876 5432", "+54 9 11 1234-5678", "+33 1 2 34 56 78",
    "+44 (0)20 7946 0958", "+49(0)30 1234567", "+41 (0) 44 668 18 00", "+39 (0)55 123 4567", "+39 (0)6 1234 5678",
    "+378 (0)549 882 123", "+225 (0)7 07 12 34 56", "+44 (0)",
  ]
  const call = (number: string) => ({ type: "phone_call", target: { kind: "number", number } }) as DeviceOperation
  try Effect.try(() => assert.deepStrictEqual({
    dialForms: forms.map((written) => [written, phoneDialNumber(written)]),
    written: [writtenPhoneNumbers("+39 (0)55 123 4567"), writtenPhoneNumbers("+44 (0)20 7946 0958")],
    handedThrough: [
      groundTelephonyTarget(call("+39551234567"), "call +39 (0)55 123 4567", [], false),
      groundTelephonyTarget(call("+442079460958"), "call +44 (0)20 7946 0958", [], false),
    ],
  }, {
    dialForms: [
      ["+33 1 23 45 67 89", "+33123456789"], ["+61 2 9876 5432", "+61298765432"], ["+54 9 11 1234-5678", "+5491112345678"], ["+33 1 2 34 56 78", undefined],
      ["+44 (0)20 7946 0958", "+442079460958"], ["+49(0)30 1234567", "+49301234567"], ["+41 (0) 44 668 18 00", "+41446681800"],
      ["+39 (0)55 123 4567", "+390551234567"], ["+39 (0)6 1234 5678", "+390612345678"], ["+378 (0)549 882 123", "+3780549882123"],
      ["+225 (0)7 07 12 34 56", "+2250707123456"], ["+44 (0)", undefined],
    ],
    written: [["+390551234567"], ["+442079460958"]],
    handedThrough: [
      { kind: "grounded", operation: call("+390551234567"), handedThrough: true },
      { kind: "grounded", operation: call("+442079460958"), handedThrough: true },
    ],
  }))
})

it.effect(`A text keeps the recipient's name when the words to send are inside it (${telephony}, "A proposed contact name is one the owner wrote as whole words, outside the text to send")`, effect () => {
  const named = (query: string, body: string) => ({ type: "sms_compose", target: { kind: "contact", query }, body }) as DeviceOperation
  const requests: ReadonlyArray<readonly [string, string, string]> = [
    ["Phil", "hi", "text Phil hi"],
    ["Sophie", "hi", "text Sophie hi"],
    ["Sophie", "hi", "send Sophie a text saying hi"],
    ["Phil", "hi", "send Phil a text saying hi"],
    ["Brooke", "ok", "send Brooke a text: ok"],
    ["Sophia", "hi", "text Sophia hi"],
    ["Noah", "no", "message Noah: no"],
    ["Brooke", "ok", "send a text to Brooke: ok"],
    ["Sam", "hi", "text Sam hi"],
  ]
  try Effect.try(() => assert.deepStrictEqual(
    requests.map(([query, body, request]): readonly [string, unknown] => [request, groundTelephonyTarget(named(query, body), request, [], false)]),
    requests.map(([query, body, request]): readonly [string, unknown] => [request, { kind: "grounded", operation: named(query, body), handedThrough: false }]),
  ))
})

it.effect(`A drafted text's recipient ends where a clause of what to say begins (${telephony}, "An addressed draft request drafts to the addressed recipient unless the owner asked to send it there")`, effect () => {
  const toSam = [
    "Draft a text to Sam to ask him about dinner tonight",
    "Write a message to Sam to tell him I'm running late",
    "Draft a text to Sam to remind him about the tripod",
    "Draft a text to Sam to see if he's free tonight",
    "Draft a text to Sam to check if he got home",
    "Draft a text to Sam to let him know I'm running late",
    "Draft a text to Sam letting him know I'm running late",
  ]
  try Effect.try(() => assert.deepStrictEqual({
    toSam: toSam.map((request) => [request, requestedSmsDraftRecipient(request)]),
    toNumber: requestedSmsDraftRecipient("Draft a text to +1 (415) 555-0124 to ask about the tripod"),
  }, {
    toSam: toSam.map((request) => [request, { kind: "contact", query: "Sam" }]),
    toNumber: { kind: "number", number: "+14155550124" },
  }))
})
