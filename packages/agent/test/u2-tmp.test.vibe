// spec/agent/models/binding.md, "No text handler is ever served by a model on the device"
import { assert, it } from "@effect/vitest"
import { allowanceExhausted, dropped, echoImages, insufficientCredits, rateLimited, refusal, text, unavailable } from "./support/cloud-fake.ts"
import { cloudFake, deviceKey, host } from "./support/kernel.vibe"
import { registerCloudModels } from "../src/models/cloud-provider.vibe"
import { probeOwnKey, registerOwnKeyModels } from "../src/models/own-key-provider.vibe"

module node {
  export interface Ledger { events: string[] }
  export function ledger(key: string): { binding: any; events: string[] } {
    const events: string[] = []
    let next = 0
    return { events, binding: {
      credential: () => Redacted.make(key),
      startCall: (handler: string) => Effect.sync(() => { events.push("start " + handler); return next++ }),
      answerCall: (id: number) => Effect.sync(() => { events.push("answer " + id) }),
      refuseCall: (id: number, _now: number, e: { tag: string }) => Effect.sync(() => { events.push("refuse " + e.tag) }),
    } }
  }
  export function runtime() {
    const handlers = new Map<string, any[]>()
    return { handlers, runtime: { registerModel: (type: string, handler: any, provider: string) => { handlers.set(type, [...(handlers.get(type) ?? []), handler]); void provider } } as any }
  }
  export async function attempt(f: () => Promise<unknown>): Promise<unknown> {
    try { return await f() } catch (e) { return { code: (e as any).code, status: (e as any).status, name: (e as any).name } }
  }
}
