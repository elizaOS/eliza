// spec/agent/tasks/wire.md, "Story: Admit only the documented task commands"
import { assert, it } from "@effect/vitest"
import { call, startInProcess, type InProcess } from "./support/kernel.vibe"
import type { LocalAnswer, LocalRequest, Refusal } from "./support/socket-client.ts"

module node {
  import { Effect } from "effect"
  import { createInteractiveTask, ElizaError, transitionInteractiveTask, type InteractiveTask, type TaskEvent, type TaskTransition } from "@elizaos/core"
  import { failStorage, initial, start, type TaskHost } from "../gen/agent__tasks.ts"
  import { startReply } from "../gen/agent__tasks__wire.ts"
  import type { ModuleFactory } from "../src/host/module.vibe"
  import { taskRoutes, taskView, type TaskRoutesHost, type TaskWrite } from "../src/tasks/routes.vibe"
  import type { TaskStorageStatus, UnreadableTaskRecord } from "../src/tasks/store.vibe"

  export const moduleName = "@elizaos/agent/tasks"
  const owner = { agentId: "agent-1", actorId: "owner-1", connector: { source: "device", accountId: "owner-account" } }
  const launchOwner = { agentId: "agent-1", actorId: "owner-1", connector: "owner-account" }

  export interface JourneyHost {
    readonly modules: ReadonlyMap<string, ModuleFactory<never>>
    readonly writes: string[]
    helper: boolean
    cleanupConfirmed: boolean
    failure: unknown
    stopServingOnWrite: boolean
    storage: TaskStorageStatus
    unreadable: UnreadableTaskRecord[]
    poison(): void
  }

  export function journeyHost(): JourneyHost {
    let state: TaskHost = start(initial, launchOwner)
    let task: InteractiveTask | null = null
    let events: TaskEvent[] = []
    let now = 1_000
    let made = 0
    const failing = <A>(run: () => A) => Effect.try({
      try: () => {
        if (journey.failure !== undefined) throw journey.failure
        return run()
      },
      catch: (cause) => cause,
    })
    const held = (taskId: string): InteractiveTask => {
      if (task === null || task.id !== taskId) throw coded(taskId, "TASK_NOT_FOUND")
      return task
    }
    const write = (taskId: string, expectedRevision: number, transition: TaskTransition) => failing((): TaskWrite => {
      journey.writes.push(`${transition.type} ${taskId}`)
      now += 100
      const next = transitionInteractiveTask(held(taskId), { owner, expectedRevision, now }, transition)
      task = next.task
      events = [...events, next.event]
      if (journey.stopServingOnWrite) state = initial
      return { task, saved: true, cleanupConfirmed: transition.type === "resume" || journey.cleanupConfirmed }
    })
    const observation = () => ({ id: `observation-${now}`, pageId: "page-1", origin: "https://example.com", version: 1, inputRevision: 1, observedAt: now })
    const host: TaskRoutesHost = {
      state: () => Effect.sync(() => state),
      helperReady: () => Effect.sync(() => journey.helper),
      current: () => failing(() => task),
      view: (taskId) => failing(() => held(taskId)),
      events: (taskId, after) => failing(() => {
        const { schemaVersion: _, ...view } = taskView(held(taskId))
        return { events: events.filter((event) => event.sequence > after), cursor: view.revision, hasMore: false, task: view }
      }),
      create: (goalRef) => failing(() => {
        const running = task !== null && !["completed", "cancelled"].includes(task.status)
        const reply = startReply(true, running, task?.goalRef === goalRef, !running)
        if (reply.tag !== "NewTask") return { reply, task: reply.tag === "ExistingTask" ? task : null }
        made += 1
        journey.writes.push(`create task-${made}`)
        task = createInteractiveTask({
          id: `task-${made}`, owner, goalRef, now,
          authorization: { decisionId: `decision-${made}`, policyRevision: "1", decidedAt: "2026-01-01T00:00:00.000Z", state: "active", revokedAt: null },
          allowedCapabilities: ["read"], allowedOrigins: ["https://example.com"],
        })
        events = []
        return { reply, task }
      }),
      pauseCurrent: () => task === null ? Effect.succeed({ task: null, saved: false, cleanupConfirmed: true }) : write(task.id, task.revision, { type: "pause" }),
      pause: (taskId, expectedRevision) => write(taskId, expectedRevision, { type: "pause" }),
      cancel: (taskId, expectedRevision) => write(taskId, expectedRevision, { type: "cancel" }),
      resume: (taskId, expectedRevision) => write(taskId, expectedRevision, { type: "resume", observation: observation() }),
      acknowledgeUnknown: (taskId, expectedRevision) => write(taskId, expectedRevision, { type: "recover" }),
      acknowledgeUnreadable: (taskId) => failing(() => {
        journey.writes.push(`acknowledge-unreadable ${taskId}`)
        const found = journey.unreadable.find((record) => record.taskId === taskId)
        if (found === undefined) throw coded(taskId, "TASK_NOT_FOUND")
        const released = { ...found, releasedAt: now }
        journey.unreadable = journey.unreadable.map((record) => record.taskId === taskId ? released : record)
        return released
      }),
      unreadable: () => failing(() => journey.unreadable),
      storageProbe: () => Effect.sync(() => journey.storage),
    }
    const factory: ModuleFactory<never> = () => Effect.succeed({
      name: moduleName,
      plugin: { name: moduleName, description: "Task routes", routes: taskRoutes(host) },
    })
    const journey: JourneyHost = {
      modules: new Map([[moduleName, factory]]),
      writes: [], helper: true, cleanupConfirmed: true, failure: undefined, stopServingOnWrite: false, storage: "ok",
      unreadable: [{ taskId: "task-old", reason: "schema", heldAt: 500, releasedAt: null }],
      poison: () => { state = failStorage(state) },
    }
    return journey
  }

  export const coded = (taskId: string, code: string) => new ElizaError(`Task ${taskId} failed`, { code })
}

import { coded, journeyHost, moduleName, type JourneyHost } from node

const answerOf = (answer: LocalAnswer | Refusal) => "status" in answer ? { status: answer.status, body: answer.json } : { status: 0, body: answer.refused }

effect function ask(agent: InProcess, asked: LocalRequest) {
  return answerOf(try call(agent, asked))
}

effect function boot(journey: JourneyHost) {
  return try startInProcess({ launch: { load: [moduleName] }, modules: journey.modules })
}

const get = (path: string): LocalRequest => ({ method: "GET", path })
const post = (path: string, body: unknown): LocalRequest => ({ method: "POST", path, body })
const statusCode = (answer: { status: number; body: unknown }) => [answer.status, (answer.body as { code?: unknown } | null)?.code]
const taskOf = (answer: { body: unknown }) => (answer.body as { task: { id: string; revision: number; epoch: number; status: string } | null }).task

it.effect('The owner starts, reads, pages and stops one task, and a repeated start returns it (spec/agent/tasks/wire.md, "Each route names one command and the one method it answers"; spec/agent/tasks/wire.md, "A repeated start of the running task\'s goal returns that task"; spec/agent/tasks/wire.md, "A view shows six public fields of the held task, or null")', effect () => {
  const journey = try Effect.sync(() => journeyHost())
  const agent = try boot(journey)
  const empty = try ask(agent, get("/api/tasks/current"))
  const started = try ask(agent, post("/api/tasks", { goalRef: "goal:inbox/1" }))
  const again = try ask(agent, post("/api/tasks", { goalRef: "goal:inbox/1" }))
  const other = try ask(agent, post("/api/tasks", { goalRef: "goal:other" }))
  const id = taskOf(started)?.id ?? ""
  const paused = try ask(agent, post(`/api/tasks/${id}/pause`, { expectedRevision: taskOf(started)?.revision ?? -1, reason: "close" }))
  const stale = try ask(agent, post(`/api/tasks/${id}/cancel`, { expectedRevision: taskOf(started)?.revision ?? -1 }))
  const resumed = try ask(agent, post(`/api/tasks/${id}/resume`, { expectedRevision: taskOf(paused)?.revision ?? -1 }))
  const page = try ask(agent, get(`/api/tasks/${id}/events?after=-1`))
  const later = try ask(agent, get(`/api/tasks/${id}/events?after=${taskOf(paused)?.revision ?? 0}`))
  const closed = try ask(agent, post("/api/tasks/current/pause", { reason: "close" }))
  const viewed = try ask(agent, get(`/api/tasks/${id}`))
  const missing = try ask(agent, get("/api/tasks/task-none"))
  const records = try ask(agent, get("/api/tasks/current/unreadable"))
  const accepted = try ask(agent, post("/api/tasks/task-old/acknowledge-unreadable", {}))
  const storage = try ask(agent, get("/api/tasks/storage"))
  try Effect.try(() => {
    assert.deepStrictEqual(empty, { status: 200, body: { task: null } })
    assert.strictEqual(started.status, 201)
    assert.deepStrictEqual(Object.keys(taskOf(started) ?? {}).sort(), ["epoch", "hasUnknownOutcome", "id", "revision", "schemaVersion", "status"])
    assert.deepStrictEqual([again.status, taskOf(again)?.id], [200, id])
    assert.deepStrictEqual(statusCode(other), [409, "TASK_CONFLICT"])
    assert.deepStrictEqual([paused.status, taskOf(paused)?.status], [200, "paused"])
    assert.deepStrictEqual(statusCode(stale), [409, "TASK_CONFLICT"])
    assert.deepStrictEqual([resumed.status, taskOf(resumed)?.status], [200, "active"])
    const shown = page.body as { events: unknown[]; task: { id: string } }
    assert.deepStrictEqual([page.status, shown.events.length, shown.task.id], [200, 2, id])
    assert.deepStrictEqual([later.status, (later.body as { events: unknown[] }).events.length], [200, 1])
    assert.deepStrictEqual([closed.status, taskOf(closed)?.status], [200, "paused"])
    assert.deepStrictEqual([viewed.status, taskOf(viewed)?.status], [200, "paused"])
    assert.deepStrictEqual(missing, { status: 404, body: { code: "TASK_NOT_FOUND" } })
    assert.deepStrictEqual(records, { status: 200, body: { records: [{ taskId: "task-old", reason: "schema", heldAt: 500, releasedAt: null }] } })
    assert.deepStrictEqual([accepted.status, (accepted.body as { records: { releasedAt: unknown }[] }).records[0]?.releasedAt === null], [200, false])
    assert.deepStrictEqual(storage, { status: 200, body: { schemaVersion: 1, taskStorage: "ok" } })
    assert.deepStrictEqual(journey.writes, ["create task-1", `pause ${id}`, `cancel ${id}`, `resume ${id}`, `pause ${id}`, "acknowledge-unreadable task-old"])
  })
}, 120_000)

it.effect('A malformed, foreign or misrouted task request is refused with one code and changes nothing (spec/agent/tasks/wire.md, "Only the launch account reaches a serving host, and the storage probe needs neither"; spec/agent/tasks/wire.md, "A command body has exactly the fields its command names"; spec/agent/tasks/wire.md, "Only the event page takes a query, and its cursor is canonical"; spec/agent/tasks/wire.md, "Every refusal is one documented code with a fixed status")', effect () => {
  const journey = try Effect.sync(() => journeyHost())
  const agent = try boot(journey)
  const started = try ask(agent, post("/api/tasks", { goalRef: "goal-1" }))
  const id = taskOf(started)?.id ?? ""
  const revision = taskOf(started)?.revision ?? 0
  journey.writes.length = 0
  const asked: LocalRequest[] = [
    { method: "GET", path: "/api/tasks/current", token: "wrong-token" },
    get(`/api/tasks/${id}/pause`),
    { method: "DELETE", path: `/api/tasks/${id}` },
    post("/api/tasks/current", {}),
    get("/api/tasks/current/events"),
    get(`/api/tasks/${id}/events?after=01`),
    get(`/api/tasks/${id}/events?after=-2`),
    get(`/api/tasks/${id}/events?after=${revision + 1}`),
    get(`/api/tasks/${id}?after=0`),
    post("/api/tasks", { goalRef: "-starts-with-dash" }),
    post("/api/tasks", { goalRef: "goal-2", reason: "close" }),
    post(`/api/tasks/${id}/cancel`, { expectedRevision: revision, extra: true }),
    post(`/api/tasks/${id}/cancel`, { expectedRevision: -1 }),
    post(`/api/tasks/${id}/cancel`, { expectedRevision: 1.5 }),
    post(`/api/tasks/${id}/cancel`, { expectedRevision: revision, reason: "close" }),
    post(`/api/tasks/${id}/pause`, { expectedRevision: revision, reason: "open" }),
    post(`/api/tasks/${id}/acknowledge-unreadable`, { expectedRevision: revision }),
    post("/api/tasks/current/pause", { expectedRevision: revision }),
    { method: "POST", path: `/api/tasks/${id}/resume`, headers: { "content-type": "text/plain" }, body: JSON.stringify({ expectedRevision: revision }) },
  ]
  const refused = try Effect.forEach(asked, (request) => ask(agent, request))
  journey.helper = false
  const noHelper = try ask(agent, post("/api/tasks", { goalRef: "goal-1" }))
  const noHelperBadBody = try ask(agent, post("/api/tasks", { goalRef: "" }))
  try Effect.try(() => {
    assert.deepStrictEqual(refused.map(statusCode), [
      [401, undefined],
      [405, "TASK_METHOD_NOT_ALLOWED"],
      [405, "TASK_METHOD_NOT_ALLOWED"],
      [405, "TASK_METHOD_NOT_ALLOWED"],
      [404, "TASK_NOT_FOUND"],
      ...Array.from({ length: 14 }, () => [400, "TASK_INVALID"]),
    ])
    assert.deepStrictEqual(statusCode(noHelper), [503, "TASK_HELPER_UNAVAILABLE"])
    assert.deepStrictEqual(statusCode(noHelperBadBody), [503, "TASK_HELPER_UNAVAILABLE"])
    assert.deepStrictEqual(journey.writes, [])
  })
}, 120_000)

it.effect('A write that outlived the account, an unconfirmed cleanup and a failing store each answer their own code, and the probe reports a poisoned host (spec/agent/tasks/wire.md, "A reply after the host stopped serving says whether a change was saved"; spec/agent/tasks/wire.md, "The storage probe reports unavailable for a poisoned host"; spec/agent/tasks/wire.md, "Every refusal is one documented code with a fixed status")', effect () => {
  const journey = try Effect.sync(() => journeyHost())
  const agent = try boot(journey)
  const started = try ask(agent, post("/api/tasks", { goalRef: "goal-1" }))
  const id = taskOf(started)?.id ?? ""
  journey.cleanupConfirmed = false
  const unconfirmed = try ask(agent, post(`/api/tasks/${id}/pause`, { expectedRevision: taskOf(started)?.revision ?? 0 }))
  const read = try ask(agent, get(`/api/tasks/${id}`))
  journey.failure = try Effect.sync(() => coded(id, "TASK_STORAGE_CORRUPT"))
  const corrupted = try ask(agent, get(`/api/tasks/${id}`))
  journey.failure = try Effect.sync(() => new Error("secret path /home/owner/tasks.sqlite"))
  const hidden = try ask(agent, get("/api/tasks/current"))
  journey.failure = { code: "TASK_STORAGE_SOMETHING_NEW" }
  const storageCode = try ask(agent, get("/api/tasks/current"))
  journey.failure = { code: "TASK_SOMETHING_NEW" }
  const taskCode = try ask(agent, get("/api/tasks/current"))
  journey.failure = undefined
  journey.cleanupConfirmed = true
  journey.storage = "deferred"
  const deferred = try ask(agent, get("/api/tasks/storage"))
  journey.stopServingOnWrite = true
  const changed = try ask(agent, post(`/api/tasks/${id}/cancel`, { expectedRevision: taskOf(read)?.revision ?? 0 }))
  const afterChange = try ask(agent, get("/api/tasks/current"))
  const probeAfterChange = try ask(agent, get("/api/tasks/storage"))
  const poisoned = try Effect.sync(() => journeyHost())
  const second = try boot(poisoned)
  try Effect.sync(() => poisoned.poison())
  const unavailable = try ask(second, get("/api/tasks/storage"))
  const refusedWhilePoisoned = try ask(second, post("/api/tasks", { goalRef: "goal-1" }))
  try Effect.try(() => {
    assert.deepStrictEqual(statusCode(unconfirmed), [503, "TASK_CLEANUP_UNCONFIRMED"])
    assert.deepStrictEqual([read.status, taskOf(read)?.status], [200, "paused"])
    assert.deepStrictEqual(corrupted, { status: 503, body: { code: "TASK_STORAGE_CORRUPT" } })
    assert.deepStrictEqual(hidden, { status: 503, body: { code: "TASK_UNAVAILABLE" } })
    assert.deepStrictEqual(storageCode, { status: 503, body: { code: "TASK_STORAGE_SOMETHING_NEW" } })
    assert.deepStrictEqual(taskCode, { status: 409, body: { code: "TASK_SOMETHING_NEW" } })
    assert.deepStrictEqual(deferred, { status: 200, body: { schemaVersion: 1, taskStorage: "deferred" } })
    assert.deepStrictEqual(statusCode(changed), [409, "TASK_ACCOUNT_CHANGED"])
    assert.deepStrictEqual(statusCode(afterChange), [503, "TASK_UNAVAILABLE"])
    assert.deepStrictEqual(probeAfterChange, { status: 200, body: { schemaVersion: 1, taskStorage: "deferred" } })
    assert.deepStrictEqual(unavailable, { status: 200, body: { schemaVersion: 1, taskStorage: "unavailable" } })
    assert.deepStrictEqual(statusCode(refusedWhilePoisoned), [503, "TASK_UNAVAILABLE"])
    assert.deepStrictEqual(poisoned.writes, [])
  })
}, 120_000)
