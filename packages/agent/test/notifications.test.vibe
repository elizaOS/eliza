// spec/agent/notifications.md, "Story: Read my notices and mark them read from my own client"
import { assert, it } from "@effect/vitest"
import { AgentEventService, NotificationService, type AgentNotification, type NotificationInput } from "@elizaos/core"
import { ask, call, events, host, startInProcess, type InProcess } from "./support/kernel.vibe"

const loaded = { launch: { load: ["@elizaos/agent/notifications"] } }
const absentId = "0b7c3a52-7e1f-4c55-9a4e-2f0d8b6c1e93"
const otherEpoch = "9d1e6f0a-3b2c-4d5e-8f70-1a2b3c4d5e6f"

effect function inbox(agent: InProcess) {
  try host("inbox start", () => agent.agent.runtime.getServiceLoadPromise(NotificationService.serviceType))
  const found = agent.agent.runtime.getService(NotificationService.serviceType)
  return try Effect.try(() => {
    assert.instanceOf(found, NotificationService)
    return found as NotificationService
  })
}

effect function notifyAll(service: NotificationService, inputs: readonly NotificationInput[]) {
  const made: AgentNotification[] = []
  for (const input of inputs) made.push(try host(`notify ${input.title}`, () => service.notify(input)))
  return made
}

const listed = (body: unknown): string[] => ((body as { notifications: AgentNotification[] }).notifications).map((notice) => notice.id)
const list = (agent: InProcess, query: string) => ask(agent, { method: "GET", path: `/api/notifications${query}` })
const markRead = (agent: InProcess, id: string) => ask(agent, { method: "POST", path: `/api/notifications/${id}/read` })

interface NativePage {
  readonly notifications: readonly { readonly id: string; readonly nativeSequence: number }[]
  readonly nativeEpoch: string
  readonly throughSequence: number
  readonly nextSequence: number
  readonly complete: boolean
}

it.effect('Notify, list with each filter, page natively and mark read twice (spec/agent/notifications.md, "An owner list holds only visible notices that match its filter, newest first"; spec/agent/notifications.md, "A list query is refused unless each parameter is given once and well formed"; spec/agent/notifications.md, "A native page takes no filter and names its epoch to continue"; spec/agent/notifications.md, "Marking a notice read answers ok only when this call durably marked an unread notice")', effect () => {
  const agent = try startInProcess(loaded)
  const service = try inbox(agent)
  const [first, second, quiet] = try notifyAll(service, [
    { title: "Take the bins out", category: "reminder" },
    { title: "Sam wrote back", category: "message" },
    { title: "Water the plants", category: "reminder", priority: "low" },
  ])

  const everything = try list(agent, "")
  const reminders = try list(agent, "?category=reminder")
  const newest = try list(agent, "?limit=1&unreadOnly=true")
  try Effect.try(() => {
    assert.deepStrictEqual([everything.status, listed(everything.body)], [200, [quiet.id, second.id, first.id]])
    assert.deepInclude(everything.body as object, { unreadCount: 2, serviceStatus: "ready" })
    assert.deepStrictEqual(listed(reminders.body), [quiet.id, first.id])
    assert.deepStrictEqual(listed(newest.body), [quiet.id])
  })

  const refusals = try Effect.forEach(
    ["?category=remindr", "?limit=101", "?limit=0", "?limit=1e1", "?unreadOnly=yes", "?afterSequence=2", "?nativeTransport=1", "?nativeTransport=true&category=reminder", "?nativeTransport=true&limit=129", "?nativeTransport=true&afterSequence=1"],
    (query) => list(agent, query))
  const undeclared = try list(agent, "?page=2")
  const repeated = try list(agent, "?category=message&category=reminder")
  try Effect.try(() => {
    assert.deepStrictEqual(refusals.map(({ status }) => status), refusals.map(() => 400))
    assert.deepStrictEqual([undeclared.status, repeated.status], [404, 404])
  })

  const opening = try list(agent, "?nativeTransport=true&limit=2")
  const page = opening.body as NativePage
  const rest = try list(agent, `?nativeTransport=true&nativeEpoch=${page.nativeEpoch}&afterSequence=${page.nextSequence}&throughSequence=${page.throughSequence}`)
  const changed = try list(agent, `?nativeTransport=true&nativeEpoch=${otherEpoch}&afterSequence=${page.nextSequence}`)
  try Effect.try(() => {
    assert.deepStrictEqual([opening.status, page.notifications.map(({ id }) => id), page.complete], [200, [first.id, second.id], false])
    assert.deepStrictEqual([rest.status, (rest.body as NativePage).notifications.map(({ id }) => id), (rest.body as NativePage).complete], [200, [quiet.id], true])
    assert.deepStrictEqual(changed.status, 409)
  })

  const marked = try markRead(agent, first.id)
  const again = try markRead(agent, first.id)
  const absent = try markRead(agent, absentId)
  const malformed = try markRead(agent, "not-a-uuid")
  const [expired] = try notifyAll(service, [{ title: "An old reminder", category: "reminder", expiresAt: 1 }])
  const unread = try list(agent, "?unreadOnly=true")
  try Effect.try(() => {
    assert.deepStrictEqual([marked, again, absent], [
      { status: 200, body: { ok: true } }, { status: 200, body: { ok: false } }, { status: 200, body: { ok: false } },
    ])
    assert.include([400, 404], malformed.status)
    assert.include(service.listIncludingExpired().map(({ id }) => id), expired.id)
    assert.deepStrictEqual(listed(unread.body), [quiet.id, second.id])
    assert.deepInclude(unread.body as object, { unreadCount: 1 })
    assert.deepStrictEqual(service.listIncludingExpired().filter((notice) => notice.readAt != null).map(({ id }) => id), [first.id])
  })
}, 120_000)

it.effect('A stopped inbox answers 503 with Retry-After, never an empty list or ok false (spec/agent/notifications.md, "An inbox that is not durably available answers 503, never an empty list")', effect () => {
  const agent = try startInProcess(loaded)
  const service = try inbox(agent)
  const [notice] = try notifyAll(service, [{ title: "Call the dentist", category: "reminder" }])
  try host("inbox stop", () => service.stop())
  const asked = try call(agent, { method: "GET", path: "/api/notifications?nativeTransport=true" })
  const owner = try list(agent, "?unreadOnly=true")
  const marked = try markRead(agent, notice.id)
  const malformed = try list(agent, "?limit=101")
  try Effect.try(() => {
    assert.ok("status" in asked)
    if (!("status" in asked)) return
    assert.strictEqual(asked.status, 503)
    assert.match(asked.headers["retry-after"] ?? "", /^[1-9][0-9]*$/)
    assert.deepStrictEqual([owner.status, marked.status, malformed.status], [503, 503, 400])
  })
}, 120_000)

schema NoticeFrame {
  readonly type: "event"
  readonly event: {
    readonly type: "agent_event"
    readonly stream: "notification"
    readonly runId: string
    readonly seq: Schema.Int
    readonly payload: { readonly id: string }
  }
}

it.effect('A committed notice and its read mark arrive on the notification stream (spec/agent/notifications.md, "Story: Read my notices and mark them read from my own client")', effect () => {
  const agent = try startInProcess(loaded)
  const service = try inbox(agent)
  const feed = try events(agent, ["notification"])
  const subscribed = try host("notification subscription", () => feed.next())
  assert.include(JSON.stringify(subscribed), '"subscribed"')
  const runtime = agent.agent.runtime
  const bus = runtime.getService<AgentEventService>(AgentEventService.serviceType)
  if (bus === null) return try die("The Agent event service was not started")
  bus.emit({ runId: absentId, stream: "notification", data: { type: "notification", notification: { id: absentId } }, agentId: runtime.agentId })
  const [notice] = try notifyAll(service, [{ title: "Parcel delivered", category: "system" }])
  const decodeFrame = Schema.decodeUnknownEffect(NoticeFrame, { onExcessProperty: "error" })
  const created = try decodeFrame(try host("committed notification frame", () => feed.next()))
  assert.deepStrictEqual(created.event, { type: "agent_event", stream: "notification", runId: notice.id, seq: 1, payload: { id: notice.id } })
  const marked = try markRead(agent, notice.id)
  const updated = try decodeFrame(try host("committed notification read frame", () => feed.next()))
  assert.deepStrictEqual([marked, updated.event], [{ status: 200, body: { ok: true } }, { ...created.event, seq: 2 }])
}, 120_000)
