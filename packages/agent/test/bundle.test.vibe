// spec/agent/plugins/bundle.md, "Story: Ship one agent bundle whose contents and actions are known"; spec/agent/plugins/bundle.md, "No bundle carries a model weight file or a Node addon"; spec/agent/plugins/bundle.md, "A bundle without the local inference plugin carries only its required files and manifest, all at its root"; spec/agent/plugins/bundle.md, "A manifest is read only for its own bundle bytes and only when it is one a build could write"; spec/agent/plugins/bundle.md, "Profile groups name only bundled plugins, each in one group"; spec/agent/plugins/bundle.md, "Story: Start the agent from my own entry with my device's services"
import { assert, it } from "@effect/vitest"
import { baseFiles } from "../gen/agent__plugins__bundle.ts"
import { admitPayload, buildAgentBundle, BundleManifestUnreadable, BundleRefused, readBundleManifest, residentLoadList } from "../src/bundle/build.vibe"
import { migrations } from "../src/storage/schema.vibe"
import { host, scratch } from "./support/kernel.vibe"
import { productActionName, productPlugin } from "./support/product-plugin/index.ts"
import { hostedFixtureName } from "./support/hosted-fixture/index.ts"

module node {
  import { execFileSync } from "node:child_process"
  import { mkdir, readdir, readFile, rm, symlink, writeFile } from "node:fs/promises"
  import * as path from "node:path"
  import { agentDir } from "./support/child.ts"

  export const sourceRoot = path.resolve(agentDir, "../..")
  export const sourceCommit = execFileSync("git", ["rev-parse", "HEAD"], { cwd: agentDir, encoding: "utf8" }).trim()
  const fixtureLinks = [["product-fixture", "test/support/product-plugin"], ["hosted-fixture", "test/support/hosted-fixture"]] as const
  export const consumerEntry = path.relative(sourceRoot, path.join(agentDir, "test/support/product-plugin/entry.ts"))

  export async function linkFixture(): Promise<void> {
    for (const [name, directory] of fixtureLinks) {
      const link = path.join(sourceRoot, "node_modules", name)
      await rm(link, { force: true })
      await symlink(path.join(agentDir, directory), link, "dir")
    }
  }

  export async function unlinkFixture(): Promise<void> {
    for (const [name] of fixtureLinks) await rm(path.join(sourceRoot, "node_modules", name), { force: true })
  }

  export async function plant(dir: string, files: readonly string[]): Promise<void> {
    for (const file of files) {
      await mkdir(path.dirname(path.join(dir, file)), { recursive: true })
      await writeFile(path.join(dir, file), "x")
    }
  }

  export function listing(dir: string): Promise<string[]> {
    return readdir(dir).then((names) => names.sort())
  }

  export async function writeManifest(dir: string, manifest: unknown): Promise<void> {
    await writeFile(path.join(dir, "manifest.json"), JSON.stringify(manifest, null, 2) + "\n")
  }

  export async function tamper(dir: string): Promise<void> {
    const file = path.join(dir, "agent.mjs")
    await writeFile(file, `${await readFile(file, "utf8")}\n`)
  }
}
import { consumerEntry, linkFixture, listing, plant, sourceCommit, sourceRoot, tamper, unlinkFixture, writeManifest } from node

effect function fixturePackage() {
  return try acquireRelease(host("product package link", () => linkFixture()), () => orDie(host("product package unlink", () => unlinkFixture())))
}

it.effect('A build from the source root ships the product plugin as a package, loads it in the smoke and writes a manifest readable only for its own bytes and well-formed profile groups (spec/agent/plugins/bundle.md, "Story: Ship one agent bundle whose contents and actions are known"; spec/agent/plugins/bundle.md, "Story: Declare which bundled plugins each device variant may load")', effect () => {
  try fixturePackage()
  const out = try scratch("bundle-out")
  try host("previous bundle", () => plant(out.path, ["stale.txt"]))
  const profiles = { core: [], views: [], aospOnly: [], optional: [] }
  const manifest = try host("bundle build", () => buildAgentBundle({ plugins: [], productPlugin: productPlugin.name, profiles, outDir: out.path, sourceCommit, sourceRoot }))
  const read = try host("manifest read", () => readBundleManifest(out.path))
  const files = try host("bundle listing", () => listing(out.path))
  try Effect.try(() => {
    assert.deepStrictEqual(read, manifest)
    assert.deepStrictEqual(files, [...baseFiles, "manifest.json"].sort())
    assert.deepStrictEqual(
      { schema: manifest.schema, node: manifest.node, sourceCommit: manifest.sourceCommit, schemaVersion: manifest.schemaVersion, plugins: manifest.plugins, productPlugin: manifest.productPlugin, localInference: manifest.localInference, worker: manifest.workflowWorkerSha256 },
      { schema: 1, node: "26", sourceCommit, schemaVersion: migrations.length, plugins: [], productPlugin: productPlugin.name, localInference: false, worker: undefined },
    )
    assert.includeMembers(manifest.packages.map(({ name }) => name), [productPlugin.name, "@elizaos/agent", "@elizaos/core"])
    assert.includeDeepMembers([...manifest.actions], [{ name: productActionName }, { name: "REPLY" }])
    assert.deepStrictEqual(manifest.profiles, profiles)
    assert.deepStrictEqual(residentLoadList(read, "AospImage", [productPlugin.name]), [])
  })
  try host("product-grouped manifest", () => writeManifest(out.path, { ...manifest, profiles: { ...profiles, core: [productPlugin.name] } }))
  const grouped = try Effect.flip(host("product-grouped manifest read", () => readBundleManifest(out.path)))
  try Effect.try(() => assert.instanceOf(grouped.cause, BundleManifestUnreadable))
  try host("manifest restore", () => writeManifest(out.path, manifest))
  try host("bundle tamper", () => tamper(out.path))
  const refused = try Effect.flip(host("tampered manifest read", () => readBundleManifest(out.path)))
  try Effect.try(() => assert.instanceOf(refused.cause, BundleManifestUnreadable))
}, 1_500_000)

it.effect('A build that lists the product plugin among the plugins, or groups a plugin it does not carry, is refused and leaves the previous bundle as it was (spec/agent/plugins/bundle.md, "A build is refused unless every input that emitted bytes comes from a named package inside the source root, at least one did, and the entry imports nothing but Node built-ins"; spec/agent/plugins/bundle.md, "Profile groups name only bundled plugins, each in one group")', effect () => {
  const out = try scratch("bundle-kept")
  try host("previous bundle", () => plant(out.path, ["agent.mjs"]))
  const refused = try Effect.flip(host("bundle build", () =>
    buildAgentBundle({ plugins: [productPlugin.name], productPlugin: productPlugin.name, outDir: out.path, sourceCommit, sourceRoot })))
  const files = try host("bundle listing", () => listing(out.path))
  try Effect.try(() => {
    assert.instanceOf(refused.cause, BundleRefused)
    assert.strictEqual(refused.cause instanceof BundleRefused ? refused.cause.verdict : undefined, "InputsMalformed")
    assert.deepStrictEqual(files, ["agent.mjs"])
  })
  const grouped = try Effect.flip(host("grouped bundle build", () =>
    buildAgentBundle({ plugins: [], productPlugin: productPlugin.name, profiles: { core: [], views: [], aospOnly: ["@elizaos/plugin-native-phone"], optional: [] }, outDir: out.path, sourceCommit, sourceRoot })))
  try Effect.try(() => assert.strictEqual(grouped.cause instanceof BundleRefused ? grouped.cause.verdict : undefined, "InputsMalformed"))
})

it.effect('The payload refuses weights, addons and, without local inference, versioned shared libraries and anything off the root (spec/agent/plugins/bundle.md, "No bundle carries a model weight file or a Node addon"; spec/agent/plugins/bundle.md, "A bundle without the local inference plugin carries only its required files and manifest, all at its root")', effect () => {
  const staging = try scratch("bundle-payload")
  try host("payload files", () => plant(staging.path, [...baseFiles, "vector.tar.gz", "models/base.GGUF", "lib/libggml.so.1.2", "addon.node", "tts/voice.bin"]))
  const cloudOnly = try host("cloud payload", () => admitPayload(staging.path, false))
  const local = try host("local payload", () => admitPayload(staging.path, true))
  const paths = (files: readonly { readonly name: string; readonly directories: readonly string[] }[]) =>
    files.map(({ name, directories }) => [...directories, name].join("/")).sort()
  try Effect.try(() => {
    assert.deepStrictEqual(paths(cloudOnly.refused), ["addon.node", "lib/libggml.so.1.2", "models/base.GGUF", "tts/voice.bin", "vector.tar.gz"])
    assert.deepStrictEqual(paths(local.refused), ["addon.node", "models/base.GGUF"])
    assert.strictEqual(cloudOnly.files.find(({ name }) => name === "libggml.so.1.2")?.extension, "so")
  })
})

it.effect('A consumer entry inside a named source package starts the agent with a host module built over its device service, and the smoke registers that module\'s action (spec/agent/plugins/bundle.md, "A consumer entry ships only as a named package\'s code inside the source root, and passes the same load smoke as the generated entry"; spec/agent/plugins/bundle.md, "A host module is named only for a bundled package that is not an agent module, and runs with its entry\'s services over the resident\'s platform layer")', effect () => {
  try fixturePackage()
  const out = try scratch("bundle-entry-out")
  const manifest = try host("bundle build with a consumer entry", () =>
    buildAgentBundle({ plugins: [hostedFixtureName], productPlugin: productPlugin.name, entry: consumerEntry, outDir: out.path, sourceCommit, sourceRoot }))
  try Effect.try(() => {
    assert.deepStrictEqual({ plugins: manifest.plugins, productPlugin: manifest.productPlugin }, { plugins: [hostedFixtureName], productPlugin: productPlugin.name })
    assert.includeMembers(manifest.packages.map(({ name }) => name), [productPlugin.name, hostedFixtureName])
    assert.includeDeepMembers([...manifest.actions], [{ name: "HOSTED_SOCKET" }, { name: productActionName }])
  })
}, 1_500_000)
