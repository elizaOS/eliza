// spec/agent/deviceActions/index.md, "Story: Complete the original request with the result I shared"
import { assert, it } from "@effect/vitest"
import { parseLaunch } from "../src/host/launch.vibe"
import { startAgent } from "../src/host/process.vibe"
import { cloudFake, deviceKey, host, scratch } from "./support/kernel.vibe"
import { launchDocument, launchFrame } from "./support/scratch.ts"

module node {
  import { Effect } from "effect"
  import type { Memory, UUID } from "@elizaos/core"
  import { machineOver, initial, type DeviceRequest, type Event } from "../gen/agent__deviceActions.effect.vibe"
  import type { SessionOwner } from "../gen/core__sessions.effect.vibe"
  import { readCompletionRoutes, type StoredRequest } from "../src/device-actions/read-completion.vibe"
  import type { ModuleFactory } from "../src/host/module.vibe"
  import type { RunningAgent } from "../src/host/process.vibe"
  import { text, type CloudFake } from "./support/cloud-fake.ts"
  import { request } from "./support/socket-client.ts"

  const moduleName = "@elizaos/agent/device-actions"
  const capability = "calendar.read.v1"
  const result = { kind: "calendar", events: [{ title: "Dentist", start: "2026-11-18T09:00:00Z" }] }

  export function requestBook() {
    const kept = new Map<string, { state: DeviceRequest }>()
    const machineFor = (proposalId: string) => {
      const record = kept.get(proposalId) ?? { state: initial }
      kept.set(proposalId, record)
      return Effect.runPromise(machineOver(() => Effect.sync(() => record.state), (next) => Effect.sync(() => { record.state = next })))
    }
    const open = (proposalId: string) => kept.has(proposalId)
      ? Effect.map(Effect.promise(() => machineFor(proposalId)), (machine): StoredRequest => ({ machine, result }))
      : Effect.succeed(undefined)
    const factory: ModuleFactory<never> = (context) => Effect.succeed({
      name: moduleName,
      plugin: {
        name: moduleName, description: "Device requests",
        routes: readCompletionRoutes({ runtime: context.runtime, sender: () => Effect.succeed(ownerOf(context.runtime.agentId)), open }),
      },
    })
    async function drive(proposalId: string, by: SessionOwner, events: readonly Event[]) {
      const machine = await machineFor(proposalId)
      for (const event of events) await Effect.runPromise(machine.send(event, by))
    }
    return { modules: new Map([[moduleName, factory]]), drive }
  }

  const ownerOf = (agentId: string): SessionOwner => ({ agentId, actorId: "owner-user", connector: agentId })

  function appliedRead(proposalId: string, origin: { requestId: string; conversationId: string; inReplyTo: string }): Event[] {
    const digest = `digest-${proposalId}`
    return [
      { type: "elapse", elapsed: Date.now() },
      { type: "registerDevice", keyHash: "device-key-hash", capabilities: [capability], workflowProtocol: 1 },
      { type: "offer", proposalId, digest, capability, expiresAt: Date.now() + 600_000, readBack: true, origin },
      { type: "decide", digest, approved: true },
      { type: "claim", digest },
      { type: "receipt", digest, attemptId: 1, reportedOutcome: "ReportedApplied" },
    ]
  }

  export async function completeOriginalRead(running: RunningAgent, socket: string, token: string, cloud: CloudFake, book: ReturnType<typeof requestBook>) {
    const call = async (path: string, body: object) => {
      const answer = await request(socket, { method: "POST", path, token, body })
      if (!("status" in answer)) throw new Error(answer.refused)
      return answer
    }
    const inferences = () => cloud.calls.filter(({ path }) => path === "/api/v1/chat/completions").length
    const opened = await call("/api/conversations", {})
    const { conversation } = opened.json as { conversation: { id: string; roomId: UUID } }
    cloud.script(text("Let me check your calendar."))
    await call(`/api/conversations/${conversation.id}/messages`, { text: "What is on my calendar tomorrow?" })
    const messages = await running.runtime.getMemories({ tableName: "messages", roomId: conversation.roomId, count: 10 })
    const asked = messages.find((message: Memory) => message.entityId !== running.runtime.agentId)
    if (asked?.id === undefined) throw new Error("The original request was not stored")
    const origin = { requestId: "request-1", conversationId: conversation.id, inReplyTo: asked.id }
    const by = ownerOf(running.status.agentId)
    await book.drive("p1", by, appliedRead("p1", origin))
    await book.drive("p2", by, appliedRead("p2", origin))
    const hint = { proposalId: "p1", digest: "digest-p1", attemptId: 1, ...origin }
    const completion = "/api/client-devices/proposals/p1/read-completion"
    const before = inferences()
    const wrongConversation = await call(completion, { ...hint, conversationId: "another" })
    const wrongAttempt = await call(completion, { ...hint, attemptId: 2 })
    cloud.script(text("You have the dentist at 9 tomorrow."))
    const first = await call(completion, hint)
    const repeated = await call(completion, hint)
    const cancelled = await call("/api/client-devices/proposals/p1/cancel-read-completion", { digest: "digest-p1" })
    const afterCancel = await call(completion, hint)
    await book.drive("p2", by, [{ type: "elapse", elapsed: 660_000 }])
    const lapsed = await call("/api/client-devices/proposals/p2/read-completion", { ...hint, proposalId: "p2", digest: "digest-p2" })
    const reply = (first.json as { reply: { messageId: UUID } }).reply
    const stored = await running.runtime.getMemoryById(reply.messageId)
    return {
      wrongConversation: wrongConversation.status, wrongAttempt: wrongAttempt.status,
      first: first.json, repeated: repeated.json, cancelled: cancelled.json, afterCancel: afterCancel.json, lapsed: lapsed.status,
      inferences: inferences() - before,
      stored: { roomId: stored?.roomId, inReplyTo: stored?.content.inReplyTo, text: stored?.content.text },
      expected: { roomId: conversation.roomId, inReplyTo: asked.id, messageId: reply.messageId, conversationId: conversation.id },
    }
  }
}

import { completeOriginalRead, requestBook } from node

it.effect('A shared device read answers the original request once, in its conversation (spec/agent/deviceActions/index.md, "Story: Complete the original request with the result I shared")', effect () => {
  const state = try scratch("read-completion")
  const cloud = try cloudFake(deviceKey)
  const socket = state.file("agent.sock")
  const frame = launchFrame({ credential: { version: 1, value: deviceKey } })
  const book = try Effect.try(() => requestBook())
  const config = try Effect.try(() => launchDocument({
    callerRole: "owner", backend: { kind: "cloud", origin: cloud.origin }, load: ["@elizaos/agent/device-actions"], hostContextRevision: 1,
  }))
  const parsed = try parseLaunch(JSON.stringify(config), JSON.stringify(frame))
  const running = try acquireRelease(
    startAgent({ ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: socket }, modules: book.modules }),
    (agent) => orDie(host("retire agent", () => agent.stop())),
  )
  const observed = try host("read completion journey", () => completeOriginalRead(running, socket, frame.token, cloud, book))
  const reply = {
    messageId: observed.expected.messageId, requestId: "request-1", conversationId: observed.expected.conversationId,
    inReplyTo: observed.expected.inReplyTo, text: "You have the dentist at 9 tomorrow.",
  }
  try Effect.try(() => assert.deepStrictEqual({ ...observed, expected: undefined }, {
    wrongConversation: 409, wrongAttempt: 409,
    first: { reply }, repeated: { reply }, cancelled: { completion: "CompletionDelivered" }, afterCancel: { reply }, lapsed: 409,
    inferences: 1,
    stored: { roomId: observed.expected.roomId, inReplyTo: observed.expected.inReplyTo, text: reply.text },
    expected: undefined,
  }))
}, 180_000)
