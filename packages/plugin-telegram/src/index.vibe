// spec/telegram/index.md, "Only the current poller can mark its claim healthy, terminated or released"; spec/telegram/index.md, "The effective Telegram allowlist can deny all chats, and DMs default to pairing when no list is set"; spec/telegram/index.md, "An admitted command keeps its sender and a reply stays in its account, chat and topic"; spec/telegram/delivery.md, "Story: Keep a pinned task board or progress status as one message across edits, deletions, and restarts"; spec/telegram/delivery.md, "Story: Enforce fail-closed owner pairing, canonical world ownership, and bounded history queries"
import { getConnectorAccountManager, type Plugin, type ServiceClass } from "@elizaos/core"
import { TelegramAccountService } from "./account-client.vibe"
import { telegramAction, telegramStatusProvider } from "./actions.vibe"
import { createTelegramConnectorAccountProvider, registerTelegramDmSensitiveRequestAdapter, registerTelegramTriageAdapter } from "./adapters.vibe"
import { TelegramOwnerPairingServiceImpl } from "./owner-pairing.vibe"
import { stopTelegramAccountAuthSession, telegramAccountRoutes, telegramSetupRoutes } from "./routes.vibe"
import { TelegramService } from "./service.vibe"
import { TelegramStandaloneService } from "./standalone.vibe"
import { TELEGRAM_PERSONAL_SERVICE_TYPE, TELEGRAM_SERVICE_NAME, type TelegramRoute } from "./types.vibe"

export * from "./types.vibe"
export * from "./formatting.vibe"
export * from "./policy.vibe"
export * from "./poller-lock.vibe"
export * from "./task-board.vibe"
export * from "./message-manager.vibe"
export * from "./owner-pairing.vibe"
export * from "./account-client.vibe"
export * from "./adapters.vibe"
export * from "./routes.vibe"
export * from "./actions.vibe"
export * from "./standalone.vibe"
export * from "./service.vibe"

export type TelegramPlugin = Plugin & { readonly routes: readonly TelegramRoute[] }

export const telegramPlugin: TelegramPlugin = {
  name: TELEGRAM_SERVICE_NAME,
  description: "Multi-account Telegram bot and personal account connector",
  connectorSources: [
    {
      source: "telegram",
      aliases: ["telegram", "telegram-account", "telegramaccount"],
      sourceKind: "passive",
      isPassive: true,
      identityMetadataMapping: {
        userIdField: "fromId",
        nameField: "entityName",
      },
      worldIdMetadataKeys: ["telegramChatId"],
    },
  ],
  services: [
    TelegramService as ServiceClass,
    TelegramOwnerPairingServiceImpl as ServiceClass,
    TelegramStandaloneService as ServiceClass,
    TelegramAccountService as ServiceClass,
  ],
  actions: [telegramAction],
  providers: [telegramStatusProvider],
  routes: [...telegramSetupRoutes, ...telegramAccountRoutes],
  autoEnable: {
    connectorKeys: ["telegram", "telegramAccount"],
  },
  init: async (_config, runtime) => {
    Effect.runSync(Effect.result(Effect.try(() => {
      getConnectorAccountManager(runtime).registerProvider(createTelegramConnectorAccountProvider(runtime))
    })))
    registerTelegramDmSensitiveRequestAdapter(runtime)
    registerTelegramTriageAdapter()
  },
  dispose: async (runtime) => {
    await stopTelegramAccountAuthSession(runtime)
    const personal = runtime.getService<TelegramAccountService>(TELEGRAM_PERSONAL_SERVICE_TYPE)
    await personal?.stop()
    await TelegramService.stop(runtime)
    await TelegramStandaloneService.stop(runtime)
  },
}

export default telegramPlugin
