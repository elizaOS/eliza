// spec/files/shownTargets.md, "A Files operation the owner asks for in chat is proposed only within the Files bounds and as the peer negotiated it"; spec/files/shownTargets.md, "Files operations need files.browser.v1, and a shown share, move or trash also needs files.shown-target.v1"; spec/files/shownTargets.md, "A move or trash binds the identity of each reviewed file, and a share binds none"
import { readOperation, type CheckedOperation, type DeviceOperation, type DeviceProposalFamily, type DeviceTurn, type Grounding, type ProposalForm } from "@elizaos/agent/device-actions"
import { chatProposalKept } from "../gen/files__shownTargets.effect.vibe"
import {
  decodeFilesOperation, FILES_CAPABILITY, FILES_DIRECT_TYPES, FILES_OPERATION_TYPES, FILES_SHOWN_TARGET_CAPABILITY, filesForm, filesToolSurface,
  type FilesAgentOperation,
} from "./contract.vibe"

const filesGuidance = "Phone Files: to find files, use files_filter; it only narrows what Files shows and returns a count, never file names or contents. files_open shows one file by path or by shown, for example shown 1 when the filter found one file. files_share, files_move, files_trash and files_folder_create are reviewed with Files on screen; a move never replaces a file with the same name, and Trash is restorable for 30 days. Use only paths the owner named or Files showed."

const every = filesToolSurface([FILES_CAPABILITY, FILES_SHOWN_TARGET_CAPABILITY]).schemas

const forms: readonly ProposalForm[] = every.flatMap((schema): ProposalForm[] => {
  const type = FILES_OPERATION_TYPES.find((name) => schema.properties?.type?.enum?.includes(name) === true)
  return type === undefined ? [] : [{ types: [type], schema, offered: (turn: DeviceTurn) => filesToolSurface(turn.capabilities).schemas.includes(schema) }]
})

const outOfBounds: Grounding = {
  kind: "Refused", code: "FILES_OPERATION_REFUSED",
  forModel: "The Files operation is outside the Files bounds (a path outside Internal storage, a repeated path or a hidden folder name) or a form this phone did not negotiate. No device proposal was created. Use only paths the owner named or positions Files showed.",
  forOwner: "I couldn't prepare that in Files.",
}

function withoutIdentities(operation: FilesAgentOperation): FilesAgentOperation {
  if ((operation.type !== "files_move" && operation.type !== "files_trash") || !("reviewed" in operation)) return operation
  const { reviewed: _reviewed, ...unbound } = operation
  return unbound
}

function kept(operation: FilesAgentOperation, turn: DeviceTurn): DeviceOperation | undefined {
  const { kind, form } = filesForm(operation)
  const admitted = chatProposalKept(true, kind, form, turn.capabilities.includes(FILES_CAPABILITY), turn.capabilities.includes(FILES_SHOWN_TARGET_CAPABILITY))
  return admitted ? readOperation(withoutIdentities(operation))?.operation : undefined
}

export const filesProposalFamily: DeviceProposalFamily = {
  name: "files",
  types: FILES_OPERATION_TYPES,
  forms,
  guidance: (turn) => [filesGuidance, ...filesToolSurface(turn.capabilities).guidance].join(" "),
  effect ground(proposed: CheckedOperation, turn: DeviceTurn) {
    const decoded = try (decodeFilesOperation(proposed.operation) catch () => undefined)
    const operation = decoded === undefined ? undefined : kept(decoded, turn)
    return operation === undefined ? outOfBounds : { kind: "Grounded", operation } satisfies Grounding
  },
  proposedText: (operation) => FILES_DIRECT_TYPES.some((type) => type === operation.type)
    ? "Review this request on your phone before it can run."
    : "Review this in Files on your phone before it can run.",
  settledText: () => undefined,
}
