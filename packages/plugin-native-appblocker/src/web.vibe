// spec/nativeAppblocker/index.md, "Story: Block only the apps I selected for a chosen interval"
import { WebPlugin } from "@capacitor/core"
import type {
  AppBlockerCapabilities,
  AppBlockerPermissionResult,
  AppBlockerPlugin,
  AppBlockerStatus,
  BlockAppsOptions,
  BlockAppsResult,
  InstalledApp,
  SelectAppsResult,
  UnblockAppsResult,
} from "./native-contract.vibe"

const PACKAGE_NAME_RE = /^[A-Za-z][A-Za-z0-9_]*(?:\.[A-Za-z][A-Za-z0-9_]*)+$/
const WEB_UNAVAILABLE_REASON = "App blocking is only available on mobile devices."

const EMPTY_CAPABILITIES: AppBlockerCapabilities = {
  canSelectApps: false,
  canBlockApps: false,
  canScheduleTimedBlocks: false,
  canUnblockEarly: false,
  requiresFamilyControls: false,
  requiresUsageAccess: false,
  requiresOverlay: false,
}

module appBlockerErrors {
  export function failValidation(message: string): never {
    throw new Error(message)
  }
}
import { failValidation } from appBlockerErrors

export function validateBlockAppsOptions(options: BlockAppsOptions): void {
  const packageNames = Array.isArray(options?.packageNames) ? options.packageNames : []
  const appTokens = Array.isArray(options?.appTokens) ? options.appTokens : []

  for (const packageName of packageNames) {
    if (typeof packageName !== "string" || !PACKAGE_NAME_RE.test(packageName.trim())) {
      failValidation("packageNames must contain valid Android package names")
    }
  }

  for (const token of appTokens) {
    if (typeof token !== "string" || token.trim().length === 0) {
      failValidation("appTokens must contain non-empty strings")
    }
  }

  if (options?.durationMinutes !== undefined && options.durationMinutes !== null) {
    if (typeof options.durationMinutes !== "number" || !Number.isFinite(options.durationMinutes) || options.durationMinutes <= 0) {
      failValidation("durationMinutes must be a positive finite number")
    }
  }
}

function unavailablePermission(): AppBlockerPermissionResult {
  return {
    status: "not-applicable",
    canRequest: false,
    canOpenSettings: false,
    settingsTarget: null,
    engine: "none",
    capabilities: { ...EMPTY_CAPABILITIES },
    reason: WEB_UNAVAILABLE_REASON,
  }
}

export class AppBlockerWeb extends WebPlugin implements AppBlockerPlugin {
  async checkPermissions(): Promise<AppBlockerPermissionResult> {
    return unavailablePermission()
  }

  async requestPermissions(): Promise<AppBlockerPermissionResult> {
    return unavailablePermission()
  }

  async getInstalledApps(): Promise<{ apps: InstalledApp[] }> {
    return { apps: [] }
  }

  async selectApps(): Promise<SelectAppsResult> {
    return { apps: [], cancelled: true }
  }

  async blockApps(options: BlockAppsOptions): Promise<BlockAppsResult> {
    validateBlockAppsOptions(options)
    return {
      success: false,
      endsAt: null,
      error: WEB_UNAVAILABLE_REASON,
      blockedCount: 0,
    }
  }

  async unblockApps(): Promise<UnblockAppsResult> {
    return {
      success: false,
      error: WEB_UNAVAILABLE_REASON,
    }
  }

  async getStatus(): Promise<AppBlockerStatus> {
    return {
      status: "unavailable",
      available: false,
      active: false,
      platform: "web",
      engine: "none",
      capabilities: { ...EMPTY_CAPABILITIES },
      blockedCount: 0,
      blockedPackageNames: [],
      endsAt: null,
      permissionStatus: "not-applicable",
      canRequest: false,
      canOpenSettings: false,
      settingsTarget: null,
      reason: WEB_UNAVAILABLE_REASON,
    }
  }
}
