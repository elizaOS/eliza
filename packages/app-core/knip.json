{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts}",
    "test/**/*.{ts,tsx}",
    "platforms/**/*.{ts,tsx}",
    "vitest*.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts}",
    "test/**/*.{ts,tsx}",
    "platforms/**/*.{ts,tsx}",
    "*.ts"
  ],
  "ignoreBinaries": [
    "adb",
    "afconvert",
    "anvil",
    "brew",
    "cmake",
    "file",
    "findstr",
    "hf",
    "log",
    "netstat",
    "ninja",
    "nm",
    "nvidia-smi",
    "otool",
    "pgrep",
    "rg",
    "ruby",
    "say",
    "secret-tool",
    "strip",
    "swift",
    "tsc6",
    "where",
    "winget"
  ],
  "ignoreDependencies": [
    "@capacitor/background-runner",
    "@capacitor/barcode-scanner",
    "@capacitor/haptics",
    "@capacitor/keyboard",
    "@capacitor/local-notifications",
    "@capacitor/push-notifications",
    "@elizaos/plugin-anthropic",
    "@elizaos/plugin-openai",
    "@elizaos/plugin-wechat",
    "tailwindcss"
  ],
  "ignoreUnresolved": ["scripts/build.mjs"],
  "vite": false,
  "vitest": false
}
