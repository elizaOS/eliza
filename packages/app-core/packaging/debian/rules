#!/usr/bin/make -f

REPO_ROOT := $(shell if [ -d "$(CURDIR)/packages/agent" ]; then printf '%s' "$(CURDIR)"; else cd "$(CURDIR)/../.." && pwd; fi)
AGENT_DIR := $(REPO_ROOT)/packages/agent
APP_CORE_DIR := $(REPO_ROOT)/packages/app-core
RUNTIME_DIR := $(CURDIR)/debian/elizaos-app/usr/lib/elizaos-app
NODE_VERSION := 24.15.0

%:
	dh $@

override_dh_auto_build:
	command -v bun >/dev/null 2>&1 || { echo "ERROR: Bun is required to build the elizaOS runtime" >&2; exit 1; }
	cd "$(REPO_ROOT)" && ELIZAOS_APP_SKIP_LOCAL_UPSTREAMS=1 bun install --frozen-lockfile --ignore-scripts
	cd "$(REPO_ROOT)" && bun run --cwd packages/shared build
	cd "$(REPO_ROOT)" && bun run --cwd packages/agent build
	cd "$(REPO_ROOT)" && bun run --cwd packages/app-core build

override_dh_auto_install:
	cd "$(REPO_ROOT)" && node packages/scripts/rm-path-recursive.mjs "$(RUNTIME_DIR)"
	install -d "$(RUNTIME_DIR)/packages/agent"
	cp -a "$(AGENT_DIR)/dist" "$(RUNTIME_DIR)/packages/agent/dist"
	cp "$(AGENT_DIR)/package.json" "$(RUNTIME_DIR)/packages/agent/package.json"
	cd "$(REPO_ROOT)" && node -e 'const fs=require("node:fs"); const root=JSON.parse(fs.readFileSync("package.json")); const target=process.argv[1]; const agent=JSON.parse(fs.readFileSync(target)); agent.version=root.version; fs.writeFileSync(target, JSON.stringify(agent, null, 2) + "\n");' "$(RUNTIME_DIR)/packages/agent/package.json"
	install -m 644 "$(REPO_ROOT)/package.json" "$(RUNTIME_DIR)/package.json"
	install -m 644 "$(REPO_ROOT)/plugins.json" "$(RUNTIME_DIR)/plugins.json"
	install -d "$(RUNTIME_DIR)/node"
	case "$$(dpkg-architecture -qDEB_HOST_ARCH)" in \
		amd64) node_arch=x64; node_sha256=472655581fb851559730c48763e0c9d3bc25975c59d518003fc0849d3e4ba0f6 ;; \
		arm64) node_arch=arm64; node_sha256=f3d5a797b5d210ce8e2cb265544c8e482eaedcb8aa409a8b46da7e8595d0dda0 ;; \
		*) echo "ERROR: unsupported Debian runtime architecture: $$(dpkg-architecture -qDEB_HOST_ARCH)" >&2; exit 1 ;; \
	esac; \
	node_archive="$(CURDIR)/debian/node-v$(NODE_VERSION)-linux-$$node_arch.tar.xz"; \
	curl --fail --location --proto '=https' --tlsv1.2 \
		"https://nodejs.org/dist/v$(NODE_VERSION)/node-v$(NODE_VERSION)-linux-$$node_arch.tar.xz" \
		--output "$$node_archive"; \
	printf '%s  %s\n' "$$node_sha256" "$$node_archive" | sha256sum --check --strict; \
	tar -xJf "$$node_archive" --strip-components=1 -C "$(RUNTIME_DIR)/node"; \
	rm -f "$$node_archive"
	cd "$(REPO_ROOT)" && node --import tsx packages/app-core/scripts/copy-runtime-node-modules.ts \
		--scan-dir packages/agent/dist \
		--target-dist "$(RUNTIME_DIR)"
	dangling_runtime_link="$$(find "$(RUNTIME_DIR)/node_modules" -xtype l -print -quit)"; \
		if [ -n "$$dangling_runtime_link" ]; then \
			echo "ERROR: staged Debian runtime contains dangling link: $$dangling_runtime_link" >&2; \
			exit 1; \
		fi
	case "$$(dpkg-architecture -qDEB_HOST_ARCH)" in \
		amd64) expected_elf='x86-64' ;; \
		arm64) expected_elf='ARM aarch64' ;; \
		*) echo "ERROR: unsupported Debian runtime architecture: $$(dpkg-architecture -qDEB_HOST_ARCH)" >&2; exit 1 ;; \
	esac; \
	foreign_elf="$$(find "$(RUNTIME_DIR)" -type f -exec file {} + | awk -v expected="$$expected_elf" 'index($$0, "ELF") && !index($$0, expected) { print; exit }')"; \
	if [ -n "$$foreign_elf" ]; then \
		echo "ERROR: staged Debian runtime contains a foreign-architecture ELF: $$foreign_elf" >&2; \
		exit 1; \
	fi

	install -d debian/elizaos-app/usr/bin
	printf '#!/bin/sh\nexport PATH="/usr/lib/elizaos-app/node/bin:$$PATH"\nexport NODE_PATH="/usr/lib/elizaos-app/node_modules"\nexec /usr/lib/elizaos-app/node/bin/node /usr/lib/elizaos-app/packages/agent/dist/bin.js "$$@"\n' \
		> debian/elizaos-app/usr/bin/elizaos-app
	chmod 755 debian/elizaos-app/usr/bin/elizaos-app

	install -m 644 "$(APP_CORE_DIR)/packaging/debian/elizaos-app.service" \
		debian/elizaos-app/usr/lib/elizaos-app/elizaos-app.service

override_dh_auto_test:
	# Skip tests during package build
	true

override_dh_dwz:
	dh_dwz -Xusr/lib/elizaos-app

override_dh_strip:
	dh_strip -Xusr/lib/elizaos-app

override_dh_auto_clean:
	cd "$(REPO_ROOT)" && node packages/scripts/rm-path-recursive.mjs packages/app-core/dist packages/agent/dist
	dh_auto_clean
