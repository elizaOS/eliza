// spec/os/android/passwords/vault.md, "The page sees vault entries only as metadata, and only while it is unlocked"; spec/os/android/passwords/vault.md, "Outside the vault page, an app learns only whether any password is saved"; spec/os/android/passwords/vault.md, "A row action acts on the revision the owner selected"; spec/os/android/passwords/autofill.md, "A form is fillable only for one exact HTTPS origin or one other app"
import { assert, it } from "@effect/vitest"
import { Machine, machine } from "../gen/os__android__passwords__vault.effect.vibe"
import {
  PasswordsClientError,
  assertNoSecretFields,
  bindingKind,
  createPasswordsClient,
  createTransferClient,
  filterEntries,
  listReplyOf,
  normalizeWebsite,
  parseEntries,
  parseStatus,
  passwordTransferPlugin,
  passwordsPlugin,
} from "../src/bridges/passwords.vibe"

module android {
  import { CapacitorException } from "@capacitor/core"
  import { mayUseSelectedVaultRecord } from "../gen/os__android__passwords__vault.ts"
  import type { ElizaPasswordTransferPlugin, ElizaPasswordsPlugin, PasswordBinding } from "../src/bridges/definitions/passwords.ts"

  interface Stored {
    label: string
    username: string
    password: string
    bindings: PasswordBinding[]
    revision: number
    updatedAt: number
  }

  export interface Vault {
    locked: boolean
    cancelUnlock: boolean
    leaksSecrets: boolean
    readable: boolean
    records: Map<string, Stored>
    clipboard: string | null
    exports: number
    importReply: unknown
  }

  /** @throws {never} */
  export function vault(): Vault {
    return {
      locked: true,
      cancelUnlock: false,
      leaksSecrets: false,
      readable: true,
      records: new Map([
        ["e1", { label: "Mail", username: "owner@example.com", password: "hunter2", bindings: [{ kind: "web", facet: "https://mail.example.com", display: "mail.example.com" }], revision: 3, updatedAt: 1700 }],
        ["e2", { label: "Bank", username: "owner", password: "s3cret", bindings: [{ kind: "android", facet: `android://${"a".repeat(64)}@com.example.bank`, display: "Bank" }], revision: 1, updatedAt: 1800 }],
      ]),
      clipboard: null,
      exports: 0,
      importReply: { imported: 2, skipped: 1 },
    }
  }

  /** @throws {never} */
  export function androidPasswords(device: Vault): ElizaPasswordsPlugin {
    const rejection = (code: string, message = code) => Object.assign(new CapacitorException(message), { code })
    const unlocked = async () => {
      if (device.locked) throw rejection("locked", "Vault locked")
    }
    const selected = async (input: { id: string; expectedRevision?: number }) => {
      await unlocked()
      const record = device.records.get(input.id)
      const allowed = mayUseSelectedVaultRecord(
        input.expectedRevision === undefined ? { tag: "ById" } : { tag: "AtRevision", rev: input.expectedRevision },
        record === undefined ? { tag: "MissingRecord" } : { tag: "CurrentRecord", rev: record.revision },
      )
      if (!allowed || record === undefined) throw rejection("conflict", `Entry ${input.id} changed`)
      return record
    }
    return {
      status: async () => ({
        available: true,
        locked: device.locked,
        unlockRemainingMs: device.locked ? 0 : 30_000,
        unlockSeconds: 30,
        biometric: true,
        autofill: { supported: true, selected: "this-app" },
      }),
      unlock: async () => {
        if (device.cancelUnlock) throw rejection("cancelled", "User cancelled the prompt for owner@example.com")
        device.locked = false
        return { unlocked: true, unlockRemainingMs: 30_000 }
      },
      lock: async () => {
        device.locked = true
        return { locked: true }
      },
      list: async () => {
        await unlocked()
        const entries = [...device.records].map(([id, { password, ...record }]) => ({ id, ...record, ...(device.leaksSecrets ? { password } : {}) }))
        return { entries } as Awaited<ReturnType<ElizaPasswordsPlugin["list"]>>
      },
      anySaved: async () => {
        await unlocked()
        const saved = device.records.size > 0
        return (device.leaksSecrets ? { saved, labels: [...device.records.values()].map((r) => r.label) } : { saved }) as Awaited<ReturnType<ElizaPasswordsPlugin["anySaved"]>>
      },
      save: async (input) => {
        await unlocked()
        if (input.label.length === 0) throw rejection("invalid", "Enter a name.")
        const id = input.id ?? `e${device.records.size + 1}`
        const password = input.password ?? "generated-password-0123"
        const bindings = input.websites.map((facet): PasswordBinding => ({ kind: "web", facet, display: facet.slice("https://".length) }))
        device.records.set(id, { label: input.label, username: input.username, password, bindings, revision: 1, updatedAt: 1900 })
        return input.generate === undefined ? { id } : { id, generated: true, length: password.length }
      },
      openEditor: async (input) => {
        if (input === undefined) return { status: "cancelled" }
        const record = await selected({ id: input.entryId, expectedRevision: input.expectedRevision })
        record.revision += 1
        return { status: "saved", id: input.entryId, revision: record.revision }
      },
      remove: async (input) => {
        await selected(input)
        device.records.delete(input.id)
        return { removed: true }
      },
      reset: async () => {
        await unlocked()
        if (device.readable) throw rejection("invalid", "The vault can still be read.")
        device.records.clear()
        return { reset: true }
      },
      reveal: async (input) => {
        await selected(input)
        return { shown: true, hidesAfterMs: 30_000 }
      },
      copy: async (input) => {
        device.clipboard = (await selected(input)).password
        return { copied: true, clearsAfterMs: 45_000 }
      },
      openAutofillSettings: async () => ({ status: "opened", destination: "autofill-picker" }),
    }
  }

  /** @throws {never} */
  export function androidTransfer(device: Vault): ElizaPasswordTransferPlugin {
    return {
      exportVault: async () => {
        device.exports += 1
        return { exported: device.records.size }
      },
      importVault: async () => device.importReply as Awaited<ReturnType<ElizaPasswordTransferPlugin["importVault"]>>,
    }
  }
}
import { androidPasswords, androidTransfer, vault } from android

effect function refusal(call: () => Promise<unknown>) {
  const { cause } = try flip(tryPromise(() => call()))
  return cause instanceof PasswordsClientError ? `${cause.code}: ${cause.message}` : cause
}

effect function thrown(program: unknown!Cause.UnknownError) {
  const { cause } = try flip(program)
  return cause instanceof PasswordsClientError ? `${cause.code}: ${cause.message}` : cause
}

it.live("Unlock the vault, list entries as metadata only and act on the revision I selected (spec/os/android/passwords/vault.md, \"The page sees vault entries only as metadata, and only while it is unlocked\"; spec/os/android/passwords/vault.md, \"Outside the vault page, an app learns only whether any password is saved\"; spec/os/android/passwords/vault.md, \"A row action acts on the revision the owner selected\")", () => effect {
  const device = vault()
  const native = androidPasswords(device)
  const passwords = createPasswordsClient(native)
  const facts = { foreground: true, unlocked: true, focused: true, granted: true, featurePresent: true }

  provide machine() {
    const page = try Machine
    const opened = try page.send({ type: "openVault", presence: "PluginRegistered", facts, admitted: true })
    const lockedStatus = try promise(() => passwords.status())
    const lockedList = try refusal(() => passwords.list())
    const lockedAnySaved = try refusal(() => passwords.anySaved())
    device.cancelUnlock = true
    const cancelled = try refusal(() => passwords.unlock())
    device.cancelUnlock = false
    const unlock = try promise(() => passwords.unlock())
    const shown = try page.send({ type: "unlocked", ticket: opened.generation })
    const metadata = try promise(() => passwords.list())
    const anySaved = try promise(() => passwords.anySaved())
    const listed = try page.send({ type: "listed", ticket: shown.generation, reply: listReplyOf(try promise(() => native.list())) })

    device.leaksSecrets = true
    const leaked = try refusal(() => passwords.list())
    const leakedAnySaved = try refusal(() => passwords.anySaved())
    const refusedListing = try page.send({ type: "listed", ticket: shown.generation, reply: listReplyOf(try promise(() => native.list())) })
    device.leaksSecrets = false

    const both = try refusal(() => passwords.save({ label: "Shop", username: "me", websites: [], password: "typed", generate: {} }))
    const shop = try Effect.try(() => normalizeWebsite("shop.example.com/cart?x=1"))
    const generated = try promise(() => passwords.save({ label: "Shop", username: "me", websites: [shop], generate: { length: 23 } }))
    const nameless = try refusal(() => passwords.save({ label: "", username: "me", websites: [] }))
    const badRevision = try refusal(() => passwords.openEditor({ entryId: "e1", expectedRevision: -1 }))
    const edited = try promise(() => passwords.openEditor({ entryId: "e1", expectedRevision: 3 }))
    const staleEdit = try refusal(() => passwords.openEditor({ entryId: "e1", expectedRevision: 3 }))
    const newEntry = try promise(() => passwords.openEditor())
    const staleCopy = try refusal(() => passwords.copy("e1", 3))
    const copied = try promise(() => passwords.copy("e1", 4))
    const revealed = try promise(() => passwords.reveal("e2"))
    const readableReset = try refusal(() => passwords.reset())
    const staleRemove = try refusal(() => passwords.remove("e2", 0))
    try promise(() => passwords.remove("e2", 1))
    const missingRemove = try refusal(() => passwords.remove("e2"))
    const settings = try promise(() => passwords.openAutofillSettings())
    try promise(() => passwords.lock())
    const relocked = try promise(() => passwords.status())
    const afterLock = try refusal(() => passwords.list())
    const left = try page.send({ type: "leaveVault" })

    const absent = createPasswordsClient(passwordsPlugin("HostPasswords"))
    const absentStatus = try refusal(() => absent.status())

    try Effect.try(() => assert.deepStrictEqual(
      {
        lockedStatus, lockedList, lockedAnySaved, anySaved, leakedAnySaved, cancelled, unlock, metadata, listed: listed.listed, leaked, refusedListing: refusedListing.listed, both, generated, nameless,
        badRevision, edited, staleEdit, newEntry, staleCopy, copied, clipboard: device.clipboard, revealed, readableReset, staleRemove, missingRemove,
        remaining: [...device.records.keys()], settings, relocked: relocked.locked, afterLock, left: left.view, absentStatus,
      },
      {
        lockedStatus: { available: true, locked: true, unlockRemainingMs: 0, unlockSeconds: 30, biometric: true, autofill: { supported: true, selected: "this-app" } },
        lockedList: "locked: Unlock saved passwords first.",
        lockedAnySaved: "locked: Unlock saved passwords first.",
        anySaved: true,
        leakedAnySaved: "unavailable: Saved passwords are unavailable.",
        cancelled: "cancelled: Unlock was cancelled.",
        unlock: { unlockRemainingMs: 30_000 },
        metadata: [
          { id: "e1", label: "Mail", username: "owner@example.com", bindings: [{ kind: "web", facet: "https://mail.example.com", display: "mail.example.com" }], updatedAt: 1700, revision: 3 },
          { id: "e2", label: "Bank", username: "owner", bindings: [{ kind: "android", facet: `android://${"a".repeat(64)}@com.example.bank`, display: "Bank" }], updatedAt: 1800, revision: 1 },
        ],
        listed: true,
        leaked: "unavailable: Saved passwords are unavailable.",
        refusedListing: false,
        both: "invalid: Choose a typed or generated password.",
        generated: { id: "e3", generated: true, length: 23 },
        nameless: "invalid: Enter a name.",
        badRevision: "invalid: Choose a saved password.",
        edited: { status: "saved", id: "e1", revision: 4 },
        staleEdit: "conflict: This password changed. Reload it and try again.",
        newEntry: { status: "cancelled" },
        staleCopy: "conflict: This password changed. Reload it and try again.",
        copied: { clearsAfterMs: 45_000 },
        clipboard: "hunter2",
        revealed: { hidesAfterMs: 30_000 },
        readableReset: "invalid: The vault can still be read.",
        staleRemove: "conflict: This password changed. Reload it and try again.",
        missingRemove: "conflict: This password changed. Reload it and try again.",
        remaining: ["e1", "e3"],
        settings: { destination: "autofill-picker" },
        relocked: true,
        afterLock: "locked: Unlock saved passwords first.",
        left: "PageClosed",
        absentStatus: "unavailable: Saved passwords are unavailable.",
      },
    ))
  }
})

it.live("Refuse secret fields, parse native payloads and bind only exact HTTPS origins or apps (spec/os/android/passwords/vault.md, \"The page sees vault entries only as metadata, and only while it is unlocked\"; spec/os/android/passwords/vault.md, \"Device-unlocked custody requires a foreground window and the current owner, even on a device without a screen lock\"; spec/os/android/passwords/autofill.md, \"A form is fillable only for one exact HTTPS origin or one other app\")", () => effect {
  const nested = try thrown(Effect.try(() => assertNoSecretFields({ entries: [{ id: "e1", extra: { OTP_Secret: "123456" } }] })))
  const deep = try thrown(Effect.try(() => assertNoSecretFields(Array.from({ length: 14 }).reduce<unknown>((inner) => [inner], "leaf"))))
  const status = try Effect.try(() => parseStatus({ available: "yes", reason: "elsewhere", locked: "no", unlockRemainingMs: -5, unlockSeconds: 30, biometric: true, autofill: { supported: "maybe", selected: "someone" }, extra: 1 }))
  const deviceWindow = try Effect.try(() => parseStatus({ available: true, custody: "device-unlocked", locked: false,
    unlockRemainingMs: null, autofill: { supported: true, selected: "this-app" } }))
  const timedWindow = try Effect.try(() => parseStatus({ available: true, locked: false,
    unlockRemainingMs: null, autofill: { supported: true, selected: "this-app" } }))
  try Effect.try(() => assert.deepStrictEqual([deviceWindow.available, deviceWindow.locked, deviceWindow.custody, deviceWindow.unlockRemainingMs],
    [true, false, "device-unlocked", null]))
  try Effect.try(() => assert.strictEqual(timedWindow.unlockRemainingMs, 0))
  const entries = try Effect.try(() => parseEntries({ entries: [{ id: "e1", label: "Mail", username: "me", bindings: [], updatedAt: Number.NaN, revision: 2, note: "dropped" }] }))
  const badBinding = try thrown(Effect.try(() => parseEntries({ entries: [{ id: "e1", label: "Mail", username: "me", bindings: [{ kind: "ftp", facet: "x", display: "x" }] }] })))
  const websites = try Effect.try(() => ["Example.COM.", "example.com:8443/login", "https://shop.example.com/cart?x=1", "localhost:3000"].map(normalizeWebsite))
  const refusedWebsites: unknown[] = []
  for (const input of ["http://example.com", "javascript:123", "https://user@example.com", "exa mple.com", "", `${"a".repeat(64)}.com`]) {
    refusedWebsites.push(try thrown(Effect.try(() => normalizeWebsite(input))))
  }
  const kinds = ["https://example.com:8443", `android://${"b".repeat(64)}@com.example.app`, "http://example.com", "android://short@com.example"].map(bindingKind)
  const rows = [
    { id: "2", label: "Mail", username: "z", bindings: [], updatedAt: 0, revision: 0 },
    { id: "1", label: "Bank", username: "a", bindings: [{ kind: "web" as const, facet: "https://bank.example", display: "bank.example" }], updatedAt: 0, revision: 0 },
  ]
  const found = { all: filterEntries(rows, " ").map((row) => row.id), byHost: filterEntries(rows, "BANK.EX").map((row) => row.id), none: filterEntries(rows, "nothing").length }

  const device = vault()
  const transfer = createTransferClient(androidTransfer(device))
  const exported = try promise(() => transfer.exportVault())
  const imported = try promise(() => transfer.importVault())
  device.importReply = { imported: 2, skipped: 1, rows: ["https://example.com"] }
  const extraKey = try refusal(() => transfer.importVault())
  device.importReply = { imported: -1, skipped: 0 }
  const negative = try refusal(() => transfer.importVault())
  const noTransfer = try refusal(() => createTransferClient(passwordTransferPlugin("HostPasswordTransfer")).exportVault())

  try Effect.try(() => assert.deepStrictEqual(
    { nested, deep, status, entries, badBinding, websites, refusedWebsites, kinds, found, exported, imported, extraKey, negative, noTransfer, exports: device.exports },
    {
      nested: "unavailable: Saved passwords are unavailable.",
      deep: "unavailable: Saved passwords are unavailable.",
      status: { available: false, locked: true, unlockRemainingMs: 0, unlockSeconds: 30, biometric: true, autofill: { supported: null, selected: "unknown" } },
      entries: [{ id: "e1", label: "Mail", username: "me", bindings: [], updatedAt: 0, revision: 2 }],
      badBinding: "unavailable: Saved passwords are unavailable.",
      websites: ["https://example.com", "https://example.com:8443", "https://shop.example.com", "https://localhost:3000"],
      refusedWebsites: [
        "invalid: Use an HTTPS website address.",
        "invalid: Use an HTTPS website address.",
        "invalid: Remove the user name from the address.",
        "invalid: Enter a website address.",
        "invalid: Enter a website address.",
        "invalid: Enter a website address.",
      ],
      kinds: ["web", "android", null, null],
      found: { all: ["1", "2"], byHost: ["1"], none: 0 },
      exported: { exported: 2 },
      imported: { imported: 2, skipped: 1 },
      extraKey: "unavailable: Saved passwords are unavailable.",
      negative: "unavailable: Saved passwords are unavailable.",
      noTransfer: "unavailable: Saved passwords are unavailable.",
      exports: 1,
    },
  ))
})
