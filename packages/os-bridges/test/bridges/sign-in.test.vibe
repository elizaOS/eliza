// spec/os/signIn/flow.md, "Story: Sign in with a code, Google or a second factor"; spec/os/signIn/flow.md, "Story: Cancel or resend exactly the request I mean"; spec/os/signIn/flow.md, "Story: Re-authenticate the signed-in account"; spec/os/signIn/readiness.md, "Story: Show only the methods the cloud is ready for"; spec/os/signIn/readiness.md, "Story: Read the service's own terms"
import { assert, it } from "@effect/vitest"
import { MalformedReply } from "../../src/bridges/bridge.vibe"
import { CloudRefused, cloudClient, type CloudPath } from "../../src/bridges/cloud.vibe"
import { SignInRefused, signInClient, signInCode } from "../../src/bridges/sign-in.vibe"
import type { CredentialId, EnvironmentName, SignInAttempt, SignInRequest } from "../../src/bridges/definitions/sign-in.ts"

module android {
  import { CapacitorException } from "@capacitor/core"
  import type { ElizaCloudPlugin } from "../../src/bridges/definitions/cloud.ts"
  import type { ElizaSignInPlugin } from "../../src/bridges/definitions/sign-in.ts"

  export interface Device {
    calls: string[]
    signedIn: boolean
    request: number
    attempt: number
    listeners: Map<string, (event: unknown) => void>
  }

  const LEGAL = { title: "Terms", revision: "1", sections: [{ title: "Use", paragraphs: ["Plain text."] }] }

  /** @throws {never} */
  function rejection(code: string): Error {
    return Object.assign(new CapacitorException(code), { code })
  }

  /** @throws {never} */
  export function androidCloud(phone: Device): ElizaCloudPlugin {
    return {
      request: async ({ target }) => {
        phone.calls.push(target)
        throw rejection(phone.signedIn ? "mail-lease-upgrade-required" : "sign-in-required")
      },
      readGrant: async () => { throw rejection("grant-unknown") },
      cancel: async () => ({ cancelled: false }),
      openExternal: async () => { throw rejection("link-refused") },
    }
  }

  /** @throws {never} */
  export function device(): Device {
    return { calls: [], signedIn: false, request: 0, attempt: 0, listeners: new Map() }
  }

  /** @throws {never} */
  export function announce(phone: Device, eventName: string, event: unknown): void {
    phone.listeners.get(eventName)?.(event)
  }

  /** @throws {never} */
  function settle(phone: Device, verdict: Record<string, unknown>): Record<string, unknown> {
    phone.request += 1
    const receipt = { request: phone.request, attempt: phone.attempt, ...verdict }
    phone.listeners.get("signInSettled")?.(receipt)
    return receipt
  }

  /** @throws {never} */
  export function androidSignIn(phone: Device): ElizaSignInPlugin {
    const readiness = { environment: "production", methodsKnown: true, email: true, sms: false, google: true, googleMode: "browser" }
    const account = () => phone.signedIn
      ? { signedIn: true, userId: "user-1", organizationId: "org-1", credentialId: "key-1", keyExpiresAt: 1900000000000 }
      : { signedIn: false }
    const codeSent = () => ({ verdict: "code-on-its-way", expiresAt: 1800000600000, resendAt: 1800000060000 })
    return {
      startEmail: async (options) => {
        phone.calls.push(`startEmail ${options.email}`)
        phone.attempt += 1
        return settle(phone, codeSent())
      },
      startPhone: async () => { throw rejection("busy") },
      startGoogle: async () => {
        phone.attempt += 1
        return settle(phone, { verdict: "factor-asked", factors: ["totp"], expiresAt: 1800000600000 })
      },
      upgradeMailLease: async () => {
        if (!phone.signedIn) throw rejection("rejected")
        phone.calls.push("upgradeMailLease")
        phone.attempt += 1
        return settle(phone, { verdict: "signed-in-as", credentialId: "key-2", google: "not-requested" })
      },
      cancelMailLeaseUpgrade: async () => ({ cancelled: false }),
      reauthenticate: async (options) => {
        phone.calls.push(`reauthenticate ${options.method}`)
        phone.attempt += 1
        return settle(phone, { verdict: "account-confirmed" })
      },
      resend: async (options) => {
        phone.calls.push(`resend ${options.attempt}`)
        phone.attempt += 1
        return settle(phone, { verdict: "try-again", retry: "too-many-attempts" })
      },
      verify: async (options) => {
        phone.calls.push(`verify ${options.attempt} ${options.code}`)
        if (options.code !== "123456") return settle(phone, { verdict: "try-again", retry: "wrong-code" })
        phone.signedIn = true
        return settle(phone, { verdict: "signed-in-as", credentialId: "key-1", google: "not-requested" })
      },
      sendFactorCode: async (options) => ({ attempt: options.attempt }),
      cancel: async (options) => {
        if (options.attempt !== phone.attempt) return { cancelled: false }
        settle(phone, { verdict: "ended", problem: "cancelled" })
        return { cancelled: true }
      },
      signOut: async () => {
        phone.signedIn = false
        return { account: account() }
      },
      status: async (options) => ({ ...readiness, environment: options.environment, account: account() }),
      serviceInfo: async (options) => options.environment === "production"
        ? { outcome: "service_shown", service: { name: "Example Cloud", terms: LEGAL, privacy: { ...LEGAL, title: "Privacy" } } }
        : options.environment === "broken"
        ? { outcome: "service_shown", service: { name: "Example Cloud", terms: { ...LEGAL, sections: [] }, privacy: LEGAL } }
        : { outcome: "service_unknown_environment" },
      addListener: async (eventName, listener) => {
        phone.listeners.set(eventName, listener)
        return { remove: async () => { phone.listeners.delete(eventName) } }
      },
    }
  }
}
import { androidCloud, androidSignIn, announce, device } from android

const PRODUCTION = "production" as EnvironmentName
const first = { request: 1 as SignInRequest, attempt: 1 as SignInAttempt }

effect function failure(call: () => Promise<unknown>) {
  const { cause } = try flip(tryPromise(() => call()))
  return cause
}

it.live('The native bridges report and start the one-time mail sign-in separately (spec/os/signIn/cloudRequests.md, "A mail or calendar route is sent only with the lease, never with the device key"; spec/os/signIn/credential.md, "A mail lease upgrade can only replace the active key for the same account")', () => effect {
  const phone = device()
  const cloud = cloudClient(androidCloud(phone))
  const path = "/api/v1/eliza/google/calendar/feed" as CloudPath
  const signedOut = try failure(() => cloud.request({ method: "GET", path }))
  phone.signedIn = true
  const upgrade = try failure(() => cloud.request({ method: "GET", path }))
  assert.instanceOf(signedOut, CloudRefused)
  assert.instanceOf(upgrade, CloudRefused)
  assert.deepStrictEqual([(signedOut as CloudRefused).failure, (upgrade as CloudRefused).failure, phone.calls],
    ["sign-in-required", "mail-lease-upgrade-required", [path, path]])
  const signedIn = try promise(() => signInClient(androidSignIn(phone)).upgradeMailLease({ environment: PRODUCTION }))
  assert.deepStrictEqual(signedIn.verdict, { kind: "SignedInAs", credentialId: "key-2" as CredentialId, google: "GoogleNotRequested" })
  assert.deepStrictEqual(phone.calls, [path, path, "upgradeMailLease"])
})

it.live("Sign in with a code, Google or a second factor (spec/os/signIn/flow.md, \"Story: Sign in with a code, Google or a second factor\"; spec/os/signIn/flow.md, \"One renderer request is open at a time, it is open exactly while the slot waits for an answer, and only it is settled\"; spec/os/signIn/flow.md, \"A wrong or unanswered code keeps the step, and a locked or rate-limited one ends the attempt as too many attempts\"; spec/os/signIn/flow.md, \"Story: Cancel or resend exactly the request I mean\")", () => effect {
  const phone = device()
  const client = signInClient(androidSignIn(phone))
  const environment = PRODUCTION
  const settled: unknown[] = []
  try promise(() => client.addListener("signInSettled", (event) => { settled.push(event) }))

  const sent = try promise(() => client.start({ method: "email", email: "owner@example.com", environment }))
  assert.deepStrictEqual(sent, { ...first, verdict: { kind: "CodeOnItsWay", expiresAt: 1800000600000, resendAt: 1800000060000 } })

  assert.isTrue(Option.isNone(signInCode("12345")))
  const wrong = try promise(() => client.verify({ attempt: sent.attempt, code: Option.getOrThrow(signInCode("000 000")) }))
  assert.deepStrictEqual(wrong.verdict, { kind: "TryAgain", retry: "WrongCode" })

  const busy = try failure(() => client.start({ method: "sms", phone: "+15555550100", environment }))
  assert.instanceOf(busy, SignInRefused)
  assert.strictEqual((busy as SignInRefused).code, "Busy")

  const later = try promise(() => client.resend({ attempt: sent.attempt }))
  assert.deepStrictEqual(later, { request: 3 as SignInRequest, attempt: 2 as SignInAttempt, verdict: { kind: "TryAgain", retry: "TooManyAttempts" } })

  const signedIn = try promise(() => client.verify({ attempt: later.attempt, code: Option.getOrThrow(signInCode("123-456")) }))
  assert.deepStrictEqual(signedIn.verdict, { kind: "SignedInAs", credentialId: "key-1" as CredentialId, google: "GoogleNotRequested" })
  assert.deepStrictEqual(phone.calls, ["startEmail owner@example.com", "verify 1 000000", "resend 1", "verify 2 123456"])

  const factor = try promise(() => client.start({ method: "google", environment }))
  assert.deepStrictEqual(factor.verdict, { kind: "FactorAsked", factors: ["totp"], expiresAt: 1800000600000 })
  assert.strictEqual(try promise(() => client.sendFactorCode({ attempt: factor.attempt })), factor.attempt)
  assert.isFalse(try promise(() => client.cancel({ attempt: sent.attempt })))
  assert.isTrue(try promise(() => client.cancel({ attempt: factor.attempt })))
  try sleep("10 millis")
  assert.strictEqual(settled.length, 6)
  assert.deepStrictEqual(settled[5], { request: 6, attempt: 3, verdict: { kind: "Ended", problem: "Cancelled" } })

  announce(phone, "signInSettled", { request: 7, attempt: 3, verdict: "signed-in-as", credentialId: "key-1", google: "held" })
  try sleep("10 millis")
  assert.strictEqual(settled.length, 6)
})

it.live("Re-authenticate the signed-in account (spec/os/signIn/flow.md, \"Story: Re-authenticate the signed-in account\")", () => effect {
  const phone = device()
  const client = signInClient(androidSignIn(phone))
  const confirmed = try promise(() => client.reauthenticate({ method: "google", environment: PRODUCTION }))
  assert.deepStrictEqual(confirmed, { ...first, verdict: { kind: "AccountConfirmed" } })
  assert.deepStrictEqual(phone.calls, ["reauthenticate google"])
  const account = try promise(() => client.signOut({ environment: PRODUCTION }))
  assert.deepStrictEqual(account, { kind: "signedOut" })
})

it.live("Show only the methods the cloud is ready for (spec/os/signIn/readiness.md, \"Story: Show only the methods the cloud is ready for\"; spec/os/signIn/readiness.md, \"Only a changed answer is announced, never the first\"; spec/os/signIn/readiness.md, \"Story: Read the service's own terms\")", () => effect {
  const phone = device()
  const client = signInClient(androidSignIn(phone))
  const environment = PRODUCTION
  const changes: unknown[] = []
  try promise(() => client.addListener("signInReadinessChanged", (event) => { changes.push(event) }))

  const status = try promise(() => client.status({ environment }))
  assert.deepStrictEqual(status, {
    readiness: { environment: PRODUCTION, methodsKnown: true, email: true, sms: false, google: true, googleMode: "Browser" },
    account: { kind: "signedOut" },
  })
  const readiness = try promise(() => client.readiness({ environment, retry: true }))
  assert.strictEqual(readiness.googleMode, "Browser")

  announce(phone, "signInReadinessChanged", { environment: "production", methodsKnown: true, email: true, sms: true, google: true, googleMode: "picker" })
  announce(phone, "signInReadinessChanged", { environment: "production", methodsKnown: "yes" })
  try sleep("10 millis")
  assert.deepStrictEqual(changes, [{ environment: "production", methodsKnown: true, email: true, sms: true, google: true, googleMode: "Picker" }])

  const shown = try promise(() => client.serviceDocument({ environment }))
  assert.strictEqual(shown.kind, "ServiceShown")
  assert.deepStrictEqual(shown.kind === "ServiceShown" ? shown.service.privacy.title : "", "Privacy")
  const unknown = try promise(() => client.serviceDocument({ environment: "staging" as EnvironmentName }))
  assert.deepStrictEqual(unknown, { kind: "ServiceUnknownEnvironment", environment: "staging" as EnvironmentName })
  const broken = try failure(() => client.serviceDocument({ environment: "broken" as EnvironmentName }))
  assert.instanceOf(broken, MalformedReply)
})
