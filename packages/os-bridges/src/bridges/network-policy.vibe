// spec/os/android/networkPolicy.md, "A metered hint is Android's own flag for the active network, and anything Android did not answer is unknown"
import type { HostFacts, PluginPresence } from "../../gen/os__android__bridge.ts"
import { meteredHint, type CostRead } from "../../gen/os__android__networkPolicy.effect.vibe"
import { nativeReply } from "./bridge.vibe"
import type { MeteredHint, NetworkPolicyPlugin, PathHints } from "./definitions/network-policy.ts"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { NetworkPolicyPlugin } from "./definitions/network-policy.ts"

  /** @throws {never} */
  export function networkPolicyPlugin(name = "ElizaNetworkPolicy"): NetworkPolicyPlugin {
    return registerPlugin<NetworkPolicyPlugin>(name)
  }

  /** @throws {never} */
  export function readNavigatorSaveData(): boolean | null {
    try {
      const nav = (globalThis as { readonly navigator?: { readonly connection?: { readonly saveData?: unknown } } }).navigator
      const saveData = nav?.connection?.saveData
      return typeof saveData === "boolean" ? saveData : null
    } catch {
      return null
    }
  }

  /** @throws {never} */
  export function assignNetworkPolicyGlobal(plugin: NetworkPolicyPlugin): void {
    (globalThis as { ElizaNetworkPolicy?: NetworkPolicyPlugin }).ElizaNetworkPolicy = plugin
  }
}
import { assignNetworkPolicyGlobal, networkPolicyPlugin, readNavigatorSaveData } from capacitor
export { networkPolicyPlugin }

const ANSWERED: HostFacts = { foreground: true, unlocked: true, focused: true, granted: true, featurePresent: true }
const NOT_REGISTERED = new Set(["UNIMPLEMENTED", "DISABLED"])

schema Metered { metered: boolean | null; source: "android-os" }
schema PathHint { isExpensive: boolean | null; isConstrained: boolean | null; source: "nw-path-monitor" }

effect function hint(name: string, plugin: NetworkPolicyPlugin) {
  const read = try result(nativeReply(name, "getMeteredHint", Metered, () => plugin.getMeteredHint()))
  const code = Result.isSuccess(read) ? undefined : match (read.failure) {
    when { _tag: "BridgeUnavailable" }: "UNIMPLEMENTED";
    when { _tag: "NativeRejection", let code }: code;
    default: undefined;
  }
  const presence: PluginPresence = code !== undefined && NOT_REGISTERED.has(code) ? "PluginNotRegistered" : "PluginRegistered"
  const metered = Result.isSuccess(read) ? read.success.metered : null
  const androidCost: CostRead = { answered: Result.isSuccess(read), activeNetwork: metered !== null, capabilitiesRead: metered !== null, notMetered: metered === false }
  const cost = meteredHint(presence, ANSWERED, androidCost)
  const answer: MeteredHint = { metered: cost === "LinkMetered" ? true : cost === "LinkUnmetered" ? false : null, source: "android-os" }
  return answer
}

effect function pathHints(name: string, plugin: NetworkPolicyPlugin): PathHints!! {
  if (plugin.getPathHints === undefined) {
    return { isExpensive: null, isConstrained: null, source: "nw-path-monitor" }
  }
  const read = try result(nativeReply(name, "getPathHints", PathHint, () => plugin.getPathHints!()))
  if (Result.isSuccess(read)) return read.success
  return { isExpensive: null, isConstrained: null, source: "nw-path-monitor" }
}

export class NetworkPolicyWeb implements NetworkPolicyPlugin {
  async getMeteredHint(): Promise<MeteredHint> {
    const saveData = readNavigatorSaveData()
    return { metered: saveData === true ? true : null, source: "android-os" }
  }

  async getPathHints(): Promise<PathHints> {
    const saveData = readNavigatorSaveData()
    return {
      isExpensive: saveData === true ? true : null,
      isConstrained: saveData === true ? true : null,
      source: "nw-path-monitor",
    }
  }
}

export function networkPolicyClient(plugin: NetworkPolicyPlugin = networkPolicyPlugin(), name = "ElizaNetworkPolicy"): Required<NetworkPolicyPlugin> {
  return {
    getMeteredHint: () => runPromise(hint(name, plugin)),
    getPathHints: () => runPromise(pathHints(name, plugin)),
  }
}

export function installNetworkPolicyGlobal(plugin: NetworkPolicyPlugin = networkPolicyClient()): void {
  assignNetworkPolicyGlobal(plugin)
}
