// spec/os/android/wifi.md, "A scan offers one row per disclosed network name, the strongest usable one"; spec/os/android/wifi.md, "Only a report of the requested network itself confirms the join or a sign-in portal"; spec/os/android/wifi.md, "Disconnect and the Internet panel report only that Android took the request"; spec/os/android/wifi.md, "A connectivity read reports Android's own flags for the active network, and an unanswered read is unknown"
import type { HandoffOutcome, HostFacts, PluginPresence } from "../../gen/os__android__bridge.ts"
import { connectivityReport, disconnectReply, internetPanel, offeredRows, type ScanRow, type WifiSecurity } from "../../gen/os__android__wifi.effect.vibe"
import { nativeCall, nativeReply, rejectionCode, settled, type BridgeFailure } from "./bridge.vibe"
import type { ConnectResult, ConnectivityResult, ListNetworksOptions, ListNetworksResult, WiFiNetwork, WiFiPlugin, WiFiSecurity } from "./definitions/wifi.ts"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { WiFiPlugin } from "./definitions/wifi.ts"

  /** @throws {never} */
  export function wifiPlugin(name = "ElizaWiFi"): WiFiPlugin {
    return registerPlugin<WiFiPlugin>(name)
  }
}
import { wifiPlugin } from capacitor
export { wifiPlugin }

export type WiFiMethod = keyof WiFiPlugin

export interface WiFiClient extends Omit<WiFiPlugin, "openInternetPanel"> {
  openInternetPanel(): Promise<HandoffOutcome>
}

const SECURITY: Readonly<Record<WiFiSecurity, WifiSecurity>> = { open: "WifiOpen", owe: "WifiOwe", wpa2: "WifiWpa2", wpa3: "WifiWpa3", eap: "WifiEap", wep: "WifiWep" }

const ANSWERED: HostFacts = { foreground: true, unlocked: true, focused: true, granted: true, featurePresent: true }

const NOT_REGISTERED = new Set(["UNIMPLEMENTED", "DISABLED"])

schema Network {
  ssid: string
  bssid: string
  rssi: number
  frequency: number
  capabilities: string
  secured: boolean
  security?: "open" | "owe" | "wpa2" | "wpa3" | "eap" | "wep"
}
schema Offer {
  ssid: string
  bssid: string
  rssi: number
  frequency: number
  capabilities: string
  secured: boolean
  security: "open" | "owe" | "wpa2" | "wpa3" | "eap" | "wep"
}
schema Permission { location: "granted" | "denied" | "prompt" | "prompt-with-rationale" }
schema Capabilities { sdk: number; approvedJoin: boolean; internetPanel: boolean }
schema Radio { enabled: boolean; connected: boolean; rssi: number | null }
schema Connected { network: Network | null }
schema Scan { networks: Offer[] }
schema Change { success: boolean; message?: string }
schema Connectivity { online: boolean; validated: boolean; captivePortal: boolean; ssid: string | null }
schema Join { status: "connected" | "captivePortal" | "declined" | "unverified" | "notConnected" | "wrongPassword" | "savedNetwork" }

function offers(found: readonly (WiFiNetwork & { security: WiFiSecurity })[], options: ListNetworksOptions | undefined): ListNetworksResult {
  const byRow = new Map(found.map((network): [ScanRow, WiFiNetwork] => [{ network: network.ssid, strength: network.rssi, security: SECURITY[network.security] }, network]))
  const strongest = offeredRows([...byRow.keys()], options?.joinable === true).flatMap((row) => byRow.get(row) ?? []).sort((a, b) => b.rssi - a.rssi)
  const limit = options?.limit
  return { networks: limit !== undefined && limit > 0 ? strongest.slice(0, limit) : strongest }
}

function reported(read: ConnectivityResult): ConnectivityResult {
  const report = connectivityReport({ answered: true, offersInternet: read.online, androidValidated: read.validated, androidCaptive: read.captivePortal, onWifi: read.ssid !== null, nameDisclosed: read.ssid !== null, activeName: read.ssid ?? "" })
  return report.tag === "ConnectivityKnown" ? { online: report.online, validated: report.validated, captivePortal: report.captivePortal, ssid: report.wifiName === "" ? null : report.wifiName } : read
}

function disconnected(change: ConnectResult): ConnectResult {
  return disconnectReply("PluginRegistered", ANSWERED, change.success) === "DisconnectAccepted" ? { success: true } : change
}

function refusalCode(failure: BridgeFailure): string | undefined {
  return failure._tag === "BridgeUnavailable" ? "UNIMPLEMENTED" : rejectionCode(failure.cause)
}

effect function panelHandoff(plugin: string, open: () => Promise<void>) {
  const opened = try result(nativeCall(plugin, "openInternetPanel", () => open()))
  const code = Result.isFailure(opened) ? refusalCode(opened.failure) : undefined
  const presence: PluginPresence = code !== undefined && NOT_REGISTERED.has(code) ? "PluginNotRegistered" : "PluginRegistered"
  return internetPanel(presence, { ...ANSWERED, featurePresent: code !== "UNSUPPORTED" }, Result.isSuccess(opened))
}

export function wifiClient(plugin: WiFiPlugin = wifiPlugin(), name = "ElizaWiFi"): WiFiClient {
  return {
    checkPermissions: () => settled(nativeReply(name, "checkPermissions", Permission, () => plugin.checkPermissions())),
    requestPermissions: (options) => settled(nativeReply(name, "requestPermissions", Permission, () => plugin.requestPermissions(options))),
    getCapabilities: () => settled(nativeReply(name, "getCapabilities", Capabilities, () => plugin.getCapabilities())),
    openInternetPanel: () => settled(panelHandoff(name, () => plugin.openInternetPanel())),
    getWifiState: () => settled(nativeReply(name, "getWifiState", Radio, () => plugin.getWifiState())),
    getConnectedNetwork: () => settled(nativeReply(name, "getConnectedNetwork", Connected, () => plugin.getConnectedNetwork())),
    listAvailableNetworks: async (options) => offers((await settled(nativeReply(name, "listAvailableNetworks", Scan, () => plugin.listAvailableNetworks(options)))).networks, options),
    connectToNetwork: (options) => settled(nativeReply(name, "connectToNetwork", Change, () => plugin.connectToNetwork(options))),
    disconnectFromNetwork: async () => disconnected(await settled(nativeReply(name, "disconnectFromNetwork", Change, () => plugin.disconnectFromNetwork()))),
    getConnectivity: async () => reported(await settled(nativeReply(name, "getConnectivity", Connectivity, () => plugin.getConnectivity()))),
    addNetworkWithApproval: (options) => settled(nativeReply(name, "addNetworkWithApproval", Join, () => plugin.addNetworkWithApproval(options))),
  }
}
