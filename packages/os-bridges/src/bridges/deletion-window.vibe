// spec/os/android/deletionWindow.md, "Story: Undo a reviewed deletion before it is sent"; spec/os/android/deletionWindow.md, "A record waiting in its window is hidden from its list until Undo or the provider settles it"; spec/os/android/deferredDeletion.md, "Story: Keep one winner between Undo and the provider"; spec/os/android/deferredDeletion.md, "Story: Undo a deleted message, conversation, voicemail or contact"
import type { DeletionHold, DeletionKind } from "../../gen/os__android__deferredDeletion.ts"
import { clockUsable, deletionDeadline, deletionNotice, hiddenFromList, offersUndo } from "../../gen/os__android__deletionWindow.effect.vibe"
import type { DeletionClock, DeletionDeadline, DeletionNotice, DeletionPhase, WindowState } from "../../gen/os__android__deletionWindow.ts"
import { MalformedReply, decoded } from "./bridge.vibe"
import type {
  DeferredDeletionEntry,
  DeferredDeletionsPending,
  DeletionNoticeView,
  DeletionRecordKind,
  StagedDeletion,
  StagedRecordKind,
} from "./definitions/action-journal.ts"

export type {
  DeletionClaim,
  DeletionClaimAction,
  DeletionClock,
  DeletionDeadline,
  DeletionNotice,
  DeletionPhase,
  PendingDeletion,
  WindowState,
} from "../../gen/os__android__deletionWindow.ts"
export type {
  DeferredDeletionEntry,
  DeferredDeletionKey,
  DeferredDeletionsClient,
  DeferredDeletionsPending,
  DeletedRecordOrigin,
  DeletionNoticeView,
  DeletionRecordKind,
  DismissOutcome,
  StagedDeletion,
  StagedRecordKind,
  UndoOutcome,
} from "./definitions/action-journal.ts"
export { claimDeletion, clockUsable, deleteUndoMs, deletionDeadline, deletionWindow, hiddenFromList, offersUndo, undoConfirmed } from "../../gen/os__android__deletionWindow.effect.vibe"

module renderer {
  import type { DeletionClock } from "../../gen/os__android__deletionWindow.ts"

  let continuity: string | undefined

  /** @throws {never} */
  export function rendererDeletionClock(): DeletionClock {
    continuity ??= globalThis.crypto.randomUUID()
    return { continuity, elapsed: Math.floor(globalThis.performance.now()), wall: Date.now() }
  }
}
import { rendererDeletionClock } from renderer
export { rendererDeletionClock }

export const UNDO_TOO_LATE = "Undo was too late. The deletion already went ahead; check the item before relying on it."

export const DELETION_NOTICE_TEXT = {
  paused: "Deletion paused. Undo to keep it, then review again if you still want to delete.",
  queued: "Deletion queued for 10 seconds.",
  uncertain: "Deletion outcome needs review. It will not be repeated.",
  verifying: "Deletion is being verified.",
  statusUnavailable: "Pending deletion status is unavailable. Refresh before making another change.",
  undoUnconfirmed: "Undo could not be confirmed. The deletion may already have gone ahead; refresh and inspect the saved item.",
  refreshing: "Refreshing the saved receipt. This does not repeat the deletion or prove the item was restored.",
  dismissed: "Outcome dismissed. The receipt is retained; nothing was restored or repeated.",
  dismissFailed: "The outcome could not be dismissed. Refresh the receipt and try again.",
} as const

export error DeletionClockUnavailable { clock: DeletionClock }

export effect function reviewDeadline(clock: DeletionClock): DeletionDeadline!DeletionClockUnavailable {
  if (!Number.isSafeInteger(clock.elapsed) || !Number.isSafeInteger(clock.wall) || !clockUsable(clock)) {
    throw new DeletionClockUnavailable({ clock })
  }
  return deletionDeadline(clock)
}

const WIRE_PHASES = ["queued", "paused", "dispatching", "undone", "deleted", "conflict", "unknown"] as const
type WirePhase = (typeof WIRE_PHASES)[number]
type WireWindow = "open" | "expired" | "clock-changed"

const PHASES: Readonly<Record<WirePhase, DeletionPhase>> = {
  queued: "Queued",
  paused: "Paused",
  dispatching: "Dispatching",
  undone: "Undone",
  deleted: "Deleted",
  conflict: "DeletionConflict",
  unknown: "UnknownOutcome",
}

const WINDOWS: Readonly<Record<WireWindow, WindowState>> = { open: "WindowOpen", expired: "WindowExpired", "clock-changed": "ClockChanged" }

const WIRE_KINDS = ["calendar", "reminder", "message", "thread", "voicemail", "contact"] as const satisfies readonly DeletionRecordKind[]

const KINDS: Readonly<Record<DeletionRecordKind, DeletionKind>> = {
  calendar: "CalendarEvent",
  reminder: "ReminderOccurrence",
  message: "MessageRecord",
  thread: "ThreadRecord",
  voicemail: "VoicemailRecord",
  contact: "ContactRecord",
}

const NOUNS: Readonly<Record<DeletionRecordKind, string>> = {
  calendar: "calendar",
  reminder: "reminder",
  message: "message",
  thread: "conversation",
  voicemail: "voicemail",
  contact: "contact",
}

export function recordKindOf(kind: DeletionKind): DeletionRecordKind {
  return match (kind) {
    when "CalendarEvent": "calendar";
    when "ReminderOccurrence": "reminder";
    when "MessageRecord": "message";
    when "ThreadRecord": "thread";
    when "VoicemailRecord": "voicemail";
    when "ContactRecord": "contact";
  }
}

function isStagedRecordKind(kind: DeletionRecordKind): kind is StagedRecordKind {
  return kind === "message" || kind === "thread" || kind === "voicemail" || kind === "contact"
}

function holdOf(blocked: string | undefined): DeletionHold {
  return match (blocked) {
    when undefined: "NotHeld";
    when "owner-changed": "HeldOwnerChanged";
    when "owner-unavailable": "HeldOwnerUnavailable";
    when "permission-required": "HeldPermissionRefused";
    default: "HeldProviderDeclined";
  }
}

const OPERATION_ID = /^[A-Za-z0-9_-]{1,128}$/
const Titled = Schema.Struct({ title: Schema.optionalKey(Schema.String) })
const WireEntry = Schema.Struct({
  id: Schema.String.check(Schema.isPattern(OPERATION_ID)),
  kind: Schema.Literals(WIRE_KINDS),
  phase: Schema.Literals(WIRE_PHASES),
  window: Schema.optionalKey(Schema.Literals(["open", "expired", "clock-changed"])),
  blocked: Schema.optionalKey(Schema.String),
  expiresAt: Schema.optionalKey(Schema.Number),
  deadline: Schema.optionalKey(Schema.Struct({ expiresAt: Schema.Number })),
  target: Schema.optionalKey(Schema.Struct({
    row: Schema.optionalKey(Titled),
    fields: Schema.optionalKey(Titled),
    id: Schema.optionalKey(Schema.Unknown),
    threadId: Schema.optionalKey(Schema.Unknown),
  })),
  original: Schema.optionalKey(Titled),
})
schema WireOrigin { kind: "event" | "reminder"; id: string }
const WirePending = Schema.Struct({ pending: Schema.Array(WireEntry), deletedNoteOrigins: Schema.optionalKey(Schema.Array(WireOrigin)) })
const WireReceipt = Schema.Struct({ phase: Schema.Literals(WIRE_PHASES) })
const WireStaged = Schema.Struct({
  id: Schema.String.check(Schema.isPattern(OPERATION_ID)),
  kind: Schema.Literals(WIRE_KINDS),
  deadline: Schema.Struct({ expiresAt: Schema.Int }),
})

function recordOf(row: typeof WireEntry.Type): string | null {
  if (!isStagedRecordKind(row.kind)) return null
  const key = row.kind === "thread" ? row.target?.threadId : row.target?.id
  return typeof key === "string" && key.length <= 64 ? key : null
}

function entryOf(row: typeof WireEntry.Type): DeferredDeletionEntry {
  const phase = PHASES[row.phase]
  return {
    id: row.id,
    kind: KINDS[row.kind],
    phase,
    window: row.window === undefined ? "WindowExpired" : WINDOWS[row.window],
    hold: phase === "Paused" ? holdOf(row.blocked) : "NotHeld",
    expiresAt: row.expiresAt ?? row.deadline?.expiresAt ?? null,
    title: row.target?.row?.title || row.target?.fields?.title || row.original?.title || null,
    record: recordOf(row),
  }
}

export effect function parseDeletionsPending(raw: unknown): DeferredDeletionsPending!MalformedReply {
  const read = try decoded("ElizaActionJournal", "pending", WirePending, raw)
  return { deletions: read.pending.map(entryOf), deletedOrigins: read.deletedNoteOrigins ?? [] }
}

export effect function receiptPhase(method: "undo" | "dismiss", raw: unknown): DeletionPhase!MalformedReply {
  return PHASES[(try decoded("ElizaActionJournal", method, WireReceipt, raw)).phase]
}

export effect function parseStagedDeletion(plugin: string, method: string, kind: StagedRecordKind, raw: unknown): StagedDeletion!MalformedReply {
  const row = try decoded(plugin, method, WireStaged, raw)
  if (row.kind !== kind) throw new MalformedReply({ plugin, method, issue: "The staged deletion belongs to another kind of record" })
  return { kind: KINDS[row.kind], id: row.id, expiresAt: row.deadline.expiresAt }
}

export function hiddenRecords(entries: readonly DeferredDeletionEntry[], kind: StagedRecordKind): ReadonlySet<string> {
  const wanted = KINDS[kind]
  return new Set(entries.flatMap((entry) => (entry.kind === wanted && entry.record !== null && hiddenFromList(entry.phase, entry.window) ? [entry.record] : [])))
}

export function noticeOf(entry: DeferredDeletionEntry): DeletionNotice {
  return deletionNotice(entry.phase, entry.window)
}

function messageOf(notice: Exclude<DeletionNotice, "NoticeHidden">): string {
  return match (notice) {
    when "NoticePaused": DELETION_NOTICE_TEXT.paused;
    when "NoticeQueued": DELETION_NOTICE_TEXT.queued;
    when "NoticeVerifying": DELETION_NOTICE_TEXT.verifying;
    when "NoticeUncertain": DELETION_NOTICE_TEXT.uncertain;
  }
}

export function deletionNoticeOf(entry: DeferredDeletionEntry): DeletionNoticeView | null {
  const notice = noticeOf(entry)
  if (notice === "NoticeHidden") return null
  const kind = recordKindOf(entry.kind)
  return {
    key: `${kind}:${entry.id}`,
    title: entry.title ?? `Selected ${NOUNS[kind]}`,
    notice,
    message: messageOf(notice),
    canUndo: offersUndo(notice),
    uncertain: notice === "NoticeUncertain",
  }
}

export function pendingDeletionNotices(entries: readonly DeferredDeletionEntry[]): DeferredDeletionEntry[] {
  return entries.filter((entry) => noticeOf(entry) !== "NoticeHidden")
}

export function deletionNoticeSignature(entries: readonly DeferredDeletionEntry[]): string {
  return entries.map((entry) => [recordKindOf(entry.kind), entry.id, entry.phase].join(",")).join("|")
}

export function deletionReviewRefusal(status: string): string | undefined {
  return match (status) {
    when "stale": "This item changed. Review it again before deleting.";
    when "unavailable": "Deletion review is unavailable. Open the item and try again; nothing changed.";
    when "not-staged": "Deletion was not queued. Nothing changed; review it again if you still want to delete it.";
    default: undefined;
  }
}

export function reminderDeletionRefusal(status: string): string | undefined {
  return match (status) {
    when "stale": "This reminder changed. Review it again before deleting.";
    when "unavailable": "Deletion review is unavailable. Open the reminder and try again; nothing changed.";
    default: deletionReviewRefusal(status);
  }
}
