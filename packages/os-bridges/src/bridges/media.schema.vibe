// spec/os/android/media/rows.md, "A row is applied only after one counted write and a confirmed readback"; spec/os/android/media/catalog.md, "A next cursor is issued only for a full page with a lookahead row and reaches the caller only with the published page"; spec/os/android/media/trash.md, "A confirmation works once, for at most two minutes, and at most four wait at once"; spec/os/android/media/albums.md, "There are at most 24 albums of at most 200 members, each key once"; spec/os/android/media/editCopy.md, "Recovery observes the unique owned row before it settles anything"; spec/os/android/files/documentGrants.md, "Story: Keep only the documents I selected"; spec/os/android/files/documentGrants.md, "A selection reports its size and time only as the provider answered each"
import { albumCapacity, memberCapacity } from "../../gen/os__android__media__albums.effect.vibe"
import { maxCatalogPage } from "../../gen/os__android__media__catalog.effect.vibe"
import { trashLimit } from "../../gen/os__android__media__trash.effect.vibe"
import type {
  AlbumList as AlbumListType,
  AlbumWritten as AlbumWrittenType,
  BatchReport as BatchReportType,
  ChangedItem as ChangedItemType,
  DocumentHandoff as DocumentHandoffType,
  DocumentText as DocumentTextType,
  EditPreview as EditPreviewType,
  EditReceipt as EditReceiptType,
  KeepOutcome as KeepOutcomeType,
  LibraryAccess as LibraryAccessType,
  LibraryPage as LibraryPageType,
  LibraryScope as LibraryScopeType,
  LibrarySummary as LibrarySummaryType,
  MediaId as MediaIdType,
  MediaItem as MediaItemType,
  MediaPage as MediaPageType,
  MediaRevision as MediaRevisionType,
  PdfPage as PdfPageType,
  PreparedTrash as PreparedTrashType,
  SelectedDocument as SelectedDocumentType,
  ShareOpened as ShareOpenedType,
  SharedMany as SharedManyType,
  TrashReceipt as TrashReceiptType,
  Validated as ValidatedType,
  VideoEditSession as VideoEditSessionType,
} from "./definitions/media.ts"

const Text = Schema.String.check(Schema.isMinLength(1))
const Count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const Size = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0))

export const MediaId = Text.pipe(Schema.brand("MediaId"))
export const MediaRevision = Text.pipe(Schema.brand("MediaRevision"))
const AlbumId = Text.pipe(Schema.brand("AlbumId"))
const AlbumRevision = Text.pipe(Schema.brand("AlbumRevision"))
const TrashConfirmation = Text.pipe(Schema.brand("TrashConfirmation"))
const EditSessionId = Text.pipe(Schema.brand("EditSessionId"))
const EditOperationId = Text.pipe(Schema.brand("EditOperationId"))
const SelectionId = Text.pipe(Schema.brand("SelectionId"))

const KindAccess = Schema.Literals(["full", "selected", "owned", "denied"])
const ScopeKind = Schema.Literals(["full", "partial", "selected", "owned", "denied"])
const RowStatus = Schema.Literals(["favorited", "unfavorited", "trashed", "restored", "deleted", "unchanged", "stale", "unverified", "unsupported"])
const Handoff = Schema.Literals(["opened", "unavailable", "failed"])

export const LibraryAccess = Schema.Struct({ scope: ScopeKind, images: KindAccess, videos: KindAccess })

const scopeFields = {
  scope: ScopeKind,
  imageAccess: KindAccess,
  videoAccess: KindAccess,
  images: Schema.Boolean,
  videos: Schema.Boolean,
  canSelectMore: Schema.Boolean,
  canEditOthers: Schema.Boolean,
  locked: Schema.Boolean,
  version: Schema.String,
}
export const LibraryScope = Schema.Struct(scopeFields)

const itemFields = {
  id: MediaId,
  kind: Schema.Literals(["image", "video"]),
  width: Count,
  height: Count,
  date: Size,
  size: Size,
  revision: MediaRevision,
  duration: Schema.optionalKey(Size),
  name: Schema.optionalKey(Schema.String),
  mutationRevision: Schema.optionalKey(MediaRevision),
  contentRevision: Schema.optionalKey(Schema.String),
  identity: Schema.optionalKey(Schema.String),
  favorite: Schema.optionalKey(Schema.Boolean),
  owned: Schema.optionalKey(Schema.Boolean),
  trashed: Schema.optionalKey(Schema.Boolean),
  expiresAt: Schema.optionalKey(Size),
  image: Schema.optionalKey(Schema.String),
  path: Schema.optionalKey(Schema.String),
  takenAt: Schema.optionalKey(Size),
  dateTaken: Schema.optionalKey(Size),
  bucket: Schema.optionalKey(Schema.String),
  folder: Schema.optionalKey(Schema.String),
  taken: Schema.optionalKey(Size),
}
export const MediaItem = Schema.Struct(itemFields)
export const ChangedItem = Schema.Struct({ ...itemFields, status: RowStatus })

const PageItems = Schema.Array(MediaItem).check(Schema.isMaxLength(maxCatalogPage))
const Next = Schema.Union([Schema.Literal(""), Text.pipe(Schema.brand("MediaCursor"))])
export const MediaPage = Schema.Struct({ items: PageItems, next: Next, access: Schema.optionalKey(LibraryAccess) })
export const LibraryPage = Schema.Struct({ ...scopeFields, items: PageItems, next: Next })

export const Validated = Schema.Struct({
  items: Schema.Array(Schema.Union([
    Schema.Struct({ id: MediaId, status: Schema.Literal("current") }),
    Schema.Struct({ id: MediaId, status: Schema.Literal("changed"), item: MediaItem }),
    Schema.Struct({ id: MediaId, status: Schema.Literal("missing") }),
  ])),
})

const DeletedRow = Schema.Struct({ id: MediaId, status: Schema.Literal("deleted") })
export const BatchReport = Schema.Struct({
  status: Schema.Literals(["complete", "partial"]),
  outcomes: Schema.Array(Schema.Struct({ id: MediaId, status: RowStatus, item: Schema.optionalKey(Schema.Union([MediaItem, DeletedRow])) })),
})

export const ShareOpened = Schema.Struct({ status: Handoff, message: Schema.optionalKey(Schema.String) })
export const SharedMany = Schema.Struct({ status: Schema.Literal("opened"), count: Count.check(Schema.isGreaterThan(0)) })
export const KeepOutcome = Schema.Struct({ status: Schema.Literals(["saved", "failed"]), id: Schema.optionalKey(MediaId), message: Schema.optionalKey(Schema.String) })
export const Thumbnails = Schema.Struct({ items: Schema.Array(Schema.Struct({ id: MediaId, image: Schema.String })).check(Schema.isMaxLength(maxCatalogPage)) })
export const Watching = Schema.Struct({ active: Schema.Boolean })
export const Reset = Schema.Struct({ reset: Schema.Literal(true) })

export const LibrarySummary = Schema.Struct({
  favorites: Count,
  videos: Count,
  camera: Schema.optionalKey(Count),
  screenshots: Schema.optionalKey(Count),
  trash: Count,
  canFavorite: Schema.Boolean,
})

export const PreparedTrash = Schema.Struct({ confirmation: TrashConfirmation, count: Count.check(Schema.isLessThanOrEqualTo(trashLimit)) })
const Ids = Schema.Array(MediaId).check(Schema.isMaxLength(trashLimit))
export const TrashReceipt = Schema.Struct({ status: Schema.Literals(["deleted", "partial"]), deletedIds: Ids, skippedIds: Ids, failedIds: Ids })

const OwnedAlbum = Schema.Struct({
  id: AlbumId,
  name: Schema.String,
  revision: AlbumRevision,
  count: Count.check(Schema.isLessThanOrEqualTo(memberCapacity)),
  memberIds: Schema.Array(MediaId).check(Schema.isMaxLength(memberCapacity)),
})
export const AlbumList = Schema.Struct({ items: Schema.Array(OwnedAlbum).check(Schema.isMaxLength(albumCapacity)) })
export const AlbumWritten = Schema.Struct({ status: Schema.Literals(["saved", "deleted"]), id: AlbumId, revision: AlbumRevision })

export const EditPreview = Schema.Struct({
  sessionId: EditSessionId,
  operationId: EditOperationId,
  image: Schema.String,
  width: Count,
  height: Count,
  reduced: Schema.Boolean,
  maxEdge: Count,
  filter: Schema.String,
  canReplace: Schema.optionalKey(Schema.Boolean),
})
export const EditReceipt = Schema.Struct({
  status: Schema.Literals(["saved", "failed", "not-started", "incomplete", "stale", "unchanged", "unknown"]),
  operationId: EditOperationId,
  id: Schema.optionalKey(MediaId),
  replaced: Schema.optionalKey(Schema.Boolean),
  revision: Schema.optionalKey(MediaRevision),
  message: Schema.optionalKey(Schema.String),
})
export const VideoEditSession = Schema.Struct({ sessionId: EditSessionId, operationId: EditOperationId, duration: Size, width: Count, height: Count })

export const SelectedDocument = Schema.Struct({
  status: Schema.Literals(["selected", "renamed-reselect", "unavailable", "unsupported", "failed"]),
  action: Schema.optionalKey(Schema.Literal("files")),
  message: Schema.optionalKey(Schema.String),
  selectionId: Schema.optionalKey(SelectionId),
  uri: Schema.optionalKey(Schema.String),
  name: Schema.optionalKey(Schema.String),
  mimeType: Schema.optionalKey(Schema.NullOr(Schema.String)),
  canRename: Schema.optionalKey(Schema.Boolean),
  size: Schema.optionalKey(Count),
  modified: Schema.optionalKey(Count.check(Schema.isGreaterThan(0))),
})
export const PdfPage = Schema.Struct({
  status: Schema.Literals(["rendered", "unavailable", "unsupported", "failed"]),
  message: Schema.String,
  page: Schema.optionalKey(Count),
  pageCount: Schema.optionalKey(Count),
  imageUri: Schema.optionalKey(Schema.String),
})
export const DocumentText = Schema.Struct({
  status: Schema.Literals(["read", "unavailable", "unsupported", "too-large", "failed"]),
  message: Schema.String,
  text: Schema.optionalKey(Schema.String),
  mimeType: Schema.optionalKey(Schema.NullOr(Schema.String)),
  bytes: Schema.optionalKey(Count),
})
export const DocumentHandoff = Schema.Struct({ status: Handoff, message: Schema.String })

export type MediaId = MediaIdType
export type MediaRevision = MediaRevisionType
export type LibraryAccess = LibraryAccessType
export type LibraryScope = LibraryScopeType
export type MediaItem = MediaItemType
export type ChangedItem = ChangedItemType
export type MediaPage = MediaPageType
export type LibraryPage = LibraryPageType
export type Validated = ValidatedType
export type BatchReport = BatchReportType
export type ShareOpened = ShareOpenedType
export type SharedMany = SharedManyType
export type KeepOutcome = KeepOutcomeType
export type LibrarySummary = LibrarySummaryType
export type PreparedTrash = PreparedTrashType
export type TrashReceipt = TrashReceiptType
export type AlbumList = AlbumListType
export type AlbumWritten = AlbumWrittenType
export type EditPreview = EditPreviewType
export type EditReceipt = EditReceiptType
export type VideoEditSession = VideoEditSessionType
export type SelectedDocument = SelectedDocumentType
export type PdfPage = PdfPageType
export type DocumentText = DocumentTextType
export type DocumentHandoff = DocumentHandoffType
