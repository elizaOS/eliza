// spec/os/android/contacts.md, "Story: Read my contacts only while I am looking at them"; spec/os/android/deletionWindow.md, "A queued deletion on its review clock hides the record from its list"; spec/os/android/contacts.md, "Story: Change only the contact I reviewed"; spec/os/android/contacts.md, "A contact write runs only on a writing install that can advertise contacts.write.v1, in front with focus"; spec/os/android/contacts.md, "A removal the owner confirmed waits in the deletion window, and only its expiry runs the editor's removal"; spec/os/android/contacts.md, "Story: Name the numbers I am already looking at"; spec/os/android/deferredDeletion.md, "A message, conversation, voicemail or contact is staged only while Android still holds it as I reviewed it"; spec/os/android/paging.md, "Story: Page my records without repeats or gaps"; spec/agent/deviceActions/capabilities.md, "The capability vocabulary is closed and versioned, with one wire name per capability"
import type { Admission, HandoffOutcome, HostFacts, ProviderReply, ReadKind, WriteGate } from "../../gen/os__android__bridge.ts"
import {
  Machine,
  advertisesContactWrite,
  answerMatchesAsk,
  machine,
  maxNamedNumbers,
  namesAnswer,
  namesShown,
  pageAskAdmitted,
  readAdmission,
  writeAdmission,
  type ContactsInstall,
  type NamesAnswer,
  type PageAsk,
} from "../../gen/os__android__contacts.effect.vibe"
import { noRow, startOf, type CursorRefusal, type PageCursor, type PageStart } from "../../gen/os__android__paging.effect.vibe"
import { actionJournalPlugin, queuedDeletions } from "./action-journal.vibe"
import { hiddenRecords, parseStagedDeletion } from "./deletion-window.vibe"
import type { ActionJournalPlugin } from "./definitions/action-journal.ts"
import type {
  AddressBookClient,
  AddressBookClientOptions,
  AddressBookContact,
  AddressBookNativePlugin,
  AddressBookPage,
  AddressBookStatus,
  ContactCursor,
  ContactCustomType,
  ContactDetail,
  ContactDraft,
  ContactDraftProblem,
  ContactEmailKind,
  ContactId,
  ContactName,
  ContactNamesClient,
  ContactPageAsk,
  ContactPhoneKind,
  ContactRemoveResult,
  ContactRequestProblem,
  ContactSaveResult,
  ContactVersion,
  DisplayOnlyName,
  NameScreen,
  NameSurface,
  ReviewedContact,
} from "./definitions/contacts.ts"

export type * from "./definitions/contacts.ts"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import { Cause, Effect, Exit } from "effect"
  import type { AddressBookNativePlugin } from "./definitions/contacts.ts"

  /** @throws {never} */
  export function addressBookPlugin(name: string): AddressBookNativePlugin {
    return registerPlugin<AddressBookNativePlugin>(name)
  }

  /** @throws {never} */
  export async function settled<A, E>(effect: Effect.Effect<A, E>): Promise<A> {
    const exit = await Effect.runPromiseExit(effect)
    if (Exit.isSuccess(exit)) return exit.value
    throw Cause.squash(exit.cause)
  }
}
import { addressBookPlugin, settled } from capacitor
export { addressBookPlugin }

export const CONTACT_PHONE_TYPES = [
  "home",
  "mobile",
  "work",
  "fax_work",
  "fax_home",
  "pager",
  "other",
  "callback",
  "car",
  "company_main",
  "isdn",
  "main",
  "other_fax",
  "radio",
  "telex",
  "tty_tdd",
  "work_mobile",
  "work_pager",
  "assistant",
  "mms",
] as const satisfies readonly ContactPhoneKind[]
export const CONTACT_EMAIL_TYPES = ["home", "work", "other", "mobile"] as const satisfies readonly ContactEmailKind[]
export const CONTACT_CUSTOM_TYPE_PREFIX = "custom:"
export const CONTACT_MAX_FIELDS = 32
export const CONTACT_MAX_NAME = 256
export const CONTACT_MAX_NUMBER = 64
export const CONTACT_MAX_ADDRESS = 320
export const CONTACT_MAX_LABEL = 64
export const CONTACT_MAX_NOTES = 8192
export const ADDRESS_BOOK_MAX_PAGE = 200
export const ADDRESS_BOOK_DEFAULT_PAGE = 50
export const CONTACT_NAMES_MAX = maxNamedNumbers
export const CONTACT_PHOTO_MAX = 48 * 1024

export type ContactsMethod = keyof AddressBookNativePlugin

export error MalformedContactReply { method: ContactsMethod; issue: string }
export error ContactCallRejected { method: ContactsMethod; rejection: unknown }
export error InvalidContactRequest { problem: ContactRequestProblem }
export error ContactCursorRefused { reason: CursorRefusal }
export error ContactReadRefused { viewOpen: boolean; admission: Admission }
export error ContactReadDropped { ticket: number }
export error ContactWriteRefused { viewOpen: boolean; gate: WriteGate; admission: Admission }
export error ContactNamesRefused { answer: NamesAnswer }
export error ContactNamesDropped { surface: NameSurface }

export type AddressBookFailure =
  | MalformedContactReply
  | ContactCallRejected
  | InvalidContactRequest
  | ContactCursorRefused
  | ContactReadRefused
  | ContactReadDropped
  | ContactWriteRefused
  | ContactNamesRefused
  | ContactNamesDropped

const ID = /^[1-9]\d{0,17}$/
const VERSION = /^[0-9a-f]{64}$/
const CURSOR = /^v1\.([1-9]\d{0,8})\.([1-9]\d{0,17})\.(.*)$/s
const CONTROL = /\p{Cc}/u
const NOTE_CONTROL = /[^\P{Cc}\t\n\r]/u
const CURSOR_MAX = 1024
const DIAL_SEPARATORS = /[\s().-]/g
const DIALABLE = /^\+?[0-9]{2,20}$/
const PHOTO = /^data:image\/jpeg;base64,[A-Za-z0-9+/]+={0,2}$/
const ONE_CONTACT: PageAsk = { queryLength: 0, hasNul: false, limit: 1 }
const strict = { onExcessProperty: "error" } as const

export function isContactId(value: unknown): value is ContactId {
  return typeof value === "string" && ID.test(value)
}

export function isContactVersion(value: unknown): value is ContactVersion {
  return typeof value === "string" && VERSION.test(value)
}

function resumeOf(cursor: string): PageCursor | undefined {
  const parts = cursor.length <= CURSOR_MAX ? CURSOR.exec(cursor) : null
  const rowId = Number(parts?.[2])
  if (!parts || !Number.isSafeInteger(rowId)) return undefined
  try {
    return { query: decodeURIComponent(parts[3] ?? ""), last: { major: Number(parts[1]), minor: 0, rowId } }
  } catch {
    return undefined
  }
}

export function isContactCursor(value: unknown): value is ContactCursor {
  return typeof value === "string" && resumeOf(value) !== undefined
}

function clean(value: unknown, max: number): value is string {
  return typeof value === "string" && value.length <= max && value.trim() !== "" && !CONTROL.test(value)
}

function namePart(value: unknown): value is string {
  return value === "" || clean(value, CONTACT_MAX_NAME)
}

function notesText(value: unknown): value is string {
  return typeof value === "string" && value.length <= CONTACT_MAX_NOTES && !NOTE_CONTROL.test(value)
}

function typed<K extends string>(names: readonly K[]) {
  return (value: unknown): value is K | ContactCustomType =>
    typeof value === "string" &&
    (names.some((name) => name === value) ||
      (value.startsWith(CONTACT_CUSTOM_TYPE_PREFIX) && clean(value.slice(CONTACT_CUSTOM_TYPE_PREFIX.length), CONTACT_MAX_LABEL)))
}

const isPhoneType = typed(CONTACT_PHONE_TYPES)
const isEmailType = typed(CONTACT_EMAIL_TYPES)

function text(max: number) {
  return Schema.String.check(Schema.isMaxLength(max))
}

function cleanText(max: number) {
  return Schema.String.check(Schema.makeFilter((value: string) => clean(value, max)))
}

const Id = Schema.String.pipe(Schema.refine(isContactId))
const Version = Schema.String.pipe(Schema.refine(isContactVersion))
const Listing = Schema.mutable(Schema.Array(text(1024))).check(Schema.isMaxLength(CONTACT_MAX_FIELDS))
const Status = Schema.Struct({ available: Schema.Boolean, readable: Schema.Boolean, writable: Schema.Boolean }).check(
  Schema.makeFilter((seen: AddressBookStatus) => (seen.available || !seen.readable) && (seen.readable || !seen.writable)),
)
const Listed = Schema.Struct({
  id: Id,
  lookup: text(1024),
  name: text(1024),
  revision: Schema.optionalKey(text(32)),
  starred: Schema.Boolean,
  phones: Listing,
  emails: Listing,
})
schema Unlisted { id: Id; incomplete: true; reason: "field-too-long" | "too-many-fields" }
const Page = Schema.Struct({
  contacts: Schema.Array(Schema.Union([Unlisted, Listed])),
  more: Schema.Boolean,
  next: Schema.optionalKey(Schema.String.pipe(Schema.refine(isContactCursor))),
})
const Detail = Schema.Struct({
  id: Id,
  lookup: text(1024),
  displayName: text(CONTACT_MAX_NAME),
  givenName: Schema.String.pipe(Schema.refine(namePart)),
  familyName: Schema.String.pipe(Schema.refine(namePart)),
  notes: Schema.optionalKey(Schema.String.pipe(Schema.refine(notesText))),
  starred: Schema.Boolean,
  phoneNumbers: Schema.mutable(
    Schema.Array(Schema.Struct({ number: cleanText(CONTACT_MAX_NUMBER), type: Schema.String.pipe(Schema.refine(isPhoneType)) })),
  ).check(Schema.isMaxLength(CONTACT_MAX_FIELDS)),
  emailAddresses: Schema.mutable(
    Schema.Array(Schema.Struct({ address: cleanText(CONTACT_MAX_ADDRESS), type: Schema.String.pipe(Schema.refine(isEmailType)) })),
  ).check(Schema.isMaxLength(CONTACT_MAX_FIELDS)),
  version: Version,
})
const Saved = Schema.Union([
  Schema.Struct({ status: Schema.Literal("saved"), id: Id, version: Version }),
  Schema.Struct({ status: Schema.Literal("saved"), id: Schema.Null, version: Schema.Null }),
  Schema.Struct({ status: Schema.Literals(["stale", "not-found", "failed", "unknown"]) }),
])
const Removed = Schema.Union([
  Schema.Struct({ status: Schema.Literal("queued"), deletion: Schema.Unknown }),
  Schema.Struct({ status: Schema.Literals(["stale", "not-found", "failed"]) }),
])
const Named = Schema.Struct({
  names: Schema.Array(Schema.Struct({
    number: Schema.String,
    name: Schema.NullOr(text(CONTACT_MAX_NAME)),
    photo: Schema.NullOr(Schema.String.check(Schema.isMaxLength(CONTACT_PHOTO_MAX)).check(Schema.isPattern(PHOTO))),
  })).check(Schema.isMaxLength(maxNamedNumbers)),
})
schema Returned { status: "returned" }
effect function decoded<A>(method: ContactsMethod, shape: Schema.Decoder<A>, raw: unknown): A!MalformedContactReply {
  return try mapError(Schema.decodeUnknownEffect(shape, strict)(raw), (refusal) => new MalformedContactReply({ method, issue: refusal.message }))
}

effect function called(method: ContactsMethod, call: () => Promise<unknown>): unknown!ContactCallRejected {
  return try tryPromise({ try: () => call(), catch: (rejection) => new ContactCallRejected({ method, rejection }) })
}

effect function reply<A>(method: ContactsMethod, shape: Schema.Codec<A>, call: () => Promise<unknown>) {
  return try decoded(method, shape, try called(method, call))
}

export interface ContactPageRead {
  readonly query: string
  readonly limit: number
  readonly start: PageStart
}

export effect function parseAddressBookStatus(value: unknown): AddressBookStatus!MalformedContactReply {
  return try decoded("status", Status, value)
}

export effect function parseAddressBookPage(value: unknown, read: ContactPageRead): AddressBookPage!MalformedContactReply {
  const page = try decoded("list", Page, value)
  const rows = page.contacts
  const before = read.start.tag === "AfterRow" ? read.start.last : noRow
  const last = rows.at(-1)
  const following = page.next === undefined ? undefined : resumeOf(page.next)
  const continues = following === undefined
    ? !page.more
    : page.more &&
      last !== undefined &&
      following.query === read.query &&
      following.last.major === before.major + rows.length &&
      String(following.last.rowId) === last.id
  const ids = new Set([String(before.rowId), ...rows.map((row) => row.id)])
  if (rows.length > read.limit || ids.size !== rows.length + 1 || !continues) {
    throw new MalformedContactReply({ method: "list", issue: "The page does not follow its request" })
  }
  return {
    contacts: rows.map((row) => ("incomplete" in row ? row : { ...row, revision: row.revision ?? null })),
    next: page.next ?? null,
  }
}

export function isIncompleteAddressBookContact(row: AddressBookPage["contacts"][number]) {
  return "incomplete" in row
}

export effect function parseContactDetail(value: unknown, id: ContactId): ContactDetail!MalformedContactReply {
  const detail = try decoded("get", Detail, value)
  if (detail.id !== id) throw new MalformedContactReply({ method: "get", issue: "The reply names another contact" })
  return detail
}

export effect function parseContactSave(value: unknown, updated?: ContactId): ContactSaveResult!MalformedContactReply {
  const saved = try decoded("save", Saved, value)
  if (updated === undefined && (saved.status === "stale" || saved.status === "not-found")) {
    throw new MalformedContactReply({ method: "save", issue: "A new contact has no earlier version" })
  }
  return saved
}

export effect function parseContactRemove(value: unknown): ContactRemoveResult!MalformedContactReply {
  const removed = try decoded("remove", Removed, value)
  if (removed.status !== "queued") return { status: removed.status }
  const deletion = try mapError(parseStagedDeletion("AddressBookPlugin", "remove", "contact", removed.deletion), (bad) => new MalformedContactReply({ method: "remove", issue: bad.issue }))
  return { status: "queued", deletion }
}

export function dialableNumber(number: string): string | null {
  const bare = number.replace(DIAL_SEPARATORS, "")
  return DIALABLE.test(bare) ? bare : null
}

export function screenNumbers(numbers: readonly string[]): string[] {
  const asked = new Set<string>()
  for (const number of numbers) {
    const dialable = dialableNumber(number)
    if (dialable !== null && asked.size < maxNamedNumbers) asked.add(dialable)
  }
  return [...asked]
}

export effect function parseContactNames(value: unknown, asked: readonly string[]) {
  const { names } = try decoded("resolveNames", Named, value)
  const answer = names.map((one) => ({ asked: asked.indexOf(one.number), named: one.name !== null, photo: one.photo !== null }))
  if (!answerMatchesAsk(asked.map((_, at) => at), answer)) throw new MalformedContactReply({ method: "resolveNames", issue: "The names do not follow the numbers asked" })
  return new Map(names.map((one) => [one.number, { name: one.name === null || one.name.trim() === "" ? null : (one.name as DisplayOnlyName), photo: one.photo }]))
}

export function contactDraftProblem(draft: ContactDraft, { create = false }: { create?: boolean } = {}): ContactDraftProblem | null {
  if (![draft.displayName, draft.givenName ?? "", draft.familyName ?? ""].every(namePart)) return "invalid-name"
  if (draft.notes !== undefined && !notesText(draft.notes)) return "invalid-notes"
  if (draft.phoneNumbers.length > CONTACT_MAX_FIELDS || draft.emailAddresses.length > CONTACT_MAX_FIELDS) return "too-many-fields"
  for (const phone of draft.phoneNumbers) {
    if (!clean(phone.number, CONTACT_MAX_NUMBER)) return "invalid-number"
    if (!isPhoneType(phone.type)) return "invalid-type"
  }
  for (const email of draft.emailAddresses) {
    if (!clean(email.address, CONTACT_MAX_ADDRESS)) return "invalid-address"
    if (!isEmailType(email.type)) return "invalid-type"
  }
  const structured = draft.givenName !== undefined || draft.familyName !== undefined
  const named = Boolean(draft.givenName || draft.familyName) || (!(create && structured) && draft.displayName !== "")
  return named || draft.notes?.trim() || draft.phoneNumbers.length || draft.emailAddresses.length ? null : "empty-contact"
}

export function contactWriteAdvertised(install: ContactsInstall, status: AddressBookStatus): boolean {
  return advertisesContactWrite(install, "PluginRegistered", { readGranted: status.readable, writeGranted: status.writable })
}

function reportedFacts(status: AddressBookStatus): HostFacts {
  return { foreground: status.readable, unlocked: status.readable, focused: status.readable, granted: status.readable, featurePresent: true }
}

function pageAsk(query: string, limit: number): PageAsk {
  return { queryLength: query.length, hasNul: query.includes("\0"), limit }
}

function bounded(ask: PageAsk): boolean {
  return Number.isSafeInteger(ask.limit) && pageAskAdmitted(ask)
}

function payloadOf(draft: ContactDraft): ContactDraft {
  return {
    displayName: draft.displayName,
    phoneNumbers: draft.phoneNumbers.map(({ number, type }) => ({ number, type })),
    emailAddresses: draft.emailAddresses.map(({ address, type }) => ({ address, type })),
    ...(draft.givenName === undefined ? {} : { givenName: draft.givenName }),
    ...(draft.familyName === undefined ? {} : { familyName: draft.familyName }),
    ...(draft.notes === undefined ? {} : { notes: draft.notes }),
  }
}

function saveReply(result: ContactSaveResult): ProviderReply {
  return match (result.status) {
    when "saved": result.id === null ? "CommittedNotReadBack" : "CommittedAndReadBack";
    when "stale": "RevisionMismatch";
    when "not-found": "NothingWritten";
    when "failed": "NothingWritten";
    when "unknown": "NoReply";
  }
}

type Book = Machine.Shape

effect function held() {
  provide machine() {
    return try Machine
  }
}

effect function observe(book: Book, method: "status" | "requestPermissions", call: () => Promise<unknown>) {
  const seen = try reply(method, Status, call)
  const { grants } = try book.get()
  if (grants.readGranted !== seen.readable || grants.writeGranted !== seen.writable) {
    try orDie(book.send({ type: "grantsChanged", readGranted: seen.readable, writeGranted: seen.writable }))
  }
  return seen
}

effect function open(book: Book, plugin: AddressBookNativePlugin) {
  book.send({ type: "openView" }) catch (kept) => kept.state
  return try observe(book, "status", () => plugin.status())
}

effect function close(book: Book) {
  book.send({ type: "closeView" }) catch (kept) => kept.state
}

effect function retire(book: Book) {
  try orDie(book.send({ type: "retireReads" }))
}

effect function prompt(book: Book, plugin: AddressBookNativePlugin) {
  try retire(book)
  return try observe(book, "requestPermissions", () => plugin.requestPermissions())
}

effect function read<A>(
  book: Book,
  plugin: AddressBookNativePlugin,
  kind: ReadKind,
  ask: PageAsk,
  start: PageStart,
  answer: () => A!(ContactCallRejected | MalformedContactReply),
) {
  const facts = reportedFacts(try observe(book, "status", () => plugin.status()))
  const begun = book.send({ type: "beginRead", kind, facts, ask }) catch effect (refused) => {
    throw new ContactReadRefused({ viewOpen: refused.state.viewOpen, admission: readAdmission(refused.state.grants, facts) })
  }
  const ticket = begun.generation
  const outcome = try exit(answer())
  book.send({ type: "completeRead", ticket, facts, start, providerOk: Exit.isSuccess(outcome) }) catch effect () => {
    throw new ContactReadDropped({ ticket })
  }
  return try outcome
}

effect function list(book: Book, plugin: AddressBookNativePlugin, journal: ActionJournalPlugin, ask: ContactPageAsk) {
  const limit = ask.limit ?? ADDRESS_BOOK_DEFAULT_PAGE
  const page = pageAsk(ask.query, limit)
  const resume = ask.cursor === undefined ? undefined : resumeOf(ask.cursor)
  if (ask.cursor !== undefined && resume === undefined) throw new InvalidContactRequest({ problem: "invalid-cursor" })
  if (!bounded(page)) throw new InvalidContactRequest({ problem: "unbounded-page" })
  const start = startOf(resume === undefined ? { tag: "FirstRequest" } : { tag: "ContinueRequest", resume }, ask.query, true)
  if (start.tag === "Refused") throw new ContactCursorRefused({ reason: start.reason })
  const options = { query: ask.query, limit, ...(ask.cursor === undefined ? {} : { cursor: ask.cursor }) }
  const listed = try read(book, plugin, ask.kind ?? "AutomaticRead", page, start, effect () =>
    try parseAddressBookPage(try called("list", () => plugin.list(options)), { query: ask.query, limit, start }))
  const hidden = hiddenRecords(try queuedDeletions(journal), "contact")
  return { ...listed, contacts: listed.contacts.filter((row) => !hidden.has(row.id)) }
}

effect function get(book: Book, plugin: AddressBookNativePlugin, id: ContactId, kind: ReadKind) {
  if (!isContactId(id)) throw new InvalidContactRequest({ problem: "invalid-contact" })
  return try read(book, plugin, kind, ONE_CONTACT, { tag: "FromFirst" }, effect () =>
    try parseContactDetail(try called("get", () => plugin.get({ id })), id))
}

effect function handoff(book: Book, method: "create" | "edit", call: () => Promise<unknown>): HandoffOutcome!! {
  try retire(book)
  return (try isSuccess(reply(method, Returned, call))) ? "Opened" : "Refused"
}

effect function edit(book: Book, plugin: AddressBookNativePlugin, contact: AddressBookContact): HandoffOutcome!! {
  const { id, lookup, revision } = contact
  if (!isContactId(id) || revision === null) return "Refused"
  return try handoff(book, "edit", () => plugin.edit({ id, lookup, revision }))
}

effect function write<A>(
  book: Book,
  plugin: AddressBookNativePlugin,
  install: ContactsInstall,
  classify: (answer: A) => ProviderReply,
  answer: () => A!!,
) {
  const facts = reportedFacts(try observe(book, "status", () => plugin.status()))
  uninterruptible {
    book.send({ type: "dispatchWrite", install, facts }) catch effect (refused) => {
      throw new ContactWriteRefused({
        viewOpen: refused.state.viewOpen,
        gate: refused.state.gate,
        admission: writeAdmission(install, refused.state.grants, facts),
      })
    }
    const result = try answer()
    try orDie(book.send({ type: "settleWrite", reply: classify(result) }))
    return result
  }
}

function reviewProblem(reviewed: ReviewedContact): ContactRequestProblem | null {
  return !isContactId(reviewed.id) ? "invalid-contact" : !isContactVersion(reviewed.version) ? "invalid-version" : null
}

effect function save(book: Book, plugin: AddressBookNativePlugin, install: ContactsInstall, draft: ContactDraft, reviewed?: ReviewedContact) {
  const problem = (reviewed && reviewProblem(reviewed)) ?? contactDraftProblem(draft, { create: reviewed === undefined })
  if (problem !== null) throw new InvalidContactRequest({ problem })
  const options = { ...(reviewed === undefined ? {} : { id: reviewed.id, version: reviewed.version }), ...payloadOf(draft) }
  const lost: ContactSaveResult = { status: "unknown" }
  return try write(book, plugin, install, saveReply, effect () =>
    (effect { return try parseContactSave(try called("save", () => plugin.save(options)), reviewed?.id) } catch () => lost))
}

effect function remove(book: Book, plugin: AddressBookNativePlugin, install: ContactsInstall, reviewed: ReviewedContact) {
  const problem = reviewProblem(reviewed)
  if (problem !== null) throw new InvalidContactRequest({ problem })
  const facts = reportedFacts(try observe(book, "status", () => plugin.status()))
  book.send({ type: "stageRemoval", install, facts }) catch effect (refused) => {
    throw new ContactWriteRefused({
      viewOpen: refused.state.viewOpen,
      gate: refused.state.gate,
      admission: writeAdmission(install, refused.state.grants, facts),
    })
  }
  return try parseContactRemove(try called("remove", () => plugin.remove({ id: reviewed.id, version: reviewed.version })))
}

export function createAddressBookClient(options: AddressBookClientOptions): AddressBookClient {
  const { install, plugin, journal = actionJournalPlugin() } = options
  const book = Effect.runSync(held())
  return {
    open: () => settled(open(book, plugin)),
    close: () => settled(close(book)),
    retire: () => settled(retire(book)),
    state: () => settled(book.get()),
    status: () => settled(observe(book, "status", () => plugin.status())),
    requestPermissions: () => settled(prompt(book, plugin)),
    list: (ask) => settled(list(book, plugin, journal, ask)),
    get: (id, kind = "AutomaticRead") => settled(get(book, plugin, id, kind)),
    create: () => settled(handoff(book, "create", () => plugin.create())),
    edit: (contact) => settled(edit(book, plugin, contact)),
    createContact: (draft) => settled(save(book, plugin, install, draft)),
    updateContact: (reviewed, draft) => settled(save(book, plugin, install, draft, reviewed)),
    remove: (reviewed) => settled(remove(book, plugin, install, reviewed)),
  }
}

type Screens = Ref.Ref<ReadonlyMap<NameSurface, number>>

effect function advance(screens: Screens, surface: NameSurface) {
  return try Ref.modify(screens, (open): [number, ReadonlyMap<NameSurface, number>] => {
    const next = (open.get(surface) ?? 0) + 1
    return [next, new Map(open).set(surface, next)]
  })
}

effect function resolveNames(screens: Screens, plugin: AddressBookNativePlugin, screen: NameScreen) {
  const asked = screenNumbers(screen.numbers)
  const generation = try advance(screens, screen.surface)
  if (asked.length === 0) return []
  const seen = try reply("status", Status, () => plugin.status())
  const grants = { readGranted: seen.readable, writeGranted: seen.writable }
  const nameAsk = { screenOpen: true, numbers: asked.length, distinct: true, dialShaped: true }
  const admitted = namesAnswer(grants, reportedFacts(seen), nameAsk, true)
  if (admitted.tag !== "NamesRead") throw new ContactNamesRefused({ answer: admitted })
  const found = try parseContactNames(try called("resolveNames", () => plugin.resolveNames({ numbers: asked })), asked)
  const current = (try Ref.get(screens)).get(screen.surface) ?? 0
  if (!namesShown(admitted, generation, current, "BesideTheRows")) throw new ContactNamesDropped({ surface: screen.surface })
  return screen.numbers.flatMap((number): ContactName[] => {
    const dialable = dialableNumber(number)
    const one = dialable === null ? undefined : found.get(dialable)
    return one === undefined || (one.name === null && one.photo === null) ? [] : [{ number, name: one.name, photo: one.photo }]
  })
}

export function createContactNames(plugin: AddressBookNativePlugin): ContactNamesClient {
  const screens: Screens = Effect.runSync(Ref.make<ReadonlyMap<NameSurface, number>>(new Map()))
  return {
    resolve: (screen) => settled(resolveNames(screens, plugin, screen)),
    close: (surface) => settled(effect { try advance(screens, surface) }),
  }
}
