// spec/os/android/phone.md, "Story: Hand an approved number to my phone"; spec/os/android/phone.md, "Story: Read my recent calls"; spec/os/android/voicemail.md, "Story: See my voicemail only when my carrier offers it"; spec/os/android/voicemail.md, "Story: Hear a voicemail"; spec/os/android/voicemail.md, "Story: Change a voicemail only as the provider confirms it"; spec/os/android/deferredDeletion.md, "Story: Undo a deleted message, conversation, voicemail or contact"; spec/agent/deviceActions/operations.md, "The operation vocabulary is closed, and each wire type belongs to one family"; spec/agent/deviceActions/capabilities.md, "The capability vocabulary is closed and versioned, with one wire name per capability"; spec/os/android/phone.md, "Story: See my SIM lines without guesses"; spec/os/android/phone.md, "A SIM line shows a field only when Android let this app read it"
import type { HostFacts, ProviderReply, ReadKind, WriteGate } from "../../gen/os__android__bridge.ts"
import { receiptOfWrite } from "../../gen/os__android__bridge.effect.vibe"
import { isAfterStart, startOf, type PageCursor, type PageRequest } from "../../gen/os__android__paging.effect.vibe"
import {
  callLogKey,
  dialReceipt,
  dialResult,
  linesFollowAccess,
  maxCallLogPage,
  maxSimLines,
  placeReceipt,
  placeStatus,
  readCallLog,
  type DialerAnswer,
  type Placement,
  type TelecomAnswer,
} from "../../gen/os__android__phone.effect.vibe"
import {
  Machine,
  canDecodePcm,
  canRequestAudio,
  canWriteRow,
  deviceAllows,
  hasRow,
  machine,
  maxPcmSamples,
  maxVoicemails,
  maxWavBytes,
  rowAt,
  shownRows,
  type PcmDecode,
  type SourceConfiguration,
} from "../../gen/os__android__voicemail.effect.vibe"
import { actionJournalPlugin, queuedDeletions } from "./action-journal.vibe"
import { BridgeUnavailable, MalformedReply, NativeRejection, nativeCall, settled } from "./bridge.vibe"
import { hiddenRecords, parseStagedDeletion } from "./deletion-window.vibe"
import type { ActionJournalPlugin } from "./definitions/action-journal.ts"
import {
  TELEPHONY_DEFAULT_PAGE,
  VOICEMAIL_AUDIO_MAX_BYTES,
  VOICEMAIL_PCM_RATE_HZ,
  WAV_HEADER_BYTES,
  normalizePhoneNumber,
  parseImageCapability,
  parseTelephonyStatus,
  type ListedVoicemail,
  type PcmRefusal,
  type PhoneClient,
  type PhoneInfo,
  type PhoneNativePlugin,
  type PlaceCallStatus,
  type RecentCallsAsk,
  type RecentCallsRefusal,
  type TelephonyCallLogEntry,
  type TelephonyHandoffStatus,
  type TelephonyStatus,
  type VoicemailCarrierState,
  type VoicemailDeletionReport,
  type VoicemailEntry,
  type VoicemailId,
  type VoicemailListing,
  type VoicemailRefusalReason,
  type VoicemailPcm,
  type VoicemailWriteStatus,
} from "./definitions/phone.ts"

export type * from "./definitions/phone.ts"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { PhoneNativePlugin } from "./definitions/phone.ts"

  /** @throws {never} */
  export function telephonyPlugin(name = "ElizaTelephony"): PhoneNativePlugin {
    return registerPlugin<PhoneNativePlugin>(name)
  }
}
import { telephonyPlugin } from capacitor
export { telephonyPlugin }

const PLUGIN = "ElizaTelephony"

export type PhoneRequestProblem = "not-dialable" | "invalid-voicemail" | "invalid-cursor"

export error PhoneRequestRefused { problem: PhoneRequestProblem }
export error RecentCallsRefused { refusal: RecentCallsRefusal }
export error VoicemailRefused { id: VoicemailId | null; reason: VoicemailRefusalReason; gate: WriteGate }
export error VoicemailPcmRefused { id: VoicemailId; reason: PcmRefusal }

const strict = { onExcessProperty: "error" } as const
const CALL_ID = /^[1-9]\d{0,15}$/
const VOICEMAIL_ID = /^[1-9]\d{0,15}$/
const DIALED = /^(|\+?[0-9]{2,20})$/
const AUDIO_TYPE = /^audio\/[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$/
const BASE64 = /^[A-Za-z0-9+/]*={0,2}$/
const TRANSCRIPT_MAX = 4000
const ADMITTED: HostFacts = { foreground: true, unlocked: true, focused: true, granted: true, featurePresent: true }

function text(max: number) {
  return Schema.String.check(Schema.isMaxLength(max))
}

function shaped(pattern: RegExp) {
  return Schema.String.check(Schema.isPattern(pattern))
}

const Count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const Moment = Schema.Int.check(Schema.isGreaterThan(0))
const Name = Schema.NullOr(text(256))

const CallLog = Schema.Struct({
  calls: Schema.Array(Schema.Struct({
    id: shaped(CALL_ID),
    number: shaped(DIALED),
    cachedName: Name,
    date: Moment,
    durationSeconds: Count,
    type: Schema.Literals(["incoming", "outgoing", "missed", "voicemail", "rejected", "blocked", "answered_externally", "unknown"]),
    isNew: Schema.Boolean,
  })),
})
const Handoff = Schema.Struct({
  status: Schema.Literals(["handed-off", "unavailable", "cancelled", "failed"]),
  target: Schema.Literal("dialer"),
  handler: Schema.NullOr(text(256)),
  message: text(1024),
})
const Placed = Schema.Struct({
  status: Schema.Literals(["placed", "emergency-handoff", "busy", "unavailable", "failed"]),
  message: text(1024),
})
const Line = Schema.Struct({
  subscriptionId: Count,
  slot: Count,
  displayName: text(64),
  carrierName: text(64),
  number: Schema.NullOr(shaped(/^(\+[0-9]{1,31}|[0-9]{1,32})$/)),
  countryIso: Schema.NullOr(shaped(/^[a-z]{2}$/)),
  networkType: Schema.Literals(["none", "2g", "3g", "4g", "5g", "wifi-calling", "unknown"]),
  roaming: Schema.NullOr(Schema.Boolean),
  signalLevel: Schema.NullOr(Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 4 }))),
  embedded: Schema.Boolean,
  iccid: Schema.NullOr(shaped(/^([0-9]{1,21}F?|[0-9]{22})$/)),
  imei: Schema.NullOr(shaped(/^[0-9]{14,16}$/)),
})
const Info = Schema.Struct({
  access: Schema.Struct({ phoneState: Schema.Boolean, phoneNumbers: Schema.Boolean, deviceIdentifiers: Schema.Boolean }),
  lines: Schema.Array(Line).check(Schema.isMaxLength(maxSimLines)),
})
const Carrier = Schema.Literals(["ready", "unconfigured", "unsupported"])
const Status = Schema.Struct({ access: Schema.Boolean, state: Schema.NullOr(Carrier) })
const Listing = Schema.Struct({
  state: Carrier,
  voicemails: Schema.Array(Schema.Struct({
    id: shaped(VOICEMAIL_ID),
    number: shaped(DIALED),
    cachedName: Name,
    date: Moment,
    durationSeconds: Count,
    isNew: Schema.Boolean,
    hasAudio: Schema.Boolean,
    carrierTranscript: Schema.NullOr(text(TRANSCRIPT_MAX)),
  })).check(Schema.isMaxLength(maxVoicemails)),
})
schema Fetch { status: "ready" | "fetching" | "failed" }
const Audio = Schema.Struct({ id: shaped(VOICEMAIL_ID), mimeType: shaped(AUDIO_TYPE), size: Count, data: Schema.String })
const Pcm = Schema.Struct({ mimeType: Schema.Literal("audio/wav"), sampleRateHz: Schema.Literal(VOICEMAIL_PCM_RATE_HZ), durationSeconds: Schema.Finite, data: Schema.String })
schema Written { status: "marked" | "unconfirmed" | "not-found" }
const Staged = Schema.Union([
  Schema.Struct({ status: Schema.Literal("queued"), deletion: Schema.Unknown }),
  Schema.Struct({ status: Schema.Literal("not-found") }),
])

effect function parsed<A>(method: string, shape: Schema.Decoder<A>, raw: unknown): A!MalformedReply {
  return try mapError(Schema.decodeUnknownEffect(shape, strict)(raw), (refusal) => new MalformedReply({ plugin: PLUGIN, method, issue: refusal.message }))
}

effect function reply<A>(method: string, shape: Schema.Decoder<A>, call: () => Promise<unknown>) {
  return try parsed(method, shape, try nativeCall(PLUGIN, method, call))
}

effect function malformed(method: string, issue: string): never!MalformedReply {
  throw new MalformedReply({ plugin: PLUGIN, method, issue })
}

effect function checked<A>(method: string, parse: (raw: unknown) => A | undefined, call: () => Promise<unknown>) {
  const value = parse(try nativeCall(PLUGIN, method, call))
  return value === undefined ? try malformed(method, "The reply is not a telephony status") : value
}

function base64Bytes(value: string, max: number): number | undefined {
  if (value.length === 0 || value.length % 4 !== 0 || value.length > Math.ceil(max / 3) * 4 || !BASE64.test(value)) return undefined
  const bytes = (value.length / 4) * 3 - (value.endsWith("==") ? 2 : value.endsWith("=") ? 1 : 0)
  return bytes >= 1 && bytes <= max ? bytes : undefined
}

function idOf(id: VoicemailId): number | undefined {
  return typeof id === "string" && VOICEMAIL_ID.test(id) && Number.isSafeInteger(Number(id)) ? Number(id) : undefined
}

function cursorHolds(cursor: PageCursor): boolean {
  const { major, minor, rowId } = cursor.last
  return typeof cursor.query === "string" && Number.isSafeInteger(rowId) && rowId > 0 && minor === -rowId && Number.isSafeInteger(major) && major < 0
}

effect function readStatus(plugin: PhoneNativePlugin) {
  return try checked("status", parseTelephonyStatus, () => plugin.status())
}

function telephonyFacts(status: TelephonyStatus, granted: boolean): HostFacts {
  return { ...ADMITTED, granted, featurePresent: status.voiceCapable }
}

function dialerAnswer(status: TelephonyHandoffStatus): DialerAnswer {
  return match (status) {
    when "handed-off": "DialerOpened";
    when "unavailable": "DialerMissing";
    when "cancelled": "DialerFailed";
    when "failed": "DialerFailed";
  }
}

effect function dial(plugin: PhoneNativePlugin, number: string) {
  const dialable = normalizePhoneNumber(number)
  const status = try readStatus(plugin)
  const facts = telephonyFacts(status, true)
  const refused = dialResult("PluginRegistered", facts, dialable !== null, "DialerMissing", false)
  if (dialable === null || refused.dialStatus === "DialRefused") return { dialStatus: refused.dialStatus, handler: null, receipt: dialReceipt(refused) }
  const answer = (try exit(reply("dial", Handoff, () => plugin.dial({ number: dialable }))))
  if (Exit.isFailure(answer)) {
    const failure = Cause.squash(answer.cause)
    if (!(failure instanceof NativeRejection)) return try failCause(answer.cause)
    const notReady = dialResult("PluginRegistered", { ...facts, foreground: false }, true, "DialerMissing", false)
    return { dialStatus: notReady.dialStatus, handler: null, receipt: dialReceipt(notReady) }
  }
  const result = dialResult("PluginRegistered", facts, true, dialerAnswer(answer.value.status), answer.value.handler === null)
  return { dialStatus: result.dialStatus, handler: result.namesHandler ? answer.value.handler : null, receipt: dialReceipt(result) }
}

interface PlaceEvidence {
  readonly placement: Placement
  readonly screen: DialerAnswer
  readonly telecom: TelecomAnswer
}

const FREE_LINE: Placement = { numberKind: "OrdinaryNumber", voiceCapable: true, roleHeld: true, callGrant: true, line: "LineFree" }

function placeEvidence(answer: PlaceCallStatus | "role-required" | "permission-required"): PlaceEvidence {
  return match (answer) {
    when "placed": { placement: FREE_LINE, screen: "DialerMissing", telecom: "TelecomAccepted" };
    when "emergency-handoff": { placement: { ...FREE_LINE, numberKind: "EmergencyNumber" }, screen: "DialerOpened", telecom: "TelecomMissing" };
    when "busy": { placement: { ...FREE_LINE, line: "LineBusy" }, screen: "DialerMissing", telecom: "TelecomMissing" };
    when "unavailable": { placement: { ...FREE_LINE, voiceCapable: false }, screen: "DialerMissing", telecom: "TelecomMissing" };
    when "failed": { placement: FREE_LINE, screen: "DialerMissing", telecom: "TelecomRefused" };
    when "role-required": { placement: { ...FREE_LINE, roleHeld: false }, screen: "DialerMissing", telecom: "TelecomMissing" };
    when "permission-required": { placement: { ...FREE_LINE, callGrant: false }, screen: "DialerMissing", telecom: "TelecomMissing" };
  }
}

function placeReport(facts: HostFacts, dialable: boolean, evidence: PlaceEvidence) {
  const status = placeStatus("PluginRegistered", facts, dialable, evidence.placement, evidence.screen, evidence.telecom)
  return { placeStatus: status, receipt: placeReceipt(status) }
}

effect function placeCall(plugin: PhoneNativePlugin, number: string) {
  const dialable = normalizePhoneNumber(number)
  const facts = telephonyFacts(try readStatus(plugin), true)
  const refused = placeReport(facts, dialable !== null, placeEvidence("placed"))
  if (dialable === null || refused.placeStatus === "CallRefused") return refused
  const answer = reply("placeCall", Placed, () => plugin.placeCall({ number: dialable })) catch effect (failure) => {
    const code = failure instanceof NativeRejection ? failure.code : undefined
    if (code === "role-required" || code === "permission-required") return { status: code }
    throw failure
  }
  return placeReport(facts, true, placeEvidence(answer.status))
}

effect function parseCallLog(raw: unknown, limit: number) {
  const { calls } = try parsed("listRecentCalls", CallLog, raw)
  if (calls.length > limit + 1) try malformed("listRecentCalls", "The page is longer than its limit and lookahead")
  return calls.map((call): TelephonyCallLogEntry => ({ ...call }))
}

effect function recentCalls(plugin: PhoneNativePlugin, ask: RecentCallsAsk) {
  const limit = ask.limit ?? TELEPHONY_DEFAULT_PAGE
  const filter = ask.number === undefined ? "" : normalizePhoneNumber(ask.number)
  if (filter === null) throw new PhoneRequestRefused({ problem: "not-dialable" })
  if (ask.after !== undefined && !cursorHolds(ask.after)) throw new PhoneRequestRefused({ problem: "invalid-cursor" })
  const request: PageRequest = ask.after === undefined ? { tag: "FirstRequest" } : { tag: "ContinueRequest", resume: ask.after }
  const status = try readStatus(plugin)
  const declared = status.permissions.callLog !== undefined
  const facts = telephonyFacts(status, status.permissions.callLog === "granted")
  const admitted = readCallLog(declared, "PluginRegistered", facts, request, filter, limit, [], true)
  if (admitted.tag !== "CallLogPage") throw new RecentCallsRefused({ refusal: admitted })
  const start = startOf(request, filter, true)
  const options = {
    limit,
    ...(filter === "" ? {} : { number: filter }),
    ...(ask.after === undefined ? {} : { beforeDate: -ask.after.last.major, beforeId: ask.after.last.rowId }),
  }
  const raw = nativeCall(PLUGIN, "listRecentCalls", () => plugin.listRecentCalls(options)) catch effect (failure) => {
    if (failure instanceof NativeRejection && failure.code === "permission-required") {
      throw new RecentCallsRefused({ refusal: { tag: "CallLogNotAdmitted", admission: "PermissionRequired" } })
    }
    throw failure
  }
  const calls = try parseCallLog(raw, limit)
  const keys = calls.map((call) => callLogKey(call.date, Number(call.id)))
  if (!keys.every((key) => isAfterStart(start, key))) try malformed("listRecentCalls", "A row does not follow the cursor")
  const answer = readCallLog(declared, "PluginRegistered", facts, request, filter, limit, keys, true)
  if (answer.tag === "CallLogUnreadable") try malformed("listRecentCalls", "Rows are out of order or repeated")
  if (answer.tag !== "CallLogPage") throw new RecentCallsRefused({ refusal: answer })
  return { calls: calls.slice(0, answer.rows.length), next: answer.more.tag === "MoreAfter" ? answer.more.following : null }
}

effect function phoneInfo(plugin: PhoneNativePlugin): PhoneInfo!(BridgeUnavailable | NativeRejection | MalformedReply) {
  const info = try reply("phoneInfo", Info, () => plugin.phoneInfo())
  const subscriptions = new Set(info.lines.map((line) => line.subscriptionId))
  const ordered = info.lines.every((line, index) => index === 0 || (info.lines[index - 1]?.slot ?? 0) <= line.slot)
  const followed = linesFollowAccess({ ...info.access }, info.lines.map((line) => ({ hasNumber: line.number !== null, hasIccid: line.iccid !== null, hasImei: line.imei !== null })))
  if (subscriptions.size !== info.lines.length || !ordered || !followed) {
    try malformed("phoneInfo", "The lines do not follow the access Android granted")
  }
  return { access: { ...info.access }, lines: info.lines.map((line) => ({ ...line })) }
}

function sourcesOf(state: VoicemailCarrierState): SourceConfiguration[] {
  return match (state) {
    when "ready": ["SourceConfigured"];
    when "unconfigured": ["SourcePending"];
    when "unsupported": [];
  }
}

effect function parseVoicemails(raw: unknown) {
  const list = try parsed("listVoicemail", Listing, raw)
  const ordered = list.voicemails.every((row, index) => index === 0 || (list.voicemails[index - 1]?.date ?? 0) >= row.date)
  const blank = list.voicemails.some((row) => row.carrierTranscript !== null && row.carrierTranscript.trim() === "")
  if (!ordered || blank || (list.state === "unsupported" && list.voicemails.length > 0)) try malformed("listVoicemail", "The voicemail rows are out of order or unreadable")
  return { state: list.state, voicemails: list.voicemails.map((row): VoicemailEntry => ({ ...row, id: row.id as VoicemailId })) }
}

effect function decodeOf(wav: VoicemailPcm): PcmDecode!MalformedReply {
  const bytes = base64Bytes(wav.data, maxWavBytes)
  const samples = bytes === undefined ? 0 : (bytes - WAV_HEADER_BYTES) / 2
  if (bytes === undefined || !Number.isSafeInteger(samples) || Math.abs(wav.durationSeconds - samples / VOICEMAIL_PCM_RATE_HZ) > 0.001) {
    try malformed("voicemailPcm", "The WAV does not match its stated duration")
  }
  return { tag: "DecodedSamples", samples }
}

function pcmRejection(code: string | undefined): PcmDecode | undefined {
  return code === "too-long" || code === "too-large" ? { tag: "DecodedSamples", samples: maxPcmSamples + 1 } : code === "undecodable" ? { tag: "Undecodable" } : undefined
}

function writtenReply(status: VoicemailWriteStatus): ProviderReply {
  return match (status) {
    when "marked": "CommittedAndReadBack";
    when "unconfirmed": "CommittedNotReadBack";
    when "not-found": "NothingWritten";
  }
}

effect function held(journal: ActionJournalPlugin): Voicemails!! {
  provide machine() {
    const book = try Machine
    const entries = try Ref.make(new Map<number, VoicemailEntry>())
    const queued = try Ref.make<readonly number[]>([])
    return { book, entries, queued, journal, lock: try Semaphore.make(1) }
  }
}

interface Voicemails {
  readonly book: Machine.Shape
  readonly entries: Ref.Ref<Map<number, VoicemailEntry>>
  readonly queued: Ref.Ref<readonly number[]>
  readonly journal: ActionJournalPlugin
  readonly lock: Semaphore.Semaphore
}

effect function listing(store: Voicemails): VoicemailListing!! {
  const state = try store.book.get()
  const details = try Ref.get(store.entries)
  const voicemails = shownRows(state.rows, [...(try Ref.get(store.queued))]).flatMap((row): ListedVoicemail[] => {
    const entry = details.get(row.id)
    if (entry === undefined) return []
    const { isNew: _isNew, hasAudio: _hasAudio, ...rest } = entry
    return [{ ...rest, heard: row.heard, audio: row.audio }]
  })
  return { carrier: state.carrier, gate: state.gate, voicemails }
}

effect function voicemailFacts(plugin: PhoneNativePlugin) {
  const status = try readStatus(plugin)
  const access = try reply("voicemailStatus", Status, () => plugin.voicemailStatus())
  if (access.access !== (access.state !== null)) try malformed("voicemailStatus", "Access and carrier state disagree")
  return telephonyFacts(status, access.access)
}

effect function refusal(store: Voicemails, id: VoicemailId | null, reason: VoicemailRefusalReason): never!VoicemailRefused {
  throw new VoicemailRefused({ id, reason, gate: (try store.book.get()).gate })
}

effect function admitted(store: Voicemails, plugin: PhoneNativePlugin, id: VoicemailId | null) {
  const facts = try voicemailFacts(plugin)
  if (!deviceAllows(facts)) try refusal(store, id, "not-admitted")
  return facts
}

effect function stored(store: Voicemails, plugin: PhoneNativePlugin, id: VoicemailId) {
  const row = idOf(id)
  if (row === undefined) throw new PhoneRequestRefused({ problem: "invalid-voicemail" })
  const facts = try admitted(store, plugin, id)
  if (!hasRow((try store.book.get()).rows, row)) try refusal(store, id, "unknown-voicemail")
  return { row, facts }
}

effect function refresh(store: Voicemails, plugin: PhoneNativePlugin, kind: ReadKind) {
  const facts = try admitted(store, plugin, null)
  const list = try parseVoicemails(try nativeCall(PLUGIN, "listVoicemail", () => plugin.listVoicemail({ limit: maxVoicemails })))
  const listed = list.voicemails.map((row) => ({ id: Number(row.id), heard: !row.isNew, hasAudio: row.hasAudio }))
  const read = { kind, startedAfterSettle: true, succeeded: true }
  store.book.send({ type: "refresh", facts, read, sources: sourcesOf(list.state), listed }) catch effect () => {
    try malformed("listVoicemail", "The voicemail rows are not keyed by provider ID")
  }
  try Ref.set(store.entries, new Map(list.voicemails.map((row) => [Number(row.id), row])))
  try Ref.set(store.queued, [...hiddenRecords(try queuedDeletions(store.journal), "voicemail")].map(Number))
  return try listing(store)
}

effect function fetchAudio(store: Voicemails, plugin: PhoneNativePlugin, id: VoicemailId) {
  const { row, facts } = try stored(store, plugin, id)
  if (!canRequestAudio(try store.book.get(), facts, row)) {
    try refusal(store, id, rowAt((try store.book.get()).rows, row).audio === "AudioOnPhone" ? "audio-not-on-phone" : "audio-already-asked")
  }
  const { status } = try reply("fetchVoicemailAudio", Fetch, () => plugin.fetchVoicemailAudio({ id }))
  if (status !== "ready") try orDie(store.book.send({ type: "requestAudio", facts, id: row, sent: status === "fetching" ? "SentToSource" : "NoSourceToAsk" }))
  return status
}

effect function audio(store: Voicemails, plugin: PhoneNativePlugin, id: VoicemailId) {
  try stored(store, plugin, id)
  const found = try reply("voicemailAudio", Audio, () => plugin.voicemailAudio({ id }))
  if (found.id !== id || base64Bytes(found.data, VOICEMAIL_AUDIO_MAX_BYTES) !== found.size) try malformed("voicemailAudio", "The audio is not the requested voicemail's")
  return { ...found, id }
}

effect function pcm(store: Voicemails, plugin: PhoneNativePlugin, id: VoicemailId) {
  const { row, facts } = try stored(store, plugin, id)
  if (!canDecodePcm(try store.book.get(), facts, row, { tag: "Undecodable" })) try refusal(store, id, "audio-not-on-phone")
  const answer = try exit(reply("voicemailPcm", Pcm, () => plugin.voicemailPcm({ id })))
  const failure = Exit.isFailure(answer) ? Cause.squash(answer.cause) : undefined
  const rejected = failure instanceof NativeRejection ? pcmRejection(failure.code) : undefined
  if (Exit.isFailure(answer) && rejected === undefined) return try failCause(answer.cause)
  const wav = Exit.isSuccess(answer) ? answer.value : undefined
  const decode = wav === undefined ? rejected ?? { tag: "Undecodable" } : try decodeOf(wav)
  const out = (try orDie(store.book.send({ type: "decodePcm", facts, id: row, decode }))).out[0]
  if (out?.tag === "PcmRefused") throw new VoicemailPcmRefused({ id, reason: out.reason })
  if (wav === undefined) return try malformed("voicemailPcm", "No PCM was returned")
  return { ...wav }
}

effect function markHeard(store: Voicemails, plugin: PhoneNativePlugin, id: VoicemailId) {
  const { row, facts } = try stored(store, plugin, id)
  if (!canWriteRow(try store.book.get(), facts, row, "NoReply")) try refusal(store, id, "write-blocked")
  const answer = reply("markVoicemailHeard", Written, () => plugin.markVoicemailHeard({ id }))
  const providerReply: ProviderReply = effect { return writtenReply((try answer).status) } catch (failure) => failure instanceof BridgeUnavailable ? "NothingWritten" : "NoReply"
  const step = try orDie(store.book.send({ type: "writeRow", facts, id: row, reply: providerReply }))
  const out = step.out[0]
  const written = out?.tag === "Wrote" ? out.written : "Uncertain"
  return { written, receipt: receiptOfWrite(written), listing: try listing(store) }
}

effect function stageDeletion(store: Voicemails, plugin: PhoneNativePlugin, id: VoicemailId): VoicemailDeletionReport!(PhoneRequestRefused | VoicemailRefused | BridgeUnavailable | NativeRejection | MalformedReply) {
  const { row, facts } = try stored(store, plugin, id)
  store.book.send({ type: "stageDelete", facts, id: row }) catch effect () => {
    try refusal(store, id, "write-blocked")
  }
  const answer = try reply("deleteVoicemail", Staged, () => plugin.deleteVoicemail({ id }))
  if (answer.status === "not-found") return { status: "not-found", listing: try listing(store) }
  const deletion = try parseStagedDeletion(PLUGIN, "deleteVoicemail", "voicemail", answer.deletion)
  try Ref.update(store.queued, (ids) => [...ids, row])
  return { status: "queued", deletion, listing: try listing(store) }
}

type VoicemailListener = Awaited<ReturnType<PhoneNativePlugin["addListener"]>>

interface VoicemailLease {
  active: boolean
  disablePending: boolean
  listener: VoicemailListener | undefined
}

interface VoicemailObservation {
  readonly lock: Semaphore.Semaphore
  lease: VoicemailLease | undefined
}

error VoicemailObservationActive { method: string }

// spec/os/android/voicemail.md, "A retired observer admits no refresh and a replacement waits for acknowledged cleanup"
effect function retireObservation(observer: VoicemailObservation, plugin: PhoneNativePlugin, lease: VoicemailLease) {
  if (observer.lease !== lease) return
  lease.active = false
  const disabled = lease.disablePending ? try Effect.result(nativeCall(PLUGIN, "observeVoicemail", () => plugin.observeVoicemail({ enabled: false }))) : undefined
  if (disabled !== undefined && Result.isSuccess(disabled)) lease.disablePending = false
  const listener = lease.listener
  const removed = listener === undefined ? undefined : try Effect.result(nativeCall(PLUGIN, "removeListener", () => listener.remove()))
  if (removed !== undefined && Result.isSuccess(removed)) lease.listener = undefined
  if (disabled !== undefined && Result.isFailure(disabled)) throw disabled.failure
  if (removed !== undefined && Result.isFailure(removed)) throw removed.failure
  observer.lease = undefined
}

effect function observe(store: Voicemails, observer: VoicemailObservation, plugin: PhoneNativePlugin, onChange: (refreshed: Promise<VoicemailListing>) => void) {
  return try observer.lock.withPermits(1)(effect {
    const previous = observer.lease
    if (previous?.active) throw new VoicemailObservationActive({ method: "observeVoicemail" })
    if (previous !== undefined) try retireObservation(observer, plugin, previous)
    const lease: VoicemailLease = { active: false, disablePending: false, listener: undefined }
    observer.lease = lease
    const changed = () => {
      if (!lease.active) return
      onChange(settled(store.lock.withPermits(1)(effect {
        if (!lease.active) return try listing(store)
        return try refresh(store, plugin, "AutomaticRead")
      })))
    }
    const handle = nativeCall(PLUGIN, "addListener", () => plugin.addListener("voicemailChanged", changed)) catch effect (failure) => {
      observer.lease = undefined
      throw failure
    }
    lease.listener = handle as VoicemailListener
    lease.disablePending = true
    nativeCall(PLUGIN, "observeVoicemail", () => plugin.observeVoicemail({ enabled: true })) catch effect (failure) => {
      try ignore(retireObservation(observer, plugin, lease))
      throw failure
    }
    lease.active = true
    return () => {
      lease.active = false
      return settled(observer.lock.withPermits(1)(retireObservation(observer, plugin, lease)))
    }
  })
}

export function phoneClient(plugin: PhoneNativePlugin = telephonyPlugin(), journal: ActionJournalPlugin = actionJournalPlugin()): PhoneClient {
  const store = Effect.runSync(held(journal))
  const serial = store.lock.withPermits(1)
  const observer: VoicemailObservation = { lock: Semaphore.makeUnsafe(1), lease: undefined }
  return {
    imageCapability: () => settled(checked("imageCapability", parseImageCapability, () => plugin.imageCapability())),
    status: () => settled(readStatus(plugin)),
    requestAccess: (access) => settled(checked("requestAccess", parseTelephonyStatus, () => plugin.requestAccess({ access }))),
    requestRole: (role) => settled(checked("requestRole", parseTelephonyStatus, () => plugin.requestRole({ role }))),
    recentCalls: (ask = {}) => settled(recentCalls(plugin, ask)),
    dial: (number) => settled(dial(plugin, number)),
    placeCall: (number) => settled(placeCall(plugin, number)),
    phoneInfo: () => settled(phoneInfo(plugin)),
    voicemail: () => settled(listing(store)),
    refreshVoicemail: (kind = "ExplicitRead") => settled(serial(refresh(store, plugin, kind))),
    fetchVoicemailAudio: (id) => settled(serial(fetchAudio(store, plugin, id))),
    voicemailAudio: (id) => settled(serial(audio(store, plugin, id))),
    voicemailPcm: (id) => settled(serial(pcm(store, plugin, id))),
    markVoicemailHeard: (id) => settled(serial(markHeard(store, plugin, id))),
    deleteVoicemail: (id) => settled(serial(stageDeletion(store, plugin, id))),
    observeVoicemail: (onChange) => settled(observe(store, observer, plugin, onChange)),
  }
}

export { maxCallLogPage as TELEPHONY_CALL_LOG_MAX, maxVoicemails as VOICEMAIL_MAX, maxWavBytes as VOICEMAIL_PCM_MAX_BYTES }
