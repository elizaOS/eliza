{
  "name": "@elizaos/capacitor-browser-surface",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Layers isolated native web surfaces (iOS WKWebView pool, Android out-of-process WebView) for the Browser view's third-party tabs.",
  "license": "MIT",
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@elizaos/os-bridges": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "capacitor": {
    "ios": {
      "src": "ios",
      "podName": "ElizaosCapacitorBrowserSurface"
    }
  },
  "files": [
    "dist",
    "ios/Sources",
    "*.podspec",
    "resources/read-page.js"
  ]
}
