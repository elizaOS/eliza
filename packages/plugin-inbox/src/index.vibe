// spec/inbox/managedRead.md, "Story: Read my managed inbox fresh, and only for me"; spec/inbox/handoff.md, "Story: Put the agent's words into an email draft without sending it"; spec/inbox/grants.md, "Story: Grant Gmail access one step at a time"
import type { AgentPlugin } from "@elizaos/agent"
import { inboxAccessProvider } from "./agent/access.vibe"
import { inboxComposeAction } from "./agent/compose.vibe"
import { inboxReadAction } from "./agent/read.vibe"

export { inboxAccess, inboxAccessProvider, inboxAccessProviderName } from "./agent/access.vibe"
export { emailDraftAnswer, inboxComposeAction, inboxComposeActionName, type EmailDraftHandoff } from "./agent/compose.vibe"
export { managedInboxRead, inboxReadAction, inboxReadActionName, type ManagedReadAnswer, type ManagedReadRequest } from "./agent/read.vibe"
export { agentGmailClient, cloudLinkTransport } from "./agent/cloud.vibe"

/** The inbox plugin's package name, which names the plugin in the bundle. */
export const inboxPluginName = "@elizaos/plugin-inbox"

/** The owner's mailbox for the agent: a fresh bounded read, a new email handed to the phone's composer, and the access state; it never sends or changes mail. */
export const inboxPlugin: AgentPlugin = {
  name: inboxPluginName,
  description: "Reads the owner's connected Gmail fresh and bounded, hands a new email to the phone's own composer, and reports Gmail access; sending and mailbox changes stay with the owner in Inbox",
  actions: [inboxReadAction, inboxComposeAction],
  providers: [inboxAccessProvider],
}

export default inboxPlugin
