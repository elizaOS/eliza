// spec/inbox/managedRead.md, "Only a bounded read is dispatched; any other request fails without a call"; spec/inbox/managedRead.md, "A read returns mail only for the current owner while permission holds"; spec/inbox/grants.md, "An approved change is prepared only under the capability it needs, and otherwise offers the upgrade"; spec/inbox/managedRead.md, "The agent reads managed mail through the device's broker when the host names one, and otherwise through its cloud link"
import { OWNER_EXCLUSIVE_DISCLOSURE_GATE, type Action, type ActionResult, type ContextDefinition, type IAgentRuntime, type Memory } from "@elizaos/core"
import { enabled, initial, machineOver, type Event, type ManagedInboxRead, type ManagedReadKind } from "../../gen/inbox__managedRead.effect.vibe"
import { type ManagedGmailClient, classifyGmailFailure, type GmailFailureKind, type MailFailure, type GmailMessage } from "@elizaos/plugin-inbox-client"
import { agentGmailClient, observeManagedReadGrant } from "./cloud.vibe"

export const inboxReadActionName = "INBOX_READ"

export const inboxContext: ContextDefinition = {
  id: "inbox", label: "Inbox", description: "The owner's connected Gmail.", descriptionCompressed: "The owner's Gmail.",
  sensitivity: "personal", cacheScope: "agent",
}

export interface ManagedReadRequest {
  readonly query?: string
  readonly limit?: number
  readonly account?: string
  readonly missedOnly?: boolean
}

export type ManagedReadAnswer =
  | { readonly kind: "mail"; readonly messages: readonly GmailMessage[] }
  | { readonly kind: "refused"; readonly reason: "missing-limit" | "account-override" | "missed-only" | "not-connected" | "several-accounts" | "owner-changed" }
  | { readonly kind: "failed"; readonly failure: GmailFailureKind }

function kindOf(request: ManagedReadRequest): ManagedReadKind {
  if (request.account !== undefined && request.account !== "") return "AccountOverrideRead"
  if (request.missedOnly === true) return "MissedOnlyRead"
  if (request.limit === undefined || !Number.isSafeInteger(request.limit) || request.limit < 1 || request.limit > 50) return "MissingLimitRead"
  return "BoundedRead"
}

const refusalOf = { MissingLimitRead: "missing-limit", AccountOverrideRead: "account-override", MissedOnlyRead: "missed-only" } as const
const refusalOfGrant = {
  NoReadableGrant: "not-connected",
  SeveralReadableGrants: "several-accounts",
  OneReadableGrant: "owner-changed",
} as const

export interface ManagedReadSession {
  step(event: Event): (ManagedInboxRead | undefined)!!
  state(): ManagedInboxRead!!
}

export effect function managedReadSession(): ManagedReadSession!! {
  const kept = try Ref.make(initial)
  const read = try machineOver(() => Ref.get(kept), (next) => Ref.set(kept, next))
  return {
    effect step(event) {
      if (!enabled(try read.get(), event)) return undefined
      return try orDie(read.send(event))
    },
    state: () => read.get(),
  }
}

export effect function managedInboxRead(client: ManagedGmailClient, request: ManagedReadRequest): ManagedReadAnswer!! {
  const read = try managedReadSession()
  const failed = (error: MailFailure): ManagedReadAnswer => ({ kind: "failed", failure: classifyGmailFailure(error, "read", true) })

  const kind = kindOf(request)
  if (kind !== "BoundedRead") {
    try read.step({ type: "beginRead", kind, grant: { tag: "NoReadableGrant" } })
    return { kind: "refused", reason: refusalOf[kind] }
  }
  const before = observeManagedReadGrant(client) catch (error) => error
  if ("_tag" in before) return failed(before)
  const admission = try read.step({ type: "beginRead", kind, grant: before.grant })
  if (admission?.phase !== "ReadPending") return { kind: "refused", reason: refusalOfGrant[before.grant.tag] }

  const search = request.query !== undefined && request.query.trim() !== "" ? request.query.trim() : "in:inbox"
  const size = (request.limit ?? 25) <= 10 ? 10 : (request.limit ?? 25) <= 25 ? 25 : 50
  const page = client.gmailSearch(admission.pendingGrant, search, size) catch (error) => error
  if ("_tag" in page) {
    try read.step({ type: "sourceFails" })
    return failed(page)
  }
  const after = observeManagedReadGrant(client) catch (error) => error
  if ("_tag" in after) {
    try read.step({ type: "sourceFails" })
    return failed(after)
  }
  const grant = after.grant
  const done = try read.step({ type: "receiveMail", grant })
  if (done?.phase !== "ReadDone") return { kind: "refused", reason: refusalOfGrant[grant.tag] }
  return { kind: "mail", messages: page.messages.slice(0, request.limit ?? page.messages.length) }
}

function parameters(options: unknown): ManagedReadRequest {
  const raw = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
  const given = typeof raw === "object" && raw !== null ? raw as Record<string, unknown> : {}
  return {
    ...(typeof given.query === "string" ? { query: given.query } : {}),
    ...(typeof given.limit === "number" ? { limit: given.limit } : typeof given.limit === "string" && /^\d+$/.test(given.limit) ? { limit: Number(given.limit) } : {}),
    ...(typeof given.account === "string" ? { account: given.account } : {}),
    ...(given.missedOnly === true ? { missedOnly: true } : {}),
  }
}

const refusalText = {
  "missing-limit": "Say how many messages to read, from 1 to 50.",
  "account-override": "Inbox reads use the Gmail account connected on this phone; another account cannot be named here.",
  "missed-only": "Missed-mail reads are not available. Search the Inbox instead.",
  "not-connected": "Gmail is not connected with read access. Connect Gmail in Inbox, then ask again.",
  "several-accounts": "More than one Gmail account has read access. Manage your Gmail connections in Inbox, then ask again.",
  "owner-changed": "The Gmail account changed while reading, so no mail is shown. Ask again to read the current account.",
} as const

const failureText: Record<GmailFailureKind, string> = {
  offline: "Gmail could not be reached. Try again when the phone is online.",
  revoked: "Gmail access needs authorization again. Reconnect Gmail in Inbox.",
  stale: "The mailbox changed while reading. Ask again.",
  gone: "That mail is no longer in Gmail.",
  unavailable: "Gmail is unavailable right now. Try again shortly.",
  refused: "That mail could not be read.",
  rejected: "Gmail refused this search. Try a simpler one.",
}

function line(message: GmailMessage): string {
  return `${message.unread ? "[unread] " : ""}${message.from} — ${message.subject || "(no subject)"} (${message.receivedAt}) [id ${message.id}]`
}

const toldOwner = (text: string): Pick<ActionResult, "userFacingText" | "verifiedUserFacing"> => ({ userFacingText: text, verifiedUserFacing: true })
const refusalUnread: Readonly<Record<keyof typeof refusalText, boolean>> = {
  "missing-limit": false, "account-override": false, "missed-only": false, "not-connected": true, "several-accounts": true, "owner-changed": true,
}

function resultOf(answer: ManagedReadAnswer): ActionResult {
  switch (answer.kind) {
    case "refused": {
      const text = refusalText[answer.reason]
      return { success: false, text, ...(refusalUnread[answer.reason] ? toldOwner(text) : {}), data: { refusal: answer.reason } }
    }
    case "failed": return { success: false, text: failureText[answer.failure], ...(answer.failure === "rejected" ? {} : toldOwner(failureText[answer.failure])), data: { failure: answer.failure } }
    case "mail": return {
      success: true,
      text: answer.messages.length === 0 ? "No messages match." : answer.messages.map(line).join("\n"),
      data: {
        messages: answer.messages.map((message) => ({
          id: message.id, threadId: message.threadId, from: message.from, subject: message.subject, snippet: message.snippet,
          receivedAt: message.receivedAt, unread: message.unread,
        })),
      },
    }
  }
}

async function handle(runtime: IAgentRuntime, _message: Memory, options: unknown): Promise<ActionResult> {
  const client = await runPromise(agentGmailClient(runtime))
  if (client === undefined) return { success: false, text: "Gmail is available only when this agent uses the cloud.", ...toldOwner("Gmail is available only when this agent uses the cloud."), data: { refusal: "no-cloud" } }
  return resultOf(await runPromise(managedInboxRead(client, parameters(options))))
}

export const inboxReadAction: Action = {
  name: inboxReadActionName,
  description: "Fresh bounded read/search of owner's connected Gmail (sender, subject, time, unread); connected account only. Read-only.",
  descriptionCompressed: "Bounded read/search of owner's connected Gmail.",
  similes: ["READ_EMAIL", "CHECK_EMAIL", "SEARCH_EMAIL", "LIST_INBOX"],
  toolSchemaStrict: true,
  cacheStable: true,
  parameters: [
    { name: "limit", required: true, schema: { type: "number" }, description: "Max messages (1-50)." },
    { name: "query", required: false, schema: { type: "string" }, description: "Gmail search (e.g. in:sent, is:unread, from:a@b.com); default in:inbox." },
  ],
  summarize: (result) => (result?.success ? "Read Gmail inbox messages." : undefined),
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  validate: async (runtime) => (await runPromise(agentGmailClient(runtime))) !== undefined,
  handler: async (runtime, message, _state, options) => handle(runtime, message, options),
}
