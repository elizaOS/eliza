// spec/inbox/managedRead.md, "The agent reads managed mail through the device's broker when the host names one, and otherwise through its cloud link"; spec/os/signIn/cloudRequests.md, "The agent gets the cloud's status and body, or a refusal naming why nothing was read, and never the credential that read it"
import { FetchHttpClient, HttpClient, HttpClientRequest, type HttpClientResponse } from "effect/http"
import { AttachmentRefused, MailProtocolFailed, MailUnreachable, type ManagedGmailTransport } from "@elizaos/plugin-inbox-client"

const brokerPath = "/__owner-gmail"
const brokerReplyLimit = 8_388_608
const brokerTimeout = "60 seconds"
const decodeJson = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Unknown))

export function brokerPrivate(endpoint: string, bearer: string): boolean {
  const url = URL.parse(endpoint)
  return url !== null && url.href === endpoint && url.protocol === "http:" && url.hostname === "127.0.0.1" && url.port !== "" && url.pathname === brokerPath
    && url.search === "" && url.hash === "" && url.username === "" && url.password === "" && /^[A-Za-z0-9_-]{64}$/.test(bearer)
}

function reasonOf(body: unknown): string {
  if (typeof body !== "object" || body === null) return ""
  if ("error" in body && typeof body.error === "string") return body.error
  return "reason" in body && typeof body.reason === "string" ? body.reason : ""
}

effect function boundedText(response: HttpClientResponse.HttpClientResponse): string!(MailProtocolFailed | MailUnreachable) {
  const chunks: Uint8Array[] = []
  let size = 0
  for try (const chunk of Stream.mapError(response.stream, (cause) => new MailUnreachable({ cause }))) {
    size += chunk.length
    if (size > brokerReplyLimit) break
    chunks.push(chunk)
  }
  if (size > brokerReplyLimit) throw new MailProtocolFailed({ code: "invalid-response", status: response.status, reason: "reply-too-large" })
  const bytes = new Uint8Array(size)
  chunks.reduce((offset, chunk) => { bytes.set(chunk, offset); return offset + chunk.length }, 0)
  return new TextDecoder().decode(bytes)
}

export function brokerTransport(endpoint: string, bearer: string, http: Layer.Layer<HttpClient.HttpClient>): ManagedGmailTransport {
  const authorization = Redacted.make("Bearer " + bearer)
  return {
    effect request(path, options) {
      if (options.body !== undefined) throw new MailProtocolFailed({ code: "http", status: 403, reason: "changes_off" })
      const exchange = effect {
        const request = HttpClientRequest.setHeader(HttpClientRequest.get(endpoint + path), "authorization", Redacted.value(authorization))
        const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "error" })
          catch effect (cause) => { throw new MailUnreachable({ cause }) }
        const decoded = decodeJson(try boundedText(response))
        const body = decoded._tag === "Some" ? decoded.value : undefined
        if (response.status === 503 && reasonOf(body) === "cloud-unreachable") throw new MailUnreachable({ cause: "the device could not reach the cloud" })
        if (response.status < 200 || response.status >= 300) throw new MailProtocolFailed({ code: "http", status: response.status, reason: reasonOf(body) })
        if (body === undefined) throw new MailProtocolFailed({ code: "invalid-response", status: response.status, reason: "" })
        return body
      }
      provide http {
        return try timeoutOrElse(exchange, { duration: brokerTimeout, orElse: () => fail(new MailUnreachable({ cause: "timeout" })) })
      }
    },
    reviewAttachment: effect () => { throw new AttachmentRefused({ detail: "The agent does not open attachment bytes" }) },
  }
}
