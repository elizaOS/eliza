// spec/inbox/managedRead.md, "Story: Read my managed inbox fresh, and only for me"; spec/inbox/failures.md, "A failure is classified by the client's own refusal first, then by being offline, then by Cloud's code and status"; spec/inbox/managedRead.md, "The agent reads managed mail through the device's broker when the host names one, and otherwise through its cloud link"
import { cloudServiceType, type CloudLinkService } from "@elizaos/agent-host"
import type { IAgentRuntime } from "@elizaos/core"
import { FetchHttpClient, type HttpClient } from "effect/http"
import { chooseManagedReadGrant, mailReaderOf, type ManagedReadGrant } from "../../gen/inbox__managedRead.effect.vibe"
import {
  managedGmailClient, type ManagedGmailClient, type ManagedGmailTransport, AttachmentRefused, MailProtocolFailed, MailUnreachable, type MailFailure, gmailGrantTier, gmailReadable, type GmailGrantTier,
} from "@elizaos/plugin-inbox-client"
import { brokerPrivate, brokerTransport, refusalCode } from "./broker.vibe"

function cloudLinkOf(runtime: IAgentRuntime): CloudLinkService | undefined {
  const found = runtime.getService<CloudLinkService>(cloudServiceType)
  return found === null || typeof found.request !== "function" ? undefined : found
}

export function cloudLinkTransport(link: CloudLinkService): ManagedGmailTransport {
  return {
    effect request(path, options) {
      const reply = try tryPromise({
        try: (signal) => link.request({ method: options.body === undefined ? "GET" : "POST", path, ...(options.body === undefined ? {} : { body: options.body }), signal }),
        catch: (cause) => new MailUnreachable({ cause }),
      })
      switch (reply.kind) {
        case "answered": return reply.body
        case "refused": throw new MailProtocolFailed({ code: "http", status: reply.status, reason: refusalCode(reply.body) })
        case "changes-off": throw new MailProtocolFailed({ code: "http", status: 403, reason: "changes_off" })
      }
    },
    reviewAttachment: effect () => { throw new AttachmentRefused({ detail: "The agent does not open attachment bytes" }) },
  }
}

export function gmailTransportOf(endpoint: string, bearer: string, http: Layer.Layer<HttpClient.HttpClient>, link: CloudLinkService | undefined): ManagedGmailTransport | undefined {
  switch (mailReaderOf(endpoint !== "", brokerPrivate(endpoint, bearer), link !== undefined)) {
    case "DeviceBroker": return brokerTransport(endpoint, bearer, http)
    case "CloudLink": return link === undefined ? undefined : cloudLinkTransport(link)
    case "NotOffered": return undefined
  }
}

export effect function agentGmailClient(runtime: IAgentRuntime): (ManagedGmailClient | undefined)!! {
  const endpoint = try orDie(Config.withDefault(Config.String("ELIZA_MANAGED_GMAIL_READ_BROKER"), ""))
  const bearer = try orDie(Config.withDefault(Config.String("ELIZA_MANAGED_GMAIL_READ_BROKER_TOKEN"), ""))
  const transport = gmailTransportOf(endpoint, bearer, FetchHttpClient.layer, cloudLinkOf(runtime))
  return transport === undefined ? undefined : managedGmailClient(transport)
}

export effect function observeManagedReadGrant(client: ManagedGmailClient): { readonly grant: ManagedReadGrant; readonly tier: GmailGrantTier }!MailFailure {
  const readable = (try client.gmailAccounts()).filter(gmailReadable)
  const grant = chooseManagedReadGrant(readable.map((account) => account.connectionId))
  return { grant, tier: gmailGrantTier(grant.tag === "OneReadableGrant" ? readable[0] : undefined) }
}
