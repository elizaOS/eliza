// spec/inbox/grants.md, "An approved change is prepared only under the capability it needs, and otherwise offers the upgrade"; spec/inbox/grants.md, "Read is asked for first, changes are one consent, and a reconnect keeps what the account holds"
import { OWNER_EXCLUSIVE_DISCLOSURE_GATE, type IAgentRuntime, type Provider, type ProviderResult } from "@elizaos/core"
import { gmailGrantTier, type GmailGrantTier } from "../mailbox/grants.vibe"
import { agentGmailClient } from "./cloud.vibe"
import { managedAccount, type ManagedAccount } from "./read.vibe"

/** The provider name of the owner's Gmail access state. */
export const inboxAccessProviderName = "INBOX_ACCESS"

const tierText = {
  none: "Gmail is not connected with read access; reading mail needs connecting Gmail in Inbox first.",
  readonly: "Gmail is connected with read access. Sending and mailbox changes are made by the owner in Inbox.",
  modify: "Gmail is connected with read and change access. Sending and mailbox changes are still reviewed and confirmed by the owner in Inbox.",
} as const satisfies Record<GmailGrantTier, string>

/** The owner's Gmail access state, with no mail content. */
export effect function inboxAccess(runtime: IAgentRuntime): ProviderResult!! {
  const client = agentGmailClient(runtime)
  if (client === undefined) return { text: "Gmail is available only when this agent uses the cloud.", values: { gmailTier: "none" } }
  const found: ManagedAccount | null = managedAccount(client) catch () => null
  if (found === null) return { text: "Gmail access could not be checked right now.", values: { gmailTier: "unknown" } }
  if (found.kind === "several") return { text: "Several Gmail accounts are connected, so the agent reads none of them; the owner reads and changes mail in Inbox.", values: { gmailTier: "several" } }
  const tier = gmailGrantTier(found.kind === "one" ? found.account : null)
  return { text: tierText[tier], values: { gmailTier: tier } }
}

/** Tells the planner whether the owner's Gmail can be read, without any mail content. */
export const inboxAccessProvider: Provider = {
  name: inboxAccessProviderName,
  description: "Whether the owner's Gmail is connected for reading, and that sends and changes happen only in Inbox",
  dynamic: true,
  cacheStable: false,
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  get: async (runtime) => runPromise(inboxAccess(runtime)),
}
