// spec/inbox/managedRead.md, "The agent reads managed mail through the device's broker when the host names one, and otherwise through its cloud link"; spec/inbox/grants.md, "An approved change is prepared only under the capability it needs, and otherwise offers the upgrade"; spec/inbox/grants.md, "Read is asked for first, changes are one consent, and a reconnect keeps what the account holds"
import { OWNER_EXCLUSIVE_DISCLOSURE_GATE, type IAgentRuntime, type Provider, type ProviderResult } from "@elizaos/core"
import { gmailGrantTier, type GmailGrantTier } from "../mailbox/grants.vibe"
import type { GoogleConnection } from "../mailbox/types.vibe"
import { agentGmailReads } from "./broker.vibe"

export const inboxAccessProviderName = "INBOX_ACCESS"

const tierText = {
  none: "Gmail is not connected with read access; reading mail needs connecting Gmail in Inbox first.",
  readonly: "Gmail is connected with read access. Sending and mailbox changes are made by the owner in Inbox.",
  modify: "Gmail is connected with read and change access. Sending and mailbox changes are still reviewed and confirmed by the owner in Inbox.",
} as const satisfies Record<GmailGrantTier, string>

export effect function inboxAccess(runtime: IAgentRuntime) {
  const reads = try agentGmailReads(runtime)
  if (reads === undefined) {
    const notOffered: ProviderResult = { text: "Gmail is available only when this agent uses the cloud.", values: { gmailTier: "none" } }
    return notOffered
  }
  const status: GoogleConnection | null = reads.gmailStatus() catch () => null
  if (status === null) return { text: "Gmail access could not be checked right now.", values: { gmailTier: "unknown" } }
  const tier = gmailGrantTier({ ...status, label: "" })
  return { text: tierText[tier], values: { gmailTier: tier } }
}

export const inboxAccessProvider: Provider = {
  name: inboxAccessProviderName,
  description: "Whether the owner's Gmail is connected for reading, and that sends and changes happen only in Inbox",
  dynamic: true,
  cacheStable: false,
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  get: async (runtime) => runPromise(inboxAccess(runtime)),
}
