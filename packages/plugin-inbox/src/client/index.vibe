// spec/inbox/reads.md, "Pages keep their first read's identity and expose mailbox shifts"; spec/inbox/drafts.md, "Recovery reads the recorded request and cannot resend it"; spec/inbox/outgoing.md, "A saved attachment of any type is a checked byte copy, never opened"; spec/inbox/display.md, "Only an absolute web link without credentials is kept, and its shown text is plain"
import { reviewOpaqueAttachment, type MailAttachmentReviewer, type OpaqueMailAttachment, type ReviewedMailAttachment } from "../mailbox/attachments.vibe"
import { utf8Length } from "../mailbox/digest.vibe"
import { MailProtocolFailed, type MailFailure, type MailUnreachable } from "../mailbox/failures.vibe"
import { linkifyMailText } from "../mailbox/links.vibe"
import type {
  GmailAccount, GmailDraftContent, GmailDraftSummary, GmailInboxCapabilities, GmailInboxOperationKind, GmailInboxReceipt, GmailMessage,
  GmailReadResult, GmailSearchPage, GmailThreadPage, GoogleConnection,
} from "../mailbox/types.vibe"
import {
  AccountsWire, AttachmentWire, CapabilitiesWire, ConnectionWire, ConnectWire, DisconnectWire, DraftsWire, DraftWire, type MailCardWire, MessageWire,
  OperationWire, SearchWire, ThreadWire,
} from "./wire.schema.vibe"

export interface ManagedGmailTransport {
  request(path: string, options: { readonly body?: unknown; readonly timeoutMs?: number }): unknown!(MailProtocolFailed | MailUnreachable)
  readonly reviewAttachment: MailAttachmentReviewer
}

export type SearchSize = 10 | 25 | 50 | 100

const google = "/api/v1/eliza/google"
const inbox = `${google}/gmail/inbox-v1`
const dispatchTimeoutMs = 45_000
const maxLinks = 50
const maxHtmlBytes = 512 * 1024
const sha = /^[a-f0-9]{64}$/
const revision = /^\d{1,20}$/
const labelKinds: readonly GmailInboxOperationKind[] = ["archive", "unarchive", "trash", "untrash"]

const invalid = () => new MailProtocolFailed({ code: "invalid-response", status: 0, reason: "" })

effect function decoded<A, I>(schema: Schema.Codec<A, I>, value: unknown): A!MailProtocolFailed {
  return Schema.decodeUnknownEffect(schema)(value) catch effect () => { throw invalid() }
}

effect function present(value: string): string!MailProtocolFailed {
  if (value.trim() === "") throw invalid()
  return value
}

function query(entries: Readonly<Record<string, string | undefined>>): string {
  return new URLSearchParams(Object.entries(entries).flatMap(([name, value]) => value === undefined ? [] : [[name, value]])).toString()
}

function senderEmail(from: string): string | null {
  const candidate = (/<([^<>]+)>\s*$/.exec(from)?.[1] ?? from).trim()
  return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(candidate) ? candidate.toLowerCase() : null
}

effect function messageOf(card: typeof MailCardWire.Type): GmailMessage!MailProtocolFailed {
  return {
    id: try present(card.id),
    threadId: try present(card.threadId),
    subject: card.subject,
    from: card.from,
    fromEmail: senderEmail(card.from),
    to: card.to,
    cc: card.cc,
    snippet: card.snippet,
    receivedAt: try present(card.receivedAt),
    unread: card.isUnread,
    starred: card.labels.includes("STARRED"),
    historyId: card.metadata.historyId,
  }
}

function connectionOf(row: typeof ConnectionWire.Type): GoogleConnection {
  return { configured: row.configured, connected: row.connected, reason: row.reason, connectionId: row.connectionId, grantedCapabilities: row.grantedCapabilities }
}

function accountOf(row: typeof ConnectionWire.Type): GmailAccount {
  return { ...connectionOf(row), label: row.identity?.email || row.identity?.name || "Google account" }
}

effect function readOf(value: typeof MessageWire.Type, historyId: string | null): GmailReadResult!MailProtocolFailed {
  const links = linkifyMailText(value.bodyText)
  const html = value.bodyHtml
  const shownHtml = html !== null && value.bodyHtmlStatus === "available" && utf8Length(html) <= maxHtmlBytes ? html : undefined
  return {
    message: try messageOf(value.message),
    bodyText: value.bodyText,
    ...(shownHtml === undefined ? {} : { bodyHtml: shownHtml }),
    ...(shownHtml === undefined && (value.bodyHtmlStatus === "too_large" || html !== null) ? { bodyHtmlOmitted: true } : {}),
    links: links.slice(0, maxLinks),
    ...(links.length > maxLinks ? { omittedLinks: links.length - maxLinks } : {}),
    historyId,
    attachments: value.attachments.map((row) => ({ ...row })),
    authenticationResults: value.authenticationResults ?? null,
  }
}

effect function receiptOf(value: typeof OperationWire.Type, requestId: string): GmailInboxReceipt!MailProtocolFailed {
  const receipt = value.receipt
  if (receipt.requestId !== requestId || !sha.test(receipt.reviewDigest) || (receipt.state === "succeeded") !== (receipt.providerResult !== null)) throw invalid()
  return {
    requestId,
    kind: receipt.kind,
    reviewDigest: receipt.reviewDigest,
    state: receipt.state,
    providerResult: receipt.providerResult,
    rejectionCode: receipt.rejectionCode,
  }
}

function capabilitiesOf(value: typeof CapabilitiesWire.Type): GmailInboxCapabilities {
  const kinds = value.kinds
  const has = (...wanted: readonly GmailInboxOperationKind[]) => wanted.every((kind) => kinds.includes(kind))
  const providerDrafts = has("draft-create", "draft-replace", "draft-delete")
  const maximumBytes = Math.max(0, value.attachmentPolicy.maxBytes)
  return {
    version: 1,
    from: value.from,
    kinds,
    threads: true,
    send: has("send"),
    providerDrafts,
    mailboxMutations: has(...labelKinds),
    attachments: maximumBytes > 0,
    providerExactlyOnce: false,
    atomicDraftReplacement: false,
    readState: has("mark-read", "mark-unread"),
    stars: has("star", "unstar"),
    draftsList: providerDrafts,
    forwardAttachments: has("send") || providerDrafts,
    searchTrash: true,
    opaqueAttachments: maximumBytes > 0,
    attachmentPolicy: { maximumOutgoing: 10, maximumBytes, maximumTotalBytes: maximumBytes, mimeTypes: value.attachmentPolicy.mimeTypes },
  }
}

effect function nextToken(next: string | null, asked: string | undefined): (string | null)!MailProtocolFailed {
  if (next !== null && (next === "" || next.length > 4096 || next === asked)) throw invalid()
  return next
}

effect function pageToken(token: string | undefined): void!MailProtocolFailed {
  if (token !== undefined && (token === "" || token.length > 4096)) throw invalid()
}

export function managedGmailClient(transport: ManagedGmailTransport) {
  effect function call(path: string, options: { readonly body?: unknown; readonly timeoutMs?: number } = {}) {
    return try transport.request(path, options)
  }

  effect function operation(path: string, requestId: string, body?: unknown, timeoutMs?: number) {
    const value = try decoded(OperationWire, try call(path, { ...(body === undefined ? {} : { body }), ...(timeoutMs === undefined ? {} : { timeoutMs }) }))
    return { value, receipt: try receiptOf(value, requestId) }
  }

  return {
    effect gmailAccounts(): GmailAccount[]!MailFailure {
      return (try decoded(AccountsWire, try call(`${google}/accounts?${query({ side: "owner" })}`))).map(accountOf)
    },

    effect gmailStatus(grantId?: string): GoogleConnection!MailFailure {
      return connectionOf(try decoded(ConnectionWire, try call(`${google}/status?${query({ side: "owner", grantId })}`)))
    },

    effect gmailConnect(capabilities: readonly string[], redirectUrl?: string): { readonly authUrl: string }!MailFailure {
      return try decoded(ConnectWire, try call(`${google}/connect/initiate`, { body: { capabilities, ...(redirectUrl === undefined ? {} : { redirectUrl }) } }))
    },

    effect disconnectGmail(connectionId: string): void!MailFailure {
      try decoded(DisconnectWire, try call(`${google}/disconnect`, { body: { side: "owner", connectionId: try present(connectionId) } }))
    },

    effect gmailSearch(grantId: string, search: string, maxResults: SearchSize = 25, token?: string): GmailSearchPage!MailFailure {
      try pageToken(token)
      const page = try decoded(SearchWire, try call(`${google}/gmail/search?${query({ side: "owner", grantId: try present(grantId), query: try present(search), maxResults: String(maxResults), pageToken: token })}`))
      if (!revision.test(page.mailboxHistoryId) || page.messages.length > maxResults) throw invalid()
      const messages: GmailMessage[] = []
      for (const card of page.messages) messages.push(try messageOf(card))
      return { messages, syncedAt: try present(page.syncedAt), nextPageToken: try nextToken(page.nextPageToken, token), mailboxHistoryId: page.mailboxHistoryId, supportsSpamTrash: page.supportsSpamTrash }
    },

    effect gmailRead(grantId: string, messageId: string): GmailReadResult!MailFailure {
      const value = try decoded(MessageWire, try call(`${google}/gmail/read?${query({ side: "owner", grantId: try present(grantId), messageId: try present(messageId) })}`))
      if (value.message.id !== messageId) throw invalid()
      return try readOf(value, value.message.metadata.historyId)
    },

    effect gmailInboxCapabilities(grantId: string): GmailInboxCapabilities!MailFailure {
      const value = try decoded(CapabilitiesWire, try call(`${inbox}/capabilities?${query({ grantId: try present(grantId) })}`))
      try present(value.from)
      return capabilitiesOf(value)
    },

    effect gmailThread(grantId: string, threadId: string, cursor?: { readonly offset: number; readonly historyId: string }): GmailThreadPage!MailFailure {
      const value = try decoded(ThreadWire, try call(`${inbox}/thread?${query({
        grantId, threadId, offset: cursor === undefined ? undefined : String(cursor.offset), historyId: cursor?.historyId,
      })}`))
      const offset = cursor?.offset ?? 0
      if (value.threadId !== threadId || value.messages.length > 25 || !Number.isSafeInteger(value.total) || value.offset !== offset ||
        value.total < offset + value.messages.length || value.total > 2000 ||
        value.nextOffset !== (offset + value.messages.length < value.total ? offset + value.messages.length : null) ||
        (cursor !== undefined && cursor.historyId !== value.historyId) || !revision.test(value.historyId)) throw invalid()
      const messages: GmailReadResult[] = []
      for (const row of value.messages) {
        if (row.message.threadId !== threadId) throw invalid()
        messages.push(try readOf(row, row.historyId))
      }
      return { messages, total: value.total, offset, historyId: value.historyId, nextOffset: value.nextOffset }
    },

    effect gmailAttachment(grantId: string, messageId: string, partId: string, historyId: string): (ReviewedMailAttachment & { readonly dataBase64: string })!MailFailure {
      const value = try decoded(AttachmentWire, try call(`${inbox}/attachment?${query({ grantId, messageId, partId, historyId })}`))
      if (value.messageId !== messageId || value.partId !== partId || value.historyId !== historyId) throw invalid()
      const checked = try transport.reviewAttachment({ name: try present(value.name), mimeType: value.mimeType, dataBase64: try present(value.dataBase64) })
      if (checked.sha256 !== value.sha256 || checked.size !== value.size) throw invalid()
      return { ...checked, dataBase64: value.dataBase64 }
    },

    effect gmailOpaqueAttachment(grantId: string, messageId: string, partId: string, historyId: string): OpaqueMailAttachment!MailFailure {
      const value = try decoded(AttachmentWire, try call(`${inbox}/attachment?${query({ grantId, messageId, partId, historyId })}`))
      if (value.messageId !== messageId || value.partId !== partId || value.historyId !== historyId) throw invalid()
      const checked = reviewOpaqueAttachment({ name: value.name, mimeType: value.mimeType, dataBase64: value.dataBase64 }) catch effect () => { throw invalid() }
      if (checked.sha256 !== value.sha256 || checked.size !== value.size) throw invalid()
      return checked
    },

    effect gmailDrafts(grantId: string, token?: string): { readonly drafts: readonly GmailDraftSummary[]; readonly nextPageToken: string | null }!MailFailure {
      try pageToken(token)
      const value = try decoded(DraftsWire, try call(`${inbox}/drafts?${query({ grantId, pageToken: token })}`))
      if (value.drafts.length > 50) throw invalid()
      const drafts: GmailDraftSummary[] = []
      for (const draft of value.drafts) drafts.push({ ...draft, draftId: try present(draft.draftId), messageId: try present(draft.messageId) })
      return { drafts, nextPageToken: try nextToken(value.nextPageToken, token) }
    },

    effect gmailDraftContent(grantId: string, draftId: string): GmailDraftContent!MailFailure {
      const value = try decoded(DraftWire, try call(`${inbox}/draft?${query({ grantId, draftId })}`))
      const content = value.content
      if (value.id !== draftId || !sha.test(value.providerDigest) || [content.to, content.cc, content.bcc].some((list) => list.length > 50) ||
        !Number.isSafeInteger(content.attachmentCount) || content.attachmentCount < 0) throw invalid()
      return {
        draftId, messageId: try present(value.messageId), providerDigest: value.providerDigest, to: content.to, cc: content.cc, bcc: content.bcc,
        subject: content.subject, bodyText: content.bodyText, threaded: content.threaded, attachmentCount: content.attachmentCount, plainText: content.plainText,
      }
    },

    effect gmailPrepareOperation(grantId: string, requestId: string, proposal: Readonly<Record<string, unknown>>): { readonly receipt: GmailInboxReceipt; readonly review: Readonly<Record<string, unknown>> }!MailFailure {
      const { value, receipt } = try operation(`${inbox}/operations`, requestId, { grantId, requestId, proposal })
      if (value.review === undefined) throw invalid()
      return { receipt, review: value.review }
    },

    effect gmailDispatchOperation(grantId: string, requestId: string, reviewDigest: string, proposal: Readonly<Record<string, unknown>>): GmailInboxReceipt!MailFailure {
      return (try operation(`${inbox}/operations/${encodeURIComponent(requestId)}/dispatch`, requestId, { grantId, reviewDigest, proposal }, dispatchTimeoutMs)).receipt
    },

    effect gmailOperation(grantId: string, requestId: string): GmailInboxReceipt!MailFailure {
      return (try operation(`${inbox}/operations/${encodeURIComponent(requestId)}?${query({ grantId })}`, requestId)).receipt
    },
  }
}

export type ManagedGmailClient = ReturnType<typeof managedGmailClient>
