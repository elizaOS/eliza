// spec/inbox/display.md, "Only an absolute web link without credentials is kept, and its shown text is plain"
import { linkKept, linksOmitted, linksShown, textMismatch } from "../../gen/inbox__display.effect.vibe"
import type { GmailLink } from "./types.vibe"

// eslint-disable-next-line no-control-regex -- Displayed link labels replace each consecutive run of C0 controls and DEL.
const controls = /[\x00-\x1f\x7f]+/g
const closing = ".,;:!?)]}>"

export function safeMailLink(value: unknown): GmailLink | null {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return null
  const href = "href" in value ? value.href : undefined
  const text = "text" in value ? value.text : undefined
  if (typeof href !== "string" || typeof text !== "string") return null
  const url = URL.parse(href)
  const kept = linkKept({
    units: href.length,
    absolute: url !== null,
    webScheme: url !== null && (url.protocol === "https:" || url.protocol === "http:"),
    hasHost: url !== null && url.hostname !== "",
    hasCredentials: url !== null && (url.username !== "" || url.password !== ""),
  })
  if (!kept || url === null) return null
  const shown = text.replace(controls, " ").replace(/\s+/g, " ").trim().slice(0, 200)
  return { href: url.href, text: shown === "" ? url.hostname : shown }
}

function trimmed(raw: string): string {
  let open = 0
  let close = 0
  for (const char of raw) {
    if (char === "(") open++
    else if (char === ")") close++
  }
  let end = raw.length
  while (end > 0 && closing.includes(raw[end - 1] ?? "")) {
    if (raw[end - 1] === ")") {
      if (open >= close) break
      close--
    }
    end--
  }
  return raw.slice(0, end)
}

export function linkifyMailText(text: string): { readonly links: GmailLink[]; readonly omitted: number } {
  const links: GmailLink[] = []
  const seen = new Set<string>()
  for (const match of text.matchAll(/https:\/\/[^\s<>"'`]+/gi)) {
    const raw = trimmed(match[0])
    const link = safeMailLink({ href: raw, text: raw })
    if (link === null || seen.has(link.href)) continue
    seen.add(link.href)
    if (links.length < linksShown(seen.size)) links.push(link)
  }
  return { links, omitted: linksOmitted(seen.size) }
}

export function linkTextMismatch(link: GmailLink): boolean {
  const url = URL.parse(link.href)
  if (url === null) return true
  const host = url.hostname.toLowerCase().replace(/^www\./, "")
  const named = /(?:https?:\/\/)?((?:[a-z0-9-]+\.)+[a-z]{2,63})(?=[/:\s.,;!?)\]'"]|$)/.exec(link.text.toLowerCase())
  const shown = named?.[1]?.replace(/^www\./, "")
  return textMismatch(shown !== undefined, shown === host || (shown !== undefined && host.endsWith(`.${shown}`)))
}
