// spec/inbox/outgoing.md, "Outgoing attachments fit both the account's policy and the shared limits"; spec/inbox/outgoing.md, "A saved attachment of any type is a checked byte copy, never opened"
import { encodedBytes, maximumFiles, maximumTotalBytes, opaqueAdmitted, outgoingCheck, type OutgoingCheck } from "../../gen/inbox__outgoing.effect.vibe"
import { sha256Bytes } from "./digest.vibe"
import { AttachmentRefused } from "./failures.vibe"

module browser {
  /** @throws {never} */
  export function canonicalBytes(dataBase64: string): Uint8Array<ArrayBuffer> | undefined {
    try {
      const raw = atob(dataBase64)
      if (btoa(raw) !== dataBase64) return undefined
      return Uint8Array.from(raw, (char) => char.charCodeAt(0))
    } catch {
      return undefined
    }
  }
}
import { canonicalBytes } from browser

export interface OutgoingMailAttachment {
  readonly name: string
  readonly mimeType: string
  readonly dataBase64: string
}

export interface ReviewedMailAttachment {
  readonly name: string
  readonly mimeType: string
  readonly size: number
  readonly sha256: string
  readonly text?: string
}

export type MailAttachmentReviewer = (file: OutgoingMailAttachment) => ReviewedMailAttachment!AttachmentRefused

export interface OpaqueMailAttachment {
  readonly name: string
  readonly mimeType: string
  readonly dataBase64: string
  readonly size: number
  readonly sha256: string
  readonly opaque: true
}

export interface OutgoingPolicy {
  readonly maximumOutgoing: number
  readonly maximumTotalBytes: number
}

export const outgoingAttachmentLimits = { maximumFiles, maximumTotalBytes } as const

export error OutgoingAttachmentsRefused { check: Exclude<OutgoingCheck, "OutgoingFits">; maximumFiles: number; maximumBytes: number }

export function attachmentBytes(file: { readonly dataBase64: string }): number {
  const padding = file.dataBase64.endsWith("==") ? 2 : file.dataBase64.endsWith("=") ? 1 : 0
  return encodedBytes(file.dataBase64.length, padding)
}

export effect function checkOutgoingAttachments(
  files: readonly { readonly name: string; readonly dataBase64: string }[],
  policy: OutgoingPolicy = { maximumOutgoing: maximumFiles, maximumTotalBytes },
  forwarded: readonly { readonly name: string; readonly size: number }[] = [],
): void!OutgoingAttachmentsRefused {
  const names = [...files, ...forwarded].map((file) => file.name.toLowerCase())
  const total = files.reduce((sum, file) => sum + attachmentBytes(file), 0) + forwarded.reduce((sum, file) => sum + file.size, 0)
  const check = outgoingCheck(files.length, new Set(names).size === names.length, total, policy.maximumOutgoing, policy.maximumTotalBytes)
  if (check !== "OutgoingFits") {
    throw new OutgoingAttachmentsRefused({
      check,
      maximumFiles: Math.min(policy.maximumOutgoing, maximumFiles),
      maximumBytes: Math.min(policy.maximumTotalBytes, maximumTotalBytes),
    })
  }
}

// eslint-disable-next-line no-control-regex -- Attachment file names reject path separators, C0 controls, and DEL.
const unsafeName = /[\\/\x00-\x1f\x7f]/
const mediaType = /^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}\/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$/i

export effect function reviewOpaqueAttachment(file: OutgoingMailAttachment): OpaqueMailAttachment!AttachmentRefused {
  const name = typeof file.name === "string" ? file.name : ""
  const data = typeof file.dataBase64 === "string" ? file.dataBase64 : ""
  const bytes = data.length <= 7 * 1024 * 1024 ? canonicalBytes(data) : undefined
  const admitted = opaqueAdmitted({
    nameLength: name.length,
    nameSafe: name.trim() !== "" && name !== "." && name !== ".." && !unsafeName.test(name),
    canonical: bytes !== undefined,
    encodedLength: data.length,
    decodedBytes: bytes?.length ?? 0,
  })
  if (!admitted || bytes === undefined) throw new AttachmentRefused({ detail: bytes !== undefined && bytes.length > 5 * 1024 * 1024 ? "Attachment exceeds 5 MiB" : "Invalid attachment name or encoding" })
  return {
    name,
    mimeType: typeof file.mimeType === "string" && mediaType.test(file.mimeType) ? file.mimeType.toLowerCase() : "application/octet-stream",
    dataBase64: data,
    size: bytes.length,
    sha256: try sha256Bytes(bytes),
    opaque: true,
  }
}
