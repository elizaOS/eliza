// spec/inbox/reads.md, "Story: Read my mailbox without mixing account pages or endlessly reusing a cursor"; spec/inbox/grants.md, "Story: Grant Gmail access one step at a time"

/** One owner-side Google connection as Cloud reports it. */
export interface GoogleConnection {
  readonly configured: boolean
  readonly connected: boolean
  readonly reason: string
  readonly connectionId: string | null
  readonly grantedCapabilities: readonly string[]
}

/** A Google connection with the label shown for its mailbox. */
export interface GmailAccount extends GoogleConnection {
  readonly label: string
}

/** Every reviewed mailbox effect the inbox-v1 operation routes accept. */
export type GmailInboxOperationKind =
  | "send" | "draft-create" | "draft-replace" | "draft-delete" | "archive" | "unarchive"
  | "trash" | "untrash" | "mark-read" | "mark-unread" | "star" | "unstar"

/** An approved mailbox change and the Cloud capability family it needs. */
export type GmailMailboxAction = GmailInboxOperationKind

/** The receipt states Cloud reports for one reviewed operation. */
export type GmailInboxReceiptState = "prepared" | "dispatched" | "succeeded" | "rejected" | "outcome-unknown"

/** Per-account managed inbox capabilities, derived from the kinds Cloud reports for the grant. */
export interface GmailInboxCapabilities {
  readonly version: 1
  readonly from: string
  readonly kinds: readonly GmailInboxOperationKind[]
  readonly threads: boolean
  readonly send: boolean
  readonly providerDrafts: boolean
  readonly mailboxMutations: boolean
  readonly attachments: boolean
  readonly providerExactlyOnce: false
  readonly atomicDraftReplacement: false
  readonly readState: boolean
  readonly stars: boolean
  readonly draftsList: boolean
  readonly forwardAttachments: boolean
  readonly searchTrash: boolean
  readonly opaqueAttachments: boolean
  readonly attachmentPolicy: { readonly maximumOutgoing: number; readonly maximumBytes: number; readonly maximumTotalBytes: number; readonly mimeTypes: readonly string[] }
}

/** A link found in mail: inert data, never fetched or rendered as HTML. */
export interface GmailLink {
  readonly href: string
  readonly text: string
}

/** One provider draft in a drafts page, metadata only. */
export interface GmailDraftSummary {
  readonly draftId: string
  readonly messageId: string
  readonly subject: string
  readonly to: readonly string[]
  readonly snippet: string
  readonly updatedAt: string | null
}

/** Exact provider draft content and its raw-MIME digest from one snapshot. */
export interface GmailDraftContent {
  readonly draftId: string
  readonly messageId: string
  readonly providerDigest: string
  readonly to: readonly string[]
  readonly cc: readonly string[]
  readonly bcc: readonly string[]
  readonly subject: string
  readonly bodyText: string
  readonly threaded: boolean
  readonly attachmentCount: number
  readonly plainText: boolean
}

/** Canonical Cloud receipt for one reviewed operation; `succeeded` always carries a provider result. */
export interface GmailInboxReceipt {
  readonly requestId: string
  readonly kind: GmailInboxOperationKind
  readonly reviewDigest: string
  readonly state: GmailInboxReceiptState
  readonly providerResult: Readonly<Record<string, unknown>> | null
  readonly rejectionCode: string | null
}

/** One listed message. */
export interface GmailMessage {
  readonly id: string
  readonly threadId: string
  readonly subject: string
  readonly from: string
  readonly fromEmail: string | null
  readonly to: readonly string[]
  readonly cc: readonly string[]
  readonly snippet: string
  readonly receivedAt: string
  readonly unread: boolean
  readonly starred: boolean
  readonly historyId: string | null
}

/** Attachment metadata of a read message; bytes are fetched separately and reviewed. */
export interface GmailMessageAttachment {
  readonly partId: string
  readonly name: string
  readonly mimeType: string
  readonly size: number
  readonly supported: boolean
}

/** One message body read; `historyId` binds later attachment reads and reviewed changes. */
export interface GmailReadResult {
  readonly message: GmailMessage
  readonly bodyText: string
  readonly bodyHtml?: string
  readonly bodyHtmlOmitted?: true
  readonly links: readonly GmailLink[]
  readonly omittedLinks?: number
  readonly historyId: string | null
  readonly attachments: readonly GmailMessageAttachment[]
  readonly authenticationResults: string | null
}

/** One search page; two pages of one search with different `mailboxHistoryId` came from a changed mailbox. */
export interface GmailSearchPage {
  readonly messages: readonly GmailMessage[]
  readonly syncedAt: string
  readonly nextPageToken: string | null
  readonly mailboxHistoryId: string
  readonly supportsSpamTrash: boolean
}

/** One bounded thread page, pinned to the thread revision of its first page. */
export interface GmailThreadPage {
  readonly messages: readonly GmailReadResult[]
  readonly total: number
  readonly offset: number
  readonly historyId: string
  readonly nextOffset: number | null
}
