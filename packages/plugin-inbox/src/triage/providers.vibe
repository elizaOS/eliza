// spec/inbox/triage.md, "Story: Triage my unified cross-channel inbox and safely manage subscriptions"
import {
  OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  type IAgentRuntime,
  type Memory,
  type Provider,
  type ProviderResult,
  type State,
} from "@elizaos/core"
import { INBOX_TRIAGE_SERVICE_TYPE, type InboxTriageService } from "./service.vibe"

const EMPTY_TRIAGE: ProviderResult = {
  text: "",
  values: { inboxUnresolved: 0, inboxUrgent: 0 },
  data: {},
}

export const inboxTriageProvider: Provider = {
  name: "inboxTriage",
  description: "Pending cross-channel inbox triage items with priority counts, snippets, deep links, and degraded-source notices.",
  descriptionCompressed: "Pending cross-channel inbox triage digest.",
  dynamic: true,
  contexts: ["inbox", "email", "messaging", "tasks"],
  contextGate: { anyOf: ["inbox", "email", "messaging", "tasks"] },
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  cacheStable: false,
  async get(runtime: IAgentRuntime, _message: Memory, _state: State): Promise<ProviderResult> {
    const svc = runtime.getService<InboxTriageService>(INBOX_TRIAGE_SERVICE_TYPE)
    if (!svc) return EMPTY_TRIAGE
    const snapshot = svc.getLastSnapshot() ?? (await svc.fetchUnified({ limit: 10 }))
    const pending = snapshot.items.filter((item) => item.state.status === "TriagePending")
    if (pending.length === 0 && snapshot.degraded.length === 0) return EMPTY_TRIAGE
    const urgentCount = pending.filter((item) => item.score.priority === "TriageUrgent").length
    const lines = pending.slice(0, 6).map((item) => {
      const linkSuffix = item.deepLink ? ` ${item.deepLink}` : ""
      return `- [${item.score.priority}] (${item.message.platform}) ${item.message.sender}: ${item.message.subject || item.message.snippet.slice(0, 80)}${linkSuffix}`
    })
    const degradedNote = snapshot.degraded.length > 0
      ? `\nDegraded: ${snapshot.degraded.map((d) => d.platform).join(", ")}`
      : ""
    return {
      text: `Inbox triage (${pending.length} pending, ${urgentCount} urgent):\n${lines.join("\n")}${degradedNote}`,
      values: { inboxUnresolved: pending.length, inboxUrgent: urgentCount, inboxComplete: snapshot.complete },
      data: { pendingCount: pending.length, urgentCount, degraded: snapshot.degraded },
    }
  },
}

export const crossChannelContextProvider: Provider = {
  name: "crossChannelContext",
  description: "Correlates recent cross-channel messages matching the active sender or topic for the owner.",
  descriptionCompressed: "Cross-channel context matching the active sender or topic.",
  dynamic: true,
  contexts: ["inbox", "email", "messaging"],
  contextGate: { anyOf: ["inbox", "email", "messaging"] },
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  cacheStable: false,
  async get(runtime: IAgentRuntime, message: Memory, _state: State): Promise<ProviderResult> {
    const svc = runtime.getService<InboxTriageService>(INBOX_TRIAGE_SERVICE_TYPE)
    if (!svc) return { text: "" }
    const snapshot = svc.getLastSnapshot()
    if (!snapshot || snapshot.items.length === 0) return { text: "" }
    const text = (message.content?.text ?? "").toLowerCase()
    const words = text.split(/\s+/).filter((w) => w.length >= 4).slice(0, 8)
    if (words.length === 0) return { text: "" }
    const related = snapshot.items.filter((item) => {
      const hay = `${item.message.sender} ${item.message.subject ?? ""} ${item.message.snippet}`.toLowerCase()
      return words.some((w) => hay.includes(w))
    }).slice(0, 5)
    if (related.length === 0) return { text: "" }
    return {
      text: `Related cross-channel messages:\n${related.map((r) => `- (${r.message.platform}) ${r.message.sender}: ${r.message.subject || r.message.snippet.slice(0, 70)}`).join("\n")}`,
      values: { crossChannelMatches: related.length },
      data: { matches: related.map((r) => ({ id: r.message.id, platform: r.message.platform, sender: r.message.sender })) },
    }
  },
}
