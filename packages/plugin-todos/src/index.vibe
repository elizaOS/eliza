// spec/todos/index.md, "Story: Read my to-do list from the dashboard or the agent"; spec/todos/store.md, "Story: Reject invalid batch writes and keep list queries bounded"
import type { Plugin } from "@elizaos/core"
import { findOwnerTodo, listOwnerTodos, type TodoListFilter, type TodoViewRow } from "../gen/todos.effect.vibe"
import { todoAction } from "./action.vibe"
import { currentTodosProvider } from "./provider.vibe"
import { TodosService } from "./service.vibe"

export error TodoStoreUnavailable { reason: string }
export error MultipleTodoRows { ownerId: string; todoId: number }

export service TodoStore {
  list(ownerId: string): TodoViewRow[]!TodoStoreUnavailable
  find(ownerId: string, todoId: number): TodoViewRow[]!TodoStoreUnavailable
}

export effect function listTodos(ownerId: string, filter: TodoListFilter) {
  if (ownerId === "") return []
  const store = try TodoStore
  return listOwnerTodos(try store.list(ownerId), ownerId, filter)
}

export effect function findTodo(ownerId: string, todoId: number) {
  if (ownerId === "" || !Number.isSafeInteger(todoId) || todoId < 1) return undefined
  const store = try TodoStore
  const rows = findOwnerTodo(try store.find(ownerId, todoId), ownerId, todoId)
  if (rows.length > 1) throw new MultipleTodoRows({ ownerId, todoId })
  return rows[0]
}

export const todosRuntimePlugin: Plugin = {
  name: "@elizaos/plugin-todos",
  description: "User-scoped persistent todos with CRUD, idempotent mutation ledger, and planner context.",
  actions: [todoAction],
  providers: [currentTodosProvider],
  services: [TodosService],
}

export const todosPlugin: Plugin = todosRuntimePlugin
export default todosPlugin

export * from "./action.vibe"
export * from "./edge.vibe"
export * from "./match.vibe"
export * from "./provider.vibe"
export * from "./service.vibe"
export * from "./store.vibe"
export * from "./types.vibe"
