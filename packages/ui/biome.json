{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "files": {
    "includes": [
      "src/**",
      "!src/**/*.d.ts",
      "!src/**/*.d.ts.map",
      "!src/**/__e2e__"
    ]
  },
  "overrides": [
    {
      "includes": ["src/cloud/connectors/discord-gateway-connection.tsx"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noDescendingSpecificity": "warn"
      },
      "a11y": {
        "useSemanticElements": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      }
    }
  }
}
