{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts!",
    "src/styles.ts!",
    "src/styles/theme.css!",
    "src/**/*.{stories,test,spec}.{ts,tsx}",
    "src/**/__e2e__/**/*.{ts,tsx,mjs}",
    "src/cloud/handoff/__integration__/**/*.mts",
    "src/components/shell/__screenshots__/**/*.mjs",
    "test/**/*.{ts,tsx,mjs}",
    "stories/**/*.{ts,tsx,mjs}",
    ".storybook/**/*.{ts,tsx}",
    "scripts/*.ts"
  ],
  "paths": {
    "@ui-src/*": ["src/*"]
  },
  "project": [
    "src/**/*.{ts,tsx,mts,mjs}",
    "src/**/*.{css,mdx}",
    "test/**/*.{ts,tsx,mts,mjs}",
    "stories/**/*.{ts,tsx,mts,mjs}",
    "stories/**/*.{css,mdx}",
    ".storybook/**/*.{css,mdx}",
    "*.config.{ts,mts,mjs}",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": ["@metamask/connect-evm", "pixelmatch"],
  "vitest": false
}
