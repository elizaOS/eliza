{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "customConditions": [],
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "../../",
    "rewriteRelativeImportExtensions": true,
    "stripInternal": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@elizaos/ui": ["./src/index.ts"],
      "@elizaos/plugin-wallet/ui": [
        "../../plugins/plugin-wallet/src/ui/index.ts"
      ],
      "@elizaos/plugin-browser": ["../../plugins/plugin-browser/src/index.ts"],
      "@elizaos/plugin-health/screen-time/mobile-signal-setup": [
        "../../plugins/plugin-health/src/screen-time/mobile-signal-setup.ts"
      ],
      "@elizaos/capacitor-*": [
        "../../plugins/plugin-native-*/dist/esm/index.d.ts"
      ]
    }
  },
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "include": ["src"]
}
