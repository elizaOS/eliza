{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "customConditions": [],
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "../../",
    "rewriteRelativeImportExtensions": true,
    "stripInternal": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@elizaos/ui": ["./src/index.ts"],
      "@elizaos/plugin-wallet/ui": [
        "../../plugins/plugin-wallet/src/ui/index.ts"
      ],
      "@elizaos/plugin-browser": ["../../plugins/plugin-browser/src/index.ts"],
      "@elizaos/plugin-health/screen-time/mobile-signal-setup": [
        "../../plugins/plugin-health/src/screen-time/mobile-signal-setup.ts"
      ],
      "@elizaos/capacitor-*": [
        "../../plugins/plugin-native-*/dist/esm/index.d.ts"
      ]
    }
  },
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__e2e__/**",
    "src/**/__integration__/**",
    "src/**/__screenshots__/**",
    "src/**/fixtures/**",
    "src/testing/**",
    "src/storybook/**",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "include": [
    "src/index.ts",
    "src/styles.ts",
    "src/overview/daily-overview.ts",
    "src/overview/OverviewCards.tsx",
    "src/api/task-lifecycle.ts",
    "src/accessibility/index.ts",
    "src/voice/pcm-wave.ts",
    "src/voice/microphone-capture.ts",
    "src/voice/batch-conversation.ts",
    "src/voice/voice-session-client-core.ts",
    "src/**/*.d.ts",
    "src/components/pages/InstalledAppsLauncher.tsx",
    "src/mobile-shell/index.ts",
    "src/mobile-shell/core.ts",
    "src/api/client-observation.ts",
    "src/android-cloud/NativeCloudSignInView.tsx",
    "src/android-cloud/native-cloud-sign-in-controller.ts",
    "src/android-cloud/native-cloud-service-info.ts",
    "src/startup/coordinator.ts",
    "src/startup/browser-host.ts",
    "src/app/AppProvider.tsx",
    "src/app/native-cloud-session.ts",
    "src/app/runtime-session.tsx",
    "src/api/android-native-agent-transport.ts",
    "src/api/native-agent-stream.ts",
    "src/api/host-transport.ts",
    "src/config/boot-config-store.ts",
    "src/bridge/storage-bridge.ts",
    "src/app/session.ts"
  ]
}
