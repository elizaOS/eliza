      "@elizaos/capacitor-secure-store": [
        "../../plugins/plugin-native-secure-store/src/index.ts"
      ],
      "@elizaos/capacitor-bun-runtime": [
        "../../plugins/plugin-native-bun-runtime/src/index.ts"
      ],
      "@elizaos/capacitor-calendar": [
        "../../plugins/plugin-native-calendar/src/index.ts"
      ],
      "@elizaos/capacitor-camera": [
        "../../plugins/plugin-native-camera/src/index.ts"
      ],
      "@elizaos/plugin-native-contacts/bridge": [
        "../../plugins/plugin-native-contacts/src/bridge.ts"
      ],
      "@elizaos/plugin-native-messages/bridge": [
        "../../plugins/plugin-native-messages/src/bridge.ts"
      ],
      "@elizaos/capacitor-mobile-signals": [
        "../../plugins/plugin-native-mobile-signals/src/index.ts"
      ],
      "@elizaos/plugin-native-phone/bridge": [
        "../../plugins/plugin-native-phone/src/bridge.ts"
      ],
      "@elizaos/capacitor-system": [
        "../../plugins/plugin-native-system/src/index.ts"
      ],
      "@elizaos/auth": ["../auth/src/sdk/index.ts"],
      "@elizaos/plugin-native-inference/model-catalog/recommendation": [
        "../../plugins/plugin-native-inference/src/model-catalog/recommendation.ts"
      ],
      "@elizaos/plugin-native-inference/model-catalog/catalog": [
        "../../plugins/plugin-native-inference/src/model-catalog/catalog.ts"
      ],
      "@elizaos/plugin-native-inference/model-catalog/routing-policy": [
        "../../plugins/plugin-native-inference/src/model-catalog/routing-policy.ts"
      ],
      "@elizaos/plugin-native-inference/model-catalog/voice-models": [
        "../../plugins/plugin-native-inference/src/model-catalog/voice-models.ts"
      ],
      "@elizaos/plugin-elizacloud/steward-session-client": [
        "../../plugins/plugin-elizacloud/src/steward-session-client/index.ts"
      ],
      "@elizaos/plugin-native-inference/model-catalog/network-policy": [
        "../../plugins/plugin-native-inference/src/model-catalog/network-policy.ts"
      ],
      "@elizaos/plugin-native-inference/model-catalog/runtime-class": [
        "../../plugins/plugin-native-inference/src/model-catalog/runtime-class.ts"
      ],
      "@elizaos/plugin-elizacloud/cloud-config/base-url": [
        "../../plugins/plugin-elizacloud/src/cloud-config/base-url.ts"
      ],
      "@elizaos/plugin-elizacloud/cloud-config/domain-contract": [
        "../../plugins/plugin-elizacloud/src/cloud-config/domain-contract.ts"
      ],
      "@elizaos/plugin-native-inference/model-catalog/verify": [
        "../../plugins/plugin-native-inference/src/model-catalog/verify.ts"
      ],
      "@elizaos/plugin-elizacloud/cloud-config/cloud-secrets": [
        "../../plugins/plugin-elizacloud/src/cloud-config/cloud-secrets.ts"
      ],
      "@elizaos/plugin-elizacloud/cloud-config/dev-cloud-env-authority": [
        "../../plugins/plugin-elizacloud/src/cloud-config/dev-cloud-env-authority.ts"
      ]
    }
  },
  "exclude": ["src/**/*.stories.ts", "src/**/*.stories.tsx"],
  "include": ["src"]
}
