        "../../plugins/plugin-wallet/src/ui/index.ts"
      ],
      "@elizaos/plugin-wallet/*": ["../../plugins/plugin-wallet/src/*"],
      "@elizaos/auth/vault": ["../../packages/auth/src/vault/index.ts"],
      "@elizaos/auth/vault/*": ["../../packages/auth/src/vault/*"],
      "@elizaos/cloud-sdk": ["../cloud/sdk/src/index.ts"],
      "@elizaos/cloud-sdk/*": ["../cloud/sdk/src/*"],
      "@elizaos/cloud-shared": ["../cloud/shared/src/index.ts"],
