{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "react",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "declaration": false,
    "noEmit": true,
    "paths": {
      "@elizaos/plugin-personal-assistant": [
        "../../plugins/plugin-personal-assistant/src/index.ts"
      ],
      "@elizaos/plugin-agent-orchestrator/ui": [
        "../../plugins/plugin-agent-orchestrator/src/ui/index.ts"
      ],
      "@elizaos/plugin-browser": [
        "../../plugins/plugin-browser/src/index.ts"
      ],
      "@elizaos/plugin-health/screen-time/mobile-signal-setup": [
        "../../plugins/plugin-health/src/screen-time/mobile-signal-setup.ts"
      ],
      "@elizaos/plugin-video": [
        "../../plugins/plugin-video/dist/index.d.ts"
      ],
      "@elizaos/plugin-elizacloud": [
        "../../plugins/plugin-elizacloud/src/index.node.ts"
      ],
      "@elizaos/plugin-computeruse": [
        "../../plugins/plugin-computeruse/src/index.ts"
      ],
      "@elizaos/plugin-workflow": [
        "../../plugins/plugin-workflow/src/index.ts"
      ],
      "@elizaos/plugin-sql": [
        "../../plugins/plugin-sql/src/index.ts"
      ],
      "@elizaos/plugin-sql/*": [
        "../../plugins/plugin-sql/src/*"
      ],
      "@elizaos/agent": [
        "./src/platform/empty-node-module.ts"
      ],
      "@elizaos/app": [
        "./src/platform/empty-node-module.ts"
      ],
      "@elizaos/app/*": [
        "./src/platform/empty-node-module.ts"
      ],
      "@elizaos/plugin-coding-tools": [
        "../../plugins/plugin-coding-tools/src/index.ts"
      ],
      "@capacitor/app": [
        "../app/node_modules/@capacitor/app/dist/esm/index.d.ts"
      ],
      "@elizaos/core": [
        "../core/src/index.ts"
      ],
      "@elizaos/core/*": [
        "../core/src/*"
      ],
      "@elizaos/plugin-wallet/ui": [
        "../../plugins/plugin-wallet/src/ui/index.ts"
      ],
      "@elizaos/plugin-wallet/*": [
        "../../plugins/plugin-wallet/src/*"
      ],
      "@elizaos/agent/*": [
        "./src/platform/empty-node-module.ts"
      ],
      "@elizaos/auth/vault": [
        "../../packages/auth/src/vault/index.ts"
      ],
      "@elizaos/auth/vault/*": [
        "../../packages/auth/src/vault/*"
      ],
      "@elizaos/cloud-sdk": [
        "../cloud/sdk/src/index.ts"
      ],
      "@elizaos/cloud-sdk/*": [
        "../cloud/sdk/src/*"
      ],
      "@elizaos/cloud-shared": [
        "../cloud/shared/src/index.ts"
      ],
      "@elizaos/cloud-shared/*": [
        "../cloud/shared/src/*"
      ],
      "@elizaos/cloud-sdk/cloud-setup-session": [
        "../cloud/sdk/src/cloud-setup-session/index.ts"
      ],
      "@elizaos/cloud-sdk/cloud-setup-session/*": [
        "../cloud/sdk/src/cloud-setup-session/*"
      ],
      "@elizaos/ui": [
        "./src/index.ts"
      ],
      "@elizaos/ui/navigation": [
        "./src/navigation/index.ts"
      ],
      "@elizaos/ui/*": [
        "./src/*"
      ],
      "@elizaos/*": [
        "../../node_modules/@elizaos/*"
      ],
      "@elizaos/capacitor-appblocker": [
        "../../plugins/plugin-native-appblocker/src/index.ts"
      ],
      "@elizaos/capacitor-secure-store": [
        "../../plugins/plugin-native-secure-store/src/index.ts"
      ],
      "@elizaos/capacitor-bun-runtime": [
        "../../plugins/plugin-native-bun-runtime/src/index.ts"
      ],
      "@elizaos/capacitor-calendar": [
        "../../plugins/plugin-native-calendar/src/index.ts"
      ],
      "@elizaos/capacitor-camera": [
        "../../plugins/plugin-native-camera/src/index.ts"
      ],
      "@elizaos/plugin-native-contacts/bridge": [
        "../../plugins/plugin-native-contacts/src/bridge.ts"
      ],
      "@elizaos/plugin-native-messages/bridge": [
        "../../plugins/plugin-native-messages/src/bridge.ts"
      ],
      "@elizaos/capacitor-mobile-signals": [
        "../../plugins/plugin-native-mobile-signals/src/index.ts"
      ],
      "@elizaos/plugin-native-phone/bridge": [
        "../../plugins/plugin-native-phone/src/bridge.ts"
      ],
      "@elizaos/capacitor-system": [
        "../../plugins/plugin-native-system/src/index.ts"
      ],
      "@elizaos/auth": [
        "../auth/src/sdk/index.ts"
      ]
    }
  },
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "include": [
    "src"
  ]
}
