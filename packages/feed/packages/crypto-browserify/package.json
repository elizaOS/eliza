{
  "name": "@feed/crypto-browserify",
  "version": "3.12.1",
  "private": true,
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.cjs",
      "default": "./index.js"
    }
  },
  "scripts": {
    "lint": "bunx @biomejs/biome check --write --unsafe --config-path ../../../../biome.json --vcs-root=../../../.. --files-ignore-unknown=true --no-errors-on-unmatched package.json index.js index.cjs",
    "lint:check": "bunx @biomejs/biome check --config-path ../../../../biome.json --vcs-root=../../../.. --files-ignore-unknown=true --no-errors-on-unmatched package.json index.js index.cjs",
    "lint:fix": "cd ../.. && bunx @biomejs/biome check --write --unsafe --config-path ../../biome.json --files-ignore-unknown=true --no-errors-on-unmatched packages/crypto-browserify/package.json",
    "format": "bunx @biomejs/biome format --write --config-path ../../../../biome.json --vcs-root=../../../.. --files-ignore-unknown=true --no-errors-on-unmatched package.json index.js index.cjs",
    "format:check": "bunx @biomejs/biome format --config-path ../../../../biome.json --vcs-root=../../../.. --files-ignore-unknown=true --no-errors-on-unmatched package.json index.js index.cjs",
    "test": "node -e \"import('./index.js').then((m) => { if (typeof m.createHash !== 'function') throw new Error('createHash export missing'); })\""
  }
}
