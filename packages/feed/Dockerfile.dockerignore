# Feed production context. Docker automatically prefers this file over the
# repository-wide .dockerignore when packages/feed/Dockerfile is selected.
#
# Keep the nested Feed monorepo and only the elizaOS workspaces needed to build
# its runtime plugins. The pruner validates the required package names before
# installation, so this allowlist and the runtime loader fail together.
**

!package.json
!bun.lock
!bunfig.toml
!.npmrc
!turbo.json
!tsconfig.json
!tsconfig.base.json

!packages/
packages/*
!packages/app-core/
packages/app-core/*
!packages/app-core/patches/
!packages/app-core/patches/**
!packages/scripts/
!packages/scripts/**
!packages/cloud/
packages/cloud/*
!packages/cloud/routing/
!packages/cloud/routing/**
!packages/contracts/
!packages/contracts/**
!packages/core/
!packages/core/**
!packages/feed/
!packages/feed/**
!packages/logger/
!packages/logger/**
!packages/prompts/
!packages/prompts/**
!packages/registry/
!packages/registry/**
!packages/shared/
!packages/shared/**

!plugins/
plugins/*
!plugins/plugin-build.ts
!plugins/plugin-build-externals.ts
!plugins/plugin-anthropic/
!plugins/plugin-anthropic/**
!plugins/plugin-openai/
!plugins/plugin-openai/**
!plugins/plugin-sql/
!plugins/plugin-sql/**

!patches/
!patches/**
