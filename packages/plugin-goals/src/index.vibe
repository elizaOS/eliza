// spec/goals/index.md, "Story: Review my goals and check-in history"; spec/goals/lifecycle.md, "Story: Keep goal evaluation prompts safe and goal metadata well formed"
import type { Plugin } from "@elizaos/core"
import {
  checkinsFor,
  mayImportGoal,
  visibleGoals,
  type GoalReviewEntry,
  type GoalViewFilter,
  type GoalViewRow,
} from "../gen/goals.effect.vibe"
import { ownerGoalsAction } from "./action.vibe"
import {
  GoalsCheckinService,
  GoalsMigrationService,
  GoalsService,
  type GoalsRepository,
} from "./store.vibe"

export error GoalDirectoryFailed { reason: string }

export service GoalDirectory {
  listForOwner(ownerId: string): GoalViewRow[]!GoalDirectoryFailed
  checkinsForOwner(ownerId: string, goalId: string): GoalReviewEntry[]!GoalDirectoryFailed
  insertMissing(row: GoalViewRow): boolean!GoalDirectoryFailed
}

export effect function listGoals(ownerId: string, filter: GoalViewFilter) {
  if (ownerId === "") return []
  const directory = try GoalDirectory
  return visibleGoals(try directory.listForOwner(ownerId), ownerId, filter)
}

export effect function listGoalHistory(ownerId: string, goalId: string) {
  if (ownerId === "" || goalId === "") return []
  const directory = try GoalDirectory
  return checkinsFor(try directory.checkinsForOwner(ownerId, goalId), ownerId, goalId)
}

export effect function importLegacyGoal(ownerId: string, row: GoalViewRow) {
  if (ownerId === "") return false
  const directory = try GoalDirectory
  const existing = try directory.listForOwner(ownerId)
  const known = [...new Set(existing.map((goal) => goal.goalId))]
  if (!mayImportGoal(row, ownerId, known)) return false
  return try directory.insertMissing(row)
}

export function createSqliteGoalDirectoryLayer(repository: GoalsRepository, agentId = "agent-default") {
  return Layer.succeed(GoalDirectory, {
    listForOwner: (ownerId: string) => Effect.succeed(repository.toGoalViewRows(ownerId)),
    checkinsForOwner: (ownerId: string, goalId: string) =>
      Effect.succeed(repository.toGoalReviewEntries(ownerId, goalId)),
    insertMissing: (row: GoalViewRow) =>
      Effect.succeed(repository.insertMissingViewRow(row, agentId, new Date().toISOString())),
  })
}

export const goalsPlugin: Plugin = {
  name: "@elizaos/plugin-goals",
  description: "Owner goal definitions, semantic evaluation, links, check-in reconciliation, and carve-out migration",
  actions: [ownerGoalsAction],
  services: [GoalsService, GoalsCheckinService, GoalsMigrationService],
}

export default goalsPlugin

export * from "./types.vibe"
export * from "./normalize.vibe"
export * from "./grounding.vibe"
export * from "./prompt-value.vibe"
export * from "./semantic-evaluator.vibe"
export * from "./store.vibe"
export * from "./action.vibe"
