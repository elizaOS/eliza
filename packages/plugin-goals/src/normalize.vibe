// spec/goals/lifecycle.md, "Evaluation scores stay bounded in percent units and duplicate cadence slots are refused"
import type { IAgentRuntime } from "@elizaos/core"
import { cadenceWriteAllowed, metadataBlocksPublic } from "../gen/goals__lifecycle.effect.vibe"
import { GoalsServiceError } from "./types.vibe"

export type ValidationResult<T> =
  | { readonly ok: true; readonly value: T }
  | { readonly ok: false; readonly error: GoalsServiceError }

export function goalsErrorMessage(error: unknown): string {
  if (error instanceof GoalsServiceError) return error.message
  return error instanceof Error ? error.message : String(error)
}

export function makeGoalsError(status: number, message: string, code?: string): GoalsServiceError {
  return new GoalsServiceError({ status, message, ...(code !== undefined ? { code } : {}) })
}

export function resolveAgentId(runtime: IAgentRuntime): ValidationResult<string> {
  const agentId = runtime.agentId
  if (typeof agentId !== "string" || agentId.trim().length === 0) {
    return { ok: false, error: makeGoalsError(500, "agent runtime is missing agentId") }
  }
  return { ok: true, value: agentId }
}

export function validateNonEmptyString(value: unknown, field: string): ValidationResult<string> {
  if (typeof value !== "string") {
    return { ok: false, error: makeGoalsError(400, `${field} must be a string`) }
  }
  const normalized = value.trim()
  if (normalized.length === 0) {
    return { ok: false, error: makeGoalsError(400, `${field} is required`) }
  }
  return { ok: true, value: normalized }
}

export function normalizeOptionalString(value: unknown): string | undefined {
  if (typeof value !== "string") return undefined
  const normalized = value.trim()
  return normalized.length > 0 ? normalized : undefined
}

export function validateEnumValue<T extends string>(
  value: unknown,
  field: string,
  allowed: readonly T[],
  fallback?: T,
): ValidationResult<T> {
  if (fallback !== undefined && (value === undefined || value === null || value === "")) {
    return { ok: true, value: fallback }
  }
  const str = validateNonEmptyString(value, field)
  if (!str.ok) return str
  if (!allowed.includes(str.value as T)) {
    return { ok: false, error: makeGoalsError(400, `${field} must be one of: ${allowed.join(", ")}`) }
  }
  return { ok: true, value: str.value as T }
}

export function isRecord(value: unknown): value is Record<string, unknown> {
  return Boolean(value) && typeof value === "object" && !Array.isArray(value)
}

export function cloneRecord(value: unknown): Record<string, unknown> {
  if (!isRecord(value)) return {}
  return { ...value }
}

export function normalizeStringList(value: unknown): string[] {
  if (!Array.isArray(value)) return []
  return value
    .filter((entry): entry is string => typeof entry === "string")
    .map((entry) => entry.trim())
    .filter((entry) => entry.length > 0)
}

export function mergeMetadata(
  current: Record<string, unknown>,
  updates?: Record<string, unknown>,
): Record<string, unknown> {
  const merged: Record<string, unknown> = { ...current, ...cloneRecord(updates) }
  const privacyRaw = typeof merged.privacyClass === "string" ? merged.privacyClass.trim() : ""
  if (privacyRaw.length === 0) {
    merged.privacyClass = "private"
  }
  if (metadataBlocksPublic(privacyRaw)) {
    merged.publicContextBlocked = true
  }
  return merged
}

export function checkDuplicateSlotKeys(cadence: Record<string, unknown>): GoalsServiceError | null {
  const isTimesPerDay = cadence.kind === "times_per_day"
  if (!isTimesPerDay || !Array.isArray(cadence.slots)) return null
  const seen = new Set<string>()
  for (const slot of cadence.slots) {
    const key = isRecord(slot) ? slot.key : undefined
    if (typeof key !== "string" || key.length === 0) continue
    if (!cadenceWriteAllowed(true, seen.has(key))) {
      return makeGoalsError(
        400,
        `goal cadence times_per_day slots must have unique keys; duplicate key ${JSON.stringify(key)}`,
      )
    }
    seen.add(key)
  }
  return null
}

const GOAL_SIMILARITY_STOP_WORDS = new Set([
  "and",
  "the",
  "for",
  "with",
  "that",
  "this",
  "from",
  "before",
  "after",
  "goal",
  "goals",
])

const CJK_SCRIPT_CHAR = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/gu

export function tokenizeGoalText(text: string | null | undefined): string[] {
  const raw = typeof text === "string" ? text : ""
  return raw
    .toLowerCase()
    .normalize("NFC")
    .split(/[^\p{L}\p{N}]+/u)
    .filter(
      (token) =>
        token.length + (token.match(CJK_SCRIPT_CHAR)?.length ?? 0) >= 3 && !GOAL_SIMILARITY_STOP_WORDS.has(token),
    )
}

export function goalSimilarityScore(leftTitle: string, rightTitle: string): number {
  const left = new Set(tokenizeGoalText(leftTitle))
  const right = new Set(tokenizeGoalText(rightTitle))
  if (left.size === 0 || right.size === 0) return 0
  let shared = 0
  for (const token of left) {
    if (right.has(token)) shared += 1
  }
  const unionSize = left.size + right.size - shared
  return unionSize === 0 ? 0 : shared / unionSize
}
