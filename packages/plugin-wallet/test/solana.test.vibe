// spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation"; spec/wallet/index.md, "Story: Inspect wallet holdings and venue quotes before making changes"
import { assert, it } from "@effect/vitest"
import type { AssetTransfer, WalletNetwork } from "../src/chain.vibe"
import { openSolanaAccount, openSolanaSigner, solanaAccountOf } from "../src/solana.vibe"
import { startSolanaChain, type SolanaChain, type SolanaGateway, type TokenProgram } from "./support/solana-chain.ts"

const FEE = "5000"
const FUNDED = 2_000_000_000n

function network(chain: SolanaChain): WalletNetwork {
  return { family: "SolanaWallet", chainId: chain.genesisHash, rpc: chain.url }
}

function symbol(mint: string): string {
  return `${mint.slice(0, 4)}…${mint.slice(-4)}`
}

effect function running() {
  return try acquireRelease(promise(() => startSolanaChain()), (chain) => promise(() => chain.close()))
}

effect function outcome(run: () => Promise<unknown>) {
  return tryPromise({
    try: async () => {
      await run()
      return "accepted"
    },
    catch: (cause) => cause instanceof Error ? cause.message : String(cause),
  }) catch (refusal) => refusal
}

it.live('Send SOL once, see it confirmed only when final, and see a transfer the chain rejected as failed (spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation")', () => effect {
  const chain = try running()
  const payer = chain.wallet(FUNDED)
  const payee = chain.wallet(0n)
  const signer = try promise(() => openSolanaSigner(network(chain), payer.seed))
  const send = (atomicUnits: string): AssetTransfer => ({ asset: { kind: "native" }, recipient: payee.address, atomicUnits })
  const quote = try promise(() => signer.quote(send("1200000000")))
  const signed = try promise(() => signer.sign(send("1200000000"), quote))
  const pooled = [try outcome(() => signed.broadcast()), try outcome(() => signed.broadcast())]
  chain.mine()
  const mined = try promise(() => signer.receipt(signed.operationRef))
  const repeated = try outcome(() => signed.broadcast())
  chain.finalize()
  const first = { spent: String(FUNDED - chain.balance(payer.address)), received: String(chain.balance(payee.address)), sends: chain.sent.length }
  const landing = try promise(() => signer.sign(send("500000000"), quote))
  const overdrawing = try promise(() => signer.sign(send("400000000"), quote))
  const rivals = [try outcome(() => landing.broadcast()), try outcome(() => overdrawing.broadcast())]
  chain.mine()
  chain.finalize()
  const receipts = [try promise(() => signer.receipt(signed.operationRef)), try promise(() => signer.receipt(landing.operationRef)), try promise(() => signer.receipt(overdrawing.operationRef))]
  const beyondBudget = try outcome(() => signer.sign(send("1"), { maximumFee: "4999" }))
  try Effect.try(() => assert.deepStrictEqual(
    { account: signer.account, signs: signer.supportsSigning, quote, pooled, mined, repeated, first, rivals, receipts, received: String(chain.balance(payee.address)), beyondBudget, sends: chain.sent.length },
    {
      account: payer.address, signs: true, quote: { maximumFee: FEE }, pooled: ["accepted", "accepted"], mined: "unresolved",
      repeated: "The wallet RPC refused sendTransaction",
      first: { spent: "1200005000", received: "1200000000", sends: 3 }, rivals: ["accepted", "accepted"], receipts: ["confirmed", "confirmed", "failed"],
      received: "1700000000", beyondBudget: "The transaction exceeds the reviewed fee budget", sends: 5,
    },
  ))
})

effect function tokenTransfer(chain: SolanaChain, program: TokenProgram) {
  const payer = chain.wallet(FUNDED)
  const payee = chain.wallet(0n)
  const stranger = chain.wallet(0n)
  const mint = chain.mint(program, 6)
  chain.tokenAccount(payer.address, mint, 5_000_000n)
  chain.tokenAccount(payee.address, mint, 0n)
  const before = chain.sent.length
  const signer = try promise(() => openSolanaSigner(network(chain), payer.seed))
  const send = (recipient: string, atomicUnits: string): AssetTransfer => ({ asset: { kind: "token", address: mint }, recipient, atomicUnits })
  const quote = try promise(() => signer.quote(send(payee.address, "1250000")))
  const signed = try promise(() => signer.sign(send(payee.address, "1250000"), quote))
  try promise(() => signed.broadcast())
  chain.mine()
  chain.finalize()
  return {
    program, quote, receipt: try promise(() => signer.receipt(signed.operationRef)),
    payer: String(chain.tokens(payer.address, mint)), payee: String(chain.tokens(payee.address, mint)), lamports: String(FUNDED - chain.balance(payer.address)),
    stranger: try outcome(() => signer.sign(send(stranger.address, "1"), quote)),
    overdrawn: try outcome(() => signer.sign(send(payee.address, "3750001"), quote)),
    withoutTokens: try outcome(() => openSolanaAccount(network(chain), stranger.address).then((bare) => bare.quote(send(payee.address, "1")))),
    sends: chain.sent.length - before,
  }
}

it.live('Send a token under either token program to a wallet that already holds it, and sign nothing for a wallet that does not (spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation")', () => effect {
  const chain = try running()
  const programs: readonly TokenProgram[] = ["token", "token2022"]
  const rows = try Effect.forEach(programs, (program) => tokenTransfer(chain, program))
  try Effect.try(() => assert.deepStrictEqual(rows, programs.map((program) => ({
    program, quote: { maximumFee: FEE }, receipt: "confirmed", payer: "3750000", payee: "1250000", lamports: FEE,
    stranger: "The recipient has no account for this token yet", overdrawn: "This wallet holds less of this token than the transfer sends",
    withoutTokens: "This wallet has no account for this token", sends: 1,
  }))))
})

it.live('Read a Solana account\'s balance and its tokens under both token programs from the chain it was opened on (spec/wallet/index.md, "Story: Inspect wallet holdings and venue quotes before making changes")', () => effect {
  const chain = try running()
  const owner = chain.wallet(42_000_000n)
  const other = chain.wallet(0n)
  const dollars = chain.mint("token", 6)
  const points = chain.mint("token2022", 9)
  const spent = chain.mint("token", 0)
  chain.tokenAccount(owner.address, dollars, 7_000_000n)
  chain.tokenAccount(owner.address, dollars, 500_000n, false)
  chain.tokenAccount(owner.address, points, 3n)
  chain.tokenAccount(owner.address, spent, 0n)
  chain.tokenAccount(other.address, dollars, 99n)
  const account = try promise(() => openSolanaAccount(network(chain), owner.address))
  const read = {
    derived: try promise(() => solanaAccountOf(owner.seed)),
    scope: { family: account.family, chainId: account.chainId, account: account.account, signs: account.supportsSigning },
    balance: try promise(() => account.nativeBalance()),
    holdings: try promise(() => account.tokenHoldings([])),
    facts: try promise(() => account.tokenFacts(points)),
    recipient: account.recipient(other.address),
    notAnAddress: try outcome(async () => account.recipient("0x52908400098527886E0F7030069857D2E4169EE7")),
    notAMint: try outcome(() => account.tokenFacts(other.address)),
    anotherChain: try outcome(() => openSolanaAccount({ ...network(chain), chainId: dollars }, owner.address)),
  }
  try Effect.try(() => assert.deepStrictEqual(read, {
    derived: owner.address,
    scope: { family: "SolanaWallet", chainId: chain.genesisHash, account: owner.address, signs: false },
    balance: "42000000",
    holdings: [
      { address: dollars, symbol: symbol(dollars), decimals: 6, atomicUnits: "7500000" },
      { address: points, symbol: symbol(points), decimals: 9, atomicUnits: "3" },
    ],
    facts: { address: points, symbol: symbol(points), decimals: 9 },
    recipient: other.address,
    notAnAddress: "A Solana address is 32 bytes written in base58",
    notAMint: "That address is not a token mint",
    anotherChain: "Wallet RPC answered from a different Solana chain",
  }))
})

effect function broadcastThrough(chain: SolanaChain, gateway: SolanaGateway) {
  const payer = chain.wallet(FUNDED)
  const payee = chain.wallet(0n)
  const signer = try promise(() => openSolanaSigner(network(chain), payer.seed))
  const transfer: AssetTransfer = { asset: { kind: "native" }, recipient: payee.address, atomicUnits: "1000000" }
  const quote = try promise(() => signer.quote(transfer))
  const signed = try promise(() => signer.sign(transfer, quote))
  chain.gateway = gateway
  const answered = try outcome(() => signed.broadcast())
  chain.gateway = "pass"
  chain.mine()
  chain.finalize()
  return { gateway, answered, receipt: try promise(() => signer.receipt(signed.operationRef)), paid: String(chain.balance(payee.address)) }
}

it.live('Find a Solana transfer by its signature after its broadcast answer was lost, and send nothing once the RPC answers from another chain (spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation")', () => effect {
  const chain = try running()
  const rows = [try broadcastThrough(chain, "lost"), try broadcastThrough(chain, "refused")]
  const payer = chain.wallet(FUNDED)
  const signer = try promise(() => openSolanaSigner(network(chain), payer.seed))
  const transfer: AssetTransfer = { asset: { kind: "native" }, recipient: payer.address, atomicUnits: "1" }
  const quote = try promise(() => signer.quote(transfer))
  const signed = try promise(() => signer.sign(transfer, quote))
  chain.genesisHash = payer.address
  const moved = [try outcome(() => signer.sign(transfer, quote)), try outcome(() => signed.broadcast())]
  try Effect.try(() => assert.deepStrictEqual({ rows, moved, sends: chain.sent.length }, {
    rows: [
      { gateway: "lost", answered: "fetch failed", receipt: "confirmed", paid: "1000000" },
      { gateway: "refused", answered: "The wallet RPC refused sendTransaction", receipt: "unresolved", paid: "0" },
    ],
    moved: ["The Solana chain changed before signing", "The Solana chain changed before broadcast"],
    sends: 2,
  }))
})
