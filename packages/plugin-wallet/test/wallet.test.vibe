// spec/wallet/custody.md, "Story: Hold my own keys on my device"; spec/wallet/requests.md, "Story: Let the agent ask, and decide myself"; spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation"; spec/wallet/index.md, "Story: Preview an exact wallet operation before executing it"; spec/wallet/index.md, "Story: Inspect wallet holdings and venue quotes before making changes"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { assert, it } from "@effect/vitest"
import type { LocalRoute } from "@elizaos/agent/routes"
import type { ActionResult, IAgentRuntime, Memory, ProviderResult, State, UUID } from "@elizaos/core"
import { openWallet, walletPlugin, type Wallet, type WalletDecided, type WalletHoldings, type WalletHost, type WalletOperation, type WalletRequestRow, type WalletReview, type WalletStatus } from "../src/index.vibe"
import { scratch, signedHash, startChain, type Chain, type Gateway, type Scratch } from "./support/evm-chain.ts"

const OWNER = "6f1c2a52-8a4e-4b7d-9c1e-2f3a4b5c6d7e"
const STRANGER = "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
const AGENT = "1b2c3d4e-5f60-4a7b-8c9d-0e1f2a3b4c5d"
const CLOSED = "This decision no longer matches an open review for the authenticated owner."
const OFF = "The wallet is off."
const AMOUNT = "1000000000000000"

interface World {
  readonly chain: Chain
  readonly files: Scratch
  readonly wallet: Wallet
  readonly routes: readonly LocalRoute[]
  readonly account: string
}

interface Answer<A> {
  readonly status: number
  readonly body: A
  readonly reason: string | undefined
}

function hostOver(files: Scratch, chain: Chain, settings: Record<string, string> = {}, seals = true): WalletHost {
  const storageKey = seals ? new Uint8Array(32).fill(7) : undefined
  const all: Record<string, string> = { WALLET_EVM_RPC_URL: chain.url, WALLET_EVM_CHAIN_ID: "31337", WALLET_EVM_TOKENS: chain.token, ...settings }
  return { agentId: AGENT, ownerId: OWNER, stateDirectory: files.directory, storageKey, setting: (key) => all[key] ?? "", ownerPresent: () => Promise.resolve(true) }
}

effect function called<A>(routes: readonly LocalRoute[], method: string, path: string, body?: unknown): Answer<A>!! {
  const segments = path.split("/")
  const parameters = new Map<string, string>()
  const route = routes.find((candidate) => {
    const pattern = candidate.path.split("/")
    return candidate.method === method && pattern.length === segments.length && pattern.every((part, index) => part.startsWith("{") || part === segments[index])
  })
  if (route === undefined) return { status: 404, body: {} as A, reason: undefined }
  route.path.split("/").forEach((part, index) => {
    if (part.startsWith("{")) parameters.set(part.slice(1, -1), segments[index] ?? "")
  })
  const answer = try promise(() => Promise.resolve(route.handler({ parameters, query: new Map(), headers: new Map(), body, signal: new AbortController().signal })))
  if ("headers" in answer) return { status: answer.status, body: {} as A, reason: undefined }
  return { status: answer.status, body: answer.body as A, reason: "reason" in answer.body && typeof answer.body.reason === "string" ? answer.body.reason : undefined }
}

effect function world(settings: Record<string, string> = {}) {
  const files = try acquireRelease(sync(() => scratch()), (made) => sync(() => made.remove()))
  const chain = try acquireRelease(promise(() => startChain()), (running) => promise(() => running.close()))
  const wallet = try openWallet(hostOver(files, chain, settings))
  const routes = walletPlugin(wallet, OWNER).routes ?? []
  const made = try called<WalletStatus>(routes, "POST", "/api/wallet")
  const account = made.body.accounts.find((held) => held.family === "evm")?.address ?? ""
  chain.fund(account, 10n ** 19n)
  chain.grant(account, 50_000_000n)
  return { chain, files, wallet, routes, account } satisfies World
}

function message(entityId: string): Memory {
  return { entityId: entityId as UUID, roomId: "2c3d4e5f-6071-4b8c-9d0e-1f2a3b4c5d6e" as UUID, content: { text: "wallet" } }
}

effect function acted(wallet: Wallet, entityId: string, parameters: Record<string, string>): ActionResult!! {
  const action = walletPlugin(wallet, OWNER).actions?.[0]
  if (action === undefined) return { success: false, text: "no action" }
  return try promise(() => action.handler({} as IAgentRuntime, message(entityId), undefined, { parameters }))
}

effect function offered(wallet: Wallet, entityId: string) {
  const action = walletPlugin(wallet, OWNER).actions?.[0]
  return action === undefined ? false : try promise(() => action.validate({} as IAgentRuntime, message(entityId)))
}

effect function told(wallet: Wallet, entityId: string): ProviderResult!! {
  const provider = walletPlugin(wallet, OWNER).providers?.[0]
  return provider === undefined ? {} : try promise(() => provider.get({} as IAgentRuntime, message(entityId), {} as State))
}

it.live('Make the wallet once on the device, seal its keys, and serve nothing while it is off (spec/wallet/custody.md, "Story: Hold my own keys on my device"; spec/wallet/custody.md, "Only the owner makes the wallet, once, with an account for each family"; spec/wallet/custody.md, "The owner switches the wallet off and on, and off means nothing is read or signed")', () => effect {
  provide NodeServices.layer {
    const files = try acquireRelease(sync(() => scratch()), (made) => sync(() => made.remove()))
    const chain = try acquireRelease(promise(() => startChain()), (running) => promise(() => running.close()))
    const unsealing = try openWallet(hostOver(files, chain, {}, false))
    const bare = walletPlugin(unsealing, OWNER).routes ?? []
    const noKey = { before: (try called<WalletStatus>(bare, "GET", "/api/wallet")).body, made: try called<WalletStatus>(bare, "POST", "/api/wallet") }
    const wallet = try openWallet(hostOver(files, chain))
    const routes = walletPlugin(wallet, OWNER).routes ?? []
    const first = (try called<WalletStatus>(routes, "POST", "/api/wallet")).body
    const second = (try called<WalletStatus>(routes, "POST", "/api/wallet")).body
    const reopened = try (try openWallet(hostOver(files, chain))).status()
    const sealed = files.sealed()
    const off = (try called<WalletStatus>(routes, "POST", "/api/wallet/switch", { on: false })).body
    const whileOff = {
      holdings: (try called<WalletHoldings>(routes, "GET", "/api/wallet/holdings")).reason,
      asked: (try called<WalletRequestRow>(routes, "POST", "/api/wallet/requests", { family: "evm", recipient: chain.recipient, amount: "1" })).reason,
      offered: try offered(wallet, OWNER),
      told: try told(wallet, OWNER),
    }
    const on = (try called<WalletStatus>(routes, "POST", "/api/wallet/switch", { on: true })).body
    const evm = first.accounts.find((account) => account.family === "evm")
    const malformed = (try called<WalletStatus>(routes, "POST", "/api/wallet/switch", { on: "yes" })).status
    const offeredOn = [try offered(wallet, OWNER), try offered(wallet, STRANGER)]
    try Effect.try(() => assert.deepStrictEqual({
      noKey: { custody: noKey.before.custody, canHold: noKey.before.canHold, status: noKey.made.status, reason: noKey.made.reason },
      custody: first.custody,
      accounts: first.accounts.map((account) => ({ family: account.family, connected: account.connected, network: account.network, canSend: account.canSend, held: account.address !== "" })),
      same: [second, reopened, on].map((status) => status.accounts.map((account) => account.address)),
      sealed: { marked: sealed.startsWith("wallet-keys-v1."), plain: sealed.includes("0x") || sealed.includes("evm") },
      off: { custody: off.custody, canSend: off.accounts.map((account) => account.canSend) },
      whileOff,
      malformed,
      offeredOn,
    }, {
      noKey: { custody: "none", canHold: false, status: 409, reason: "This device gave no storage key to seal a wallet under." },
      custody: "ready",
      accounts: [
        { family: "evm", connected: true, network: "Local chain", canSend: true, held: true },
        { family: "solana", connected: false, network: "", canSend: false, held: true },
      ],
      same: [0, 1, 2].map(() => [evm?.address, first.accounts.find((account) => account.family === "solana")?.address]),
      sealed: { marked: true, plain: false },
      off: { custody: "off", canSend: [false, false] },
      whileOff: { holdings: OFF, asked: OFF, offered: false, told: {} },
      malformed: 400,
      offeredOn: [true, false],
    }))
  }
})

function sent(decided: Answer<WalletDecided>, signed: string) {
  return decided.body.status === "declined" || decided.status !== 200 ? { status: decided.status } : { status: decided.body.status, signedHash: decided.body.operationRef === signed }
}

effect function broadcastThrough({ chain, files, routes }: World, gateway: Gateway, automine: boolean) {
  chain.gateway = gateway
  chain.automine = automine
  const before = { paid: chain.balance(chain.recipient), sends: chain.sent.length }
  const asked = (try called<WalletRequestRow>(routes, "POST", "/api/wallet/requests", { family: "evm", recipient: chain.recipient, amount: "0.001" })).body
  try sync(() => files.keepDesk())
  const review = (try called<WalletReview>(routes, "POST", `/api/wallet/requests/${asked.id}/review`)).body
  const decision = { decision: "approve", intentId: review.intentId, commitment: review.commitment }
  const decided = try called<WalletDecided>(routes, "POST", `/api/wallet/requests/${asked.id}/decide`, decision)
  const retried = try called<WalletDecided>(routes, "POST", `/api/wallet/requests/${asked.id}/decide`, decision)
  if (!automine) chain.mine()
  const signed = try Effect.try(() => signedHash(chain.sent.at(-1) ?? ""))
  const afterFirst = { paid: chain.balance(chain.recipient) - before.paid, sends: chain.sent.length - before.sends }
  chain.gateway = "pass"
  try sync(() => files.restoreDesk())
  const reopened = try called<WalletReview>(routes, "POST", `/api/wallet/requests/${asked.id}/review`)
  const operations = (try called<{ readonly operations: readonly WalletOperation[] }>(routes, "GET", "/api/wallet/activity")).body.operations
  return {
    gateway, automine, ...sent(decided, signed), retried: retried.reason,
    landed: chain.landed(signed), paid: String(afterFirst.paid), sends: afterFirst.sends,
    reopened: { reason: reopened.reason, paid: String(chain.balance(chain.recipient) - before.paid), sends: chain.sent.length - before.sends },
    waiting: (try called<{ readonly requests: readonly WalletRequestRow[] }>(routes, "GET", "/api/wallet/requests")).body.requests.length,
    reconciled: operations.find((operation) => operation.intentId === review.intentId)?.status,
  }
}

const cases: readonly (readonly [Gateway, boolean])[] = [
  ["pass", true], ["missingHash", true], ["nullHash", true], ["malformedHash", true], ["otherHash", true], ["uppercaseHash", true],
  ["lost", true], ["gatewayError", true], ["secondCopy", true], ["secondCopy", false], ["refused", true],
]

it.live('Recover the real outcome of an EVM transfer whatever the RPC answers to its broadcast, and never sign it again after a restart that forgot the decision (spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation"; spec/wallet/index.md, "A submitted operation retains one durable binding through reconciliation"; spec/wallet/requests.md, "Only the owner\'s decision takes a request off the desk")', () => effect {
  provide NodeServices.layer {
    const all = try world()
    const rows = try Effect.forEach(cases, ([gateway, automine]) => broadcastThrough(all, gateway, automine))
    const expected = cases.map(([gateway, automine]) => ({
      gateway, automine, status: gateway === "pass" ? "submitted" : "unresolved", signedHash: true, retried: CLOSED,
      landed: gateway !== "refused", paid: gateway === "refused" ? "0" : AMOUNT, sends: 1,
      reopened: { reason: "That request was already decided.", paid: gateway === "refused" ? "0" : AMOUNT, sends: 1 },
      waiting: 0,
      reconciled: gateway === "refused" ? "pending" : "confirmed",
    }))
    try Effect.try(() => assert.deepStrictEqual({ rows, refusals: all.chain.refusals }, { rows: expected, refusals: ["nonce too low", "already known"] }))
  }
}, 60_000)

it.live('The agent reads the wallet and asks for a token transfer, and only the owner\'s review on the wallet route sends it (spec/wallet/requests.md, "Story: Let the agent ask, and decide myself"; spec/wallet/requests.md, "A request waits with the exact terms it was asked with"; spec/wallet/index.md, "Story: Inspect wallet holdings and venue quotes before making changes"; spec/wallet/index.md, "A review binds the complete immutable wallet operation")', () => effect {
  provide NodeServices.layer {
    const { chain, wallet, routes, account } = try world()
    const transfer = { chain: "evm", token: chain.token, recipient: chain.recipient }
    const holdings = try acted(wallet, OWNER, { subaction: "holdings" })
    const quoted = try acted(wallet, OWNER, { subaction: "quote", ...transfer, amount: "2.5" })
    const refusedAsks = [
      try acted(wallet, OWNER, { subaction: "request", ...transfer, amount: "0.0000001" }),
      try acted(wallet, OWNER, { subaction: "request", ...transfer, amount: "0" }),
      try acted(wallet, OWNER, { subaction: "request", ...transfer, recipient: "0x1234", amount: "1" }),
      try acted(wallet, OWNER, { subaction: "request", chain: "solana", recipient: chain.recipient, amount: "1" }),
      try acted(wallet, STRANGER, { subaction: "request", ...transfer, amount: "1" }),
      try acted(wallet, OWNER, { subaction: "approve", ...transfer, amount: "1" }),
    ].map((result) => [result.success, result.text])
    const asked = try acted(wallet, OWNER, { subaction: "request", ...transfer, amount: "2.50" })
    const waiting = (try called<{ readonly requests: readonly WalletRequestRow[] }>(routes, "GET", "/api/wallet/requests")).body.requests
    const id = waiting[0]?.id ?? 0
    const untouched = { sends: chain.sent.length, tokens: String(chain.tokens(chain.recipient)) }
    const review = (try called<WalletReview>(routes, "POST", `/api/wallet/requests/${id}/review`)).body
    const wrong = try called<WalletDecided>(routes, "POST", `/api/wallet/requests/${id}/decide`, { decision: "approve", intentId: review.intentId, commitment: "0".repeat(64) })
    const again = (try called<WalletReview>(routes, "POST", `/api/wallet/requests/${id}/review`)).body
    const decided = (try called<WalletDecided>(routes, "POST", `/api/wallet/requests/${id}/decide`, { decision: "approve", intentId: again.intentId, commitment: again.commitment })).body
    const context = (try told(wallet, OWNER)).data
    const filled = try Effect.forEach([1, 2, 3, 4, 5, 6, 7, 8, 9], (count) => acted(wallet, OWNER, { subaction: "request", ...transfer, amount: String(count) }))
    const first = (try called<{ readonly requests: readonly WalletRequestRow[] }>(routes, "GET", "/api/wallet/requests")).body.requests[0]?.id ?? 0
    const declining = (try called<WalletReview>(routes, "POST", `/api/wallet/requests/${first}/review`)).body
    const declined = (try called<WalletDecided>(routes, "POST", `/api/wallet/requests/${first}/decide`, { decision: "decline", intentId: declining.intentId, commitment: declining.commitment })).body
    const left = (try called<{ readonly requests: readonly WalletRequestRow[] }>(routes, "GET", "/api/wallet/requests")).body.requests.length
    const stranger = [try offered(wallet, STRANGER), try told(wallet, STRANGER)]
    try Effect.try(() => assert.deepStrictEqual({
      holdings: holdings.data,
      quoted: [quoted.success, quoted.data?.atomicUnits, quoted.data?.symbol, quoted.data?.maximumFee, quoted.data?.feeSymbol],
      refusedAsks,
      asked: asked.success,
      waiting,
      untouched,
      review: { account: review.account, recipient: review.recipient, asset: review.asset, symbol: review.symbol, decimals: review.decimals, atomicUnits: review.atomicUnits, network: review.network, feeSymbol: review.feeSymbol, sameIntent: again.intentId === review.intentId },
      wrong: [wrong.status, wrong.reason],
      decided: decided.status,
      moved: { tokens: String(chain.tokens(chain.recipient)), sends: chain.sent.length },
      context: {
        holdings: Array.isArray(context?.holdings) ? context.holdings.length : undefined,
        requests: context?.requests,
        operations: Array.isArray(context?.operations) ? context.operations.length : undefined,
      },
      filled: filled.map((result) => result.success),
      declined: [declined.status, left, chain.sent.length],
      stranger,
    }, {
      holdings: {
        holdings: [
          { family: "evm", chainId: "31337", asset: "native", symbol: "ETH", decimals: 18, atomicUnits: "10000000000000000000" },
          { family: "evm", chainId: "31337", asset: chain.token, symbol: "TKN", decimals: 6, atomicUnits: "50000000" },
        ],
        unread: [],
      },
      quoted: [true, "2500000", "TKN", "75600000000000", "ETH"],
      refusedAsks: [
        [false, "TKN has at most 6 decimal places."],
        [false, "The amount must be more than zero and fit the chain exactly."],
        [false, "That is not an address on this chain."],
        [false, "This wallet has no network configured for that chain."],
        [false, "Only the wallet's owner may use it."],
        [false, "Name a wallet subaction: accounts, holdings, quote, request, requests, activity, reconcile."],
      ],
      asked: true,
      waiting: [{ id: 1, family: "evm", asset: chain.token, symbol: "TKN", recipient: chain.recipient, amount: "2.5", asker: "agent" }],
      untouched: { sends: 0, tokens: "0" },
      review: { account, recipient: chain.recipient, asset: chain.token, symbol: "TKN", decimals: 6, atomicUnits: "2500000", network: "Local chain", feeSymbol: "ETH", sameIntent: true },
      wrong: [409, CLOSED],
      decided: "submitted",
      moved: { tokens: "2500000", sends: 1 },
      context: { holdings: 2, requests: [], operations: 1 },
      filled: [true, true, true, true, true, true, true, true, false],
      declined: ["declined", 7, 1],
      stranger: [false, {}],
    }))
  }
}, 60_000)

effect function outcome<A, E>(run: A!E): { readonly value?: A; readonly reason?: string }!! {
  return effect {
    return { value: try run }
  } catch (failure) => ({ reason: typeof failure === "object" && failure !== null && "reason" in failure ? String(failure.reason) : "unreachable" })
}

it.effect('A review refuses terms outside the wallet\'s limits and an approval that arrives after its minute (spec/wallet/index.md, "Story: Preview an exact wallet operation before executing it"; spec/wallet/index.md, "An approval and fresh quote belong to the same operation")', () => effect {
  provide NodeServices.layer {
    const limited = try world({ WALLET_EVM_MAX_FEE_ATOMIC: "1" })
    const fenced = try world({ WALLET_TRANSFER_RECIPIENTS: "0x000000000000000000000000000000000000dEaD" })
    const { wallet, chain } = try world()
    const transfer = (to: Chain) => ({ family: "EvmWallet" as const, token: "", recipient: to.recipient, amount: "0.001" })
    const outside = try Effect.forEach([limited, fenced], effect (other) => {
      const asked = try other.wallet.ask(transfer(other.chain), "OwnerAsks")
      return (try outcome(other.wallet.review(asked.id))).reason
    })
    const asked = try wallet.ask(transfer(chain), "OwnerAsks")
    const review = try wallet.review(asked.id)
    try TestClock.adjust("61 seconds")
    const late = try outcome(wallet.decide(asked.id, { decision: "approve", intentId: review.intentId, commitment: review.commitment }))
    const sentLate = chain.sent.length
    const fresh = try wallet.review(asked.id)
    const timely = try outcome(wallet.decide(asked.id, { decision: "approve", intentId: fresh.intentId, commitment: fresh.commitment }))
    try Effect.try(() => assert.deepStrictEqual({
      outside, late: late.reason, sentLate, timely: timely.value?.status, sends: chain.sent.length, paid: String(chain.balance(chain.recipient)),
    }, {
      outside: ["The recipient or the network fee is outside this wallet's limits.", "The recipient or the network fee is outside this wallet's limits."],
      late: "This wallet review expired.", sentLate: 0, timely: "submitted", sends: 1, paid: AMOUNT,
    }))
  }
}, 60_000)
