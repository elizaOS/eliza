// spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation"; spec/wallet/index.md, "A submitted operation retains one durable binding through reconciliation"
import { assert, it } from "@effect/vitest"
import type { IAgentRuntime, Memory, UUID } from "@elizaos/core"
import { bindWalletOwnerReview, walletAction, type WalletOwnerReviewResult } from "../src/index.vibe"

module chain {
  import { mkdtempSync, rmSync } from "node:fs"
  import { createServer, type Server } from "node:http"
  import type { AddressInfo } from "node:net"
  import { tmpdir } from "node:os"
  import { join } from "node:path"
  import { Transaction, Wallet, id, keccak256, toQuantity } from "ethers"

  export type Gateway = "pass" | "lost" | "refused" | "gatewayError" | "secondCopy" | "missingHash" | "nullHash" | "malformedHash" | "otherHash" | "uppercaseHash"

  interface Call { readonly id: unknown; readonly method: string; readonly params: readonly unknown[] }
  interface Answer { readonly result?: unknown; readonly error?: { readonly code: number; readonly message: string } }
  interface Pooled { readonly hash: string; readonly from: string; readonly to: string; readonly value: bigint; readonly price: bigint }
  interface Mined extends Pooled { readonly block: number }

  export interface Chain {
    readonly url: string
    readonly signingKey: string
    readonly recipient: string
    gateway: Gateway
    automine: boolean
    readonly sent: string[]
    readonly refusals: string[]
    /** @throws {never} */
    balance(address: string): bigint
    /** @throws {never} */
    landed(hash: string): boolean
    /** @throws {never} */
    mine(): void
    close(): Promise<void>
  }

  const chainId = 31337n
  const baseFee = 1_000_000_000n
  const tip = 1_000_000_000n
  const transferGas = 21_000n

  /** @throws {never} */
  export function signedHash(raw: string): string {
    return keccak256(raw)
  }

  /** @throws {never} */
  export async function startChain(): Promise<Chain> {
    const signer = Wallet.createRandom()
    const balances = new Map<string, bigint>([[signer.address.toLowerCase(), 10n ** 19n]])
    const pool = new Map<string, Pooled>()
    const mined = new Map<string, Mined>()
    const blocks: string[][] = [[]]
    const balance = (address: string) => balances.get(address.toLowerCase()) ?? 0n
    const minedNonce = (address: string) => [...mined.values()].filter((tx) => tx.from === address.toLowerCase()).length
    const pendingNonce = (address: string) => minedNonce(address) + [...pool.values()].filter((tx) => tx.from === address.toLowerCase()).length
    const mine = () => {
      const included = [...pool.values()]
      for (const tx of included) {
        balances.set(tx.from, balance(tx.from) - tx.value - transferGas * tx.price)
        balances.set(tx.to, balance(tx.to) + tx.value)
        mined.set(tx.hash, { ...tx, block: blocks.length })
      }
      pool.clear()
      blocks.push(included.map((tx) => tx.hash))
    }
    const blockHash = (number: number) => id(`fake-chain-block-${number}`)
    const block = (tag: unknown) => {
      const number = typeof tag === "string" && tag.startsWith("0x") ? Number(BigInt(tag)) : blocks.length - 1
      const transactions = blocks[number]
      if (transactions === undefined) return null
      return {
        number: toQuantity(number), hash: blockHash(number), parentHash: number === 0 ? `0x${"0".repeat(64)}` : blockHash(number - 1),
        timestamp: toQuantity(1_800_000_000 + number * 12), nonce: "0x0000000000000000", difficulty: "0x0", gasLimit: toQuantity(30_000_000),
        gasUsed: toQuantity(transferGas * BigInt(transactions.length)), miner: `0x${"0".repeat(40)}`, extraData: "0x",
        baseFeePerGas: toQuantity(baseFee), transactions,
      }
    }
    const receipt = (hash: unknown) => {
      const tx = typeof hash === "string" ? mined.get(hash.toLowerCase()) : undefined
      if (tx === undefined) return null
      const index = blocks[tx.block]?.indexOf(tx.hash) ?? 0
      return {
        transactionHash: tx.hash, transactionIndex: toQuantity(index), blockHash: blockHash(tx.block), blockNumber: toQuantity(tx.block),
        from: tx.from, to: tx.to, gasUsed: toQuantity(transferGas), cumulativeGasUsed: toQuantity(transferGas * BigInt(index + 1)),
        effectiveGasPrice: toQuantity(tx.price), contractAddress: null, logs: [], logsBloom: `0x${"0".repeat(512)}`, status: "0x1", type: "0x2",
      }
    }
    const refusals: string[] = []
    const refuse = (message: string): Answer => {
      refusals.push(message)
      return { error: { code: -32000, message } }
    }
    const accept = (raw: string): Answer => {
      const tx = Transaction.from(raw)
      const hash = tx.hash
      if (hash === null || tx.chainId !== chainId || tx.from === null || tx.to === null || tx.maxFeePerGas === null || tx.maxPriorityFeePerGas === null) return refuse("invalid transaction")
      if (pool.has(hash)) return refuse("already known")
      if (tx.nonce < pendingNonce(tx.from)) return refuse("nonce too low")
      if (tx.nonce > pendingNonce(tx.from)) return refuse("nonce too high")
      if (tx.maxFeePerGas < baseFee) return refuse("max fee per gas less than block base fee")
      if (balance(tx.from) < tx.value + tx.gasLimit * tx.maxFeePerGas) return refuse("insufficient funds for gas * price + value")
      const price = baseFee + (tx.maxPriorityFeePerGas < tx.maxFeePerGas - baseFee ? tx.maxPriorityFeePerGas : tx.maxFeePerGas - baseFee)
      pool.set(hash, { hash, from: tx.from.toLowerCase(), to: tx.to.toLowerCase(), value: tx.value, price })
      if (state.automine) mine()
      return { result: hash }
    }
    const node = (call: Call): Answer => {
      const [first, second] = call.params
      switch (call.method) {
        case "eth_chainId": return { result: toQuantity(chainId) }
        case "eth_blockNumber": return { result: toQuantity(blocks.length - 1) }
        case "eth_getBlockByNumber": return { result: block(first) }
        case "eth_getBalance": return { result: toQuantity(balance(String(first))) }
        case "eth_getTransactionCount": return { result: toQuantity(second === "pending" ? pendingNonce(String(first)) : minedNonce(String(first))) }
        case "eth_estimateGas": return { result: toQuantity(transferGas) }
        case "eth_gasPrice": return { result: toQuantity(baseFee + tip) }
        case "eth_maxPriorityFeePerGas": return { result: toQuantity(tip) }
        case "eth_getTransactionReceipt": return { result: receipt(first) }
        case "eth_sendRawTransaction": return accept(String(first))
        default: return { error: { code: -32601, message: `the method ${call.method} does not exist` } }
      }
    }
    const relay = (call: Call): Answer | "lost" => {
      if (call.method !== "eth_sendRawTransaction") return node(call)
      state.sent.push(String(call.params[0]))
      switch (state.gateway) {
        case "pass": return node(call)
        case "refused": return { error: { code: -32000, message: "insufficient funds for gas * price + value" } }
        case "lost": node(call); return "lost"
        case "gatewayError": node(call); return { error: { code: -32603, message: "Upstream response timed out" } }
        case "secondCopy": node(call); return node(call)
        case "missingHash": node(call); return {}
        case "nullHash": node(call); return { result: null }
        case "malformedHash": node(call); return { result: "0x1234" }
        case "otherHash": node(call); return { result: `0x${"a".repeat(64)}` }
        case "uppercaseHash": return { result: `0x${String(node(call).result).slice(2).toUpperCase()}` }
      }
    }
    const server: Server = createServer((request, response) => {
      let body = ""
      request.on("data", (chunk: Buffer) => { body += chunk.toString("utf8") })
      request.on("end", () => {
        const parsed: unknown = JSON.parse(body)
        const calls = (Array.isArray(parsed) ? parsed : [parsed]) as Call[]
        const replies: object[] = []
        for (const call of calls) {
          const answer = relay(call)
          if (answer === "lost") {
            response.destroy()
            return
          }
          replies.push({ jsonrpc: "2.0", id: call.id, ...answer })
        }
        response.setHeader("content-type", "application/json")
        response.end(JSON.stringify(Array.isArray(parsed) ? replies : replies[0]))
      })
    })
    await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", () => resolve()))
    const state: Chain = {
      url: `http://127.0.0.1:${(server.address() as AddressInfo).port}`,
      signingKey: signer.privateKey,
      recipient: Wallet.createRandom().address,
      gateway: "pass",
      automine: true,
      sent: [],
      refusals,
      balance,
      landed: (hash) => mined.has(hash.toLowerCase()),
      mine,
      close: () => {
        server.closeAllConnections()
        return new Promise((resolve) => server.close(() => resolve()))
      },
    }
    return state
  }

  export function useStateDirectory(): () => void {
    const directory = mkdtempSync(join(tmpdir(), "eliza-wallet-"))
    const previous = process.env.ELIZA_STATE_DIR
    process.env.ELIZA_STATE_DIR = directory
    return () => {
      if (previous === undefined) delete process.env.ELIZA_STATE_DIR
      else process.env.ELIZA_STATE_DIR = previous
      rmSync(directory, { recursive: true, force: true })
    }
  }

  /** @throws {never} */
  export async function settle<A>(run: () => Promise<A>): Promise<{ readonly value?: A; readonly refused?: string }> {
    try {
      return { value: await run() }
    } catch (failure) {
      return { refused: typeof failure === "object" && failure !== null && "reason" in failure ? String(failure.reason) : String(failure) }
    }
  }
}
import { settle, signedHash, startChain, useStateDirectory, type Chain, type Gateway } from chain

const OWNER = "6f1c2a52-8a4e-4b7d-9c1e-2f3a4b5c6d7e"
const AMOUNT = "1000000000000000"
const CLOSED = "This decision no longer matches an open review for the authenticated owner."

function walletRuntime(chain: Chain): IAgentRuntime {
  const settings: Record<string, string> = {
    ELIZA_ADMIN_ENTITY_ID: OWNER,
    WALLET_EVM_RPC_URL: chain.url,
    WALLET_EVM_CHAIN_ID: "31337",
    WALLET_EVM_SIGNING_KEY: chain.signingKey,
    WALLET_TRANSFER_MAX_ATOMIC: "1000000000000000000",
    WALLET_TRANSFER_RECIPIENTS: chain.recipient,
    WALLET_TRANSFER_MAX_FEE_ATOMIC: "100000000000000",
  }
  return { agentId: "1b2c3d4e-5f60-4a7b-8c9d-0e1f2a3b4c5d", getSetting: (key: string) => settings[key] ?? null } as unknown as IAgentRuntime
}

effect function approve(runtime: IAgentRuntime, chain: Chain, requestId: string) {
  const review = try bindWalletOwnerReview(runtime, { requestId, family: "evm", recipient: chain.recipient, atomicUnits: AMOUNT }, () => Promise.resolve(OWNER))
  const decision = { decision: "approve" as const, intentId: review.details.intent.intentId, commitment: review.details.intent.commitment }
  const outcome = try promise(() => settle(() => review.decide(decision)))
  const retried = try promise(() => settle(() => review.decide(decision)))
  try promise(() => review.close())
  return { intentId: decision.intentId, outcome: outcome.value, refused: outcome.refused, retried: retried.refused }
}

effect function reconcile(runtime: IAgentRuntime, intentId: string) {
  const message = { entityId: OWNER as UUID, roomId: "2c3d4e5f-6071-4b8c-9d0e-1f2a3b4c5d6e" as UUID, content: { text: "did my transfer go through?" } } satisfies Memory
  const settled = try promise(() => settle(() => walletAction.handler(runtime, message, undefined, { parameters: { subaction: "reconcile", chain: "evm", intentId } })))
  return settled.value?.data?.receipt ?? settled.refused
}

function sent(outcome: WalletOwnerReviewResult | undefined, signed: string) {
  return outcome === undefined || outcome.status === "declined" ? { status: outcome?.status } : { status: outcome.status, signedHash: outcome.operationRef === signed }
}

effect function broadcastThrough(runtime: IAgentRuntime, chain: Chain, gateway: Gateway, automine: boolean) {
  chain.gateway = gateway
  chain.automine = automine
  const before = { paid: chain.balance(chain.recipient), sends: chain.sent.length }
  const requestId = `transfer-${gateway}-${automine ? "mined" : "pooled"}`
  const first = try approve(runtime, chain, requestId)
  if (!automine) chain.mine()
  const signed = try Effect.try(() => signedHash(chain.sent.at(-1) ?? ""))
  const afterFirst = { paid: chain.balance(chain.recipient) - before.paid, sends: chain.sent.length - before.sends }
  chain.gateway = "pass"
  const reopened = try approve(runtime, chain, requestId)
  return {
    gateway, automine, ...sent(first.outcome, signed), refused: first.refused, retried: first.retried,
    landed: chain.landed(signed), paid: String(afterFirst.paid), sends: afterFirst.sends,
    reopened: { ...sent(reopened.outcome, signed), paid: String(chain.balance(chain.recipient) - before.paid), sends: chain.sent.length - before.sends },
    reconciled: try reconcile(runtime, first.intentId),
  }
}

const cases: readonly (readonly [Gateway, boolean])[] = [
  ["pass", true], ["missingHash", true], ["nullHash", true], ["malformedHash", true], ["otherHash", true], ["uppercaseHash", true],
  ["lost", true], ["gatewayError", true], ["secondCopy", true], ["secondCopy", false], ["refused", true],
]

it.live('Recover the real outcome of an EVM transfer whatever the RPC answers to its broadcast, and never pay twice on a retry (spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation"; spec/wallet/index.md, "A submitted operation retains one durable binding through reconciliation")', () => effect {
  try acquireRelease(Effect.try(() => useStateDirectory()), (release) => sync(release))
  const chain = try acquireRelease(promise(() => startChain()), (running) => promise(() => running.close()))
  const runtime = walletRuntime(chain)
  const rows = try Effect.forEach(cases, ([gateway, automine]) => broadcastThrough(runtime, chain, gateway, automine))
  const expected = cases.map(([gateway, automine]) => ({
    gateway, automine, status: gateway === "pass" ? "submitted" : "unresolved", signedHash: true, refused: undefined, retried: CLOSED,
    landed: gateway !== "refused", paid: gateway === "refused" ? "0" : AMOUNT, sends: 1,
    reopened: { status: "unresolved", signedHash: true, paid: gateway === "refused" ? "0" : AMOUNT, sends: 1 },
    reconciled: gateway === "refused" ? "unresolved" : "confirmed",
  }))
  try Effect.try(() => assert.deepStrictEqual({ rows, refusals: chain.refusals }, { rows: expected, refusals: ["nonce too low", "already known"] }))
})
