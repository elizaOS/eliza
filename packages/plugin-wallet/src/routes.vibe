// spec/wallet/custody.md, "Only the owner makes the wallet, once, with an account for each family"; spec/wallet/requests.md, "Only the owner's decision takes a request off the desk"; spec/wallet/index.md, "A review binds the complete immutable wallet operation"
import type { AgentPlugin } from "@elizaos/agent-host"
import { WalletAsk, WalletDecision, WalletSwitch, walletPaths, type WalletRefusal } from "@elizaos/plugin-wallet-client"
import { BirdeyeService, NewsDataService } from "./analytics.vibe"
import { familyOf } from "./networks.vibe"
import { WalletRefused, WalletUnreachable, type Wallet } from "./wallet.vibe"

const switchBody = Schema.decodeUnknownOption(WalletSwitch, { onExcessProperty: "error" })
const askBody = Schema.decodeUnknownOption(WalletAsk, { onExcessProperty: "error" })
const decideBody = Schema.decodeUnknownOption(WalletDecision, { onExcessProperty: "error" })

export type WalletRoute = NonNullable<AgentPlugin["routes"]>[number]
type Answer = { readonly status: number; readonly body: object }

const malformed: Answer = { status: 400, body: { error: "The wallet could not read that request.", code: "invalid_request" } satisfies WalletRefusal }

effect function settled(run: object!(WalletRefused | WalletUnreachable)): Answer!! {
  return effect {
    return { status: 200, body: try run } satisfies Answer
  } catch (error): Answer => match (error) {
    when WalletRefused: { status: 409, body: { error: error.reason, code: "refused" } satisfies WalletRefusal };
    when WalletUnreachable: { status: 502, body: { error: "The wallet could not reach its network.", code: "unreachable" } satisfies WalletRefusal };
  }
}

function replied(run: object!(WalletRefused | WalletUnreachable), signal: AbortSignal): Promise<Answer> {
  return runPromise(settled(run), { signal })
}

function requestId(parameters: ReadonlyMap<string, string>): number | undefined {
  const id = parameters.get("id") ?? ""
  return /^[1-9][0-9]{0,14}$/.test(id) ? Number(id) : undefined
}

export interface WalletMarketOverviewOptions {
  readonly birdeye?: BirdeyeService
  readonly news?: NewsDataService
}

export async function handleWalletMarketOverviewRoute(options: WalletMarketOverviewOptions = {}): Promise<Answer> {
  const birdeye = options.birdeye ?? new BirdeyeService()
  const news = options.news ?? new NewsDataService()
  const [trending, market] = await Promise.all([
    birdeye.getTrendingTokens("solana", 10),
    news.getMarketSnapshot(),
  ])
  return {
    status: 200,
    body: {
      trending,
      market,
      observedAt: Date.now(),
    },
  }
}

function signReviewRequired(family: "evm" | "solana", operation: string): Answer {
  return {
    status: 403,
    body: {
      error: `Direct ${family.toUpperCase()} ${operation} requires owner approval through the reviewed wallet request flow.`,
      code: "review_required",
    },
  }
}

export function evmSignRoutes(wallet: Wallet): WalletRoute[] {
  return [
    {
      method: "GET",
      path: "/wallet/evm/address",
      handler: ({ signal }) => replied(
        Effect.map(wallet.status(), (status) => {
          const evm = status.accounts.find((a) => a.family === "evm")
          return { address: evm?.address ?? "", connected: evm?.connected ?? false, custody: status.custody }
        }),
        signal,
      ),
    },
    { method: "POST", path: "/wallet/evm/personal-sign", maxBodyBytes: 4096, handler: () => signReviewRequired("evm", "personal-sign") },
    { method: "POST", path: "/wallet/evm/sign-typed-data", maxBodyBytes: 8192, handler: () => signReviewRequired("evm", "sign-typed-data") },
    { method: "POST", path: "/wallet/evm/sign-transaction", maxBodyBytes: 8192, handler: () => signReviewRequired("evm", "sign-transaction") },
    { method: "POST", path: "/wallet/evm/send-transaction", maxBodyBytes: 8192, handler: () => signReviewRequired("evm", "send-transaction") },
  ]
}

export function solanaSignRoutes(wallet: Wallet): WalletRoute[] {
  return [
    {
      method: "GET",
      path: "/wallet/solana/pubkey",
      handler: ({ signal }) => replied(
        Effect.map(wallet.status(), (status) => {
          const sol = status.accounts.find((a) => a.family === "solana")
          return { pubkey: sol?.address ?? "", connected: sol?.connected ?? false, custody: status.custody }
        }),
        signal,
      ),
    },
    { method: "POST", path: "/wallet/solana/sign-message", maxBodyBytes: 4096, handler: () => signReviewRequired("solana", "sign-message") },
    { method: "POST", path: "/wallet/solana/sign-transaction", maxBodyBytes: 8192, handler: () => signReviewRequired("solana", "sign-transaction") },
    { method: "POST", path: "/wallet/solana/sign-all-transactions", maxBodyBytes: 16384, handler: () => signReviewRequired("solana", "sign-all-transactions") },
    { method: "POST", path: "/wallet/solana/sign-and-send-transaction", maxBodyBytes: 8192, handler: () => signReviewRequired("solana", "sign-and-send-transaction") },
  ]
}

export function walletRoutes(wallet: Wallet, overviewOptions: WalletMarketOverviewOptions = {}): WalletRoute[] {
  return [
    { method: "GET", path: walletPaths.wallet, handler: ({ signal }) => replied(wallet.status(), signal) },
    { method: "POST", path: walletPaths.wallet, maxBodyBytes: 64, handler: ({ signal }) => replied(wallet.create(), signal) },
    {
      method: "POST", path: walletPaths.switch, maxBodyBytes: 64,
      handler: ({ body, signal }) => {
        const sent = Option.getOrUndefined(switchBody(body ?? {}))
        return sent === undefined ? malformed : replied(wallet.switchTo(sent.on), signal)
      },
    },
    { method: "GET", path: walletPaths.holdings, handler: ({ signal }) => replied(wallet.holdings(), signal) },
    { method: "GET", path: walletPaths.activity, handler: ({ signal }) => replied(Effect.map(wallet.activity(), (operations) => ({ operations })), signal) },
    { method: "GET", path: walletPaths.requests, handler: ({ signal }) => replied(Effect.map(wallet.requests(), (requests) => ({ requests })), signal) },
    {
      method: "POST", path: walletPaths.requests, maxBodyBytes: 1024,
      handler: ({ body, signal }) => {
        const sent = Option.getOrUndefined(askBody(body ?? {}))
        const family = familyOf(sent?.family ?? "")
        if (sent === undefined || family === undefined) return malformed
        return replied(wallet.ask({ family, token: sent.token ?? "", recipient: sent.recipient.trim(), amount: sent.amount.trim() }, "OwnerAsks"), signal)
      },
    },
    {
      method: "POST", path: "/api/wallet/requests/{id}/review", maxBodyBytes: 64,
      handler: ({ parameters, signal }) => {
        const id = requestId(parameters)
        return id === undefined ? malformed : replied(wallet.review(id), signal)
      },
    },
    {
      method: "POST", path: "/api/wallet/requests/{id}/decide", maxBodyBytes: 1024,
      handler: ({ parameters, body, signal }) => {
        const id = requestId(parameters)
        const sent = Option.getOrUndefined(decideBody(body ?? {}))
        return id === undefined || sent === undefined ? malformed : replied(wallet.decide(id, sent), signal)
      },
    },
    { method: "GET", path: "/api/wallet/market-overview", handler: () => handleWalletMarketOverviewRoute(overviewOptions) },
    ...evmSignRoutes(wallet),
    ...solanaSignRoutes(wallet),
  ]
}
