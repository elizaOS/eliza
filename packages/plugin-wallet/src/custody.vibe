// spec/wallet/index.md, "A submitted operation retains one durable binding through reconciliation"; spec/wallet/index.md, "A review binds the complete immutable wallet operation"
import type { WalletFamily } from "../gen/wallet.effect.vibe"

export type WalletConfiguration =
  | { readonly family: "EvmWallet"; readonly rpc: string; readonly chainId: string; readonly privateKey: string }
  | { readonly family: "SolanaWallet"; readonly rpc: string; readonly chainId: string; readonly privateKey: string }

export interface NativeTransfer {
  readonly recipient: string
  readonly atomicUnits: string
}

export interface SignedSubmission {
  readonly operationRef: string
  broadcast(): Promise<void>
}

export interface WalletCustodian {
  readonly family: WalletFamily
  readonly chainId: string
  readonly account: string
  readonly supportsNativeSigning: boolean
  recipient(input: string): string
  balance(): Promise<string>
  estimate(transfer: NativeTransfer): Promise<string>
  sign(transfer: NativeTransfer, maximumFee: string): Promise<SignedSubmission>
  receipt(operationRef: string): Promise<"confirmed" | "failed" | "unresolved">
  close(): void
}

module node {
  import { Contract, JsonRpcProvider, Wallet, getAddress, keccak256 } from "ethers"
  import { Connection, Keypair, PublicKey, SystemProgram, Transaction } from "@solana/web3.js"
  import bs58 from "bs58"
  import { createHash, randomUUID } from "node:crypto"
  import { constants } from "node:fs"
  import { link, mkdir, open, readFile, unlink } from "node:fs/promises"
  import { dirname, join } from "node:path"
  import type { NativeTransfer, WalletConfiguration, WalletCustodian } from "./custody.vibe"
  import type { WalletRun } from "../gen/wallet.ts"

  export function walletDigest(parts: readonly string[]): string {
    return createHash("sha256").update(JSON.stringify(parts)).digest("hex")
  }

  function supportedEvmSigning(chainId: string, address: string): boolean {
    if (chainId === "1" || chainId === "11155111") return true
    if (chainId !== "31337" && chainId !== "1337") return false
    const rpc = new URL(address)
    return ["http:", "https:"].includes(rpc.protocol) && ["localhost", "127.0.0.1", "[::1]"].includes(rpc.hostname)
  }

  export async function openWallet(configuration: WalletConfiguration): Promise<WalletCustodian> {
    if (configuration.family === "EvmWallet") {
      const provider = new JsonRpcProvider(configuration.rpc)
      try {
        const network = await provider.getNetwork()
        if (String(network.chainId) !== configuration.chainId) throw new Error("Wallet RPC answered from a different EVM chain")
        const signer = new Wallet(configuration.privateKey, provider)
        const transaction = (transfer: NativeTransfer) => ({ to: transfer.recipient, value: BigInt(transfer.atomicUnits) })
        return {
          family: "EvmWallet",
          chainId: configuration.chainId,
          account: signer.address,
          supportsNativeSigning: supportedEvmSigning(configuration.chainId, configuration.rpc),
          recipient: getAddress,
          balance: async () => (await provider.getBalance(signer.address)).toString(),
          estimate: async (transfer) => (await signer.estimateGas(transaction(transfer))).toString(),
          sign: async (transfer, maximumFee) => {
            if (!supportedEvmSigning(configuration.chainId, configuration.rpc)) throw new Error("The EVM chain has no supported total-fee policy")
            const prepared = await signer.populateTransaction(transaction(transfer))
            const feePrice = prepared.type === 0 ? prepared.gasPrice : prepared.type === 2 ? prepared.maxFeePerGas : undefined
            if (String(prepared.chainId) !== configuration.chainId || prepared.gasLimit == null || feePrice == null) {
              throw new Error("The transaction lacks a verifiable chain and execution fee")
            }
            const units = BigInt(prepared.gasLimit)
            const price = BigInt(feePrice)
            if (units <= 0n || price < 0n || units * price > BigInt(maximumFee)) {
              throw new Error("The transaction exceeds the reviewed fee budget")
            }
            const raw = await signer.signTransaction(prepared)
            return { operationRef: keccak256(raw), broadcast: async () => { await provider.broadcastTransaction(raw) } }
          },
          receipt: async (operationRef) => {
            const found = await provider.getTransactionReceipt(operationRef)
            if (found === null || found.hash.toLowerCase() !== operationRef.toLowerCase()) return "unresolved"
            const finalized = await provider.getBlock("finalized")
            if (finalized === null || finalized.number < found.blockNumber) return "unresolved"
            const included = await provider.getBlock(found.blockNumber)
            if (included === null || included.hash !== found.blockHash) return "unresolved"
            return found.status === 1 ? "confirmed" : found.status === 0 ? "failed" : "unresolved"
          },
          close: () => provider.destroy(),
        }
      } catch (failure) {
        provider.destroy()
        throw failure
      }
    }
    const connection = new Connection(configuration.rpc, "confirmed")
    const actualChain = await connection.getGenesisHash()
    if (actualChain !== configuration.chainId) throw new Error("Wallet RPC answered from a different Solana chain")
    const signer = Keypair.fromSecretKey(bs58.decode(configuration.privateKey))
    const build = async (transfer: NativeTransfer) => {
      const block = await connection.getLatestBlockhash()
      return new Transaction({ ...block, feePayer: signer.publicKey }).add(SystemProgram.transfer({
        fromPubkey: signer.publicKey, toPubkey: new PublicKey(transfer.recipient), lamports: BigInt(transfer.atomicUnits),
      }))
    }
    return {
      family: "SolanaWallet",
      chainId: actualChain,
      account: signer.publicKey.toBase58(),
      supportsNativeSigning: true,
      recipient: (input) => new PublicKey(input).toBase58(),
      balance: async () => {
        const lamports = await connection.getBalance(signer.publicKey, "confirmed")
        if (!Number.isSafeInteger(lamports)) throw new Error("The Solana RPC balance exceeded its exact integer range")
        return String(lamports)
      },
      estimate: async (transfer) => {
        const response = await connection.getFeeForMessage((await build(transfer)).compileMessage(), "confirmed")
        if (response.value === null || !Number.isSafeInteger(response.value)) throw new Error("Solana RPC did not supply an exact fee")
        return String(response.value)
      },
      sign: async (transfer, maximumFee) => {
        if (await connection.getGenesisHash() !== actualChain) throw new Error("The Solana chain changed before signing")
        const tx = await build(transfer)
        const fee = await connection.getFeeForMessage(tx.compileMessage(), "confirmed")
        if (fee.value === null || !Number.isSafeInteger(fee.value) || BigInt(fee.value) > BigInt(maximumFee)) {
          throw new Error("The transaction exceeds the reviewed fee budget")
        }
        tx.sign(signer)
        if (!tx.signature) throw new Error("Solana signer did not produce a signature")
        const operationRef = bs58.encode(tx.signature)
        const raw = tx.serialize()
        return { operationRef, broadcast: async () => {
          if (await connection.getGenesisHash() !== actualChain) throw new Error("The Solana chain changed before broadcast")
          await connection.sendRawTransaction(raw, { maxRetries: 0 })
        } }
      },
      receipt: async (operationRef) => {
        const receipt = (await connection.getSignatureStatuses([operationRef], { searchTransactionHistory: true })).value[0]
        if (!receipt || receipt.confirmationStatus !== "finalized") return "unresolved"
        return receipt.err ? "failed" : "confirmed"
      },
      close: () => {},
    }
  }

  export async function evmTokenBalance(rpc: string, account: string, token: string, chainId: string): Promise<string> {
    const provider = new JsonRpcProvider(rpc)
    try {
      if (String((await provider.getNetwork()).chainId) !== chainId) throw new Error("Wallet RPC answered from a different EVM chain")
      const contract = new Contract(getAddress(token), ["function balanceOf(address) view returns (uint256)"], provider)
      const value: unknown = await contract.getFunction("balanceOf").staticCall(getAddress(account))
      if (typeof value !== "bigint") throw new Error("Token balance was malformed")
      return String(value)
    } finally {
      provider.destroy()
    }
  }

  function missing(error: unknown): boolean {
    return typeof error === "object" && error !== null && "code" in error && error.code === "ENOENT"
  }

  type JournalPhase = "reservation" | "submission"

  function journalFile(directory: string, intentId: string, phase: JournalPhase): string {
    const suffix = phase === "reservation" ? ".reservation.json" : ".json"
    return join(directory, walletDigest([intentId]) + suffix)
  }

  async function readJournal(directory: string, intentId: string, phase: JournalPhase): Promise<unknown> {
    try {
      return JSON.parse(await readFile(journalFile(directory, intentId, phase), "utf8"))
    } catch (error) {
      if (missing(error)) return undefined
      throw error
    }
  }

  export function readDispatch(directory: string, intentId: string): Promise<unknown> {
    return readJournal(directory, intentId, "submission")
  }

  export function readSigningReservation(directory: string, intentId: string): Promise<unknown> {
    return readJournal(directory, intentId, "reservation")
  }

  async function syncDirectory(directory: string): Promise<void> {
    const folder = await open(directory, constants.O_RDONLY)
    try {
      await folder.sync()
    } finally {
      await folder.close()
    }
  }

  function exists(error: unknown): boolean {
    return typeof error === "object" && error !== null && "code" in error && error.code === "EEXIST"
  }

  async function createDurableChild(directory: string): Promise<void> {
    try {
      await mkdir(directory, { mode: 0o700 })
    } catch (error) {
      if (!exists(error)) throw error
    }
    await syncDirectory(dirname(directory))
  }

  async function writeExclusive(directory: string, record: WalletRun, phase: JournalPhase): Promise<boolean> {
    const temp = join(directory, randomUUID() + ".tmp")
    const file = await open(temp, "wx", 0o600)
    try {
      try {
        await file.writeFile(JSON.stringify(record))
        await file.sync()
      } finally {
        await file.close()
      }
      try {
        await link(temp, journalFile(directory, record.intent.intentId, phase))
      } catch (error) {
        if (exists(error)) return false
        throw error
      }
      await syncDirectory(directory)
      return true
    } finally {
      await unlink(temp)
    }
  }

  export async function reserveWalletSigning(directory: string, record: WalletRun): Promise<boolean> {
    await createDurableChild(dirname(directory))
    await createDurableChild(directory)
    return writeExclusive(directory, record, "reservation")
  }

  export function claimDispatch(directory: string, record: WalletRun): Promise<boolean> {
    return writeExclusive(directory, record, "submission")
  }

  export function walletJournalDirectory(stateDirectory: string, agentId: string): string {
    return join(stateDirectory, "wallet", walletDigest([agentId]))
  }
}
export { claimDispatch, evmTokenBalance, openWallet, readDispatch, readSigningReservation, reserveWalletSigning, walletDigest, walletJournalDirectory } from node
