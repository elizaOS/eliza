export function sumWalletBalancesUsd(legs: readonly WalletBalanceLeg[]): number {
  return legs.reduce((acc, leg) => acc + (leg.priced && Number.isFinite(leg.balanceUsd) ? leg.balanceUsd : 0), 0)
}

export function walletIdentityKey(accounts: { readonly evm?: string; readonly solana?: string }): string {
  return `${(accounts.evm ?? "").trim().toLowerCase()}|${(accounts.solana ?? "").trim()}`
}

export function walletIdentitySwitched(previous: WalletBalanceBaseline | undefined, currentIdentityKey: string): boolean {
  return previous !== undefined && previous.identityKey !== currentIdentityKey
}

export function pricedCoverageFlips(previous: readonly WalletBalanceLeg[], current: readonly WalletBalanceLeg[]): boolean {
  const prevPriced = new Set(previous.filter((l) => l.priced).map((l) => `${l.chain}:${l.assetId}`))
  const currPriced = new Set(current.filter((l) => l.priced).map((l) => `${l.chain}:${l.assetId}`))
  if (prevPriced.size !== currPriced.size) return true
  for (const key of prevPriced) if (!currPriced.has(key)) return true
  return false
}

export function resolveThresholds(overrides?: Partial<WalletBalanceDeltaThresholds>): WalletBalanceDeltaThresholds {
  return {
    minDeltaUsd: overrides?.minDeltaUsd !== undefined && overrides.minDeltaUsd >= 0 ? overrides.minDeltaUsd : DEFAULT_MIN_DELTA_USD,
    thresholdPct: overrides?.thresholdPct !== undefined && overrides.thresholdPct >= 0 ? overrides.thresholdPct : DEFAULT_THRESHOLD_PCT,
  }
}

export function evaluateWalletBalanceDelta(
  previous: WalletBalanceBaseline | undefined,
  current: WalletBalanceBaseline,
  thresholds: WalletBalanceDeltaThresholds = resolveThresholds(),
): WalletBalanceDeltaResult {
  const switched = walletIdentitySwitched(previous, current.identityKey)
  if (previous === undefined || switched) {
    return { identitySwitched: switched, coverageFlipped: false, previousUsd: 0, currentUsd: current.totalUsd, deltaUsd: 0, deltaPct: 0, significant: false }
  }
  const coverageFlipped = pricedCoverageFlips(previous.legs, current.legs)
  const deltaUsd = current.totalUsd - previous.totalUsd
  const deltaPct = previous.totalUsd > 0 ? (Math.abs(deltaUsd) / previous.totalUsd) * 100 : (Math.abs(deltaUsd) > 0 ? 100 : 0)
  const significant = !coverageFlipped && Math.abs(deltaUsd) >= thresholds.minDeltaUsd && deltaPct >= thresholds.thresholdPct
  return { identitySwitched: false, coverageFlipped, previousUsd: previous.totalUsd, currentUsd: current.totalUsd, deltaUsd, deltaPct, significant }
}

export function buildWalletBalanceDeltaTaskInput(agentId: string, intervalMinutes = WALLET_BALANCE_DELTA_INTERVAL_MINUTES) {
  return {
    name: WALLET_BALANCE_DELTA_CHANNEL,
    groupKey: WALLET_BALANCE_DELTA_GROUP_KEY,
    idempotencyKey: `${WALLET_BALANCE_DELTA_TASK_IDEMPOTENCY_KEY}:${agentId}`,
    intervalMs: Math.max(1, intervalMinutes) * 60_000,
  }
}
