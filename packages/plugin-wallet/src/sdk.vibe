// spec/wallet/index.md, "Story: Enforce exact spend limits when making a payment"; spec/wallet/index.md, "A chain amount compares exactly at every digit"
import { ElizaError } from "@elizaos/core"
import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import { atMostAtomic, validAtomicAmount, walletPaymentFits } from "../gen/wallet.effect.vibe"
import { raise, sha256Hex, toBigInt } from "./policy.vibe"

export const NATIVE_TOKEN = "0x0000000000000000000000000000000000000000"

export const AgentAccountFactoryV2Abi = [
  "function createAccount(address owner, address operator, uint256 salt) returns (address)",
  "function getAccount(address owner, uint256 salt) view returns (address)",
] as const

export const AgentAccountV2Abi = [
  "function agentExecute(address to, uint256 value, bytes data) returns (bytes)",
  "function approveTransaction(uint256 txId)",
  "function cancelTransaction(uint256 txId)",
  "function setSpendPolicy(uint256 perTxLimit, uint256 dailyLimit)",
  "function pendingNonce() view returns (uint256)",
] as const

export interface TokenEntry {
  readonly symbol: string
  readonly name: string
  readonly address: string
  readonly decimals: number
  readonly chainId: number | string
  readonly isNative?: boolean
  readonly isStablecoin?: boolean
}

export class TokenRegistry {
  private readonly entries = new Map<string, TokenEntry>()

  constructor(initial: readonly TokenEntry[] = []) {
    for (const entry of initial) this.add(entry)
  }

  add(entry: TokenEntry): void {
    this.entries.set(`${entry.chainId}:${entry.symbol.toUpperCase()}`, entry)
    this.entries.set(`${entry.chainId}:${entry.address.toLowerCase()}`, entry)
  }

  find(chainId: number | string, symbolOrAddress: string): TokenEntry | undefined {
    return this.entries.get(`${chainId}:${symbolOrAddress.toUpperCase()}`)
      ?? this.entries.get(`${chainId}:${symbolOrAddress.toLowerCase()}`)
  }

  list(chainId?: number | string): TokenEntry[] {
    const seen = new Set<string>()
    const out: TokenEntry[] = []
    for (const entry of this.entries.values()) {
      if (chainId !== undefined && String(entry.chainId) !== String(chainId)) continue
      const key = `${entry.chainId}:${entry.address.toLowerCase()}`
      if (seen.has(key)) continue
      seen.add(key)
      out.push(entry)
    }
    return out
  }
}

