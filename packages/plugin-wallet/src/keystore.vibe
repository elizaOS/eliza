// spec/wallet/custody.md, "Only the owner makes the wallet, once, with an account for each family"
export interface WalletKeys {
  readonly evmKey: string
  readonly solanaSeed: Uint8Array
}

export interface Keystore {
  readonly seals: boolean
  read(): Promise<WalletKeys | undefined>
  keep(keys: WalletKeys): Promise<WalletKeys>
}

module node {
  import { createCipheriv, createDecipheriv, hkdfSync, randomBytes } from "node:crypto"
  import { link, mkdir, open, readFile, unlink } from "node:fs/promises"
  import { join } from "node:path"
  import type { Keystore, WalletKeys } from "./keystore.vibe"

  const marker = "wallet-keys-v1."
  const ivBytes = 12
  const tagBytes = 16

  function coded(error: unknown, code: string): boolean {
    return typeof error === "object" && error !== null && "code" in error && error.code === code
  }

  function unsealed(text: string): WalletKeys {
    const parsed: unknown = JSON.parse(text)
    const evmKey = typeof parsed === "object" && parsed !== null && "evm" in parsed ? parsed.evm : undefined
    const seed = typeof parsed === "object" && parsed !== null && "solana" in parsed ? parsed.solana : undefined
    if (typeof evmKey !== "string" || !/^0x[0-9a-f]{64}$/.test(evmKey) || typeof seed !== "string") throw new Error("The sealed wallet keys are not readable")
    const solanaSeed = new Uint8Array(Buffer.from(seed, "base64"))
    if (solanaSeed.length !== 32) throw new Error("The sealed wallet keys are not readable")
    return { evmKey, solanaSeed }
  }

  export function newSolanaSeed(): Uint8Array {
    return new Uint8Array(randomBytes(32))
  }

  export function storageKeyBytes(storageKey: string | undefined): Uint8Array | undefined {
    if (storageKey === undefined) return undefined
    const bytes = Buffer.from(storageKey, "base64")
    const canonical = bytes.toString("base64") === storageKey || bytes.toString("base64url") === storageKey
    return canonical && bytes.length === 32 ? new Uint8Array(bytes) : undefined
  }

  export function openKeystore(directory: string, master: Uint8Array | undefined, agentId: string): Keystore {
    const scope = Buffer.from(JSON.stringify(["wallet-keys", agentId, "v1"]))
    const key = master === undefined ? undefined : Buffer.from(hkdfSync("sha256", master, Buffer.alloc(0), scope, 32))
    const file = join(directory, "keys.sealed")
    const read = async (): Promise<WalletKeys | undefined> => {
      let sealed: string
      try {
        sealed = (await readFile(file, "utf8")).trimEnd()
      } catch (error) {
        if (coded(error, "ENOENT")) return undefined
        throw error
      }
      const bytes = Buffer.from(sealed.slice(marker.length), "base64url")
      if (key === undefined || !sealed.startsWith(marker) || bytes.length < ivBytes + tagBytes) throw new Error("The sealed wallet keys cannot be opened on this launch")
      const opener = createDecipheriv("aes-256-gcm", key, bytes.subarray(0, ivBytes))
      opener.setAAD(scope)
      opener.setAuthTag(bytes.subarray(bytes.length - tagBytes))
      return unsealed(Buffer.concat([opener.update(bytes.subarray(ivBytes, bytes.length - tagBytes)), opener.final()]).toString("utf8"))
    }
    return {
      seals: key !== undefined,
      read,
      keep: async (keys) => {
        if (key === undefined) throw new Error("This launch gave no storage key to seal a wallet under")
        const iv = randomBytes(ivBytes)
        const sealer = createCipheriv("aes-256-gcm", key, iv)
        sealer.setAAD(scope)
        const body = Buffer.concat([sealer.update(JSON.stringify({ evm: keys.evmKey, solana: Buffer.from(keys.solanaSeed).toString("base64") }), "utf8"), sealer.final()])
        await mkdir(directory, { recursive: true, mode: 0o700 })
        const temp = join(directory, `keys.${randomBytes(6).toString("hex")}.tmp`)
        const handle = await open(temp, "wx", 0o600)
        try {
          try {
            await handle.writeFile(marker + Buffer.concat([iv, body, sealer.getAuthTag()]).toString("base64url") + "\n")
            await handle.sync()
          } finally {
            await handle.close()
          }
          try {
            await link(temp, file)
          } catch (error) {
            if (!coded(error, "EEXIST")) throw error
          }
        } finally {
          await unlink(temp)
        }
        const kept = await read()
        if (kept === undefined) throw new Error("The sealed wallet keys did not stay on the device")
        return kept
      },
    }
  }
}
export { newSolanaSeed, openKeystore, storageKeyBytes } from node
