// spec/wallet/custody.md, "Story: Hold my own keys on my device"; spec/wallet/requests.md, "Story: Let the agent ask, and decide myself"; spec/wallet/index.md, "Story: Preview an exact wallet operation before executing it"; spec/wallet/index.md, "Story: Recover the real outcome of an on-chain operation"; spec/wallet/index.md, "Story: Inspect wallet holdings and venue quotes before making changes"
import { ModuleRefused, type AgentModule, type AgentPlugin, type ModuleFactory } from "@elizaos/agent"
import type { IAgentRuntime } from "@elizaos/core"
import { walletAction, walletProvider } from "./agent.vibe"
import { storageKeyBytes } from "./keystore.vibe"
import { walletRoutes } from "./routes.vibe"
import { openWallet, type Wallet, type WalletHost } from "./wallet.vibe"

export const walletModuleName = "@elizaos/plugin-wallet"

export { walletActionName } from "./agent.vibe"
export { walletRoutes, type WalletRoute } from "./routes.vibe"
export {
  WalletRefused, WalletUnreachable, openWallet,
  type CustodyState, type Wallet, type WalletAccount, type WalletContext, type WalletDecided, type WalletDecision, type WalletHolding, type WalletHoldings,
  type WalletHost, type WalletOperation, type WalletQuote, type WalletRequestRow, type WalletReview, type WalletStatus, type WalletTransferInput,
} from "./wallet.vibe"

export function walletPlugin(wallet: Wallet, ownerId: string): AgentPlugin {
  return {
    name: walletModuleName,
    description: "The owner's wallet: one EVM and one Solana account with keys sealed on the device, holdings, exact transfer quotes, transfers the owner reviews and approves, and their reconciled outcomes.",
    contexts: ["wallet"],
    actions: [walletAction(wallet, ownerId)],
    providers: [walletProvider(wallet, ownerId)],
    routes: walletRoutes(wallet),
  }
}

export const walletModule: ModuleFactory<FileSystem.FileSystem | Path.Path> = effect (context) => {
  const refusal = (reason: string) => new ModuleRefused({ module: walletModuleName, reason })
  const runtime: IAgentRuntime = context.runtime
  const storageKey = context.storageKey
  const sealed = storageKey === undefined ? undefined
    : try Effect.try({ try: () => storageKeyBytes(Redacted.value(storageKey)), catch: () => refusal("The launch storage key could not be read") })
  const host: WalletHost = {
    agentId: runtime.agentId,
    ownerId: context.ownerEntityId,
    stateDirectory: context.stateDirectory,
    storageKey: sealed,
    setting: (key) => {
      const value = runtime.getSetting(key)
      return typeof value === "string" ? value.trim() : ""
    },
    ownerPresent: () => Promise.resolve(true),
  }
  const wallet = openWallet(host) catch effect () => { throw refusal("The wallet's state on this device could not be opened") }
  return { name: walletModuleName, plugin: walletPlugin(wallet, context.ownerEntityId) } satisfies AgentModule
}
