export class NoMatchingLpProtocolError extends ElizaError {
  constructor(protocol: string) {
    super(`No matching LP protocol service registered for "${protocol}".`, { code: "LP_PROTOCOL_NOT_FOUND", context: { protocol } })
  }
}

export class DexInteractionService extends Service {
  static override serviceType = "dex_interaction"
  override capabilityDescription = "Unified router across EVM and Solana concentrated liquidity protocol adapters"
  private readonly adapters: ReadonlyMap<LpProtocolName, BaseLpProtocolService>

  constructor(runtime?: IAgentRuntime) {
    super(runtime)
    this.adapters = new Map<LpProtocolName, BaseLpProtocolService>([
      ["uniswap-v3", new UniswapV3LpService(runtime)],
      ["aerodrome", new AerodromeLpService(runtime)],
      ["pancakeswap-v3", new PancakeSwapV3LpService(runtime)],
      ["raydium", new RaydiumService(runtime)],
      ["orca", new OrcaService(runtime)],
      ["meteora", new MeteoraLpService(runtime)],
    ])
  }

  static override async start(runtime: IAgentRuntime): Promise<Service> { return new DexInteractionService(runtime) }
  override async stop(): Promise<void> {}

  adapter(protocol: LpProtocolName): BaseLpProtocolService {
    const found = this.adapters.get(protocol)
    if (found === undefined) {
      raise(new NoMatchingLpProtocolError(protocol))
    }
    return found
  }

  allPositions(): LpPosition[] {
    return [...this.adapters.values()].flatMap((svc) => svc.listPositions())
  }
}

export class ConcentratedLiquidityService extends Service {
  static override serviceType = "concentrated_liquidity"
  override capabilityDescription = "Concentrated liquidity position range math and management"
  readonly dex: DexInteractionService

  constructor(runtime?: IAgentRuntime, dex?: DexInteractionService) {
    super(runtime)
    this.dex = dex ?? new DexInteractionService(runtime)
  }

  static override async start(runtime: IAgentRuntime): Promise<Service> { return new ConcentratedLiquidityService(runtime) }
  override async stop(): Promise<void> {}
}

export class YieldOptimizationService extends Service {
  static override serviceType = "yield_optimization"
  override capabilityDescription = "Ranks LP opportunities by net APR and minimum TVL safety thresholds"

  static override async start(runtime: IAgentRuntime): Promise<Service> { return new YieldOptimizationService(runtime) }
  override async stop(): Promise<void> {}

  rankOpportunities(pools: readonly LpPoolOpportunity[], minTvlUsd = 50_000): LpPoolOpportunity[] {
    return pools
      .filter((p) => p.tvlUsd >= minTvlUsd && Number.isFinite(p.aprPct))
      .sort((a, b) => b.aprPct - a.aprPct)
  }
}

export class UserLpProfileService extends Service {
  static override serviceType = "user_lp_profile"
  override capabilityDescription = "Tracks owner LP risk profile, auto-rebalance preference, and max slippage"
  private readonly profiles = new Map<string, { readonly maxSlippageBps: number; readonly minTvlUsd: number; readonly autoRebalance: boolean }>()

  static override async start(runtime: IAgentRuntime): Promise<Service> { return new UserLpProfileService(runtime) }
  override async stop(): Promise<void> {}

  getProfile(userId: string) {
    return this.profiles.get(userId) ?? { maxSlippageBps: 100, minTvlUsd: 100_000, autoRebalance: false }
  }

  setProfile(userId: string, profile: { readonly maxSlippageBps: number; readonly minTvlUsd: number; readonly autoRebalance: boolean }): void {
    this.profiles.set(userId, profile)
  }
}

export class VaultService extends Service {
  static override serviceType = "wallet_vault"
  override capabilityDescription = "Manages non-custodial yield vault deposits and withdrawals"
  private readonly balances = new Map<string, number>()

  static override async start(runtime: IAgentRuntime): Promise<Service> { return new VaultService(runtime) }
  override async stop(): Promise<void> {}

  deposit(vaultId: string, amountUsd: number): number {
    const next = (this.balances.get(vaultId) ?? 0) + Math.max(0, amountUsd)
    this.balances.set(vaultId, next)
    return next
  }

  withdraw(vaultId: string, amountUsd: number): number {
    const current = this.balances.get(vaultId) ?? 0
    const next = Math.max(0, current - Math.max(0, amountUsd))
    this.balances.set(vaultId, next)
    return next
  }

  balanceOf(vaultId: string): number {
    return this.balances.get(vaultId) ?? 0
  }
}

export const stewardTradingProvider: Provider = createDynamicWalletProvider({
  name: "STEWARD_TRADING",
  description: "Current trading policy limits, daily trade count, and recent trade executions",
  descriptionCompressed: "Trading limits & recent trades",
  get: async (runtime): Promise<ProviderResult> => {
    const svc = runtime.getService<StewardTradingService>(STEWARD_TRADING_SERVICE_TYPE) ?? new StewardTradingService(runtime)
    const st = svc.policy.status()
    const recent = svc.history().slice(-5)
    return {
      text: `Trading policy: ${st.paused ? "PAUSED" : "active"}, spent ${st.dailySpent}/${st.dailyLimit}, trades ${st.dailyTxCount}/${st.maxDailyTxs}, max slippage ${st.maxSlippageBps} bps. Recent trades: ${recent.length}.`,
      values: { tradingPaused: st.paused, dailyTradeCount: st.dailyTxCount },
      data: { policy: st, recentTrades: recent },
    }
  },
})

