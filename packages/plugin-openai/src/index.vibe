// spec/openai/index.md, "Story: Use an OpenAI-compatible model for the requested capability"
import { ModelType, VECTOR_DIMS, type GenerateTextParams, type IAgentRuntime, type ImageDescriptionParams, type Plugin, type TextStreamResult, type TokenUsage } from "@elizaos/core"
import { Cause, Effect, Exit, Fiber, Queue, Schema, Stream } from "effect"
import * as Sse from "effect/encoding/Sse"
import { Machine, machine, type OpenAiAttempt, openAiModelId, openAiTokenizerKey, suitableOpenAiEndpoint } from "../gen/openai.effect.vibe"

module node {
  import { fetchRemoteMedia, fetchWithConfidentialInference } from "@elizaos/core"
  import { getEncoding, type TiktokenEncoding } from "js-tiktoken"

  const encodings = new Map<TiktokenEncoding, ReturnType<typeof getEncoding>>()
  export function encodingFor(name: TiktokenEncoding) {
    const known = encodings.get(name)
    if (known) return known
    const encoding = getEncoding(name)
    encodings.set(name, encoding)
    return encoding
  }

  export function postOpenAi(address: string, key: string, payload: object, signal: AbortSignal, timeoutMs?: number) {
    return fetchWithConfidentialInference(address, {
      method: "POST", redirect: "error",
      signal: timeoutMs === undefined ? signal : AbortSignal.any([signal, AbortSignal.timeout(timeoutMs)]),
      headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    }, globalThis.fetch)
  }

  export async function transcribeOpenAi(address: string, key: string, source: string | Uint8Array, model: string, signal: AbortSignal) {
    const bytes = typeof source === "string"
      ? (await fetchRemoteMedia({ url: source, maxBytes: 26214400, signal })).buffer
      : source
    const body = new FormData()
    body.set("model", model)
    body.set("file", new Blob([Uint8Array.from(bytes)]), "audio.wav")
    return globalThis.fetch(address, { method: "POST", redirect: "error", signal, headers: { Authorization: `Bearer ${key}` }, body })
  }
}
import { encodingFor, postOpenAi, transcribeOpenAi } from node

export error OpenAiFailure { reason: string; retryable: boolean }

function setting(runtime: IAgentRuntime, name: string): string {
  const value = runtime.getSetting(name)
  return typeof value === "string" ? value.trim() : ""
}

function callOpenAi(runtime: IAgentRuntime, path: string, body: object, selectedAddress?: string) {
  const base = (selectedAddress ?? (setting(runtime, "OPENAI_BASE_URL") || "https://api.openai.com/v1")).replace(/\/+$/, "")
  return effect {
    const key = setting(runtime, "OPENAI_API_KEY")
    if (key === "" && setting(runtime, "OPENAI_BASE_URL") === "") throw new OpenAiFailure({ reason: "No OpenAI connection is configured.", retryable: false })
    const response = try tryPromise({
      try: (signal) => postOpenAi(base + path, key, body, signal, 120000),
      catch: () => new OpenAiFailure({ reason: "The OpenAI endpoint could not be reached.", retryable: true }),
    })
    if (!response.ok) {
      try Effect.ignore(tryPromise(async () => { await response.body?.cancel() }))
      throw new OpenAiFailure({ reason: `OpenAI endpoint returned HTTP ${response.status}.`, retryable: response.status === 408 || response.status === 409 || response.status === 429 || response.status >= 500 })
    }
    return response
  }
}

effect function jsonPost(runtime: IAgentRuntime, path: string, body: object, selectedAddress?: string) {
  const response = try callOpenAi(runtime, path, body, selectedAddress)
  return try tryPromise({
    try: (): Promise<unknown> => response.json(),
    catch: () => new OpenAiFailure({ reason: "OpenAI response was not JSON.", retryable: false }),
  })
}

const usageSchema = Schema.Struct({
  prompt_tokens: Schema.Int, completion_tokens: Schema.Int, total_tokens: Schema.Int,
  prompt_tokens_details: Schema.optionalKey(Schema.Unknown),
  completion_tokens_details: Schema.optionalKey(Schema.Unknown),
})
type OpenAiUsage = typeof usageSchema.Type

function reportedTokens(details: unknown, key: string): number | undefined {
  if (typeof details !== "object" || details === null || !Object.hasOwn(details, key)) return undefined
  const value = (details as Record<string, unknown>)[key]
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value : undefined
}

// spec/openai/index.md, "Reported cache and reasoning token counts survive completion decoding"
function usageOf(usage: OpenAiUsage): TokenUsage {
  const cached = reportedTokens(usage.prompt_tokens_details, "cached_tokens")
  const reasoning = reportedTokens(usage.completion_tokens_details, "reasoning_tokens")
  return {
    promptTokens: usage.prompt_tokens, completionTokens: usage.completion_tokens, totalTokens: usage.total_tokens,
    ...(cached === undefined ? {} : { cacheReadInputTokens: cached }),
    ...(reasoning === undefined ? {} : { reasoningTokens: reasoning }),
  }
}
const streamFrameSchema = Schema.Struct({
  choices: Schema.Array(Schema.Struct({
    delta: Schema.Struct({ content: Schema.optionalKey(Schema.NullOr(Schema.String)) }),
    finish_reason: Schema.optionalKey(Schema.NullOr(Schema.String)),
  })),
  usage: Schema.optionalKey(Schema.NullOr(usageSchema)),
})
const streamFrame = Schema.decodeUnknownEffect(Schema.fromJsonString(streamFrameSchema))

function observed<T>(promise: Promise<T>): Promise<T> {
  void promise.catch(() => undefined)
  return promise
}

interface OpenAiStreamCompletion {
  readonly text: string
  readonly reason?: string | undefined
  readonly usage?: TokenUsage | undefined
}

function whenCancelled(signal: AbortSignal): Effect.Effect<never> {
  return Effect.callback<never>((resume) => {
    const abort = () => resume(Effect.interrupt)
    if (signal.aborted) {
      abort()
      return
    }
    signal.addEventListener("abort", abort, { once: true })
    return Effect.sync(() => signal.removeEventListener("abort", abort))
  })
}

function streamResult<E>(fiber: Fiber.Fiber<OpenAiStreamCompletion, E>, queue: Queue.Queue<string, OpenAiFailure | Cause.Done>): TextStreamResult {
  const completion = observed(Effect.runPromise(Fiber.join(fiber)))
  return {
    textStream: Stream.toAsyncIterable(Stream.fromQueue(queue)),
    text: observed(completion.then((result) => result.text)),
    finishReason: observed(completion.then((result) => result.reason)),
    usage: observed(completion.then((result) => result.usage)),
  }
}

effect function streamAnswer(response: Response, model: Machine.Shape, attempt: OpenAiAttempt, signal?: AbortSignal) {
  if (response.body === null || response.headers.get("content-type")?.split(";", 1)[0]?.trim().toLowerCase() !== "text/event-stream") {
    try Effect.ignore(tryPromise(async () => { await response.body?.cancel() }))
    throw new OpenAiFailure({ reason: "OpenAI did not return a completion event stream.", retryable: false })
  }
  if (signal?.aborted) return try Effect.interrupt
  const body = response.body
  const replies = Stream.fromReadableStream({ evaluate: () => body, onError: () => new OpenAiFailure({ reason: "OpenAI event stream disconnected.", retryable: false }) })
    .pipe(Stream.decodeText(), Stream.pipeThroughChannel(Sse.decode({ maxEventSize: 1048576 })))
  const queue = try Queue.unbounded<string, OpenAiFailure | Cause.Done>()
  const produce = effect {
    let text = ""
    let reason: string | undefined
    let usage: TokenUsage | undefined
    let done = false
    for try (const event of replies) {
      if (event.data === "[DONE]") {
        done = true
        break
      }
      const next = try streamFrame(event.data)
      const reported = next.usage
      if (reported != null) usage = usageOf(reported)
      for (const choice of next.choices) {
        if (choice.finish_reason != null) reason = choice.finish_reason
        const delta = choice.delta.content
        if (delta == null || delta === "") continue
        if (text.length + delta.length > 4194304) throw new OpenAiFailure({ reason: "OpenAI exceeded the response text budget.", retryable: false })
        try model.send({ type: "publishOpenAiPiece", attempt })
        text += delta
        try Queue.offer(queue, delta)
      }
    }
    if (!done || reason !== "stop") throw new OpenAiFailure({ reason: "OpenAI stopped without completing the event stream.", retryable: false })
    try model.send({ type: "acceptOpenAi", attempt, terminal: true, shapeMatches: true })
    return { text, reason, usage }
  }
  const watched = signal === undefined ? produce : Effect.raceFirst(produce, whenCancelled(signal))
  const fiber = try forkDetach(Effect.onExit(watched, (outcome) => Exit.isSuccess(outcome)
    ? Queue.end(queue)
    : Queue.fail(queue, new OpenAiFailure({ reason: "OpenAI did not complete the event stream.", retryable: false }))),
    { startImmediately: true })
  return try Effect.sync(() => streamResult(fiber, queue))
}

const chatResponse = Schema.Struct({
  choices: Schema.NonEmptyArray(Schema.Struct({ message: Schema.Struct({ content: Schema.NullOr(Schema.String), tool_calls: Schema.optionalKey(Schema.Array(Schema.Unknown)) }), finish_reason: Schema.String })),
  usage: Schema.optionalKey(usageSchema),
})
const decodeChat = Schema.decodeUnknownEffect(chatResponse)

function modelEndpoint(runtime: IAgentRuntime, modelId: string) {
  return { address: setting(runtime, "OPENAI_BASE_URL") || "https://api.openai.com/v1", modelId, acceptsOperation: true, acceptsSchema: true, confidential: setting(runtime, "OPENAI_CONFIDENTIAL") === "true" }
}

effect function textRequest(runtime: IAgentRuntime, params: GenerateTextParams, tier: string) {
  const primary = modelEndpoint(runtime, openAiModelId(params.model ?? "", setting(runtime, "OPENAI_" + tier + "_MODEL"), setting(runtime, "OPENAI_MODEL") || "gpt-4.1-mini"))
  const fallback = modelEndpoint(runtime, setting(runtime, "OPENAI_FALLBACK_MODEL"))
  const needsSchema = params.responseSchema !== undefined
  const needsConfidential = setting(runtime, "OPENAI_CONFIDENTIAL") === "true"
  if (!suitableOpenAiEndpoint(primary, needsSchema, needsConfidential)) throw new OpenAiFailure({ reason: "The OpenAI route cannot honor this request.", retryable: false })
  provide machine() {
    const model = try Machine
    let run = try model.send({ type: "beginOpenAi", primary, fallback, needsSchema, needsConfidential })
    while (run.phase === "CallingOpenAi") {
      const endpoint = run.attempt === "PrimaryOpenAi" ? primary : fallback
      const result = try Effect.exit(effect {
        const messages = params.messages ?? [
          ...(params.system === undefined ? [] : [{ role: "system", content: params.system }]),
          { role: "user", content: params.prompt ?? "" },
        ]
        const wantsEvents = params.stream === true && !needsSchema && (params.tools?.length ?? 0) === 0 && params.toolChoice === undefined
        const payload = {
          model: endpoint.modelId, messages, stream: wantsEvents, temperature: params.temperature, top_p: params.topP,
          max_completion_tokens: params.omitMaxTokens ? undefined : params.maxTokens, stop: params.stopSequences,
          tools: params.tools?.map((tool) => ({ type: "function", function: { name: tool.name, description: tool.description, parameters: tool.parameters, strict: tool.strict } })),
          tool_choice: params.toolChoice, seed: params.seed,
          response_format: params.responseSchema === undefined ? params.responseFormat : { type: "json_schema", json_schema: { name: "response", strict: true, schema: params.responseSchema } },
        }
        if (wantsEvents) {
          const response = try callOpenAi(runtime, "/chat/completions", { ...payload, stream_options: { include_usage: true } }, endpoint.address)
          const live = try streamAnswer(response, model, run.attempt, params.signal)
          return { kind: "live", live } as const
        }
        const known = try jsonPost(runtime, "/chat/completions", payload, endpoint.address)
        const full = decodeChat(known) catch effect () => { throw new OpenAiFailure({ reason: "OpenAI reply had an invalid completion shape.", retryable: false }) }
        return { kind: "full", full } as const
      })
      if (result._tag === "Success") {
        if (result.value.kind === "live") return result.value.live
        const complete = result.value.full
        const choice = complete.choices[0]
        const valid = choice.finish_reason === "stop" || choice.finish_reason === "tool_calls"
        if (!valid) throw new OpenAiFailure({ reason: "OpenAI did not complete its response.", retryable: false })
        try model.send({ type: "acceptOpenAi", attempt: run.attempt, terminal: valid, shapeMatches: choice.message.content !== null })
        const text = choice.message.content ?? ""
        const reported = complete.usage
        if (!params.stream && choice.message.tool_calls === undefined) return text
        return try Effect.sync(() => ({
          textStream: (async function* () { if (text !== "") yield text })(),
          text: Promise.resolve(text),
          usage: Promise.resolve(reported && usageOf(reported)),
          finishReason: Promise.resolve(choice.finish_reason),
          toolCalls: choice.message.tool_calls,
        } satisfies TextStreamResult))
      }
      if (Cause.hasInterruptsOnly(result.cause)) return try Effect.failCause(result.cause)
      const failure = Cause.squash(result.cause)
      run = try model.send({ type: "failOpenAi", attempt: run.attempt, failure: failure instanceof OpenAiFailure && failure.retryable ? "RetryableOpenAi" : "ProviderRefusedOpenAi" })
      if (run.phase === "FailedOpenAi") return try Effect.failCause(result.cause)
    }
    throw new OpenAiFailure({ reason: "No OpenAI attempt completed.", retryable: false })
  }
}

const embeddingReply = Schema.Struct({ data: Schema.NonEmptyArray(Schema.Struct({ embedding: Schema.Array(Schema.Number) })) })
const imageReply = Schema.Struct({ data: Schema.Array(Schema.Struct({ url: Schema.optionalKey(Schema.String), b64_json: Schema.optionalKey(Schema.String) })) })
const textReply = Schema.Struct({ text: Schema.String })

function describe(runtime: IAgentRuntime, input: ImageDescriptionParams | string) {
  const params = typeof input === "string" ? { imageUrl: input } : input
  return runPromise(effect {
    const raw = try jsonPost(runtime, "/chat/completions", {
      model: setting(runtime, "OPENAI_IMAGE_DESCRIPTION_MODEL") || "gpt-4.1-mini",
      messages: [{ role: "user", content: [{ type: "text", text: params.prompt ?? "Describe this image." }, { type: "image_url", image_url: { url: params.imageUrl } }] }],
    }, setting(runtime, "OPENAI_IMAGE_DESCRIPTION_BASE_URL") || undefined)
    const parsed = try Schema.decodeUnknownEffect(chatResponse)(raw)
    const description = parsed.choices[0].message.content
    if (description === null) throw new OpenAiFailure({ reason: "OpenAI returned no image description.", retryable: false })
    return { title: "", description }
  }, { signal: "signal" in params ? params.signal : undefined })
}

function textHandler(tier: string) {
  return (runtime: IAgentRuntime, params: GenerateTextParams) => runPromise(textRequest(runtime, params, tier), { signal: params.signal })
}

export const plugin: Plugin = {
  name: "@elizaos/plugin-openai",
  description: "OpenAI-compatible text, tokenization, image, audio, and embedding handlers.",
  models: {
    [ModelType.TEXT_NANO]: textHandler("NANO"),
    [ModelType.TEXT_SMALL]: textHandler("SMALL"),
    [ModelType.TEXT_MEDIUM]: textHandler("MEDIUM"),
    [ModelType.TEXT_LARGE]: textHandler("LARGE"),
    [ModelType.TEXT_MEGA]: textHandler("MEGA"),
    [ModelType.RESPONSE_HANDLER]: textHandler("SMALL"),
    [ModelType.ACTION_PLANNER]: textHandler("LARGE"),
    [ModelType.TEXT_EMBEDDING]: (runtime, params) => runPromise(effect {
      if (params === null) return Array.from({ length: VECTOR_DIMS.XXL }, (_item, index) => index === 0 ? 0.1 : 0)
      const raw = try jsonPost(runtime, "/embeddings", { model: setting(runtime, "OPENAI_EMBEDDING_MODEL") || "text-embedding-3-small", input: typeof params === "string" ? params : params.text })
      const parsed = try Schema.decodeUnknownEffect(embeddingReply)(raw)
      if (!parsed.data[0].embedding.every(Number.isFinite)) throw new OpenAiFailure({ reason: "OpenAI returned an invalid vector.", retryable: false })
      return [...parsed.data[0].embedding]
    }, typeof params === "object" && params !== null ? { signal: params.signal } : undefined),
    [ModelType.TEXT_TOKENIZER_ENCODE]: (_runtime, params) => {
      const encoding = openAiTokenizerKey("", "o200k_base")
      return Promise.resolve(encodingFor(encoding === "cl100k_base" ? encoding : "o200k_base").encode(params.prompt))
    },
    [ModelType.TEXT_TOKENIZER_DECODE]: (_runtime, params) => Promise.resolve(encodingFor("o200k_base").decode(params.tokens)),
    [ModelType.IMAGE]: (runtime, params) => runPromise(effect {
      const raw = try jsonPost(runtime, "/images/generations", { model: setting(runtime, "OPENAI_IMAGE_MODEL") || "gpt-image-1", prompt: params.prompt, size: params.size, n: params.count })
      const parsed = try Schema.decodeUnknownEffect(imageReply)(raw)
      return parsed.data.flatMap((item) => item.url !== undefined ? [{ url: item.url }] : item.b64_json !== undefined ? [{ url: "data:image/png;base64," + item.b64_json }] : [])
    }),
    [ModelType.IMAGE_DESCRIPTION]: describe,
    [ModelType.TRANSCRIPTION]: (runtime, params) => runPromise(effect {
      const source = typeof params === "string" || params instanceof Uint8Array ? params : params.audio instanceof ArrayBuffer ? new Uint8Array(params.audio) : params.audio ?? params.audioUrl
      const response = try tryPromise({
        try: (signal) => transcribeOpenAi((setting(runtime, "OPENAI_BASE_URL") || "https://api.openai.com/v1").replace(/\/+$/, "") + "/audio/transcriptions",
          setting(runtime, "OPENAI_API_KEY"), source, setting(runtime, "OPENAI_TRANSCRIPTION_MODEL") || "whisper-1", signal),
        catch: () => new OpenAiFailure({ reason: "OpenAI transcription could not be reached.", retryable: true }),
      })
      if (!response.ok) throw new OpenAiFailure({ reason: `OpenAI transcription returned HTTP ${response.status}.`, retryable: false })
      const decoded = try Schema.decodeUnknownEffect(textReply)(try tryPromise((): Promise<unknown> => response.json()))
      return decoded.text
    }, typeof params === "object" && "signal" in params ? { signal: params.signal } : undefined),
    [ModelType.TEXT_TO_SPEECH]: (runtime, params) => {
      const request = typeof params === "string" ? { text: params } : params
      return runPromise(effect {
        const response = try tryPromise({
          try: (signal) => postOpenAi((setting(runtime, "OPENAI_BASE_URL") || "https://api.openai.com/v1").replace(/\/+$/, "") + "/audio/speech",
            setting(runtime, "OPENAI_API_KEY"), { model: setting(runtime, "OPENAI_TTS_MODEL") || "tts-1", input: request.text, voice: request.voice ?? "alloy", speed: request.speed }, signal),
          catch: () => new OpenAiFailure({ reason: "OpenAI speech could not be reached.", retryable: true }),
        })
        if (!response.ok) throw new OpenAiFailure({ reason: `OpenAI speech returned HTTP ${response.status}.`, retryable: false })
        return new Uint8Array(try tryPromise(() => response.arrayBuffer()))
      }, { signal: request.signal })
    },
  },
}

export default plugin
