interface MediaRegistrationSpec {
  readonly modelType: string
  readonly operation: OpenAiOperation
  readonly overrideKeys: readonly string[]
  readonly handler: Parameters<IAgentRuntime["registerModel"]>[1]
}

const MEDIA_REGISTRATIONS: readonly MediaRegistrationSpec[] = [
  {
    modelType: ModelType.IMAGE,
    operation: "CreateImage",
    overrideKeys: [],
    handler: handleImageGeneration as unknown as Parameters<IAgentRuntime["registerModel"]>[1],
  },
  {
    modelType: ModelType.IMAGE_DESCRIPTION,
    operation: "DescribeImage",
    overrideKeys: ["OPENAI_IMAGE_DESCRIPTION_BASE_URL"],
    handler: handleImageDescription as unknown as Parameters<IAgentRuntime["registerModel"]>[1],
  },
  {
    modelType: ModelType.TRANSCRIPTION,
    operation: "TranscribeAudio",
    overrideKeys: [],
    handler: handleTranscription as unknown as Parameters<IAgentRuntime["registerModel"]>[1],
  },
  {
    modelType: ModelType.TEXT_TO_SPEECH,
    operation: "SpeakText",
    overrideKeys: [],
    handler: handleTextToSpeech as unknown as Parameters<IAgentRuntime["registerModel"]>[1],
  },
]

export function registerMediaModels(runtime: IAgentRuntime): void {
  const providerMode = getProviderMode(runtime)
  const registrations: Array<Parameters<typeof registerProviderModels>[2][number]> = []
  for (const spec of MEDIA_REGISTRATIONS) {
    const hasOverride = spec.overrideKeys.some((key) => hasNonEmptySetting(runtime, key))
    if (!openAiSupportsCapability(providerMode, spec.operation, hasOverride)) {
      logger.info(`[OpenAI] Not registering ${spec.modelType}: the selected endpoint does not serve it`)
      continue
    }
    registrations.push({
      modelType: spec.modelType,
      handler: spec.handler,
      priority: plugin.priority,
    })
  }
  registerProviderModels(runtime, PLUGIN_NAME, registrations)
}

export const plugin: Plugin = {
  name: PLUGIN_NAME,
  description: "OpenAI-compatible text, reasoning, tokenization, image, audio, embedding, and deep research handlers.",
  autoEnable: {
    envKeys: ["OPENAI_API_KEY", "CEREBRAS_API_KEY", "EVOLINK_API_KEY"],
    shouldEnable: (env) => shouldEnable(env),
  },
  config: buildPluginConfig(),
  events: {
    [EventType.MESSAGE_RECEIVED]: [async ({ runtime }) => { preconnectProvider(runtime) }],
    [EventType.VOICE_MESSAGE_RECEIVED]: [async ({ runtime }) => { preconnectProvider(runtime) }],
  },
  async init(_config: Record<string, string>, runtime: IAgentRuntime): Promise<void> {
    warnWhenApiKeyIsMissing(runtime)
    registerMediaModels(runtime)
  },
  modelMetadata: openaiTextModelMetadata,
  models: {
    [ModelType.TEXT_NANO]: handleTextNano,
    [ModelType.TEXT_SMALL]: handleTextSmall,
    [ModelType.TEXT_MEDIUM]: handleTextMedium,
    [ModelType.TEXT_LARGE]: handleTextLarge,
    [ModelType.TEXT_MEGA]: handleTextMega,
    [ModelType.RESPONSE_HANDLER]: handleResponseHandler,
    [ModelType.ACTION_PLANNER]: handleActionPlanner,
    [ModelType.TEXT_REASONING_SMALL]: handleReasoningSmall,
    [ModelType.TEXT_REASONING_LARGE]: handleReasoningLarge,
    [ModelType.TEXT_EMBEDDING]: handleTextEmbedding,
    [ModelType.TEXT_TOKENIZER_ENCODE]: handleTokenizerEncode,
    [ModelType.TEXT_TOKENIZER_DECODE]: handleTokenizerDecode,
    [ModelType.RESEARCH]: handleResearch,
  },
}

