  type OpenAiUsageProvider,
} from "./config.vibe"
import {
  cooldownErrorForModel,
  describeRetryReason,
  emitModelUsageEvent,
  getExhaustedEndpointError,
  isModelAttemptIdleTimeout,
  isModelCoolingDown,
  isTransientProviderError,
