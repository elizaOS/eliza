// spec/openai/index.md, "Story: Use an OpenAI-compatible model for the requested capability"
import { assert, it } from "@effect/vitest"
import { ModelType, type IAgentRuntime, type TextStreamResult } from "@elizaos/core"
import { plugin } from "../src/index.vibe"

module node {
  import { createServer, type ServerResponse } from "node:http"

  export interface OpenAiTestServer {
    readonly endpoint: string
    readonly requests: Record<string, unknown>[]
    stop(): Promise<void>
  }

  export async function startOpenAiTestServer(
    onRequest: (body: Record<string, unknown>, res: ServerResponse) => void,
  ): Promise<OpenAiTestServer> {
    const requests: Record<string, unknown>[] = []
    const srv = createServer((req, res) => {
      const chunks: Buffer[] = []
      req.on("data", (chunk: Buffer) => { chunks.push(chunk) })
      req.on("end", () => {
        const body = JSON.parse(Buffer.concat(chunks).toString("utf8")) as Record<string, unknown>
        requests.push(body)
        onRequest(body, res)
      })
    })
    await new Promise<void>((resolve) => { srv.listen(0, "127.0.0.1", () => resolve()) })
    const bound = srv.address()
    const port = typeof bound === "object" && bound !== null ? bound.port : 0
    return {
      endpoint: `http://127.0.0.1:${port}/v1`,
      requests,
      stop: () => new Promise<void>((resolve) => { srv.close(() => resolve()) }),
    }
  }
}
import { startOpenAiTestServer } from node

function openaiRuntime(endpoint: string): IAgentRuntime {
  return {
    getSetting: (key: string) =>
      key === "OPENAI_API_KEY" ? "test-openai-key" : key === "OPENAI_BASE_URL" ? endpoint : undefined,
  } as unknown as IAgentRuntime
}

it('OpenAI & Cerebras prompt-cache usage, omitted content on tool_calls, and batch-uniform wire strict gating work end to end (spec/openai/index.md, "Story: Use an OpenAI-compatible model for the requested capability")', async () => {
  let callIndex = 0
  const srv = await startOpenAiTestServer((body, res) => {
    callIndex += 1
    if (body.stream === true) {
      res.writeHead(200, { "content-type": "text/event-stream" })
      res.write('data: {"choices":[{"delta":{"content":"cerebras-hit"},"finish_reason":null}]}\n\n')
      res.write('data: {"choices":[{"delta":{},"finish_reason":"stop"}],"usage":{"prompt_tokens":1024,"completion_tokens":40,"total_tokens":1064,"prompt_tokens_details":{"cached_tokens":896}}}\n\n')
      res.end("data: [DONE]\n\n")
      return
    }
    res.writeHead(200, { "content-type": "application/json" })
    if (callIndex === 1) {
      res.end(JSON.stringify({
        choices: [{ message: { tool_calls: [{ id: "call_1", type: "function", function: { name: "READ", arguments: "{\"path\":\"a.ts\"}" } }] }, finish_reason: "tool_calls" }],
        usage: { prompt_tokens: 2048, completion_tokens: 64, total_tokens: 2112, prompt_tokens_details: { cached_tokens: 1920, audio_tokens: 0 } },
      }))
      return
    }
    if (callIndex === 2) {
      res.end(JSON.stringify({
        choices: [{ message: { content: "searched", tool_calls: [] }, finish_reason: "stop" }],
        usage: { prompt_tokens: 256, completion_tokens: 16, total_tokens: 272, prompt_tokens_details: { cached_tokens: 0 } },
      }))
      return
    }
    if (callIndex === 3) {
      res.end(JSON.stringify({
        choices: [{ message: { content: "legacy answer", tool_calls: [] }, finish_reason: "stop" }],
        usage: { prompt_tokens: 100, completion_tokens: 10, total_tokens: 110 },
      }))
      return
    }
    res.end(JSON.stringify({
      choices: [{ message: callIndex === 4 ? { role: "assistant" } : { content: null, tool_calls: [] }, finish_reason: "stop" }],
      usage: { prompt_tokens: 100, completion_tokens: 0, total_tokens: 100 },
    }))
  })
  try {
    const handler = plugin.models?.[ModelType.TEXT_SMALL] as (runtime: IAgentRuntime, params: unknown) => Promise<TextStreamResult>
    const runtime = openaiRuntime(srv.endpoint)
    const strictRead = {
      name: "READ",
      description: "Read",
      strict: true,
      parameters: { type: "object", additionalProperties: false, properties: { path: { type: "string" } }, required: ["path"] },
    }
    const strictSearch = {
      name: "WEB_SEARCH",
      description: "Search",
      strict: true,
      parameters: { type: "object", additionalProperties: false, properties: { query: { type: "string" } }, required: ["query"] },
    }
    const mixedBatch = await handler(runtime, {
      prompt: "Read file",
      tools: [
        strictRead,
        {
          name: "EDIT",
          description: "Edit",
          strict: true,
          parameters: { type: "object", additionalProperties: false, properties: { edits: { type: "array", items: { type: "object" } }, path: { type: "string" } }, required: ["path"] },
        },
        {
          name: "WORKFLOW",
          description: "Workflow",
          strict: true,
          parameters: { type: "object", additionalProperties: false, properties: { input: { type: "object", additionalProperties: true } }, required: ["input"] },
        },
      ],
    })
    const allStrictBatch = await handler(runtime, {
      prompt: "Search web",
      tools: [strictRead, strictSearch],
    })
    const withoutDetails = await handler(runtime, { prompt: "Legacy provider" })
    const absentContent = await handler(runtime, { prompt: "Empty reply" }).then(() => "succeeded", (error: unknown) => String((error as { readonly reason?: unknown }).reason))
    const nullContent = await handler(runtime, { prompt: "Null reply" }).then(() => "succeeded", (error: unknown) => String((error as { readonly reason?: unknown }).reason))
    const streamed = await handler(runtime, { prompt: "Stream cached", stream: true })
    const mixedTools = srv.requests[0]?.tools as Array<{ function: { name: string; strict?: boolean } }>
    const uniformStrictTools = srv.requests[1]?.tools as Array<{ function: { name: string; strict?: boolean } }>
    assert.deepStrictEqual(
      mixedTools.map((tool) => [tool.function.name, "strict" in tool.function ? tool.function.strict : undefined]),
      [["READ", undefined], ["EDIT", undefined], ["WORKFLOW", undefined]],
    )
    assert.deepStrictEqual(
      uniformStrictTools.map((tool) => [tool.function.name, "strict" in tool.function ? tool.function.strict : undefined]),
      [["READ", true], ["WEB_SEARCH", true]],
    )
    assert.deepStrictEqual(mixedBatch.toolCalls, [{ id: "call_1", type: "function", function: { name: "READ", arguments: "{\"path\":\"a.ts\"}" } }])
    assert.strictEqual(await mixedBatch.text, "")
    assert.deepStrictEqual(await mixedBatch.usage, {
      promptTokens: 2048,
      completionTokens: 64,
      totalTokens: 2112,
      cacheReadInputTokens: 1920,
    })
    assert.deepStrictEqual(await allStrictBatch.usage, {
      promptTokens: 256,
      completionTokens: 16,
      totalTokens: 272,
      cacheReadInputTokens: 0,
    })
    assert.ok(absentContent.includes("no content and no tool calls"))
    assert.ok(nullContent.includes("no content and no tool calls"))
    assert.deepStrictEqual(await withoutDetails.usage, {
      promptTokens: 100,
      completionTokens: 10,
      totalTokens: 110,
    })
    assert.strictEqual(await streamed.text, "cerebras-hit")
    assert.deepStrictEqual(await streamed.usage, {
      promptTokens: 1024,
      completionTokens: 40,
      totalTokens: 1064,
      cacheReadInputTokens: 896,
    })
  } finally {
    await srv.stop()
  }
})
