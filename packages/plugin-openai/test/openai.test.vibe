// spec/openai/index.md, "Story: Use an OpenAI-compatible model for the requested capability"
import { assert, it } from "@effect/vitest"
import {
  createModelAttemptAllowance,
  ElizaError,
  EventType,
  ModelType,
  runWithStreamingContext,
  type GenerateTextResult,
  type IAgentRuntime,
  type TextStreamResult,
} from "@elizaos/core"
import { installNodeRuntimeAdapters } from "@elizaos/core-node"
import {
  CEREBRAS_SCHEMA_UNBOUNDED,
  detectAudioMimeType,
  factorResponseSchema,
  getFilenameForMimeType,
  handleImageDescription,
  handleImageGeneration,
  handleResearch,
  handleTextToSpeech,
  handleTranscription,
  isCerebrasMode,
  isWireStrictSchema,
  isCerebrasReasoningPart,
  loadedEncodingNames,
  normalizeAudioMimeType,
  normalizeSchemaForCerebras,
  OpenAiFailure,
  openaiPlugin,
  parseImageDescriptionResponse,
  plugin,
  ProviderRateLimitCooldownError,
  RATE_LIMIT_MAX_HOLD_MS,
  registerMediaModels,
  repairToolMessagePairing,
  resolveOpenAIBaseURL,
  resolveTokenizerEncodingName,
  resolveWireProviderExtraFields,
  shouldEnable,
} from "../src/index.vibe"

module node {
  import { createServer, type IncomingMessage, type ServerResponse } from "node:http"

  export interface CapturedRequest {
    readonly url: string
    readonly method: string
    readonly headers: Record<string, string | string[] | undefined>
    readonly rawBody: string
    readonly json: Record<string, unknown> | undefined
  }

  export interface OpenAiTestServer {
    readonly endpoint: string
    readonly requests: CapturedRequest[]
    stop(): Promise<void>
  }

  export async function startOpenAiTestServer(
    onRequest: (req: CapturedRequest, res: ServerResponse, rawReq: IncomingMessage) => void,
  ): Promise<OpenAiTestServer> {
    const requests: CapturedRequest[] = []
    const srv = createServer((req, res) => {
      const chunks: Buffer[] = []
      req.on("data", (chunk: Buffer) => { chunks.push(chunk) })
      req.on("end", () => {
        const rawBody = Buffer.concat(chunks).toString("utf8")
        let json: Record<string, unknown> | undefined
        try {
          const parsed: unknown = JSON.parse(rawBody)
          if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
            json = parsed as Record<string, unknown>
          }
        } catch {
          json = undefined
        }
        const captured: CapturedRequest = {
          url: req.url ?? "",
          method: req.method ?? "POST",
          headers: req.headers,
          rawBody,
          json,
        }
        requests.push(captured)
        onRequest(captured, res, req)
      })
    })
    await new Promise<void>((resolve) => { srv.listen(0, "127.0.0.1", () => resolve()) })
    const bound = srv.address()
    const port = typeof bound === "object" && bound !== null ? bound.port : 0
    return {
      endpoint: `http://127.0.0.1:${port}/v1`,
      requests,
      stop: () => new Promise<void>((resolve) => { srv.close(() => resolve()) }),
    }
  }
}
import { startOpenAiTestServer } from node

interface RecordedEvent {
  readonly event: string
  readonly payload: Record<string, unknown>
}

interface RecordedModelReg {
  readonly modelType: string
  readonly provider: string
}

function makeRuntime(
  settings: Record<string, string | undefined>,
  events: RecordedEvent[] = [],
  registeredModels: RecordedModelReg[] = [],
): IAgentRuntime {
  return {
    getSetting: (key: string) => settings[key],
    emitEvent: async (event: string, payload: Record<string, unknown>) => {
      events.push({ event, payload })
    },
    reportError: () => undefined,
    registerModel: (modelType: string, _handler: unknown, provider: string) => {
      registeredModels.push({ modelType, provider })
    },
  } as unknown as IAgentRuntime
}

it('OpenAI & Cerebras prompt-cache usage, omitted content on tool_calls, normalized ToolCall shape, and batch-uniform wire strict gating work end to end (spec/openai/index.md, "Story: Use an OpenAI-compatible model for the requested capability"; spec/openai/index.md, "Tools are sent strict only when every tool in the request is strict"; spec/openai/index.md, "Reported usage carries the cached prompt tokens the provider reports")', async () => {
  let callIndex = 0
  const srv = await startOpenAiTestServer((req, res) => {
    callIndex += 1
    const body = req.json ?? {}
    if (body.stream === true) {
      res.writeHead(200, { "content-type": "text/event-stream" })
      res.write('data: {"choices":[{"delta":{"content":"cerebras-hit"},"finish_reason":null}]}\n\n')
      res.write('data: {"choices":[{"delta":{},"finish_reason":"stop"}],"usage":{"prompt_tokens":1024,"completion_tokens":40,"total_tokens":1064,"prompt_tokens_details":{"cached_tokens":896},"completion_tokens_details":{"reasoning_tokens":12}}}\n\n')
      res.end("data: [DONE]\n\n")
      return
    }
    res.writeHead(200, { "content-type": "application/json" })
    if (callIndex === 1) {
      res.end(JSON.stringify({
        choices: [{ message: { tool_calls: [{ id: "call_1", type: "function", function: { name: "READ", arguments: "{\"path\":\"a.ts\"}" } }] }, finish_reason: "tool_calls" }],
        usage: { prompt_tokens: 2048, completion_tokens: 64, total_tokens: 2112, prompt_tokens_details: { cached_tokens: 1920, audio_tokens: 0 } },
      }))
      return
    }
    if (callIndex === 2) {
      res.end(JSON.stringify({
        choices: [{ message: { content: "found", tool_calls: [] }, finish_reason: "stop" }],
        usage: { prompt_tokens: 256, completion_tokens: 16, total_tokens: 272, prompt_tokens_details: { cached_tokens: 0 } },
      }))
      return
    }
    res.end(JSON.stringify({
      choices: [{ message: { content: "legacy" }, finish_reason: "stop" }],
      usage: { prompt_tokens: 100, completion_tokens: 10, total_tokens: 110 },
    }))
  })
  try {
    assert.strictEqual(plugin, openaiPlugin)
    assert.strictEqual(plugin.name, "@elizaos/plugin-openai")
    assert.strictEqual(plugin.modelMetadata?.[ModelType.TEXT_SMALL]?.streamable, true)

    const events: RecordedEvent[] = []
    const runtime = makeRuntime({ OPENAI_API_KEY: "test-openai-key", OPENAI_BASE_URL: srv.endpoint }, events)
    const handler = plugin.models?.[ModelType.TEXT_SMALL] as (runtime: IAgentRuntime, params: unknown) => Promise<string | GenerateTextResult | TextStreamResult>
    const strictRead = {
      name: "READ",
      description: "Read",
      strict: true,
      parameters: { type: "object", additionalProperties: false, properties: { path: { type: "string" } }, required: ["path"] },
    }
    const strictSearch = {
      name: "WEB_SEARCH",
      description: "Search",
      strict: true,
      parameters: { type: "object", additionalProperties: false, properties: { query: { type: "string" } }, required: ["query"] },
    }
    const mixedBatch = await handler(runtime, {
      prompt: "Read file",
      tools: [
        strictRead,
        {
          name: "EDIT",
          description: "Edit",
          strict: true,
          parameters: { type: "object", additionalProperties: false, properties: { edits: { type: "array", items: { type: "object" } }, path: { type: "string" } }, required: ["path"] },
        },
        {
          name: "WORKFLOW",
          description: "Workflow",
          strict: true,
          parameters: { type: "object", additionalProperties: false, properties: { input: { type: "object", additionalProperties: true } }, required: ["input"] },
        },
      ],
    }) as GenerateTextResult
    const allStrictBatch = await handler(runtime, {
      prompt: "Search web",
      tools: [strictRead, strictSearch],
    }) as GenerateTextResult
    const plainText = await handler(runtime, { prompt: "Legacy provider" })
    const streamed = await handler(runtime, { prompt: "Stream cached", stream: true }) as TextStreamResult

    const mixedTools = srv.requests[0]?.json?.tools as Array<{ function: { name: string; strict?: boolean } }>
    const uniformStrictTools = srv.requests[1]?.json?.tools as Array<{ function: { name: string; strict?: boolean } }>
    assert.deepStrictEqual(
      mixedTools.map((tool) => [tool.function.name, "strict" in tool.function ? tool.function.strict : undefined]),
      [["READ", undefined], ["EDIT", undefined], ["WORKFLOW", undefined]],
    )
    assert.deepStrictEqual(
      uniformStrictTools.map((tool) => [tool.function.name, "strict" in tool.function ? tool.function.strict : undefined]),
      [["READ", true], ["WEB_SEARCH", true]],
    )
    assert.deepStrictEqual(mixedBatch.toolCalls, [{ id: "call_1", name: "READ", arguments: { path: "a.ts" } }])
    assert.strictEqual(mixedBatch.text, "")
    assert.deepStrictEqual(mixedBatch.usage, {
      promptTokens: 2048,
      completionTokens: 64,
      totalTokens: 2112,
      cacheReadInputTokens: 1920,
    })
    assert.deepStrictEqual(allStrictBatch.usage, {
      promptTokens: 256,
      completionTokens: 16,
      totalTokens: 272,
      cacheReadInputTokens: 0,
    })
    assert.strictEqual(plainText, "legacy")
    assert.strictEqual(await streamed.text, "cerebras-hit")
    assert.deepStrictEqual(await streamed.usage, {
      promptTokens: 1024,
      completionTokens: 40,
      totalTokens: 1064,
      cacheReadInputTokens: 896,
      reasoningTokens: 12,
    })
    const modelUsedEvents = events.filter((e) => e.event === EventType.MODEL_USED)
    assert.strictEqual(modelUsedEvents.length, 4)
    assert.strictEqual((modelUsedEvents[0]?.payload.tokens as Record<string, unknown>).cacheReadInputTokens, 1920)
    assert.strictEqual((modelUsedEvents[3]?.payload.tokens as Record<string, unknown>).reasoningTokens, 12)
  } finally {
    await srv.stop()
  }
})

it('Streaming tool call deltas, tool-message pairing repair, lone surrogate sanitization, and MODEL_OUTPUT_INCOMPLETE usage ordering work end to end (spec/openai/index.md, "An attempt can change upstream only before publishing any output")', async () => {
  let reqNum = 0
  const srv = await startOpenAiTestServer((req, res) => {
    reqNum += 1
    if (req.json?.stream === true) {
      res.writeHead(200, { "content-type": "text/event-stream" })
      res.write('data: {"choices":[{"delta":{"tool_calls":[{"index":0,"id":"tc_9","type":"function","function":{"name":"lookup","arguments":"{\\"q\\":"}}]},"finish_reason":null}]}\n\n')
      res.write('data: {"choices":[{"delta":{"tool_calls":[{"index":0,"function":{"arguments":"\\"ok\\"}"}}]},"finish_reason":"tool_calls"}]}\n\n')
      res.end("data: [DONE]\n\n")
      return
    }
    res.writeHead(200, { "content-type": "application/json" })
    if (reqNum === 2) {
      res.end(JSON.stringify({
        choices: [{ message: { content: "truncated..." }, finish_reason: "length" }],
        usage: { prompt_tokens: 50, completion_tokens: 100, total_tokens: 150 },
      }))
      return
    }
    res.end(JSON.stringify({
      choices: [{ message: { content: "paired-ok" }, finish_reason: "stop" }],
      usage: { prompt_tokens: 30, completion_tokens: 5, total_tokens: 35 },
    }))
  })
  try {
    const events: RecordedEvent[] = []
    const runtime = makeRuntime({ OPENAI_API_KEY: "k", OPENAI_BASE_URL: srv.endpoint }, events)
    const handler = plugin.models?.[ModelType.TEXT_LARGE] as (runtime: IAgentRuntime, params: unknown) => Promise<unknown>

    const streamed = await handler(runtime, {
      prompt: "Call tool",
      stream: true,
      tools: [{ name: "lookup", parameters: { type: "object", properties: { q: { type: "string" } } } }],
    }) as TextStreamResult
    assert.strictEqual(await streamed.finishReason, "tool_calls")
    assert.deepStrictEqual(await streamed.toolCalls, [{ id: "tc_9", name: "lookup", arguments: { q: "ok" } }])

    let incompleteError: unknown
    try {
      await handler(runtime, { prompt: "Truncate me", maxTokens: 100 })
    } catch (err) {
      incompleteError = err
    }
    assert.ok(incompleteError instanceof ElizaError)
    assert.strictEqual(incompleteError.code, "MODEL_OUTPUT_INCOMPLETE")
    assert.strictEqual(events.filter((e) => e.event === EventType.MODEL_USED).length, 1)

    const repaired = repairToolMessagePairing([
      { role: "assistant", content: null, tool_calls: [{ id: "c1", type: "function", function: { name: "a", arguments: "{}" } }] },
      { role: "user", content: "interleaved" },
      { role: "tool", tool_call_id: "c1", content: "result-1" },
      { role: "tool", tool_call_id: "orphan", content: "orphan-result" },
    ])
    assert.deepStrictEqual(repaired.map((m) => m.role), ["assistant", "tool", "user", "user"])

    const brokenSurrogate = `bad-\uD800-text`
    await handler(runtime, { prompt: brokenSurrogate })
    assert.strictEqual(/\\ud800/i.test(srv.requests[2]?.rawBody ?? ""), false)
  } finally {
    await srv.stop()
  }
})

it('Cerebras routing, base URL isolation, capability gating, reasoning replay, schema compat, root union wrapping, and stall guard work end to end (spec/openai/index.md, "Confidential and capability requirements are routing constraints")', async () => {
  assert.strictEqual(shouldEnable({}), false)
  assert.strictEqual(shouldEnable({ OPENAI_API_KEY: "  " }), false)
  assert.strictEqual(shouldEnable({ CEREBRAS_API_KEY: "csk-1" }), true)
  assert.strictEqual(shouldEnable({ EVOLINK_API_KEY: "ev-1" }), true)

  assert.strictEqual(
    resolveOpenAIBaseURL((k) => ({ ELIZA_PROVIDER: "cerebras", OPENAI_BASE_URL: "https://api.openai.com/v1" }[k])),
    "https://api.cerebras.ai/v1",
  )
  assert.strictEqual(
    resolveOpenAIBaseURL((k) => ({ ELIZA_PROVIDER: "cerebras", OPENAI_BASE_URL: "https://proxy.example.com/v1" }[k])),
    "https://proxy.example.com/v1",
  )

  const cerebrasRegs: RecordedModelReg[] = []
  const cerebrasRt = makeRuntime({ ELIZA_PROVIDER: "cerebras", CEREBRAS_API_KEY: "csk" }, [], cerebrasRegs)
  assert.strictEqual(isCerebrasMode(cerebrasRt), true)
  await plugin.init?.({}, cerebrasRt)
  assert.deepStrictEqual(cerebrasRegs, [])

  const overrideRegs: RecordedModelReg[] = []
  const overrideRt = makeRuntime({
    ELIZA_PROVIDER: "cerebras",
    CEREBRAS_API_KEY: "csk",
    OPENAI_IMAGE_DESCRIPTION_BASE_URL: "https://api.openai.com/v1",
  }, [], overrideRegs)
  registerMediaModels(overrideRt)
  assert.deepStrictEqual(overrideRegs.map((r) => r.modelType), [ModelType.IMAGE_DESCRIPTION])

  const openAiRegs: RecordedModelReg[] = []
  const keylessRt = makeRuntime({}, [], openAiRegs)
  await plugin.init?.({}, keylessRt)
  assert.deepStrictEqual(openAiRegs.map((r) => r.modelType).sort(), [
    ModelType.IMAGE,
    ModelType.IMAGE_DESCRIPTION,
    ModelType.TEXT_TO_SPEECH,
    ModelType.TRANSCRIPTION,
  ])

  const extra = resolveWireProviderExtraFields(
    { providerOptions: { openai: { promptCacheRetention: "24h" }, cerebras: { promptCacheKey: "ck-1" }, eliza: { thinking: "off" } } },
    cerebrasRt,
    "qwen-3.8-27b",
  )
  assert.strictEqual(extra.prompt_cache_key, "ck-1")
  assert.strictEqual(extra.prompt_cache_retention, undefined)
  assert.strictEqual(extra.reasoning_effort, "none")

  const defaultGemma = resolveWireProviderExtraFields({}, cerebrasRt, "gemma-4-31b")
  assert.strictEqual(defaultGemma.reasoning_effort, undefined)

  const cyclic: Record<string, unknown> = { type: "object" }
  cyclic.not = cyclic
  let cycleErr: unknown
  try {
    normalizeSchemaForCerebras(cyclic, true)
  } catch (err) {
    cycleErr = err
  }
  assert.ok(cycleErr instanceof ElizaError && cycleErr.code === CEREBRAS_SCHEMA_UNBOUNDED)

  const bigBranch = { type: "object", description: "x".repeat(220), properties: { a: { type: "string" } }, required: ["a"], additionalProperties: false }
  const factored = factorResponseSchema({ type: "object", properties: { first: bigBranch, second: bigBranch }, required: ["first", "second"] })
  assert.ok(factored.$defs !== undefined)

  let call = 0
  const srv = await startOpenAiTestServer((req, res) => {
    call += 1
    if (req.json?.stream === true) {
      res.writeHead(200, { "content-type": "text/event-stream" })
      res.write(`data: {"choices":[{"delta":{"content":"{${" ".repeat(4100)}"},"finish_reason":null}]}\n\n`)
      res.end("data: [DONE]\n\n")
      return
    }
    res.writeHead(200, { "content-type": "application/json" })
    if (call === 1) {
      res.end(JSON.stringify({
        choices: [{ message: { content: JSON.stringify({ __eliza_response: { kind: "ok", n: 7 } }) }, finish_reason: "stop" }],
      }))
      return
    }
    res.end(JSON.stringify({
      choices: [{
        message: {
          content: null,
          reasoning: "hidden-cot",
          tool_calls: [{ id: "tc_1", type: "function", function: { name: "math_factorial", arguments: "{\"n\":5}" } }],
        },
        finish_reason: "tool_calls",
      }],
    }))
  })
  try {
    const rt = makeRuntime({
      ELIZA_PROVIDER: "cerebras",
      CEREBRAS_API_KEY: "csk-test",
      OPENAI_BASE_URL: srv.endpoint,
      CEREBRAS_MODEL: "qwen-3.8-27b",
    })
    const handler = plugin.models?.[ModelType.TEXT_SMALL] as (runtime: IAgentRuntime, params: unknown) => Promise<unknown>

    const unionRes = await handler(rt, {
      prompt: "Return union",
      responseSchema: {
        anyOf: [
          { type: "object", properties: { kind: { const: "ok" }, n: { type: "number" } }, required: ["kind", "n"], additionalProperties: false },
          { type: "object", properties: { kind: { const: "err" } }, required: ["kind"], additionalProperties: false },
        ],
      },
    }) as GenerateTextResult
    assert.deepStrictEqual(JSON.parse(unionRes.text), { kind: "ok", n: 7 })

    const dottedRes = await handler(rt, {
      messages: [
        { role: "user", content: "fact 5" },
        { role: "assistant", content: [{ type: "reasoning", text: "prior-cot", providerOptions: { cerebras: { model: "qwen-3.8-27b" } } }, { type: "text", text: "thinking" }] },
        { role: "user", content: "go" },
      ],
      tools: [{ name: "math.factorial", parameters: { type: "object", properties: { n: { type: "number" } }, required: ["n"], additionalProperties: false }, strict: true }],
    }) as GenerateTextResult
    assert.deepStrictEqual(dottedRes.toolCalls, [{ id: "tc_1", name: "math.factorial", arguments: { n: 5 } }])
    assert.ok(Array.isArray(dottedRes.content) && isCerebrasReasoningPart(dottedRes.content[0], "qwen-3.8-27b"))
    const sentMessages = srv.requests[1]?.json?.messages as Array<{ role: string; reasoning?: string }>
    assert.strictEqual(sentMessages.find((m) => m.role === "assistant")?.reasoning, "prior-cot")

    let stallErr: unknown
    try {
      const stalled = await handler(rt, {
        prompt: "Stall stream",
        stream: true,
        responseSchema: { type: "object", properties: { a: { type: "string" } }, required: ["a"], additionalProperties: false },
      }) as TextStreamResult
      await stalled.text
    } catch (err) {
      stallErr = err
    }
    assert.ok(stallErr instanceof ElizaError && stallErr.code === "STRUCTURED_OUTPUT_STALLED")
  } finally {
    await srv.stop()
  }
})

it(`Transient retries, flat Cerebras 400 enrichment, permanent quota/parser non-retry, cooldown fallback, OpenRouter failover, confidential isolation, and lease enforcement work end to end (spec/openai/index.md, "A cooling route does not resend before the provider's reset")`, async () => {
  let primaryCalls = 0
  const primarySrv = await startOpenAiTestServer((req, res) => {
    primaryCalls += 1
    const prompt = ((req.json?.messages as Array<{ content?: string }>)?.at(-1)?.content) ?? ""
    if (prompt === "retry-500") {
      if (primaryCalls === 1) {
        res.writeHead(500, { "content-type": "application/json" })
        res.end(JSON.stringify({ message: "Encountered a server error, please try again" }))
        return
      }
      res.writeHead(200, { "content-type": "application/json" })
      res.end(JSON.stringify({ choices: [{ message: { content: "recovered" }, finish_reason: "stop" }] }))
      return
    }
    if (prompt === "quota-429") {
      res.writeHead(429, { "content-type": "application/json", "retry-after": "1" })
      res.end(JSON.stringify({ error: { code: "insufficient_quota", message: "Quota exhausted" } }))
      return
    }
    if (prompt === "parser-400") {
      res.writeHead(400, { "content-type": "application/json" })
      res.end(JSON.stringify({ type: "generation_error", param: "tool_calls", code: "parser_error", message: "Failed to parse tool call" }))
      return
    }
    if (prompt === "cooldown-429") {
      if (req.json?.model === "backup-model") {
        res.writeHead(200, { "content-type": "application/json" })
        res.end(JSON.stringify({ choices: [{ message: { content: "served-by-backup" }, finish_reason: "stop" }] }))
        return
      }
      res.writeHead(429, { "content-type": "application/json", "retry-after": "60" })
      res.end(JSON.stringify({ message: "Rate limit exceeded" }))
      return
    }
    if (prompt === "leased-ok") {
      res.writeHead(200, { "content-type": "application/json" })
      res.end(JSON.stringify({ choices: [{ message: { content: "leased-reply" }, finish_reason: "stop" }] }))
      return
    }
    res.writeHead(429, { "content-type": "application/json", "retry-after": "60" })
    res.end(JSON.stringify({ message: "Cerebras saturated" }))
  })

  const openRouterSrv = await startOpenAiTestServer((_req, res) => {
    res.writeHead(200, { "content-type": "application/json" })
    res.end(JSON.stringify({ choices: [{ message: { content: "openrouter-ok" }, finish_reason: "stop" }] }))
  })

  try {
    const handler = plugin.models?.[ModelType.TEXT_SMALL] as (runtime: IAgentRuntime, params: unknown) => Promise<unknown>
    const rt = makeRuntime({ OPENAI_API_KEY: "k", OPENAI_BASE_URL: primarySrv.endpoint, OPENAI_SMALL_MODEL: "primary-model" })

    const recovered = await handler(rt, { prompt: "retry-500" })
    assert.strictEqual(recovered, "recovered")
    assert.strictEqual(primaryCalls, 2)

    const quotaWithFallbackRt = makeRuntime({
      OPENAI_API_KEY: "k",
      OPENAI_BASE_URL: primarySrv.endpoint,
      OPENAI_SMALL_MODEL: "primary-model",
      OPENAI_FALLBACK_MODEL: "backup-model",
    })
    const beforeQuota = primaryCalls
    let quotaErr: unknown
    try {
      await handler(quotaWithFallbackRt, { prompt: "quota-429" })
    } catch (err) {
      quotaErr = err
    }
    assert.strictEqual(primaryCalls, beforeQuota + 1)
    assert.ok(quotaErr instanceof OpenAiFailure)
    assert.strictEqual(quotaErr.status, 429)
    assert.ok(quotaErr.reason.includes("Quota exhausted"))

    const beforeParser = primaryCalls
    let parserErr: unknown
    try {
      await handler(rt, { prompt: "parser-400" })
    } catch (err) {
      parserErr = err
    }
    assert.strictEqual(primaryCalls, beforeParser + 1)
    assert.ok(parserErr instanceof OpenAiFailure)
    assert.strictEqual(parserErr.status, 400)

    const cooldownRt = makeRuntime({
      OPENAI_API_KEY: "k",
      OPENAI_BASE_URL: primarySrv.endpoint,
      OPENAI_SMALL_MODEL: "primary-model",
      OPENAI_FALLBACK_MODEL: "backup-model",
    })
    const servedByBackup = await handler(cooldownRt, { prompt: "cooldown-429" })
    assert.strictEqual(servedByBackup, "served-by-backup")

    const noFallbackRt = makeRuntime({
      ELIZA_PROVIDER: "cerebras",
      CEREBRAS_API_KEY: "csk",
      OPENAI_BASE_URL: primarySrv.endpoint,
      CEREBRAS_MODEL: "qwen-3.8-27b",
    })
    let first429: unknown
    try {
      await handler(noFallbackRt, { prompt: "cooldown-429" })
    } catch (err) {
      first429 = err
    }
    assert.ok(first429 instanceof OpenAiFailure && first429.status === 429)
    let holdErr: unknown
    try {
      await handler(noFallbackRt, { prompt: "cooldown-429" })
    } catch (err) {
      holdErr = err
    }
    assert.ok(holdErr instanceof ProviderRateLimitCooldownError)
    assert.strictEqual(holdErr.statusCode, 429)
    assert.ok(holdErr.retryAfterMs > RATE_LIMIT_MAX_HOLD_MS)

    const orRt = makeRuntime({
      ELIZA_PROVIDER: "cerebras",
      CEREBRAS_API_KEY: "csk",
      OPENAI_BASE_URL: primarySrv.endpoint,
      CEREBRAS_MODEL: "qwen-3.8-27b",
      OPENROUTER_API_KEY: "or-key",
      OPENROUTER_FALLBACK_MODEL: "qwen/qwen-3.8-27b",
      OPENROUTER_BASE_URL: openRouterSrv.endpoint,
    })
    const orReply = await handler(orRt, { prompt: "failover-or" })
    assert.strictEqual(orReply, "openrouter-ok")
    assert.deepStrictEqual(openRouterSrv.requests[0]?.json?.provider, {
      require_parameters: true,
      data_collection: "deny",
      sort: "latency",
    })
    assert.deepStrictEqual(openRouterSrv.requests[0]?.json?.reasoning, { effort: "high" })
    assert.strictEqual(openRouterSrv.requests[0]?.json?.reasoning_effort, undefined)

    const confidentialRt = makeRuntime({
      ELIZA_PROVIDER: "cerebras",
      CEREBRAS_API_KEY: "csk",
      OPENAI_BASE_URL: primarySrv.endpoint,
      OPENAI_CONFIDENTIAL: "true",
      CEREBRAS_MODEL: "qwen-3.8-27b",
      OPENROUTER_API_KEY: "or-key",
      OPENROUTER_FALLBACK_MODEL: "qwen/qwen-3.8-27b",
      OPENROUTER_BASE_URL: openRouterSrv.endpoint,
    })
    const orCountBefore = openRouterSrv.requests.length
    let confErr: unknown
    try {
      await handler(confidentialRt, { prompt: "confidential-only" })
    } catch (err) {
      confErr = err
    }
    assert.ok(confErr !== undefined)
    assert.strictEqual(openRouterSrv.requests.length, orCountBefore)

    installNodeRuntimeAdapters()
    const ac = new AbortController()
    const allowance = createModelAttemptAllowance({
      signal: ac.signal,
      budgetMicroUsd: 100000,
      maxAttempts: 1,
      maxOutputTokens: 64,
      expiresAt: Date.now() + 60000,
      tariffs: [{
        provider: "openai-compatible",
        model: "primary-model",
        route: primarySrv.endpoint,
        inputNanoUsdPerToken: 100,
        outputNanoUsdPerToken: 100,
        inputTokenUpperBound: 10000,
      }],
    })
    const lease = allowance.openTurn("msg-1", ac.signal)
    const leaseCtx = { messageId: "msg-1", modelAttemptTurnId: "msg-1", onStreamChunk: async () => undefined, modelAttemptLease: lease }
    let mediaLeaseErr: unknown
    let exhaustedLeaseErr: unknown
    try {
      try {
        await runWithStreamingContext(
          leaseCtx,
          () => handler(rt, { prompt: "see image", attachments: [{ data: "abc", mediaType: "image/png" }] }),
        )
      } catch (err) {
        mediaLeaseErr = err
      }
      const beforeLeaseCalls = primaryCalls
      const leasedReply = await runWithStreamingContext(
        leaseCtx,
        () => handler(rt, { prompt: "leased-ok", omitMaxTokens: true }),
      )
      assert.strictEqual(leasedReply, "leased-reply")
      assert.strictEqual(primarySrv.requests[primarySrv.requests.length - 1]?.json?.max_completion_tokens, 64)
      assert.ok(allowance.remainingMicroUsd < 100000)
      try {
        await runWithStreamingContext(
          leaseCtx,
          () => handler(rt, { prompt: "leased-ok" }),
        )
      } catch (err) {
        exhaustedLeaseErr = err
      }
      assert.strictEqual(primaryCalls, beforeLeaseCalls + 1)
    } finally {
      lease.close()
      allowance.close()
    }
    assert.ok(mediaLeaseErr instanceof ElizaError && mediaLeaseErr.code === "MODEL_ATTEMPT_POLICY_ROUTE")
    assert.ok(exhaustedLeaseErr instanceof ElizaError && exhaustedLeaseErr.code === "MODEL_ATTEMPT_POLICY_EXHAUSTED")
  } finally {
    await primarySrv.stop()
    await openRouterSrv.stop()
  }
})

it('Embeddings, images, audio transcription/TTS, deep research, and lazy BPE tokenizer work end to end (spec/openai/index.md, "Tokenizer cache keys distinguish concrete model encodings")', async () => {
  const srv = await startOpenAiTestServer((req, res) => {
    if (req.url.endsWith("/embeddings")) {
      res.writeHead(200, { "content-type": "application/json" })
      const dim = typeof req.json?.dimensions === "number" ? req.json.dimensions : 384
      res.end(JSON.stringify({
        data: [{ index: 0, embedding: Array.from({ length: dim }, (_x, i) => i === 0 ? 0.5 : 0) }],
        usage: { prompt_tokens: 4, total_tokens: 4 },
      }))
      return
    }
    if (req.url.endsWith("/images/generations")) {
      res.writeHead(200, { "content-type": "application/json" })
      res.end(JSON.stringify({
        output_format: "webp",
        data: [{ b64_json: "AQID", revised_prompt: "sharp cat" }],
      }))
      return
    }
    if (req.url.endsWith("/chat/completions")) {
      res.writeHead(200, { "content-type": "application/json" })
      res.end(JSON.stringify({
        choices: [{ message: { content: "Title: Harbor Dawn\nDescription: Boats moored at sunrise." }, finish_reason: "stop" }],
        usage: { prompt_tokens: 20, completion_tokens: 12, total_tokens: 32 },
      }))
      return
    }
    if (req.url.endsWith("/audio/transcriptions")) {
      if (req.rawBody.includes('name="response_format"\r\n\r\ntext')) {
        res.writeHead(200, { "content-type": "text/plain" })
        res.end("plain transcript")
        return
      }
      res.writeHead(200, { "content-type": "application/json" })
      res.end(JSON.stringify({ text: "json transcript" }))
      return
    }
    if (req.url.endsWith("/audio/speech")) {
      if (req.json?.input === "empty-audio") {
        res.writeHead(200, { "content-type": "audio/mpeg" })
        res.end(new Uint8Array(0))
        return
      }
      res.writeHead(200, { "content-type": "audio/mpeg" })
      res.end(new Uint8Array([0x49, 0x44, 0x33, 0x03, 0x00, 0x00]))
      return
    }
    if (req.url.endsWith("/responses")) {
      res.writeHead(200, { "content-type": "application/json" })
      res.end(JSON.stringify({
        id: "resp_1",
        status: "completed",
        output_text: "Deep synthesis.",
        output: [
          { id: "ws_1", type: "web_search_call", status: "completed", action: { type: "search", query: "eliza" } },
          {
            type: "message",
            content: [{
              type: "output_text",
              text: "Deep synthesis.",
              annotations: [{ url: "https://example.com", title: "Example", start_index: 0, end_index: 4 }],
            }],
          },
        ],
      }))
      return
    }
    res.writeHead(404)
    res.end()
  })

  try {
    const events: RecordedEvent[] = []
    const rt = makeRuntime({
      OPENAI_API_KEY: "test-key",
      OPENAI_BASE_URL: srv.endpoint,
      OPENAI_EMBEDDING_DIMENSIONS: "384",
      OPENAI_SMALL_MODEL: "gpt-4o-mini",
      OPENAI_LARGE_MODEL: "gpt-4",
    }, events)

    const embed = plugin.models?.[ModelType.TEXT_EMBEDDING] as (runtime: IAgentRuntime, params: unknown) => Promise<number[]>
    const probe = await embed(rt, null)
    assert.strictEqual(probe.length, 384)
    assert.strictEqual(probe[0], 0.1)

    const vec = await embed(rt, { text: "hello world" })
    assert.strictEqual(vec.length, 384)
    assert.strictEqual(vec[0], 0.5)

    const cerebrasNoEmbedRt = makeRuntime({ ELIZA_PROVIDER: "cerebras", CEREBRAS_API_KEY: "csk" })
    let cerebrasNullProbeErr: unknown
    try {
      await embed(cerebrasNoEmbedRt, null)
    } catch (err) {
      cerebrasNullProbeErr = err
    }
    assert.ok(cerebrasNullProbeErr instanceof ElizaError && cerebrasNullProbeErr.code === "EMBEDDING_PROVIDER_UNAVAILABLE")

    let cerebrasEmbedErr: unknown
    try {
      await embed(cerebrasNoEmbedRt, { text: "hello" })
    } catch (err) {
      cerebrasEmbedErr = err
    }
    assert.ok(cerebrasEmbedErr instanceof ElizaError && cerebrasEmbedErr.code === "EMBEDDING_PROVIDER_UNAVAILABLE")

    const imgs = await handleImageGeneration(rt, { prompt: "a cat", count: 1 })
    assert.deepStrictEqual(imgs, [{ url: "data:image/webp;base64,AQID", revisedPrompt: "sharp cat" }])

    const desc = await handleImageDescription(rt, "https://example.com/harbor.jpg")
    assert.deepStrictEqual(desc, { title: "Harbor Dawn", description: "Boats moored at sunrise." })
    assert.deepStrictEqual(parseImageDescriptionResponse("A book with title: Dune on its cover."), {
      title: "Image Analysis",
      description: "A book with title: Dune on its cover.",
    })

    const wavBytes = new Uint8Array([0x52, 0x49, 0x46, 0x46, 0, 0, 0, 0, 0x57, 0x41, 0x56, 0x45, 0, 0])
    assert.strictEqual(detectAudioMimeType(wavBytes), "audio/wav")
    assert.strictEqual(normalizeAudioMimeType("audio/x-m4a; codecs=aac"), "audio/mp4")
    assert.strictEqual(getFilenameForMimeType("audio/wav"), "recording.wav")

    const jsonTx = await handleTranscription(rt, wavBytes)
    assert.strictEqual(jsonTx, "json transcript")
    const textTx = await handleTranscription(rt, { audio: wavBytes, responseFormat: "text" })
    assert.strictEqual(textTx, "plain transcript")

    let emptyUrlErr: unknown
    try {
      await handleTranscription(rt, { audioUrl: "" })
    } catch (err) {
      emptyUrlErr = err
    }
    assert.ok(emptyUrlErr instanceof OpenAiFailure)

    const speechBuf = await handleTextToSpeech(rt, { text: "Hello voice" })
    assert.strictEqual(speechBuf.byteLength, 6)

    let emptyAudioErr: unknown
    try {
      await handleTextToSpeech(rt, { text: "empty-audio" })
    } catch (err) {
      emptyAudioErr = err
    }
    assert.ok(emptyAudioErr instanceof OpenAiFailure)

    const research = await handleResearch(rt, { input: "Analyze eliza", maxToolCalls: 3 })
    assert.strictEqual(research.id, "resp_1")
    assert.strictEqual(research.text, "Deep synthesis.")
    assert.strictEqual(research.annotations.length, 1)
    assert.strictEqual(research.outputItems.length, 2)

    assert.strictEqual(resolveTokenizerEncodingName("gpt-4o-mini"), "o200k_base")
    assert.strictEqual(resolveTokenizerEncodingName("custom-legacy-model"), "cl100k_base")
    assert.strictEqual(resolveTokenizerEncodingName("gpt-5.6-luna"), "o200k_base")

    const encode = plugin.models?.[ModelType.TEXT_TOKENIZER_ENCODE] as (runtime: IAgentRuntime, params: unknown) => Promise<number[]>
    const decode = plugin.models?.[ModelType.TEXT_TOKENIZER_DECODE] as (runtime: IAgentRuntime, params: unknown) => Promise<string>
    const tokens = await encode(rt, { prompt: "Hello tokenizer!", modelType: ModelType.TEXT_SMALL })
    assert.ok(tokens.length > 0)
    assert.strictEqual(await decode(rt, { tokens, modelType: ModelType.TEXT_SMALL }), "Hello tokenizer!")
    assert.ok(loadedEncodingNames().includes("o200k_base"))
  } finally {
    await srv.stop()
  }
})

it('Wire strict gating inspects objects nested in combinator and definition subschemas (spec/openai/index.md, "Tools are sent strict only when every tool in the request is strict")', async () => {
  const closedObject = { type: "object", additionalProperties: false, properties: { a: { type: "string" } }, required: ["a"] }
  const unclosedObject = { type: "object", properties: { a: { type: "string" } }, required: ["a"] }
  const underRequiredObject = { type: "object", additionalProperties: false, properties: { a: { type: "string" }, b: { type: "string" } }, required: ["a"] }
  const wrap = (value: unknown) => ({ type: "object", additionalProperties: false, properties: { v: value }, required: ["v"] })

  assert.strictEqual(isWireStrictSchema(closedObject), true)
  assert.strictEqual(isWireStrictSchema(wrap({ anyOf: [closedObject, { type: "string" }] })), true)
  assert.strictEqual(isWireStrictSchema(wrap({ anyOf: [unclosedObject] })), false)
  assert.strictEqual(isWireStrictSchema(wrap({ oneOf: [underRequiredObject] })), false)
  assert.strictEqual(isWireStrictSchema(wrap({ allOf: [unclosedObject] })), false)
  assert.strictEqual(isWireStrictSchema({ anyOf: [unclosedObject] }), false)
  assert.strictEqual(isWireStrictSchema({ type: "object", additionalProperties: false, properties: { v: { type: "string" } }, required: ["v"], $defs: { helper: unclosedObject } }), false)
  assert.strictEqual(isWireStrictSchema({ type: "object", additionalProperties: false, patternProperties: { "^x": unclosedObject } }), false)
  assert.strictEqual(isWireStrictSchema({ type: "array", prefixItems: [unclosedObject] }), false)
  assert.strictEqual(isWireStrictSchema(wrap({ not: unclosedObject })), false)
  assert.strictEqual(isWireStrictSchema(wrap({ if: unclosedObject, then: closedObject })), false)
  assert.strictEqual(isWireStrictSchema(wrap({ type: "array", items: { anyOf: [unclosedObject] } })), false)

  const srv = await startOpenAiTestServer((req, res) => {
    res.writeHead(200, { "content-type": "application/json" })
    res.end(JSON.stringify({
      choices: [{ message: { content: "done", tool_calls: [] }, finish_reason: "stop" }],
      usage: { prompt_tokens: 10, completion_tokens: 5, total_tokens: 15 },
    }))
  })
  try {
    const runtime = makeRuntime({ OPENAI_API_KEY: "k", OPENAI_BASE_URL: srv.endpoint })
    const handler = plugin.models?.[ModelType.TEXT_SMALL] as (runtime: IAgentRuntime, params: unknown) => Promise<string | GenerateTextResult | TextStreamResult>
    const strictRead = {
      name: "READ",
      description: "Read",
      strict: true,
      parameters: { type: "object", additionalProperties: false, properties: { path: { type: "string" } }, required: ["path"] },
    }
    await handler(runtime, {
      prompt: "Pick",
      tools: [
        strictRead,
        {
          name: "PICK",
          description: "Pick",
          strict: true,
          parameters: wrap({ anyOf: [unclosedObject] }),
        },
      ],
    })
    await handler(runtime, {
      prompt: "Pick closed",
      tools: [
        {
          name: "PICK",
          description: "Pick",
          strict: true,
          parameters: wrap({ anyOf: [closedObject, { type: "string" }] }),
        },
      ],
    })
    const hiddenTools = srv.requests[0]?.json?.tools as Array<{ function: { name: string; strict?: boolean } }>
    const closedTools = srv.requests[1]?.json?.tools as Array<{ function: { name: string; strict?: boolean } }>
    assert.deepStrictEqual(
      hiddenTools.map((tool) => [tool.function.name, "strict" in tool.function ? tool.function.strict : undefined]),
      [["READ", undefined], ["PICK", undefined]],
    )
    assert.deepStrictEqual(
      closedTools.map((tool) => [tool.function.name, "strict" in tool.function ? tool.function.strict : undefined]),
      [["PICK", true]],
    )
  } finally {
    await srv.stop()
  }
})
