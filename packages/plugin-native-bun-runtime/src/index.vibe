// spec/nativeBunRuntime/index.md, "Story: Send messages and request local speech through the running embedded runtime"
import { agentClient } from "@elizaos/os-bridges"
import type { AgentRequest, AgentStatus, ElizaAgentPlugin } from "@elizaos/os-bridges"
import { acceptRuntimeReply, mayUseRuntime, type LocalSpeechStatus, type RuntimeSnapshot } from "../gen/nativeBunRuntime.effect.vibe"

export error EmbeddedRuntimeUnavailable
export error EmbeddedRuntimeRetired

export interface EmbeddedRuntimeReply {
  readonly status: number
  readonly data: unknown
}

export function runtimeSnapshot(status: AgentStatus, speech: LocalSpeechStatus = "LocalSpeechUnavailable"): RuntimeSnapshot {
  const health = status.state === "running" ? "EmbeddedRunning" : status.state === "starting" ? "EmbeddedStarting" :
    status.state === "failed" ? "EmbeddedFailed" : "EmbeddedStopped"
  return { health, launchId: String(status.epoch), speech }
}

export function createEmbeddedRuntime(port: ElizaAgentPlugin = agentClient()) {
  return {
    start: () => port.start(),
    stop: () => port.stop(),
    getStatus: () => port.getStatus(),
    effect call(request: AgentRequest) {
      const active = runtimeSnapshot(try tryPromise(() => port.getStatus()))
      if (!mayUseRuntime(active, "EmbeddedCall", active.launchId)) throw new EmbeddedRuntimeUnavailable()
      const reply: EmbeddedRuntimeReply = try tryPromise(() => port.request(request))
      const current = runtimeSnapshot(try tryPromise(() => port.getStatus()))
      if (!acceptRuntimeReply(current, active.launchId)) throw new EmbeddedRuntimeRetired()
      return reply
    },
  }
}
