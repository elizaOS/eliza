export error McpUnavailable { serverId: string; operation: string }
export error McpRefused { serverId: string; reason: string }

export type McpConnection =
  | { readonly kind: "http"; readonly url: URL; readonly fetch: typeof fetch }
  | { readonly kind: "stdio"; readonly command: string; readonly args: readonly string[]; readonly env: Readonly<Record<string, string>> }

export service McpConnectionPolicy {
  admit(server: McpServer): (McpConnection | undefined)!McpRefused
}

effect function withClient<A, E, R>(server: McpServer, run: (client: Client) => A!E!R) {
  const policy = try McpConnectionPolicy
  const connection = try policy.admit(server)
  if (connection === undefined || !connectionAllowed(server, true) || ((server.transport === "HttpTransport") !== (connection.kind === "http"))) {
    throw new McpRefused({ serverId: server.serverId, reason: "connection not authorized" })
  }
  const session = try Effect.try({
    try: () => ({
      client: new Client({ name: "eliza", version: "4.0.0" }),
      transport: connection.kind === "http"
        ? new StreamableHTTPClientTransport(connection.url, { fetch: connection.fetch })
        : new StdioClientTransport({ command: connection.command, args: [...connection.args], env: { ...connection.env }, stderr: "pipe" }),
    }),
    catch: () => new McpUnavailable({ serverId: server.serverId, operation: "create transport" }),
  })
  return try ensuring(effect {
    try tryPromise({
      try: () => session.client.connect(session.transport),
      catch: () => new McpUnavailable({ serverId: server.serverId, operation: "connect" }),
    })
    return try run(session.client)
  }, effect {
    tryPromise({ try: () => session.client.close(), catch: () => undefined }) catch () => undefined
  })
}

export effect function listMcpTools(server: McpServer) {
  return try withClient(server, effect (client) =>
    try tryPromise({ try: () => client.listTools(), catch: () => new McpUnavailable({ serverId: server.serverId, operation: "list tools" }) }),
  )
}

export effect function callMcpTool(server: McpServer, toolName: string, argumentsToTry: readonly Readonly<Record<string, unknown>>[]) {
  return try withClient(server, effect (client) => {
    const listed = try tryPromise({
      try: () => client.listTools(),
      catch: () => new McpUnavailable({ serverId: server.serverId, operation: "list tools" }),
    })
    const matches = listed.tools.filter((tool) => tool.name === toolName)
    const tool = matches[0]
    if (matches.length !== 1 || tool === undefined) throw new McpRefused({ serverId: server.serverId, reason: "unknown or ambiguous tool" })
    const validate = try Effect.try({
      try: () => new Ajv({ strict: true, allErrors: false }).compile(tool.inputSchema),
      catch: () => new McpRefused({ serverId: server.serverId, reason: "unsupported tool input schema" }),
    })
    provide machine() {
      const invocation = try Machine
      for (const candidate of argumentsToTry) {
        const valid = try Effect.try({
          try: () => validate(candidate),
          catch: () => new McpRefused({ serverId: server.serverId, reason: "argument validation failed" }),
        })
        const result = try invocation.send({ type: "observeArguments", valid })
        if (result.phase === "InvocationRefused") break
        if (result.phase !== "ReadyToInvoke") continue
        try invocation.send({ type: "authorizeInvocation" })
        return try tryPromise({
          try: () => client.callTool({ name: toolName, arguments: { ...candidate } }),
          catch: () => new McpUnavailable({ serverId: server.serverId, operation: "invoke tool" }),
        })
      }
      throw new McpRefused({ serverId: server.serverId, reason: "invalid tool arguments" })
    }
  })
}

type SchemaNode = Readonly<Record<string, unknown>>
const VALUE_TYPES = ["string", "number", "integer", "boolean", "object", "array"] as const
const WIRE_KEYWORDS = new Set(["type", "nullable", "properties", "required", "additionalProperties", "items", "description", "title"])

function isSchemaNode(value: unknown): value is SchemaNode {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

function unionBranches(node: SchemaNode): readonly SchemaNode[] | undefined {
  if (node.type !== undefined) return undefined
  const branches = node.anyOf ?? node.oneOf
  return Array.isArray(branches) && branches.length > 0 && branches.every(isSchemaNode) ? branches : undefined
}

function directTypeNames(node: SchemaNode): string[] | undefined {
  if (typeof node.type === "string") return [node.type]
  if (Array.isArray(node.type) && node.type.length > 0 && node.type.every((name): name is string => typeof name === "string")) return node.type
  return undefined
}

function isTypedSchema(node: SchemaNode): boolean {
  const direct = directTypeNames(node)
  if (direct !== undefined) return direct.every((name) => name === "null" || VALUE_TYPES.some((type) => type === name))
  const union = unionBranches(node)
  return union !== undefined && union.every(isTypedSchema)
}

function anyValue(depth: number): ActionParameterSchema {
  return {
    anyOf: [
      { type: "string" },
      { type: "number" },
      { type: "boolean" },
      { type: "null" },
      { type: "object", additionalProperties: true },
      ...(anyValueNestsArray(depth) ? [{ type: "array", items: anyValue(depth + 1) }] : []),
    ],
  }
}

function declaredFacets(node: SchemaNode): ShapeFacet[] {
  return [
    ...(isSchemaNode(node.properties) ? ["NestedProperties" as const] : []),
    ...(Array.isArray(node.required) ? ["RequiredNames" as const] : []),
    ...(node.additionalProperties !== undefined || node.patternProperties !== undefined ? ["OtherNames" as const] : []),
    ...(isSchemaNode(node.items) && node.prefixItems === undefined ? ["ArrayItems" as const] : []),
  ]
}

function parameterShape(node: unknown, depth: number, inUnion = false): ActionParameterSchema {
  if (!isSchemaNode(node)) return anyValue(depth)
  const shape = projectShape(declaredFacets(node), isTypedSchema(node), depth)
  if (shape.anyValue) return anyValue(depth)
  const description = (depth > 0 || inUnion) && typeof node.description === "string" ? { description: node.description } : {}
  const union = unionBranches(node)
  if (union !== undefined) {
    const branches: ActionParameterSchema[] = []
    const pushBranch = (entry: ActionParameterSchema) => {
      if (entry.type === "null" && entry.description === undefined && branches.some((existing) => existing.type === "null" && existing.description === undefined)) return
      branches.push(entry)
    }
    for (const branch of union) {
      const projected = parameterShape(branch, depth, true)
      if (projected.anyOf !== undefined && projected.description === undefined) projected.anyOf.forEach(pushBranch)
      else pushBranch(projected)
    }
    return branches.length === 1 ? { ...branches[0], ...description } : { anyOf: branches, ...description }
  }
  const names = directTypeNames(node) ?? []
  const has = (facet: ShapeFacet) => shape.facets.includes(facet)
  const branches: ActionParameterSchema[] = VALUE_TYPES.filter((type) => names.includes(type)).map((type) => {
    if (type === "object") {
      const properties = has("NestedProperties") && isSchemaNode(node.properties) ? node.properties : {}
      const required = has("RequiredNames") && Array.isArray(node.required) ? node.required : []
      return {
        type,
        properties: Object.fromEntries(Object.entries(properties).map(([name, child]) => [name, parameterShape(child, depth + 1)])),
        required: required.filter((name) => typeof name === "string" && Object.hasOwn(properties, name)),
        additionalProperties: !has("OtherNames") || node.patternProperties !== undefined || node.additionalProperties === true
          ? true
          : isSchemaNode(node.additionalProperties) ? parameterShape(node.additionalProperties, depth + 1) : false,
      }
    }
    if (type === "array") return { type, items: has("ArrayItems") ? parameterShape(node.items, depth + 1) : anyValue(depth + 1) }
    return { type }
  })
  if (names.includes("null") || node.nullable === true) branches.push({ type: "null" })
  return branches.length === 1 ? { ...branches[0], ...description } : { anyOf: branches, ...description }
}

function omitsConstraints(node: unknown): boolean {
  if (!isSchemaNode(node)) return false
  return Object.entries(node).some(([keyword, value]) =>
    !WIRE_KEYWORDS.has(keyword) ||
    (keyword === "properties" && isSchemaNode(value) && Object.values(value).some(omitsConstraints)) ||
    ((keyword === "items" || keyword === "additionalProperties") && omitsConstraints(value)),
  )
}

function parameterDescription(node: unknown): string {
  const stated = isSchemaNode(node) && typeof node.description === "string" ? node.description : ""
  if (!omitsConstraints(node)) return stated
  try {
    return `${stated} JSON schema: ${JSON.stringify(node)}`.trim()
  } catch {
    return stated
  }
}

export function mcpToolParameters(inputSchema: SchemaNode): ActionParameter[] {
  const properties = isSchemaNode(inputSchema.properties) ? inputSchema.properties : {}
  const required = Array.isArray(inputSchema.required) ? inputSchema.required : []
  return Object.entries(properties).map(([name, node]) => ({
    name,
    description: parameterDescription(node),
    required: required.includes(name),
    schema: parameterShape(node, 0),
  }))
}

function actionName(serverId: string, toolName: string, taken: Set<string>): string {
  const base = `MCP_${serverId}_${toolName}`.toUpperCase().replace(/[^A-Z0-9_]+/g, "_")
  let name = base
  for (let suffix = 2; taken.has(name); suffix += 1) name = `${base}_${suffix}`
  taken.add(name)
  return name
}

function toolText(result: SchemaNode): string {
  return (Array.isArray(result.content) ? result.content : [])
    .flatMap((part) => isSchemaNode(part) && part.type === "text" && typeof part.text === "string" ? [part.text] : [])
    .join("\n")
}

effect function toolResult(server: McpServer, toolName: string, parameters: Readonly<Record<string, unknown>>) {
  return effect {
    const result: SchemaNode = try callMcpTool(server, toolName, [parameters])
    const text = toolText(result)
    return (result.isError === true ? { success: false, text, error: text || `${toolName} failed` } : { success: true, text }) satisfies ActionResult
  } catch (failure) => ({ success: false, error: failure instanceof McpRefused ? failure.reason : `The ${server.serverId} MCP server could not run ${toolName}.` }) satisfies ActionResult
}

export effect function mcpToolActions(server: McpServer) {
  const policy = try McpConnectionPolicy
  const listed = try listMcpTools(server)
  const taken = new Set<string>()
  return listed.tools.map((tool): Action => ({
    name: actionName(server.serverId, tool.name, taken),
    description: tool.description ?? `Call ${tool.name} on the ${server.serverId} MCP server.`,
    contexts: ["connectors"],
    roleGate: { minRole: "ADMIN" },
    parameters: mcpToolParameters(tool.inputSchema),
    validate: async () => true,
    handler: (_runtime, _message, _state, options) => runPromise(effect {
      const parameters = options?.parameters
      provide McpConnectionPolicy = policy {
        return try toolResult(server, tool.name, isSchemaNode(parameters) ? parameters : {})
      }
    }),
  }))
}

export type McpInvocationMachineHandle = McpMachineHandle<McpInvocation, McpInvocationEvent>

export function createMcpInvocationHandle(): McpInvocationMachineHandle {
  const created = runSync(effect {
    provide machine() {
      const m = try Machine
      return m
    }
  })
  return wrapMcpMachineHandle(created)
}

function withMcpContext(action: Action): Action {
  return {
    ...action,
    contexts: [...new Set([...(action.contexts ?? []), "general", "automation", "knowledge", MCP_ACTION_CONTEXT])],
  }
}

export const mcpPlugin: Plugin = {
  name: "@elizaos/plugin-mcp",
  description: "Plugin for connecting to MCP (Model Context Protocol) servers",
  init: async (_config: Record<string, string>, _runtime: IAgentRuntime): Promise<void> => {
    logger.info("Initializing MCP plugin...")
  },
  async dispose(runtime: IAgentRuntime) {
    const svc = runtime.getService<McpService>(McpService.serviceType)
    await svc?.stop()
  },
  services: [McpService],
  actions: [...promoteSubactionsToActions(withMcpContext(mcpAction))],
  providers: [mcpProvider],
}

export const plugin: Plugin = mcpPlugin
const defaultMcpPlugin: Plugin = mcpPlugin
export default defaultMcpPlugin

