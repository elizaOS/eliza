// spec/mcp/index.md, "Story: Call an explicitly enabled server with valid tool arguments"; spec/mcp/index.md, "A tool's parameters keep the nested shape of its input schema down to a fixed depth"; spec/mcp/index.md, "An invocation can be sent once only after its original schema accepts the arguments"; spec/mcp/workerLifecycle.md, "Story: Isolate untrusted MCP schema compilation and validation"
import { assert, describe, it } from "@effect/vitest"
import { type Action, type ActionParameters, type ActionResult, type Memory, actionToTool, AgentRuntime, stringToUuid, validateToolArgs } from "@elizaos/core"
import {
  AnthropicMcpCompatibility,
  GoogleMcpCompatibility,
  McpConnectionPolicy,
  McpService,
  OpenAIReasoningMcpCompatibility,
  actionNamesCollide,
  convertJsonSchemaToActionParams,
  detectMcpModelProvider,
  evaluateSchemaWithWorkerLifecycle,
  formatMcpProviderForPrompt,
  generateSimiles,
  getMcpServerDetails,
  handleMcpRoutes,
  isMcpSettings,
  makeUniqueActionName,
  mcpAction,
  mcpPlugin,
  mcpProvider,
  mcpToolActions,
  parseActionName,
  parseJSON,
  searchMcpMarketplace,
  toActionName,
  validateJsonSchema,
  validateMcpServerConfigSecurity,
  validateParamsAgainstSchema,
} from "../src/index.vibe"

module node {
  import { once } from "node:events"
  import { createServer } from "node:http"
  import { Server } from "@modelcontextprotocol/sdk/server/index.js"
  import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js"
  import { CallToolRequestSchema, ListResourcesRequestSchema, ListResourceTemplatesRequestSchema, ListToolsRequestSchema, ReadResourceRequestSchema } from "@modelcontextprotocol/sdk/types.js"
  import { Ajv } from "ajv"
  import type http from "node:http"
  import type { IAgentRuntime } from "@elizaos/core"
  import type { McpRouteConfig, McpRouteContext, McpService } from "../src/index.vibe"

  const text = { type: "string" }
  const deep = (levels: number, leaf: object = { type: "integer" }): object => levels === 0 ? leaf : { type: "object", properties: { next: deep(levels - 1, leaf) }, required: ["next"] }

  const tools = [
    { name: "push_files", inputSchema: { type: "object", properties: { branch: text, files: { type: "array", items: { type: "object", properties: { path: text, content: text }, required: ["path", "content"], additionalProperties: false } } }, required: ["branch", "files"] } },
    { name: "create_page", inputSchema: { type: "object", properties: { parent: { type: "object", properties: { page_id: text }, required: ["page_id"] }, title: { type: "string", minLength: 1, description: "Page title" } }, required: ["parent", "title"] } },
    { name: "sum_ids", inputSchema: { type: "object", properties: { ids: { type: "array", items: { type: "integer" } } }, required: ["ids"] } },
    { name: "echo_value", inputSchema: { type: "object", properties: { value: {} }, required: ["value"] } },
    { name: "set_labels", inputSchema: { type: "object", properties: { labels: { type: "object", additionalProperties: text } }, required: ["labels"] } },
    { name: "nest", inputSchema: { type: "object", properties: { root: deep(7) }, required: ["root"] } },
    {
      name: "query_items",
      inputSchema: {
        type: "object",
        properties: {
          filter: {
            anyOf: [
              { type: "object", description: "Owner filter", properties: { owner: text }, required: ["owner"], additionalProperties: false },
              { type: ["string", "null"] },
              { type: "null" },
            ],
          },
          tags: {
            anyOf: [
              { type: "array", items: { type: "integer" } },
              { type: "null" },
            ],
          },
          flex: {
            anyOf: [
              text,
              {},
            ],
          },
          both: {
            anyOf: [text, { type: "integer" }],
            oneOf: [text, { type: "integer" }],
          },
          atLimit: deep(4, {
            anyOf: [
              { type: "object", properties: { leaf: { type: "integer" } }, required: ["leaf"], additionalProperties: false },
              { type: "null" },
            ],
          }),
        },
        required: ["filter"],
      },
    },
    {
      name: "resolve_target",
      inputSchema: {
        type: "object",
        properties: {
          target: {
            oneOf: [
              { type: "object", properties: { issue: { type: "integer" } }, required: ["issue"], additionalProperties: false },
              { type: "object", properties: { slug: text }, required: ["slug"], additionalProperties: false },
            ],
          },
        },
        required: ["target"],
      },
    },
  ]

  export async function startServer(signal: AbortSignal): Promise<{ connection: { readonly kind: "http"; readonly url: URL; readonly fetch: typeof fetch }; called: string[]; delivered: unknown[]; stop(): Promise<void> }> {
    const called: string[] = []
    const delivered: unknown[] = []
    const ajv = new Ajv({ strict: true })
    const http = createServer((request, response) => {
      const server = new Server({ name: "nested-shape-server", version: "1.0.0" }, { capabilities: { tools: {} } })
      server.setRequestHandler(ListToolsRequestSchema, async () => ({ tools }))
      server.setRequestHandler(CallToolRequestSchema, async ({ params }) => {
        called.push(params.name)
        const tool = tools.find((entry) => entry.name === params.name)
        if (tool === undefined || !ajv.validate(tool.inputSchema, params.arguments ?? {})) return { isError: true, content: [{ type: "text", text: "refused" }] }
        delivered.push({ [params.name]: params.arguments })
        return { content: [{ type: "text", text: "done" }] }
      })
      const transport = new StreamableHTTPServerTransport({ sessionIdGenerator: undefined, enableJsonResponse: true })
      response.on("close", () => { void transport.close(); void server.close() })
      void server.connect(transport).then(() => transport.handleRequest(request, response))
    })
    http.listen(0, "127.0.0.1")
    await once(http, "listening", { signal })
    const address = http.address()
    if (address === null || typeof address === "string") throw new Error("Could not reserve a loopback port")
    return { connection: { kind: "http", url: new URL(`http://127.0.0.1:${address.port}/mcp`), fetch }, called, delivered, stop: () => new Promise<void>((resolve) => http.close(() => resolve())) }
  }

  export async function startRichMcpServer(): Promise<{ readonly url: string; readonly stop: () => Promise<void> }> {
    const httpServer = createServer((request, response) => {
      const server = new Server({ name: "rich-mcp", version: "1.0.0" }, { capabilities: { tools: {}, resources: {} } })
      server.setRequestHandler(ListToolsRequestSchema, async () => ({
        tools: [
          {
            name: "add_numbers",
            description: "Adds two integers",
            inputSchema: {
              type: "object",
              properties: { a: { type: "integer" }, b: { type: "integer" } },
              required: ["a", "b"],
              additionalProperties: false,
            },
          },
        ],
      }))
      server.setRequestHandler(CallToolRequestSchema, async ({ params }) => {
        const args = (params.arguments ?? {}) as { a?: number; b?: number }
        return { content: [{ type: "text", text: `sum=${Number(args.a ?? 0) + Number(args.b ?? 0)}` }] }
      })
      server.setRequestHandler(ListResourcesRequestSchema, async () => ({
        resources: [{ uri: "docs://guide", name: "Guide", description: "Setup guide", mimeType: "text/plain" }],
      }))
      server.setRequestHandler(ListResourceTemplatesRequestSchema, async () => ({ resourceTemplates: [] }))
      server.setRequestHandler(ReadResourceRequestSchema, async ({ params }) => ({
        contents: [{ uri: params.uri, mimeType: "text/plain", text: "Welcome to MCP guide" }],
      }))
      const transport = new StreamableHTTPServerTransport({ sessionIdGenerator: undefined, enableJsonResponse: true })
      response.on("close", () => { void transport.close(); void server.close() })
      void server.connect(transport).then(() => transport.handleRequest(request, response))
    })
    httpServer.listen(0, "127.0.0.1")
    await once(httpServer, "listening")
    const addr = httpServer.address() as { port: number }
    return {
      url: `http://127.0.0.1:${addr.port}/mcp`,
      stop: () => new Promise<void>((resolve) => httpServer.close(() => resolve())),
    }
  }

  export async function startMockRegistry(): Promise<{ readonly baseUrl: string; readonly stop: () => Promise<void> }> {
    const httpServer = createServer((req, res) => {
      res.setHeader("content-type", "application/json")
      if (req.url?.startsWith("/v0/servers?")) {
        res.end(JSON.stringify({
          servers: [
            {
              server: {
                name: "io.example/github",
                title: "GitHub MCP",
                description: "GitHub tools",
                version: "1.0.0",
                remotes: [{ type: "streamable-http", url: "https://mcp.example/github" }],
              },
              _meta: { "io.modelcontextprotocol.registry/official": { isLatest: true, publishedAt: "2026-01-01T00:00:00Z" } },
            },
          ],
        }))
        return
      }
      if (req.url?.includes("/versions/latest")) {
        if (req.url.includes("missing")) {
          res.statusCode = 404
          res.end(JSON.stringify({ error: "not found" }))
          return
        }
        res.end(JSON.stringify({
          server: { name: "io.example/github", title: "GitHub MCP", description: "GitHub tools", version: "1.0.0" },
        }))
        return
      }
      res.statusCode = 404
      res.end("{}")
    })
    httpServer.listen(0, "127.0.0.1")
    await once(httpServer, "listening")
    const addr = httpServer.address() as { port: number }
    return {
      baseUrl: `http://127.0.0.1:${addr.port}`,
      stop: () => new Promise<void>((resolve) => httpServer.close(() => resolve())),
    }
  }

  export function makeMcpRuntime(mcpSetting: unknown, service?: McpService): { readonly runtime: IAgentRuntime; readonly attach: (svc: McpService) => void } {
    let attached = service ?? null
    const runtime = {
      agentId: "00000000-0000-4000-8000-000000000001",
      character: { settings: {} },
      getSetting: (key: string) => (key === "mcp" ? mcpSetting : null),
      getService: (name: string) => (name === "mcp" ? attached : null),
      getModel: () => undefined,
      useModel: async (_type: unknown, params: { prompt: string }) => params.prompt.includes("Synthesize") ? "Sum is 7." : "{}",
      createMemory: async () => "mem-1",
      reportError: () => undefined,
    } as unknown as IAgentRuntime
    return { runtime, attach: (svc) => { attached = svc } }
  }

  export function makeRouteContext(method: string, pathname: string, service: McpService): { readonly ctx: McpRouteContext; readonly replies: readonly { readonly status: number; readonly body: unknown }[] } {
    const replies: { status: number; body: unknown }[] = []
    const config: McpRouteConfig = { mcp: { servers: { docs: { type: "streamable-http", url: "https://mcp.example/docs" } } } }
    const ctx: McpRouteContext = {
      req: {} as http.IncomingMessage,
      res: {} as http.ServerResponse,
      method,
      pathname,
      url: new URL(`http://127.0.0.1${pathname}`),
      state: { config, runtime: { getService: (name) => (name === "mcp" ? service : null) } },
      json: (_res, data, status = 200) => { replies.push({ status, body: data }) },
      error: (_res, message, status = 400) => { replies.push({ status, body: { error: message } }) },
      readJsonBody: async () => null,
      saveElizaConfig: () => undefined,
      redactDeep: (v) => v,
      isBlockedObjectKey: (k) => k === "__proto__" || k === "constructor" || k === "prototype",
      cloneWithoutBlockedObjectKeys: (v) => v,
      resolveMcpServersRejection: async () => null,
      resolveMcpTerminalAuthorizationRejection: () => null,
      decodePathComponent: (raw) => decodeURIComponent(raw),
    }
    return { ctx, replies }
  }
}
import { makeMcpRuntime, makeRouteContext, startMockRegistry, startRichMcpServer, startServer } from node

const server = { serverId: "peer", serverEpoch: 1, transport: "HttpTransport" as const, enabled: true }
const nested = (levels: number, leaf: unknown): unknown => levels === 0 ? leaf : { next: nested(levels - 1, leaf) }

const cases: ReadonlyArray<readonly [string, Record<string, unknown>, string | null, boolean]> = [
  ["push_files", { branch: "main", files: [{ path: "a.md", content: "#" }] }, null, true],
  ["push_files", { branch: "main", files: [{ path: "a.md" }] }, "Missing required argument 'files[0].content'", false],
  ["push_files", { branch: "main", files: [{ path: "a.md", content: "#", mode: "100644" }] }, "Unexpected argument 'files[0].mode'", false],
  ["create_page", { parent: { page_id: "59833787" }, title: "Notes" }, null, true],
  ["create_page", { parent: {}, title: "Notes" }, "Missing required argument 'parent.page_id'", false],
  ["sum_ids", { ids: [3, 4] }, null, true],
  ["sum_ids", { ids: ["three"] }, "Argument 'ids[0]' expected integer, got string", false],
  ["echo_value", { value: "hello" }, null, true],
  ["echo_value", { value: [[["a"], []], [[1]]] }, null, true],
  ["echo_value", { value: { a: [1, { b: null }] } }, null, true],
  ["set_labels", { labels: { team: "core" } }, null, true],
  ["set_labels", { labels: { team: 1 } }, "Argument 'labels.team' expected string, got number", false],
  ["nest", { root: nested(7, 1) }, null, true],
  ["nest", { root: nested(7, "one") }, null, false],
  ["query_items", { filter: { owner: "alice" }, tags: [1, 2], flex: { ok: true }, both: "s", atLimit: nested(4, { leaf: 7 }) }, null, true],
  ["query_items", { filter: null, tags: null }, null, true],
  ["query_items", { filter: {} }, "Argument 'filter' did not satisfy any anyOf branch", false],
  ["query_items", { filter: { owner: "alice", extra: 1 } }, "Argument 'filter' did not satisfy any anyOf branch", false],
  ["query_items", { filter: null, tags: ["bad"] }, "Argument 'tags' did not satisfy any anyOf branch", false],
  ["query_items", { filter: null, both: { x: 1 } }, "Argument 'both' did not satisfy any anyOf branch", false],
  ["query_items", { filter: null, both: [1] }, "Argument 'both' did not satisfy any anyOf branch", false],
  ["query_items", { filter: null, atLimit: nested(4, {}) }, "Argument 'atLimit.next.next.next.next' did not satisfy any anyOf branch", false],
  ["resolve_target", { target: { issue: 42 } }, null, true],
  ["resolve_target", { target: { slug: "core" } }, null, true],
  ["resolve_target", { target: {} }, "Argument 'target' did not satisfy any anyOf branch", false],
  ["resolve_target", { target: { issue: "42" } }, "Argument 'target' did not satisfy any anyOf branch", false],
]

it.live("An MCP tool's nested argument shapes reach the planner and the server (spec/mcp/index.md, \"A tool's parameters keep the nested shape of its input schema down to a fixed depth\")", () => scoped(effect {
  const fixture = try acquireRelease(tryPromise((signal) => startServer(signal)), (fixture) => promise(() => fixture.stop()))
  let actions: Action[] = []
  provide McpConnectionPolicy = { admit: () => succeed(fixture.connection) } {
    actions = try mcpToolActions(server)
  }
  const runtime = try Effect.try(() => new AgentRuntime({ character: { name: "Eliza", bio: [] } }))
  const byName = new Map(actions.map((action) => [action.name, action]))
  const action = (tool: string) => byName.get(`MCP_PEER_${tool.toUpperCase()}`)
  const outcomes: Array<{ tool: string; refused: string | null; called: boolean; delivered: boolean }> = []
  for (const [tool, args] of cases) {
    const found = action(tool)
    const admitted = found === undefined ? undefined : try Effect.try(() => validateToolArgs(found, args))
    const before = fixture.delivered.length
    const calledBefore = fixture.called.length
    const result = found !== undefined && admitted?.valid === true
      ? try tryPromise(() => found.handler(runtime, { entityId: stringToUuid("owner"), roomId: stringToUuid("room"), content: { text: tool } }, undefined, { parameters: admitted.args as ActionParameters }))
      : undefined
    outcomes.push({ tool, refused: admitted?.valid === true ? null : admitted?.errors.join("; ") ?? "no action", called: fixture.called.length > calledBefore, delivered: result?.success === true && fixture.delivered.length === before + 1 })
  }
  const planned = (tool: string) => Effect.try(() => { const found = action(tool); return found === undefined ? undefined : actionToTool(found).function.parameters })
  const arrayLevels = (schema: unknown): number => {
    const branch = typeof schema === "object" && schema !== null && "anyOf" in schema && Array.isArray(schema.anyOf) ? schema.anyOf.find((entry) => entry.type === "array") : undefined
    return branch === undefined ? 0 : 1 + arrayLevels(branch.items)
  }
  const pushFiles = try planned("push_files")
  const setLabels = try planned("set_labels")
  const echoValue = try planned("echo_value")
  const createPage = try planned("create_page")
  const queryItems = try planned("query_items")
  const resolveTarget = try planned("resolve_target")
  const shapes = {
    pushFiles,
    setLabels,
    anyValueArrayLevels: arrayLevels(echoValue?.properties.value),
    title: createPage?.properties.title,
    queryFilterAnyOf: queryItems?.properties.filter?.anyOf,
    queryTagsAnyOf: queryItems?.properties.tags?.anyOf,
    queryFlexArrayLevels: arrayLevels(queryItems?.properties.flex),
    resolveTargetAnyOf: resolveTarget?.properties.target?.anyOf,
  }
  try Effect.try(() => {
    assert.deepStrictEqual(actions.map((entry) => entry.name), ["MCP_PEER_PUSH_FILES", "MCP_PEER_CREATE_PAGE", "MCP_PEER_SUM_IDS", "MCP_PEER_ECHO_VALUE", "MCP_PEER_SET_LABELS", "MCP_PEER_NEST", "MCP_PEER_QUERY_ITEMS", "MCP_PEER_RESOLVE_TARGET"])
    assert.deepStrictEqual(shapes, {
      pushFiles: {
        type: "object",
        properties: {
          branch: { type: "string" },
          files: { type: "array", items: { type: "object", properties: { path: { type: "string" }, content: { type: "string" } }, required: ["path", "content"], additionalProperties: false } },
        },
        required: ["branch", "files"],
        additionalProperties: false,
      },
      setLabels: { type: "object", properties: { labels: { type: "object", properties: {}, required: [], additionalProperties: { type: "string" } } }, required: ["labels"], additionalProperties: false },
      anyValueArrayLevels: 4,
      title: { type: "string", description: 'Page title JSON schema: {"type":"string","minLength":1,"description":"Page title"}' },
      queryFilterAnyOf: [
        { type: "object", description: "Owner filter", properties: { owner: { type: "string" } }, required: ["owner"], additionalProperties: false },
        { type: "string" },
        { type: "null" },
      ],
      queryTagsAnyOf: [
        { type: "array", items: { type: "integer" } },
        { type: "null" },
      ],
      queryFlexArrayLevels: 4,
      resolveTargetAnyOf: [
        { type: "object", properties: { issue: { type: "integer" } }, required: ["issue"], additionalProperties: false },
        { type: "object", properties: { slug: { type: "string" } }, required: ["slug"], additionalProperties: false },
      ],
    })
    assert.deepStrictEqual(outcomes, cases.map(([tool, , refused, delivered]) => ({ tool, refused, called: delivered, delivered })))
    assert.deepStrictEqual(fixture.delivered, cases.filter(([, , , delivered]) => delivered).map(([tool, args]) => ({ [tool]: args })))
  })
}), 30_000)

describe("MCP service, compatibility, marketplace, routes and worker lifecycle (spec/mcp/index.md, \"Story: Call an explicitly enabled server with valid tool arguments\")", () => {
  it("Runs McpService discovery, call_tool, read_resource, provider, routes, marketplace, JSON5, compatibility and worker lifecycle end-to-end (spec/mcp/workerLifecycle.md, \"Story: Isolate untrusted MCP schema compilation and validation\")", async () => {
    const rich = await startRichMcpServer()
    const registry = await startMockRegistry()
    try {
      const settings = { servers: { demo: { type: "streamable-http" as const, url: rich.url } } }
      assert.strictEqual(isMcpSettings(settings), true)
      assert.isNotNull(validateMcpServerConfigSecurity({ type: "stdio", command: "bash", args: ["-c", "id"] }, false))
      assert.isNotNull(validateMcpServerConfigSecurity({ type: "http", url: "http://169.254.169.254/latest" }, false))
      assert.isNull(validateMcpServerConfigSecurity({ type: "streamable-http", url: "https://mcp.example/api" }, false))

      const { runtime, attach } = makeMcpRuntime(settings)
      const service = await McpService.start(runtime)
      attach(service)
      assert.strictEqual(service.getServers().length, 1)
      assert.strictEqual(service.getServers()[0]?.status, "connected")

      const prov = await mcpProvider.get(runtime, { entityId: stringToUuid("u"), roomId: stringToUuid("r"), content: { text: "" } }, { values: {}, data: {}, text: "" })
      assert.include(prov.text ?? "", "demo")
      assert.include(formatMcpProviderForPrompt(service.getProviderData().values.mcp), "add_numbers")

      assert.strictEqual(mcpAction.toolSchemaStrict, true)
      assert.strictEqual(mcpAction.cacheStable, true)
      assert.isFunction(mcpAction.summarize)
      const paramNames = (mcpAction.parameters ?? []).map((p) => p.name)
      assert.deepStrictEqual(paramNames, [...paramNames].sort())

      const msg: Memory = { entityId: stringToUuid("u"), roomId: stringToUuid("r"), agentId: stringToUuid("a"), content: { text: "add 3 and 4" } }
      const toolRes = await mcpAction.handler(runtime, msg, undefined, { parameters: { action: "call_tool", serverName: "demo", toolName: "add_numbers", arguments: { a: 3, b: 4 } } }) as ActionResult
      assert.strictEqual(toolRes.success, true)
      assert.strictEqual(toolRes.promptDataMode, "replace-data")
      assert.include(String((toolRes.data as { output?: string }).output), "sum=7")

      const badRes = await mcpAction.handler(runtime, msg, undefined, { parameters: { action: "call_tool", serverName: "demo", toolName: "add_numbers", arguments: { a: "bad", b: 4 } } }) as ActionResult
      assert.strictEqual(badRes.success, false)

      const readRes = await mcpAction.handler(runtime, msg, undefined, { parameters: { action: "read_resource", serverName: "demo", uri: "docs://guide" } }) as ActionResult
      assert.strictEqual(readRes.success, true)
      assert.include(String((readRes.data as { output?: string }).output), "Welcome to MCP guide")

      const statusRoute = makeRouteContext("GET", "/api/mcp/status", service)
      assert.strictEqual(await handleMcpRoutes(statusRoute.ctx), true)
      assert.strictEqual((statusRoute.replies[0]?.body as { servers: { name: string }[] }).servers[0]?.name, "demo")

      const found = await searchMcpMarketplace("github", 10, { baseUrl: registry.baseUrl })
      assert.strictEqual(found.results[0]?.name, "io.example/github")
      const details = await getMcpServerDetails("io.example/github", { baseUrl: registry.baseUrl })
      assert.strictEqual(details?.version, "1.0.0")
      assert.isNull(await getMcpServerDetails("missing", { baseUrl: registry.baseUrl }))

      assert.deepStrictEqual(parseJSON("Here's prose {ignore} then { key: 'val', trailing: 1, }"), { key: "val", trailing: 1 })
      assert.strictEqual(toActionName("github", "list_prs"), "GITHUB_LIST_PRS")
      assert.strictEqual(actionNamesCollide("a-b", "A_B"), true)
      assert.deepStrictEqual(parseActionName("GITHUB_LIST_PRS"), { serverName: "github", toolName: "list_prs" })
      assert.strictEqual(makeUniqueActionName("github", "list_prs", new Set(["GITHUB_LIST_PRS"])), "GITHUB_LIST_PRS_2")
      assert.isAbove(generateSimiles("github", "list_prs").length, 0)

      assert.strictEqual(detectMcpModelProvider({ modelProvider: "anthropic", model: "claude-3" }).provider, "anthropic")
      const googleRewritten: Record<string, unknown> = new GoogleMcpCompatibility({ provider: "google", modelId: "gemini-2.5" }).transformToolSchema({ type: "object", additionalProperties: false, properties: { x: { type: "string", minLength: 2 } } } as Record<string, unknown>)
      assert.notProperty(googleRewritten, "additionalProperties")
      assert.include(String(googleRewritten.description), "Constraints:")
      const anthropicRewritten: Record<string, unknown> = new AnthropicMcpCompatibility({ provider: "anthropic", modelId: "claude" }).transformToolSchema({ type: "object", additionalProperties: false } as Record<string, unknown>)
      assert.notProperty(anthropicRewritten, "additionalProperties")
      const openaiRewritten: Record<string, unknown> = new OpenAIReasoningMcpCompatibility({ provider: "openai", modelId: "o3", isReasoningModel: true }).transformToolSchema({ type: "object", additionalProperties: false } as Record<string, unknown>)
      assert.include(String(openaiRewritten.description), "IMPORTANT:")

      const converted = convertJsonSchemaToActionParams({ properties: { mode: { type: "string", enum: ["fast", "deep"] } }, required: ["mode"] })
      assert.strictEqual(converted?.[0]?.name, "mode")
      assert.deepStrictEqual(validateParamsAgainstSchema({ mode: "fast" }, { properties: { mode: { type: "string", enum: ["fast", "deep"] } }, required: ["mode"] }), [])
      assert.isAbove(validateParamsAgainstSchema({ mode: "invalid" }, { properties: { mode: { type: "string", enum: ["fast", "deep"] } }, required: ["mode"] }).length, 0)
      assert.strictEqual(validateJsonSchema({ a: 1 }, { type: "object", properties: { a: { type: "integer" } }, required: ["a"] }).success, true)

      const workerEval = await runPromise(evaluateSchemaWithWorkerLifecycle({ a: 2 }, { type: "object", properties: { a: { type: "integer" } }, required: ["a"] }))
      assert.strictEqual(workerEval.success, true)

      await mcpPlugin.dispose?.(runtime)
      assert.strictEqual(service.getServers().length, 0)
    } finally {
      await rich.stop()
      await registry.stop()
    }
  }, 30_000)
})
