// spec/nativeSystem/index.md, "Story: Follow the device's authority for system controls"; spec/nativeSystem/index.md, "Native availability and approval belong to the requested system surface"
import type {
  AndroidRoleName,
  AndroidRoleRequestResult,
  DefaultAppRole,
  DefaultAppStatus,
  DeviceSettingsStatus,
  FlashlightStatus,
  LauncherApp,
  NotificationShadeOutcome,
  SystemBuildInfo,
  SystemFacts,
  SystemLaunchInfo,
  SystemLocaleInfo,
  SystemPlugin,
  SystemSettingsPage,
  SystemSettingsPageResult,
  SystemStatus,
  SystemVolumeStatus,
  SystemVolumeStream,
} from "@elizaos/os-bridges"

const ANDROID_ROLES: ReadonlySet<AndroidRoleName> = new Set(["home", "dialer", "sms", "assistant"])
const VOLUME_STREAMS: ReadonlySet<SystemVolumeStream> = new Set(["music", "ring", "alarm", "notification", "system", "voiceCall"])

export function webLocaleInfo(
  format: () => Intl.ResolvedDateTimeFormatOptions = () =>
    new Intl.DateTimeFormat(undefined, { hour: "numeric" }).resolvedOptions(),
): SystemLocaleInfo {
  const options = format()
  const cycle = options.hourCycle
  return {
    locale: options.locale,
    hour24: cycle === "h23" || cycle === "h24" ? true : cycle === "h11" || cycle === "h12" ? false : options.hour12 === false,
  }
}

export class SystemWeb implements SystemPlugin {
  async listLauncherApps(): Promise<{ apps: LauncherApp[] }> {
    return { apps: [] }
  }

  async launchApp(options: { packageName: string; activityName?: string; user?: string }): Promise<void> {
    if (typeof options?.packageName !== "string" || options.packageName === "") {
      throw new Error("Choose an installed app")
    }
    throw new Error("Launching installed apps is only available on Android.")
  }

  async addListener(): Promise<{ remove: () => Promise<void> }> {
    return { remove: async () => undefined }
  }

  async resolveDefaultApp(options: { role: DefaultAppRole }): Promise<DefaultAppStatus> {
    if (options?.role !== "dial") throw new Error("role must be dial")
    return { role: "dial", available: false }
  }

  async openDefaultApp(options: { role: DefaultAppRole }): Promise<void> {
    if (options?.role !== "dial") throw new Error("role must be dial")
    throw new Error("The default dial app is only available on Android.")
  }

  async getBuildInfo(): Promise<SystemBuildInfo> {
    return { launcher: false, version: "web" }
  }

  async getLaunchInfo(): Promise<SystemLaunchInfo> {
    return { assistant: false }
  }

  async getLocaleInfo(): Promise<SystemLocaleInfo> {
    return webLocaleInfo()
  }

  async getStatus(): Promise<SystemStatus> {
    return { packageName: "web", roles: [] }
  }

  async openSettings(): Promise<void> {
    throw new Error("System settings are only available on Android.")
  }

  async openNetworkSettings(): Promise<void> {
    throw new Error("Network settings are only available on Android.")
  }

  async openWriteSettings(): Promise<void> {
    throw new Error("Write-settings permission is only available on Android.")
  }

  async openDisplaySettings(): Promise<void> {
    throw new Error("Display settings are only available on Android.")
  }

  async openSoundSettings(): Promise<void> {
    throw new Error("Sound settings are only available on Android.")
  }

  async getSystemFacts(): Promise<SystemFacts> {
    return {}
  }

  async openSettingsPage(_options: { page: SystemSettingsPage }): Promise<SystemSettingsPageResult> {
    throw new Error("Android settings pages are only available on Android.")
  }

  async openNotificationShade(): Promise<{ status: NotificationShadeOutcome }> {
    return { status: "unsupported" }
  }

  async requestRole(options: { role: AndroidRoleName }): Promise<AndroidRoleRequestResult> {
    if (typeof options?.role !== "string" || !ANDROID_ROLES.has(options.role)) {
      throw new Error("role must be one of home, dialer, sms, assistant")
    }
    throw new Error(`Android role ${options.role} is only available on Android.`)
  }

  async getDeviceSettings(): Promise<DeviceSettingsStatus> {
    return {
      brightness: 0.75,
      brightnessMode: "unknown",
      canWriteSettings: false,
      volumes: [
        { stream: "music", current: 7, max: 15 },
        { stream: "ring", current: 4, max: 7 },
        { stream: "alarm", current: 4, max: 7 },
        { stream: "notification", current: 4, max: 7 },
      ],
    }
  }

  async setScreenBrightness(options: { brightness: number }): Promise<DeviceSettingsStatus> {
    if (typeof options?.brightness !== "number" || !Number.isFinite(options.brightness) || options.brightness < 0 || options.brightness > 1) {
      throw new Error("brightness must be a number between 0 and 1")
    }
    throw new Error("Brightness control is only available on Android.")
  }

  async setVolume(options: { stream: SystemVolumeStream; volume: number; showUi?: boolean }): Promise<SystemVolumeStatus> {
    if (typeof options?.stream !== "string" || !VOLUME_STREAMS.has(options.stream)) {
      throw new Error("stream must be one of music, ring, alarm, notification, system, voiceCall")
    }
    if (typeof options?.volume !== "number" || !Number.isFinite(options.volume) || !Number.isInteger(options.volume) || options.volume < 0) {
      throw new Error("volume must be a non-negative finite integer")
    }
    throw new Error(`${options.stream} volume control is only available on Android.`)
  }

  async setFlashlight(options: { enabled: boolean }): Promise<FlashlightStatus> {
    if (typeof options?.enabled !== "boolean") {
      throw new Error("enabled must be a boolean")
    }
    throw new Error("Flashlight control is only available on Android.")
  }
}
