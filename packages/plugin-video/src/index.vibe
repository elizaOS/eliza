// spec/video/index.md, "Story: Read metadata and captions from a video"; spec/video/index.md, "Manual English captions outrank automatic English captions and audio"; spec/video/index.md, "Story: Transcribe a video and reuse only completed work"
import { ModelType, Service, ServiceType, type IAgentRuntime, type Plugin } from "@elizaos/core"
import { Schema } from "effect"
import { Machine, mediaReadAllowed, compactVideoDateValid, machine, requestedDownloadLimit, selectManualCaptionTrack, selectVideoCaption, type ManualCaptionTrack, type PinnedCaption, type VideoInputKind } from "../gen/video.effect.vibe"

module node {
  import { execFile } from "node:child_process"
  import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises"
  import { tmpdir } from "node:os"
  import { join } from "node:path"
  import { promisify } from "node:util"
  import { fetchRemoteMedia } from "@elizaos/core-node"

  const run = promisify(execFile)

  /** @throws {never} */
  export function approvedVideoSource(raw: string): URL | undefined {
    const url = URL.parse(raw)
    if (!url || url.protocol !== "https:" || url.username || url.password) return undefined
    return url
  }

  export async function inspect(url: URL, signal: AbortSignal): Promise<unknown> {
    const { stdout } = await run("yt-dlp", ["--no-playlist", "--no-config", "--skip-download", "--dump-single-json", "--", url.href], {
      maxBuffer: 4194304, signal, timeout: 45000,
    })
    return JSON.parse(stdout)
  }

  export async function remoteMedia(url: string, limit: number, signal: AbortSignal): Promise<Uint8Array> {
    return Uint8Array.from((await fetchRemoteMedia({ url, maxBytes: limit, signal })).buffer)
  }

  export async function audioFromVideo(bytes: Uint8Array, signal: AbortSignal): Promise<Uint8Array> {
    const directory = await mkdtemp(join(tmpdir(), "eliza-video-"))
    try {
      const source = join(directory, "source")
      const output = join(directory, "transcription.wav")
      await writeFile(source, bytes)
      await run("ffmpeg", ["-nostdin", "-protocol_whitelist", "file,pipe", "-i", source, "-vn", "-ac", "1", "-ar", "16000", "-fs", "25165824", output], {
        maxBuffer: 1048576, signal, timeout: 120000,
      })
      return Uint8Array.from(await readFile(output))
    } finally {
      await rm(directory, { recursive: true, force: true })
    }
  }
}
import { approvedVideoSource, audioFromVideo, inspect, remoteMedia } from node

export error VideoFailure { reason: string; cause?: unknown }

const captionVariant = Schema.Array(Schema.Struct({ url: Schema.String, ext: Schema.optionalKey(Schema.String) }))
const captionTracks = Schema.Record(Schema.String, captionVariant)
const videoMetadata = Schema.Struct({
  id: Schema.String,
  title: Schema.String,
  description: Schema.optionalKey(Schema.String),
  channel: Schema.optionalKey(Schema.String),
  duration: Schema.optionalKey(Schema.Number),
  thumbnail: Schema.optionalKey(Schema.String),
  upload_date: Schema.optionalKey(Schema.String),
  subtitles: Schema.optionalKey(captionTracks),
  automatic_captions: Schema.optionalKey(captionTracks),
})
const autoCaptions = Schema.Struct({
  events: Schema.Array(Schema.Struct({ segs: Schema.optionalKey(Schema.Array(Schema.Struct({ utf8: Schema.optionalKey(Schema.String) }))) })),
})

function captionUrl(offered: readonly { readonly url: string; readonly ext?: string }[], type?: string): string {
  return offered.find((entry) => entry.url !== "" && entry.ext === type)?.url ?? ""
}

function manualCaptionTrack(language: string, offered: readonly { readonly url: string; readonly ext?: string }[]): ManualCaptionTrack {
  return { primaryEnglish: language === "en", srtUrl: captionUrl(offered, "srt"), vttUrl: captionUrl(offered, "vtt"), untypedUrl: captionUrl(offered) }
}

export function pinVideoCaption(metadata: typeof videoMetadata.Type): PinnedCaption {
  const manual = selectManualCaptionTrack(Object.entries(metadata.subtitles ?? {}).filter(([language]) => /^en(?:-|$)/i.test(language)).map(([language, offered]) => manualCaptionTrack(language, offered)))
  const automatic = metadata.automatic_captions?.["en"] ?? []
  return selectVideoCaption(manual.srtUrl, manual.vttUrl, manual.untypedUrl, captionUrl(automatic, "json3"), captionUrl(automatic))
}

function youtubePage(url: URL): boolean {
  return ["www.youtube.com", "youtube.com", "m.youtube.com", "youtu.be", "www.vimeo.com", "vimeo.com"].includes(url.hostname)
}

export effect function probeVideo(source: string) {
  const url = approvedVideoSource(source)
  if (url === undefined || !youtubePage(url)) throw new VideoFailure({ reason: "Select a supported HTTPS video site." })
  const raw = try tryPromise({ try: (signal) => inspect(url, signal), catch: (cause) => new VideoFailure({ reason: "Video site metadata could not be read.", cause }) })
  const info = try Schema.decodeUnknownEffect(videoMetadata)(raw)
  const date = info.upload_date
  const uploaded = date !== undefined && /^\d{8}$/.test(date) && compactVideoDateValid(Number(date.slice(0, 4)), Number(date.slice(4, 6)), Number(date.slice(6)))
    ? `${date.slice(0, 4)}-${date.slice(4, 6)}-${date.slice(6)}` : undefined
  return { ...info, uploaded }
}

effect function readVideo(source: string, kind: VideoInputKind) {
  const url = approvedVideoSource(source)
  if (url === undefined) throw new VideoFailure({ reason: "A media source must be an HTTPS URL." })
  const bytes = try tryPromise({
    try: (signal) => remoteMedia(url.href, requestedDownloadLimit(kind), signal),
    catch: (cause) => new VideoFailure({ reason: "Video media could not be downloaded.", cause }),
  })
  if (!mediaReadAllowed({ sourceRef: url.href, kind, sourceAllowed: true }, bytes.byteLength)) throw new VideoFailure({ reason: "Video media exceeds its byte budget." })
  return bytes
}

effect function extractCaption(metadata: typeof videoMetadata.Type) {
  const selected = pinVideoCaption(metadata)
  if (selected.formatKind === "ExtractAudio") return ""
  const bytes = try readVideo(selected.sourceUrl, "SubtitleDownload")
  const text = new TextDecoder().decode(bytes)
  if (selected.formatKind === "JsonCaptions" || text.trimStart().startsWith("{")) {
    const raw = try Effect.try((): unknown => JSON.parse(text))
    const reply = try Schema.decodeUnknownEffect(autoCaptions)(raw)
    return reply.events.flatMap((entry) => entry.segs?.map((segment) => segment.utf8 ?? "") ?? []).join("").replace(/\r\n?|\n/g, " ").trim()
  }
  return text.split(/\r?\n/).filter((line) => line.trim() !== "" && !/^\d+$/.test(line.trim()) && !line.includes("-->") && line.trim() !== "WEBVTT").join(" ")
}

export effect function transcribeVideo(runtime: IAgentRuntime, source: string) {
  const url = approvedVideoSource(source)
  if (url === undefined) throw new VideoFailure({ reason: "A video URL must use HTTPS." })
  provide machine() {
    const run = try Machine
    try run.send({ type: "beginVideo", sourceRef: url.href, job: "BuildTranscript", formatName: "text", sourceAllowed: true })
    let text: string
    if (youtubePage(url)) {
      const metadata = try probeVideo(url.href)
      text = (extractCaption(metadata)) catch () => ""
      if (text === "") throw new VideoFailure({ reason: "The video page supplied no usable transcript or downloadable media." })
    } else {
      const video = try readVideo(source, "DirectVideo")
      const audio = try tryPromise({
        try: (signal) => audioFromVideo(video, signal),
        catch: (cause) => new VideoFailure({ reason: "The media audio could not be converted.", cause }),
      })
      text = try tryPromise({
        try: (signal) => runtime.useModel(ModelType.TRANSCRIPTION, { audio: audio, audioUrl: "", mimeType: "audio/wav", signal }),
        catch: (cause) => new VideoFailure({ reason: "The video transcription provider did not answer.", cause }),
      })
    }
    if (text.trim() === "") throw new VideoFailure({ reason: "The video returned no transcription." })
    try run.send({ type: "publishVideo", sourceRef: url.href, job: "BuildTranscript", formatName: "text", artifactRef: "transcript", verified: true })
    return text
  }
}

export class VideoService extends Service {
  static override serviceType = ServiceType.VIDEO
  override capabilityDescription = "Read video metadata and extract captions or transcribe direct video audio."

  static override start(runtime: IAgentRuntime): Promise<VideoService> {
    return Promise.resolve(new VideoService(runtime))
  }

  getVideoInfo(source: string, signal?: AbortSignal) {
    return runPromise(probeVideo(source), { signal })
  }

  downloadVideo(source: string, signal?: AbortSignal) {
    return runPromise(readVideo(source, "DirectVideo"), { signal })
  }

  transcribe(source: string, signal?: AbortSignal): Promise<string> {
    return runPromise(transcribeVideo(this.runtime, source), { signal })
  }

  override stop(): Promise<void> {
    return Promise.resolve()
  }
}

export const plugin: Plugin = {
  name: "@elizaos/plugin-video",
  description: "Video metadata, bounded downloads, caption selection and audio transcription.",
  services: [VideoService],
}
export default plugin
