// spec/core/media.md, "Story: Fetch an attachment through its correct trust boundary"; spec/core/media.md, "Fetching requires a screened endpoint and finishing requires complete bounded bytes"; spec/core/media.md, "Transport host spelling preserves DNS and IP certificate semantics"
import { Foreign, foreign, promised } from "@elizaos/core"
import type { PinnedLookupFetchParams } from "./fetch-guard.vibe"

module node {
  import dns from "node:dns"
  import { type RequestOptions as HttpRequestOptions, type IncomingMessage, request as requestHttp } from "node:http"
  import { request as requestHttps } from "node:https"
  import { isIP, type LookupFunction } from "node:net"
  import { Readable } from "node:stream"
  import { usesSni, type TransportHost } from "../../gen/core__media.effect.vibe"
  import type { PinnedLookupFetchParams } from "./fetch-guard.vibe"
  import type { LookupFn } from "@elizaos/core"

  export interface PreparedRequest {
    readonly method: string
    readonly headers: Headers
    readonly body: Uint8Array | undefined
  }

  export type RequestOutcome = { readonly response: Response } | { readonly error: unknown }

  /** @throws {never} */
  export const nodeLookupFn: LookupFn = (hostname, options) => dns.promises.lookup(hostname, options)

  /** @throws {never} */
  export async function prepareRequest(init: RequestInit): Promise<PreparedRequest> {
    const method = (init.method ?? "GET").toUpperCase()
    const headers = new Headers(init.headers)
    if (init.body === undefined || init.body === null) return { method, headers, body: undefined }
    const serialized = new Response(init.body)
    const contentType = serialized.headers.get("content-type")
    const body = new Uint8Array(await serialized.arrayBuffer())
    if (contentType && !headers.has("content-type")) headers.set("content-type", contentType)
    if (!headers.has("content-length")) headers.set("content-length", String(body.length))
    return { method, headers, body }
  }

  function transportHost(hostname: string): TransportHost {
    const family = isIP(hostname)
    return family === 4 ? "IPv4" : family === 6 ? "IPv6" : "DnsName"
  }

  function requestOptions(
    { url, lookup }: PinnedLookupFetchParams,
    { method, headers }: PreparedRequest,
  ): HttpRequestOptions {
    const hostname = url.hostname.replace(/^\[|\]$/g, "")
    return {
      protocol: url.protocol,
      hostname,
      port: url.port ? Number(url.port) : undefined,
      method,
      path: `${url.pathname}${url.search}`,
      headers: Object.fromEntries(headers),
      lookup: lookup as HttpRequestOptions["lookup"],
      ...(usesSni(transportHost(hostname), url.protocol === "https:") ? { servername: hostname } : undefined),
    }
  }

  function responseFromIncomingMessage(response: IncomingMessage, cleanup: () => void): Response {
    const headers = new Headers()
    for (const [key, value] of Object.entries(response.headers)) {
      if (Array.isArray(value)) {
        for (const item of value) headers.append(key, item)
      } else if (typeof value === "string") {
        headers.set(key, value)
      }
    }
    const status = response.statusCode ?? 500
    const init = { status, statusText: response.statusMessage, headers } satisfies ResponseInit
    if (status === 204 || status === 205 || status === 304) {
      response.once("error", cleanup)
      response.resume()
      cleanup()
      return new Response(null, init)
    }
    response.once("close", cleanup)
    response.once("end", cleanup)
    return new Response(Readable.toWeb(response) as unknown as ReadableStream<Uint8Array>, init)
  }

  function openPinnedRequest(
    params: PinnedLookupFetchParams,
    prepared: PreparedRequest,
    settle: (outcome: RequestOutcome) => void,
  ): () => void {
    let settled = false
    const signal = params.init.signal
    const cleanupSignal = () => signal?.removeEventListener("abort", abort)
    const rejectOnce = (error: unknown) => {
      if (settled) return
      settled = true
      cleanupSignal()
      settle({ error })
    }
    const requestFn = params.url.protocol === "https:" ? requestHttps : requestHttp
    const request = requestFn(requestOptions(params, prepared), (response) => {
      if (settled) return
      const status = response.statusCode
      if (status === undefined || status < 200 || status > 599) {
        response.destroy()
        request.destroy()
        rejectOnce(new Error(`invalid upstream HTTP status ${status}`))
        return
      }
      let built: Response
      try {
        built = responseFromIncomingMessage(response, cleanupSignal)
      } catch (error) {
        response.destroy()
        request.destroy()
        rejectOnce(error instanceof Error ? error : new Error(String(error)))
        return
      }
      settled = true
      settle({ response: built })
    })
    function abort() {
      request.destroy(new DOMException("Aborted", "AbortError"))
    }
    request.on("error", rejectOnce)
    if (signal?.aborted) abort()
    else signal?.addEventListener("abort", abort, { once: true })
    if (prepared.body) request.write(prepared.body)
    request.end()
    return abort
  }

  /** @throws {never} */
  export function sendPinnedRequest(
    params: PinnedLookupFetchParams,
    prepared: PreparedRequest,
    settle: (outcome: RequestOutcome) => void,
  ): () => void {
    try {
      return openPinnedRequest(params, prepared, settle)
    } catch (error) {
      settle({ error })
      return () => undefined
    }
  }

  /** @throws {never} */
  export function createValidatedLookup(
    validate: (address: string, family: number) => void,
    resolve?: LookupFunction,
  ): LookupFunction {
    return (hostname, options, callback) => {
      const lookup = resolve ?? (dns.lookup as LookupFunction)
      lookup(hostname, { ...options, all: true }, (error, result, family) => {
        if (error) {
          callback(error, [])
          return
        }
        const addresses = Array.isArray(result) ? result : [{ address: result, family: family ?? 0 }]
        try {
          if (addresses.length === 0) throw new Error("Destination host did not resolve")
          for (const entry of addresses) {
            if (entry.family !== 4 && entry.family !== 6) throw new Error("Destination address family is invalid")
            validate(entry.address, entry.family)
          }
        } catch (cause) {
          callback(cause as NodeJS.ErrnoException, [])
          return
        }
        if (options.all) callback(null, addresses)
        else callback(null, addresses[0].address, addresses[0].family)
      })
    }
  }
}
import { createValidatedLookup, nodeLookupFn, prepareRequest, sendPinnedRequest } from node
export { createValidatedLookup, nodeLookupFn }

export effect function nodePinnedFetch(params: PinnedLookupFetchParams) {
  const prepared = try foreign(() => prepareRequest(params.init))
  return try callback<Response, Foreign>((resume) => {
    const abort = sendPinnedRequest(params, prepared, (outcome) =>
      resume("response" in outcome ? succeed(outcome.response) : fail(new Foreign({ cause: outcome.error }))))
    return sync(abort)
  })
}

export const nodePinnedFetchPromise = promised(nodePinnedFetch)
