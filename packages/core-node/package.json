{
  "name": "@elizaos/core-node",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Node.js runtime APIs, filesystem, network, media fetch and host adapters for @elizaos/core.",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js",
        "default": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "generate:first-party": "node --import vibelang/register src/catalog/generate.vibe",
    "generate:first-party:check": "node --import vibelang/register src/catalog/generate.vibe --check",
    "build": "pnpm run generate:first-party:check && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vibelang -p tsconfig.build.json",
    "typecheck": "vibelang --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/platform-node-shared": "4.1.1",
    "@elizaos/core": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  }
}
