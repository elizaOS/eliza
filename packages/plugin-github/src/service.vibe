// spec/github/index.md, "Story: List pull requests and triage notifications under the selected account"; spec/github/index.md, "Story: Review the exact GitHub operation before it changes a repository"
import { logger, Service, type IAgentRuntime } from "@elizaos/core"
import {
  defaultGitHubAccountIdForRole,
  readGitHubAccountsWithConnectorCredentials,
  resolveGitHubAccount,
  type GitHubAccountConfig,
  type GitHubAccountSelection,
} from "./accounts.vibe"
import {
  GITHUB_SERVICE_TYPE,
  createGitHubRestClient,
  type GitHubIdentity,
  type GitHubOctokitClient,
  type IGitHubService,
} from "./types.vibe"

interface GitHubClientRecord {
  readonly account: GitHubAccountConfig
  readonly client: GitHubOctokitClient
}

function normalizeSelector(
  selector:
    | GitHubIdentity
    | { readonly as?: GitHubIdentity; readonly role?: GitHubIdentity; readonly accountId?: string },
): GitHubAccountSelection {
  if (selector === "user" || selector === "agent") return { role: selector }
  return {
    accountId: typeof selector.accountId === "string" && selector.accountId.trim() ? selector.accountId.trim() : undefined,
    role: selector.role ?? selector.as ?? "agent",
  }
}

export class GitHubService extends Service implements IGitHubService {
  static override readonly serviceType = GITHUB_SERVICE_TYPE
  override readonly capabilityDescription = "GitHub REST API integration for PRs, issues, and notifications"

  private clients = new Map<string, GitHubClientRecord>()
  private readonly testClients = new Map<string, GitHubClientRecord>()
  private accountGeneration = 0
  private pendingReload: Promise<void> | null = null
  private readonly createClient: (auth: string) => GitHubOctokitClient

  constructor(
    runtime?: IAgentRuntime,
    createClient: (auth: string) => GitHubOctokitClient = (auth) => createGitHubRestClient(auth),
  ) {
    super(runtime)
    this.createClient = createClient
  }

  static override async start(
    runtime: IAgentRuntime,
    createClient?: (auth: string) => GitHubOctokitClient,
  ): Promise<GitHubService> {
    const service = new GitHubService(runtime, createClient)
    await service.initialize()
    return service
  }

  async reloadAccounts(): Promise<void> {
    const reload = this.initialize()
    this.pendingReload = reload
    try {
      await reload
    } finally {
      if (this.pendingReload === reload) this.pendingReload = null
    }
  }

  async refreshAccounts(): Promise<void> {
    await this.reloadAccounts()
    while (this.pendingReload) await this.pendingReload
  }

  private async initialize(): Promise<void> {
    const generation = ++this.accountGeneration
    this.clients = new Map(this.testClients)
    if (!this.runtime) return
    const accounts = await readGitHubAccountsWithConnectorCredentials(this.runtime)
    if (generation !== this.accountGeneration) return
    for (const account of accounts) {
      if (this.testClients.has(account.accountId)) continue
      this.clients.set(account.accountId, { account, client: this.createClient(account.token) })
    }
    for (const role of ["user", "agent"] as const) {
      if (!resolveGitHubAccount(accounts, { role })) {
        logger.info(`[GitHubService] no GitHub ${role} account configured — ${role}-acting calls will be rejected`)
      }
    }
    logger.info(`[GitHubService] configured ${this.clients.size} GitHub account(s)`)
  }

  getOctokit(
    selector:
      | GitHubIdentity
      | { readonly as?: GitHubIdentity; readonly role?: GitHubIdentity; readonly accountId?: string },
  ): GitHubOctokitClient | null {
    const selection = normalizeSelector(selector)
    const account = resolveGitHubAccount(
      Array.from(this.clients.values()).map((record) => record.account),
      selection,
    )
    if (!account) return null
    return this.clients.get(account.accountId)?.client ?? null
  }

  setClientForTesting(
    as: GitHubIdentity,
    client: GitHubOctokitClient | null,
    accountId: string = defaultGitHubAccountIdForRole(as),
  ): void {
    if (!client) {
      this.testClients.delete(accountId)
      this.clients.delete(accountId)
      return
    }
    const record: GitHubClientRecord = { account: { accountId, role: as, token: "test" }, client }
    this.testClients.set(accountId, record)
    this.clients.set(accountId, record)
  }

  override async stop(): Promise<void> {
    ++this.accountGeneration
    this.testClients.clear()
    this.clients.clear()
  }
}
