// spec/form/index.md, "The participant can shelve and resume an unexpired form, cancel it, or let it expire"
import { FORM_DEFINITION_DEFAULTS, type FormDefinition, type FormSession } from "./types.vibe"

export function calculateTTL(session: FormSession, form?: FormDefinition, now = Date.now()): number {
  const config = form?.ttl || {}
  const minDays = config.minDays ?? FORM_DEFINITION_DEFAULTS.ttl.minDays
  const maxDays = config.maxDays ?? FORM_DEFINITION_DEFAULTS.ttl.maxDays
  const multiplier = config.effortMultiplier ?? FORM_DEFINITION_DEFAULTS.ttl.effortMultiplier
  const minutesSpent = session.effort.timeSpentMs / 60000
  const effortDays = minutesSpent * multiplier
  const ttlDays = Math.min(maxDays, Math.max(minDays, effortDays))
  return now + ttlDays * 24 * 60 * 60 * 1000
}

export function shouldNudge(session: FormSession, form?: FormDefinition, now = Date.now()): boolean {
  const nudgeConfig = form?.nudge
  if (nudgeConfig?.enabled === false) return false
  const maxNudges = nudgeConfig?.maxNudges ?? FORM_DEFINITION_DEFAULTS.nudge.maxNudges
  if ((session.nudgeCount || 0) >= maxNudges) return false
  const afterInactiveHours = nudgeConfig?.afterInactiveHours ?? FORM_DEFINITION_DEFAULTS.nudge.afterInactiveHours
  const inactiveMs = afterInactiveHours * 60 * 60 * 1000
  if (now - session.effort.lastInteractionAt < inactiveMs) return false
  if (session.lastNudgeAt && now - session.lastNudgeAt < 24 * 60 * 60 * 1000) return false
  return true
}

export function isExpiringSoon(session: FormSession, withinMs: number, now = Date.now()): boolean {
  return session.expiresAt - now < withinMs
}

export function isExpired(session: FormSession, now = Date.now()): boolean {
  return session.expiresAt < now
}

export function shouldConfirmCancel(session: FormSession): boolean {
  return session.effort.timeSpentMs > 5 * 60 * 1000
}

export function formatTimeRemaining(session: FormSession, now = Date.now()): string {
  const remaining = session.expiresAt - now
  if (remaining <= 0) return "expired"
  const hours = Math.floor(remaining / (60 * 60 * 1000))
  const days = Math.floor(hours / 24)
  if (days > 0) return `${days} day${days > 1 ? "s" : ""}`
  if (hours > 0) return `${hours} hour${hours > 1 ? "s" : ""}`
  const minutes = Math.floor(remaining / (60 * 1000))
  return `${minutes} minute${minutes > 1 ? "s" : ""}`
}

export function formatEffort(session: FormSession): string {
  const minutes = Math.floor(session.effort.timeSpentMs / 60000)
  if (minutes < 1) return "just started"
  if (minutes < 60) return `${minutes} minute${minutes > 1 ? "s" : ""}`
  const hours = Math.floor(minutes / 60)
  const remainingMinutes = minutes % 60
  if (remainingMinutes === 0) return `${hours} hour${hours > 1 ? "s" : ""}`
  return `${hours}h ${remainingMinutes}m`
}
