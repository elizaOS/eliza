// spec/form/index.md, "Each captured answer belongs to one field in the participant's current form"
import { ModelType, parseJSONObjectFromText, type IAgentRuntime, type JSONSchema } from "@elizaos/core"
import { resolveControlTemplates, type TemplateValues } from "./template.vibe"
import type { ControlType, ExtractionResult, FormControl, FormDefinition, FormIntent, IntentResult, JsonValue } from "./types.vibe"
import { getTypeHandler, parseValue, validateField } from "./validation.vibe"

const FORM_INTENTS: FormIntent[] = [
  "fill_form",
  "submit",
  "stash",
  "restore",
  "cancel",
  "undo",
  "skip",
  "explain",
  "example",
  "progress",
  "autofill",
  "other",
]

const UNSAFE_OBJECT_KEYS = new Set(["__proto__", "prototype", "constructor"])

const INTENT_MEANINGS: Record<FormIntent, string> = {
  fill_form: "user is providing field values",
  submit: "user wants to submit or finish the form",
  stash: "user wants to save or pause the form for later",
  restore: "user wants to resume a saved form",
  cancel: "user wants to cancel or abandon the form",
  undo: "user wants to undo the last change",
  skip: "user wants to skip the current field",
  explain: "user wants an explanation",
  example: "user wants an example value",
  progress: "user wants a progress update",
  autofill: "user wants to use saved values",
  other: "none of the above",
}

type ControlTypeResolverService = { getControlType?: (typeId: string) => ControlType | undefined }

function resolveRuntimeControlType(runtime: IAgentRuntime, typeId: string): ControlType | undefined {
  const service = runtime.getService("FORM") as ControlTypeResolverService | null
  return typeof service?.getControlType === "function" ? service.getControlType(typeId) : undefined
}

function parseBoolFlag(value: unknown): boolean {
  return String(value ?? "").trim().toLowerCase() === "true"
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

function extractionDedupeKey(field: string, value: unknown): string {
  return `${field}\0${JSON.stringify(value ?? null)}`
}

function isValidIntent(value: string): value is FormIntent {
  return (FORM_INTENTS as string[]).includes(value)
}

function isSafeExtractionField(field: string): boolean {
  return field.split(".").every((part) => part.length > 0 && !UNSAFE_OBJECT_KEYS.has(part))
}

export function buildFormExtractorSchema(): JSONSchema {
  return {
    type: "object",
    properties: {
      formIntent: { type: "string", enum: [...FORM_INTENTS] },
      formExtractions: {
        type: "array",
        items: {
          type: "object",
          properties: {
            field: { type: "string" },
            value: {},
            confidence: { type: "number" },
            isCorrection: { type: "boolean" },
            reasoning: { type: "string" },
          },
          required: ["field", "confidence"],
          additionalProperties: false,
        },
      },
    },
    required: ["formIntent", "formExtractions"],
    additionalProperties: false,
  }
}

export function buildFormExtractorPromptSection(params: {
  text: string
  form: FormDefinition
  controls: FormControl[]
  templateValues?: TemplateValues
  resolveControlType?: (typeId: string) => ControlType | undefined
}): string {
  const { text, form, controls, templateValues, resolveControlType } = params
  const resolvedControls = templateValues
    ? controls.map((control) => resolveControlTemplates(control, templateValues))
    : controls
  const fieldsDescription = resolvedControls
    .filter((control) => !control.hidden)
    .map((control) => {
      const handler = getTypeHandler(control.type, resolveControlType?.(control.type))
      const typeHint = handler?.extractionPrompt || control.type
      return {
        key: control.key,
        label: control.label,
        type: typeHint,
        description: control.description || typeHint,
        hints: control.extractHints ?? [],
        options: control.options?.map((option) => option.value) ?? [],
      }
    })
  return `Extract active form intent + field values.

Context JSON:
${JSON.stringify(
  {
    form: { name: form.name, description: form.description },
    fields: fieldsDescription,
    user_message: text,
    intent_options: FORM_INTENTS,
    intent_meanings: INTENT_MEANINGS,
  },
  null,
  2,
)}

Return:
{
  "formIntent": "one of intent_options",
  "formExtractions": [
    { "field": "<key>", "value": <extracted>, "confidence": 0.0-1.0, "isCorrection": false, "reasoning": "brief" }
  ]
}

Rules:
- Choose exactly one intent.
- fill_form: extract every mentioned field value.
- No fields -> formExtractions=[].
- confidence 0.0-1.0.`
}

export function parseFormExtractorOutput(raw: unknown): IntentResult | null {
  if (!isRecord(raw)) return null
  const intentStr = typeof raw.formIntent === "string" ? raw.formIntent.toLowerCase() : "other"
  const intent: FormIntent = isValidIntent(intentStr) ? intentStr : "other"
  const rawExtractions = Array.isArray(raw.formExtractions) ? raw.formExtractions : []
  const extractions: ExtractionResult[] = []
  const seen = new Set<string>()
  for (const entry of rawExtractions) {
    if (!isRecord(entry)) continue
    const fieldKey = typeof entry.field === "string" ? entry.field : ""
    if (!fieldKey || !isSafeExtractionField(fieldKey)) continue
    const dedupeKey = extractionDedupeKey(fieldKey, entry.value)
    if (seen.has(dedupeKey)) continue
    seen.add(dedupeKey)
    const value: JsonValue = (entry.value as JsonValue | undefined) ?? null
    let confidence = typeof entry.confidence === "number" ? entry.confidence : parseFloat(String(entry.confidence ?? ""))
    if (!Number.isFinite(confidence)) confidence = 0.5
    confidence = Math.max(0, Math.min(1, confidence))
    extractions.push({
      field: fieldKey,
      value,
      confidence,
      reasoning: typeof entry.reasoning === "string" ? entry.reasoning : undefined,
      isCorrection: parseBoolFlag(entry.isCorrection),
    })
  }
  return { intent, extractions }
}

export function coerceExtractionsAgainstControls(
  extractions: ExtractionResult[],
  controls: FormControl[],
  templateValues?: TemplateValues,
  resolveControlType?: (typeId: string) => ControlType | undefined,
): ExtractionResult[] {
  const resolvedControls = templateValues
    ? controls.map((control) => resolveControlTemplates(control, templateValues))
    : controls
  const controlsByKey = new Map(resolvedControls.map((control) => [control.key, control]))
  return extractions.flatMap((extraction) => {
    if (extraction.field.includes(".")) {
      const [parentKey, subKey, ...extraParts] = extraction.field.split(".")
      if (extraParts.length > 0 || !parentKey || !subKey || !controlsByKey.has(parentKey)) return []
      return [extraction]
    }
    const control = controlsByKey.get(extraction.field)
    if (!control) return []
    const controlType = resolveControlType?.(control.type)
    const value = typeof extraction.value === "string" ? parseValue(extraction.value, control, controlType) : extraction.value
    const validation = validateField(value, control, controlType)
    if (!validation.valid) {
      const reasoning = `${extraction.reasoning ?? ""} (Validation failed: ${validation.error})`.trim()
      return [{ ...extraction, value, confidence: Math.min(extraction.confidence, 0.3), reasoning }]
    }
    return [{ ...extraction, value }]
  })
}

export async function extractSingleField(
  runtime: IAgentRuntime,
  text: string,
  control: FormControl,
  debug?: boolean,
  templateValues?: TemplateValues,
): Promise<ExtractionResult | null> {
  const resolvedControl = templateValues ? resolveControlTemplates(control, templateValues) : control
  const controlType = resolveRuntimeControlType(runtime, resolvedControl.type)
  const handler = getTypeHandler(resolvedControl.type, controlType)
  const typeHint = handler?.extractionPrompt || resolvedControl.type
  const prompt = `Extract a single form field value from the user message.

Context JSON:
${JSON.stringify(
  {
    field: {
      key: resolvedControl.key,
      label: resolvedControl.label,
      type: typeHint,
      description: resolvedControl.description,
      hints: resolvedControl.extractHints ?? [],
      options: resolvedControl.options?.map((option) => option.value) ?? [],
      example: resolvedControl.example,
    },
    user_message: text,
  },
  null,
  2,
)}

Return only a valid JSON object with this schema:
{
  "found": true,
  "value": "extracted value or null if not found",
  "confidence": 0.95,
  "reasoning": "brief explanation"
}`
  const response = await runtime.useModel(ModelType.TEXT_SMALL, { prompt, temperature: 0.1 })
  const parsed = parseJSONObjectFromText(response)
  if (!parsed || !(parsed.found === true || parsed.found === "true")) return null
  const rawValue = (parsed.value as JsonValue | undefined) ?? null
  const value = typeof rawValue === "string" ? parseValue(rawValue, resolvedControl, controlType) : rawValue
  const confidence = typeof parsed.confidence === "number" ? parsed.confidence : parseFloat(String(parsed.confidence ?? ""))
  const result: ExtractionResult = {
    field: resolvedControl.key,
    value,
    confidence: Number.isFinite(confidence) ? confidence : 0.5,
    reasoning: parsed.reasoning ? String(parsed.reasoning) : undefined,
  }
  if (debug) runtime.logger.debug("[FormExtraction] Single field extraction:", JSON.stringify(result))
  return result
}

export async function detectCorrection(
  runtime: IAgentRuntime,
  text: string,
  currentValues: Record<string, JsonValue>,
  controls: FormControl[],
  templateValues?: TemplateValues,
): Promise<ExtractionResult[]> {
  const resolvedControls = templateValues
    ? controls.map((control) => resolveControlTemplates(control, templateValues))
    : controls
  const currentValueEntries = resolvedControls.filter((control) => currentValues[control.key] !== undefined)
  if (currentValueEntries.length === 0) return []
  const prompt = `Detect whether the user is correcting a previous form value.

Context JSON:
${JSON.stringify(
  {
    current_values: currentValueEntries.map((control) => ({
      key: control.key,
      label: control.label,
      value: currentValues[control.key],
    })),
    user_message: text,
  },
  null,
  2,
)}

Return only a valid JSON object with this schema:
{
  "has_correction": true,
  "corrections": [
    { "field": "email", "old_value": "old@example.com", "new_value": "new@example.com", "confidence": 0.9 }
  ]
}

Rules:
- Decide whether the user is correcting a previous value.
- When correcting, extract the replacement value.
- Use an empty corrections array when no corrections were found.`
  const response = await runtime.useModel(ModelType.TEXT_SMALL, { prompt, temperature: 0.1 })
  const parsed = parseJSONObjectFromText(response)
  if (!parsed || !(parsed.has_correction === true || parsed.has_correction === "true") || !Array.isArray(parsed.corrections)) {
    return []
  }
  const corrections: ExtractionResult[] = []
  const seen = new Set<string>()
  for (const item of parsed.corrections) {
    if (!isRecord(item)) continue
    const fieldName = item.field ? String(item.field) : ""
    const control = resolvedControls.find(
      (candidate) =>
        candidate.label.toLowerCase() === fieldName.toLowerCase() ||
        candidate.key.toLowerCase() === fieldName.toLowerCase(),
    )
    if (!control) continue
    const dedupeKey = extractionDedupeKey(control.key, item.new_value)
    if (seen.has(dedupeKey)) continue
    seen.add(dedupeKey)
    const rawNew = (item.new_value as JsonValue | undefined) ?? null
    const value =
      typeof rawNew === "string"
        ? parseValue(rawNew, control, resolveRuntimeControlType(runtime, control.type))
        : rawNew
    const confidence = typeof item.confidence === "number" ? item.confidence : parseFloat(String(item.confidence ?? ""))
    corrections.push({
      field: control.key,
      value,
      confidence: Number.isFinite(confidence) ? confidence : 0.8,
      isCorrection: true,
    })
  }
  return corrections
}
