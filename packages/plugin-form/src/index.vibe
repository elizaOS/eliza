export const formPlugin: Plugin & { descriptionCompressed?: string } = {
  name: "form",
  description: "Agent-native conversational forms for data collection",
  descriptionCompressed: "Conversational forms for structured data collection.",
  autoEnable: {
    shouldEnable: (_env, config) => {
      const formFeature = (config?.features as Record<string, unknown> | undefined)?.form
      return (
        formFeature === true ||
        (typeof formFeature === "object" &&
          formFeature !== null &&
          (formFeature as { enabled?: unknown }).enabled !== false)
      )
    },
  },
  services: [FormService as unknown as ServiceClass],
  providers: [formContextProvider],
  actions: [formAction],
  evaluators: [formEvaluator as unknown as RegisteredEvaluator],
  async dispose(runtime: IAgentRuntime) {
    const service = runtime.getService<FormService>(FormService.serviceType)
    await service?.stop()
  },
}

export default formPlugin
