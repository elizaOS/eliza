{
  "name": "@elizaos/registry",
  "version": "2.0.0-beta.0",
  "description": "In-repo source of truth for the elizaOS community plugin registry: third-party entry data, JSON schema, validation, generator, and a typed loader.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/elizaOS/eliza/tree/main/packages/registry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elizaOS/eliza.git",
    "directory": "packages/registry"
  },
  "keywords": [
    "elizaos",
    "registry",
    "plugins"
  ],
  "files": [
    "dist",
    "entries/third-party"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime-kernel": {
      "types": "./dist/runtime-kernel.d.ts",
      "import": "./dist/runtime-kernel.js",
      "default": "./dist/runtime-kernel.js"
    },
    "./first-party": {
      "types": "./dist/first-party/index.d.ts",
      "import": "./dist/first-party/index.js",
      "default": "./dist/first-party/index.js"
    },
    "./first-party/generated.json": "./dist/first-party/generated.json",
    "./first-party/curated-app-definitions.json": "./dist/first-party/curated-app-definitions.json",
    "./first-party/channel-plugin-map.json": "./dist/first-party/channel-plugin-map.json",
    "./first-party/provider-plugin-map.json": "./dist/first-party/provider-plugin-map.json",
    "./first-party/short-id-plugin-map.json": "./dist/first-party/short-id-plugin-map.json"
  },
  "scripts": {
    "validate": "bun run src/validate-cli.ts",
    "generate": "bun run src/generate-cli.ts",
    "generate:first-party": "bun run src/first-party/generate.ts",
    "generate:first-party:check": "bun run src/first-party/generate.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../scripts/run-vitest.mjs run --config ./vitest.config.ts",
    "lint": "bunx @biomejs/biome check --write --unsafe src",
    "lint:check": "bunx @biomejs/biome check src",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe src",
    "format": "bunx @biomejs/biome format --write src",
    "format:check": "bunx @biomejs/biome format src",
    "format:fix": "bunx @biomejs/biome format --write src",
    "build": "node ../scripts/rm-path-recursive.mjs dist && tsc6 --noCheck -p tsconfig.build.json && node ../scripts/rewrite-dist-relative-imports-node-esm.mjs packages/registry && node ../scripts/copy-package-assets.mjs packages/registry src/first-party/channel-plugin-map.json src/first-party/curated-app-definitions.json src/first-party/generated.json src/first-party/provider-plugin-map.json src/first-party/short-id-plugin-map.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.0.0"
  },
  "elizaos": {
    "scripts": {
      "testLanes": [
        "server"
      ],
      "buildOnInstall": {
        "sentinel": "dist/index.js",
        "order": 1
      }
    }
  }
}
