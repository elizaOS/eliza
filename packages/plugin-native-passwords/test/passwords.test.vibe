// spec/nativePasswords/index.md, "Story: Manage saved passwords without revealing them to the application renderer"; spec/nativePasswords/index.md, "The renderer can observe only public vault status and owner-authorized metadata"
import { assert, it } from "@effect/vitest"
import {
  ElizaPasswordsWeb,
  createPasswordsClient,
  createTransferClient,
  type ElizaPasswordTransferPlugin,
  type ElizaPasswordsPlugin,
} from "../src/index.vibe"

it.effect(`Fail closed on web password fallback and validate native password vault and transfer clients (spec/nativePasswords/index.md, "Story: Manage saved passwords without revealing them to the application renderer"; spec/nativePasswords/index.md, "The renderer can observe only public vault status and owner-authorized metadata")`, effect () => {
  const web = new ElizaPasswordsWeb()
  const webStatus = try tryPromise(() => web.status())
  const webLock = try tryPromise(() => web.lock())
  const webSaved = try tryPromise(() => web.anySaved())
  const webUnlock = try Effect.result(Effect.tryPromise(() => web.unlock()))
  const webList = try Effect.result(Effect.tryPromise(() => web.list()))

  const nativeVault: ElizaPasswordsPlugin = {
    status: async () => ({
      available: true,
      locked: false,
      unlockRemainingMs: 60_000,
      unlockSeconds: 60,
      biometric: true,
      autofill: { supported: true, selected: "this-app" },
    }),
    unlock: async () => ({ unlocked: true, unlockRemainingMs: 60_000 }),
    lock: async () => ({ locked: true }),
    list: async () => ({
      entries: [{
        id: "entry-1",
        label: "Example",
        username: "alice",
        bindings: [{ kind: "web", facet: "https://example.com", display: "example.com" }],
        updatedAt: 1_700_000_000_000,
        revision: 1,
      }],
    }),
    anySaved: async () => ({ saved: true }),
    save: async () => ({ id: "entry-1" }),
    openEditor: async () => ({ status: "saved", id: "entry-1", revision: 2 }),
    remove: async () => ({ removed: true }),
    reset: async () => ({ reset: true }),
    reveal: async () => ({ shown: true, hidesAfterMs: 15_000 }),
    copy: async () => ({ copied: true, clearsAfterMs: 30_000 }),
    openAutofillSettings: async () => ({ status: "opened", destination: "autofill-picker" }),
  }
  const client = createPasswordsClient(nativeVault)
  const nativeStatus = try tryPromise(() => client.status())
  const listed = try tryPromise(() => client.list())

  const transferPlugin: ElizaPasswordTransferPlugin = {
    exportVault: async () => ({ exported: 2 }),
    importVault: async () => ({ imported: 2, skipped: 1 }),
  }
  const transfer = createTransferClient(transferPlugin)
  const exported = try tryPromise(() => transfer.exportVault())
  const imported = try tryPromise(() => transfer.importVault())

  try Effect.try(() => {
    assert.deepStrictEqual(webStatus, {
      available: false,
      reason: "unsupported",
      locked: true,
      unlockRemainingMs: 0,
      unlockSeconds: 0,
      biometric: false,
      autofill: { supported: null, selected: "unknown" },
    })
    assert.deepStrictEqual(webLock, { locked: true })
    assert.deepStrictEqual(webSaved, { saved: false })
    assert.strictEqual(webUnlock._tag, "Failure")
    assert.strictEqual(webList._tag, "Failure")
    assert.isTrue(nativeStatus.available)
    assert.strictEqual(listed.length, 1)
    assert.strictEqual(listed[0]?.username, "alice")
    assert.deepStrictEqual(exported, { exported: 2 })
    assert.deepStrictEqual(imported, { imported: 2, skipped: 1 })
  })
})
