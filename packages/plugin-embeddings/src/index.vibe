// spec/embeddings/index.md, "Story: Embed every input in the configured vector space"
import { logger, ModelType, type IAgentRuntime, type Plugin } from "@elizaos/core"
import {
  DEFAULT_EMBEDDING_MODEL,
  getEmbeddingBaseURL,
  getEmbeddingDimensions,
  hasEmbeddingConfig,
  logResolvedConfig,
  readInitialPluginConfig,
  shouldEnable,
  validateEmbeddingDimension,
} from "./config.vibe"
import { handleBatchTextEmbedding, handleTextEmbedding } from "./embedding.vibe"

export const embeddingsPlugin: Plugin = {
  name: "@elizaos/plugin-embeddings",
  description:
    "Configured OpenAI-compatible embedding endpoint with ordered, exact-width batches and bounded failover.",
  autoEnable: {
    envKeys: ["EMBEDDING_BASE_URL", "EMBEDDING_API_KEY"],
    shouldEnable: (env) => shouldEnable({ env, config: {}, isNativePlatform: false }),
  },
  priority: 1,
  config: readInitialPluginConfig(),
  async init(_config, runtime: IAgentRuntime) {
    if (!hasEmbeddingConfig(runtime)) {
      logger.warn(
        "[Embeddings] Neither EMBEDDING_BASE_URL nor EMBEDDING_API_KEY is set — embedding calls will throw until one is configured.",
      )
      return
    }
    validateEmbeddingDimension(getEmbeddingDimensions(runtime))
    if (!getEmbeddingBaseURL(runtime)) {
      logger.warn(
        "[Embeddings] EMBEDDING_API_KEY is set but EMBEDDING_BASE_URL is not — set the endpoint URL for embedding calls to succeed.",
      )
    }
    logResolvedConfig(runtime)
    if (getEmbeddingBaseURL(runtime)) {
      void handleTextEmbedding(runtime, "warmup")
        .then(() => logger.debug("[Embeddings] Endpoint warm"))
        .catch(() => undefined)
    }
  },
  modelMetadata: {
    [ModelType.TEXT_EMBEDDING]: {
      displayModelSetting: "EMBEDDING_MODEL",
      displayModelDefault: DEFAULT_EMBEDDING_MODEL,
    },
  },
  models: {
    [ModelType.TEXT_EMBEDDING]: handleTextEmbedding,
    [ModelType.TEXT_EMBEDDING_BATCH]: (runtime, params) =>
      handleBatchTextEmbedding(runtime, params.texts),
  },
}

export const plugin = embeddingsPlugin
export default embeddingsPlugin

export {
  DEFAULT_EMBEDDING_DIMENSIONS,
  DEFAULT_EMBEDDING_MODEL,
  getAuthHeader,
  getBooleanSetting,
  getEmbeddingApiKey,
  getEmbeddingBaseURL,
  getEmbeddingDimensions,
  getEmbeddingFallbackApiKey,
  getEmbeddingFallbackBaseURL,
  getEmbeddingFallbackModel,
  getEmbeddingModel,
  getEndpointAuthHeader,
  getNumericSetting,
  getSetting,
  hasEmbeddingConfig,
  hasExplicitDimensions,
  logResolvedConfig,
  shouldEnable,
  validateEmbeddingDimension,
  type VectorDimension,
} from "./config.vibe"
export { handleBatchTextEmbedding, handleTextEmbedding } from "./embedding.vibe"
export { EmbeddingProviderFailed } from "./errors.vibe"
export { emitModelUsageEvent, type EmbeddingUsage } from "./events.vibe"
export type { EmbeddingResponse, TokenUsage } from "./types.vibe"
