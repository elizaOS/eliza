// spec/embeddings/index.md, "Story: Embed every input in the configured vector space"
import { assert, describe, it } from "@effect/vitest"
import {
  AgentRuntime,
  ConfidentialInferenceAuthority,
  EventType,
  isModelProviderError,
  isTransientModelError,
  modelProviderErrorDetail,
  ModelType,
  runWithConfidentialInference,
  type ConfidentialInferenceAuditRecord,
  type IAgentRuntime,
  type IDatabaseAdapter,
  type Plugin,
} from "@elizaos/core"
import {
  embeddingsPlugin,
  getAuthHeader,
  getBooleanSetting,
  getEmbeddingDimensions,
  getEmbeddingFallbackModel,
  getEmbeddingModel,
  getNumericSetting,
  handleBatchTextEmbedding,
  handleTextEmbedding,
  plugin,
  shouldEnable,
  validateEmbeddingDimension,
} from "../src/index.vibe"

module node {
  import { once } from "node:events"
  import { createServer, type IncomingMessage, type ServerResponse } from "node:http"

  export interface CapturedRequest {
    readonly path: string
    readonly authorization: string | undefined
    readonly body: string
  }

  export interface EmbeddingTestServer {
    readonly baseUrl: string
    readonly requests: CapturedRequest[]
    close(): Promise<void>
  }

  /** @throws {never} */
  export function parseJson<T>(raw: string): T {
    return JSON.parse(raw) as T
  }

  /** @throws {never} */
  export function httpFetch(url: string, init: RequestInit): Promise<Response> {
    return globalThis.fetch(url, init)
  }

  /** @throws {never} */
  export async function startEmbeddingServer(
    onRequest: (captured: CapturedRequest, req: IncomingMessage, res: ServerResponse) => void,
  ): Promise<EmbeddingTestServer> {
    const requests: CapturedRequest[] = []
    const server = createServer((req, res) => {
      const chunks: Buffer[] = []
      req.on("data", (chunk: Buffer) => { chunks.push(chunk) })
      req.on("end", () => {
        const captured: CapturedRequest = {
          path: req.url ?? "",
          authorization: req.headers.authorization,
          body: Buffer.concat(chunks).toString("utf8"),
        }
        requests.push(captured)
        onRequest(captured, req, res)
      })
    })
    server.listen(0, "127.0.0.1")
    await once(server, "listening")
    const addr = server.address()
    const port = typeof addr === "object" && addr !== null ? addr.port : 0
    return {
      baseUrl: `http://127.0.0.1:${port}`,
      requests,
      close: async () => {
        server.closeAllConnections()
        await new Promise<void>((resolve) => { server.close(() => resolve()) })
      },
    }
  }
}
import { httpFetch, parseJson, startEmbeddingServer } from node

const LONE_SURROGATE_ESCAPE = /\\u[dD][89a-fA-F][0-9a-fA-F]{2}/

interface RecordedRuntime {
  readonly runtime: IAgentRuntime
  readonly events: Array<{ readonly event: string; readonly payload: unknown }>
  readonly reportedErrors: Array<{ readonly scope: string; readonly error: unknown; readonly context: unknown }>
}

function makeRuntime(
  settings: Record<string, string | number | boolean | null>,
  options?: {
    readonly emitEvent?: (event: string, payload: unknown) => Promise<void> | void
  },
): RecordedRuntime {
  const events: Array<{ readonly event: string; readonly payload: unknown }> = []
  const reportedErrors: Array<{ readonly scope: string; readonly error: unknown; readonly context: unknown }> = []
  const runtime = {
    agentId: "00000000-0000-0000-0000-000000000001",
    getSetting: (key: string) => (Object.hasOwn(settings, key) ? settings[key] : null),
    emitEvent: async (event: string, payload: unknown) => {
      events.push({ event, payload })
      if (options?.emitEvent) {
        await options.emitEvent(event, payload)
      }
    },
    reportError: (scope: string, error: unknown, context?: unknown) => {
      reportedErrors.push({ scope, error, context })
    },
  } as unknown as IAgentRuntime
  return { runtime, events, reportedErrors }
}

function vectorOf(width: number, lead: number): number[] {
  return Array.from({ length: width }, (_item, index) => (index === 0 ? lead : 0))
}

async function expectRejects(fn: () => Promise<unknown>): Promise<unknown> {
  try {
    await fn()
  } catch (error: unknown) {
    return error
  }
  assert.fail("Expected promise to reject")
}

async function flushMicrotasks(): Promise<void> {
  await Promise.resolve()
  await Promise.resolve()
  await Promise.resolve()
}

describe('Plugin metadata, auto-enable, strict config, and dimension probe (spec/embeddings/index.md, "An endpoint attempt uses the configured representation and count")', () => {
  it('activates only on primary URL or API key, enforces strict integer dimensions, and rejects null probe without EMBEDDING_BASE_URL (spec/embeddings/index.md, "An endpoint attempt uses the configured representation and count")', async () => {
    assert.strictEqual(plugin, embeddingsPlugin)
    assert.strictEqual(plugin.name, "@elizaos/plugin-embeddings")
    assert.strictEqual(plugin.priority, 1)
    assert.deepStrictEqual(plugin.autoEnable?.envKeys, ["EMBEDDING_BASE_URL", "EMBEDDING_API_KEY"])
    assert.deepStrictEqual(plugin.modelMetadata?.[ModelType.TEXT_EMBEDDING], {
      displayModelSetting: "EMBEDDING_MODEL",
      displayModelDefault: "text-embedding-3-small",
    })
    assert.strictEqual(shouldEnable({ env: { EMBEDDING_BASE_URL: "https://embed.test" }, config: {}, isNativePlatform: false }), true)
    assert.strictEqual(shouldEnable({ env: { EMBEDDING_API_KEY: "test-key" }, config: {}, isNativePlatform: false }), true)
    assert.strictEqual(shouldEnable({ env: { EMBEDDING_FALLBACK_BASE_URL: "https://fallback.test" }, config: {}, isNativePlatform: false }), false)
    assert.strictEqual(shouldEnable({ env: { EMBEDDING_BASE_URL: "   ", EMBEDDING_API_KEY: "" }, config: {}, isNativePlatform: false }), false)
    assert.strictEqual(plugin.autoEnable?.shouldEnable?.({ EMBEDDING_API_KEY: "k" }, {}), true)
    assert.strictEqual(plugin.autoEnable?.shouldEnable?.({ EMBEDDING_FALLBACK_BASE_URL: "https://fallback.test" }, {}), false)

    const { runtime: keyOnly } = makeRuntime({ EMBEDDING_API_KEY: "test-key", EMBEDDING_BASE_URL: "" })
    const probeError = await expectRejects(() => handleTextEmbedding(keyOnly, null))
    assert.ok(probeError instanceof Error && probeError.message.includes("No embedding endpoint configured. Set EMBEDDING_BASE_URL."))
    assert.deepStrictEqual(getAuthHeader(keyOnly), { Authorization: "Bearer test-key" })
    assert.strictEqual(getEmbeddingModel(keyOnly), "text-embedding-3-small")
    assert.strictEqual(getEmbeddingFallbackModel(keyOnly), "text-embedding-3-small")

    const { runtime: configured } = makeRuntime({
      EMBEDDING_BASE_URL: "https://embedding.test",
      EMBEDDING_API_KEY: "",
      EMBEDDING_DIMENSIONS: "384",
      EMBEDDING_MODEL: "custom-model",
      EMBEDDING_FALLBACK_MODEL: "",
      FEATURE_FLAG: "yes",
    })
    const probe = await handleTextEmbedding(configured, null)
    assert.strictEqual(probe.length, 384)
    assert.strictEqual(probe[0], 0.1)
    assert.strictEqual(probe[1], 0)
    assert.deepStrictEqual(getAuthHeader(configured), {})
    assert.strictEqual(getEmbeddingFallbackModel(configured), "custom-model")
    assert.strictEqual(getBooleanSetting(configured, "FEATURE_FLAG", false), true)
    assert.strictEqual(getBooleanSetting(configured, "MISSING_FLAG", true), true)
    assert.strictEqual(validateEmbeddingDimension(384), 384)

    for (const bad of ["1536abc", "384.0", "1e3", "+384", "-384", "0", "0x180"]) {
      const { runtime: badDimRuntime } = makeRuntime({
        EMBEDDING_BASE_URL: "https://embedding.test",
        EMBEDDING_DIMENSIONS: bad,
      })
      await expectRejects(async () => getNumericSetting(badDimRuntime, "EMBEDDING_DIMENSIONS", 1536))
      await expectRejects(async () => getEmbeddingDimensions(badDimRuntime))
      const err = await expectRejects(() => handleTextEmbedding(badDimRuntime, null))
      assert.ok(err instanceof Error && err.message.includes("must be a valid integer"))
    }

    const { runtime: unsupportedWidth } = makeRuntime({
      EMBEDDING_BASE_URL: "https://embedding.test",
      EMBEDDING_DIMENSIONS: "999",
    })
    await expectRejects(async () => validateEmbeddingDimension(999))
    const initErr = await expectRejects(async () => {
      await plugin.init?.({}, unsupportedWidth)
    })
    assert.ok(initErr instanceof Error && initErr.message.includes("Invalid embedding dimension: 999"))

    const { runtime: emptyBatchRuntime } = makeRuntime({ EMBEDDING_BASE_URL: "", EMBEDDING_DIMENSIONS: "not-a-number" })
    assert.deepStrictEqual(await handleBatchTextEmbedding(emptyBatchRuntime, []), [])

    const invalidParamErr = await expectRejects(() => handleTextEmbedding(configured, {} as unknown as string))
    assert.ok(invalidParamErr instanceof Error && invalidParamErr.message.includes("Invalid embedding params"))

    const emptyTextErr = await expectRejects(() => handleTextEmbedding(configured, "   "))
    assert.ok(emptyTextErr instanceof Error && emptyTextErr.message.includes("Cannot generate embedding for empty text"))

    const emptyBatchItemErr = await expectRejects(() => handleBatchTextEmbedding(configured, ["ok", "  "]))
    assert.ok(emptyBatchItemErr instanceof Error && emptyBatchItemErr.message.includes("empty text at index 1"))

    const cache = new Map<string, unknown>()
    let ensuredDimension = 0
    const adapter = {
      ensureEmbeddingDimension: async (dimension: number) => { ensuredDimension = dimension },
      clearEmbeddingsOutsideActiveDimension: async () => [],
      getCache: async <T>(key: string) => cache.get(key) as T | undefined,
      getCaches: async <T>(keys: string[]) => new Map(keys.flatMap((k) => (cache.has(k) ? [[k, cache.get(k) as T]] : []))),
      setCache: async <T>(key: string, value: T) => { cache.set(key, value); return true },
      setCaches: async (entries: Array<{ readonly key: string; readonly value: unknown }>) => {
        for (const entry of entries) cache.set(entry.key, entry.value)
        return true
      },
      deleteCache: async (key: string) => cache.delete(key),
      deleteCaches: async (keys: string[]) => {
        for (const key of keys) cache.delete(key)
        return true
      },
      getTasks: async () => [],
      createTasks: async (tasks: unknown[]) => tasks.map((_t, index) => `00000000-0000-0000-0000-00000000000${index + 2}`),
      createLogs: async () => undefined,
    } as unknown as IDatabaseAdapter
    const onDeviceEmbedder: Plugin = {
      name: "on-device-embedder",
      description: "Test on-device TEXT_EMBEDDING provider",
      priority: 0,
      models: {
        [ModelType.TEXT_EMBEDDING]: async () => vectorOf(384, 1),
      },
    }
    const realRuntime = new AgentRuntime({
      logLevel: "fatal",
      character: {
        name: "Agent",
        bio: ["test"],
        settings: { EMBEDDING_API_KEY: "test-key", EMBEDDING_BASE_URL: "" },
      },
      adapter,
      plugins: [],
    })
    await realRuntime.registerPlugin(onDeviceEmbedder)
    await realRuntime.registerPlugin(embeddingsPlugin)
    await realRuntime.ensureEmbeddingDimension()
    const fellThrough = await realRuntime.useModel(ModelType.TEXT_EMBEDDING, { text: "remember this" })
    assert.strictEqual(ensuredDimension, 384)
    assert.strictEqual(fellThrough.length, 384)
    assert.strictEqual(fellThrough[0], 1)
  })
})

describe('Wire format, Unicode sanitization, index ordering, validation, and MODEL_USED telemetry (spec/embeddings/index.md, "Vectors cover every index exactly once and share one width")', () => {
  it('sanitizes lone surrogates, sends string for single and array for batch, omits unset dimensions, reorders indices, and emits MODEL_USED resiliently (spec/embeddings/index.md, "Vectors cover every index exactly once and share one width")', async () => {
    const server = await startEmbeddingServer((captured, _req, res) => {
      const parsed = parseJson<{ input: string | string[]; dimensions?: number }>(captured.body)
      res.writeHead(200, { "content-type": "application/json" })
      if (Array.isArray(parsed.input)) {
        res.end(JSON.stringify({
          data: [
            { index: 2, embedding: vectorOf(384, 3) },
            { index: 0, embedding: vectorOf(384, 1) },
            { index: 1, embedding: vectorOf(384, 2) },
          ],
          usage: { prompt_tokens: 18, total_tokens: 18 },
        }))
        return
      }
      if (parsed.dimensions === undefined) {
        res.end(JSON.stringify({
          data: [{ index: 0, embedding: vectorOf(1536, 7) }],
          usage: null,
        }))
        return
      }
      res.end(JSON.stringify({
        data: [{ index: 0, embedding: vectorOf(384, 5) }],
        usage: { prompt_tokens: 6, total_tokens: 6 },
      }))
    })
    try {
      const { runtime, events } = makeRuntime({
        EMBEDDING_BASE_URL: `${server.baseUrl}///`,
        EMBEDDING_API_KEY: "wire-secret",
        EMBEDDING_MODEL: "test-model",
        EMBEDDING_DIMENSIONS: "384",
        EMBEDDING_FALLBACK_BASE_URL: "",
      })
      const broken = "summarize this page 🤖 please".slice(0, 21)
      const fullEmoji = "full emoji 🤖"
      const plainText = "plain text"

      assert.ok(broken.includes("\uD83E"))
      assert.strictEqual(LONE_SURROGATE_ESCAPE.test(JSON.stringify(broken)), true)

      const singleVector = await handleTextEmbedding(runtime, broken)
      const batchVectors = await handleBatchTextEmbedding(runtime, [broken, fullEmoji, plainText])

      const { runtime: implicitWidthRuntime } = makeRuntime({
        EMBEDDING_BASE_URL: server.baseUrl,
        EMBEDDING_API_KEY: "",
        EMBEDDING_MODEL: "default-width-model",
        EMBEDDING_DIMENSIONS: "",
        EMBEDDING_FALLBACK_BASE_URL: "",
      })
      const defaultWidthVector = await handleTextEmbedding(implicitWidthRuntime, "implicit width")

      await flushMicrotasks()

      assert.strictEqual(singleVector.length, 384)
      assert.strictEqual(singleVector[0], 5)
      assert.deepStrictEqual(batchVectors.map((v) => v[0]), [1, 2, 3])
      assert.strictEqual(defaultWidthVector.length, 1536)
      assert.strictEqual(defaultWidthVector[0], 7)

      assert.strictEqual(server.requests.length, 3)
      for (const req of server.requests) {
        assert.strictEqual(req.path, "/embeddings")
        assert.strictEqual(LONE_SURROGATE_ESCAPE.test(req.body), false)
      }
      const singleWire = parseJson<Record<string, unknown>>(server.requests[0]!.body)
      const batchWire = parseJson<Record<string, unknown>>(server.requests[1]!.body)
      const implicitWire = parseJson<Record<string, unknown>>(server.requests[2]!.body)

      assert.strictEqual(singleWire.input, "summarize this page \uFFFD")
      assert.strictEqual(singleWire.dimensions, 384)
      assert.strictEqual(server.requests[0]!.authorization, "Bearer wire-secret")
      assert.deepStrictEqual(batchWire.input, ["summarize this page \uFFFD", fullEmoji, plainText])
      assert.strictEqual(batchWire.dimensions, 384)
      assert.strictEqual("dimensions" in implicitWire, false)
      assert.strictEqual(server.requests[2]!.authorization, undefined)

      assert.strictEqual(events.length, 2)
      assert.strictEqual(events[0]!.event, EventType.MODEL_USED)
      assert.deepStrictEqual((events[0]!.payload as { tokens: unknown }).tokens, {
        prompt: 6,
        completion: 0,
        total: 6,
      })
      assert.strictEqual((events[0]!.payload as { prompt: string }).prompt, "summarize this page \uFFFD")
      assert.strictEqual((events[1]!.payload as { prompt: string }).prompt, "batch:3")
      assert.deepStrictEqual((events[1]!.payload as { tokens: unknown }).tokens, {
        prompt: 18,
        completion: 0,
        total: 18,
      })

      const { runtime: throwingListenerRuntime, reportedErrors } = makeRuntime(
        {
          EMBEDDING_BASE_URL: server.baseUrl,
          EMBEDDING_DIMENSIONS: "384",
          EMBEDDING_FALLBACK_BASE_URL: "",
        },
        {
          emitEvent: async () => {
            throw new Error("telemetry sink down")
          },
        },
      )
      const servedDespiteListenerFailure = await handleTextEmbedding(throwingListenerRuntime, "keep serving")
      await flushMicrotasks()
      assert.strictEqual(servedDespiteListenerFailure[0], 5)
      assert.strictEqual(reportedErrors.length, 1)
      assert.strictEqual(reportedErrors[0]!.scope, "EmbeddingsModelUsage.emitEvent")
    } finally {
      await server.close()
    }
  })

  it('rejects duplicate, out-of-range, wrong-count, wrong-width, and non-JSON responses (spec/embeddings/index.md, "Vectors cover every index exactly once and share one width")', async () => {
    let mode = "duplicate"
    const server = await startEmbeddingServer((_captured, _req, res) => {
      if (mode === "not-json") {
        res.writeHead(200, { "content-type": "text/plain" })
        res.end("not-json")
        return
      }
      res.writeHead(200, { "content-type": "application/json" })
      if (mode === "duplicate") {
        res.end(JSON.stringify({ data: [{ index: 0, embedding: vectorOf(384, 1) }, { index: 0, embedding: vectorOf(384, 2) }] }))
      } else if (mode === "out-of-range") {
        res.end(JSON.stringify({ data: [{ index: 2, embedding: vectorOf(384, 1) }] }))
      } else if (mode === "wrong-count") {
        res.end(JSON.stringify({ data: [] }))
      } else if (mode === "wrong-width") {
        res.end(JSON.stringify({ data: [{ index: 0, embedding: vectorOf(512, 1) }] }))
      }
    })
    try {
      const { runtime } = makeRuntime({
        EMBEDDING_BASE_URL: server.baseUrl,
        EMBEDDING_DIMENSIONS: "384",
        EMBEDDING_FALLBACK_BASE_URL: "",
      })
      mode = "duplicate"
      const dupErr = await expectRejects(() => handleBatchTextEmbedding(runtime, ["a", "b"]))
      assert.ok(dupErr instanceof Error && dupErr.message.includes("duplicate index 0"))

      mode = "out-of-range"
      const rangeErr = await expectRejects(() => handleTextEmbedding(runtime, "a"))
      assert.ok(rangeErr instanceof Error && rangeErr.message.includes("out-of-range index"))

      mode = "wrong-count"
      const countErr = await expectRejects(() => handleTextEmbedding(runtime, "a"))
      assert.ok(countErr instanceof Error && countErr.message.includes("returned 0 vectors, expected 1"))

      mode = "wrong-width"
      const widthErr = await expectRejects(() => handleTextEmbedding(runtime, "a"))
      assert.ok(widthErr instanceof Error && widthErr.message.includes("dimension mismatch: got 512, expected 384"))

      mode = "not-json"
      const jsonErr = await expectRejects(() => handleTextEmbedding(runtime, "a"))
      assert.ok(jsonErr instanceof Error && jsonErr.message.includes("not valid JSON"))
    } finally {
      await server.close()
    }
  })
})

describe('Confidential inference, bounded fallback, HTTP diagnostics, and cancellation (spec/embeddings/index.md, "A failed primary can use a configured fallback once")', () => {
  it('enforces confidential inference admission, audit metadata, no redispatch, redirect refusal, and ordinary fallback (spec/embeddings/index.md, "A failed primary can use a configured fallback once")', async () => {
    let responseStatus = 200
    let primaryInvalidComponent = false
    const server = await startEmbeddingServer((captured, _req, res) => {
      const input = parseJson<{ input: string | string[] }>(captured.body)
      const count = Array.isArray(input.input) ? input.input.length : 1
      res.writeHead(responseStatus, { "content-type": "application/json" })
      res.end(JSON.stringify({
        data: Array.from({ length: count }, (_item, index) => ({
          index,
          embedding: Array.from({ length: 384 }, (_v, i) =>
            i === 0 && primaryInvalidComponent && captured.path === "/embeddings"
              ? null
              : i === 0
                ? 1
                : 0),
        })),
      }))
    })

    function confidentialFixture(options: { readonly approved?: boolean; readonly auditFails?: boolean; readonly fallback?: boolean } = {}) {
      const { runtime } = makeRuntime({
        EMBEDDING_BASE_URL: server.baseUrl,
        EMBEDDING_API_KEY: "synthetic-embedding-secret",
        EMBEDDING_MODEL: "reviewed-bge",
        EMBEDDING_DIMENSIONS: "384",
        EMBEDDING_FALLBACK_BASE_URL: options.fallback ? `${server.baseUrl}/fallback` : "",
        EMBEDDING_FALLBACK_MODEL: "reviewed-bge",
        EMBEDDING_FALLBACK_API_KEY: "synthetic-fallback-secret",
      })
      const records: ConfidentialInferenceAuditRecord[] = []
      const expiresAt = Date.now() + 60_000
      const authority = new ConfidentialInferenceAuthority({
        handlers: [handleTextEmbedding, handleBatchTextEmbedding],
        redispatchPolicy: "deny-after-authorization",
        currentProfile: () => ({
          revision: "synthetic-policy",
          expiresAt,
          routes: (options.approved === false ? [] : [server.baseUrl, `${server.baseUrl}/fallback`]).map((url, index) => ({
            id: `route-${index}`,
            endpoint: `${url}/embeddings`,
            model: "reviewed-bge",
            modelTypes: [ModelType.TEXT_EMBEDDING, ModelType.TEXT_EMBEDDING_BATCH],
          })),
        }),
        audit: {
          async append(record) {
            if (options.auditFails) throw new Error("Synthetic audit unavailable")
            records.push(record)
          },
        },
        transport: async (url, init, context) => {
          await context.beforeDispatch({
            evidenceDigest: "a".repeat(64),
            connectionBindingDigest: "b".repeat(64),
          })
          assert.strictEqual(records.at(-1)?.phase, "dispatch_intent")
          return httpFetch(url, init)
        },
      })
      const embed = (input: string | string[]) =>
        runWithConfidentialInference(
          authority,
          {
            agentId: runtime.agentId,
            modelType: Array.isArray(input) ? ModelType.TEXT_EMBEDDING_BATCH : ModelType.TEXT_EMBEDDING,
            handler: Array.isArray(input) ? handleBatchTextEmbedding : handleTextEmbedding,
          },
          () => (Array.isArray(input) ? handleBatchTextEmbedding(runtime, input) : handleTextEmbedding(runtime, input)),
        )
      return { runtime, records, embed }
    }

    try {
      for (const deniedOptions of [{ approved: false, fallback: true }, { auditFails: true, fallback: true }]) {
        server.requests.length = 0
        const { embed } = confidentialFixture(deniedOptions)
        await expectRejects(() => embed("synthetic private memory"))
        assert.deepStrictEqual(server.requests, [])
      }

      server.requests.length = 0
      const { embed: admittedEmbed, records: admittedRecords } = confidentialFixture()
      const largeInput = `${"complete synthetic memory Ω ".repeat(2000)}END`
      assert.strictEqual((await admittedEmbed(largeInput)).length, 384)
      assert.strictEqual((await admittedEmbed([largeInput, "second memory"])).length, 2)
      assert.deepStrictEqual(
        server.requests.map((r) => parseJson<{ input: unknown }>(r.body).input),
        [largeInput, [largeInput, "second memory"]],
      )
      assert.deepStrictEqual(
        server.requests.map((r) => r.authorization),
        ["Bearer synthetic-embedding-secret", "Bearer synthetic-embedding-secret"],
      )
      assert.strictEqual(admittedRecords.filter((r) => r.phase === "dispatch_intent").length, 2)
      assert.strictEqual(JSON.stringify(admittedRecords).includes("synthetic-embedding-secret"), false)
      assert.strictEqual(JSON.stringify(admittedRecords).includes("complete synthetic memory"), false)

      server.requests.length = 0
      responseStatus = 503
      const { embed: fail503Embed } = confidentialFixture({ fallback: true })
      await expectRejects(() => fail503Embed("synthetic private memory"))
      assert.deepStrictEqual(server.requests.map((r) => r.path), ["/embeddings"])

      server.requests.length = 0
      responseStatus = 302
      const { embed: redirectEmbed, records: redirectRecords } = confidentialFixture({ fallback: true })
      await expectRejects(() => redirectEmbed("synthetic private memory"))
      assert.deepStrictEqual(server.requests.map((r) => r.path), ["/embeddings"])
      assert.ok(redirectRecords.map((r) => r.phase).includes("transport_error"))

      server.requests.length = 0
      responseStatus = 200
      const { runtime: ordinaryRuntime } = confidentialFixture()
      assert.strictEqual((await handleTextEmbedding(ordinaryRuntime, "ordinary synthetic input")).length, 384)
      assert.strictEqual(server.requests.length, 1)

      server.requests.length = 0
      primaryInvalidComponent = true
      const { runtime: fallbackRuntime } = confidentialFixture({ fallback: true })
      const fallbackVector = await handleTextEmbedding(fallbackRuntime, "ordinary synthetic input")
      assert.strictEqual(fallbackVector[0], 1)
      assert.deepStrictEqual(server.requests.map((r) => r.path), ["/embeddings", "/fallback/embeddings"])
      assert.strictEqual(server.requests[1]!.authorization, "Bearer synthetic-fallback-secret")
    } finally {
      await server.close()
    }
  })

  it('preserves HTTP error metadata for core failover, combines primary and fallback errors when exhausted, and stops fallback on AbortSignal cancellation (spec/embeddings/index.md, "A failed primary can use a configured fallback once")', async () => {
    let abortOnPrimary: AbortController | undefined
    const server = await startEmbeddingServer((captured, _req, res) => {
      if (captured.path === "/embeddings") {
        if (abortOnPrimary !== undefined) {
          abortOnPrimary.abort(new Error("caller cancelled after primary failure"))
        }
        res.writeHead(503, { "content-type": "application/json", "retry-after": "5" })
        res.end(JSON.stringify({ error: { message: "primary overloaded" } }))
        return
      }
      res.writeHead(502, { "content-type": "application/json" })
      res.end(JSON.stringify({ error: { message: "fallback bad gateway" } }))
    })
    try {
      const { runtime: primaryOnly } = makeRuntime({
        EMBEDDING_BASE_URL: server.baseUrl,
        EMBEDDING_DIMENSIONS: "384",
        EMBEDDING_FALLBACK_BASE_URL: "",
      })
      const httpErr = await expectRejects(() => handleTextEmbedding(primaryOnly, "hello"))
      assert.strictEqual(isModelProviderError(httpErr), true)
      assert.strictEqual(isTransientModelError(httpErr), true)
      const detail = modelProviderErrorDetail(httpErr)
      assert.strictEqual(detail?.status, 503)
      assert.strictEqual(detail?.providerMessage, "primary overloaded")
      assert.strictEqual(detail?.url, `${server.baseUrl}/embeddings`)
      assert.strictEqual((httpErr as { responseHeaders?: Record<string, string> }).responseHeaders?.["retry-after"], "5")

      server.requests.length = 0
      const { runtime: withFallback } = makeRuntime({
        EMBEDDING_BASE_URL: server.baseUrl,
        EMBEDDING_DIMENSIONS: "384",
        EMBEDDING_FALLBACK_BASE_URL: `${server.baseUrl}/fallback`,
      })
      const bothErr = await expectRejects(() => handleTextEmbedding(withFallback, "hello"))
      assert.ok(bothErr instanceof Error)
      assert.ok(bothErr.message.includes("primary"))
      assert.ok(bothErr.message.includes("fallback"))
      assert.strictEqual(modelProviderErrorDetail(bothErr)?.status, 502)
      assert.deepStrictEqual(server.requests.map((r) => r.path), ["/embeddings", "/fallback/embeddings"])

      server.requests.length = 0
      const preAborted = new AbortController()
      preAborted.abort(new Error("already aborted"))
      const preAbortErr = await expectRejects(() =>
        handleTextEmbedding(withFallback, { text: "hello", signal: preAborted.signal }),
      )
      assert.strictEqual((preAbortErr as { code?: string }).code, "ABORT_ERR")
      assert.deepStrictEqual(server.requests, [])

      server.requests.length = 0
      const cancelAfterPrimary = new AbortController()
      abortOnPrimary = cancelAfterPrimary
      const afterPrimaryErr = await expectRejects(() =>
        handleTextEmbedding(withFallback, { text: "hello", signal: cancelAfterPrimary.signal }),
      )
      abortOnPrimary = undefined
      assert.strictEqual((afterPrimaryErr as { code?: string }).code, "ABORT_ERR")
      assert.deepStrictEqual(server.requests.map((r) => r.path), ["/embeddings"])
    } finally {
      await server.close()
    }
  })
})
