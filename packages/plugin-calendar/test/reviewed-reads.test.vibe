// spec/calendar/reviewedReads.md, "Story: Share only the exact current Calendar information I reviewed"; spec/calendar/reviewedReads.md, "Story: Propose on my phone only the Calendar request I made"; spec/calendar/readClock.md, "Story: See and create times in the zone I am asking about"
import { assert, it } from "@effect/vitest"
import type { IAgentRuntime, UUID } from "@elizaos/core"
import { negotiation, readOperation, validate } from "@elizaos/agent"
import type { DeviceTurn } from "@elizaos/agent-host"
import { calendarProposalFamily } from "../src/plugin/device-proposals.vibe"
import { createNeedsConfirmation, createTimeZone, createYear, createdUtcInstant, displayDay, displayWallTime, buildUtcDateFromLocalParts, requestTimeZone, startOfCivilDay, CALENDAR_CAPABILITY, CALENDAR_NAMED_READ_CAPABILITY, NamedReadRefused, executeNamedCalendarRead, namedReadWindow, reviewedReadsMachine, type NamedCalendarReadContext, type NamedCalendarReadProvider } from "@elizaos/plugin-calendar-client"

const selected = { kind: "calendar-event", accountId: "device-home", sourceRevision: "a".repeat(64), id: "evt-1", revision: "b".repeat(64) }
const context: NamedCalendarReadContext = { view: "calendar", owner: "alice", selectedObject: selected }
const read = { type: "calendar_named", action: "read", name: " dentist " } as const
const capabilities = [CALENDAR_NAMED_READ_CAPABILITY, CALENDAR_CAPABILITY]
const fields = { title: "Ｄentist check-up", description: "", location: "", start: "2026-05-04T16:00:00.000Z", end: "2026-05-04T17:00:00.000Z", timeZone: "UTC" }
const record = { version: 1, kind: "calendar_read_selected", sourceId: "device-home", eventId: "evt-1", revision: selected.revision, fields } as const

function share() {
  const controls = { status: "applied", result: record as unknown, feedComplete: true, cancelled: [] as string[], afterRead: () => {} }
  const provider: NamedCalendarReadProvider = {
    executeAgent: () => {
      controls.afterRead()
      return Effect.succeed({ status: controls.status, result: controls.result, feedComplete: controls.feedComplete })
    },
    cancelAgent: ({ operationId }) => Effect.sync(() => { controls.cancelled.push(operationId) }),
  }
  return { controls, provider }
}

it.effect('Share only the exact current Calendar information I reviewed (spec/calendar/reviewedReads.md, "Story: Share only the exact current Calendar information I reviewed")', effect () => {
  provide reviewedReadsMachine() {
    const { controls, provider } = share()
    let active = context
    const run = (op: unknown = read, ctx = context, caps: readonly string[] = capabilities) =>
      executeNamedCalendarRead(provider, op, "op-1", ctx, caps, () => active)
    const shared = try run()
    assert.deepStrictEqual(shared, {
      status: "succeeded", summary: "Shared the matching event you chose. Its requested update still requires a separate review.",
      foregroundResult: { version: 1, kind: "calendar_named", action: "read", name: read.name, basis: "owner-chosen",
        operation: { type: "calendar_read_selected", target: { sourceId: selected.accountId, sourceRevision: selected.sourceRevision, eventId: selected.id, revision: selected.revision } }, record },
    })
    assert.strictEqual((try run({ ...read, name: "plumber" })).summary, "The selected event does not match the requested name. Nothing was shared or changed.")
    const refusedSummary = "The event was not shared. Its selection, access or review changed; nothing was changed."
    controls.feedComplete = false
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.feedComplete = true
    controls.status = "denied"
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.status = "applied"
    controls.result = { ...record, revision: "c".repeat(64) }
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.result = record
    controls.afterRead = () => { active = { ...context, owner: "bob" } }
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.afterRead = () => {}
    active = context
    assert.strictEqual((try run(read, { ...context, sensitive: true })).summary, "Choose the exact matching event in Calendar before sharing it. Nothing was shared or changed.")
    assert.strictEqual((try run(read, { ...context, view: "notes" })).status, "failed")
    const refusal = try Effect.flip(run(read, context, [CALENDAR_NAMED_READ_CAPABILITY]))
    assert.isTrue(refusal instanceof NamedReadRefused && refusal.reason === "capability_unavailable")
    assert.strictEqual((try run()).status, "succeeded")
    assert.deepStrictEqual(namedReadWindow(10_500), { startMs: 9_000, endMs: 11_000 })
  }
})

it.effect('See and create times in the zone I am asking about (spec/calendar/readClock.md, "Story: See and create times in the zone I am asking about")', effect () => {
  const la = "America/Los_Angeles"
  assert.strictEqual(requestTimeZone({ explicit: "Bogus/Zone", client: "Europe/London", owner: "UTC" }), "Europe/London")
  assert.strictEqual(requestTimeZone({ explicit: "Asia/Tokyo", client: "Europe/London", owner: "UTC" }), "Asia/Tokyo")
  assert.strictEqual(requestTimeZone({ owner: la }), la)
  assert.strictEqual(createTimeZone({ client: "Europe/London", owner: la }), "Europe/London")
  const winter = displayWallTime("2026-01-15T19:00:00.000Z", la)
  const summer = displayWallTime("2026-07-15T19:00:00.000Z", la)
  assert.deepStrictEqual([winter?.hour, winter?.offsetMinutes, summer?.hour, summer?.offsetMinutes], [11, -480, 12, -420])
  assert.strictEqual(createdUtcInstant({ year: 2026, month: 1, day: 15, hour: 11, minute: 0, second: 0 }, la), "2026-01-15T19:00:00.000Z")
  assert.strictEqual(createdUtcInstant({ year: 2026, month: 3, day: 8, hour: 2, minute: 30, second: 0 }, la), "2026-03-08T10:30:00.000Z")
  assert.strictEqual(createdUtcInstant({ year: 2026, month: 11, day: 1, hour: 1, minute: 30, second: 0 }, la), "2026-11-01T08:30:00.000Z")
  assert.strictEqual(buildUtcDateFromLocalParts(la, { year: 2026, month: 11, day: 1, hour: 1, minute: 30, second: 0 }, "reject"), undefined)
  assert.strictEqual(startOfCivilDay({ year: 2026, month: 3, day: 8 }, la), Date.parse("2026-03-08T08:00:00.000Z"))
  assert.strictEqual(startOfCivilDay({ year: 2011, month: 12, day: 30 }, "Pacific/Apia"), undefined)
  assert.deepStrictEqual([
    displayDay({ startAt: "2026-01-15T03:00:00.000Z", isAllDay: false }, la),
    displayDay({ startAt: "2026-01-15T00:00:00.000Z", isAllDay: true }, la),
    displayDay({ startAt: "2026-01-15T12:00:00.000Z", isAllDay: false }, "Pacific/Kiritimati"),
  ], ["2026-01-14", "2026-01-15", "2026-01-16"])
  const june = { year: 2026, month: 6, day: 1 }
  assert.deepStrictEqual([createYear("lunch on March 3 2028", june, 2030), createYear("lunch next March 3", june, 2030), createYear("lunch on March 3", june, 2030),
    createYear("March 3 2027 at noon", june, 2030), createYear("lunch next Friday on March 3", june, 2030), createYear("lunch next December 3", june, 2030),
    createYear("dinner next November", { ...june, month: 11 }, 2030), createYear("lunch next year", june, 2030), createYear("lunch next Friday", june, 2027),
    createYear("lunch tomorrow", june, 2027)], [2028, 2027, 2026, 2027, 2026, 2026, 2027, 2027, 2027, 2027])
  assert.deepStrictEqual(["2027년 1월 5일", "내년 1월 5일", "올해 1월 5일", "请安排明年 1月 5日", "2027年 1月 5日", "今年 1月 5日", "12027년 1월 5일", "국내년 1월 5일",
    "내년 January 5, 2028", "2027년 12/25", "내년 12/25", "明年 12-25", "今年 12/25", "국내년 12/25"].map((text) => createYear(text, june, 2030)),
    [2027, 2027, 2026, 2027, 2027, 2026, 2026, 2026, 2028, 2027, 2027, 2027, 2026, 2026])
  const now = new Date("2026-06-01T12:00:00.000Z")
  assert.deepStrictEqual([createNeedsConfirmation("2026-01-01T10:00:00.000Z", now, "UTC"), createNeedsConfirmation("2026-06-02T10:00:00.000Z", now, "UTC"),
    createNeedsConfirmation("2025-12-31T10:00:00.000Z", now, "UTC")], [true, false, true])
})

const phoneCapabilities = ["calendar.local-event.v1", "calendar.create.v1", "calendar.next-read.v1", "calendar.availability-read.v1", "calendar.named-read.v1", "device.named-target.v1"]
const turnStarted = Date.UTC(2026, 10, 22, 15, 0)

function phoneModel(replies: readonly string[] = []) {
  const waiting = [...replies]
  const asked: string[] = []
  const runtime = {
    actions: [{ name: "CALENDAR" }],
    useModel: async (_type: unknown, params: { readonly system?: string; readonly messages?: readonly { readonly content: string }[] }) => {
      asked.push(`${params.messages?.[0]?.content ?? ""}\n${params.system ?? ""}`)
      const reply = waiting.shift()
      if (reply === undefined) throw new Error("No model reply")
      return reply
    },
  } as unknown as IAgentRuntime
  return { runtime, asked, family: calendarProposalFamily(runtime) }
}

function phoneTurn(runtime: IAgentRuntime, ownerText: string, observation: DeviceTurn["observation"], completesReads = true): DeviceTurn {
  const negotiated = negotiation(true, phoneCapabilities.join(","))
  return {
    runtime, by: {} as DeviceTurn["by"], negotiation: negotiated,
    capabilities: phoneCapabilities, message: { id: "00000000-0000-4000-8000-000000000001" as UUID, content: { text: ownerText } } as DeviceTurn["message"],
    ownerText, observation, completedActionNavigation: false, completesReads, conversationId: "c1", requestId: "r1", assistantName: "Eliza", swapped: [],
    startedAt: turnStarted, timeZone: observation?.timeZone, signal: new AbortController().signal,
    admit: (operation) => validate(operation, negotiated, "NoBinding"), earlier: () => succeed([]),
  }
}

const unzonedCalendar = { view: "calendar", revision: 1, sensitive: false, selectedObject: selected }
const onCalendar = { ...unzonedCalendar, timeZone: "Europe/Berlin" }
const onHome = { view: "home", revision: 1, sensitive: false, timeZone: "Europe/Berlin" }
const target = { sourceId: "device-home", sourceRevision: "a".repeat(64), eventId: "evt-1", revision: "b".repeat(64) }
const proposedFields = { title: "Lunch with Sam", description: "", location: "", start: "2026-11-23T11:00:00.000Z", end: "2026-11-23T12:00:00.000Z", timeZone: "Europe/Berlin" }

it.effect(`Propose on my phone only the Calendar request I made (spec/calendar/reviewedReads.md, "Story: Propose on my phone only the Calendar request I made"; spec/calendar/reviewedReads.md, "A phone Calendar proposal is offered only where its record may be proposed"; spec/calendar/reviewedReads.md, "A selected target, a chosen calendar and a named event are the ones the owner gave"; spec/calendar/reviewedReads.md, "A new phone event is the timed event the model read, at a clock time the owner's words do not contradict, on the phone's clock"; spec/calendar/availability.md, "An availability window is the one the model read from the owner's request, on the phone's clock"; spec/calendar/readClock.md, "A stated clock time is refused only where the owner's words give another")`, effect () => {
  const { runtime, family, asked } = phoneModel()
  const turn = (words: string, observation: DeviceTurn["observation"] = onHome, completesReads = true) => phoneTurn(runtime, words, observation, completesReads)
  const grounded = effect (operation: unknown, at: DeviceTurn) => {
    const checked = readOperation(family.prepare?.(operation) ?? operation)
    if (checked === undefined) return "DEVICE_OPERATION_INVALID"
    const result = try family.ground(checked, at)
    return result.kind === "Grounded" ? result.operation : result.code
  }
  const offered = (at: DeviceTurn) => family.forms.filter((form) => form.offered(at) && (form.now?.available(at) ?? true)).map(({ schema }) => JSON.stringify(schema.properties?.action?.enum ?? schema.properties?.type?.enum))
  assert.deepStrictEqual(offered(turn("delete this", onCalendar)), [
    '["calendar_read_next"]', '["calendar_create_local"]', '["calendar_read_selected"]', '["calendar_delete"]', '["read"]', '["delete"]', '["calendar_availability"]',
  ])
  assert.deepStrictEqual(offered(turn("add lunch tomorrow at noon", { ...onHome, view: "notes" })), ['["calendar_read_next"]'])
  assert.deepStrictEqual([offered(turn("add lunch tomorrow at noon")).includes('["calendar_create_local"]'), offered(turn("put lunch with Ana on my phone calendar Friday at noon")).includes('["calendar_create_local"]')],
    [true, true])
  assert.deepStrictEqual(offered(turn("delete this", { ...onHome, view: "calendar", sensitive: true })), [])
  assert.deepStrictEqual(offered(turn("delete this", { ...onCalendar, selectedObject: { kind: "canonical-calendar-event", id: "e" } })), [])

  const deleting = { type: "calendar_delete", target }
  assert.deepStrictEqual([try grounded(deleting, turn("Delete this event", onCalendar)), try grounded(deleting, turn("Delete my 3pm, I don't need it", onCalendar)), try grounded(deleting, turn("削除して", onCalendar))],
    [deleting, deleting, deleting])
  assert.strictEqual(try grounded({ ...deleting, target: { ...target, eventId: "evt-2" } }, turn("Delete this event", onCalendar)), "DEVICE_CALENDAR_TARGET_NOT_SELECTED")
  const lunchDelete = { type: "calendar_named", action: "delete", name: "lunch" } as const
  assert.deepStrictEqual(try grounded(lunchDelete, turn("Cancel the lunch, we're not meeting")), lunchDelete)
  assert.strictEqual(try grounded({ type: "calendar_named", action: "delete", name: "plumber" }, turn("Delete my dentist appointment")), "CALENDAR_NAMED_NOT_REQUESTED")
  const unspaced = (name: string, words: string) => grounded({ type: "calendar_named", action: "delete", name }, turn(words))
  assert.deepStrictEqual([try unspaced("歯医者", "歯医者を削除して"), try unspaced("牙医预约", "删除牙医预约"), try unspaced("치과", "치과를 삭제해줘"),
    try unspaced("Dentist", "Delete the dentistry booking"), try unspaced("歯医者", "小児歯医者を削除して"), try unspaced("牙医预约", "删除儿童牙医预约")], [
    { type: "calendar_named", action: "delete", name: "歯医者" }, { type: "calendar_named", action: "delete", name: "牙医预约" }, { type: "calendar_named", action: "delete", name: "치과" },
    "CALENDAR_NAMED_NOT_REQUESTED", "CALENDAR_NAMED_NOT_REQUESTED", "CALENDAR_NAMED_NOT_REQUESTED",
  ])

  const dentist = { type: "calendar_named", action: "read", name: "dentist appointment" }
  const named = (words: string, observation: DeviceTurn["observation"] = onHome, completesReads = true) => grounded(dentist, turn(words, observation, completesReads))
  assert.deepStrictEqual([try named("Move my dentist appointment to Friday at 3pm"), try named("Move my dentist appointment to 3pm Narnia time"), try named("Push my dentist appointment back an hour"),
    try named("Move my dentist appointment to Friday at 3pm", { ...onHome, timeZone: undefined }), try named("Move my dentist appointment to Friday at 3pm", onHome, false),
    try named("Move my plumber appointment to Friday at 3pm")],
    [dentist, dentist, dentist, "CALENDAR_ZONE_UNAVAILABLE", "CALENDAR_CHANGE_READ_UNAVAILABLE", "CALENDAR_NAMED_NOT_REQUESTED"])
  const sharing = { type: "calendar_read_selected", target }
  assert.deepStrictEqual([try grounded(sharing, turn("What is this meeting about?", onCalendar)), try grounded(sharing, turn("Move this meeting to 10am", unzonedCalendar)),
    try grounded({ ...sharing, target: { ...target, revision: "c".repeat(64) } }, turn("Move this meeting to 10am", onCalendar))],
    [sharing, sharing, "DEVICE_CALENDAR_TARGET_NOT_SELECTED"])

  const lunch = turn("Add lunch with Sam at Cafe Roma tomorrow at noon")
  const created = try grounded({ type: "calendar_create_local", fields: { ...proposedFields, description: "Discuss the budget", location: "Cafe Roma" } }, lunch)
  assert.deepStrictEqual(created, { type: "calendar_create_local", fields: { ...proposedFields, location: "Cafe Roma" } })
  assert.notStrictEqual(lunch.admit(created), undefined)
  const create = (words: string, fields: Partial<typeof proposedFields> = {}) => grounded({ type: "calendar_create_local", fields: { ...proposedFields, ...fields } }, turn(words))
  const ana = { title: "Lunch with Ana", start: "2026-11-27T11:00:00.000Z", end: "2026-11-27T12:00:00.000Z" }
  assert.deepStrictEqual([try create("put lunch with Ana on my phone calendar Friday at noon", ana), try create("Add lunch with Sam at 6pm", { start: "2026-11-22T17:00:00.000Z", end: "2026-11-22T18:00:00.000Z" }),
    try create("Add lunch with Sam 2027年3/5 at 3pm", { start: "2027-03-05T14:00:00.000Z", end: "2027-03-05T15:00:00.000Z" }),
    try create("Add lunch with Sam tomorrow from one ten PM to one thirty PM", { start: "2026-11-23T12:10:00.000Z", end: "2026-11-23T12:30:00.000Z" }),
    try create("Add lunch with Sam tomorrow at ten past 4", { start: "2026-11-23T15:10:00.000Z", end: "2026-11-23T16:10:00.000Z" }), try create("Add lunch with Sam soon")], [
    { type: "calendar_create_local", fields: { ...proposedFields, ...ana } },
    { type: "calendar_create_local", fields: { ...proposedFields, start: "2026-11-22T17:00:00.000Z", end: "2026-11-22T18:00:00.000Z" } },
    { type: "calendar_create_local", fields: { ...proposedFields, start: "2027-03-05T14:00:00.000Z", end: "2027-03-05T15:00:00.000Z" } },
    { type: "calendar_create_local", fields: { ...proposedFields, start: "2026-11-23T12:10:00.000Z", end: "2026-11-23T12:30:00.000Z" } },
    { type: "calendar_create_local", fields: { ...proposedFields, start: "2026-11-23T15:10:00.000Z", end: "2026-11-23T16:10:00.000Z" } },
    { type: "calendar_create_local", fields: proposedFields },
  ])
  assert.deepStrictEqual([try create("Add lunch with Sam tomorrow at 3", { start: "2026-11-23T15:00:00.000Z", end: "2026-11-23T16:00:00.000Z" }), try create("Add lunch with Sam tomorrow from one ten PM to one thirty PM", { start: "2026-11-23T21:10:00.000Z", end: "2026-11-23T21:30:00.000Z" }),
    try create("Add lunch with Sam tomorrow at 3pm Tokyo time", { start: "2026-11-23T06:00:00.000Z", end: "2026-11-23T07:00:00.000Z", timeZone: "Asia/Tokyo" }),
    try create("Add lunch with Sam tomorrow at 3pm Tokyo time", { start: "2026-11-23T06:00:00.000Z", end: "2026-11-23T07:00:00.000Z" }),
    try create("Add lunch tomorrow at noon", { title: "Lunch with the board" }), try create("Add lunch with Sam at noon", { start: "2026-11-22T11:00:00.000Z", end: "2026-11-22T12:00:00.000Z" })],
    ["CALENDAR_CLOCK_UNSAID", "CALENDAR_CLOCK_UNSAID", "CALENDAR_OTHER_ZONE_NAMED", "CALENDAR_CLOCK_UNSAID", "CALENDAR_TITLE_NOT_STATED", "CALENDAR_CREATE_PAST_START"])
  assert.deepStrictEqual(try create("Add lunch with Sam every Monday at noon"), { type: "calendar_create_local", fields: proposedFields })
  assert.deepStrictEqual([try create("put lunch with Ana on my phone calendar Friday at noon", { ...ana, start: "2026-11-27T12:00:00+01:00", end: "2026-11-27T13:00+01:00" }),
    try create("put lunch with Ana on my phone calendar Friday at noon", { ...ana, start: "2026-11-27T11:00:00Z" }), try create("put lunch with Ana on my phone calendar Friday at noon", { ...ana, start: "2026-11-27T12:00:00" })],
    [{ type: "calendar_create_local", fields: { ...proposedFields, ...ana } }, { type: "calendar_create_local", fields: { ...proposedFields, ...ana } }, "DEVICE_OPERATION_INVALID"])

  const window = { type: "calendar_availability", start: "2026-11-23T14:00:00.000Z", end: "2026-11-23T15:00:00.000Z", timeZone: "Europe/Berlin" }
  const morning = { ...window, start: "2026-11-22T23:00:00.000Z", end: "2026-11-23T11:00:00.000Z" }
  const free = (words: string, proposed: typeof window = window, observation: DeviceTurn["observation"] = onHome) => grounded(proposed, turn(words, observation))
  assert.deepStrictEqual([try free("Am I free tomorrow at 3pm?"), try free("am I free tomorrow morning?", morning), try free("Am I free tomorrow at 3pm Tokyo time?", { ...window, timeZone: "Asia/Tokyo" }),
    try free("Am I free tomorrow at 3pm?", window, { ...onHome, timeZone: undefined }), try free("am I free tomorrow morning?", { ...morning, start: "2026-11-23T00:00:00+01:00", end: "2026-11-23T12:00+01:00" })],
    [window, morning, "CALENDAR_OTHER_ZONE_NAMED", "CALENDAR_ZONE_UNAVAILABLE", morning])
  assert.deepStrictEqual(asked, [])
})

it.effect(`A change after a shared read is the edit the model read (spec/calendar/reviewedReads.md, "A change after a shared read is the edit the model read from the owner's request, keeping every other field")`, effect () => {
  const shared = { ...fields, title: "Standup", start: "2026-11-22T16:00:00.000Z", end: "2026-11-22T16:30:00.000Z", timeZone: "Europe/Berlin" }
  const read = { proposalId: "p1", requestMessageId: "00000000-0000-4000-8000-000000000001" as UUID, operation: { type: "calendar_read_selected", target } as const,
    result: { ...record, fields: shared }, settledAt: turnStarted }
  const byName = { ...read, operation: { type: "calendar_named", action: "read", name: "standup" } as const,
    result: { version: 1, kind: "calendar_named", action: "read", name: "standup", basis: "owner-chosen", operation: { type: "calendar_read_selected", target }, record: { ...record, fields: shared } } }
  const unmatched = { ...byName, result: { version: 1, kind: "calendar_named", action: "read", name: "standup", basis: "no-match" } }
  const reply = (change: Record<string, string> = {}, question?: string) => JSON.stringify({
    requiresInput: question !== undefined, question: question ?? null, title: null, location: null, description: null, start: null, end: null, timeZone: null, ...change,
  })
  const after = effect (words: string, answer: string | undefined, earlier: typeof read | typeof byName | typeof unmatched = read, observation: DeviceTurn["observation"] = onCalendar) => {
    const model = phoneModel(answer === undefined ? [] : [answer])
    const continued = try (model.family.continueAfterRead?.(earlier, phoneTurn(model.runtime, words, observation)) ?? succeed(undefined))
    return { continued, asked: model.asked.length }
  }
  const timeReview = "The event is ready for time-change review. Confirm the new time to update it; nothing has changed yet."
  const editReview = "The event is ready for update review. Confirm the requested changes; nothing has changed yet."
  const moved = (start: string, end: string, zone: Record<string, string> = {}) => ({ continued: { operation: { type: "calendar_update", target, fields: { ...shared, start, end, ...zone } }, text: timeReview }, asked: 1 })
  const edited = (change: Partial<typeof shared>) => ({ continued: { operation: { type: "calendar_update", target, fields: { ...shared, ...change } }, text: editReview }, asked: 1 })
  const told = (text: string, asked = 1) => ({ continued: { text }, asked })
  assert.deepStrictEqual([
    try after("Reschedule this meeting for tomorrow at 10am", reply({ start: "2026-11-23T09:00:00.000Z", end: "2026-11-23T09:30:00.000Z" })),
    try after("Push this meeting back an hour", reply({ start: "2026-11-22T17:00:00.000Z", end: "2026-11-22T17:30:00.000Z" })),
    try after("move my 3pm to 4", reply({ start: "2026-11-22T15:00:00.000Z", end: "2026-11-22T15:30:00.000Z" })),
    try after("Move this meeting to 3pm Tokyo time", reply({ start: "2026-11-23T06:00:00.000Z", end: "2026-11-23T06:30:00.000Z", timeZone: "Asia/Tokyo" })),
  ], [
    moved("2026-11-23T09:00:00.000Z", "2026-11-23T09:30:00.000Z"), moved("2026-11-22T17:00:00.000Z", "2026-11-22T17:30:00.000Z"), moved("2026-11-22T15:00:00.000Z", "2026-11-22T15:30:00.000Z"),
    moved("2026-11-23T06:00:00.000Z", "2026-11-23T06:30:00.000Z", { timeZone: "Asia/Tokyo" }),
  ])
  assert.deepStrictEqual([try after("Rename this to “Team sync”", reply({ title: "Team sync" })), try after("Change the location to Room 4", reply({ location: "Room 4" })),
    try after("Please set the notes for this meeting to Bring the slides.", reply({ description: "Bring the slides" })),
    try after("Rename it Checkup and push it an hour", reply({ title: "Checkup", start: "2026-11-22T17:00:00.000Z", end: "2026-11-22T17:30:00.000Z" }))],
    [edited({ title: "Team sync" }), edited({ location: "Room 4" }), edited({ description: "Bring the slides" }), edited({ title: "Checkup", start: "2026-11-22T17:00:00.000Z", end: "2026-11-22T17:30:00.000Z" })])
  const question = "Should it start at 10am or 11am?"
