// spec/calendar/reviewedReads.md, "Story: Share only the exact current Calendar information I reviewed"; spec/calendar/reviewedReads.md, "Story: Propose on my phone only the Calendar request I made"; spec/calendar/readClock.md, "Story: See and create times in the zone I am asking about"
import { assert, it } from "@effect/vitest"
import type { IAgentRuntime, UUID } from "@elizaos/core"
import { negotiation, readOperation, validate, type CheckedOperation, type DeviceTurn } from "@elizaos/agent/device-actions"
import { calendarProposalFamily } from "../src/plugin/device-proposals.vibe"
import { createNeedsConfirmation, createTimeZone, createYear, createdUtcInstant, displayDay, displayWallTime, buildUtcDateFromLocalParts,
  requestTimeZone, startOfCivilDay } from "../src/clock.vibe"
import { CALENDAR_CAPABILITY, CALENDAR_NAMED_READ_CAPABILITY, NamedReadRefused, executeNamedCalendarRead, namedReadWindow,
  reviewedReadsMachine, type NamedCalendarReadContext, type NamedCalendarReadProvider } from "../src/client/index.vibe"

const selected = { kind: "calendar-event", accountId: "device-home", sourceRevision: "a".repeat(64), id: "evt-1", revision: "b".repeat(64) }
const context: NamedCalendarReadContext = { view: "calendar", owner: "alice", selectedObject: selected }
const read = { type: "calendar_named", action: "read", name: " dentist " } as const
const capabilities = [CALENDAR_NAMED_READ_CAPABILITY, CALENDAR_CAPABILITY]
const fields = { title: "Ｄentist check-up", description: "", location: "", start: "2026-05-04T16:00:00.000Z", end: "2026-05-04T17:00:00.000Z", timeZone: "UTC" }
const record = { version: 1, kind: "calendar_read_selected", sourceId: "device-home", eventId: "evt-1", revision: selected.revision, fields } as const

function share() {
  const controls = { status: "applied", result: record as unknown, feedComplete: true, cancelled: [] as string[], afterRead: () => {} }
  const provider: NamedCalendarReadProvider = {
    executeAgent: () => {
      controls.afterRead()
      return Effect.succeed({ status: controls.status, result: controls.result, feedComplete: controls.feedComplete })
    },
    cancelAgent: ({ operationId }) => Effect.sync(() => { controls.cancelled.push(operationId) }),
  }
  return { controls, provider }
}

it.effect('Share only the exact current Calendar information I reviewed (spec/calendar/reviewedReads.md, "Story: Share only the exact current Calendar information I reviewed")', effect () => {
  provide reviewedReadsMachine() {
    const { controls, provider } = share()
    let active = context
    const run = (op: unknown = read, ctx = context, caps: readonly string[] = capabilities) =>
      executeNamedCalendarRead(provider, op, "op-1", ctx, caps, () => active)
    const shared = try run()
    assert.deepStrictEqual(shared, {
      status: "succeeded", summary: "Shared the matching event you chose. Its requested update still requires a separate review.",
      foregroundResult: { version: 1, kind: "calendar_named", action: "read", name: read.name, basis: "owner-chosen",
        operation: { type: "calendar_read_selected", target: { sourceId: selected.accountId, sourceRevision: selected.sourceRevision, eventId: selected.id, revision: selected.revision } }, record },
    })
    assert.strictEqual((try run({ ...read, name: "plumber" })).summary, "The selected event does not match the requested name. Nothing was shared or changed.")
    const refusedSummary = "The event was not shared. Its selection, access or review changed; nothing was changed."
    controls.feedComplete = false
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.feedComplete = true
    controls.status = "denied"
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.status = "applied"
    controls.result = { ...record, revision: "c".repeat(64) }
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.result = record
    controls.afterRead = () => { active = { ...context, owner: "bob" } }
    assert.strictEqual((try run()).summary, refusedSummary)
    controls.afterRead = () => {}
    active = context
    assert.strictEqual((try run(read, { ...context, sensitive: true })).summary, "Choose the exact matching event in Calendar before sharing it. Nothing was shared or changed.")
    assert.strictEqual((try run(read, { ...context, view: "notes" })).status, "failed")
    const refusal = try Effect.flip(run(read, context, [CALENDAR_NAMED_READ_CAPABILITY]))
    assert.isTrue(refusal instanceof NamedReadRefused && refusal.reason === "capability_unavailable")
    assert.strictEqual((try run()).status, "succeeded")
    assert.deepStrictEqual(namedReadWindow(10_500), { startMs: 9_000, endMs: 11_000 })
  }
})

it.effect('See and create times in the zone I am asking about (spec/calendar/readClock.md, "Story: See and create times in the zone I am asking about")', effect () => {
  const la = "America/Los_Angeles"
  assert.strictEqual(requestTimeZone({ explicit: "Bogus/Zone", client: "Europe/London", owner: "UTC" }), "Europe/London")
  assert.strictEqual(requestTimeZone({ explicit: "Asia/Tokyo", client: "Europe/London", owner: "UTC" }), "Asia/Tokyo")
  assert.strictEqual(requestTimeZone({ owner: la }), la)
  assert.strictEqual(createTimeZone({ client: "Europe/London", owner: la }), "Europe/London")
  const winter = displayWallTime("2026-01-15T19:00:00.000Z", la)
  const summer = displayWallTime("2026-07-15T19:00:00.000Z", la)
  assert.deepStrictEqual([winter?.hour, winter?.offsetMinutes, summer?.hour, summer?.offsetMinutes], [11, -480, 12, -420])
  assert.strictEqual(createdUtcInstant({ year: 2026, month: 1, day: 15, hour: 11, minute: 0, second: 0 }, la), "2026-01-15T19:00:00.000Z")
  assert.strictEqual(createdUtcInstant({ year: 2026, month: 3, day: 8, hour: 2, minute: 30, second: 0 }, la), "2026-03-08T10:30:00.000Z")
  assert.strictEqual(createdUtcInstant({ year: 2026, month: 11, day: 1, hour: 1, minute: 30, second: 0 }, la), "2026-11-01T08:30:00.000Z")
  assert.strictEqual(buildUtcDateFromLocalParts(la, { year: 2026, month: 11, day: 1, hour: 1, minute: 30, second: 0 }, "reject"), undefined)
  assert.strictEqual(startOfCivilDay({ year: 2026, month: 3, day: 8 }, la), Date.parse("2026-03-08T08:00:00.000Z"))
  assert.strictEqual(startOfCivilDay({ year: 2011, month: 12, day: 30 }, "Pacific/Apia"), Date.parse("2011-12-30T10:00:00.000Z"))
  assert.deepStrictEqual([
    displayDay({ startAt: "2026-01-15T03:00:00.000Z", isAllDay: false }, la),
    displayDay({ startAt: "2026-01-15T00:00:00.000Z", isAllDay: true }, la),
    displayDay({ startAt: "2026-01-15T12:00:00.000Z", isAllDay: false }, "Pacific/Kiritimati"),
  ], ["2026-01-14", "2026-01-15", "2026-01-16"])
  const june = { year: 2026, month: 6, day: 1 }
  assert.deepStrictEqual([createYear("lunch on March 3 2028", june, 2030), createYear("lunch next March 3", june, 2030), createYear("lunch on March 3", june, 2030),
    createYear("March 3 2027 at noon", june, 2030), createYear("lunch next Friday on March 3", june, 2030), createYear("lunch next December 3", june, 2030),
    createYear("dinner next November", { ...june, month: 11 }, 2030), createYear("lunch next year", june, 2030), createYear("lunch next Friday", june, 2027),
    createYear("lunch tomorrow", june, 2027)], [2028, 2027, 2026, 2027, 2026, 2026, 2027, 2027, 2027, 2027])
  assert.deepStrictEqual(["2027년 1월 5일", "내년 1월 5일", "올해 1월 5일", "请安排明年 1月 5日", "2027年 1月 5日", "今年 1月 5日", "12027년 1월 5일", "국내년 1월 5일",
    "내년 January 5, 2028", "2027년 12/25", "내년 12/25", "明年 12-25", "今年 12/25", "국내년 12/25"].map((text) => createYear(text, june, 2030)),
    [2027, 2027, 2026, 2027, 2027, 2026, 2026, 2026, 2028, 2027, 2027, 2027, 2026, 2026])
  const now = new Date("2026-06-01T12:00:00.000Z")
  assert.deepStrictEqual([createNeedsConfirmation("2026-01-01T10:00:00.000Z", now, "UTC"), createNeedsConfirmation("2026-06-02T10:00:00.000Z", now, "UTC"),
    createNeedsConfirmation("2025-12-31T10:00:00.000Z", now, "UTC")], [true, false, true])
})

const phoneCapabilities = ["calendar.local-event.v1", "calendar.create.v1", "calendar.next-read.v1", "calendar.availability-read.v1", "calendar.named-read.v1", "device.named-target.v1"]
const turnStarted = Date.UTC(2026, 10, 22, 15, 0)

function phoneTurn(ownerText: string, observation: DeviceTurn["observation"], actions: readonly string[] = [], completesReads = true): DeviceTurn {
  const negotiated = negotiation(true, phoneCapabilities.join(","))
  return {
    runtime: { actions: actions.map((name) => ({ name })) } as unknown as IAgentRuntime, by: {} as DeviceTurn["by"], negotiation: negotiated,
    capabilities: phoneCapabilities, message: { id: "00000000-0000-4000-8000-000000000001" as UUID, content: { text: ownerText } } as DeviceTurn["message"],
    ownerText, observation, completedActionNavigation: false, completesReads, conversationId: "c1", requestId: "r1", assistantName: "Eliza", swapped: [],
    startedAt: turnStarted, timeZone: observation?.timeZone, signal: new AbortController().signal,
    admit: (operation) => validate(operation, negotiated, "NoBinding"), earlier: () => succeed([]),
  }
}

const unzonedCalendar = { view: "calendar", revision: 1, sensitive: false, selectedObject: selected }
const onCalendar = { ...unzonedCalendar, timeZone: "Europe/Berlin" }
const onHome = { view: "home", revision: 1, sensitive: false, timeZone: "Europe/Berlin" }
const target = { sourceId: "device-home", sourceRevision: "a".repeat(64), eventId: "evt-1", revision: "b".repeat(64) }
const proposedFields = { title: "Lunch with Sam", description: "", location: "", start: "2026-11-23T12:00:00.000Z", end: "2026-11-23T13:00:00.000Z", timeZone: "UTC" }

effect function grounded(operation: unknown, turn: DeviceTurn) {
  const result = try calendarProposalFamily.ground(readOperation(operation) as CheckedOperation, turn)
  return result.kind === "Grounded" ? result.operation : result.code
}

it.effect('Propose on my phone only the Calendar request I made (spec/calendar/reviewedReads.md, "Story: Propose on my phone only the Calendar request I made"; spec/calendar/reviewedReads.md, "A phone Calendar proposal is offered only where its record may be proposed"; spec/calendar/reviewedReads.md, "A selected target, a chosen calendar and a named event are the ones the owner gave"; spec/calendar/reviewedReads.md, "A delete is proposed only when the owner\'s own words ask for it, and a no keeps the event"; spec/calendar/reviewedReads.md, "A new phone event starts at the day and time the owner stated, in the phone\'s zone"; spec/calendar/reviewedReads.md, "A change after a shared read is the edits the owner\'s words gave, keeping every other field"; spec/calendar/availability.md, "An availability window is the day and time the owner asked about, in the phone\'s zone")', effect () => {
  const offered = (turn: DeviceTurn) => calendarProposalFamily.forms.filter((form) => form.offered(turn) && (form.now?.available(turn) ?? true)).map(({ schema }) => JSON.stringify(schema.properties?.action?.enum ?? schema.properties?.type?.enum))
  assert.deepStrictEqual(offered(phoneTurn("delete this", onCalendar)), [
    '["calendar_read_next"]', '["calendar_create_local"]', '["calendar_read_selected"]', '["calendar_delete"]', '["read"]', '["delete"]', '["calendar_availability"]',
  ])
  assert.deepStrictEqual(offered(phoneTurn("add lunch tomorrow at noon", { ...onHome, view: "notes" }, ["CALENDAR"])), ['["calendar_read_next"]'])
  assert.deepStrictEqual(offered(phoneTurn("add lunch to my phone's calendar tomorrow at noon", { ...onHome, view: "notes" }, ["CALENDAR"])), ['["calendar_read_next"]'])
  assert.deepStrictEqual(offered(phoneTurn("add lunch to my phone's calendar tomorrow at noon", onHome, ["CALENDAR"])).includes('["calendar_create_local"]'), true)
  assert.deepStrictEqual(offered(phoneTurn("delete this", { ...onHome, view: "calendar", sensitive: true })), [])
  assert.deepStrictEqual(offered(phoneTurn("delete this", { ...onCalendar, selectedObject: { kind: "canonical-calendar-event", id: "e" } })), [])

  const deleting = { type: "calendar_delete", target }
  assert.deepStrictEqual([try grounded(deleting, phoneTurn("Delete this event", onCalendar)), try grounded(deleting, phoneTurn("Delete my 3pm, I don't need it", onCalendar))], [deleting, deleting])
  assert.deepStrictEqual([try grounded(deleting, phoneTurn("No, keep it", onCalendar)), try grounded(deleting, phoneTurn("Please don't delete it", onCalendar))],
    ["CALENDAR_DELETE_NOT_REQUESTED", "CALENDAR_DELETE_NOT_REQUESTED"])
  assert.strictEqual(try grounded({ ...deleting, target: { ...target, eventId: "evt-2" } }, phoneTurn("Delete this event", onCalendar)), "DEVICE_CALENDAR_TARGET_NOT_SELECTED")
  const lunchDelete = { type: "calendar_named", action: "delete", name: "lunch" } as const
  assert.deepStrictEqual(try grounded(lunchDelete, phoneTurn("Cancel the lunch, we're not meeting", onHome)), lunchDelete)
  assert.strictEqual(try grounded({ type: "calendar_named", action: "delete", name: "plumber" }, phoneTurn("Delete my dentist appointment", onHome)), "CALENDAR_NAMED_NOT_REQUESTED")
  const unspaced = (name: string, words: string) => grounded({ type: "calendar_named", action: "delete", name }, phoneTurn(words, onHome))
  assert.deepStrictEqual([try unspaced("歯医者", "歯医者を削除して"), try unspaced("牙医预约", "删除牙医预约"), try unspaced("치과", "치과를 삭제해줘"),
    try unspaced("Dentist", "Delete the dentistry booking"), try unspaced("歯医者", "小児歯医者を削除して"), try unspaced("牙医预约", "删除儿童牙医预约")], [
    { type: "calendar_named", action: "delete", name: "歯医者" }, { type: "calendar_named", action: "delete", name: "牙医预约" }, { type: "calendar_named", action: "delete", name: "치과" },
    "CALENDAR_NAMED_NOT_REQUESTED", "CALENDAR_NAMED_NOT_REQUESTED", "CALENDAR_NAMED_NOT_REQUESTED",
  ])

  const dentist = { type: "calendar_named", action: "read", name: "dentist appointment" }
  const named = (words: string, observation: DeviceTurn["observation"] = onHome) => grounded(dentist, phoneTurn(words, observation))
  assert.deepStrictEqual([try named("When is my dentist appointment?"), try named("Move my dentist appointment to Friday at 3pm"), try named("Move my dentist appointment to Friday at 3pm, not Thursday"),
    try named("Move my dentist appointment to Friday at 3pm Tokyo time"), try named("Move my dentist appointment to 3pm tomorrow and rename it to Checkup"),
    try named("Move my dentist appointment to 3pm Narnia time"), try named("Move my dentist appointment to 3pm and push it an hour"),
    try named("Change my dentist appointment location to Main Street"), try named("Move my dentist appointment later"), try named("Move my dentist appointment to Friday at 3pm", { ...onHome, timeZone: undefined }),
    try named("Push my dentist appointment back an hour"), try named("Change the location of my dentist appointment"), try named("Move my dentist appointment an hour later or earlier"),
    try grounded(dentist, phoneTurn("Move my dentist appointment to Friday at 3pm", onHome, [], false))],
    ["CALENDAR_NAMED_READ_NOT_A_CHANGE", dentist, dentist, dentist, dentist, "CALENDAR_CHANGE_ZONE_UNKNOWN", "CALENDAR_CHANGE_UNSUPPORTED", dentist, "CALENDAR_CHANGE_TIME_AMBIGUOUS", "CALENDAR_ZONE_UNAVAILABLE",
      dentist, "CALENDAR_CHANGE_UNSUPPORTED", "CALENDAR_CHANGE_UNSUPPORTED", "CALENDAR_CHANGE_READ_UNAVAILABLE"])
  const sharing = { type: "calendar_read_selected", target }
  assert.deepStrictEqual([try grounded(sharing, phoneTurn("What is this meeting about?", onCalendar)), try grounded(sharing, phoneTurn("How do I move this event to tomorrow at 3pm?", onCalendar)),
    try grounded(sharing, phoneTurn("Move this event to my work calendar tomorrow at 3pm", onCalendar)), try grounded(sharing, phoneTurn("Move this meeting to 10am", unzonedCalendar))],
    [sharing, sharing, "CALENDAR_CHANGE_UNSUPPORTED", "CALENDAR_ZONE_UNAVAILABLE"])

  const lunch = phoneTurn("Add lunch with Sam at Cafe Roma tomorrow at noon", onHome)
  const created = try grounded({ type: "calendar_create_local", fields: { ...proposedFields, description: "Discuss the budget", location: "Cafe Roma" } }, lunch)
  assert.deepStrictEqual(created, { type: "calendar_create_local", fields: { ...proposedFields, location: "Cafe Roma", start: "2026-11-23T11:00:00.000Z", end: "2026-11-23T12:00:00.000Z", timeZone: "Europe/Berlin" } })
  assert.notStrictEqual(lunch.admit(created), undefined)
  const create = (words: string, fields = proposedFields) => grounded({ type: "calendar_create_local", fields }, phoneTurn(words, onHome))
  assert.deepStrictEqual([try create("Add lunch with Sam every Monday at noon"), try create("Add lunch with Sam soon"), try create("Add lunch with Sam tomorrow at 3pm Tokyo time"),
    try create("Add lunch tomorrow at noon", { ...proposedFields, title: "Lunch with the board" }), try create("Add lunch with Sam on 2027-03-28 from 1am to 2:30am"),
    try create("Add lunch with Sam at noon"), try create("Add lunch with Sam at 6pm"), try create("Add lunch with Sam 2027年3/5 at 3pm"), try create("Add lunch with Sam 明年 3/5 at 3pm")],
    ["CALENDAR_CREATE_UNSUPPORTED", "CALENDAR_CREATE_ORIGINAL_UNAVAILABLE", "CALENDAR_OTHER_ZONE_NAMED", "CALENDAR_TITLE_NOT_STATED", "CALENDAR_LOCAL_TIME_AMBIGUOUS",
      "CALENDAR_CREATE_PAST_START", { type: "calendar_create_local", fields: { ...proposedFields, start: "2026-11-22T17:00:00.000Z", end: "2026-11-22T18:00:00.000Z", timeZone: "Europe/Berlin" } },
      ...Array.from({ length: 2 }, () => ({ type: "calendar_create_local", fields: { ...proposedFields, start: "2027-03-05T14:00:00.000Z", end: "2027-03-05T15:00:00.000Z", timeZone: "Europe/Berlin" } }))])

  const window = { type: "calendar_availability", start: "2026-11-23T00:00:00.000Z", end: "2026-11-24T00:00:00.000Z", timeZone: "UTC" }
  const free = (words: string, proposed = window) => grounded(proposed, phoneTurn(words, onHome))
  assert.deepStrictEqual([try free("Am I free tomorrow at 3pm?"), try free("Am I free tomorrow?"), try free("Am I free at 3pm?"),
    try free("Am I free this afternoon?", { ...window, start: "2026-11-22T15:00:00.000Z", end: "2026-11-22T17:00:00.000Z" })], [
    { type: "calendar_availability", start: "2026-11-23T14:00:00.000Z", end: "2026-11-23T15:00:00.000Z", timeZone: "Europe/Berlin" },
    { type: "calendar_availability", start: "2026-11-22T23:00:00.000Z", end: "2026-11-23T23:00:00.000Z", timeZone: "Europe/Berlin" },
    { type: "calendar_availability", start: "2026-11-22T14:00:00.000Z", end: "2026-11-22T15:00:00.000Z", timeZone: "Europe/Berlin" },
    { type: "calendar_availability", start: "2026-11-22T15:00:00.000Z", end: "2026-11-22T17:00:00.000Z", timeZone: "Europe/Berlin" },
  ])
  assert.deepStrictEqual([try free("Am I free sometime?"), try free("Am I free tomorrow at 3pm Tokyo time?"), try free("Am I free on 2027-03-28 from 1am to 2:30am?")],
    ["CALENDAR_ORIGINAL_AVAILABILITY_UNAVAILABLE", "CALENDAR_OTHER_ZONE_NAMED", "CALENDAR_LOCAL_TIME_AMBIGUOUS"])
})

it.effect('A change after a shared read is the edits the owner asked for (spec/calendar/reviewedReads.md, "A change after a shared read is the edits the owner\'s words gave, keeping every other field")', effect () => {
  const shared = { ...fields, title: "Standup", start: "2026-11-22T16:00:00.000Z", end: "2026-11-22T16:30:00.000Z", timeZone: "Europe/Berlin" }
  const read = { proposalId: "p1", requestMessageId: "00000000-0000-4000-8000-000000000001" as UUID, operation: { type: "calendar_read_selected", target } as const,
    result: { ...record, fields: shared }, settledAt: turnStarted }
  const after = (words: string, observation: DeviceTurn["observation"] = onCalendar) => calendarProposalFamily.continueAfterRead?.(read, phoneTurn(words, observation)) ?? succeed(undefined)
  const timeReview = "The event is ready for time-change review. Confirm the new time to update it; nothing has changed yet."
  const editReview = "The event is ready for update review. Confirm the requested changes; nothing has changed yet."
  const moved = (start: string, end: string) => ({ operation: { type: "calendar_update" as const, target, fields: { ...shared, start, end } }, text: timeReview })
  const edited = (change: Partial<typeof shared>) => ({ operation: { type: "calendar_update", target, fields: { ...shared, ...change } }, text: editReview })
  assert.deepStrictEqual([try after("Reschedule this meeting for tomorrow at 10am"), try after("Move this meeting to tomorrow at 10am for 2 hours"), try after("Move this meeting to 10am")], [
    moved("2026-11-23T09:00:00.000Z", "2026-11-23T09:30:00.000Z"), moved("2026-11-23T09:00:00.000Z", "2026-11-23T11:00:00.000Z"), moved("2026-11-22T09:00:00.000Z", "2026-11-22T09:30:00.000Z"),
  ])
  assert.deepStrictEqual([try after("Push this meeting back an hour"), try after("Move this meeting two days earlier"), try after("Move it half an hour later"), try after("Move this meeting to Friday"),
    try after("Push it back an hour and a half"), try after("Move it one and a half hours earlier")], [
    moved("2026-11-22T17:00:00.000Z", "2026-11-22T17:30:00.000Z"), moved("2026-11-20T16:00:00.000Z", "2026-11-20T16:30:00.000Z"), moved("2026-11-22T16:30:00.000Z", "2026-11-22T17:00:00.000Z"),
    moved("2026-11-27T16:00:00.000Z", "2026-11-27T16:30:00.000Z"), moved("2026-11-22T17:30:00.000Z", "2026-11-22T18:00:00.000Z"), moved("2026-11-22T14:30:00.000Z", "2026-11-22T15:00:00.000Z"),
  ])
  assert.deepStrictEqual([try after("Rename this to “Team sync”"), try after("Change the location to Room 4"), try after("Please set the notes for this meeting to Bring the slides.")],
    [edited({ title: "Team sync" }), edited({ location: "Room 4" }), edited({ description: "Bring the slides" })])
  assert.deepStrictEqual(try after("Rename this to Standup"), { text: "No requested field change was resolved. Nothing was changed." })
  assert.deepStrictEqual([try after("Rename this to Sync and move it to 3pm"), try after("Move the event to 3pm tomorrow and rename it to Standup"),
    try after("Change the location to Room 4 and move it to 3pm"), try after("Rename it Checkup and push it an hour")], [
    edited({ title: "Sync", start: "2026-11-22T14:00:00.000Z", end: "2026-11-22T14:30:00.000Z" }), edited({ start: "2026-11-23T14:00:00.000Z", end: "2026-11-23T14:30:00.000Z" }),
    edited({ location: "Room 4", start: "2026-11-22T14:00:00.000Z", end: "2026-11-22T14:30:00.000Z" }), edited({ title: "Checkup", start: "2026-11-22T17:00:00.000Z", end: "2026-11-22T17:30:00.000Z" }),
  ])
  assert.deepStrictEqual([try after("Change this meeting to end at 6pm"), try after("Make it end at 6pm"), try after("Move this meeting to 3pm Tokyo time")], [
    moved("2026-11-22T16:00:00.000Z", "2026-11-22T17:00:00.000Z"), moved("2026-11-22T16:00:00.000Z", "2026-11-22T17:00:00.000Z"),
    { operation: { type: "calendar_update", target, fields: { ...shared, start: "2026-11-23T06:00:00.000Z", end: "2026-11-23T06:30:00.000Z", timeZone: "Asia/Tokyo" } }, text: timeReview },
  ])
  assert.deepStrictEqual([try after("Move this meeting to tomorrow at 10am or 11am"), try after("What is this meeting about?"), try after("How do I move this event to tomorrow at 3pm?"),
    try after("Don't rename it to Lunch"), try after("Don't call it Standup anymore, call it Sync"), try after("Move this meeting to 10am", unzonedCalendar),
    try after("Push it back an hour or two"), try after("Move it to 3pm and push it an hour"), try after("Make it end at 5")],
    [undefined, undefined, undefined, undefined, undefined, undefined, undefined, undefined, undefined])
  const byName = { ...read, operation: { type: "calendar_named", action: "read", name: "standup" } as const,
    result: { version: 1, kind: "calendar_named", action: "read", name: "standup", basis: "owner-chosen", operation: { type: "calendar_read_selected", target }, record: { ...record, fields: shared } } }
  assert.deepStrictEqual(try (calendarProposalFamily.continueAfterRead?.(byName, phoneTurn("Move standup to Friday at 3pm, not Thursday", onHome)) ?? succeed(undefined)),
    moved("2026-11-27T14:00:00.000Z", "2026-11-27T14:30:00.000Z"))
  const unmatched = { ...byName, result: { version: 1, kind: "calendar_named", action: "read", name: "standup", basis: "no-match" } }
  assert.deepStrictEqual(try (calendarProposalFamily.continueAfterRead?.(unmatched, phoneTurn("Move standup to Friday at 3pm", onHome)) ?? succeed(undefined)),
    { text: "No event matched this reviewed lookup. Nothing was changed." })
})
