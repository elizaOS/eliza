// spec/calendar/actions.md, "Story: Change my calendar only as I asked and know it happened"; spec/calendar/actions.md, "A resident delete runs at once only for the one event the owner named, and otherwise asks in chat"; spec/calendar/actions.md, "Attendees hear of a change only when the owner asked and the calendar can tell them"; spec/calendar/readClock.md, "A request's zone is the stated zone, else the client's zone, else the owner's"; spec/calendar/seriesScope.md, "A write names its scope: this event, this and following, or all"; spec/calendar/residentStore.md, "Story: Keep the calendar events I saved before this version"
import { assert, it } from "@effect/vitest"
import { activityLabel } from "@elizaos/agent-host"
import { attestAuthenticatedApiDeliveryAudience, canActionRun, ContextRegistry, disclosureGateFailure, resolveActionContexts, type IAgentRuntime, type Memory, type UUID } from "@elizaos/core"
import {
  calendarAction, calendarAsk, calendarHost, calendarPlugin, calendarProvider, calendarRoutes, CalendarService, calendarServiceType, CalendarWriteNotAccepted, runCalendarAction,
  type CalendarAccount, type CalendarApprovalRow, type CalendarCache, type CalendarEvent, type CalendarProviderPort, type CalendarRouteInput,
} from "../src/index.vibe"

function memoryCache(rows = new Map<string, unknown>(), refused = new Set<string>()): CalendarCache {
  return {
    async getCache<T>(key: string) { return rows.get(key) as T | undefined },
    async setCache<T>(key: string, value: T) {
      if (refused.has(key)) return false
      rows.set(key, value)
      return true
    },
    async deleteCache(key: string) { return rows.delete(key) },
  }
}

function at(value: unknown, ...path: string[]): unknown {
  return path.reduce<unknown>((inner, key) => typeof inner === "object" && inner !== null && key in inner ? (inner as Record<string, unknown>)[key] : undefined, value)
}

const owner: CalendarAccount = { agentId: "agent", ownerId: "owner", accountId: "owner@example.com" }
const stranger: CalendarAccount = { agentId: "agent", ownerId: "owner", accountId: "other@example.com" }
const work = { provider: "google", side: "owner", grantId: "grant", connectorAccountId: owner.accountId, calendarId: "work" } as const

const guests = (addresses: readonly string[]) => addresses.map((email) => ({ email, displayName: null, responseStatus: "needsAction", self: false, organizer: false, optional: false }))

function googleCalendar(answers = true) {
  const events = new Map<string, CalendarEvent>()
  const scopes: string[] = []
  const notified: boolean[] = []
  const health = { complete: true, widestDays: Number.POSITIVE_INFINITY }
  let made = 0
  const mine = (account: CalendarAccount) => account.accountId === owner.accountId
  const refuse = (code: string) => new CalendarWriteNotAccepted({ failure: { code, message: code, retryable: false } })
  const respond: NonNullable<CalendarProviderPort["respond"]> = effect (_account, _source, eventId, _scope, response, expected, _key, notify) => {
    notified.push(notify)
    const found = events.get(eventId)
    if (found === undefined || found.metadata.etag !== expected) throw refuse("precondition_failed")
    const changed = { ...found, attendees: found.attendees.map((attendee) => attendee.self ? { ...attendee, responseStatus: response } : attendee), metadata: { ...found.metadata, etag: `${expected}+` } }
    events.set(eventId, changed)
    return changed
  }
  const port: CalendarProviderPort = {
    ...(answers ? { respond } : {}),
    provider: "google",
    recurrenceLines: false,
    notifies: true,
    effect sources(account) {
      return mine(account) ? [{ ...work, accountEmail: owner.accountId, summary: "Work", description: null, primary: false, accessRole: "owner", timeZone: "UTC", selected: true, includeInFeed: true }] : []
    },
    effect read(account, _source, timeMin, timeMax) {
      const fits = timeMax - timeMin <= health.widestDays * 86_400_000
      return { events: mine(account) && fits ? [...events.values()].filter((event) => Date.parse(event.startAt) < timeMax && Date.parse(event.endAt) > timeMin) : [], complete: health.complete && fits }
    },
    effect get(account, _source, eventId) { return mine(account) ? events.get(eventId) : undefined },
    effect create(_account, _source, fields, _recurrence, key) {
      const existing = [...events.values()].find((event) => event.metadata.key === key)
      if (existing !== undefined) return existing
      made += 1
      const event: CalendarEvent = {
        id: `g-${made}`, externalId: `g-${made}`, agentId: "agent", provider: "google", side: "owner", calendarId: "work",
        title: fields.title, description: fields.description, location: fields.location, status: "confirmed",
        startAt: fields.startAt, endAt: fields.endAt, isAllDay: fields.isAllDay, timezone: fields.timeZone, htmlLink: null, conferenceLink: null,
        organizer: { self: true, email: owner.accountId }, attendees: guests(fields.attendees ?? []), metadata: { etag: `etag-${made}`, key }, syncedAt: "2030-01-01T00:00:00.000Z", updatedAt: "2030-01-01T00:00:00.000Z",
        connectorAccountId: owner.accountId, grantId: "grant",
      }
      events.set(event.id, event)
      return event
    },
    effect update(_account, _source, eventId, scope, fields, expected, _key, notify) {
      scopes.push(scope)
      notified.push(notify)
      const found = events.get(eventId)
      if (found === undefined || found.metadata.etag !== expected) throw refuse("precondition_failed")
      const { attendees, ...rest } = fields
      const changed = { ...found, ...rest, attendees: attendees === undefined ? found.attendees : guests(attendees), metadata: { ...found.metadata, etag: `${expected}+` } }
      events.set(eventId, changed)
      return changed
    },
    effect remove(_account, _source, eventId, scope, expected, _key, notify) {
      scopes.push(scope)
      notified.push(notify)
      if (events.get(eventId)?.metadata.etag !== expected) throw refuse("precondition_failed")
      events.delete(eventId)
    },
  }
  return { port, events, scopes, notified, health }
}

const march = { timeMin: "2030-03-01T00:00:00Z", timeMax: "2030-03-10T00:00:00Z" }

const ownerEntity = "00000000-0000-4000-8000-000000000001" as UUID
const agentEntity = "00000000-0000-4000-8000-000000000002" as UUID
const guestEntity = "00000000-0000-4000-8000-000000000003" as UUID

effect function ownerTurn(participants: readonly UUID[]) {
  const runtime = { agentId: agentEntity, getSetting: (key: string) => key === "ELIZA_ADMIN_ENTITY_ID" ? ownerEntity : undefined,
    getParticipantsForRoom: async () => [...participants], getEntityById: async () => null } as unknown as IAgentRuntime
  const message: Memory = { id: "00000000-0000-4000-8000-000000000005" as UUID, entityId: ownerEntity, agentId: agentEntity, roomId: "00000000-0000-4000-8000-000000000004" as UUID, content: { text: "What's on my calendar?" } }
  try tryPromise(() => attestAuthenticatedApiDeliveryAudience(runtime, message, { kind: "owner_session", principalId: "owner" }))
  return message
}

it.effect(`Change my calendar only as I asked and know it happened (spec/calendar/actions.md, "Story: Change my calendar only as I asked and know it happened"; spec/calendar/actions.md, "A calendar the active account does not list never narrows a read"; spec/calendar/actions.md, "A create is reported only after it reads back from the same calendar"; spec/calendar/actions.md, "A change's result names its target as read before the change and the version it produced"; spec/calendar/actions.md, "A write goes to the active account's writable calendar, at once only for the resident calendar"; spec/calendar/readClock.md, "A stated year wins, a wrong extracted year is corrected, and a past start asks first"; spec/calendar/readClock.md, "A request's zone is the stated zone, else the client's zone, else the owner's"; spec/calendar/seriesScope.md, "A write names its scope: this event, this and following, or all"; spec/calendar/seriesScope.md, "A chat change to a repeating event asks which occurrences unless the request says")`, effect () => {
  const filed: CalendarApprovalRow[] = []
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => ({ request: async (row) => { filed.push(row); return { id: row.id, state: "pending" } } }) })
  const ask = { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "", ownerZone: "UTC" }
  const dentist = { subaction: "create_event", title: "Dentist", location: "Main St", startAt: "2030-03-04T09:00:00-08:00", endAt: "2030-03-04T10:00:00-08:00", timeZone: "America/Los_Angeles", reviewBeforeCreate: false, statedClock: "none" }

  const created = try runCalendarAction(host, ask, dentist)
  const id = at(created.data, "event", "id")
  const etag = at(created.data, "event", "metadata", "etag")
  assert.deepStrictEqual([created.success, at(created.data, "event", "title"), at(created.data, "event", "startAt")], [true, "Dentist", "2030-03-04T17:00:00.000Z"])
  assert.deepStrictEqual([at(created.effectReceipts?.[0], "operation"), at(created.effectReceipts?.[0], "resource", "id"), at(created.effectReceipts?.[0], "resource", "version")], ["calendar.event.create", id, etag])
  const replayed = try runCalendarAction(host, ask, dentist)
  assert.deepStrictEqual([at(replayed.data, "event", "id"), at(replayed.effectReceipts?.[0], "idempotency", "replayed")], [id, true])
  const found = try runCalendarAction(host, ask, { subaction: "search_events", query: "DENTIST", ...march })
  assert.deepStrictEqual([at(found.data, "events", "length"), at(found.data, "complete"), at(found.data, "accountId")], [1, true, "resident:agent"])
  const masked = try runCalendarAction(host, ask, { subaction: "search_events", query: "dentist", calendarId: "[REDACTED]", ...march })
  assert.deepStrictEqual([at(masked.data, "events", "length"), at(masked.data, "complete")], [1, true])

  const updated = try runCalendarAction(host, { ...ask, id: "message-2" }, { subaction: "update_event", eventId: id, title: "Dentist moved" })
  const changedEtag = at(updated.data, "event", "metadata", "etag")
  assert.deepStrictEqual([at(updated.data, "subaction"), at(updated.data, "targetEvent", "id"), at(updated.data, "targetEvent", "metadata", "etag"), at(updated.data, "event", "id"), at(updated.data, "event", "title"), at(updated.data, "event", "location")],
    ["update_event", id, etag, id, "Dentist moved", "Main St"])
  assert.notStrictEqual(changedEtag, etag)
  assert.deepStrictEqual([at(updated.effectReceipts?.[0], "operation"), at(updated.effectReceipts?.[0], "outcome"), at(updated.effectReceipts?.[0], "resource", "version")], ["calendar.event.update", "applied", changedEtag])

  const stillThere = effect (query: string) => at((try runCalendarAction(host, ask, { subaction: "search_events", query, ...march })).data, "events", "length")
  const unnamed = try runCalendarAction(host, { ...ask, id: "message-3a", text: "Delete the dentist one" }, { subaction: "delete_event", query: "moved", ...march })
  const unanswered = try runCalendarAction(host, { ...ask, id: "message-3a0", text: "No, keep it" }, { subaction: "delete_event", eventId: id })
  const kept = try runCalendarAction(host, { ...ask, id: "message-3a1", text: "No, keep it" }, { subaction: "delete_event", eventId: id, ownerAnswer: "no" })
  const spent = try runCalendarAction(host, { ...ask, id: "message-3a2", text: "yes" }, { subaction: "delete_event", eventId: id, ownerAnswer: "yes" })
  assert.deepStrictEqual([unnamed.success, at(unnamed.data, "requiresInput"), at(unnamed.data, "eventId"), at(unanswered.data, "requiresInput"), kept.success, at(kept.data, "declined"), at(spent.data, "requiresInput"), filed.length, try stillThere("moved")],
    [false, true, id, true, false, true, true, 0, 1])
  const declinedAtOnce = try runCalendarAction(host, { ...ask, id: "message-3a4", text: "Don't delete Dentist moved" }, { subaction: "delete_event", query: "moved", ...march, ownerAnswer: "no" })
  const keptAtOnce = try runCalendarAction(host, { ...ask, id: "message-3a5", text: "Keep Dentist moved, I still need it" }, { subaction: "delete_event", query: "moved", ...march, ownerAnswer: "no" })
  assert.deepStrictEqual([declinedAtOnce.success, at(declinedAtOnce.data, "declined"), keptAtOnce.success, at(keptAtOnce.data, "declined"), filed.length, try stillThere("moved")],
    [false, true, false, true, 0, 1])
  const unread = try runCalendarAction(host, { ...ask, id: "message-3a6", text: "Delete Dentist moved" }, { subaction: "delete_event", query: "moved", ...march })
  assert.deepStrictEqual([unread.success, at(unread.data, "requiresInput"), at(unread.data, "eventId"), filed.length, try stillThere("moved")], [false, true, id, 0, 1])
  const deleted = try runCalendarAction(host, { ...ask, id: "message-3", text: "Delete Dentist moved" }, { subaction: "delete_event", query: "moved", ...march, ownerAnswer: "yes" })
  assert.deepStrictEqual([at(deleted.data, "deleted"), at(deleted.data, "targetEvent", "id"), at(deleted.data, "targetEvent", "metadata", "etag"), filed.length], [true, id, changedEtag, 0])
  assert.deepStrictEqual([at(deleted.effectReceipts?.[0], "operation"), at(deleted.effectReceipts?.[0], "resource", "kind"), at(deleted.effectReceipts?.[0], "resource", "version")], ["calendar.event.delete", "calendar.event", `deleted:${changedEtag}`])
  assert.strictEqual(at((try runCalendarAction(host, ask, { subaction: "search_events", ...march })).data, "events", "length"), 0)
  try runCalendarAction(host, { ...ask, id: "message-3b" }, { ...dentist, title: "歯医者" })
  const unspaced = try runCalendarAction(host, { ...ask, id: "message-3c", text: "歯医者を削除して" }, { subaction: "delete_event", query: "歯医者", ...march, ownerAnswer: "yes" })
  assert.deepStrictEqual([at(unspaced.data, "deleted"), filed.length], [true, 0])
  try runCalendarAction(host, { ...ask, id: "message-3e" }, { ...dentist, title: "Vet" })
  const vague = try runCalendarAction(host, { ...ask, id: "message-3f", text: "Cancel the animal appointment" }, { subaction: "delete_event", query: "vet", ...march })
  const yes = try runCalendarAction(host, { ...ask, id: "message-3g", text: "Yes, delete it" }, { subaction: "delete_event", eventId: String(at(vague.data, "eventId")), ownerAnswer: "yes" })
  assert.deepStrictEqual([at(vague.data, "requiresInput"), at(yes.data, "deleted"), filed.length, try stillThere("vet")], [true, true, 0, 0])
  const past = try runCalendarAction(host, { ...ask, id: "message-4" }, { ...dentist, startAt: "1969-12-31T09:00:00Z", endAt: "1969-12-31T10:00:00Z" })
  assert.deepStrictEqual([past.success, at(past.data, "needsConfirmation")], [false, "past_start"])
  const pointDay = try runCalendarAction(host, { ...ask, id: "message-4b" }, { ...dentist, isAllDay: true, startAt: "2030-03-04T00:00:00Z", endAt: "2030-03-04T00:00:00Z" })
  assert.deepStrictEqual([pointDay.success, pointDay.text, at((try runCalendarAction(host, ask, { subaction: "search_events", ...march })).data, "events", "length")],
    [false, "A new event needs a title and a start before its end.", 0])
  const fromPhone = (id: string, text: string) => calendarAsk({ id, entityId: "owner-entity", roomId: "room",
    content: { text, metadata: { observation: { view: "calendar", revision: 1, sensitive: false, timeZone: "America/Los_Angeles" } } } } as unknown as Memory, "UTC")
  const phoneLunch = { subaction: "create_event", title: "Lunch", startAt: "2030-03-06T12:00:00-08:00", endAt: "2030-03-06T13:00:00-08:00", timeZone: "Asia/Tokyo", reviewBeforeCreate: false, statedClock: "start" }
  const stated = try runCalendarAction(host, fromPhone("message-7", "Lunch with Sam on March 6 2031 at noon"), phoneLunch)
  const undated = try runCalendarAction(host, fromPhone("message-8", "Lunch with Sam next Wednesday at noon"), phoneLunch)
  assert.deepStrictEqual([stated.text?.replace(/\s/gu, " "), at(stated.data, "event", "endAt"), at(stated.data, "event", "timezone"), at(undated.data, "event", "startAt")],
    ["Created Lunch, Mar 6, 2031, 12:00 PM.", "2031-03-06T21:00:00.000Z", "America/Los_Angeles", "2030-03-06T20:00:00.000Z"])
  const gap = try runCalendarAction(host, fromPhone("breakfast-dst-gap", "Breakfast on March 9 2031 at 2:30 AM"), {
    ...phoneLunch, title: "Breakfast", startAt: "2030-03-09T02:30:00-08:00", endAt: "2030-03-09T03:30:00-08:00",
  })
  const breakfast = try runCalendarAction(host, ask, {
    subaction: "search_events", query: "Breakfast", timeMin: "2031-03-09T00:00:00Z", timeMax: "2031-03-10T00:00:00Z",
  })
  assert.deepStrictEqual([gap.success, gap.effectReceipts?.length ?? 0, at(breakfast.data, "events", "length")], [false, 0, 0])
  try TestClock.setTime(Date.parse("2026-06-01T12:00:00Z"))
  const lunch = { ...dentist, title: "Lunch", startAt: "2031-03-04T12:00:00-08:00", endAt: "2031-03-04T13:30:00-08:00" }
  const said = effect (id: string, text: string) => {
    const result = try runCalendarAction(host, { ...ask, id, text }, lunch)
    const span = at(result.data, "fields") ?? at(result.data, "event")
    return [result.success, at(result.data, "needsConfirmation") ?? null, at(span, "startAt"), at(span, "endAt")]
  }
  assert.deepStrictEqual(try said("lunch-1", "Add lunch on March 4"), [false, "past_start", "2026-03-04T20:00:00.000Z", "2026-03-04T21:30:00.000Z"])
  assert.deepStrictEqual(try said("lunch-2", "Add lunch next Friday on March 4"), [false, "past_start", "2026-03-04T20:00:00.000Z", "2026-03-04T21:30:00.000Z"])
  assert.deepStrictEqual(try said("lunch-3", "Add lunch next March 4"), [true, null, "2027-03-04T20:00:00.000Z", "2027-03-04T21:30:00.000Z"])
  assert.deepStrictEqual(try said("lunch-4", "Add lunch tomorrow at noon"), [true, null, "2031-03-04T20:00:00.000Z", "2031-03-04T21:30:00.000Z"])
  const leapDay = { ...dentist, title: "Leap appointment", startAt: "2028-02-29T12:00:00Z", endAt: "2028-02-29T13:00:00Z", timeZone: "UTC" }
  const missingLeapDay = try runCalendarAction(host, { ...ask, id: "leap-1", text: "Add Leap appointment on February 29, 2027" }, leapDay)
  const validLeapDay = try runCalendarAction(host, { ...ask, id: "leap-2", text: "Add Leap appointment on February 29, 2028" }, leapDay)
  const leapAppointments = try runCalendarAction(host, ask, { subaction: "search_events", query: leapDay.title, timeMin: "2027-02-28T00:00:00Z", timeMax: "2028-03-02T00:00:00Z" })
  assert.deepStrictEqual([missingLeapDay.success, missingLeapDay.effectReceipts?.length ?? 0, validLeapDay.success, at(validLeapDay.data, "event", "startAt"), at(leapAppointments.data, "events", "length")],
    [false, 0, true, "2028-02-29T12:00:00.000Z", 1])
  const checkups = effect () => at((try runCalendarAction(host, ask, { subaction: "search_events", query: "Checkup", ...march })).data, "events", "length")
  const preview = try runCalendarAction(host, { ...ask, id: "message-review" }, { ...dentist, title: "Checkup", reviewBeforeSaving: true })
  assert.deepStrictEqual([preview.success, at(preview.data, "approvalRequestId"), at(preview.data, "change", "source", "provider"), try checkups()], [true, filed[0]?.id, "eliza", 0])
  const held = filed.splice(0)[0]
  if (held === undefined) return
  assert.strictEqual((try host.executeApproval({ id: held.id, action: held.action, payload: held.payload })).result, "ChangeSucceeded")
  assert.strictEqual(try checkups(), 1)

  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  const standup = { subaction: "create_event", calendarId: "work", title: "Standup", startAt: "2030-03-05T16:00:00Z", endAt: "2030-03-05T16:15:00Z", timeZone: "UTC", statedClock: "none" }
  const queued = try runCalendarAction(host, { ...ask, id: "message-5" }, standup)
  assert.deepStrictEqual([queued.success, at(queued.data, "approvalRequestId"), google.events.size], [true, filed[0]?.id, 0])
  const reviewed = filed[0]
  assert.deepStrictEqual(reviewed?.payload.change, { action: "schedule_event", account: owner.accountId, source: work,
    fields: { title: "Standup", description: "", location: "", startAt: "2030-03-05T16:00:00.000Z", endAt: "2030-03-05T16:15:00.000Z", isAllDay: false, timeZone: "UTC" }, recurrence: null })
  if (reviewed === undefined) return
  const record = { id: reviewed.id, action: reviewed.action, payload: reviewed.payload }
  assert.strictEqual((try host.executeApproval(record)).result, "ChangeSucceeded")
  assert.strictEqual((try host.executeApproval(record)).result, "ChangeSucceeded")
  assert.deepStrictEqual([...google.events.values()].map((event) => [event.title, event.startAt, event.endAt]), [["Standup", "2030-03-05T16:00:00.000Z", "2030-03-05T16:15:00.000Z"]])
  const allHands = { title: "All hands", description: "", location: "", startAt: "2030-03-05T16:00:00.000Z", endAt: "2030-03-05T16:15:00.000Z", isAllDay: false, timeZone: "UTC" }
  const tampered = try host.executeApproval({ ...record, id: "approval-tampered", payload: { ...reviewed.payload, change: { ...reviewed.payload.change, fields: allHands } } })
  assert.deepStrictEqual([tampered.result, tampered.failure?.code], ["ChangeInvalidated", "CALENDAR_REVIEW_UNBOUND"])

  const series = try runCalendarAction(host, { ...ask, id: "message-6" }, { subaction: "update_event", calendarId: "work", query: "standup", ...march, title: "Standup, all", recurrenceScope: "series" })
  const seriesReview = filed.at(-1)
  assert.deepStrictEqual([series.success, at(seriesReview?.payload.change, "scope"), at(seriesReview?.payload.change, "fields", "title")], [true, "series", "Standup, all"])
  // spec/calendar/actions.md, "A write goes to the active account's writable calendar, at once only for the resident calendar"
  assert.deepStrictEqual([seriesReview?.payload.targetStartAt, "targetStartAt" in (reviewed?.payload ?? {}), /^calendar-[0-9a-f]{40}$/.test(seriesReview?.id ?? "")],
    ["2030-03-05T16:00:00.000Z", false, true])
  if (seriesReview === undefined) return
  const rescoped = try host.executeApproval({ id: "approval-rescoped", action: seriesReview.action, payload: { ...seriesReview.payload, change: { ...seriesReview.payload.change, scope: "instance" } } })
  assert.deepStrictEqual([rescoped.result, rescoped.failure?.code, google.scopes], ["ChangeInvalidated", "CALENDAR_REVIEW_UNBOUND", []])
  assert.strictEqual((try host.executeApproval({ id: seriesReview.id, action: seriesReview.action, payload: seriesReview.payload })).result, "ChangeSucceeded")
  assert.deepStrictEqual([google.scopes, [...google.events.values()].map((event) => event.title)], [["series"], ["Standup, all"]])
  const repeating = google.events.get("g-1")
  if (repeating === undefined) return
  google.events.set(repeating.id, { ...repeating, recurringEventId: "g-series" })
  const worded = effect (id: string, text: string, scope?: string) => {
    const result = try runCalendarAction(host, { ...ask, id, text }, { subaction: "update_event", calendarId: "work", eventId: repeating.id, title: "Standup, renamed", ...(scope === undefined ? {} : { recurrenceScope: scope }) })
    return [result.success, at(result.data, "missing") ?? at(filed.at(-1)?.payload.change, "scope")]
  }
  assert.deepStrictEqual([try worded("message-6a", "Rename this and all following to Standup, renamed", "this_and_following"), try worded("message-6b", "Rename the whole series to Standup, renamed", "series"),
    try worded("message-6c", "Rename the whole series to Standup, renamed")], [[true, "this_and_following"], [true, "series"], [false, ["recurrenceScope"]]])
})

it.effect(`Ask the agent about my calendar and get my active account's events, showing Calendar while it reads (spec/calendar/actions.md, "Story: Ask the agent about my calendar and get my active account's events"; spec/agent/conversation/planning.md, "A tool's progress names its app only when one labelled app applies, and never its arguments or results"; spec/calendar/actions.md, "The calendar reaches the agent only in a turn whose audience is the owner alone"; spec/calendar/actions.md, "An event is shown only from a listed calendar of the active account"; spec/calendar/actions.md, "An approved change runs only with its reviewed fields for the account that approved it")`, effect () => {
  const filed: CalendarApprovalRow[] = []
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => ({ request: async (row) => { filed.push(row); return { id: row.id, state: "pending" } } }) })
  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  const ask = { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "" }
  const disclosed = (message: Memory) => [canActionRun(calendarAction, { message, userRoles: ["OWNER"] }), disclosureGateFailure(calendarProvider.disclosureGate, message) === undefined]
  assert.deepStrictEqual([disclosed(try ownerTurn([ownerEntity, agentEntity])), disclosed(try ownerTurn([ownerEntity, agentEntity, guestEntity]))], [[true, true], [false, false]])
  const registered = { ...calendarAction, contexts: try Effect.try(() => resolveActionContexts(calendarAction)) }
  const ownerOnly = try ownerTurn([ownerEntity, agentEntity])
  const runsOnTurn = try Effect.try(() => canActionRun(registered, { message: ownerOnly, userRoles: ["OWNER"], activeContexts: ["general"] }))
  const sharedTurn = try ownerTurn([ownerEntity, agentEntity, guestEntity])
  const refusedOnTurn = try Effect.try(() => [
    canActionRun(registered, { message: sharedTurn, userRoles: ["OWNER"], activeContexts: ["general"] }),
    canActionRun(registered, { message: ownerOnly, userRoles: ["USER"], activeContexts: ["general"] }),
  ])
  assert.deepStrictEqual([calendarAction.contexts, registered.contexts, runsOnTurn, refusedOnTurn], [undefined, ["calendar", "automation", "general"], true, [false, false]])
  const lunch = try runCalendarAction(host, ask, { subaction: "create_event", title: "Private lunch", startAt: "2030-03-04T12:00:00Z", endAt: "2030-03-04T13:00:00Z", reviewBeforeCreate: false, statedClock: "none" })
  assert.deepStrictEqual([lunch.success, at(lunch.effectReceipts?.[0], "operation"), filed.length], [true, "calendar.event.create", 0])
  try runCalendarAction(host, { ...ask, id: "message-2" }, { subaction: "create_event", calendarId: "work", title: "Board review", startAt: "2030-03-05T12:00:00Z", endAt: "2030-03-05T13:00:00Z", statedClock: "none" })
  const board = filed.at(-1)
  if (board === undefined) return
  assert.strictEqual((try host.executeApproval({ id: board.id, action: board.action, payload: board.payload })).result, "ChangeSucceeded")
  const mine = try runCalendarAction(host, ask, { subaction: "search_events", ...march })
  assert.deepStrictEqual((at(mine.data, "events") as CalendarEvent[]).map((event) => event.title), ["Private lunch", "Board review"])

  try runCalendarAction(host, { ...ask, id: "message-3" }, { subaction: "delete_event", calendarId: "work", query: "board", ...march })
  const removal = filed.at(-1)
  if (removal === undefined) return
  try host.bindAccount(stranger)
  const theirs = try runCalendarAction(host, ask, { subaction: "search_events", ...march })
  assert.deepStrictEqual([at(theirs.data, "events", "length"), at(theirs.data, "accountId")], [0, stranger.accountId])
  assert.strictEqual(at(removal.payload.change, "scope"), "instance")
  const invalidated = try host.executeApproval({ id: removal.id, action: removal.action, payload: removal.payload })
  assert.deepStrictEqual([invalidated.result, invalidated.failure?.code, google.events.size], ["ChangeInvalidated", "CALENDAR_REVIEW_UNBOUND", 1])
  const runtime = { contexts: try Effect.try(() => new ContextRegistry()) } as unknown as IAgentRuntime
  try promise(() => Promise.resolve(calendarPlugin().init?.({}, runtime)))
  assert.strictEqual(activityLabel(runtime, calendarAction), "Using Calendar")
})

it.effect(`Find my events by their words, and what is on while I am away (spec/calendar/actions.md, "Story: Ask the agent about my calendar and get my active account's events"; spec/calendar/actions.md, "A lookup finds the events that hold the most asked words, preferring their titles"; spec/calendar/actions.md, "A trip question shows everything from the first event at the place to the end of the last")`, effect () => {
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => ({ request: async (row) => ({ id: row.id, state: "pending" }) }) })
  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  const sam = { email: "sam@example.com", displayName: "Sam Park", responseStatus: "accepted", self: false, organizer: false, optional: false }
  const row = (id: string, title: string, startAt: string, endAt: string, extra: Partial<CalendarEvent> = {}): CalendarEvent => ({
    id, externalId: id, agentId: "agent", provider: "google", side: "owner", calendarId: "work", title, description: "", location: "", status: "confirmed",
    startAt, endAt, isAllDay: false, timezone: "UTC", htmlLink: null, conferenceLink: null, organizer: { self: true }, attendees: [], metadata: { etag: id },
    syncedAt: "2030-01-01T00:00:00.000Z", updatedAt: "2030-01-01T00:00:00.000Z", connectorAccountId: owner.accountId, grantId: "grant", ...extra,
  })
  for (const event of [
    row("dentist", "Dentist appointment", "2030-03-02T17:00:00.000Z", "2030-03-02T18:00:00.000Z"),
    row("checkup", "Checkup", "2030-03-03T17:00:00.000Z", "2030-03-03T18:00:00.000Z", { description: "Right after the dentist" }),
    row("planning", "Planning meeting", "2030-03-04T17:00:00.000Z", "2030-03-04T18:00:00.000Z", { attendees: [sam] }),
    row("team", "Team meeting", "2030-03-04T19:00:00.000Z", "2030-03-04T20:00:00.000Z"),
    row("lunch", "Lunch", "2030-03-05T19:00:00.000Z", "2030-03-05T20:00:00.000Z", { location: "Ferry Building, San Francisco" }),
    row("flight", "Flight to Denver", "2030-03-06T15:00:00.000Z", "2030-03-06T17:00:00.000Z"),
    row("dinner", "Dinner with Ana", "2030-03-07T01:00:00.000Z", "2030-03-07T02:00:00.000Z"),
    row("hotel", "Hotel", "2030-03-06T18:00:00.000Z", "2030-03-08T16:00:00.000Z", { location: "Denver, CO" }),
    row("home", "Back at the office", "2030-03-09T17:00:00.000Z", "2030-03-09T18:00:00.000Z"),
  ]) google.events.set(event.id, event)
  const ask = { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "" }
  const titles = effect (subaction: string, query: string) => (at((try runCalendarAction(host, ask, { subaction, query, ...march })).data, "events") as CalendarEvent[]).map((event) => event.title)
  assert.deepStrictEqual([try titles("search_events", "dentist appointments"), try titles("search_events", "dentist"), try titles("search_events", "my meeting with Sam"),
    try titles("search_events", "the Ferry Building"), try titles("search_events", "sam@example.com"), try titles("search_events", "plumber")], [
    ["Dentist appointment"], ["Dentist appointment"], ["Planning meeting"], ["Lunch"], ["Planning meeting"], [],
  ])
  assert.deepStrictEqual(try titles("trip_window", "Denver"), ["Flight to Denver", "Hotel", "Dinner with Ana"])
  const nowhere = try runCalendarAction(host, ask, { subaction: "trip_window", query: "Lisbon", ...march })
  assert.deepStrictEqual([nowhere.success, nowhere.text, at(nowhere.data, "location")], [true, "I couldn't find a trip to Lisbon in your calendar in that range.", "Lisbon"])
  const moved = try runCalendarAction(host, { ...ask, id: "message-2" }, { subaction: "update_event", query: "dentist appointments", ...march, title: "Dentist" })
  assert.deepStrictEqual([moved.success, at(moved.data, "change", "target", "eventId")], [true, "dentist"])
})

it.effect(`Ask when I am free and get openings from my real calendar (spec/calendar/actions.md, "Story: Ask when I am free and get openings from my real calendar"; spec/calendar/actions.md, "A free-time question reads exactly the asked window and answers only from a complete read"; spec/calendar/actions.md, "A morning-only question reads only that morning, from midnight to noon"; spec/calendar/actions.md, "A period is free only when no blocking event overlaps it"; spec/calendar/actions.md, "Openings are at most two quarter-hour starts of the asked length inside the window"; spec/calendar/actions.md, "A free-time question refuses only as before the window notes, and a note never changes the window read")`, effect () => {
  try TestClock.setTime(Date.parse("2030-03-03T20:00:00Z"))
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => undefined })
  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  const me = { email: owner.accountId, displayName: null, self: true, organizer: false, optional: false }
  const row = (id: string, startAt: string, endAt: string, extra: Partial<CalendarEvent> = {}): CalendarEvent => ({
    id, externalId: id, agentId: "agent", provider: "google", side: "owner", calendarId: "work", title: id, description: "", location: "", status: "confirmed",
    startAt, endAt, isAllDay: false, timezone: "UTC", htmlLink: null, conferenceLink: null, organizer: null, attendees: [], metadata: { etag: id },
    syncedAt: "2030-01-01T00:00:00.000Z", updatedAt: "2030-01-01T00:00:00.000Z", connectorAccountId: owner.accountId, grantId: "grant", ...extra,
  })
  for (const event of [
    row("standup", "2030-03-04T17:00:00.000Z", "2030-03-04T17:30:00.000Z"),
    row("review", "2030-03-04T17:45:00.000Z", "2030-03-04T18:40:00.000Z"),
    row("declined", "2030-03-04T18:40:00.000Z", "2030-03-04T19:30:00.000Z", { attendees: [{ ...me, responseStatus: "declined" }] }),
    row("focus", "2030-03-04T19:00:00.000Z", "2030-03-04T20:00:00.000Z", { metadata: { etag: "focus", transparency: "transparent" } }),
    row("cancelled", "2030-03-04T19:00:00.000Z", "2030-03-04T19:30:00.000Z", { status: "cancelled" }),
    row("offsite", "2030-03-06T00:00:00.000Z", "2030-03-07T00:00:00.000Z", { isAllDay: true }),
  ]) google.events.set(event.id, event)
  const zone = "America/Los_Angeles"
  const asked = (text: string, parameters: Record<string, unknown>) => runCalendarAction(host, { by: "owner-entity", conversation: "room:owner", id: text, text }, { timeZone: zone, ...parameters })
  const morning = { subaction: "propose_times", timeMin: "2030-03-04T09:00:00-08:00", timeMax: "2030-03-04T12:00:00-08:00", durationMinutes: 20, morningOnly: true }

  const twenty = try asked("Do I have 20 minutes tomorrow morning?", morning)
  assert.deepStrictEqual([twenty.success, at(twenty.data, "slots")], [true, [
    { startAt: "2030-03-04T18:45:00.000Z", endAt: "2030-03-04T19:05:00.000Z", durationMinutes: 20, timeZone: zone },
    { startAt: "2030-03-04T19:15:00.000Z", endAt: "2030-03-04T19:35:00.000Z", durationMinutes: 20, timeZone: zone },
  ]])
  assert.strictEqual(twenty.text, "I found these 20-minute openings: Monday, March 4, from 10:45 AM to 11:05 AM Pacific Standard Time or Monday, March 4, from 11:15 AM to 11:35 AM Pacific Standard Time.")
  const evening = try asked("Do I have 20 minutes tomorrow morning?", { ...morning, timeMax: "2030-03-04T20:00:00-08:00" })
  const unflagged = try asked("Do I have 20 minutes tomorrow morning?", { ...morning, timeMax: "2030-03-04T20:00:00-08:00", morningOnly: false })
  assert.deepStrictEqual([evening.success, at(evening.data, "code"), unflagged.success, at(unflagged.data, "slots", "length")], [false, "CALENDAR_AVAILABILITY_OUTSIDE_REQUESTED_PERIOD", true, 2])
  const early = try asked("Am I free tomorrow morning until noon?", { ...morning, subaction: "check_availability", timeMin: "2030-03-03T23:00:00-08:00" })
  assert.strictEqual(at(early.data, "code"), "CALENDAR_AVAILABILITY_OUTSIDE_REQUESTED_PERIOD")
  const exact = try asked("am I free tomorrow morning?", { subaction: "check_availability", timeMin: "2030-03-04T00:00:00-08:00", timeMax: "2030-03-04T12:00:00-08:00", morningOnly: true })
  assert.deepStrictEqual([exact.success, at(exact.data, "isFree"), at(exact.data, "conflicts")], [true, false, [
    { startAt: "2030-03-04T17:00:00.000Z", endAt: "2030-03-04T17:30:00.000Z" }, { startAt: "2030-03-04T17:45:00.000Z", endAt: "2030-03-04T18:40:00.000Z" },
  ]])
  for (const wider of ["Am I free tomorrow morning or afternoon?", "Check today or tomorrow morning.", "Am I free tomorrow morning from 10 to 12:30?", "Am I free tomorrow morning until 13:00?"]) {
    const read = try asked(wider, { subaction: "check_availability", timeMin: "2030-03-04T10:00:00-08:00", timeMax: "2030-03-04T20:00:00-08:00" })
    assert.deepStrictEqual([wider, read.success, at(read.data, "isFree"), at(read.data, "conflicts", "length")], [wider, true, false, 1])
  }
  const eleven = try asked("Am I free tomorrow at 11?", { subaction: "check_availability", timeMin: "2030-03-04T11:00:00-08:00", timeMax: "2030-03-04T11:30:00-08:00" })
  assert.deepStrictEqual([eleven.success, at(eleven.data, "isFree"), at(eleven.data, "conflicts")], [true, true, []])
  const wednesday = try asked("Is Wednesday free?", { subaction: "check_availability", timeMin: "2030-03-06T00:00:00-08:00", timeMax: "2030-03-07T00:00:00-08:00" })
  assert.deepStrictEqual(at(wednesday.data, "conflicts"), [{ startAt: "2030-03-06T08:00:00.000Z", endAt: "2030-03-07T08:00:00.000Z" }])
  const described = (name: string) => calendarAction.parameters?.find((parameter) => parameter.name === name)?.description ?? ""
  assert.deepStrictEqual([
    described("afternoonOnly").includes("tomorrow when I can pick up groceries in the afternoon"), described("afternoonOnly").includes("tomorrow afternoon where I can pick up these groceries"),
    described("statedClock").includes("between noon and five"), described("statedClock").includes("from one ten PM to two PM"), described("durationMinutes").includes("a free hour"), described("timeMin").includes("no earlier than now"),
    described("morningOnly").includes("the window then ends by that day's noon."),
  ], [true, true, true, true, true, true, true])
  const unsized = try asked("Find me time this week", { subaction: "propose_times", timeMin: "2030-03-04T09:00:00-08:00", timeMax: "2030-03-04T12:00:00-08:00" })
  const tooLong = try asked("Am I free this month?", { subaction: "check_availability", timeMin: "2030-03-04T00:00:00-08:00", timeMax: "2030-03-12T00:00:00-07:00" })
  assert.deepStrictEqual([at(unsized.data, "code"), at(tooLong.data, "code")], ["CALENDAR_AVAILABILITY_INVALID_WINDOW", "CALENDAR_AVAILABILITY_INVALID_WINDOW"])
  google.health.complete = false
  const stale = try asked("Do I have 20 minutes tomorrow morning?", morning)
  assert.deepStrictEqual([stale.success, at(stale.data, "availability"), at(stale.data, "slots")], [false, "unknown", undefined])
})

it.effect(`A free-time question reads the window as sent and notes a window the owner's words seem to give otherwise (spec/calendar/readClock.md, "The owner's words are read for a free-time window only to note one they seem to give otherwise"; spec/calendar/actions.md, "A free-time question refuses only as before the window notes, and a note never changes the window read"; spec/calendar/actions.md, "A free-time question reads exactly the asked window and answers only from a complete read"; spec/calendar/actions.md, "A morning-only question reads only that morning, from midnight to noon")`, effect () => {
  try TestClock.setTime(Date.parse("2030-03-03T20:00:00Z"))
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => undefined })
  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  const zone = "America/Los_Angeles"
  const asked = (text: string, parameters: Record<string, unknown>) => runCalendarAction(host, { by: "owner-entity", conversation: "room:owner", id: text, text }, { timeZone: zone, ...parameters })
  const asWindow = (from: string, to: string, extra: Record<string, unknown> = {}) => ({ subaction: "check_availability", timeMin: `2030-03-04T${from}:00-08:00`, timeMax: `2030-03-04T${to}:00-08:00`, statedClock: "range", ...extra })
  const readAsSent = (parameters: Record<string, unknown>) => [Date.parse(String(parameters.timeMin)), Date.parse(String(parameters.timeMax))]
  const readWindow = (result: { readonly data?: unknown }) => [Date.parse(String(at(result.data, "windowStart"))), Date.parse(String(at(result.data, "windowEnd")))]
  const unnoted = [
    ["Am I free Mar 4 2-4pm?", asWindow("14:00", "16:00")], ["Am I free 3/4 2-4pm?", asWindow("14:00", "16:00")], ["Am I free tomorrow 14.30-16.00?", asWindow("14:30", "16:00")],
    ["Am I free tomorrow from twenty to three till five pm?", asWindow("14:40", "17:00")], ["Am I free tomorrow from 12:00 noon to 1:00 pm?", asWindow("12:00", "13:00")],
    ["Find me 1-2 hr tomorrow between 1 and like 5", asWindow("13:00", "17:00", { subaction: "propose_times", durationMinutes: 60 })],
    ["Am I free tomorrow from ten past nine till half 5?", asWindow("09:10", "17:30")], ["Am I free tomorrow from 0900 to 1100?", asWindow("09:00", "11:00")],
    ["Am I free tomorrow afternoon until 5:30?", asWindow("12:00", "17:30", { afternoonOnly: true })], ["Tomorrow from 9 to 11 am I need a free hour", asWindow("09:00", "11:00")],
    ["Am I free tomorrow from 2 to 4?", asWindow("14:00", "16:00")], ["Am I free tomorrow from 2 to 4 pm, until 6 if needed?", asWindow("14:00", "18:00")],
    ["Am I free tomorrow at 3 for two hours?", asWindow("15:00", "17:00")], ["Am I free tomorrow at 10 to 6 for an hour?", asWindow("17:50", "18:50", { statedClock: "start" })],
    ["Am I free tomorrow from ten to six for an hour?", asWindow("17:50", "18:50")], ["Am I free tomorrow from ten to six?", asWindow("10:00", "18:00")],
    ["Am I free tomorrow at five til seven for 30 min?", asWindow("18:55", "19:25")], ["Am I free tomorrow from two uh thirty to four?", asWindow("14:30", "16:00")],
    ["Am I free tomorrow from 3 like 15 to 4?", asWindow("15:15", "16:00")], ["Am I free tomorrow 2 to 4, maybe 4:30?", asWindow("14:00", "16:30")],
    ["Am I free tomorrow 2 till 4, maybe 5?", asWindow("14:00", "17:00")], ["Am I free tomorrow 2 to 4, 4:30 at the latest?", asWindow("14:00", "16:30")],
    ["Am I free tomorrow from 2 to 4-4:30?", asWindow("14:00", "16:30")], ["Am I free tomorrow 10 to 12-12:30?", asWindow("10:00", "12:30")],
    ["Am I free tomorrow 3 to 5pm, starting at 3?", asWindow("15:00", "17:00")], ["Am I free tomorrow 9 to 11 am, until 11 latest?", asWindow("09:00", "11:00")],
    ["Am I free tomorrow at 3, from 3 to 5?", asWindow("15:00", "17:00")], ["Am I free tomorrow from 2? say 2 to 4", asWindow("14:00", "16:00")],
    ["Am I free tomorrow 2 to 4, no wait, 3 to 5?", asWindow("15:00", "17:00")], ["Am I free tomorrow afternoon till 6h?", asWindow("12:00", "18:00", { afternoonOnly: true, statedClock: "none" })],
    ["Am I free tomorrow afternoon till 18h?", asWindow("12:00", "18:00", { afternoonOnly: true, statedClock: "none" })], ["Am I free tomorrow 2-4pm ET?", asWindow("11:00", "13:00")],
    ["Am I free tomorrow from 2 to 4 New York time?", asWindow("11:00", "13:00")], ["Am I free tomorrow 9-11am London time?", asWindow("01:00", "03:00")],
    ["Am I free tomorrow 9 to 11 am, er pm?", asWindow("21:00", "23:00")], ["Tomorrow 1 to 3 AM I mean pm, am I free?", asWindow("13:00", "15:00")],
    ["Can 3 to 6 of us meet tomorrow between noon and around 5?", asWindow("12:00", "17:00")], ["Am I free tomorrow morning until noon?", asWindow("08:00", "12:00", { morningOnly: true, statedClock: "none" })],
  ] as const
  for (const [text, parameters] of unnoted) {
    const result = try asked(text, parameters)
    assert.deepStrictEqual([text, result.success, readWindow(result), at(result.data, "windowNote")], [text, true, readAsSent(parameters), undefined])
  }
  const noted = [
    ["Am I free Mar 4 2-4pm?", asWindow("02:00", "16:00"), "the window 2:00 – 4:00 PM", [{ startAt: "2030-03-04T22:00:00.000Z", endAt: "2030-03-05T00:00:00.000Z" }]],
    ["Tomorrow from 9 to 11 am I need a free hour", asWindow("21:00", "23:00"), "the window 9:00 – 11:00 AM", [{ startAt: "2030-03-04T17:00:00.000Z", endAt: "2030-03-04T19:00:00.000Z" }]],
    ["Find me 20 minutes tomorrow from one ten PM to two PM", asWindow("01:10", "14:00", { subaction: "propose_times", durationMinutes: 20 }), "the window 1:10 – 2:00 PM", [{ startAt: "2030-03-04T21:10:00.000Z", endAt: "2030-03-04T22:00:00.000Z" }]],
    ["Am I free tomorrow from 3pm?", asWindow("03:00", "05:00", { statedClock: "start" }), "a start at 3:00 PM", undefined],
    ["Am I free tomorrow between noon and five?", asWindow("12:00", "18:00"), "the window 12:00 – 5:00 PM", [{ startAt: "2030-03-04T20:00:00.000Z", endAt: "2030-03-05T01:00:00.000Z" }]],
  ] as const
  for (const [text, parameters, says, windows] of noted) {
    const result = try asked(text, parameters)
    assert.deepStrictEqual([text, result.success, readWindow(result), at(result.data, "windowNote", "kind"), String(at(result.data, "windowNote", "says")).replace(/\s/gu, " ").includes(says),
      at(result.data, "windowNote", "windows"), result.text?.replace(/\s/gu, " ").includes(says)],
      [text, true, readAsSent(parameters), "WordsGiveAnotherWindow", true, windows, true])
  }
  const afternoon = try asked("Am I free tomorrow afternoon?", asWindow("12:00", "18:00", { afternoonOnly: true, statedClock: "none" }))
  const today = try asked("Is today free?", { subaction: "check_availability", timeMin: "2030-03-03T00:00:00-08:00", timeMax: "2030-03-04T00:00:00-08:00" })
  const yesterday = try asked("Was I free yesterday afternoon?", { subaction: "check_availability", timeMin: "2030-03-02T12:00:00-08:00", timeMax: "2030-03-02T17:00:00-08:00", afternoonOnly: true })
  assert.deepStrictEqual([afternoon.success, at(afternoon.data, "windowNote", "kind"), today.success, at(today.data, "windowStart"), at(today.data, "windowNote", "kind"), yesterday.success, at(yesterday.data, "windowNote", "kind")],
    [true, "AfternoonAsked", true, "2030-03-03T08:00:00.000Z", "StartsBeforeNow", true, "StartsBeforeNow"])
  assert.strictEqual(String(at(today.data, "windowNote", "says")).includes("search_events"), true)
  const unread = [
    ["明天下午2点到4点有空吗", asWindow("02:00", "04:00")], ["내일 오후 2시부터 4시까지 시간 있어?", asWindow("02:00", "04:00")], ["明日の午後2時から4時まで空いてる？", asWindow("02:00", "04:00")],
    ["¿Estoy libre mañana de dos a cuatro?", asWindow("02:00", "04:00")], ["Bin ich morgen von 15 bis 17 Uhr frei?", asWindow("03:00", "05:00")],
    ["Am I free tomorrow between 2 and 4 or 5?", asWindow("02:00", "05:00")], ["Am I free tomorrow from 2 to 3 and a half?", asWindow("02:00", "03:30")],
    ["Am I free 11-25 2-4pm?", asWindow("02:00", "04:00")], ["Am I free tomorrow 9h15 to 11?", asWindow("21:15", "23:00")],
    ["Am I free tomorrow? Asking for Дмитрий, 2 to 4 pm", asWindow("02:00", "04:00")], ["Am I free tomorrow 2-4pm ET?", asWindow("02:00", "04:00")],
    ["Was I free yesterday afternoon, Дмитрий?", { subaction: "check_availability", timeMin: "2030-03-02T12:00:00-08:00", timeMax: "2030-03-02T17:00:00-08:00", afternoonOnly: true }],
  ] as const
  for (const [text, parameters] of unread) {
    const result = try asked(text, parameters)
    assert.deepStrictEqual([text, result.success, readWindow(result), at(result.data, "windowNote")], [text, true, readAsSent(parameters), undefined])
  }
  const pastNoon = [
    ["Am I free tomorrow morning for my 2 kids?", asWindow("00:00", "14:00", { morningOnly: true, statedClock: "none" })],
    ["Am I free tomorrow morning until 12:30?", asWindow("08:00", "12:30", { morningOnly: true, statedClock: "none" })],
    ["Am I free tomorrow morning, until 1?", asWindow("00:00", "13:00", { morningOnly: true, statedClock: "none" })],
    ["Am I free tomorrow morning? I have a call until 1", asWindow("00:00", "13:00", { morningOnly: true, statedClock: "none" })],
  ] as const
  for (const [text, parameters] of pastNoon) {
    const result = try asked(text, parameters)
    assert.deepStrictEqual([text, result.success, at(result.data, "code")], [text, false, "CALENDAR_AVAILABILITY_OUTSIDE_REQUESTED_PERIOD"])
  }
})

it.effect(`Answer an invitation only as its invitee (spec/calendar/actions.md, "Story: Change my calendar only as I asked and know it happened"; spec/calendar/actions.md, "Only an invitee answers an invitation, and an invitee's delete is a decline")`, effect () => {
  const filed: CalendarApprovalRow[] = []
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => ({ request: async (row) => { filed.push(row); return { id: row.id, state: "pending" } } }) })
  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  const invite: CalendarEvent = {
    id: "invite", externalId: "invite", agentId: "agent", provider: "google", side: "owner", calendarId: "work", title: "Planning", description: "", location: "",
    status: "confirmed", startAt: "2030-03-05T18:00:00.000Z", endAt: "2030-03-05T19:00:00.000Z", isAllDay: false, timezone: "UTC", htmlLink: null, conferenceLink: null,
    organizer: { email: "boss@example.com", self: false }, attendees: [{ email: owner.accountId, displayName: null, responseStatus: "needsAction", self: true, organizer: false, optional: false },
      { email: "boss@example.com", displayName: null, responseStatus: "accepted", self: false, organizer: true, optional: false }],
    metadata: { etag: "inv-1" }, syncedAt: "2030-01-01T00:00:00.000Z", updatedAt: "2030-01-01T00:00:00.000Z", connectorAccountId: owner.accountId, grantId: "grant",
  }
  google.events.set(invite.id, invite)
  const mine = () => google.events.get(invite.id)?.attendees[0]?.responseStatus
  const ask = { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "" }
  const run = effect (row: CalendarApprovalRow | undefined) => row === undefined ? "missing" : (try host.executeApproval({ id: row.id, action: row.action, payload: row.payload })).failure?.code ?? "ran"

  const edit = try runCalendarAction(host, ask, { subaction: "update_event", eventId: invite.id, title: "Mine now" })
  assert.deepStrictEqual([edit.success, at(edit.data, "refusal"), filed.length], [false, "invitee_edit", 0])
  const declined = try runCalendarAction(host, { ...ask, id: "message-2", text: "Decline Planning and let them know" }, { subaction: "delete_event", eventId: invite.id, notifyAttendees: true })
  const decline = filed.at(-1)
  assert.deepStrictEqual([declined.success, decline?.action, decline?.payload.change, decline?.reason], [true, "cancel_event",
    { action: "respond_invitation", account: owner.accountId, target: { source: work, eventId: invite.id, expectedVersion: "inv-1" }, scope: "instance", response: "declined", notifyAttendees: true },
    "Calendar respond invitation reviewed in chat, telling its attendees"])
  assert.deepStrictEqual([try run(decline), mine(), google.events.get(invite.id)?.title, google.notified], ["ran", "declined", "Planning", [true]])

  const routes = calendarRoutes(async () => host)
  const answer = (eventId: string, body: Record<string, unknown>) => {
    const route = routes.find((row) => row.method === "POST" && row.path === "/api/lifeops/calendar/events/{eventId}/response")
    return tryPromise(() => route === undefined ? Promise.reject(new Error("There is no invitation answer route"))
      : route.handler({ parameters: new Map([["eventId", eventId]]), query: new Map(), body }))
  }
  const accepted = try answer(invite.id, { responseStatus: "accepted", expectedProviderVersion: "inv-1+", idempotencyKey: "answer-1" })
  const acceptance = filed.at(-1)
  assert.deepStrictEqual([accepted.status, at(accepted.body, "approvalRequestId"), acceptance?.action, at(acceptance?.payload.change, "response")], [202, acceptance?.id, "modify_event", "accepted"])
  assert.strictEqual((try answer(invite.id, { responseStatus: "tentative", recurrenceScope: "this_and_following", expectedProviderVersion: "inv-1+", idempotencyKey: "answer-2" })).status, 400)
  const unanswering = googleCalendar(false)
  try host.register(unanswering.port)
  assert.deepStrictEqual([try run(acceptance), mine()], ["CALENDAR_INVITATION_RESPONSE_UNSUPPORTED", "declined"])
  unanswering.events.set(invite.id, google.events.get(invite.id) ?? invite)
  const unsupported = try answer(invite.id, { responseStatus: "tentative", expectedProviderVersion: "inv-1+", idempotencyKey: "answer-3" })
  assert.deepStrictEqual([unsupported.status, at(unsupported.body, "code")], [501, "CALENDAR_ANSWERS_UNSUPPORTED"])
  try host.register(google.port)
  const tentative = try answer(invite.id, { responseStatus: "tentative", recurrenceScope: "series", expectedProviderVersion: "inv-1+", idempotencyKey: "answer-4" })
  assert.deepStrictEqual([tentative.status, at(filed.at(-1)?.payload.change, "notifyAttendees"), try run(filed.at(-1)), mine(), google.notified], [202, undefined, "ran", "tentative", [true, false]])

  const own = try runCalendarAction(host, { ...ask, id: "message-3" }, { subaction: "create_event", title: "Focus", startAt: "2030-03-06T18:00:00Z", endAt: "2030-03-06T19:00:00Z", reviewBeforeCreate: false, statedClock: "none" })
  const organizer = try answer(String(at(own.data, "event", "id")), { responseStatus: "accepted", expectedProviderVersion: String(at(own.data, "event", "metadata", "etag")), idempotencyKey: "answer-5" })
  assert.deepStrictEqual([organizer.status, at(organizer.body, "code")], [403, "CALENDAR_NOT_INVITEE"])
})

it.effect(`Change my calendar only as I asked and know it happened, from the owner's client (spec/calendar/actions.md, "Story: Change my calendar only as I asked and know it happened"; spec/calendar/actions.md, "Declining an invitation never deletes the event")`, effect () => {
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => undefined })
  const routes = calendarRoutes(async () => host)
  const call = (method: string, path: string, input: Partial<CalendarRouteInput> = {}) => {
    const route = routes.find((row) => row.method === method && row.path === path)
    return tryPromise(() => route === undefined ? Promise.reject(new Error(`${method} ${path} is not a calendar route`))
      : route.handler({ parameters: new Map(), query: new Map(), body: undefined, ...input }))
  }
  const window = new Map([["timeMin", "2030-03-01T00:00:00.000Z"], ["timeMax", "2030-03-10T00:00:00.000Z"]])
  const made = try call("POST", "/api/lifeops/calendar/events", { body: { title: "Haircut", startAt: "2030-03-06T18:00:00Z", endAt: "2030-03-06T19:00:00Z", timeZone: "UTC", idempotencyKey: "key-1" } })
  const id = String(at(made.body, "event", "id"))
  const etag = String(at(made.body, "event", "metadata", "etag"))
  assert.deepStrictEqual([made.status, at(made.body, "event", "title")], [200, "Haircut"])
  assert.strictEqual(at((try call("GET", "/api/lifeops/calendar/feed", { query: window })).body, "events", "length"), 1)
  const path = "/api/lifeops/calendar/events/{eventId}"
  const parameters = new Map([["eventId", id]])
  assert.strictEqual((try call("PATCH", path, { parameters, body: { title: "Haircut", expectedProviderVersion: "stale", idempotencyKey: "key-2" } })).status, 409)
  const moved = try call("PATCH", path, { parameters, body: { startAt: "2030-03-07T18:00:00Z", endAt: "2030-03-07T19:00:00Z", expectedProviderVersion: etag, idempotencyKey: "key-2" } })
  assert.deepStrictEqual([moved.status, at(moved.body, "event", "startAt"), at(moved.body, "event", "title")], [200, "2030-03-07T18:00:00.000Z", "Haircut"])
  const next = String(at(moved.body, "event", "metadata", "etag"))
  assert.strictEqual((try call("DELETE", path, { parameters, query: new Map([["expectedProviderVersion", next], ["idempotencyKey", "key-3"]]) })).status, 400)
  const declined = try call("DELETE", path, { parameters, query: new Map([["expectedProviderVersion", next], ["idempotencyKey", "key-3"], ["cancellationMode", "decline_invitation"]]) })
  assert.deepStrictEqual([declined.status, at(declined.body, "code"), at((try call("GET", "/api/lifeops/calendar/feed", { query: window })).body, "events", "length")], [403, "CALENDAR_NOT_INVITEE", 1])
  const gone = try call("DELETE", path, { parameters, query: new Map([["expectedProviderVersion", next], ["idempotencyKey", "key-3"], ["cancellationMode", "remove_private_copy"]]) })
  assert.deepStrictEqual([gone.status, at(gone.body, "deleted"), at(gone.body, "receipt", "providerVersion")], [200, true, `deleted:${next}`])
  assert.strictEqual(at((try call("GET", "/api/lifeops/calendar/feed", { query: window })).body, "events", "length"), 0)
})

it.effect(`Create a repeating event through the reviewed create (spec/calendar/actions.md, "Story: Change my calendar only as I asked and know it happened"; spec/calendar/actions.md, "A repeating create carries its reviewed recurrence and reads back with it"; spec/calendar/actions.md, "A write goes to the active account's writable calendar, at once only for the resident calendar"; spec/calendar/seriesScope.md, "A chat change to a repeating event asks which occurrences unless the request says"; spec/calendar/actions.md, "A change finds its one event from a year back to five years ahead, and never calls an unread calendar empty"; spec/calendar/actions.md, "A resident delete runs at once only for the one event the owner named, and otherwise asks in chat")`, effect () => {
  const filed: CalendarApprovalRow[] = []
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => ({ request: async (row) => { filed.push(row); return { id: row.id, state: "pending" } } }) })
  const ask = { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "", ownerZone: "UTC" }
  const weekly = { subaction: "create_event", title: "Piano", startAt: "2030-03-04T17:00:00Z", endAt: "2030-03-04T18:00:00Z", timeZone: "UTC",
    repeat: "weekly", repeatUntil: "2030-03-25T17:00:00Z", skipStarts: ["2030-03-11T17:00:00Z"], reviewBeforeCreate: false, statedClock: "none" }
  const made = try runCalendarAction(host, ask, weekly)
  assert.deepStrictEqual([made.success, at(made.data, "event", "recurrence")], [true, ["RRULE:FREQ=WEEKLY;UNTIL=20300325T170000Z", "EXDATE:20300311T170000Z"]])
  const month = try runCalendarAction(host, ask, { subaction: "search_events", query: "piano", timeMin: "2030-03-01T00:00:00Z", timeMax: "2030-04-01T00:00:00Z" })
  assert.deepStrictEqual((at(month.data, "events") as CalendarEvent[]).map((event) => event.startAt), ["2030-03-04T17:00:00.000Z", "2030-03-18T17:00:00.000Z", "2030-03-25T17:00:00.000Z"])
  const lesson = String(at(month.data, "events", "1", "id"))
  const unsaid = try runCalendarAction(host, { ...ask, id: "message-4a", text: "Rename piano to Piano recital" }, { subaction: "update_event", eventId: lesson, title: "Piano recital" })
  assert.deepStrictEqual([unsaid.success, at(unsaid.data, "missing"), at(unsaid.data, "eventId")], [false, ["recurrenceScope"], lesson])
  const once = try runCalendarAction(host, { ...ask, id: "message-4", text: "Rename just this one to Piano recital" }, { subaction: "update_event", eventId: lesson, title: "Piano recital", recurrenceScope: "instance" })
  const all = try runCalendarAction(host, { ...ask, id: "message-5" }, { subaction: "update_event", eventId: lesson, title: "Piano lesson", recurrenceScope: "series" })
  const renamed = try runCalendarAction(host, ask, { subaction: "search_events", query: "piano", timeMin: "2030-03-01T00:00:00Z", timeMax: "2030-04-01T00:00:00Z" })
  assert.deepStrictEqual([once.success, all.success, at(all.data, "event", "id"), (at(renamed.data, "events") as CalendarEvent[]).map((event) => event.title)],
    [true, true, lesson, ["Piano lesson", "Piano lesson", "Piano lesson"]])
  const named = try runCalendarAction(host, { ...ask, id: "message-5a" },
    { subaction: "update_event", query: "piano lesson", title: "Piano", recurrenceScope: "series", timeMin: "2030-03-01T00:00:00Z", timeMax: "2030-04-01T00:00:00Z" })
  assert.deepStrictEqual([named.success, at(named.data, "event", "title")], [true, "Piano"])
  const lessons = effect () => (at((try runCalendarAction(host, ask, { subaction: "search_events", query: "piano", timeMin: "2030-03-01T00:00:00Z", timeMax: "2030-04-01T00:00:00Z" })).data, "events") as CalendarEvent[]).map((event) => event.startAt)
  const deleting = (id: string, text: string, recurrenceScope?: string, selected?: string, ownerAnswer?: string) =>
    runCalendarAction(host, { ...ask, id, text, ...(selected === undefined ? {} : { selected }) },
      { subaction: "delete_event", eventId: lesson, ...(recurrenceScope === undefined ? {} : { recurrenceScope }), ...(ownerAnswer === undefined ? {} : { ownerAnswer }) })
  const all3 = ["2030-03-04T17:00:00.000Z", "2030-03-18T17:00:00.000Z", "2030-03-25T17:00:00.000Z"]
  const unnamed = try deleting("message-6", "Delete the lesson")
  const yesSeries = try deleting("message-7", "yes", "series", undefined, "yes")
  assert.deepStrictEqual([at(unnamed.data, "requiresInput"), yesSeries.success, at(yesSeries.data, "deleted"), try lessons()], [true, false, undefined, all3])
  const selectedSeries = try deleting("message-8", "Delete this", "series", lesson)
  const following = try deleting("message-9", "Delete Piano", "this_and_following")
  assert.deepStrictEqual([selectedSeries.success, at(selectedSeries.data, "deleted"), following.success, at(following.data, "requiresInput"), try lessons()], [false, undefined, false, undefined, all3])
  const conflicting = try deleting("message-10", "Delete just this one or the whole series?")
  assert.deepStrictEqual([conflicting.success, at(conflicting.data, "missing"), try lessons()], [false, ["delete confirmation"], all3])
  const yes = try deleting("message-11", "yes", undefined, undefined, "yes")
  assert.deepStrictEqual([at(yes.data, "deleted"), try lessons()], [true, ["2030-03-04T17:00:00.000Z", "2030-03-25T17:00:00.000Z"]])
  const doubled = try runCalendarAction(host, { ...ask, id: "message-2" }, { ...weekly, skipStarts: ["2030-03-11T17:00:00Z", "2030-03-11T17:00:00Z"] })
  assert.strictEqual(doubled.success, false)
  const checkup = { subaction: "create_event", title: "Checkup", startAt: "2030-03-06T17:00:00Z", endAt: "2030-03-06T18:00:00Z", timeZone: "UTC", statedClock: "none" }
  const checkups = effect () => at((try runCalendarAction(host, ask, { subaction: "search_events", query: "checkup", ...march })).data, "events", "length")
  const held = try runCalendarAction(host, { ...ask, id: "message-review" }, checkup)
  const preview = filed.at(-1)
  assert.deepStrictEqual([held.success, at(held.data, "approvalRequestId"), at(preview?.payload.change, "fields", "title"), try checkups()], [true, preview?.id, "Checkup", 0])
  if (preview === undefined) return
  assert.strictEqual((try host.executeApproval({ id: preview.id, action: preview.action, payload: preview.payload })).result, "ChangeSucceeded")
  assert.strictEqual(try checkups(), 1)

  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  try runCalendarAction(host, { ...ask, id: "message-3" }, { ...weekly, calendarId: "work" })
  const review = filed.at(-1)
  assert.deepStrictEqual(at(review?.payload.change, "recurrence"), { rule: "weekly", until: "2030-03-25T17:00:00.000Z", excluded: ["2030-03-11T17:00:00.000Z"] })
  if (review === undefined) return
  const refusal = try host.executeApproval({ id: review.id, action: review.action, payload: review.payload })
  assert.deepStrictEqual([refusal.result, refusal.failure?.code, google.events.size], ["ChangeInvalidated", "CALENDAR_RECURRENCE_UNSUPPORTED", 0])
})

it.effect(`Change my calendar only as I asked and know it happened, at a free time and for the one event I meant (spec/calendar/actions.md, "Story: Change my calendar only as I asked and know it happened"; spec/calendar/readClock.md, "A clock time the owner stated is one the owner's words hold"; spec/calendar/readClock.md, "A stated year wins, a wrong extracted year is corrected, and a past start asks first"; spec/calendar/actions.md, "A chat create or move that overlaps a commitment is refused, naming it"; spec/calendar/actions.md, "A new event with a start and no end lasts the asked minutes, else one hour"; spec/calendar/actions.md, "A change finds its one event from a year back to five years ahead, and never calls an unread calendar empty"; spec/calendar/actions.md, "A whole-day read names its first and last day, and code finds the midnights"; spec/calendar/readClock.md, "A time sent without an offset is wall time in the request's zone"; spec/calendar/seriesScope.md, "A chat change to a repeating event asks which occurrences unless the request says"; spec/calendar/actions.md, "A change that moves only the start keeps the event's length")`, effect () => {
  try TestClock.setTime(Date.parse("2030-03-01T12:00:00Z"))
  const filed: CalendarApprovalRow[] = []
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => ({ request: async (row) => { filed.push(row); return { id: row.id, state: "pending" } } }) })
  const ask = { by: "owner-entity", conversation: "room:owner", text: "", ownerZone: "America/Los_Angeles" }
  const said = (id: string, text: string, parameters: Record<string, unknown>) => runCalendarAction(host, { ...ask, id, text }, { reviewBeforeCreate: false, ...parameters })
  const run = (id: string, parameters: Record<string, unknown>) => said(id, "", { statedClock: "none", ...parameters })
  const span = (result: { readonly data?: unknown }) => [at(result.data, "event", "startAt"), at(result.data, "event", "endAt")]
  const dentist = try run("slot-1", { subaction: "create_event", title: "Dentist", startAt: "2030-03-04T09:00" })
  const call = try run("slot-2", { subaction: "create_event", title: "Call", startAt: "2030-03-04T11:00", durationMinutes: 30 })
  const skipped = try run("slot-3", { subaction: "create_event", title: "Ghost", startAt: "2030-03-10T02:30" })
  const fraction = try run("slot-4", { subaction: "create_event", title: "Marathon", startAt: "2030-03-04T14:00", durationMinutes: 30.5 })
  assert.deepStrictEqual([span(dentist), span(call), at(skipped.data, "code"), at(fraction.data, "code")],
    [["2030-03-04T17:00:00.000Z", "2030-03-04T18:00:00.000Z"], ["2030-03-04T19:00:00.000Z", "2030-03-04T19:30:00.000Z"], "CALENDAR_WALL_TIME_UNRESOLVED", "CALENDAR_EVENT_LENGTH_INVALID"])

  const again = try run("slot-1", { subaction: "create_event", title: "Dentist", startAt: "2030-03-04T09:00" })
  const offsite = try run("slot-4a", { subaction: "create_event", title: "Offsite", startAt: "2030-03-08T08:00", durationMinutes: 540 })
  const late = try run("slot-4b", { subaction: "create_event", title: "Late", startAt: "2030-03-06T24:00" })
  const twice = try run("slot-4c", { subaction: "create_event", title: "Twice", startAt: "2030-11-03T01:30" })
  const unreal = try run("slot-4d", { subaction: "create_event", title: "Never", startAt: "2030-02-30T09:00" })
  const holiday = try runCalendarAction(host, { ...ask, id: "slot-4e", ownerZone: "Europe/Berlin" }, { subaction: "create_event", title: "Holiday", isAllDay: true, startAt: "2030-03-11T00:00", reviewBeforeCreate: false })
  const tokyo = try said("slot-4f", "Schedule a sync at 9am Tokyo time", { subaction: "create_event", title: "Tokyo sync", startAt: "2030-03-06T09:00", timeZone: "Asia/Tokyo", statedClock: "start" })
  const unsaidZone = try run("slot-4g", { subaction: "create_event", title: "Osaka sync", startAt: "2030-03-07T09:00", timeZone: "Asia/Tokyo" })
  const taco = "Add an event called Taco Night lab check tomorrow from one ten PM to one thirty PM on my built in Eliza calendar with no guests."
  const labSync = "Schedule an event named Lab sync tomorrow from 3pm to 3:45pm"
  const labDinner = "Add an event called Lab dinner tomorrow from six PM to seven PM at the lab"
  const ranged = (id: string, text: string, title: string, startAt: string, endAt: string) => said(id, text, { subaction: "create_event", title, startAt, endAt, statedClock: "range" })
  const misread = [try ranged("slot-4h", taco, "Taco Night lab check", "2030-03-02T22:10", "2030-03-02T22:30"), try ranged("slot-4i", labSync, "Lab sync", "2030-03-02T16:00", "2030-03-02T16:45"),
    try ranged("slot-4j", labDinner, "Lab dinner", "2030-03-02T19:00", "2030-03-02T20:00")]
  assert.deepStrictEqual(misread.map((result) => [result.success, at(result.data, "code"), result.effectReceipts?.length ?? 0]), Array.from({ length: 3 }, () => [false, "CALENDAR_CLOCK_UNSAID", 0]))
  assert.strictEqual(misread[0]?.text, "Nothing was saved: the start time 10:10 PM is not a time the request gives.")
  const dictated = try ranged("slot-4k", taco, "Taco Night lab check", "2030-03-02T13:10", "2030-03-02T13:30")
  const written = try ranged("slot-4l", labSync, "Lab sync", "2030-03-02T15:00", "2030-03-02T15:45")
  const extended = try ranged("slot-4m", labDinner, "Lab dinner", "2030-03-02T18:00", "2030-03-02T19:00")
  const morningTaco = try ranged("slot-4v", taco, "Taco Night lab check", "2030-03-02T01:10", "2030-03-02T01:30")
  assert.deepStrictEqual([morningTaco.success, at(morningTaco.data, "code"), at(morningTaco.data, "sent"), morningTaco.effectReceipts?.length ?? 0], [false, "CALENDAR_CLOCK_UNSAID", "2030-03-02T09:10:00.000Z", 0])
  const attachedAm = try said("slot-4x", "Schedule the dentist tomorrow at 9am I think", { subaction: "create_event", title: "Dentist", startAt: "2030-03-02T21:00", statedClock: "start" })
  assert.deepStrictEqual([attachedAm.success, at(attachedAm.data, "code"), attachedAm.effectReceipts?.length ?? 0], [false, "CALENDAR_CLOCK_UNSAID", 0])
  const lengthAfterClock = try said("slot-4y", "Add Dentist tomorrow at 11, two hours", { subaction: "create_event", title: "Checkup", startAt: "2030-03-02T11:00", durationMinutes: 120, statedClock: "start" })
  const unreadClock = try said("slot-4z", "牙医 明天早上5点", { subaction: "create_event", title: "Dentist check", startAt: "2030-03-02T05:00", statedClock: "start" })
  assert.deepStrictEqual([span(lengthAfterClock), unreadClock.success, at(unreadClock.data, "code")], [["2030-03-02T19:00:00.000Z", "2030-03-02T21:00:00.000Z"], false, "CALENDAR_CLOCK_UNSAID"])
  const halfThree = try said("slot-4zh", "Dentist tomorrow at half 3", { subaction: "create_event", title: "Half three", startAt: "2030-03-20T15:30", statedClock: "start" })
  const lateStandup = try said("slot-4zi", "Standup tomorrow 9:15a", { subaction: "create_event", title: "Late huddle", startAt: "2030-03-20T21:15", statedClock: "start" })
  const rangeAsMinutes = try said("slot-4zj", "Coffee tomorrow from 10 to 6", { subaction: "create_event", title: "Coffee", startAt: "2030-03-20T17:50", statedClock: "start" })
  const phoneNumber = try said("slot-4zk", "Call 0800 123 456 tomorrow at 3", { subaction: "create_event", title: "Hotline", startAt: "2030-03-20T08:00", statedClock: "start" })
  assert.deepStrictEqual([at(halfThree.data, "code"), at(halfThree.data, "sent"), halfThree.effectReceipts?.length ?? 0, span(lateStandup), at(rangeAsMinutes.data, "code"), at(phoneNumber.data, "code")],
    ["CALENDAR_CLOCK_UNSAID", "2030-03-20T22:30:00.000Z", 0, ["2030-03-21T04:15:00.000Z", "2030-03-21T05:15:00.000Z"], "CALENDAR_CLOCK_UNSAID", "CALENDAR_CLOCK_UNSAID"])
  const errand = (id: string, text: string, startAt: string) => said(id, text, { subaction: "create_event", title: "Errand", startAt, statedClock: "start" })
  const addressed = [try errand("slot-4zl", "Lunch tomorrow at 1230 Broadway", "2030-03-21T12:30"), try errand("slot-4zm", "Meet Sam tomorrow at 1430 Main St", "2030-03-21T14:30"),
