  try run("slot-17", { subaction: "create_event", title: "Stretch", startAt: "2030-03-04T07:00", durationMinutes: 15, repeat: "daily" })
  const standup = { subaction: "update_event", query: "standup" }
  const thursday = try said("slot-18", "Move Thursday's standup to 3pm, just this one", { ...standup, startAt: "2030-03-07T15:00", endAt: "2030-03-07T15:15", recurrenceScope: "instance", statedClock: "start" })
  const anyDay = try said("slot-19", "Move just this one standup to 4pm", { ...standup, startAt: "2030-03-04T16:00", endAt: "2030-03-04T16:15", recurrenceScope: "instance", statedClock: "start" })
  const anyScope = try said("slot-20", "Rename standup to Sync", { ...standup, title: "Sync" })
  const saturday = try said("slot-21", "Cancel Saturday's standup", { subaction: "delete_event", query: "standup" })
  const tomorrow = try said("slot-22", "Move Dentist tomorrow at 10am", { subaction: "update_event", query: "dentist", startAt: "2030-03-02T10:00", endAt: "2030-03-02T11:00", statedClock: "start" })
  const absent = try run("slot-23", { subaction: "update_event", query: "plumber", title: "Plumber, moved" })
  assert.deepStrictEqual([span(thursday), at(anyDay.data, "candidates", "length"), at(anyScope.data, "missing"), at(anyScope.data, "startAt"), saturday.success, at(saturday.data, "candidates", "length"), span(tomorrow), at(absent.data, "code")],
    [["2030-03-07T23:00:00.000Z", "2030-03-07T23:15:00.000Z"], 5, ["recurrenceScope"], "2030-03-04T16:00:00.000Z", false, 5, ["2030-03-02T18:00:00.000Z", "2030-03-02T19:00:00.000Z"], "CALENDAR_TARGET_NOT_FOUND"])

  const google = googleCalendar()
  google.health.widestDays = 200
  try host.register(google.port)
  try host.bindAccount(owner)
  google.events.set("review", {
    id: "review", externalId: "review", agentId: "agent", provider: "google", side: "owner", calendarId: "work", title: "Review", description: "", location: "", status: "confirmed",
    startAt: "2030-03-05T18:00:00.000Z", endAt: "2030-03-05T19:00:00.000Z", isAllDay: false, timezone: "UTC", htmlLink: null, conferenceLink: null, organizer: { self: true }, attendees: [],
    metadata: { etag: "review" }, syncedAt: "2030-01-01T00:00:00.000Z", updatedAt: "2030-01-01T00:00:00.000Z", connectorAccountId: owner.accountId, grantId: "grant",
  })
  const near = try run("slot-24", { subaction: "update_event", query: "review", title: "Review, moved" })
  const nowhere = try run("slot-25", { subaction: "update_event", query: "plumber", title: "Plumber, moved" })
  const taken = try run("slot-26", { subaction: "create_event", calendarId: "work", title: "Clash", startAt: "2030-03-05T10:15" })
  assert.deepStrictEqual([near.success, at(filed.at(-1)?.payload.change, "target", "eventId"), at(nowhere.data, "code"), at(taken.data, "code"), at(taken.data, "conflicts", "0", "title"), filed.length],
    [true, "review", "CALENDAR_TARGET_NOT_FOUND", "CALENDAR_WRITE_CONFLICT", "Review", 1])

  google.health.complete = false
  const unread = try run("slot-13", { subaction: "update_event", query: "plumber", title: "Plumber, moved" })
  const blind = try run("slot-14", { subaction: "create_event", calendarId: "work", title: "Sync", startAt: "2030-03-05T09:00" })
  const beside = try run("slot-15", { subaction: "create_event", title: "Walk", startAt: "2030-03-05T09:00" })
  assert.deepStrictEqual([at(unread.data, "code"), at(blind.data, "code"), google.events.size, beside.success, beside.text?.endsWith("so overlaps there were not checked.")],
    ["CALENDAR_TARGET_UNREAD", "CALENDAR_WRITE_SLOT_UNREAD", 1, true, true])
})

it.effect(`A create or change holds no clock in four digits, a dot, an hour and h, counted minutes or "half 5", which read as odds, counts, amounts, lengths, doses, scores, years or page, room and house numbers (spec/calendar/readClock.md, "A clock time the owner stated is one the owner's words hold"; spec/calendar/readClock.md, "A stated year wins, a wrong extracted year is corrected, and a past start asks first")`, effect () => {
  try TestClock.setTime(Date.parse("2030-03-01T12:00:00Z"))
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => undefined })
  const ask = { by: "owner-entity", conversation: "room:owner", text: "", ownerZone: "America/Los_Angeles" }
  const said = (id: string, text: string, parameters: Record<string, unknown>) => runCalendarAction(host, { ...ask, id, text }, { reviewBeforeCreate: false, ...parameters })
  const refusal = (result: { readonly data?: unknown; readonly effectReceipts?: readonly unknown[] }) => [at(result.data, "code"), result.effectReceipts?.length ?? 0]
  const refusedAt = (result: { readonly data?: unknown; readonly effectReceipts?: readonly unknown[] }) => [...refusal(result), at(result.data, "sent")]
  const errand = (id: string, text: string, startAt: string, statedClock?: string) =>
    said(id, text, { subaction: "create_event", title: "Errand", startAt, ...(statedClock === undefined ? {} : { statedClock }) })
  const misread = [
    try errand("r3-1", "Meeting tomorrow from 1500 to 1630.", "2030-03-05T15:00", "start"), try errand("r3-2", "Workshop tomorrow between 0900 and 1100.", "2030-03-05T09:00", "start"),
    try errand("r3-3", "Tomorrow, read pages from 1215 to 1230.", "2030-03-05T12:15", "start"), try errand("r3-4", "Canvass houses from 1745 to 1747.", "2030-03-05T17:45", "start"),
    try errand("r3-5", "Bet on the Lakers tomorrow at 5 to 1.", "2030-03-05T12:55", "start"), try errand("r3-6", "Mix the epoxy tomorrow at two to one.", "2030-03-05T12:58", "start"),
    try errand("r3-7", "Rematch tomorrow, last time we lost at 10 to 6.", "2030-03-05T05:50", "start"), try errand("r3-8", "Tomorrow, scale the recipe from half 2 to 3 cups.", "2030-03-05T02:30", "start"),
    try errand("r3-9", "Tomorrow, cut back from 10 past 6 to 7 laps.", "2030-03-05T06:10", "start"), try errand("r3-10", "Sell my Samsung shares tomorrow at ₩1450.", "2030-03-05T14:50", "start"),
    try errand("r3-11", "Sell the coins tomorrow at ₿0145.", "2030-03-05T01:45", "start"), try errand("r3-12", "Party tomorrow at #0930.", "2030-03-05T09:30", "start"),
    try errand("r3-13", "Call the hotline tomorrow at +0930.", "2030-03-05T09:30", "start"), try errand("r3-14", "Fire the kiln tomorrow at 0932°.", "2030-03-05T09:32", "start"),
    try errand("r3-15", "Buy gold at 2345 on Friday.", "2030-03-08T23:45", "start"), try errand("r3-16", "Set the bid at 0945 this morning", "2030-03-01T09:45", "start"),
    try errand("r3-17", "Charge the car tomorrow for 14h30.", "2030-03-05T14:30", "start"), try errand("r3-18", "The backup takes 02h15, start it tomorrow", "2030-03-05T02:15", "start"),
    try errand("r3-19", "Tomorrow, the final score was tied at 14 14.", "2030-03-05T14:14", "start"), try errand("r3-20", "Replay tomorrow the game that ended at 21 15.", "2030-03-05T21:15", "start"),
    try errand("r3-21", "Tomorrow: Waterloo reenactment at 1815.", "2030-03-05T18:15", "start"), try errand("r3-22", "Lunch tomorrow at 1230.", "2030-03-05T12:30", "start"),
    try errand("r3-35", "Increase her dose from half 1 to 2 tomorrow.", "2030-03-05T01:30", "start"), try errand("r3-36", "Lunch with Sam tomorrow; his apartment is at 0815.", "2030-03-05T08:15", "start"),
    try errand("r3-37", "Marathon tomorrow, aiming to finish at 03h45.", "2030-03-05T03:45", "start"), try errand("r3-38", "Retro tomorrow at ０９３０.", "2030-03-05T09:30", "start"),
    try errand("r3-39", "Dinner tomorrow at 2045.", "2030-03-05T20:45", "start"), try errand("r3-40", "Pay the $14.30 invoice tomorrow at 2", "2030-03-05T14:30", "start"),
    try errand("r3-41", "Book room 15, 30 people, tomorrow at 3", "2030-03-05T15:30", "start"),
  ]
  assert.deepStrictEqual(misread.map(refusal), misread.map(() => ["CALENDAR_CLOCK_UNSAID", 0]))
  const undeclared = [try errand("r3-23", "Dilute the cleaner at 10 to 1 tomorrow.", "2030-03-05T12:50"), try errand("r3-24", "Meeting tomorrow from 1500 to 1630.", "2030-03-05T15:00")]
  const workshop = try said("r3-25", "Workshop tomorrow from 0900 to 1100.", { subaction: "create_event", title: "Workshop", startAt: "2030-03-05T09:00", endAt: "2030-03-05T11:00", statedClock: "range" })
  assert.deepStrictEqual([...undeclared.map(refusal), refusedAt(workshop)],
    [["CALENDAR_CLOCK_UNDECLARED", 0], ["CALENDAR_CLOCK_UNDECLARED", 0], ["CALENDAR_CLOCK_UNSAID", 0, "2030-03-05T17:00:00.000Z"]])

  try said("r3-26", "", { subaction: "create_event", title: "Bet", startAt: "2030-03-06T08:07", statedClock: "none" })
  const move = (id: string, text: string, startAt: string) => said(id, text, { subaction: "update_event", query: "bet", startAt, statedClock: "start" })
  const moves = [try move("r3-27", "Move the bet to tomorrow at 10 to 1.", "2030-03-06T12:50"), try move("r3-28", "Move the bet to tomorrow at #0930.", "2030-03-06T09:30"),
    try move("r3-29", "Move the bet: from half 2 to 3 cups.", "2030-03-06T02:30"), try move("r3-30", "Move the bet to houses from 1201 to 1259.", "2030-03-06T12:01"),
    try move("r3-31", "Move the bet to bid at 1450 on Monday.", "2030-03-06T14:50")]
  assert.deepStrictEqual(moves.map(refusal), moves.map(() => ["CALENDAR_CLOCK_UNSAID", 0]))

  const quarter = try said("r3-32", "Call at quarter of five tomorrow", { subaction: "create_event", title: "Quarter call", startAt: "2030-03-26T16:45", statedClock: "start" })
  const hourAndH = try said("r3-33", "Call tomorrow at 14h30", { subaction: "create_event", title: "Afternoon call", startAt: "2030-03-27T14:30", statedClock: "start" })
  const toDigits = try said("r3-34", "Block tomorrow from 9am to 0930.", { subaction: "create_event", title: "Early block", startAt: "2030-03-28T09:00", endAt: "2030-03-28T09:30", statedClock: "range" })
  assert.deepStrictEqual([quarter, hourAndH, toDigits].map(refusedAt), [["CALENDAR_CLOCK_UNSAID", 0, "2030-03-26T23:45:00.000Z"], ["CALENDAR_CLOCK_UNSAID", 0, "2030-03-27T21:30:00.000Z"],
    ["CALENDAR_CLOCK_UNSAID", 0, "2030-03-28T16:30:00.000Z"]])
})

it.effect(`Put an event on my phone's own calendar through the phone's review (spec/calendar/actions.md, "A new event the owner put on the phone's own calendar is proposed on the phone")`, effect () => {
  try TestClock.setTime(Date.parse("2030-03-01T12:00:00Z"))
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => undefined })
  const text = "put lunch with Ana on my phone calendar Friday at noon"
  const ask = { by: "owner-entity", conversation: "room:owner", id: "phone-1", text, ownerZone: "America/Los_Angeles" }
  const lunch = { subaction: "create_event", title: "Lunch with Ana", startAt: "2030-03-08T12:00", durationMinutes: 60, statedClock: "start", reviewBeforeCreate: false }
  const lunches = effect () => at((try runCalendarAction(host, ask, { subaction: "search_events", query: "Ana", timeMin: "2030-03-01T00:00:00Z", timeMax: "2030-04-01T00:00:00Z" })).data, "events", "length")
  const redirected = try runCalendarAction(host, { ...ask, phoneCalendar: true }, { ...lunch, phoneCalendar: true })
  assert.deepStrictEqual([redirected.success, at(redirected.data, "code"), typeof at(redirected.data, "next"), redirected.effectReceipts?.length ?? 0, try lunches()],
    [false, "CALENDAR_PHONE_CALENDAR_ASKED", "string", 0, 0])
  const noPhone = try runCalendarAction(host, { ...ask, id: "phone-2" }, { ...lunch, phoneCalendar: true })
  const unasked = try runCalendarAction(host, { ...ask, id: "phone-3", text: "Add lunch with Ana Saturday at noon", phoneCalendar: true }, { ...lunch, startAt: "2030-03-09T12:00" })
  assert.deepStrictEqual([noPhone.success, at(noPhone.data, "event", "startAt"), unasked.success, try lunches()], [true, "2030-03-08T20:00:00.000Z", true, 2])
})

it.effect(`Attendees hear of a change only when the owner asked and the calendar can tell them (spec/calendar/actions.md, "Attendees hear of a change only when the owner asked and the calendar can tell them"; spec/calendar/actions.md, "A new event's guests and a change of guests are the ones the owner's words give"; spec/calendar/actions.md, "A resident delete runs at once only for the one event the owner named, and otherwise asks in chat")`, effect () => {
  const rowsKey = "calendar:kv:calendar.resident.rows.agent.resident%3Aagent"
  const planning = { id: "resident-planning", calendarId: "primary", title: "Planning", body: "", location: "", begin: Date.parse("2030-03-04T17:00:00Z"), end: Date.parse("2030-03-04T18:00:00Z"),
    revision: "r1", who: ["sam@example.com"] }
  const rows = new Map<string, unknown>([[rowsKey, JSON.stringify({ revision: 1, rows: [planning], changedAt: {}, replays: {}, imported: null })]])
  const host = try calendarHost({ cache: memoryCache(rows), agentId: "agent", approvals: () => undefined })
  const ask = { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "Move Planning to 11am and let Sam know" }
  const nobody = "The built-in calendar can't email attendees, so nobody was notified."
  const moved = try runCalendarAction(host, ask, { subaction: "update_event", eventId: planning.id, startAt: "2030-03-04T11:00:00Z", endAt: "2030-03-04T12:00:00Z", notifyAttendees: true, timeZone: "UTC", statedClock: "start" })
  const quiet = try runCalendarAction(host, { ...ask, id: "message-2", text: "Rename Planning to Sync" }, { subaction: "update_event", eventId: planning.id, title: "Sync", timeZone: "UTC" })
  assert.deepStrictEqual([moved.success, moved.text?.endsWith(nobody), at(moved.data, "event", "startAt"), quiet.success, quiet.text?.endsWith(nobody)],
    [true, true, "2030-03-04T11:00:00.000Z", true, false])
  const emails = (result: { readonly data?: unknown }) => (at(result.data, "event", "attendees") as { readonly email: string | null }[] | undefined)?.map((attendee) => attendee.email)
  const guestChange = (id: string, text: string, change: Record<string, unknown>) => runCalendarAction(host, { ...ask, id, text }, { subaction: "update_event", eventId: planning.id, timeZone: "UTC", ...change })
  const routes = calendarRoutes(async () => host)
  const patch = routes.find((row) => row.method === "PATCH" && row.path === "/api/lifeops/calendar/events/{eventId}")
  const loud = try tryPromise(() => patch === undefined ? Promise.reject(new Error("There is no update route")) : patch.handler({ parameters: new Map([["eventId", planning.id]]), query: new Map(),
    body: { title: "Loud", notifyAttendees: true, expectedProviderVersion: String(at(quiet.data, "event", "metadata", "etag")), idempotencyKey: "loud-1" } }))
  assert.deepStrictEqual([loud.status, at(loud.body, "code")], [400, "CALENDAR_ATTENDEE_NOTIFICATIONS_UNSUPPORTED"])
  const invited = try guestChange("message-4", "Invite ana@example.com to Sync", { addGuests: ["ana@example.com"] })
  const dropped = try guestChange("message-5", "Remove Sam from Sync", { removeGuests: ["sam"] })
  const guessed = try guestChange("message-6", "Invite Bob to Sync", { addGuests: ["bob@example.com"] })
  const absent = try guestChange("message-7", "Remove Alex from Sync", { removeGuests: ["Alex"] })
  const unnamed = try guestChange("message-8", "Clean up the guest list", { removeGuests: ["ana@example.com"] })
  assert.deepStrictEqual([emails(invited), emails(dropped), guessed.text, absent.text, unnamed.text], [["sam@example.com", "ana@example.com"], ["ana@example.com"],
    "I won't invite bob@example.com: that exact address isn't in your request. Nothing was changed.", "Alex isn't a guest of that event. Nothing was changed.",
    "You didn't name ana@example.com as a guest to remove. Nothing was changed."])
  const lunch = try runCalendarAction(host, { ...ask, id: "message-9", text: "Add lunch with ana@example.com and save it now" },
    { subaction: "create_event", title: "Lunch", startAt: "2030-03-05T19:00:00Z", endAt: "2030-03-05T20:00:00Z", attendees: ["ana@example.com"], timeZone: "UTC", reviewBeforeCreate: false, statedClock: "none" })
  assert.deepStrictEqual(emails(lunch), ["ana@example.com"])
  const selected = try runCalendarAction(host, { ...ask, id: "message-3", text: "Delete this", selected: planning.id }, { subaction: "delete_event", eventId: planning.id, timeZone: "UTC", ownerAnswer: "yes" })
  assert.deepStrictEqual([selected.success, selected.text], [true, "Deleted Sync."])
})

it.effect(`Keep the calendar events I saved before this version (spec/calendar/residentStore.md, "Story: Keep the calendar events I saved before this version"; spec/calendar/residentStore.md, "The earlier events are imported once, exactly, and never over the series rows")`, effect () => {
  const priorKey = "calendar:kv:calendar.resident.agent.resident%3Aagent"
  const rowsKey = "calendar:kv:calendar.resident.rows.agent.resident%3Aagent"
  const saved: CalendarEvent = {
    id: "resident-1", externalId: "resident-1", agentId: "agent", provider: "eliza", side: "owner", calendarId: "primary",
    title: "Dentist", description: "Bring forms", location: "Main St", status: "confirmed", startAt: "2030-03-04T17:00:00.000Z", endAt: "2030-03-04T18:00:00.000Z",
    isAllDay: false, timezone: "America/Los_Angeles", htmlLink: null, conferenceLink: null, organizer: null, attendees: [],
    metadata: { etag: "r3", createdAt: "2030-01-01T00:00:00.000Z" }, syncedAt: "2030-01-02T00:00:00.000Z", updatedAt: "2030-01-02T00:00:00.000Z",
    calendarSummary: "Calendar", connectorAccountId: "resident:agent", grantId: "resident",
  }
  const prior = JSON.stringify({ revision: 3, events: [saved], replays: { "old-key": saved.id } })
  const rows = new Map<string, unknown>([[priorKey, prior]])
  const refused = new Set([rowsKey])
  const window = { timeMin: Date.parse("2030-03-01T00:00:00Z"), timeMax: Date.parse("2030-03-10T00:00:00Z") }
  const crashed = try calendarHost({ cache: memoryCache(rows, refused), agentId: "agent", approvals: () => undefined })
  const unsaved = try crashed.search(window)
  assert.deepStrictEqual([unsaved?.complete, unsaved?.events.length, unsaved?.unavailable, rows.has(rowsKey)], [false, 0, ["eliza"], false])

  refused.clear()
  const first = try calendarHost({ cache: memoryCache(rows, refused), agentId: "agent", approvals: () => undefined })
  const found = try first.search(window)
  assert.deepStrictEqual(found?.events.map((event) => [event.id, event.title, event.description, event.startAt, event.timezone, event.metadata.etag]),
    [["resident-1", "Dentist", "Bring forms", "2030-03-04T17:00:00.000Z", "America/Los_Angeles", "r3"]])
  const receipt = at(try Effect.try(() => JSON.parse(String(rows.get(rowsKey)))), "imported")
  assert.deepStrictEqual([at(receipt, "format"), at(receipt, "revision"), at(receipt, "events")], ["resident-events-1", 3, 1])
  const moved = try runCalendarAction(first, { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "" }, { subaction: "update_event", eventId: "resident-1", title: "Dentist moved" })
  assert.deepStrictEqual([moved.success, at(moved.data, "targetEvent", "metadata", "etag")], [true, "r3"])

  const rerun = try calendarHost({ cache: memoryCache(rows, refused), agentId: "agent", approvals: () => undefined })
  assert.deepStrictEqual((try rerun.search(window))?.events.map((event) => event.title), ["Dentist moved"])
  assert.strictEqual(rows.get(priorKey), prior)

  const broken = new Map<string, unknown>([[priorKey, JSON.stringify({ revision: 3, events: [{ id: "resident-1" }], replays: {} })]])
  const review = try calendarHost({ cache: memoryCache(broken), agentId: "agent", approvals: () => undefined })
  const held = try review.search(window)
  assert.deepStrictEqual([held?.complete, held?.events.length, held?.unavailable], [false, 0, ["eliza"]])
  const blocked = try runCalendarAction(review, { by: "owner-entity", conversation: "room:owner", id: "message-2", text: "" }, { subaction: "create_event", title: "New", startAt: "2030-03-05T17:00:00Z", endAt: "2030-03-05T18:00:00Z", reviewBeforeCreate: false, statedClock: "none" })
  assert.deepStrictEqual([blocked.success, broken.has(rowsKey)], [false, false])
})

it.effect(`A read with no connected calendar account says that none is connected, beside what the agent's own calendar holds (spec/calendar/actions.md, "A read with no connected calendar account says that none is connected, never only that the calendar is empty")`, effect () => {
  try TestClock.setTime(Date.parse("2030-03-03T20:00:00Z"))
  const host = try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => undefined })
  const ask = { by: "owner-entity", conversation: "room:owner", id: "today", text: "What's on my calendar today?", ownerZone: "UTC" }
  const today = { subaction: "search_events", date: "2030-03-04", timeZone: "UTC" }
  const free = { subaction: "check_availability", timeMin: "2030-03-04T09:00:00Z", timeMax: "2030-03-04T10:00:00Z", timeZone: "UTC" }
  const notConnected = " No calendar account is connected, so only the agent's own calendar was read."
  const read = effect (parameters: Record<string, unknown>) => {
    const result = try runCalendarAction(host, ask, parameters)
    return { text: result.text, connection: at(result.data, "connection"), events: at(result.data, "events", "length") }
  }

  const empty = try read(today)
  const unbookedHour = try read(free)
  const dentist = try runCalendarAction(host, { ...ask, id: "dentist" }, { subaction: "create_event", title: "Dentist", startAt: "2030-03-04T15:00:00Z", endAt: "2030-03-04T16:00:00Z", timeZone: "UTC", reviewBeforeCreate: false, statedClock: "none" })
  const residentEvent = try read(today)
  const google = googleCalendar()
  try host.register(google.port)
  try host.bindAccount(owner)
  const connected = try read(today)
  const connectedFree = try read(free)
  const context = effect (calendar: typeof host) => {
    const service = new CalendarService(undefined, calendar)
    const runtime = { getService: (type: string) => type === calendarServiceType ? service : null } as unknown as IAgentRuntime
    const shown = try tryPromise(() => Promise.resolve(calendarProvider.get(runtime, { content: { text: ask.text } } as Memory, { values: {}, data: {}, text: "" })))
    return { text: shown.text, connection: at(shown.data, "connection") }
  }
  const contextUnconnected = try context(try calendarHost({ cache: memoryCache(), agentId: "agent", approvals: () => undefined }))
  const contextConnected = try context(host)

  assert.deepStrictEqual({ empty, unbookedHour, created: dentist.success, residentEvent: [residentEvent.connection, residentEvent.events, (residentEvent.text ?? "").endsWith(notConnected)], connected, connectedFree, contextUnconnected, contextConnected }, {
    empty: { text: `No events match in that range.${notConnected}`, connection: "none", events: 0 },
    unbookedHour: { text: `You're free Mon, Mar 4, 9:00\u2009\u2013\u200910:00 AM UTC.${notConnected}`, connection: "none", events: undefined },
    created: true,
    residentEvent: ["none", 1, true],
    connected: { text: "No events match in that range.", connection: "connected", events: 0 },
    connectedFree: { text: "You're free Mon, Mar 4, 9:00\u2009\u2013\u200910:00 AM UTC.", connection: "connected", events: undefined },
    contextUnconnected: { text: `No calendar events in the next 24 hours.${notConnected}`, connection: "none" },
    contextConnected: { text: "No calendar events in the next 24 hours.", connection: "connected" },
  })
})
