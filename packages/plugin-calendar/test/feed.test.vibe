// spec/calendar/managedFeed.md, "Story: Read the connected Calendar and keep its source information intact"; spec/calendar/managedFeed.md, "Story: Show one checked copy of a mapped event after a provider read"; spec/calendar/managedFeed.md, "Story: Keep each cached copy under its own source and its provider's edit time"; spec/calendar/aggregateMerge.md, "Story: See one occurrence with its precise source evidence"; spec/calendar/actions.md, "The managed Google calendar is read and changed as one of the active account's calendars"
import { assert, it } from "@effect/vitest"
import type { CloudLinkReply, CloudLinkRequest } from "@elizaos/agent-host"
import { type CalendarEvent, type CalendarSummary, cloudCalendar, managedEventId, managedFeed, mergeFeedEvents, parseManagedGoogleCalendarFeed, type PurgeRefused, type AggregatePorts, type CalendarLinkRecord, type FeedComponent, type ImportedSourceScope, type ManagedCacheStore } from "@elizaos/plugin-calendar-client"
import { calendarHost, runCalendarAction, type CalendarApprovalRow } from "../src/index.vibe"
import { memoryCache } from "./support/memory-cache.ts"

const api = "/api/v1/eliza/google"
const grant = "0f6c2a5e-8b1d-4c3a-9e7f-2a4b6c8d0e1f"
const otherGrant = "7d3e1b9a-5c2f-4a6e-8b0d-1f3a5c7e9b2d"
const window = { timeMin: "2026-11-23T08:00:00.000Z", timeMax: "2026-11-24T08:00:00.000Z", timeZone: "America/Los_Angeles" }
const syncedAt = "2026-11-22T12:00:00.000Z"
const self = { email: "owner@example.com", displayName: null, self: true }

const sourceOf = (grantId: string, calendarId: string): CalendarSummary => ({
  provider: "google", side: "owner", grantId, connectorAccountId: grantId, calendarId, accountEmail: null, summary: calendarId,
  description: null, primary: calendarId === "work", accessRole: "owner", timeZone: window.timeZone, selected: true, includeInFeed: true,
})
const work = sourceOf(grant, "work")

const accounts = (grants: readonly string[]) => grants.map((connectionId) => ({
  provider: "google", side: "owner", connected: true, connectionId, identity: { email: "owner@example.com" },
  grantedCapabilities: ["google.basic_identity", "google.calendar.read", "google.calendar.write"],
}))
const calendarRow = (calendarId: string, patch: Record<string, unknown> = {}) => ({
  calendarId, accountId: "subject-1", accountEmail: "owner@example.com", label: calendarId, accessRole: "owner", read: true, write: true, ...patch,
})
const card = (calendarId: string, externalId: string, metadata: Record<string, unknown>, patch: Record<string, unknown> = {}) => ({
  externalId, calendarId, title: "Standup", description: "", location: "", status: "confirmed", startAt: "2026-11-23T17:00:00.000Z",
  endAt: "2026-11-23T17:30:00.000Z", isAllDay: false, timezone: null, htmlLink: null, conferenceLink: null, etag: null, seriesId: null,
  organizer: null, attendees: [], metadata, ...patch,
})
const feedBody = (calendarId: string, events: readonly unknown[], patch: Record<string, unknown> = {}) => ({ calendarId, events, syncedAt, ...patch })
const answered = (body: unknown, status = 200): CloudLinkReply => ({ kind: "answered", status, body })
const cloudRefused = (status: number, body: unknown): CloudLinkReply => ({ kind: "refused", status, body })
const editsOff: CloudLinkReply = { kind: "changes-off", operation: "calendar_edit" }

type Call = { readonly method: string; readonly path: string; readonly body?: unknown; readonly idempotencyKey?: string; readonly ifMatch?: string }

const param = (call: Call, name: string) => new URLSearchParams(call.path.split("?")[1] ?? "").get(name)

function cloudFake(answer: (call: Call) => CloudLinkReply!!) {
  const calls: Call[] = []
  const link = {
    request: (request: CloudLinkRequest) => runPromise(effect {
      const call: Call = { method: request.method, path: request.path, ...(request.body === undefined ? {} : { body: request.body }),
        ...(request.idempotencyKey === undefined ? {} : { idempotencyKey: request.idempotencyKey }), ...(request.ifMatch === undefined ? {} : { ifMatch: request.ifMatch }) }
      calls.push(call)
      return try answer(call)
    }),
  }
  return { calls, link }
}

function memoryStore(log: string[]) {
  const rows = new Map<string, CalendarEvent>()
  const plansRemoved: string[] = []
  const inScope = (event: CalendarEvent, scope: ImportedSourceScope) => event.provider === scope.provider && event.side === scope.side && event.grantId === scope.grantId
  const store: ManagedCacheStore = {
    find: (id) => sync(() => rows.get(id)),
    save: (events) => sync(() => {
      for (const event of events) rows.set(event.id, event)
      log.push(`saved:${events.map((event) => event.calendarId).join(",")}`)
    }),
    eventsFor: (scope) => sync(() => [...rows.values()].filter((event) => inScope(event, scope))),
    removeReminderPlans: (ids) => sync(() => { plansRemoved.push(...ids); log.push("reminders") }),
    removeProjection: (scope) => sync(() => {
      const gone = [...rows.values()].filter((event) => inScope(event, scope) && event.connectorAccountId === scope.connectorAccountId)
      for (const event of gone) rows.delete(event.id)
      log.push("removed")
      return gone.length
    }),
  }
  return { rows, plansRemoved, store }
}

const residentBase: CalendarEvent = {
  id: "local-1", externalId: "local-1", agentId: "agent", provider: "eliza", side: "owner", calendarId: "resident", title: "Standup",
  description: "", location: "", status: "confirmed", startAt: "2026-11-23T17:00:00.000Z", endAt: "2026-11-23T17:30:00.000Z",
  isAllDay: false, timezone: null, htmlLink: null, conferenceLink: null, organizer: null, attendees: [], metadata: { version: "r1" },
  syncedAt, updatedAt: "2026-11-21T09:00:00.000Z", grantId: "resident", connectorAccountId: "resident",
}
const resident: CalendarSummary = { ...sourceOf("resident", "resident"), provider: "eliza" }

it.effect(`Read only the exact selected calendar and window through the cloud link, cache it under its own identity and its provider edit time (spec/calendar/managedFeed.md, "Story: Read the connected Calendar and keep its source information intact"; spec/calendar/managedFeed.md, "The resident accepts only a whole Cloud answer for the exact selected calendar"; spec/calendar/managedFeed.md, "A cache write for another identity leaves the stored copy unchanged"; spec/calendar/managedFeed.md, "An event's change time is the provider's edit time, never the refresh time")`, effect () => {
  const mode: { feed: CloudLinkReply; calendars: CloudLinkReply } = {
    feed: answered(feedBody("work", [card("work", "e1", { updatedAt: "2026-11-20T10:00:00.000Z" }, { etag: "\"2\"" })])),
    calendars: answered([calendarRow("work"), calendarRow("busy", { accessRole: "freeBusyReader", read: false, write: false }), calendarRow("shared", { write: false })]),
  }
  const cloud = cloudFake((call) => sync(() => {
    if (call.path === `${api}/accounts`) {
      return answered([...accounts([grant]), { connected: false, connectionId: otherGrant, grantedCapabilities: ["google.calendar.read"] },
        { connected: true, connectionId: "mail-only", grantedCapabilities: ["google.gmail.triage"] }])
    }
    return call.path.startsWith(`${api}/calendar/calendars?`) ? mode.calendars : mode.feed
  }))
  const log: string[] = []
  const { rows, store } = memoryStore(log)
  try scoped(effect {
    const client = cloudCalendar(cloud.link)
    const feed = try managedFeed({ agentId: "agent", broker: client, store })
    const listed = try client.sources()
    assert.deepEqual(listed.map((source) => [source.calendarId, source.grantId, source.accessRole, source.googleAccountId]),
      [["work", grant, "owner", "subject-1"], ["shared", grant, "reader", "subject-1"]])
    assert.deepEqual(cloud.calls.map((call) => call.path), [`${api}/accounts`, `${api}/calendar/calendars?grantId=${grant}`])

    const e1 = managedEventId(grant, "work", "e1")
    const read = try feed.read(work, window)
    assert.deepEqual(read.events.map((event) => [event.id, event.agentId, event.updatedAt, event.metadata.etag]), [[e1, "agent", "2026-11-20T10:00:00.000Z", "\"2\""]])
    assert.equal(cloud.calls[2]?.path, `${api}/calendar/feed?${new URLSearchParams({ grantId: grant, calendarId: "work", expectedAccountId: "subject-1", ...window }).toString()}`)
    assert.equal(rows.get(e1)?.calendarId, "work")

    const created = "2026-11-21T10:00:00.000Z"
    mode.feed = answered(feedBody("work", [
      card("work", "e2", { iCalUID: null, createdAt: null, updatedAt: null }),
      card("work", "e2-created", { createdAt: created, updatedAt: null }),
      card("work", "e2-unreadable", { updatedAt: 42, createdAt: created }),
    ]))
    assert.deepEqual((try feed.read(work, window)).events.map(({ externalId, updatedAt }) => [externalId, updatedAt]), [
      ["e2", ""], ["e2-created", created], ["e2-unreadable", ""],
    ])

    const e3 = managedEventId(grant, "work", "e3")
    rows.set(e3, { ...residentBase, id: e3, provider: "google", calendarId: "personal", grantId: grant, connectorAccountId: grant })
    mode.feed = answered(feedBody("work", [card("work", "e3", { createdAt: "2026-11-01T00:00:00.000Z" })]))
    assert.deepEqual((try feed.read(work, window)).events, [])
    assert.equal(rows.get(e3)?.calendarId, "personal")

    const refusal = (reply: CloudLinkReply) => {
      mode.feed = reply
      return map(Effect.flip(feed.read(work, window)), (failure) => failure._tag === "ManagedCalendarUnavailable" ? [failure.stage, failure.httpStatus] : [failure._tag, null])
    }
    assert.deepEqual(try refusal(answered(feedBody("home", []))), ["schema", 200])
    assert.deepEqual(try refusal(answered(feedBody("work", [], { truncated: true }))), ["schema", 200])
    assert.deepEqual(try refusal(answered(feedBody("work", [], { nextPageToken: "more" }))), ["schema", 200])
    assert.deepEqual(try refusal(answered(feedBody("work", [card("home", "e4", {})]))), ["schema", 200])
    assert.deepEqual(try refusal(answered(feedBody("work", [card("work", "e5", {}), card("work", "e5", {})]))), ["schema", 200])
    assert.deepEqual(try refusal(cloudRefused(409, { error: "google_reauth_required", retryable: false })), ["http", 409])
    assert.deepEqual(try refusal(answered([])), ["schema", 200])
    const calls = cloud.calls.length
    assert.deepEqual(try map(Effect.flip(feed.read(sourceOf(otherGrant, "work"), window)), (failure) => failure._tag === "ManagedCalendarUnavailable" ? failure.stage : failure._tag), "scope")
    assert.equal(cloud.calls.length, calls)

    mode.calendars = answered([calendarRow("work"), calendarRow("work")])
    assert.equal(try map(Effect.flip(client.sources()), (failure) => failure.stage), "schema")
  })
  assert.deepEqual(cloud.calls.filter((call) => call.method !== "GET"), [])
  const cloudFeed = { calendarId: "work", syncedAt, events: [] }
  assert.deepEqual(try parseManagedGoogleCalendarFeed(cloudFeed, "work"), cloudFeed)
  assert.equal(try map(Effect.flip(parseManagedGoogleCalendarFeed({ ...cloudFeed, truncated: true }, "work")), (failure) => failure._tag), "ManagedGoogleWireInvalid")
})

function at(value: unknown, ...path: string[]): unknown {
  return path.reduce<unknown>((inner, key) => typeof inner === "object" && inner !== null && key in inner ? (inner as Record<string, unknown>)[key] : undefined, value)
}

it.effect(`Read and change the managed Google calendar beside the resident one through the cloud link (spec/calendar/actions.md, "Story: Ask the agent about my calendar and get my active account's events"; spec/calendar/actions.md, "The managed Google calendar is read and changed as one of the active account's calendars"; spec/calendar/actions.md, "An event is shown only from a listed calendar of the active account")`, effect () => {
  const held = new Map<string, Record<string, unknown>>([["e1", card("work", "e1", {}, { etag: "\"1\"", organizer: self })]])
  const health = { feed: true, edits: true, recurringCreate: false, privateCreate: true }
  const writes: Call[] = []
  const cloud = cloudFake((call) => sync(() => {
    if (call.path === `${api}/accounts`) return answered(accounts([grant]))
    if (call.path.startsWith(`${api}/calendar/calendars?`)) return answered([calendarRow("work", {
      ...(health.recurringCreate ? { recurrenceLines: true } : {}), ...(health.privateCreate ? { privateCreate: true } : {}),
    })])
    if (call.path.startsWith(`${api}/calendar/feed?`)) return health.feed ? answered(feedBody("work", [...held.values()])) : cloudRefused(503, { error: "provider_unavailable", retryable: true })
    const id = call.path.slice(`${api}/calendar/events/`.length).split("?")[0] ?? ""
    if (call.method === "GET") {
      const found = held.get(id)
      return found === undefined ? cloudRefused(404, { error: "not_found", retryable: false }) : answered({ event: found })
    }
    writes.push(call)
    if (!health.edits) return editsOff
    const body = call.body as Record<string, unknown>
    if (call.method === "POST") {
      const made = card("work", `made${writes.length}`, {}, { title: body.title, startAt: body.startAt, endAt: body.endAt, etag: "\"1\"", organizer: self,
        ...(body.recurrence === undefined ? {} : { recurrence: body.recurrence }) })
      held.set(made.externalId, made)
      return answered({ event: made }, 201)
    }
    const before = held.get(id)
    if (before === undefined || before.etag !== call.ifMatch) return cloudRefused(412, { error: "precondition_failed", retryable: false, outcome: "not_accepted" })
    const changed = { ...before, title: body.title, etag: `"${writes.length + 1}"` }
    held.set(id, changed)
    return answered({ event: changed })
  }))
  try scoped(effect {
    const filed: CalendarApprovalRow[] = []
    const host = try calendarHost({ cache: memoryCache(), agentId: "agent", managed: cloudCalendar(cloud.link),
      approvals: () => ({ request: async (row) => { filed.push(row); return { id: row.id, state: "pending" } } }) })
    const account = try host.active()
    if (account === undefined) return
    const e1 = managedEventId(grant, "work", "e1")
    const day = { timeMin: Date.parse(window.timeMin), timeMax: Date.parse(window.timeMax) }
    const read = try host.search(day)
    assert.deepEqual([read?.events.map((event) => [event.id, event.connectorAccountId, event.grantId]), read?.complete, read?.sources.map((source) => [source.key.provider, source.status])],
      [[[e1, account.accountId, grant]], true, [["eliza", "fresh"], ["google", "fresh"]]])

    const ask = { by: "owner-entity", conversation: "room:owner", id: "message-1", text: "", clientZone: "UTC", ownerZone: "America/Los_Angeles" }
    const approve = effect () => {
      const row = filed.at(-1)
      return row === undefined ? { result: "missing", text: "" } : try host.executeApproval({ id: row.id, action: row.action, payload: row.payload })
    }
    const created = try runCalendarAction(host, ask, { subaction: "create_event", calendarId: "work", title: "Review", startAt: "2026-11-23T19:00:00Z", endAt: "2026-11-23T20:00:00Z", timeZone: "UTC", statedClock: "none" })
    assert.deepEqual([created.success, at(filed.at(-1)?.payload.change, "source", "grantId"), (try approve()).result], [true, grant, "ChangeSucceeded"])
    assert.deepEqual([writes[0]?.method, writes[0]?.path, writes[0]?.idempotencyKey, at(writes[0]?.body, "grantId"), at(writes[0]?.body, "expectedAccountId"), at(writes[0]?.body, "title"), at(writes[0]?.body, "timeZone")],
      ["POST", `${api}/calendar/events`, filed.at(-1)?.id, grant, "subject-1", "Review", "UTC"])
    assert.equal(at(writes[0]?.body, "privateCreate"), true)

    const renamed = try runCalendarAction(host, { ...ask, id: "message-2" }, { subaction: "update_event", eventId: e1, title: "Standup, moved" })
    assert.deepEqual([renamed.success, (try approve()).result, held.get("e1")?.title, writes[1]?.method, writes[1]?.path, writes[1]?.ifMatch],
      [true, "ChangeSucceeded", "Standup, moved", "PATCH", `${api}/calendar/events/e1`, "\"1\""])

    health.edits = false
    const blocked = try runCalendarAction(host, { ...ask, id: "message-3" }, { subaction: "update_event", eventId: e1, title: "Standup, again" })
    const off = try approve()
    assert.deepEqual([blocked.success, off.result, off.text, held.get("e1")?.title],
      [true, "ChangeRetryable", "Calendar edits are turned off in Settings › Google accounts. Google stays connected; nothing was changed.", "Standup, moved"])

    const removal = try runCalendarAction(host, { ...ask, id: "message-4", text: "Delete Review" }, { subaction: "delete_event", query: "review", ...window })
    assert.deepEqual([removal.success, at(removal.data, "refusal"), filed.length], [false, "deletes_unsupported", 3])

    health.feed = false
    const kept = try host.search(day)
    assert.deepEqual([kept?.events.map((event) => event.title).sort(), kept?.complete, kept?.sources.map((source) => source.status)], [["Review", "Standup, moved"], false, ["fresh", "stale"]])

    health.feed = true
    health.edits = true
    const series = { subaction: "create_event", calendarId: "work", title: "Piano", startAt: "2030-03-04T17:00:00Z", endAt: "2030-03-04T18:00:00Z", timeZone: "UTC", statedClock: "none",
      repeat: "weekly", repeatUntil: "2030-03-25T17:00:00Z", skipStarts: ["2030-03-11T17:00:00Z"] }
    const beforeSeries = writes.length
    const old = try runCalendarAction(host, { ...ask, id: "message-5" }, series)
    const refused = try approve()
    assert.deepEqual([old.success, at(refused, "failure", "code"), writes.length], [true, "CALENDAR_RECURRENCE_UNSUPPORTED", beforeSeries])
    health.recurringCreate = true
    const current = try runCalendarAction(host, { ...ask, id: "message-6" }, series)
    assert.deepEqual([current.success, (try approve()).result, writes.length, at(writes.at(-1)?.body, "recurrence")],
      [true, "ChangeSucceeded", beforeSeries + 1, ["RRULE:FREQ=WEEKLY;UNTIL=20300325T170000Z", "EXDATE:20300311T170000Z"]])
    const readBack = cloud.calls.filter((call) => call.method === "GET" && call.path.startsWith(`${api}/calendar/events/made`)).at(-1)
    assert.equal(readBack === undefined ? undefined : param(readBack, "expectedAccountId"), "subject-1")
    const parent = managedEventId(grant, "work", `made${writes.length}`)
    const parentEdit = try runCalendarAction(host, { ...ask, id: "message-7" }, { subaction: "update_event", eventId: parent, title: "Entire series", recurrenceScope: "instance" })
    const denied = try approve()
    assert.deepEqual([parentEdit.success, at(denied, "failure", "code"), writes.length], [true, "CALENDAR_MANAGED_SERIES_REVIEW_REQUIRED", beforeSeries + 1])
    health.privateCreate = false
    const olderCloud = try runCalendarAction(host, { ...ask, id: "message-8" }, { subaction: "create_event", calendarId: "work",
      title: "Private lesson", startAt: "2030-03-04T19:00:00Z", endAt: "2030-03-04T20:00:00Z", timeZone: series.timeZone, statedClock: "none" })
    const noPrivacy = try approve()
    assert.deepEqual([olderCloud.success, at(noPrivacy, "failure", "code"), writes.length], [true, "CALENDAR_PRIVATE_CREATE_UNAVAILABLE", beforeSeries + 1])
  })
})

it.effect(`A purge waits for the grant's admitted write, removes exactly its projection, and a later read imports again (spec/calendar/managedFeed.md, "Story: Read the connected Calendar and keep its source information intact"; spec/calendar/managedFeed.md, "A purge drains preexisting writes for its grant before acknowledging local removal")`, effect () => {
  const gate = try Deferred.make<void>()
  const held = { on: true }
  const cloud = cloudFake(effect (call) => {
    if (call.path === `${api}/accounts`) return answered(accounts([grant, otherGrant]))
    if (call.path.startsWith(`${api}/calendar/calendars?`)) return answered([calendarRow("work")])
    const asked = param(call, "grantId")
    if (asked === grant && held.on) try Deferred.await(gate)
    return answered(feedBody("work", [card("work", asked === grant ? "e1" : "e9", {}, { etag: "\"1\"" })]))
  })
  const feedCalls = () => cloud.calls.filter((call) => call.path.startsWith(`${api}/calendar/feed?`)).length
  const log: string[] = []
  const { rows, plansRemoved, store } = memoryStore(log)
  try scoped(effect {
    const client = cloudCalendar(cloud.link)
    try client.sources()
    const feed = try managedFeed({ agentId: "agent", broker: client, store })
    const scope = { provider: "google", side: "owner", grantId: grant, connectorAccountId: grant } as const
    assert.equal(try map(Effect.flip(feed.purge({ ...scope, confirmAction: false })), (failure: PurgeRefused) => failure.reason), "confirmation_required")

    const reading = fork feed.read(work, window)
    while (feedCalls() === 0) try Effect.yieldNow
    const purging = fork feed.purge({ ...scope, confirmAction: true })
    try Effect.yieldNow
    const other = try feed.read(sourceOf(otherGrant, "work"), window)
    assert.equal(other.events.length, 1)
    assert.deepEqual(log, ["saved:work"])
    try Deferred.succeed(gate, undefined)
    assert.equal((try join reading).events.length, 1)
    const receipt = try join purging
    assert.deepEqual(log, ["saved:work", "saved:work", "reminders", "removed"])
    assert.deepEqual([receipt.events, receipt.providerMutation, plansRemoved], [1, false, [managedEventId(grant, "work", "e1")]])
    assert.deepEqual([...rows.values()].map((event) => event.grantId), [otherGrant])

    held.on = false
    assert.equal((try feed.read(work, window)).events.length, 1)
    assert.equal(rows.size, 2)
  })
})

it.effect('Pull an exact clean mapping only after a successful provider read and show it once (spec/calendar/managedFeed.md, "Story: Show one checked copy of a mapped event after a provider read"; spec/calendar/managedFeed.md, "A successful provider feed only offers pull for an exact clean mapping")', effect () => {
  const cloud = cloudFake((call) => sync(() => {
    if (call.path === `${api}/accounts`) return answered(accounts([grant]))
    if (call.path.startsWith(`${api}/calendar/calendars?`)) return answered([calendarRow("work")])
    return answered(feedBody("work", [card("work", "e1", { iCalUID: "uid-1", updatedAt: "2026-11-22T10:00:00.000Z" }, { etag: "\"2\"" })]))
  }))
  const { store } = memoryStore([])
  const state: { local: CalendarEvent; link: CalendarLinkRecord; paused: boolean; answer: "pulled" | "refused"; pulls: number } = {
    local: residentBase,
    link: { id: "link-1", agentId: "agent", localEventId: "local-1", localRevision: "r1", connectorAccountId: grant, providerCalendarId: "work",
      providerEventId: "e1", providerEtag: "\"1\"", state: "clean", pendingOperation: null },
    paused: false,
    answer: "pulled",
    pulls: 0,
  }
  const ports: AggregatePorts = {
    localFeed: () => sync((): FeedComponent => ({ calendar: resident, feed: {
      calendarId: "resident", events: [state.local], source: "synced", state: "complete",
      sources: [{ key: resident, summary: "Resident", accessRole: "owner", status: "fresh", syncedAt }], timeMin: window.timeMin, timeMax: window.timeMax, syncedAt,
    } })),
    links: () => sync(() => [state.link]),
    control: () => sync(() => ({ paused: state.paused, dispatchHeld: false, destination: { connectorAccountId: grant, calendarId: "work" } })),
    recordPolicy: () => true,
    pull: (link) => sync(() => {
      state.pulls += 1
      if (state.answer === "pulled") {
        state.local = { ...state.local, title: "Standup moved", metadata: { version: "r2" } }
        state.link = { ...link, localRevision: "r2", providerEtag: "\"2\"" }
      }
      return state.answer
    }),
  }
  try scoped(effect {
    const client = cloudCalendar(cloud.link)
    try client.sources()
    const feed = try managedFeed({ agentId: "agent", broker: client, store })
    const first = try feed.aggregate([work], window, ports)
    assert.equal(state.pulls, 1)
    assert.equal(first.feed.state, "complete")
    assert.deepEqual(first.feed.events.map((event) => [event.id, event.title]), [["local-1", "Standup moved"]])
    const deduplication = first.feed.events[0]?.metadata.deduplication as { sources: readonly unknown[]; identityVersion: string }
    assert.deepEqual([deduplication.sources.length, deduplication.identityVersion], [2, "canonical-linked-calendar-v1"])

    try feed.aggregate([work], window, ports)
    assert.equal(state.pulls, 1)

    state.link = { ...state.link, providerEtag: "\"1\"" }
    state.paused = true
    try feed.aggregate([work], window, ports)
    assert.equal(state.pulls, 1)

    state.paused = false
    state.answer = "refused"
    const refused = try feed.aggregate([work], window, ports)
    assert.deepEqual([state.pulls, refused.refusedPulls.map((link) => link.id), refused.feed.state], [2, ["link-1"], "complete"])
    assert.equal(refused.feed.events.length, 2)
  })
})

it.effect('Group copies by exact link or portable occurrence and show the ranked copy with every source (spec/calendar/aggregateMerge.md, "Story: See one occurrence with its precise source evidence"; spec/calendar/aggregateMerge.md, "Exact link revisions or portable occurrence identity determine which copies can share a row"; spec/calendar/aggregateMerge.md, "Current mapped local row or ordered provider metadata selects the visible copy")', effect () => {
  const ics: CalendarSummary = { ...sourceOf("ics-grant", "feed"), provider: "ics", accessRole: "reader" }
  const google = sourceOf(grant, "work")
  const { grantId: _grant, connectorAccountId: _account, ...bare } = residentBase
  const copy = (patch: Partial<CalendarEvent>): CalendarEvent => ({ ...bare, provider: "google", ...patch })
  const component = (calendar: CalendarSummary, events: readonly CalendarEvent[]): FeedComponent => ({ calendar, feed: {
    calendarId: calendar.calendarId, events, source: "synced", state: "complete", sources: [], timeMin: window.timeMin, timeMax: window.timeMax, syncedAt,
  } })
  const merged = mergeFeedEvents([
    component(google, [
      copy({ id: "g-lunch", calendarId: "work", title: "Lunch", updatedAt: "2026-11-22T00:00:00.000Z", metadata: { iCalUID: " uid-lunch " } }),
      copy({ id: "g-moved", calendarId: "work", startAt: "2026-11-23T19:00:00.000Z", metadata: { iCalUID: "uid-series", originalStartTime: "2026-11-23T18:00:00.000Z" } }),
      copy({ id: "g-plain", calendarId: "work", title: "Same title", metadata: {} }),
      copy({ id: "b-tie", calendarId: "work", metadata: { iCalUID: "uid-tie" } }),
      copy({ id: "a-tie", calendarId: "work", metadata: { iCalUID: "uid-tie" } }),
    ]),
    component(ics, [
      copy({ id: "i-lunch", provider: "ics", calendarId: "feed", title: "Lunch!", updatedAt: "2026-11-21T00:00:00.000Z", metadata: { icsUid: "uid-lunch" } }),
      copy({ id: "i-series", provider: "ics", calendarId: "feed", startAt: "2026-11-23T18:00:00.000Z", metadata: { icsUid: "uid-series" } }),
      copy({ id: "i-allday", provider: "ics", calendarId: "feed", isAllDay: true, startAt: "2026-11-23T00:00:00.000Z", endAt: "2026-11-24T00:00:00.000Z", metadata: { icsUid: "uid-lunch" } }),
      copy({ id: "i-plain", provider: "ics", calendarId: "feed", title: "Same title", metadata: {} }),
    ]),
  ], [])
  const view = merged.map((event) => {
    const deduplication = event.metadata.deduplication as { sources: readonly { eventId: string }[]; conflictingFields: readonly string[] } | undefined
    return [event.id, deduplication?.sources.map((source) => source.eventId) ?? [], deduplication?.conflictingFields ?? []]
  })
  assert.deepEqual(view.sort((left, right) => String(left[0]).localeCompare(String(right[0]))), [
    ["a-tie", ["a-tie", "b-tie"], []],
    ["g-lunch", ["g-lunch", "i-lunch"], ["title"]],
    ["g-moved", ["g-moved", "i-series"], ["startAt"]],
    ["g-plain", [], []],
    ["i-allday", [], []],
    ["i-plain", [], []],
  ])
  const lunch = merged.find((event) => event.id === "g-lunch")
  assert.deepEqual([lunch?.grantId, lunch?.connectorAccountId, lunch?.calendarSummary], [grant, grant, "work"])
  assert.deepEqual(merged.map((event) => event.startAt), [...merged.map((event) => event.startAt)].sort())
})
