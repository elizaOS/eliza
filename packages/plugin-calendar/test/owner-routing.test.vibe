// spec/calendar/requestRouting.md, "An explicit event change adds Calendar relevance only to its admitted action"; spec/calendar/requestRouting.md, "A private availability request adds Calendar relevance for its own read"
import { assert, it } from "@effect/vitest"
import { calendarPlugin } from "../src/index.vibe"
import { calendarAvailabilityRequest, calendarEventRequest } from "../src/plugin/request-routing.vibe"
import type { AgentPlugin } from "../../agent/src/host/module.vibe"
import { toolCalls, text } from "../../agent/test/support/cloud-fake.ts"
import { call, cloudFake, deviceKey, startInProcess } from "../../agent/test/support/kernel.vibe"

it.effect('Recognize current Calendar words and keep other records out (spec/calendar/requestRouting.md, "An explicit event change adds Calendar relevance only to its admitted action")', effect () => {
  try Effect.try(() => assert.deepStrictEqual([
    calendarEventRequest("Please add a dentist appointment tomorrow."),
    calendarEventRequest("Move the roadshow to 4pm."),
    calendarEventRequest("Push the standup back to 5pm."),
    calendarEventRequest("Delete the calendar event migration planning."),
    calendarEventRequest("删除牙医预约"),
    calendarEventRequest("歯医者を削除して"),
    calendarEventRequest("치과를 삭제해줘"),
    calendarEventRequest("Move the note migration planning to 4pm."),
    calendarEventRequest("Move it to 4pm."),
    calendarEventRequest("Push it back to 5pm."),
    calendarEventRequest("Can you push that back to 4pm?"),
    calendarEventRequest("Move it up to 2pm."),
    calendarEventRequest("Add a meeting in the calendar app on this phone."),
    calendarEventRequest("Delete the meeting notes."),
  ], ["CreateEventIntent", "UpdateEventIntent", "UpdateEventIntent", "DeleteEventIntent", "DeleteEventIntent", "DeleteEventIntent", "DeleteEventIntent",
    "NoEventIntent", "NoEventIntent", "NoEventIntent", "NoEventIntent", "NoEventIntent", "NoEventIntent", "NoEventIntent"]))
  try Effect.try(() => assert.deepStrictEqual([
    calendarAvailabilityRequest("Am I free tomorrow morning and set a 20-minute timer?"),
    calendarAvailabilityRequest("Do I have 20 minutes tomorrow morning?"),
    calendarAvailabilityRequest("Is Friday or tomorrow morning free?"),
    calendarAvailabilityRequest("Find me time for a call tomorrow morning"),
    calendarAvailabilityRequest("Is Chrome free tomorrow?"),
    calendarAvailabilityRequest("Am I free tomorrow on my phone's calendar?"),
  ], [{ tag: "CheckInterval" }, { tag: "FindOpening", minutes: 20 }, { tag: "CheckInterval" },
    { tag: "NeedOpeningLength" }, { tag: "NoAvailability" }, { tag: "NoAvailability" }]))
})

it.live('Use resident Calendar and keep the other work while Contacts is open (spec/calendar/requestRouting.md, "Story: Change a calendar event from the view I am using"; spec/calendar/requestRouting.md, "Story: Check my calendar availability from the view I am using")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const calendar = calendarPlugin()
  const other: AgentPlugin = {
    name: "calendar-contacts-fixture",
    description: "Reads a synthetic local record.",
    actions: [{
      name: "READ_EXTRA_FIXTURE", description: "Read the unrelated synthetic record.",
      contextGate: { contexts: ["general"] },
      validate: async () => true,
      handler: async () => ({ success: true, text: "The other fixture is ready." }),
    }],
  }
  const agent = try startInProcess({
    launch: { callerRole: "owner", backend: { kind: "cloud", origin: cloud.origin }, load: [calendar.name, other.name],
      allowed: ["REPLY", "IGNORE", "NONE", "CALENDAR", "READ_EXTRA_FIXTURE"] },
    frame: { credential: { version: 1, value: deviceKey } },
    bundled: new Map<string, AgentPlugin>([[calendar.name, calendar], [other.name, other]]),
  })

  const title = "歯医者"
  const startAt = "2035-03-04T09:00:00Z"
  const endAt = "2035-03-04T10:00:00Z"
  const opened = try call(agent, { method: "POST", path: "/api/conversations", body: {} })
  if (!("status" in opened) || opened.status !== 201) throw new Error("The fixture conversation did not open")
  const id = (opened.json as { conversation: { id: string } }).conversation.id
  const asked = `Add an event called ${title} on March 4, 2035 at 9am UTC, save it now, and check the other fixture.`
  try Effect.sync(() => cloud.script(toolCalls("",
    { name: "CALENDAR", arguments: { subaction: "create_event", title, startAt, endAt, timeZone: "UTC", reviewBeforeCreate: false } },
    { name: "READ_EXTRA_FIXTURE", arguments: {} },
  ), text("I saved 歯医者 and checked the other fixture.")))
  const reply = try call(agent, {
    method: "POST", path: `/api/conversations/${id}/messages`, body: { text: asked,
      metadata: { observation: { view: "contacts", revision: 1, sensitive: false } } },
  })
  const window = new URLSearchParams({
    timeMin: "2035-03-04T00:00:00Z", timeMax: "2035-03-05T00:00:00Z", timeZone: "UTC",
  })
  const feed = try call(agent, { method: "GET", path: `/api/lifeops/calendar/feed?${window}` })
  const plan = cloud.calls.find(({ path }) => path.endsWith("/chat/completions"))
  const beforeDelete = cloud.calls.length
  try Effect.sync(() => cloud.script(toolCalls("", { name: "CALENDAR", arguments: { subaction: "delete_event", query: title,
    timeMin: "2035-03-04T00:00:00Z", timeMax: "2035-03-05T00:00:00Z" } }), text("歯医者を削除しました。")))
  const deleted = try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`,
    body: { text: "歯医者を削除して", metadata: { observation: { view: "contacts", revision: 2, sensitive: false } } } })
  const afterDelete = try call(agent, { method: "GET", path: `/api/lifeops/calendar/feed?${window}` })
  const deletePlan = cloud.calls.slice(beforeDelete).find(({ path }) => path.endsWith("/chat/completions"))
  const confirmationTitle = "Vet consultation"
  try Effect.sync(() => cloud.script(toolCalls("", { name: "CALENDAR", arguments: {
    subaction: "create_event", title: confirmationTitle, startAt, endAt, timeZone: "UTC", reviewBeforeCreate: false,
  } }), text("I saved the Vet consultation.")))
  const seeded = try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`,
    body: { text: "Add an event called Vet consultation on March 4, 2035 at 9am UTC and save it now." } })
  const availabilityFrom = cloud.calls.length
  try Effect.sync(() => cloud.script(toolCalls("",
    { name: "CALENDAR", arguments: { subaction: "propose_times", durationMinutes: 30,
      timeMin: "2035-03-04T09:00:00Z", timeMax: "2035-03-04T11:00:00Z", timeZone: "UTC" } },
    { name: "CALENDAR", arguments: { subaction: "create_event", title: "Unexpected event", startAt, endAt, reviewBeforeCreate: false } },
    { name: "CALENDAR", arguments: { subaction: "propose_times", durationMinutes: 20,
      timeMin: "2035-03-04T09:00:00Z", timeMax: "2035-03-04T11:00:00Z", timeZone: "UTC" } },
    { name: "READ_EXTRA_FIXTURE", arguments: {} },
  ), text("There is a 20-minute opening starting at 10 AM UTC. The other fixture is ready.")))
  const availability = try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`,
    body: { text: "Do I have 20 minutes on March 4, 2035 from 9am to 11am UTC, and check the other fixture?",
      metadata: { observation: { view: "contacts", revision: 3, sensitive: false } } } })
  const availabilityPlan = cloud.calls.slice(availabilityFrom).find(({ path }) => path.endsWith("/chat/completions"))
  try Effect.sync(() => cloud.script(toolCalls("", { name: "CALENDAR", arguments: {
    subaction: "delete_event", query: "vet", timeMin: "2035-03-04T00:00:00Z", timeMax: "2035-03-05T00:00:00Z",
  } }), text("I found the Vet consultation.")))
  const pending = try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`,
    body: { text: "Cancel the animal appointment.", metadata: { observation: { view: "contacts", revision: 4, sensitive: false } } } })
  const beforeAnswer = cloud.calls.length
  try Effect.sync(() => cloud.script(toolCalls("", { name: "CALENDAR", arguments: { subaction: "answer_delete" } }),
    text("I deleted the Vet consultation.")))
  const confirmed = try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`,
    body: { text: "Yes, delete it.", metadata: { observation: { view: "contacts", revision: 5, sensitive: false } } } })
  const afterAnswer = try call(agent, { method: "GET", path: `/api/lifeops/calendar/feed?${window}` })
  const answerPlan = cloud.calls.slice(beforeAnswer).find(({ path }) => path.endsWith("/chat/completions"))
  if (!("status" in reply) || !("status" in feed) || !("status" in deleted) || !("status" in afterDelete)
    || !("status" in seeded) || !("status" in pending) || !("status" in confirmed) || !("status" in afterAnswer)
    || !("status" in availability)) return try Effect.die(new Error("A signed Calendar fixture route returned no status"))
  try Effect.try(() => {
    assert.include(JSON.stringify(plan?.body), "Use CALENDAR's create_event")
    assert.strictEqual(reply.status, 200)
    assert.strictEqual(feed.status, 200)
    const result = reply.json as { actionResults: readonly { action: string }[] }
    assert.includeMembers(result.actionResults.map(({ action }) => action), ["CALENDAR", "READ_EXTRA_FIXTURE"])
    assert.include(JSON.stringify(feed.json), title)
    assert.include(JSON.stringify(deletePlan?.body), "Use CALENDAR's delete_event")
    assert.strictEqual(deleted.status, 200)
    const deletion = deleted.json as { actionResults: readonly { action: string; data: { deleted?: boolean } }[] }
    assert.isTrue(deletion.actionResults.some(({ action, data }) => action === "CALENDAR" && data.deleted === true))
    assert.strictEqual(afterDelete.status, 200)
    assert.notInclude(JSON.stringify(afterDelete.json), title)
    assert.strictEqual(seeded.status, 200)
    assert.strictEqual(pending.status, 200)
    assert.include((pending.json as { text: string }).text, "Should I delete it?")
    assert.include(JSON.stringify(answerPlan?.body), "Use CALENDAR's answer_delete")
    assert.strictEqual(confirmed.status, 200)
    const confirmation = confirmed.json as { actionResults: readonly { action: string; data: { deleted?: boolean } }[] }
    assert.isTrue(confirmation.actionResults.some(({ action, data }) => action === "CALENDAR" && data.deleted === true))
    assert.strictEqual(afterAnswer.status, 200)
    assert.notInclude(JSON.stringify(afterAnswer.json), confirmationTitle)
    assert.notInclude(JSON.stringify(afterAnswer.json), "Unexpected event")
    assert.strictEqual(availability.status, 200)
    assert.include(JSON.stringify(availabilityPlan?.body), "Use CALENDAR's propose_times for that length")
    const availabilityActions = (availability.json as { actionResults: readonly { action: string; data: {
      slots?: readonly { startAt: string; endAt: string; durationMinutes: number; timeZone: string }[]; executionStatus?: string
    } }[] }).actionResults
    assert.includeMembers(availabilityActions.map(({ action }) => action), ["CALENDAR", "READ_EXTRA_FIXTURE"])
    const calendarSteps = availabilityActions.filter(({ action }) => action === "CALENDAR")
    assert.strictEqual(calendarSteps.filter(({ data }) => data.executionStatus === "not_started").length, 2)
    assert.deepInclude(calendarSteps.find(({ data }) => data.slots !== undefined)?.data.slots ?? [], {
      startAt: "2035-03-04T10:00:00.000Z", endAt: "2035-03-04T10:20:00.000Z", durationMinutes: 20, timeZone: "UTC",
    })
  })
}, 120_000)
