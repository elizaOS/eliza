// spec/calendar/managedFeed.md, "Story: Read the connected Calendar and keep its source information intact"; spec/calendar/managedFeed.md, "The resident accepts only a whole Cloud answer for the exact selected calendar"; spec/calendar/actions.md, "The managed Google calendar is read and changed as one of the active account's calendars"
import type { CloudLinkReply, CloudLinkRequest, CloudLinkService } from "@elizaos/agent"
import { managedCalendarAnswerAccepted, managedCatalogAccepted, type ManagedCalendarAnswer, type ManagedCalendarCall } from "../../gen/calendar__managedFeed.effect.vibe"
import { sourceKeyId, type CalendarEvent, type CalendarEventFields, type CalendarFeed, type CalendarSourceKey, type CalendarSummary } from "../model.vibe"
import { CalendarWriteNotAccepted, CalendarWriteUnconfirmed } from "../mutations/ledger.vibe"
import { providerChangeTime } from "./cache.vibe"
import {
  exactFeedEvents, isManagedGoogleAccounts, isManagedGoogleCalendarRows, isManagedGoogleEventAnswer, isManagedGoogleFeed, isManagedGoogleRefusal,
  type ManagedGoogleCalendarRow, type ManagedGoogleEvent,
} from "./cloud-wire.schema.vibe"

export const managedCalendarRequestTimeout = "30 seconds"

export type BrokerOperation = "sources" | "feed" | "event"

export type BrokerStage = "scope" | "http" | "schema"

export error ManagedCalendarUnavailable { operation: BrokerOperation; stage: BrokerStage; httpStatus: number | null }

export type ManagedCalendarSource = CalendarSummary & { readonly googleAccountId: string }

export interface FeedWindow {
  readonly timeMin: string
  readonly timeMax: string
  readonly timeZone: string
}

export interface ManagedCalendarTarget {
  readonly grantId: string
  readonly calendarId: string
  readonly googleAccountId: string
}

type WriteFailure = CalendarWriteNotAccepted | CalendarWriteUnconfirmed

export interface ManagedCalendarBroker {
  readonly acceptsGrant: (grantId: string) => boolean
  sources(): readonly ManagedCalendarSource[]!ManagedCalendarUnavailable
  feed(source: CalendarSummary, window: FeedWindow, agentId: string): CalendarFeed!ManagedCalendarUnavailable
  event(source: CalendarSourceKey, externalId: string, agentId: string): (CalendarEvent | undefined)!ManagedCalendarUnavailable
  create(target: ManagedCalendarTarget, fields: CalendarEventFields, idempotencyKey: string, agentId: string): CalendarEvent!WriteFailure
  change(target: ManagedCalendarTarget, externalId: string, revision: string, fields: CalendarEventFields, agentId: string): CalendarEvent!WriteFailure
}

export type CloudCalendarLink = Pick<CloudLinkService, "request">

const google = "/api/v1/eliza/google"
const calendarRead = "google.calendar.read"
const query = (values: Readonly<Record<string, string>>) => new URLSearchParams(values).toString()
const eventPath = (externalId: string) => `${google}/calendar/events/${encodeURIComponent(externalId)}`

export function managedEventId(grantId: string, calendarId: string, externalId: string): string {
  return `${grantId}:${encodeURIComponent(calendarId)}:${externalId}`
}

export function managedExternalId(source: CalendarSourceKey, eventId: string): string | undefined {
  const prefix = `${source.grantId}:${encodeURIComponent(source.calendarId)}:`
  return eventId.startsWith(prefix) && eventId.length > prefix.length ? eventId.slice(prefix.length) : undefined
}

export function cloudEventOf(card: ManagedGoogleEvent, grantId: string, agentId: string, syncedAt: string): CalendarEvent {
  const metadata = card.etag === undefined || card.etag === null ? card.metadata : { ...card.metadata, etag: card.etag }
  return {
    id: managedEventId(grantId, card.calendarId, card.externalId), externalId: card.externalId, agentId, provider: "google", side: "owner",
    calendarId: card.calendarId, title: card.title, description: card.description, location: card.location, status: card.status,
    startAt: card.startAt, endAt: card.endAt, isAllDay: card.isAllDay, timezone: card.timezone, htmlLink: card.htmlLink,
    conferenceLink: card.conferenceLink, organizer: card.organizer, attendees: card.attendees, metadata, recurrence: null,
    recurringEventId: card.seriesId ?? null, syncedAt, updatedAt: providerChangeTime(metadata) ?? "", grantId, connectorAccountId: grantId,
  }
}

function sourceOf(grantId: string, row: ManagedGoogleCalendarRow): ManagedCalendarSource {
  return {
    provider: "google", side: "owner", grantId, connectorAccountId: grantId, calendarId: row.calendarId,
    accountEmail: row.accountEmail === "" ? null : row.accountEmail, summary: row.label === "" ? row.calendarId : row.label, description: null,
    primary: row.calendarId === row.accountEmail, accessRole: row.write ? row.accessRole : "reader", timeZone: null, selected: true,
    includeInFeed: true, googleAccountId: row.accountId,
  }
}

const day = (instant: string) => instant.slice(0, 10)
const nextDay = (instant: string) => new Date(Date.parse(`${day(instant)}T00:00:00.000Z`) + 86_400_000).toISOString().slice(0, 10)

function eventBody(fields: CalendarEventFields): Readonly<Record<string, unknown>> {
  const timing = fields.isAllDay
    ? { allDay: true, startAt: day(fields.startAt), endAt: day(fields.endAt) > day(fields.startAt) ? day(fields.endAt) : nextDay(fields.startAt) }
    : { startAt: fields.startAt, endAt: fields.endAt, ...(fields.timeZone === "" ? {} : { timeZone: fields.timeZone }) }
  return { title: fields.title, description: fields.description, location: fields.location, ...timing,
    ...(fields.attendees === undefined ? {} : { attendees: fields.attendees.map((email) => ({ email })) }) }
}

function statusOf(reply: CloudLinkReply): number {
  return reply.kind === "changes-off" ? 403 : reply.status
}

function answerOf(reply: CloudLinkReply, facts: Pick<ManagedCalendarAnswer, "shapeValid"> & Partial<ManagedCalendarAnswer>): ManagedCalendarAnswer {
  return { grantListed: true, answered: reply.kind === "answered", exactCalendar: true, exactEvents: true, ...facts }
}

export function cloudCalendar(link: CloudCalendarLink): ManagedCalendarBroker {
  let listedGrants = new Set<string>()
  const acceptsGrant = (grantId: string) => listedGrants.has(grantId)
  const notAccepted = (code: string, message: string, retryable: boolean) => new CalendarWriteNotAccepted({ failure: { code, message, retryable } })
  const unconfirmed = (code: string, message: string) => new CalendarWriteUnconfirmed({ failure: { code, message, retryable: false } })
  const unknownWrite = () => unconfirmed("CALENDAR_MANAGED_WRITE_UNKNOWN", "The managed calendar did not confirm the change, so check it before trying again.")

  effect function ask(operation: BrokerOperation, request: CloudLinkRequest): CloudLinkReply!ManagedCalendarUnavailable {
    const lost = new ManagedCalendarUnavailable({ operation, stage: "http", httpStatus: null })
    return timeout(tryPromise({ try: (signal) => link.request({ ...request, signal }), catch: () => lost }), managedCalendarRequestTimeout) catch effect () => { throw lost }
  }

  effect function admit(operation: BrokerOperation, kind: ManagedCalendarCall, reply: CloudLinkReply, answer: ManagedCalendarAnswer): void!ManagedCalendarUnavailable {
    if (managedCalendarAnswerAccepted(kind, answer)) return
    throw new ManagedCalendarUnavailable({ operation, stage: !answer.grantListed ? "scope" : !answer.answered ? "http" : "schema", httpStatus: statusOf(reply) })
  }

  effect function written(target: ManagedCalendarTarget, reply: CloudLinkReply, agentId: string): CalendarEvent!WriteFailure {
    switch (reply.kind) {
      case "changes-off":
        throw notAccepted("CALENDAR_MANAGED_EDITS_OFF", "Calendar edits are turned off in Settings › Google accounts. Google stays connected; nothing was changed.", false)
      case "refused": {
        const refusal = isManagedGoogleRefusal(reply.body) ? reply.body : undefined
        if (refusal?.outcome !== "not_accepted") throw unknownWrite()
        if (refusal.error === "precondition_failed") throw notAccepted("CALENDAR_TARGET_CHANGED", "The event changed in Google Calendar since it was reviewed. Nothing was changed.", false)
        throw notAccepted("CALENDAR_MANAGED_REFUSED", "The managed Google calendar refused the change before taking it. Nothing was changed.", refusal.retryable)
      }
      case "answered": {
        const event = isManagedGoogleEventAnswer(reply.body) && reply.body.event.calendarId === target.calendarId ? reply.body.event : undefined
        if (event === undefined) throw unconfirmed("CALENDAR_MANAGED_RESULT_INVALID", "The managed calendar's answer did not name the changed event, so the change is unconfirmed.")
        return cloudEventOf(event, target.grantId, agentId, "")
      }
    }
  }

  effect function send(request: CloudLinkRequest): CloudLinkReply!CalendarWriteUnconfirmed {
    return ask("event", request) catch effect () => { throw unknownWrite() }
  }

  return {
    acceptsGrant,

    effect sources() {
      const accounts = try ask("sources", { method: "GET", path: `${google}/accounts` })
      const known = accounts.kind === "answered" && isManagedGoogleAccounts(accounts.body) ? accounts.body : undefined
      try admit("sources", "CalendarSourcesCall", accounts, answerOf(accounts, { shapeValid: known !== undefined }))
      const grants = (known ?? []).flatMap((account) => account.connected && account.connectionId !== null && account.grantedCapabilities.includes(calendarRead) ? [account.connectionId] : [])
      const rows: ManagedCalendarSource[] = []
      for (const grantId of grants) {
        const reply = try ask("sources", { method: "GET", path: `${google}/calendar/calendars?${query({ grantId })}` })
        const listed = reply.kind === "answered" && isManagedGoogleCalendarRows(reply.body) ? reply.body : undefined
        const once = listed !== undefined && new Set(listed.map((row) => row.calendarId)).size === listed.length
        try admit("sources", "CalendarSourcesCall", reply, answerOf(reply, { shapeValid: once }))
        rows.push(...(listed ?? []).filter((row) => row.read).map((row) => sourceOf(grantId, row)))
      }
      if (!managedCatalogAccepted(rows.length, new Set(rows.map(sourceKeyId)).size === rows.length)) {
        throw new ManagedCalendarUnavailable({ operation: "sources", stage: "schema", httpStatus: 200 })
      }
      listedGrants = new Set(rows.map((row) => row.grantId))
      return rows
    },

    effect feed(source, window, agentId) {
      if (!acceptsGrant(source.grantId)) throw new ManagedCalendarUnavailable({ operation: "feed", stage: "scope", httpStatus: null })
      const reply = try ask("feed", { method: "GET", path: `${google}/calendar/feed?${query({ grantId: source.grantId, calendarId: source.calendarId, ...window })}` })
      const answered = reply.kind === "answered" && isManagedGoogleFeed(reply.body) ? reply.body : undefined
      try admit("feed", "CalendarFeedCall", reply, answerOf(reply, {
        shapeValid: answered !== undefined,
        exactCalendar: answered?.calendarId === source.calendarId,
        exactEvents: answered !== undefined && exactFeedEvents(answered.events, source.calendarId),
      }))
      const syncedAt = answered?.syncedAt ?? ""
      const key = { provider: source.provider, side: source.side, grantId: source.grantId, connectorAccountId: source.connectorAccountId, calendarId: source.calendarId }
      const feed: CalendarFeed = {
        calendarId: source.calendarId,
        events: (answered?.events ?? []).map((event) => cloudEventOf(event, source.grantId, agentId, syncedAt)),
        source: "synced",
        state: "complete",
        sources: [{ key, summary: source.summary, accessRole: source.accessRole, status: "fresh", syncedAt }],
        timeMin: window.timeMin,
        timeMax: window.timeMax,
        syncedAt,
      }
      return feed
    },

    effect event(source, externalId, agentId) {
      if (!acceptsGrant(source.grantId)) throw new ManagedCalendarUnavailable({ operation: "event", stage: "scope", httpStatus: null })
      const reply = try ask("event", { method: "GET", path: `${eventPath(externalId)}?${query({ grantId: source.grantId, calendarId: source.calendarId })}` })
      if (reply.kind === "refused" && reply.status === 404) return undefined
      const card = reply.kind === "answered" && isManagedGoogleEventAnswer(reply.body) ? reply.body.event : undefined
      try admit("event", "CalendarOtherCall", reply, answerOf(reply, { shapeValid: card?.calendarId === source.calendarId && card.externalId === externalId }))
      return card === undefined ? undefined : cloudEventOf(card, source.grantId, agentId, "")
    },

    effect create(target, fields, idempotencyKey, agentId) {
      const reply = try send({ method: "POST", path: `${google}/calendar/events`, idempotencyKey,
        body: { grantId: target.grantId, calendarId: target.calendarId, expectedAccountId: target.googleAccountId, ...eventBody(fields) } })
      return try written(target, reply, agentId)
    },

    effect change(target, externalId, revision, fields, agentId) {
      const reply = try send({ method: "PATCH", path: eventPath(externalId), ifMatch: revision,
        body: { grantId: target.grantId, calendarId: target.calendarId, expectedAccountId: target.googleAccountId, ...eventBody(fields) } })
      return try written(target, reply, agentId)
    },
  }
}
