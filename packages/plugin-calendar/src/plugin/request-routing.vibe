// spec/calendar/requestRouting.md, "An explicit event change adds Calendar relevance only to its admitted action"; spec/calendar/requestRouting.md, "A private availability request adds Calendar relevance for its own read"
import type { IAgentRuntime, Memory } from "@elizaos/core"
import { deviceTurnFor } from "@elizaos/agent/device-actions"
import { availabilityCallAdmitted, canAddEventContext, denseCalendarDeleteContext, residentAvailabilityIntent, type AvailabilityIntent, type CalendarIntent } from "../../gen/calendar__requestRouting.ts"
import { namesCalendarDate } from "../clock.vibe"
import { denseDeleteTarget, statedLengths } from "../request-time.vibe"
import { bindCalendarDeleteAnswer, calendarAsk, isDeleteAnswerCall } from "./actions.vibe"
import { phoneAvailabilityOffered } from "./device-proposals.vibe"

// "please", "can you", "hey, could you please".
const COURTESY = String.raw`^(?:(?:hey|hi|ok|okay)[,.!]?\s+)?(?:please,?\s+)?(?:(?:can|could|would|will)\s+you\s+(?:please\s+)?)?`
const EVENT_NOUN = String.raw`(?:calendar\s+)?(?:event|appointment|meeting|calendar\s+entry)s?`
// Up to three describing words before the noun ("a dentist appointment", "my
// 3pm meeting"); a preposition ends them, so "add Sam to the meeting" is an
// attendee change, not a new event.
const DESCRIBING = String.raw`((?:(?!(?:to|from|for|with|on|in|at|into|onto|of)\b)[\p{L}\p{N}'’:.-]+\s+){0,3}?)`
const DETERMINER = String.raw`(?:(?:a|an|the|my|one|this|that|our)\s+)?`
const CREATE_VERB = String.raw`(?:add|create|make|schedule|book|put|set\s+up|plan|new)`
const CREATE_EVENT = new RegExp(
  `${COURTESY}${CREATE_VERB}\\s+${DETERMINER}(?:new\\s+)?${DESCRIBING}${EVENT_NOUN}\\b(.*)$`,
  "isu",
)
// "add v613 check to my calendar", "put lunch with Sam on the calendar".
const CREATE_ON_CALENDAR = new RegExp(
  `${COURTESY}(?:add|put|schedule|book)\\s+(\\S[\\s\\S]*?)\\s+(?:to|on|in|onto|into)\\s+(?:my|the|our)\\s+calendar\\b`,
  "iu",
)
const DELETE_VERB = String.raw`(?:delete|remove|cancel|clear|drop|erase)`
const DELETE_EVENT = new RegExp(
  `${COURTESY}${DELETE_VERB}\\s+${DETERMINER}${DESCRIBING}${EVENT_NOUN}\\b(.*)$`,
  "isu",
)
// "take v613 check off my calendar", "remove lunch from the calendar".
const DELETE_FROM_CALENDAR = new RegExp(
  `${COURTESY}(?:delete|remove|take|clear|drop)\\s+(\\S[\\s\\S]*?)\\s+(?:off|from|out\\s+of)\\s+(?:my|the|our)\\s+calendar[.!?]*$`,
  "iu",
)
const DAY = String.raw`(?:today|tonight|tomorrow|(?:this|next)\s+(?:week|monday|tuesday|wednesday|thursday|friday|saturday|sunday)|(?:on\s+)?(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday))`
// A written clock time: "4pm", "4:30", "10 a.m.", "noon". A bare number
// ("change my status to 5") is not one.
const CLOCK = String.raw`(?:\d{1,2}(?::\d{2})?\s*(?:a\.?m\.?|p\.?m\.?)|\d{1,2}:\d{2}|noon|midnight)`
const WHEN = String.raw`(?:${DAY}(?:\s+(?:at\s+)?${CLOCK})?|${CLOCK}(?:\s+${DAY})?)`
// "move v613 check to 4pm", "reschedule the standup to tomorrow at 10".
const MOVE_EVENT = new RegExp(
  `${COURTESY}(?:move|reschedule|push(?:\\s+back)?|shift|bump|change)\\s+(\\S[\\s\\S]*?)\\s+(?:to|until|till|for)\\s+${WHEN}(?:,?\\s+(?:please|now|instead))?[.!?]*$`,
  "iu",
)
// Things other than events that the same verbs act on in this phone's apps.
const NOT_AN_EVENT =
  /\b(?:notes?|files?|folders?|reminders?|alarms?|timers?|contacts?|tabs?|photos?|pictures?|images?|videos?|albums?|messages?|texts?|emails?|mails?|tasks?|to-?dos?|workflows?|apps?|icons?|widgets?|windows?|songs?|tracks?|playlists?|wallpaper|brightness|volume|settings?|lists?|line|lines)\b/iu
// An event word that only describes another record: "the meeting notes",
// "a meeting link", "the appointment reminder".
const EVENT_ATTRIBUTE = new RegExp(
  String.raw`^\s*(?:${NOT_AN_EVENT.source.slice(2, -2)}|links?|agendas?|minutes|recordings?|transcripts?|summar(?:y|ies))\b`,
  "iu",
)
// The event word sits inside another record: "delete the meeting from my
// notes", "add an event to my tasks".
const IN_OTHER_RECORD =
  /\b(?:from|in|into|to|on|onto|off)\s+(?:my|the|our|a|an|this|that)\s+(?:[\p{L}\p{N}'’-]+\s+)?(?:notes?|files?|folders?|reminders?|alarms?|timers?|contacts?|tabs?|photos?|albums?|messages?|texts?|emails?|tasks?|to-?dos?|workflows?|lists?|playlists?)\b/iu
// A pronoun ("move it to 4pm") names its target only through the turn's
// history, which the referential effect reroute owns; the target may be an
// alarm, a reminder or a workflow rather than an event.
const PRONOUN = /^(?:it|that|this|them|those|these|that\s+one|this\s+one)(?:\s+(?:all|back|up|forward|ahead|over|out))?$/iu
// Non-event settings the same move/change verbs set to a time.
const NOT_AN_EVENT_TIME =
  /\b(?:status|clocks?|time\s*zone|timezone|thermostat|temperature|wake[\s-]?up|bedtime|sleep|quiet\s+hours|do\s+not\s+disturb|dnd|focus|schedule\s+send)\b/iu

/** True when the matched event words name an event rather than describe another record. */
function namesEvent(describing: string, rest: string): boolean {
  return (
    !NOT_AN_EVENT.test(describing) &&
    !EVENT_ATTRIBUTE.test(rest) &&
    !IN_OTHER_RECORD.test(rest)
  )
}

function eventMatch(pattern: RegExp, request: string): boolean {
  const match = pattern.exec(request)
  return Boolean(match && namesEvent(match[1] ?? "", match[2] ?? ""))
}

function subjectMatch(pattern: RegExp, request: string): boolean {
  const match = pattern.exec(request)
  return Boolean(match && !NOT_AN_EVENT.test(match[1] ?? ""))
}

// The phone's own calendar is the device calendar review, not this route.
const PHONE_CALENDAR =
  /\b(?:phone|device|android|system|os)(?:['’]s)?\s+(?:own\s+)?calendar\b|\bcalendar\s+(?:app\s+)?on\s+(?:this|my|the)\s+(?:phone|device)\b/iu

const PERIOD = String.raw`(?:${DAY}|this\s+(?:morning|afternoon|evening|week)|${CLOCK})`
const LENGTH = String.raw`\d+(?:\.\d+)?\s*(?:minutes?|mins?|hours?|hrs?)`
const availabilityCheck = new RegExp(String.raw`${COURTESY}(?:am\s+i\s+(?:free|available|busy)\b|do\s+i\s+have\s+(?:any\s+)?time\b|do\s+i\s+have\s+(?:anything|a\s+conflict)\s+(?:on|in)\b|check\s+(?:if|whether)\s+i(?:['’]m|\s+am)\s+(?:free|available|busy)\b|is\s+${PERIOD}\b[^!?]*\b(?:free|open|available)\b)`, "iu")
const asksForOpening = new RegExp(String.raw`${COURTESY}(?:(?:find|suggest|look\s+for)\s+(?:me\s+)?(?:some\s+time|time|(?:an?|some)\s+(?:openings?|slots?)|${LENGTH})|do\s+i\s+have\s+(?:${LENGTH}|(?:any\s+)?time\s+for))\b`, "iu")
const hasTimeWindow = new RegExp(String.raw`\b${PERIOD}\b`, "iu")
const separateTask = /(?:[.!?]\s+|\s*,?\s+and\s+(?:also\s+|then\s+)?|\s*,?\s+then\s+)(?=(?:add|am|check|create|do|find|is|look|open|read|send|set|show|start|suggest)\b)/iu

export function calendarAvailabilityRequest(text: string): AvailabilityIntent {
  if (PHONE_CALENDAR.test(text) || text.length > 300) return { tag: "NoAvailability" }
  for (const part of text.trim().split(separateTask)) {
    if (!hasTimeWindow.test(part) && !namesCalendarDate(part)) continue
    const lengths = statedLengths(part)
    if (asksForOpening.test(part)) {
      const minutes = lengths?.length === 1 ? (lengths[0] ?? 0) / 60_000 : 0
      return Number.isInteger(minutes) && minutes >= 5 && minutes <= 480 ? { tag: "FindOpening", minutes } : { tag: "NeedOpeningLength" }
    }
    if (availabilityCheck.test(part)) return { tag: "CheckInterval" }
  }
  return { tag: "NoAvailability" }
}

/**
 * Which Calendar event operation the owner's current message asks for, read
 * from their own words. Requests about other records or the phone's own
 * calendar each have their own admission rules.
 */
export function calendarEventRequest(
  text: string,
): CalendarIntent {
  const request = text.trim()
  if (!request || request.length > 300 || PHONE_CALENDAR.test(request)) return "NoEventIntent"
  const denseDelete = denseCalendarDeleteContext(denseDeleteTarget(request) !== undefined)
  if (denseDelete !== "NoEventIntent") return denseDelete
  if (
    eventMatch(DELETE_EVENT, request) ||
    subjectMatch(DELETE_FROM_CALENDAR, request)
  )
    return "DeleteEventIntent"
  if (
    eventMatch(CREATE_EVENT, request) ||
    subjectMatch(CREATE_ON_CALENDAR, request)
  )
    return "CreateEventIntent"
  const move = MOVE_EVENT.exec(request)
  const subject = (move?.[1] ?? "").trim()
  if (
    move &&
    !PRONOUN.test(subject) &&
    !NOT_AN_EVENT.test(subject) &&
    !NOT_AN_EVENT_TIME.test(subject)
  )
    return "UpdateEventIntent"
  return "NoEventIntent"
}

const requestedOperation = {
  CreateEventIntent: { subaction: "create_event", purpose: "create a calendar event" },
  UpdateEventIntent: { subaction: "update_event", purpose: "change the time of a calendar event" },
  DeleteEventIntent: { subaction: "delete_event", purpose: "delete a calendar event" },
} as const

function eventIntentForCall(subaction: unknown): CalendarIntent {
  if (subaction === "create_event") return "CreateEventIntent"
  if (subaction === "update_event") return "UpdateEventIntent"
  if (subaction === "delete_event") return "DeleteEventIntent"
  return "NoEventIntent"
}

export async function calendarRequestRelevance(runtime: IAgentRuntime, message: Memory, previous?: { readonly askedIn: string; readonly text: string }) {
  if (await bindCalendarDeleteAnswer(runtime, message, previous)) return {
    note: "The owner answered the preceding Calendar delete question. Use CALENDAR's answer_delete with no other parameters.",
    context: "calendar" as const,
    matches: isDeleteAnswerCall,
  }
  const words = calendarAsk(message).text ?? ""
  const intent = calendarEventRequest(words)
  if (intent === "NoEventIntent") {
    const turn = deviceTurnFor(runtime, message)
    const read = residentAvailabilityIntent(calendarAvailabilityRequest(words), turn !== undefined && phoneAvailabilityOffered(turn))
    if (read.tag === "NoAvailability") return undefined
    const note = read.tag === "NeedOpeningLength"
      ? "The owner asked for a Calendar opening. Ask how long the opening should be."
      : read.tag === "CheckInterval"
        ? "The owner asked about Calendar availability. Use CALENDAR's check_availability for the requested interval."
        : `The owner asked for a ${read.minutes}-minute Calendar opening. Use CALENDAR's propose_times for that length in the requested window.`
    return {
      note,
      context: "calendar" as const,
      matches: (params: Readonly<Record<string, unknown>>) => {
        const called: AvailabilityIntent = params.subaction === "check_availability" ? { tag: "CheckInterval" }
          : params.subaction === "propose_times" && typeof params.durationMinutes === "number"
            ? { tag: "FindOpening", minutes: params.durationMinutes } : { tag: "NoAvailability" }
        return availabilityCallAdmitted(read, called, params.calendarId !== undefined)
      },
    }
  }
  const operation = requestedOperation[intent]
  return {
    note: `The owner asked to ${operation.purpose}. Use CALENDAR's ${operation.subaction} for this part of the request and keep the other requested work. The open view is a relevance hint.`,
    context: "calendar" as const,
    matches: (params: Readonly<Record<string, unknown>>) => canAddEventContext(intent, eventIntentForCall(params.subaction)),
  }
}
