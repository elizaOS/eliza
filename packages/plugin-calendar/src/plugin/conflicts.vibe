// spec/calendar/autoJoin.md, "Story: Detect calendar conflicts honestly and schedule meeting auto-join by policy"; spec/calendar/autoJoin.md, "Conflict scans classify overlap severity and require complete reads to be definitive"
import { showsApp } from "@elizaos/agent-host"
import {
  OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  type Action, type ActionResult, type ProviderDataRecord,
} from "@elizaos/core"
import type { CalendarEvent } from "@elizaos/plugin-calendar-client"
import { classifyPairConflict, conflictScanDefinitive, type ConflictSeverity } from "../../gen/calendar__autoJoin.effect.vibe"
import { calendarContext, calendarServiceOf } from "./actions.vibe"
import type { CalendarHost, CalendarSearchResult } from "./host.vibe"

export const conflictDetectActionName = "CONFLICT_DETECT"

export type ConflictSeverityName = "none" | "back_to_back" | "hard_overlap"

export interface ConflictEventSummary {
  readonly id: string
  readonly title: string
  readonly startAt: string
  readonly endAt: string
  readonly calendarId: string
}

export interface CalendarConflictPair {
  readonly severity: "back_to_back" | "hard_overlap"
  readonly first: ConflictEventSummary
  readonly second: ConflictEventSummary
  readonly gapMinutes: number
}

export interface ConflictScanReport {
  readonly severity: ConflictSeverityName
  readonly definitive: boolean
  readonly completeness: "complete" | "partial" | "none"
  readonly totalSources: number
  readonly unreadSources: number
  readonly checkedEvents: number
  readonly ignoredEvents: number
  readonly conflicts: readonly CalendarConflictPair[]
}

const dayMs = 86_400_000
const bufferMs = 300_000
const conflictSubactions = ["scan_event_proposal", "scan_today", "scan_week"] as const

const ConflictParams = Schema.Struct({
  calendarId: Schema.optionalKey(Schema.String),
  endAt: Schema.optionalKey(Schema.String),
  startAt: Schema.optionalKey(Schema.String),
  subaction: Schema.Literals(conflictSubactions),
  title: Schema.optionalKey(Schema.String),
})
const decodeConflictParams = Schema.decodeUnknownOption(ConflictParams)

const severityWire: Readonly<Record<ConflictSeverity, ConflictSeverityName>> = {
  ConflictNone: "none",
  ConflictBackToBack: "back_to_back",
  ConflictHardOverlap: "hard_overlap",
}

function isIgnoredForConflict(event: CalendarEvent): boolean {
  if (event.isAllDay || event.status === "cancelled") return true
  if (event.metadata.transparency === "transparent") return true
  return event.attendees.some((attendee) => attendee.self && attendee.responseStatus === "declined")
}

function summarizeEvent(event: CalendarEvent): ConflictEventSummary {
  return {
    id: event.id,
    title: event.title || "(untitled)",
    startAt: event.startAt,
    endAt: event.endAt,
    calendarId: event.calendarId,
  }
}

function comparePair(
  a: ConflictEventSummary,
  aStart: number,
  aEnd: number,
  b: ConflictEventSummary,
  bStart: number,
  bEnd: number,
): CalendarConflictPair | undefined {
  const verdict = severityWire[classifyPairConflict(aStart, aEnd, bStart, bEnd)]
  if (verdict === "none") return undefined
  const gapMs = verdict === "hard_overlap" ? 0 : Math.max(0, bStart >= aEnd ? bStart - aEnd : aStart - bEnd)
  return {
    severity: verdict,
    first: a,
    second: b,
    gapMinutes: Math.round(gapMs / 60_000),
  }
}

export function detectCalendarConflicts(
  events: readonly CalendarEvent[],
  totalSources: number,
  unreadSources: number,
  proposal?: { readonly title?: string; readonly startAt: string; readonly endAt: string },
): ConflictScanReport {
  const checked: { readonly summary: ConflictEventSummary; readonly start: number; readonly end: number }[] = []
  let ignoredEvents = 0
  for (const event of events) {
    const start = Date.parse(event.startAt)
    const end = Date.parse(event.endAt)
    if (isIgnoredForConflict(event) || !Number.isFinite(start) || !Number.isFinite(end) || end <= start) {
      ignoredEvents += 1
      continue
    }
    checked.push({ summary: summarizeEvent(event), start, end })
  }
  const conflicts: CalendarConflictPair[] = []
  if (proposal !== undefined) {
    const pStart = Date.parse(proposal.startAt)
    const pEnd = Date.parse(proposal.endAt)
    const proposed: ConflictEventSummary = {
      id: "proposed",
      title: proposal.title?.trim() || "Proposed event",
      startAt: new Date(pStart).toISOString(),
      endAt: new Date(pEnd).toISOString(),
      calendarId: "proposal",
    }
    for (const item of checked) {
      const pair = comparePair(proposed, pStart, pEnd, item.summary, item.start, item.end)
      if (pair !== undefined) conflicts.push(pair)
    }
  } else {
    for (let i = 0; i < checked.length; i += 1) {
      const left = checked[i]
      if (left === undefined) continue
      for (let j = i + 1; j < checked.length; j += 1) {
        const right = checked[j]
        if (right === undefined) continue
        const pair = comparePair(left.summary, left.start, left.end, right.summary, right.start, right.end)
        if (pair !== undefined) conflicts.push(pair)
      }
    }
  }
  const definitive = conflictScanDefinitive(totalSources, unreadSources)
  const completeness = totalSources <= 0 ? "none" : unreadSources === 0 ? "complete" : "partial"
  const severity: ConflictSeverityName = conflicts.some((c) => c.severity === "hard_overlap")
    ? "hard_overlap"
    : conflicts.some((c) => c.severity === "back_to_back")
      ? "back_to_back"
      : "none"
  return {
    severity,
    definitive,
    completeness,
    totalSources,
    unreadSources,
    checkedEvents: checked.length,
    ignoredEvents,
    conflicts,
  }
}

function sourceReadCounts(found: CalendarSearchResult): { readonly totalSources: number; readonly unreadSources: number } {
  const failedRows = found.sources.filter((source) => source.status !== "fresh")
  const failedProviders = new Set(failedRows.map((source) => source.key.provider))
  const missingProviders = found.unavailable.filter((provider) => !failedProviders.has(provider)).length
  const totalSources = found.sources.length + missingProviders
  const unreadSources = failedRows.length + missingProviders + (!found.complete && failedRows.length === 0 && missingProviders === 0 ? 1 : 0)
  return { totalSources, unreadSources }
}

function formatConflictText(subaction: string, report: ConflictScanReport): string {
  const caveat = report.definitive ? "" : " Some calendar sources could not be read, so this conflict scan is not definitive."
  if (report.conflicts.length === 0) {
    return `No conflicts detected for ${subaction} across ${report.checkedEvents} event(s).${caveat}`
  }
  const lines = report.conflicts.slice(0, 10).map((pair) =>
    `- [${pair.severity}] "${pair.first.title}" vs "${pair.second.title}" (${pair.first.startAt}..${pair.first.endAt})`,
  )
  return `Detected ${report.conflicts.length} conflict(s) (${report.severity}):\n${lines.join("\n")}${caveat}`
}

export effect function runConflictDetectAction(host: CalendarHost, input: unknown): ActionResult!! {
  const decoded = decodeConflictParams(input)
  if (Option.isNone(decoded)) {
    return {
      success: false,
      text: `${conflictDetectActionName} requires subaction: ${conflictSubactions.join(", ")}.`,
    }
  }
  const params = decoded.value
  const now = try Clock.currentTimeMillis
  let timeMin = now
  let timeMax = now + dayMs
  let proposal: { readonly title?: string; readonly startAt: string; readonly endAt: string } | undefined
  if (params.subaction === "scan_week") {
    timeMax = now + 7 * dayMs
  } else if (params.subaction === "scan_event_proposal") {
    const startMs = params.startAt === undefined ? Number.NaN : Date.parse(params.startAt)
    const endMs = params.endAt === undefined ? Number.NaN : Date.parse(params.endAt)
    if (!Number.isFinite(startMs) || !Number.isFinite(endMs) || endMs <= startMs) {
      return {
        success: false,
        text: "scan_event_proposal requires valid ISO startAt and endAt with endAt after startAt.",
        data: { subaction: params.subaction, code: "CALENDAR_PROPOSAL_INVALID" },
      }
    }
    timeMin = Math.max(0, startMs - bufferMs)
    timeMax = endMs + bufferMs
    proposal = {
      ...(params.title === undefined ? {} : { title: params.title }),
      startAt: new Date(startMs).toISOString(),
      endAt: new Date(endMs).toISOString(),
    }
  }
  const found = try host.search({
    timeMin,
    timeMax,
    ...(params.calendarId === undefined ? {} : { calendarId: params.calendarId }),
  })
  if (found === undefined) {
    return {
      success: false,
      text: "No calendar account is active right now.",
      data: { subaction: params.subaction, definitive: false, completeness: "none" },
    }
  }
  const { totalSources, unreadSources } = sourceReadCounts(found)
  const report = detectCalendarConflicts(found.events, totalSources, unreadSources, proposal)
  const data: ProviderDataRecord = {
    subaction: params.subaction,
    severity: report.severity,
    definitive: report.definitive,
    completeness: report.completeness,
    totalSources: report.totalSources,
    unreadSources: report.unreadSources,
    checkedEvents: report.checkedEvents,
    ignoredEvents: report.ignoredEvents,
    conflicts: report.conflicts.map((pair) => ({
      severity: pair.severity,
      gapMinutes: pair.gapMinutes,
      first: { ...pair.first },
      second: { ...pair.second },
    })),
  }
  return {
    success: true,
    text: formatConflictText(params.subaction, report),
    data,
  }
}

export const conflictDetectAction: Action = {
  name: conflictDetectActionName,
  description: "Scan the owner's calendar for hard overlaps and back-to-back meetings today, this week, or against a proposed event window.",
  descriptionCompressed: "Detect calendar overlaps and back-to-back conflicts.",
  similes: ["CHECK_CONFLICTS", "CALENDAR_CONFLICTS", "DETECT_OVERLAPS"],
  tags: ["capability:schedule"],
  contexts: ["calendar"],
  contextGate: { anyOf: ["calendar"] },
  toolSchemaStrict: true,
  cacheStable: true,
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  parameters: [
    { name: "calendarId", required: false, description: "Optional calendar ID to restrict the scan.", schema: { type: "string" } },
    { name: "endAt", required: false, description: "Proposed event end ISO timestamp (scan_event_proposal).", schema: { type: "string" } },
    { name: "startAt", required: false, description: "Proposed event start ISO timestamp (scan_event_proposal).", schema: { type: "string" } },
    { name: "subaction", required: true, description: "Conflict scan mode.", schema: { type: "string", enum: [...conflictSubactions] } },
    { name: "title", required: false, description: "Optional proposed event title.", schema: { type: "string" } },
  ],
  summarize: (result) => result?.text ?? "Conflict scan complete.",
  validate: async (runtime) => calendarServiceOf(runtime) !== undefined,
  handler: async (runtime, _message, _state, options) => {
    const host = calendarServiceOf(runtime)
    if (host === undefined) {
      return { success: false, text: "The calendar isn't running.", userFacingText: "The calendar isn't running.", verifiedUserFacing: true }
    }
    const input = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
    return runPromise(runConflictDetectAction(host, input))
  },
}

showsApp(conflictDetectAction, calendarContext.id)
