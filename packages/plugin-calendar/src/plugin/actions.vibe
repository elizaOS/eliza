import { guestAddresses } from "./providers.vibe"
import { CalendarService, calendarServiceType } from "./service.vibe"

export const calendarActionName = "CALENDAR"

export const calendarContext: ContextDefinition = {
  id: "calendar", label: "Calendar", description: "The owner's calendars and events.", descriptionCompressed: "Calendars and events.",
  sensitivity: "personal", cacheScope: "agent",
}

const day = 86_400_000
const maxSpan = 370 * day
const subactions = ["search_events", "next_event", "trip_window", "check_availability", "propose_times", "create_event", "update_event", "delete_event"] as const
type Subaction = typeof subactions[number]

const sentTime = /^(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d)(?::(\d\d)(?:\.\d{1,3})?)?(Z|[+-]\d\d:\d\d)?$/
const civilDay = /^(\d{4})-(\d\d)-(\d\d)$/
const Instant = Schema.String.check(Schema.makeFilter((text) => sentTime.test(text)))
const Words = (limit: number) => Schema.String.check(Schema.isMaxLength(limit))
const Parameters = Schema.Struct({
  subaction: Schema.Literals(subactions),
  query: Schema.optionalKey(Words(500)),
  timeMin: Schema.optionalKey(Instant),
  timeMax: Schema.optionalKey(Instant),
  date: Schema.optionalKey(Words(10)),
  endDate: Schema.optionalKey(Words(10)),
  eventId: Schema.optionalKey(Words(1024)),
  calendarId: Schema.optionalKey(Words(1024)),
  title: Schema.optionalKey(Words(500)),
  description: Schema.optionalKey(Words(16_000)),
  location: Schema.optionalKey(Words(2_000)),
  startAt: Schema.optionalKey(Instant),
  endAt: Schema.optionalKey(Instant),
  isAllDay: Schema.optionalKey(Schema.Boolean),
  timeZone: Schema.optionalKey(Words(128)),
  durationMinutes: Schema.optionalKey(Schema.Number),
  confirmedPastStart: Schema.optionalKey(Schema.Boolean),
  reviewBeforeSaving: Schema.optionalKey(Schema.Boolean),
  notifyAttendees: Schema.optionalKey(Schema.Boolean),
  attendees: Schema.optionalKey(Schema.Array(Words(320))),
  addGuests: Schema.optionalKey(Schema.Array(Words(320))),
  removeGuests: Schema.optionalKey(Schema.Array(Words(320))),
  reviewBeforeCreate: Schema.optionalKey(Schema.Boolean),
  recurrenceScope: Schema.optionalKey(WriteScopeRecord),
  statedClock: Schema.optionalKey(Schema.Literals(["start", "range", "none"])),
  phoneCalendar: Schema.optionalKey(Schema.Boolean),
  morningOnly: Schema.optionalKey(Schema.Boolean),
  afternoonOnly: Schema.optionalKey(Schema.Boolean),
  ownerAnswer: Schema.optionalKey(Schema.Literals(["yes", "no"])),
  repeat: Schema.optionalKey(RecurrenceRecord.fields.rule),
  repeatUntil: Schema.optionalKey(Instant),
  skipStarts: Schema.optionalKey(Schema.Array(Instant)),
})
type Parameters = typeof Parameters.Type
const decodeParameters = Schema.decodeUnknownOption(Parameters)
const decodeFields = Schema.decodeUnknownOption(FieldsRecord)
const decodeRecurrence = Schema.decodeUnknownOption(RecurrenceRecord)

const canonical = (instant: string) => new Date(Date.parse(instant)).toISOString()

function dayOf(sent: string | undefined): LocalDate | undefined {
  const match = sent === undefined ? null : civilDay.exec(sent)
  if (match === null) return undefined
  const date = { year: Number(match[1]), month: Number(match[2]), day: Number(match[3]) }
  const real = addDaysToLocalDate(date, 0)
  return real.year === date.year && real.month === date.month && real.day === date.day ? date : undefined
}

type TimeRead = { readonly kind: "at"; readonly at: string } | { readonly kind: "unreal" } | { readonly kind: "unresolved" }

function timeIn(sent: string, zone: string): TimeRead {
  const parts = sentTime.exec(sent)
  if (parts === null) return { kind: "unreal" }
  const date = dayOf(sent.slice(0, 10))
  const hour = Number(parts[4]), minute = Number(parts[5]), second = Number(parts[6] ?? "0")
  const offset = parts[7] !== undefined
  const real = date !== undefined && clockReal(hour, minute, second) && (!offset || Number.isFinite(Date.parse(sent)))
  const wall = date === undefined ? undefined : hour === 24 ? { ...addDaysToLocalDate(date, 1), hour: 0, minute, second } : { ...date, hour, minute, second }
  const at = !real || offset || wall === undefined ? undefined : buildUtcDateFromLocalParts(zone, wall, "reject")
  switch (instantRead(real, offset, at !== undefined)) {
    case "InstantUnreal": return { kind: "unreal" }
    case "InstantAsSent": return { kind: "at", at: sent }
    case "InstantInWallZone": return at === undefined ? { kind: "unresolved" } : { kind: "at", at: at.toISOString() }
    case "InstantRefused": return { kind: "unresolved" }
  }
}

const rangeTimes = ["timeMin", "timeMax"] as const
const eventTimes = ["startAt", "endAt", "repeatUntil"] as const
type TimesRead = { readonly kind: "read"; readonly parameters: Parameters } | { readonly kind: "unreal" } | { readonly kind: "unresolved" }

function timesIn(sent: Parameters, keys: typeof rangeTimes | typeof eventTimes, zone: string): TimesRead {
  const read: { -readonly [Key in keyof Parameters]: Parameters[Key] } = { ...sent }
  for (const key of keys) {
    const instant = read[key]
    if (instant === undefined) continue
    const at = timeIn(instant, zone)
    if (at.kind !== "at") return at
    read[key] = at.at
  }
  if (keys !== eventTimes || read.skipStarts === undefined) return { kind: "read", parameters: read }
  const starts: string[] = []
  for (const start of read.skipStarts) {
    const at = timeIn(start, zone)
    if (at.kind !== "at") return at
    starts.push(at.at)
  }
  return { kind: "read", parameters: { ...read, skipStarts: starts } }
}

function eventWallZone(sent: Parameters, creating: boolean, wholeDay: boolean, text: string, zones: { readonly request: string; readonly context: string }): string | undefined {
  const loose = [sent.startAt, sent.endAt, sent.repeatUntil, ...(sent.skipStarts ?? [])].flatMap((time) => time === undefined || sentTime.exec(time)?.[7] !== undefined ? [] : [time])
  const instant = (time: string, zone: string) => {
    const read = timeIn(time, zone)
    return read.kind === "at" ? read.at : read.kind
  }
  const sentZone = knownTimeZone(sent.timeZone) ? sent.timeZone : undefined
  const named = zoneNamedIn(text)
  const moved = sentZone !== undefined && loose.some((time) => instant(time, sentZone) !== instant(time, zones.context))
  const ownerNamedIt = sentZone !== undefined && named.kind === "zone" && loose.every((time) => instant(time, named.zone) === instant(time, sentZone))
  switch (wallZone(wholeDay, creating, sentZone !== undefined, moved, ownerNamedIt)) {
    case "WallAsCivilDate": return "UTC"
    case "WallInRequestZone": return zones.request
    case "WallInContextZone": return zones.context
    case "WallInNamedZone": return sentZone
    case "WallZoneUnsaid": return undefined
  }
}

type DayWindow = { readonly kind: "none" } | { readonly kind: "refused" } | { readonly kind: "days"; readonly timeMin: number; readonly timeMax: number }

function wholeDays(parameters: Parameters, zone: string): DayWindow {
  const first = dayOf(parameters.date)
  const last = parameters.endDate === undefined ? first : dayOf(parameters.endDate)
  const timeMin = first === undefined ? undefined : startOfCivilDay(first, zone)
  const timeMax = last === undefined ? undefined : startOfCivilDay(addDaysToLocalDate(last, 1), zone)
  const days = timeMin === undefined || timeMax === undefined || timeMin < 0 ? undefined : { kind: "days" as const, timeMin, timeMax }
  const count = days === undefined ? 0 : Math.round((days.timeMax - days.timeMin) / day)
  switch (dayRead(parameters.date !== undefined, parameters.endDate !== undefined, days !== undefined, parameters.timeMin !== undefined || parameters.timeMax !== undefined, count)) {
    case "ReadAskedWindow": return { kind: "none" }
    case "RefuseDayRead": return { kind: "refused" }
    case "ReadWholeDays": return days ?? { kind: "refused" }
  }
}

function bySeries(events: readonly CalendarEvent[]): CalendarEvent[][] {
  const series = new Map<string, CalendarEvent[]>()
  for (const event of events) {
    const key = `${event.provider}\n${event.calendarId}\n${event.recurringEventId ?? event.id}`
    const held = series.get(key)
    if (held === undefined) series.set(key, [event])
    else held.push(event)
  }
  return [...series.values()]
}

function nextOf(occurrences: readonly CalendarEvent[], now: number): CalendarEvent | undefined {
  return occurrences.find((event) => Date.parse(event.endAt) > now) ?? occurrences.at(-1)
}

function candidatesOf(groups: readonly (readonly CalendarEvent[])[], now: number): CalendarEvent[] {
  const [only] = groups
  if (groups.length !== 1 || only === undefined) {
    return groups.flatMap((occurrences) => {
      const next = nextOf(occurrences, now)
      return next === undefined ? [] : [next]
    })
  }
  const ahead = only.filter((event) => Date.parse(event.endAt) > now)
  return (ahead.length > 0 ? ahead : only).slice(0, 5)
}

function startsOn(event: CalendarEvent, date: LocalDate, zone: string): boolean {
  const parts = getZonedDateParts(new Date(Date.parse(event.startAt)), event.isAllDay ? "UTC" : zone)
  return parts !== undefined && parts.year === date.year && parts.month === date.month && parts.day === date.day
}

function readFresh(sources: CalendarSearchResult["sources"], event: CalendarEvent): boolean {
  return sources.some((source) => source.status === "fresh" && source.key.provider === event.provider && source.key.calendarId === event.calendarId
    && (event.grantId === undefined || event.grantId === "" || source.key.grantId === event.grantId))
}

function repeats(event: CalendarEvent): boolean {
  return (event.recurringEventId ?? null) !== null || (event.recurrence?.length ?? 0) > 0
}

function wallTime(event: CalendarEvent, zone: string): string {
  try {
    const format = event.isAllDay
      ? new Intl.DateTimeFormat("en-US", { timeZone: "UTC", dateStyle: "medium" })
      : new Intl.DateTimeFormat("en-US", { timeZone: zone, dateStyle: "medium", timeStyle: "short" })
    return format.format(new Date(Date.parse(event.startAt)))
  } catch {
    return event.startAt
  }
}

function line(event: CalendarEvent, zone: string): string {
  return `${event.title || "(untitled)"}, ${wallTime(event, zone)}${event.location === "" ? "" : ` at ${event.location}`}`
}

function parametersOf(options: unknown): Parameters | undefined {
  const raw = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
  const decoded = decodeParameters(raw)
  return Option.isSome(decoded) ? decoded.value : undefined
}

const receiptOperation = { schedule_event: "calendar.event.create", modify_event: "calendar.event.update", cancel_event: "calendar.event.delete", respond_invitation: "calendar.event.respond" } as const
const answered = { accepted: "Accepted", tentative: "Answered maybe to", declined: "Declined" } as const

export function calendarEffectReceipt(request: CalendarMutationRequest, receipt: CalendarMutationReceipt, replayed: boolean): AppliedEffectReceipt {
  const operation = receiptOperation[receipt.operation]
  return {
    receiptId: `calendar-event-mutation-receipt-v1:${sha256Hex(JSON.stringify([operation, receipt.eventId, receipt.providerVersion, request.id]))}`,
    operation,
    resource: { kind: "calendar.event", id: receipt.eventId, version: receipt.providerVersion },
    artifacts: [],
    idempotency: { key: request.id, replayed },
    observedAt: receipt.acceptedAt,
    outcome: "applied",
    commit: { kind: "durable", id: receipt.eventId, committedAt: receipt.acceptedAt },
  }
}

const ledgerDown = "The calendar's change records couldn't be read, so I can't confirm that change."
const rangeUnreadable = "That time range isn't one I can read: it must run forward and span at most 370 days."
const failed = (subaction: Subaction, text: string, extra: Record<string, unknown> = {}): ActionResult =>
  ({ success: false, text, data: { subaction, ...extra } })
const notDone = (subaction: Subaction, text: string, extra: Record<string, unknown> = {}, owner = text): ActionResult =>
  ({ ...failed(subaction, text, extra), userFacingText: owner, verifiedUserFacing: true })

function timesRefused(subaction: Subaction, kind: "unreal" | "unresolved"): ActionResult {
  return kind === "unreal"
    ? failed(subaction, "One of those times is not a real date and clock time. Write each as YYYY-MM-DDTHH:MM, with its offset or without one. Nothing was read or changed.", { code: "CALENDAR_TIME_INVALID" })
    : failed(subaction, "One of those times is skipped or shown twice by that day's clock change, so it names no single moment. Nothing was read or changed.", { code: "CALENDAR_WALL_TIME_UNRESOLVED" })
}

type UnsaidClock = { readonly check: "ClockUnsaid" | "ClockUndeclared"; readonly which: "start" | "end"; readonly at: number; readonly zone: string }
type KeptTimes = { readonly start?: string; readonly end?: string }

function unsaidClock(sent: Parameters, zone: string, text: string, kept: KeptTimes = {}): UnsaidClock | undefined {
  const endChecked = sent.statedClock === "range"
  const sentTimes = [["start", sent.startAt, kept.start], ...(endChecked ? [["end", sent.endAt, kept.end]] as const : [])] as const
  const givesAClock = wordsGiveAClock(text)
  for (const [which, time, keptTime] of sentTimes) {
    const at = time === undefined ? Number.NaN : Date.parse(time)
    const wall = Number.isFinite(at) && (keptTime === undefined || at !== Date.parse(keptTime)) ? getZonedDateParts(new Date(at), zone) : undefined
    if (wall === undefined) continue
    const check = statedClockCheck(sent.statedClock !== undefined, sent.statedClock === "start" || sent.statedClock === "range", clockSpelledInWords({ hour: wall.hour, minute: wall.minute }, text), givesAClock)
    if (check !== "ClockAsSent") return { check, which, at, zone }
  }
  return undefined
}

function clockRefused(subaction: Subaction, unsaid: UnsaidClock, verb: string): ActionResult {
  const clock = new Intl.DateTimeFormat("en-US", { timeZone: unsaid.zone, hour: "numeric", minute: "2-digit" }).format(new Date(unsaid.at))
  const sent = new Date(unsaid.at).toISOString()
  return unsaid.check === "ClockUndeclared"
    ? failed(subaction, `Nothing was ${verb} yet: the request gives another clock time than the ${unsaid.which} time ${clock}, and the call did not say whether the owner gave one.`,
      { code: "CALENDAR_CLOCK_UNDECLARED", sent, next: "The time can stand. If the owner gave no clock time and you chose this one (\"tomorrow afternoon\", \"push it back an hour\"), call again at once with the same times and statedClock none. If the owner said a clock time, call again with that time and statedClock start, or range with its end." })
    : failed(subaction, `Nothing was ${verb}: the request gives another clock time than the ${unsaid.which} time ${clock}.`,
      { code: "CALENDAR_CLOCK_UNSAID", sent, requiresInput: true, missing: ["clock time"], next: "Do not call again with a time of your own. Ask the owner, in your own words, which time they meant, and wait for their answer." })
}

function ownerAnswerOf(parameters: Parameters): OwnerAnswer {
  return parameters.ownerAnswer === "yes" ? "SaidYes" : parameters.ownerAnswer === "no" ? "SaidNo" : "SaidNeither"
}

function window(parameters: Parameters, now: number, length: number): { readonly timeMin: number; readonly timeMax: number } | undefined {
  const timeMin = parameters.timeMin === undefined ? now : Date.parse(parameters.timeMin)
  const timeMax = parameters.timeMax === undefined ? timeMin + length : Date.parse(parameters.timeMax)
  return timeMax > timeMin && timeMax - timeMin <= maxSpan && timeMin >= 0 ? { timeMin, timeMax } : undefined
}

const connectionWire: Readonly<Record<CalendarConnection, "connected" | "none">> = { AccountConnected: "connected", NoAccountConnected: "none" }

function connectionNote(found: CalendarSearchResult): string {
  return found.connection === "NoAccountConnected" ? " No calendar account is connected, so only the agent's own calendar was read." : ""
}

function readResult(subaction: Subaction, found: CalendarSearchResult, events: readonly CalendarEvent[], zone: string, empty: string): ActionResult {
  const caveat = `${found.complete ? "" : " Some calendars could not be read, so this may be incomplete."}${connectionNote(found)}`
  const text = events.length === 0 ? `${empty}${caveat}` : `${events.map((event) => line(event, zone)).join("\n")}${caveat}`
  return {
    success: true, text,
    data: { subaction, events: [...events], complete: found.complete, connection: connectionWire[found.connection], timeMin: found.timeMin, timeMax: found.timeMax, accountId: found.account.accountId },
  }
}

function changeText(outcome: CalendarMutationOutcome, done: string): string {
  switch (outcome.kind) {
    case "succeeded": return done
    case "confirmed": return "You confirmed this change already landed."
    case "retryable": return `The calendar did not take the change: ${outcome.failure.message}`
    case "invalidated": return `I can't make that change: ${outcome.failure.message}`
    case "blocked": return outcome.reason === "in_flight" ? "That change is still running." : "The calendar didn't confirm the change, so check it before I try again."
  }
}

function changeOwnerText(outcome: Exclude<CalendarMutationOutcome, { readonly kind: "succeeded" | "confirmed" }>): string {
  switch (outcome.kind) {
    case "retryable": return "The calendar did not take the change."
    case "invalidated": return "That calendar change can't be made."
    case "blocked": return changeText(outcome, "")
  }
}

const nobodyNotified = " The built-in calendar can't email attendees, so nobody was notified."
const overlapsUnchecked = " Another calendar could not be read, so overlaps there were not checked."

function changeResult(subaction: Subaction, result: CalendarChangeResult, zone: string): ActionResult {
  if (result.kind === "refused") {
    const text = {
      no_account: "No calendar account is active right now.",
      foreign_account: "That calendar belongs to another account than the one in use.",
      not_writable: "That calendar can't be written from this account.",
      no_provider: "That calendar's provider isn't connected.",
      approvals_unavailable: "The approval queue isn't available, so I can't ask you to approve that change.",
      organizer_unknown: "The calendar doesn't say whether you organize that event or were invited, so I can't change it.",
      not_invitee: "Only an invitee can answer that invitation.",
      invitee_edit: "You were invited to that event, so only its organizer can change it. I can decline it for you instead.",
      answers_unsupported: "That calendar's provider can't answer invitations.",
      answer_scope: "An invitation is answered for this event or the whole series, not this and following.",
      deletes_unsupported: "That calendar can't delete events from here. Delete it in the Calendar app.",
    }[result.reason]
    return result.reason === "foreign_account" || result.reason === "answer_scope" ? failed(subaction, text, { refusal: result.reason }) : notDone(subaction, text, { refusal: result.reason })
  }
  if (result.kind === "conflict") {
    const made = subaction === "create_event" ? "created" : "changed"
    if (result.reason === "unread") {
      return notDone(subaction, `Nothing was ${made}: the calendar it goes on could not be read, so I can't tell whether that time is free.`, { code: "CALENDAR_WRITE_SLOT_UNREAD" })
    }
    const held = result.conflicts.slice(0, 5)
    const overlap = `Nothing was ${made}: that time overlaps ${held.map((event) => line(event, zone)).join("; ")}.`
    return notDone(subaction, `${overlap} Tell me another time, or move that first.`,
      { code: "CALENDAR_WRITE_CONFLICT", requiresInput: true, missing: ["available time"], conflicts: held.map((event) => ({ id: event.id, title: event.title, startAt: event.startAt, endAt: event.endAt })) }, overlap)
  }
  const unchecked = result.overlapsUnchecked ? overlapsUnchecked : ""
  if (result.kind === "queued") {
    const silent = result.notice === "CannotNotify" ? " That calendar can't email attendees, so nobody will be notified." : ""
    return { success: true, text: `I've asked for your approval before changing that calendar.${silent}${unchecked}`, data: { subaction, approvalRequestId: result.approvalId, change: result.request.payload } }
  }
  const { outcome, request } = result
  if (outcome.kind === "confirmed") return failed(subaction, changeText(outcome, ""), { outcome: outcome.kind, requestId: request.id })
  if (outcome.kind !== "succeeded") return notDone(subaction, changeText(outcome, ""), { outcome: outcome.kind, requestId: request.id }, changeOwnerText(outcome))
  const receipt = outcome.receipt
  const effectReceipts = [calendarEffectReceipt(request, receipt, outcome.replayed)]
  const note = `${result.notice === "CannotNotify" ? nobodyNotified : ""}${unchecked}`
  if (receipt.operation === "schedule_event" && receipt.event !== null) {
    return { success: true, text: `Created ${line(receipt.event, zone)}.${unchecked}`, effectReceipts, data: { subaction, event: receipt.event, requestId: request.id } }
  }
  if (request.payload.action === "respond_invitation" && receipt.event !== null) {
    return { success: true, text: `${answered[request.payload.response]} ${line(receipt.event, zone)}.${note}`, effectReceipts,
      data: { subaction, targetEvent: receipt.target, event: receipt.event, response: request.payload.response, requestId: request.id } }
  }
  if (receipt.operation === "modify_event" && receipt.event !== null) {
    return { success: true, text: `Updated ${line(receipt.event, zone)}.${note}`, effectReceipts, data: { subaction, targetEvent: receipt.target, event: receipt.event, requestId: request.id } }
  }
  const title = receipt.target?.title ?? "the event"
  return { success: true, text: `Deleted ${title}.${note}`, effectReceipts, data: { subaction, targetEvent: receipt.target, deleted: true, requestId: request.id } }
}

export interface CalendarAsk {
  readonly by: string
  readonly id: string
  readonly conversation?: string
  readonly text?: string
  readonly selected?: string
  readonly clientZone?: string
  readonly ownerZone?: string
  readonly phoneCalendar?: true
}

function askTextOf(ask: CalendarAsk): string {
  return ask.text ?? ""
}

function askConversationOf(ask: CalendarAsk): string {
  return ask.conversation ?? `${ask.by}:default`
}

function ownerWords(message: Memory): string {
  try {
    const bound = incomingMessagePersistenceSnapshot(message)
    return bound === undefined ? extractUserText(unwrapUserMessageText(message)) : unwrapUserMessageText(bound)
  } catch {
    return ""
  }
}

export function calendarAsk(message: Memory, ownerZone?: string): CalendarAsk {
  const context = readTurnContext(message)
  const clientZone = context.observation?.timeZone ?? context.voiceUi?.uiTimeZone
  const observation = context.observation
  const selected = observation?.sensitive === false && observation.selectedObject?.kind === "canonical-calendar-event" ? observation.selectedObject.id : undefined
  return {
    by: String(message.entityId), id: String(message.id ?? `${message.roomId}:${message.createdAt ?? 0}`),
    conversation: `${message.roomId}:${message.entityId}`, text: ownerWords(message),
    ...(selected === undefined ? {} : { selected }),
    ...(clientZone === undefined ? {} : { clientZone }),
    ...(ownerZone === undefined ? {} : { ownerZone }),
  }
}

function zonesOf(ask: CalendarAsk) {
  return { owner: knownTimeZone(ask.ownerZone) ? ask.ownerZone : deviceTimeZone(), ...(ask.clientZone === undefined ? {} : { client: ask.clientZone }) }
}

interface NamedRead {
  readonly events: readonly CalendarEvent[]
  readonly sources: CalendarSearchResult["sources"]
  readonly everythingRead: boolean
}

type Named = Pick<CalendarSearch, "query" | "calendarId">

effect function readBySteps(host: CalendarHost, named: Named, now: number): (NamedRead | undefined)!! {
  let span = lookupSpanDays
  let reads = 0
  let firstReadWhole = false
  let everythingRead = true
  for (const leg of [{ from: -lookupNearBack, to: lookupNearAhead, first: true }, { from: lookupNearAhead, to: lookupDaysAhead, first: false }, { from: -lookupNearBack, to: -lookupDaysBack, first: false }]) {
    let at = leg.from
    while (at !== leg.to) {
      if (reads >= lookupReadLimit) return { events: [], sources: [], everythingRead: false }
      const next = leg.first ? leg.to : leg.to > at ? Math.min(leg.to, at + span) : Math.max(leg.to, at - span)
      const timeMin = Math.max(0, now + Math.min(at, next) * day)
      const timeMax = now + Math.max(at, next) * day
      if (timeMax <= timeMin) {
        at = next
        continue
      }
      const searched = try host.search({ timeMin, timeMax, ...named })
      if (searched === undefined) return undefined
      reads += 1
      if (leg.first) firstReadWhole = searched.complete
      const verdict = lookupStep(searched.events.length, searched.complete, firstReadWhole && !leg.first, Math.abs(next - at))
      if (verdict === "LookupDecides") return { events: searched.events, sources: searched.sources, everythingRead: searched.complete }
      if (verdict === "LookupShrinks") {
        span = Math.floor(Math.abs(next - at) / 2)
        continue
      }
      if (verdict === "LookupUnread") everythingRead = false
      at = next
    }
  }
  return { events: [], sources: [], everythingRead }
}

interface TargetAsk {
  readonly parameters: Parameters
  readonly text: string
  readonly moving: boolean
  readonly scope: CalendarWriteScope | undefined
  readonly zone: string
  readonly now: number
}

type Lookup =
  | { readonly kind: "found"; readonly found: CalendarFound }
  | { readonly kind: "ambiguous"; readonly matches: readonly CalendarEvent[]; readonly offDay: boolean }
  | { readonly kind: "unread" }
  | { readonly kind: "missing" }
  | { readonly kind: "badRange" }

effect function target(host: CalendarHost, asked: TargetAsk): Lookup!! {
  const { parameters, now, zone } = asked
  if (parameters.eventId !== undefined) {
    const found = try host.find(parameters.eventId, parameters.calendarId)
    return found === undefined ? { kind: "missing" } : { kind: "found", found }
  }
  const query = parameters.query ?? ""
  if (query.trim() === "") return { kind: "missing" }
  const named: Named = { query, ...(parameters.calendarId === undefined ? {} : { calendarId: parameters.calendarId }) }
  const ranged = parameters.timeMin !== undefined || parameters.timeMax !== undefined
  const span = ranged ? window(parameters, Math.max(0, now - lookupNearBack * day), lookupNearAhead * day) : undefined
  if (ranged && span === undefined) return { kind: "badRange" }
  const whole = span === undefined ? undefined : try host.search({ ...span, ...named })
  const read: NamedRead | undefined = span === undefined ? try readBySteps(host, named, now)
    : whole === undefined ? undefined : { events: whole.events, sources: whole.sources, everythingRead: whole.complete }
  if (read === undefined) return { kind: "missing" }
  const said = read.events.length === 0 ? undefined
    : eventDayInWords(asked.text, { moving: asked.moving, titles: read.events.map((event) => event.title), query, zone, now: new Date(now) })
  const dayStart = said === undefined ? undefined : startOfCivilDay(said.date, zone)
  const dayEnd = said === undefined ? undefined : startOfCivilDay(addDaysToLocalDate(said.date, 1), zone)
  const saidDayRead = dayStart === undefined || dayEnd === undefined || dayStart < 0 ? undefined : try host.search({ timeMin: dayStart, timeMax: dayEnd, ...named })
  const series = new Set(bySeries(read.events).map((occurrences) => occurrences[0]?.recurringEventId ?? occurrences[0]?.id))
  const titles = new Set(read.events.map((event) => event.title.trim().toLowerCase()))
  const onDay = said === undefined || saidDayRead === undefined ? []
    : saidDayRead.events.filter((event) => startsOn(event, said.date, zone) && (series.has(event.recurringEventId ?? event.id) || titles.has(event.title.trim().toLowerCase())))
  const groups = bySeries(onDay.length > 0 ? onDay : read.events)
  if (said !== undefined && onDay.length === 0 && offDay(asked.moving, groups.length, said.followsName, said.marksTheEvent) === "DayHoldsNone") {
    return { kind: "ambiguous", matches: candidatesOf(groups, now), offDay: true }
  }
  const occurrences = groups[0] ?? []
  const first = occurrences[0]
  const sources = onDay.length > 0 && saidDayRead !== undefined ? saidDayRead.sources : read.sources
  const verdict = changeTarget(groups.length, read.everythingRead, first !== undefined && readFresh(sources, first))
  if (verdict === "TargetUnread") return { kind: "unread" }
  if (verdict === "TargetMissing") return { kind: "missing" }
  if (verdict === "TargetAmbiguous") return { kind: "ambiguous", matches: candidatesOf(groups, now), offDay: false }
  const choice = occurrenceChoice(occurrences.length, asked.scope !== undefined, asked.scope === "series")
  if (choice === "AskWhichDay") return { kind: "ambiguous", matches: candidatesOf(groups, now), offDay: false }
  const chosen = choice === "TheOnlyOccurrence" ? first : nextOf(occurrences, now)
  const found = chosen === undefined ? undefined : try host.find(chosen.id, chosen.calendarId)
  return found === undefined ? { kind: "missing" } : { kind: "found", found }
}

type Guests = { readonly kind: "guests"; readonly attendees?: readonly string[] } | { readonly kind: "refused"; readonly text: string }

function guestsRefused(verdict: GuestChange, who: string): Guests {
  const text = {
    GuestsAsAsked: "",
    AddressNotWritten: `I won't invite ${who}: that exact address isn't in your request. Nothing was changed.`,
    GuestNotNamed: `You didn't name ${who} as a guest to remove. Nothing was changed.`,
    GuestNotOnEvent: `${who} isn't a guest of that event. Nothing was changed.`,
  }[verdict]
  return { kind: "refused", text }
}

function newGuests(parameters: Parameters, text: string): Guests {
  const asked = parameters.attendees ?? []
  const unwritten = asked.find((address) => !addressWrittenInWords(address, text))
  const verdict = guestChange(unwritten === undefined, true, true)
  if (verdict !== "GuestsAsAsked") return guestsRefused(verdict, unwritten ?? "")
  return asked.length === 0 ? { kind: "guests" } : { kind: "guests", attendees: [...new Set(asked.map((address) => address.trim().toLowerCase()))] }
}

function changedGuests(event: CalendarEvent, parameters: Parameters, text: string): Guests {
  if (parameters.addGuests === undefined && parameters.removeGuests === undefined) return { kind: "guests" }
  const adds = parameters.addGuests ?? []
  const others = event.attendees.filter((attendee) => !attendee.self)
  const removals = (parameters.removeGuests ?? []).map((said) => ({ said, matched: others.filter((guest) => guestIs(guest, said)) }))
  const unwritten = adds.find((address) => !addressWrittenInWords(address, text))
  const unnamed = removals.find(({ matched }) => matched.some((guest) => !guestNamedInWords(guest, text)))
  const missing = removals.find(({ matched }) => matched.length === 0)
  const verdict = guestChange(unwritten === undefined, unnamed === undefined, missing === undefined)
  if (verdict !== "GuestsAsAsked") return guestsRefused(verdict, unwritten ?? unnamed?.said ?? missing?.said ?? "")
  const removed = new Set(removals.flatMap(({ matched }) => matched.flatMap((guest) => guest.email === null ? [] : [guest.email.trim().toLowerCase()])))
  return { kind: "guests", attendees: [...new Set([...guestAddresses(event).filter((address) => !removed.has(address)), ...adds.map((address) => address.trim().toLowerCase())])] }
}

function updatedFields(found: CalendarFound, parameters: Parameters, zone: string, attendees: readonly string[] | undefined): CalendarEventFields {
  const event = found.event
  return {
    ...(attendees === undefined ? {} : { attendees }),
    title: parameters.title ?? event.title,
    description: parameters.description ?? event.description,
    location: parameters.location ?? event.location,
    startAt: canonical(parameters.startAt ?? event.startAt),
    endAt: new Date(changedEndMs(Date.parse(event.startAt), Date.parse(event.endAt), parameters.startAt !== undefined, Date.parse(parameters.startAt ?? event.startAt),
      parameters.endAt !== undefined, Date.parse(parameters.endAt ?? event.endAt))).toISOString(),
    isAllDay: parameters.isAllDay ?? event.isAllDay,
    timeZone: parameters.timeZone ?? event.timezone ?? zone,
  }
}

const eventKey = (event: CalendarEvent) => `${event.provider}\n${event.calendarId}\n${event.id}`

effect function namedRead(host: CalendarHost, event: CalendarEvent, text: string, now: number): { readonly complete: boolean; readonly only: boolean }!! {
  const read = try host.search({ timeMin: Math.min(now - day, Date.parse(event.startAt)), timeMax: Math.max(now + 60 * day, Date.parse(event.endAt) + 1) })
  if (read === undefined) return { complete: false, only: false }
  const named = new Set(read.events.filter((other) => eventNamedInWords(other.title, text)).map(eventKey))
  return { complete: read.complete, only: named.size === 1 && named.has(eventKey(event)) }
}

effect function residentDelete(host: CalendarHost, ask: CalendarAsk, found: CalendarFound, scope: CalendarWriteScope, said: OwnerAnswer, notifyAttendees: boolean, now: number, zone: string): ActionResult!! {
  const subaction = "delete_event"
  const event = found.event
  const text = askTextOf(ask)
  const conversation = askConversationOf(ask)
  const titled = eventNamedInWords(event.title, text)
  const read = try namedRead(host, event, text, now)
  const question = try host.deleteQuestion(conversation)
  const answer = deleteAnswer(question?.eventId === event.id, question !== undefined && question.askedIn !== ask.id, question === undefined ? -1 : now - question.askedAt, said)
  const pointedAt = ownerPointedAt(titled, read.only, read.complete, ask.selected === event.id)
  switch (chatDeleteStep(scope === "instance", residentDeleteStep(pointedAt, said, answer))) {
    case "KeepEvent": {
      if (question?.eventId === event.id) try host.settleDeleteQuestion(conversation)
      return failed(subaction, `Nothing was deleted. You turned down deleting “${event.title}”, so it stays on your calendar.`, { declined: true, eventId: event.id })
    }
    case "AskInChat": {
      try host.askToDelete(conversation, { eventId: event.id, askedIn: ask.id, askedAt: now, scope })
      const unread = read.complete ? "" : " Another calendar could not be read, so the event you meant may be there."
      const which = pointedAt ? `“${event.title}”, ${wallTime(event, zone)}, is the event you named.` : `Your request didn't name one exact event; the closest match is “${event.title}”, ${wallTime(event, zone)}.`
      return failed(subaction, `Nothing was deleted. ${which}${unread} Should I delete it?`,
        { requiresInput: true, missing: ["delete confirmation"], eventId: event.id, recurrenceScope: scope, targetEvent: event })
    }
    case "PickInCalendar":
      return notDone(subaction, `Nothing was deleted. From chat I can delete only one occurrence of “${event.title}”. To delete more of the series, choose it in Calendar.`, { eventId: event.id, recurrenceScope: scope })
    case "DeleteNow": {
      const result = host.change({ kind: "delete", target: found, scope, notifyAttendees, askedBy: ask.by, askId: `${ask.id}:${subaction}` }) catch () => undefined
      if (question !== undefined && result?.kind === "ran") try host.settleDeleteQuestion(conversation)
      return result === undefined ? notDone(subaction, ledgerDown) : changeResult(subaction, result, zone)
    }
  }
}

type WindowSpan = { readonly begin: number; readonly finish: number }
type FreeTimeNote = { readonly kind: "WordsGiveAnotherWindow" | "StartsBeforeNow" | "AfternoonAsked"; readonly says: string; readonly windows?: readonly { readonly startAt: string; readonly endAt: string }[] }
type WallClock = { readonly hour: number; readonly minute: number }

function freeTimeNote(parameters: Parameters, begin: number, finish: number, zone: string, text: string, now: number): FreeTimeNote | undefined {
  const start = getZonedDateParts(new Date(begin), zone)
  const end = getZonedDateParts(new Date(finish), zone)
  if (start === undefined || end === undefined) return undefined
  const words = windowWordsOf(text, { hour: start.hour, minute: start.minute })
  const named = zoneNamedIn(text)
  const thisMinute = now - now % 60000
  const startChecked = windowStartChecked(begin >= thisMinute && begin < thisMinute + 60000)
  const sameDay = start.year === end.year && start.month === end.month && start.day === end.day
  const noon = hourOfDay(begin, zone, 12)
  const five = hourOfDay(begin, zone, 17)
  const onDay = (clock: StatedClockTime) => buildUtcDateFromLocalParts(zone, { year: start.year, month: start.month, day: start.day, hour: clock.hour, minute: clock.minute, second: 0 })?.getTime()
  const instants = (clocks: readonly StatedClockTime[]) => clocks.map(onDay).filter((at): at is number => at !== undefined)
  const same = (wall: WallClock) => (clock: StatedClockTime) => clock.hour === wall.hour && clock.minute === wall.minute
  const otherHalf = (wall: WallClock) => (clock: StatedClockTime) => clock.minute === wall.minute && clock.hour % 12 === wall.hour % 12
  const either = (wall: WallClock) => (clock: StatedClockTime) => clock.hour % 12 === wall.hour % 12
  const held = (wall: WallClock) => clockSpelledInWords({ hour: wall.hour, minute: wall.minute }, text) || clockSpelledInWords({ hour: wall.hour, minute: wall.minute }, words.uncounted)
  const inPeriod = (fit: WindowSpan) => noon === undefined || (parameters.morningOnly === true ? fit.finish <= noon : parameters.afternoonOnly === true ? fit.begin >= noon : true)
  const ranges = (sameDay ? words.ranges : []).flatMap((range, index) => {
    if (!range.starts.some(either(start)) && !range.ends.some(either(end))) return []
    const readings = instants(range.starts)
    const ends = instants(range.ends)
    const all = readings.flatMap((from) => ends.filter((to) => to > from).map((to) => ({ begin: from, finish: to })))
    const kept = windowFits(readings.length, ends.length, all.length)
    const nearest = kept === all.length ? all : readings.length > 1 ? all.slice(-kept) : all.slice(0, kept)
    return [{ range, index, fits: nearest.some(inPeriod) ? nearest.filter(inPeriod) : nearest }]
  })
  const fitted = ranges.some(({ fits }) => fits.some((fit) => fit.finish === finish && (fit.begin === begin || (!startChecked && fit.begin <= begin))))
  const statedElsewhere = (statements: WindowWords["starts"], wall: WallClock, index: number | undefined) => statements.some((stated) => stated.range !== index && stated.clocks.some(same(wall)))
  const rangeOff = ranges.some(({ range, index, fits }) => fits.length > 0 && (
    windowSideOff(!startChecked || fits.some((fit) => fit.begin === begin) || statedElsewhere(words.starts, start, index), range.starts.some(otherHalf(start)), held(start))
    || windowSideOff(fits.some((fit) => fit.finish === finish) || statedElsewhere(words.ends, end, index), range.ends.some(otherHalf(end)), held(end))))
  const alone = (statements: WindowWords["starts"]) => statements.filter((stated) => stated.range === undefined)
  const statementOff = (statements: WindowWords["starts"], wall: WallClock, checked: boolean) => checked
    && windowSideOff(statements.some((stated) => stated.clocks.some(same(wall))), alone(statements).some((stated) => stated.clocks.some(otherHalf(wall))), true)
  const startOff = statementOff(words.starts, start, startChecked)
  const endOff = statementOff(words.ends, end, true)
  const sidesOff = !fitted && (rangeOff || startOff || endOff)
  const afternoonLeft = parameters.afternoonOnly === true && noon !== undefined && five !== undefined && ((begin < noon && !held(start)) || (finish > five && !held(end)))
  const clocks = new Intl.DateTimeFormat("en-US", { timeZone: zone, hour: "numeric", minute: "2-digit" })
  const list = (items: readonly string[]) => new Intl.ListFormat("en-US", { type: "disjunction" }).format(items)
  const asRead = "The window was read as sent."
  const zoneSaid = named.kind !== "none" || /\b[A-Z]{1,4}T\b/u.test(text)
  switch (windowNote(words.read, zoneSaid && !(named.kind === "zone" && named.zone === zone), sidesOff, begin < thisMinute, afternoonLeft)) {
    case "NoNote": return undefined
    case "WordsGiveAnotherWindow": {
      const fits = rangeOff ? ranges.flatMap(({ fits }) => fits).filter((fit, at, all) => all.findIndex((known) => known.begin === fit.begin && known.finish === fit.finish) === at) : []
      const stated = (statements: WindowWords["starts"]) => [...new Set(instants(alone(statements).flatMap((statement) => statement.clocks)))].map((at) => clocks.format(new Date(at)))
      const said = fits.length > 0 ? `the window ${list(fits.map((fit) => clocks.formatRange(new Date(fit.begin), new Date(fit.finish))))}`
        : [...(startOff ? [`a start at ${list(stated(words.starts))}`] : []), ...(endOff ? [`an end at ${list(stated(words.ends))}`] : [])].join(" and ")
      return { kind: "WordsGiveAnotherWindow", says: `Note: the owner's words seem to give ${said} that day, not the window sent. ${asRead}`,
        ...(fits.length > 0 ? { windows: fits.map((fit) => ({ startAt: new Date(fit.begin).toISOString(), endAt: new Date(fit.finish).toISOString() })) } : {}) }
    }
    case "StartsBeforeNow":
      return { kind: "StartsBeforeNow", says: `Note: the window starts before now (${clocks.format(new Date(now))}). ${asRead} For the rest of a period under way, start it at now; for what was on earlier, search_events lists the events.` }
    case "AfternoonAsked":
      return { kind: "AfternoonAsked", says: `Note: the owner asked about an afternoon, which runs from noon to 5 PM, and the window sent runs outside it. ${asRead}` }
  }
}

effect function freeTime(host: CalendarHost, parameters: Parameters, zone: string, text: string, now: number): ActionResult!! {
  const subaction = parameters.subaction === "propose_times" ? "propose_times" : "check_availability"
  const propose = subaction === "propose_times"
  const begin = parameters.timeMin === undefined ? Number.NaN : Date.parse(parameters.timeMin)
  const finish = parameters.timeMax === undefined ? Number.NaN : Date.parse(parameters.timeMax)
  const minutes = parameters.durationMinutes ?? 0
  const windowValid = windowFitsWeek(begin, finish, zone)
  const durationValid = !propose || (Number.isInteger(minutes) && slotMinutesAllowed(minutes))
  if (freeTimeRead(windowValid, durationValid, true) === "RefuseWindow") {
    return failed(subaction, "I need the exact window (timeMin and timeMax, at most seven days apart) and, for openings, the asked length in minutes from 5 to 480.", { code: "CALENDAR_AVAILABILITY_INVALID_WINDOW" })
  }
  const noon = hourOfDay(begin, zone, 12)
  if (morningAdmission(parameters.morningOnly === true, noon === undefined || finish > noon) === "RefuseOutsideMorning") {
    return failed(subaction, "The owner asked only about a morning. Keep the window on that morning's date and end it by noon in the request's zone; for a shorter opening inside the morning, use propose_times.",
      { code: "CALENDAR_AVAILABILITY_OUTSIDE_REQUESTED_PERIOD" })
  }
  const found = try host.search({ timeMin: Math.max(0, begin - day), timeMax: finish + day, ...(parameters.calendarId === undefined ? {} : { calendarId: parameters.calendarId }) })
  if (found === undefined) return notDone(subaction, "No calendar account is active right now.")
  const asked = { begin, finish }
  const busy = blockingSpans(found.events, zone)?.filter((span) => positiveOverlap(asked, span))
  if (busy === undefined || freeTimeRead(windowValid, durationValid, found.complete) !== "AvailabilityKnown") {
    return notDone(subaction, "Some calendars could not be read completely, so I can't tell whether that time is free.", { code: "CALENDAR_AVAILABILITY_INCOMPLETE", availability: "unknown" })
  }
  const range = { windowStart: new Date(begin).toISOString(), windowEnd: new Date(finish).toISOString(), timeZone: zone, accountId: found.account.accountId, connection: connectionWire[found.connection] }
  const note = freeTimeNote(parameters, begin, finish, zone, text, now)
  const noted = note === undefined ? {} : { windowNote: note }
  const connected = connectionNote(found)
  const withNote = (said: string) => `${note === undefined ? said : `${said} ${note.says}`}${connected}`
  if (!propose) {
    const free = intervalFree(asked, busy)
    return {
      success: true, text: withNote(free ? `You're free ${spanText(asked, zone)}.` : `That time isn't free: ${busy.map((span) => spanText(span, zone)).join("; ")}.`),
      data: { subaction, ...range, isFree: free, conflicts: busy.map((span) => ({ startAt: new Date(span.begin).toISOString(), endAt: new Date(span.finish).toISOString() })), ...noted },
    }
  }
  const slots = openings(asked, minutes * 60_000, busy)
  return {
    success: true,
    text: withNote(slots.length === 0 ? `I found no ${minutes}-minute opening on the quarter hour in that time.` : `I found these ${minutes}-minute openings: ${new Intl.ListFormat("en-US", { type: "disjunction" }).format(slots.map((slot) => openingText(slot, zone)))}.`),
    data: {
      subaction, ...range, durationMinutes: minutes, ...noted,
      slots: slots.map((slot) => ({ startAt: new Date(slot.begin).toISOString(), endAt: new Date(slot.finish).toISOString(), durationMinutes: minutes, timeZone: zone })),
      availabilityEvidence: "Openings start on the quarter hour and come from this exact read. An empty list does not rule out an opening off the quarter hour.",
    },
  }
}

effect function handle(host: CalendarHost, ask: CalendarAsk, sent: Parameters): ActionResult!! {
  const subaction = sent.subaction
  const now = try Clock.currentTimeMillis
  const zones = zonesOf(ask)
  const zone = requestTimeZone({ ...zones, ...(sent.timeZone === undefined ? {} : { explicit: sent.timeZone }) })
  const createZone = createTimeZone(zones)
  const ranged = timesIn(sent, rangeTimes, zone)
  if (ranged.kind !== "read") return timesRefused(subaction, ranged.kind)
  const parameters = ranged.parameters
  const text = askTextOf(ask)
  const askedBy = ask.by
  const askId = `${ask.id}:${subaction}`
  switch (subaction) {
    case "search_events":
    case "next_event": {
      const days: DayWindow = subaction === "search_events" ? wholeDays(parameters, zone) : { kind: "none" }
      if (days.kind === "refused") {
        return failed(subaction, "A whole-day read takes date, and endDate for more days, as real YYYY-MM-DD dates at most 370 days apart, without timeMin or timeMax. Nothing was read.", { code: "CALENDAR_READ_DATE_INVALID" })
      }
      const span = days.kind === "days" ? { timeMin: days.timeMin, timeMax: days.timeMax } : window(parameters, now, subaction === "next_event" ? 30 * day : 7 * day)
      if (span === undefined) return failed(subaction, rangeUnreadable)
      const found = try host.search({ ...span, ...(parameters.query === undefined ? {} : { query: parameters.query }), ...(parameters.calendarId === undefined ? {} : { calendarId: parameters.calendarId }) })
      if (found === undefined) return notDone(subaction, "No calendar account is active right now.")
      const events = subaction === "next_event" ? found.events.filter((event) => Date.parse(event.endAt) > now).slice(0, 1) : found.events
      return readResult(subaction, found, events, zone, subaction === "next_event" ? "Nothing is on your calendar in the next 30 days." : "No events match in that range.")
    }
    case "trip_window": {
      const place = parameters.query?.trim() ?? ""
      if (place === "") return failed(subaction, "A trip question needs the place in query, for example Denver. Nothing was read.")
      const span = window(parameters, now, 60 * day)
      if (span === undefined) return failed(subaction, rangeUnreadable)
      const found = try host.search({ ...span, ...(parameters.calendarId === undefined ? {} : { calendarId: parameters.calendarId }) })
      if (found === undefined) return notDone(subaction, "No calendar account is active right now.")
      const trip = tripEvents(found.events, place)
      const result = readResult(subaction, found, trip, zone, `I couldn't find a trip to ${place} in your calendar in that range.`)
      return { ...result, data: { ...result.data, location: place } }
    }
    case "check_availability":
    case "propose_times":
      return try freeTime(host, parameters, zone, text, now)
    case "create_event": {
      if (createStore(parameters.phoneCalendar === true, ask.phoneCalendar === true) === "ProposeOnPhone") {
        return failed(subaction, "Nothing was saved here: this event goes on your phone's own calendar, which you review on the phone.",
          { code: "CALENDAR_PHONE_CALENDAR_ASKED", next: "When the owner named the phone's own calendar, propose it now with PROPOSE_DEVICE_ACTION as calendar_create_local, with the title and the day and time the owner said on the phone's clock, and do not call create_event for it; the owner reviews it on the phone. When the owner named the agent's own Eliza calendar or a connected account, call create_event again without phoneCalendar." })
      }
      const guests = newGuests(parameters, text)
      if (guests.kind === "refused") return failed(subaction, guests.text, { code: "CALENDAR_GUEST_NOT_GROUNDED" })
      const wall = eventWallZone(parameters, true, parameters.isAllDay === true, text, { request: zone, context: createZone })
      if (wall === undefined) {
        return failed(subaction, `Nothing was saved: the time came with the zone ${parameters.timeZone ?? ""}, which the owner's words don't name. Send startAt and endAt with their offset, or leave timeZone out to use the owner's zone.`,
          { code: "CALENDAR_WALL_TIME_ZONE_UNSAID" })
      }
      const timed = timesIn(parameters, eventTimes, wall)
      if (timed.kind !== "read") return timesRefused(subaction, timed.kind)
      const sentEvent = timed.parameters
      const minutes = sentEvent.durationMinutes ?? 0
      const length = createLength(sentEvent.endAt !== undefined, sentEvent.durationMinutes !== undefined, Number.isInteger(minutes), minutes)
      if (length === "RefuseLength") {
        return failed(subaction, "A new event's length is a whole number of minutes from 1 to 44640. For anything else send endAt. Nothing was saved.", { code: "CALENDAR_EVENT_LENGTH_INVALID" })
      }
      const unsaid = sentEvent.isAllDay === true ? undefined : unsaidClock(sentEvent, wall, text)
      if (unsaid !== undefined) return clockRefused(subaction, unsaid, "saved")
      const begin = sentEvent.startAt === undefined ? undefined : Date.parse(sentEvent.startAt)
      const finish = begin === undefined ? undefined
        : createEndMs(begin, length === "KeepEnd", sentEvent.endAt === undefined ? begin : Date.parse(sentEvent.endAt), length === "UseLength" ? minutes : 0, sentEvent.isAllDay === true)
      const fields = decodeFields({
        title: sentEvent.title ?? "", description: sentEvent.description ?? "", location: sentEvent.location ?? "",
        startAt: begin === undefined ? "" : new Date(begin).toISOString(), endAt: finish === undefined ? "" : new Date(finish).toISOString(),
        isAllDay: sentEvent.isAllDay ?? false, timeZone: createZone, ...(guests.attendees === undefined ? {} : { attendees: guests.attendees }),
      })
      if (Option.isNone(fields) || !fieldsSpanValid(fields.value)) return failed(subaction, "A new event needs a title and a start before its end.")
      const stated = statedYearCreate(fields.value, text, new Date(now))
      if (stated === undefined) return failed(subaction, "That start time doesn't exist in the requested year and time zone.")
      const { fields: asked, move } = stated
      const recurrence = sentEvent.repeat === undefined ? Option.some(null) : decodeRecurrence({ rule: sentEvent.repeat,
        ...(sentEvent.repeatUntil === undefined ? {} : { until: move(canonical(sentEvent.repeatUntil)) }),
        ...(sentEvent.skipStarts === undefined ? {} : { excluded: sentEvent.skipStarts.map((start) => move(canonical(start))) }) })
      if (Option.isNone(recurrence)) return failed(subaction, "A repeating event needs one rule (daily, weekdays or weekly) and distinct skipped starts.")
      if (sentEvent.confirmedPastStart !== true && createNeedsConfirmation(asked.startAt, new Date(now), asked.isAllDay ? "UTC" : asked.timeZone)) {
        return failed(subaction, "That start time has already passed. Should I still create it?", { needsConfirmation: "past_start", fields: asked })
      }
      const source = try host.writeTarget(sentEvent.calendarId)
      if (source === undefined) return notDone(subaction, "There's no calendar this account can write to.")
      const result = host.change({ kind: "create", source, fields: asked, recurrence: recurrence.value, reviewFirst: chatCreateReviewed(sentEvent.reviewBeforeCreate === false && sentEvent.reviewBeforeSaving !== true), slotZone: createZone, askedBy, askId }) catch () => undefined
      return result === undefined ? notDone(subaction, ledgerDown) : changeResult(subaction, result, createZone)
    }
    case "update_event":
    case "delete_event": {
      const lookup = try target(host, { parameters, text, moving: subaction === "update_event", scope: parameters.recurrenceScope, zone, now })
      if (lookup.kind === "badRange") return failed(subaction, rangeUnreadable)
      if (lookup.kind === "ambiguous") {
        const shown = lookup.matches.slice(0, 5)
        return failed(subaction, `${lookup.offDay ? "None of them starts on that day. " : ""}Which one? ${shown.map((event) => line(event, zone)).join("; ")}`,
          { requiresInput: true, missing: ["eventId"], candidates: shown.map((event) => ({ id: event.id, title: event.title, startAt: event.startAt })) })
      }
      if (lookup.kind === "unread") {
        return notDone(subaction, "Some calendars could not be read, so I can't tell whether that event is there. Nothing was changed.", { code: "CALENDAR_TARGET_UNREAD" })
      }
      if (lookup.kind === "missing") return failed(subaction, "I couldn't find that event in this account's calendars.", { code: "CALENDAR_TARGET_NOT_FOUND" })
      const found = lookup.found
      const notifyAttendees = parameters.notifyAttendees === true
      const deletingResident = subaction === "delete_event" && found.source.provider === "eliza"
      const pending = deletingResident ? try host.deleteQuestion(askConversationOf(ask)) : undefined
      const held = pending?.eventId === found.event.id ? pending.scope : undefined
      const choice = scopeChoice(repeats(found.event), parameters.recurrenceScope !== undefined, held !== undefined, deletingResident)
      if (choice === "AskWhichOccurrences") {
        return failed(subaction, `Nothing was ${subaction === "update_event" ? "changed" : "deleted"}: “${found.event.title}” repeats, and the occurrence found is ${wallTime(found.event, zone)}. The request did not say whether to ${subaction === "update_event" ? "change" : "delete"} just that occurrence, that and every following occurrence, or the whole series.`,
          { requiresInput: true, missing: ["recurrenceScope"], eventId: found.event.id, startAt: found.event.startAt,
            next: "Read the owner's request again. When it already says which, as \"just this one\" or \"only this time\" say instance, call again at once with that recurrenceScope and this eventId; only otherwise ask the owner, in your own words." })
      }
      const scope = choice === "ScopeHeld" ? held ?? "instance" : parameters.recurrenceScope ?? "instance"
      if (deletingResident) return try residentDelete(host, ask, found, scope, ownerAnswerOf(parameters), notifyAttendees, now, zone)
      if (subaction === "delete_event") {
        const result = host.change({ kind: "delete", target: found, scope, notifyAttendees, askedBy, askId }) catch () => undefined
        return result === undefined ? notDone(subaction, ledgerDown) : changeResult(subaction, result, zone)
      }
      const guests = changedGuests(found.event, parameters, text)
      if (guests.kind === "refused") return failed(subaction, guests.text, { code: "CALENDAR_GUEST_NOT_GROUNDED" })
      const allDay = parameters.isAllDay ?? found.event.isAllDay
      const wall = eventWallZone(parameters, false, allDay, text, { request: zone, context: createZone }) ?? zone
      const timed = timesIn(parameters, eventTimes, wall)
      if (timed.kind !== "read") return timesRefused(subaction, timed.kind)
      const unsaid = allDay ? undefined : unsaidClock(timed.parameters, wall, text, { start: found.event.startAt, end: found.event.endAt })
      if (unsaid !== undefined) return clockRefused(subaction, unsaid, "changed")
      const fields = updatedFields(found, timed.parameters, zone, guests.attendees)
      if (Option.isNone(decodeFields(fields)) || !fieldsSpanValid(fields)) return failed(subaction, "The changed event needs a title and a start before its end.")
      const result = host.change({ kind: "update", target: found, scope, fields, notifyAttendees, slotZone: zone, askedBy, askId }) catch () => undefined
      return result === undefined ? notDone(subaction, ledgerDown) : changeResult(subaction, result, zone)
    }
  }
}

export effect function runCalendarAction(host: CalendarHost, ask: CalendarAsk, input: unknown, _message?: Memory): ActionResult!! {
  const parameters = parametersOf({ parameters: input })
  if (parameters === undefined) return { success: false, text: `${calendarActionName} needs a subaction: ${subactions.join(", ")}.` }
  return try handle(host, ask, parameters)
}

function serviceOf(runtime: IAgentRuntime): CalendarHost | undefined {
  const found: unknown = runtime.getService(calendarServiceType)
  return found instanceof CalendarService ? found.host : undefined
}

const assistantServiceType = "personal-assistant"

async function ownerZone(runtime: IAgentRuntime): Promise<string | undefined> {
  const assistant: unknown = runtime.getService(assistantServiceType)
  const read = typeof assistant === "object" && assistant !== null && "ownerCalendarZone" in assistant ? assistant.ownerCalendarZone : undefined
  if (typeof read !== "function") return undefined
  const zone: unknown = await Promise.resolve().then(() => read.call(assistant)).catch(() => undefined)
  return typeof zone === "string" ? zone : undefined
}

export const calendarAction: Action = {
  name: calendarActionName,
  description: "Owner's calendar. Reads: search_events, next_event, trip_window (events during trip at query place), check_availability (window free?), propose_times (<=2 openings of durationMinutes; neither books). Writes: create_event, update_event, delete_event (declines invites); connected providers require approval; native phone calendar uses PROPOSE_DEVICE_ACTION when offered. Set statedClock on new startAt/availability windows. Chat creates review unless owner asked to save now. Built-in delete removes <=1 occurrence; runs at once only with ownerAnswer=yes + unique exact title or selected event; else asks, then re-call with eventId+ownerAnswer.",
  similes: ["CALENDAR_SEARCH", "SCHEDULE", "AGENDA", "CALENDAR_TRIP_WINDOW", "CALENDAR_CHECK_AVAILABILITY", "CALENDAR_PROPOSE_TIMES", "CREATE_EVENT", "UPDATE_EVENT", "DELETE_EVENT"],
  tags: ["capability:schedule", "effect:receipt-required"],
  parameters: [
    { name: "subaction", required: true, description: "Op.", schema: { type: "string", enum: [...subactions] } },
    { name: "query", required: false, description: "Match title/notes/location/guest; place for trip_window.", schema: { type: "string" } },
    { name: "timeMin", required: false, description: "Range start: ISO-8601 w/ offset or wall time (2030-03-04T09:00, request zone). Req for availability/propose_times; start no earlier than now.", schema: { type: "string" } },
    { name: "timeMax", required: false, description: "Range end (same format). Req for availability/propose_times; morning<=12:00, afternoon 12:00-17:00 (request zone).", schema: { type: "string" } },
    { name: "date", required: false, description: "search_events whole-day start (YYYY-MM-DD, request zone); omit timeMin/timeMax.", schema: { type: "string" } },
    { name: "endDate", required: false, description: "search_events whole-day inclusive end (YYYY-MM-DD); needs date.", schema: { type: "string" } },
    { name: "eventId", required: false, description: "Event id from a prior result.", schema: { type: "string" } },
    { name: "calendarId", required: false, description: "Calendar id.", schema: { type: "string" } },
    { name: "title", required: false, description: "Exact title.", schema: { type: "string" } },
    { name: "description", required: false, description: "Exact notes.", schema: { type: "string" } },
    { name: "location", required: false, description: "Exact location.", schema: { type: "string" } },
    { name: "startAt", required: false, description: "Start: ISO-8601 w/ offset or wall time (2030-03-04T09:00; owner zone on create, request zone on update, YYYY-MM-DDT00:00 if all-day).", schema: { type: "string" } },
    { name: "endAt", required: false, description: "End (like startAt). Default: durationMinutes, else 1h (1d all-day); update keeps length.", schema: { type: "string" } },
    { name: "isAllDay", required: false, description: "All-day.", schema: { type: "boolean" } },
    { name: "timeZone", required: false, description: "IANA zone; with create wall time, set only if owner named it.", schema: { type: "string" } },
    { name: "durationMinutes", required: false, description: "propose_times slot min (5-480; 'a free hour'=60); create_event min if no endAt. Don't guess.", schema: { type: "integer", minimum: 1, maximum: 44640 } },
    { name: "confirmedPastStart", required: false, description: "Owner confirmed past start.", schema: { type: "boolean" } },
    { name: "reviewBeforeCreate", required: false, description: "create_event: false only if owner asked to save now; else reviews first.", schema: { type: "boolean" } },
    { name: "reviewBeforeSaving", required: false, description: "create_event: true if owner asked to preview/review first (takes priority; keep on follow-ups).", schema: { type: "boolean" } },
    { name: "repeat", required: false, description: "create_event recurrence.", schema: { type: "string", enum: ["daily", "weekdays", "weekly"] } },
    { name: "repeatUntil", required: false, description: "create_event last start (ISO-8601 w/ offset).", schema: { type: "string" } },
    { name: "skipStarts", required: false, description: "create_event skipped starts (ISO-8601 w/ offset).", schema: { type: "array", items: { type: "string" } } },
    { name: "attendees", required: false, description: "create_event: exact guest emails owner wrote; never guess/lookup.", schema: { type: "array", items: { type: "string" } } },
    { name: "addGuests", required: false, description: "update_event: exact guest emails owner wrote.", schema: { type: "array", items: { type: "string" } } },
    { name: "removeGuests", required: false, description: "update_event: guest emails/names owner used.", schema: { type: "array", items: { type: "string" } } },
    { name: "notifyAttendees", required: false, description: "update/delete: true only if owner asked to notify guests.", schema: { type: "boolean" } },
    { name: "recurrenceScope", required: false, description: "Repeating scope (instance=this, series=all). Set if stated; else asks, then re-call w/ eventId.", schema: { type: "string", enum: ["instance", "this_and_following", "series"] } },
    { name: "statedClock", required: false, description: "New startAt/endAt or free-time window: start=owner gave start clock ('at 3pm', 'noon', 'to 4'), range=start+end ('between noon and five', 'from one ten PM to two PM'), none=you chose time ('tomorrow afternoon', 'move it to Friday'). Unstated clock requires none.", schema: { type: "string", enum: ["start", "range", "none"] } },
    { name: "phoneCalendar", required: false, description: "create_event: true only for phone's native calendar (any language); omit for Eliza/connected.", schema: { type: "boolean" } },
    { name: "morningOnly", required: false, description: "Availability: true if morning-only; the window then ends by that day's noon.", schema: { type: "boolean" } },
    { name: "afternoonOnly", required: false, description: "Availability: true if afternoon-only (incl. errand-framed: 'tomorrow when I can pick up groceries in the afternoon', 'tomorrow afternoon where I can pick up these groceries'); window 12:00-17:00 or stated outer clock.", schema: { type: "boolean" } },
    { name: "ownerAnswer", required: false, description: "Built-in delete_event: yes if owner asked/agreed, no if declined/keep; omit else.", schema: { type: "string", enum: ["yes", "no"] } },
  ],
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,
  validate: async (runtime) => serviceOf(runtime) !== undefined,
  handler: async (runtime, message, _state, options) => {
    const host = serviceOf(runtime)
    if (host === undefined) return { success: false, text: "The calendar isn't running.", userFacingText: "The calendar isn't running.", verifiedUserFacing: true }
    const input = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
    const phoneCalendar = phoneCalendarOffered(runtime, message)
    return runPromise(runCalendarAction(host, { ...calendarAsk(message, await ownerZone(runtime)), ...(phoneCalendar ? { phoneCalendar } : {}) }, input, message))
  },
}

showsApp(calendarAction, calendarContext.id)

export const calendarProvider: Provider = {
  name: "CALENDAR_CONTEXT",
  description: "The owner's events over the next 24 hours from the active account's calendars",
  dynamic: true,
  roleGate: { minRole: "OWNER" },
  disclosureGate: OWNER_EXCLUSIVE_DISCLOSURE_GATE,

  get: async (runtime, message) => {
    const host = serviceOf(runtime)
    if (host === undefined) return {}
    const now = Date.now()
    const found = await runPromise(host.search({ timeMin: now, timeMax: now + contextLookahead }))
    if (found === undefined) return {}
    const zone = createTimeZone(zonesOf(calendarAsk(message, await ownerZone(runtime))))
    const lines = found.events.map((event) => `- ${line(event, zone)}`)
    return {
      text: `${lines.length === 0 ? "No calendar events in the next 24 hours." : `Calendar, next 24 hours${found.complete ? "" : " (some calendars unread)"}:\n${lines.join("\n")}`}${connectionNote(found)}`,
      data: { events: [...found.events], complete: found.complete, connection: connectionWire[found.connection] },
    }
  },
}
