// spec/calendar/actions.md, "Story: Ask the agent about my calendar and get my active account's events"; spec/calendar/actions.md, "Story: Change my calendar only as I asked and know it happened"; spec/calendar/actions.md, "An event is shown only from a listed calendar of the active account"; spec/calendar/actions.md, "A write goes to the active account's writable calendar, at once only for the resident calendar"; spec/calendar/actions.md, "Only an invitee answers an invitation, and an invitee's delete is a decline"; spec/calendar/actions.md, "A resident delete runs at once only for the one event the owner named, and otherwise asks in chat"; spec/calendar/actions.md, "Attendees hear of a change only when the owner asked and the calendar can tell them"; spec/calendar/actions.md, "A lookup finds the events that hold the most asked words, preferring their titles"; spec/calendar/actions.md, "The managed Google calendar is read and changed as one of the active account's calendars"; spec/calendar/actions.md, "The managed Google calendar is read and changed as one of the active account's calendars"; spec/calendar/actions.md, "A chat create or move that overlaps a commitment is refused, naming it"; spec/calendar/actions.md, "A change waiting for approval expires a day after it was asked"; spec/calendar/seriesScope.md, "A chat change to a repeating event asks which occurrences unless the request says"
import { sha256Hex } from "@elizaos/core"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import {
  approvalExpiry, attendeeNotice, eventVisible, invitationVerdict, readScope, slotChecked, sourceRead, writeRoute, writeSlot, type AttendeeNotice, type SourceRead,
} from "../../gen/calendar__actions.effect.vibe"
import { positiveOverlap } from "../../gen/calendar__availability.effect.vibe"
import { type ManagedCalendarBroker, sameSourceKey, sourceKeyId, type CalendarEvent, type CalendarEventFields, type CalendarProvider, type CalendarSourceHealth, type CalendarSourceKey, type CalendarSourceStatus, type CalendarSummary, calendarMutationLedger, type CalendarLedgerUnavailable, type CalendarAnswerScope, type CalendarInvitationResponse, type CalendarMutationOutcome, type CalendarMutationPayload, type CalendarMutationRequest, PayloadRecord, type CalendarWriteScope, WriteScopeRecord, type CalendarRecurrence } from "@elizaos/plugin-calendar-client"
import { invitationChangeOf, providerMutationPort, reviewDigest } from "../mutations/provider-port.vibe"
import { eventInWindow, eventVersion, hasOtherAttendees, ownerRole, residentCalendar, type CalendarAccount, type CalendarProviderPort } from "./providers.vibe"
import { blockingSpans } from "./free-time.vibe"
import { lookupMatches } from "./lookup.vibe"
import { managedGoogleCalendar } from "./managed-provider.vibe"
import { cacheKeyValueStore, type CalendarCache } from "./runtime-store.vibe"

export type CalendarApprovalAction = "schedule_event" | "modify_event" | "cancel_event"

export function approvalAction(payload: CalendarMutationPayload): CalendarApprovalAction {
  if (payload.action !== "respond_invitation") return payload.action
  return payload.response === "declined" ? "cancel_event" : "modify_event"
}

export interface CalendarApprovalRow {
  readonly id: string
  readonly subjectUserId: string
  readonly requestedBy: string
  readonly action: CalendarApprovalAction
  readonly payload: { readonly change: CalendarMutationPayload; readonly digest: string; readonly targetStartAt?: string }
  readonly reason: string
  readonly expiresAt: string
}

export interface CalendarApprovals {
  request(row: CalendarApprovalRow): Promise<{ readonly id: string; readonly state: string }>
}

export interface CalendarApprovalRecord {
  readonly id: string
  readonly action: string
  readonly payload: Readonly<Record<string, unknown>>
}

export interface CalendarLedgerOutcome {
  readonly result: "ChangeSucceeded" | "ChangeInvalidated" | "ChangeRetryable" | "ChangeUnconfirmed"
  readonly text: string
  readonly failure?: { readonly code: string; readonly retryable: boolean; readonly acceptance: "not_accepted" | "unknown" }
}

export interface CalendarSearch {
  readonly timeMin: number
  readonly timeMax: number
  readonly query?: string
  readonly calendarId?: string
}

export interface CalendarSearchResult {
  readonly account: CalendarAccount
  readonly events: readonly CalendarEvent[]
  readonly complete: boolean
  readonly sources: readonly CalendarSourceHealth[]
  readonly unavailable: readonly CalendarProvider[]
  readonly timeMin: string
  readonly timeMax: string
}

export interface CalendarFound {
  readonly event: CalendarEvent
  readonly source: CalendarSourceKey
}

export type CalendarChangeRequest =
  | { readonly kind: "create"; readonly source: CalendarSourceKey; readonly fields: CalendarEventFields; readonly recurrence: CalendarRecurrence | null; readonly reviewFirst?: boolean; readonly slotZone?: string; readonly askedBy: string; readonly askId: string }
  | { readonly kind: "update"; readonly target: CalendarFound; readonly scope: CalendarWriteScope; readonly fields: CalendarEventFields; readonly notifyAttendees?: boolean; readonly slotZone?: string; readonly askedBy: string; readonly askId: string }
  | { readonly kind: "delete"; readonly target: CalendarFound; readonly scope: CalendarWriteScope; readonly notifyAttendees?: boolean; readonly askedBy: string; readonly askId: string }
  | { readonly kind: "respond"; readonly target: CalendarFound; readonly scope: CalendarAnswerScope; readonly response: CalendarInvitationResponse; readonly notifyAttendees?: boolean; readonly askedBy: string; readonly askId: string }

export type CalendarChangeResult =
  | { readonly kind: "ran"; readonly request: CalendarMutationRequest; readonly outcome: CalendarMutationOutcome; readonly notice: AttendeeNotice; readonly overlapsUnchecked: boolean }
  | { readonly kind: "queued"; readonly request: CalendarMutationRequest; readonly approvalId: string; readonly notice: AttendeeNotice; readonly overlapsUnchecked: boolean }
  | { readonly kind: "conflict"; readonly reason: "taken" | "unread"; readonly conflicts: readonly CalendarEvent[] }
  | { readonly kind: "refused"; readonly reason: CalendarRefusal }

export type CalendarRefusal =
  | "no_account" | "foreign_account" | "not_writable" | "no_provider" | "approvals_unavailable"
  | "organizer_unknown" | "not_invitee" | "invitee_edit" | "answers_unsupported" | "answer_scope" | "deletes_unsupported"

interface CalendarDeleteQuestion {
  readonly eventId: string
  readonly askedIn: string
  readonly askedAt: number
  readonly scope?: CalendarWriteScope
}

export interface CalendarHostOptions {
  readonly cache: CalendarCache
  readonly agentId: string
  readonly approvals: () => CalendarApprovals | undefined
  readonly managed?: ManagedCalendarBroker
}

const dayMs = 86_400_000
const decodePayload = Schema.decodeUnknownOption(PayloadRecord, { onExcessProperty: "error" })
const decodeQuestion = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Struct({ eventId: Schema.String, askedIn: Schema.String, askedAt: Schema.Number, scope: Schema.optionalKey(WriteScopeRecord) })))
const questionKey = (conversation: string) => `calendar.delete-question.${encodeURIComponent(conversation)}`
const sourceStatus: Readonly<Record<SourceRead, CalendarSourceStatus>> = { ReadFresh: "fresh", ReadStale: "stale", ReadFailed: "error" }
const noticeReason: Readonly<Record<AttendeeNotice, string>> = {
  NotifyAttendees: ", telling its attendees",
  NotifyNobody: "",
  CannotNotify: ", without telling its attendees: this calendar can't email them",
}

function writableRow(row: CalendarSummary): boolean {
  return row.accessRole === "owner" || row.accessRole === "writer"
}

function byStart(left: CalendarEvent, right: CalendarEvent): number {
  return Date.parse(left.startAt) - Date.parse(right.startAt) || (left.id < right.id ? -1 : left.id > right.id ? 1 : 0)
}

export function ledgerOutcome(outcome: CalendarMutationOutcome): CalendarLedgerOutcome {
  switch (outcome.kind) {
    case "succeeded": return { result: "ChangeSucceeded", text: outcome.receipt.operation === "cancel_event" ? "The event was deleted." : "The calendar shows the change." }
    case "confirmed": return { result: "ChangeSucceeded", text: "You confirmed the change landed." }
    case "retryable": return { result: "ChangeRetryable", text: outcome.failure.message, failure: { code: outcome.failure.code, retryable: true, acceptance: "not_accepted" } }
    case "invalidated": return { result: "ChangeInvalidated", text: outcome.failure.message, failure: { code: outcome.failure.code, retryable: false, acceptance: "not_accepted" } }
    case "blocked": return { result: "ChangeUnconfirmed", text: outcome.reason === "in_flight" ? "The change is still running." : "The calendar did not confirm the change; check it before trying again.",
      failure: { code: outcome.reason === "in_flight" ? "CALENDAR_MUTATION_IN_FLIGHT" : "CALENDAR_MUTATION_OUTCOME_UNKNOWN", retryable: false, acceptance: "unknown" } }
  }
}

export effect function calendarHost(options: CalendarHostOptions) {
  const store = try cacheKeyValueStore(options.cache)
  const rows = Layer.succeed(KeyValueStore.KeyValueStore, store)
  const resident = try Effect.provide(residentCalendar(), rows)
  const residentAccount: CalendarAccount = { agentId: options.agentId, ownerId: "owner", accountId: `resident:${options.agentId}` }
  const managed = options.managed === undefined ? undefined
    : try Effect.provideService(managedGoogleCalendar({ broker: options.managed, owner: residentAccount, store }), Scope.Scope, try Scope.make())
  const providers = try Ref.make(new Map<CalendarProvider, CalendarProviderPort>(managed === undefined ? [["eliza", resident]] : [["eliza", resident], ["google", managed]]))
  const active = try Ref.make<CalendarAccount | undefined>(residentAccount)
  const ledger = try calendarMutationLedger()
  const port = providerMutationPort({ active: () => Ref.get(active), port: (provider) => map(Ref.get(providers), (held) => held.get(provider)) })

  effect function register(next: CalendarProviderPort) {
    try Ref.update(providers, (held) => new Map([...held, [next.provider, next]]))
  }

  effect function bindAccount(account: CalendarAccount | undefined) {
    try Ref.set(active, account)
  }

  effect function listed(account: CalendarAccount) {
    const found: { readonly port: CalendarProviderPort; readonly row: CalendarSummary }[] = []
    const unavailable: CalendarProvider[] = []
    for (const provider of (try Ref.get(providers)).values()) {
      const rows = provider.sources(account) catch () => undefined
      if (rows === undefined) { unavailable.push(provider.provider); continue }
      for (const row of rows) if (row.connectorAccountId === account.accountId && row.provider === provider.provider) found.push({ port: provider, row })
    }
    return { found, unavailable }
  }

  function narrowedTo(found: readonly { readonly row: CalendarSummary }[], calendarId: string | undefined): string | undefined {
    if (calendarId === undefined) return undefined
    return readScope(true, found.some(({ row }) => row.calendarId === calendarId)) === "OneListed" ? calendarId : undefined
  }

  effect function calendars(): (readonly CalendarSummary[] | undefined)!! {
    const account = try Ref.get(active)
    return account === undefined ? undefined : (try listed(account)).found.map(({ row }) => row)
  }

  effect function search(request: CalendarSearch): (CalendarSearchResult | undefined)!! {
    const account = try Ref.get(active)
    if (account === undefined) return undefined
    const { found, unavailable } = try listed(account)
    const events: CalendarEvent[] = []
    const sources: CalendarSourceHealth[] = []
    let complete = unavailable.length === 0
    const seen = new Set<string>()
    const readAt = new Date(try Clock.currentTimeMillis).toISOString()
    const calendarId = narrowedTo(found, request.calendarId)
    for (const { port, row } of found) {
      if (calendarId !== undefined && row.calendarId !== calendarId) continue
      const read = port.read(account, row, request.timeMin, request.timeMax) catch () => undefined
      const status = sourceStatus[sourceRead(read !== undefined, read?.complete === true, (read?.events.length ?? 0) > 0)]
      sources.push({ key: { provider: row.provider, side: row.side, grantId: row.grantId, connectorAccountId: row.connectorAccountId, calendarId: row.calendarId },
        summary: row.summary, accessRole: row.accessRole, status, syncedAt: status === "fresh" ? readAt : null })
      if (read === undefined) { complete = false; unavailable.push(port.provider); continue }
      complete = complete && read.complete
      for (const event of read.events) {
        const key = `${sourceKeyId(row)}\n${event.id}`
        if (seen.has(key) || !eventVisible(event.connectorAccountId ?? row.connectorAccountId, account.accountId, true) || !eventInWindow(event, request.timeMin, request.timeMax)) continue
        seen.add(key)
        events.push(event)
      }
    }
    return {
      account, events: (request.query === undefined ? events : lookupMatches(events, request.query)).sort(byStart), complete, sources, unavailable: [...new Set(unavailable)],
      timeMin: new Date(request.timeMin).toISOString(), timeMax: new Date(request.timeMax).toISOString(),
    }
  }

  effect function find(eventId: string, calendarId?: string): (CalendarFound | undefined)!! {
    const account = try Ref.get(active)
    if (account === undefined) return undefined
    const { found } = try listed(account)
    const narrowed = narrowedTo(found, calendarId)
    for (const { port, row } of found) {
      if (narrowed !== undefined && row.calendarId !== narrowed) continue
      const event = port.get(account, row, eventId) catch () => undefined
      if (event !== undefined && eventVisible(event.connectorAccountId ?? row.connectorAccountId, account.accountId, true)) {
        return { event, source: { provider: row.provider, side: row.side, grantId: row.grantId, connectorAccountId: row.connectorAccountId, calendarId: row.calendarId } }
      }
    }
    return undefined
  }

  effect function notifies(source: CalendarSourceKey): boolean!! {
    return (try Ref.get(providers)).get(source.provider)?.notifies === true
  }

  effect function deleteQuestion(conversation: string): (CalendarDeleteQuestion | undefined)!! {
    const raw = store.get(questionKey(conversation)) catch () => undefined
    const read = decodeQuestion(raw ?? "")
    return Option.isSome(read) ? read.value : undefined
  }

  effect function askToDelete(conversation: string, question: CalendarDeleteQuestion): void!! {
    store.set(questionKey(conversation), JSON.stringify(question)) catch () => undefined
  }

  effect function settleDeleteQuestion(conversation: string): void!! {
    store.remove(questionKey(conversation)) catch () => undefined
  }

  effect function writeTarget(calendarId?: string): (CalendarSourceKey | undefined)!! {
    const account = try Ref.get(active)
    if (account === undefined) return undefined
    const writable = (try listed(account)).found.filter(({ row }) => writableRow(row) && (calendarId === undefined || row.calendarId === calendarId))
    const chosen = writable.find(({ row }) => row.provider === "eliza") ?? writable.find(({ row }) => row.primary) ?? writable[0]
    if (chosen === undefined) return undefined
    const { provider, side, grantId, connectorAccountId } = chosen.row
    return { provider, side, grantId, connectorAccountId, calendarId: chosen.row.calendarId }
  }

  effect function slotOf(asked: Extract<CalendarChangeRequest, { readonly kind: "create" | "update" }>, source: CalendarSourceKey, id: string) {
    const span = { begin: Date.parse(asked.fields.startAt), finish: Date.parse(asked.fields.endAt) }
    const own = asked.kind === "update" ? asked.target.event : undefined
    const moved = own === undefined || Date.parse(own.startAt) !== span.begin || Date.parse(own.endAt) !== span.finish
    const applied = asked.slotZone === undefined ? false : (try Effect.provide(ledger.inspect(id), rows)).receipt !== undefined
    const zone = asked.slotZone ?? "UTC"
    const checked = slotChecked(asked.slotZone !== undefined, !asked.fields.isAllDay, moved, applied)
    const read = checked ? try search({ timeMin: Math.max(0, span.begin - dayMs), timeMax: span.finish + dayMs }) : undefined
    const taken = (read?.events ?? []).filter((event) => !(own !== undefined && event.id === own.id && event.calendarId === own.calendarId && event.provider === own.provider)
      && (blockingSpans([event], zone) ?? []).some((busy) => positiveOverlap(span, busy)))
    const targetRead = read?.sources.some((row) => sameSourceKey(row.key, source) && row.status === "fresh") === true
    return { taken, verdict: writeSlot(checked, targetRead, read?.complete === true, taken.length) }
  }

  effect function change(asked: CalendarChangeRequest): CalendarChangeResult!CalendarLedgerUnavailable {
    const account = try Ref.get(active)
    if (account === undefined) return { kind: "refused", reason: "no_account" }
    const source = asked.kind === "create" ? asked.source : asked.target.source
    const provider = (try Ref.get(providers)).get(source.provider)
    if (provider === undefined) return { kind: "refused", reason: "no_provider" }
    const row = (try listed(account)).found.find(({ row }) => sameSourceKey(row, source))
    const route = writeRoute(source.provider === "eliza" ? "ResidentProvider" : "AccountProvider", source.connectorAccountId === account.accountId && row !== undefined, row !== undefined && writableRow(row.row),
      asked.kind === "create" && asked.reviewFirst === true)
    if (route === "RefuseWrite") return { kind: "refused", reason: source.connectorAccountId === account.accountId ? "not_writable" : "foreign_account" }
    const notice = asked.kind === "create" ? "NotifyNobody" : attendeeNotice(asked.notifyAttendees === true, hasOtherAttendees(asked.target.event), provider.notifies)
    const notify = notice === "NotifyAttendees" ? { notifyAttendees: true as const } : {}
    let payload: CalendarMutationPayload
    if (asked.kind === "create") {
      payload = { action: "schedule_event", account: account.accountId, source, fields: asked.fields, recurrence: asked.recurrence }
    } else {
      const target = { source, eventId: asked.target.event.id, expectedVersion: eventVersion(asked.target.event) }
      const change = invitationChangeOf(asked.kind === "update" ? "modify_event" : asked.kind === "delete" ? "cancel_event" : "respond_invitation")
      const role = ownerRole(asked.target.event, row?.row.accountEmail ?? null)
      const verdict = invitationVerdict(change, role, provider.respond !== undefined, asked.scope === "this_and_following")
      if (verdict === "RefuseRole") return { kind: "refused", reason: role === "UnknownRole" ? "organizer_unknown" : change === "AnswerInvitation" ? "not_invitee" : "invitee_edit" }
      if (verdict === "RefuseUnsupported") return { kind: "refused", reason: "answers_unsupported" }
      if (verdict === "RefuseScope") return { kind: "refused", reason: "answer_scope" }
      if (asked.kind === "delete" && verdict === "RunAsAsked" && provider.remove === undefined) return { kind: "refused", reason: "deletes_unsupported" }
      const scope = asked.scope === "series" ? "series" : "instance"
      payload = asked.kind === "update" ? { action: "modify_event", account: account.accountId, target, scope: asked.scope, fields: asked.fields, ...notify }
        : asked.kind === "respond" ? { action: "respond_invitation", account: account.accountId, target, scope, response: asked.response, ...notify }
        : verdict === "RunAsDecline" ? { action: "respond_invitation", account: account.accountId, target, scope, response: "declined", ...notify }
        : { action: "cancel_event", account: account.accountId, target, scope: asked.scope, ...notify }
    }
    const digest = reviewDigest(payload)
    const request: CalendarMutationRequest = { id: `calendar-${sha256Hex(`${asked.askId}\n${digest}`).slice(0, 40)}`, digest, payload }
    const slot = asked.kind === "create" || asked.kind === "update" ? try slotOf(asked, source, request.id) : undefined
    if (slot?.verdict === "SlotTaken" || slot?.verdict === "SlotUnread") return { kind: "conflict", reason: slot.verdict === "SlotTaken" ? "taken" : "unread", conflicts: slot.taken }
    const overlapsUnchecked = slot?.verdict === "SlotUnchecked"
    if (route === "ApplyNow") return { kind: "ran", request, outcome: try Effect.provide(ledger.run(request, port), rows), notice, overlapsUnchecked }
    const approvals = options.approvals()
    if (approvals === undefined) return { kind: "refused", reason: "approvals_unavailable" }
    const now = try Clock.currentTimeMillis
    const filed = tryPromise(() => approvals.request({
      id: request.id, subjectUserId: asked.askedBy, requestedBy: options.agentId, action: approvalAction(payload),
      payload: { change: payload, digest, ...(asked.kind === "create" ? {} : { targetStartAt: asked.target.event.startAt }) }, reason: `Calendar ${payload.action.replace("_", " ")} reviewed in chat${noticeReason[notice]}`,
      expiresAt: new Date(approvalExpiry(now)).toISOString(),
    })) catch () => undefined
    return filed === undefined ? { kind: "refused", reason: "approvals_unavailable" } : { kind: "queued", request, approvalId: filed.id, notice, overlapsUnchecked }
  }

  effect function executeApproval(record: CalendarApprovalRecord): CalendarLedgerOutcome!! {
    const held = record.payload
    const change = decodePayload(held.change)
    const digest = held.digest
    if (Option.isNone(change) || typeof digest !== "string" || approvalAction(change.value) !== record.action) {
      return { result: "ChangeInvalidated", text: "The approved calendar change is not one the calendar can run.", failure: { code: "CALENDAR_APPROVAL_MALFORMED", retryable: false, acceptance: "not_accepted" } }
    }
    const outcome = Effect.provide(ledger.run({ id: record.id, digest, payload: change.value }, port), rows) catch () => undefined
    return outcome === undefined
      ? { result: "ChangeUnconfirmed", text: "The calendar ledger could not be read.", failure: { code: "CALENDAR_LEDGER_UNAVAILABLE", retryable: false, acceptance: "unknown" } }
      : ledgerOutcome(outcome)
  }

  return {
    register, bindAccount, calendars, search, find, writeTarget, notifies, change, executeApproval, deleteQuestion, askToDelete, settleDeleteQuestion,
    active: () => Ref.get(active),
    ledger: {
      inspect: (id: string) => Effect.provide(ledger.inspect(id), rows),
      reconcile: (id: string, evidence: Parameters<typeof ledger.reconcile>[1]) => Effect.provide(ledger.reconcile(id, evidence), rows),
    },
  }
}

export type CalendarHost = Effect.Success<ReturnType<typeof calendarHost>>
