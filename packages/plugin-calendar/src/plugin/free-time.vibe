// spec/calendar/actions.md, "Story: Ask when I am free and get openings from my real calendar"; spec/calendar/actions.md, "A free-time question reads exactly the asked window and answers only from a complete read"; spec/calendar/actions.md, "A tomorrow-morning question reads only tomorrow, from midnight to noon"; spec/calendar/actions.md, "A period is free only when no blocking event overlaps it"; spec/calendar/actions.md, "Openings are at most two quarter-hour starts of the asked length inside the window"
import { alignedStart, eventBlocks, nextSearchStart, quarterHour, slotOffered } from "../../gen/calendar__actions.effect.vibe"
import type { TimeWindow } from "../../gen/calendar__availability.effect.vibe"
import { addDaysToLocalDate, buildUtcDateFromLocalParts, getZonedDateParts, namesCalendarDate, startOfCivilDay, type LocalDate } from "../clock.vibe"
import type { CalendarEvent } from "../model.vibe"

const dayMs = 86_400_000
const tomorrowMorningWords = /\btomorrow\s+morning\b/i
const besideMorning = /\b(?:after|before|except|not)\s+tomorrow\s+morning\b/i
const noonBound = /\b(?:until|through|to|by|before)\s+(?:noon|midday|12(?::00)?\s*p\.?\s*m)\b/gi
const otherPeriod = /\b(?:morning|afternoon|evening|tonight|night|noon|midday|lunch(?:time)?|all\s+day|whole\s+day|full\s+day|rest\s+of\s+the\s+day|week)\b/i
const afternoonClock = /\b(?:(?:1[0-2]|0?[1-9])(?::[0-5]\d)?\s*p\.?\s*m|12:(?:0[1-9]|[1-5]\d)(?!\s*a\.?\s*m)|(?:1[3-9]|2[0-3]):[0-5]\d)\b/i
const otherDay = /\b(?:today|tomorrow|yesterday|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b|\bin\s+\d+\s+days?\b/i

/** Whether the owner's words ask about tomorrow morning and no other period, part of the day, afternoon clock time or day. */
export function asksOnlyAboutTomorrowMorning(request: string): boolean {
  const remainder = request.replace(tomorrowMorningWords, "")
  if (remainder === request || besideMorning.test(request)) return false
  const others = remainder.replace(noonBound, "")
  return !otherDay.test(remainder) && !namesCalendarDate(remainder) && !otherPeriod.test(others) && !afternoonClock.test(others)
}

/** Tomorrow's midnight and noon in a zone, from the current instant. */
export function tomorrowMorning(now: number, timeZone: string): { readonly midnight: number; readonly noon: number } | undefined {
  const today = getZonedDateParts(new Date(now), timeZone)
  if (today === undefined) return undefined
  const tomorrow = addDaysToLocalDate(today, 1)
  const midnight = buildUtcDateFromLocalParts(timeZone, { ...tomorrow, hour: 0, minute: 0, second: 0 })
  const noon = buildUtcDateFromLocalParts(timeZone, { ...tomorrow, hour: 12, minute: 0, second: 0 })
  return midnight === undefined || noon === undefined ? undefined : { midnight: midnight.getTime(), noon: noon.getTime() }
}

/** Whether a window runs forward from a nonnegative start to no later than seven civil days after it in the zone, at the same wall time. */
export function windowFitsWeek(begin: number, finish: number, timeZone: string): boolean {
  const first = Number.isFinite(begin) ? getZonedDateParts(new Date(begin), timeZone) : undefined
  const last = Number.isFinite(finish) ? getZonedDateParts(new Date(finish), timeZone) : undefined
  if (first === undefined || last === undefined || begin < 0 || finish <= begin || finish - begin > 8 * dayMs) return false
  const limit = addDaysToLocalDate(first, 7)
  const bound = [limit.year, limit.month, limit.day, first.hour, first.minute, first.second, begin % 1000]
  const actual = [last.year, last.month, last.day, last.hour, last.minute, last.second, finish % 1000]
  const differs = bound.findIndex((value, index) => actual[index] !== value)
  return differs === -1 || (actual[differs] ?? 0) < (bound[differs] ?? 0)
}

function civilDate(instant: string): LocalDate | undefined {
  const at = new Date(Date.parse(instant))
  return Number.isFinite(at.getTime()) ? { year: at.getUTCFullYear(), month: at.getUTCMonth() + 1, day: at.getUTCDate() } : undefined
}

function occupied(event: CalendarEvent, timeZone: string): TimeWindow | undefined {
  if (!event.isAllDay) {
    const begin = Date.parse(event.startAt)
    const finish = Date.parse(event.endAt)
    return Number.isFinite(begin) && Number.isFinite(finish) ? { begin, finish } : undefined
  }
  const first = civilDate(event.startAt)
  const last = civilDate(event.endAt)
  if (first === undefined || last === undefined) return undefined
  const begin = startOfCivilDay(first, timeZone)
  const finish = startOfCivilDay(Date.parse(event.endAt) > Date.parse(event.startAt) ? last : addDaysToLocalDate(first, 1), timeZone)
  return begin === undefined || finish === undefined ? undefined : { begin, finish }
}

function ownerDeclined(event: CalendarEvent): boolean {
  return event.attendees.some((attendee) => attendee.self && attendee.responseStatus?.trim().toLowerCase() === "declined")
}

function markedFree(event: CalendarEvent): boolean {
  const transparency = event.metadata.transparency
  return typeof transparency === "string" && ["transparent", "free"].includes(transparency.trim().toLowerCase())
}

/** The time each blocking event occupies, an all-day event over its civil days in the zone, or undefined when one cannot be placed. */
export function blockingSpans(events: readonly CalendarEvent[], timeZone: string): TimeWindow[] | undefined {
  const spans: TimeWindow[] = []
  for (const event of events) {
    if (!eventBlocks(event.status.trim().toLowerCase() === "cancelled", ownerDeclined(event), markedFree(event))) continue
    const span = occupied(event, timeZone)
    if (span === undefined) return undefined
    spans.push(span)
  }
  return spans
}

/** At most two free openings of the length inside the window, on quarter-hour starts, the second at or after the first one's end. */
export function openings(window: TimeWindow, durationMs: number, busy: TimeWindow[]): TimeWindow[] {
  const found: TimeWindow[] = []
  let start = alignedStart(window.begin)
  while (found.length < 2 && start + durationMs <= window.finish) {
    if (slotOffered(window, start, durationMs, busy)) {
      found.push({ begin: start, finish: start + durationMs })
      start = nextSearchStart(start, durationMs)
    } else {
      start += quarterHour
    }
  }
  return found
}

/** A span as the owner reads it in a zone. */
export function spanText(span: TimeWindow, timeZone: string): string {
  try {
    return new Intl.DateTimeFormat("en-US", { timeZone, weekday: "short", month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZoneName: "short" })
      .formatRange(new Date(span.begin), new Date(span.finish))
  } catch {
    return `${new Date(span.begin).toISOString()} to ${new Date(span.finish).toISOString()}`
  }
}
