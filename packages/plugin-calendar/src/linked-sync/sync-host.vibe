// spec/calendar/linkedSync.md, "Story: Link my resident calendar to a verified provider destination"; spec/calendar/linkedReconcile.md, "Story: Bring the two versions together without overwriting an independent edit"; spec/calendar/syncSettlement.md, "Story: Resume sync in the foreground only from a current opt-in read"; spec/calendar/syncSettlement.md, "A foreground read of the opt-in has exactly one outcome"; spec/calendar/syncSettlement.md, "Stopping or hiding retires the generation and cancels its running pass"; spec/calendar/syncSettlement.md, "Only a current enabled opt-in starts a pass, and a stale read changes nothing visible"
import { canReadOptIn, type OptInResult } from "../../gen/calendar__syncSettlement.effect.vibe"
import { SyncSettings } from "./wire.schema.vibe"
import { CalendarSyncAborted, CalendarSyncRefused, type ProviderRefused, type ProviderUncertain, type LinkedCalendarEventRecord, type LinkedCalendarLocalPort } from "./linked.vibe"
import { CALENDAR_LINK_LIMIT, CalendarLinkedStore, type CalendarLinkedStoreOptions, type CalendarLinkStorage, type CalendarSyncBinding } from "./linked-store.vibe"
import { googleCalendarSyncPort, type CalendarSyncClient, type GoogleCalendarSyncPortOptions } from "./google-port.vibe"
import { LinkedCalendarReconciler, type LinkedCalendarReconcileOutcome, type LinkedCalendarRecoveryOutcome } from "./reconcile.vibe"
import { foregroundSyncMachine } from "./settlement.vibe"

export interface CalendarSyncContext {
  readonly reviewIdentity: string
  readonly binding: CalendarSyncBinding
  readonly client: CalendarSyncClient
  readonly local: LinkedCalendarLocalPort
  readonly storage: CalendarLinkStorage
  readonly current: () => boolean
  readonly localDeletionUndone?: (eventId: string) => boolean
  readonly events: () => Promise<ReadonlyArray<{ readonly id: string; readonly revision: string }>>
}

export interface CalendarSyncPreference {
  read(scope: string): boolean!(CalendarSyncRefused | CalendarSyncAborted)
  write(scope: string, enabled: boolean): void!(CalendarSyncRefused | CalendarSyncAborted)
}

export interface CalendarSyncReview {
  readonly reviewIdentity: string
  readonly scope: string
  readonly binding: CalendarSyncBinding
  readonly events: ReadonlyArray<{ readonly id: string; readonly revision: string }>
}

export type CalendarSyncReport = Record<LinkedCalendarReconcileOutcome, number>

export type CalendarSyncControllerOptions = CalendarLinkedStoreOptions & GoogleCalendarSyncPortOptions

export interface CalendarSyncDestination {
  readonly account: string
  readonly calendar: string
}

export type CalendarSyncPrepared = CalendarSyncContext & { readonly destination?: CalendarSyncDestination }

export interface CalendarSyncTarget {
  readonly environment: CalendarSyncBinding["environment"]
  readonly userId: string
  readonly organizationId: string
  readonly connectionId: string
  readonly calendarId: string
  readonly agentId: string
}

export type CalendarSyncSettings = typeof SyncSettings.Type

export interface CalendarSyncSettingsStore {
  read(): Promise<unknown | null>
  edit(edit: (value: CalendarSyncSettings | null) => CalendarSyncSettings | null): Promise<void>
}

export interface CalendarSyncDeviceGate {
  enabled(): Promise<boolean>
  enable(current: () => boolean): Promise<void>
  pause(): Promise<void>
  cancel(): void
}

export interface CalendarSyncLocalSource {
  readonly revision: string
  readonly deviceEnabled?: boolean
}

export interface CalendarSyncHostOptions {
  prepare(signal: AbortSignal, request: { readonly interactive: boolean }): Promise<CalendarSyncPrepared>
  readonly settings: CalendarSyncSettingsStore
  target(): CalendarSyncTarget
  identity(): string
  foreground(): boolean
  source(target: CalendarSyncTarget, current: () => boolean): Promise<CalendarSyncLocalSource>
  readonly storage: CalendarLinkStorage
  readonly device?: () => CalendarSyncDeviceGate | undefined
  readonly controller?: CalendarSyncControllerOptions
  settingsWritten?(): void
  reviewMessage?(events: number): string
  readonly localChangeDelayMs?: number
}

export interface CalendarSyncHostSnapshot {
  readonly status: string
  readonly running: boolean
  readonly enabled: boolean
}

type SyncFailure = CalendarSyncRefused | CalendarSyncAborted | ProviderRefused | ProviderUncertain

const refuse = (message: string) => new CalendarSyncRefused({ message })
const decodeSettings = Schema.decodeUnknownEffect(SyncSettings, { onExcessProperty: "error" })
const dispatchSettleMs = 300_000
const recoveredAs = { landed: "clean", not_landed: "dirty", unresolved: "quarantined" } as const satisfies Record<LinkedCalendarRecoveryOutcome, LinkedCalendarReconcileOutcome>
const emptyReport = (): CalendarSyncReport => ({ clean: 0, pushed: 0, pulled: 0, conflicted: 0, quarantined: 0, paused: 0, dirty: 0 })

export effect function readCalendarSyncSettings(value: unknown): (CalendarSyncSettings | null)!CalendarSyncRefused {
  if (value === null || value === undefined) return null
  return try mapError(decodeSettings(value), () => refuse("Calendar sync settings need recovery. Saved events are retained."))
}

export function calendarSyncTargetMatches(binding: CalendarSyncBinding | undefined, target: CalendarSyncTarget): boolean {
  return binding !== undefined && binding.environment === target.environment && binding.userId === target.userId
    && binding.organizationId === target.organizationId && binding.connectionId === target.connectionId
    && binding.calendarId === target.calendarId && binding.agentId === target.agentId
}

export function calendarSyncSettingsSlot(storage: CalendarLinkStorage, slot: string, attempts = 8): CalendarSyncSettingsStore {
  return {
    read: () => storage.read(slot),
    async edit(edit) {
      for (let attempt = 0; attempt < attempts; attempt++) {
        const before = await storage.read(slot)
        const result = await storage.compareExchange(slot, before, edit(before as CalendarSyncSettings | null))
        if (result.status === "saved") return
      }
      throw new Error("Calendar sync settings changed. Review them again.")
    },
  }
}

export function calendarSyncFailureMessage(error: SyncFailure): string {
  switch (error._tag) {
    case "CalendarSyncAborted": return "Sync paused or the selected account changed. Check linked events before retrying."
    case "CalendarSyncRefused": return error.message
    case "ProviderRefused":
    case "ProviderUncertain":
      return error.message || "Sync stopped. Check the selected Google calendar before retrying."
  }
}

export function calendarSyncReportMessage(result: CalendarSyncReport): string {
  const warnings = result.conflicted + result.quarantined + result.dirty
  return warnings > 0
    ? `Sync needs review: ${result.conflicted} conflicts, ${result.quarantined} unconfirmed changes, ${result.dirty} refused changes.`
    : `Synced: ${result.pushed} sent to Google, ${result.pulled} received, ${result.clean} unchanged.${result.paused > 0 ? ` ${result.paused} links paused.` : ""}`
}

export class CalendarSyncController {
  #running = false
  #generation = 0
  readonly #prepare: (signal: AbortSignal) => Promise<CalendarSyncContext>
  readonly #preference: CalendarSyncPreference
  readonly #options: CalendarSyncControllerOptions

  constructor(prepare: (signal: AbortSignal) => Promise<CalendarSyncContext>, preference: CalendarSyncPreference, options: CalendarSyncControllerOptions = {}) {
    this.#prepare = prepare
    this.#preference = preference
    this.#options = options
  }

  cancel(): void {
    this.#generation++
  }

  effect #context(): { context: CalendarSyncContext; check: () => void!CalendarSyncAborted; store: CalendarLinkedStore }!(CalendarSyncRefused | CalendarSyncAborted) {
    const generation = this.#generation
    const context = try tryPromise({ try: (signal) => this.#prepare(signal), catch: (error) => refuse(error instanceof Error ? error.message : "Calendar sync could not be prepared.") })
    const live = () => generation === this.#generation && context.current()
    effect function check(): void!CalendarSyncAborted {
      if (!live()) throw new CalendarSyncAborted({ reason: "Calendar sync context changed" })
    }
    try check()
    const store = try CalendarLinkedStore.open(context.binding, live, context.storage, { idempotencyNamespace: this.#options.idempotencyNamespace })
    return { context, check, store }
  }

  effect #port(client: CalendarSyncClient, context: CalendarSyncContext) {
    return try googleCalendarSyncPort(client, context.binding, context.current, { canonicalRecurrence: this.#options.canonicalRecurrence })
  }

  effect #events(context: CalendarSyncContext) {
    return try tryPromise({ try: () => context.events(), catch: () => refuse("Your local calendar could not be read. Nothing changed.") })
  }

  effect #unchanged(context: CalendarSyncContext, events: ReadonlyArray<{ readonly id: string; readonly revision: string }>, check: () => void!(CalendarSyncRefused | CalendarSyncAborted), message: string): void!(CalendarSyncRefused | CalendarSyncAborted) {
    for (const event of events) {
      const snapshot = try tryPromise({ try: () => context.local.get(event.id), catch: () => refuse(message) })
      try check()
      if (snapshot === null || snapshot.revision !== event.revision) throw refuse(message)
    }
  }

  effect #work<A>(task: A!SyncFailure): A!SyncFailure {
    if (this.#running) throw refuse("Calendar sync is already running.")
    this.#running = true
    return try ensuring(task, sync(() => { this.#running = false }))
  }

  effect review(): CalendarSyncReview!SyncFailure {
    return try this.#work(effect {
      const { context, check, store } = try this.#context()
      try this.#port(context.client, context)
      try check()
      const events = try this.#events(context)
      if (events.length > CALENDAR_LINK_LIMIT) throw refuse("Calendar sync supports up to 2,000 linked local events. Nothing changed.")
      try this.#unchanged(context, events, check, "Your local calendar changed. Review sync again.")
      return { reviewIdentity: context.reviewIdentity, scope: store.scope, binding: { ...context.binding }, events: events.map((event) => ({ ...event })) }
    })
  }

  effect enabled(): boolean!SyncFailure {
    return try this.#work(effect {
      const { store } = try this.#context()
      return try this.#preference.read(store.scope)
    })
  }

  effect enable(review: CalendarSyncReview): void!SyncFailure {
    try this.#work(effect {
      const { context, check, store } = try this.#context()
      if (context.reviewIdentity !== review.reviewIdentity || store.scope !== review.scope || JSON.stringify(context.binding) !== JSON.stringify(review.binding)) {
        throw refuse("The selected account or calendar changed. Review sync again.")
      }
      const events = try this.#events(context)
      try check()
      if (JSON.stringify(events) !== JSON.stringify(review.events)) throw refuse("The event list changed. Review sync again.")
      try this.#unchanged(context, events, check, "An event changed. Review sync again.")
      try this.#port(context.client, context)
      try check()
      try this.#preference.write(store.scope, true)
      try check()
    })
  }

  effect pause(): void!(CalendarSyncRefused | CalendarSyncAborted) {
    this.cancel()
    const { store } = try this.#context()
    try this.#preference.write(store.scope, false)
  }

  effect sync(): CalendarSyncReport!SyncFailure {
    return try this.#work(effect {
      const { context, check, store } = try this.#context()
      const preference = this.#preference
      effect function opted(): void!(CalendarSyncRefused | CalendarSyncAborted) {
        try check()
        if (!(try preference.read(store.scope))) throw new CalendarSyncAborted({ reason: "Calendar sync is paused" })
        try check()
      }
      try opted()
      const client: CalendarSyncClient = { googleCalendarSync: (input, signal) => context.client.googleCalendarSync(input, signal) }
      const engine = new LinkedCalendarReconciler(store, context.local, try this.#port(client, context))
      const events = try this.#events(context)
      try opted()
      if (events.length > CALENDAR_LINK_LIMIT) throw refuse("Calendar sync link limit reached. No new events were linked.")
      try this.#unchanged(context, events, opted, "A local event changed before sync. Retry to review its current state.")
      for (const event of events) {
        try opted()
        try store.link(event.id, event.revision)
      }
      const report = emptyReport()
      for (const listed of try store.list()) {
        try opted()
        if (listed.state === "quarantined") {
          const release = { dispatchedAt: Date.parse(listed.updatedAt), settleMs: dispatchSettleMs, now: DateTime.toEpochMillis(try DateTime.now) }
          report[recoveredAs[try engine.recoverDispatch(listed, release)]]++
          continue
        }
        const row: LinkedCalendarEventRecord = !events.some((event) => event.id === listed.localEventId) && listed.providerEventId !== null
          && listed.state !== "paused" && listed.state !== "conflicted"
          ? try store.save(listed, { state: "dirty", pendingOperation: "delete" }) : listed
        let outcome = try engine.reconcile(row)
        if (outcome === "quarantined" && context.localDeletionUndone?.(row.localEventId) === true) {
          try opted()
          const latest = (try store.list()).find((item) => item.id === row.id)
          if (latest?.state === "quarantined" && latest.lastErrorCode === "LINKED_CALENDAR_LOCAL_DELETE_CAS_REJECTED") {
            try store.save(latest, { state: "paused", pendingOperation: null, lastErrorCode: "LINKED_CALENDAR_LOCAL_DELETE_UNDONE",
              lastErrorMessage: "Deletion undone. The local event is kept and its Google link is paused." })
            outcome = "paused"
          }
        }
        report[outcome]++
        try opted()
      }
      return report
    })
  }
}

export effect function createCalendarSyncHost(options: CalendarSyncHostOptions) {
  const gate = () => options.device?.()
  const reviewMessage = options.reviewMessage ?? ((events: number) => `Ready to link ${events} local events.`)
  const foreground = try foregroundSyncMachine()
  const listeners = new Set<() => void>()
  const settledListeners = new Set<() => void>()
  let destination: CalendarSyncDestination = { account: "", calendar: "" }
  let preparedBinding: CalendarSyncBinding | null = null
  let status = "Sync is off."
  let running = false
  let enabled = false
  let interactive = false
  let pendingLocalChange = false
  let pendingTimer: Fiber.Fiber<void, never> | undefined

  const changed = () => { for (const listener of [...listeners]) listener() }
  const host = <A>(promise: () => Promise<A>, message: string) => tryPromise({ try: promise, catch: () => refuse(message) })
  const saved = () => effect { return try readCalendarSyncSettings(try host(() => options.settings.read(), "Calendar sync settings could not be read.")) }

  const controller = new CalendarSyncController(async (signal) => {
    const context = await options.prepare(signal, { interactive })
    preparedBinding = { ...context.binding }
    if (context.destination !== undefined) destination = { ...context.destination }
    return context
  }, {
    effect read(scope) {
      const value = try saved()
      const device = gate()
      enabled = value?.scope === scope && value.enabled && (device === undefined || try host(() => device.enabled(), "The device sync switch could not be read."))
      return enabled
    },
    effect write(scope, nextEnabled) {
      const binding = preparedBinding
      if (binding === null) throw refuse("Review the Calendar sync destination again.")
      try host(() => options.settings.edit(() => ({ version: 1, scope, binding: { ...binding }, enabled: nextEnabled })), "Calendar sync settings changed. Review them again.")
      options.settingsWritten?.()
      enabled = nextEnabled
    },
  }, options.controller)

  effect function work<A>(action: A!SyncFailure, success: (result: A) => string, progress: string): A!SyncFailure {
    if (running) throw refuse("Calendar sync is already running.")
    running = true
    status = progress
    changed()
    const reported = Effect.catch(action, effect (error) => {
      status = calendarSyncFailureMessage(error)
      throw error
    })
    return try onExit(reported, (result) => sync(() => {
      if (Exit.isSuccess(result)) status = success(result.value)
      running = false
      changed()
      for (const listener of [...settledListeners]) listener()
    }))
  }

  const cancel = () => {
    controller.cancel()
    gate()?.cancel()
  }

  effect function syncPass(): CalendarSyncReport!SyncFailure {
    return try work(controller.sync(), calendarSyncReportMessage, "Syncing…")
  }

  effect function resume(): void!! {
    if (running || !options.foreground()) return
    const state = try foreground.get()
    if (!canReadOptIn(state)) return
    const issued = foreground.send({ type: "readOptIn" }) catch () => state
    const generation = issued.foreground.generation
    const result: OptInResult = effect {
      const config = try saved()
      return config !== null && config.enabled && calendarSyncTargetMatches(config.binding, options.target()) ? "OptInEnabled" as OptInResult : "OptInDisabled" as OptInResult
    } catch () => "OptInFailed" as OptInResult
    const returned = foreground.send({ type: "returnOptIn", g: generation, result }) catch () => issued
    if (returned.foreground.running !== generation) {
      if (returned.foreground.status === "SyncFailed" && returned.foreground.lastReturned === generation) {
        status = "Calendar sync settings could not be read. Saved events are retained."
        changed()
      }
      return
    }
    try ensuring(orElseSucceed(map(syncPass(), () => undefined), () => undefined), orElseSucceed(foreground.send({ type: "finishPass" }), () => issued))
  }

  effect function retire(kind: "hideForeground" | "stopForeground"): void!! {
    const state = try foreground.get()
    if (state.foreground.active && state.foreground.visible) foreground.send({ type: kind }) catch () => state
    if (pendingTimer !== undefined) try Fiber.interrupt(pendingTimer)
    cancel()
  }

  effect function revive(): void!! {
    const state = try foreground.get()
    if (!state.foreground.active) foreground.send({ type: "startAgain" }) catch () => state
    const now = try foreground.get()
    if (!now.foreground.visible) foreground.send({ type: "showForeground" }) catch () => now
    try resume()
  }

  effect function localChanged(): void!! {
    if (!enabled || !options.foreground()) return
    if (running) {
      pendingLocalChange = true
      return
    }
    if (pendingTimer !== undefined) try Fiber.interrupt(pendingTimer)
    pendingTimer = fork.detached (effect {
      try sleep(Duration.millis(options.localChangeDelayMs ?? 400))
      if (!running && enabled && options.foreground()) map(syncPass(), () => undefined) catch () => undefined
    })
  }

  return {
    subscribe(listener: () => void): () => void {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    snapshot: (): CalendarSyncHostSnapshot => ({ status, running, enabled }),
    effect settings() {
      const loaded = effect {
        const config = try saved()
        const target = options.target()
        let on = config !== null && config.enabled && calendarSyncTargetMatches(config.binding, target)
        if (on && config !== null && gate() !== undefined) {
          const key = options.identity()
          const local = try host(() => options.source(target, () => options.foreground() && options.identity() === key), "The local calendar could not be read.")
          on = local.deviceEnabled === true && local.revision === config.binding.localSourceRevision
          if (!on) status = "Device sync needs a new review. Saved events are retained."
        }
        return on
      } catch () => false
      enabled = loaded
      changed()
    },
    effect linkedProviderEvents() {
      const config = try saved()
      const target = options.target()
      if (config === null || !config.enabled || !calendarSyncTargetMatches(config.binding, target)) return new Set<string>()
      const key = options.identity()
      const current = () => options.foreground() && options.identity() === key
      const local = try host(() => options.source(target, current), "The local calendar could not be read.")
      if (local.revision !== config.binding.localSourceRevision) return new Set<string>()
      const store = try CalendarLinkedStore.open(config.binding, current, options.storage, { idempotencyNamespace: options.controller?.idempotencyNamespace })
      return new Set((try store.list()).flatMap((row) => row.providerEventId !== null && (row.state === "clean" || row.state === "dirty") ? [row.providerEventId] : []))
    },
    destination: (): CalendarSyncDestination => ({ ...destination }),
    review: () => work(effect {
      interactive = true
      return try ensuring(controller.review(), sync(() => { interactive = false }))
    }, (review) => reviewMessage(review.events.length), "Reviewing calendar…"),
    effect enable(review: CalendarSyncReview) {
      try work(effect {
        const device = gate()
        if (device === undefined) return try controller.enable(review)
        if (review.reviewIdentity !== options.identity()) throw refuse("Calendar account changed. Review sync again.")
        try host(() => device.enable(() => options.foreground() && review.reviewIdentity === options.identity()), "The device sync switch could not be turned on.")
        effect {
          const refreshed = try controller.review()
          try controller.enable(refreshed)
        } catch effect (error) => {
          host(() => device.pause(), "The device sync switch could not be paused.") catch () => undefined
          throw error
        } }, () => "Sync enabled.", "Enabling sync…")
      return try syncPass()
    },
    sync: syncPass,
    effect pause() {
      controller.cancel()
      const device = gate()
      if (device !== undefined) try host(() => device.pause(), "The device sync switch could not be paused.")
      try host(() => options.settings.edit((value) => value === null ? null : { ...value, enabled: false }), "Calendar sync settings changed. Review them again.")
      options.settingsWritten?.()
      enabled = false
      status = "Sync is off. Saved events and links are retained."
      changed()
    },
    cancel,
    resume,
    effect start() {
      let stopped = false
      let key = options.identity()
      const settled = () => {
        if (!pendingLocalChange) return
        pendingLocalChange = false
        runFork(localChanged())
      }
      settledListeners.add(settled)
      try resume()
      return {
        ownerChanged: () => effect {
          if (stopped || options.identity() === key) return
          const changedExistingOwner = key !== ""
          key = options.identity()
          try retire("hideForeground")
          const device = gate()
          if (device !== undefined && changedExistingOwner) {
            enabled = false
            host(() => device.pause(), "pause") catch () => { status = "Device sync pause could not be confirmed. Check pending deletions." }
          }
          status = "Sync is off."
          changed()
          try revive()
        },
        localChanged: () => stopped ? Effect.void : localChanged(),
        visibilityChanged: () => effect {
          if (stopped) return
          if (options.foreground()) try revive()
          else try retire("hideForeground")
        },
        settingsChangedElsewhere: () => sync(() => {
          if (stopped) return
          cancel()
          status = "Sync settings changed in another view."
          changed()
        }),
        stop: () => effect {
          if (stopped) return
          stopped = true
          settledListeners.delete(settled)
          try retire("stopForeground")
        },
      }
    },
  }
}
