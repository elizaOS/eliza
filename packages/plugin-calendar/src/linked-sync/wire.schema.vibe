// spec/calendar/linkedReconcile.md, "A push retains its operation and uses the exact provider preconditions"; spec/calendar/linkedSync.md, "A link writes only to a verified owner destination, and a saved destination never switches"
import { sampledWireInstant } from "../availability/availability.schema.vibe"

// eslint-disable-next-line no-control-regex -- Wire identifiers exclude C0 controls and DEL in the schema pattern.
const plain = /^[^\u0000-\u001f\u007f]+$/
const Text = (max: number) => Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(max), Schema.isPattern(plain))
const InstantWire = Schema.String.check(Schema.isMaxLength(64), Schema.makeFilter((value) => Number.isFinite(Date.parse(value))))
const Instant = sampledWireInstant(InstantWire)
const TimedInstant = sampledWireInstant(InstantWire.check(Schema.isPattern(/(Z|[+-]\d{2}:\d{2})$/)), { allowDateOnly: false })
const CivilDate = Schema.String.check(Schema.isPattern(/^\d{4}-\d{2}-\d{2}$/))

export const SemanticAttendee = Schema.Struct({ email: Text(320), optional: Schema.Boolean })

export const SemanticEvent = Schema.Struct({
  title: Schema.String.check(Schema.isMaxLength(4000)),
  description: Schema.String,
  location: Schema.String,
  startAt: Schema.String.check(Schema.isMaxLength(64)),
  endAt: Schema.String.check(Schema.isMaxLength(64)),
  timeZone: Schema.NullOr(Schema.String.check(Schema.isMaxLength(128))),
  isAllDay: Schema.Boolean,
  attendees: Schema.Array(SemanticAttendee),
  recurrence: Schema.optionalKey(Schema.Array(Text(2048))),
  deleted: Schema.optionalKey(Schema.Boolean),
})

const TimedEvent = Schema.Struct({
  title: Text(4000),
  description: Schema.String,
  location: Schema.String,
  isAllDay: Schema.Literal(false),
  startAt: TimedInstant,
  endAt: TimedInstant,
  timeZone: Text(128),
  attendees: Schema.Array(SemanticAttendee),
  recurrence: Schema.optionalKey(Schema.Array(Text(2048))),
  deleted: Schema.optionalKey(Schema.Literal(false)),
})

const AllDayEvent = Schema.Struct({
  ...TimedEvent.fields,
  isAllDay: Schema.Literal(true),
  startAt: CivilDate,
  endAt: CivilDate,
  timeZone: Schema.Null,
})

export const ProviderEventWire = Schema.Struct({
  eventId: Text(1024),
  etag: Text(1024),
  event: Schema.Union([TimedEvent, AllDayEvent]),
})

export const SyncCapabilities = Schema.Struct({
  version: Schema.Literal(1),
  calendarId: Text(1024),
  accountId: Text(2048),
  read: Schema.Boolean,
  write: Schema.Boolean,
  conditionalWrites: Schema.Boolean,
  idempotentCreate: Schema.Boolean,
  providerExactlyOnce: Schema.Literal(false),
  accountEmail: Schema.optionalKey(Schema.String),
  calendarLabel: Schema.optionalKey(Schema.String),
})

export const SyncEnvelope = Schema.Struct({
  version: Schema.Literal(1),
  calendarId: Text(1024),
  providerExactlyOnce: Schema.Literal(false),
})

export const SyncRefusal = Schema.Struct({
  code: Schema.String.check(Schema.isPattern(/^CALENDAR_SYNC_/)),
  outcome: Schema.Literals(["not_accepted", "precondition_failed"]),
  error: Schema.optionalKey(Schema.String),
})

export const SyncBinding = Schema.Struct({
  environment: Schema.Literals(["production", "staging"]),
  userId: Text(1024),
  organizationId: Text(1024),
  connectionId: Text(1024),
  providerAccountId: Text(1024),
  calendarId: Text(1024),
  agentId: Text(1024),
  localSourceId: Text(1024),
  localSourceRevision: Text(1024),
})

const LinkState = Schema.Literals(["clean", "dirty", "conflicted", "quarantined", "paused", "local_only"])
const Nullable = (max: number) => Schema.NullOr(Text(max))

export const LinkRecord = Schema.Struct({
  id: Text(1024),
  agentId: Text(1024),
  localEventId: Text(1024),
  connectorAccountId: Text(1024),
  providerCalendarId: Text(1024),
  providerEventId: Nullable(1024),
  providerEtag: Nullable(1024),
  localRevision: Text(1024),
  lastCommonSemanticHash: Schema.NullOr(Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/))),
  state: LinkState,
  pendingOperation: Schema.NullOr(Schema.Literals(["create", "update", "delete"])),
  idempotencyKey: Text(1024),
  lastErrorCode: Nullable(1024),
  lastErrorMessage: Schema.NullOr(Schema.String.check(Schema.isMaxLength(4096))),
  createdAt: Instant,
  updatedAt: Instant,
})

export const LinkDocument = Schema.Struct({
  version: Schema.Literal(1),
  owner: Text(128),
  links: Schema.Array(LinkRecord).check(Schema.isMaxLength(2000)),
})

export const SyncSettings = Schema.Struct({
  version: Schema.Literal(1),
  scope: Schema.String,
  binding: SyncBinding,
  enabled: Schema.Boolean,
})
