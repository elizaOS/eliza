// spec/calendar/actions.md, "An approved change runs only with its reviewed fields for the account that approved it"; spec/calendar/actions.md, "A create is reported only after it reads back from the same calendar"; spec/calendar/actions.md, "A change's result names its target as read before the change and the version it produced"; spec/calendar/seriesScope.md, "A write names its scope: this event, this and following, or all"; spec/calendar/actions.md, "A repeating create carries its reviewed recurrence and reads back with it"; spec/calendar/actions.md, "Only an invitee answers an invitation, and an invitee's delete is a decline"; spec/calendar/actions.md, "Attendees hear of a change only when the owner asked and the calendar can tell them"; spec/calendar/actions.md, "The managed Google calendar is read and changed as one of the active account's calendars"
import { sha256Hex } from "@elizaos/core"
import { createOutcome, invitationVerdict, managedEditTargetAllowed, repeatingCreateAllowed, receiptVersion, reviewStillBinds, type InvitationChange, type InvitationVerdict, type OwnerRole } from "../../gen/calendar__actions.effect.vibe"
import { knownTimeZone } from "../clock.vibe"
import { holdsRecurrence, type CalendarRecurrence } from "../series/recurrence-rule.vibe"
import { sameSourceKey, utcInstant, type CalendarEvent, type CalendarEventFields, type CalendarSourceKey } from "../model.vibe"
import { answeredWith, eventVersion, fieldsOf, holdsFields, ownerRole, type CalendarAccount, type CalendarProviderPort } from "../plugin/providers.vibe"
import {
  CalendarPreflightRefused, CalendarWriteNotAccepted, CalendarWriteUnconfirmed,
  type CalendarMutationFailure, type CalendarMutationPayload, type CalendarMutationPort, type CalendarMutationReceipt, type CalendarMutationRequest,
} from "./ledger.vibe"

export interface CalendarProviders {
  active(): (CalendarAccount | undefined)!!
  port(provider: CalendarSourceKey["provider"]): (CalendarProviderPort | undefined)!!
}

function canonical(value: unknown): string {
  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`
  if (value !== null && typeof value === "object") {
    const entries = Object.entries(value).sort(([left], [right]) => left < right ? -1 : left > right ? 1 : 0)
    return `{${entries.map(([key, inner]) => `${JSON.stringify(key)}:${canonical(inner)}`).join(",")}}`
  }
  return JSON.stringify(value) ?? "null"
}

export function reviewDigest(payload: CalendarMutationPayload): string {
  return sha256Hex(canonical(payload))
}

export function fieldsSpanValid(fields: CalendarEventFields): boolean {
  const start = utcInstant(fields.startAt)
  const end = utcInstant(fields.endAt)
  return start !== undefined && end !== undefined && end > start
}

export function recurrenceFits(fields: CalendarEventFields, recurrence: CalendarRecurrence): boolean {
  return (fields.isAllDay || knownTimeZone(fields.timeZone)) && (recurrence.until === undefined || Date.parse(recurrence.until) >= Date.parse(fields.startAt))
}

const failure = (code: string, message: string, retryable: boolean): CalendarMutationFailure => ({ code, message, retryable })
const refuse = (code: string, message: string, retryable = false) => new CalendarPreflightRefused({ failure: failure(code, message, retryable) })
const unconfirmed = (code: string, message: string) => new CalendarWriteUnconfirmed({ failure: failure(code, message, false) })

export function invitationChangeOf(action: Exclude<CalendarMutationPayload["action"], "schedule_event">): InvitationChange {
  return action === "modify_event" ? "EditEvent" : action === "cancel_event" ? "DeleteEvent" : "AnswerInvitation"
}

function invitationRefusal(change: InvitationChange, role: OwnerRole, verdict: InvitationVerdict): { readonly code: string; readonly message: string } {
  if (verdict === "RefuseScope") return { code: "CALENDAR_RECURRENCE_RESPONSE_SCOPE_UNSUPPORTED", message: "An invitation is answered for this event or the whole series, not this and following." }
  if (verdict === "RefuseUnsupported") return { code: "CALENDAR_INVITATION_RESPONSE_UNSUPPORTED", message: "That calendar's provider can't answer invitations." }
  if (verdict === "RunAsDecline") return { code: "CALENDAR_CANCELLATION_AUTHORITY_MISMATCH", message: "You are invited to this event, so it can be declined but not removed." }
  if (role === "UnknownRole") return { code: "CALENDAR_ORGANIZER_IDENTITY_UNKNOWN", message: "The calendar doesn't say whether you organize this event or were invited." }
  return change === "AnswerInvitation"
    ? { code: "CALENDAR_INVITATION_RESPONSE_AUTHORITY_MISMATCH", message: "Only an invitee can answer this invitation." }
    : { code: "CALENDAR_INVITATION_MODIFY_FORBIDDEN", message: "Only the organizer can change this event." }
}

function sourceOf(payload: CalendarMutationPayload): CalendarSourceKey {
  return payload.action === "schedule_event" ? payload.source : payload.target.source
}

function fromSource(event: CalendarEvent, source: CalendarSourceKey): boolean {
  return event.provider === source.provider && event.side === source.side && event.calendarId === source.calendarId
    && (event.connectorAccountId ?? source.connectorAccountId) === source.connectorAccountId
}

export function providerMutationPort(providers: CalendarProviders): CalendarMutationPort {
  effect function bound(request: CalendarMutationRequest) {
    const account = try providers.active()
    if (account === undefined || !reviewStillBinds(request.payload.account, account.accountId, request.digest, reviewDigest(request.payload))) {
      throw refuse("CALENDAR_REVIEW_UNBOUND", "The account or the change differs from the one that was reviewed.")
    }
    const source = sourceOf(request.payload)
    const port = try providers.port(source.provider)
    if (port === undefined) throw refuse("CALENDAR_PROVIDER_UNAVAILABLE", "That calendar's provider is not connected.", true)
    return { account, source, port }
  }

  effect function readBack(port: CalendarProviderPort, account: CalendarAccount, source: CalendarSourceKey, eventId: string) {
    return port.get(account, source, eventId) catch effect () => { throw unconfirmed("CALENDAR_READBACK_UNAVAILABLE", "The calendar could not be read back after the change.") }
  }

  return {
    effect preflight(request) {
      const { account, source, port } = try bound(request)
      if (request.payload.action === "respond_invitation" && port.respond === undefined) {
        const refusal = invitationRefusal("AnswerInvitation", "InviteeRole", "RefuseUnsupported")
        throw refuse(refusal.code, refusal.message)
      }
      if (request.payload.action === "cancel_event" && port.remove === undefined) throw refuse("CALENDAR_DELETE_UNSUPPORTED", "That calendar's provider can't delete events from here. Nothing was changed.")
      const listed = port.sources(account) catch effect () => { throw refuse("CALENDAR_SOURCE_UNAVAILABLE", "The calendar could not be listed.", true) }
      const writable = listed.find((row) => sameSourceKey(row, source))
      if (writable === undefined || (writable.accessRole !== "owner" && writable.accessRole !== "writer")) {
        throw refuse("CALENDAR_SOURCE_NOT_WRITABLE", "That calendar is not one this account can write.")
      }
      const payload = request.payload
      if ((payload.action === "schedule_event" || payload.action === "modify_event") && !fieldsSpanValid(payload.fields)) throw refuse("CALENDAR_FIELDS_INVALID", "The reviewed start and end are not an ordered span.")
      if (payload.action === "schedule_event") {
        const carrier = port.provider === "eliza" ? "ResidentRows" : port.recurrenceLines && writable.recurrenceLines !== false ? "ProviderRuleLines" : "ProviderWithoutRules"
        if (!repeatingCreateAllowed(payload.recurrence !== null, carrier)) {
          throw refuse("CALENDAR_RECURRENCE_UNSUPPORTED", "That calendar's provider can't save a repeating event, so it was not created.")
        }
        if (payload.recurrence !== null && !recurrenceFits(payload.fields, payload.recurrence)) {
          throw refuse("CALENDAR_RECURRENCE_INVALID", "A repeating event needs a known time zone and an end of repeats no earlier than its start.")
        }
        return { target: null }
      }
      const target = port.get(account, source, payload.target.eventId) catch effect () => { throw refuse("CALENDAR_SOURCE_UNAVAILABLE", "The event could not be read.", true) }
      if (target === undefined) throw refuse("CALENDAR_EVENT_NOT_FOUND", "That event is no longer in the calendar.")
      if (eventVersion(target) !== payload.target.expectedVersion) throw refuse("CALENDAR_TARGET_CHANGED", "The event changed since it was reviewed.")
      if (port.provider === "google" && payload.action === "modify_event" &&
        !managedEditTargetAllowed((target.recurrence?.length ?? 0) > 0, typeof target.recurringEventId === "string" && target.recurringEventId !== "")) {
        throw refuse("CALENDAR_MANAGED_SERIES_REVIEW_REQUIRED", "Select one occurrence in the managed calendar. Nothing was changed.")
      }
      const change = invitationChangeOf(payload.action)
      const role = ownerRole(target, writable.accountEmail)
      const verdict = invitationVerdict(change, role, port.respond !== undefined, payload.scope === "this_and_following")
      if (verdict !== "RunAsAsked") {
        const refusal = invitationRefusal(change, role, verdict)
        throw refuse(refusal.code, refusal.message)
      }
      return { target }
    },
    effect execute(request, preflight) {
      const { account, source, port } = try mapError(bound(request), (refused) => new CalendarWriteNotAccepted({ failure: refused.failure }))
      const payload = request.payload
      if (payload.action === "schedule_event") {
        const made = try port.create(account, source, payload.fields, payload.recurrence, request.id)
        const read = try readBack(port, account, source, made.id)
        const allDayZone = port.provider === "google" && payload.fields.isAllDay ? payload.fields.timeZone : undefined
        const outcome = createOutcome(true, read !== undefined, read !== undefined && fromSource(read, source),
          read !== undefined && holdsFields(read, payload.fields) && holdsRecurrence(read.recurrence, payload.recurrence, allDayZone))
        if (outcome !== "CreatedAndRead" || read === undefined) throw unconfirmed("CALENDAR_CREATE_UNCONFIRMED", "The created event did not read back from the same calendar.")
        return { operation: payload.action, source, eventId: read.id, providerVersion: eventVersion(read), event: read, target: null, acceptedAt: read.updatedAt } satisfies CalendarMutationReceipt
      }
      const target = preflight.target
      if (target === null) throw unconfirmed("CALENDAR_TARGET_UNREAD", "The change has no target read before it.")
      if (payload.action === "respond_invitation") {
        if (port.respond === undefined) throw new CalendarWriteNotAccepted({ failure: failure("CALENDAR_INVITATION_RESPONSE_UNSUPPORTED", "That calendar's provider can't answer invitations.", false) })
        const answered = try port.respond(account, source, payload.target.eventId, payload.scope, payload.response, payload.target.expectedVersion, request.id, payload.notifyAttendees === true)
        const read = try readBack(port, account, source, answered.id)
        const version = read === undefined ? "" : eventVersion(read)
        if (read === undefined || !fromSource(read, source) || !answeredWith(read, payload.response) || !holdsFields(read, fieldsOf(target)) || version === "") {
          throw unconfirmed("CALENDAR_RESPONSE_UNCONFIRMED", "The event did not read back with your answer.")
        }
        return { operation: payload.action, source, eventId: payload.target.eventId, providerVersion: version, event: read, target, acceptedAt: read.updatedAt } satisfies CalendarMutationReceipt
      }
      if (payload.action === "modify_event") {
        const changed = try port.update(account, source, payload.target.eventId, payload.scope, payload.fields, payload.target.expectedVersion, request.id, payload.notifyAttendees === true)
        const read = try readBack(port, account, source, changed.id)
        const version = read === undefined ? "" : eventVersion(read)
        if (read === undefined || !fromSource(read, source) || !holdsFields(read, payload.fields)
          || receiptVersion("UpdateChange", eventVersion(target) !== "", version !== "") !== "FromChangedEvent") {
          throw unconfirmed("CALENDAR_UPDATE_UNCONFIRMED", "The changed event did not read back with the reviewed fields.")
        }
        return { operation: payload.action, source, eventId: payload.target.eventId, providerVersion: version, event: read, target, acceptedAt: read.updatedAt } satisfies CalendarMutationReceipt
      }
      if (port.remove === undefined) throw new CalendarWriteNotAccepted({ failure: failure("CALENDAR_DELETE_UNSUPPORTED", "That calendar's provider can't delete events from here.", false) })
      try port.remove(account, source, payload.target.eventId, payload.scope, payload.target.expectedVersion, request.id, payload.notifyAttendees === true)
      if ((try readBack(port, account, source, payload.target.eventId)) !== undefined) throw unconfirmed("CALENDAR_DELETE_UNCONFIRMED", "The deleted event still reads back.")
      if (receiptVersion("DeleteChange", eventVersion(target) !== "", false) !== "FromDeletedTarget") throw unconfirmed("CALENDAR_DELETE_UNVERSIONED", "The deleted event had no version.")
      const acceptedAt = new Date(try Clock.currentTimeMillis).toISOString()
      return { operation: payload.action, source, eventId: target.id, providerVersion: `deleted:${eventVersion(target)}`, event: null, target, acceptedAt } satisfies CalendarMutationReceipt
    },
  }
}
