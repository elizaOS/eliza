// spec/calendar/readClock.md, "A stated year wins, a wrong extracted year is corrected, and a past start asks first"; spec/calendar/reviewedReads.md, "A new phone event starts at the day and time the owner stated, in the phone's zone"; spec/calendar/reviewedReads.md, "A change after a shared read is the edits the owner's words gave, keeping every other field"; spec/calendar/availability.md, "An availability window is the day and time the owner asked about, in the phone's zone"; spec/calendar/reviewedReads.md, "A selected target, a chosen calendar and a named event are the ones the owner gave"; spec/calendar/reviewedReads.md, "A delete is proposed only when the owner's own words ask for it, and a no keeps the event"; spec/calendar/actions.md, "Attendees hear of a change only when the owner asked and the calendar can tell them"; spec/calendar/actions.md, "A resident delete runs at once only for the one event the owner named, and otherwise asks in chat"; spec/calendar/actions.md, "A new event's guests and a change of guests are the ones the owner's words give"; spec/calendar/seriesScope.md, "A chat change to a repeating event asks which occurrences unless the request or the owner's words say"; spec/calendar/actions.md, "A change finds its one event from a year back to five years ahead, and never calls an unread calendar empty"
import { nameSaid } from "../gen/calendar__reviewedReads.effect.vibe"
import { addDaysToLocalDate, buildUtcDateFromLocalParts, getZonedDateParts, knownTimeZone, type LocalDate } from "./clock.vibe"
import type { CalendarWriteScope } from "./series/document.vibe"

export interface StatedClockTime {
  readonly hour: number
  readonly minute: number
}

export type StatedClockTimes =
  | { readonly kind: "none" }
  | { readonly kind: "one"; readonly start: StatedClockTime; readonly end?: StatedClockTime }
  | { readonly kind: "several" }

export function compiled(source: string, flags: string): RegExp {
  try {
    return new RegExp(source, flags)
  } catch {
    return flags.includes("g") ? /(?!)/g : /(?!)/
  }
}

const locales = ["en", "zh-CN", "ko", "es", "pt", "vi", "tl"]

function localeNames(build: (locale: string, style: "long" | "short") => readonly string[]): Readonly<Record<string, number>> {
  const map: Record<string, number> = {}
  for (const locale of locales) {
    for (const style of ["long", "short"] as const) {
      try {
        build(locale, style).forEach((name, index) => {
          const key = name.toLowerCase().replace(/\.$/, "")
          if (key.length > 0) map[key] = index
        })
      } catch {
        continue
      }
    }
  }
  return map
}

const monthMap = localeNames((locale, style) => {
  const format = new Intl.DateTimeFormat(locale, { month: style, timeZone: "UTC" })
  return Array.from({ length: 12 }, (_, month) => format.format(new Date(Date.UTC(2024, month, 15))))
})
const weekdayMap = localeNames((locale, style) => {
  const format = new Intl.DateTimeFormat(locale, { weekday: style, timeZone: "UTC" })
  return Array.from({ length: 7 }, (_, weekday) => format.format(new Date(Date.UTC(2024, 0, 7 + weekday))))
})

const spacedWordChar = String.raw`(?![\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}])[\p{L}\p{M}\p{N}_]`
const spacedWordCharPattern = compiled(`^${spacedWordChar}$`, "u")

function wholeWord(name: string): string {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
  const open = spacedWordCharPattern.test(name.at(0) ?? "") ? `(?<!${spacedWordChar})` : ""
  const close = spacedWordCharPattern.test(name.at(-1) ?? "") ? `(?!${spacedWordChar})` : ""
  return `${open}${escaped}${close}`
}

const longestFirst = (names: readonly string[]) => [...names].sort((a, b) => b.length - a.length)
const hanWeekdayPrefix = /^(?:周|週|星期|礼拜|禮拜)/u
const hanCountBefore = "(?<![〇零一二两兩三四五六七八九十百几幾数數0-9０-９])"

function weekdaySource(name: string): string {
  const source = wholeWord(name)
  if (!hanWeekdayPrefix.test(name)) return source
  return `${hanCountBefore}${source}${name.endsWith("日") ? "(?![程期子常记記历曆])" : "(?![天次个個年月周週遍回])"}`
}

const monthNamePattern = compiled(
  `(${longestFirst(Object.keys(monthMap)).map(wholeWord).join("|")})\\.?\\s+(\\d{1,2})(?:st|nd|rd|th)?(?:,?\\s+(\\d{4}))?\\b`, "iu")
const weekdayNamePattern = compiled(
  `(?:(?<!${spacedWordChar})(this|next)\\s+)?(${longestFirst(Object.keys(weekdayMap).filter((name) => name.length > 1)).map(weekdaySource).join("|")})`, "iu")
const cjkNextWeek = /(?:(?<![\p{L}\p{N}])(?:다음\s*주|담주)(?:\s*의)?|(?<!下)下个?(?:周|星期|礼拜|禮拜)?的?)\s*$/u
const cjkWeekAfterNext = /(?:(?<![\p{L}\p{N}])(?:다다음\s*주|다담주)(?:\s*의)?|(?<!下)下下个?(?:周|星期|礼拜|禮拜)?的?)\s*$/u
const cjkUnresolvedWeek = /(?:(?<![\p{L}\p{N}])(?:지난\s*주|지난|저번\s*주|저번|매주|매)(?:\s*의)?|(?:上个?|每个?)(?:周|星期|礼拜|禮拜)?的?)\s*$/u
const countWords: Readonly<Record<string, number>> = { a: 1, an: 1, one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, nine: 9, ten: 10 }

const normalized = (value: string) => value.trim().toLowerCase().replace(/\s+/g, " ")
const lookupKey = (value: string) => value.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "")

function count(token: string): number | undefined {
  return /^\d{1,3}$/.test(token) ? Number(token) : countWords[token]
}

function relativeDayOffset(text: string): number | undefined {
  if (/\bday after tomorrow\b/.test(text)) return 2
  if (/\bday before yesterday\b/.test(text)) return -2
  const inSpan = /\bin (\d{1,3}|a|an|one|two|three|four|five|six|seven|eight|nine|ten) (days?|weeks?)\b/.exec(text)
    ?? /\b(\d{1,3}|a|an|one|two|three|four|five|six|seven|eight|nine|ten) (days?|weeks?) from (?:now|today)\b/.exec(text)
  const spanned = inSpan === null ? undefined : count(inSpan[1])
  if (inSpan !== null && spanned !== undefined) return inSpan[2].startsWith("week") ? spanned * 7 : spanned
  if (/\btomorrow\b/.test(text)) return 1
  if (/\byesterday\b/.test(text)) return -1
  if (/\btoday\b/.test(text)) return 0
  return undefined
}

function realDay(year: number, month: number, day: number): boolean {
  if (!Number.isInteger(year) || !Number.isInteger(month) || !Number.isInteger(day) || month < 1 || month > 12 || day < 1) return false
  const date = new Date(0)
  date.setUTCFullYear(year, month - 1, day)
  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day
}

function leadingYear(before: string, thisYear: number): number | undefined {
  const explicit = /(?<!\p{N})(\d{4})[년年]\s*$/u.exec(before)
  if (explicit !== null) return Number(explicit[1])
  if (/(?:(?<![\p{L}\p{M}\p{N}_])내년|明年)\s*$/u.test(before)) return thisYear + 1
  if (/(?:(?<![\p{L}\p{M}\p{N}_])올해|今年)\s*$/u.test(before)) return thisYear
  return undefined
}

function weekdayDate(text: string, today: LocalDate): LocalDate | undefined {
  const match = weekdayNamePattern.exec(text)
  const before = match === null ? "" : text.slice(0, match.index)
  if (match === null || cjkUnresolvedWeek.test(before)) return undefined
  const weeksAhead = cjkWeekAfterNext.test(before) ? 2 : cjkNextWeek.test(before) ? 1 : 0
  const target = weekdayMap[lookupKey(match[2] ?? "")]
  if (target === undefined) return undefined
  const current = new Date(Date.UTC(today.year, today.month - 1, today.day, 12)).getUTCDay()
  const monday = (weekday: number) => (weekday + 6) % 7
  const ahead = (target - current + 7) % 7
  const delta = weeksAhead > 0 ? 7 * weeksAhead - monday(current) + monday(target)
    : lookupKey(match[1] ?? "") === "next" ? (ahead === 0 ? 7 : ahead + 7) : ahead
  return addDaysToLocalDate(today, delta)
}

export function parseExplicitLocalDate(value: string, timeZone: string, now: Date): LocalDate | undefined {
  const text = normalized(value)
  const today = getZonedDateParts(now, timeZone)
  if (today === undefined) return undefined
  const iso = /\b(\d{4})-(\d{1,2})-(\d{1,2})\b/.exec(text)
  if (iso !== null) {
    const date = { year: Number(iso[1]), month: Number(iso[2]), day: Number(iso[3]) }
    return realDay(date.year, date.month, date.day) ? date : undefined
  }
  const named = monthNamePattern.exec(text)
  if (named !== null) {
    const month = monthMap[lookupKey(named[1] ?? "")]
    if (month === undefined) return undefined
    const year = named[3] !== undefined ? Number(named[3]) : leadingYear(text.slice(0, named.index), today.year) ?? today.year
    const date = { year, month: month + 1, day: Number(named[2]) }
    return realDay(date.year, date.month, date.day) ? date : undefined
  }
  const numeric = /\b(\d{1,2})([/-])(\d{1,2})(?:[/-](\d{2,4}))?\b/.exec(text)
  if (numeric !== null) {
    const raw = numeric[4]
    const year = raw === undefined ? leadingYear(text.slice(0, numeric.index), today.year) ?? today.year : raw.length === 2 ? 2000 + Number(raw) : Number(raw)
    const date = { year, month: Number(numeric[1]), day: Number(numeric[3]) }
    const timeRange = raw === undefined && numeric[2] === "-" && weekdayNamePattern.test(text)
    if (realDay(date.year, date.month, date.day) && !timeRange) return date
  }
  const weekday = weekdayDate(text, today)
  if (weekday !== undefined) return weekday
  const offset = relativeDayOffset(text)
  return offset === undefined ? undefined : addDaysToLocalDate(today, offset)
}

export const destinationMarker = /\b(?:to|(?:for|until|till)(?=\s+(?:today|tonight|tomorrow|(?:this|next)\s+(?:week(?:end)?|month|morning|afternoon|evening|(?:mon|tues|wednes|thurs|fri|satur|sun)day)\b|(?:mon|tue|tues|wed|thu|thur|thurs|fri|sat|sun)(?:day)?\b|(?:tues|wednes|thurs|satur)day\b|(?:jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|june?|july?|aug(?:ust)?|sept?(?:ember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\.?(?=\s+\d|\s*$)|noon\b|midnight\b|\d{1,2}(?:[:/.-]\d|\s*(?:a\.?m\b|p\.?m\b)|(?:st|nd|rd|th)\b|\s*$|\s+(?:a\.?m\b|p\.?m\b|o['’]clock\b)))))\b/i
const eventDayMarker = /\b(?:on|from|of)\s+(?:the\s+)?(?:today|tonight|tomorrow|yesterday|this\b|next\b|last\b|(?:mon|tue|wed|thu|fri|sat|sun)[a-z]*\b|(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\b|\d)|\b(?:today|tonight|tomorrow|yesterday|(?:mon|tues|wednes|thurs|fri|satur|sun)day)['’]s?\b/i

interface EventDayAsk {
  readonly moving: boolean
  readonly titles: readonly string[]
  readonly query: string
  readonly zone: string
  readonly now: Date
}

interface EventDay {
  readonly date: LocalDate
  readonly followsName: boolean
  readonly marksTheEvent: boolean
}

const nameIn = (name: string, text: string) => name.trim() === "" ? null : compiled(literal(name.trim()), "iu").exec(text)

export function eventDayInWords(text: string, asked: EventDayAsk): EventDay | undefined {
  const unnamed = asked.titles.reduce((left, title) => title.trim() === "" ? left : left.replace(compiled(literal(title.trim()), "giu"), " "), text)
  const cut = asked.moving ? unnamed.search(destinationMarker) : -1
  const about = cut === -1 ? unnamed : unnamed.slice(0, cut)
  const date = parseExplicitLocalDate(about, asked.zone, asked.now)
  if (date === undefined) return undefined
  const named = [...asked.titles, asked.query].map((name) => nameIn(name, text)).find((found) => found !== null)
  const followsName = named !== undefined && named !== null
    && parseExplicitLocalDate(text.slice(0, named.index), asked.zone, asked.now) === undefined
    && parseExplicitLocalDate(text.slice(named.index + named[0].length), asked.zone, asked.now) !== undefined
  return { date, followsName, marksTheEvent: cut !== -1 || eventDayMarker.test(about) }
}

const meridiem = String.raw`(a\.?m\.?|p\.?m\.?)`
const clockMentionSource = String.raw`\b(\d{1,2})(?::(\d{2}))?\s*${meridiem}(?![a-z])|\b(noon|midnight)\b|\b([01]\d|2[0-3]):([0-5]\d)\b(?!\s*${meridiem})`
const clockRange = compiled(String.raw`\b(\d{1,2})(?::(\d{2}))?\s*${meridiem}?\s*(?:-|–|—|until|till|through|to)\s*(\d{1,2})(?::(\d{2}))?\s*${meridiem}(?![a-z])`, "i")

function clockOf(hourText: string | undefined, minuteText: string | undefined, half: string | undefined): StatedClockTime | undefined {
  if (hourText === undefined) return undefined
  const hour = Number(hourText), minute = minuteText === undefined ? 0 : Number(minuteText)
  if (!Number.isInteger(hour) || !Number.isInteger(minute) || minute < 0 || minute > 59) return undefined
  if (half === undefined) return hour >= 0 && hour <= 23 ? { hour, minute } : undefined
  if (hour < 1 || hour > 12) return undefined
  return { hour: (hour % 12) + (half.toLowerCase().startsWith("p") ? 12 : 0), minute }
}

export function parseStatedClockTimes(value: string): StatedClockTimes {
  const text = normalized(value)
  const range = clockRange.exec(text)
  let remainder = text
  let start: StatedClockTime | undefined
  let end: StatedClockTime | undefined
  if (range !== null) {
    start = clockOf(range[1], range[2], range[3] ?? range[6])
    end = clockOf(range[4], range[5], range[6])
    if (start === undefined || end === undefined) return { kind: "several" }
    remainder = `${text.slice(0, range.index)} ${text.slice(range.index + range[0].length)}`
  }
  const mentions: StatedClockTime[] = []
  for (const match of remainder.matchAll(compiled(clockMentionSource, "gi"))) {
    const mention = match[4] !== undefined ? { hour: match[4].toLowerCase() === "noon" ? 12 : 0, minute: 0 }
      : match[5] !== undefined ? clockOf(match[5], match[6], undefined) : clockOf(match[1], match[2], match[3])
    if (mention === undefined) return { kind: "several" }
    mentions.push(mention)
  }
  if (start !== undefined) return mentions.length > 0 ? { kind: "several" } : { kind: "one", start, ...(end === undefined ? {} : { end }) }
  const distinct = new Set(mentions.map(({ hour, minute }) => `${hour}:${minute}`))
  const [only] = mentions
  if (distinct.size === 0 || only === undefined) return { kind: "none" }
  return distinct.size > 1 ? { kind: "several" } : { kind: "one", start: only }
}

export function statedLengths(value: string): readonly number[] | undefined {
  const found = [...value.matchAll(/\b(\d+(?:\.\d+)?)\s*(minutes?|mins?|hours?|hrs?)\b/giu)]
  if (/(?:[-+]\s*\d+|\d+\s*\/\s*\d+)\s*(?:minutes?|mins?|hours?|hrs?)/iu.test(value)) return undefined
  if (found.length === 0 && /\b(?:minutes?|mins?|hours?|hrs?)\b/iu.test(value)) return undefined
  return found.map(([, amount, unit]) => Math.round(Number(amount) * (/^h/i.test(unit ?? "") ? 3_600_000 : 60_000)))
}

export type StatedShift =
  | { readonly kind: "span"; readonly ms: number }
  | { readonly kind: "days"; readonly days: number }

const shiftCount = String.raw`\d+(?:\.\d+)?|an?|one|two|three|four|five|six|seven|eight|nine|ten`
const shiftAmount = compiled(String.raw`\bhalf\s+an?\s+hour\b|\b(${shiftCount})\s+(?:hours?\s+and\s+a\s+half|and\s+a\s+half\s+hours?)\b|\b(${shiftCount})\s*(minutes?|mins?|hours?|hrs?|days?|weeks?)\b`, "giu")
const laterShift = /\b(?:later|back|delay(?:ed)?|postpone(?:d)?|push(?:ed)?)\b/iu
const earlierShift = /\b(?:earlier|sooner|up)\b/iu

export function statedShift(value: string): StatedShift | "unclear" | undefined {
  const text = normalized(value)
  const amounts = [...text.matchAll(shiftAmount)]
  const later = laterShift.test(text), earlier = earlierShift.test(text)
  const [only] = amounts
  if (only === undefined || (!later && !earlier)) return undefined
  if (amounts.length > 1 || (later && earlier)) return "unclear"
  const sign = later ? 1 : -1
  const counted = (token: string) => /^\d/.test(token) ? Number(token) : count(token) ?? 0
  if (only[1] !== undefined) return { kind: "span", ms: sign * Math.round((counted(only[1]) + 0.5) * 3_600_000) }
  if (only[2] === undefined) return { kind: "span", ms: sign * 1_800_000 }
  const amount = counted(only[2])
  const unit = only[3] ?? ""
  if (/^(?:day|week)/i.test(unit)) {
    const days = amount * (/^week/i.test(unit) ? 7 : 1)
    return Number.isInteger(days) && days > 0 ? { kind: "days", days: sign * days } : "unclear"
  }
  const ms = Math.round(amount * (/^h/i.test(unit) ? 3_600_000 : 60_000))
  return Number.isSafeInteger(ms) && ms > 0 ? { kind: "span", ms: sign * ms } : "unclear"
}

export function localInstant(zone: string, date: LocalDate, clock: StatedClockTime): number | undefined {
  return buildUtcDateFromLocalParts(zone, { ...date, hour: clock.hour, minute: clock.minute, second: 0 }, "reject")?.getTime()
}

const leadingDecline = /^[\s"“'‘]*(?:no(?!\s+(?:need|longer)\b)|nope|nah|wait|hold\s+on|never\s*mind|nevermind|keep\s+it|leave\s+it|forget\s+(?:it|that))\b|^\s*cancel\s+that\s*[.!]*\s*$/iu
const folded = (text: string) => text.normalize("NFKC").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim()

export const deleteWords = /\b(?:delete|remove|cancel|clear|drop|erase|get\s+rid\s+of)\b|\btake\b[\s\S]*\boff\b/i

export function asksToDeleteInWords(text: string): boolean {
  return deleteWords.test(text) || denseDeleteTarget(text) !== undefined
}

const yesWords = /^[\s"“'‘]*(?:(?:yes|yeah|yea|yep|yup|sure|ok|okay|confirm(?:ed)?|correct|right|absolutely|definitely|please\s+do|go\s+ahead|do\s+it|delete\s+it|remove\s+it|that\s+one)\b|y\s*[.!]?\s*$)/iu

export function saysYes(text: string): boolean {
  return yesWords.test(text)
}

const people = String.raw`(?:all\s+|the\s+|my\s+|our\s+|both\s+)?(?:attendees?|guests?|invitees?|participants?|everyone|everybody|people|team|others|them|him|her)\b`
const someone = String.raw`(?!(?:me|us|you|it|this|that|the|a|an|my|our|what|when|how|why|where|if)\b)\p{L}+`
const noticeWords = compiled(String.raw`\b(?:notify|tell|e-?mail|inform|alert)\s+(?:${people}|${someone})|\b(?:message|update)\s+${people}|\blet\s+(?:${people}|${someone})\s+know\b|\bsend\s+(?:out\s+)?(?:an?\s+)?(?:updates?|notices?|notifications?)\b`, "iu")
const noticeVerbs = /notify|tell|e-?mail|inform|message|alert|let|send/

export function noticeAskedInWords(text: string): boolean {
  return noticeWords.test(text)
}

export function noticeDeclinedInWords(text: string): boolean {
  return compiled(String.raw`\b(?:don['’]?t|do\s+not|never|not|without|no\s+need\s+to)\s+(?:\p{L}+\s+){0,2}?(?:${noticeVerbs.source})\b`, "iu").test(text)
}

export interface NamedGuest {
  readonly email: string | null
  readonly displayName: string | null
}

function guestNames(guest: NamedGuest): readonly string[] {
  const address = guest.email ?? ""
  return [address, address.split("@")[0] ?? "", ...(guest.displayName ?? "").split(/\s+/u)].filter((name) => folded(name) !== "")
}

export function guestNamedInWords(guest: NamedGuest, text: string): boolean {
  return guestNames(guest).some((name) => namedInWords(name, text))
}

export function guestIs(guest: NamedGuest, said: string): boolean {
  const asked = folded(said)
  return asked !== "" && [...guestNames(guest), guest.displayName ?? ""].some((name) => folded(name) === asked)
}

const literal = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")

export function addressWrittenInWords(address: string, text: string): boolean {
  const asked = address.trim().toLowerCase()
  const pattern = String.raw`(?<![\w.+@-])` + literal(asked) + String.raw`(?![\w@+-])`
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/u.test(asked) && compiled(pattern, "u").test(text.normalize("NFKC").toLowerCase())
}

export function declinesInWords(text: string, verbs: RegExp): boolean {
  return leadingDecline.test(text) || compiled(String.raw`\b(?:don['’]?t|do\s+not|never|not|no\s+need\s+to)\s+(?!(?:forget|hesitate)\b)(?:\p{L}+\s+){0,2}?(?:${verbs.source})`, "iu").test(text)
}

export function namedInWords(name: string, text: string): boolean {
  return folded(name) !== "" && ` ${folded(text)} `.includes(` ${folded(name)} `)
}

const denseScript = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]/u
const denseDeletes = [
  /^(?:(?:请|請)\s*)?(?:删除|刪除)\s*(.+)$/u,
  /^(.+?)\s*を\s*削除して(?:ください)?$/u,
  /^(.+?)\s*(?:을|를)\s*(?:삭제해줘|삭제해\s*주세요)$/u,
]

export function denseDeleteTarget(text: string): string | undefined {
  const spoken = folded(text)
  for (const pattern of denseDeletes) {
    const target = pattern.exec(spoken)?.[1]?.trim()
    if (target !== undefined && target !== "") return target
  }
  return undefined
}

export function eventNamedInWords(name: string, text: string): boolean {
  const said = folded(name)
  return said !== "" && nameSaid(namedInWords(name, text), denseScript.test(said), denseDeleteTarget(text) === said)
}

export function wordsInWords(value: string, text: string): boolean {
  const said = new Set(folded(text).split(" "))
  const words = folded(value).split(" ").filter((word) => word !== "")
  return words.length > 0 && words.every((word) => said.has(word))
}

const zoneTerms = /\b(?:time\s*zones?|utc|gmt)\b/iu
const zoneNames = /\b(?:[ECMPA][SD]T|AK[SD]T|HST|BST|IST|[CEW]ES?T|[CEW]EDT|JST|KST|HKT|SGT|A[ECW][SD]T|NZ[SD]T|MSK)\b|\b[A-Z][A-Za-z_]+\/[A-Z][A-Za-z_]+\b|(?<=\S\s+)[A-Z][a-z]+(?:\s+[A-Z][a-z]+)?\s+time\b|(?:\d|[ap]\.?m\.?)\s*[+−]\d{1,2}(?::?\d{2})?\b|\d(?::\d{2})?\s*Z\b/u

export function namesAZone(text: string): boolean {
  return zoneTerms.test(text) || zoneNames.test(text)
}

export type NamedZone = { readonly kind: "none" } | { readonly kind: "zone"; readonly zone: string } | { readonly kind: "unknown" }

const singleZoneAbbreviations: Readonly<Record<string, string>> = {
  UTC: "UTC", GMT: "UTC", Z: "UTC", PST: "America/Los_Angeles", PDT: "America/Los_Angeles", PT: "America/Los_Angeles", MST: "America/Denver", MDT: "America/Denver",
  MT: "America/Denver", CST: "America/Chicago", CDT: "America/Chicago", CT: "America/Chicago", EST: "America/New_York", EDT: "America/New_York", ET: "America/New_York",
  AKST: "America/Anchorage", AKDT: "America/Anchorage", HST: "Pacific/Honolulu", JST: "Asia/Tokyo", KST: "Asia/Seoul", HKT: "Asia/Hong_Kong", SGT: "Asia/Singapore",
  CET: "CET", CEST: "CET", EET: "EET", EEST: "EET", WET: "WET", WEST: "WET", MSK: "Europe/Moscow", NZST: "Pacific/Auckland", NZDT: "Pacific/Auckland",
  AEST: "Australia/Sydney", AEDT: "Australia/Sydney", ACST: "Australia/Adelaide", ACDT: "Australia/Adelaide", AWST: "Australia/Perth",
}

function zoneCities(): Readonly<Record<string, string>> {
  const cities: Record<string, string> = {}
  try {
    for (const zone of Intl.supportedValuesOf("timeZone")) {
      const city = zone.split("/").at(-1)?.replace(/_/g, " ").toLowerCase()
      if (city !== undefined && zone.includes("/")) cities[city] = zone
    }
  } catch {
    return cities
  }
  return cities
}

const cityZones = zoneCities()
const ianaName = /\b([A-Z][A-Za-z_]+(?:\/[A-Z][A-Za-z_-]+){1,2})\b/u
const offsetZone = /\b(?:UTC|GMT)\s*([+−-])\s*(\d{1,2})(?::?(\d{2}))?\b/iu
const cityTime = /(?<=\S\s+)([A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)\s+time\b/u
const abbreviation = /(?:\d|[ap]\.?m\.?)\s*([A-Z]{1,5})\b|\b([A-Z]{2,5})\s+time\b/u

export function zoneNamedIn(text: string): NamedZone {
  if (!namesAZone(text)) return { kind: "none" }
  const offset = offsetZone.exec(text)
  if (offset !== null) {
    const hours = Number(offset[2]), minutes = Number(offset[3] ?? "0")
    if (minutes !== 0 || hours > 14) return { kind: "unknown" }
    return { kind: "zone", zone: hours === 0 ? "UTC" : `Etc/GMT${offset[1] === "+" ? "-" : "+"}${hours}` }
  }
  const iana = ianaName.exec(text)?.[1]
  if (iana !== undefined) return knownTimeZone(iana) ? { kind: "zone", zone: iana } : { kind: "unknown" }
  const city = cityTime.exec(text)?.[1]?.toLowerCase()
  const cityZone = city === undefined ? undefined : cityZones[city]
  if (cityZone !== undefined) return { kind: "zone", zone: cityZone }
  const short = abbreviation.exec(text)
  const named = short === null ? undefined : singleZoneAbbreviations[short[1] ?? short[2] ?? ""]
  if (named !== undefined) return { kind: "zone", zone: named }
  return /\b(?:utc|gmt)\b/iu.test(text) ? { kind: "zone", zone: "UTC" } : { kind: "unknown" }
}

const scopeWords: readonly (readonly [CalendarWriteScope, RegExp])[] = [
  ["instance", /\b(?:just|only)\s+(?:this|that)(?:\s+(?:one|time|occurrence|instance|event|meeting|week))?\b|\bthis\s+(?:one|occurrence|instance)\s+only\b|\bsingle\s+occurrence\b/i],
  ["this_and_following", /\b(?:this|that)(?:\s+(?:one|occurrence|instance|event|meeting|[a-z0-9_-]+))?\s+(?:and|&)\s+(?:(?:all|every)\s+)?(?:following|future|everything\s+after)(?:\s+(?:events|occurrences|instances|ones))?\b|\bfrom\s+(?:this|that)(?:\s+(?:one|occurrence|instance|event|meeting))?\s+(?:forward|onwards?|on)\b|\bstarting\s+(?:with|at)\s+(?:this|that)(?:\s+(?:one|occurrence|instance|event|meeting))?\b/i],
  ["series", /\b(?:whole|entire|full)\s+series\b|\bthe\s+series\b|\ball\s+(?:occurrences|instances|of\s+them)\b|\bevery\s+(?:occurrence|instance|single\s+one)\b|\bstop\s+(?:it\s+)?(?:from\s+)?(?:repeating|recurring)\b|\bcancel\s+the\s+recurring\b/i],
]

export function scopesInWords(text: string): CalendarWriteScope[] {
  return scopeWords.filter(([, pattern]) => pattern.test(text)).map(([scope]) => scope)
}
