// spec/calendar/actions.md, "A repeating create carries its reviewed recurrence and reads back with it"; spec/calendar/seriesScope.md, "An occurrence becomes a standalone override or an exclusion under its series"
import type { CalendarRow } from "./document.vibe"
import { getZonedDateParts } from "../clock.vibe"

export interface CalendarRecurrence {
  readonly rule: "daily" | "weekdays" | "weekly"
  readonly until?: string
  readonly excluded?: readonly string[]
}

export type RowRecurrence = Pick<CalendarRow, "repeat" | "until" | "excluded">

const rules: Record<CalendarRecurrence["rule"], string> = { daily: "RRULE:FREQ=DAILY", weekdays: "RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR", weekly: "RRULE:FREQ=WEEKLY" }

function stamp(instant: number): string {
  return new Date(Math.floor(instant / 1000) * 1000).toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z")
}

export function rowRecurrence(recurrence: CalendarRecurrence): RowRecurrence {
  return {
    repeat: recurrence.rule,
    ...(recurrence.until === undefined ? {} : { until: Date.parse(recurrence.until) + 1 }),
    ...(recurrence.excluded === undefined || recurrence.excluded.length === 0 ? {} : { excluded: [...new Set(recurrence.excluded.map((start) => Date.parse(start)))] }),
  }
}

export function recurrenceLines(row: RowRecurrence): string[] {
  if (row.repeat === undefined || row.repeat === "none") return []
  const rule = rules[row.repeat] + (row.until === undefined ? "" : `;UNTIL=${stamp(row.until - 1)}`)
  return [rule, ...[...new Set((row.excluded ?? []).map(stamp))].sort().map((at) => `EXDATE:${at}`)]
}

export function reviewedRecurrenceLines(recurrence: CalendarRecurrence | null): string[] {
  return recurrence === null ? [] : recurrenceLines(rowRecurrence(recurrence))
}

function dateStamp(value: string, zone: string): string | undefined {
  const parts = getZonedDateParts(new Date(value), zone)
  if (parts === undefined) return undefined
  return String(parts.year).padStart(4, "0") + String(parts.month).padStart(2, "0") + String(parts.day).padStart(2, "0")
}

export function reviewedGoogleRecurrenceLines(recurrence: CalendarRecurrence | null, allDayZone?: string): string[] | undefined {
  if (recurrence === null || allDayZone === undefined) return reviewedRecurrenceLines(recurrence)
  const bound = recurrence.until === undefined ? undefined : dateStamp(recurrence.until, allDayZone)
  if (recurrence.until !== undefined && bound === undefined) return undefined
  const excluded: string[] = []
  for (const start of recurrence.excluded ?? []) {
    const date = dateStamp(start, allDayZone)
    if (date === undefined) return undefined
    excluded.push(`EXDATE;VALUE=DATE:${date}`)
  }
  return [rules[recurrence.rule] + (bound === undefined ? "" : `;UNTIL=${bound}`), ...[...new Set(excluded)].sort()]
}

export function holdsRecurrence(lines: readonly string[] | null | undefined, recurrence: CalendarRecurrence | null, allDayZone?: string): boolean {
  const read = [...new Set(lines ?? [])].sort()
  const reviewed = reviewedGoogleRecurrenceLines(recurrence, allDayZone)?.sort()
  return reviewed !== undefined && read.length === reviewed.length && read.every((line, index) => line === reviewed[index])
}
