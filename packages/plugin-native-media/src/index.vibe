// spec/nativeMedia/index.md, "Story: Review an exact device media item before sharing or changing it"; spec/nativeMedia/index.md, "Media bytes and mutations need the same selection fence as the review"
import { mayUseMedia, type MediaFence, type MediaOperation } from "../gen/nativeMedia.effect.vibe"

export {
  deviceLibraryClient,
  deviceLibraryPlugin,
  permittedPhotosClient,
  permittedPhotosPlugin,
  photosClient,
  photosPlugin,
  selectedDocumentsClient,
  selectedDocumentsPlugin,
} from "@elizaos/os-bridges"
export type {
  AlbumChange,
  AlbumId,
  AlbumList,
  AlbumRevision,
  AlbumWritten,
  BatchReport,
  ChangedItem,
  CropRect,
  DeviceLibraryClient,
  DeviceLibraryPlugin,
  DocumentHandoff,
  DocumentStatus,
  DocumentText,
  EditOperationId,
  EditPreview,
  EditReceipt,
  EditSessionId,
  EditStatus,
  FlagChange,
  HandoffStatus,
  KeepOutcome,
  KindAccess,
  LibraryAccess,
  LibraryChange,
  LibraryFilter,
  LibraryPage,
  LibraryPageOptions,
  LibraryScope,
  LibraryScopeKind,
  LibrarySummary,
  ListOptions,
  MediaCursor,
  MediaId,
  MediaItem,
  MediaKind,
  MediaPage,
  MediaRevision,
  OwnedAlbum,
  OwnedListOptions,
  PdfPage,
  PermittedPhotosClient,
  PermittedPhotosPlugin,
  PhotoEdit,
  PhotosClient,
  PhotosPlugin,
  PreparedTrash,
  Reviewed,
  RowOutcome,
  RowStatus,
  SelectedDocument,
  SelectedDocumentsClient,
  SelectedDocumentsPlugin,
  SelectionId,
  ShareOpened,
  SharedMany,
  Thumbnail,
  TrashConfirmation,
  TrashReceipt,
  TrashSelection,
  Validated,
  VideoEdit,
  VideoEditSession,
} from "@elizaos/os-bridges"
export type { MediaFence, MediaOperation }

export function evaluateMediaSelectionFence(
  reviewed: MediaFence,
  observed: MediaFence,
  operation: MediaOperation,
  stillPermitted: boolean,
  ownerReviewed: boolean,
): boolean {
  return mayUseMedia(reviewed, observed, operation, stillPermitted, ownerReviewed)
}
