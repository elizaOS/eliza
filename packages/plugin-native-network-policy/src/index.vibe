// spec/nativeNetworkPolicy/index.md, "Story: Check the cost of the active connection before a passive download"
import { nativeReply } from "@elizaos/os-bridges"
import { networkPolicyPlugin } from "@elizaos/os-bridges"
import type { NetworkPolicyPlugin } from "@elizaos/os-bridges"
import { androidCost, appleCost, mayDownload, webCost, type Hint } from "../gen/nativeNetworkPolicy.effect.vibe"

export type { MeteredHint, PathHints, NetworkPolicyPlugin } from "@elizaos/os-bridges"
export { networkPolicyClient, networkPolicyPlugin } from "@elizaos/os-bridges"

const NativeMetered = Schema.Struct({ metered: Schema.NullOr(Schema.Boolean), source: Schema.Literal("android-os") })
const NativePath = Schema.Struct({ isExpensive: Schema.NullOr(Schema.Boolean), isConstrained: Schema.NullOr(Schema.Boolean), source: Schema.Literal("nw-path-monitor") })
const NATIVE_COST = "ElizaNetworkPolicy"

function hint(value: boolean | null): Hint {
  return value === null ? "HintUnknown" : value ? "HintYes" : "HintNo"
}

export const NetworkPolicy = networkPolicyPlugin()

export effect function nativeDownloadAllowed(options: { platform: "android" | "ios" | "web"; internetValidated: boolean; browserDataSaver?: boolean; plugin?: NetworkPolicyPlugin }) {
  const plugin = options.plugin ?? NetworkPolicy
  if (options.platform === "web") return mayDownload(webCost(hint(options.browserDataSaver ?? null)), options.internetValidated)
  if (options.platform === "android") {
    const report = nativeReply(NATIVE_COST, "getMeteredHint", NativeMetered, () => plugin.getMeteredHint()) catch () => undefined
    return mayDownload(androidCost(hint(report?.metered ?? null)), options.internetValidated)
  }
  const report = nativeReply(NATIVE_COST, "getPathHints", NativePath, () => plugin.getPathHints()) catch () => undefined
  return mayDownload(appleCost(hint(report?.isExpensive ?? null), hint(report?.isConstrained ?? null)), options.internetValidated)
}
