{
	"name": "@elizaos/core",
	"version": "2.0.3-beta.7",
	"description": "Core runtime, plugin abstractions, and AgentRuntime for elizaOS \u2014 actions, providers, evaluators, services, models, and types.",
	"homepage": "https://github.com/elizaOS/eliza",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elizaOS/eliza.git",
		"directory": "packages/core"
	},
	"keywords": [
		"elizaos",
		"agent",
		"runtime",
		"ai",
		"llm",
		"plugins"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": true,
	"exports": {
		".": {
			"eliza-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./catalog/channel-plugin-map.json": {
			"eliza-source": "./src/catalog/channel-plugin-map.json",
			"default": "./dist/catalog/channel-plugin-map.json"
		},
		"./catalog/curated-app-definitions.json": {
			"eliza-source": "./src/catalog/curated-app-definitions.json",
			"default": "./dist/catalog/curated-app-definitions.json"
		},
		"./catalog/generated.json": {
			"eliza-source": "./src/catalog/generated.json",
			"default": "./dist/catalog/generated.json"
		},
		"./catalog/provider-plugin-map.json": {
			"eliza-source": "./src/catalog/provider-plugin-map.json",
			"default": "./dist/catalog/provider-plugin-map.json"
		},
		"./catalog/short-id-plugin-map.json": {
			"eliza-source": "./src/catalog/short-id-plugin-map.json",
			"default": "./dist/catalog/short-id-plugin-map.json"
		},
		"./restart-exit-code.json": {
			"eliza-source": "./src/restart-exit-code.json",
			"default": "./dist/restart-exit-code.json"
		},
		"./protocol": {
			"eliza-source": "./src/protocol.ts",
			"types": "./dist/protocol.d.ts",
			"import": "./dist/protocol.js",
			"default": "./dist/protocol.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepublishOnly": "bun run build",
		"build": "bun run build.ts",
		"build:watch": "bun run build.ts --watch",
		"dev": "bun run build:watch",
		"clean": "node ../scripts/rm-path-recursive.ts dist .turbo .turbo-tsconfig.json *.tsbuildinfo && node scripts/clean-src-artifacts.ts",
		"perf:settings": "bun run scripts/perf-settings.ts",
		"test": "node ../scripts/run-vitest.ts run",
		"test:coverage": "mkdir -p coverage/.tmp && node ../scripts/run-vitest.ts run --coverage",
		"test:e2e": "npx playwright test",
		"test:watch": "node ../scripts/run-vitest.ts",
		"lint": "bunx @biomejs/biome check --write src test scripts build.ts vitest.config.ts",
		"lint:check": "bunx @biomejs/biome check src test scripts build.ts vitest.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tooling.json",
		"format": "bunx @biomejs/biome format --write ./src",
		"format:check": "bunx @biomejs/biome format ./src",
		"generate:first-party": "bun run src/catalog/generate.ts",
		"generate:first-party:check": "bun run src/catalog/generate.ts --check"
	},
	"author": "elizaOS",
	"license": "MIT",
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/bun": "1.4.2",
		"@types/node": "^25.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"typescript": "^6.0.3",
		"tsx": "^4.21.0",
		"vitest": "^5.0.3",
		"dotenv": "^17.2.3",
		"@types/markdown-it": "^14.1.2"
	},
	"dependencies": {
		"zod": "^4.6.5",
		"adze": "^2.2.5",
		"json5": "^2.2.3",
		"file-type": "^22.0.0",
		"markdown-it": "^14.1.0",
		"yaml": "^2.8.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"gitHead": "cb192f7b21c441e9463d1af2f890c145814baad2",
	"elizaos": {
		"scripts": {
			"coreBuild": true,
			"buildOnInstall": {},
			"testLanes": [
				"server"
			]
		}
	}
}
