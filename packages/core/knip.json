{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"playwright": false,
	"playwright-ct": false,
	"playwright-test": false,
	"entry": [
		"src/index.ts",
		"src/protocol.ts",
		"build.ts",
		"scripts/**/*.ts",
		"e2e/**/*.ts",
		"test/**/*.ts"
	],
	"project": ["src/**/*.ts", "!src/**/*.d.ts", "build.ts"],
	"ignore": ["scripts/fixtures/**"]
}
