  ]
  const BASELINE = `import fs from "node:fs"; import path from "node:path";
const read = (name) => JSON.parse(fs.readFileSync(path.resolve(JSON.parse(process.argv[1]), "../../spec/core/baseline", name), "utf8"));
const surface = read("core-public-surface.json"); const consumers = read("core-consumers.json");
console.log(JSON.stringify({
  entrypoints: surface.entrypoints.map(({ entry, conditions, exports }) => ({
    entry, conditions, exports: [
      ...exports.map(({ name, typeOnly }) => ({ name, typeOnly })),
      ...(entry === "." ? [{ name: "PrivacyMode", typeOnly: true }, { name: "privacyPlugin", typeOnly: false }] : []),
      ...(entry === "." || entry === "./protocol" ? [{ name: "modelAttemptCapture", typeOnly: false }] : []),
    ],
  })),
  files: surface.files.map(({ path, sha256 }) => ({ path, sha256 })),
  imports: consumers.imports.map(({ file, line, module, kind, names, text, v4RetiredNames = [] }) => ({ file, line, module, kind, names: names.filter(({ name }) => !v4RetiredNames.includes(name)).map(({ name, typeOnly }) => ({ name, typeOnly })), text })),
}));`
  const NAMES = `const entries = JSON.parse(process.argv[1]); const names = {};
for (const entry of entries) names[entry] = Object.keys(await import("@elizaos/core" + entry.slice(1), entry.endsWith(".json") ? { with: { type: "json" } } : undefined)).sort();
console.log(JSON.stringify(names));`
  // spec/core/taskEventReader.md, "Story: Observe complete task history without stale page replacement"; spec/core/taskEventReader.md, "A generation owns its pending read and every publish boundary rechecks it"
  const READER_RECOVERY = String.raw`import assert from "node:assert/strict";
import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";
import { TaskEventReader } from "@elizaos/core";
const directory = process.argv[1];
const event = (taskId, sequence) => ({ schemaVersion: 1, eventId: taskId + "#" + sequence, taskId, sequence, epoch: 0, at: sequence, kind: sequence === 0 ? "create" : "observe", status: "active" });
const page = (taskId, sequence) => ({ events: [event(taskId, sequence)], cursor: sequence, hasMore: false, task: { id: taskId, revision: sequence, epoch: 0, status: "completed", hasUnknownOutcome: false } });
const put = (taskId, sequence) => writeFile(path.join(directory, taskId + ".json"), JSON.stringify(page(taskId, sequence)));
const source = (calls) => async (taskId, after) => {
  calls.push([taskId, after]);
  return JSON.parse(await readFile(path.join(directory, taskId + ".json"), "utf8"));
};
async function rejectsOriginal(call, expected) {
  let rejected = false;
  try { await call(); } catch (error) { rejected = true; assert.strictEqual(error, expected); }
  assert.strictEqual(rejected, true);
}
for (const marker of [new Error("observer"), Object.freeze({ observer: true }), 0, undefined]) {
  await put("retry", 0);
  const calls = [], views = [];
  let armed = true;
  const reader = new TaskEventReader({
    read: source(calls),
    changed: (view) => {
      views.push(structuredClone(view));
      if (armed) { armed = false; throw marker; }
      if (view.page) view.page.events.length = 0;
    },
  });
  try {
    await rejectsOriginal(() => reader.start("retry"), marker);
    assert.deepEqual(calls, []);
    await reader.refresh();
    assert.deepEqual(calls, [["retry", -1]]);
    assert.deepEqual(views.at(-1), { page: page("retry", 0), pending: false, failed: false });
    armed = true;
    await rejectsOriginal(() => reader.refresh(), marker);
    assert.deepEqual(calls, [["retry", -1]]);
    await put("retry", 1);
    await reader.refresh();
    assert.deepEqual(calls, [["retry", -1], ["retry", 0]]);
    assert.deepEqual(views.at(-1), { page: { ...page("retry", 1), events: [event("retry", 0), event("retry", 1)] }, pending: false, failed: false });
  } finally { reader.stop(); }
}
await put("retry", 0);
{
  const marker = Object.freeze({ stopped: true }), calls = [];
  let first = true;
  const reader = new TaskEventReader({
    read: source(calls),
    changed: () => { if (first) { first = false; reader.stop(); throw marker; } },
  });
  try {
    await rejectsOriginal(() => reader.start("retry"), marker);
    await reader.refresh();
    assert.deepEqual(calls, []);
    await reader.start("retry");
    assert.deepEqual(calls, [["retry", -1]]);
  } finally { reader.stop(); }
}
await put("replacement", 0);
{
  const marker = Object.freeze({ replaced: true }), calls = [], views = [];
  let first = true, replacement;
  const reader = new TaskEventReader({
    read: source(calls),
    changed: (view) => {
      views.push(view);
      if (first) {
        first = false;
        replacement = reader.start("replacement").then(() => ({ ok: true }), (error) => ({ ok: false, error }));
        throw marker;
      }
    },
  });
  try {
    await rejectsOriginal(() => reader.start("retry"), marker);
    assert.deepEqual(await replacement, { ok: true });
    await reader.refresh();
    assert.deepEqual(calls, [["replacement", -1], ["replacement", 0]]);
    assert.deepEqual(views.at(-1), { page: page("replacement", 0), pending: false, failed: false });
  } finally { reader.stop(); }
}
for (const stage of ["page", "finish"]) {
  const marker = Object.freeze({ stage }), calls = [], views = [];
  let armed = true;
  const reader = new TaskEventReader({
    read: source(calls),
    changed: (view) => {
      views.push(view);
      if (armed && view.page && (stage === "page" ? view.pending : !view.pending)) { armed = false; throw marker; }
    },
  });
  try {
    if (stage === "finish") await rejectsOriginal(() => reader.start("retry"), marker);
    else { await reader.start("retry"); assert.equal(views.at(-1).failed, true); }
    await reader.refresh();
    assert.deepEqual(calls, [["retry", -1], ["retry", 0]]);
    assert.deepEqual(views.at(-1), { page: page("retry", 0), pending: false, failed: false });
  } finally { reader.stop(); }
}`
  const NATIVE_RECORDS = `import assert from "node:assert/strict";
import { asObjectRecord, asRecord, hasPlainObjectTag, isObjectRecord, isPlainObject, validateMeetingArtifact } from "@elizaos/core";
const prototypeFailure = new Error("native-record-prototype");
const tagFailure = new Error("native-record-tag");
const events = [];
const target = Object.defineProperty({}, Symbol.toStringTag, { get() { assert.strictEqual(this, observed); events.push("tag"); return "Object"; } });
const observed = new Proxy(target, { getPrototypeOf() { events.push("prototype"); throw prototypeFailure; } });
assert.throws(() => isPlainObject(observed), (error) => error === prototypeFailure);
assert.deepStrictEqual(events, ["prototype"]);
events.length = 0;
assert.strictEqual(isObjectRecord(observed), true);
assert.strictEqual(asObjectRecord(observed), observed);
assert.deepStrictEqual(events, []);
assert.strictEqual(hasPlainObjectTag(observed), true);
assert.deepStrictEqual(events, ["tag"]);
events.length = 0;
const nullPrototype = new Proxy({}, { getPrototypeOf() { events.push("prototype"); return null; } });
assert.strictEqual(isPlainObject(nullPrototype), true);
assert.strictEqual(isObjectRecord(nullPrototype), true);
assert.deepStrictEqual(events, ["prototype"]);
for (const prototype of [null, Object.prototype]) {
  const array = Object.setPrototypeOf([], prototype);
  Object.defineProperty(array, Symbol.toStringTag, { get() { throw tagFailure; } });
  assert.strictEqual(isPlainObject(array), true);
  assert.strictEqual(asRecord(array), array);
  assert.strictEqual(isObjectRecord(array), false);
  assert.strictEqual(hasPlainObjectTag(array), false);
}
const arrayProxy = new Proxy([], { getPrototypeOf() { throw prototypeFailure; }, get(target, key, receiver) { if (key === Symbol.toStringTag) throw tagFailure; return Reflect.get(target, key, receiver); } });
assert.throws(() => isPlainObject(arrayProxy), (error) => error === prototypeFailure);
assert.strictEqual(isObjectRecord(arrayProxy), false);
assert.strictEqual(hasPlainObjectTag(arrayProxy), false);
const callable = Object.defineProperty(function () {}, Symbol.toStringTag, { get() { throw tagFailure; } });
assert.strictEqual(hasPlainObjectTag(callable), false);
const tagged = Object.defineProperty({}, Symbol.toStringTag, { get() { throw tagFailure; } });
assert.throws(() => hasPlainObjectTag(tagged), (error) => error === tagFailure);
const nativeError = (operation) => { try { operation(); } catch (error) { return error; } assert.fail("native operation must throw"); };
const revoked = Proxy.revocable([], {});
revoked.revoke();
for (const [predicate, operation] of [[isPlainObject, () => Object.getPrototypeOf(revoked.proxy)], [isObjectRecord, () => Array.isArray(revoked.proxy)], [hasPlainObjectTag, () => Array.isArray(revoked.proxy)]]) {
  const expected = nativeError(operation);
  assert.throws(() => predicate(revoked.proxy), (error) => error.constructor === expected.constructor && error.message === expected.message);
}
const revokedCallable = Proxy.revocable(function () {}, {});
revokedCallable.revoke();
assert.strictEqual(isPlainObject(revokedCallable.proxy), false);
assert.strictEqual(isObjectRecord(revokedCallable.proxy), false);
assert.strictEqual(hasPlainObjectTag(revokedCallable.proxy), false);
const artifact = { "schemaVersion": "eliza.meeting_artifact.v1", "artifactId": "artifact-1", "meeting": { "id": "meeting-1", "captureMode": "local_capture", "platform": "local", "consent": { "state": "granted" }, "retentionPolicy": { "retainAudio": true, "retainTranscript": true, "scope": "owner-private" } }, "media": [{ "id": "media-1", "url": "/api/media/0123456789abcdef.wav", "mimeType": "audio/wav" }], "sourceStreams": [{ "id": "stream-1", "kind": "local_mic", "mediaRefId": "media-1", "platformParticipantId": "participant-1" }], "platformParticipants": [{ "id": "participant-1" }], "diarizedSpeakers": [{ "id": "speaker-1", "sourceStreamIds": ["stream-1"], "platformParticipantIds": ["participant-1"], "entityBindingId": "binding-1", "name": { "displayName": "Ada", "provenance": "self_introduction", "confidence": 0.9 } }], "entityBindings": [{ "id": "binding-1", "diarizedSpeakerId": "speaker-1", "entityId": "entity-1", "status": "active", "provenance": "self_introduction", "confidence": 0.9 }], "transcriptSpans": [{ "id": "span-1", "sourceStreamId": "stream-1", "speakerId": "speaker-1", "platformParticipantId": "participant-1", "startMs": 0, "endMs": 1000, "text": "hello", "words": [{ "text": "hello", "startMs": 0, "endMs": 1000 }] }], "notes": [{ "id": "note-1", "transcriptSpanIds": ["span-1"] }], "actionItems": [{ "id": "action-1", "transcriptSpanIds": ["span-1"] }], "decisions": [{ "id": "decision-1", "transcriptSpanIds": ["span-1"] }], "evidenceArtifacts": [{ "id": "evidence-1", "mediaRefId": "media-1", "transcriptSpanIds": ["span-1"] }] };
const validation = { valid: true, errors: [] };
let meetingPrototypeReads = 0;
assert.deepStrictEqual(validateMeetingArtifact(new Proxy(artifact, { getPrototypeOf(target) { meetingPrototypeReads += 1; return Reflect.getPrototypeOf(target); } })), validation);
assert.strictEqual(meetingPrototypeReads, 0);
assert.deepStrictEqual(validateMeetingArtifact(new Proxy(artifact, { getPrototypeOf() { throw prototypeFailure; } })), validation);
console.log("null");`
  const ASSETS = `import { createHash } from "node:crypto"; import fs from "node:fs"; import path from "node:path";
const [dir, catalogs, retired] = JSON.parse(process.argv[1]);
const restart = await import("@elizaos/core/restart-exit-code.json", { with: { type: "json" } }).then((json) => json.default, (error) => error.code);
const digests = {};
for (const [entry, target] of catalogs) { const file = path.join(dir, target); digests[entry] = fs.existsSync(file) ? createHash("sha256").update(fs.readFileSync(file)).digest("hex") : null; }
const retiredResults = {};
for (const entry of retired) retiredResults[entry] = await import("@elizaos/core" + entry.slice(1)).then(() => "imported", (error) => error.code);
const guard = typeof (await import("@elizaos/core")).createPreparedModelRequestGuard;
console.log(JSON.stringify({ restart, digests, retiredResults, guard }));`
  const CLOSURE = `import fs from "node:fs"; import { isBuiltin } from "node:module"; import path from "node:path"; import ts from "typescript";
const [dir, leaves] = JSON.parse(process.argv[1]); const closures = {};
for (const [entry, target] of leaves) {
  const seen = new Set(); const external = new Set(); const pending = [path.join(dir, target)];
  while (pending.length > 0) {
    const file = pending.pop(); if (seen.has(file)) continue; seen.add(file);
    for (const imported of ts.preProcessFile(fs.readFileSync(file, "utf8"), true, true).importedFiles) {
      if (imported.fileName.startsWith(".")) pending.push(path.resolve(path.dirname(file), imported.fileName));
      else external.add(isBuiltin(imported.fileName) && !imported.fileName.startsWith("node:") ? "node:" + imported.fileName : imported.fileName);
    }
  }
  closures[entry] = [...external].sort();
}
console.log(JSON.stringify(closures));`
  const PROCESSLESS = `import fs from "node:fs"; import os from "node:os"; import path from "node:path"; import { pathToFileURL } from "node:url";
const [corePkgDir, viteEntry, entries] = JSON.parse(process.argv[1]);
const { build } = await import(pathToFileURL(viteEntry).href);
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "core-browser-"));
const bundles = [];
try {
  for (const [entry, target] of entries) {
    const outDir = path.join(tmp, entry === "." ? "root" : entry.replace(/[^a-z0-9]/gi, "_"));
    await build({ logLevel: "silent", build: { outDir, minify: false, lib: { entry: path.join(corePkgDir, target), formats: ["es"], fileName: () => "bundle.mjs" } } });
    bundles.push([entry, path.join(outDir, "bundle.mjs")]);
  }
  const out = process.stdout;
  const failures = {};
  delete globalThis.process;
  for (const [entry, file] of bundles) failures[entry] = await import(pathToFileURL(file).href).then(() => null, (error) => String(error));
  out.write(JSON.stringify(failures) + "\\n");
} finally {
  fs.rmSync(tmp, { recursive: true, force: true });
}`
  const INSPECT = `import fs from "node:fs"; import path from "node:path"; import ts from "typescript";
const [dir, core, moved] = JSON.parse(process.argv[1]); const file = path.join(dir, "entries.ts");
const movedSet = new Set(moved);
const surface = JSON.parse(fs.readFileSync(path.resolve(core, "../../spec/core/baseline/core-public-surface.json"), "utf8"));
fs.writeFileSync(file, "import \\"@elizaos/core\\";\\nexport {};\\n");
const program = ts.createProgram([file], { module: ts.ModuleKind.NodeNext, moduleResolution: ts.ModuleResolutionKind.NodeNext, target: ts.ScriptTarget.ES2024, strict: true, noEmit: true, types: ["node"] });
const checker = program.getTypeChecker();
const statement = program.getSourceFile(file).statements.find(ts.isImportDeclaration);
const symbol = checker.getSymbolAtLocation(statement.moduleSpecifier);
const packed = symbol === undefined ? new Map() : new Map(checker.getExportsOfModule(symbol).map((item) => [item.name, item]));
const names = { ".": [...packed.keys()].sort() };
const keyOf = (name) => name !== undefined && (ts.isIdentifier(name) || ts.isStringLiteral(name) || ts.isNumericLiteral(name)) ? name.text : undefined;
const tagOf = (node, source) => node === undefined || !ts.isLiteralTypeNode(node) ? undefined : ts.isStringLiteral(node.literal) || ts.isNoSubstitutionTemplateLiteral(node.literal) ? JSON.stringify(node.literal.text) : node.literal.getText(source);
const differences = [];
const checked = new Set();
for (const { entry, exports } of surface.entrypoints) {
  for (const { name, declarations = [] } of exports) {
    if (movedSet.has(name) || checked.has(name)) continue;
    checked.add(name);
    const required = new Map();
    for (const { kind, signature } of declarations) {
      if (kind !== "InterfaceDeclaration" && kind !== "TypeAliasDeclaration") continue;
      const source = ts.createSourceFile("baseline.ts", signature, ts.ScriptTarget.Latest, true); const declaration = source.statements[0];
      const members = declaration !== undefined && ts.isInterfaceDeclaration(declaration) ? declaration.members : declaration !== undefined && ts.isTypeAliasDeclaration(declaration) && ts.isTypeLiteralNode(declaration.type) ? declaration.type.members : [];
      for (const member of members) {
        const key = keyOf(member.name);
        if ((ts.isPropertySignature(member) || ts.isMethodSignature(member)) && member.questionToken === undefined && key !== undefined) required.set(key, ts.isPropertySignature(member) ? tagOf(member.type, source) : undefined);
      }
    }
    if (required.size === 0) continue;
    const exported = packed.get(name); if (exported === undefined) { differences.push(entry + " " + name + ": not exported"); continue; }
    const type = checker.getDeclaredTypeOfSymbol(exported.flags & ts.SymbolFlags.Alias ? checker.getAliasedSymbol(exported) : exported);
    for (const [key, tag] of required) {
      const property = checker.getPropertyOfType(type, key);
      const actual = property === undefined ? undefined : checker.typeToString(checker.getTypeOfSymbol(property));
      if (property === undefined) differences.push(entry + " " + name + "." + key + ": missing");
      else if (property.flags & ts.SymbolFlags.Optional) differences.push(entry + " " + name + "." + key + ": optional");
      else if (tag !== undefined && actual !== tag) differences.push(entry + " " + name + "." + key + ": " + actual + " instead of " + tag);
    }
  }
}
console.log(JSON.stringify({ names, fields: differences }));`
  const WRITE = `import fs from "node:fs"; import path from "node:path";
const [dir, files] = JSON.parse(process.argv[1]);
for (const [name, text] of Object.entries(files)) fs.writeFileSync(path.join(dir, name), text);
console.log("null");`
  const COPIES = `import { pathToFileURL } from "node:url";
const [a, b] = JSON.parse(process.argv[1]); const load = (file) => import(pathToFileURL(file).href);
const A = await load(a.root); const B = await load(b.root);
const anthropic = { name: "anthropic" }; const coding = { name: "coding" }; const manager = { run: (_context, fn) => fn(), active: () => undefined };
const before = B.getTrajectoryContextManager();
A.setAnthropicAccountPoolBridge(anthropic); A.setCodingAgentSelectorBridge(coding);
const installed = [B.getAnthropicAccountPoolBridge() === anthropic, B.getCodingAgentSelectorBridge() === coding];
A.setAnthropicAccountPoolBridge(null);
A.setTrajectoryContextManager(manager);
const wire = { git: { repo: "fx/plugin", v0: {}, v1: {}, v2: {} }, npm: { repo: "@fx/plugin" }, supports: { v0: false, v1: false, v2: true }, kind: "plugin", extension: "retained" };
const wireRefused = (input) => { try { A.decodeRuntimeRegistry(input); return false; } catch { return true; } };
const { kind: _kind, ...unspecifiedKind } = wire;
const wireBoundary = [A.decodeRuntimeRegistry({ registry: { plugin: wire } }).get("plugin").kind, A.runtimeRegistryEntrySchema.parse(wire).extension,
  wireRefused({ registry: { app: { ...wire, kind: "app" } } }), wireRefused({ registry: { app: { ...wire, registryKind: "app" } } }),
  wireRefused({ registry: { app: { ...wire, app: { launchType: "internal-tab" } } } }), wireRefused({ registry: {}, apps: { app: wire } }),
  A.decodeRuntimeRegistry({ registry: { plugin: unspecifiedKind } }).get("plugin").kind === undefined];
console.log(JSON.stringify({
  errors: [new A.ElizaError("journey", { code: "JOURNEY" }) instanceof B.ElizaError],
  bridges: [...installed, B.getAnthropicAccountPoolBridge(), B.getCodingAgentSelectorBridge() === coding],
  ambient: [before !== manager, B.getTrajectoryContextManager() === manager],
  wireBoundary,
}));`
  const node = (cwd: string, script: string, input: unknown, conditions: string[] = []) => effect {
    const result = try host(() => runNode({ script, args: [JSON.stringify(input)], cwd, conditions, timeoutMs: 300_000 }))
    return try Effect.try({ try: () => JSON.parse(result.status === 0 ? result.stdout : ""), catch: () => result })
  }
  const differences = (label: string, actual: readonly string[], expected: readonly string[]) => [
    ...expected.filter((name) => !actual.includes(name)).map((name) => `${label}: missing ${name}`),
    ...actual.filter((name) => !expected.includes(name)).map((name) => `${label}: extra ${name}`),
  ]
  const sameKeys = (left: object, right: object) => differences("keys", Object.keys(left), Object.keys(right))

  const root = try scratch("eliza-core-release")
  const consumer = `${root}/consumer`
  const packed = try acquireRelease(host(() => packCandidate(coreDir)), (made) => orDie(host(() => made.remove())))
  const selection = { attemptId: packed.attemptId, revision: packed.revision }
  const { entrypoints: baseline, files: baselineFiles, imports: consumerImports } = (try node(coreDir, BASELINE, packed.sourceDir)) as {
    entrypoints: Array<{ entry: string; conditions: Record<string, string>; exports: Array<{ name: string; typeOnly: boolean }> }>
    files: Array<{ path: string; sha256: string }>
    imports: Array<{ file: string; line: number; module: string; kind: string; names: Array<{ name: string; typeOnly: boolean }>; text: string }>
  }
  const selected = { ...selection, artifactDigest: packed.sha256 }
  const examined = effect {
    return { attemptId: selected.attemptId, revision: selected.revision, artifactDigest: try host(() => sha256File(packed.tarball)) }
  }
  const record = (kind: string, check: string, detail: string[]) => effect {
    return { kind, check, candidate: try examined, ok: detail.length === 0, detail }
  }
  const installed = try host(() => installPacked(packed, consumer, true))
  const manifest = installed.manifest
  const expectedEntries = [
    ".",
    "./catalog/channel-plugin-map.json",
    "./catalog/generated.json",
    "./catalog/provider-plugin-map.json",
    "./catalog/short-id-plugin-map.json",
    "./restart-exit-code.json",
  ]
  const expectedRootRuntime = [...new Set(
    baseline.flatMap((entry) => entry.exports.filter((symbol) => !symbol.typeOnly && !movedToCoreNode.has(symbol.name)).map((symbol) => symbol.name)),
  )]
  const expectedRootDeclared = [...new Set(
    baseline.flatMap((entry) => entry.exports.filter((symbol) => !movedToCoreNode.has(symbol.name)).map((symbol) => symbol.name)),
  )]

  const exportMap = try record("PackedImports", "export map", [
    ...differences("exports", Object.keys(manifest.exports), expectedEntries),
    ...differences(". conditions", Object.keys(manifest.exports["."] ?? {}), ["eliza-source", "types", "import", "default"]),
    ...expectedEntries.filter((entry) => entry.endsWith(".json")).flatMap((entry) =>
      differences(`${entry} conditions`, Object.keys(manifest.exports[entry] ?? {}), ["eliza-source", "default"])),
  ])

  const runtimeNames = (try node(consumer, NAMES, ["."])) as Record<string, string[]>
  const names = try record("PackedImports", "runtime names",
    expectedRootRuntime.filter((name) => !runtimeNames["."].includes(name)).map((name) => `.: missing ${name}`))

  const sourceNames = (try node(consumer, NAMES, expectedEntries, ["eliza-source"])) as Record<string, string[]>
  const sourceImports = try record("PackedImports", "source-condition imports", [
    ...differences(".", sourceNames["."], runtimeNames["."]),
    ...expectedEntries.filter((entry) => entry.endsWith(".json")).flatMap((entry) =>
      differences(entry, sourceNames[entry], ["default"])),
  ])

  const nativeRecords = try host(() => runNode({ script: NATIVE_RECORDS, cwd: consumer, timeoutMs: 300_000 }))
  const nativeRecordChecks = try record("PackedImports", "native record observations", nativeRecords.status === 0 ? [] : [nativeRecords.stderr || nativeRecords.stdout || `node exit ${nativeRecords.status}`])

  const readerDirectory = try scratch("eliza-core-packed-reader-recovery")
  const readerRecovery = try host(() => runNode({ script: READER_RECOVERY, args: [readerDirectory], cwd: consumer, timeoutMs: 300_000 }))
  const readerRecoveryChecks = try record("RuntimeConformance", "task-event observer recovery", readerRecovery.status === 0 && readerRecovery.signal === null && readerRecovery.stdout === "" && readerRecovery.stderr === "" ? [] : [JSON.stringify(readerRecovery)])

  const catalogs = expectedEntries.filter((entry) => entry.startsWith("./catalog/")).map((entry) => [entry, manifest.exports[entry]?.default])
  const assets = (try node(consumer, ASSETS, [`${consumer}/node_modules/@elizaos/core`, catalogs, retiredCodeSubpaths])) as {
    restart: unknown
    digests: Record<string, string | null>
    retiredResults: Record<string, string>
    guard: string
  }
  const assetChecks = try record("PackedImports", "json assets and private subpath", [
    ...(JSON.stringify(assets.restart) === JSON.stringify({ restartExitCode: 75 }) ? [] : [`restart-exit-code.json: ${JSON.stringify(assets.restart)}`]),
    ...catalogs.map(([entry]) => [entry, assets.digests[entry], baselineFiles.find((file) => file.path === `packages/core/src${entry.slice(1)}`)?.sha256]).filter(([, actual, expected]) => actual !== expected).map(([entry, actual]) => `${entry}: sha256 ${actual}`),
    ...retiredCodeSubpaths.filter((entry) => assets.retiredResults[entry] !== "ERR_PACKAGE_PATH_NOT_EXPORTED").map((entry) => `${entry}: ${assets.retiredResults[entry]}`),
    ...(assets.guard === "function" ? [] : [`createPreparedModelRequestGuard: ${assets.guard}`]),
  ])

  const closures = (try node(consumer, CLOSURE, [`${consumer}/node_modules/@elizaos/core`, [[".", manifest.exports["."].import]]])) as Record<string, string[]>
  const processless = (try node(consumer, PROCESSLESS, [`${consumer}/node_modules/@elizaos/core`, `${coreDir}/node_modules/vite/dist/node/index.js`, [[".", manifest.exports["."].import]]])) as Record<string, string | null>
  const packageName = (specifier: string) => specifier.split("/").slice(0, specifier.startsWith("@") ? 2 : 1).join("/")
  const browserSafe = try record("PackedImports", "browser-safe root", [
    ...closures["."].filter((specifier) => specifier.startsWith("node:") || specifier.startsWith("@effect/platform-node")).map((specifier) => `.: imports ${specifier}`),
    ...(processless["."] === null ? [] : [`.: without process ${processless["."]}`]),
  ])
  const rootBoundary = try record("PackedImports", "root boundary", closures["."].filter((specifier) =>
    specifier.startsWith("@elizaos/") || specifier.startsWith("node:") || !(packageName(specifier) in (manifest.dependencies ?? {}))).map((specifier) => `.: imports ${specifier}`))

  const required = new Map<string, { name: string; typeOnly: boolean }>()
  const droppedConsumerNames = new Set(["@elizaos/core\u0000TrajectoryChatMessage"])
  const unlistedConsumerNames: string[] = []
  for (const site of consumerImports) {
    const imported = baseline.find((entry) => `@elizaos/core${entry.entry.slice(1)}` === site.module)
    if (imported === undefined) continue
    const named = site.kind === "LastTypeNode"
      ? [...site.text.matchAll(/import\("[^"]+"\)\.([A-Za-z_$][\w$]*)/g)].map((found) => ({ name: found[1], typeOnly: true }))
      : site.kind === "ImportDeclaration" || site.kind === "ExportDeclaration" ? site.names : []
    for (const { name, typeOnly } of named) {
      if (name === "*" || name === "default" || movedToCoreNode.has(name)) continue
      const key = `${site.module}\u0000${name}`
      if (!imported.exports.some((symbol) => symbol.name === name)) {
        if (!droppedConsumerNames.has(key)) unlistedConsumerNames.push(`${site.file}:${site.line} ${site.module} ${name}: consumer import not in baseline`)
        continue
      }
      required.set(name, { name, typeOnly: typeOnly && (required.get(name)?.typeOnly ?? true) })
    }
  }
  const importsTs = [...required.values()].map((symbol, index) => `import { ${symbol.typeOnly ? "type " : ""}${symbol.name} as required${index} } from "@elizaos/core";`).concat([
    `import { privacyPlugin, Service, type Action, type IAgentRuntime, type Plugin, type PrivacyMode, type Provider } from "@elizaos/core";`,
    `const privacy: PrivacyMode = { secretSwap: true, piiSwap: true };`,
    `export const protectedAgent: Plugin = privacyPlugin(privacy);`,
    `const action = { name: "JOURNEY", description: "journey", validate: async () => true, handler: async () => ({ success: true }) } satisfies Action;`,
    `const provider = { name: "JOURNEY", get: async () => ({ text: "" }) } satisfies Provider;`,
    `class JourneyService extends Service { static override serviceType = "journey"; capabilityDescription = "journey"; static override async start(runtime: IAgentRuntime): Promise<Service> { return new JourneyService(runtime); } async stop(): Promise<void> {} }`,
    `export const plugin = { name: "journey", description: "journey", actions: [action], providers: [provider], services: [JourneyService] } satisfies Plugin;`,
  ]).join("\n")
  const tsconfig = JSON.stringify({ compilerOptions: { module: "nodenext", moduleResolution: "nodenext", target: "es2024", strict: true, noEmit: true, types: ["node"] }, files: ["imports.ts"] })
  try node(consumer, WRITE, [consumer, { "imports.ts": importsTs, "tsconfig.json": tsconfig }])
  const compiled = try host(() => runNode({ file: `${consumer}/node_modules/typescript/bin/tsc`, args: ["--noEmit", "-p", consumer], cwd: consumer, timeoutMs: 300_000 }))
  const consumerTypes = try record("PackedTypes", "consumer compilation", [
    ...unlistedConsumerNames,
    ...compiled.stdout.split("\n").filter((line) => line.includes("error TS")),
    ...(compiled.status === 0 ? [] : [`tsc exit ${compiled.status}`]),
  ])
  const sourceCompiled = try host(() => runNode({ file: `${consumer}/node_modules/typescript/bin/tsc`, args: ["--noEmit", "-p", consumer, "--customConditions", "eliza-source"], cwd: consumer, timeoutMs: 300_000 }))
  const sourceTypes = try record("PackedTypes", "source-condition compilation", [
    ...sourceCompiled.stdout.split("\n").filter((line) => line.includes("error TS")),
    ...(sourceCompiled.status === 0 ? [] : [`tsc exit ${sourceCompiled.status}`]),
  ])
  const inspection = Schema.Struct({
    names: Schema.Record(Schema.String, Schema.NullOr(Schema.Array(Schema.String))),
    fields: Schema.Array(Schema.String),
  })
  const declared = try Schema.decodeUnknownEffect(inspection)(try node(consumer, INSPECT, [consumer, packed.sourceDir, [...movedToCoreNode]]))
  const declarations = try record("PackedTypes", "declaration names",
    expectedRootDeclared.filter((name) => !(declared.names["."] ?? []).includes(name)).map((name) => `.: missing ${name}`))
  const fields = try record("PackedTypes", "required fields and discriminants", [...declared.fields])

  const other = `${root}/other`
  const otherInstalled = try host(() => installPacked(packed, other))
  try Effect.try(() => assert.notStrictEqual(installed.packageDirectory, otherInstalled.packageDirectory))
  const files = (dir: string) => ({ root: `${dir}/node_modules/@elizaos/core/${manifest.exports["."].import}` })
  const shared = (try node(consumer, COPIES, [files(consumer), files(other)])) as Record<string, unknown>
  const expectedShared: Record<string, unknown> = {
    errors: [true],
    bridges: [true, true, null, true],
    ambient: [true, true],
    wireBoundary: ["plugin", "retained", true, true, true, true, true],
  }
  const copies = try record("PackedImports", "two copies", [
    ...sameKeys(shared, expectedShared),
    ...Object.keys(expectedShared).filter((key) => JSON.stringify(shared[key]) !== JSON.stringify(expectedShared[key])).map((key) => `${key}: ${JSON.stringify(shared[key])}`),
  ])

  const passed = (kind: string, check: string) => ({ kind, check, candidate: selected, ok: true, detail: [] as string[] })
  try Effect.try(() => assert.deepStrictEqual([exportMap, names, sourceImports, nativeRecordChecks, readerRecoveryChecks, assetChecks, browserSafe, rootBoundary, consumerTypes, sourceTypes, declarations, fields, copies], [
    passed("PackedImports", "export map"),
    passed("PackedImports", "runtime names"),
    passed("PackedImports", "source-condition imports"),
    passed("PackedImports", "native record observations"),
    passed("RuntimeConformance", "task-event observer recovery"),
    passed("PackedImports", "json assets and private subpath"),
    passed("PackedImports", "browser-safe root"),
    passed("PackedImports", "root boundary"),
    passed("PackedTypes", "consumer compilation"),
    passed("PackedTypes", "source-condition compilation"),
    passed("PackedTypes", "declaration names"),
    passed("PackedTypes", "required fields and discriminants"),
    passed("PackedImports", "two copies"),
  ]))
}, 600_000)

it.live('Two scrub items drained together keep both people\'s pseudonyms, and a failed one retries behind the queue (spec/core/corpusPseudonyms.md, "Story: Preserve one pseudonym per verified cluster across corpus writes"; spec/core/corpusPseudonyms.md, "Scrub items that assemble the pseudonym map do so one at a time, so every pseudonym they mint stays in the stored map")', () => scoped(effect {
  try withEnv({ SECRET_SALT: "map-stage-pseudonym-salt" })
  const people: Record<string, string> = { "Ada Lovelace": "ada", "Grace Hopper": "grace" }
  class People extends Service {
    static serviceType = "eliza_knowledge_graph"
    capabilityDescription = "The two people the scrub names"
    static async start(runtime: IAgentRuntime): Promise<Service> {
      return new People(runtime)
    }
    async stop(): Promise<void> {}
    getEntityStore() {
      return {
        resolve: async (query: { name?: string }) => query.name !== undefined && people[query.name] !== undefined
          ? [{ entity: { entityId: people[query.name], type: "person", preferredName: query.name, identities: [] }, confidence: 0.95, evidence: [] }]
          : [],
      }
    }
  }
  const services: Plugin = { name: "map-stage-host", description: "Host services of the map stage", services: [PiiScrubService, People] }
  const runtime = try kernel({ plugins: [services] })
  const ruleset = "map-stage-ruleset"
  const contents: Record<string, string> = { ada: "Please call Ada Lovelace tomorrow.", grace: "Please ask Grace Hopper today." }
  const open = new Map<string, { readonly surrogate: string; readonly settle: (succeed: boolean) => void }>()
  const surrogates: Record<string, string[]> = { ada: [], grace: [] }
  const completed = new Set<string>()
  const opened: string[] = []
  const personOf = (text: string) => Object.keys(contents).find((person) => contents[person] === text) ?? ""
  try Effect.orDie(Effect.try(() => runtime.registerModel(ModelType.PII_SCRUB, async (_runtime, params) => {
    const scrub = params as { text: string; candidateSpans: string[]; rulesetVersion: string; pseudonymAssignments?: Array<{ entityClusterId: string; surrogate: string }> }
    const person = personOf(scrub.text)
    const surrogate = scrub.pseudonymAssignments?.find((assignment) => assignment.entityClusterId === `entity:${person}`)?.surrogate ?? ""
    surrogates[person]?.push(surrogate)
    opened.push(person)
    const succeed = await new Promise<boolean>((settle) => {
      open.set(person, { surrogate, settle })
    })
    open.delete(person)
    if (!succeed) throw new Error("the scrub model refused this item")
    return { modelId: "map-stage-scrubber", rulesetVersion: scrub.rulesetVersion, verdicts: scrub.candidateSpans.map((span) => ({ span, kind: "pii", replacement: surrogate })) }
  }, "map-stage", 10)))
  try Effect.orDie(Effect.try(() => runtime.registerEvent(EventType.PII_SCRUB_COMPLETED, async (payload) => {
    completed.add(personOf((payload as { content: string }).content))
  })))
  const until = (what: string, check: () => boolean) => effect {
    for (let attempt = 0; attempt < 500; attempt++) {
      if (check()) return
      try sleep("10 millis")
    }
    try die(new Error(`map stage: ${what} did not happen within 5 s`))
  }
  const stored = () => host(async () => Object.fromEntries(((await new EncryptedCachePseudonymMapStore(runtime).load())?.clusters ?? []).map((cluster) => [cluster.clusterId, cluster.pseudonym])))
  for (const [person, name] of [["ada", "Ada Lovelace"], ["grace", "Grace Hopper"]]) {
    try host(() => runtime.emitEvent(EventType.PII_SCRUB_REQUESTED, { runtime, content: contents[person], rulesetVersion: ruleset, candidateSpans: [name], priority: "normal", source: "map-stage" }))
  }
  try until("both items to be queued", () => runtime.getService<PiiScrubService>("pii-scrub")?.getQueueSize() === 2)
  const [task] = try host(() => runtime.getTasksByName("PII_SCRUB_DRAIN"))
  const worker = runtime.getTaskWorker("PII_SCRUB_DRAIN")
  const drained = try sync(() => ({ settled: task !== undefined && worker !== undefined ? worker.execute(runtime, {}, task) : Promise.reject(new Error("map stage: the PII scrub drain is not registered")) }))

  try until("the first item to reach the model", () => open.size === 1)
  try sleep("150 millis")
  const first = [...open.keys()]
  const second = first[0] === "ada" ? "grace" : "ada"
  open.get(first[0] ?? "")?.settle(false)
  try until("the second item to reach the model", () => open.has(second))
  try sleep("500 millis")
  const whileSecondHolds = [...open.keys()]
  open.get(second)?.settle(true)
  try until("the second item to complete", () => completed.has(second))
  const afterSecond = try stored()
  try until("the failed item to retry", () => open.has(first[0] ?? ""))
  open.get(first[0] ?? "")?.settle(true)
  try until("the failed item to complete", () => completed.has(first[0] ?? ""))
  try host(async () => drained.settled)
  const final = try stored()
  try Effect.try(() => assert.deepStrictEqual({
    first: first.length,
    whileSecondHolds,
    opened,
    afterSecond: Object.keys(afterSecond),
    secondKept: afterSecond[`entity:${second}`] === surrogates[second][0],
    final: Object.keys(final).sort(),
    adaKept: final["entity:ada"] === surrogates.ada.at(-1) && surrogates.ada.at(-1) !== "",
    graceKept: final["entity:grace"] === surrogates.grace.at(-1) && surrogates.grace.at(-1) !== "",
    distinct: final["entity:ada"] !== final["entity:grace"],
  }, {
    first: 1,
    whileSecondHolds: [second],
    opened: [first[0], second, first[0]],
    afterSecond: [`entity:${second}`],
    secondKept: true,
    final: ["entity:ada", "entity:grace"],
    adaKept: true,
    graceKept: true,
    distinct: true,
  }))
}), 60_000)

// spec/core/actionPlanning.md, "A promoted subaction keeps its umbrella's summarize and model class unless it sets its own"
it.effect('Promoted subactions preserve summarize and modelClass with override precedence and pin their discriminator (spec/core/actionPlanning.md, "A promoted subaction keeps its umbrella\'s summarize and model class unless it sets its own")', () => effect {
  const seen: Record<string, unknown>[] = []
  const parentSummarize = (result: { text?: string } | undefined) => `parent:${result?.text ?? ""}`
  const listSummarize = (result: { text?: string } | undefined) => `list:${result?.text ?? ""}`
  const parent: Action = {
    name: "TASKS",
    description: "Manage tasks.",
    modelClass: "TEXT_LARGE",
    summarize: parentSummarize,
    parameters: [
      { name: "action", description: "Op.", required: false, schema: { type: "string", enum: ["create", "list"] } },
      { name: "task", description: "Task.", required: false, subactions: ["create"], requiredForSubactions: ["create"], schema: { type: "string" } },
      { name: "limit", description: "Limit.", required: false, subactions: ["list"], schema: { type: "integer" } },
    ],
    validate: async () => true,
    handler: async (_runtime, _message, _state, options) => {
      seen.push(((options as { parameters?: Record<string, unknown> } | undefined)?.parameters) ?? {})
      return { success: true, text: "ok" }
    },
  }
  const promoted = promoteSubactionsToActions(parent, {
    overrides: {
      list: { modelClass: "TEXT_SMALL", summarize: listSummarize },
    },
  })
  const createAction = promoted.find((action) => action.name === "TASKS_CREATE")
  const listAction = promoted.find((action) => action.name === "TASKS_LIST")
  assert.isDefined(createAction)
  assert.isDefined(listAction)
  const runtime = try Effect.try(() => new AgentRuntime({ character: createCharacter({ name: "Eliza", bio: [] }) }))
  const message = createMessageMemory({ id: createUniqueUuid(runtime, "promote-msg"), entityId: createUniqueUuid(runtime, "promote-user"), roomId: createUniqueUuid(runtime, "promote-room"), content: { text: "list tasks" } })
  const listResult = try Effect.promise(() => listAction!.handler(runtime, message, undefined, { parameters: { limit: 5 } }))
  const contradiction = try Effect.promise(() => listAction!.handler(runtime, message, undefined, { parameters: { action: "create" } }))
  assert.deepStrictEqual({
    createModelClass: createAction!.modelClass,
    listModelClass: listAction!.modelClass,
    createSummary: createAction!.summarize?.({ success: true, text: "x" }, {}),
    listSummary: listAction!.summarize?.({ success: true, text: "x" }, {}),
    createParams: createAction!.parameters?.map((param) => [param.name, param.required, param.schema.enum]),
    listParams: listAction!.parameters?.map((param) => [param.name, param.required, param.schema.enum]),
    listOk: listResult.success,
    contradictionOk: contradiction.success,
    seen,
  }, {
    createModelClass: "TEXT_LARGE",
    listModelClass: "TEXT_SMALL",
    createSummary: "parent:x",
    listSummary: "list:x",
    createParams: [["action", false, ["create"]], ["task", true, undefined]],
    listParams: [["action", false, ["list"]], ["limit", false, undefined]],
    listOk: true,
    contradictionOk: false,
    seen: [{ limit: 5, action: "list", subaction: "list" }],
  })
})

// spec/core/actionPlanning.md, "An object parameter with no declared properties accepts any keys, and one with declared properties accepts no others unless it says so"
it.effect('Open-ended object schemas allow arbitrary keys while closed objects with declared properties reject unknown keys (spec/core/actionPlanning.md, "An object parameter with no declared properties accepts any keys, and one with declared properties accepts no others unless it says so")', () => effect {
  const action: Action = {
    name: "WORKFLOW_TEST",
    description: "Test schema.",
    parameters: [
      { name: "input", description: "Open payload.", required: false, schema: { type: "object" } },
      { name: "closed", description: "Explicitly closed empty object.", required: false, schema: { type: "object", additionalProperties: false } },
      { name: "config", description: "Typed object.", required: false, schema: { type: "object", properties: { mode: { type: "string" } } } },
    ],
    validate: async () => true,
    handler: async () => ({ success: true }),
  }
  const schema = actionToJsonSchemaOrThrow(action)
  const openValid = validateToolArgsOrThrow(action, { input: { env: "prod", retries: 2 }, config: { mode: "fast" } })
  const closedInvalid = validateToolArgsOrThrow(action, { closed: { extra: true } })
  const typedExtraInvalid = validateToolArgsOrThrow(action, { config: { mode: "fast", unknownKey: 1 } })
  assert.deepStrictEqual({
    inputAdditional: schema.properties.input?.additionalProperties,
    closedAdditional: schema.properties.closed?.additionalProperties,
    configAdditional: schema.properties.config?.additionalProperties,
    openValid: openValid.valid,
    closedValid: closedInvalid.valid,
    typedExtraValid: typedExtraInvalid.valid,
  }, {
    inputAdditional: true,
    closedAdditional: false,
    configAdditional: false,
    openValid: true,
    closedValid: false,
    typedExtraValid: false,
  })
})
