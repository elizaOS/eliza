// spec/core/asyncContext.md, "Story: Keep concurrent turn context isolated"; spec/core/asyncContext.md, "Scope restoration and peer isolation are exact for every context value"; spec/core/asyncContext.md, "A scope on a host with no asynchronous storage is refused before its callback runs"
it.live('A host with no asynchronous context storage refuses a scope rather than drop it at the first await, and Node keeps each scope without any registration (spec/core/asyncContext.md, "A scope on a host with no asynchronous storage is refused before its callback runs"; spec/core/asyncContext.md, "Story: Keep concurrent turn context isolated")', () => effect {
  let entered = false
  const refusing = asyncContextStorageFactoryFor({})<string>()
  const refused = try Effect.flip(Effect.try({ try: () => refusing.run("turn-one", () => { entered = true }), catch: (error) => error }))
  const node = asyncContextStorageFactoryFor(nodeGlobal())<string>()
  const observed = try Effect.promise(() => Promise.all([
    node.run("turn-one", async () => { await Effect.runPromise(Effect.sleep("10 millis")); return node.getStore() }),
    node.run("turn-two", async () => { await Effect.runPromise(Effect.sleep("2 millis")); return node.getStore() }),
    runWithTrajectoryContext({ runId: "run-one" }, async () => { await Effect.runPromise(Effect.sleep("5 millis")); return getTrajectoryContext()?.runId }),
  ]))
  assert.deepStrictEqual([refused instanceof AsyncContextUnavailableError, entered, refusing.getStore(), observed, node.getStore()], [true, false, undefined, ["turn-one", "turn-two", "run-one"], undefined])
})

// spec/core/settingsKeys.md, "Story: Keep persisted settings decryptable under the selected key"; spec/core/settingsKeys.md, "Recognized ciphertext fails explicitly when authentication or decryption fails"; spec/core/protocols.md, "Story: Share canonical values across hosts and plugins"
it.live('Envelopes and a pseudonym map that node:crypto wrote still open, ids and digests keep their published values, truncated GCM tags and wrong key or IV lengths are refused, and a host with no cipher refuses (spec/core/settingsKeys.md, "Recognized ciphertext fails explicitly when authentication or decryption fails"; spec/core/settingsKeys.md, "Story: Keep persisted settings decryptable under the selected key"; spec/core/protocols.md, "Story: Share canonical values across hosts and plugins")', () => effect {
  const fromHex = (text: string) => Uint8Array.from(text.match(/../g) ?? [], (pair) => Number.parseInt(pair, 16))
  const toHex = (bytes: Uint8Array) => Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("")
  const salt = "fixture-private-salt-5b2e"
  const v2Envelope = "v2:00112233445566778899aabb:14e068184b1883184cab8b491aa2cd7ee92bb5c7:45c50104db1337129d17ef696fcddaf6"
  const v1Envelope = "0f0e0d0c0b0a09080706050403020100:051e28df09c03f5d1e6b17602ec3bd5988eec6405ec0d9d6e8e4ddf2f0222e25"
  const mapBlob = "v2:a1a2a3a4a5a6a7a8a9aaabac:ae7d2a4af8314fc193b681c546f33096849724e414b8d5a4c1df0b42a253faafe8b49666f5cddcb82f27cfe32bf6f9ab7a088f6f9d32:3478cc31b6516ba713e237809415d217"
  const stored = new Map<string, unknown>([["pii:pseudonym-map:v1", mapBlob]])
  const cache = {
    getCache: async <T,>(key: string) => stored.get(key) as T | undefined,
    setCache: async <T,>(key: string, value: T) => { stored.set(key, value); return true },
    deleteCache: async (key: string) => stored.delete(key),
  }
  const native = nodeSecretCipher(nodeCryptoModule())
  assert.isDefined(native)
  const nistKey = fromHex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")
  const nistIv = fromHex("cafebabefacedbaddecaf888")
  const nistAad = fromHex("feedfacedeadbeeffeedfacedeadbeefabaddad2")
  const nistPlaintext = fromHex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
  const nist = native!.encryptAes256Gcm(nistKey, nistIv, nistPlaintext, nistAad)
  const store = try Effect.orDie(Effect.try(() => new EncryptedCachePseudonymMapStore(cache, { encryptionSalt: salt })))
  const opened = {
    v2: decryptStringValue(v2Envelope, salt),
    v1: decryptStringValue(v1Envelope, salt),
    map: try Effect.promise(() => store.load()),
  }
  const rejected = (run: () => unknown) => effect {
    const error = try Effect.flip(Effect.try({ try: run, catch: (cause) => cause }))
    return error instanceof RangeError ? error.message : String(error)
  }
  const truncatedStored = new Map<string, unknown>([["pii:pseudonym-map:v1", `${mapBlob.slice(0, mapBlob.lastIndexOf(":"))}:3478cc31`]])
  const truncatedStore = try Effect.orDie(Effect.try(() => new EncryptedCachePseudonymMapStore({
    getCache: async <T,>(key: string) => truncatedStored.get(key) as T | undefined,
    setCache: async <T,>(key: string, value: T) => { truncatedStored.set(key, value); return true },
    deleteCache: async (key: string) => truncatedStored.delete(key),
  }, { encryptionSalt: salt })))
  const truncatedMap = try Effect.flip(Effect.tryPromise({ try: () => truncatedStore.load(), catch: (error) => error }))
  const refusedLengths = {
    tags: [
      try rejected(() => native!.decryptAes256Gcm(nistKey, nistIv, nist.ciphertext, nist.tag.slice(0, 4), nistAad)),
      try rejected(() => native!.decryptAes256Gcm(nistKey, nistIv, nist.ciphertext, nist.tag.slice(0, 12), nistAad)),
      try rejected(() => native!.decryptAes256Gcm(nistKey, nistIv, nist.ciphertext, nist.tag.slice(0, 15), nistAad)),
    ],
    map: truncatedMap instanceof Error && truncatedMap.message.includes("Invalid AES-GCM tag length: 4 bytes. Expected 16 bytes."),
    key: try rejected(() => native!.encryptAes256Gcm(nistKey.slice(0, 16), nistIv, nistPlaintext, nistAad)),
    gcmIv: try rejected(() => native!.encryptAes256Gcm(nistKey, nistIv.slice(0, 8), nistPlaintext, nistAad)),
    cbcIv: try rejected(() => native!.decryptAes256Cbc(nistKey, nistIv, nistPlaintext.slice(0, 16))),
  }
  const refused = try ensuring(effect {
    try sync(() => registerSecretCipher(undefined))
    const read = try Effect.flip(Effect.try({ try: () => decryptStringValue(v2Envelope, salt), catch: (error) => error }))
    const map = try Effect.flip(Effect.tryPromise({ try: () => store.load(), catch: (error) => error }))
    return {
      read: read instanceof ElizaError ? [read.code, read.cause instanceof SecretCipherUnavailableError] : [String(read)],
      map: [map instanceof Error, (map instanceof Error ? map.message : String(map)).includes("No AES cipher is installed")],
    }
  }, sync(() => registerSecretCipher(native)))
  assert.deepStrictEqual({
    opened,
    reopened: decryptStringValue(v2Envelope, salt),
    nist: [toHex(nist.ciphertext), toHex(nist.tag), toHex(native!.decryptAes256Gcm(nistKey, nistIv, nist.ciphertext, nist.tag, nistAad))],
    uuids: [stringToUuid("hello world"), stringToUuid("j01-agent"), stringToUuid("caf\u00e9 \u{1F600}"), stringToUuid(42)],
    digests: [toHex(sha1Digest("abc")), toHex(sha1Digest("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")), sha256HexDigest(""), sha256HexDigest("abc"), sha256HexDigest("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")],
    refusedLengths,
    refused,
  }, {
    opened: { v2: "sk-fixture-v2-\u00e9\u{1F511}", v1: "legacy-cbc-fixture-value", map: { version: 1, salt: "fixture-mint-salt", clusters: [] } },
    reopened: "sk-fixture-v2-\u00e9\u{1F511}",
    nist: [
      "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662",
      "76fc6ece0f4e1768cddf8853bb2d551b",
      toHex(nistPlaintext),
    ],
    uuids: ["f0355dd5-2823-054c-ae66-a0b12842c215", "6a03da5d-19e0-0868-8d96-8ad7fb1e0a1e", "f6b56b10-bbae-00fb-9279-09317f98afde", "92cfceb3-9d57-0914-ad8b-14d0e37643de"],
    digests: [
      "a9993e364706816aba3e25717850c26c9cd0d89d",
      "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
      "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
      "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
    ],
    refusedLengths: {
      tags: [
        "Invalid AES-GCM tag length: 4 bytes. Expected 16 bytes.",
        "Invalid AES-GCM tag length: 12 bytes. Expected 16 bytes.",
        "Invalid AES-GCM tag length: 15 bytes. Expected 16 bytes.",
      ],
      map: true,
      key: "Invalid AES-256 key length: 16 bytes. Expected 32 bytes.",
      gcmIv: "Invalid AES-GCM IV length: 8 bytes. Expected 12 bytes.",
      cbcIv: "Invalid AES-CBC IV length: 12 bytes. Expected 16 bytes.",
    },
    refused: { read: ["SETTING_DECRYPTION_FAILED", true], map: [true, true] },
  })
})

effect function storeAt(prefix: string) {
  const directory = try scratch(prefix)
  return try host(async () => new SqliteStore(`${directory}/core.sqlite`))
}

effect function changingMethod(target: object, member: string, next: unknown, armed: () => boolean = () => true) {
  const observed = { reads: 0, totalReads: 0, cachedCalls: 0 }
  const cached = async () => { observed.cachedCalls += 1 }
  try Effect.try(() => Object.defineProperty(target, member, {
    configurable: true,
    get: () => {
      observed.totalReads += 1
      if (!armed()) return cached
      observed.reads += 1
      return observed.reads === 1 ? cached : next
    },
  }))
  return observed
}

const keyless = ({ id: _id, accountKey: _accountKey, createdAt: _createdAt, updatedAt: _updatedAt, ...rest }: ConnectorAccount) => rest

const startInChild = [
  "const [path, agentId] = process.argv.slice(1)",
  "const { AgentRuntime, createCharacter, getConnectorAccountManager } = await import(\"./src/index.vibe\")",
  "const { SqliteAdapter, SqliteStore } = await import(\"./test/support/sqlite-adapter.ts\")",
  "const { scriptedOAuthProvider } = await import(\"./test/support/oauth.ts\")",
  "const runtime = new AgentRuntime({ character: createCharacter({ name: \"Eliza\" }), agentId })",
  "runtime.registerDatabaseAdapter(new SqliteAdapter(new SqliteStore(path), \"c\"))",
  "await runtime.initialize({ skipMigrations: true })",
  "const google = scriptedOAuthProvider({ name: \" Google \" })",
  "const manager = getConnectorAccountManager(runtime)",
  "manager.registerProvider(google.provider)",
  "const flow = await manager.startOAuth(\"google\", { accountId: \"user-4\" })",
  "console.log(JSON.stringify({ id: flow.id, callback: google.consent(flow.authUrl ?? \"\", \"user-4\") }))",
  "await runtime.stop()",
  "await runtime.close()",
].join("\n")

// spec/core/runtime.md, "Story: Initialize an explicit host composition"; spec/core/runtime.md, "Initialization releases waiters on success and failure"; spec/core/runtime.md, "Only open ingress admits new turns"; spec/core/runtime.md, "Story: Retire every owned operation"; spec/core/runtime.md, "Stop closes admissions and prepares services once"; spec/core/runtime.md, "Strict retirement succeeds only when original work is drained"; spec/core/runtimeShutdown.md, "Story: Join one active shutdown attempt"; spec/core/runtimeShutdown.md, "Stop ownership is published before service preparation"; spec/core/runtimeShutdown.md, "Story: Establish strict quiescence after bounded shutdown"; spec/core/runtimeShutdown.md, "All strict callers share the original strict result"; spec/core/adapterOwnership.md, "Registration captures object references and rollback preserves close ordering"; spec/core/adapterOwnership.md, "Story: Preserve adapter identity through plugin failure and migrations"; spec/core/settings.md, "Story: Resolve the same setting in every host"; spec/core/settings.md, "Resolution preserves precedence and valid false zero and empty values"; spec/core/settings.md, "Setting and clearing align live secret and constructor slots"; spec/core/connectionLocks.md, "Story: Reconcile overlapping records without lost in-process updates"; spec/core/entities.md, "Story: Observe committed mutations through fresh runtime reads"; spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/diagnostics.md, "A structured failure retains its identity and an unclassified one gets a code"; spec/core/index.md, "Story: Compose a kernel through explicit services"; spec/core/settings.md, "Story: Isolate settings between agents and keys"; spec/core/memoConcurrency.md, "Story: Read after a completed mutation without receiving an older snapshot"; spec/core/serviceStopObservation.md, "Story: Continue best-effort shutdown with its failures retained"; spec/core/retirementTracker.md, "Story: Drain every owned retirement operation and report retained failures"
it.live("Host a runtime from construction to close and restart (spec/core/runtime.md, \"Story: Initialize an explicit host composition\"; spec/core/runtime.md, \"Story: Retire every owned operation\")", () => effect {
  const agentId = try Effect.try(() => stringToUuid("j01-agent"))
  const userId = try Effect.try(() => stringToUuid("j01-user"))
  const roomId = try Effect.try(() => stringToUuid("j01-room"))
  const worldId = try Effect.try(() => stringToUuid("j01-world"))
  const memoryId = try Effect.try(() => stringToUuid("j01-memory"))
  const boom = new Error("boom")
  const stopFailure = new Error("failing service could not stop")
  const stops: string[] = []
  const prepared: string[] = []
  const described = (failure: unknown) => isElizaError(failure) ? { code: failure.code, context: failure.context } : failure

  class FailingService extends Service {
    static serviceType = "j01-failing"
    capabilityDescription = "rejects its stop"
    static async start(runtime: AgentRuntime) {
      return new FailingService(runtime)
    }
    prepareStop(reason: string) {
      prepared.push(`failing:${reason}`)
    }
    async stop() {
      stops.push("failing")
      throw stopFailure
    }
  }
  class CountingService extends Service {
    static serviceType = "j01-counting"
    capabilityDescription = "counts its stops"
    static async start(runtime: AgentRuntime) {
      return new CountingService(runtime)
    }
    prepareStop(reason: string) {
      prepared.push(`counting:${reason}`)
    }
    async stop() {
      stops.push("counting")
    }
  }

  const store = try storeAt("j01-store")
  const a = try host(async () => new SqliteAdapter(store, "a"))
  const character = {
    name: "Eliza",
    bio: ["A host lifecycle journey."],
    secrets: { API_TOKEN: "secret-token", SHADOWED: "from-secret" },
    settings: {
      SHADOWED: "from-settings",
      FLAG_OFF: false,
      ZERO: 0,
      EMPTY: "",
      BOOL_TEXT: "true",
      P_DIRECT_EXTRA: "direct",
      secrets: { NESTED_TOKEN: "nested" },
      extra: { EXTRA_ONLY: "extra", P_DIRECT_EXTRA: "extra" },
    },
    env: { ENV_DIRECT: "direct", P_ENV_CTOR: "env", vars: { ENV_DIRECT: "vars", ENV_VAR_ONLY: "var", P_VARS_CTOR: "var" } },
  }
  const runtime = try Effect.try(() => new AgentRuntime({
    agentId,
    character,
    settings: { CTOR_ONLY: "ctor", FLAG_OFF: "true", ZERO: "5", EMPTY: "fallback", P_ENV_CTOR: "ctor", P_VARS_CTOR: "ctor" },
  }))
  // spec/core/adapterOwnership.md, "Registration captures object references and rollback preserves close ordering"
  runtime.registerDatabaseAdapter(a)
  const registered = runtime.adapter === a

  // spec/core/runtime.md, "Initialization releases waiters on success and failure"
  const waiterStates: string[] = []
  const agentReads = { phase: 0, counts: [0, 0] }
  const readAgents = a.getAgentsByIds.bind(a)
  try Effect.try(() => { a.getAgentsByIds = (ids) => { agentReads.counts[agentReads.phase] += 1; return readAgents(ids) } })
  for concurrent (const caller of ["host", "host", "waiter", "waiter"]) {
    try host(() => caller === "host" ? runtime.initialize({ skipMigrations: true }) : runtime.initPromise.then(() => { waiterStates.push(runtime.getLifecycleState()) }))
  }
  agentReads.phase = 1
  try host(() => runtime.initialize({ skipMigrations: true }))
  try Effect.try(() => Reflect.deleteProperty(a, "getAgentsByIds"))
  try Effect.try(() => assert.strictEqual(agentReads.counts[0], agentReads.counts[1]))
  const stored = {
    agents: (try host(() => a.getAgentsByIds([agentId]))).map((agent) => agent.name),
    entities: (try host(() => a.getEntitiesByIds([agentId]))).map((entity) => entity.names),
    lifecycle: runtime.getLifecycleState(),
    waiterStates,
  }

  // spec/core/settings.md, "Resolution preserves precedence and valid false zero and empty values"; spec/core/settings.md, "Setting and clearing align live secret and constructor slots"; spec/core/settings.md, "Story: Isolate settings between agents and keys"
  const keys = ["API_TOKEN", "SHADOWED", "FLAG_OFF", "ZERO", "EMPTY", "BOOL_TEXT", "NESTED_TOKEN", "EXTRA_ONLY", "ENV_DIRECT", "ENV_VAR_ONLY", "CTOR_ONLY", "J01_PROCESS_ONLY", "FRESH_KEY", "P_DIRECT_EXTRA", "P_ENV_CTOR", "P_VARS_CTOR"]
  const read = effect (target: AgentRuntime) => {
    const values: Record<string, string | boolean | number | null> = {}
    for (const key of keys) values[key] = try Effect.try(() => target.getSetting(key))
    return values
  }
  try withEnv({ J01_PROCESS_ONLY: "process" })
  const other = try kernel({ agentId: try Effect.try(() => stringToUuid("j01-other-agent")), character: { name: "Echo", secrets: { API_TOKEN: "other-token" } } })
  const resolved = try read(runtime)
  try Effect.try(() => runtime.registerDatabaseAdapter(other.adapter))
  const keptFirst = runtime.adapter === a
  runtime.setSetting("API_TOKEN", "rotated")
  const rotated = [try Effect.try(() => runtime.getSetting("API_TOKEN")), try Effect.try(() => other.getSetting("API_TOKEN"))]
  runtime.setSetting("API_TOKEN", null)
  runtime.setSetting("SHADOWED", null)
  runtime.setSetting("CTOR_ONLY", null)
  runtime.setSetting("FRESH_KEY", "fresh", true)
  const cleared = {
    runtime: try read(runtime),
    other: try read(other),
    linkedSecrets: runtime.character.secrets === runtime.character.settings?.secrets,
    settingsSlot: [runtime.settings.API_TOKEN, runtime.settings.CTOR_ONLY, runtime.settings.FRESH_KEY],
  }

  // spec/core/connectionLocks.md, "Story: Reconcile overlapping records without lost in-process updates"
  for concurrent (const index of Array.from({ length: 20 }, (_, position) => position)) {
    try host(() => runtime.ensureConnection({
      entityId: userId,
      roomId,
      worldId,
      roomName: "general",
      worldName: "Guild",
      name: "Ada",
      userName: index % 2 === 0 ? "ada#1" : "ada_tg",
      userId: index % 2 === 0 ? "discord-ada" : "telegram-ada",
      source: index % 2 === 0 ? "discord" : "telegram",
      serverId: "guild-1",
      messageServerId: worldId,
      channelId: "channel-1",
    }))
  }
  const user = try host(() => runtime.getEntityById(userId))
  const room = try host(() => runtime.getRoom(roomId))
  const connected = {
    worlds: (try host(() => runtime.getAllWorlds())).filter((world) => world.id === worldId).map((world) => world.name),
    room: room && { name: room.name, serverId: room.serverId, messageServerId: room.messageServerId, worldId: room.worldId, channelId: room.channelId },
    names: [...(user?.names ?? [])].sort(),
    sources: user?.metadata && { discord: user.metadata.discord, telegram: user.metadata.telegram },
    participants: [...(try host(() => runtime.getParticipantsForRoom(roomId)))].sort(),
  }

  // spec/core/entities.md, "Story: Observe committed mutations through fresh runtime reads"; spec/core/memoConcurrency.md, "Story: Read after a completed mutation without receiving an older snapshot"
  try host(() => runtime.createMemory({ id: memoryId, entityId: userId, agentId, roomId, content: { text: "hello from Ada", source: "discord" }, createdAt: Date.now() }, "messages"))
  const gate = Promise.withResolvers<void>()
  try Effect.try(() => a.fault("getEntitiesByIds", { gate: gate.promise }))
  const earlier = try Effect.sync(() => runtime.getEntityById(agentId))
  try sleep("50 millis")
  const renamed = try host(() => runtime.updateAgent(agentId, { name: "Nova" }))
  const later = try timeout(host(() => runtime.getEntityById(agentId)), "5 seconds")
  const earlierWhileGated = try Effect.race(host(() => earlier.then(() => "settled")), Effect.as(sleep("10 millis"), "pending"))
  gate.resolve()
  const fresh = {
    memory: (try host(() => runtime.getMemoryById(memoryId)))?.content.text,
    renamed,
    later: later?.names,
    earlierWhileGated,
    earlier: (try host(() => earlier))?.names,
  }

  // spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/diagnostics.md, "A structured failure retains its identity and an unclassified one gets a code"
  const noModel = try Effect.flip(host(() => runtime.useModel(ModelType.TEXT_SMALL, { prompt: "hello" })))
  const modelFailure = [noModel instanceof NoModelProviderConfiguredError, noModel instanceof ElizaError, isElizaError(noModel), described(noModel)]

  // spec/core/runtimeShutdown.md, "Stop ownership is published before service preparation"; spec/core/runtimeShutdown.md, "All strict callers share the original strict result"; spec/core/runtime.md, "Only open ingress admits new turns"; spec/core/serviceStopObservation.md, "Story: Continue best-effort shutdown with its failures retained"; spec/core/retirementTracker.md, "Story: Drain every owned retirement operation and report retained failures"
  try host(() => runtime.registerService(FailingService))
  try host(() => runtime.registerService(CountingService))
  const started = [
    (try host(() => runtime.getServiceLoadPromise(FailingService.serviceType))) instanceof FailingService,
    (try host(() => runtime.getServiceLoadPromise(CountingService.serviceType))) instanceof CountingService,
  ]
  const admittedBeforeStop = try host(() => runtime.roomHandlerQueue.runWith(roomId, async () => "admitted"))
  const joined: string[][] = []
  for concurrent (const index of [0, 1]) {
    try host(() => runtime.stop())
    joined[index] = [...stops].sort()
  }
  const strict: unknown[] = []
  for concurrent (const index of [0, 1]) {
    strict[index] = try Effect.flip(host(() => runtime.stop({ requireQuiescence: true })))
  }
  const [first, second] = strict
  const retained = first instanceof Error && first.cause instanceof AggregateError ? first.cause.errors : []
  const turnAfterStop = try Effect.flip(host(() => runtime.roomHandlerQueue.runWith(roomId, async () => "admitted")))
  const shutdown = {
    started,
    admittedBeforeStop,
    joined,
    sameStrictOutcome: first === second,
    strict: [first instanceof ElizaError, described(first)],
    retained: retained.map((failure) => [described(failure), failure instanceof Error && failure.cause === stopFailure]),
    turnAfterStop: [turnAfterStop instanceof RoomHandlerQueueClosedError, described(turnAfterStop)],
    lifecycle: runtime.getLifecycleState(),
    stopsAfterStrict: [...stops].sort(),
    prepared: [...prepared].sort(),
  }

  try host(() => runtime.close())
  const closedOnce = [...store.closeLog]
  const restarted = try Effect.scoped(effect {
    const next = try kernel({ store, agentId, label: "b", character: { name: "Nova" } })
    return {
      memory: (try host(() => next.getMemoryById(memoryId)))?.content.text,
      agent: (try host(() => next.getEntityById(agentId)))?.names,
    }
  })
  const restart = { closedOnce, restarted, closeLog: [...store.closeLog] }

  // spec/core/runtime.md, "Initialization releases waiters on success and failure"
  const failingStore = try storeAt("j01-failing-store")
  const failingAdapter = try host(async () => new SqliteAdapter(failingStore, "failing"))
  const failing = try Effect.try(() => new AgentRuntime({ character: { name: "Eliza", bio: ["A runtime whose adapter cannot start."] } }))
  failing.registerDatabaseAdapter(failingAdapter)
  try Effect.try(() => failingAdapter.fault("initialize", { reject: boom }, 2))
  const initFailures: unknown[] = []
  for concurrent (const index of [0, 1]) {
    initFailures[index] = try Effect.flip(host(() => failing.initialize({ skipMigrations: true })))
  }
  const failedWaiter = try host(() => failing.initPromise.then(() => failing.getLifecycleState()))
  const failedLifecycle = failing.getLifecycleState()
  try host(() => failing.stop())
  try host(() => failing.close())
  const failure = { rejectedWithBoom: initFailures.map((rejection) => rejection === boom), failedWaiter, failedLifecycle, closeLog: [...failingStore.closeLog] }

  try Effect.try(() => assert.deepStrictEqual(
    { registered, keptFirst, stored, resolved, rotated, cleared, connected, fresh, modelFailure, shutdown, restart, failure },
    {
      registered: true,
      keptFirst: true,
      stored: { agents: ["Eliza"], entities: [["Eliza"]], lifecycle: "running", waiterStates: ["running", "running"] },
      resolved: {
        API_TOKEN: "secret-token",
        SHADOWED: "from-secret",
        FLAG_OFF: false,
        ZERO: 0,
        EMPTY: "",
        BOOL_TEXT: true,
        NESTED_TOKEN: "nested",
        EXTRA_ONLY: "extra",
        ENV_DIRECT: "direct",
        ENV_VAR_ONLY: "var",
        CTOR_ONLY: "ctor",
        J01_PROCESS_ONLY: null,
        FRESH_KEY: null,
        P_DIRECT_EXTRA: "direct",
        P_ENV_CTOR: "env",
        P_VARS_CTOR: "var",
      },
      rotated: ["rotated", "other-token"],
      cleared: {
        runtime: {
          API_TOKEN: null,
          SHADOWED: "from-settings",
          FLAG_OFF: false,
          ZERO: 0,
          EMPTY: "",
          BOOL_TEXT: true,
          NESTED_TOKEN: "nested",
          EXTRA_ONLY: "extra",
          ENV_DIRECT: "direct",
          ENV_VAR_ONLY: "var",
          CTOR_ONLY: null,
          J01_PROCESS_ONLY: null,
          FRESH_KEY: "fresh",
          P_DIRECT_EXTRA: "direct",
          P_ENV_CTOR: "env",
          P_VARS_CTOR: "var",
        },
        other: {
          API_TOKEN: "other-token",
          SHADOWED: null,
          FLAG_OFF: null,
          ZERO: null,
          EMPTY: null,
          BOOL_TEXT: null,
          NESTED_TOKEN: null,
          EXTRA_ONLY: null,
          ENV_DIRECT: null,
          ENV_VAR_ONLY: null,
          CTOR_ONLY: null,
          J01_PROCESS_ONLY: null,
          FRESH_KEY: null,
          P_DIRECT_EXTRA: null,
          P_ENV_CTOR: null,
          P_VARS_CTOR: null,
        },
        linkedSecrets: true,
        settingsSlot: [undefined, undefined, "fresh"],
      },
      connected: {
        worlds: ["Guild"],
        room: { name: "general", serverId: "guild-1", messageServerId: worldId, worldId, channelId: "channel-1" },
        names: ["Ada", "ada#1", "ada_tg"],
        sources: { discord: { id: "discord-ada", name: "Ada", userName: "ada#1" }, telegram: { id: "telegram-ada", name: "Ada", userName: "ada_tg" } },
        participants: [agentId, userId].sort(),
      },
      fresh: { memory: "hello from Ada", renamed: true, later: ["Nova", "Eliza"], earlierWhileGated: "pending", earlier: ["Nova", "Eliza"] },
      modelFailure: [true, true, true, { code: "NO_MODEL_PROVIDER_CONFIGURED", context: { reason: "no-provider" } }],
      shutdown: {
        started: [true, true],
        admittedBeforeStop: "admitted",
        joined: [["counting", "failing"], ["counting", "failing"]],
        sameStrictOutcome: true,
        strict: [true, { code: "RUNTIME_QUIESCENCE_FAILED", context: { failureCount: 1 } }],
        retained: [[{ code: "RUNTIME_RETIREMENT_FAILED", context: { scope: "stop:j01-failing" } }, true]],
        turnAfterStop: [true, { code: "ROOM_HANDLER_QUEUE_CLOSED", context: { reason: "runtime-stop" } }],
        lifecycle: "stopped",
        stopsAfterStrict: ["counting", "failing"],
        prepared: ["counting:runtime-stop", "failing:runtime-stop"],
      },
      restart: { closedOnce: ["a"], restarted: { memory: "hello from Ada", agent: ["Nova", "Eliza"] }, closeLog: ["a", "b"] },
      failure: { rejectedWithBoom: [true, true], failedWaiter: "failed", failedLifecycle: "failed", closeLog: ["failing"] },
    },
  ))
}, 60_000)

// spec/core/journey.md, "Story: Complete or cancel a turn and retire its runtime"; spec/core/journey.md, "A turn composes the existing machines without a second state store"; spec/core/journey.md, "Action evidence and transport acknowledgement remain distinct"; spec/core/journey.md, "Retirement waits for the admitted turn and its pending reply"; spec/core/providers/work.md, "Story: Share provider work without sharing cancellation"; spec/core/execution.md, "Story: Settle an action before publishing its callback"; spec/core/execution.md, "Callbacks wait for a valid admitted result"; spec/core/execution.md, "Every callback from a finished source reaches delivery settlement"; spec/core/receipts.md, "Story: Confirm only a committed requested effect"; spec/core/receipts.md, "Delivery rechecks the exact text and receipt IDs after hooks have run"; spec/core/authorization.md, "Role gates combine exclusions, minimum rank and all required memberships"; spec/core/messaging.md, "Story: Dispatch through a selected connector account"; spec/core/messaging.md, "Send routing and hook routing have distinct fallback rules"; spec/core/postDelivery.md, "Story: Capture and settle a connector delivery boundary"; spec/core/terminal.md, "Story: Finalize one run after all admitted child work"; spec/core/events.md, "Story: Emit ordered events with their run session"; spec/core/concurrency.md, "Story: Own each room through durable settlement"; spec/core/turnControllers.md, "Story: Cancel room work without cancelling the cancel request"; spec/core/asyncContext.md, "Story: Keep concurrent turn context isolated"; spec/core/confirmation.md, "Story: Settle an explicit confirmation from the user's reply"; spec/core/responseEvaluation.md, "Story: Apply response evaluator decisions in priority order"; spec/core/diagnostics.md, "Story: Observe a failure without failing the reporting path"; spec/core/providers/index.md, "Story: Share exactly equivalent provider requests"; spec/core/actionReceipts.md, "Story: Drain action callbacks with exact receipt evidence"; spec/core/receiptBindings.md, "Story: Preserve authentic binding identity across concurrent replies"; spec/core/postDelivery.md, "Story: Track detached work under runtime and room ownership"; spec/core/context.md, "Story: Select relevant history while retaining complete evidence"
it.live("Answer a message: compose, plan, act, deliver, cancel (spec/core/journey.md, \"Story: Complete or cancel a turn and retire its runtime\"; spec/core/multiRoomLeases.md, \"Story: Own a room set through the callback and every admitted write\")", () => effect {
  const log: string[] = []
  const gate = () => Effect.try(() => Promise.withResolvers<void>())
  const providerStarted = try gate()
  const providerRelease = try gate()
  const hangingProvider = try gate()
  const afterReturn = try gate()
  const waitEntered = try gate()
  const waitRelease = try gate()
  const holdEntered = try gate()
  const holdRelease = try gate()
  const sendHold = { entered: try gate(), settled: try gate(), release: try Effect.try(() => Promise.resolve()), failNext: false }
  const sendRelease = try gate()
  const roomWorkRelease = try gate()
  const never = try gate()
  const counts = { notes: 0, echoStarts: 0, lookups: 0, validations: 0, hookEffects: 0 }
  const handlerStates: string[] = []
  const late: Promise<unknown>[] = []
  const sent: Array<{ via: string; accountId?: string; text?: string; receiptIds?: unknown }> = []
  const completed: Array<{ action: unknown; status: unknown; error: unknown }> = []
  const runEnded: Array<{ runId: unknown; status: unknown; receipts: string[] }> = []
  const user = stringToUuid("j02-user")
  const world = stringToUuid("j02-world")
  const dm = stringToUuid("j02-dm")
  const group = stringToUuid("j02-group")
  const groupWorld = stringToUuid("j02-group-world")
  const other = stringToUuid("j02-other")
  const at = new Date().toISOString()

  // spec/core/grammar.md, "Portable escaping preserves literal members and range structure"
  const slugGrammar = try Effect.try(() => buildPlannerActionGrammarStrict([{ name: "TAG_FILE", parameters: [{ name: "slug", description: "File slug", required: true, schema: { type: "string", pattern: "^[\\w-]+$" } }] }])?.grammar ?? "")
  try Effect.try(() => assert.ok(slugGrammar.includes("[A-Za-z0-9_\\x2d]"), slugGrammar))

  const recordNote: Action = {
    name: "RECORD_NOTE",
    description: "Stores a note for the user",
    tags: ["capability:write", "effect:receipt-required"],
    parameters: [{ name: "note", description: "The note text", required: true, schema: { type: "string" } }],
    validate: async () => true,
    handler: async (runtime, message, _state, options, callback) => {
      const note = String((options?.parameters as { note?: unknown } | undefined)?.note ?? "")
      const id = await runtime.createMemory({ entityId: message.entityId, agentId: runtime.agentId, roomId: message.roomId, content: { text: note, source: "chat" } }, "notes")
      const receiptId = `receipt-${note}`
      const text = `Saved: ${note}`
      await callback?.({ text, actions: ["RECORD_NOTE"] })
      await callback?.({ text, actions: ["RECORD_NOTE"] })
      return {
        success: true,
        text,
        verifiedUserFacing: true,
        userFacingText: text,
        userFacingEffectReceiptIds: [receiptId],
        effectReceipts: [{ receiptId, operation: "notes.create", resource: { kind: "note", id }, artifacts: [], idempotency: { key: null, replayed: false }, observedAt: at, outcome: "applied", commit: { kind: "durable", id, committedAt: at } }],
      }
    },
  }
  const lookup: Action = {
    name: "LOOKUP",
    description: "Answers from stored notes",
    validate: async () => true,
    handler: async (_runtime, _message, state, _options, callback) => {
      counts.lookups += 1
      handlerStates.push(state?.text ?? "")
      await callback?.({ text: "first", actions: ["LOOKUP"] })
      late.push(afterReturn.promise.then(() => callback?.({ text: "second", actions: ["LOOKUP"] })))
      log.push("handler:returning")
      return { success: true, text: "looked up" }
    },
  }
  const wait: Action = {
    name: "WAIT",
    description: "Waits for an outside answer",
    validate: async () => true,
    handler: async () => {
      log.push("wait:enter")
      waitEntered.resolve()
      await waitRelease.promise
      log.push("wait:exit")
      return { success: true }
    },
  }
  const boom = new Error("disk full")
  const broken: Action = {
    name: "BROKEN",
    description: "Fails while writing",
    validate: async () => true,
    handler: async (_runtime, _message, _state, _options, callback) => {
      await callback?.({ text: "half written" })
      throw boom
    },
  }
  const adminHook: Action = {
    name: "ADMIN_HOOK",
    description: "Runs only for administrators",
    mode: "ALWAYS_AFTER",
    roleGate: { minRole: "ADMIN" },
    validate: async (runtime) => {
      counts.validations += 1
      const current = await runtime.getWorld(groupWorld)
      if (current) await runtime.updateWorld({ ...current, metadata: { ...current.metadata, roles: { [user]: "GUEST" } } })
      return true
    },
    handler: async () => {
      counts.hookEffects += 1
      return { success: true }
    },
  }
  const failingHook: Action = {
    name: "FAILING_HOOK",
    description: "Reports a refusal",
    mode: "ALWAYS_AFTER",
    roleGate: { minRole: "GUEST" },
    validate: async () => true,
    handler: async () => ({ success: false, error: "denied" }),
  }
  class EchoService extends Service {
    static serviceType = "j02-echo"
    capabilityDescription = "Echoes text"
    static async start(runtime: IAgentRuntime): Promise<Service> {
      counts.echoStarts += 1
      return new EchoService(runtime)
    }
    async stop(): Promise<void> {}
  }
  const tagOf = (params: unknown) => {
    const prompt = String((params as { prompt?: string }).prompt ?? "")
    return [...prompt.matchAll(/#([A-Z_]+)/g)].at(-1)?.[1] ?? "LOOKUP"
  }
  const primary = try Effect.try(() => scriptedModels("primary", 10, { [ModelType.TEXT_LARGE]: [{ reply: tagOf }], [ModelType.TEXT_SMALL]: [{ until: never.promise }] }))
  const fallback = try Effect.try(() => scriptedModels("fallback", 0, { [ModelType.TEXT_LARGE]: [{ reply: "LOOKUP" }], [ModelType.TEXT_SMALL]: [{ reply: "fallback answer" }] }))
  const plugin: Plugin = {
    name: "j02-notes",
    description: "Notes plugin of journey 02",
    actions: [recordNote, lookup, wait, broken, adminHook, failingHook],
    providers: [
      {
        name: "NOTES_CONTEXT",
        get: async (_runtime, message) => {
          counts.notes += 1
          if (counts.notes === 1) {
            providerStarted.resolve()
            await providerRelease.promise
          }
          return { text: `notes for ${message.content.text}` }
        },
      },
      {
        name: "HISTORY",
        get: async (runtime, message) => {
          const stored = await runtime.getMemories({ roomId: message.roomId, tableName: "messages" })
          return { text: [...stored].sort((a, b) => (a.createdAt ?? 0) - (b.createdAt ?? 0)).map((memory) => memory.content.text).join("\n") }
        },
      },
      {
        name: "BROKEN_CONTEXT",
        get: async () => {
          throw new Error("notes store unavailable")
        },
      },
      {
        name: "HANGING_CONTEXT",
        get: async () => {
          await hangingProvider.promise
          return { text: "too late" }
        },
      },
    ],
    services: [EchoService, AgentEventService],
    events: {
      [EventType.RUN_STARTED]: [async (payload) => bridgeRunStartedToStreams(payload)],
      [EventType.RUN_ENDED]: [async (payload) => {
        runEnded.push({ runId: payload.runId, status: payload.status, receipts: (payload.outcome?.effects ?? []).map((receipt) => receipt.receiptId) })
        log.push("run:ended")
        bridgeRunEndedToStreams(payload)
      }],
      [EventType.ACTION_STARTED]: [async (payload) => bridgeActionStartedToStreams(payload)],
      [EventType.ACTION_COMPLETED]: [async (payload) => {
        completed.push({ action: payload.content?.actions?.[0], status: payload.content?.actionStatus, error: payload.content?.error })
        bridgeActionCompletedToStreams(payload)
      }],
    },
  }

  const runtime = try kernel({ plugins: [plugin, primary.plugin, fallback.plugin], settings: { OUTBOUND_VOICE_REWRITE: "false" } })
  const reported = (code: string) => runtime.getRecentReportedErrors().filter((entry) => entry.code === code || entry.scope === code).length
  const say = (id: string, roomId: UUID, text: string): Memory =>
    createMessageMemory({ id: stringToUuid(id), entityId: user, agentId: runtime.agentId, roomId, content: { text, source: "chat", channelType: ChannelType.DM } })
  const store = (message: Memory) => runtime.createMemory(message, "messages")
  try Effect.try(() => runtime.registerMessageConnector({
    source: "chat",
    sendHandler: async (_runtime, target, content) => {
      sent.push({ via: "default", accountId: target.accountId, text: content.text, receiptIds: content.effectReceiptIds })
    },
    editHandler: async () => {
      log.push("edit:default")
    },
  }))
  try Effect.try(() => runtime.registerMessageConnector({
    source: "chat",
    accountId: "acct-primary",
    sendHandler: async (_runtime, target, content) => {
      sendHold.entered.resolve()
      await sendHold.release
      if (sendHold.failNext) {
        sendHold.failNext = false
        throw new Error("socket closed")
      }
      sent.push({ via: "account", accountId: target.accountId, text: content.text, receiptIds: content.effectReceiptIds })
      log.push("send:settled")
      sendHold.settled.resolve()
    },
  }))
  const deliver = (roomId: UUID, rewrite?: "text" | "receipts"): HandlerCallback => async (response: Content) => {
    const hooked = rewrite === "text" ? { ...response, text: `${response.text ?? ""} (edited)` } : rewrite === "receipts" ? { ...response, effectReceiptIds: ["receipt-forged"] } : response
    log.push(`deliver:${response.text ?? ""}`)
    if (Array.isArray(hooked.effectReceiptIds) && !effectDeliveryBindingIsValid(hooked)) {
      log.push(`refused:${hooked.text ?? ""}`)
      return []
    }
    await runtime.sendMessageToTarget({ source: "chat", roomId, accountId: "acct-primary" }, hooked)
    return []
  }
  const turn = (label: string, message: Memory, options: { rewrite?: "text" | "receipts"; roomWork?: Promise<void>; child?: { requested: PromiseWithResolvers<void>; release: Promise<void> } } = {}) =>
    runtime.roomHandlerQueue.withLease(message.roomId, (lease) => runtime.turnControllers.runWith(message.roomId, async (signal) => {
      log.push(`${label}:start`)
      const runId = runtime.startRun(message.roomId)
      await runtime.emitEvent(EventType.RUN_STARTED, { runtime, runId, messageId: message.id, roomId: message.roomId, entityId: user, startTime: Date.now(), status: "started", source: "chat" })
      const owner = new RunTerminalOwner(runtime, runId, message, Date.now(), lease)
      const state = await runtime.composeState(message, ["NOTES_CONTEXT", "HISTORY"], true, true)
      const planned = await runtime.useModel(ModelType.TEXT_LARGE, { prompt: `${state.text}\n${message.content.text}`, signal })
      const result = await withRoomDeliverySettlement(runtime, message.roomId, lease, async () => {
        if (options.roomWork) void owner.trackAfterDelivery("index-reply", () => options.roomWork as Promise<void>)
        return executePlannedToolCall(runtime, { message, state, activeContexts: ["general"], callback: deliver(message.roomId, options.rewrite) }, { name: String(planned).trim(), params: String(planned).trim() === "RECORD_NOTE" ? { note: label } : {} })
      })
      owner.recordActionResult(result)
      void owner.track("summarize", async () => {
        await options.child?.release
        log.push("child:settled")
      })
      options.child?.requested.resolve()
      await owner.request({ status: result.success ? "completed" : "cancelled", reason: "journey", effects: [] })
      log.push(`${label}:end`)
      return { runId, state, result }
    }))

  const m1 = say("j02-m1", dm, "please remember to buy milk #RECORD_NOTE")
  try host(() => runtime.ensureConnection({ entityId: user, roomId: dm, worldId: world, userName: "ada", name: "Ada", source: "chat", type: ChannelType.DM, channelId: "dm-1" }))
  const dmWorld = try host(() => runtime.getWorld(world))
  if (dmWorld) try host(() => runtime.updateWorld({ ...dmWorld, metadata: { ...dmWorld.metadata, roles: { [user]: "MEMBER" } } }))
  const earlier = ["earlier one ".repeat(800), "earlier two ".repeat(800)]
  try host(() => store(say("j02-e1", dm, earlier[0] ?? "")))
  try host(() => store(say("j02-e2", dm, earlier[1] ?? "")))
  try host(() => store(m1))

  // spec/core/providers/work.md, "Story: Share provider work without sharing cancellation"; spec/core/providers/index.md, "Story: Share exactly equivalent provider requests"
  const firstCompose = try Effect.try(() => runtime.composeState(m1, ["NOTES_CONTEXT"], true))
  try host(() => providerStarted.promise)
  const secondCompose = try Effect.try(() => runtime.composeState(m1, ["NOTES_CONTEXT"], true))
  const refreshCompose = try Effect.try(() => runtime.composeState(m1, ["NOTES_CONTEXT"], true, false, ["NOTES_CONTEXT"]))
  const refreshed = try Effect.race(host(() => refreshCompose.then((state) => state.text)), Effect.as(sleep("2 seconds"), "still shared"))
  const whileHeld = counts.notes
  providerRelease.resolve()
  const shared = try host(() => Promise.all([firstCompose, secondCompose]))
  const brokenMessage = say("j02-broken", dm, "what do I have?")
  const brokenCompose = try host(() => runtime.composeState(brokenMessage, ["BROKEN_CONTEXT"], true).then(() => "resolved", (error: unknown) => error instanceof ElizaError ? error.code : String(error)))
  // spec/core/providers/waiter.md, "Story: Release a caller with its own outcome"
  const unbudgeted = runtime.character.settings
  runtime.character.settings = { ...unbudgeted, providersTotalTimeoutMs: 100 }
  const hungCompose = try host(() => runtime.composeState(say("j02-hung", dm, "anything new?"), ["HANGING_CONTEXT"], true).then(() => "resolved", (error: unknown) => error instanceof ElizaError ? error.code : String(error)))
  runtime.character.settings = unbudgeted
  hangingProvider.resolve()
  try Effect.try(() => assert.strictEqual(hungCompose, "PROVIDER_COMPOSITION_ABORTED"))
  const thirdCompose = try host(() => runtime.composeState(say("j02-m1b", dm, "another message"), ["NOTES_CONTEXT"], true))
  const composed = [shared.map((state) => state.text), refreshed, whileHeld, counts.notes, brokenCompose, reported("PROVIDER_COMPOSITION_FAILED"), runtime.stateCache.has(brokenMessage.id ?? ""), thirdCompose.text]

  const echo = [runtime.getService("j02-echo"), runtime.getService("j02-echo"), try host(() => runtime.getServiceLoadPromise("j02-echo"))]
  const services = [counts.echoStarts, echo[0] === echo[1] && echo[1] === echo[2], echo[0] instanceof EchoService]

  try Effect.try(() => assert.deepStrictEqual([composed, services], [
    [["notes for please remember to buy milk #RECORD_NOTE", "notes for please remember to buy milk #RECORD_NOTE"], "notes for please remember to buy milk #RECORD_NOTE", 2, 3, "PROVIDER_COMPOSITION_FAILED", 1, false, "notes for another message"],
    [1, true, true],
  ]))

  // spec/core/execution.md, "Callbacks wait for a valid admitted result"; spec/core/execution.md, "Every callback from a finished source reaches delivery settlement"; spec/core/context.md, "Story: Select relevant history while retaining complete evidence"
  const lookupMessage = say("j02-m2", dm, "what is on my list? #LOOKUP")
  try host(() => store(lookupMessage))
  const lookupTurn = try host(() => turn("lookup", lookupMessage))
  afterReturn.resolve()
  try host(() => Promise.all(late))
  const plannerCall = primary.seen.filter((call) => call.modelType === ModelType.TEXT_LARGE).at(-1)
  const plannerPrompt = String((plannerCall?.params as { prompt?: string } | undefined)?.prompt ?? "")
  const acted = [
    counts.lookups,
    handlerStates[0] === lookupTurn.state.text,
    log.filter((entry) => entry.startsWith("deliver:") || entry === "handler:returning"),
    sent.map((entry) => entry.text),
    [plannerPrompt.includes(lookupMessage.content.text ?? "-"), earlier.every((text) => plannerPrompt.includes(text))],
  ]
  const storedHistory = try host(() => runtime.getMemories({ roomId: dm, tableName: "messages" }))
  const roomHistory = ["j02-e1", "j02-e2", "j02-m1"].flatMap((id) => storedHistory.filter((memory) => memory.id === stringToUuid(id)))
  const historyContext = (completionContext?: Record<string, unknown>): ContextObject => ({
    id: "j02-planner-context",
    metadata: { roomId: dm, messageId: lookupMessage.id, ...(completionContext ? { completionContext: completionContext as never } : {}) },
    events: [
      { id: "current-request", type: "segment", source: "message-service", segment: { id: "current-request", label: "current_request", content: lookupMessage.content.text ?? "", stable: false } },
      ...roomHistory.map((memory) => ({ id: String(memory.id), type: "segment" as const, source: "prior-dialogue", segment: { id: String(memory.id), label: "prior_message:user", content: memory.content.text ?? "", stable: false } })),
    ],
  })
  const selector = (sourceSetId: string) => ({ mode: "relevant_prior_dialogue", sourceSetId, complete: true, relevantSourceIds: ["h1"], constraintSourceIds: [], referentSourceIds: [], pendingIntentSourceIds: [] })
  const segmentTexts = (context: ContextObject) => context.events.map((event) => String((event as { segment?: { content?: unknown } }).segment?.content ?? ""))
  const stale = try Effect.try(() => selectCompletionContext(historyContext(selector("0".repeat(64)))))
  const valid = try Effect.try(() => selectCompletionContext(historyContext(selector(completionContextSources(historyContext()).sourceSetId))))
  const selected = [
    roomHistory.map((memory) => memory.content.text),
    [stale.applied, segmentTexts(stale.context)],
    [valid.applied, valid.omittedSourceCount, segmentTexts(valid.context)],
  ]
  try Effect.try(() => assert.deepStrictEqual([acted, selected], [
    [1, true, ["handler:returning", "deliver:first", "deliver:second"], ["first", "second"], [true, true]],
    [
      [earlier[0], earlier[1], m1.content.text],
      [false, [lookupMessage.content.text, earlier[0], earlier[1], m1.content.text]],
      [true, 2, [lookupMessage.content.text, earlier[0]]],
    ],
  ]))

  // spec/core/receipts.md, "Story: Confirm only a committed requested effect"; spec/core/receipts.md, "Delivery rechecks the exact text and receipt IDs after hooks have run"; spec/core/receiptBindings.md, "Story: Preserve authentic binding identity across concurrent replies"; spec/core/actionReceipts.md, "Story: Drain action callbacks with exact receipt evidence"
  sent.length = 0
  log.length = 0
  const noteTurn = try host(() => turn("milk", m1))
  const delivered: Content[] = []
  const capture: HandlerCallback = async (response: Content) => {
    delivered.push(response)
    return []
  }
  const pair = try host(() => Promise.all(["eggs", "bread"].map((note) => executePlannedToolCall(runtime, { message: m1, activeContexts: ["general"], callback: capture }, { name: "RECORD_NOTE", params: { note } }))))
  const rewritten = try host(() => turn("tea", say("j02-m3", dm, "remember tea #RECORD_NOTE"), { rewrite: "text" }))
  const forged = try host(() => turn("jam", say("j02-m3b", dm, "remember jam #RECORD_NOTE"), { rewrite: "receipts" }))
  const receipts = [
    sent.map((entry) => [entry.via, entry.text, entry.receiptIds]),
    noteTurn.result.userFacingEffectReceiptIds,
    delivered.map((content) => [content.text, content.effectReceiptIds, effectDeliveryBindingProvesApplication(content)]),
    pair.map((result) => result.userFacingEffectReceiptIds),
    [rewritten.result.success, forged.result.success],
    log.filter((entry) => entry.startsWith("refused:")),
  ]
  try Effect.try(() => assert.deepStrictEqual(receipts, [
    [["account", "Saved: milk", ["receipt-milk"]]],
    ["receipt-milk"],
    [["Saved: eggs", ["receipt-eggs"], true], ["Saved: bread", ["receipt-bread"], true]],
    [["receipt-eggs"], ["receipt-bread"]],
    [true, true],
    ["refused:Saved: tea (edited)", "refused:Saved: jam"],
  ]))

  // spec/core/authorization.md, "Role gates combine exclusions, minimum rank and all required memberships"
  try host(() => runtime.ensureConnection({ entityId: user, roomId: group, worldId: groupWorld, userName: "ada", name: "Ada", source: "chat", type: ChannelType.GROUP, channelId: "group-1" }))
  const groupWorldRow = try host(() => runtime.getWorld(groupWorld))
  if (groupWorldRow) try host(() => runtime.updateWorld({ ...groupWorldRow, metadata: { ...groupWorldRow.metadata, roles: { [user]: "ADMIN" } } }))
  completed.length = 0
  try host(() => runtime.runActionsByMode("ALWAYS_AFTER", say("j02-g1", group, "run the hooks"), { values: {}, data: {}, text: "" }))
  try Effect.try(() => assert.deepStrictEqual(
    [counts.validations, counts.hookEffects, completed.map((entry) => [entry.action, entry.status, entry.error])],
    [1, 0, [["ADMIN_HOOK", "failed", "Action ADMIN_HOOK is not allowed for the current role"], ["FAILING_HOOK", "failed", "denied"]]],
  ))

  // spec/core/messaging.md, "Story: Dispatch through a selected connector account"; spec/core/messaging.md, "Send routing and hook routing have distinct fallback rules"; spec/core/events.md, "Story: Emit ordered events with their run session"; spec/core/terminal.md, "Story: Finalize one run after all admitted child work"
  const lifecycle: Array<{ type: unknown; seq: number }> = []
  const events = runtime.getService<AgentEventService>(ServiceType.AGENT_EVENT)
  const unsubscribe = events?.subscribe((event) => {
    if (event.stream === "lifecycle") lifecycle.push({ type: (event.data as { type?: unknown }).type, seq: event.seq })
  })
  sent.length = 0
  log.length = 0
  runEnded.length = 0
  const child = { requested: try gate(), release: try gate() }
  const terminalMarks = () => log.filter((entry) => entry === "child:settled" || entry === "run:ended")
  const juicePending = try Effect.try(() => turn("juice", say("j02-m4", dm, "remember juice #RECORD_NOTE"), { child: { requested: child.requested, release: child.release.promise } }))
  try host(() => child.requested.promise)
  try sleep("30 millis")
  const whileChildPending = terminalMarks()
  child.release.resolve()
  const juiceTurn = try host(() => juicePending)
  unsubscribe?.()
  try host(() => runtime.sendMessageToTarget({ source: "chat", roomId: dm, accountId: "acct-other" }, { text: "fallback route" }))
  const missing = try host(() => runtime.sendMessageToTarget({ source: "nowhere", roomId: dm }, { text: "lost" }).then(() => "sent", (error: unknown) => error instanceof ElizaError ? error.code : String(error)))
  const editOutcome = (accountId: string) => host(() => runtime.editMessageOnTarget({ source: "chat", roomId: dm, accountId }, "j02-sent-1", { text: "edited" }).then(() => "edited", (error: unknown) => error instanceof Error ? error.message : String(error)))
  const edits = [try editOutcome("acct-primary"), try editOutcome("acct-other"), log.filter((entry) => entry === "edit:default").length]
  try Effect.try(() => assert.deepStrictEqual([
    sent.map((entry) => [entry.via, entry.accountId, entry.text]),
    missing,
    edits,
    lifecycle.map((entry) => entry.type),
    lifecycle.every((entry, index) => index === 0 || entry.seq > (lifecycle[index - 1]?.seq ?? 0)),
    runEnded,
    whileChildPending,
    terminalMarks(),
  ], [
    [["account", "acct-primary", "Saved: juice"], ["default", "acct-other", "fallback route"]],
    "SEND_HANDLER_NOT_FOUND",
    ["Connector does not support edit_message (source: chat accountId: acct-primary)", "edited", 1],
    ["run_start", "action_start", "action_end", "run_end"],
    true,
    [{ runId: juiceTurn.runId, status: "completed", receipts: ["receipt-juice"] }],
    [],
    ["child:settled", "run:ended"],
  ]))

  // spec/core/journey.md, "Action evidence and transport acknowledgement remain distinct"
  sent.length = 0
  runEnded.length = 0
  sendHold.failNext = true
  const kaleTurn = try host(() => turn("kale", say("j02-m4b", dm, "remember kale #RECORD_NOTE")).then((outcome) => outcome.runId, (error: unknown) => error instanceof Error ? error.message : String(error)))
  try Effect.try(() => assert.deepStrictEqual([sendHold.failNext, runEnded.map((entry) => [entry.runId, entry.receipts]), sent], [false, [[kaleTurn, ["receipt-kale"]]], []]))

  // spec/core/concurrency.md, "Story: Own each room through durable settlement"
  log.length = 0
  const firstTurn = try Effect.try(() => turn("first", say("j02-m5", dm, "wait for me #WAIT")))
  try host(() => waitEntered.promise)
  const secondTurn = try Effect.try(() => turn("second", say("j02-m6", dm, "and then this #LOOKUP")))
  waitRelease.resolve()
  try host(() => Promise.all([firstTurn, secondTurn]))
  try Effect.try(() => assert.deepStrictEqual(log.filter((entry) => /^(first|second):(start|end)$|^wait:/.test(entry)), ["first:start", "wait:enter", "wait:exit", "first:end", "second:start", "second:end"]))

  try host(() => runtime.ensureConnection({ entityId: user, roomId: other, worldId: world, userName: "ada", name: "Ada", source: "chat", type: ChannelType.DM, channelId: "dm-2" }))

  // spec/core/multiRoomLeases.md, "Each transaction captures the sorted deduplicated room set"; spec/core/multiRoomLeases.md, "Release drains the held prefix from its highest room downward"
  const roomRanks: [UUID, UUID, UUID] = [dm, group, other]
  const [lowerRoom, overlapRoom, upperRoom] = roomRanks.sort()
  const leaseJourney = try host(async () => {
    const queue = runtime.roomHandlerQueue
    const entered = Promise.withResolvers<string[]>()
    const leave = Promise.withResolvers<void>()
    const waiting = Promise.withResolvers<void>()
    const abort = new AbortController()
    const reason = new Error("room lease request cancelled")
    const holding = queue.withLeases([upperRoom, overlapRoom], async (leases) => {
      entered.resolve([...leases.keys()])
      await leave.promise
    })
    const work: Promise<unknown>[] = [holding]
    const unsubscribe = queue.onEvent((event) => {
      if (event.type === "enqueued" && event.roomId === overlapRoom && event.queueDepth === 2) waiting.resolve()
    })
    try {
      const acquired = await Promise.race([entered.promise, holding])
      const request = queue.withLeases([overlapRoom, lowerRoom], async () => "entered", { signal: abort.signal }).then(
        (result) => result,
        (error: unknown) => error instanceof RoomHandlerQueueAbortedError ? [error.roomId, error.cause === reason] : error,
      )
      work.push(request)
      await Promise.race([waiting.promise, request])
      const beforeAbort = [queue.pendingFor(lowerRoom), queue.pendingFor(overlapRoom)]
      const recoveredId = stringToUuid("j02-recovered-room-lease")
      const recovery = queue.withLease(lowerRoom, (lease) => queue.withLeaseWrite(lowerRoom, lease, async () => {
        await runtime.createMemory({ ...say("j02-recovered-room-lease", lowerRoom, "stored after unwind"), id: recoveredId }, "lease-journey")
        return (await runtime.getMemoryById(recoveredId))?.content.text
      }))
      work.push(recovery)
      abort.abort(reason)
      const refused = await request
      const text = await recovery
      return { acquired, beforeAbort, refused, text, remaining: queue.pendingFor(overlapRoom) }
    } finally {
      unsubscribe()
      abort.abort(reason)
      leave.resolve()
      await Promise.allSettled(work)
    }
  })
  try Effect.try(() => assert.deepStrictEqual(
    [leaseJourney.acquired, leaseJourney.beforeAbort, leaseJourney.refused, leaseJourney.text, leaseJourney.remaining],
    [[overlapRoom, upperRoom], [1, 2], [overlapRoom, true], "stored after unwind", 1],
  ))

  // spec/core/turnControllers.md, "Story: Cancel room work without cancelling the cancel request"; spec/core/asyncContext.md, "Story: Keep concurrent turn context isolated"
  const held = try Effect.try(() => runWithTrajectoryContext({ runId: "run-held" }, () => runtime.turnControllers.runWith(dm, async (signal) => {
    holdEntered.resolve()
    await holdRelease.promise
    return [signal.aborted, getTrajectoryContext()?.runId]
  })))
  const cancelled = try Effect.try(() => runWithTrajectoryContext({ runId: "run-cancelled" }, () => runtime.turnControllers.runWith(other, async (signal) => {
    const answer = runtime.useModel(ModelType.TEXT_SMALL, { prompt: "slow question", signal })
    return answer.then(() => ["answered", getTrajectoryContext()?.runId], (error: unknown) => [error, getTrajectoryContext()?.runId])
  })))
  try host(() => holdEntered.promise)
  const slowSeen = () => primary.seen.some((call) => (call.params as { prompt?: string }).prompt === "slow question")
  const untilSlowSeen: void!! = Effect.suspend(() => slowSeen() ? Effect.void : Effect.andThen(sleep("1 millis"), untilSlowSeen))
  try Effect.race(untilSlowSeen, sleep("5 seconds"))
  const reachedModel = slowSeen()
  const canceller = try host(() => runtime.turnControllers.runWith(other, async (signal) => [runtime.abortTurn(other, "user"), signal.aborted]))
  holdRelease.resolve()
  const [heldOutcome, cancelledOutcome] = try host(() => Promise.all([held, cancelled]))
  const turnError = cancelledOutcome[0]
  try Effect.try(() => assert.deepStrictEqual([
    reachedModel,
    canceller,
    turnError instanceof TurnAbortedError,
    (turnError as TurnAbortedError).code,
    (turnError as TurnAbortedError).message,
    cancelledOutcome[1],
    fallback.seen.filter((call) => call.modelType === ModelType.TEXT_SMALL).length,
    heldOutcome,
  ], [true, [true, false], true, "TURN_ABORTED", "Turn aborted: user", "run-cancelled", 0, [false, "run-held"]]))

  // spec/core/confirmation.md, "Story: Settle an explicit confirmation from the user's reply"; spec/core/confirmation.md, "A refusal overrides an initial affirmative and an unclear reply stays pending"
  const confirm = (id: string, roomId: UUID, text: string, pendingKey = "all") =>
    host(() => requireConfirmation({ runtime, message: say(id, roomId, text), actionName: "DELETE_NOTES", pendingKey, prompt: "Delete every note? Reply yes to confirm.", metadata: { scope: "all" } }))
  const decisions = [
    try confirm("j02-c1", dm, "delete all my notes"),
    try confirm("j02-c2", dm, "hmm, maybe?"),
    try confirm("j02-c3", other, "yes"),
    try confirm("j02-c4", dm, "yes"),
    try confirm("j02-c5", dm, "delete all my notes again", "again"),
    try confirm("j02-c6", dm, "yes, actually no", "again"),
  ]
  try Effect.try(() => assert.deepStrictEqual(decisions, [{ status: "pending" }, { status: "pending" }, { status: "pending" }, { status: "confirmed", metadata: { scope: "all" } }, { status: "pending" }, { status: "cancelled", metadata: { scope: "all" } }]))
  for (const [i, refusal] of ["だめ", "やめて", "算了", "确认，算了", "確認、だめです", "確認、やめてください"].entries()) {
    const offered = try confirm(`j02-offer-${i}`, dm, "delete all my notes", refusal)
    const declined = try confirm(`j02-refuse-${i}`, dm, refusal, refusal)
    try Effect.try(() => assert.deepStrictEqual([refusal, offered, declined], [refusal, { status: "pending" }, { status: "cancelled", metadata: { scope: "all" } }]))
  }

  // spec/core/responseEvaluation.md, "Story: Apply response evaluator decisions in priority order"; spec/core/diagnostics.md, "Story: Observe a failure without failing the reporting path"
  const classifierError = new Error("classifier offline")
  runtime.registerResponseHandlerEvaluator({ name: "z-patch", priority: 20, shouldRun: async () => true, evaluate: async () => ({ reply: "patched reply" }) })
  runtime.registerResponseHandlerEvaluator({ name: "m-broken", priority: 10, shouldRun: async () => true, evaluate: async () => {
    throw classifierError
  } })
  runtime.registerResponseHandlerEvaluator({ name: "a-early", priority: 15, shouldRun: async () => true, evaluate: async () => ({ reply: "early reply" }) })
  const messageHandler: MessageHandlerResult = { processMessage: "RESPOND", plan: { contexts: [], reply: "draft reply" }, thought: "" }
  const evaluation = try host(() => runResponseHandlerEvaluators({ runtime, message: m1, state: lookupTurn.state, messageHandler, availableContexts: [] }))
  const evaluatorReports = runtime.getRecentReportedErrors().filter((entry) => entry.scope === "ResponseHandlerEvaluator.evaluate").map(({ at: _at, ...entry }) => entry)
  try Effect.try(() => assert.deepStrictEqual([evaluation, messageHandler.plan.reply, evaluatorReports], [
    {
      activeEvaluators: ["m-broken", "a-early", "z-patch"],
      appliedPatches: [{ evaluatorName: "a-early", debug: [], changed: ["reply:set"] }, { evaluatorName: "z-patch", debug: [], changed: ["reply:set"] }],
      candidateActionsAddedByEvaluators: [],
      candidateActionsClearedByEvaluators: false,
      errors: [{ evaluatorName: "m-broken", error: "classifier offline" }],
    },
    "patched reply",
    [{ scope: "ResponseHandlerEvaluator.evaluate", code: "UNCLASSIFIED", message: "classifier offline", context: { evaluator: "m-broken" } }],
  ]))

  // spec/core/responseFields.md, "All active fields parse before handlers begin and preemption stops subsequent handlers"
  const volatileFields: unknown[] = []
  for (const member of ["parse", "shouldRun"] as const) {
    const registry = try Effect.try(() => new ResponseHandlerFieldRegistry())
    let handled = 0
    const field: ResponseHandlerFieldEvaluator = { name: `j02-${member}`, description: "host field", schema: { type: "string" }, handle: async () => { handled += 1; return undefined } }
    const observed = try changingMethod(field, member, undefined)
    try Effect.try(() => registry.register(field))
    const result = try host(() => registry.dispatch({ runtime, message: m1, state: lookupTurn.state, senderRole: "USER", turnSignal: new AbortController().signal, rawParsed: { [field.name]: "input" } }))
    const trace = result.traces[0]
    volatileFields.push([trace?.active, trace?.parsed, trace?.parseOutcome, trace?.handled, typeof result.fieldErrors[field.name] === "string", handled, observed])
  }
  try Effect.try(() => assert.deepStrictEqual(volatileFields, [
    [true, false, "hard-fail", false, true, 0, { reads: 2, totalReads: 2, cachedCalls: 0 }],
    [true, false, "skipped", false, true, 0, { reads: 2, totalReads: 2, cachedCalls: 0 }],
  ]))

  // spec/core/journey.md, "Retirement waits for the admitted turn and its pending reply"; spec/core/postDelivery.md, "Story: Track detached work under runtime and room ownership"; spec/core/postDelivery.md, "Story: Capture and settle a connector delivery boundary"
  delivered.length = 0
  const brokenResult = try host(() => executePlannedToolCall(runtime, { message: m1, activeContexts: ["general"], callback: capture }, { name: "BROKEN" }))
  log.length = 0
  sendHold.entered = try gate()
  sendHold.settled = try gate()
  sendHold.release = sendRelease.promise
  const roomWork = try Effect.try(() => roomWorkRelease.promise.then(() => {
    log.push("room-work:settled")
  }))
  const lastTurn = try Effect.try(() => turn("last", say("j02-m7", dm, "remember soup #RECORD_NOTE"), { roomWork }))
  try host(() => sendHold.entered.promise)
  const stopped = try Effect.try(() => runtime.stop().then(() => {
    log.push("stop:resolved")
  }))
  try sleep("30 millis")
  const settledMarks = () => log.filter((entry) => entry === "send:settled" || entry === "room-work:settled" || entry === "stop:resolved")
  const whileSending = settledMarks()
  sendRelease.resolve()
  try host(() => sendHold.settled.promise)
  try sleep("30 millis")
  const whileRoomWork = settledMarks()
  roomWorkRelease.resolve()
  try host(() => Promise.all([lastTurn, stopped]))
  try Effect.try(() => assert.deepStrictEqual([brokenResult.success, (brokenResult.data as { error?: unknown } | undefined)?.error === boom, delivered.map((content) => content.text), whileSending, whileRoomWork, settledMarks()], [
    false,
    true,
    [],
    [],
    ["send:settled"],
    ["send:settled", "room-work:settled", "stop:resolved"],
  ]))
}, 60_000)

// spec/core/models.md, "Story: Dispatch a complete admitted request"; spec/core/models.md, "Admission checks the complete request without changing its source bytes"; spec/core/models.md, "Eligible text failures advance only to registrations with remaining budget"; spec/core/models.md, "Cancellation follows turn identity and blocks fallback"; spec/core/registries.md, "Story: Select registered model handlers in order"; spec/core/registries.md, "Model registration preserves every handler and its provider identity"; spec/core/journey.md, "Model invocation retains the admitted request through fallback and failure"; spec/core/preparedRequests.md, "Story: Bind every transport retry to the admitted request"; spec/core/preparedRequests.md, "Only the admitted body can supply its input token count"; spec/core/modelAttemptLeases.md, "Story: Issue a turn-scoped model allowance"; spec/core/pseudonymSession.md, "Story: Keep substitutions reversible across repeated model calls"; spec/core/secretSession.md, "Story: Restore known placeholders while keeping credentials out of replies"; spec/core/secretSession.md, "Egress restores pseudonyms before placeholders, and recognition never reads a placeholder"; spec/core/streamRevisions.md, "Story: Distinguish a new stream attempt from prior chunks"; spec/core/skeletonStreamState.md, "Story: Stream exact visible text without losing partial parser state"; spec/core/unicode.md, "Story: Preserve Unicode in provider requests and diagnostics"; spec/core/modelDiagnostics.md, "Story: Finish every diagnostic write before storage closes"
it.live("Dispatch a model request through failover, swaps, streams, cancellation and a turn allowance (spec/core/models.md, \"Story: Dispatch a complete admitted request\"; spec/core/models.md, \"A failure is eligible only as a refused connection, a busy or failing provider or a spent retry budget, and never for speech\")", () => Effect.scoped(effect {
  const EMAIL = "jane.okafor@acmecapital.com"
  const ADDRESS = "1600 Pennsylvania Avenue NW"
  const KEY = "sk-live-abcdefghijklmnopqrstuvwxyz0123"
  const UNICODE = "lone \uD800 high, lone \uDC00 low, astral 😀 𝄞, 中文 and café"
  const RAW = "{\"text\":\"Line one\\nsays \\\"hi\\\" caf\\u00e9 \\ud83d\\ude00 and a tab\\tend\"}"
  const answered: string[] = []
  const guards: Array<{ attempts: number; countsAdmittedBody: boolean; changedBody: unknown }> = []
  const logGate = { released: false }
  const deliveries: Array<{ call: number; chunk: string; revision: number | undefined }> = []
  const promptOf = (params: unknown) => String((params as { prompt?: unknown } | undefined)?.prompt)
  const text = (models: { seen: SeenCall[] }) => models.seen.filter((call) => call.modelType === ModelType.TEXT_LARGE)
  const outcome = (promise: Promise<unknown>) => promise.then((value) => ({ value }), (error: unknown) => ({ error }))
  const failure = (settled: { value: unknown } | { error: unknown }) => "error" in settled ? settled.error : "resolved"
  const valueOf = (settled: { value: unknown } | { error: unknown }) => "value" in settled ? settled.value : settled.error
  const contactIn = (prompt: string) => prompt.match(/__ELIZA_CONTACT_\w+?__/)?.[0] ?? "none"
  const bytes = (body: string) => new TextEncoder().encode(body).byteLength
  const arrived = Promise.withResolvers<void>()
  const server = try acquireRelease(
    host(() => loopback((_request, response) => {
      response.writeHead(200, { "content-type": "text/plain" })
      response.write("the body never ends")
      arrived.resolve()
    })),
    (opened) => orDie(host(() => opened.close())),
  )
  const fx = try Effect.try(() => {
    const otherTurnGate = Promise.withResolvers<void>()
    const transport = (attempts: number) => (params: unknown): ScriptedReply => {
      const request = params as { prompt: string; maxTokens: number }
      const body = JSON.stringify({ model: "gpt-test", input: request.prompt, max_output_tokens: request.maxTokens })
      let serialized = 0
      const guard = createPreparedModelRequestGuard({ provider: "openai", model: "gpt-test", route: "responses", serializeRequest: () => serialized++ <= attempts ? body : `${body} `, outputReserveTokens: request.maxTokens })
      for (let attempt = 0; attempt < attempts; attempt += 1) guard.assertBeforeAttempt()
      let changedBody: unknown = "admitted"
      try {
        guard.assertBeforeAttempt()
      } catch (error) {
        changedBody = (error as { code?: unknown }).code
      }
      guards.push({ attempts: guard.attempts, countsAdmittedBody: guard.budget.inputTokens === bytes(body), changedBody })
      return `allowed ${request.prompt}`
    }
    const socket = providerError("socket")
    const failures = { funding: providerError("funding"), policy: providerError("policy"), abort: providerError("abort"), speech: providerError("socket"), stream: providerError("socket"), exhausted: Object.assign(new Error("retry budget exhausted"), { code: MODEL_PROVIDER_RETRY_BUDGET_EXHAUSTED }) }
    const chunks = Array.from({ length: Math.ceil(RAW.length / 7) }, (_, index) => RAW.slice(index * 7, index * 7 + 7))
    const alpha = scriptedModels("alpha", 30, {
      [ModelType.TEXT_LARGE]: [
        { fail: socket },
        { fail: failures.exhausted },
        { fail: failures.funding },
        { fail: failures.policy },
        { fail: failures.abort },
        { reply: (params) => `Sent to ${promptOf(params)}` },
        { reply: (params) => `Again ${contactIn(promptOf(text(alpha)[5]?.params))} near ${promptOf(params)}` },
        { reply: (params) => promptOf(params) },
        { fetch: server.url("127.0.0.1", "/body") },
        { until: otherTurnGate.promise, reply: "answer in another turn" },
        { chunks },
        { fail: failures.stream },
        { reply: "final answer" },
      ],
      [ModelType.IMAGE]: [{ reply: [{ url: "https://images.test/1.png" }] as unknown as ScriptedReply }],
      [ModelType.TEXT_TO_SPEECH]: [{ fail: failures.speech }],
    })
    const rootTurn = new AbortController()
    const preAborted = new AbortController()
    const reasons = { root: new Error("turn 7 cancelled"), pre: new Error("cancelled before dispatch") }
    preAborted.abort(reasons.pre)
    return {
      alpha,
      failures,
      reasons,
      rootTurn,
      preAborted,
      otherTurnGate,
      otherTurn: new AbortController(),
      caller: new AbortController(),
      leaseTurn: new AbortController(),
      allowanceOwner: new AbortController(),
      scopedLeaseTurn: new AbortController(),
      scopedAllowanceOwner: new AbortController(),
      logGate: Promise.withResolvers<void>(),
      decoded: (JSON.parse(RAW) as { text: string }).text,
      alphaBackup: scriptedModels("alpha", 20, { [ModelType.TEXT_LARGE]: [{ reply: "answer from alpha 20" }, { chunks }] }),
      beta: scriptedModels("beta", 10, {
        [ModelType.TEXT_LARGE]: [{ reply: "answer from beta" }],
        [ModelType.TEXT_TO_SPEECH]: [{ reply: new Uint8Array([1, 2, 3]) }],
      }),
      scopedAnthropic: scriptedModels("@elizaos/plugin-anthropic", 0, { [ModelType.TEXT_LARGE]: [{ reply: "answer from scoped anthropic" }] }),
      scopedEmbeddings: scriptedModels("@elizaos/plugin-embeddings", 0, { [ModelType.TEXT_EMBEDDING]: [{ reply: [0.25, 0.75] }] }),
      otherOpenai: scriptedModels("@other/plugin-openai", 0, { [ModelType.TEXT_LARGE]: [{ reply: "unqualified other openai" }] }),
      scopedOpenai: scriptedModels("@elizaos/plugin-openai", 0, { [ModelType.TEXT_LARGE]: [{ reply: transport(1) }, { reply: transport(1) }] }),
      openai: scriptedModels("openai", 0, { [ModelType.TEXT_LARGE]: [{ reply: transport(2) }, { reply: transport(1) }] }),
    }
  })
  const { alpha, alphaBackup, beta, scopedAnthropic, scopedEmbeddings, otherOpenai, scopedOpenai, openai } = fx
  const store = try storeAt("core-j03")

  const journey = try Effect.scoped(effect {
    const runtime = try kernel({ store, character: { name: "Eliza", secrets: { OPENAI_API_KEY: KEY } }, plugins: [alpha.plugin, beta.plugin] })
    // spec/core/index.md, "Compatibility translates asynchronous results without losing failures"
    class RecognizerPort extends Service {
      static serviceType = "pii_entity_recognizer"
      capabilityDescription = "j03 recognizer host port"
      static async start(owner: IAgentRuntime): Promise<RecognizerPort> { return new RecognizerPort(owner) }
      async stop(): Promise<void> {}
    }
    const recognizerModel = try Effect.try(() => scriptedModels("j03-ner", 0, { [ModelType.TEXT_SMALL]: [{ reply: "recognizer reply" }] }))
    try host(() => runtime.registerPlugin(recognizerModel.plugin))
    try host(() => runtime.registerPlugin({ name: "j03-recognizer", description: "j03", services: [RecognizerPort] }))
    const recognizer = try host(() => runtime.getServiceLoadPromise(RecognizerPort.serviceType))
    const recognition = { reads: 0, calls: 0, receiver: false }
    const getRecognizer = function (this: unknown) { recognition.calls += 1; recognition.receiver = this === recognizer; return null }
    try Effect.try(() => Object.defineProperty(recognizer, "getRecognizer", { get: () => { recognition.reads += 1; return recognition.reads === 1 ? getRecognizer : null } }))
    runtime.setSetting("ELIZA_PII_SWAP_ENABLED", "true")
    const recognizedReply = try host(() => runtime.useModel(ModelType.TEXT_SMALL, { prompt: "recognizer boundary" }, "j03-ner"))
    runtime.setSetting("ELIZA_PII_SWAP_ENABLED", "false")
    answered.push(`useModel:${ModelType.TEXT_SMALL}`)
    try host(() => runtime.unloadPlugin("j03-recognizer"))
    try host(() => runtime.unloadPlugin(recognizerModel.plugin.name))
    try Effect.try(() => assert.deepStrictEqual([recognizedReply, recognition, recognizerModel.seen.length], ["recognizer reply", { reads: 1, calls: 1, receiver: true }, 1]))

    // spec/core/models.md, "Story: Dispatch a complete admitted request"
    const localModel = try Effect.try(() => scriptedModels("ollama", 50, { [ModelType.TEXT_SMALL]: [{ reply: "local prose" }] }))
    const remoteModel = try Effect.try(() => scriptedModels("j03-remote", 0, { [ModelType.TEXT_SMALL]: [{ reply: "remote prose" }, { reply: "{\"ok\":true}" }] }))
    try host(() => runtime.registerPlugin(localModel.plugin))
    try host(() => runtime.registerPlugin(remoteModel.plugin))
    const pinnedRemote = try host(() => callModelWithValidation(runtime, { modelType: ModelType.TEXT_SMALL, provider: "j03-remote", params: { prompt: "pinned remote" }, schema: { type: "object", required: ["ok"], properties: { ok: { type: "boolean" } } } }))
    for (let attempt = 0; attempt < pinnedRemote.attempts; attempt++) answered.push(`useModel:${ModelType.TEXT_SMALL}`)
    try host(() => runtime.unloadPlugin(remoteModel.plugin.name))
    try host(() => runtime.unloadPlugin(localModel.plugin.name))
    try Effect.try(() => assert.deepStrictEqual([pinnedRemote.parsed, pinnedRemote.attempts, localModel.seen.length], [{ ok: true }, 2, 0]))

    // spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/diagnostics.md, "Story: Observe a failure without failing the reporting path"
    class TrajectoryPort extends Service {
      static serviceType = "trajectories"
      capabilityDescription = "j03 host trajectory port"
      onEnabled: () => void = () => {}
      onStart: () => void = () => {}
      isEnabled: (() => boolean) | undefined = () => { this.onEnabled(); return true }
      startTrajectory: (() => string) | undefined = () => { this.onStart(); return "j03-host-trajectory" }
      startStep: (() => string) | undefined = () => "j03-host-step"
      endTrajectory = async () => {}
      flushWriteQueue = async () => {}
      annotateStep: (() => void) | undefined = () => {}
      logLlmCall: (() => void) | undefined = () => {}
      static async start(owner: IAgentRuntime): Promise<TrajectoryPort> { return new TrajectoryPort(owner) }
      async stop(): Promise<void> {}
    }
    try host(() => runtime.registerPlugin({ name: "j03-host-trajectory", description: "j03", services: [TrajectoryPort] }))
    const trajectory = try host(async () => {
      const service = await runtime.getServiceLoadPromise("trajectories")
      if (!(service instanceof TrajectoryPort)) throw new TypeError("The registered trajectory service must retain its constructor")
      return service
    })
    const defaults = { isEnabled: trajectory.isEnabled, startTrajectory: trajectory.startTrajectory, startStep: trajectory.startStep, flushWriteQueue: trajectory.flushWriteQueue, annotateStep: trajectory.annotateStep, logLlmCall: trajectory.logLlmCall, onEnabled: trajectory.onEnabled, onStart: trajectory.onStart }
    const trajectoryFailures: unknown[] = []
    const diagnostic = (scope: string) => runtime.getRecentReportedErrors().filter((entry) => entry.scope === scope).length
    for (const next of [undefined, null]) {
      const observed = try changingMethod(trajectory, "isEnabled", next)
      const failure = try host(() => withStandaloneTrajectory(runtime, { source: "j03-enabled" }, () => "kept").then(() => undefined, (error: unknown) => error))
      trajectoryFailures.push([failure instanceof TypeError, observed])
      try Effect.try(() => { Reflect.deleteProperty(trajectory, "isEnabled"); Object.assign(trajectory, defaults) })
    }
    let armedStep = false
    trajectory.onStart = () => { armedStep = true }
    const stepObserved = try changingMethod(trajectory, "startStep", undefined, () => armedStep)
    const stepBefore = diagnostic("StandaloneTrajectory.startStep")
    const step = try host(() => withStandaloneTrajectory(runtime, { source: "j03-step" }, () => getTrajectoryContext()?.trajectoryStepId))
    trajectoryFailures.push([step, stepObserved, diagnostic("StandaloneTrajectory.startStep") === stepBefore + 1])
    try Effect.try(() => { Reflect.deleteProperty(trajectory, "startStep"); Object.assign(trajectory, defaults) })
    for (const child of [false, true]) {
      let armedFlush = false
      const observed = try changingMethod(trajectory, "flushWriteQueue", null, () => armedFlush)
      const scope = child ? "TrajectoryChildStep.finalize" : "StandaloneTrajectory.flush"
      const before = diagnostic(scope)
      const work = () => { armedFlush = true; return "kept" }
      const value = try host(async () => await (child
        ? runWithTrajectoryContext({ trajectoryId: "j03-parent", trajectoryStepId: "j03-parent-step" }, () => withEvaluatorStep(runtime, "j03-child", work))
        : withStandaloneTrajectory(runtime, { source: "j03-flush" }, work)))
      trajectoryFailures.push([value, observed, diagnostic(scope) === before + 1])
      try Effect.try(() => { Reflect.deleteProperty(trajectory, "flushWriteQueue"); Object.assign(trajectory, defaults) })
    }
    for (const member of ["startTrajectory", "annotateStep", "logLlmCall"] as const) {
      trajectory.onEnabled = () => { trajectory[member] = undefined }
      const before = diagnostic("StandaloneTrajectory.start")
      const capture = try host(async () => {
        try {
          if (member === "startTrajectory") return await withStandaloneTrajectory(runtime, { source: "j03-start" }, () => getTrajectoryContext()?.trajectoryId)
          if (member === "annotateStep") return await annotateActiveTrajectoryStep(runtime, { stepId: "j03-parent-step" })
          return await runWithTrajectoryContext({ trajectoryId: "j03-parent", trajectoryStepId: "j03-parent-step" }, async () => logActiveTrajectoryLlmCall(runtime, { model: "j03-model", systemPrompt: "", userPrompt: "", response: "", purpose: "test" }))
        } catch (error) {
          return error
        }
      })
      trajectoryFailures.push([member === "startTrajectory" ? capture === undefined && diagnostic("StandaloneTrajectory.start") === before + 1 : capture instanceof TypeError])
      try Effect.try(() => Object.assign(trajectory, defaults))
    }
    trajectory.logLlmCall = throwOnRead({ failure: new TypeError("j03 logger fault") })
    const providerCallBefore = diagnostic("TrajectoryProviderCall")
    const recordedReply = try host(async () => runWithTrajectoryContext({ trajectoryId: "j03-parent", trajectoryStepId: "j03-parent-step" }, async () => recordLlmCall(runtime, { model: "j03-model", systemPrompt: "", userPrompt: "", purpose: "test" }, () => "generated")))
    trajectoryFailures.push([recordedReply, diagnostic("TrajectoryProviderCall") === providerCallBefore + 1])
    try Effect.try(() => Object.assign(trajectory, defaults))
    for (const next of [undefined, null]) {
      const context: TrajectoryContext = {}
      const observed = try changingMethod(context, "activateTaskCapture", next)
      const failure = try host(() => Promise.resolve(runWithTrajectoryContext(context, () => ensureTaskTrajectory())).then(() => undefined, (error: unknown) => error))
      trajectoryFailures.push([failure instanceof TypeError, observed])
    }
    try host(() => runtime.unloadPlugin("j03-host-trajectory"))
    try Effect.try(() => assert.deepStrictEqual(trajectoryFailures, [
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
      ["j03-host-trajectory", { reads: 2, totalReads: 4, cachedCalls: 0 }, true],
      ["kept", { reads: 2, totalReads: 4, cachedCalls: 0 }, true],
      ["kept", { reads: 2, totalReads: 4, cachedCalls: 0 }, true],
      [true], [true], [true],
      ["generated", true],
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
    ]))
    // spec/core/traces.md, "Story: Retain enrich and retire active trace records"; spec/core/traces.md, "Recording preserves the insertion position of a replacement in its run"
    try Effect.try(() => {
      type ExecutionTrace = Parameters<AgentRuntime["recordPromptTrace"]>[0]
      type ScoreSignal = Parameters<AgentRuntime["enrichTrace"]>[1]
      const runA = stringToUuid("j03-trace-a")
      const runB = stringToUuid("j03-trace-b")
      const nativeNow = Date.now
      let clock = 1_000_000
      const ttl = 300_000
      const trace = ({ id, runId, createdAt = clock }: Pick<ExecutionTrace, "id" | "runId"> & Partial<Pick<ExecutionTrace, "createdAt">>): ExecutionTrace => ({
        id, runId, createdAt, traceVersion: 1, type: "trace", promptKey: "j03.trace", modelSlot: ModelType.TEXT_LARGE, modelId: "synthetic-model", templateHash: "synthetic-template", schemaFingerprint: "synthetic-schema", variant: "baseline", parseSuccess: true, schemaValid: true, validationCodesMatched: true, retriesUsed: 0, tokenEstimate: 1, latencyMs: 1, scoreCard: { signals: [], compositeScore: 0 },
      })
      const clear = () => { runtime.deleteActiveTrace(runA); runtime.deleteActiveTrace(runB) }
      Date.now = () => clock
      try {
        const expired = trace({ id: "cadence", runId: runA, createdAt: clock - ttl - 1 })
        runtime.recordPromptTrace(expired)
        const ignored = trace({ id: "ignored", runId: undefined })
        let ignoredIdReads = 0
        Object.defineProperty(ignored, "id", { get: () => { ignoredIdReads += 1; return "ignored" } })
        for (let attempt = 0; attempt < 98; attempt += 1) runtime.recordPromptTrace(ignored)
        const replacement = trace({ id: "cadence", runId: runB })
        const purgeBeforeIdentity: boolean[] = []
        Object.defineProperty(replacement, "runId", { get: () => { purgeBeforeIdentity.push(runtime.getActiveTrace(runA) === undefined); return runB } })
        runtime.recordPromptTrace(replacement)
        assert.deepStrictEqual({ ignoredIdReads, purgeBeforeIdentity }, { ignoredIdReads: 0, purgeBeforeIdentity: [true] })
        assert.strictEqual(runtime.getActiveTrace(runB), replacement)
        clear()

        const first = trace({ id: "x", runId: runA })
        const second = trace({ id: "y", runId: runB })
        const transferred = trace({ id: "x", runId: runB })
        runtime.recordPromptTrace(first)
        runtime.recordPromptTrace(second)
        runtime.recordPromptTrace(transferred)
        assert.deepStrictEqual(runtime.getActiveTracesForRun(runA), [])
        assert.deepStrictEqual(runtime.getActiveTracesForRun(runB), [second, transferred])
        const rerecorded = trace({ id: "x", runId: runB })
        runtime.recordPromptTrace(rerecorded)
        assert.deepStrictEqual(runtime.getActiveTracesForRun(runB), [second, rerecorded])
        const purgeOrder: string[] = []
        Object.defineProperty(rerecorded, "createdAt", { get: () => { purgeOrder.push("x"); return clock } })
        Object.defineProperty(second, "createdAt", { get: () => { purgeOrder.push("y"); return clock } })
        runtime.purgePromptTraces()
        assert.deepStrictEqual(purgeOrder, ["x", "y"])
        runtime.deleteActiveTrace(runA)
        assert.strictEqual(runtime.getActiveTrace(runB), rerecorded)
        const emptyId = trace({ id: "", runId: runA })
        runtime.recordPromptTrace(emptyId)
        assert.strictEqual(runtime.getActiveTrace(runA), emptyId)
        runtime.deleteActiveTraceById("")
        assert.strictEqual(runtime.getActiveTrace(runA), undefined)
        clear()

        const changingId = trace({ id: "initial-id", runId: runA })
        let admissionIdReads = 0
        Object.defineProperty(changingId, "id", { get: () => { admissionIdReads += 1; return admissionIdReads === 1 ? "captured-id" : "unadmitted-alias" } })
        runtime.recordPromptTrace(changingId)
        assert.strictEqual(admissionIdReads, 1)
        assert.strictEqual(runtime.getActiveTrace(runA), changingId)
        runtime.deleteActiveTraceById("unadmitted-alias")
        assert.strictEqual(runtime.getActiveTrace(runA), changingId)
        runtime.deleteActiveTraceById("captured-id")
        assert.strictEqual(runtime.getActiveTrace(runA), undefined)
        assert.strictEqual(admissionIdReads, 1)

        const numeric = {
          nan: trace({ id: "numeric-nan", runId: runA, createdAt: Number.NaN }),
          infinity: trace({ id: "numeric-infinity", runId: runA, createdAt: Number.POSITIVE_INFINITY }),
          negativeInfinity: trace({ id: "numeric-negative-infinity", runId: runA, createdAt: Number.NEGATIVE_INFINITY }),
          boundary: trace({ id: "numeric-boundary", runId: runA, createdAt: clock - ttl }),
          expiredFraction: trace({ id: "numeric-expired-fraction", runId: runA, createdAt: clock - ttl - 0.5 }),
          freshFraction: trace({ id: "numeric-fresh-fraction", runId: runA, createdAt: clock - ttl + 0.5 }),
        }
        for (const entry of Object.values(numeric)) runtime.recordPromptTrace(entry)
        runtime.purgePromptTraces()
        assert.deepStrictEqual(runtime.getActiveTracesForRun(runA), [numeric.infinity, numeric.boundary, numeric.freshFraction])
        numeric.infinity.createdAt = clock - ttl - 1
        runtime.purgePromptTraces()
        assert.deepStrictEqual(runtime.getActiveTracesForRun(runA), [numeric.boundary, numeric.freshFraction])
        const mutable = numeric.boundary
        const card: ExecutionTrace["scoreCard"] = { signals: [], compositeScore: 0 }
        mutable.scoreCard = card
        mutable.id = "caller-mutated-id"
        mutable.runId = runB
        const signal: ScoreSignal = { source: "fixture", kind: "quality", value: 0.5, traceId: "numeric-boundary" }
        runtime.enrichTrace(runA, signal)
        assert.strictEqual(mutable.scoreCard, card)
        assert.strictEqual(card.signals[0], signal)
        assert.strictEqual(card.compositeScore, 0.5)
        assert.strictEqual(runtime.getActiveTracesForRun(runA)[0], mutable)
        runtime.deleteActiveTraceById("caller-mutated-id")
        assert.strictEqual(runtime.getActiveTracesForRun(runA)[0], mutable)
        clock += 1
        runtime.purgePromptTraces()
        assert.deepStrictEqual(runtime.getActiveTracesForRun(runA), [])
        clear()

        const sharedCard: ExecutionTrace["scoreCard"] = { signals: [], compositeScore: 0 }
        const sharedA = trace({ id: "shared-a", runId: runA })
        const sharedB = trace({ id: "shared-b", runId: runB })
        sharedA.scoreCard = sharedCard
        sharedB.scoreCard = sharedCard
        runtime.recordPromptTrace(sharedA)
        runtime.recordPromptTrace(sharedB)
        const sharedSignal: ScoreSignal = { source: "fixture", kind: "quality", value: 0.5 }
        runtime.enrichTrace(runA, sharedSignal)
        assert.strictEqual(sharedA.scoreCard, sharedCard)
        assert.strictEqual(sharedB.scoreCard, sharedCard)
        assert.strictEqual(sharedB.scoreCard.signals[0], sharedSignal)
        clear()

        const beforeThrow = trace({ id: "before-throw", runId: runA, createdAt: clock - ttl - 1 })
        const hostile = trace({ id: "hostile", runId: runA })
        const afterThrow = trace({ id: "after-throw", runId: runA, createdAt: clock - ttl - 1 })
        const failure = new Error("createdAt observer failed")
        Object.defineProperty(hostile, "createdAt", { get: throwOnRead({ failure }) })
        for (const entry of [beforeThrow, hostile, afterThrow]) runtime.recordPromptTrace(entry)
        let caught: unknown
        try { runtime.purgePromptTraces() } catch (error) { caught = error }
        assert.strictEqual(caught, failure)
        const retained = runtime.getActiveTracesForRun(runA)
        assert.strictEqual(retained.length, 2)
        assert.strictEqual(retained[0], hostile)
        assert.strictEqual(retained[1], afterThrow)
        clear()

        const appended = trace({ id: "append-c", runId: runA })
        const appendFirst = trace({ id: "append-a", runId: runA })
        const appendSecond = trace({ id: "append-b", runId: runA })
        const appendCard = appendFirst.scoreCard
        let append = true
        Object.defineProperty(appendFirst, "scoreCard", { get: () => { if (append) { append = false; runtime.recordPromptTrace(appended) } return appendCard } })
        runtime.recordPromptTrace(appendFirst)
        runtime.recordPromptTrace(appendSecond)
        assert.strictEqual(runtime.getActiveTracesForRun(runA).length, 2)
        const appendedSignal: ScoreSignal = { source: "fixture", kind: "quality", value: 0.25 }
        runtime.enrichTrace(runA, appendedSignal)
        for (const entry of [appendFirst, appendSecond, appended]) assert.strictEqual(entry.scoreCard.signals[0], appendedSignal)
        clear()

        const retiredFirst = trace({ id: "retired-a", runId: runA })
        const retiredSecond = trace({ id: "retired-b", runId: runA })
        const newSecond = trace({ id: "retired-b", runId: runA })
        const unvisited = trace({ id: "retired-c", runId: runA })
        const retiredCard = retiredFirst.scoreCard
        let replace = true
        Object.defineProperty(retiredFirst, "scoreCard", { get: () => { if (replace) { replace = false; runtime.deleteActiveTrace(runA); runtime.recordPromptTrace(newSecond); runtime.recordPromptTrace(unvisited) } return retiredCard } })
        runtime.recordPromptTrace(retiredFirst)
        runtime.recordPromptTrace(retiredSecond)
        const retiredSignal: ScoreSignal = { source: "fixture", kind: "quality", value: 0.75 }
        runtime.enrichTrace(runA, retiredSignal)
        assert.strictEqual(retiredCard.signals[0], retiredSignal)
        assert.strictEqual(newSecond.scoreCard.signals[0], retiredSignal)
        assert.strictEqual(retiredSecond.scoreCard.signals.length, 0)
        assert.strictEqual(unvisited.scoreCard.signals.length, 0)
        assert.deepStrictEqual(runtime.getActiveTracesForRun(runA), [newSecond, unvisited])
        clear()

        const selectedFirst = trace({ id: "selected-a", runId: runA })
        const selectedSecond = trace({ id: "selected-b", runId: runA })
        const foreignSecond = trace({ id: "selected-b", runId: runB })
        const foreignUnvisited = trace({ id: "selected-c", runId: runA })
        runtime.recordPromptTrace(selectedFirst)
        runtime.recordPromptTrace(selectedSecond)
        const capturedSignal: ScoreSignal = { source: "fixture", kind: "quality", value: 1 }
        Object.defineProperty(capturedSignal, "traceId", { get: () => { runtime.deleteActiveTrace(runA); runtime.recordPromptTrace(foreignSecond); runtime.recordPromptTrace(foreignUnvisited); return undefined } })
        runtime.enrichTrace(runA, capturedSignal)
        assert.strictEqual(foreignSecond.scoreCard.signals[0], capturedSignal)
        assert.strictEqual(foreignUnvisited.scoreCard.signals.length, 0)
        assert.strictEqual(selectedSecond.scoreCard.signals.length, 0)
        assert.strictEqual(runtime.getActiveTrace(runB), foreignSecond)
      } finally {
        Date.now = nativeNow
        clear()
      }
    })
    try Effect.try(() => alphaBackup.register(runtime))
    const large = (params: Record<string, unknown>, provider?: string) =>
      outcome(runtime.useModel(ModelType.TEXT_LARGE, params as never, provider).then((value) => {
        answered.push(`useModel:${ModelType.TEXT_LARGE}`)
        return value
      }))
    const scoped = (context: StreamingContext, run: () => Promise<{ value: unknown } | { error: unknown }>) => {
      try {
        return runWithStreamingContext(context, run)
      } catch (error) {
        return Promise.reject(error)
      }
    }
    const inTurn = (context: TrajectoryContext, params: Record<string, unknown>) => host(() => Promise.resolve(runWithTrajectoryContext(context, () => large(params))))

    // spec/core/registries.md, "Model registration preserves every handler and its provider identity"
    const registered = runtime.getModelRegistrations().filter((entry) => entry.modelType === ModelType.TEXT_LARGE)
    const registrations = registered.map((entry) => [entry.provider, entry.priority, entry.registrationOrder > 0])
    const [alpha30Order, alpha20Order, betaOrder] = ([["alpha", 30], ["alpha", 20], ["beta", 10]] as const).map(([provider, priority]) =>
      registered.find((entry) => entry.provider === provider && entry.priority === priority)?.registrationOrder ?? Number.NaN)
    const orderKept = alpha30Order <= betaOrder && betaOrder <= alpha20Order

    // spec/core/models.md, "Eligible text failures advance only to registrations with remaining budget"; spec/core/preparedRequests.md, "Only the admitted body can supply its input token count"
    const failedOver = try host(() => large({ prompt: "Summarize the café report 😀", maxTokens: 64 }))
    const [refused, retried] = [text(alpha)[0], text(alphaBackup)[0]]
    const admittedBudget = (retried?.params as { providerOptions?: { eliza?: { modelInputBudget?: { estimatedInputTokens?: number } } } } | undefined)
      ?.providerOptions?.eliza?.modelInputBudget?.estimatedInputTokens
    const failover = {
      result: valueOf(failedOver),
      sameBytes: refused !== undefined && refused.body === retried?.body,
      budgetIsFullMeasure: admittedBudget === bytes(retried?.body ?? ""),
    }
    const backupBeforeExhausted = text(alphaBackup).length
    const exhaustedAnswer = try host(() => large({ prompt: "Summarize after the budget is spent" }))
    const exhausted = { result: valueOf(exhaustedAnswer), siblingCalls: text(alphaBackup).length - backupBeforeExhausted }

    const terminalBefore = [text(alphaBackup).length, text(beta).length, beta.seen.length]
    const terminal = {
      funding: failure(try host(() => large({ prompt: "funding" }))) === fx.failures.funding,
      policy: failure(try host(() => large({ prompt: "policy" }))) === fx.failures.policy,
      abort: failure(try host(() => large({ prompt: "abort" }))) === fx.failures.abort,
      speech: failure(try host(() => outcome(runtime.useModel(ModelType.TEXT_TO_SPEECH, { text: "hello" })))) === fx.failures.speech,
      secondCalls: [text(alphaBackup).length, text(beta).length, beta.seen.length].map((count, index) => count - (terminalBefore[index] ?? 0)),
    }

    runtime.setSetting("ELIZA_BRAIN_PROVIDER", "gamma")
    const pinned = failure(try host(() => large({ prompt: "pinned" })))
    try Effect.try(() => {
      scopedAnthropic.register(runtime)
      scopedEmbeddings.register(runtime)
    })
    runtime.setSetting("ELIZA_BRAIN_PROVIDER", "anthropic")
    const brainShort = try host(() => large({ prompt: "brain short" }))
    runtime.setSetting("ELIZA_BRAIN_PROVIDER", "@elizaos/plugin-anthropic")
    const brainScoped = try host(() => large({ prompt: "brain scoped" }))
    runtime.setSetting("ELIZA_BRAIN_PROVIDER", null)
    const explicitShort = try host(() => large({ prompt: "explicit short" }, "anthropic"))
    const explicitScoped = try host(() => large({ prompt: "explicit scoped" }, "@elizaos/plugin-beta"))
    const embed = (textInput: string, provider?: string) =>
      outcome(runtime.useModel(ModelType.TEXT_EMBEDDING, { text: textInput }, provider).then((value) => {
        answered.push(`useModel:${ModelType.TEXT_EMBEDDING}`)
        return value
      }))
    const embedShort = try host(() => embed("embed short", "embeddings"))
    const embedScoped = try host(() => embed("embed scoped", "@elizaos/plugin-embeddings"))
    const pin = {
      isElizaError: pinned instanceof ElizaError,
      code: (pinned as { code?: unknown }).code,
      namesProvider: String((pinned as { message?: unknown }).message).includes("\"gamma\""),
      brainShort: valueOf(brainShort),
      brainScoped: valueOf(brainScoped),
      explicitShort: valueOf(explicitShort),
      explicitScoped: valueOf(explicitScoped),
      embedShort: valueOf(embedShort),
      embedScoped: valueOf(embedScoped),
    }

    // spec/core/pseudonymSession.md, "Story: Keep substitutions reversible across repeated model calls"; spec/core/secretSession.md, "Story: Restore known placeholders while keeping credentials out of replies"
    runtime.setSetting("ELIZA_SECRET_SWAP_ENABLED", "true")
    runtime.setSetting("ELIZA_PII_SWAP_ENABLED", "true")
    const turn: TrajectoryContext = { messageId: "turn-5" }
    const first = try inTurn(turn, { prompt: `Mail ${EMAIL} at ${ADDRESS} with ${KEY}`, signal: fx.caller.signal })
    const second = try inTurn(turn, { prompt: `Visit ${ADDRESS}` })
    const imageParams = { prompt: `Draw a postcard for ${EMAIL}`, size: "1024x1024", negativePrompt: `no ${EMAIL}`, signal: fx.caller.signal }
    try host(() => outcome(runtime.useModel(ModelType.IMAGE, imageParams).then(() => answered.push(`useModel:${ModelType.IMAGE}`))))
    const firstSeen = promptOf(text(alpha)[5]?.params)
    const secondSeen = promptOf(text(alpha)[6]?.params)
    const imageSeen = alpha.seen.find((call) => call.modelType === ModelType.IMAGE)?.params as Record<string, unknown> | undefined
    const surrogate = firstSeen.split(" at ")[1]?.split(" with ")[0] ?? "none"
    const userReply = (settled: { value: unknown } | { error: unknown }) => {
      const reply = String(valueOf(settled))
      return turn.piiSwapSession?.restoreText(turn.secretSwapSession?.restoreUserReplyText(reply) ?? reply)
    }
    // spec/core/secretSession.md, "Egress restores pseudonyms before placeholders, and recognition never reads a placeholder"
    const connectorSend: unknown[] = []
    try Effect.try(() => runtime.registerMessageConnector({
      source: "pii-egress",
      sendHandler: async (_runtime, _target, content) => {
        connectorSend.push(content.text)
      },
    }))
    try host(() => Promise.resolve(runWithTrajectoryContext(turn, () => runtime.sendMessageToTarget({ source: "pii-egress" }, { text: `Meet at ${surrogate}`, agentVoiced: true }))))
    const swaps = {
      providerSawRealValues: [EMAIL, ADDRESS, KEY].some((value) => `${firstSeen} ${secondSeen} ${promptOf(imageSeen)}`.includes(value)),
      surrogateReused: surrogate !== ADDRESS && secondSeen === `Visit ${surrogate}`,
      repliesHoldRealValues: [EMAIL, ADDRESS, KEY].some((value) => JSON.stringify([valueOf(first), valueOf(second)]).includes(value)),
      firstUserReply: userReply(first),
      secondUserReply: userReply(second),
      imageFields: [imageSeen?.size, imageSeen?.negativePrompt],
      callerSignal: [(text(alpha)[5]?.params as { signal?: unknown } | undefined)?.signal === fx.caller.signal, imageSeen?.signal === fx.caller.signal],
      connectorSend,
    }
    // spec/core/secretSession.md, "Egress restores pseudonyms before placeholders, and recognition never reads a placeholder"; spec/core/secretSession.md, "A map coordinate never becomes a contact reference"
    const PHONE = "+12025550123"
    const CARD = `[MAPSCARD]\n${JSON.stringify({ kind: "place", place: { latitude: 37.7749295, longitude: -122.4194093 } })}\n[/MAPSCARD]`
    const secret = new SecretSwapSession()
    const contact = try Effect.try(() => secret.substituteText(PHONE))
    const unwritten = contact.replace(/_[0-9]+__$/, "_999999__")
    const recognizerInputs: string[] = []
    const names = [`${contact} Alice Example`, contact, unwritten, "Alice Example"]
    const pii = new PseudonymSession({ salt: "j03-private", recognizer: { name: "j03-gazetteer", recognize: (input: string) => {
      recognizerInputs.push(input)
      const value = names.find((name) => input.includes(name))
      return Promise.resolve(value === undefined ? [] : [{ kind: "person", value, start: input.indexOf(value), end: input.indexOf(value) + value.length }])
    } } })
    const privateTurn: TrajectoryContext = { messageId: "turn-6", secretSwapSession: secret, piiSwapSession: pii }
    const privateModel = try Effect.try(() => scriptedModels("j03-private", 0, { [ModelType.TEXT_LARGE]: [{ reply: "noted" }] }))
    try host(() => runtime.registerPlugin(privateModel.plugin))
    try host(() => Promise.resolve(runWithTrajectoryContext(privateTurn, () => runtime.useModel(ModelType.TEXT_LARGE, { prompt: `Text ${PHONE} Alice Example ${CARD}` }, "j03-private"))))
    answered.push(`useModel:${ModelType.TEXT_LARGE}`)
    const privatePrompt = promptOf(privateModel.seen[0]?.params)
    const recognizerSawReference = recognizerInputs.some((input) => input.includes("__ELIZA_"))
    const recipients: unknown[] = []
    try Effect.try(() => runtime.registerAction({
      name: "J03_TEXT_CONTACT",
      description: "Texts a phone number",
      parameters: [{ name: "recipient", description: "The phone number", required: true, schema: { type: "string" } }],
      validate: async () => true,
      handler: async (_runtime, _message, _state, options) => {
        recipients.push((options?.parameters as { recipient?: unknown } | undefined)?.recipient)
        return { success: true, text: "sent" }
      },
    }))
    try host(() => pii.learn(contact))
    try host(() => pii.learn(unwritten))
    const contactMessage = createMessageMemory({ id: stringToUuid("j03-private-message"), entityId: runtime.agentId, agentId: runtime.agentId, roomId: stringToUuid("j03-private-room"), content: { text: "text my contact" } })
    const textTo = (recipient: string) => host(() => outcome(Promise.resolve(runWithTrajectoryContext(privateTurn, () =>
      executePlannedToolCall(runtime, { message: contactMessage, activeContexts: ["general"] }, { name: "J03_TEXT_CONTACT", params: { recipient } })))))
    const sentToContact = try textTo(pii.substituteText(contact))
    const sentToUnwritten = try textTo(pii.substituteText(unwritten))
    const privateAction = {
      recognizerSawReference,
      providerSaw: [privatePrompt.includes(contact), privatePrompt.includes(PHONE), privatePrompt.includes("Alice Example"), privatePrompt.includes(CARD)],
      aliasesWrapReferences: pii.substituteText(contact) !== contact,
      results: [sentToContact, sentToUnwritten].map((settled) => "value" in settled && (settled.value as { success?: unknown }).success === true),
      recipients,
    }

    runtime.setSetting("ELIZA_SECRET_SWAP_ENABLED", "false")
    runtime.setSetting("ELIZA_PII_SWAP_ENABLED", "false")

    // spec/core/unicode.md, "Story: Preserve Unicode in provider requests and diagnostics"
    const echoed = try host(() => large({ prompt: UNICODE }))
    const unicodeCall = text(alpha)[7]
    const unicodeBudget = (unicodeCall?.params as { providerOptions?: { eliza?: { modelInputBudget?: { estimatedInputTokens?: number } } } } | undefined)
      ?.providerOptions?.eliza?.modelInputBudget?.estimatedInputTokens
    const unicode = { providerSaw: promptOf(unicodeCall?.params) === UNICODE, reply: valueOf(echoed) === UNICODE, budgetCountsUtf8: unicodeBudget === bytes(unicodeCall?.body ?? "") }

    // spec/core/models.md, "Cancellation follows turn identity and blocks fallback"
    const fallbackBefore = [text(alphaBackup).length, text(beta).length]
    const sameTurn = try sync(() => ({ pending: scoped({ messageId: "turn-7", abortSignal: fx.rootTurn.signal }, () =>
      scoped({ messageId: "turn-7" }, () => large({ prompt: "read the loopback body" }))) }))
    try host(() => arrived.promise)
    const otherTurn = try sync(() => ({ pending: scoped({ messageId: "turn-7", abortSignal: fx.rootTurn.signal }, () =>
      scoped({ messageId: "turn-8", abortSignal: fx.otherTurn.signal }, () => large({ prompt: "answer in another turn" }))) }))
    while (text(alpha).length < 10) try sleep("5 millis")
    fx.rootTurn.abort(fx.reasons.root)
    const cancelled = try host(() => sameTurn.pending)
    try host(() => server.socketClosed(0))
    fx.otherTurnGate.resolve()
    const answeredElsewhere = try host(() => otherTurn.pending)
    const preAborted = try host(() => large({ prompt: "never dispatched", signal: fx.preAborted.signal }))
    const cancellation = {
      sameTurn: failure(cancelled) === fx.reasons.root,
      socketClosed: server.requests.map((request) => request.closed),
      otherTurn: valueOf(answeredElsewhere),
      preAborted: failure(preAborted) === fx.reasons.pre,
      handlerCalls: text(alpha).length,
      fallbackCalls: [text(alphaBackup).length, text(beta).length].map((count, index) => count - (fallbackBefore[index] ?? 0)),
    }

    // spec/core/skeletonStreamState.md, "Story: Stream exact visible text without losing partial parser state"; spec/core/streamRevisions.md, "Story: Distinguish a new stream attempt from prior chunks"
    const streamed = (call: number) => ({
      prompt: "stream the reply",
      stream: true,
      streamStructured: true,
      responseSkeleton: { spans: [{ kind: "free-string", key: "text" }] },
      streamFields: [{ field: "text" }],
      onStreamChunk: (chunk: string, _messageId?: string, _accumulated?: string, revision?: number) => {
        deliveries.push({ call, chunk, revision })
      },
    })
    const firstStream = try host(() => large(streamed(1)))
    const retriedStream = try host(() => large(streamed(2)))
    const visible = (call: number) => deliveries.filter((delivery) => delivery.call === call).map((delivery) => delivery.chunk).join("")
    const revisions = (call: number) => [...new Set(deliveries.filter((delivery) => delivery.call === call).map((delivery) => delivery.revision))]
    const [firstRevision] = revisions(1)
    const [retriedRevision] = revisions(2)
    const streams = {
      visible: [visible(1), visible(2)],
      results: [valueOf(firstStream), valueOf(retriedStream)],
      revisionsPerAttempt: [revisions(1).length, revisions(2).length],
      retriedSkipsFailedAttempt: Number(retriedRevision) - Number(firstRevision),
      retriedBy: text(alphaBackup).length,
    }

    // spec/core/modelAttemptLeases.md, "Story: Issue a turn-scoped model allowance"; spec/core/preparedRequests.md, "Story: Bind every transport retry to the admitted request"
    try Effect.try(() => otherOpenai.register(runtime))
    const otherScopeShortRejected = failure(try host(() => large({ prompt: "other scope short" }, "openai"))) instanceof Error
    const otherScopeElizaRejected = failure(try host(() => large({ prompt: "other scope eliza" }, "@elizaos/plugin-openai"))) instanceof Error
    try Effect.try(() => scopedOpenai.register(runtime))
    const scopedLease = try Effect.try(() => createModelAttemptAllowance({
      signal: fx.scopedAllowanceOwner.signal,
      budgetMicroUsd: 1_000_000,
      maxAttempts: 2,
      maxOutputTokens: 256,
      expiresAt: Date.now() + 60_000,
      tariffs: [{ provider: "openai", model: "gpt-test", route: "responses", inputNanoUsdPerToken: 1, outputNanoUsdPerToken: 1, inputTokenUpperBound: 100_000 }],
    }).openTurn("turn-8b", fx.scopedLeaseTurn.signal))
    const scopedLeased = (prompt: string, provider: string) => host(() => scoped(
      { messageId: "turn-8b", modelAttemptTurnId: "turn-8b", modelAttemptLease: scopedLease, abortSignal: fx.scopedLeaseTurn.signal },
      () => large({ prompt, maxTokens: 1_000 }, provider),
    ))
    const scopedLeasedResults = [
      try scopedLeased("short to scoped", "openai"),
      try scopedLeased("scoped to scoped", "@elizaos/plugin-openai"),
      try scopedLeased("other-scope openai", "@other/plugin-openai"),
      try scopedLeased("non-openai scoped", "anthropic"),
    ]
    try Effect.try(() => openai.register(runtime))
    const lease = try Effect.try(() => createModelAttemptAllowance({
      signal: fx.allowanceOwner.signal,
      budgetMicroUsd: 1_000_000,
      maxAttempts: 3,
      maxOutputTokens: 256,
      expiresAt: Date.now() + 60_000,
      tariffs: [{ provider: "openai", model: "gpt-test", route: "responses", inputNanoUsdPerToken: 1, outputNanoUsdPerToken: 1, inputTokenUpperBound: 100_000 }],
    }).openTurn("turn-9", fx.leaseTurn.signal))
    const leased = (prompt: string) => host(() => scoped(
      { messageId: "turn-9", modelAttemptTurnId: "turn-9", modelAttemptLease: lease, abortSignal: fx.leaseTurn.signal },
      () => large({ prompt, maxTokens: 1_000 }, "openai"),
    ))
    const leasedResults = [try leased("first, retried once café 😀"), try leased("second"), try leased("third")]
    const allowance = {
      otherScopeLookupRejected: [otherScopeShortRejected, otherScopeElizaRejected],
      otherScopeCalls: otherOpenai.seen.length,
      scopedResults: scopedLeasedResults.map((settled) => "value" in settled ? settled.value : (settled.error as { code?: unknown }).code),
      scopedProviderMaxTokens: text(scopedOpenai).map((call) => (call.params as { maxTokens?: unknown }).maxTokens),
      results: leasedResults.map((settled) => "value" in settled ? settled.value : (settled.error as { code?: unknown }).code),
      providerMaxTokens: text(openai).map((call) => (call.params as { maxTokens?: unknown }).maxTokens),
      guards,
    }

    // spec/core/modelDiagnostics.md, "Story: Finish every diagnostic write before storage closes"
    try Effect.try(() => (runtime.adapter as unknown as SqliteAdapter).fault("createLogs", { gate: fx.logGate.promise }))
    const finalAnswer = try host(() => large({ prompt: "final diagnostic" }))
    try forkDetach(effect {
      try sleep("200 millis")
      logGate.released = true
      fx.logGate.resolve()
    })

    try Effect.try(() => assert.deepStrictEqual({ registrations, orderKept, failover, exhausted, terminal, pin, swaps, privateAction, unicode, cancellation, streams, allowance }, {
      registrations: [["alpha", 30, true], ["alpha", 20, true], ["beta", 10, true]],
      orderKept: true,
      failover: { result: "answer from alpha 20", sameBytes: true, budgetIsFullMeasure: true },
      exhausted: { result: "answer from beta", siblingCalls: 0 },
      terminal: { funding: true, policy: true, abort: true, speech: true, secondCalls: [0, 0, 0] },
      pin: {
        isElizaError: true,
        code: "MODEL_PROVIDER_PIN_UNAVAILABLE",
        namesProvider: true,
        brainShort: "answer from scoped anthropic",
        brainScoped: "answer from scoped anthropic",
        explicitShort: "answer from scoped anthropic",
        explicitScoped: "answer from beta",
        embedShort: [0.25, 0.75],
        embedScoped: [0.25, 0.75],
      },
      swaps: {
        providerSawRealValues: false,
        surrogateReused: true,
        repliesHoldRealValues: false,
        firstUserReply: `Sent to Mail ${EMAIL} at ${ADDRESS} with [redacted credential]`,
        secondUserReply: `Again ${EMAIL} near Visit ${ADDRESS}`,
        imageFields: ["1024x1024", `no ${EMAIL}`],
        callerSignal: [true, true],
        connectorSend: [`Meet at ${ADDRESS}`],
      },
      privateAction: { recognizerSawReference: false, providerSaw: [true, false, false, true], aliasesWrapReferences: true, results: [true, false], recipients: [PHONE] },
      unicode: { providerSaw: true, reply: true, budgetCountsUtf8: true },
      cancellation: { sameTurn: true, socketClosed: [true], otherTurn: "answer in another turn", preAborted: true, handlerCalls: 10, fallbackCalls: [0, 0] },
      streams: { visible: [fx.decoded, fx.decoded], results: [RAW, RAW], revisionsPerAttempt: [1, 1], retriedSkipsFailedAttempt: 2, retriedBy: 2 },
      allowance: {
        otherScopeLookupRejected: [true, true],
        otherScopeCalls: 0,
        scopedResults: ["allowed short to scoped", "allowed scoped to scoped", "MODEL_ATTEMPT_POLICY_ROUTE", "MODEL_ATTEMPT_POLICY_ROUTE"],
        scopedProviderMaxTokens: [256, 256],
        results: ["allowed first, retried once café 😀", "allowed second", "MODEL_ATTEMPT_POLICY_EXHAUSTED"],
        providerMaxTokens: [256, 256, 256],
        guards: [
          { attempts: 1, countsAdmittedBody: true, changedBody: "MODEL_PREPARED_REQUEST_MUTATED" },
          { attempts: 1, countsAdmittedBody: true, changedBody: "MODEL_PREPARED_REQUEST_MUTATED" },
          { attempts: 2, countsAdmittedBody: true, changedBody: "MODEL_PREPARED_REQUEST_MUTATED" },
          { attempts: 1, countsAdmittedBody: true, changedBody: "MODEL_PREPARED_REQUEST_MUTATED" },
        ],
      },
    }))
    return { answer: valueOf(finalAnswer), gatePendingAtStop: !logGate.released }
  })

  const reader = try Effect.try(() => new SqliteAdapter(store, "reader"))
  const closedBeforeRead = [...store.closeLog]
  const rows = try host(() => reader.getLogs({}))
  try host(() => reader.close())
  const diagnostics = rows.filter((row) => row.type.startsWith("useModel:"))
  const promptsOf = (body: unknown) => (body as { prompt?: unknown }).prompt
  try Effect.try(() => assert.deepStrictEqual({
    journey,
    closedBeforeRead,
    diagnosticTypes: diagnostics.map((row) => row.type).sort(),
    gatedWriteStored: diagnostics.some((row) => promptsOf(row.body) === "final diagnostic"),
    unicodeStored: diagnostics.some((row) => promptsOf(row.body) === UNICODE),
  }, {
    journey: { answer: "final answer", gatePendingAtStop: true },
    closedBeforeRead: ["a"],
    diagnosticTypes: [...answered].sort(),
    gatedWriteStored: true,
    unicodeStored: true,
  }))
}), 60_000)

// spec/core/models.md, "Story: Get a whole answer from a busy provider"; spec/core/models.md, "A model call takes no output cap from settings"; spec/core/models.md, "An extractor pass refused with a temporary rate limit waits it out, at most five seconds, and is sent once more"
it.live("Get a whole answer from a busy provider: no setting caps output, an older character loads without its cap, and each extractor pass waits out a rate limit once (spec/core/models.md, \"Story: Get a whole answer from a busy provider\")", () => scoped(effect {
  const limited = () => Object.assign(new Error("Too many requests"), { status: 429, retryAfterMs: 200 })
  const models = try Effect.try(() => scriptedModels("busy", 10, {
    [ModelType.TEXT_LARGE]: [{ fail: limited() }, { reply: "unreadable" }, { fail: limited() }, { reply: "ok" }, { fail: limited() }, { fail: limited() }],
  }))
  const runtime = try kernel({ settings: { TEXT_LARGE_MAX_TOKENS: "16", DEFAULT_MAX_TOKENS: "16", DEFAULT_TEMPERATURE: "0.2" } })
  try Effect.sync(() => models.register(runtime))
  const parser = (raw: string) => raw === "ok" ? raw : null
  const providerOptions = { eliza: { thinking: "low" } }
  const began = Date.now()
  const repaired = try host(() => runExtractorPipeline({ runtime, prompt: "Plan the reminder.", providerOptions, parser, buildRepairPrompt: () => "Repair it." }))
  const waited = Date.now() - began
  const refused = try host(() => runExtractorPipeline({ runtime, prompt: "Plan another.", parser }).then(() => "resolved", (error: unknown) => (error as { status?: unknown }).status))
  const sent = models.seen.map(({ params }) => params as { prompt?: unknown; maxTokens?: unknown; temperature?: unknown; providerOptions?: { eliza?: { modelInputBudget?: unknown } } })
  const legacy = parseAndValidateCharacter(JSON.stringify({ name: "legacy-character", settings: { defaultMaxTokens: 16, defaultTemperature: 0.25 } }))
  try Effect.try(() => assert.deepStrictEqual({
    legacy: { success: legacy.success, settings: legacy.data?.settings },
    repaired, refused, waitedForBoth: waited >= 400,
    sent: sent.map(({ prompt, maxTokens, temperature, providerOptions: options }) => {
      const { modelInputBudget: _budget, ...eliza } = options?.eliza ?? {}
      return { prompt, capped: maxTokens !== undefined, temperature, options: Object.keys(eliza).length ? { ...options, eliza } : undefined }
    }),
  }, {
    legacy: { success: true, settings: { defaultTemperature: 0.25 } },
    repaired: { parsed: "ok", raw: "ok", repaired: true }, refused: 429, waitedForBoth: true,
    sent: [
      { prompt: "Plan the reminder.", capped: false, temperature: 0.2, options: providerOptions },
      { prompt: "Plan the reminder.", capped: false, temperature: 0.2, options: providerOptions },
      { prompt: "Repair it.", capped: false, temperature: 0.2, options: providerOptions },
      { prompt: "Repair it.", capped: false, temperature: 0.2, options: providerOptions },
      { prompt: "Plan another.", capped: false, temperature: 0.2, options: undefined },
      { prompt: "Plan another.", capped: false, temperature: 0.2, options: undefined },
    ],
  }))
}), 60_000)

it.live('An extractor pass that already tried two providers keeps the original refusal (spec/core/models.md, "An extractor pass refused with a temporary rate limit waits it out, at most five seconds, and is sent once more")', () => scoped(effect {
  const refusal = Object.freeze(Object.assign(new Error("Temporary refusal"), { status: 429, retryAfterMs: 0 }))
  const primary = try Effect.try(() => scriptedModels("first-provider", 10, {
    [ModelType.TEXT_LARGE]: [{ fail: providerError("socket") }, { reply: "unexpected resend" }],
  }))
  const secondary = try Effect.try(() => scriptedModels("second-provider", 0, {
    [ModelType.TEXT_LARGE]: [{ fail: refusal }],
  }))
  const runtime = try kernel({})
  try Effect.sync(() => { primary.register(runtime); secondary.register(runtime) })
  const failure = try host(() => runExtractorPipeline({
    runtime, prompt: "Plan the reminder.", parser: (raw) => raw,
  }).then(() => undefined, (error: unknown) => error))
  assert.strictEqual(failure, refusal)
  assert.deepStrictEqual([primary.seen.length, secondary.seen.length], [1, 1])
}), 60_000)

// spec/core/plugins.md, "Story: Load and roll back a plugin"; spec/core/plugins.md, "Duplicate callers share the registration outcome"; spec/core/plugins.md, "Cleanup removes only owned contributions"; spec/core/plugins.md, "Service start remains owned across rollback and unload"; spec/core/pluginServices.md, "Story: Retry and reload plugins without losing epoch ownership"; spec/core/pluginServices.md, "A retired epoch cannot mutate a replacement epoch"; spec/core/pluginServices.md, "Story: Withdraw plugin declarations without losing asynchronous instances"; spec/core/services.md, "Story: Acquire a declared service"; spec/core/services.md, "Concurrent acquisition joins the original startup"; spec/core/services.md, "An observer failure retains the running service"; spec/core/services.md, "Story: Stop a late or removed service once"; spec/core/services.md, "Late startup enters retirement without publication"; spec/core/serviceInstances.md, "Story: Share starts and stop each returned object once"; spec/core/eagerServices.md, "Story: Retry transient eager startup without restarting shutdown work"; spec/core/eagerServices.md, "Backoff starts only after rejection and uses the declared delay sequence"; spec/core/registries.md, "Story: Register actions providers and evaluators"; spec/core/registries.md, "Plugin contributions cannot displace an incumbent component"; spec/core/registries.md, "Story: Remove only registrations owned by a plugin epoch"; spec/core/messaging.md, "A captured handler survives registry removal and replacement"; spec/core/concurrentConnectors.md, "Story: Retain captured transports during registry replacement"; spec/core/hooks.md, "Story: Dispatch an immutable phase snapshot"; spec/core/hooks.md, "Each phase dispatch captures the current handler identities"; spec/core/hookService.md, "Story: Dispatch eligible event hooks in a stable order"; spec/core/hookService.md, "Eligibility returns every failure in source order and caches successful binary probes"; spec/core/adapterOwnership.md, "Story: Preserve adapter identity through plugin failure and migrations"; spec/core/concurrentHooks.md, "Story: Replace hooks while independent phase calls are in flight"; spec/core/serviceAcquisitionResult.md, "Story: Explain a service acquisition failure with every original cause"; spec/core/serviceBuilder.md, "Story: Build independent service classes from a mutable builder"
it.live("Load, reload and unload plugins, services and hooks (spec/core/plugins.md, \"Story: Load and roll back a plugin\")", () => effect {
  const store = try storeAt("j04-store")
  const runtime = try kernel({ store })
  const hostAdapter = runtime.adapter
  const probe = (serviceType: string, starting: (attempt: number) => Promise<void>) => {
    const record = { starts: 0, stops: 0, instances: [] as Service[] }
    class Probe extends Service {
      static serviceType = serviceType
      capabilityDescription = serviceType
      async stop(): Promise<void> {
        record.stops += 1
      }
      static async start(owner: IAgentRuntime): Promise<Probe> {
        record.starts += 1
        await starting(record.starts)
        const instance = new Probe(owner)
        record.instances.push(instance)
        return instance
      }
    }
    return { Probe, record }
  }
  const pause = (millis: number) => runPromise(sleep(millis))
  const delivered: string[][] = []
  const relay = (tag: string, gate?: { entered: PromiseWithResolvers<void>; release: Promise<void> }) => async (_owner: IAgentRuntime, _target: unknown, content: Content) => {
    gate?.entered.resolve()
    await gate?.release
    delivered.push([tag, String(content.text)])
  }
  const reported = (scope: string) => runtime.getRecentReportedErrors().filter((entry) => entry.scope === scope).map((entry) => [entry.message, entry.context?.serviceType ?? entry.context?.hookId])

  let inits = 0
  const order: string[] = []
  const sharedFailure = new Error("j04 shared init failed")
  const shared: Plugin = { name: "j04-shared", description: "j04", init: async () => {
    inits += 1
    await pause(20)
    order.push("init")
    if (inits === 1) throw sharedFailure
  } }
  const register = (caller: number) => host(() => runtime.registerPlugin(shared).then(() => false, (error: unknown) => error === sharedFailure).finally(() => order.push(`caller ${caller}`)))
  const callerResults = try all([register(0), register(1)], { concurrency: "unbounded" })
  try host(() => runtime.registerPlugin(shared))
  const joined = [callerResults, order, inits, runtime.plugins.filter((plugin) => plugin.name === "j04-shared").length]

  const incumbent: Action = { name: "J04_ACT", description: "incumbent", similes: [], handler: async () => ({ success: true }), validate: async () => true }
  try host(() => runtime.registerPlugin({ name: "j04-incumbent", description: "j04", actions: [incumbent] }))
  const slowStarted = Promise.withResolvers<void>()
  const slow = probe("j04-slow", async () => {
    slowStarted.resolve()
    await pause(150)
  })
  const initFailure = new Error("j04 init failed")
  const flaky: Plugin = { name: "j04-flaky", description: "j04", init: async (_config, owner) => {
    owner.registerAction({ ...incumbent, description: "displacer" })
    owner.registerAction({ ...incumbent, name: "J04_FLAKY_ACT", description: "flaky" })
    await owner.registerService(slow.Probe)
    void owner.getServiceLoadPromise("j04-slow").catch(() => undefined)
    await slowStarted.promise
    throw initFailure
  } }
  const rejected = try Effect.flip(host(() => runtime.registerPlugin(flaky)))
  const rolledBack = [
    rejected === initFailure,
    runtime.actions.filter((action) => action.name.startsWith("J04_")).map((action) => action.description),
    slow.record.starts,
    slow.record.stops,
    runtime.getService("j04-slow"),
    runtime.plugins.some((plugin) => plugin.name === "j04-flaky"),
  ]

  const attempts: Array<{ startedAt: number; rejectedAt?: number }> = []
  const eager = probe("j04-eager", async (attempt) => {
    attempts.push({ startedAt: Date.now() })
    if (attempt < 3) {
      attempts[attempts.length - 1].rejectedAt = Date.now()
      throw new Error(`j04 eager attempt ${attempt} failed`)
    }
  })
  try host(() => runtime.registerPlugin({ name: "j04-eager", description: "j04", services: [eager.Probe] }))

  const lateRegistration = Promise.withResolvers<void>()
  const epoch = (tag: string): Plugin => ({ name: "j04-epoch", description: "j04", actions: [{ ...incumbent, name: `J04_EPOCH_${tag}`, description: tag }], init: async (_config, owner) => {
    owner.registerMessageConnector({ source: "j04-epoch", sendHandler: relay(tag) })
    if (tag === "ONE") void lateRegistration.promise.then(() => owner.registerMessageConnector({ source: "j04-epoch", sendHandler: relay("LATE") }))
  } })
  try host(() => runtime.registerPlugin(epoch("ONE")))
  const unloaded = (try host(() => runtime.unloadPlugin("j04-epoch")))?.pluginName
  try host(() => runtime.reloadPlugin(epoch("TWO")))
  lateRegistration.resolve()
  try host(() => lateRegistration.promise.then(() => pause(10)))
  try host(() => runtime.sendMessageToTarget({ source: "j04-epoch" }, { text: "after reload" }))
  const owned = try Effect.try(() => runtime.getPluginOwnership("j04-epoch")?.messageConnectors.map((connector) => connector.source))
  const reloaded = [unloaded, runtime.actions.filter((action) => action.name.startsWith("J04_EPOCH_")).map((action) => action.description), owned]

  const lazy = probe("j04-lazy", () => pause(30))
  const observerFailure = new Error("j04 observer failed")
  try Effect.try(() => runtime.registerEvent(EventType.SERVICE_STARTED, async (payload) => {
    if ((payload as { serviceType?: string }).serviceType === "j04-lazy") throw observerFailure
  }))
  try host(() => runtime.registerService(lazy.Probe))
  const [first, second] = try all([host(() => runtime.getServiceLoadPromise("j04-lazy")), host(() => runtime.getServiceLoadPromise("j04-lazy"))], { concurrency: "unbounded" })
  const brokenA = probe("j04-broken", async () => {
    throw new Error("j04 broken A")
  })
  const brokenB = probe("j04-broken", async () => {
    throw new Error("j04 broken B")
  })
  try all([
    host(() => runtime.registerPlugin({ name: "j04-broken-a", description: "j04", services: [brokenA.Probe] })),
    host(() => runtime.registerPlugin({ name: "j04-broken-b", description: "j04", services: [brokenB.Probe] })),
  ], { concurrency: "unbounded" })
  const loadFailure = try Effect.flip(host(() => runtime.getServiceLoadPromise("j04-broken")))
  const causes = ((loadFailure as { cause?: { errors?: Array<{ cause?: { message?: string } }> } }).cause?.errors ?? []).map((error) => error.cause?.message)
  const acquired = [
    lazy.record.starts,
    first === second,
    runtime.getService("j04-lazy") === first,
    reported("AgentRuntime.serviceStartedObserver"),
    (loadFailure as Error).message,
    causes,
  ]

  const sendGate = { entered: Promise.withResolvers<void>(), release: Promise.withResolvers<void>() }
  const relayPlugin = (name: string, tag: string, gate?: { entered: PromiseWithResolvers<void>; release: Promise<void> }): Plugin => ({ name, description: "j04", init: (_config, owner) => {
    owner.registerMessageConnector({ source: "j04-relay", sendHandler: relay(tag, gate) })
  } })
  try host(() => runtime.registerPlugin(relayPlugin("j04-relay-a", "A", { entered: sendGate.entered, release: sendGate.release.promise })))
  const admitted = try forkChild(host(() => runtime.sendMessageToTarget({ source: "j04-relay" }, { text: "admitted" })))
  try host(() => sendGate.entered.promise)
  try host(() => runtime.unloadPlugin("j04-relay-a"))
  try host(() => runtime.registerPlugin(relayPlugin("j04-relay-b", "B")))
  sendGate.release.resolve()
  try Fiber.join(admitted)
  try host(() => runtime.sendMessageToTarget({ source: "j04-relay" }, { text: "next" }))

  const blocked = Promise.withResolvers<void>()
  const hookEntered = Promise.withResolvers<void>()
  let firstHookCalls = 0
  const tagResult = (tag: string) => (_owner: IAgentRuntime, ctx: PipelineHookContext) => {
    if (ctx.phase === "post_model") (ctx.result.current as string[]).push(tag)
  }
  runtime.registerPipelineHook({ id: "j04-first", phase: "post_model", position: 0, handler: async (owner, ctx) => {
    tagResult("first")(owner, ctx)
    firstHookCalls += 1
    if (firstHookCalls === 1) {
      hookEntered.resolve()
      await blocked.promise
    }
  } })
  runtime.registerPipelineHook({ id: "j04-second", phase: "post_model", position: 1, handler: tagResult("old") })
  const modelCall = () => ({ phase: "post_model" as const, requestedModelType: "TEXT_SMALL", resolvedModelKey: "TEXT_SMALL", params: {}, durationMs: 0, result: { current: [] as string[] } })
  const running = modelCall()
  const inFlight = try forkChild(host(() => runtime.applyPipelineHooks("post_model", running)))
  try host(() => hookEntered.promise)
  runtime.registerPipelineHook({ id: "j04-second", phase: "post_model", position: 1, handler: tagResult("new") })
  runtime.registerPipelineHook({ id: "j04-failing", phase: "pre_model", handler: async () => {
    throw new Error("j04 pre_model hook failed")
  } })
  try host(() => runtime.applyPipelineHooks("pre_model", { phase: "pre_model", requestedModelType: "TEXT_SMALL", resolvedModelKey: "TEXT_SMALL", params: {} }))
  blocked.resolve()
  try Fiber.join(inFlight)
  const next = modelCall()
  try host(() => runtime.applyPipelineHooks("post_model", next))
  const dispatched = [running.result.current, next.result.current, reported("AgentRuntime.pipelineHook")]

  const pluginAdapter = try Effect.try(() => new SqliteAdapter(store, "plugin"))
  const migrationFailure = new Error("j04 migration plugin failed")
  const adapterFailure = try Effect.flip(host(() => runtime.registerPlugin({ name: "j04-adapter", description: "j04", schema: { j04_notes: { id: "text" } }, init: async () => {
    runtime.registerDatabaseAdapter(pluginAdapter)
    await runtime.runPluginMigrations()
    throw migrationFailure
  } })))
  const closedByCore = [...store.closeLog]
  try host(() => pluginAdapter.close())
  const adapterKept = [
    adapterFailure === migrationFailure,
    runtime.adapter === hostAdapter,
    (hostAdapter as SqliteAdapter).migrations.map((entry) => [entry.member, (entry.args[0] as Array<{ name: string }>).map((plugin) => plugin.name)]),
    closedByCore,
  ]

  const builder = createService("j04-built")
  const built: { A?: ServiceClass & (new (owner?: IAgentRuntime) => Service); B?: ServiceClass & (new (owner?: IAgentRuntime) => Service) } = {}
  builder.withDescription("first").withStart(async (owner) => Object.assign(new built.A!(owner), { madeBy: "first closure" }))
  const A = builder.build()
  built.A = A
  builder.withDescription("second").withStart(async (owner) => Object.assign(new built.B!(owner), { madeBy: "second closure" }))
  const B = builder.build()
  built.B = B
  const unstarted = createService("j04-unstarted").build()
  try host(() => runtime.registerPlugin({ name: "j04-builder", description: "j04", services: [A, B, unstarted] }))
  try host(() => runtime.getServiceLoadPromise("j04-built"))
  const builtInstances = runtime.getServicesByType("j04-built") as Array<Service & { madeBy?: string }>
  const unstartedFailure = try Effect.flip(host(() => runtime.getServiceLoadPromise("j04-unstarted")))
  const stoppedQuietly = try host(() => builtInstances[0].stop())
  const builderRun = [
    builtInstances.map((instance) => [instance.capabilityDescription, instance.madeBy]),
    Reflect.set(A, "serviceType", "j04-renamed"),
    A.serviceType,
    ((unstartedFailure as { cause?: { errors?: Array<{ cause?: Error }> } }).cause?.errors ?? []).map((error) => error.cause?.message),
    stoppedQuietly,
  ]

  const guardedHooks: unknown[] = []
  for (const [index, next] of [undefined, null, "callable"].entries()) {
    const serviceType = `j04-class-hook-${index}`
    const service = probe(serviceType, async () => {})
    const called = { receiver: false, owner: false }
    const replacement = async function (this: unknown, owner: IAgentRuntime) {
      called.receiver = this === service.Probe
      called.owner = owner === runtime
    }
    const observed = try changingMethod(service.Probe, "stopRuntime", next === "callable" ? replacement : next)
    try host(() => runtime.registerPlugin({ name: serviceType, description: "j04", init: async (_config, owner) => { await owner.registerService(service.Probe) } }))
    try host(() => runtime.getServiceLoadPromise(serviceType))
    const failure = try host(() => runtime.unloadPlugin(serviceType).then(() => undefined, (error: unknown) => error))
    guardedHooks.push([failure instanceof AggregateError && failure.errors.length === 1 && failure.errors[0] instanceof TypeError, observed, called, service.record.stops])
  }

  const guardedAdapters: unknown[] = []
  for (const [index, member] of ["close", "stop"].entries()) {
    const name = `j04-adapter-hook-${index}`
    const candidate = try Effect.try(() => new AgentRuntime({ character: createCharacter({ name }) }))
    const adapter = try Effect.try(() => new SqliteAdapter(store, name))
    if (member === "stop") try Effect.try(() => Object.defineProperty(adapter, "close", { configurable: true, value: undefined }))
    const observed = try changingMethod(adapter, member, index === 0 ? undefined : null)
    const initError = new Error(name)
    const failure = try Effect.flip(host(() => candidate.registerPlugin({ name, description: "j04", init: async () => {
      candidate.registerDatabaseAdapter(adapter)
      throw initError
    } })))
    guardedAdapters.push([failure === initError, observed, candidate.adapter === adapter, candidate.getRecentReportedErrors().some((entry) => entry.scope === "PluginLifecycle.registrationRollback" && entry.context?.plugin === name)])
    try Effect.try(() => { Reflect.deleteProperty(adapter, "close"); Reflect.deleteProperty(adapter, "stop") })
    if (!candidate.adapter) candidate.registerDatabaseAdapter(adapter)
    try host(() => candidate.initialize({ skipMigrations: true }))
    try host(() => candidate.stop())
    try host(() => candidate.close())
  }

  const guardedConfigs: unknown[] = []
  for (const [index, next] of [undefined, null].entries()) {
    const name = `j04-config-hook-${index}`
    const plugin: Plugin = { name, description: "j04", actions: [{ ...incumbent, name: name.toUpperCase() }] }
    const observed = try changingMethod(plugin, "applyConfig", next)
    try host(() => runtime.registerPlugin(plugin))
    const failure = try host(() => runtime.applyPluginConfig(name, {}).then(() => undefined, (error: unknown) => error))
    guardedConfigs.push([failure instanceof TypeError, observed])
    try host(() => runtime.unloadPlugin(name))
  }
  try Effect.try(() => assert.deepStrictEqual([guardedHooks, guardedAdapters, guardedConfigs], [
    [
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }, { receiver: false, owner: false }, 1],
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }, { receiver: false, owner: false }, 1],
      [false, { reads: 2, totalReads: 2, cachedCalls: 0 }, { receiver: true, owner: true }, 1],
    ],
    [
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }, true, true],
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }, true, true],
    ],
    [
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
    ],
  ]))

  // spec/core/plugins.md, "Cleanup removes only owned contributions"; spec/core/index.md, "Compatibility translates asynchronous results without losing failures"
  const guardedInitialization: unknown[] = []
  for (const mode of ["missing", "callable", "config-error"] as const) {
    const events: string[] = []
    const captured: { firstCalls: number; receiver: boolean; owner: boolean; config?: Record<string, string>; presentAtDispose: boolean } = { firstCalls: 0, receiver: false, owner: false, presentAtDispose: false }
    const plugin: Plugin = { name: `j04-init-${mode}`, description: "j04", dispose: async () => { events.push("dispose"); captured.presentAtDispose = runtime.plugins.includes(plugin) } }
    let initReads = 0
    const callback = async function (this: unknown, config: Record<string, string>, owner: IAgentRuntime) {
      events.push("called")
      captured.receiver = this === plugin
      captured.owner = owner === runtime
      captured.config = config
    }
    const invalidConfig = try Effect.try(() => { const pair = Proxy.revocable({ VALUE: "unused" }, {}); pair.revoke(); return pair.proxy })
    try Effect.try(() => {
      Object.defineProperty(plugin, "init", { get: () => { events.push("init"); initReads += 1; return initReads === 1 ? async () => { captured.firstCalls += 1 } : mode === "missing" ? undefined : callback } })
      Object.defineProperty(plugin, "config", { get: () => { events.push("config"); return mode === "config-error" ? invalidConfig : { VALUE: { toString() { events.push("value"); return "2" } } } } })
    })
    const failure = try host(() => runtime.registerPlugin(plugin).then(() => undefined, (error: unknown) => error))
    if (mode === "callable") try host(() => runtime.unloadPlugin(plugin.name))
    guardedInitialization.push([failure instanceof TypeError, events, captured])
  }
  const guardedMigrations: unknown[] = []
  for (const next of [undefined, null]) {
    const observed = try changingMethod(hostAdapter, "runMigrations", next)
    const failure = try host(() => runtime.runMigrations(["j04-migrations"]).then(() => undefined, (error: unknown) => error))
    guardedMigrations.push([failure instanceof TypeError, observed])
    try Effect.try(() => Reflect.deleteProperty(hostAdapter, "runMigrations"))
  }
  const replacementAdapter = try Effect.try(() => new SqliteAdapter(store, "j04-migration-receiver"))
  let adapterReads = 0
  let oldReceiverCalls = 0
  const firstMigration = async () => { oldReceiverCalls += 1 }
  try Effect.try(() => Object.defineProperty(hostAdapter, "runMigrations", { configurable: true, get: () => { adapterReads += 1; runtime.adapter = replacementAdapter; return firstMigration } }))
  try host(() => runtime.runMigrations(["j04-receiver"]))
  const migrationReceiver = [adapterReads, oldReceiverCalls, replacementAdapter.migrations.map((entry) => [entry.member, entry.args])]
  try Effect.try(() => Reflect.deleteProperty(hostAdapter, "runMigrations"))
  runtime.adapter = hostAdapter
  try host(() => replacementAdapter.close())
  try Effect.try(() => assert.deepStrictEqual([guardedInitialization, guardedMigrations, migrationReceiver], [
    [
      [true, ["init", "config", "config", "value", "init", "dispose"], { firstCalls: 0, receiver: false, owner: false, presentAtDispose: false }],
      [false, ["init", "config", "config", "value", "init", "called", "dispose"], { firstCalls: 0, receiver: true, owner: true, config: { VALUE: "2" }, presentAtDispose: true }],
      [true, ["init", "config", "config", "dispose"], { firstCalls: 0, receiver: false, owner: false, presentAtDispose: true }],
    ],
    [
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
      [true, { reads: 2, totalReads: 2, cachedCalls: 0 }],
    ],
    [1, 0, [["runMigrations", [["j04-receiver"]]]]],
  ]))

  for (let waited = 0; runtime.getService("j04-eager") === null && waited < 20_000; waited += 100) try sleep(100)
  const eagerRun = [
    eager.record.starts,
    attempts.slice(1).map((attempt, index) => {
      const gap = attempt.startedAt - (attempts[index].rejectedAt ?? Infinity)
      return gap >= [2_000, 5_000][index] && gap < [5_000, 10_000][index]
    }),
    runtime.getService("j04-eager") === eager.record.instances[0],
  ]

  const lateGate = Promise.withResolvers<void>()
  const lateEntered = Promise.withResolvers<void>()
  const late = probe("j04-late", async () => {
    lateEntered.resolve()
    await lateGate.promise
  })
  try host(() => runtime.registerPlugin({ name: "j04-late", description: "j04", services: [late.Probe] }))
  try host(() => lateEntered.promise)
  const unloading = try forkChild(host(() => runtime.unloadPlugin("j04-late")))
  const stopping = try forkChild(host(() => runtime.stop()))
  try sleep(50)
  lateGate.resolve()
  try Fiber.join(unloading)
  try Fiber.join(stopping)
  const retired = [
    [late, lazy, eager, slow].map((service) => [service.record.instances.length, service.record.stops]),
    ["j04-late", "j04-lazy", "j04-eager", "j04-built"].map((serviceType) => runtime.getService(serviceType)),
    reported("AgentRuntime.serviceStart").filter(([, type]) => type === "j04-late"),
  ]

  try Effect.try(() => assert.deepStrictEqual([joined, rolledBack, reloaded, acquired, delivered, dispatched, adapterKept, builderRun, eagerRun, retired], [
    [[true, true], ["init", "caller 0", "caller 1", "init"], 2, 1],
    [true, ["incumbent"], 1, 1, null, false],
    ["j04-epoch", ["TWO"], ["j04-epoch"]],
    [
      1,
      true,
      true,
      [["j04 observer failed", "j04-lazy"]],
      "Service j04-broken not found or failed to start",
      ["j04 broken A", "j04 broken B"],
    ],
    [["TWO", "after reload"], ["A", "admitted"], ["B", "next"]],
    [["first", "old"], ["first", "new"], [["j04 pre_model hook failed", "j04-failing"]]],
    [true, true, [["runPluginMigrations", ["j04-adapter"]]], []],
    [[["first", "first closure"], ["second", "second closure"]], false, "j04-built", ["Start function not defined for service j04-unstarted"], undefined],
    [3, [true, true], true],
    [[[1, 1], [1, 1], [1, 1], [1, 1]], [null, null, null, null], [["Runtime stop requested while service j04-late was starting", "j04-late"]]],
  ]))
}, 120_000)

// spec/core/storage.md, "Story: Publish complete immutable source revisions"; spec/core/storage.md, "Every page read checks current authorization and expected revision"; spec/core/storage.md, "Story: Preserve storage compatibility without hiding unsupported operations"; spec/core/storage.md, "A stale or malformed revision, or invalid pagination, exposes no page"; spec/core/ingressSnapshots.md, "Story: Preserve a durable original through prompt-only augmentation"; spec/core/authorization.md, "Story: Read only the authorized records"; spec/core/embeddingSpace.md, "Story: Keep stored vectors in their verified representation"; spec/core/embeddingSpace.md, "A probe prepares dimensions and representation before pinning"; spec/core/embeddingService.md, "Story: Activate once and retain every distinct source snapshot"; spec/core/embeddingService.md, "Initialization has one shared promise and a failed activation can retry"; spec/core/batchQueue.md, "A batched call settles successful items before retrying failures"; spec/core/factWrites.md, "Story: Merge every contribution once into its canonical fact"; spec/core/privacy.md, "Story: Publish scrub completion only after durable privacy work"; spec/core/privacy.md, "A marker follows successful scrub and persisted pseudonym assignments"; spec/core/privacyService.md, "Story: Share service startup while keeping independent scrub attempts"; spec/core/ingressSnapshots.md, "Reuse requires exact redacted content and every projected stored segment"; spec/core/secretSession.md, "Story: Restore known placeholders while keeping credentials out of replies"
it.live("Remember segmented messages, embeddings, facts and privacy (spec/core/storage.md, \"Story: Publish complete immutable source revisions\")", () => effect {
  try withEnv({ SECRET_SALT: "j05-pseudonym-map-salt" })
  class People extends Service {
    static serviceType = "eliza_knowledge_graph"
    capabilityDescription = "People the host knows"
    static async start(runtime: IAgentRuntime): Promise<Service> {
      return new People(runtime)
    }
    async stop(): Promise<void> {}
    getEntityStore() {
      return {
        resolve: async (query: { name?: string }) => query.name === "Priya Raman"
          ? [{ entity: { entityId: "priya", type: "person", preferredName: "Priya Raman", identities: [] }, confidence: 0.99, evidence: ["j05-roster"] }]
          : [],
      }
    }
  }
  const services: Plugin = { name: "j05-host", description: "Host services of the remember journey", services: [EmbeddingGenerationService, PiiScrubService, People] }
  const runtime = try kernel({ plugins: [services], character: { settings: { secrets: { OPENAI_API_KEY: "sk-j05-configured-credential" } } } })
  const adapter = runtime.adapter as SqliteAdapter
  const agentId = runtime.agentId
  const worldId = stringToUuid("j05-world")
  const roomId = stringToUuid("j05-room")
  const reader = stringToUuid("j05-reader")
  const other = stringToUuid("j05-other")
  for (const entityId of [reader, other]) {
    try host(() => runtime.ensureConnection({ entityId, roomId, worldId, channelId: "j05", source: "test", type: ChannelType.GROUP, userName: entityId }))
  }
  const failure = (f: () => unknown) => effect {
    const outcome = try exit(host(async () => f()))
    if (Exit.isSuccess(outcome)) return { name: "resolved", code: undefined, message: undefined }
    const error = Cause.squash(outcome.cause) as { name?: string; code?: string; message?: string }
    return { name: error.name, code: error.code, message: error.message }
  }
  const until = (check: () => Promise<boolean> | boolean) => effect {
    for (let attempt = 0; attempt < 500; attempt++) {
      if (try host(async () => check())) return
      try sleep("10 millis")
    }
    try die(new Error("j05: condition did not hold within 5 s"))
  }
  const fixture = <A>(f: () => A) => Effect.orDie(Effect.try(f))
  const drain = (name: string) => effect {
    const [task] = try host(() => runtime.getTasksByName(name))
    const worker = runtime.getTaskWorker(name)
    if (task && worker) try host(() => worker.execute(runtime, {}, task))
  }
  const page = (messageId: UUID, offset: number, expectedRevision?: string, limit = MESSAGE_CONTENT_SEGMENT_MAX_BYTES) =>
    host(() => adapter.readMessageContentRange({
      agentId,
      messageId,
      authorizedRoomId: roomId,
      accessContext: { requesterEntityId: reader, role: "USER" },
      source: { kind: "message-text" },
      offset,
      limit,
      expectedRevision,
    }))
  const readAll = (messageId: UUID) => effect {
    const pieces: string[] = []
    let offset = 0
    let total = 1
    let revision: string | undefined
    while (offset < total) {
      const read = try page(messageId, offset, revision)
      if (read.status !== "ok") return read.status
      pieces.push(read.page.text)
      offset = read.page.end
      total = read.page.total
      revision = read.page.revision
    }
    return pieces.join("")
  }

  const text = `\uFEFF${"complete 🙂עברית漢字é\n".repeat(8_000)}FINAL EVIDENCE`
  const messageId = stringToUuid("j05-long-message")
  const message: Memory = { id: messageId, agentId, entityId: reader, roomId, content: { text }, metadata: { type: "message", scope: "room" } }
  try host(() => runtime.createMessageMemory(message))
  const parent = try host(() => runtime.getMemoryById(messageId))
  const descriptor = parent?.content.messageTextSource as { storage?: string; byteLength?: number; segmentCount?: number } | undefined
  const segments = try host(() => runtime.getMemoriesByIds(collectMessageContentSegmentIds(messageId, parent?.content ?? {}), MESSAGE_CONTENT_SEGMENT_TABLE))
  const published = {
    parentFields: Object.keys(parent?.content ?? {}),
    storage: descriptor?.storage,
    byteLength: descriptor?.byteLength,
    segmentCount: descriptor?.segmentCount,
    storedSegments: segments.length,
    whole: try readAll(messageId),
  }

  // spec/core/ingressSnapshots.md, "Story: Preserve a durable original through prompt-only augmentation"
  const replayed = try host(() => persistIncomingMessageMemory(runtime, { ...message, content: { text } }))
  const collided = try failure(() => persistIncomingMessageMemory(runtime, { ...message, content: { text: `${text}!` } }))
  const routed: Memory = { ...message, content: { text } }
  bindIncomingMessagePersistence(routed, parent as Memory)
  const augmented: Memory = { ...routed, content: { text: `[recent context]\n${text}` } }
  inheritIncomingMessagePersistence(routed, augmented)
  augmented.content.text = "[prompt only]"
  const snapshot = incomingMessagePersistenceSnapshot(augmented)
  augmented.roomId = other
  const moved = try failure(() => incomingMessagePersistenceSnapshot(augmented))
  const ingress = {
    replayed,
    collided,
    snapshot,
    unbound: incomingMessagePersistenceSnapshot({ ...message }),
    moved,
    stored: try host(() => runtime.getMemoryById(messageId)),
  }

  // spec/core/storage.md, "Every page read checks current authorization and expected revision"; spec/core/storage.md, "A stale or malformed revision, or invalid pagination, exposes no page"
  const replacement = "second revision 漢字\n".repeat(9_000)
  const before = try page(messageId, 0)
  try host(() => runtime.replaceMessageMemoryContent(messageId, { text: replacement }))
  const replaced = try readAll(messageId)
  const current = try page(messageId, 0)
  try host(() => runtime.deleteParticipants([{ entityId: reader, roomId }]))
  const revoked = try page(messageId, current.status === "ok" ? current.page.end : 0, current.status === "ok" ? current.page.revision : undefined)
  const pages = {
    revisionChanged: before.status === "ok" && current.status === "ok" && before.page.revision !== current.page.revision,
    replaced,
    revoked,
    negative: [try failure(() => runtime.queryEntities({ limit: -1 })), try failure(() => runtime.getTasks({ offset: -1 }))],
  }

  try Effect.try(() => assert.deepStrictEqual({ published, ingress, pages }, {
    published: {
      parentFields: ["messageTextSource"],
      storage: "segments",
      byteLength: new TextEncoder().encode(text).length,
      segmentCount: Math.ceil(new TextEncoder().encode(text).length / MESSAGE_CONTENT_SEGMENT_MAX_BYTES),
      storedSegments: Math.ceil(new TextEncoder().encode(text).length / MESSAGE_CONTENT_SEGMENT_MAX_BYTES),
      whole: text,
    },
    ingress: {
      replayed: messageId,
      collided: { name: "ElizaError", code: "MESSAGE_CONTENT_PUBLICATION_CONFLICT", message: "Incoming message id is bound to different or incomplete content" },
      snapshot: parent,
      unbound: undefined,
      moved: { name: "ElizaError", code: "MESSAGE_CONTENT_PUBLICATION_CONFLICT", message: "Ingress persistence snapshot identity changed" },
      stored: parent,
    },
    pages: {
      revisionChanged: true,
      replaced: replacement,
      revoked: { status: "forbidden" },
      negative: [
        { name: "RangeError", code: undefined, message: "queryEntities limit must be a non-negative safe integer" },
        { name: "RangeError", code: undefined, message: "getTasks offset must be a non-negative safe integer" },
      ],
    },
  }))

  // spec/core/authorization.md, "Story: Read only the authorized records"; spec/core/storage.md, "Story: Preserve storage compatibility without hiding unsupported operations"
  const eighths = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => n / 8)
  const note = (id: string, author: UUID, scope: string, embedding: number[]): Memory => ({ id: stringToUuid(id), agentId, entityId: author, roomId, content: { text: id }, embedding, metadata: { type: "custom", scope } as Memory["metadata"] })
  for (const memory of [
    note("j05-reader-private", reader, "private", [1, 1, 0, 0, 0, 0, 0, 0].map((n) => n / 8)),
    note("j05-other-private", other, "private", eighths),
    note("j05-other-shared", other, "shared", [1, 0, 0, 0, 0, 0, 0, 1].map((n) => n / 8)),
  ]) {
    try host(() => runtime.createMemory(memory, "notes"))
  }
  const search = (accessContext?: { requesterEntityId: UUID; role: "USER" }) => effect {
    const found = try host(() => runtime.searchMemories({ tableName: "notes", embedding: eighths, accessContext }))
    return found.map((memory) => memory.content.text)
  }
  const recalled = {
    trusted: try search(),
    reader: try search({ requesterEntityId: reader, role: "USER" }),
    unsupported: try failure(() => adapter.compareAndSwapMemoryPublication({} as never)),
  }
  try Effect.try(() => assert.deepStrictEqual(recalled, {
    trusted: ["j05-other-private", "j05-other-shared", "j05-reader-private"],
    reader: ["j05-other-shared", "j05-reader-private"],
    unsupported: { name: "ElizaError", code: "CONTENT_CONTINUITY_ATOMIC_PUBLICATION_UNSUPPORTED", message: "Atomic memory publication is unsupported by this adapter" },
  }))

  // spec/core/embeddingService.md, "Initialization has one shared promise and a failed activation can retry"
  const vector = () => identifyEmbeddingVector([...eighths], "test:j05-eighths")
  const registrationFailures = () => runtime.getRecentReportedErrors().filter((report) => report.scope === "AgentRuntime.registerModel").map((report) => report.message)
  const activation = () => effect {
    const drains = try host(() => runtime.getTasksByName("EMBEDDING_DRAIN"))
    return { failures: registrationFailures(), drains: drains.length, handlers: runtime.getEvent(EventType.EMBEDDING_GENERATION_REQUESTED)?.length ?? 0 }
  }
  try fixture(() => adapter.fault("createTasks", { reject: new Error("transient task-store outage") }))
  const firstModel = try fixture(() => scriptedModels("j05-first", 10, { [ModelType.TEXT_EMBEDDING]: [{ reply: vector }] }))
  try fixture(() => firstModel.register(runtime))
  try until(() => registrationFailures().length === 1)
  const failed = try activation()
  const secondModel = try fixture(() => scriptedModels("j05-second", 10, { [ModelType.TEXT_EMBEDDING]: [{ reply: vector }] }))
  const thirdModel = try fixture(() => scriptedModels("j05-third", 10, { [ModelType.TEXT_EMBEDDING]: [{ reply: vector }] }))
  try fixture(() => {
    secondModel.register(runtime)
    thirdModel.register(runtime)
  })
  try until(async () => (await runtime.getTasksByName("EMBEDDING_DRAIN")).length === 1)
  const retried = try activation()

  // spec/core/embeddingSpace.md, "A probe prepares dimensions and representation before pinning"
  const embeddingCalls = () => [...firstModel.seen, ...secondModel.seen, ...thirdModel.seen]
  const gate = Promise.withResolvers<void>()
  try fixture(() => adapter.fault("ensureEmbeddingSpace", { gate: gate.promise }))
  const first = try forkChild(host(() => runtime.ensureEmbeddingDimension()))
  const second = try forkChild(host(() => runtime.ensureEmbeddingDimension()))
  const asked = try forkChild(host(() => runtime.useModel(ModelType.TEXT_EMBEDDING, { text: "recall this complete request" })))
  try until(() => embeddingCalls().length >= 2)
  try sleep("50 millis")
  const waitingForPin = [first, second, asked].map((fiber) => fiber.pollUnsafe() === undefined)
  gate.resolve()
  const answer = try Fiber.join(asked)
  try Fiber.join(first)
  try Fiber.join(second)
  const pinned = {
    waitingForPin,
    space: getEmbeddingVectorSpace(answer),
    vector: [...answer],
    probes: embeddingCalls().filter((call) => call.params === null).length,
  }

  // spec/core/batchQueue.md, "A batched call settles successful items before retrying failures"
  const batchModel = try fixture(() => scriptedModels("j05-first", 10, { [ModelType.TEXT_EMBEDDING_BATCH]: [{ fail: new Error("actual provider batch failure") }] }))
  try fixture(() => batchModel.register(runtime))
  const batchTexts = ["retained text one", "retained text two"]
  const changedText = "retained text one, changed"
  const batchIds = batchTexts.map((text) => stringToUuid(text))
  for (const [index, id] of batchIds.entries()) {
    const memory: Memory = { id, agentId, entityId: reader, roomId, content: { text: batchTexts[index] } }
    try host(() => runtime.createMemory(memory, "notes"))
    try host(() => runtime.queueEmbeddingGeneration(memory, "high"))
  }
  // spec/core/embeddingService.md, "Story: Activate once and retain every distinct source snapshot"
  try host(() => runtime.queueEmbeddingGeneration({ id: batchIds[0], agentId, entityId: reader, roomId, content: { text: changedText } }, "high"))
  const embedded = () => effect {
    const rows = try host(() => runtime.getMemoriesByIds(batchIds, "notes"))
    return rows.length === batchIds.length && rows.every((row) => row.embedding?.length === eighths.length)
  }
  for (let attempt = 0; attempt < 50 && !(try embedded()); attempt++) try drain("EMBEDDING_DRAIN")
  const outcomes = try host(() => runtime.getLogs({ type: "embedding_event" }))
  const textOf = (params: unknown) => (params as { text?: string; texts?: string[] } | null)
  const batched = {
    embedded: try embedded(),
    primaryBatches: batchModel.seen.filter((call) => batchTexts.every((text) => textOf(call.params)?.texts?.includes(text))).length,
    singles: [batchTexts[0], changedText, batchTexts[1]].map((text) => embeddingCalls().filter((call) => textOf(call.params)?.text === text).length),
    persisted: batchIds.map((id) => outcomes.filter((log) => (log.body as { memoryId?: string }).memoryId === id).map((log) => String((log.body as { status?: string }).status)).sort()),
    batchFailureReported: runtime.getRecentReportedErrors().some((report) => report.scope === "BatchQueue.processBatch" && report.message === "actual provider batch failure"),
  }

  // spec/core/embeddingSpace.md, "Story: Keep stored vectors in their verified representation"
  const relabelModel = try fixture(() => scriptedModels("j05-relabel", 0, { [ModelType.TEXT_EMBEDDING]: [{ reply: () => identifyEmbeddingVector([...eighths], "test:j05-relabelled") }] }))
  try fixture(() => relabelModel.register(runtime))
  const relabelled = try failure(() => runtime.useModel(ModelType.TEXT_EMBEDDING, { text: "relabel" }, "j05-relabel"))
  try Effect.try(() => assert.deepStrictEqual({ failed, retried, pinned, batched, relabelled }, {
    failed: { failures: ["transient task-store outage"], drains: 0, handlers: 0 },
    retried: { failures: ["transient task-store outage"], drains: 1, handlers: 1 },
    pinned: { waitingForPin: [true, true, true], space: "test:j05-eighths", vector: eighths, probes: 1 },
    batched: { embedded: true, primaryBatches: 1, singles: [1, 1, 1], persisted: [["completed", "discarded_stale_source"], ["completed"]], batchFailureReported: true },
    relabelled: { name: "ElizaError", code: "EMBEDDING_SPACE_MISMATCH", message: "Embedding provider returned a different or unidentified representation" },
  }))

  // spec/core/factWrites.md, "Story: Merge every contribution once into its canonical fact"; spec/core/factWrites.md, "One writer owns the read and commit interval"
  const writeFact = (id: string, text: string, evidence: string) => runtime.createMemory({ id: stringToUuid(id), agentId, entityId: reader, roomId, content: { text }, metadata: { type: "custom", extractionEvidenceIds: [evidence] } as Memory["metadata"] }, "facts")
  const fact = (id: string, text: string, evidence: string) => host(() => writeFact(id, text, evidence))
  const merged = try all([fact("j05-fact-a", "Balance: -10 USD", "evidence-a"), fact("j05-fact-b", "Balance: -10 USD", "evidence-b")], { concurrency: "unbounded" })
  const credit = try fact("j05-fact-c", "Balance: +10 USD", "evidence-c")
  try fixture(() => adapter.fault("updateMemories", { reject: new Error("fact commit refused") }))
  const refused = try failure(() => writeFact("j05-fact-d", "Balance: -10 USD", "evidence-d"))
  const afterRefusal = try fact("j05-fact-e", "Balance: -10 USD", "evidence-e")
  const facts = try host(() => runtime.getMemories({ roomId, tableName: "facts", count: 10, unique: false }))
  const laterAt = Date.now() + 1
  try host(() => adapter.createMemories(Array.from({ length: 150 }, (_, index) => ({ tableName: "facts", memory: { id: stringToUuid(`j05-later-fact-${index}`), agentId, entityId: reader, roomId, createdAt: laterAt + index, content: { text: `Later fact ${index}` } } }))))
  const beyondRecent = try fact("j05-fact-f", "Balance: -10 USD", "evidence-f")

  // spec/core/ingressSnapshots.md, "Reuse requires exact redacted content and every projected stored segment"
  const rawSecret = "here is my token ghp_1234567890abcdefghijklmnopqrstuvwxyzAB and key sk-j05-configured-credential, thanks"
  const secretId = try host(() => runtime.createMessageMemory({ id: stringToUuid("j05-secret"), agentId, entityId: reader, roomId, content: { text: rawSecret } }))
  const secret = try host(() => runtime.getMemoryById(secretId))
  const secretReplay = try host(() => persistIncomingMessageMemory(runtime, { id: secretId, agentId, entityId: reader, roomId, content: { text: rawSecret } }))
  try Effect.try(() => assert.deepStrictEqual({
    merged,
    credit,
    refused,
    afterRefusal,
    beyondRecent,
    facts: facts.map((row) => [row.id, row.content.text, (row.metadata as { extractionEvidenceIds?: string[] }).extractionEvidenceIds]),
    stored: secret?.content.text,
    secretReplay,
  }, {
    merged: [stringToUuid("j05-fact-a"), stringToUuid("j05-fact-a")],
    credit: stringToUuid("j05-fact-c"),
    refused: { name: "Error", code: undefined, message: "fact commit refused" },
    afterRefusal: stringToUuid("j05-fact-a"),
    beyondRecent: stringToUuid("j05-fact-a"),
    facts: [
      [stringToUuid("j05-fact-c"), "Balance: +10 USD", ["evidence-c"]],
      [stringToUuid("j05-fact-a"), "Balance: -10 USD", ["evidence-a", "evidence-b", "evidence-e"]],
    ],
    stored: "here is my token ghp_12…yzAB and key [REDACTED:OPENAI_API_KEY], thanks",
    secretReplay: secretId,
  }))

  // spec/core/privacy.md, "A marker follows successful scrub and persisted pseudonym assignments"; spec/core/privacyService.md, "Each processor attempt preserves its own marker and retry ownership"; spec/core/privacyService.md, "Stop captures lazy startup, flushes eligible work and finalizes its own promise"
  const ruleset = "j05-ruleset-1"
  const contents = ["Priya Raman wrote the first note", "Priya Raman wrote the second note"]
  const urgent = "Priya Raman wrote the urgent note"
  const scrubModel = try fixture(() => scriptedModels("j05-scrub", 10, {
    [ModelType.PII_SCRUB]: [{
      reply: (params) => ({
        modelId: "j05-scrubber",
        rulesetVersion: ruleset,
        verdicts: (params as { candidateSpans: string[] }).candidateSpans.map((span) => ({ span, kind: "pii", replacement: "[person]" })),
      }),
    }],
  }))
  try fixture(() => scrubModel.register(runtime))
  const pseudonyms = try Effect.orDie(Effect.try(() => new EncryptedCachePseudonymMapStore(runtime)))
  const completions: Array<{ content: string; marked: boolean; clusters: string[]; renamed: boolean }> = []
  try Effect.orDie(Effect.try(() => runtime.registerEvent(EventType.PII_SCRUB_COMPLETED, async (payload) => {
    const { content } = payload as { content: string }
    const map = await pseudonyms.load()
    completions.push({
      content,
      marked: await isScrubDone(runtime, content, ruleset),
      clusters: (map?.clusters ?? []).map((cluster) => cluster.clusterId),
      renamed: (map?.clusters ?? []).every((cluster) => cluster.pseudonym.length > 0 && cluster.pseudonym !== "Priya Raman"),
    })
  })))
  const request = (content: string, priority: "high" | "normal") =>
    host(() => runtime.emitEvent(EventType.PII_SCRUB_REQUESTED, { runtime, content, rulesetVersion: ruleset, candidateSpans: ["Priya Raman"], priority, itemRef: content, source: "j05" }))
  const markers = () => effect {
    const marked = try Effect.forEach(contents, (content) => host(() => isScrubDone(runtime, content, ruleset)))
    return marked.filter(Boolean).length
  }
  try fixture(() => adapter.fault("setCaches", { reject: new Error("cache write refused") }))
  try Effect.forEach(contents, (content) => request(content, "normal"), { concurrency: "unbounded" })
  const scrubDrains = (try host(() => runtime.getTasksByName("PII_SCRUB_DRAIN"))).length
  try drain("PII_SCRUB_DRAIN")
  try until(() => completions.length >= 2)
  const drained = { attempts: scrubModel.seen.length, completions: completions.length, markers: try markers() }
  try request(urgent, "high")
  const queued = runtime.getService<PiiScrubService>("pii-scrub")?.getQueueSize()
  try host(() => runtime.stop())
  const scrubbed = {
    scrubDrains,
    drained,
    attempts: scrubModel.seen.length,
    queued,
    urgentMarked: try host(() => isScrubDone(runtime, urgent, ruleset)),
    completions: [...completions].sort((left, right) => left.content.localeCompare(right.content)),
  }
  const completed = (content: string) => ({ content, marked: true, clusters: ["entity:priya"], renamed: true })
  try Effect.try(() => assert.deepStrictEqual(scrubbed, {
    scrubDrains: 1,
    drained: { attempts: 3, completions: 2, markers: 2 },
    attempts: 4,
    queued: 1,
    urgentMarked: true,
    completions: [completed(contents[0]), completed(contents[1]), completed(urgent)].sort((left, right) => left.content.localeCompare(right.content)),
  }))
}, 120_000)

// spec/core/authorization.md, "Story: Change roles against fresh authority"; spec/core/authorization.md, "A role write captures the target and authority revision"; spec/core/authorization.md, "A concurrent revocation makes the captured role write stale"; spec/core/authorization.md, "A committed role change has fresh authorization and one matching audit row"; spec/core/authorization.md, "Trusted ownership and deliberate grants determine resolved roles"; spec/core/entities.md, "Story: Show only components from authorized sources"; spec/core/entities.md, "Adapter failure cannot become a successful mutation result"; spec/core/settingsKeys.md, "Story: Keep persisted settings decryptable under the selected key"; spec/core/settingsKeys.md, "Recognized ciphertext fails explicitly when authentication or decryption fails"; spec/core/settingsKeys.md, "Production rejects unset and public salts on refresh"; spec/core/channelTopics.md, "Story: Replace a topic service after its admitted work settles"; spec/core/topicService.md, "Story: Retire all room queues before clearing the service cache"; spec/core/memo.md, "Story: Reuse concurrent reads and evict only the matching rejected promise"; spec/core/memo.md, "Live entries expire as monotonic time advances"
it.live("Administer a world: roles, components, settings and topics (spec/core/authorization.md, \"Story: Change roles against fresh authority\"; spec/core/entities.md, \"Story: Show only components from authorized sources\"; spec/core/settingsKeys.md, \"Story: Keep persisted settings decryptable under the selected key\"; spec/core/channelTopics.md, \"Story: Replace a topic service after its admitted work settles\"; spec/core/topicService.md, \"Story: Retire all room queues before clearing the service cache\"; spec/core/memo.md, \"Story: Reuse concurrent reads and evict only the matching rejected promise\")", () => effect {
  const store = try storeAt("eliza-core-j06")
  const runtime = try kernel({ store })
  const adapter = runtime.adapter as SqliteAdapter
  const agentId = runtime.agentId
  const serverId = "j06-guild"
  const worldId = createUniqueUuid(runtime, serverId)
  const ownerId = stringToUuid("j06-owner")
  const actorId = stringToUuid("j06-admin")
  const memberA = stringToUuid("j06-member-a")
  const memberB = stringToUuid("j06-member-b")
  const memberC = stringToUuid("j06-member-c")
  const roomId = stringToUuid("j06-general")
  const lobbyId = stringToUuid("j06-lobby")
  const failure = <A>(f: () => Promise<A>) => Effect.flip(host(f))
  const pending = <A>(f: () => Promise<A>) => sync(() => ({ settled: f() }))
  const fault = (member: string, gate: Promise<void>) => host(async () => adapter.fault(member, { gate }))
  const said = (entityId: UUID, text: string): Memory => ({ id: stringToUuid(`j06-${text}`), entityId, agentId, roomId, content: { text } })
  const authorizedBy = (actor: UUID, target: UUID, role: RoleName) => async (fresh: { world: World | null; metadata: Record<string, unknown> } | null) => {
    if (!fresh?.world) return false
    const [actorRole, targetRole] = await Promise.all([
      resolveEntityRole(runtime, fresh.world, fresh.metadata, actor),
      resolveEntityRole(runtime, fresh.world, fresh.metadata, target),
    ])
    return canModifyRole(actorRole, targetRole, role)
  }
  const change = (actor: UUID, target: UUID, role: RoleName, text: string) =>
    setEntityRoleCas(runtime, said(actor, text), target, role, { worldId, authorize: authorizedBy(actor, target, role) })

  try host(() => runtime.createEntities([
    { id: ownerId, names: ["Owner"], agentId },
    { id: actorId, names: ["Admin"], agentId },
    { id: memberA, names: ["Member A"], agentId },
    { id: memberB, names: ["Member B"], agentId },
    { id: memberC, names: ["Member C"], agentId },
  ]))
  try host(() => runtime.createWorld({
    id: worldId,
    name: "J06 Guild",
    agentId,
    metadata: {
      ownership: { ownerId },
      roles: { [ownerId]: Role.OWNER, [actorId]: Role.ADMIN, [memberA]: Role.MEMBER, [memberB]: Role.MEMBER },
      roleSources: { [ownerId]: "owner", [actorId]: "manual", [memberA]: "manual", [memberB]: "manual" },
    },
  }))
  try host(() => runtime.createRoom({ id: roomId, name: "general", agentId, source: "discord", type: ChannelType.GROUP, worldId }))
  try host(() => runtime.createRoom({ id: lobbyId, name: "lobby", agentId, source: "discord", type: ChannelType.GROUP, worldId }))

  // spec/core/authorization.md, "A concurrent revocation makes the captured role write stale"
  const casGate = Promise.withResolvers<void>()
  const authorizedOnce = Promise.withResolvers<void>()
  const staleAuthorizations: boolean[] = []
  try fault("compareAndSwapWorldMetadata", casGate.promise)
  const stale = try pending(() => setEntityRoleCas(runtime, said(actorId, "promote member a"), memberA, "ADMIN", {
    worldId,
    authorize: async (fresh) => {
      const allowed = await authorizedBy(actorId, memberA, "ADMIN")(fresh)
      staleAuthorizations.push(allowed)
      authorizedOnce.resolve()
      return allowed
    },
  }))
  try host(() => authorizedOnce.promise)
  try sleep("100 millis")
  const revocation = try host(() => change(ownerId, actorId, "GUEST", "revoke admin"))
  casGate.resolve()
  const staleOutcome = try host(() => stale.settled)
  // spec/core/authorization.md, "A committed role change has fresh authorization and one matching audit row"
  const fresh = try host(() => change(ownerId, memberA, "ADMIN", "grant member a"))
  const administered = try host(() => runtime.getWorld(worldId))
  const audit = (try host(() => runtime.getLogs({ type: ROLE_WRITE_AUDIT_LOG_TYPE })))
    .map((row) => row.body.metadata as Record<string, unknown>)
    .sort((left, right) => String(left.newRole).localeCompare(String(right.newRole)))
  try Effect.try(() => assert.deepStrictEqual(
    { revocation, staleAuthorizations, staleOutcome, fresh, roles: administered?.metadata?.roles, roleSources: administered?.metadata?.roleSources, audit },
    {
      revocation: { status: "committed", roles: { [ownerId]: "OWNER", [actorId]: "GUEST", [memberA]: "MEMBER", [memberB]: "MEMBER" } },
      staleAuthorizations: [true, false],
      staleOutcome: { status: "unauthorized" },
      fresh: { status: "committed", roles: { [ownerId]: "OWNER", [actorId]: "GUEST", [memberA]: "ADMIN", [memberB]: "MEMBER" } },
      roles: { [ownerId]: "OWNER", [actorId]: "GUEST", [memberA]: "ADMIN", [memberB]: "MEMBER" },
      roleSources: { [ownerId]: "owner", [memberA]: "manual", [memberB]: "manual" },
      audit: [
        { worldId, actorEntityId: ownerId, targetEntityId: memberA, previousRole: "USER", newRole: "ADMIN", grantSource: "manual", outcome: "committed" },
        { worldId, actorEntityId: ownerId, targetEntityId: actorId, previousRole: "ADMIN", newRole: "GUEST", grantSource: "manual", outcome: "committed" },
      ],
    },
  ))

  // spec/core/authorization.md, "A concurrent revocation makes the captured role write stale"
  const exhaustGate = Promise.withResolvers<void>()
  const exhaustAuthorized = Promise.withResolvers<void>()
  try fault("compareAndSwapWorldMetadata", exhaustGate.promise)
  const exhausting = try pending(() => setEntityRoleCas(runtime, said(ownerId, "exhaust"), memberB, "GUEST", {
    worldId,
    maxAttempts: 1,
    authorize: async (fresh) => {
      const allowed = await authorizedBy(ownerId, memberB, "GUEST")(fresh)
      exhaustAuthorized.resolve()
      return allowed
    },
  }))
  try host(() => exhaustAuthorized.promise)
  try sleep("100 millis")
  const concurrent = try host(() => change(ownerId, actorId, "USER", "restore admin as user"))
  exhaustGate.resolve()
  const exhausted = try host(() => exhausting.settled)
  const afterExhaustion = try host(() => runtime.getWorld(worldId))
  const auditAfterExhaustion = (try host(() => runtime.getLogs({ type: ROLE_WRITE_AUDIT_LOG_TYPE }))).length
  try Effect.try(() => assert.deepStrictEqual(
    { concurrent: concurrent.status, exhausted, auditRows: auditAfterExhaustion - audit.length, roles: afterExhaustion?.metadata?.roles },
    { concurrent: "committed", exhausted: { status: "conflict" }, auditRows: 1, roles: { [ownerId]: "OWNER", [actorId]: "USER", [memberA]: "ADMIN", [memberB]: "MEMBER" } },
  ))

  // spec/core/authorization.md, "Trusted ownership and deliberate grants determine resolved roles"
  const recordedOwner = resolveCanonicalOwnerId(runtime, administered?.metadata as Parameters<typeof resolveCanonicalOwnerId>[1])
  runtime.setSetting("ELIZA_ADMIN_ENTITY_ID", "not-a-uuid")
  const fallbackOwner = try Effect.try(() => resolveOwnerEntityIdOrDefault(runtime))
  runtime.setSetting("ELIZA_ADMIN_ENTITY_ID", null)
  const claimed = {
    ...administered!.metadata,
    roles: { ...administered!.metadata!.roles, [memberB]: Role.OWNER },
    roleSources: { ...(administered!.metadata!.roleSources as Record<string, string>), [memberB]: "connector_admin" },
  } as Parameters<typeof resolveEntityRole>[2]
  const resolved = try host(() => Promise.all([ownerId, memberA, memberB].map((id) => resolveEntityRole(runtime, administered!, claimed, id))))
  try Effect.try(() => assert.deepStrictEqual(
    { recordedOwner, fallbackOwner, resolved },
    { recordedOwner: ownerId, fallbackOwner: stringToUuid(`${agentId}-admin-entity`), resolved: ["OWNER", "ADMIN", "GUEST"] },
  ))

  // spec/core/entities.md, "Story: Show only components from authorized sources"
  try host(() => runtime.createComponent({ id: stringToUuid("j06-agent-note"), entityId: memberC, agentId, roomId, worldId, sourceEntityId: agentId, type: "agent-note", createdAt: 1, data: { note: "from the agent" } }))
  try host(() => runtime.createComponent({ id: stringToUuid("j06-peer-note"), entityId: memberC, agentId, roomId, worldId, sourceEntityId: memberB, type: "peer-note", createdAt: 2, data: { note: "from member b" } }))
  try host(() => runtime.createComponent({ id: stringToUuid("j06-author-note"), entityId: memberC, agentId, roomId, worldId, sourceEntityId: actorId, type: "author-note", createdAt: 3, data: { note: "from the author" } }))
  try host(() => runtime.createComponent({ id: stringToUuid("j06-self-note"), entityId: memberC, agentId, roomId, worldId, sourceEntityId: memberC, type: "self-note", createdAt: 4, data: { note: "from member c" } }))
  const visibleTypes = effect {
    const world = try host(() => runtime.getWorld(worldId))
    const entity = try host(() => runtime.getEntityById(memberC))
    const visible = try host(() => withVisibleComponents(runtime, world, entity!, actorId))
    const roles = try host(() => Promise.all([actorId, memberC].map((id) => resolveEntityRole(runtime, world!, world!.metadata as Parameters<typeof resolveEntityRole>[2], id))))
    return { roles, components: (visible.components ?? []).map(({ type, sourceEntityId, data }) => ({ type, sourceEntityId, data })) }
  }
  const agentNote = { type: "agent-note", sourceEntityId: agentId, data: { note: "from the agent" } }
  const peerNote = { type: "peer-note", sourceEntityId: memberB, data: { note: "from member b" } }
  const authorNote = { type: "author-note", sourceEntityId: actorId, data: { note: "from the author" } }
  const selfNote = { type: "self-note", sourceEntityId: memberC, data: { note: "from member c" } }
  const beforePromotion = try visibleTypes
  const promotion = try host(() => change(ownerId, memberB, "ADMIN", "promote member b"))
  const afterPromotion = try visibleTypes
  try Effect.try(() => assert.deepStrictEqual(
    { beforePromotion, promotion: promotion.status, afterPromotion },
    {
      beforePromotion: { roles: ["USER", "GUEST"], components: [agentNote, authorNote, selfNote] },
      promotion: "committed",
      afterPromotion: { roles: ["USER", "GUEST"], components: [agentNote, peerNote, authorNote, selfNote] },
    },
  ))

  // spec/core/entities.md, "Adapter failure cannot become a successful mutation result"
  const duplicate = try failure(() => runtime.createEntities([{ id: memberA, names: ["Impostor"], agentId }]))
  const kept = try host(() => runtime.getEntityById(memberA))
  try Effect.try(() => assert.deepStrictEqual(
    { error: { message: (duplicate as Error).message, code: (duplicate as { code?: string }).code }, names: kept?.names },
    { error: { message: "UNIQUE constraint failed: entities.id", code: "ERR_SQLITE_ERROR" }, names: ["Member A"] },
  ))

  // spec/core/memo.md, "Story: Reuse concurrent reads and evict only the matching rejected promise"; spec/core/memo.md, "Live entries expire as monotonic time advances"
  const readGate = Promise.withResolvers<void>()
  const settledReads: string[] = []
  try fault("getRoomsByIds", readGate.promise)
  const firstRead = try pending(() => runtime.getRoom(lobbyId).then((room) => {
    settledReads.push("first")
    return room?.name
  }))
  const secondRead = try pending(() => runtime.getRoom(lobbyId).then((room) => {
    settledReads.push("second")
    return room?.name
  }))
  try sleep("100 millis")
  const waitingReads = [...settledReads]
  readGate.resolve()
  const sharedReads = [try host(() => firstRead.settled), try host(() => secondRead.settled)]
  const outside = try host(async () => new SqliteAdapter(store, "outside"))
  const lobby = try host(() => outside.getRoomsByIds([lobbyId]))
  try host(() => outside.updateRooms([{ ...lobby[0]!, name: "lobby renamed" }]))
  try host(() => outside.close())
  const whileLive = (try host(() => runtime.getRoom(lobbyId)))?.name
  try sleep("1100 millis")
  const afterExpiry = (try host(() => runtime.getRoom(lobbyId)))?.name
  try Effect.try(() => assert.deepStrictEqual(
    { waitingReads, sharedReads, settledReads, whileLive, afterExpiry },
    { waitingReads: [], sharedReads: ["lobby", "lobby"], settledReads: ["first", "second"], whileLive: "lobby", afterExpiry: "lobby renamed" },
  ))

  // spec/core/settingsKeys.md, "Recognized ciphertext fails explicitly when authentication or decryption fails"
  const privateSalt = "j06-private-salt-0f3c9a"
  try withEnv({ SECRET_SALT: privateSalt, NODE_ENV: "test" })
  clearSaltCache()
  const setting = (value: string, secret: boolean) => ({ name: secret ? "API token" : "Mode", description: "", usageDescription: "", required: false, value, secret, dependsOn: [] })
  const updated = try host(() => updateWorldSettings(runtime, serverId, { API_TOKEN: setting("tok-123", true), MODE: setting("public", false) }))
  const persisted = try host(() => runtime.getWorld(worldId))
  const storedSettings = persisted?.metadata?.settings as unknown as Record<string, { value: string }>
  const ciphertext = storedSettings.API_TOKEN!.value
  const decrypted = try host(() => getWorldSettings(runtime, serverId)) as Record<string, { value: string }> | null
  const parts = ciphertext.split(":")
  const tamperedText = [parts[0], parts[1], `${parts[2]!.slice(0, -1)}${parts[2]!.endsWith("0") ? "1" : "0"}`, parts[3]].join(":")
  const nativeDecryption = try host(() => runNode({
    script: `import { createDecipheriv, createHash } from "node:crypto";
const [envelope, salt] = JSON.parse(process.argv[1]);
const [, iv, ciphertext, tag] = envelope.split(":");
let diagnostic = null;
try {
  const decipher = createDecipheriv("aes-256-gcm", createHash("sha256").update(salt).digest(), Buffer.from(iv, "hex"));
  decipher.setAAD(new TextEncoder().encode("elizaos:settings:v2"));
  decipher.setAuthTag(Buffer.from(tag, "hex"));
  decipher.update(Buffer.from(ciphertext, "hex"));
  decipher.final();
} catch (error) {
  diagnostic = [error instanceof Error, error.constructor.name, error.name, error.message, error.code ?? null, error.library ?? null, error.reason ?? null];
}
console.log(JSON.stringify(diagnostic));`,
    args: [JSON.stringify([tamperedText, privateSalt])],
  }))
  const nativeDiagnostic = Schema.Tuple([Schema.Boolean, Schema.String, Schema.String, Schema.String, Schema.NullOr(Schema.String), Schema.NullOr(Schema.String), Schema.NullOr(Schema.String)])
  const nativeCause = try Schema.decodeUnknownEffect(Schema.fromJsonString(nativeDiagnostic), { onExcessProperty: "error" })(nativeDecryption.stdout)
  try Effect.try(() => assert.deepStrictEqual([nativeDecryption.status, nativeCause[0]], [0, true]))
  try host(() => runtime.updateWorld({ ...persisted!, metadata: { ...persisted!.metadata, settings: { ...storedSettings, API_TOKEN: { ...storedSettings.API_TOKEN!, value: tamperedText } } as unknown as NonNullable<World["metadata"]>["settings"] } }))
  const tampered = try failure(() => getWorldSettings(runtime, serverId))
  const decryptionFailure = try Effect.try(() => {
    assert.instanceOf(tampered, ElizaError)
    const cause = tampered.cause
    assert.instanceOf(cause, Error)
    return {
      code: tampered.code,
      message: tampered.message,
      cause: [cause instanceof Error, cause.constructor.name, cause.name, cause.message, "code" in cause ? cause.code ?? null : null, "library" in cause ? cause.library ?? null : null, "reason" in cause ? cause.reason ?? null : null],
    }
  })
  const cause = try Schema.decodeUnknownEffect(nativeDiagnostic, { onExcessProperty: "error" })(decryptionFailure.cause)
  // spec/core/settingsKeys.md, "Production rejects unset and public salts on refresh"
  try withEnv({ SECRET_SALT: undefined, NODE_ENV: "production" })
  clearSaltCache()
  const unset = try failure(() => getWorldSettings(runtime, serverId))
  try withEnv({ SECRET_SALT: "secretsalt", NODE_ENV: "production" })
  clearSaltCache()
  const publicSalt = try failure(() => getWorldSettings(runtime, serverId))
  try Effect.try(() => assert.deepStrictEqual(
    {
      updated,
      envelope: [parts[0], parts.length, storedSettings.MODE!.value],
      underConfiguredSalt: decryptStringValue(ciphertext, privateSalt),
      decrypted: [decrypted?.API_TOKEN?.value, decrypted?.MODE?.value],
      tampered: [true, decryptionFailure.code, decryptionFailure.message, cause],
      unsafe: [[(unset as Error).constructor.name, (unset as Error).message], [(publicSalt as Error).constructor.name, (publicSalt as Error).message]],
    },
    {
      updated: true,
      envelope: ["v2", 4, "public"],
      underConfiguredSalt: "tok-123",
      decrypted: ["tok-123", "public"],
      tampered: [true, "SETTING_DECRYPTION_FAILED", "Failed to decrypt secret setting", nativeCause],
      unsafe: [
        ["Error", "SECRET_SALT must be set to a non-default value in production."],
        ["Error", "SECRET_SALT must be set to a non-default value in production."],
      ],
    },
  ))

  // spec/core/channelTopics.md, "Retirement rejects new work and joins admitted operations before clearing local state"; spec/core/topicService.md, "Stop blocks every new room admission and joins the complete room snapshot"
  const topics = try host(() => ChannelTopicsService.start(runtime))
  try host(() => topics.recordTopics(roomId, ["pricing", " roadmap "]))
  try host(() => topics.recordTopics(lobbyId, ["launch"]))
  const writeGate = Promise.withResolvers<void>()
  const retirement: string[] = []
  try fault("updateRooms", writeGate.promise)
  const admittedWrite = try pending(() => topics.recordTopics(roomId, ["pricing", "hiring"]).then(() => {
    retirement.push("write")
  }))
  try sleep("100 millis")
  const stopping = try pending(() => topics.stop().then(() => {
    retirement.push("stop")
  }))
  const refused = try failure(() => topics.recordTopics(stringToUuid("j06-unseen-room"), ["late"]))
  try sleep("100 millis")
  const waitingRetirement = [...retirement]
  writeGate.resolve()
  try host(() => admittedWrite.settled)
  try host(() => stopping.settled)
  const retiredCache = topics.getTopicsForAllRooms()
  const replacement = try host(() => ChannelTopicsService.start(runtime))
  const hydrated = [try host(() => replacement.ensureHydrated(roomId)), try host(() => replacement.ensureHydrated(lobbyId))]
  const durable = (try host(() => runtime.getRoom(roomId)))?.metadata?.currentTopics
  try host(() => replacement.stop())
  try Effect.try(() => assert.deepStrictEqual(
    { refused: (refused as { code?: string }).code, waitingRetirement, retirement, retiredCache, hydrated, durable },
    {
      refused: "CHANNEL_TOPICS_STOPPING",
      waitingRetirement: [],
      retirement: ["write", "stop"],
      retiredCache: {},
      hydrated: [["roadmap", "pricing", "hiring"], ["launch"]],
      durable: ["roadmap", "pricing", "hiring"],
    },
  ))
}, 60_000)

// spec/core/scheduling.md, "Story: Execute due work within its owning agent"; spec/core/scheduling.md, "Stale query results and out-of-scope tasks never become dispatchable"; spec/core/scheduling.md, "Pausing affects later selections while admitted work retains its outcome"; spec/core/scheduling.md, "Retirement fences new admission and drains actual storage ownership"; spec/core/scheduling.md, "Story: Preserve concurrent operator metadata changes"; spec/core/scheduling.md, "Worker bookkeeping changes its keys while retaining the operator pause"; spec/core/taskServiceOwners.md, "Story: Stop admission synchronously and drain every admitted task operation"; spec/core/taskServiceOwners.md, "Exclusive tasks observe every active invocation of the same task"; spec/core/taskServiceOwners.md, "Local timer replacement retains the earliest deadline and exact active tick"; spec/core/sharedScheduler.md, "Story: Replace scheduler storage while process tasks and safely owned queries continue"; spec/core/processScheduler.md, "Story: Reuse one timer and drain the exact disposed task"; spec/core/processScheduler.md, "Process task names are unique only while registered and stale disposers preserve replacements"; spec/core/queryDrain.md, "Story: Replace services without dispatching stale results or closing active storage"; spec/core/taskDrain.md, "Story: Reconcile a reusable drain and retire its persisted task"
it.live("Story: Execute due work within its owning agent, across scheduler storage replacement, stop and restart (spec/core/scheduling.md, \"Story: Execute due work within its owning agent\")", () => Effect.scoped(effect {
  // spec/core/batchProcessor.md, "Story: Process every batch item with independent outcomes"; spec/core/batchProcessor.md, "Failure releases capacity before backoff and exhaustion callbacks"; spec/core/batchQueue.md, "A batched call settles successful items before retrying failures"
  const batchItem = { id: "j07-batch" }
  const batchError = new Error("j07 batch failure")
  const exhaustionError = new Error("j07 exhausted observer")
  const callbackOrder: Array<[string, boolean, boolean, boolean]> = []
  let batchOwner: BatchProcessor<typeof batchItem> | undefined
  let retryable = false
  let callReads = 0
  const callbacks = {
    process: async function (this: unknown, item: typeof batchItem) { callbackOrder.push(["process", this === batchOwner, item === batchItem, true]); throw batchError },
    shouldRetry: function (this: unknown, item: typeof batchItem, error: Error) { callbackOrder.push(["retry", this === batchOwner, item === batchItem, error === batchError]); return retryable },
    onExhausted: async function (this: unknown, item: typeof batchItem, error: Error) { callbackOrder.push(["exhausted", this === batchOwner, item === batchItem, error === batchError]); throw exhaustionError },
  }
  try Effect.try(() => { for (const callback of Object.values(callbacks)) Object.defineProperty(callback, "call", { get: () => { callReads += 1; return undefined } }) })
  const processor = try Effect.try(() => new BatchProcessor({ ...callbacks, maxParallel: 1, maxRetriesAfterFailure: 2, retryPolicy: { minDelayMs: 0, maxDelayMs: 0, jitter: 0 } }))
  batchOwner = processor
  const firstBatch = try host(() => processor.processBatch([batchItem]))
  const firstCallbacks = [...callbackOrder]
  callbackOrder.length = 0
  retryable = true
  let attemptReads = 0
  try Effect.try(() => Object.defineProperty(batchItem, "_batchMaxAttempts", { get: () => [2, 2, 2, 1][attemptReads++] }))
  const secondBatch = try host(() => processor.processBatch([batchItem]))
  const batchOutcomes = [firstBatch, secondBatch].map((batch) => batch.map((row) => [row.item === batchItem, row.success, row.error === batchError, row.retryCount]))
  const batchObservation = [firstCallbacks, callbackOrder, batchOutcomes, attemptReads, callReads]
  const batchExpected = [
    [["process", true, true, true], ["retry", true, true, true], ["exhausted", true, true, true]],
    [["process", true, true, true], ["retry", true, true, true], ["process", true, true, true], ["exhausted", true, true, true]],
    [[[true, false, true, 0]], [[true, false, true, 1]]], 2, 0,
  ]

  const nativeItems: Array<[string, boolean, string | undefined]> = []
  let nativeOwner: BatchProcessor<string> | undefined
  const nativeProcessor = try Effect.try(() => new BatchProcessor<string>({ maxParallel: 1, maxRetriesAfterFailure: 0, process: async function (this: unknown, item: string) {
    nativeItems.push([item, this === nativeOwner, getTrajectoryContext()?.trajectoryStepId])
  } }))
  nativeOwner = nativeProcessor
  const nativeBatch = (items: string[]) => host(async () => await runWithTrajectoryContext({ trajectoryId: "j07-native-array", trajectoryStepId: "j07-native-step" }, () => nativeProcessor.processBatch(items)))
  const ordinaryArray = try nativeBatch(["ordinary"])
  const sparseArray = try Effect.try(() => new Array<string>(1))
  const sparseResult = try nativeBatch(sparseArray)
  const indexedArray = ["indexed"]
  try Effect.try(() => Object.defineProperty(indexedArray, Symbol.iterator, { value: function* () { yield "iterator-value" } }))
  const indexedResult = try nativeBatch(indexedArray)
  try Effect.try(() => assert.deepStrictEqual([ordinaryArray, sparseResult, indexedResult, nativeItems], [
    [{ item: "ordinary", success: true, retryCount: 0 }],
    [undefined],
    [{ item: "indexed", success: true, retryCount: 0 }],
    [["ordinary", true, "j07-native-step"], ["indexed", true, "j07-native-step"]],
  ]))

  const firstInput = { id: "first" }
  const secondInput = { id: "second" }
  const replacementInput = { id: "replacement" }
  const orderedInputs = [firstInput, secondInput]
  const nativeOrder: string[] = []
  try Effect.try(() => {
    for (const item of orderedInputs) Object.defineProperty(item, "_batchMaxAttempts", { get: () => { nativeOrder.push(`budget:${item.id}`); return 1 } })
  })
  const orderedProcessor = try Effect.try(() => new BatchProcessor({ maxParallel: 1, maxRetriesAfterFailure: 0, process: async (item: typeof firstInput) => {
    nativeOrder.push(`process:${item.id}`)
    if (item === firstInput) orderedInputs[1] = replacementInput
  } }))
  const orderedOutcomes = try host(() => orderedProcessor.processBatch(orderedInputs))
  try Effect.try(() => assert.deepStrictEqual([nativeOrder, orderedOutcomes.map((row) => [row.item === firstInput, row.item === secondInput, row.success]), orderedInputs[1] === replacementInput], [
    ["budget:first", "budget:first", "budget:second", "budget:second", "process:first", "process:second"],
    [[true, false, true], [false, true, true]],
    true,
  ]))

  const agentA = stringToUuid("j07-agent-a")
  const agentB = stringToUuid("j07-agent-b")
  const who = (id: unknown) => id === agentA ? "A" : id === agentB ? "B" : "other"
  const store = try storeAt("eliza-core-j07")
  const plugins = [{ name: "j07-tasks", description: "Task service for the scheduling journey", services: [TaskService] }]
  const latch = () => Deferred.makeUnsafe<void>()
  const open = (gate: Deferred.Deferred<void>) => Deferred.doneUnsafe(gate, Exit.void)
  const reach = (gate: Deferred.Deferred<void>, millis = 6_000) => Effect.timeout(Deferred.await(gate), millis)
  const waitFor = (gate: Deferred.Deferred<void>) => runPromise(Deferred.await(gate))
  const gated = (reached: Deferred.Deferred<void>, release: Deferred.Deferred<void>) => ({
    get gate() {
      open(reached)
      return waitFor(release)
    },
  })
  const background = <A>(f: () => Promise<A>) => effect {
    const state = { done: false }
    const fiber = try forkScoped(ensuring(host(f), sync(() => { state.done = true })), { startImmediately: true })
    return { fiber, state }
  }
  const describe = (error: unknown) => {
    const code = (error as { code?: unknown } | null)?.code
    return code === undefined ? { message: error instanceof Error ? error.message : String(error) } : { code }
  }
  const settle = <A, E>(work: A!E) => Effect.match(work, {
    onFailure: (error) => ({ rejected: describe(error) }),
    onSuccess: () => "resolved",
  })
  const outcome = <A>(f: () => Promise<A>) => settle(host(f))
  const until = (done: () => boolean, millis = 6_000) => effect {
    for (let waited = 0; !done() && waited < millis; waited += 25) try sleep(25)
  }
  const worker = (runtime: { registerTaskWorker: (worker: TaskWorker) => void }, name: string, execute: TaskWorker["execute"]) =>
    Effect.try(() => runtime.registerTaskWorker({ name, execute }))
  try acquireRelease(sync(() => undefined), () => orDie(host(() => stopTaskScheduler())))

  const scheduled = try host(async () => new SqliteAdapter(store, "s1"))
  const replacement = try host(async () => new SqliteAdapter(store, "s2"))
  try acquireRelease(sync(() => replacement), (adapter) => orDie(host(() => adapter.close())))
  startTaskScheduler(scheduled)

  const shared = try Effect.scoped(effect {
    const runtimeA = try kernel({ store, agentId: agentA, label: "a", character: { name: "J07A" }, plugins })
    const runtimeB = try kernel({ store, agentId: agentB, label: "b", character: { name: "J07B" }, plugins })
    const serviceA = (try host(() => runtimeA.getServiceLoadPromise(ServiceType.TASK))) as TaskService
    try host(() => runtimeB.getServiceLoadPromise(ServiceType.TASK))

    // spec/core/index.md, "Compatibility translates asynchronous results without losing failures"
    const preflights: unknown[] = []
    for (const [index, next] of [undefined, null].entries()) {
      const name = `J07_PREFLIGHT_${index}`
      let executions = 0
      const taskWorker: TaskWorker = { name, execute: async () => { executions += 1 } }
      const observed = try changingMethod(taskWorker, "shouldRun", next)
      try Effect.try(() => runtimeA.registerTaskWorker(taskWorker))
      const id = try host(() => runtimeA.createTask({ name, description: "preflight boundary", tags: ["manual"], metadata: {} }))
      const task = try host(async () => {
        const stored = (await runtimeA.getTasksByIds([id]))[0]
        if (!stored) throw new Error("The persisted preflight task must be readable")
        return stored
      })
      const failure = try host(() => serviceA.runTick([task]).then(() => undefined, (error: unknown) => error))
      const outer = failure instanceof ElizaError ? failure : undefined
      const inner: unknown = outer?.cause instanceof AggregateError ? outer.cause.errors[0] : undefined
      preflights.push([outer?.code, outer?.severity, inner instanceof ElizaError ? inner.code : undefined, inner instanceof ElizaError && inner.cause instanceof TypeError, observed, executions])
      try host(() => runtimeA.deleteTask(id))
    }
    try Effect.try(() => assert.deepStrictEqual([batchObservation, preflights], [batchExpected, [
      ["TASK_TICK_FAILED", "ephemeral", "TASK_PREFLIGHT_FAILED", true, { reads: 2, totalReads: 2, cachedCalls: 0 }, 0],
      ["TASK_TICK_FAILED", "ephemeral", "TASK_PREFLIGHT_FAILED", true, { reads: 2, totalReads: 2, cachedCalls: 0 }, 0],
    ]]))

    // spec/core/taskServiceOwners.md, "An orphaned task is quarantined only after the startup grace and leaves quarantine when its worker returns or a heal succeeds"
    let orphanNow = 0
    const orphanService = try Effect.try(() => new TaskService(runtimeA, { now: () => orphanNow, setTimeout: () => undefined, clearTimeout: () => {} }))
    const orphanId = try host(() => runtimeA.createTask({ name: "J07_ORPHAN_ONCE", description: "one-shot whose worker is late", tags: ["manual"], metadata: {} }))
    const orphanRow = () => host(async () => {
      const stored = (await runtimeA.getTasksByIds([orphanId]))[0]
      if (!stored) throw new Error("An orphaned one-shot task must keep its row")
      return stored
    })
    const orphanStates: unknown[] = []
    for (const step of ["grace", "quarantine", "heal"]) {
      if (step === "quarantine") orphanNow = 60_000
      if (step === "heal") try worker(runtimeA, "J07_ORPHAN_ONCE", async () => undefined)
      const row = try orphanRow()
      try host(() => orphanService.runTick([row]))
      const after = try orphanRow()
      orphanStates.push([after.metadata?.paused ?? false, after.metadata?.orphanedNoWorker ?? false])
    }
    try host(() => runtimeA.deleteTask(orphanId))
    try Effect.try(() => assert.deepStrictEqual(orphanStates, [[false, false], [true, true], [false, false]]))

    const owned: string[] = []
    for (const runtime of [runtimeA, runtimeB]) {
      try worker(runtime, "J07_OWNED", async (rt, _options, task) => {
        owned.push(`${who(rt.agentId)} ran ${who(task.agentId)}`)
        return { nextInterval: 600_000 }
      })
    }
    for (const runtime of [runtimeA, runtimeB]) {
      try host(() => runtime.createTask({ name: "J07_OWNED", description: "owned", tags: ["queue", "repeat"], metadata: { updatedAt: 0, updateInterval: 600_000 } }))
    }
    try until(() => owned.length >= 2)
    try sleep(1_200)
    const ownership = [...owned].sort()

    // spec/core/taskServiceOwners.md, "Exclusive tasks observe every active invocation of the same task"
    const onceEntered = latch()
    const onceRelease = latch()
    const blockingEntered = latch()
    const blockingRelease = latch()
    const overlapEntered = latch()
    const overlapRelease = latch()
    const runs = { once: 0, blocking: 0, overlap: 0, overlapActive: 0, overlapMaxActive: 0 }
    try worker(runtimeA, "J07_ONCE", async () => {
      runs.once += 1
      open(onceEntered)
      await waitFor(onceRelease)
      return undefined
    })
    try worker(runtimeA, "J07_BLOCKING", async () => {
      runs.blocking += 1
      open(blockingEntered)
      await waitFor(blockingRelease)
      return { nextInterval: 600_000 }
    })
    try worker(runtimeA, "J07_OVERLAP", async () => {
      runs.overlap += 1
      runs.overlapActive += 1
      runs.overlapMaxActive = Math.max(runs.overlapMaxActive, runs.overlapActive)
      if (runs.overlapActive === 2) open(overlapEntered)
      await waitFor(overlapRelease)
      runs.overlapActive -= 1
      return { nextInterval: 600_000 }
    })
    const onceId = try host(() => runtimeA.createTask({ name: "J07_ONCE", description: "once", tags: ["queue"], metadata: {} }))
    const blockingId = try host(() => runtimeA.createTask({ name: "J07_BLOCKING", description: "blocking", tags: ["queue", "repeat"], metadata: { updatedAt: 0, updateInterval: 1 } }))
    const overlapId = try host(() => runtimeA.createTask({ name: "J07_OVERLAP", description: "overlap", tags: ["queue", "repeat"], metadata: { updatedAt: Date.now(), updateInterval: 600_000, blocking: false } }))
    const invocations = [
      try background(() => serviceA.executeTaskById(onceId)),
      try background(() => serviceA.executeTaskById(blockingId)),
      try background(() => serviceA.runDueTasks()),
      try background(() => serviceA.executeTaskById(onceId)),
      try background(() => serviceA.executeTaskById(blockingId)),
      try background(() => serviceA.executeTaskById(overlapId)),
      try background(() => serviceA.executeTaskById(overlapId)),
    ]
    try reach(onceEntered)
    try reach(blockingEntered)
    try reach(overlapEntered)
    try sleep(1_500)
    open(onceRelease)
    open(blockingRelease)
    open(overlapRelease)
    for (const invocation of invocations) try Fiber.join(invocation.fiber)
    const exclusive = {
      onceRuns: runs.once,
      onceRow: try host(() => runtimeA.getTask(onceId)),
      blockingRuns: runs.blocking,
      overlapRuns: runs.overlap,
      overlapMaxActive: runs.overlapMaxActive,
    }

    // spec/core/processScheduler.md, "Process task names are unique only while registered and stale disposers preserve replacements"
    const oldEntered = latch()
    const oldRelease = latch()
    const newEntered = latch()
    const oldSeen: string[] = []
    const disposeOld = try Effect.try(() => registerScheduledProcessTask("j07-process", async (signal) => {
      oldSeen.push("ran")
      open(oldEntered)
      await waitFor(oldRelease)
      oldSeen.push(`aborted ${signal.aborted}`)
    }))
    const duplicateWhileRegistered = try outcome(async () => registerScheduledProcessTask("j07-process", async () => undefined))
    try reach(oldEntered)
    const disposal = try background(disposeOld)
    const disposeNew = try Effect.try(() => registerScheduledProcessTask("j07-process", async () => {
      open(newEntered)
    }))
    try reach(newEntered)
    const disposedWhileOldRuns = disposal.state.done
    const oldWhileNewRan = [...oldSeen]
    open(oldRelease)
    try Fiber.join(disposal.fiber)
    const duplicateAfterOldDisposer = try outcome(async () => registerScheduledProcessTask("j07-process", async () => undefined))
    try host(() => disposeNew())
    const freeAfterDispose = try outcome(async () => registerScheduledProcessTask("j07-process", async () => undefined)())
    const processes ={ duplicateWhileRegistered, disposedWhileOldRuns, oldWhileNewRan, duplicateAfterOldDisposer, freeAfterDispose, old: [...oldSeen] }

    // spec/core/queryDrain.md, "Story: Replace services without dispatching stale results or closing active storage"; spec/core/scheduling.md, "Stale query results and out-of-scope tasks never become dispatchable"
    const staleRuns: string[] = []
    try worker(runtimeA, "J07_STALE", async (rt) => {
      staleRuns.push(who(rt.agentId))
      return { nextInterval: 600_000 }
    })
    const oldQueryReached = latch()
    const oldQueryRelease = latch()
    const newQueryReached = latch()
    const newQueryRelease = latch()
    try Effect.try(() => scheduled.fault("getTasks", gated(oldQueryReached, oldQueryRelease)))
    try reach(oldQueryReached)
    try host(() => runtimeA.createTask({ name: "J07_STALE", description: "stale", tags: ["queue", "repeat"], metadata: { updatedAt: 0, updateInterval: 600_000 } }))
    try Effect.try(() => replacement.fault("getTasks", gated(newQueryReached, newQueryRelease)))
    const handoff = try background(() => handoffTaskSchedulerAdapter(scheduled, replacement))
    try reach(newQueryReached)
    const whileOldQueryGated = { handoffSettled: handoff.state.done }
    open(oldQueryRelease)
    try Fiber.join(handoff.fiber)
    const closedByCore = [...store.closeLog]
    try sleep(300)
    const staleRunsAfterHandoff = [...staleRuns]
    try host(() => scheduled.close())
    open(newQueryRelease)
    try until(() => staleRuns.length >= 1)
    const replaced = { whileOldQueryGated, closedByCore, staleRunsAfterHandoff, currentRuns: [...staleRuns] }

    // spec/core/taskServiceOwners.md, "Story: Stop admission synchronously and drain every admitted task operation"; spec/core/scheduling.md, "Retirement fences new admission and drains actual storage ownership"
    try host(() => stopTaskScheduler())
    const slowEntered = latch()
    const slowRelease = latch()
    const afterStop: string[] = []
    try worker(runtimeA, "J07_SLOW", async () => {
      open(slowEntered)
      await waitFor(slowRelease)
      return undefined
    })
    try worker(runtimeA, "J07_AFTER_STOP", async () => {
      afterStop.push("old runtime")
      return { nextInterval: 600_000 }
    })
    const slowId = try host(() => runtimeA.createTask({ name: "J07_SLOW", description: "slow", tags: ["queue"], metadata: {} }))
    try sleep(10)
    const afterStopId = try host(() => runtimeA.createTask({ name: "J07_AFTER_STOP", description: "after stop", tags: ["queue", "repeat"], metadata: { updatedAt: 0, updateInterval: 600_000 } }))
    const tick = try background(() => serviceA.runDueTasks())
    try reach(slowEntered)
    const stopping = try background(() => runtimeA.stop())
    const refused = try outcome(() => serviceA.executeTaskById(afterStopId))
    try sleep(300)
    const stoppedBeforeTickSettled = stopping.state.done
    open(slowRelease)
    try Fiber.join(stopping.fiber)
    const tickOutcome = try settle(Fiber.join(tick.fiber))
    const remaining = (try host(() => replacement.getTasksByIds([slowId, afterStopId]))).map((task) => task.name)
    const stopped = { refused, stoppedBeforeTickSettled, tickOutcome, remaining, afterStop: [...afterStop] }
    return { ownership, exclusive, processes, replaced, stopped }
  })

  try Effect.try(() => assert.deepStrictEqual(shared, {
    ownership: ["A ran A", "B ran B"],
    exclusive: { onceRuns: 1, onceRow: null, blockingRuns: 1, overlapRuns: 2, overlapMaxActive: 2 },
    processes: {
      duplicateWhileRegistered: { rejected: { code: "TASK_SCHEDULER_DUPLICATE_PROCESS_TASK" } },
      disposedWhileOldRuns: false,
      oldWhileNewRan: ["ran"],
      duplicateAfterOldDisposer: { rejected: { code: "TASK_SCHEDULER_DUPLICATE_PROCESS_TASK" } },
      freeAfterDispose: "resolved",
      old: ["ran", "aborted true"],
    },
    replaced: {
      whileOldQueryGated: { handoffSettled: false },
      closedByCore: [],
      staleRunsAfterHandoff: [],
      currentRuns: ["A"],
    },
    stopped: {
      refused: { rejected: { code: "TASK_SERVICE_STOPPED" } },
      stoppedBeforeTickSettled: false,
      tickOutcome: "resolved",
      remaining: ["J07_AFTER_STOP"],
      afterStop: [],
    },
  }))

  // spec/core/scheduling.md, "Story: Execute due work within its owning agent"
  const restarted = try kernel({ store, agentId: agentA, label: "a2", character: { name: "J07A" }, plugins, settings: { TASK_TICK_MAX_MS: "8000" } })
  const service = (try host(() => restarted.getServiceLoadPromise(ServiceType.TASK))) as TaskService
  const resumed: string[] = []
  try worker(restarted, "J07_AFTER_STOP", async () => {
    resumed.push("restarted runtime")
    return { nextInterval: 600_000 }
  })
  try until(() => resumed.length >= 1)
  const restart = [...resumed]

  // spec/core/taskServiceOwners.md, "Local timer replacement retains the earliest deadline and exact active tick"
  const ranAt = new Map<string, number>()
  try worker(restarted, "J07_WAKE", async (_rt, _options, task) => {
    ranAt.set(String(task.description), Date.now())
    return { nextInterval: 600_000 }
  })
  const wakeMetadata = () => ({ updatedAt: Date.now(), updateInterval: 600_000 })
  const early = try host(() => restarted.createTask({ name: "J07_WAKE", description: "early", tags: ["queue", "repeat"], metadata: wakeMetadata() }))
  const late = try host(() => restarted.createTask({ name: "J07_WAKE", description: "late", tags: ["queue", "repeat"], metadata: wakeMetadata() }))
  try sleep(1_500)
  const requested = Date.now()
  try host(() => Promise.all([
    restarted.patchTaskMetadata(early, { wake: { requestAt: requested + 1_200 } }),
    restarted.patchTaskMetadata(late, { wake: { requestAt: requested + 2_500 } }),
  ]))
  try until(() => ranAt.has("early"), 7_000)
  try sleep(Math.max(0, requested + 1_800 - Date.now()))
  try host(() => restarted.patchTaskMetadata(early, { set: { j07: 1 } }))
  try until(() => ranAt.has("late"), 7_000)
  const earlyAt = (ranAt.get("early") ?? Infinity) - requested
  const lateAt = (ranAt.get("late") ?? Infinity) - requested
  const created = Date.now()
  try worker(restarted, "J07_FRESH", async () => {
    ranAt.set("fresh", Date.now())
    return undefined
  })
  try host(() => restarted.createTask({ name: "J07_FRESH", description: "fresh", tags: ["queue"], metadata: {} }))
  try until(() => ranAt.has("fresh"), 7_000)
  const freshAt = (ranAt.get("fresh") ?? Infinity) - created
  const holdEntered = latch()
  const holdRelease = latch()
  try worker(restarted, "J07_HOLD", async () => {
    open(holdEntered)
    await waitFor(holdRelease)
    return undefined
  })
  try worker(restarted, "J07_AFTER_TICK", async () => {
    ranAt.set("afterTick", Date.now())
    return undefined
  })
  try host(() => restarted.createTask({ name: "J07_HOLD", description: "hold", tags: ["queue"], metadata: {} }))
  const held = try background(() => service.runDueTasks())
  try reach(holdEntered)
  const queuedDuringTick = Date.now()
  try host(() => restarted.createTask({ name: "J07_AFTER_TICK", description: "after tick", tags: ["queue"], metadata: {} }))
  try sleep(Math.max(0, queuedDuringTick + 2_000 - Date.now()))
  const ranDuringTick = ranAt.has("afterTick")
  const released = Date.now()
  open(holdRelease)
  try Fiber.join(held.fiber)
  try until(() => ranAt.has("afterTick"), 7_000)
  const afterTickAt = (ranAt.get("afterTick") ?? Infinity) - released
  const wakes = {
    earlyAfterItsDeadline: earlyAt >= 1_200,
    earlyBeforeLateDeadline: earlyAt < 2_500,
    lateAfterItsDeadline: lateAt >= 2_500,
    lateKeepsEarlierDeadline: lateAt < 4_000,
    freshBeforeLongTick: freshAt < 3_000,
    timerWaitsForActiveTick: !ranDuringTick,
    wakeOneSecondAfterTick: afterTickAt >= 900 && afterTickAt < 3_000,
  }

  // spec/core/scheduling.md, "Pausing affects later selections while admitted work retains its outcome"; spec/core/scheduling.md, "Worker bookkeeping changes its keys while retaining the operator pause"
  const pauseEntered = latch()
  const pauseRelease = latch()
  const pauseRuns = { count: 0 }
  try worker(restarted, "J07_PAUSE", async () => {
    pauseRuns.count += 1
    open(pauseEntered)
    await waitFor(pauseRelease)
    return { nextInterval: 1 }
  })
  const pauseId = try host(() => restarted.createTask({
    name: "J07_PAUSE",
    description: "pause while running",
    tags: ["queue", "repeat"],
    metadata: { updatedAt: Date.now(), updateInterval: 600_000, baseInterval: 600_000, failureCount: 2, maxFailures: 8, lastError: "earlier failure" },
  }))
  const running = try background(() => service.executeTaskById(pauseId))
  try reach(pauseEntered)
  try host(() => Promise.all([
    service.pauseTask(pauseId),
    restarted.patchTaskMetadata(pauseId, { set: { operatorNote: "night shift" } }),
  ]))
  open(pauseRelease)
  try Fiber.join(running.fiber)
  try host(() => service.runDueTasks())
  try sleep(1_200)
  const paused = (try host(() => restarted.getTask(pauseId)))?.metadata ?? {}
  const pausing = {
    runs: pauseRuns.count,
    metadata: {
      paused: paused.paused,
      operatorNote: paused.operatorNote,
      failureCount: paused.failureCount,
      maxFailures: paused.maxFailures,
      updateInterval: paused.updateInterval,
      baseInterval: paused.baseInterval,
      lastError: paused.lastError,
    },
    status: (try host(() => service.getTaskStatus(pauseId))).paused,
  }

  // spec/core/taskDrain.md, "Story: Reconcile a reusable drain and retire its persisted task"
  const drain = new TaskDrain({ taskName: "J07_DRAIN", intervalMs: 5_000, taskMetadata: { lane: "j07" }, onDrain: async () => undefined })
  const drainRows = effect {
    const rows = try host(() => restarted.getTasksByName("J07_DRAIN"))
    return rows.map((task) => ({
      mine: task.id === drain.id,
      tags: task.tags,
      lane: task.metadata?.lane,
      updateInterval: task.metadata?.updateInterval,
      baseInterval: task.metadata?.baseInterval,
    }))
  }
  try host(() => drain.start(restarted))
  const started = try drainRows
  try host(() => drain.updateInterval(restarted, 9_000))
  const updated = { rows: try drainRows, intervalMs: drain.getIntervalMs() }
  const second = new TaskDrain({ taskName: "J07_DRAIN", intervalMs: 7_000, taskMetadata: { lane: "j07" }, onDrain: async () => undefined })
  try host(() => second.start(restarted))
  const reconciled = { sameId: second.id === drain.id, rows: try drainRows }
  try host(() => drain.dispose(restarted))
  try host(() => second.dispose(restarted))
  const disposed = { rows: try drainRows, id: drain.id, secondId: second.id }

  try Effect.try(() => assert.deepStrictEqual({ restart, wakes, pausing, drain: { started, updated, reconciled, disposed } }, {
    restart: ["restarted runtime"],
    wakes: { earlyAfterItsDeadline: true, earlyBeforeLateDeadline: true, lateAfterItsDeadline: true, lateKeepsEarlierDeadline: true, freshBeforeLongTick: true, timerWaitsForActiveTick: true, wakeOneSecondAfterTick: true },
    pausing: {
      runs: 1,
      metadata: { paused: true, operatorNote: "night shift", failureCount: 0, maxFailures: 8, updateInterval: 1, baseInterval: undefined, lastError: undefined },
      status: true,
    },
    drain: {
      started: [{ mine: true, tags: ["queue", "repeat"], lane: "j07", updateInterval: 5_000, baseInterval: 5_000 }],
      updated: { rows: [{ mine: true, tags: ["queue", "repeat"], lane: "j07", updateInterval: 9_000, baseInterval: 9_000 }], intervalMs: 9_000 },
      reconciled: { sameId: true, rows: [{ mine: true, tags: ["queue", "repeat"], lane: "j07", updateInterval: 7_000, baseInterval: 7_000 }] },
      disposed: { rows: [], id: null, secondId: null },
    },
  }))
}), 90_000)

// spec/core/pairing/index.md, "Story: Approve a pairing code without losing a failed request"; spec/core/pairing/admission.md, "Story: Admit pending pairing requests without evicting existing senders"; spec/core/pairing/grants.md, "Story: Receive the actual stored grant identity"; spec/core/pairing/replies.md, "Story: Suppress repeated pairing replies within the retained TTL"; spec/core/approvals.md, "Story: Resolve an approval exactly once"; spec/core/approvals.md, "Persisting a request precedes publishing its in-memory callback"; spec/core/approvals.md, "Claiming removes pending ownership before a callback starts"; spec/core/approvals.md, "Restart drops process-owned callbacks and service retirement drains a claimed callback"; spec/core/approvalService.md, "Story: Drain every approval without crossing identities"; spec/core/approvalRetirement.md, "Story: Stop waits for approvals and their independent queries"; spec/core/approvalService.md, "Story: Register each approval type once before creating its task"
it.live("Pair a sender and approve an action across a restart (spec/core/pairing/index.md, \"Story: Approve a pairing code without losing a failed request\")", () => effect {
  const until = (check: () => Promise<boolean>) => effect {
    while (!(try host(check))) try sleep("5 millis")
  }
  const outcome = <A>(f: () => Promise<A>) => Effect.match(host(f), {
    onSuccess: (value) => ({ value }),
    onFailure: (error) => error instanceof ElizaError ? { code: error.code } : { error },
  })
  const act = (f: () => void) => host(async () => f())
  const decided = (result: ApprovalResult) => ({ ...result, resolvedAt: typeof result.resolvedAt })
  const store = try storeAt("j08-approve-and-pair")
  const agentId = stringToUuid("j08-approve-and-pair")
  const roomId = stringToUuid("j08-approval-room")
  const plugin: Plugin = {
    name: "j08-approvals",
    description: "Pairing and approval services of the host",
    services: [PairingService, ApprovalService] as unknown as Plugin["services"],
  }
  const ask = (name: string, extra: Partial<ApprovalRequest> = {}): ApprovalRequest => ({
    name,
    description: `${name} the build`,
    roomId,
    options: STANDARD_OPTIONS.APPROVE_DENY,
    ...extra,
  })
  const failure = new Error("storage refused")
  const channel = "telegram"

  const before = try Effect.scoped(effect {
    const runtime = try kernel({ store, agentId, plugins: [plugin] })
    const adapter = runtime.adapter as SqliteAdapter
    const pairing = (try host(() => runtime.getServiceLoadPromise(ServiceType.PAIRING))) as PairingService
    const approvals = (try host(() => runtime.getServiceLoadPromise(ServiceType.APPROVAL))) as ApprovalService

    // spec/core/pairing/admission.md, "One read-check-write admission owns the captured row and exact payload"; spec/core/pairing/replies.md, "A live retained claim suppresses a reply and expired claims can rearm it"
    const checks = []
    for (const senderId of ["alice", "bob", "carol", "dave"]) {
      checks.push(try host(() => checkPairingAllowed(runtime, { channel, senderId })))
    }
    const first = try host(() => pairing.listPendingRequests(channel))
    try sleep("5 millis")
    checks.push(try host(() => checkPairingAllowed(runtime, { channel, senderId: "alice" })))
    const again = try host(() => pairing.listPendingRequests(channel))
    const codes = Object.fromEntries(checks.slice(0, 3).map((check, index) => [["alice", "bob", "carol"][index], check.pairingCode ?? ""]))
    const identity = (requests: typeof first) => requests.map(({ id, code, createdAt, senderId }) => [senderId, id, code, createdAt.getTime()]).sort()
    const seenAt = (requests: typeof first) => requests.find((request) => request.senderId === "alice")!.lastSeenAt.getTime()
    const queued = again.map((request) => [request.senderId, request.code]).sort()
    const brief = new PairingService(runtime, { requestTtlMs: 50 })
    const briefClaims = [brief.claimPairingReply(channel, "erin"), brief.claimPairingReply(channel, "erin")]
    try sleep("60 millis")
    briefClaims.push(brief.claimPairingReply(channel, "erin"))
    const claims = [
      pairing.claimPairingReply(channel, "alice"),
      pairing.claimPairingReply(channel, "dave"),
      pairing.claimPairingReply(channel, "dave"),
      ...briefClaims,
    ]
    const admission = { checks, queued, claims, unchanged: JSON.stringify(identity(again)) === JSON.stringify(identity(first)), refreshed: seenAt(again) > seenAt(first) }

    // spec/core/pairing/index.md, "Each request lookup selects the exact oldest live row for the normalized code"; spec/core/pairing/index.md, "A retained grant is captured before deletion of that request's ID"; spec/core/pairing/grants.md, "Both owner and grant-key indexes identify the same complete row"
    const both = try host(() => Promise.all([
      pairing.approveCode({ channel, code: ` ${codes.alice.toLowerCase()} ` }),
      pairing.approveCode({ channel, code: codes.alice }),
    ]))
    try act(() => adapter.fault("getPairingRequests", { reject: failure }))
    const blank = try host(() => pairing.approveCode({ channel, code: "   " }))
    const unread = try outcome(() => pairing.approveCode({ channel, code: codes.bob }))
    try act(() => adapter.fault("deletePairingRequests", { reject: failure }))
    const undeleted = try outcome(() => pairing.approveCode({ channel, code: codes.bob }))
    const kept = {
      granted: (try host(() => pairing.getAllowlist(channel))).map((entry) => entry.senderId).sort(),
      pending: (try host(() => pairing.listPendingRequests(channel))).map((request) => request.senderId).sort(),
    }
    const retried = (try host(() => pairing.approveCode({ channel, code: codes.bob })))?.senderId
    const grants = {
      same: both[0]?.allowlistEntry.id === both[1]?.allowlistEntry.id && JSON.stringify(both[0]) === JSON.stringify(both[1]),
      grantId: both[0]?.allowlistEntry.id,
      senders: both.map((result) => result?.senderId),
      blank,
      unread: "error" in unread && unread.error === failure,
      undeleted: "error" in undeleted && undeleted.error === failure,
      kept,
      retried,
      allowed: try host(() => isInAllowlist(runtime, channel, "bob")),
      pending: (try host(() => pairing.listPendingRequests(channel))).map((request) => request.senderId),
    }

    // spec/core/approvals.md, "Persisting a request precedes publishing its in-memory callback"; spec/core/approvalService.md, "Successful registrations retain one name and failed registrations retain none"
    const seen: string[] = []
    const persisted = Promise.withResolvers<void>()
    const slow = Promise.withResolvers<void>()
    try act(() => adapter.fault("createTasks", { gate: persisted.promise }))
    let deploySettled = false
    const deploying = try forkChild(Effect.tap(host(() => approvals.requestApproval(ask("DEPLOY", {
      timeoutMs: 300,
      onSelect: async (option, task, rt) => {
        seen.push(`select ${option} ${(await rt.getTask(task.id as UUID))?.id === task.id}`)
        await slow.promise
      },
      onTimeout: async () => {
        seen.push("timeout")
      },
    }))), () => Effect.sync(() => {
      deploySettled = true
    })))
    try until(async () => runtime.getTaskWorker("DEPLOY") !== undefined)
    const unpublished = approvals.listPendingUserActions().length
    try act(() => persisted.resolve())
    try until(async () => approvals.listPendingUserActions().length === 1)
    const deployId = approvals.listPendingUserActions()[0].id as UUID
    const worker = runtime.getTaskWorker("DEPLOY")
    const deployTask = try host(() => runtime.getTask(deployId))

    // spec/core/approvals.md, "Claiming removes pending ownership before a callback starts"
    const selections = try forkChild(Effect.all([
      outcome(() => worker!.execute(runtime, { option: "approve" }, deployTask!)),
      outcome(() => worker!.execute(runtime, { option: "deny" }, deployTask!)),
    ], { concurrency: "unbounded" }))
    try sleep("450 millis")
    const resolvedEarly = deploySettled
    try act(() => slow.resolve())
    const raced = (try Fiber.join(selections)).map((selection) => "code" in selection ? selection.code : "selected").sort()
    const deployed = decided(try Fiber.join(deploying))
    const pendingDeploy = try forkChild(host(() => approvals.requestApproval(ask("DEPLOY", {
      onSelect: async () => {
        seen.push("orphan selected")
      },
    }))))
    try until(async () => approvals.listPendingUserActions().length === 1)
    const orphanId = approvals.listPendingUserActions()[0].id as UUID
    const claiming = {
      unpublished,
      resolvedEarly,
      seen: [...seen],
      raced,
      deployed: { ...deployed, taskId: deployed.taskId === deployId },
      deployRow: try host(() => runtime.getTask(deployId)),
      sameWorker: runtime.getTaskWorker("DEPLOY") === worker,
    }

    const distant = [30 * 24 * 3_600_000, Number.POSITIVE_INFINITY]
    const waiting = try Effect.forEach(distant, (timeoutMs) => host(() => approvals.requestApprovalAsync(ask("ARCHIVE", { timeoutMs, timeoutDefault: "approve" }))))
    try sleep("200 millis")
    const distantRows = try Effect.forEach(waiting, (id) => host(async () => (await runtime.getTask(id))?.id === id))
    try Effect.forEach(waiting, (id) => host(() => approvals.cancelApproval(id)))
    try Effect.try(() => assert.deepStrictEqual(distantRows, [true, true]))

    const started = Date.now()
    const expiring = try host(() => approvals.requestApprovalAsync(ask("ARCHIVE", { timeoutMs: 150, timeoutDefault: "approve" })))
    try until(async () => (await runtime.getTask(expiring)) === null)
    const expiredAfter = Date.now() - started
    try act(() => adapter.fault("deleteTasks", { reject: failure }))
    const stuck = try host(() => approvals.requestApprovalAsync(ask("ARCHIVE", { timeoutMs: 150 })))
    try until(async () => runtime.getRecentReportedErrors().some((report) => report.scope === "ApprovalService.asyncTimeout"))
    const expiry = {
      expiredInTime: expiredAfter >= 150,
      stuckRow: (try host(() => runtime.getTask(stuck)))?.id === stuck,
      reported: runtime.getRecentReportedErrors().filter((report) => report.scope === "ApprovalService.asyncTimeout").map((report) => report.message),
      pending: approvals.listPendingUserActions().map((action) => action.id === orphanId),
    }

    // spec/core/approvalRetirement.md, "Stop closes admission and joins the original read and approval work"; spec/core/approvalService.md, "Admission and callback ownership compose under one service stop"; spec/core/approvals.md, "Restart drops process-owned callbacks and service retirement drains a claimed callback"
    const order: string[] = []
    const held = Promise.withResolvers<void>()
    const releasing = try forkChild(host(() => approvals.requestApproval(ask("RELEASE", {
      onSelect: async () => {
        order.push("callback started")
        await held.promise
        order.push("callback finished")
      },
    }))))
    try until(async () => approvals.listPendingUserActions().length === 2)
    const releaseId = approvals.listPendingUserActions().find((action) => action.id !== orphanId)!.id as UUID
    const releaseTask = try host(() => runtime.getTask(releaseId))
    const selecting = try forkChild(host(() => runtime.getTaskWorker("RELEASE")!.execute(runtime, { option: "approve" }, releaseTask!)))
    try until(async () => order.length === 1)
    const lateWrite = Promise.withResolvers<void>()
    try act(() => adapter.fault("createTasks", { gate: lateWrite.promise }))
    const late = try forkChild(outcome(() => approvals.requestApprovalAsync(ask("LATE"))))
    try until(async () => runtime.getTaskWorker("LATE") !== undefined)
    const reading = Promise.withResolvers<void>()
    try act(() => adapter.fault("getTasks", { gate: reading.promise }, 5))
    const read = try forkChild(effect {
      const result = try outcome(() => approvals.getPendingApprovals(roomId))
      order.push("read settled")
      return "value" in result
    })
    try sleep("20 millis")
    const unloading = try forkChild(effect {
      try host(() => runtime.unloadPlugin(plugin.name))
      order.push("unloaded")
    })
    try sleep("100 millis")
    order.push("callback released")
    try act(() => held.resolve())
    try until(async () => order.includes("callback finished"))
    try act(() => lateWrite.resolve())
    try sleep("50 millis")
    try act(() => reading.resolve())
    try Fiber.join(unloading)
    try Fiber.join(selecting)
    const retirement = {
      order,
      late: try Fiber.join(late),
      read: try Fiber.join(read),
      released: decided(try Fiber.join(releasing)).selectedOption,
      orphan: decided(try Fiber.join(pendingDeploy)),
      releaseRow: try host(() => runtime.getTask(releaseId)),
      service: runtime.getService(ServiceType.APPROVAL),
      closed: try outcome(() => approvals.requestApprovalAsync(ask("ARCHIVE"))),
    }
    return { admission, codes, grants, claiming, expiry, retirement, orphanId, stuck }
  })

  const { admission, codes, grants, claiming, expiry, retirement, orphanId, stuck } = before
  try Effect.try(() => assert.deepStrictEqual({ admission, grants, claiming, expiry, retirement: { ...retirement, orphan: { ...retirement.orphan, taskId: retirement.orphan.taskId === orphanId } } }, {
    admission: {
      checks: [
        ...["alice", "bob", "carol"].map((senderId) => ({
          allowed: false,
          pairingCode: codes[senderId],
          newRequest: true,
          replyMessage: buildPairingReplyMessage({ channel, senderId, code: codes[senderId], idLabel: "userId" }),
          idLabel: "userId",
        })),
        { allowed: false, idLabel: "userId" },
        { allowed: false, pairingCode: codes.alice, newRequest: false, replyMessage: undefined, idLabel: "userId" },
      ],
      queued: [["alice", codes.alice], ["bob", codes.bob], ["carol", codes.carol]],
      claims: [false, true, false, true, false, true],
      unchanged: true,
      refreshed: true,
    },
    grants: {
      same: true,
      grantId: stringToUuid(JSON.stringify(["allowlist", agentId, channel, "alice"])),
      senders: ["alice", "alice"],
      blank: null,
      unread: true,
      undeleted: true,
      kept: { granted: ["alice", "bob"], pending: ["bob", "carol"] },
      retried: "bob",
      allowed: true,
      pending: ["carol"],
    },
    claiming: {
      unpublished: 0,
      resolvedEarly: false,
      seen: ["select approve true"],
      raced: ["APPROVAL_CALLBACK_UNAVAILABLE", "selected"],
      deployed: { selectedOption: "approve", success: true, timedOut: false, cancelled: false, taskId: true, resolvedBy: undefined, resolvedAt: "number" },
      deployRow: null,
      sameWorker: true,
    },
    expiry: {
      expiredInTime: true,
      stuckRow: true,
      reported: [failure.message],
      pending: [true],
    },
    retirement: {
      order: ["callback started", "callback released", "callback finished", "read settled", "unloaded"],
      late: { code: "APPROVAL_SERVICE_STOPPED" },
      read: true,
      released: "approve",
      orphan: { selectedOption: "cancel", success: false, timedOut: false, cancelled: true, taskId: true, resolvedAt: "number" },
      releaseRow: null,
      service: null,
      closed: { code: "APPROVAL_SERVICE_STOPPED" },
    },
  }))

  // spec/core/approvals.md, "Restart drops process-owned callbacks and service retirement drains a claimed callback"
  const runtime = try kernel({ store, agentId, plugins: [plugin], label: "b" })
  const pairing = (try host(() => runtime.getServiceLoadPromise(ServiceType.PAIRING))) as PairingService
  const approvals = (try host(() => runtime.getServiceLoadPromise(ServiceType.APPROVAL))) as ApprovalService
  const restarted = {
    rows: (try host(() => approvals.getAllPendingApprovals())).map((task) => task.id === orphanId ? "orphan" : task.id === stuck ? "stuck" : task.name).sort(),
    callbacks: approvals.listPendingUserActions(),
    orphanSelected: try outcome(() => approvals.handleSelection(orphanId, "approve")),
    cancelled: try outcome(() => approvals.cancelApproval(orphanId)),
    orphanRow: try host(() => runtime.getTask(orphanId)),
    stuckSelected: try outcome(() => approvals.handleSelection(stuck, "approve")),
    granted: (try host(() => pairing.getAllowlist(channel))).map((entry) => entry.senderId).sort(),
    pending: (try host(() => pairing.listPendingRequests(channel))).map((request) => request.senderId),
    allowed: (try host(() => checkPairingAllowed(runtime, { channel, senderId: "alice" }))).allowed,
  }
  try Effect.try(() => assert.deepStrictEqual(restarted, {
    rows: ["orphan", "stuck"],
    callbacks: [],
    orphanSelected: { code: "APPROVAL_CALLBACK_UNAVAILABLE" },
    cancelled: { value: undefined },
    orphanRow: null,
    stuckSelected: { value: undefined },
    granted: ["alice", "bob"],
    pending: ["carol"],
    allowed: true,
  }))
}, 60_000)

// spec/core/notifications/index.md, "Story: Read durable notifications across retries and restart"; spec/core/notifications/index.md, "Inbox mutations retain stable IDs and increasing sequence coordinates"; spec/core/notifications/index.md, "Acknowledgement publishes success while ambiguity requires reconciliation"; spec/core/notifications/index.md, "Read fences use quiescent durable state and restart reloads that state"; spec/core/notifications/index.md, "Story: Preserve notification group and expiry policy"; spec/core/notifications/startup.md, "Hydration validates every row and the complete coordinate map"; spec/core/notifications/startup.md, "Story: Publish a notification service only after durable hydration"; spec/core/notifications/recovery.md, "Story: Retry a failed notification service without concurrent loaders"; spec/core/notifications/payload.md, "Story: Keep notification data independent of the producer and observers"; spec/core/notifications/cursor.md, "Story: Page a fixed notification snapshot without skipping unreadable rows"; spec/core/events.md, "Original fanout precedes its diagnostic reports"
it.live("Notify the owner and bridge agent events across a restart (spec/core/notifications/index.md, \"Story: Read durable notifications across retries and restart\")", () => effect {
  const agentId = "0f9c2a64-7d1e-4b3a-9c55-09a0b1c2d3e4" as UUID
  const key = `notifications:${agentId}`
  const store = try storeAt("eliza-core-j09")
  const services = (list: Array<typeof AgentEventService | typeof NotificationService>) => [{ name: "notify-the-owner", description: "Notification inbox and agent event bus", services: list }]
  const failureOf = (error: unknown) => error instanceof NotificationNativeError
    ? { name: error.name, code: error.code, status: error.status, message: error.message }
    : error instanceof Error ? { name: error.name, message: error.message } : { thrown: error }
  const seen: Array<Record<string, unknown>> = []
  const record = (event: AgentEventPayload) => {
    const data = event.data as Record<string, unknown>
    const notification = data.notification as AgentNotification | undefined
    seen.push({
      stream: event.stream,
      type: data.type,
      ...(notification ? { title: notification.title } : {}),
      ...(data.removed ? { removed: true } : {}),
      ...(typeof data.message === "string" ? { message: data.message } : {}),
    })
    if (notification) notification.title = "edited by an observer"
  }
  const shown = (rows: AgentNotification[]) => rows.map((row) => row.title)

  const before = try Effect.scoped(effect {
    const runtime = try kernel({ store, agentId, plugins: services([AgentEventService, NotificationService]) })
    const adapter = runtime.adapter as unknown as SqliteAdapter
    const events = (try host(() => runtime.getServiceLoadPromise(ServiceType.AGENT_EVENT))) as AgentEventService
    const inbox = (try host(() => runtime.getServiceLoadPromise(ServiceType.NOTIFICATION))) as NotificationService

    const emptyTitle = failureOf(try Effect.flip(host(() => inbox.notify({ title: "   " }))))
    const listenerFailure = new Error("listener boom")
    const stopThrowing = events.subscribe((event) => {
      if (event.stream === "notification") Effect.runSync(Effect.fail(listenerFailure))
    })
    const secondFailure = new Error("listener boom 2")
    const stopSecondThrowing = events.subscribe((event) => {
      if (event.stream === "notification") Effect.runSync(Effect.fail(secondFailure))
    })
    const stopRecording = events.subscribe(record)
    const input = { title: "  Deploy finished  ", body: " Build #42 deployed ", data: { build: { id: 42 } } }
    const first = try host(() => {
      const queued = inbox.notify(input)
      input.title = "changed by the producer"
      input.data.build.id = 0
      return queued
    })
    ;(first.data!.build as { id: number }).id = 7
    const stored = (try host(() => runtime.getCache<NotificationInboxSnapshot>(key)))!
    const reported = runtime.getRecentReportedErrors()
      .filter((entry) => entry.scope === "AgentEventService.listener")
      .map((entry) => ({ scope: entry.scope, context: entry.context }))
    // spec/core/notifications/index.md, "Inbox mutations retain stable IDs and increasing sequence coordinates"; spec/core/events.md, "Original fanout precedes its diagnostic reports"
    try Effect.try(() => assert.deepStrictEqual({
      emptyTitle,
      first: { title: first.title, body: first.body, category: first.category, priority: first.priority, source: first.source, readAt: first.readAt, agentId: first.agentId, nativeSequence: first.nativeSequence },
      stored: { version: stored.version, epoch: stored.nativeEpoch === first.nativeEpoch, sequence: stored.nativeSequence, coordinates: stored.nativeSequences, rows: stored.notifications.map((row) => ({ id: row.id, title: row.title, body: row.body, data: row.data, createdAt: row.createdAt === first.createdAt })) },
      listed: inbox.list().map((row) => ({ title: row.title, data: row.data })),
      seen: seen.map((event) => ({ ...event })),
      reported,
    }, {
      emptyTitle: { name: "Error", message: "[NotificationService] notification.title is required" },
      first: { title: "Deploy finished", body: "Build #42 deployed", category: "general", priority: "normal", source: "agent", readAt: null, agentId, nativeSequence: 1 },
      stored: { version: 2, epoch: true, sequence: 1, coordinates: { [first.id]: 1 }, rows: [{ id: first.id, title: "Deploy finished", body: "Build #42 deployed", data: { build: { id: 42 } }, createdAt: true }] },
      listed: [{ title: "Deploy finished", data: { build: { id: 42 } } }],
      seen: [
        { stream: "notification", type: "notification", title: "Deploy finished" },
        { stream: "error", type: "error", message: "listener boom" },
        { stream: "error", type: "error", message: "listener boom 2" },
        { stream: "error", type: "warning", message: "2 event listener(s) threw exceptions" },
      ],
      reported: [
        { scope: "AgentEventService.listener", context: { stream: "notification", runId: first.id } },
        { scope: "AgentEventService.listener", context: { stream: "notification", runId: first.id } },
      ],
    }))
    stopThrowing()
    stopSecondThrowing()
    seen.length = 0

    const grouped = [
      try host(() => inbox.notify({ title: "Build 1", groupKey: "builds" })),
      try host(() => inbox.notify({ title: "Build 2", groupKey: "builds" })),
      try host(() => inbox.notify({ title: "Build 3", groupKey: "builds", data: { count: 9 } })),
      try host(() => inbox.notify({ title: "Build 4", groupKey: "builds" })),
    ]
    try host(() => inbox.notify({ title: "Stale 1", groupKey: "stale", expiresAt: Date.now() + 1000 }))
    const visibleBeforeExpiry = shown(inbox.list())
    try sleep(1200)
    const visibleAfterExpiry = shown(inbox.list())
    const fresh = try host(() => inbox.notify({ title: "Stale 2", groupKey: "stale" }))
    const routine = try host(() => inbox.notify({ title: "Routine", category: "system" }))
    const kept = try host(() => inbox.notify({ title: "Kept", category: "system", expiresAt: null }))
    const order = inbox.listIncludingExpired().map((row) => [row.id, row.nativeSequence])
    const groupReads = [
      try host(() => inbox.markReadByGroupKey("builds")),
      try host(() => inbox.markReadByGroupKey("builds")),
      try host(() => inbox.markReadByGroupKey("")),
    ]
    const durable = (try host(() => runtime.getCache<NotificationInboxSnapshot>(key)))!
    // spec/core/notifications/index.md, "Story: Preserve notification group and expiry policy"
    try Effect.try(() => assert.deepStrictEqual({
      counts: grouped.map((row) => row.data),
      builds: inbox.list().filter((row) => row.groupKey === "builds").map((row) => ({ title: row.title, read: row.readAt !== null, data: row.data })),
      regrouped: [new Set(grouped.map((row) => row.id)).size, grouped.every((row, i) => i === 0 || row.nativeSequence! > grouped[i - 1].nativeSequence!), grouped[3].readAt],
      visibleBeforeExpiry,
      visibleAfterExpiry,
      fresh: fresh.data,
      durableTitles: shown(durable.notifications),
      routine: [routine.priority, routine.expiresAt! - routine.createdAt],
      kept: [kept.priority, kept.expiresAt],
      groupReads,
      orderKept: inbox.listIncludingExpired().map((row) => [row.id, row.nativeSequence]),
      unread: inbox.getUnreadCount(),
    }, {
      counts: [undefined, { count: 2 }, { count: 9 }, { count: 10 }],
      builds: [{ title: "Build 4", read: true, data: { count: 10 } }],
      regrouped: [4, true, null],
      visibleBeforeExpiry: ["Stale 1", "Build 4", "Deploy finished"],
      visibleAfterExpiry: ["Build 4", "Deploy finished"],
      fresh: undefined,
      durableTitles: ["Deploy finished", "Build 4", "Stale 2", "Routine", "Kept"],
      routine: ["low", 86_400_000],
      kept: ["low", null],
      groupReads: [1, 0, 0],
      orderKept: order,
      unread: 2,
    }))
    seen.length = 0

    const writeFailure = new Error("cache write refused")
    try Effect.try(() => adapter.fault("setCaches", { reject: writeFailure }))
    const refused = try Effect.flip(host(() => inbox.notify({ title: "Refused write" })))
    try Effect.try(() => adapter.fault("setCaches", { resolve: false }))
    const unacknowledged = failureOf(try Effect.flip(host(() => inbox.notify({ title: "Unacknowledged write" }))))
    const rereadFailure = new Error("cache read refused")
    try Effect.try(() => adapter.fault("setCaches", { reject: writeFailure }))
    try Effect.try(() => adapter.fault("getCaches", { reject: rereadFailure }))
    const ambiguous = try Effect.flip(host(() => inbox.notify({ title: "Unreconciled write" })))
    const fenced = failureOf(try Effect.flip(host(() => inbox.listNativePage())))
    const reconciled = try host(() => inbox.notify({ title: "After reconciliation" }))
    const afterFaults = (try host(() => runtime.getCache<NotificationInboxSnapshot>(key)))!
    // spec/core/notifications/index.md, "Acknowledgement publishes success while ambiguity requires reconciliation"
    try Effect.try(() => assert.deepStrictEqual({
      refused: refused === writeFailure,
      unacknowledged,
      ambiguous: ambiguous instanceof AggregateError ? { message: ambiguous.message, writeFirst: ambiguous.errors[0] === writeFailure, readSecond: ambiguous.errors[1] === rereadFailure } : failureOf(ambiguous),
      fenced,
      reconciled: reconciled.title,
      durableTitles: shown(afterFaults.notifications),
      memoryTitles: shown(inbox.listIncludingExpired()).reverse(),
      seen: seen.map((event) => ({ ...event })),
    }, {
      refused: true,
      unacknowledged: { name: "Error", message: "[NotificationService] notification cache persistence was rejected" },
      ambiguous: { message: "notification persistence and reconciliation failed", writeFirst: true, readSecond: true },
      fenced: { name: "NotificationNativeError", code: "NOTIFICATION_INBOX_UNAVAILABLE", status: 503, message: "Notification inbox is not durably available" },
      reconciled: "After reconciliation",
      durableTitles: ["Deploy finished", "Build 4", "Stale 2", "Routine", "Kept", "After reconciliation"],
      memoryTitles: ["Deploy finished", "Build 4", "Stale 2", "Routine", "Kept", "After reconciliation"],
      seen: [{ stream: "notification", type: "notification", title: "After reconciliation" }],
    }))

    try host(() => inbox.clear())
    seen.length = 0
    const low = try host(() => inbox.notify({ title: "Read", priority: "low" }))
    const gone = try host(() => inbox.notify({ title: "Deleted" }))
    const later = try host(() => inbox.notify({ title: "Expires later", expiresAt: Date.now() + 60_000 }))
    const firstMark = try host(() => inbox.markRead(low.id))
    const firstRemoval = try host(() => inbox.remove(gone.id))
    const noWrite = new Error("no write expected")
    try Effect.try(() => adapter.fault("setCaches", { reject: noWrite }))
    const marks = [firstMark, try host(() => inbox.markRead(low.id))]
    const firstPage = try host(() => inbox.listNativePage({ limit: 1 }))
    const removals = [firstRemoval, try host(() => inbox.remove(gone.id))]
    const witness = try Effect.flip(host(() => inbox.notify({ title: "Consumes the armed fault" })))
    const afterFence = try host(() => inbox.notify({ title: "After captured fence" }))
    const rest = try host(() => inbox.listNativePage({ nativeEpoch: firstPage.nativeEpoch, afterSequence: firstPage.nextSequence, throughSequence: firstPage.throughSequence, limit: 1 }))
    const allRead = [try host(() => inbox.markAllRead()), try host(() => inbox.markAllRead())]
    // spec/core/notifications/cursor.md, "Story: Page a fixed notification snapshot without skipping unreadable rows"
    try Effect.try(() => assert.deepStrictEqual({
      marks,
      noOpsWroteNothing: witness === noWrite,
      firstPage: { ids: firstPage.notifications.map((row) => row.id), read: firstPage.notifications[0].readAt !== null, complete: firstPage.complete },
      removals,
      rest: { ids: rest.notifications.map((row) => row.id), complete: rest.complete, nextIsFence: rest.nextSequence === firstPage.throughSequence, fence: rest.throughSequence === firstPage.throughSequence },
      afterFenceBeyond: afterFence.nativeSequence! > rest.throughSequence,
      allRead,
      unread: inbox.getUnreadCount(),
      seen: seen.map((event) => ({ ...event })),
    }, {
      marks: [true, false],
      noOpsWroteNothing: true,
      firstPage: { ids: [low.id], read: true, complete: false },
      removals: [true, false],
      rest: { ids: [later.id], complete: true, nextIsFence: true, fence: true },
      afterFenceBeyond: true,
      allRead: [2, 0],
      unread: 0,
      seen: [
        { stream: "notification", type: "notification", title: "Read" },
        { stream: "notification", type: "notification", title: "Deleted" },
        { stream: "notification", type: "notification", title: "Expires later" },
        { stream: "notification", type: "notification_update", title: "Read" },
        { stream: "notification", type: "notification_update", title: "Deleted", removed: true },
        { stream: "notification", type: "notification", title: "After captured fence" },
        { stream: "notification", type: "notification_update", title: "Expires later" },
        { stream: "notification", type: "notification_update", title: "After captured fence" },
      ],
    }))
    stopRecording()
    seen.length = 0
    const page = try host(() => inbox.listNativePage())
    return { titles: shown(inbox.listIncludingExpired()), page }
  })

  // spec/core/notifications/startup.md, "Story: Publish a notification service only after durable hydration"; spec/core/notifications/startup.md, "Hydration validates every row and the complete coordinate map"
  try Effect.scoped(effect {
    const runtime = try kernel({ store, agentId, label: "b", plugins: services([AgentEventService]) })
    const adapter = runtime.adapter as unknown as SqliteAdapter
    const events = (try host(() => runtime.getServiceLoadPromise(ServiceType.AGENT_EVENT))) as AgentEventService
    const stopRecording = events.subscribe(record)
    const gate = Promise.withResolvers<void>()
    try Effect.try(() => adapter.fault("getCaches", { gate: gate.promise }))
    const registering = fork host(() => runtime.registerPlugin({ name: "notify-the-owner-inbox", description: "Notification inbox", services: [NotificationService] }))
    try Effect.repeat(Effect.sync(() => runtime.getServiceRegistrationStatus(ServiceType.NOTIFICATION)), { schedule: Schedule.spaced("1 millis"), until: (status) => status === "registering" })
    const whileLoading = [runtime.getService(ServiceType.NOTIFICATION), runtime.getServiceRegistrationStatus(ServiceType.NOTIFICATION), NotificationService.getAvailability(runtime)]
    gate.resolve()
    try Fiber.join(registering)
    const inbox = (try host(() => runtime.getServiceLoadPromise(ServiceType.NOTIFICATION))) as NotificationService
    const restarted = { titles: shown(inbox.listIncludingExpired()), page: try host(() => inbox.listNativePage()) }

    const legacy = [
      { id: "10000000-0000-0000-0000-000000000001", title: "First stored", body: "  exact  ", category: "reminder", priority: "high", source: "fixture", createdAt: 500, data: { secret: "kept" } },
      { id: "10000000-0000-0000-0000-000000000002", title: "Second stored", category: "general", priority: "normal", source: "fixture", createdAt: 1, expiresAt: 0 },
    ]
    try host(() => runtime.setCache(key, legacy))
    try Effect.try(() => adapter.fault("setCaches", { resolve: false }))
    const unmigrated = failureOf(try Effect.flip(host(() => NotificationService.start(runtime))))
    const keptLegacy = try host(() => runtime.getCache(key))
    const migrated = (try host(() => NotificationService.start(runtime))) as NotificationService
    const migratedPage = try host(() => migrated.listNativePage())
    const migratedRows = (try host(() => runtime.getCache<NotificationInboxSnapshot>(key)))!.notifications
    const noWrite = new Error("no write expected")
    try Effect.try(() => adapter.fault("setCaches", { reject: noWrite }))
    const again = (try host(() => NotificationService.start(runtime))) as NotificationService
    const againPage = try host(() => again.listNativePage())
    const faultStillArmed = (try Effect.flip(host(() => runtime.setCache(key, legacy)))) === noWrite
    const rebroadcast = seen.map((event) => ({ ...event }))

    const draining = try Effect.try(() => migrated.notify({ title: "Queued before close" }))
    const closing = try Effect.try(() => migrated.stop())
    const lateWrite = failureOf(try Effect.flip(host(() => migrated.notify({ title: "After close" }))))
    const lateRead = failureOf(try Effect.flip(host(() => migrated.listNativePage())))
    try host(() => closing)
    const durableAtClose = (try host(() => runtime.getCache<NotificationInboxSnapshot>(key)))!.notifications.some((row) => row.title === "Queued before close")
    const drained = (try host(() => draining)).title
    try host(() => again.stop())

    try host(() => runtime.setCache(key, [legacy[0], legacy[0]]))
    const duplicate = failureOf(try Effect.flip(host(() => NotificationService.start(runtime))))
    const readFailure = new Error("cache read refused at start")
    try Effect.try(() => adapter.fault("getCaches", { reject: readFailure }))
    const unreadable = (try Effect.flip(host(() => NotificationService.start(runtime)))) === readFailure

    try host(() => runtime.setCache(key, { version: 2, nativeEpoch: before.page.nativeEpoch, nativeSequence: 1, notifications: [{ id: "20000000-0000-0000-0000-000000000001", title: "Out of range" }], nativeSequences: { "20000000-0000-0000-0000-000000000001": 2 } }))
    const malformed = failureOf(try Effect.flip(host(() => NotificationService.start(runtime))))
    stopRecording()
    try Effect.try(() => assert.deepStrictEqual({
      whileLoading,
      restarted: { titles: restarted.titles, page: restarted.page },
      rebroadcast,
      unmigrated,
      keptLegacy,
      migratedPage: migratedPage.notifications.map((row) => [row.title, row.nativeSequence]),
      migratedRows,
      againPage,
      faultStillArmed,
      closed: { durableAtClose, drained, lateWrite, lateRead },
      duplicate,
      unreadable,
      malformed,
    }, {
      whileLoading: [null, "registering", "registering"],
      restarted: before,
      rebroadcast: [],
      unmigrated: { name: "Error", message: "[NotificationService] notification cache persistence was rejected" },
      keptLegacy: legacy,
      migratedPage: [["First stored", 1], ["Second stored", 2]],
      migratedRows: legacy,
      againPage: migratedPage,
      faultStillArmed: true,
      closed: {
        durableAtClose: true,
        drained: "Queued before close",
        lateWrite: { name: "Error", message: "[NotificationService] notification write rejected: service is stopped" },
        lateRead: { name: "NotificationNativeError", code: "NOTIFICATION_INBOX_UNAVAILABLE", status: 503, message: "Notification inbox is not durably available" },
      },
      duplicate: { name: "NotificationNativeError", code: "NOTIFICATION_INBOX_INVALID", status: 503, message: "Duplicate persisted notification id" },
      unreadable: true,
      malformed: { name: "NotificationNativeError", code: "NOTIFICATION_INBOX_INVALID", status: 503, message: "Invalid persisted notification coordinates" },
    }))
  })

  // spec/core/notifications/recovery.md, "Story: Retry a failed notification service without concurrent loaders"
  try Effect.scoped(effect {
    const runtime = try kernel({ store, agentId, label: "c", plugins: services([NotificationService]) })
    const startError = (try Effect.flip(host(() => runtime.getServiceLoadPromise(ServiceType.NOTIFICATION)))) as ElizaError
    const failedStart = { name: startError.name, message: startError.message, code: startError.code, cause: (startError.cause as AggregateError).errors.map((error: ElizaError) => ({ name: error.name, message: error.message, code: error.code, cause: failureOf(error.cause) })) }
    const failed = [runtime.getServiceRegistrationStatus(ServiceType.NOTIFICATION), NotificationService.getAvailability(runtime)]
    const persisted = { id: "00000000-0000-0000-0000-0000000000cc", title: "Recovered history", category: "general", priority: "normal", source: "test", createdAt: Date.now(), readAt: null }
    try host(() => runtime.setCache(key, [persisted]))
    const attempts = Array.from({ length: 8 }, () => NotificationService.requestRecovery(runtime).state)
    const recovered = (try host(() => runtime.getServiceLoadPromise(ServiceType.NOTIFICATION))) as NotificationService
    try Effect.try(() => assert.deepStrictEqual({
      failedStart,
      failed,
      attempts,
      recovered: shown(recovered.list()),
      registered: [runtime.getServiceRegistrationStatus(ServiceType.NOTIFICATION), NotificationService.getAvailability(runtime), runtime.getService(ServiceType.NOTIFICATION) === recovered],
    }, {
      failedStart: { name: "ElizaError", message: "Service notification not found or failed to start", code: "SERVICE_START_FAILED", cause: [{ name: "ElizaError", message: "Service notification failed to start", code: "SERVICE_START_FAILED", cause: { name: "NotificationNativeError", code: "NOTIFICATION_INBOX_INVALID", status: 503, message: "Invalid persisted notification coordinates" } }] },
      failed: ["failed", "failed"],
      attempts: ["started", "in-flight", "in-flight", "in-flight", "in-flight", "in-flight", "in-flight", "in-flight"],
      recovered: ["Recovered history"],
      registered: ["registered", "registered", true],
    }))
  })
}, 60_000)

// spec/core/oauth/index.md, "Story: Start authorization only after preserving its original state"; spec/core/oauth/index.md, "Story: Complete one authorization without reusing a consumed state"; spec/core/oauth/index.md, "A callback consumes a pending unexpired flow before provider work"; spec/core/oauth/verifiers.md, "Story: Use a one-time verifier only with its originating flow"; spec/core/connectorHandoff.md, "Story: Transfer complete fallback state before invoking the next backend"; spec/core/connectorStorage.md, "Story: Retain full account and flow values under exact identities"; spec/core/accountValues.md, "Story: Patch account policy without changing its durable identity"; spec/core/messaging.md, "Story: Dispatch through a selected connector account"; spec/core/connectorManagers.md, "Story: Resolve account providers through the correct manager"; spec/core/oauth/bridge.md, "Story: Preserve one-time flow ownership across durable and process state"
it.live("Connect a connector account through OAuth and send through it (spec/core/oauth/index.md, \"Story: Complete one authorization without reusing a consumed state\"; spec/core/connectorHandoff.md, \"Story: Transfer complete fallback state before invoking the next backend\"; spec/core/messaging.md, \"Story: Dispatch through a selected connector account\")", () => scoped(effect {
  const store = try storeAt("eliza-core-connect-an-account")
  let retired = false
  const runtime = try acquireRelease(
    Effect.try(() => new AgentRuntime({ character: createCharacter({ name: "Eliza" }) })),
    (open) => retired ? Effect.void : orDie(effect { try host(() => open.stop()); try host(() => open.close()) }),
  )
  const other = try acquireRelease(
    Effect.try(() => new AgentRuntime({ character: createCharacter({ name: "Other" }) })),
    (open) => orDie(host(() => open.stop())),
  )
  const google = try Effect.try(() => scriptedOAuthProvider({ name: " Google ", inventory: true }))
  const outlook = try Effect.try(() => scriptedOAuthProvider({ name: "outlook", ttlMs: 1 }))
  const storedBeforeProvider: unknown[] = []
  const startGoogle = google.provider.startOAuth
  const observing: ConnectorAccountProvider = {
    ...google.provider,
    startOAuth: async (request, manager) => {
      const stored = await manager.getOAuthFlow(request.provider, request.flow.state)
      storedBeforeProvider.push(stored && { id: stored.id, status: stored.status, authUrl: stored.authUrl ?? null })
      if (!startGoogle) throw new Error("scripted provider has no startOAuth")
      return startGoogle(request, manager)
    },
  }
  const exchanges = () => [...google.seen, ...outlook.seen].filter((call) => call.step === "completeOAuth").length

  // spec/core/connectorManagers.md, "A runtime cache preserves its manager while a compatible registered service takes precedence"
  const manager = getConnectorAccountManager(runtime)
  const registered = try Effect.try(() => manager.registerProvider(observing))
  try Effect.try(() => manager.registerProvider(outlook.provider))
  const managers = {
    cached: getConnectorAccountManager(runtime) === manager,
    distinct: getConnectorAccountManager(other) !== manager,
    registered,
    found: manager.getProvider("google")?.label,
    spelled: manager.getProvider(" GOOGLE ")?.provider,
    elsewhere: getConnectorAccountManager(other).getProvider("google") ?? null,
  }
  // spec/core/connectorHandoff.md, "Backend replacement preserves facade identity and memoizes each current adapter"
  const device = try Effect.try(() => new AgentRuntime({ character: createCharacter({ name: "Device" }) }))
  try Effect.try(() => device.registerDatabaseAdapter(Object.create(DatabaseAdapter.prototype)))
  const onDevice = getConnectorAccountManager(device)
  const deviceBot = try host(() => onDevice.upsertAccount("slack", { label: "Device" }, "device-bot"))
  const deviceAccounts = try host(() => onDevice.listAccounts("slack"))
  const dropbox = try Effect.try(() => scriptedOAuthProvider({ name: "dropbox" }))
  try Effect.try(() => onDevice.registerProvider(dropbox.provider))
  const deviceStart = try host(() => onDevice.startOAuth("dropbox", { accountId: "device-user" }))
  const deviceDone = try host(() => onDevice.completeOAuth("dropbox", dropbox.consent(deviceStart.authUrl ?? "", "device-user")))
  const deviceStored = try host(() => onDevice.getOAuthFlow("dropbox", deviceStart.id))
  const unsupported = {
    accounts: deviceAccounts.map((account) => [account.id, account.id === deviceBot.id]),
    flow: [(deviceStart.codeVerifier ?? "").length, deviceDone.flow.status, deviceDone.account?.id, deviceStored?.status, deviceStored?.codeVerifier ?? null],
  }
  const facade = manager.getStorage()
  // spec/core/accountValues.md, "Normalization preserves explicit values and applies only documented defaults"
  const team = try host(() => manager.upsertAccount("slack", { label: "", role: "SERVICE", purpose: ["messaging", " "] }, " team-bot "))
  // spec/core/oauth/index.md, "Persistence precedes provider initiation and failed cleanup retains both errors"
  const work = try host(() => manager.startOAuth("google", { accountId: "user-1", label: "Work", scopes: ["gmail.send"], redirectUri: "https://agent.test/oauth/callback" }))
  const workVerifier = work.codeVerifier ?? ""
  const started = {
    managers,
    unsupported,
    team: [team.id, team.provider, team.label, team.role, team.purpose, team.accessGate, team.status],
    storedBeforeProvider: [...storedBeforeProvider],
    flow: [work.provider, work.status, work.accountId, work.redirectUri, work.authUrl?.startsWith("https://accounts.google.test/o/oauth2/auth?"), work.authUrl?.includes(`state=${work.state}`), workVerifier.length],
  }

  // spec/core/connectorHandoff.md, "The snapshot contains exact accounts and pending unexpired flows"
  const staleFallback = try host(() => manager.startOAuth("outlook", {}))
  try sleep("20 millis")

  // spec/core/connectorHandoff.md, "Backend replacement preserves facade identity and memoizes each current adapter"
  const adapter = try Effect.try(() => new SqliteAdapter(store, "a"))
  try Effect.try(() => runtime.registerDatabaseAdapter(adapter))
  try host(() => runtime.initialize({ skipMigrations: true }))
  // spec/core/connectorHandoff.md, "The snapshot contains exact accounts and pending unexpired flows"
  const teamAccounts = try host(() => manager.listAccounts("slack"))
  const teamByKey = try host(() => manager.getAccount("slack", "team-bot"))
  const teamRows = try host(() => adapter.listConnectorAccounts({ provider: "slack" }))
  const workRow = try host(() => adapter.getOAuthFlowState({ state: work.state, provider: "google" }))
  const staleRow = try host(() => adapter.getOAuthFlowState({ state: staleFallback.state, provider: "outlook", includeConsumed: true, includeExpired: true }))
  // spec/core/oauth/index.md, "Persistence precedes provider initiation and failed cleanup retains both errors"; spec/core/oauth/verifiers.md, "Story: Use a one-time verifier only with its originating flow"
  const insertFailure = new Error("the database refused the OAuth flow")
  try Effect.try(() => adapter.fault("createOAuthFlowState", { reject: insertFailure }))
  const refusedStart = try Effect.flip(host(() => manager.startOAuth("google", { accountId: "user-3" })))
  const afterRefusedStart = [refusedStart === insertFailure, storedBeforeProvider.length, google.seen.filter((call) => call.step === "startOAuth").length]
  const personal = try host(() => manager.startOAuth("google", { accountId: "user-2", label: "Personal", scopes: ["gmail.send"] }))
  const personalRow = try host(() => adapter.getOAuthFlowState({ state: personal.state, provider: "google" }))
  const moved = {
    facade: manager.getStorage() === facade,
    manager: getConnectorAccountManager(runtime) === manager,
    accounts: teamAccounts.map((account) => [account.accountKey, account.id === teamByKey?.id, keyless(account)]),
    rows: teamRows.map((row) => [row.provider, row.accountKey, row.displayName, row.role]),
    staleRow,
    workRow: workRow && [workRow.metadata.flowId, workRow.metadata.status, workRow.metadata.hasCodeVerifier, workRow.consumedAt, JSON.stringify(workRow).includes(workVerifier)],
    refusedStart: afterRefusedStart,
    personalRow: personalRow && [personalRow.codeVerifierRef, personal.metadata?.codeVerifierRef, (personal.codeVerifier ?? "").length, JSON.stringify(personalRow).includes(personal.codeVerifier ?? "")],
  }

  const expiring = try host(() => manager.startOAuth("outlook", {}))
  const denied = try host(() => manager.startOAuth("google", { accountId: "user-9" }))
  const expiringCallback = try Effect.try(() => outlook.consent(expiring.authUrl ?? ""))
  try sleep("20 millis")
  // spec/core/oauth/index.md, "A callback consumes a pending unexpired flow before provider work"
  const workCallback = try Effect.try(() => google.consent(work.authUrl ?? "", "user-1"))
  const workDone = try host(() => manager.completeOAuth("google", workCallback))
  const afterWork = exchanges()
  const replayed = try Effect.flip(host(() => manager.completeOAuth("google", workCallback)))
  const expired = try Effect.flip(host(() => manager.completeOAuth("outlook", expiringCallback)))
  const deniedCallback = try Effect.try(() => google.deny(denied.authUrl ?? ""))
  const refusal = try host(() => manager.completeOAuth("google", deniedCallback))
  const afterRefusals = exchanges()
  const deniedRow = try host(() => adapter.getOAuthFlowState({ state: denied.state, provider: "google", includeConsumed: true, includeExpired: true }))
  // spec/core/oauth/bridge.md, "Mirror mutation precedes optional durable calls and captured results remain stable"
  const personalCallback = try Effect.try(() => google.consent(personal.authUrl ?? "", "user-2"))
  const consumeFailure = new Error("the database lost the connection while consuming")
  try Effect.try(() => adapter.fault("consumeOAuthFlowState", { reject: consumeFailure }))
  const faulted = try Effect.flip(host(() => manager.completeOAuth("google", personalCallback)))
  try Effect.try(() => adapter.fault("consumeOAuthFlowState", { resolve: null }))
  const absent = try Effect.flip(host(() => manager.completeOAuth("google", personalCallback)))
  const afterFaults = exchanges()
  const personalDone = try host(() => manager.completeOAuth("google", personalCallback))
  const workAccount = workDone.account
  const personalAccount = personalDone.account
  const workId = workAccount?.id ?? ""
  const personalId = personalAccount?.id ?? ""
  const reread = try host(() => manager.getAccount("google", workId))
  const refused = (failure: unknown) => [failure instanceof Error, failure instanceof ElizaError, (failure as Error).message]
  const callbacks = {
    work: [workDone.flow.id === work.id, workDone.flow.state === work.state, workDone.flow.status, workDone.flow.accountId === workId, workDone.redirectUrl],
    account: workAccount && {
      provider: workAccount.provider,
      accountKey: workAccount.accountKey,
      label: workAccount.label,
      role: workAccount.role,
      purpose: workAccount.purpose,
      accessGate: workAccount.accessGate,
      status: workAccount.status,
      externalId: workAccount.externalId,
      displayHandle: workAccount.displayHandle,
      metadata: workAccount.metadata,
      uuid: /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(workId),
    },
    reread,
    exchanges: [afterWork, afterRefusals, afterFaults, exchanges()],
    replayed: refused(replayed),
    expired: refused(expired),
    refusal: [refusal.flow.id === denied.id, refusal.flow.status, refusal.flow.error, refusal.account ?? null],
    deniedRow: deniedRow && [deniedRow.metadata.status, deniedRow.consumedAt !== null],
    faulted: faulted === consumeFailure,
    absent: refused(absent),
    personal: [personalDone.flow.status, personalAccount?.accountKey, personalAccount?.label, personalId !== workId],
  }

  // spec/core/accountValues.md, "Provider refresh preserves stored identity and protected policy fields"
  const disabled = try host(() => manager.patchAccount("google", workId, { status: "disabled" }))
  const listed = try host(() => manager.listAccounts("google"))
  const workPolicy = try host(() => manager.evaluatePolicy({ provider: "google" }, { accountId: workId }))
  const personalPolicy = try host(() => manager.evaluatePolicy({ provider: "google" }, { accountId: personalId }))
  const patched = {
    identity: disabled && [disabled.id === workId, disabled.accountKey, disabled.externalId, disabled.createdAt === workAccount?.createdAt, disabled.status],
    listed: Object.fromEntries(listed.map((account) => [account.accountKey, [account.status, account.id === (account.accountKey === "user-1" ? workId : personalId)]])),
    policies: [workPolicy.allowed, workPolicy.reason, personalPolicy.allowed, personalPolicy.account?.id === personalId],
  }

  // spec/core/messaging.md, "Send routing and hook routing have distinct fallback rules"
  const deliveries: unknown[] = []
  try Effect.try(() => runtime.registerSendHandler("gmail", (_runtime, target, content) => {
    deliveries.push(["default", target.accountId === workId, content.text])
    return Promise.resolve()
  }))
  try Effect.try(() => runtime.registerMessageConnector({
    source: "gmail",
    accountId: personalId,
    sendHandler: (_runtime, target, content) => {
      deliveries.push(["personal", target.accountId === personalId, target.channelId, content.text])
      return Promise.resolve()
    },
  }))
  try host(() => runtime.sendMessageToTarget({ source: "gmail", accountId: personalId, channelId: "inbox" }, { text: "Hello from the personal account", agentVoiced: true }))
  try host(() => runtime.sendMessageToTarget({ source: "gmail", accountId: workId }, { text: "Hello from the work account", agentVoiced: true }))
  const unrouted = try Effect.flip(host(() => runtime.sendMessageToTarget({ source: "outlook", accountId: workId }, { text: "Nobody carries this", agentVoiced: true })))
  const sent = { deliveries, unrouted: [unrouted instanceof ElizaError, (unrouted as ElizaError).code] }

  try host(() => runtime.stop())
  try host(() => runtime.close())
  retired = true
  const restarted = try kernel({ store, label: "b", agentId: runtime.agentId })
  const reloaded = getConnectorAccountManager(restarted)
  try Effect.try(() => reloaded.registerProvider(observing))
  const accounts = try host(() => reloaded.listAccounts("google"))
  const finished = try host(() => reloaded.getOAuthFlow("google", work.id))
  const replayedAfterRestart = try Effect.flip(host(() => reloaded.completeOAuth("google", workCallback)))
  // spec/core/oauth/verifiers.md, "Story: Use a one-time verifier only with its originating flow"; spec/core/oauth/index.md, "A callback consumes a pending unexpired flow before provider work"
  const beforeChild = exchanges()
  const child = try host(() => runNode({ script: startInChild, args: [store.path, runtime.agentId], vibe: true, timeoutMs: 120_000 }))
  const fromChild = try Effect.try(() => JSON.parse(child.stdout.split("\n").find((line) => line.startsWith("{\"id\"")) ?? "null") as { id: string; callback: { state: string; code: string; query: Record<string, string> } })
  const lost = try host(() => reloaded.completeOAuth("google", fromChild.callback))
  const lostStored = try host(() => reloaded.getOAuthFlow("google", fromChild.id))
  const restart = {
    manager: reloaded !== manager,
    accounts: Object.fromEntries(accounts.map((account) => [account.accountKey, [account.id, account.status, account.label]])),
    finished: finished && [finished.id === work.id, finished.status, finished.accountId === workId],
    replayed: refused(replayedAfterRestart),
    lost: [child.status, lost.flow.id === fromChild.id, lost.flow.status, lost.flow.error, lost.account ?? null, lostStored?.status, exchanges() - beforeChild],
    exchanges: exchanges(),
    closeLog: [...store.closeLog],
  }

  const unknownFlow = [true, false, "Unknown, expired, or already used OAuth flow state"]
  const grant = google.grants.get("user-1")
  try Effect.try(() => assert.deepStrictEqual({ started, moved, callbacks, patched, sent, restart }, {
    started: {
      managers: {
        cached: true,
        distinct: true,
        registered: { provider: "google", messageConnectorRegistered: false, messageConnectorSkipped: false, postConnectorRegistered: false, postConnectorSkipped: false },
        found: "Scripted Google OAuth",
        spelled: "google",
        elsewhere: null,
      },
      unsupported: { accounts: [["device-bot", true]], flow: [43, "completed", "device-user", "completed", null] },
      team: ["team-bot", "slack", "", "AGENT", ["messaging"], "open", "connected"],
      storedBeforeProvider: [{ id: work.id, status: "pending", authUrl: null }],
      flow: ["google", "pending", "user-1", "https://agent.test/oauth/callback", true, true, 43],
    },
    moved: {
      facade: true,
      manager: true,
      accounts: [["team-bot", true, { ...keyless(team), metadata: {} }]],
      rows: [["slack", "team-bot", "", "AGENT"]],
      staleRow: null,
      workRow: [work.id, "pending", true, null, false],
      refusedStart: [true, 1, 1],
      personalRow: [`connector-oauth-pkce:google:${personal.id}`, `connector-oauth-pkce:google:${personal.id}`, 43, false],
    },
    callbacks: {
      work: [true, true, "completed", true, undefined],
      account: {
        provider: "google",
        accountKey: "user-1",
        label: "Work",
        role: "OWNER",
        purpose: ["messaging"],
        accessGate: "open",
        status: "connected",
        externalId: "user-1",
        displayHandle: "@user-1",
        metadata: { scopes: ["gmail.send"], grant: { issuedAt: grant?.issuedAt, tokenType: "Bearer" } },
        uuid: true,
      },
      reread: workAccount,
      exchanges: [1, 1, 1, 2],
      replayed: unknownFlow,
      expired: unknownFlow,
      refusal: [true, "failed", "The user denied access", null],
      deniedRow: ["failed", true],
      faulted: true,
      absent: unknownFlow,
      personal: ["completed", "user-2", "Personal", true],
    },
    patched: {
      identity: [true, "user-1", "user-1", true, "disabled"],
      listed: { "user-1": ["disabled", true], "user-2": ["connected", true] },
      policies: [false, "status disabled is not allowed", true, true],
    },
    sent: {
      deliveries: [
        ["personal", true, "inbox", "Hello from the personal account"],
        ["default", true, "Hello from the work account"],
      ],
      unrouted: [true, "SEND_HANDLER_NOT_FOUND"],
    },
    restart: {
      manager: true,
      accounts: { "user-1": [workId, "disabled", "Work"], "user-2": [personalId, "connected", "Personal"] },
      finished: [true, "completed", true],
      replayed: unknownFlow,
      lost: [0, true, "failed", "This authorization link was created before the agent restarted, so its one-time PKCE secret no longer exists. Start the OAuth flow again and use the fresh link.", null, "failed", 0],
      exchanges: 2,
      closeLog: ["a"],
    },
  }))
}), 180_000)

// spec/core/logging/index.md, "Story: Retain recent diagnostics and notify current listeners"; spec/core/security.md, "Story: Admit content and outbound data"; spec/core/security.md, "A secret never appears in a log line"
it.live("Retain recent diagnostics and redact secrets in log listeners (spec/core/logging/index.md, \"Story: Retain recent diagnostics and notify current listeners\"; spec/core/security.md, \"Story: Admit content and outbound data\")", () => effect {
  const time = /\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z/g
  const heard: Array<[number | undefined, string]> = []
  const listener = (entry: LogEntry) => {
    heard.push([entry.level, entry.msg])
  }
  addLogListener(listener)
  const log = createLogger({ level: "info", namespace: "j12" })
  log.info("first")
  log.warn({ apiKey: "sk-j12-in-process-0123456789" }, "second")
  removeLogListener(listener)
  log.info("third")
  const recent = recentLogs().split("\n").slice(-3).map((line) => line.replace(time, "<time>"))
  try Effect.try(() => assert.deepStrictEqual({ heard, recent }, {
    heard: [[30, "#j12  first"], [40, "#j12  second (apiKey=[REDACTED])"]],
    recent: ["<time> info #j12  first", "<time> warn #j12  second (apiKey=[REDACTED])", "<time> info #j12  third"],
  }))
}, 30_000)

// spec/core/voice.md, "Story: Interrupt one voice turn across its consumers"; spec/core/voice.md, "Reason ownership precedes unlinking and signal abortion follows callbacks"; spec/core/voiceRegistry.md, "Story: Replace and cancel the active voice turn by room"; spec/core/outboundStyle.md, "Story: Reuse scoped rephrasing while retaining original text on failure"; spec/core/outboundStyle.md, "Cache hits move to most recent and capacity evicts only the oldest key"
it.live("Speak a reply and interrupt it (spec/core/voice.md, \"Story: Interrupt one voice turn across its consumers\"; spec/core/voiceRegistry.md, \"Story: Replace and cancel the active voice turn by room\"; spec/core/outboundStyle.md, \"Story: Reuse scoped rephrasing while retaining original text on failure\")", () => scoped(effect {
  let arrivals = 0
  const bothRequests = Deferred.makeUnsafe<void>()
  const server = try acquireRelease(host(() => loopback(() => { arrivals += 1; if (arrivals === 2) Deferred.doneUnsafe(bothRequests, Exit.void) })), (open) => orDie(host(() => open.close())))
  const voiced = (params: unknown) => `Voiced ${(params as { prompt: string }).prompt.split("Message to rewrite:\n")[1]?.split("\n")[0] ?? ""}`
  const models = try Effect.try(() => scriptedModels("voice-provider", 10, {
    [ModelType.TEXT_LARGE]: [{ fetch: server.url("127.0.0.1", "/large") }],
    [ModelType.TEXT_TO_SPEECH]: [{ fetch: server.url("127.0.0.1", "/speech") }],
    [ModelType.TEXT_SMALL]: [{ reply: voiced }, { reply: voiced }, { fail: new Error("rephrase unavailable") }, { reply: voiced }],
  }))
  const run = try Random.nextInt
  const runtime = try kernel({ plugins: [models.plugin], agentId: try Effect.try(() => stringToUuid(`j13-speaker-${run}`)) })
  const peer = try kernel({ plugins: [models.plugin], agentId: try Effect.try(() => stringToUuid(`j13-peer-${run}`)) })
  const registry = new VoiceCancellationRegistry()
  const room = "room-voice"
  const token = registry.arm(room, { runId: "turn-1", slot: 0 })
  const large = try fork(host(() => runtime.useModel(ModelType.TEXT_LARGE, { prompt: "Tell me a story", signal: token.signal })))
  const speech = try fork(host(() => runtime.useModel(ModelType.TEXT_TO_SPEECH, { text: "Sure, here it is.", signal: token.signal })))

  // spec/core/outboundStyle.md, "Cache hits move to most recent and capacity evicts only the oldest key"
  const voice = (text: string, source: string) => host(() => ensureAgentVoice(runtime, { text }, { source }))
  const rewrites = [
    try voice("Sure, here it is.", "discord"),
    try voice("Sure, here it is.", "discord"),
    try voice("Sure, here it is.", "telegram"),
    try voice("The weather is 12 degrees.", "discord"),
    try host(() => ensureAgentVoice(peer, { text: "Sure, here it is." }, { source: "discord" })),
    try voice("Sure, here it is.", "discord"),
  ]
  const smallCalls = () => models.seen.filter((call) => call.modelType === ModelType.TEXT_SMALL).length
  const afterRewrites = smallCalls()
  for (let index = 0; index < 499; index++) try voice(`Filler reply ${index}.`, "discord")
  const afterFill = smallCalls()
  const survivors = [try voice("Sure, here it is.", "discord"), try voice("Sure, here it is.", "telegram")]
  const afterSurvivors = smallCalls()

  try Deferred.await(bothRequests)
  // spec/core/voice.md, "Reason ownership precedes unlinking and signal abortion follows callbacks"
  const deliveries: unknown[] = []
  token.onAbort(() => { deliveries.push("inference-unsubscribed") })()
  let stopPlayback: () => void = () => undefined
  token.onAbort((reason) => {
    deliveries.push(["planning", reason, token.aborted, token.reason, token.signal.aborted])
    stopPlayback()
    token.abort("user-cancel")
  })
  stopPlayback = token.onAbort((reason) => { deliveries.push(["playback", reason, token.aborted, token.signal.aborted]) })
  const twice = (reason: string) => { deliveries.push(["twice", reason]) }
  const oldDisposer = token.onAbort(twice)
  token.onAbort(twice)
  oldDisposer()
  const interrupted = registry.abort(room, "barge-in")
  token.onAbort((reason) => { deliveries.push(["late", reason, token.aborted, token.signal.aborted]) })
  const lateAtOnce = deliveries.length
  const largeExit = try Fiber.await(large)
  const speechExit = try Fiber.await(speech)
  try host(() => server.socketClosed(0))
  try host(() => server.socketClosed(1))
  const failureName = (outcome: Exit.Exit<unknown, unknown>) => Exit.isFailure(outcome) ? (Cause.squash(outcome.cause) as { name?: string }).name : "resolved"
  const providerSignals = models.seen
    .filter((call) => call.modelType !== ModelType.TEXT_SMALL)
    .map((call) => [call.modelType, (call.params as { signal?: AbortSignal }).signal?.aborted])
  const interruption = {
    interrupted,
    reason: token.reason,
    runId: token.runId,
    slot: token.slot,
    signalAborted: token.signal.aborted,
    deliveries,
    lateAtOnce,
    current: registry.current(room),
    again: registry.abort(room, "timeout"),
    outcomes: [failureName(largeExit), failureName(speechExit)],
    providerSignals,
    sockets: server.requests.map((request) => [request.path, request.closed]).sort(),
  }

  // spec/core/voiceRegistry.md, "Story: Replace and cancel the active voice turn by room"
  const replaced = registry.arm(room, { runId: "turn-2" })
  const other = registry.arm("room-other", { runId: "turn-3" })
  const duringReplace: unknown[] = []
  replaced.onAbort((reason) => { duringReplace.push([reason, registry.current(room), registry.activeRoomIds()]) })
  const replacement = registry.arm(room, { runId: "turn-4" })
  const turn = new AbortController()
  const linked = registry.arm("room-linked", { runId: "turn-5", linkSignal: turn.signal })
  turn.abort()
  const dead = registry.arm("room-dead", { runId: "turn-6", linkSignal: AbortSignal.abort() })
  const currentIsReplacement = registry.current(room) === replacement
  const beforeAll = registry.activeRoomIds()
  const abortedAll = registry.abortAll("user-cancel")
  const handoff = {
    replacedReason: replaced.reason,
    duringReplace,
    currentIsReplacement,
    linkedReason: linked.reason,
    linkedCurrent: registry.current("room-linked"),
    dead: [dead.reason, dead.aborted, dead.signal.aborted, registry.current("room-dead")],
    beforeAll,
    abortedAll,
    reasons: [other.reason, replacement.reason],
    active: registry.activeRoomIds(),
  }

  const reported = runtime.getRecentReportedErrors().filter((entry) => entry.scope === "voice-gate").map((entry) => [entry.scope, entry.context])
  try Effect.try(() => assert.deepStrictEqual({ rewrites, counts: [afterRewrites, afterFill, afterSurvivors], survivors, reported, interruption, handoff }, {
    rewrites: [
      { text: "Voiced Sure, here it is.", agentVoiced: true },
      { text: "Voiced Sure, here it is.", agentVoiced: true },
      { text: "Voiced Sure, here it is.", agentVoiced: true },
      { text: "The weather is 12 degrees." },
      { text: "Voiced Sure, here it is.", agentVoiced: true },
      { text: "Voiced Sure, here it is.", agentVoiced: true },
    ],
    counts: [4, 503, 504],
    survivors: [
      { text: "Voiced Sure, here it is.", agentVoiced: true },
      { text: "Voiced Sure, here it is.", agentVoiced: true },
    ],
    reported: [["voice-gate", { source: "discord", agentId: runtime.agentId }]],
    interruption: {
      interrupted: true,
      reason: "barge-in",
      runId: "turn-1",
      slot: 0,
      signalAborted: true,
      deliveries: [
        ["planning", "barge-in", true, "barge-in", false],
        ["playback", "barge-in", true, false],
        ["late", "barge-in", true, true],
      ],
      lateAtOnce: 3,
      current: null,
      again: false,
      outcomes: ["AbortError", "AbortError"],
      providerSignals: [[ModelType.TEXT_LARGE, true], [ModelType.TEXT_TO_SPEECH, true]],
      sockets: [["/large", true], ["/speech", true]],
    },
    handoff: {
      replacedReason: "external",
      duringReplace: [["external", null, ["room-other"]]],
      currentIsReplacement: true,
      linkedReason: "external",
      linkedCurrent: null,
      dead: ["external", true, true, null],
      beforeAll: ["room-other", room],
      abortedAll: ["room-other", room],
      reasons: ["user-cancel", "user-cancel"],
      active: [],
    },
  }))
}), 15_000)

// spec/core/context.md, "A recorded outcome is printed with only the fields a later step reads, under a legend fixed by its record kind"
it.effect('An expired proposal takes its preview\'s row and the legend says a never-ran reason answers only whether the request ran (spec/core/context.md, "A recorded outcome is printed with only the fields a later step reads, under a legend fixed by its record kind")', effect () => {
  const scope = "Past recorded outcomes only."
  const proposal = (id: string, ended: boolean) => normalizeEffectReceipt({
    receiptId: id,
    operation: "device.sms_compose",
    resource: { kind: "device.approval", id },
    artifacts: [],
    idempotency: { key: ended ? null : `device:${id}`, replayed: false },
    observedAt: "2026-11-20T21:15:04.179Z",
    ...(ended ? { outcome: "noop", reason: "Expired; it never ran." } : { outcome: "preview" }),
  })
  const record = (id: string, recordScope: string, outcomes: readonly (readonly [boolean, unknown])[]) => ({
    id,
    label: "runtime:historical_effects",
    stable: false,
    content: JSON.stringify({
      requestSourceEventId: "history:a",
      scope: recordScope,
      outcomes: outcomes.map(([success, receipt]) => ({ actionName: "PROPOSE_DEVICE_ACTION", success, receipt })),
    }),
  })
  const folded = compactHistoricalReceiptSegments([
    record("historical-effects:a", scope, [[true, proposal("p", false)], [true, proposal("q", false)]]),
    record("historical-proposal-terminal:p", "Authoritative later proposal state: expired. This supersedes the earlier preview of proposal p only.", [[false, proposal("p", true)]]),
  ])
  assert.deepStrictEqual(folded.map(({ id, label }) => [id, label]), [
    ["receipt_wire_1", "runtime:historical_receipt_encoding"],
    ["historical-effects:a", "runtime:historical_effects"],
  ])
  assert.deepStrictEqual(try Effect.try(() => JSON.parse(folded[0].content) as unknown), {
    id: "receipt_wire_1",
    encoding: "row=[requestSourceEventId,[[actionName,success,receipt],...]]; receipt=[shape,[operation,[resourceKind,resourceId],outcome]]; shape 1 adds reason, 2 adds [commitKind], 3 adds [failureCode,failureRetryable,failureAcceptance]; other receipts are objects. history:hN names history source hN. Values are exact. A preview records a proposal, not its completion; a later proposal state takes its place. A reason that says it never ran means the owner declined it or it expired: that answers whether the request ran, not what the resource holds now. Each [id,row] segment with this id holds one row under this scope at its own chronological position.",
    scope,
  })
  assert.deepStrictEqual(try Effect.try(() => JSON.parse(folded[1].content) as unknown), [
    "receipt_wire_1",
    [
      "history:a",
      [
        ["PROPOSE_DEVICE_ACTION", false, [1, ["device.sms_compose", ["device.approval", "p"], "noop", "Expired; it never ran."]]],
        ["PROPOSE_DEVICE_ACTION", true, [0, ["device.sms_compose", ["device.approval", "q"], "preview"]]],
      ],
    ],
  ])
  assert.isFalse(folded.some((segment) => segment.content.includes("Authoritative later proposal state")))
})

// spec/core/release.md, "Story: Install the replacement through existing npm entry points"; spec/core/release.md, "Every release check names the candidate it actually examined"; spec/core/packageExports.md, "Story: Preserve the imported core surface in the consumer build and the npm package"; spec/core/packageExports.md, "An admitted pack serves exactly the declared leaves, each free of host-only code"; spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/accountBridges.md, "Each bridge slot preserves the last installed object identity"; spec/core/ambientManagers.md, "Story: Share injected managers across bundled core copies"; spec/core/accountBridges.md, "Story: Install and clear shared account-selection contracts"; spec/core/catalog.md, "A valid runtime registration overrides its id and invalidates cached indexes"
it.live('the packed tarball installs, imports, compiles and shares state across copies (spec/core/release.md, "Story: Install the replacement through existing npm entry points"; spec/core/packageExports.md, "Story: Preserve the imported core surface in the consumer build and the npm package"; spec/core/valueGuards.md, "Plain records require the intrinsic object prototype or a null prototype")', () => effect {
  const movedToCoreNode = new Set([
