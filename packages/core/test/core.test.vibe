module traceBoundary {
  import { types } from "node:util"

  /** @throws {never} */
  export function throwOnRead({ failure }: { failure: Error }): () => never {
    return () => { throw failure }
  }

  /** @throws {never} */
  export function isProxy(value: unknown): boolean {
    return types.isProxy(value)
  }
}
import { isProxy, throwOnRead } from traceBoundary

module cryptoBoundary {
  import * as nodeCrypto from "node:crypto"

  /** @throws {never} */
  export function nodeCryptoModule(): unknown {
    return nodeCrypto
  }

  /** @throws {never} */
  export function nodeGlobal(): unknown {
    return globalThis
  }
}
import { nodeCryptoModule, nodeGlobal } from cryptoBoundary
