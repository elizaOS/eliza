{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"outDir": "./dist",
		"rootDir": "../../",
		"ignoreDeprecations": "6.0",
		"sourceMap": false,
		"inlineSourceMap": false,
		"typeRoots": [
			"../../node_modules/@types",
			"../../node_modules",
			"../../../node_modules/@types",
			"../../../node_modules"
		],
		"types": ["node"],
		"noEmit": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"skipLibCheck": true,
		"paths": {
			"@elizaos/core": ["./src/index.ts"],
			"@elizaos/common": ["../common/src/index.ts"]
		},
		"incremental": false
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"vitest.config.ts",
		"node_modules",
		"dist",
		"src/**/__tests__/**",
		"src/**/*.test.ts"
	]
}
