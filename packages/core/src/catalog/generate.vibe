// spec/core/catalog.md, "Story: Discover and register first-party capabilities"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import { Effect } from "effect"
import { Foreign, thrown } from "../edge.vibe"
import type { ElizaCuratedAppDefinition } from "./apps.vibe"
import { type RegistryEntry, registryEntrySchema } from "./schema.vibe"

export error RegistryClaimConflict { message: string }
export error InvalidRegistryEntryFile { message: string }
export error DuplicateRegistryId { message: string }

module node {
  import { execFileSync } from "node:child_process"
  import { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from "node:fs"
  import { createRequire } from "node:module"
  import { join } from "node:path"
  import { Effect } from "effect"
  import { Foreign } from "../edge.vibe"

  function onDisk<A>(run: () => A): Effect.Effect<A, Foreign> {
    return Effect.try({ try: run, catch: (cause) => new Foreign({ cause }) })
  }

  export const check = process.argv.includes("--check")

  /** @throws {never} */
  export function joinPath(...parts: string[]): string {
    return join(...parts)
  }

  /** @throws {never} */
  export function exists(path: string): boolean {
    return existsSync(path)
  }

  /** @throws {never} */
  export function listDirectory(dir: string): Effect.Effect<Array<{ name: string; isDirectory: boolean }>, Foreign> {
    return onDisk(() => readdirSync(dir, { withFileTypes: true }).map((dirent) => ({ name: dirent.name, isDirectory: dirent.isDirectory() })))
  }

  /** @throws {never} */
  export function readJsonFile(file: string): Effect.Effect<unknown, Foreign> {
    return onDisk(() => JSON.parse(readFileSync(file, "utf-8")) as unknown)
  }

  /** @throws {never} */
  export function readFileIfPresent(path: string): Effect.Effect<string, Foreign> {
    return onDisk(() => existsSync(path) && statSync(path).isFile() ? readFileSync(path, "utf-8") : "")
  }

  /** @throws {never} */
  export function writeFile(path: string, content: string): Effect.Effect<void, Foreign> {
    return onDisk(() => writeFileSync(path, content))
  }

  /** @throws {never} */
  export function biomeFormatJson(repoRoot: string, content: string, filePath: string): Effect.Effect<string, Foreign> {
    return onDisk(() => {
      const biomeBin = createRequire(join(repoRoot, "package.json")).resolve("@biomejs/biome/bin/biome")
      return execFileSync(process.execPath, [biomeBin, "format", `--stdin-file-path=${filePath}`], { input: content, encoding: "utf-8", maxBuffer: 64 * 1024 * 1024 })
    })
  }

  /** @throws {never} */
  export function exitFailed(): void {
    process.exit(1)
  }
}
import { biomeFormatJson, check, exists, exitFailed, joinPath, listDirectory, readFileIfPresent, readJsonFile, writeFile } from node

const HERE = import.meta.dirname
const REPO_ROOT = joinPath(HERE, "..", "..", "..", "..")
const CURATED_DIR = joinPath(HERE, "curated")
const GENERATED_PATH = joinPath(HERE, "generated.json")
const CURATED_DEFS_PATH = joinPath(HERE, "curated-app-definitions.json")
const CHANNEL_MAP_PATH = joinPath(HERE, "channel-plugin-map.json")
const PROVIDER_MAP_PATH = joinPath(HERE, "provider-plugin-map.json")
const SHORTID_MAP_PATH = joinPath(HERE, "short-id-plugin-map.json")

export function collectCuratedAppDefinitions(entries: RegistryEntry[]): ElizaCuratedAppDefinition[] {
  const curated: Array<{ entry: RegistryEntry; curatedApp: NonNullable<RegistryEntry["curatedApp"]> }> = []
  for (const entry of entries) {
    if (entry.curatedApp) curated.push({ entry, curatedApp: entry.curatedApp })
  }
  return curated
    .sort((a, b) => a.curatedApp.order - b.curatedApp.order || a.curatedApp.slug.localeCompare(b.curatedApp.slug))
    .map(({ entry, curatedApp }) => ({ slug: curatedApp.slug, canonicalName: entry.npmName ?? "", aliases: curatedApp.aliases }))
}

effect function collectClaimMap(entries: RegistryEntry[], label: string, claimedKeys: (entry: RegistryEntry) => Iterable<string>) {
  const map = new Map<string, string>()
  for (const e of entries) {
    if (!e.npmName) continue
    for (const key of claimedKeys(e)) {
      const existing = map.get(key)
      if (existing && existing !== e.npmName) {
        throw new RegistryClaimConflict({ message: `[registry/generate] ${label} "${key}" claimed by both ${existing} and ${e.npmName}` })
      }
      map.set(key, e.npmName)
    }
  }
  return Object.fromEntries([...map].sort(([a], [b]) => (a < b ? -1 : 1))) as Record<string, string>
}

export effect function collectChannelPluginMap(entries: RegistryEntry[]) {
  return try collectClaimMap(entries, "channel", (e) => e.channels)
}

export effect function collectShortIdPluginMap(entries: RegistryEntry[]) {
  return try collectClaimMap(entries, "short id", (e) => e.shortIds)
}

export effect function collectProviderPluginMap(entries: RegistryEntry[]) {
  return try collectClaimMap(entries, "provider env key", (e) => Object.keys(e.config).filter((envKey) => e.config[envKey].autoEnableProvider === true))
}

interface SourcedEntry {
  entry: RegistryEntry
  file: string
}

function validated(file: string, data: unknown): RegistryEntry | InvalidRegistryEntryFile {
  const parsed = registryEntrySchema.safeParse(data)
  if (parsed.success) return parsed.data
  return new InvalidRegistryEntryFile({ message: `[registry/generate] ${file} failed validation: ${String(parsed.error)}` })
}

effect function readEntryFile(file: string) {
  const raw = try readJsonFile(file)
  const sourced: SourcedEntry[] = []
  for (const data of Array.isArray(raw) ? raw : [raw]) {
    const entry = validated(file, data)
    if (entry instanceof InvalidRegistryEntryFile) throw entry
    sourced.push({ entry, file })
  }
  return sourced
}

effect function collectPluginOwnedEntries() {
  const out: SourcedEntry[] = []
  for (const base of ["plugins", "packages"]) {
    const baseDir = joinPath(REPO_ROOT, base)
    if (!exists(baseDir)) continue
    for (const dirent of try listDirectory(baseDir)) {
      if (!dirent.isDirectory) continue
      const file = joinPath(baseDir, dirent.name, "registry-entry.json")
      if (exists(file)) out.push(...try readEntryFile(file))
    }
  }
  return out
}

effect function collectCuratedEntries(dir: string): SourcedEntry[]!(Foreign | InvalidRegistryEntryFile) {
  const out: SourcedEntry[] = []
  for (const dirent of try listDirectory(dir)) {
    const full = joinPath(dir, dirent.name)
    if (dirent.isDirectory) out.push(...try collectCuratedEntries(full))
    else if (dirent.name.endsWith(".json")) out.push(...try readEntryFile(full))
  }
  return out
}

export effect function collectFirstPartyEntries() {
  const pluginOwned = try collectPluginOwnedEntries()
  const sourced = [...pluginOwned, ...(exists(CURATED_DIR) ? try collectCuratedEntries(CURATED_DIR) : [])]
  const byId = new Map<string, string>()
  for (const { entry, file } of sourced) {
    const existing = byId.get(entry.id)
    if (existing) throw new DuplicateRegistryId({ message: `[registry/generate] duplicate id "${entry.id}" in ${file} and ${existing}` })
    byId.set(entry.id, file)
  }
  return sourced.map((s) => s.entry).sort((a, b) => a.id.localeCompare(b.id))
}

function asJson(value: unknown): string {
  return `${JSON.stringify(value, null, 2)}\n`
}

effect function render(entries: RegistryEntry[]) {
  return {
    full: asJson({ entries }),
    curated: asJson(collectCuratedAppDefinitions(entries)),
    channels: asJson(try collectChannelPluginMap(entries)),
    providers: asJson(try collectProviderPluginMap(entries)),
    shortIds: asJson(try collectShortIdPluginMap(entries)),
  }
}

export effect function generateFirstPartyRegistry() {
  return try render(try collectFirstPartyEntries())
}

function plainly<Args extends readonly unknown[], A>(run: (...args: Args) => A!Error):(...args: Args) => A {
  return thrown((...args: Args) => Effect.mapError(run(...args), (error): Error => (error instanceof Foreign ? error : new Error(error.message))))
}

export const collectChannelPluginMapOrThrow = plainly(collectChannelPluginMap)
export const collectShortIdPluginMapOrThrow = plainly(collectShortIdPluginMap)
export const collectProviderPluginMapOrThrow = plainly(collectProviderPluginMap)
export const collectFirstPartyEntriesOrThrow = plainly(collectFirstPartyEntries)
export const generateFirstPartyRegistryOrThrow = plainly(generateFirstPartyRegistry)

effect function main() {
  const entries = try collectFirstPartyEntries()
  const next = try render(entries)
  const artifacts: Array<[string, string]> = []
  for (const [path, content] of [
    [GENERATED_PATH, next.full],
    [CURATED_DEFS_PATH, next.curated],
    [CHANNEL_MAP_PATH, next.channels],
    [PROVIDER_MAP_PATH, next.providers],
    [SHORTID_MAP_PATH, next.shortIds],
  ] as const) {
    artifacts.push([path, try biomeFormatJson(REPO_ROOT, content, path)])
  }
  if (check) {
    for (const [path, expected] of artifacts) {
      if (try readFileIfPresent(path) !== expected) {
        try Console.error(`[registry/generate] ${path} is stale. Run \`bun run --cwd packages/core generate:first-party\` and commit the result.`)
        return exitFailed()
      }
    }
    return try Console.log("[registry/generate] generated artifacts are up to date.")
  }
  for (const [path, content] of artifacts) try writeFile(path, content)
  try Console.log(`[registry/generate] wrote ${entries.length} entries + ${entries.filter((entry) => entry.curatedApp).length} curated-app definitions`)
}

if (import.meta.main) NodeRuntime.runMain(main())
