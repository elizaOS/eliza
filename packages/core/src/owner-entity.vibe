// spec/core/authorization.md, "Trusted ownership and deliberate grants determine resolved roles"
import { failingAs, type Foreign, foreign, promised, thrown, thrownValue } from "./edge.vibe"
import { ElizaError } from "./errors.vibe"
import { deterministicOwnerEntityId, hasConfiguredCanonicalOwner, resolveOwnerEntityIdOrDefault } from "./roles.vibe"
import type { UUID } from "./types/primitives.vibe"
import type { IAgentRuntime } from "./types/runtime.vibe"
import { validateUuid } from "./utils/uuid.vibe"

type WorldMetadataShape = {
  ownership?: { ownerId?: string }
}

effect function resolveFallbackOwnerEntityId(runtime: Pick<IAgentRuntime, "agentId">) {
  return try deterministicOwnerEntityId(runtime.agentId)
}

export const resolveFallbackOwnerEntityIdOrThrow = thrown(failingAs(TypeError, resolveFallbackOwnerEntityId))

effect function resolveOwnerEntityId(runtime: IAgentRuntime) {
  if (try hasConfiguredCanonicalOwner(runtime)) {
    return try resolveOwnerEntityIdOrDefault(runtime)
  }

  let phase = "rooms"
  let roomId: string | undefined
  let worldId: string | undefined
  const scan = effect {
    const roomIds = try foreign(() => runtime.getRoomsForParticipant(runtime.agentId))
    for (const candidateRoomId of roomIds) {
      phase = "room"
      roomId = candidateRoomId
      worldId = undefined
      const room = try foreign(() => runtime.getRoom(candidateRoomId))
      if (!room?.worldId) continue
      phase = "world"
      worldId = room.worldId
      const world = try foreign(() => runtime.getWorld(room.worldId as UUID))
      const metadata = (world?.metadata ?? {}) as WorldMetadataShape
      const candidateOwnerId = validateUuid(metadata.ownership?.ownerId)
      if (candidateOwnerId) return candidateOwnerId
    }
    return null
  }
  const worldOwnerId = try Effect.catchCause(scan, (cause): never!(Foreign | ElizaError)! => {
    if (Cause.hasInterruptsOnly(cause)) return Effect.failCause(cause)
    const thrown = Cause.squash(cause)
    return Effect.fail(new ElizaError("Owner identity lookup failed; restore storage access and retry.", {
      code: "OWNER_ENTITY_LOOKUP_FAILED",
      cause: thrownValue(thrown),
      context: { agentId: runtime.agentId, phase, roomId, worldId },
      severity: "ephemeral",
    }))
  })

  return worldOwnerId ?? (try resolveFallbackOwnerEntityId(runtime))
}

export const resolveOwnerEntityIdPromise = promised(failingAs(TypeError, resolveOwnerEntityId, ElizaError))
