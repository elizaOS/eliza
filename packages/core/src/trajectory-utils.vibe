export type TrajectoryFinalStatus =
  | "completed"
  | "error"
  | "timeout"
  | "terminated"

export const TRAJECTORY_LLM_PURPOSES = [
  "planner",
  "action",
  "provider",
  "evaluator",
  "background",
  "external_llm",
  "optimizer",
] as const

export type TrajectoryLlmPurpose = (typeof TRAJECTORY_LLM_PURPOSES)[number]

