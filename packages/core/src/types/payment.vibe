// spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/packageExports.md, "An admitted pack serves exactly the declared leaves, each free of host-only code"
export type BuiltInPaymentConfig =
  | "base_usdc"
  | "solana_usdc"
  | "polygon_usdc"
  | "bsc_usdc"
  | "base_elizaos"
  | "solana_elizaos"
  | "solana_degenai"

export interface X402Config {
  priceInCents: number
  paymentConfigs?: (BuiltInPaymentConfig | string)[]
}

export interface X402ValidationResult {
  valid: boolean
  error?: {
    status: number
    message: string
    details?: unknown
  }
}
