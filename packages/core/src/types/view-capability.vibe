// spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/packageExports.md, "An admitted pack serves exactly the declared leaves, each free of host-only code"
export interface ViewCapabilityParameter {
  type: string
  description: string
  required?: boolean
  enum?: Array<string | number | boolean>
  pattern?: string
  minLength?: number
  maxLength?: number
  minimum?: number
  maximum?: number
}

export interface ViewCapability {
  id: string
  description: string
  authority?: "agent" | "human"
  params?: Record<string, ViewCapabilityParameter>
}
