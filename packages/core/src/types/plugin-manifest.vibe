// spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/packageExports.md, "An admitted pack serves exactly the declared leaves, each free of host-only code"
export interface PluginAutoEnableContext {
  env: NodeJS.ProcessEnv

  config: Record<string, unknown>

  isNativePlatform: boolean
}

export interface PluginAutoEnableModule {
  shouldEnable: (ctx: PluginAutoEnableContext) => boolean | Promise<boolean>
  shouldForce?: (ctx: PluginAutoEnableContext) => boolean
}
