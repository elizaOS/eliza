// spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/packageExports.md, "An admitted pack serves exactly the declared leaves, each free of host-only code"
import type { MemoryMetadata } from "./memory.vibe"
import type { Content, UUID } from "./primitives.vibe"

export type DocumentDirectory = {
  path?: string
  directory?: string
  shared?: boolean
}

export type DocumentSourceItem = {
  item:
    | { case: "path"; value: string }
    | { case: "directory"; value: DocumentDirectory }
    | { case: undefined; value?: undefined }
}

export interface DocumentItem {
  id: UUID
  content: Content
  metadata?: MemoryMetadata
  worldId?: UUID
  similarity?: number
}

export type DocumentRecord = Partial<DocumentItem>
