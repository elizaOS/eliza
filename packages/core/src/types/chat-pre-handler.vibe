// spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/packageExports.md, "An admitted pack serves exactly the declared leaves, each free of host-only code"
import type { Memory } from "./memory.vibe"
import type { IAgentRuntime } from "./runtime.vibe"

export interface ChatPreHandlerContext {
  runtime: IAgentRuntime
  message: Memory

  abortSignal?: AbortSignal

  appendText: (text: string) => void

  replaceText: (text: string) => void
}

export interface ChatPreHandlerResult {
  responseText: string
}

export interface ChatPreHandler {
  id: string

  priority?: number

  tryHandle(ctx: ChatPreHandlerContext): Promise<ChatPreHandlerResult | null>
}
