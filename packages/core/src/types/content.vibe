// spec/core/contracts.md, "Required fields and discriminants survive a compatibility projection"
import { failingAs, thrown } from "../edge.vibe"
export const CONTENT_REFERENCE_KINDS = [
  "file",
  "document",
  "attachment",
  "email",
  "memory",
  "tool-result",
] as const

export type ContentReferenceKind = (typeof CONTENT_REFERENCE_KINDS)[number]

export const CONTENT_REFERENCE_RESUMABILITY_VALUES = [
  "restart-safe",
  "session-safe",
  "non-resumable",
] as const

export type ContentReferenceResumability = (typeof CONTENT_REFERENCE_RESUMABILITY_VALUES)[number]

export const READ_RANGE_UNITS = ["line", "fragment", "byte"] as const

export type ReadRangeUnit = (typeof READ_RANGE_UNITS)[number]

export const READ_COMPLETENESS_VALUES = [
  "complete",
  "partial-recoverable",
  "partial-source-loss",
  "unavailable",
] as const

export type ReadCompleteness = (typeof READ_COMPLETENESS_VALUES)[number]

export interface ContentReference {
  kind: ContentReferenceKind
  ref: string
  revision?: string

  resumability?: ContentReferenceResumability

  expiresAt?: string
}

export interface ReadRange {
  unit: ReadRangeUnit

  start: number

  end: number
  total?: number
}

export interface ReadSlice {
  range: ReadRange
  hasPrevious: boolean
  hasMore: boolean
  nextOffset?: number
  revision?: string
  completeness: ReadCompleteness
  sliceSha256: string
  sourceSha256?: string
  reason?: string
}

export interface ReadView {
  reference: ContentReference
  slice: ReadSlice
}

export interface BuildReadSliceInput {
  range: ReadRange
  completeness: ReadCompleteness
  sliceSha256: string
  revision?: string
  sourceSha256?: string
  reason?: string
}

const CONTENT_REFERENCE_KIND_SET = new Set<string>(CONTENT_REFERENCE_KINDS)
const CONTENT_REFERENCE_RESUMABILITY_SET = new Set<string>(
  CONTENT_REFERENCE_RESUMABILITY_VALUES,
)
const READ_RANGE_UNIT_SET = new Set<string>(READ_RANGE_UNITS)
const READ_COMPLETENESS_SET = new Set<string>(READ_COMPLETENESS_VALUES)
const SHA256_PATTERN = /^[0-9a-f]{64}$/u
const OPAQUE_REFERENCE_PATTERN = /^[A-Za-z0-9._:~-]{1,256}$/u
const CONTENT_REFERENCE_KEYS = new Set([
  "kind",
  "ref",
  "revision",
  "resumability",
  "expiresAt",
])
const READ_RANGE_KEYS = new Set(["unit", "start", "end", "total"])
const READ_SLICE_KEYS = new Set([
  "range",
  "hasPrevious",
  "hasMore",
  "nextOffset",
  "revision",
  "completeness",
  "sliceSha256",
  "sourceSha256",
  "reason",
])
const READ_VIEW_KEYS = new Set(["reference", "slice"])

export error InvalidContentContract { message: string }

function invalid(message: string): InvalidContentContract {
  return new InvalidContentContract({ message: `Invalid progressive content contract: ${message}` })
}

export effect function requireRecord<E>(value: unknown, label: string, fail: (message: string) => E): Record<string, unknown>!E {
  if (value === null || typeof value !== "object" || Array.isArray(value)) throw fail(`${label} must be an object`)
  return value as Record<string, unknown>
}

export effect function rejectUnknownKeys<E>(
  value: Record<string, unknown>,
  allowed: ReadonlySet<string>,
  label: string,
  fail: (message: string) => E,
): void!E {
  const unknown = Object.keys(value).filter((key) => !allowed.has(key))
  if (unknown.length > 0) throw fail(`${label} contains unsupported field(s): ${unknown.join(", ")}`)
}

export effect function safeOffset<E>(value: unknown, label: string, fail: (message: string) => E): number!E {
  if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 0) throw fail(`${label} must be a nonnegative safe integer`)
  return value
}

effect function optionalSafeOffset(value: unknown, label: string): (number | undefined)!InvalidContentContract {
  return value === undefined ? undefined : try safeOffset(value, label, invalid)
}

effect function optionalNonEmptyString(value: unknown, label: string): (string | undefined)!InvalidContentContract {
  if (value === undefined) return undefined
  if (typeof value !== "string" || value.trim().length === 0) throw invalid(`${label} must be a nonempty string when present`)
  return value
}

effect function sha256(value: unknown, label: string): string!InvalidContentContract {
  if (typeof value !== "string" || !SHA256_PATTERN.test(value)) throw invalid(`${label} must be a lowercase SHA-256 hex digest`)
  return value
}

effect function optionalTimestamp(value: unknown, label: string): (string | undefined)!InvalidContentContract {
  const text = try optionalNonEmptyString(value, label)
  if (text === undefined) return undefined
  const epoch = Date.parse(text)
  if (!Number.isFinite(epoch) || new Date(epoch).toISOString() !== text) throw invalid(`${label} must be an ISO-8601 UTC timestamp when present`)
  return text
}

export effect function validateContentReference(value: unknown): ContentReference!InvalidContentContract {
  const input = try requireRecord(value, "reference", invalid)
  try rejectUnknownKeys(input, CONTENT_REFERENCE_KEYS, "reference", invalid)
  if (typeof input.kind !== "string" || !CONTENT_REFERENCE_KIND_SET.has(input.kind)) throw invalid("reference.kind is unsupported")
  if (typeof input.ref !== "string" || !OPAQUE_REFERENCE_PATTERN.test(input.ref)) {
    throw invalid("reference.ref must be an opaque token without paths, addresses, or whitespace")
  }
  const resumability = try optionalNonEmptyString(input.resumability, "reference.resumability")
  if (resumability !== undefined && !CONTENT_REFERENCE_RESUMABILITY_SET.has(resumability)) throw invalid("reference.resumability is unsupported")
  const expiresAt = try optionalTimestamp(input.expiresAt, "reference.expiresAt")
  if (expiresAt !== undefined && resumability !== "restart-safe") throw invalid("reference.expiresAt requires resumability=restart-safe")
  const revision = try optionalNonEmptyString(input.revision, "reference.revision")
  return {
    kind: input.kind as ContentReferenceKind,
    ref: input.ref,
    ...(revision === undefined ? {} : { revision }),
    ...(resumability === undefined ? {} : { resumability: resumability as ContentReferenceResumability }),
    ...(expiresAt === undefined ? {} : { expiresAt }),
  }
}
export const validateContentReferenceOrThrow = thrown(failingAs(TypeError, validateContentReference))

export function isContentReference(value: unknown): value is ContentReference {
  return Exit.isSuccess(runSyncExit(validateContentReference(value)))
}

effect function validateReadSlice(value: unknown): ReadSlice!InvalidContentContract {
  const input = try requireRecord(value, "slice", invalid)
  try rejectUnknownKeys(input, READ_SLICE_KEYS, "slice", invalid)
  const rawRange = try requireRecord(input.range, "slice.range", invalid)
  try rejectUnknownKeys(rawRange, READ_RANGE_KEYS, "slice.range", invalid)
  if (typeof rawRange.unit !== "string" || !READ_RANGE_UNIT_SET.has(rawRange.unit)) throw invalid("slice.range.unit is unsupported")
  const start = try safeOffset(rawRange.start, "slice.range.start", invalid)
  const end = try safeOffset(rawRange.end, "slice.range.end", invalid)
  const total = try optionalSafeOffset(rawRange.total, "slice.range.total")
  if (start > end) throw invalid("slice.range.start must not exceed end")
  if (total !== undefined && end > total) throw invalid("slice.range.end must not exceed total")
  if (input.hasPrevious !== start > 0) throw invalid("slice.hasPrevious must equal range.start > 0")
  if (typeof input.hasMore !== "boolean") throw invalid("slice.hasMore must be boolean")
  if (typeof input.completeness !== "string" || !READ_COMPLETENESS_SET.has(input.completeness)) throw invalid("slice.completeness is unsupported")
  const completeness = input.completeness as ReadCompleteness
  const nextOffset = try optionalSafeOffset(input.nextOffset, "slice.nextOffset")
  const recoverable = completeness === "partial-recoverable"
  if (input.hasMore !== recoverable) throw invalid("slice.hasMore is true only for partial-recoverable slices")
  if (recoverable && (nextOffset !== end || end <= start)) throw invalid("recoverable slice.nextOffset must equal an advancing range.end")
  if (!recoverable && nextOffset !== undefined) throw invalid("slice.nextOffset is allowed only for partial-recoverable slices")
  if (completeness === "complete" && total !== undefined && end !== total) throw invalid("complete slice.range.end must equal total")
  const revision = try optionalNonEmptyString(input.revision, "slice.revision")
  const sourceSha256 = input.sourceSha256 === undefined ? undefined : try sha256(input.sourceSha256, "slice.sourceSha256")
  if (recoverable && revision === undefined && sourceSha256 === undefined) throw invalid("recoverable slices require revision or sourceSha256 identity")
  const reason = try optionalNonEmptyString(input.reason, "slice.reason")
  const sliceSha256 = try sha256(input.sliceSha256, "slice.sliceSha256")
  return {
    range: { unit: rawRange.unit as ReadRangeUnit, start, end, ...(total === undefined ? {} : { total }) },
    hasPrevious: start > 0,
    hasMore: recoverable,
    ...(recoverable ? { nextOffset: end } : {}),
    ...(revision === undefined ? {} : { revision }),
    completeness,
    sliceSha256,
    ...(sourceSha256 === undefined ? {} : { sourceSha256 }),
    ...(reason === undefined ? {} : { reason }),
  }
}
export const validateReadSliceOrThrow = thrown(failingAs(TypeError, validateReadSlice))

effect function validateReadView(value: unknown): ReadView!InvalidContentContract {
  const input = try requireRecord(value, "readView", invalid)
  try rejectUnknownKeys(input, READ_VIEW_KEYS, "readView", invalid)
  const reference = try validateContentReference(input.reference)
  const slice = try validateReadSlice(input.slice)
  if (reference.revision !== undefined && slice.revision !== undefined && reference.revision !== slice.revision) {
    throw invalid("reference and slice revisions must match")
  }
  return { reference, slice }
}
export const validateReadViewOrThrow = thrown(failingAs(TypeError, validateReadView))

export function isReadView(value: unknown): value is ReadView {
  return Exit.isSuccess(runSyncExit(validateReadView(value)))
}

effect function buildContentReference(input: ContentReference): ContentReference!InvalidContentContract {
  return try validateContentReference(input)
}
export const buildContentReferenceOrThrow = thrown(failingAs(TypeError, buildContentReference))

effect function buildReadSlice(input: BuildReadSliceInput): ReadSlice!InvalidContentContract {
  return try validateReadSlice({
    ...input,
    hasPrevious: input.range.start > 0,
    hasMore: input.completeness === "partial-recoverable",
    ...(input.completeness === "partial-recoverable" ? { nextOffset: input.range.end } : {}),
  })
}
export const buildReadSliceOrThrow = thrown(failingAs(TypeError, buildReadSlice))

effect function buildReadView(input: ReadView): ReadView!InvalidContentContract {
  return try validateReadView(input)
}
export const buildReadViewOrThrow = thrown(failingAs(TypeError, buildReadView))
