// spec/core/index.md, "Compatibility translates asynchronous results without losing failures"; spec/core/packageExports.md, "An admitted pack serves exactly the declared leaves, each free of host-only code"
import { failingAs, thrown } from "../edge.vibe"

export const WORKSPACE_DELTA_RECEIPT_DATA_KEY = "workspaceDeltaReceipt" as const

export type WorkspaceDeltaOutcome = "changed" | "unchanged" | "indeterminate"

export const WORKSPACE_DELTA_INDETERMINATE_REASON_CODES = [
  "WORKTREE_PROBE_FAILED",
  "BASELINE_SNAPSHOT_FAILED",
  "POST_SNAPSHOT_FAILED",
  "OBSERVATION_TIME_BUDGET_EXCEEDED",
  "OBSERVATION_BYTE_BUDGET_EXCEEDED",
  "OBSERVATION_OUTPUT_BUDGET_EXCEEDED",
  "REMOTE_EXECUTION_UNOBSERVED",
  "BACKGROUND_RECEIPT_PENDING",
] as const

export type WorkspaceDeltaIndeterminateReasonCode = (typeof WORKSPACE_DELTA_INDETERMINATE_REASON_CODES)[number]

export interface WorkspaceDeltaReceipt {
  version: 1
  kind: "workspace_delta"
  scope: {
    kind: "git_worktree"
    root: string
    rootId: string
    executionDomainId: string
    coverage: "tracked_and_untracked_nonignored"
  }
  operation?: {
    kind: "background_shell"
    handle: string
    status: "running" | "terminating" | "exited" | "killed" | "error"
  }
  outcome: WorkspaceDeltaOutcome
  beforeFingerprint?: string
  afterFingerprint?: string
  observedAt: string
  reasonCode?: WorkspaceDeltaIndeterminateReasonCode
}

type WorkspaceDeltaOperation = NonNullable<WorkspaceDeltaReceipt["operation"]>

error InvalidWorkspaceDeltaReceipt { message: string }

const RECEIPT_KEYS: ReadonlySet<string> = new Set([
  "version",
  "kind",
  "scope",
  "outcome",
  "observedAt",
  "operation",
  "beforeFingerprint",
  "afterFingerprint",
  "reasonCode",
])
const SCOPE_KEYS: ReadonlySet<string> = new Set(["kind", "root", "rootId", "executionDomainId", "coverage"])
const OPERATION_KEYS: ReadonlySet<string> = new Set(["kind", "handle", "status"])
const OPERATION_STATUSES: ReadonlySet<unknown> = new Set<WorkspaceDeltaOperation["status"]>([
  "running",
  "terminating",
  "exited",
  "killed",
  "error",
])
const REASON_CODES: ReadonlySet<unknown> = new Set(WORKSPACE_DELTA_INDETERMINATE_REASON_CODES)

effect function assertExactKeys(value: Record<string, unknown>, allowedKeys: ReadonlySet<string>, label: string) {
  const unexpected = Object.keys(value).filter((key) => !allowedKeys.has(key))
  if (unexpected.length > 0) {
    throw new InvalidWorkspaceDeltaReceipt({ message: `${label} has unexpected fields: ${unexpected.join(", ")}.` })
  }
}

effect function fingerprint(value: unknown, field: string) {
  if (typeof value !== "string" || !/^[a-f0-9]{64}$/.test(value)) {
    throw new InvalidWorkspaceDeltaReceipt({ message: `WorkspaceDeltaReceipt.${field} must be a lowercase SHA-256 hex string.` })
  }
  return value
}

function record(value: unknown): Record<string, unknown> | undefined {
  return value !== null && typeof value === "object" && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : undefined
}

function isSingleLine(value: unknown): value is string {
  return typeof value === "string" && value.length > 0 && value.trim() === value && !/[\0\r\n]/.test(value)
}

function isTerminal(status: WorkspaceDeltaOperation["status"]): boolean {
  return status === "exited" || status === "killed" || status === "error"
}

effect function operationOf(raw: Record<string, unknown>) {
  const operation = record(raw.operation)
  if (!operation) {
    if (raw.operation !== undefined) {
      throw new InvalidWorkspaceDeltaReceipt({ message: "WorkspaceDeltaReceipt has an invalid operation." })
    }
    return undefined
  }
  try assertExactKeys(operation, OPERATION_KEYS, "WorkspaceDeltaReceipt.operation")
  if (
    operation.kind !== "background_shell"
    || !isSingleLine(operation.handle)
    || operation.handle.length > 200
    || !OPERATION_STATUSES.has(operation.status)
  ) {
    throw new InvalidWorkspaceDeltaReceipt({ message: "WorkspaceDeltaReceipt has an invalid operation." })
  }
  return {
    kind: "background_shell",
    handle: operation.handle,
    status: operation.status as WorkspaceDeltaOperation["status"],
  } satisfies WorkspaceDeltaOperation
}

export effect function normalizeWorkspaceDeltaReceipt(value: unknown) {
  const raw = record(value)
  const scope = record(raw?.scope)
  if (raw) try assertExactKeys(raw, RECEIPT_KEYS, "WorkspaceDeltaReceipt")
  if (scope) try assertExactKeys(scope, SCOPE_KEYS, "WorkspaceDeltaReceipt.scope")
  if (
    raw?.version !== 1
    || raw.kind !== "workspace_delta"
    || scope?.kind !== "git_worktree"
    || scope.coverage !== "tracked_and_untracked_nonignored"
    || !isSingleLine(scope.root)
  ) {
    throw new InvalidWorkspaceDeltaReceipt({ message: "WorkspaceDeltaReceipt has an invalid envelope or scope." })
  }
  const normalizedScope: WorkspaceDeltaReceipt["scope"] = {
    kind: "git_worktree",
    root: scope.root,
    rootId: try fingerprint(scope.rootId, "scope.rootId"),
    executionDomainId: try fingerprint(scope.executionDomainId, "scope.executionDomainId"),
    coverage: "tracked_and_untracked_nonignored",
  }
  const operation = try operationOf(raw)
  const operationField: { operation?: WorkspaceDeltaOperation } = operation ? { operation } : {}
  const outcome = raw.outcome
  if (outcome !== "changed" && outcome !== "unchanged" && outcome !== "indeterminate") {
    throw new InvalidWorkspaceDeltaReceipt({ message: "WorkspaceDeltaReceipt has an invalid outcome." })
  }
  const observedAt = raw.observedAt
  if (
    typeof observedAt !== "string"
    || !Number.isFinite(Date.parse(observedAt))
    || new Date(observedAt).toISOString() !== observedAt
  ) {
    throw new InvalidWorkspaceDeltaReceipt({ message: "WorkspaceDeltaReceipt.observedAt must be an ISO timestamp." })
  }
  if (outcome === "indeterminate") {
    const reasonCode = raw.reasonCode
    if (!REASON_CODES.has(reasonCode)) {
      throw new InvalidWorkspaceDeltaReceipt({ message: "Indeterminate WorkspaceDeltaReceipt values require a canonical reasonCode." })
    }
    if (raw.afterFingerprint !== undefined) {
      throw new InvalidWorkspaceDeltaReceipt({ message: "Indeterminate WorkspaceDeltaReceipt values cannot include afterFingerprint." })
    }
    const pending = reasonCode === "BACKGROUND_RECEIPT_PENDING"
    if (pending && operation === undefined) {
      throw new InvalidWorkspaceDeltaReceipt({ message: "A pending background WorkspaceDeltaReceipt requires its operation handle." })
    }
    if (
      operation
      && (pending
        ? operation.status !== "running" && operation.status !== "terminating"
        : !isTerminal(operation.status))
    ) {
      throw new InvalidWorkspaceDeltaReceipt({ message: "WorkspaceDeltaReceipt operation status contradicts its observation state." })
    }
    const receipt: WorkspaceDeltaReceipt = {
      version: 1,
      kind: "workspace_delta",
      scope: normalizedScope,
      ...operationField,
      outcome,
      ...(raw.beforeFingerprint === undefined
        ? {}
        : { beforeFingerprint: try fingerprint(raw.beforeFingerprint, "beforeFingerprint") }),
      observedAt,
      reasonCode: reasonCode as WorkspaceDeltaIndeterminateReasonCode,
    }
    return receipt
  }
  if (raw.reasonCode !== undefined) {
    throw new InvalidWorkspaceDeltaReceipt({ message: "Observed WorkspaceDeltaReceipt values cannot include reasonCode." })
  }
  if (operation && !isTerminal(operation.status)) {
    throw new InvalidWorkspaceDeltaReceipt({ message: "Observed WorkspaceDeltaReceipt operations require a terminal status." })
  }
  const beforeFingerprint = try fingerprint(raw.beforeFingerprint, "beforeFingerprint")
  const afterFingerprint = try fingerprint(raw.afterFingerprint, "afterFingerprint")
  if ((outcome === "changed") === (beforeFingerprint === afterFingerprint)) {
    throw new InvalidWorkspaceDeltaReceipt({ message: `WorkspaceDeltaReceipt fingerprints contradict outcome ${outcome}.` })
  }
  const receipt: WorkspaceDeltaReceipt = {
    version: 1,
    kind: "workspace_delta",
    scope: normalizedScope,
    ...operationField,
    outcome,
    beforeFingerprint,
    afterFingerprint,
    observedAt,
  }
  return receipt
}

export const normalizeWorkspaceDeltaReceiptOrThrow = thrown(failingAs(TypeError, normalizeWorkspaceDeltaReceipt))

effect function readWorkspaceDeltaReceipt(data: Record<string, unknown> | undefined) {
  const value = data?.[WORKSPACE_DELTA_RECEIPT_DATA_KEY]
  return value === undefined ? undefined : try normalizeWorkspaceDeltaReceipt(value)
}

export const readWorkspaceDeltaReceiptOrThrow = thrown(failingAs(TypeError, readWorkspaceDeltaReceipt))
