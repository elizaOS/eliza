// spec/core/views.md, "Story: Deliver a completed action to the intended view"; spec/core/views.md, "Completion requires matching request renderer installation and view identities"
import { type Foreign, foreignSync, thrown } from "../edge.vibe"
import { normalizeCompletedActionHandoffId } from "../events.vibe"
import { parseViewInteractionClientId } from "./view-interact-protocol.vibe"
import { asNonEmptyString } from "../utils/type-guards.vibe"

export interface ViewActionHandoff {
  viewId: string
  viewPath?: string
  subview?: string
  completedActionDelivered?: true
  completedActionHandoffId?: string
  navigationPrepared?: true
  navigationBinding?: {
    requestId: string
    clientId: string
    viewId: string
    viewType: "gui"
    installationId: string
  }
}
function readOwnValue(value: unknown, key: string): unknown {
  if (typeof value !== "object" || value === null || Array.isArray(value)) {
    return undefined
  }
  return Object.getOwnPropertyDescriptor(value, key)?.value
}

effect function findViewActionHandoff(
  actionResults: readonly unknown[] | undefined,
): (ViewActionHandoff | null)!Foreign {
  if (!Array.isArray(actionResults)) return null
  for (let index = actionResults.length - 1; index >= 0; index--) {
    const result = actionResults[index]
    if (readOwnValue(result, "success") !== true) {
      continue
    }
    const actionName = asNonEmptyString(
      readOwnValue(result, "actionName"),
    )?.toUpperCase()
    const values = readOwnValue(result, "values")
    const mode = asNonEmptyString(readOwnValue(values, "mode"))?.toLowerCase()
    const subaction = asNonEmptyString(
      readOwnValue(values, "subaction"),
    )?.toLowerCase()
    const targetId = asNonEmptyString(
      readOwnValue(values, "targetId"),
    )?.toLowerCase()
    const viewId = asNonEmptyString(readOwnValue(values, "viewId"))
    const isViewsHandoff = (actionName === "VIEWS" && (mode === "show" || mode === "open"))
      || (actionName === "VIEWS_SHOW" && mode === "show")
    const isAppBrowserHandoff = actionName === "APP" && mode === "launch" && viewId === "browser"
    const isBrowserWorkspaceHandoff = (actionName === "BROWSER"
      || actionName === "BROWSER_OPEN"
      || actionName === "BROWSER_NAVIGATE"
      || actionName === "BROWSER_SHOW")
      && targetId === "workspace"
      && (subaction === "open"
        || subaction === "navigate"
        || subaction === "show")
      && viewId === "browser"
    if (
      (isViewsHandoff || isAppBrowserHandoff || isBrowserWorkspaceHandoff)
      && viewId
    ) {
      const actionUrl = asNonEmptyString(readOwnValue(values, "url"))
      const declaredViewPath = asNonEmptyString(readOwnValue(values, "viewPath"))

      const viewPath = isBrowserWorkspaceHandoff && actionUrl
        ? `/browser?browse=${try foreignSync(() => encodeURIComponent(actionUrl))}`
        : declaredViewPath
      const subview = asNonEmptyString(readOwnValue(values, "subview"))
      const completedActionHandoffId = normalizeCompletedActionHandoffId(
        readOwnValue(values, "completedActionHandoffId"),
      )
      let navigationBinding: ViewActionHandoff["navigationBinding"]
      if (readOwnValue(values, "navigationPrepared") === true) {
        const binding = readOwnValue(values, "navigationBinding")
        const requestId = normalizeCompletedActionHandoffId(
          readOwnValue(binding, "requestId"),
        )
        const clientId = parseViewInteractionClientId(
          readOwnValue(binding, "clientId"),
        )
        const installationId = parseViewInteractionClientId(
          readOwnValue(binding, "installationId"),
        )
        if (
          !isViewsHandoff
          || !completedActionHandoffId
          || requestId !== completedActionHandoffId
          || !clientId
          || !installationId
          || readOwnValue(binding, "viewId") !== viewId
          || readOwnValue(binding, "viewType") !== "gui"
        ) {
          continue
        }
        navigationBinding = {
          requestId,
          clientId,
          installationId,
          viewId,
          viewType: "gui",
        }
      }
      return {
        viewId,
        ...(viewPath ? { viewPath } : {}),
        ...(subview ? { subview } : {}),
        ...(readOwnValue(values, "completedActionDelivered") === true
          ? { completedActionDelivered: true }
          : {}),
        ...(completedActionHandoffId ? { completedActionHandoffId } : {}),
        ...(navigationBinding
          ? { navigationPrepared: true, navigationBinding }
          : {}),
      }
    }
  }
  return null
}

export const findViewActionHandoffOrThrow = thrown(findViewActionHandoff)
