// spec/core/media.md, "Story: Fetch an attachment through its correct trust boundary"; spec/core/media.md, "Fetching requires a screened endpoint and finishing requires complete bounded bytes"
import { foreign, promised } from "../edge.vibe"
import type { PinnedLookupFetchLike } from "../network/fetch-guard.vibe"
import type { LookupFn } from "../network/ssrf.vibe"
import { DEFAULT_CONNECTOR_ATTACHMENT_MAX_BYTES, type ResolvedAttachmentBytes } from "./attachments.vibe"
import { type FetchLike, fetchRemoteMedia, MediaFetchError, readResponseWithLimit } from "./fetch.vibe"
import { trustedLocalMediaUrl } from "./local-store.vibe"
import { extensionForMime } from "./mime.vibe"

export type ResolveOutboundAttachmentOptions = {
  maxBytes?: number
  timeoutMs?: number
  fetchImpl?: FetchLike
  lookupFn?: LookupFn
  pinnedFetchImpl?: PinnedLookupFetchLike

  localFetch?: FetchLike
}

const DEFAULT_OUTBOUND_TIMEOUT_MS = 30_000

module node {
  import { Buffer } from "node:buffer"
  import type { FetchLike } from "./fetch.vibe"

  /** @throws {never} */
  export async function dataUrlBytes(url: string, payload: string, isBase64: boolean): Promise<Buffer> {
    if (isBase64) {
      return Buffer.from(decodeURIComponent(payload).replace(/\s+/g, ""), "base64")
    }
    return Buffer.from(await (await fetch(url)).arrayBuffer())
  }

  /** @throws {never} */
  export function platformFetch(): FetchLike | undefined {
    return globalThis.fetch
  }

  /** @throws {never} */
  export async function fetchWithTimeout(fetcher: FetchLike, href: string, timeoutMs: number): Promise<Response> {
    return await fetcher(href, { signal: AbortSignal.timeout(timeoutMs) })
  }
}
import { dataUrlBytes, fetchWithTimeout, platformFetch } from node

function isDataUrl(url: string): boolean {
  return url.trim().slice(0, 5).toLowerCase() === "data:"
}

export function summarizeOutboundAttachmentUrl(url: string): {
  scheme: string
  host?: string
  path?: string
} {
  const trimmed = url.trim()
  if (isDataUrl(trimmed)) {
    const comma = trimmed.indexOf(",")
    const header = (comma >= 0 ? trimmed.slice(5, comma) : "")
      .replace(/;base64$/i, "")
      .split(";")[0]
      ?.trim()
    return { scheme: "data", path: header || "application/octet-stream" }
  }
  try {
    const parsed = new URL(trimmed)
    return {
      scheme: parsed.protocol.replace(/:$/, ""),
      host: parsed.host,
      path: parsed.pathname.split("/").slice(0, 4).join("/"),
    }
  } catch {
    return { scheme: "opaque" }
  }
}

effect function decodeDataUrl(
  url: string,
  maxBytes: number,
) {
  const comma = url.indexOf(",")
  if (!isDataUrl(url) || comma < 0) {
    throw new MediaFetchError("fetch_failed", "malformed data URL")
  }
  const header = url.slice(5, comma)
  const payload = url.slice(comma + 1)
  const isBase64 = /(?:^|;)base64$/i.test(header.trim())
  const mime = header
    .replace(/;base64$/i, "")
    .split(";")[0]
    ?.trim()
    .toLowerCase() || "application/octet-stream"

  const buffer = foreign(() => dataUrlBytes(url, payload, isBase64)) catch effect (failure) => {
    throw new MediaFetchError(
      "fetch_failed",
      "failed to decode data URL",
      failure.cause,
    )
  }
  if (buffer.length === 0) {
    throw new MediaFetchError("fetch_failed", "data URL contained no bytes")
  }
  if (buffer.length > maxBytes) {
    throw new MediaFetchError(
      "max_bytes",
      `data URL exceeds maxBytes ${maxBytes}`,
    )
  }
  const ext = extensionForMime(mime)
  return {
    buffer,
    contentType: mime,
    ...(ext ? { fileName: `attachment${ext}` } : {}),
  } satisfies ResolvedAttachmentBytes
}

effect function fetchLocalMediaStoreBytes(
  localUrl: URL,
  opts: ResolveOutboundAttachmentOptions,
  maxBytes: number,
  timeoutMs: number,
) {
  const fetcher = opts.localFetch ?? platformFetch()
  if (typeof fetcher !== "function") {
    throw new MediaFetchError(
      "fetch_failed",
      "local media-store fetch is not available",
    )
  }
  const response = foreign(() => fetchWithTimeout(fetcher, localUrl.href, timeoutMs)) catch effect (failure) => {
    throw new MediaFetchError(
      "fetch_failed",
      `local media-store fetch failed for ${localUrl.pathname}`,
      failure.cause,
    )
  }
  if (!response.ok) {
    throw new MediaFetchError(
      "http_error",
      `local media-store fetch failed (HTTP ${response.status}) for ${localUrl.pathname}`,
    )
  }
  const buffer = try readResponseWithLimit(response, maxBytes)
  const contentType = response.headers.get("content-type")?.split(";")[0]?.trim()
    || "application/octet-stream"
  const fileName = localUrl.pathname.split("/").pop()
  return {
    buffer,
    contentType,
    ...(fileName ? { fileName } : {}),
  } satisfies ResolvedAttachmentBytes
}

export effect function resolveOutboundAttachmentBytes(
  url: string,
  opts: ResolveOutboundAttachmentOptions = {},
) {
  const trimmed = url.trim()
  if (!trimmed) {
    throw new MediaFetchError(
      "fetch_failed",
      "outbound attachment URL is empty",
    )
  }
  const maxBytes = opts.maxBytes ?? DEFAULT_CONNECTOR_ATTACHMENT_MAX_BYTES
  const timeoutMs = opts.timeoutMs ?? DEFAULT_OUTBOUND_TIMEOUT_MS

  if (isDataUrl(trimmed)) {
    return try decodeDataUrl(trimmed, maxBytes)
  }

  const localUrl = try trustedLocalMediaUrl(trimmed)
  if (localUrl) {
    return try fetchLocalMediaStoreBytes(localUrl, opts, maxBytes, timeoutMs)
  }

  const notSupported = "outbound attachment URL is not a data URL, media-store handle, or http(s) URL"
  const parsed = try Effect.try({
    try: () => new URL(trimmed),
    catch: (error) => new MediaFetchError("fetch_failed", notSupported, error),
  })
  if (parsed.protocol !== "http:" && parsed.protocol !== "https:") {
    throw new MediaFetchError("fetch_failed", notSupported)
  }

  const fetched = try fetchRemoteMedia({
    url: trimmed,
    maxBytes,
    timeoutMs,
    fetchImpl: opts.fetchImpl,
    lookupFn: opts.lookupFn,
    pinnedFetchImpl: opts.pinnedFetchImpl,
  })
  return {
    buffer: fetched.buffer,
    contentType: fetched.contentType ?? "application/octet-stream",
    ...(fetched.fileName ? { fileName: fetched.fileName } : {}),
  } satisfies ResolvedAttachmentBytes
}
export const resolveOutboundAttachmentBytesPromise = promised(resolveOutboundAttachmentBytes)
