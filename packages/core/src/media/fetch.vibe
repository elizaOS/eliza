// spec/core/media.md, "Story: Fetch an attachment through its correct trust boundary"; spec/core/media.md, "Fetching requires a screened endpoint and finishing requires complete bounded bytes"
import { asLegacy, Foreign, foreign, promised, thrownValue } from "../edge.vibe"
import { fetchWithSsrfGuard, type PinnedLookupFetchLike } from "../network/fetch-guard.vibe"
import { type LookupFn, SsrfBlockedError, type SsrfPolicy } from "../network/ssrf.vibe"
import { toWellFormedUnicode, truncateWellFormed } from "../utils/unicode.vibe"
import { detectMime, extensionForMime } from "./mime.vibe"

export type FetchMediaResult = {
  buffer: Buffer
  contentType?: string
  fileName?: string
}

export type MediaFetchErrorCode =
  | "max_bytes"
  | "http_error"
  | "fetch_failed"
  | "invalid_response"

export class MediaFetchError extends Data.TaggedError("MediaFetchError")<{ readonly code: MediaFetchErrorCode; readonly name: string }> {
  constructor(code: MediaFetchErrorCode, message: string, cause?: unknown) {
    super({ code, name: "MediaFetchError" })
    this.message = message
    if (cause !== undefined) {
      Object.defineProperty(this, "cause", { value: cause, writable: true, configurable: true })
    }
  }
}

module node {
  import { Buffer } from "node:buffer"

  /** @throws {RangeError | TypeError} */
  export function mediaFetchSignal(timeoutMs: number, signal: AbortSignal | undefined): AbortSignal {
    const timeoutSignal = AbortSignal.timeout(timeoutMs)
    return signal ? AbortSignal.any([signal, timeoutSignal]) : timeoutSignal
  }

  /** @throws {never} */
  export function bufferOf(bytes: ArrayBuffer): Buffer {
    return Buffer.from(bytes)
  }

  /** @throws {never} */
  export function concatBytes(chunks: Uint8Array[], total: number): Buffer {
    return Buffer.concat(chunks, total)
  }
}
import { bufferOf, concatBytes, mediaFetchSignal } from node

export type FetchLike = (
  input: RequestInfo | URL,
  init?: RequestInit,
) => Promise<Response>

export const DEFAULT_MEDIA_FETCH_TIMEOUT_MS = 10_000

export type FetchMediaOptions = {
  url: string
  fetchImpl?: FetchLike
  filePathHint?: string

  userAgent?: string
  maxBytes?: number
  maxRedirects?: number
  timeoutMs?: number

  signal?: AbortSignal

  requiredContentTypePrefix?: string

  rejectContentEncoding?: boolean
  ssrfPolicy?: SsrfPolicy
  lookupFn?: LookupFn
  pinnedFetchImpl?: PinnedLookupFetchLike
}

function stripQuotes(value: string): string {
  return value.replace(/^["']|["']$/g, "")
}

function getBasename(p: string): string {
  return p.split(/[\\/]/).pop() || ""
}
function getExtname(p: string): string {
  const base = getBasename(p)
  const match = base.match(/\.[^.]+$/)
  return match ? match[0] : ""
}

function parseContentDispositionFileName(
  header?: string | null,
): string | undefined {
  if (!header) {
    return undefined
  }
  const parameters = Array.from(
    header.matchAll(
      /(?:^|;)\s*([^=;\s]+)\s*=\s*(?:"((?:\\.|[^"\\])*)"|([^;]*))/g,
    ),
  )
  const starMatch = parameters.find(
    (parameter) => parameter[1].toLowerCase() === "filename*",
  )
  if (starMatch) {
    const cleaned = stripQuotes((starMatch[2] ?? starMatch[3]).trim())

    const extValueMatch = /^([^']*)'([^']*)'([\s\S]*)$/.exec(cleaned)
    const encoded = extValueMatch ? extValueMatch[3] : cleaned
    try {
      const decoded = extValueMatch?.[1].toLowerCase() === "iso-8859-1"
        ? encoded.replace(/%([0-9a-f]{2})/gi, (_match, hex: string) => String.fromCharCode(Number.parseInt(hex, 16)))
        : decodeURIComponent(encoded)
      return getBasename(decoded)
    } catch {
      return getBasename(encoded)
    }
  }
  const match = parameters.find(
    (parameter) => parameter[1].toLowerCase() === "filename",
  )
  if (match) {
    const value = match[2] === undefined
      ? stripQuotes(match[3].trim())
      : match[2].replace(/\\(.)/g, "$1")
    return getBasename(value)
  }
  return undefined
}

effect function readErrorBodySnippet(
  res: Response,
  maxChars = 200,
) {
  return Effect.catchDefect(snippetOf(res, maxChars), () => succeed(undefined)) catch () => undefined
}
export const readErrorBodySnippetPromise = promised(readErrorBodySnippet)

effect function snippetOf(res: Response, maxChars: number) {
  const { buffer, truncated } = try readBoundedBody(res, maxChars * 4, "truncate")
  const text = try Effect.try(() => new TextDecoder().decode(buffer, { stream: truncated }))
  if (!text) {
    return undefined
  }
  const collapsed = text.replace(/\s+/g, " ").trim()
  if (!collapsed) {
    return undefined
  }
  const wellFormed = toWellFormedUnicode(collapsed)
  if (!truncated && wellFormed.length <= maxChars) {
    return wellFormed
  }
  const budget = Math.max(0, maxChars - 1)
  return `${truncateWellFormed(wellFormed, budget).trimEnd()}…`
}

effect function enforceResponsePolicy(
  res: Response,
  url: string,
  options: FetchMediaOptions,
) {
  const requiredPrefix = options.requiredContentTypePrefix
    ?.trim()
    .toLowerCase()
  if (requiredPrefix) {
    const declared = res.headers.get("content-type")?.trim().toLowerCase()
    if (!declared?.startsWith(requiredPrefix)) {
      throw new MediaFetchError(
        "invalid_response",
        `Failed to fetch media from ${url}: expected Content-Type starting with ${requiredPrefix}`,
      )
    }
  }

  if (options.rejectContentEncoding) {
    const encoding = res.headers.get("content-encoding")?.trim().toLowerCase()
    if (encoding && encoding !== "identity") {
      throw new MediaFetchError(
        "invalid_response",
        `Failed to fetch media from ${url}: encoded response bodies are not accepted`,
      )
    }
  }
}

effect function fetchGuardedMedia(options: FetchMediaOptions) {
  const timeoutMs = options.timeoutMs ?? DEFAULT_MEDIA_FETCH_TIMEOUT_MS
  const compositeSignal = try Effect.try({
    try: () => mediaFetchSignal(timeoutMs, options.signal),
    catch: (cause) => new Foreign({ cause }),
  })
  const guarded = fetchWithSsrfGuard({
    url: options.url,
    init: options.userAgent === undefined
      ? undefined
      : { headers: { "User-Agent": options.userAgent } },
    fetchImpl: options.fetchImpl,
    maxRedirects: options.maxRedirects,
    signal: compositeSignal,
    policy: options.ssrfPolicy,
    lookupFn: options.lookupFn,
    pinnedFetchImpl: options.pinnedFetchImpl,
  })
  return asLegacy(Error, guarded, SsrfBlockedError) catch effect (error) => {
    const err = thrownValue(error)
    throw new MediaFetchError(
      "fetch_failed",
      `Failed to fetch media from ${options.url}: ${String(err)}`,
      err,
    )
  }
}

effect function throwIfHttpError(
  res: Response,
  url: string,
  finalUrl: string,
) {
  if (res.ok) {
    return
  }

  const statusText = res.statusText ? ` ${res.statusText}` : ""
  const redirected = finalUrl !== url ? ` (redirected to ${finalUrl})` : ""
  let detail = `HTTP ${res.status}${statusText}`
  if (!res.body) {
    detail = `HTTP ${res.status}${statusText}; empty response body`
  } else {
    const snippet = try readErrorBodySnippet(res)
    if (snippet) {
      detail += `; body: ${snippet}`
    }
  }
  throw new MediaFetchError(
    "http_error",
    `Failed to fetch media from ${url}${redirected}: ${detail}`,
  )
}

effect function enforceContentLengthLimit(
  res: Response,
  url: string,
  maxBytes?: number,
) {
  const contentLength = res.headers.get("content-length")
  if (maxBytes === undefined || !contentLength) {
    return
  }

  const length = Number(contentLength)
  if (Number.isFinite(length) && length > maxBytes) {
    throw new MediaFetchError(
      "max_bytes",
      `Failed to fetch media from ${url}: content length ${length} exceeds maxBytes ${maxBytes}`,
    )
  }
}

function fileNameFromUrl(url: string): string | undefined {
  try {
    const parsed = new URL(url)
    let pathname = parsed.pathname
    try {
      pathname = decodeURIComponent(pathname)
    } catch {
    }
    const base = getBasename(pathname)
    return base || undefined
  } catch {
    return undefined
  }
}

effect function resolveMediaMetadata(params: {
  res: Response
  buffer: Buffer
  finalUrl: string
  filePathHint?: string
}) {
  const { res, buffer, finalUrl, filePathHint } = params
  const headerFileName = parseContentDispositionFileName(
    res.headers.get("content-disposition"),
  )
  let fileName = headerFileName
    || fileNameFromUrl(finalUrl)
    || (filePathHint ? getBasename(filePathHint) : undefined)

  const filePathForMime = headerFileName && getExtname(headerFileName)
    ? headerFileName
    : (filePathHint ?? finalUrl)
  const contentType = try detectMime({
    buffer,
    headerMime: res.headers.get("content-type"),
    filePath: filePathForMime,
  })
  if (fileName && !getExtname(fileName) && contentType) {
    const ext = extensionForMime(contentType)
    if (ext) {
      fileName = `${fileName}${ext}`
    }
  }

  return {
    contentType: contentType ?? undefined,
    fileName,
  } satisfies Pick<FetchMediaResult, "contentType" | "fileName">
}

export effect function fetchRemoteMedia(options: FetchMediaOptions) {
  const { response: res, finalUrl, release } = try fetchGuardedMedia(options)
  const fetched = effect {
    try throwIfHttpError(res, options.url, finalUrl)
    try enforceResponsePolicy(res, options.url, options)
    try enforceContentLengthLimit(res, options.url, options.maxBytes)

    const buffer = options.maxBytes !== undefined
      ? try readResponseWithLimit(res, options.maxBytes)
      : bufferOf(try foreign(() => res.arrayBuffer()))
    const metadata = try resolveMediaMetadata({
      res,
      buffer,
      finalUrl,
      filePathHint: options.filePathHint,
    })

    return {
      buffer,
      ...metadata,
    } satisfies FetchMediaResult
  }
  return try ensuring(fetched, effect {
    foreign(() => res.body?.cancel()) catch () => undefined
    try orDie(foreign(() => release()))
  })
}
export const fetchRemoteMediaPromise = promised(fetchRemoteMedia)

export effect function readResponseWithLimit(
  res: Response,
  maxBytes: number,
) {
  return (try readBoundedBody(res, maxBytes, "throw")).buffer
}
export const readResponseWithLimitPromise = promised(readResponseWithLimit)

function exceedsMaxBytes(res: Response, maxBytes: number): MediaFetchError {
  return new MediaFetchError(
    "max_bytes",
    `Failed to fetch media from ${res.url || "response"}: payload exceeds maxBytes ${maxBytes}`,
  )
}

effect function readBoundedBody(
  res: Response,
  maxBytes: number,
  onOverflow: "throw" | "truncate",
) {
  const body = res.body
  if (!body) {
    const fallback = bufferOf(try foreign(() => res.arrayBuffer()))
    if (fallback.length <= maxBytes) {
      return { buffer: fallback, truncated: false }
    }
    if (onOverflow === "throw") {
      throw exceedsMaxBytes(res, maxBytes)
    }
    return { buffer: fallback.subarray(0, maxBytes), truncated: true }
  }

  const reader = try Effect.try({
    try: () => body.getReader(),
    catch: (cause) => new Foreign({ cause }),
  })
  const read = effect {
    const chunks: Uint8Array[] = []
    let total = 0
    let truncated = false
    while (true) {
      const { done, value } = try foreign(() => reader.read())
      if (done) {
        break
      }
      if (value.length) {
        if (total + value.length > maxBytes) {
          foreign(() => reader.cancel()) catch () => undefined
          if (onOverflow === "throw") {
            throw exceedsMaxBytes(res, maxBytes)
          }
          chunks.push(value.subarray(0, maxBytes - total))
          total = maxBytes
          truncated = true
          break
        }
        total += value.length
        chunks.push(value)
      }
    }
    return { buffer: concatBytes(chunks, total), truncated }
  }
  return try ensuring(read, sync(() => {
    try {
      reader.releaseLock()
    } catch {
    }
  }))
}
