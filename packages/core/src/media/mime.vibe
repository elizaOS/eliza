// spec/core/media.md, "Specific sniffed types win and generic containers defer to a known extension"
import { chooseMime, type MimeCandidate } from "../../gen/core__media.effect.vibe"
import { foreign, promised } from "../edge.vibe"

const EXT_BY_MIME: Record<string, string> = {
  "image/heic": ".heic",
  "image/heif": ".heif",
  "image/jpeg": ".jpg",
  "image/png": ".png",
  "image/webp": ".webp",
  "image/gif": ".gif",
  "audio/ogg": ".ogg",
  "audio/mpeg": ".mp3",
  "audio/x-m4a": ".m4a",
  "audio/mp4": ".m4a",
  "video/mp4": ".mp4",
  "video/quicktime": ".mov",
  "application/pdf": ".pdf",
  "application/json": ".json",
  "application/zip": ".zip",
  "application/gzip": ".gz",
  "application/x-tar": ".tar",
  "application/x-7z-compressed": ".7z",
  "application/vnd.rar": ".rar",
  "application/msword": ".doc",
  "application/vnd.ms-excel": ".xls",
  "application/vnd.ms-powerpoint": ".ppt",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document": ".docx",
  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": ".xlsx",
  "application/vnd.openxmlformats-officedocument.presentationml.presentation": ".pptx",
  "text/csv": ".csv",
  "text/plain": ".txt",
  "text/markdown": ".md",
}

const MIME_BY_EXT: Record<string, string> = {
  ...Object.fromEntries(
    Object.entries(EXT_BY_MIME).map(([mime, ext]) => [ext, mime]),
  ),
  ".jpeg": "image/jpeg",
}

function normalizeHeaderMime(mime?: string | null): string | undefined {
  if (!mime) return undefined
  const cleaned = mime.split(";")[0].trim().toLowerCase()
  return cleaned || undefined
}

export function getFileExtension(filePath?: string | null): string | undefined {
  if (!filePath) return undefined
  let candidate = filePath
  try {
    if (/^https?:\/\//i.test(filePath)) candidate = new URL(filePath).pathname
  } catch {}

  const base = candidate.split(/[\\/]/).pop() ?? ""
  const dotIndex = base.lastIndexOf(".")
  if (dotIndex === -1) return undefined
  const ext = base.slice(dotIndex + 1).toLowerCase()
  return ext ? `.${ext}` : undefined
}

function isGenericMime(mime?: string): boolean {
  if (!mime) return true
  const m = mime.toLowerCase()
  return m === "application/octet-stream" || m === "application/zip"
}

function mimeCandidate(value: string | undefined): MimeCandidate {
  return { present: value !== undefined, generic: isGenericMime(value), value: value ?? "" }
}

export effect function detectMime(opts: {
  buffer?: Uint8Array
  headerMime?: string | null
  filePath?: string
}) {
  const ext = getFileExtension(opts.filePath)
  const extension = mimeCandidate(ext ? MIME_BY_EXT[ext] : undefined)
  const header = mimeCandidate(normalizeHeaderMime(opts.headerMime))
  const sniffed = try sniffMime(opts.buffer)
  return chooseMime(mimeCandidate(sniffed), extension, header) || undefined
}
export const detectMimePromise = promised(detectMime)

export function extensionForMime(mime?: string | null): string | undefined {
  if (!mime) return undefined
  return EXT_BY_MIME[mime.toLowerCase()]
}

effect function sniffMime(buffer?: Uint8Array) {
  if (!buffer) return undefined
  const { fileTypeFromBuffer } = try foreign(() => import("file-type"))
  return (try foreign(() => fileTypeFromBuffer(buffer)))?.mime
}
export const sniffMimePromise = promised(sniffMime)
