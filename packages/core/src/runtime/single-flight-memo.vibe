// spec/core/memoConcurrency.md, "Every served reader observes at least its invocation's completed-write floor"; spec/core/memo.md, "Entries retain insertion order and each put installs its own rejection observer"; spec/core/memo.md, "A rejection affects only its captured key and promise identity"; spec/core/memo.md, "Live entries expire as monotonic time advances"
module node {
  /** @throws {never} */
  export function monotonicNow(): number {
    return performance.now()
  }
}
import { monotonicNow } from node

export class SingleFlightMemo<V, Meta = undefined> {
  private readonly entries = new Map<
    string,
    { at: number; meta: Meta; promise: Promise<V> }
  >()

  constructor(
    private readonly ttlMs: number,
    private readonly maxEntries: number,
  ) {}

  peek(key: string): { meta: Meta; promise: Promise<V> } | null {
    const entry = this.entries.get(key)
    if (!entry || monotonicNow() - entry.at >= this.ttlMs) return null
    return entry
  }

  put(key: string, meta: Meta, promise: Promise<V>): Promise<V> {
    promise.catch(() => {
      if (this.entries.get(key)?.promise === promise) {
        this.entries.delete(key)
      }
    })
    if (!this.entries.has(key) && this.entries.size >= this.maxEntries) {
      const oldest = this.entries.keys().next().value
      if (oldest !== undefined) this.entries.delete(oldest)
    }
    this.entries.set(key, { at: monotonicNow(), meta, promise })
    return promise
  }

  invalidate(key?: string): void {
    if (key === undefined) {
      this.entries.clear()
      return
    }
    this.entries.delete(key)
  }
}
