// spec/core/models.md, "Admission checks the complete request without changing its source bytes"
import { thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import type { ChatMessage, PromptSegment, ToolDefinition } from "../types/model.vibe"
import { utf8ByteLength } from "../utils/unicode.vibe"

export { utf8ByteLength }

export const DEFAULT_CONTEXT_WINDOW_TOKENS = 128_000
export const DEFAULT_INPUT_RESERVE_TOKENS = 10_000

export const MODEL_WINDOW_RESERVE_FRACTION = 0.2

export interface ModelInputBudget {
  estimatedInputTokens: number
  contextWindowTokens: number
  reserveTokens: number
  dispatchThresholdTokens: number
  estimationMode: "heuristic" | "utf8-upper-bound"
}

effect function serializedText(value: unknown): string!ElizaError {
  if (typeof value === "string") {
    return value
  }
  if (value == null) {
    return ""
  }
  return try Effect.try({
    try: () => JSON.stringify(value) ?? "",
    catch: (cause) =>
      new ElizaError("Model input cannot be serialized completely", {
        code: "MODEL_INPUT_SERIALIZATION_FAILED",
        cause,
      }),
  })
}

type EstimationMode = ModelInputBudget["estimationMode"]

effect function textMeasure(value: unknown, mode: EstimationMode): number!ElizaError {
  const text = try serializedText(value)
  return mode === "utf8-upper-bound" ? utf8ByteLength(text) : text.length
}

effect function totalMeasure(values: readonly unknown[], mode: EstimationMode): number!ElizaError {
  let total = 0
  for (const value of values) {
    total += try textMeasure(value, mode)
  }
  return total
}

export function estimateTokensFromChars(chars: number): number {
  return Math.ceil(chars / 3.5)
}

effect function estimateModelInputTokens(args: {
  completeRequest?: unknown
  messages?: readonly ChatMessage[]
  promptSegments?: readonly PromptSegment[]
  tools?: readonly ToolDefinition[]
  system?: unknown
  prompt?: unknown
  input?: unknown
  responseSchema?: unknown
  responseFormat?: unknown
  grammar?: unknown
  responseSkeleton?: unknown
  prefill?: unknown
  estimationMode?: EstimationMode
}): number!ElizaError {
  const estimationMode = args.estimationMode ?? "heuristic"
  const upperBound = estimationMode === "utf8-upper-bound"
  if (Object.hasOwn(args, "completeRequest")) {
    const measured = try textMeasure(args.completeRequest, estimationMode)
    return upperBound ? measured : estimateTokensFromChars(measured)
  }
  const messageChars = upperBound
    ? try textMeasure(args.messages, estimationMode)
    : try totalMeasure(args.messages?.map((message) => message.content) ?? [], estimationMode)
  const segmentChars = args.messages && args.messages.length > 0
    ? 0
    : upperBound
    ? try textMeasure(args.promptSegments, estimationMode)
    : try totalMeasure(args.promptSegments?.map((segment) => segment.content) ?? [], estimationMode)
  const toolChars = upperBound
    ? try textMeasure(args.tools, estimationMode)
    : try totalMeasure(args.tools ?? [], estimationMode)
  const additionalChars = try totalMeasure([
    args.system,
    args.prompt,
    args.input,
    args.responseSchema,
    args.responseFormat,
    args.grammar,
    args.responseSkeleton,
    args.prefill,
  ], estimationMode)
  const measured = segmentChars + messageChars + toolChars + additionalChars
  return upperBound ? measured : estimateTokensFromChars(measured)
}

export effect function buildModelInputBudget(args: {
  completeRequest?: unknown
  messages?: readonly ChatMessage[]
  promptSegments?: readonly PromptSegment[]
  tools?: readonly ToolDefinition[]
  system?: unknown
  prompt?: unknown
  input?: unknown
  responseSchema?: unknown
  responseFormat?: unknown
  grammar?: unknown
  responseSkeleton?: unknown
  prefill?: unknown

  estimationMode?: EstimationMode

  contextWindowTokens?: number

  reserveTokens?: number

  modelName?: string
}): ModelInputBudget!ElizaError {
  const explicitWindow = Number.isFinite(args.contextWindowTokens) && args.contextWindowTokens
    ? Math.max(1, Math.floor(args.contextWindowTokens))
    : undefined

  const contextWindowTokens = explicitWindow ?? DEFAULT_CONTEXT_WINDOW_TOKENS
  const reserveTokens = Number.isFinite(args.reserveTokens) && args.reserveTokens !== undefined
    ? Math.max(0, Math.floor(args.reserveTokens))
    : DEFAULT_INPUT_RESERVE_TOKENS

  const dispatchThresholdTokens = Math.max(
    1,
    contextWindowTokens - reserveTokens,
  )
  const estimatedInputTokens = try estimateModelInputTokens(args)
  const estimationMode = args.estimationMode ?? "heuristic"
  return {
    estimatedInputTokens,
    contextWindowTokens,
    reserveTokens,
    dispatchThresholdTokens,
    estimationMode,
  }
}
export const buildModelInputBudgetOrThrow = thrown(buildModelInputBudget)

export function withModelInputBudgetProviderOptions<
  T extends Record<string, unknown>,
>(providerOptions: T, budget: ModelInputBudget): T {
  const eliza = typeof providerOptions.eliza === "object" && providerOptions.eliza !== null
    ? (providerOptions.eliza as Record<string, unknown>)
    : {}
  return {
    ...providerOptions,
    eliza: {
      ...eliza,
      modelInputBudget: budget,
    },
  } as T
}
