  const entityIds = Array.isArray(params.entityIds) && params.entityIds.length > 0
    ? params.entityIds
    : params.entityId
    ? [params.entityId]
    : []
  return try foreign(() => current.getRelationships({ entityIds, tags: params.tags, limit: params.limit, offset: params.offset }))
}

export effect function getTasks(params: { roomId?: UUID; worldId?: UUID; tags?: string[]; entityId?: UUID; limit?: number; offset?: number; }): Task[]!StoreFailure!RuntimeKernel {
  try validateTaskQueryPagination(params)
  const { runtime } = try Host
  return try foreign(() => runtime.adapter.getTasks({ ...params, agentIds: [runtime.agentId] }))
}

export effect function markLocalTasksDirty(): void!Foreign!RuntimeKernel {
  const { runtime } = try Host
  try foreignSync(() => runtime.getService<TaskService>(ServiceType.TASK)?.markDirty())
}

export effect function createTask(task: Task): UUID!StoreFailure!RuntimeKernel {
  const { runtime } = try Host
  return (try foreign(() => runtime.createTasks([task])))[0]
}

export effect function getTask(id: UUID): (Task | null)!StoreFailure!RuntimeKernel {
  const current = try adapter()
  return (try foreign(() => current.getTasksByIds([id])))[0] ?? null
}

export effect function updatePendingTask(id: UUID, task: Partial<Task>): boolean!StoreFailure!RuntimeKernel {
  const current = try adapter()
  const updated = (try foreign(() => current.updatePendingTask?.call(current, id, task))) ?? false
  if (updated) try markLocalTasksDirty()
  return updated
}

export effect function patchTaskMetadata(id: UUID, patch: TaskMetadataPatch): TaskMetadataPatchOutcome!StoreFailure!RuntimeKernel {
  const current = try adapter()
  if (patch.wake && current.supportsAtomicTaskWake !== true) return "unsupported"
  const patcher = current.patchTaskMetadata
  if (typeof patcher !== "function") return "unsupported"
  const patched = try foreign(() => patcher.call(current, id, patch))
  if (patched) try markLocalTasksDirty()
  return patched ? "patched" : "missing"
}

export effect function updateTask(id: UUID, task: Partial<Task>): void!StoreFailure!RuntimeKernel {
  const { runtime } = try Host
  try foreign(() => runtime.updateTasks([{ id, task }]))
}

export effect function deleteTask(id: UUID): void!StoreFailure!RuntimeKernel {
