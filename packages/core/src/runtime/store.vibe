const READ_MEMO_TTL_MS = 1_000
const READ_MEMO_MAX_ENTRIES = 1_000
const ROOM_MESSAGES_MEMO_MIN_WINDOW = 50
const GET_ALL_MEMORIES_PAGE_SIZE = 10_000
const CONNECTION_BATCH_SIZE = 5_000
const WORLD_ENSURE_ATTEMPTS = 3
const AGENT_MEMORY_TABLES = ["memories", "messages", "facts", "documents", "document_fragments", "transcripts"]

export error WorldIdRequired { message: string }
export error RoomCreateFailed { message: string }
export error ParticipantLinkFailed { message: string }
export error AgentRecordMissing { message: string }
export error AgentIdRequired { message: string }
export error AgentEntityUnavailable { message: string }

type ConnectionFailure = Effect.Error<ReturnType<typeof ensureConnectionStandalone>>

export interface GetMemoriesParams {
  entityId?: UUID
  authorEntityIds?: UUID[]
  agentId?: UUID
  roomId?: UUID
  excludeRoomIds?: UUID[]
  limit?: number
  count?: number
  offset?: number
  cursor?: { createdAt: number; id: UUID }
  unique?: boolean
  tableName: string
  start?: number
  end?: number
  worldId?: UUID
  metadata?: Record<string, unknown>
  textContains?: string
  orderBy?: "createdAt"
  orderDirection?: "asc" | "desc"
  includeEmbedding?: boolean
  accessContext?: AccessContext
}

export type StoreFailure =
  | WorldIdRequired
  | RoomCreateFailed
  | ParticipantLinkFailed
  | AgentRecordMissing
  | AgentIdRequired
  | AgentEntityUnavailable
  | InvalidPagination
  | ConnectionFailure
  | ElizaError
  | Foreign

export service Store {
  static readonly key = "@elizaos/core/runtime/Store"
  readonly mutations: RuntimeDataMutations
  readonly roomReadMemo: SingleFlightMemo<Room | null>
  readonly roomMessagesMemo: SingleFlightMemo<Memory[], number>
}

module edge {
  import type { Kernel } from "../edge.vibe"
  import { getSecretsForRedaction } from "./agent-settings.vibe"
  import type { RuntimeKernel } from "./kernel.vibe"

  /** @throws {never} */
  export function secretsForRedaction(kernel: () => Kernel<RuntimeKernel>): () => Record<string, string> {
    return () => kernel().runSync(getSecretsForRedaction())
  }
}
import { secretsForRedaction } from edge

function invalidateTurnEntityDetails(agentId: UUID): void {
  invalidateTurnMemoPrefix(`entity-details:${agentId}:`)
}

function invalidateTurnIdentityClusters(agentId: UUID): void {
  invalidateTurnMemoPrefix(`identity-cluster:${agentId}:`)
  invalidateTurnMemoPrefix(`verified-identity-cluster:${agentId}:`)
}

export const StoreLive: Layer.Layer<Store, never, Host | Settings> = Layer.effect(Store, effect {
  const { runtime, kernel } = try Host
  const roomReadMemo = new SingleFlightMemo<Room | null>(READ_MEMO_TTL_MS, READ_MEMO_MAX_ENTRIES)
  const roomMessagesMemo = new SingleFlightMemo<Memory[], number>(READ_MEMO_TTL_MS, READ_MEMO_MAX_ENTRIES)
  const mutations = new RuntimeDataMutations(runtime, {
    invalidateTurnEntityDetails: () => invalidateTurnEntityDetails(runtime.agentId),
    invalidateTurnIdentityClusters: () => invalidateTurnIdentityClusters(runtime.agentId),
    getSecretsForRedaction: secretsForRedaction(kernel),
    roomMessagesMemo: () => roomMessagesMemo,
    roomReadMemo: () => roomReadMemo,
  })
  return { mutations, roomReadMemo, roomMessagesMemo }
})

