export effect function getComponentsByType(type: string, agentId?: UUID, options?: { entityContext?: UUID }): Component[]!StoreFailure!RuntimeKernel {
  const { runtime } = try Host
  const entities = try foreign(() =>
    runtime.adapter.queryEntities({
      componentType: type,
      agentId: agentId ?? runtime.agentId,
      includeAllComponents: false,
      ...(options?.entityContext != null && { entityContext: options.entityContext }),
    })
  )
  const components: Component[] = []
  for (const entity of entities) {
    if (entity.components) components.push(...entity.components)
  }
  return components
}

