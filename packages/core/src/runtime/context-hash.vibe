// spec/core/execution.md, "Story: Settle an action before publishing its callback"
import { failingAs, Foreign, thrown } from "../edge.vibe"
import { sha256Hex } from "./trajectory-provider-attribution.vibe"

type StableJsonValue =
  | string
  | number
  | boolean
  | null
  | readonly StableJsonValue[]
  | { readonly [key: string]: StableJsonValue | undefined }

interface HashablePromptSegment {
  content: string
  stable?: boolean
  id?: string
  label?: string
  metadata?: StableJsonValue
}

interface PrefixHash {
  index: number
  hash: string
  segmentHash: string
}

module stable {
  export class UnstableJsonFault extends TypeError {}

  /** @throws {TypeError} */
  export function stableStringifyValue(value: unknown, seen: WeakSet<object>): string {
    if (value === null) {
      return "null"
    }

    const type = typeof value
    if (type === "string" || type === "number" || type === "boolean") {
      return JSON.stringify(value)
    }

    if (type === "bigint") {
      throw new UnstableJsonFault("Cannot stable stringify BigInt values as JSON")
    }

    if (type === "undefined" || type === "function" || type === "symbol") {
      return ""
    }

    if (seen.has(value as object)) {
      throw new UnstableJsonFault("Cannot stable stringify circular structures")
    }
    seen.add(value as object)

    if (Array.isArray(value)) {
      const serialized = `[${
        value
          .map((item) => {
            const serialized = stableStringifyValue(item, seen)
            return serialized === "" ? "null" : serialized
          })
          .join(",")
      }]`
      seen.delete(value)
      return serialized
    }

    const record = value as Record<string, unknown>
    const keys = Object.keys(record).sort((left, right) => left < right ? -1 : left > right ? 1 : 0)
    let serialized = ""
    for (const key of keys) {
      const entry = stableStringifyValue(record[key], seen)
      if (entry === "") continue
      serialized += `${serialized ? "," : ""}${JSON.stringify(key)}:${entry}`
    }
    seen.delete(value as object)
    return `{${serialized}}`
  }
}
import { stableStringifyValue, UnstableJsonFault } from stable

export error UnstableJson { message: string }

export effect function hashString(value: string): string!! {
  return sha256Hex(value)
}

export const hashStringOrThrow = thrown(hashString)

export effect function stableJsonStringify(value: unknown): string!(UnstableJson | Foreign) {
  const serialized = try Effect.try({
    try: () => stableStringifyValue(value, new WeakSet()),
    catch: (cause) => cause instanceof UnstableJsonFault ? new UnstableJson({ message: cause.message }) : new Foreign({ cause }),
  })
  return serialized === "" ? "null" : serialized
}

export const stableJsonStringifyOrThrow = thrown(failingAs(TypeError, stableJsonStringify))

export effect function hashStableJson(value: unknown): string!(UnstableJson | Foreign) {
  return try hashString(try stableJsonStringify(value))
}

export const hashStableJsonOrThrow = thrown(failingAs(TypeError, hashStableJson))

export effect function computePrefixHashes(segments: readonly HashablePromptSegment[]): PrefixHash[]!(UnstableJson | Foreign) {
  let prefixHash = try hashStableJson({ contextPrefix: [] })
  const hashes: PrefixHash[] = []
  for (const [index, segment] of segments.map((segment, index) => [index, segment] as const)) {
    const segmentHash = try hashStableJson({
      content: segment.content,
      id: segment.id,
      label: segment.label,
      metadata: segment.metadata,
      stable: Boolean(segment.stable),
    })
    prefixHash = try hashStableJson({ previousPrefixHash: prefixHash, segmentHash })
    hashes.push({ index, hash: prefixHash, segmentHash })
  }
  return hashes
}

export const computePrefixHashesOrThrow = thrown(failingAs(TypeError, computePrefixHashes))
