// spec/core/execution.md, "Story: Settle an action before publishing its callback"
import { failingAs, Foreign, thrown } from "../edge.vibe"

module stable {
  import { sha256Hex } from "./trajectory-provider-attribution.vibe"

  export type StableJsonValue =
    | string
    | number
    | boolean
    | null
    | readonly StableJsonValue[]
    | { readonly [key: string]: StableJsonValue | undefined }

  export interface HashablePromptSegment {
    content: string
    stable?: boolean
    id?: string
    label?: string
    metadata?: StableJsonValue
  }

  export interface PrefixHash {
    index: number
    hash: string
    segmentHash: string
  }

  export class UnstableJsonFault extends TypeError {}

  /** @throws {TypeError} */
  export function stableStringifyValue(value: unknown, seen: WeakSet<object>): string {
    if (value === null) {
      return "null"
    }

    const type = typeof value
    if (type === "string" || type === "number" || type === "boolean") {
      return JSON.stringify(value)
    }

    if (type === "bigint") {
      throw new UnstableJsonFault("Cannot stable stringify BigInt values as JSON")
    }

    if (type === "undefined" || type === "function" || type === "symbol") {
      return ""
    }

    if (seen.has(value as object)) {
      throw new UnstableJsonFault("Cannot stable stringify circular structures")
    }
    seen.add(value as object)

    if (Array.isArray(value)) {
      const serialized = `[${
        value
          .map((item) => {
            const serialized = stableStringifyValue(item, seen)
            return serialized === "" ? "null" : serialized
          })
          .join(",")
      }]`
      seen.delete(value)
      return serialized
    }

    const record = value as Record<string, unknown>
    const keys = Object.keys(record).sort((left, right) => left < right ? -1 : left > right ? 1 : 0)
    let serialized = ""
    for (const key of keys) {
      const entry = stableStringifyValue(record[key], seen)
      if (entry === "") continue
      serialized += `${serialized ? "," : ""}${JSON.stringify(key)}:${entry}`
    }
    seen.delete(value as object)
    return `{${serialized}}`
  }

  /** @throws {TypeError} */
  export function stableJson(value: unknown): string {
    const serialized = stableStringifyValue(value, new WeakSet())
    return serialized === "" ? "null" : serialized
  }

  /** @throws {TypeError} */
  export function hashStable(value: unknown): string {
    return sha256Hex(stableJson(value))
  }

  /** @throws {TypeError} */
  export function prefixHashes(segments: readonly HashablePromptSegment[]): PrefixHash[] {
    let prefixHash = hashStable({ contextPrefix: [] })
    return segments.map((segment, index) => {
      const segmentHash = hashStable({
        content: segment.content,
        id: segment.id,
        label: segment.label,
        metadata: segment.metadata,
        stable: Boolean(segment.stable),
      })
      prefixHash = hashStable({ previousPrefixHash: prefixHash, segmentHash })
      return { index, hash: prefixHash, segmentHash }
    })
  }
}
import { hashStable, prefixHashes, stableJson, UnstableJsonFault, type HashablePromptSegment, type PrefixHash } from stable
import { sha256Hex } from "./trajectory-provider-attribution.vibe"

export error UnstableJson { message: string }

function serializationFailure(cause: unknown): UnstableJson | Foreign {
  return cause instanceof UnstableJsonFault ? new UnstableJson({ message: cause.message }) : new Foreign({ cause })
}

effect function hashString(value: string): string!! {
  return sha256Hex(value)
}

export const hashStringOrThrow = thrown(hashString)

effect function stableJsonStringify(value: unknown): string!(UnstableJson | Foreign) {
  return try Effect.try({ try: () => stableJson(value), catch: serializationFailure })
}

export const stableJsonStringifyOrThrow = thrown(failingAs(TypeError, stableJsonStringify))

export effect function hashStableJson(value: unknown): string!(UnstableJson | Foreign) {
  return try Effect.try({ try: () => hashStable(value), catch: serializationFailure })
}

export const hashStableJsonOrThrow = thrown(failingAs(TypeError, hashStableJson))

effect function computePrefixHashes(segments: readonly HashablePromptSegment[]): PrefixHash[]!(UnstableJson | Foreign) {
  return try Effect.try({ try: () => prefixHashes(segments), catch: serializationFailure })
}

export const computePrefixHashesOrThrow = thrown(failingAs(TypeError, computePrefixHashes))
