// spec/core/context.md, "Context starts with complete original sources and mandatory evidence"; spec/core/context.md, "Only complete current-source selections project prior dialogue"; spec/core/context.md, "A historical evidence projection requires exact validated source binding"
import { failingAs, type Foreign, thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import type { ActionParameterSchema, CompletionContextSelection } from "../types/components.vibe"
import { normalizeEffectReceipt } from "../types/effects.vibe"
import type { JSONSchema } from "../types/model.vibe"
import { hashStableJson, type UnstableJson } from "./context-hash.vibe"
import type { ContextEvent, ContextObject, ContextSegmentEvent } from "./context-object.vibe"

export const HISTORICAL_EFFECT_TERMINALS: unique symbol = Symbol(
  "historicalEffectTerminals",
)
export interface HistoricalEffectTerminal {
  requestSourceEventId: string
  originalReceiptHash: string
  terminalReceipt: unknown
  state: "done" | "rejected" | "expired"
}

effect function hasHistoricalTerminal(
  event: ContextSegmentEvent,
  requestSourceEventId: string,
  receipt: unknown,
) {
  const proofs = (
    event as ContextSegmentEvent & {
      [HISTORICAL_EFFECT_TERMINALS]?: readonly HistoricalEffectTerminal[]
    }
  )[HISTORICAL_EFFECT_TERMINALS]
  if (!proofs?.length) return false
  const receiptHash = try hashStableJson(receipt)
  for (const proof of proofs) {
    if (
      proof.requestSourceEventId === requestSourceEventId
      && HISTORICAL_TERMINAL_STATES.has(proof.state)
      && (proof.originalReceiptHash === receiptHash
        || (try hashStableJson(proof.terminalReceipt)) === receiptHash)
    ) {
      return true
    }
  }
  return false
}

const HISTORICAL_TERMINAL_STATES: ReadonlySet<string> = new Set([
  "done",
  "rejected",
  "expired",
])

const SOURCE_ID_PATTERN = /^h[1-9]\d*$/

export const COMPLETION_CONTEXT_SELECTION_INSTRUCTIONS =
  `History selection: use the source map to select original facts, applicable standing constraints/corrections, referents and explicitly continued unfinished work in completionContext. Assign each source once; its exact text remains intact. Completed tasks are not pending, and task-scoped restrictions do not automatically become standing rules. Preserve corrections and original speaker attribution; navigation receipts follow their request.
Use relevant_prior_dialogue with complete=true when dependencies are resolved (an empty selection is valid), otherwise all_prior_dialogue with complete=false. Exhaustive dialogue coverage needs all originals; live-record questions need tools. Use the sourceSetId required by the response schema. Current request, system/provider constraints and receipts remain complete; selection proves relevance, never execution.`

export const COMPLETION_CONTEXT_SCHEMA = {
  type: "object",
  additionalProperties: false,
  properties: {
    mode: {
      type: "string",
      enum: [
        "relevant_prior_dialogue",
        "all_prior_dialogue",
        "selected",
        "full",
      ],
      description:
        "relevant_prior_dialogue is the completed relevance review, including a reviewed empty selection. all_prior_dialogue is for unresolved dialogue dependencies, exhaustive conversation coverage/counting, or no source set. This selects prior messages, never live app records or tool results. selected/full are legacy aliases.",
    },
    sourceSetId: {
      type: "string",
      pattern: "^(?:[0-9a-f]{64})?$",
      description:
        "Copy the entire 64-character completion_source_set value exactly. Never abbreviate or generate it. Use an empty string only when no source set is supplied.",
    },
    complete: {
      type: "boolean",
      description:
        "True only after reviewing all labeled prior user and assistant sources and including every applicable constraint, correction, referent and referenced pending intent. It certifies this source selection, not completion of future tool work.",
    },
    relevantSourceIds: {
      type: "array",
      items: { type: "string", pattern: SOURCE_ID_PATTERN.source },
    },
    constraintSourceIds: {
      type: "array",
      items: { type: "string", pattern: SOURCE_ID_PATTERN.source },
    },
    referentSourceIds: {
      type: "array",
      items: { type: "string", pattern: SOURCE_ID_PATTERN.source },
    },
    pendingIntentSourceIds: {
      type: "array",
      items: { type: "string", pattern: SOURCE_ID_PATTERN.source },
    },
  },
  required: [
    "mode",
    "sourceSetId",
    "complete",
    "relevantSourceIds",
    "constraintSourceIds",
    "referentSourceIds",
    "pendingIntentSourceIds",
  ],
} satisfies JSONSchema & ActionParameterSchema

effect function withRequiredCompletionSourceIdentity(
  schema: JSONSchema,
  context: ContextObject,
  _exactRepair = false,
) {
  const completion = schema.properties?.completionContext
  const identity = completion?.properties?.sourceSetId
  if (!completion || identity?.type !== "string") return schema
  const snapshot = try completionContextSources(context)
  if (snapshot.sources.length === 0) return schema
  if (
    identity.enum !== undefined
    && (!Array.isArray(identity.enum)
      || !identity.enum.some((id) => id === snapshot.sourceSetId))
  ) {
    throw new ElizaError(
      "Source identity schema does not authorize this request.",
      {
        code: "COMPLETION_CONTEXT_IDENTITY_CONFLICT",
      },
    )
  }

  const sourceIds = snapshot.sources.map(({ id }) => id)
  const sourceIdSet = new Set(sourceIds)
  const properties = { ...completion.properties }
  for (const name of SOURCE_LIST_FIELDS) {
    const field = properties[name]
    const items = field?.items
    if (
      !field
      || !items
      || Array.isArray(items)
      || items.type !== "string"
      || (items.pattern !== undefined
        && items.pattern !== SOURCE_ID_PATTERN.source)
    ) {
      continue
    }
    const { pattern: _pattern, ...literalItems } = items
    properties[name] = {
      ...field,
      items: {
        ...literalItems,
        enum: Array.isArray(items.enum)
          ? items.enum.filter(
            (id): id is string => typeof id === "string" && sourceIdSet.has(id),
          )
          : sourceIds,
      },
    }
  }
  const { pattern: _pattern, ...literalIdentity } = identity
  properties.sourceSetId = { ...literalIdentity, enum: [snapshot.sourceSetId] }
  const required: JSONSchema = {
    ...schema,
    properties: {
      ...schema.properties,
      completionContext: { ...completion, properties },
    },
  }
  return required
}
export const withRequiredCompletionSourceIdentityOrThrow = thrown(
  failingAs(TypeError, withRequiredCompletionSourceIdentity, ElizaError),
)

const SOURCE_LIST_FIELDS = [
  "relevantSourceIds",
  "constraintSourceIds",
  "referentSourceIds",
  "pendingIntentSourceIds",
] as const
const SELECTION_FIELDS = new Set<string>([
  "mode",
  "sourceSetId",
  "complete",
  ...SOURCE_LIST_FIELDS,
])

export function parseCompletionContextSelection(
  value: unknown,
): CompletionContextSelection | undefined {
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    return undefined
  }
  const record = value as Record<string, unknown>

  const mode = record.mode === "relevant_prior_dialogue"
    ? "selected"
    : record.mode === "all_prior_dialogue"
    ? "full"
    : record.mode
  if (
    Object.keys(record).some((key) => !SELECTION_FIELDS.has(key))
    || (mode !== "full" && mode !== "selected")
    || typeof record.sourceSetId !== "string"
    || typeof record.complete !== "boolean"
  ) {
    return undefined
  }
  for (const key of SOURCE_LIST_FIELDS) {
    const ids = record[key]
    if (
      !Array.isArray(ids)
      || ids.some((id) => typeof id !== "string" || !SOURCE_ID_PATTERN.test(id))
      || new Set(ids).size !== ids.length
    ) {
      return undefined
    }
  }
  return {
    mode,
    sourceSetId: record.sourceSetId,
    complete: record.complete,
    relevantSourceIds: [...(record.relevantSourceIds as string[])],
    constraintSourceIds: [...(record.constraintSourceIds as string[])],
    referentSourceIds: [...(record.referentSourceIds as string[])],
    pendingIntentSourceIds: [...(record.pendingIntentSourceIds as string[])],
  }
}

export function collectCompletionContextSources(
  context: ContextObject,
): Array<{ id: string; event: ContextSegmentEvent }> {
  const sources: Array<{ id: string; event: ContextSegmentEvent }> = []
  for (const event of context.events) {
    if (
      event.type !== "segment"
      || event.source !== "prior-dialogue"
      || !("segment" in event)
    ) {
      continue
    }
    const segment = event.segment
    if (
      !segment
      || typeof segment !== "object"
      || Array.isArray(segment)
      || !("label" in segment)
      || (segment.label !== "prior_message:user"
        && segment.label !== "prior_message:agent")
      || !("id" in segment)
      || segment.id !== event.id
      || !("content" in segment)
      || typeof segment.content !== "string"
    ) {
      continue
    }
    sources.push({
      id: `h${sources.length + 1}`,
      event: event as ContextSegmentEvent,
    })
  }

  if (new Set(sources.map(({ event }) => event.id)).size !== sources.length) {
    sources.length = 0
  }
  return sources
}

function isHistoricalRequestEvidenceEvent(
  event: ContextEvent,
): event is ContextSegmentEvent {
  if (
    event.type !== "segment"
    || event.source !== "message-service"
    || !("segment" in event)
  ) {
    return false
  }
  const segment = event.segment
  return (
    !!segment
    && typeof segment === "object"
    && !Array.isArray(segment)
    && "label" in segment
    && (segment.label === "runtime:historical_navigation"
      || segment.label === "runtime:historical_observations"
      || segment.label === "runtime:historical_effects")
    && "content" in segment
    && typeof segment.content === "string"
    && "id" in segment
    && segment.id === event.id
  )
}

interface HistoricalEvidenceBinding {
  known: ReadonlySet<string>
  requests: ReadonlySet<string>
  eventIdCounts: ReadonlyMap<string, number>
  includedEventIds: ReadonlySet<string>
  historicalEffects?: boolean | "settled"
}

error UnparsableHistoricalReceipt { cause: unknown }

effect function historicalEntryBound(
  observation: unknown,
  event: ContextSegmentEvent,
  requestSourceEventId: string,
  effects: boolean,
  historicalEffects: boolean | "settled" | undefined,
) {
  if (
    !observation
    || typeof observation !== "object"
    || Array.isArray(observation)
    || Object.keys(observation).sort().join(",") !== "actionName,receipt,success"
    || !("actionName" in observation)
    || typeof observation.actionName !== "string"
    || !observation.actionName.trim()
    || !("success" in observation)
    || typeof observation.success !== "boolean"
    || (!effects && observation.success !== true)
  ) {
    return false
  }
  const receipt = (observation as { receipt?: unknown }).receipt
  const normalized = try normalizeEffectReceipt(receipt)
  if (!effects && !(normalized.outcome === "noop" && !normalized.idempotency.replayed)) return false
  if (
    effects
    && historicalEffects === "settled"
    && !(observation.success === true
      && (normalized.outcome === "applied"
        || (normalized.outcome === "noop" && normalized.idempotency.replayed)))
    && !(try hasHistoricalTerminal(event, requestSourceEventId, normalized))
  ) {
    return false
  }
  return (try hashStableJson(normalized)) === (try hashStableJson(receipt))
}

effect function keepsHistoricalEvidence(
  event: ContextSegmentEvent,
  binding: HistoricalEvidenceBinding,
) {
  const effects = event.segment.label === "runtime:historical_effects"
  const receipt: unknown = try Effect.try({
    try: (): unknown => JSON.parse(event.segment.content),
    catch: (cause) => new UnparsableHistoricalReceipt({ cause }),
  })
  if (
    !receipt
    || typeof receipt !== "object"
    || Array.isArray(receipt)
    || !("requestSourceEventId" in receipt)
    || typeof receipt.requestSourceEventId !== "string"
    || !binding.known.has(receipt.requestSourceEventId)
  ) {
    return true
  }
  const requestSourceEventId = receipt.requestSourceEventId
  if (effects || event.segment.label === "runtime:historical_observations") {
    const field = effects ? "outcomes" : "observations"
    const entries = (receipt as Record<string, unknown>)[field]
    if (
      binding.eventIdCounts.get(event.id) !== 1
      || !binding.requests.has(requestSourceEventId)
      || Object.keys(receipt).sort().join(",") !== `${field},requestSourceEventId,scope`
      || !("scope" in receipt)
      || typeof receipt.scope !== "string"
      || !receipt.scope.trim()
      || !Array.isArray(entries)
      || !entries.length
    ) {
      return true
    }
    for (const observation of entries) {
      const bound = try historicalEntryBound(
        observation,
        event,
        requestSourceEventId,
        effects,
        binding.historicalEffects,
      )
      if (!bound) return true
    }
  }
  return binding.includedEventIds.has(requestSourceEventId)
}

export function selectHistoricalNavigation(
  context: ContextObject,
  includedEventIds: ReadonlySet<string>,
  options: { historicalEffects?: boolean | "settled" } = {},
): ContextObject {
  const sources = collectCompletionContextSources(context)
  if (sources.length === 0) return context
  const eventIdCounts = new Map<string, number>()
  for (const event of context.events) {
    eventIdCounts.set(event.id, (eventIdCounts.get(event.id) ?? 0) + 1)
  }
  const binding: HistoricalEvidenceBinding = {
    known: new Set(sources.map(({ event }) => event.id)),
    requests: new Set(
      sources
        .filter((source) => source.event.segment.label === "prior_message:user")
        .map((source) => source.event.id),
    ),
    eventIdCounts,
    includedEventIds,
    historicalEffects: options.historicalEffects,
  }
  return {
    ...context,
    events: context.events.filter((event) => {
      if (!isHistoricalRequestEvidenceEvent(event)) return true
      if (event.segment.label === "runtime:historical_effects" && !options.historicalEffects) return true
      return match (runSyncExit(keepsHistoricalEvidence(event, binding))) {
        when Exit.Success(let value): value;
        default: true;
      }
    }),
  }
}

export effect function completionContextSources(context: ContextObject) {
  const sources = collectCompletionContextSources(context)
  return {
    sourceSetId: try hashStableJson({
      contextId: context.id,
      roomId: context.metadata?.roomId,
      messageId: context.metadata?.messageId,
      sources,

      navigationEvidence: context.events.filter(
        isHistoricalRequestEvidenceEvent,
      ),
    }),
    sources,
  }
}
export const completionContextSourcesOrThrow = thrown(failingAs(TypeError, completionContextSources))

effect function selectCompletionContext(
  context: ContextObject,
  options: { historicalEffects?: boolean | "settled" } = {},
): {
  context: ContextObject
  applied: boolean
  omittedSourceCount: number
  selection?: CompletionContextSelection
}!(UnstableJson | Foreign) {
  const complete = { context, applied: false, omittedSourceCount: 0 }
  const selection = parseCompletionContextSelection(
    context.metadata?.completionContext,
  )
  if (selection?.mode !== "selected" || !selection.complete) return complete
  const { sourceSetId, sources } = try completionContextSources(context)
  if (selection.sourceSetId !== sourceSetId || sources.length === 0) {
    return complete
  }
  const sourceIds = new Set(sources.map(({ id }) => id))
  const selectedIds = new Set(
    SOURCE_LIST_FIELDS.flatMap((key) => selection[key]),
  )
  for (const id of selectedIds) if (!sourceIds.has(id)) return complete
  const omittedEvents = new Set<ContextEvent>(
    sources.filter(({ id }) => !selectedIds.has(id)).map(({ event }) => event),
  )
  if (omittedEvents.size === 0) return complete
  return {
    context: {
      ...context,
      events: selectHistoricalNavigation(
        context,
        new Set(
          sources
            .filter(({ id }) => selectedIds.has(id))
            .map(({ event }) => event.id),
        ),
        options,
      ).events.filter((event) => !omittedEvents.has(event)),
    },
    applied: true,
    omittedSourceCount: omittedEvents.size,
    selection,
  }
}
export const selectCompletionContextOrThrow = thrown(failingAs(TypeError, selectCompletionContext))

const PLANNER_QUERY_TOKEN_SURFACE_MODES: ReadonlySet<string> = new Set([
  "full",
  "tiered",
  "relay-delivery",
])

effect function referencePlannerQueryTokens(context: ContextObject): {
  context: ContextObject
  applied: boolean
}!(UnstableJson | Foreign) {
  if (context.metadata?.plannerQueryTokensRestored === true) {
    return { context, applied: false }
  }
  let applied = false
  const events: ContextEvent[] = []
  for (const event of context.events) {
    if (event.type !== "message_handler" || event.source !== "message-service") {
      events.push(event)
      continue
    }
    const plan = event.metadata?.plan
    if (!plan || typeof plan !== "object" || Array.isArray(plan)) {
      events.push(event)
      continue
    }
    const surface = plan.actionSurface
    if (
      !surface
      || typeof surface !== "object"
      || Array.isArray(surface)
      || !PLANNER_QUERY_TOKEN_SURFACE_MODES.has(String(surface.mode))
      || !Array.isArray(surface.queryTokens)
      || !surface.queryTokens.every((token) => typeof token === "string")
    ) {
      events.push(event)
      continue
    }
    const { queryTokens, ...routing } = surface
    const reference = {
      sourceEventId: event.id,
      field: "metadata.plan.actionSurface.queryTokens",
      count: queryTokens.length,
      sha256: try hashStableJson(queryTokens),
      restoreTool: "RESTORE_CONTEXT",
    }
    if (JSON.stringify(queryTokens).length <= JSON.stringify(reference).length) {
      events.push(event)
      continue
    }
    applied = true
    events.push({
      ...event,
      metadata: {
        ...event.metadata,
        plan: { ...plan, actionSurface: routing },
        plannerQueryTokensReference: reference,
      },
    })
  }
  return { context: applied ? { ...context, events } : context, applied }
}
export const referencePlannerQueryTokensOrThrow = thrown(failingAs(TypeError, referencePlannerQueryTokens))
