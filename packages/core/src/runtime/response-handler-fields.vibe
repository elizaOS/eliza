// spec/core/responseFields.md, "Story: Extend structured responses without hiding sibling failures"; spec/core/responseFields.md, "Valid registration is first-wins and invalidates full-schema caches only when changed"; spec/core/responseFields.md, "All active fields parse before handlers begin and preemption stops subsequent handlers"
import { type Foreign, foreign, foreignSync } from "../edge.vibe"
import type { ReplyEffectStatus } from "../types/components.vibe"
import type { Memory } from "../types/memory.vibe"
import type { JSONSchema } from "../types/model.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import type { State } from "../types/state.vibe"
import { TurnAbortedError } from "./turn-aborted-error.vibe"
import { errorText } from "../utils/errors.vibe"

export type ResponseHandlerSenderRole =
  | "OWNER"
  | "ADMIN"
  | "USER"
  | "GUEST"
  | "SYSTEM"
  | "SELF"

export interface ResponseHandlerResult {
  shouldRespond: "RESPOND" | "IGNORE" | "STOP"
  contexts: string[]
  intents: string[]
  candidateActionNames: string[]
  replyText: string
  replyEffectStatus?: ReplyEffectStatus
  facts: string[]
  relationships: Array<{
    subject: string
    predicate: string
    object: string
  }>
  addressedTo: string[]

  [extra: string]: unknown
}

export interface ResponseHandlerFieldContext {
  readonly runtime: IAgentRuntime
  readonly message: Memory
  readonly state: State
  readonly senderRole: ResponseHandlerSenderRole

  readonly turnSignal: AbortSignal
}

export interface ResponseHandlerFieldHandleContext<TValue> extends ResponseHandlerFieldContext {
  readonly value: TValue
  readonly parsed: Readonly<ResponseHandlerResult>
}

export interface ResponseHandlerFieldEffect {
  mutateResult?: (result: ResponseHandlerResult) => void
  preempt?: {
    mode: "ack-and-stop" | "ignore" | "direct-reply"
    reason: string
  }
  debug?: string[]
}

export interface ResponseHandlerFieldEvaluator<TValue = unknown> {
  name: string

  description: string

  descriptionCompressed?: string

  priority?: number

  directReplyValue?: (value: unknown) => boolean

  schema: JSONSchema

  shouldRun?(ctx: ResponseHandlerFieldContext): boolean | Promise<boolean>

  getContext?(ctx: ResponseHandlerFieldContext): string | Promise<string>

  parse?(value: unknown, ctx: ResponseHandlerFieldContext): TValue | null

  handle?(
    ctx: ResponseHandlerFieldHandleContext<TValue>,
  ):
    | ResponseHandlerFieldEffect
    | undefined
    | Promise<ResponseHandlerFieldEffect | undefined>
}

export interface ResponseHandlerFieldTrace {
  fieldName: string
  active: boolean
  parsed: boolean
  parseOutcome: "ok" | "soft-fail" | "hard-fail" | "skipped"
  handled: boolean
  preempted: boolean
  preemptMode?: "ack-and-stop" | "ignore" | "direct-reply"
  preemptReason?: string
  debug?: string[]
  errorMessage?: string
}

export interface ResponseHandlerFieldRunResult {
  parsed: ResponseHandlerResult
  traces: ResponseHandlerFieldTrace[]
  preempt?: {
    mode: "ack-and-stop" | "ignore" | "direct-reply"
    reason: string
  }

  fieldErrors: Record<string, string>
}

export error InvalidFieldEvaluator { message: string }

export effect function admitResponseHandlerField(
  registered: ReadonlyMap<string, ResponseHandlerFieldEvaluator>,
  evaluator: ResponseHandlerFieldEvaluator,
): boolean!InvalidFieldEvaluator {
  if (!evaluator.name || typeof evaluator.name !== "string") {
    throw new InvalidFieldEvaluator({ message: "ResponseHandlerFieldEvaluator must have a non-empty name" })
  }
  if (!evaluator.description || typeof evaluator.description !== "string") {
    throw new InvalidFieldEvaluator({
      message:
        `ResponseHandlerFieldEvaluator '${evaluator.name}' must have a non-empty description (used verbatim in the system prompt)`,
    })
  }
  if (!evaluator.schema || typeof evaluator.schema !== "object") {
    throw new InvalidFieldEvaluator({ message: `ResponseHandlerFieldEvaluator '${evaluator.name}' must declare a JSONSchema` })
  }
  return !registered.has(evaluator.name)
}

type FieldAttempt<A> = { ok: true; value: A } | { ok: false; cause: unknown }

effect function attemptField<A>(work: A!Foreign): FieldAttempt<A>!Foreign {
  return map(work, (value): FieldAttempt<A> => ({ ok: true, value })) catch effect (failure) => {
    if (failure.cause instanceof TurnAbortedError) throw failure
    return { ok: false, cause: failure.cause } satisfies FieldAttempt<A>
  }
}

function shouldRunField(evaluator: ResponseHandlerFieldEvaluator, ctx: ResponseHandlerFieldContext): boolean!Foreign {
  return foreign(() => evaluator.shouldRun ? evaluator.shouldRun(ctx) : true)
}

function parseFieldValue(evaluator: ResponseHandlerFieldEvaluator, raw: unknown, ctx: ResponseHandlerFieldContext): unknown!Foreign {
  return foreignSync(() => evaluator.parse!(raw, ctx))
}

effect function handleField(
  evaluator: ResponseHandlerFieldEvaluator,
  trace: ResponseHandlerFieldTrace,
  ctx: ResponseHandlerFieldHandleContext<unknown>,
  parsed: ResponseHandlerResult,
): ({ preempt: ResponseHandlerFieldEffect["preempt"] } | undefined)!Foreign {
  if (try foreignSync(() => ctx.turnSignal.aborted)) return undefined
  const outcome = try foreign(() => evaluator.handle?.(ctx))
  return try foreignSync(() => {
    trace.handled = true
    if (outcome?.debug?.length) {
      trace.debug = outcome.debug.slice()
    }
    if (outcome?.mutateResult) {
      outcome.mutateResult(parsed)
    }
    if (!outcome?.preempt) return undefined
    trace.preempted = true
    trace.preemptMode = outcome.preempt.mode
    trace.preemptReason = outcome.preempt.reason
    return { preempt: outcome.preempt }
  })
}

function recordFieldFailure(
  runtime: IAgentRuntime,
  evaluatorName: string,
  trace: ResponseHandlerFieldTrace,
  fieldErrors: Record<string, string>,
  error: unknown,
  stage: "parse" | "shouldRun" | "handle",
  logMessage: string,
): void {
  const messageStr = errorText(error)
  trace.errorMessage = messageStr
  fieldErrors[evaluatorName] = messageStr
  runtime.logger.warn(
    { src: "response-handler-field-registry", field: evaluatorName, err: messageStr },
    logMessage,
  )
  runtime.reportError(`ResponseHandlerFieldRegistry.${stage}`, error, { evaluator: evaluatorName })
}

export effect function composeResponseHandlerPromptSlices(
  evaluators: ReadonlyArray<ResponseHandlerFieldEvaluator>,
  ctx: ResponseHandlerFieldContext,
) {
  const sections: string[] = []
  const context: string[] = []
  const active: string[] = []
  const skipped: string[] = []
  for (const evaluator of evaluators) {
    if (try shouldRunField(evaluator, ctx)) {
      active.push(evaluator.name)
      sections.push(`### ${evaluator.name}\n${evaluator.description}`)
      const facts = try foreign(() => evaluator.getContext?.(ctx))
      if (facts?.trim()) context.push(`### ${evaluator.name}\n${facts}`)
    } else {
      skipped.push(evaluator.name)
      sections.push(`### ${evaluator.name}\nN/A this turn; emit empty value.`)
    }
  }
  return {
    rendered: sections.join("\n\n"),
    context: context.join("\n\n"),
    activeFieldNames: active,
    skippedFieldNames: skipped,
  }
}

export interface ResponseHandlerDispatchArgs {
  rawParsed: Record<string, unknown>
  runtime: IAgentRuntime
  message: Memory
  state: State
  senderRole: ResponseHandlerSenderRole
  turnSignal: AbortSignal
}

export effect function dispatchResponseHandlerFields(
  evaluators: ReadonlyArray<ResponseHandlerFieldEvaluator>,
  args: ResponseHandlerDispatchArgs,
): ResponseHandlerFieldRunResult!Foreign {
  const traces: ResponseHandlerFieldTrace[] = []
  const fieldErrors: Record<string, string> = {}
  let preempt: ResponseHandlerFieldEffect["preempt"]
  const parsed = buildDefaultedResult(evaluators, args.rawParsed)
  const baseCtx: ResponseHandlerFieldContext = {
    runtime: args.runtime,
    message: args.message,
    state: args.state,
    senderRole: args.senderRole,
    turnSignal: args.turnSignal,
  }
  const handlers: Array<{ evaluator: ResponseHandlerFieldEvaluator; trace: ResponseHandlerFieldTrace; value: unknown }> = []

  for (const evaluator of evaluators) {
    const trace: ResponseHandlerFieldTrace = {
      fieldName: evaluator.name,
      active: true,
      parsed: false,
      parseOutcome: "skipped",
      handled: false,
      preempted: false,
    }
    const failActivation = (cause: unknown) => {
      traces.push(trace)
      recordFieldFailure(args.runtime, evaluator.name, trace, fieldErrors, cause, "shouldRun", "Response-handler field shouldRun failed")
    }
    const activation = try attemptField(shouldRunField(evaluator, baseCtx))
    if (!activation.ok) {
      failActivation(activation.cause)
      continue
    }
    if (!activation.value) {
      trace.active = false
      traces.push(trace)
      continue
    }
    const reading = try attemptField(foreignSync(() => ({ raw: args.rawParsed[evaluator.name], parses: Boolean(evaluator.parse) })))
    if (!reading.ok) {
      failActivation(reading.cause)
      continue
    }
    let value: unknown = reading.value.raw
    if (reading.value.parses) {
      const parsing = try attemptField(parseFieldValue(evaluator, value, baseCtx))
      if (!parsing.ok) {
        trace.parseOutcome = "hard-fail"
        traces.push(trace)
        recordFieldFailure(args.runtime, evaluator.name, trace, fieldErrors, parsing.cause, "parse", "Response-handler field parse hard-failed")
        continue
      }
      if (parsing.value === null) {
        trace.parseOutcome = "soft-fail"
        traces.push(trace)
        fieldErrors[evaluator.name] = "parse returned null (soft fail)"
        continue
      }
      value = parsing.value
    }
    trace.parsed = true
    trace.parseOutcome = "ok"
    parsed[evaluator.name] = value
    traces.push(trace)
    const handles = try attemptField(foreignSync(() => Boolean(evaluator.handle)))
    if (!handles.ok) {
      failActivation(handles.cause)
      continue
    }
    if (handles.value) handlers.push({ evaluator, trace, value })
  }

  for (const { evaluator, trace, value } of handlers) {
    const handling = try attemptField(handleField(evaluator, trace, { ...baseCtx, value, parsed }, parsed))
    if (!handling.ok) {
      recordFieldFailure(args.runtime, evaluator.name, trace, fieldErrors, handling.cause, "handle", "Response-handler field handler failed")
      continue
    }
    if (handling.value) preempt = handling.value.preempt
    if (preempt) break
  }

  return { parsed, traces, preempt, fieldErrors }
}

export interface ResponseHandlerFieldSelectionOptions {
  includeFieldNames?: ReadonlySet<string> | readonly string[]
}

function buildDefaultedResult(
  evaluators: ReadonlyArray<ResponseHandlerFieldEvaluator>,
  raw: Record<string, unknown>,
): ResponseHandlerResult {
  const result = { ...raw } as Record<string, unknown>
  for (const evaluator of evaluators) {
    if (result[evaluator.name] === undefined) {
      result[evaluator.name] = defaultValueForSchema(evaluator.schema)
    }
  }
  return result as ResponseHandlerResult
}

function defaultValueForSchema(schema: JSONSchema): unknown {
  if (!schema || typeof schema !== "object") return null
  const type = (schema as { type?: unknown }).type
  if (Array.isArray(type)) {
    const first = type.find((t) => t !== "null") as string | undefined
    return defaultValueForType(first ?? "null")
  }
  if (typeof type === "string") return defaultValueForType(type)
  return null
}

function defaultValueForType(type: string): unknown {
  switch (type) {
    case "string":
      return ""
    case "array":
      return []
    case "object":
      return {}
    case "boolean":
      return false
    case "integer":
    case "number":
      return 0
    default:
      return null
  }
}

module edge {
  import { asLegacy, runDetached, runDetachedSync } from "../edge.vibe"
  import type { JSONSchema } from "../types/model.vibe"
  import {
    admitResponseHandlerField,
    composeResponseHandlerPromptSlices,
    dispatchResponseHandlerFields,
    type ResponseHandlerDispatchArgs,
    type ResponseHandlerFieldContext,
    type ResponseHandlerFieldEvaluator,
    type ResponseHandlerFieldRunResult,
    type ResponseHandlerFieldSelectionOptions,
  } from "./response-handler-fields.vibe"

  /** @throws {never} */
  function compareEvaluators(
    a: ResponseHandlerFieldEvaluator,
    b: ResponseHandlerFieldEvaluator,
  ): number {
    const pa = a.priority ?? 100
    const pb = b.priority ?? 100
    if (pa !== pb) return pa - pb
    return a.name.localeCompare(b.name)
  }

  /** @throws {never} */
  function normalizeFieldSelection(
    options: ResponseHandlerFieldSelectionOptions,
  ): ReadonlySet<string> | null {
    const include = options.includeFieldNames
    if (!include) return null
    return new Set([...include].filter(Boolean))
  }

  /** @throws {never} */
  function fieldSelectionKey(
    options: ResponseHandlerFieldSelectionOptions,
  ): string {
    const include = normalizeFieldSelection(options)
    return include ? [...include].sort().join("\0") : ""
  }

  export class ResponseHandlerFieldRegistry {
    private evaluators = new Map<string, ResponseHandlerFieldEvaluator>()
    private cachedSchema: JSONSchema | null = null
    private cachedSchemaSignature: string | null = null
    private cachedSorted: ReadonlyArray<ResponseHandlerFieldEvaluator> | null = null

    /** @throws {Error} */
    register(evaluator: ResponseHandlerFieldEvaluator): void {
      if (!runDetachedSync(asLegacy(Error, admitResponseHandlerField(this.evaluators, evaluator)))) return
      this.evaluators.set(evaluator.name, evaluator)
      this.invalidateCaches()
    }

    /** @throws {never} */
    unregister(name: string): boolean {
      const removed = this.evaluators.delete(name)
      if (removed) this.invalidateCaches()
      return removed
    }

    /** @throws {never} */
    private invalidateCaches(): void {
      this.cachedSchema = null
      this.cachedSchemaSignature = null
      this.cachedSorted = null
    }

    /** @throws {never} */
    list(options: ResponseHandlerFieldSelectionOptions = {}): ReadonlyArray<ResponseHandlerFieldEvaluator> {
      return this.sortedEvaluators(options)
    }

    /** @throws {never} */
    size(): number {
      return this.evaluators.size
    }

    /** @throws {never} */
    composeSchema(options: ResponseHandlerFieldSelectionOptions = {}): JSONSchema {
      const selectionKey = fieldSelectionKey(options)
      if (!selectionKey && this.cachedSchema) return this.cachedSchema
      const sorted = this.sortedEvaluators(options)
      const properties: Record<string, JSONSchema> = {}
      const required: string[] = []
      for (const evaluator of sorted) {
        properties[evaluator.name] = evaluator.schema
        required.push(evaluator.name)
      }
      const schema: JSONSchema = {
        type: "object",
        additionalProperties: false,
        properties,
        required,
      }
      if (selectionKey) return schema
      this.cachedSchema = schema
      this.cachedSchemaSignature = JSON.stringify(schema)
      return schema
    }

    /** @throws {never} */
    composeSchemaSignature(options: ResponseHandlerFieldSelectionOptions = {}): string {
      const selectionKey = fieldSelectionKey(options)
      if (selectionKey) return JSON.stringify(this.composeSchema(options))
      if (!this.cachedSchemaSignature) this.composeSchema()
      return this.cachedSchemaSignature ?? ""
    }

    /** @throws {never} */
    composePromptSlices(
      ctx: ResponseHandlerFieldContext,
      options: ResponseHandlerFieldSelectionOptions = {},
    ): Promise<{
      rendered: string
      context: string
      activeFieldNames: string[]
      skippedFieldNames: string[]
    }> {
      return runDetached(composeResponseHandlerPromptSlices(this.sortedEvaluators(options), ctx))
    }

    /** @throws {never} */
    dispatch(args: ResponseHandlerDispatchArgs): Promise<ResponseHandlerFieldRunResult> {
      return runDetached(dispatchResponseHandlerFields(this.sortedEvaluators(), args))
    }

    /** @throws {never} */
    private sortedEvaluators(options: ResponseHandlerFieldSelectionOptions = {}): ReadonlyArray<ResponseHandlerFieldEvaluator> {
      const includeNames = normalizeFieldSelection(options)
      if (!includeNames) {
        this.cachedSorted ??= [...this.evaluators.values()].sort(compareEvaluators)
        return this.cachedSorted
      }
      return [...this.evaluators.values()]
        .filter((evaluator) => includeNames.has(evaluator.name))
        .sort(compareEvaluators)
    }
  }
}
import { ResponseHandlerFieldRegistry } from edge
export { ResponseHandlerFieldRegistry }
