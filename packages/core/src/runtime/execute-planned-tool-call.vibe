export interface ExecutePlannedToolCallContext {
  message: Memory

  replyOwner?: "planner"
  state?: State
  activeContexts?: readonly AgentContext[]
  userRoles?: readonly RoleGateRole[]
  previousResults?: readonly ActionResult[]
  callback?: Parameters<Action["handler"]>[4]
  responses?: Memory[]

  entityAliases?: EntityAliasCapabilityMap
}

export type ExecutePlannedToolCallOptions = HandlerOptions & {
  actions?: readonly Action[]
  onStreamChunk?: StreamChunkCallback
  abortSignal?: AbortSignal

  onSettledResult?: (result: ActionResult) => void

  onBeforeCallbacks?: (result: ActionResult) => void
}

const MAX_ACTION_RESULT_DIAGNOSTIC_DEPTH = 8
const MAX_ACTION_RESULT_DIAGNOSTIC_NODES = 1_024

interface ActionResultDiagnosticBudget {
  nodes: number
}

function redactDiagnosticString(
  value: string,
  redactDiagnosticText: ToolDiagnosticTextRedactor,
): ContentValue {
  try {
    return redactDiagnosticText(value)
  } catch {
    return TOOL_DIAGNOSTIC_MASK
  }
}

function projectActionResultDiagnosticValue(
  value: unknown,
  redactDiagnosticText: ToolDiagnosticTextRedactor,
  seen: WeakSet<object>,
  depth: number,
  budget: ActionResultDiagnosticBudget,
  suppressKeys?: ReadonlySet<string>,
): ContentValue {
  budget.nodes += 1
  if (budget.nodes > MAX_ACTION_RESULT_DIAGNOSTIC_NODES) {
    return TOOL_DIAGNOSTIC_MASK
  }
  if (value === undefined || value === null || typeof value === "boolean") {
    return value as ContentValue
  }
  if (typeof value === "number") {
    return Number.isFinite(value) ? value : TOOL_DIAGNOSTIC_MASK
  }
  if (typeof value === "string") {
    return redactDiagnosticString(value, redactDiagnosticText)
  }
  if (typeof value !== "object") {
    return TOOL_DIAGNOSTIC_MASK
  }
  if (depth >= MAX_ACTION_RESULT_DIAGNOSTIC_DEPTH || seen.has(value)) {
    return TOOL_DIAGNOSTIC_MASK
  }
  seen.add(value)
  try {
    let isArray: boolean
    try {
      isArray = Array.isArray(value)
    } catch {
      return TOOL_DIAGNOSTIC_MASK
    }
    if (isArray) {
      let lengthDescriptor: PropertyDescriptor | undefined
      try {
        lengthDescriptor = Object.getOwnPropertyDescriptor(value, "length")
      } catch {
        return TOOL_DIAGNOSTIC_MASK
      }
      const length = lengthDescriptor?.value
      if (
        typeof length !== "number"
        || !Number.isSafeInteger(length)
        || length < 0
        || length > MAX_ACTION_RESULT_DIAGNOSTIC_NODES - budget.nodes
      ) {
        return TOOL_DIAGNOSTIC_MASK
      }
      const projected: ContentValue[] = new Array(length)
      for (let index = 0; index < length; index += 1) {
        let descriptor: PropertyDescriptor | undefined
        try {
          descriptor = Object.getOwnPropertyDescriptor(value, String(index))
        } catch {
          return TOOL_DIAGNOSTIC_MASK
        }
        budget.nodes += 1
        if (budget.nodes > MAX_ACTION_RESULT_DIAGNOSTIC_NODES) {
          return TOOL_DIAGNOSTIC_MASK
        }
        if (!descriptor) continue
        projected[index] = "value" in descriptor
          ? projectActionResultDiagnosticValue(
            descriptor.value,
            redactDiagnosticText,
            seen,
            depth + 1,
            budget,
          )
          : TOOL_DIAGNOSTIC_MASK
      }
      return projected
    }

    let keys: PropertyKey[]
    try {
      keys = Reflect.ownKeys(value)
    } catch {
      return TOOL_DIAGNOSTIC_MASK
    }
    if (keys.length > MAX_ACTION_RESULT_DIAGNOSTIC_NODES - budget.nodes) {
      return TOOL_DIAGNOSTIC_MASK
    }
    const record: Record<string, ContentValue> = {}
    for (const key of keys) {
      if (typeof key !== "string") continue
      let descriptor: PropertyDescriptor | undefined
      try {
        descriptor = Object.getOwnPropertyDescriptor(value, key)
      } catch {
        return TOOL_DIAGNOSTIC_MASK
      }
      if (!descriptor?.enumerable) continue
      budget.nodes += 1
      if (budget.nodes > MAX_ACTION_RESULT_DIAGNOSTIC_NODES) {
        return TOOL_DIAGNOSTIC_MASK
      }
      let projected: ContentValue
      if (suppressKeys?.has(key)) {
        projected = sensitiveActionResultMarker(
          "value" in descriptor ? descriptor.value : undefined,
          redactDiagnosticText,
          budget,
        )
      } else if (isSensitiveKeyName(key) || !("value" in descriptor)) {
        projected = TOOL_DIAGNOSTIC_MASK
      } else {
        projected = projectActionResultDiagnosticValue(
          descriptor.value,
          redactDiagnosticText,
          seen,
          depth + 1,
          budget,
        )
      }
      defineOwnValue(record, key, projected)
    }
    return record
  } finally {
    seen.delete(value)
  }
}

const SUPPRESSED_RESULT_KEYS: ReadonlySet<string> = new Set(["data", "values"])

function actionResultToContentRecord(
  result: ActionResult,
  redactDiagnosticText: ToolDiagnosticTextRedactor,
  options: { suppressData?: boolean } = {},
): Record<string, ContentValue> {
  const projectedResult = projectActionResultDiagnosticValue(
    result,
    redactDiagnosticText,
    new WeakSet<object>(),
    0,
    { nodes: 0 },
    options.suppressData ? SUPPRESSED_RESULT_KEYS : undefined,
  )
  return isObjectRecord(projectedResult) ? projectedResult : {}
}

function sensitiveActionResultMarker(
  value: unknown,
  redactDiagnosticText?: ToolDiagnosticTextRedactor,
  budget?: ActionResultDiagnosticBudget,
): Record<string, ContentValue> {
  let actionName: string | undefined
  if (value !== null && typeof value === "object") {
    try {
      const descriptor = Object.getOwnPropertyDescriptor(value, "actionName")
      if (
        descriptor
        && "value" in descriptor
        && typeof descriptor.value === "string"
      ) {
        actionName = redactDiagnosticText && budget
          ? (redactDiagnosticString(
            descriptor.value,
            redactDiagnosticText,
          ) as string)
          : descriptor.value
      }
    } catch {
    }
  }
  return {
    ...(actionName ? { actionName } : {}),
    suppressed: true,
    reason: "sensitive_action_result",
  }
}

export function shouldSuppressActionResultClipboard(
  action: Pick<Action, "suppressActionResultClipboard"> | undefined,
  result: { data?: Readonly<Record<string, unknown>> },
): boolean {
  return (
    action?.suppressActionResultClipboard === true
    || result.data?.suppressActionResultClipboard === true
  )
}

export effect function projectActionResultForClipboard(
  action: Pick<Action, "name" | "suppressActionResultClipboard"> | undefined,
  result: ActionResult,
  actionName = action?.name,
) {
  if (!shouldSuppressActionResultClipboard(action, result)) {
    return result
  }

  const resultActionName = typeof result.data?.actionName === "string"
    ? result.data.actionName
    : undefined
  const safeActionName = actionName ?? resultActionName
  const safeControlData = {
    ...(getBoundOperationDenialAttempt(result)
      ? {
        code: result.data?.code,
        executionStatus: "not_started",
        executed: false,
      }
      : {}),
    ...(safeActionName ? { actionName: safeActionName } : {}),
    ...(result.data?.outcomeUnknown === true ? { outcomeUnknown: true } : {}),
    ...(result.data?.retryable === false ? { retryable: false } : {}),
    ...(result.data?.reconciliationRequired === true
      ? { reconciliationRequired: true }
      : {}),
    ...(result.data?.suppressPlannerReply === true
      ? { suppressPlannerReply: true }
      : {}),
  }
  const projected: ActionResult = {
    success: result.success,
    ...(result.text !== undefined ? { text: result.text } : {}),
    ...(result.transcriptVisibility !== undefined
      ? { transcriptVisibility: result.transcriptVisibility }
      : {}),
    ...(result.userFacingText !== undefined
      ? { userFacingText: result.userFacingText }
      : {}),
    ...(result.verifiedUserFacing !== undefined
      ? { verifiedUserFacing: result.verifiedUserFacing }
      : {}),
    ...(result.effectReceipts !== undefined
      ? { effectReceipts: result.effectReceipts }
      : {}),
    ...(result.userFacingEffectReceiptIds !== undefined
      ? {
        userFacingEffectReceiptIds: result.userFacingEffectReceiptIds,
      }
      : {}),
    ...(result.failureProvenance !== undefined
      ? { failureProvenance: result.failureProvenance }
      : {}),
    ...(result.replyFailure !== undefined
      ? { replyFailure: result.replyFailure }
      : {}),
    ...(Object.keys(safeControlData).length > 0
      ? { data: safeControlData }
      : {}),
    ...(result.turnComplete !== undefined
      ? { turnComplete: result.turnComplete }
      : {}),
    ...(result.modelReplyRequired !== undefined
      ? { modelReplyRequired: result.modelReplyRequired }
      : {}),
    ...(result.modelReplyFallback !== undefined
      ? { modelReplyFallback: result.modelReplyFallback }
      : {}),
    ...(result.continueChain !== undefined
      ? { continueChain: result.continueChain }
      : {}),
  }
  const projectionAttempt = getBoundOperationDenialAttempt(result)
  if (projectionAttempt) {
    try bindRequestOperationResult(projected, projectionAttempt)
  }
  copyBoundOperationDenial(result, projected, projectionAttempt)
  return projected
}

export const projectActionResultForClipboardOrThrow = thrown(failingAs(TypeError, projectActionResultForClipboard))

effect function projectSettledResultForObserver(
  action: Action,
  result: ActionResult,
) {
  const projected = try projectActionResultForClipboard(action, result, action.name)
  if (action.disclosureGate?.require !== "owner_exclusive") return projected
  const controlData = {
    actionName: action.name,
    ...(result.data?.outcomeUnknown === true ? { outcomeUnknown: true } : {}),
    ...(result.data?.retryable === false ? { retryable: false } : {}),
    ...(result.data?.reconciliationRequired === true
      ? { reconciliationRequired: true }
      : {}),
    ...(result.data?.suppressPlannerReply === true
      ? { suppressPlannerReply: true }
      : {}),
  }

  return {
    success: projected.success,
    ...(projected.effectReceipts !== undefined
      ? { effectReceipts: projected.effectReceipts }
      : {}),
    ...(projected.failureProvenance !== undefined
      ? { failureProvenance: projected.failureProvenance }
      : {}),
    ...(projected.replyFailure !== undefined
      ? { replyFailure: projected.replyFailure }
      : {}),
    data: controlData,
    ...(projected.turnComplete !== undefined
      ? { turnComplete: projected.turnComplete }
      : {}),
    ...(projected.modelReplyRequired !== undefined
      ? { modelReplyRequired: projected.modelReplyRequired }
      : {}),
    ...(projected.modelReplyFallback !== undefined
      ? { modelReplyFallback: projected.modelReplyFallback }
      : {}),
    ...(projected.continueChain !== undefined
      ? { continueChain: projected.continueChain }
      : {}),
  } satisfies ActionResult
}

effect function publishSettledResult(
  runtime: IAgentRuntime,
  action: Action,
  result: ActionResult,
  observer: ((result: ActionResult) => void) | undefined,
) {
  if (!observer) return
  effect {
    const projected = try projectSettledResultForObserver(action, result)
    try foreignSync(() => observer(projected))
  } catch (failure) => reportObserverFailure(runtime, action, thrownValue(failure))
}

function reportObserverFailure(runtime: IAgentRuntime, action: Action, error: unknown): void {
  try {
    runtime.reportError("ActionSettlementObserver", error, {
      actionName: action.name,
    })
  } catch (reportingError) {
    runtime.logger.error(
      {
        src: "execute-planned-tool-call",
        action: action.name,
        error: stringifyError(error),
        reportingError: stringifyError(reportingError),
      },
      "Action settlement observer and error reporting both failed",
    )
  }
}

function readMetadataString(message: Memory, key: string): string | undefined {
  const metadata = isObjectRecord(message.metadata) ? message.metadata : null
  const value = metadata?.[key]
  return typeof value === "string" && value.trim().length > 0
    ? value.trim()
    : undefined
}

function runWithMessageTrajectoryContext<T>(
  runtime: IAgentRuntime,
  message: Memory,
  fn: () => Promise<T> | T,
): Promise<T> | T {
  const activeContext = getTrajectoryContext()
  const trajectoryId = readMetadataString(message, "trajectoryId")
  const runId = typeof runtime.getCurrentRunId === "function"
    ? runtime.getCurrentRunId()
    : undefined
  if (
    typeof activeContext?.trajectoryStepId === "string"
    && activeContext.trajectoryStepId.trim().length > 0
  ) {
    if (
      trajectoryId
      && !(
        typeof activeContext.trajectoryId === "string"
        && activeContext.trajectoryId.trim().length > 0
      )
    ) {
      return runWithTrajectoryContext(
        {
          ...activeContext,
          trajectoryId,
          ...(runId ? { runId } : {}),
          ...(message.roomId ? { roomId: message.roomId } : {}),
          ...(message.id ? { messageId: message.id } : {}),
        },
        fn,
      )
    }
    return fn()
  }

  const trajectoryStepId = readMetadataString(message, "trajectoryStepId")
  if (!trajectoryStepId) {
    return fn()
  }

  return runWithTrajectoryContext(
    {
      ...activeContext,
      ...(trajectoryId ? { trajectoryId } : {}),
      trajectoryStepId,
      ...(runId ? { runId } : {}),
      ...(message.roomId ? { roomId: message.roomId } : {}),
      ...(message.id ? { messageId: message.id } : {}),
    },
    fn,
  )
}

interface PerfProbe {
  mark(label: string): void
  report(runtime: IAgentRuntime, actionName: string): void
}

function startPerfProbe(): PerfProbe {
  const startedAt = Date.now()
  const marks: [string, number][] = []
  let previous = startedAt
  return {
    mark(label) {
      const now = Date.now()
      marks.push([label, now - previous])
      previous = now
    },
    report(runtime, actionName) {
      const total = Date.now() - startedAt
      if (total <= 400) return
      runtime.logger.info(
        { src: "execute-planned-tool-call" },
        `[perf-probe] tool=${actionName} total=${total}ms ${
          marks
            .filter(([, ms]) => ms >= 5)
            .map(([label, ms]) => `${label}=${ms}ms`)
            .join(" ")
        }`,
      )
    },
  }
}

interface PlannedRun {
  readonly runtime: IAgentRuntime
  readonly toolCall: PlannerToolCall
  readonly options: ExecutePlannedToolCallOptions
  readonly action: Action
  readonly redactDiagnosticText: ToolDiagnosticTextRedactor
  readonly ownerExecutionId: string | undefined
  readonly perf: PerfProbe
}

interface EarlyResult {
  readonly kind: "early"
  readonly result: ActionResult
  readonly ownerCapture?: OwnerCapture
}

interface AdmittedArguments {
  readonly kind: "admitted"
  readonly requestOperationAttempt: BoundRequestOperationAttempt | undefined
  readonly validation: ValidateToolArgsResult
}

interface AdmittedHandler {
  readonly kind: "admitted"
  readonly handlerOptions: HandlerOptions
  readonly onSettledResult: ExecutePlannedToolCallOptions["onSettledResult"]
  readonly onBeforeCallbacks: ExecutePlannedToolCallOptions["onBeforeCallbacks"]
}

interface ActionRun {
  readonly result: ActionResult
  readonly worldId: UUID!Foreign
  readonly startedDispatch: Fiber.Fiber<void, Foreign> | undefined
}

function early(result: ActionResult, ownerCapture?: OwnerCapture): EarlyResult {
  return { kind: "early", result, ownerCapture }
}

function gateCapture(
  run: Pick<PlannedRun, "runtime" | "ownerExecutionId">,
  gate: OwnerCapture["gate"],
  gateOutcome: OwnerCapture["gateOutcome"],
): OwnerCapture | undefined {
  return run.runtime.ownerToolExecutionObserver
    ? {
      runtime: run.runtime,
      executionId: run.ownerExecutionId,
      phase: "gate",
      gate,
      gateOutcome,
    }
    : undefined
}

effect function admitCaller(run: PlannedRun, ctx: ExecutePlannedToolCallContext) {
  const { runtime, action } = run
  try foreign(() => Promise.resolve())
  const resolvedCtx = try withResolvedUserRoles(runtime, ctx)
  const executorCtx = resolvedCtx.state
    ? {
      ...resolvedCtx,
      state: withActiveRoutingContexts(
        resolvedCtx.state,
        resolvedCtx.message,
        resolvedCtx.activeContexts,
      ),
    }
    : resolvedCtx
  run.perf.mark("roles")
  if (action.disclosureGate?.require === "owner_exclusive") {
    try renewExpiredTrustedDeliveryAudience(runtime, executorCtx.message)
  }
  const gateFailure = try actionGateFailure(action, executorCtx)
  if (gateFailure) {
    return early(failureResult(action.name, gateFailure), gateCapture(run, "role-context", "denied"))
  }
  if (action.disclosureGate?.require === "owner_exclusive") {
    const disclosure = try authorizeOwnerExclusiveDisclosure(runtime, executorCtx.message)
    if (!disclosure.allowed) {
      return early(
        failureResult(action.name, `Owner-private disclosure denied: ${disclosure.reason}`),
        gateCapture(run, "disclosure", "denied"),
      )
    }
  }
  return { kind: "admitted" as const, executorCtx }
}

effect function admitRequestRestriction(
  run: PlannedRun,
  executorCtx: ExecutePlannedToolCallContext,
  requestOperationAttempt: BoundRequestOperationAttempt | undefined,
) {
  const { runtime, action, toolCall } = run
  if (!action.restrictRequestOperation) return undefined
  const restriction: unknown = try foreignSync(() =>
    runWithActionRoutingContext(
      {
        actionName: action.name,
        modelClass: action.modelClass,
        messageId: executorCtx.message.id,
        requestMessage: executorCtx.message,
        requestState: executorCtx.state,
        requestRuntime: runtime,
        hostAttemptId: run.ownerExecutionId,
        requestOperationAttempt,
      },
      () =>
        action.restrictRequestOperation?.({
          runtime,
          message: executorCtx.message,
          state: executorCtx.state,
          action,
          params: toolCall.params,
        }),
    )
  )
  if (restriction === undefined) return undefined
  if (
    !isObjectRecord(restriction)
    || restriction.success !== false
    || !getBoundOperationDenialOperation(restriction)
    || !requestOperationAttempt
    || getBoundOperationDenialAttempt(restriction) !== requestOperationAttempt
  ) {
    return early(failureResult(
      action.name,
      "Invalid request-operation restriction result",
      {
        code: "ACTION_REQUEST_RESTRICTION_INVALID",
        acceptance: "rejected",
        executionStatus: "not_started",
        executed: false,
        retryable: false,
      },
      {
        kind: "handler_error",
        boundary: "handler",
        code: "ACTION_REQUEST_RESTRICTION_INVALID",
        retryable: false,
      },
    ))
  }
  return early(try normalizeActionResult(action.name, restriction, requestOperationAttempt))
}

effect function admitArguments(run: PlannedRun, executorCtx: ExecutePlannedToolCallContext) {
  const { runtime, action, toolCall } = run
  const requestOperationAttempt = executorCtx.state
    ? beginRequestOperationAttempt({
      runtime,
      state: executorCtx.state,
      message: executorCtx.message,
      action,
    })
    : undefined
  const restricted = try admitRequestRestriction(run, executorCtx, requestOperationAttempt)
  if (restricted) return restricted

  if (
    "args" in toolCall
    || "arguments" in toolCall
    || (toolCall.params !== undefined && !isPlainObject(toolCall.params))
  ) {
    return early(
      try normalizeActionResult(
        action.name,
        failureResult(
          action.name,
          "Tool arguments must be a plain object in params",
          { acceptance: "rejected", executionStatus: "not_started" },
          {
            kind: "handler_error",
            boundary: "handler",
            code: "ACTION_ARGUMENTS_INVALID",
            retryable: true,
          },
        ),
        requestOperationAttempt,
      ),
      gateCapture(run, "schema", "denied"),
    )
  }
  const argsForValidation = dropEmptyOptionalArgs(action, toolCall.params ?? {})
  const entityAliases = executorCtx.entityAliases
    ?? (try buildTurnEntityAliases(
      runtime,
      executorCtx.message,
      executorCtx.state,
      executorCtx.userRoles,
    ))
  run.perf.mark("aliases")
  const checked = try result(validateToolArgs(action, resolveEntityAliasRefs(entityAliases, argsForValidation)))
  if (Result.isFailure(checked)) {
    const error = thrownValue(checked.failure)
    if (!(error instanceof ElizaError) || error.code !== "ACTION_DEFINITION_INVALID") {
      throw checked.failure
    }
    return early(
      failureResult(
        action.name,
        error.message,
        { error, retryable: false, executionStatus: "not_started" },
        {
          kind: "missing_capability",
          boundary: "capability",
          code: "ACTION_DEFINITION_INVALID",
          retryable: false,
        },
      ),
      gateCapture(run, "schema", "failed"),
    )
  }
  const validation = checked.success
  if (!validation.valid) {
    const invalidParameterNames = validation.invalidParameterNames ?? []
    return early(
      try normalizeActionResult(
        action.name,
        failureResult(
          action.name,
          validation.errors.join("; ")
            || `Invalid arguments for action ${action.name}`,
          {
            acceptance: "rejected",
            executionStatus: "not_started",
            parameterErrors: validation.errors,
            ...(invalidParameterNames.length > 0
              ? { invalidParameterNames }
              : {}),
          },
          {
            kind: "handler_error",
            boundary: "handler",
            code: "ACTION_ARGUMENTS_INVALID",
            retryable: true,
          },
        ),
        requestOperationAttempt,
      ),
      gateCapture(run, "schema", "denied"),
    )
  }
  return { kind: "admitted", requestOperationAttempt, validation } satisfies AdmittedArguments
}

effect function admitHandler(
  run: PlannedRun,
  executorCtx: ExecutePlannedToolCallContext,
  validation: ValidateToolArgsResult,
) {
  const { runtime, action, options } = run
  const previousResults = [...(executorCtx.previousResults ?? [])]
  const parameters = action.parameters && action.parameters.length > 0
    ? (validation.args as ActionParameters | undefined)
    : undefined
  const {
    actions: _scopedActions,
    onSettledResult,
    onBeforeCallbacks,
    ...handlerOptionOverrides
  } = options
  const handlerOptions: HandlerOptions = {
    ...handlerOptionOverrides,
    parameters,
    parameterErrors: undefined,
    actionContext: options.actionContext ?? {
      previousResults,
      getPreviousResult: (actionName: string) =>
        previousResults.find(
          (result) => result.data?.actionName === actionName,
        ),
    },
  }

  if (action.validate) {
    const checked = try result(foreign(() =>
      action.validate!(runtime, executorCtx.message, executorCtx.state, handlerOptions)
    ))
    if (Result.isFailure(checked)) {
      const error = thrownValue(checked.failure)
      return early(
        failureResult(
          action.name,
          stringifyError(error),
          { error },
          {
            kind: "handler_error",
            boundary: "handler",
            code: "ACTION_VALIDATION_FAILED",
            retryable: true,
          },
        ),
        gateCapture(run, "action-validation", "failed"),
      )
    }
    if (!checked.success) {
      return early(
        failureResult(
          action.name,
          `Action ${action.name} is not available for the current state`,
          {},
          {
            kind: "missing_capability",
            boundary: "capability",
            code: "ACTION_UNAVAILABLE",
            retryable: false,
          },
        ),
        gateCapture(run, "action-validation", "denied"),
      )
    }
  }

  run.perf.mark("validate")
  const accountPolicy = try evaluateConnectorAccountPolicies(runtime, action, {
    message: executorCtx.message,
    parameters: validation.args as Record<string, unknown>,
  })
  if (!accountPolicy.allowed) {
    return early(
      failureResult(
        action.name,
        accountPolicy.reason
          ?? `Action ${action.name} is not allowed for the selected connector account`,
      ),
      gateCapture(run, "connector-account", "denied"),
    )
  }
  run.perf.mark("accountPolicy")
  try foreignSync(() => options.abortSignal?.throwIfAborted())
  return { kind: "admitted", handlerOptions, onSettledResult, onBeforeCallbacks } satisfies AdmittedHandler
}

function reportEmitEventFailure(
  runtime: IAgentRuntime,
  action: Action,
  eventType: EventType,
  err: unknown,
): void {
  runtime.reportError("ExecutePlannedToolCall.emitEvent", err, {
    action: action.name,
    eventType,
  })
  runtime.logger.warn(
    {
      src: "execute-planned-tool-call",
      action: action.name,
      eventType,
      err: errorText(err),
    },
    "emitEvent failed",
  )
}

effect function deliverOwnerExclusiveCallback(
  runtime: IAgentRuntime,
  executorCtx: ExecutePlannedToolCallContext,
  callbackArgs: Parameters<HandlerCallback>,
) {
  const disclosure = try revalidateOwnerExclusiveDisclosure(runtime, executorCtx.message)
  if (disclosure.allowed) {
    return try foreign(() => executorCtx.callback?.(...callbackArgs) ?? [])
  }
  return try foreign(() =>
    executorCtx.callback?.(
      {
        text: PRIVACY_DENIED_TEXT,
        actions: ["PRIVACY_DENIED"],
        data: {
          privacyDenied: true,
          privacyReason: disclosure.reason,
        },
      },
      "PRIVACY_DENIED",
    ) ?? []
  )
}

effect function invokePlannedAction(
  run: PlannedRun,
  executorCtx: ExecutePlannedToolCallContext,
  handlerOptions: HandlerOptions,
  requestOperationAttempt: BoundRequestOperationAttempt | undefined,
  actionCallback: HandlerCallback | undefined,
) {
  const { runtime, action } = run
  const currentGateFailure = try actionGateFailure(action, {
    ...executorCtx,
    userRoles: (try actionGateNeedsCallerRoles(action))
      ? try resolveActionCallerRoles(runtime, executorCtx.message)
      : executorCtx.userRoles,
  })
  if (currentGateFailure) {
    return failureResult(action.name, currentGateFailure)
  }
  try foreignSync(() => run.options.abortSignal?.throwIfAborted())

  const secretSwapSession = getTrajectoryContext()?.secretSwapSession
  if (secretSwapSession && handlerOptions.parameters !== undefined) {
    handlerOptions.parameters = try restoreSecretsInValue(
      secretSwapSession,
      handlerOptions.parameters,
      { failOnUnresolved: true },
    )
  }
  const piiSwapSession = getTrajectoryContext()?.piiSwapSession
  if (piiSwapSession && handlerOptions.parameters !== undefined) {
    handlerOptions.parameters = try restorePseudonymsInValue(piiSwapSession, handlerOptions.parameters)
  }
  observeOwnerToolExecution(runtime, () => ({
    phase: "started",
    gate: "execution",
    gateOutcome: "executed",
    actionName: action.name,
    executionId: run.ownerExecutionId,
    toolCallId: run.toolCall.id,
    args: handlerOptions.parameters,
  }))
  const routingContext = {
    actionName: action.name,
    modelClass: action.modelClass,
    replyOwner: action.suppressActionResultClipboard
      ? undefined
      : executorCtx.replyOwner,
    messageId: executorCtx.message.id,
    requestMessage: executorCtx.message,
    requestState: executorCtx.state,
    requestRuntime: runtime,
    hostAttemptId: run.ownerExecutionId,
    requestOperationAttempt,
  }
  return try ensuring(
    foreign(() =>
      runWithActionRoutingContext(routingContext, () =>
        action.handler(
          runtime,
          executorCtx.message,
          executorCtx.state,
          handlerOptions,
          actionCallback,
          executorCtx.responses,
        ))
    ),
    sync(() => {
      routingContext.replyOwner = undefined
    }),
  )
}

effect function runPlannedAction(
  run: PlannedRun,
  executorCtx: ExecutePlannedToolCallContext,
  admittedArguments: AdmittedArguments,
  admittedHandler: AdmittedHandler,
) {
  const { runtime, action } = run
  const { requestOperationAttempt, validation } = admittedArguments
  const messageId = executorCtx.message.id
  const roomId = executorCtx.message.roomId
  const worldId = try cached(resolveActionEventWorldId(
    runtime,
    executorCtx.message,
    "ExecutePlannedToolCall.resolveActionEventWorldId",
  ))

  let startedDispatch: Fiber.Fiber<void, Foreign> | undefined
  if (typeof runtime.emitEvent === "function") {
    const world = try worldId
    const dispatch = try foreignSync(() =>
      runtime.emitEvent(EventType.ACTION_STARTED, {
        runtime,
        ...(messageId ? { messageId } : {}),
        roomId,
        world,
        content: {
          text: `Executing action: ${action.name}`,
          actions: [action.name],
          actionStatus: "executing" as const,
          source: executorCtx.message.content.source,
        },
      }).catch((err: unknown) => reportEmitEventFailure(runtime, action, EventType.ACTION_STARTED, err))
    )
    startedDispatch = try Effect.forkDetach(foreign(() => dispatch), { startImmediately: true })
  }

  const callback = action.disclosureGate?.require === "owner_exclusive" && executorCtx.callback
    ? (...callbackArgs: Parameters<HandlerCallback>) =>
      runDetached(deliverOwnerExclusiveCallback(runtime, executorCtx, callbackArgs))
    : executorCtx.callback
  run.perf.mark("startedEvent")
  const settle = () =>
    runDetached(settleActionHandler({
      runtime,
      action,
      operationAttempt: requestOperationAttempt,
      callback,
      beforeCallbacks: thrown((result: ActionResult) =>
        publishSettledResult(runtime, action, result, admittedHandler.onBeforeCallbacks)
      ),
      invoke: (actionCallback) =>
        runDetached(invokePlannedAction(
          run,
          executorCtx,
          admittedHandler.handlerOptions,
          requestOperationAttempt,
          actionCallback,
        )),
    }))
  const result = try foreign(() =>
    runWithMessageTrajectoryContext(runtime, executorCtx.message, () =>
      runDetached(withActionStep(runtime, action.name, settle, {
        parameters: isObjectRecord(validation.args) ? validation.args : {},
        projectResult: thrown((settled: ActionResult) => projectSettledResultForObserver(action, settled)),
      })))
  )
  return { result, worldId, startedDispatch } satisfies ActionRun
}

effect function withOwnerDisclosure(
  run: PlannedRun,
  message: Memory,
  result: ActionResult,
) {
  if (run.action.disclosureGate?.require !== "owner_exclusive") return result
  const disclosure = try revalidateOwnerExclusiveDisclosure(run.runtime, message)
  if (disclosure.allowed) return result
  return failureResult(run.action.name, PRIVACY_DENIED_TEXT, {
    privacyDenied: true,
    privacyReason: disclosure.reason,
  })
}

effect function completePlannedToolCall(
  run: PlannedRun,
  executorCtx: ExecutePlannedToolCallContext,
  actionRun: ActionRun,
  onSettledResult: AdmittedHandler["onSettledResult"],
) {
  const { runtime, action, redactDiagnosticText } = run
  run.perf.mark("handler")
  try publishSettledResult(runtime, action, actionRun.result, onSettledResult)
  let resultForEvent = try withOwnerDisclosure(run, executorCtx.message, actionRun.result)
  const suppressActionResult = shouldSuppressActionResultClipboard(action, resultForEvent)

  if (typeof runtime.emitEvent === "function") {
    const world = try actionRun.worldId
    if (actionRun.startedDispatch) try join actionRun.startedDispatch
    const messageId = executorCtx.message.id
    try foreign(() =>
      runtime.emitEvent(EventType.ACTION_COMPLETED, {
        runtime,
        ...(messageId ? { messageId } : {}),
        roomId: executorCtx.message.roomId,
        world,
        content: {
          text: redactDiagnosticText(
            resultForEvent.text ?? `Action ${action.name} completed`,
          ),
          actions: [action.name],
          actionStatus: resultForEvent.success ? "completed" : "failed",
          actionResult: actionResultToContentRecord(
            resultForEvent,
            redactDiagnosticText,
            {
              suppressData: suppressActionResult,
            },
          ),
          source: executorCtx.message.content.source,
          error: typeof resultForEvent.error === "string"
            ? redactDiagnosticText(resultForEvent.error)
            : undefined,
        },
      }).catch((err: unknown) => reportEmitEventFailure(runtime, action, EventType.ACTION_COMPLETED, err))
    )
  }
  resultForEvent = try withOwnerDisclosure(run, executorCtx.message, resultForEvent)
  run.perf.mark("post")
  run.perf.report(runtime, action.name)
  return try emitToolResult(run.toolCall, redactDiagnosticText, resultForEvent, {
    suppressData: suppressActionResult,
    ownerCapture: runtime.ownerToolExecutionObserver
      ? {
        runtime,
        executionId: run.ownerExecutionId,
        phase: "settled",
        gate: "execution",
        gateOutcome: resultForEvent.success ? "executed" : "failed",
      }
      : undefined,
  })
}

effect function emitEarlyResult(run: PlannedRun, outcome: EarlyResult) {
  return try emitToolResult(run.toolCall, run.redactDiagnosticText, outcome.result, {
    ownerCapture: outcome.ownerCapture,
  })
}

export effect function executePlannedToolCall(
  runtime: IAgentRuntime,
  ctx: ExecutePlannedToolCallContext,
  toolCall: PlannerToolCall,
  options: ExecutePlannedToolCallOptions = {},
) {
  try foreignSync(() => options.abortSignal?.throwIfAborted())
  const ownerExecutionId = runtime.ownerToolExecutionObserver
    ? randomUuid()
    : undefined
  const perf = startPerfProbe()
  const redactDiagnosticText = composeToolDiagnosticRedactor(runtime)
  const action = (options.actions ?? runtime.actions).find(
    (candidate) => candidate.name === toolCall.name,
  )
  if (!action) {
    return try emitToolResult(
      toolCall,
      redactDiagnosticText,
      failureResult(
        toolCall.name,
        `Action not found: ${toolCall.name}`,
        {},
        {
          kind: "missing_capability",
          boundary: "capability",
          code: "ACTION_NOT_FOUND",
          retryable: false,
        },
      ),
      {
        ownerCapture: gateCapture({ runtime, ownerExecutionId }, "lookup", "denied"),
      },
    )
  }
  const run: PlannedRun = { runtime, toolCall, options, action, redactDiagnosticText, ownerExecutionId, perf }
  const caller = try admitCaller(run, ctx)
  if (caller.kind === "early") return try emitEarlyResult(run, caller)
  const executorCtx = caller.executorCtx
  const admittedArguments = try admitArguments(run, executorCtx)
  if (admittedArguments.kind === "early") return try emitEarlyResult(run, admittedArguments)
  const admittedHandler = try admitHandler(run, executorCtx, admittedArguments.validation)
  if (admittedHandler.kind === "early") return try emitEarlyResult(run, admittedHandler)
  const actionRun = try runPlannedAction(run, executorCtx, admittedArguments, admittedHandler)
  return try completePlannedToolCall(run, executorCtx, actionRun, admittedHandler.onSettledResult)
}

export const executePlannedToolCallPromise = promised(failingAs(TypeError, executePlannedToolCall, ElizaError))

interface OwnerCapture {
  runtime: IAgentRuntime
  executionId?: string
  phase: "gate" | "settled"
  gate:
    | "lookup"
    | "role-context"
    | "disclosure"
    | "schema"
    | "action-validation"
    | "connector-account"
    | "execution"
  gateOutcome: "denied" | "failed" | "executed"
}

effect function emitToolResult(
  toolCall: PlannerToolCall,
  redactDiagnosticText: ToolDiagnosticTextRedactor,
  result: ActionResult,
  options: { suppressData?: boolean; ownerCapture?: OwnerCapture } = {},
) {
  if (options.ownerCapture) {
    const observation = options.ownerCapture
    observeOwnerToolExecution(observation.runtime, () => ({
      phase: observation.phase,
      gate: observation.gate,
      gateOutcome: observation.gateOutcome,
      actionName: toolCall.name,
      executionId: observation.executionId,
      toolCallId: toolCall.id,
      ...(observation.phase === "gate" ? { args: toolCall.params } : {}),
      result,
    }))
  }
  const streamingContext = getStreamingContext()
  const status = result.success ? "completed" : "failed"
  const streamingToolCall = plannedToolCallToStreamingToolCall(
    toolCall,
    status,
    redactDiagnosticText,
  )
  streamingToolCall.result = actionResultToStreamingResult(
    result,
    redactDiagnosticText,
    options,
  )
  try emitStreamingHook(streamingContext, "onToolResult", {
    toolCall: streamingToolCall,
    toolCallId: streamingToolCall.id,
    result: streamingToolCall.result,
    status,
    ...(streamingContext?.messageId
      ? { messageId: streamingContext.messageId }
      : {}),
  })
  return result
}

effect function withResolvedUserRoles(
  runtime: IAgentRuntime,
  ctx: ExecutePlannedToolCallContext,
) {
  if (ctx.userRoles?.length) {
    return ctx
  }
  return {
    ...ctx,
    userRoles: try resolveActionCallerRoles(runtime, ctx.message),
  }
}

function plannedToolCallToStreamingToolCall(
  toolCall: PlannerToolCall,
  status: "completed" | "failed",
  redactDiagnosticText: ToolDiagnosticTextRedactor,
): ToolCall {
  return {
    id: toolCall.id ?? toolCall.name,
    name: toolCall.name,
    arguments: (projectToolDiagnosticArgs(
      toolCall.params,
      redactDiagnosticText,
    ) ?? {}) as ToolCall["arguments"],
    status,
  }
}

function actionResultToStreamingResult(
  result: ActionResult,
  redactDiagnosticText: ToolDiagnosticTextRedactor,
  options: { suppressData?: boolean } = {},
): ToolCall["result"] {
  const streamingResult: ActionResult = {
    success: result.success,
    text: result.text,
    userFacingText: result.userFacingText,
    verifiedUserFacing: result.verifiedUserFacing,
    effectReceipts: result.effectReceipts,
    replyFailure: result.replyFailure,
    userFacingEffectReceiptIds: result.userFacingEffectReceiptIds,
    error: result.error ? stringifyError(result.error) : undefined,
    data: options.suppressData
      ? sensitiveActionResultMarker(result.data)
      : result.data,
    values: options.suppressData && result.values !== undefined
      ? sensitiveActionResultMarker(result.values)
      : result.values,
    turnComplete: result.turnComplete,
    modelReplyRequired: result.modelReplyRequired,
    modelReplyFallback: result.modelReplyFallback,
    continueChain: result.continueChain,
  }
  return actionResultToContentRecord(streamingResult, redactDiagnosticText)
}

export function dropEmptyOptionalArgs(
  action: Action,
  args: Record<string, unknown>,
): Record<string, unknown> {
  if (action.toolSchemaStrict === false) return args

  let filtered: Record<string, unknown> | undefined
  for (const parameter of action.parameters ?? []) {
    if (parameter.required === true) continue
    if (
      args[parameter.name] === ""
      && parameter.modelOmissionSentinels?.includes("")
    ) {
      filtered ??= { ...args }
      delete filtered[parameter.name]
    }
  }
  return filtered ?? args
}
