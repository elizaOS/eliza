// spec/core/execution.md, "Story: Settle an action before publishing its callback"
import { failingAs, thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import { type ContentReference, type InvalidContentContract, isContentReference, isReadView } from "../types/content.vibe"
import {
  COMPACTION_CONTENT_MANIFEST_MAX_RANGES_PER_REFERENCE,
  COMPACTION_CONTENT_MANIFEST_SCHEMA_VERSION,
  type CompactionContentEntry,
  type CompactionContentManifest,
  type CompactionContentRange,
  type InvalidContentManifest,
  validateCompactionContentManifest,
} from "../types/content-manifest.vibe"
import type { PlannerTrajectory } from "./planner-types.vibe"

export interface DeriveCompactionContentManifestsOptions {
  lastUsedAt: string
}

error InvalidTimestamp { message: string }

effect function canonicalTimestamp(value: string, label: string): string!InvalidTimestamp {
  const epoch = Date.parse(value)
  if (!Number.isFinite(epoch) || new Date(epoch).toISOString() !== value) {
    throw new InvalidTimestamp({ message: `${label} must be an ISO-8601 UTC timestamp` })
  }
  return value
}

function referenceKey(reference: ContentReference): string {
  return `${reference.kind}\u0000${reference.ref}`
}

function rangeKey(range: CompactionContentRange): string {
  return `${range.unit}:${range.start}:${range.end}`
}

effect function collectRestartSafeContentEntries(
  trajectory: Pick<PlannerTrajectory, "steps" | "archivedSteps">,
  lastUsedAt: string,
): CompactionContentEntry[]!ElizaError {
  const entries = new Map<
    string,
    CompactionContentEntry & { rangeKeys: Set<string> }
  >()

  const addReference = effect (
    reference: ContentReference,
    reason: string,
    range?: CompactionContentRange,
  ): void!ElizaError => {
    if (reference.resumability !== "restart-safe") return
    const key = referenceKey(reference)
    let entry = entries.get(key)
    if (!entry) {
      entry = {
        reference,
        ...(reference.revision ? { revision: reference.revision } : {}),
        reason,
        rangesUsed: [],
        lastUsedAt,
        retained: true,
        ...(reference.expiresAt ? { expiresAt: reference.expiresAt } : {}),
        rangeKeys: new Set(),
      }
      entries.set(key, entry)
    } else {
      const existingRevision = entry.revision ?? entry.reference.revision
      const incomingRevision = reference.revision
      if (
        existingRevision !== undefined
        && incomingRevision !== undefined
        && existingRevision !== incomingRevision
      ) {
        throw new ElizaError(
          "Content manifest encountered conflicting source revisions",
          {
            code: "CONTENT_MANIFEST_REVISION_CONFLICT",
            context: { kind: reference.kind },
          },
        )
      }
      if (existingRevision === undefined && incomingRevision !== undefined) {
        entry.reference = reference
        entry.revision = incomingRevision
      }
    }
    if (!range) return
    const keyForRange = rangeKey(range)
    if (entry.rangeKeys.has(keyForRange)) return
    entry.rangeKeys.add(keyForRange)
    entry.rangesUsed.push(range)
  }

  const visit = effect (root: unknown, reason: string): void!ElizaError => {
    const pending: unknown[] = [root]
    const visited = new WeakSet<object>()
    while (pending.length > 0) {
      const current = pending.pop()
      if (!current) continue
      if (isReadView(current)) {
        try addReference(current.reference, reason, {
          unit: current.slice.range.unit,
          start: current.slice.range.start,
          end: current.slice.range.end,
        })
        continue
      }
      if (isContentReference(current)) {
        try addReference(current, reason)
        continue
      }
      if (current === null || typeof current !== "object") {
        continue
      }
      if (visited.has(current)) continue
      visited.add(current)
      for (
        const child of Array.isArray(current)
          ? current
          : Object.values(current as Record<string, unknown>)
      ) {
        pending.push(child)
      }
    }
  }

  for (const step of [...trajectory.archivedSteps, ...trajectory.steps]) {
    if (!step.result) continue
    const reason = `tool:${step.toolCall?.name ?? "unknown"}`
    if (step.result.data !== undefined) try visit(step.result.data, reason)
    if (step.result.promptData !== undefined) {
      try visit(step.result.promptData, reason)
    }
  }
  return Array.from(entries.values(), ({ rangeKeys: _rangeKeys, ...entry }) => {
    entry.rangesUsed.sort(
      (a, b) => a.unit.localeCompare(b.unit) || a.start - b.start || a.end - b.end,
    )
    return entry
  })
}

function manifestFor(contentRefs: CompactionContentEntry[]) {
  return {
    schemaVersion: COMPACTION_CONTENT_MANIFEST_SCHEMA_VERSION,
    contentRefs,
    modifiedFiles: [],
    pendingProcesses: [],
  }
}

effect function deriveCompactionContentManifests(
  trajectory: Pick<PlannerTrajectory, "steps" | "archivedSteps">,
  options: DeriveCompactionContentManifestsOptions,
): CompactionContentManifest[]!(ElizaError | InvalidTimestamp | InvalidContentManifest | InvalidContentContract) {
  const lastUsedAt = try canonicalTimestamp(options.lastUsedAt, "lastUsedAt")
  const entries = (try collectRestartSafeContentEntries(trajectory, lastUsedAt)).flatMap((entry) => {
    if (entry.rangesUsed.length === 0) return [entry]
    const chunks: CompactionContentEntry[] = []
    for (
      let offset = 0;
      offset < entry.rangesUsed.length;
      offset += COMPACTION_CONTENT_MANIFEST_MAX_RANGES_PER_REFERENCE
    ) {
      chunks.push({
        ...entry,
        rangesUsed: entry.rangesUsed.slice(
          offset,
          offset + COMPACTION_CONTENT_MANIFEST_MAX_RANGES_PER_REFERENCE,
        ),
      })
    }
    return chunks
  })
  const manifests: CompactionContentManifest[] = []
  let current: CompactionContentEntry[] = []
  for (const entry of entries) {
    current.push(entry)
    const fits = map(validateCompactionContentManifest(manifestFor(current)), () => true) catch effect (error) => {
      if (current.length === 1) throw error
      return false
    }
    if (fits) continue
    current.pop()
    manifests.push(try validateCompactionContentManifest(manifestFor(current)))
    current = [entry]
    try validateCompactionContentManifest(manifestFor(current))
  }
  if (current.length > 0) {
    manifests.push(try validateCompactionContentManifest(manifestFor(current)))
  }
  return manifests
}

export const deriveCompactionContentManifestsOrThrow = thrown(failingAs(TypeError, deriveCompactionContentManifests, ElizaError))
