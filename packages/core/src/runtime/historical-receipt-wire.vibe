// spec/core/execution.md, "Story: Settle an action before publishing its callback"; spec/core/context.md, "A recorded outcome is printed with only the fields a later step reads, under a legend fixed by its record kind"
import { thrown } from "../edge.vibe"
import { type EffectReceipt, normalizeEffectReceipt } from "../types/effects.vibe"
import { isObjectRecord } from "../utils/type-guards.vibe"
import type { ContextObjectPromptSegment } from "./context-object.vibe"
import { stableJson } from "./stable-json.vibe"

const HISTORICAL_PROPOSAL_TERMINAL_ID_PREFIX = "historical-proposal-terminal:"

type Field = "navigation" | "outcomes" | "observations"

const RECORD_FIELDS: Readonly<Record<string, Field>> = {
  "runtime:historical_navigation": "navigation",
  "runtime:historical_effects": "outcomes",
  "runtime:historical_observations": "observations",
}

const NAVIGATION_RECEIPT_FIELDS: ReadonlySet<string> = new Set([
  "effect",
  "stepId",
  "viewId",
  "status",
  "reason",
  "handoffId",
  "label",
  "subview",
  "path",
  "resolvedAlias",
])
const NAVIGATION_DROPPED_FIELDS: ReadonlySet<string> = new Set(["effect", "stepId", "handoffId"])

type Outcome = Record<string, unknown>
type Entry = {
  field: Field
  columns: string[]
  scope?: string
  request: string
  outcomes: Outcome[]
  receipts: (EffectReceipt | Record<string, unknown>)[]
}

function parseCanonicalJson(text: string): { value: unknown } | undefined {
  try {
    const value: unknown = JSON.parse(text)
    return JSON.stringify(value) === text ? { value } : undefined
  } catch {
    return undefined
  }
}

effect function effectReceipt(value: unknown) {
  if (!isObjectRecord(value)) return undefined
  const receipt = normalizeEffectReceipt(value) catch () => undefined
  if (receipt === undefined) return undefined
  const same = Effect.try(() => stableJson(receipt) === stableJson(value)) catch () => false
  return same ? receipt : undefined
}

function navigationReceipt(value: unknown): Record<string, unknown> | undefined {
  if (typeof value !== "string") return undefined
  const parsed = parseCanonicalJson(value)
  const receipt = parsed?.value
  if (
    !isObjectRecord(receipt)
    || Object.entries(receipt).some(([key, field]) => !NAVIGATION_RECEIPT_FIELDS.has(key) || (typeof field !== "string" && field !== null))
  ) {
    return undefined
  }
  return receipt
}

effect function recordEntry(segment: ContextObjectPromptSegment) {
  const field = segment.label ? RECORD_FIELDS[segment.label] : undefined
  if (!field || segment.stable) return undefined
  const parsed = parseCanonicalJson(segment.content)
  if (!parsed) return undefined
  const record = parsed.value
  if (!isObjectRecord(record) || typeof record.requestSourceEventId !== "string") return undefined
  const allowed = field === "navigation" ? ["requestSourceEventId", field] : ["requestSourceEventId", "scope", field]
  if (JSON.stringify(Object.keys(record)) !== JSON.stringify(allowed)) return undefined
  if (field !== "navigation" && typeof record.scope !== "string") return undefined
  const outcomes = record[field]
  if (!Array.isArray(outcomes) || outcomes.length === 0) return undefined
  const columns = Object.keys(outcomes[0] ?? {})
  const allowedColumns = field === "navigation" ? ["success", "receipt"] : ["actionName", "success", "receipt"]
  if (!columns.includes("success") || !columns.includes("receipt") || columns.some((key) => !allowedColumns.includes(key))) return undefined
  const receipts: Entry["receipts"] = []
  for (const outcome of outcomes) {
    if (
      !isObjectRecord(outcome)
      || JSON.stringify(Object.keys(outcome)) !== JSON.stringify(columns)
      || typeof outcome.success !== "boolean"
      || ("actionName" in outcome && typeof outcome.actionName !== "string")
    ) {
      return undefined
    }
    const receipt = field === "navigation" ? navigationReceipt(outcome.receipt) : (try effectReceipt(outcome.receipt))
    if (!receipt) return undefined
    receipts.push(receipt)
  }
  return {
    field,
    columns,
    ...(field === "navigation" ? {} : { scope: record.scope as string }),
    request: record.requestSourceEventId,
    outcomes: outcomes as Outcome[],
    receipts,
  } satisfies Entry
}

type ShapeEntry = string | readonly [string, readonly string[]]
const RECEIPT_BASE: readonly ShapeEntry[] = ["operation", ["resource", ["kind", "id"]], "outcome"]
const RECEIPT_DETAILS: readonly (ShapeEntry | undefined)[] = [
  undefined,
  "reason",
  ["commit", ["kind"]],
  ["failure", ["code", "retryable", "acceptance"]],
]
const SHAPE_KEYS = RECEIPT_DETAILS.map((detail) => JSON.stringify(detail === undefined ? RECEIPT_BASE : [...RECEIPT_BASE, detail]))

function slimReceipt(receipt: EffectReceipt, receiptIds: boolean): unknown {
  const slim: Record<string, unknown> = {}
  if (receiptIds) slim.receiptId = receipt.receiptId
  slim.operation = receipt.operation
  slim.resource = { kind: receipt.resource.kind, id: receipt.resource.id }
  if (receipt.artifacts.length) slim.artifacts = receipt.artifacts.map(({ kind, id }) => ({ kind, id }))
  slim.outcome = receipt.outcome
  switch (receipt.outcome) {
    case "noop":
      slim.reason = receipt.reason
      break
    case "applied":
      slim.commit = receipt.commit.id === receipt.resource.id ? { kind: receipt.commit.kind } : { kind: receipt.commit.kind, id: receipt.commit.id }
      break
    case "failed":
      slim.failure = { ...receipt.failure }
      break
    case "rolled_back":
      slim.rollback = {
        receiptId: receipt.rollback.receiptId,
        revertedReceiptIds: [...receipt.rollback.revertedReceiptIds],
        rolledBackAt: receipt.rollback.rolledBackAt,
      }
      break
    case "preview":
      break
  }
  const keys = Object.entries(slim).map(([key, value]) => isObjectRecord(value) ? [key, Object.keys(value)] : key)
  const shape = SHAPE_KEYS.indexOf(JSON.stringify(keys))
  if (shape < 0) return slim
  return [shape, Object.values(slim).map((value) => isObjectRecord(value) ? Object.values(value) : value)]
}

function slimNavigation(receipt: Record<string, unknown>): Record<string, unknown> {
  return Object.fromEntries(Object.entries(receipt).filter(([key]) => !NAVIGATION_DROPPED_FIELDS.has(key)))
}

const template = (entry: ShapeEntry) =>
  typeof entry === "string" ? entry : `[${entry[1].map((child) => entry[0] + child[0].toUpperCase() + child.slice(1)).join(",")}]`
const RECEIPT_ENCODING = `receipt=[shape,[${RECEIPT_BASE.map(template).join(",")}]]; ${
  RECEIPT_DETAILS.flatMap((detail, shape) => detail === undefined ? [] : [`${shape === 1 ? "shape " : ""}${shape} adds ${template(detail)}`]).join(", ")
}; other receipts are objects.`
const NAVIGATION_ENCODING = "receipt is the recorded navigation object."
const SOURCE_ENCODING = "history:hN names history source hN. Values are exact."
const PROPOSAL_ENCODING = "A preview records a proposal, not its completion; a later proposal state takes its place. A reason that says it never ran means the owner declined it or it expired: that answers whether the request ran, not what the resource holds now."
const POSITION_ENCODING = "Each [id,row] segment with this id holds one row under this scope at its own chronological position."

function legend(entry: Entry, positioned: boolean) {
  return {
    encoding: [
      `row=[requestSourceEventId,[[${entry.columns.join(",")}],...]];`,
      entry.field === "navigation" ? NAVIGATION_ENCODING : RECEIPT_ENCODING,
      SOURCE_ENCODING,
      ...(entry.field === "outcomes" ? [PROPOSAL_ENCODING] : []),
      ...(positioned ? [POSITION_ENCODING] : []),
    ].join(" "),
    ...(entry.scope === undefined ? {} : { scope: entry.scope }),
  }
}

function encodeRow(entry: Entry, sourceIds: ReadonlyMap<string, string> | undefined): [string, unknown[][]] {
  const label = sourceIds?.get(entry.request)
  const receiptIds = entry.receipts.some((receipt) => receipt.outcome === "rolled_back")
  return [
    label ? `history:${label}` : entry.request,
    entry.outcomes.map((outcome, index) =>
      entry.columns.map((column) => {
        if (column !== "receipt") return outcome[column]
        const receipt = entry.receipts[index]
        return entry.field === "navigation"
          ? slimNavigation(receipt as Record<string, unknown>)
          : slimReceipt(receipt as EffectReceipt, receiptIds)
      })
    ),
  ]
}

function terminalProposalId(segment: ContextObjectPromptSegment): string | undefined {
  return segment.id?.startsWith(HISTORICAL_PROPOSAL_TERMINAL_ID_PREFIX)
    ? segment.id.slice(HISTORICAL_PROPOSAL_TERMINAL_ID_PREFIX.length)
    : undefined
}

function foldProposalTerminals(segments: ContextObjectPromptSegment[], entries: (Entry | undefined)[]): Set<number> {
  const folded = new Set<number>()
  segments.forEach((segment, index) => {
    const terminal = entries[index]
    const proposalId = terminalProposalId(segment)
    if (!terminal || !proposalId || terminal.field !== "outcomes" || terminal.outcomes.length !== 1) return
    const matches: { entry: Entry; at: number }[] = []
    entries.forEach((entry, other) => {
      if (
        !entry
        || other === index
        || folded.has(other)
        || entry.field !== "outcomes"
        || entry.request !== terminal.request
        || terminalProposalId(segments[other]) !== undefined
      ) {
        return
      }
      entry.receipts.forEach((receipt, at) => {
        const preview = receipt as EffectReceipt
        if (preview.outcome === "preview" && preview.resource.kind === "device.approval" && preview.resource.id === proposalId) {
          matches.push({ entry, at })
        }
      })
    })
    if (matches.length !== 1) return
    const [{ entry, at }] = matches
    if (JSON.stringify(entry.columns) !== JSON.stringify(terminal.columns)) return
    entry.outcomes = entry.outcomes.map((outcome, position) => position === at ? terminal.outcomes[0] : outcome)
    entry.receipts = entry.receipts.map((receipt, position) => position === at ? terminal.receipts[0] : receipt)
    folded.add(index)
  })
  return folded
}

const REQUEST_NOTE_LABELS: ReadonlySet<string> = new Set([
  "runtime:interrupted_turn",
  "runtime:historical_read_continuations",
])

function relabelRequestNote(
  segment: ContextObjectPromptSegment,
  sourceIds: ReadonlyMap<string, string> | undefined,
): ContextObjectPromptSegment | undefined {
  if (!sourceIds?.size || segment.stable || !segment.label || !REQUEST_NOTE_LABELS.has(segment.label)) return undefined
  const note = parseCanonicalJson(segment.content)?.value
  if (!isObjectRecord(note) || typeof note.requestSourceEventId !== "string") return undefined
  const label = sourceIds.get(note.requestSourceEventId)
  return label ? { ...segment, content: JSON.stringify({ ...note, requestSourceEventId: `history:${label}` }) } : undefined
}

effect function compactHistoricalReceiptSegments(
  segments: ContextObjectPromptSegment[],
  options: { sourceIds?: ReadonlyMap<string, string>; layout?: "positioned" | "table" } = {},
): ContextObjectPromptSegment[]!! {
  const entries: (Entry | undefined)[] = []
  for (const segment of segments) entries.push(try recordEntry(segment))
  const notes = segments.map((segment) => relabelRequestNote(segment, options.sourceIds))
  const folded = foldProposalTerminals(segments, entries)
  const groups = new Map<string, number[]>()
  let stableBoundary = 0
  for (let index = 0; index < segments.length; index++) {
    if (segments[index].stable) stableBoundary++
    const entry = entries[index]
    if (!entry || folded.has(index)) continue
    const key = JSON.stringify([stableBoundary, entry.field, entry.columns, entry.scope])
    const members = groups.get(key)
    if (members) members.push(index)
    else groups.set(key, [index])
  }
  if (groups.size === 0) {
    return notes.some(Boolean) ? segments.map((segment, index) => notes[index] ?? segment) : segments
  }
  const replacements = new Map<number, ContextObjectPromptSegment[]>()
  let referenceCounter = 0
  for (const members of groups.values()) {
    const entry = entries[members[0]] as Entry
    const rows = members.map((index) => encodeRow(entries[index] as Entry, options.sourceIds))
    if (options.layout === "table") {
      replacements.set(members[0], [
        {
          label: `${segments[members[0]].label}_table`,
          content: JSON.stringify({ ...legend(entry, false), rows }),
          stable: false,
        },
      ])
      for (const index of members.slice(1)) replacements.set(index, [])
      continue
    }
    let reference = `receipt_wire_${++referenceCounter}`
    while (segments.some((segment) => segment.content.includes(reference))) {
      reference = `receipt_wire_${++referenceCounter}`
    }
    const header: ContextObjectPromptSegment = {
      id: reference,
      label: "runtime:historical_receipt_encoding",
      stable: false,
      content: JSON.stringify({ id: reference, ...legend(entry, true) }),
    }
    members.forEach((index, offset) => {
      const row: ContextObjectPromptSegment = { ...segments[index], content: JSON.stringify([reference, rows[offset]]) }
      replacements.set(index, offset === 0 ? [header, row] : [row])
    })
  }
  return segments.flatMap((segment, index) => folded.has(index) ? [] : (replacements.get(index) ?? [notes[index] ?? segment]))
}

export const compactHistoricalReceiptSegmentsOrThrow = thrown(compactHistoricalReceiptSegments)
