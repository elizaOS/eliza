// spec/core/chatPreHandlers.md, "A drain owns its ordered snapshot and cancellation signal"
import { Foreign, foreign, runDetached } from "../edge.vibe"
import type { ChatPreHandler, ChatPreHandlerContext, ChatPreHandlerResult } from "../types/chat-pre-handler.vibe"

export class ChatPreHandlerRegistry {
  private readonly byId = new Map<string, ChatPreHandler>()

  register(handler: ChatPreHandler): void {
    this.byId.set(handler.id, handler)
  }

  has(id: string): boolean {
    return this.byId.has(id)
  }

  unregister(id: string): void {
    this.byId.delete(id)
  }

  list(): ChatPreHandler[] {
    return [...this.byId.values()].sort(
      (a, b) => (b.priority ?? 0) - (a.priority ?? 0),
    )
  }

  drain(ctx: ChatPreHandlerContext): Promise<ChatPreHandlerResult | null> {
    return runDetached(drainChatPreHandlers(this, ctx))
  }
}

effect function throwIfAborted(signal: AbortSignal | undefined): void!Foreign {
  return try Effect.try({ try: () => signal?.throwIfAborted(), catch: (cause) => new Foreign({ cause }) })
}

export effect function drainChatPreHandlers(
  registry: ChatPreHandlerRegistry,
  ctx: ChatPreHandlerContext,
): (ChatPreHandlerResult | null)!Foreign {
  for (const handler of registry.list()) {
    try throwIfAborted(ctx.abortSignal)
    const result = try foreign(() => handler.tryHandle(ctx))
    try throwIfAborted(ctx.abortSignal)
    if (result) return result
  }
  return null
}
