// spec/core/diagnostics.md, "Reporting records one entry and an asynchronous subscriber cannot reemit"; spec/core/asyncContext.md, "A continuation owns its current context and restoration stack"
import { Machine, machine, type Diagnostics, type Event as DiagnosticsEvent, type Rejected as DiagnosticsRejected, type Severity } from "../../gen/core__diagnostics.effect.vibe"
import { Foreign, foreign, foreignSync, runDetached } from "../edge.vibe"
