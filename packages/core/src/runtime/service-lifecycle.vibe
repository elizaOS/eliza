// spec/core/serviceInstances.md, "Story: Share starts and stop each returned object once"; spec/core/serviceInstances.md, "Acquisition snapshots keep each class and attempt generation"; spec/core/serviceInstances.md, "Instance stop promises retain identity across every caller"
import { asLegacy, Foreign, foreign, foreignSync, runDetached } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import { EventType } from "../types/events.vibe"
import type { ServiceClass } from "../types/plugin.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import type { Service, ServiceTypeName } from "../types/service.vibe"
import type { RuntimeRetirement } from "./retirement.vibe"

export type ServiceResolver = (service: Service) => void

export type ServiceRejecter = (reason: Error | string) => void

export type ServicePromiseHandler = {
  resolve: ServiceResolver
  reject: ServiceRejecter
}

export interface RuntimeServiceLifecycleHost {
  stopRequested(): boolean
  initializationFailed(): boolean
  resolveServiceTypeAlias(serviceType: ServiceTypeName | string): string
  initResolver(): ((value?: void | PromiseLike<void>) => void) | undefined
  serviceTypes(): Map<ServiceTypeName, ServiceClass[]>
  serviceInstancesByClass(): Map<ServiceClass, Service>
  startingServiceClasses(): Map<ServiceClass, Promise<Service>>
  failedServiceClasses(): Set<ServiceClass>
  startingServices(): Map<string, Promise<Service | null>>
  serviceRegistrationStatus(): Map<
    ServiceTypeName,
    "pending" | "registering" | "registered" | "failed"
  >
  servicePromiseHandlers(): Map<string, ServicePromiseHandler>
  servicePromises(): Map<string, Promise<Service>>
  stopped(): boolean

  runServiceStart(
    key: ServiceTypeName,
    serviceType: string,
    serviceClass: ServiceClass,
  ): Promise<Service | null>
}

const EAGER_SERVICE_START_RETRY_DELAYS_MS: readonly number[] = [
  2_000,
  5_000,
  10_000,
]

error ServiceImplementationDidNotStart { message: string }
error ServiceStartAfterStop { message: string }
error ServiceUnregisteredDuringStart { message: string }

function thrownValue(failure: Foreign | ElizaError | ServiceStartAfterStop | ServiceUnregisteredDuringStart): unknown {
  if (failure instanceof Foreign) return failure.cause
  if (failure instanceof ElizaError) return failure
  return new Error(failure.message)
}

export effect function startServiceEagerly(
  lifecycle: RuntimeServiceLifecycle,
  serviceType: ServiceTypeName | string,
  pluginName: string,
): void!! {
  const { runtime, host } = lifecycle
  for (let attempt = 0;; attempt += 1) {
    const started = try result(Effect.catchDefect(ensureServiceStarted(lifecycle, serviceType), (cause) => fail(new Foreign({ cause }))))
    if (Result.isSuccess(started)) return
    const err = started.failure instanceof Foreign ? started.failure.cause : started.failure
    const delayMs = EAGER_SERVICE_START_RETRY_DELAYS_MS[attempt]
    const willRetry = delayMs !== undefined
      && !host.stopRequested()
      && !host.stopped()
    runtime.logger.error(
      {
        src: "agent",
        agentId: runtime.agentId,
        plugin: pluginName,
        serviceType,
        attempt: attempt + 1,
        willRetry,
        error: err instanceof Error ? err.message : String(err),
      },
      willRetry ? "Service start failed; retrying" : "Service start failed",
    )
    if (!willRetry) return
    try sleep(delayMs)
    if (host.stopRequested() || host.stopped()) return
  }
}

effect function stopServiceOperation(
  retirement: RuntimeRetirement,
  serviceType: string,
  service: Service,
): void!Foreign {
  foreign(() => service.stop()) catch effect (failure) => {
    retirement.recordFailure(`stop:${serviceType}`, failure.cause)
    throw failure
  }
}

export effect function stopServiceInstance(
  lifecycle: RuntimeServiceLifecycle,
  serviceType: string,
  service: Service | null | undefined,
  reason: string,
): void!! {
  const { runtime, retirement } = lifecycle
  if (!service) {
    retirement.recordFailure(
      `stop:${serviceType}`,
      new Error("Null service instance"),
    )
    runtime.logger.warn(
      { src: "agent", agentId: runtime.agentId, serviceType, reason },
      "Null service instance during stop; skipping",
    )
    return
  }

  if (typeof service.stop !== "function") {
    retirement.recordFailure(
      `stop:${serviceType}`,
      new Error("Service is missing stop()"),
    )
    runtime.logger.warn(
      { src: "agent", agentId: runtime.agentId, serviceType, reason },
      "Service instance is missing stop(); skipping",
    )
    return
  }
  foreign(() => lifecycle.stopServiceOnce(serviceType, service)) catch ({ cause: err }) => {
    runtime.logger.warn(
      {
        src: "agent",
        agentId: runtime.agentId,
        serviceType,
        reason,
        error: err instanceof Error ? err.message : String(err),
      },
      "Service stop() threw; continuing",
    )
  }
}

effect function startServiceClass(
  host: RuntimeServiceLifecycleHost,
  serviceClass: ServiceClass,
  starting: Promise<Service | null>,
): Service!(Foreign | ServiceImplementationDidNotStart) {
  const service = foreign(() => starting) catch effect (failure) => {
    host.failedServiceClasses().add(serviceClass)
    throw failure
  }
  if (!service) {
    throw new ServiceImplementationDidNotStart({
      message: `Service implementation ${serviceClass.name || "<anonymous>"} did not start`,
    })
  }
  host.failedServiceClasses().delete(serviceClass)
  return service
}

function classStart(
  host: RuntimeServiceLifecycleHost,
  key: ServiceTypeName,
  serviceType: string,
  serviceClass: ServiceClass,
  startedImplementation: Service | undefined,
): Promise<Service> {
  const started = host.serviceInstancesByClass().get(serviceClass)
  if (started) return Promise.resolve(started)
  const pending = host.startingServiceClasses().get(serviceClass)
  if (pending) return pending
  if (startedImplementation && host.failedServiceClasses().has(serviceClass)) {
    return Promise.resolve(startedImplementation)
  }
  const starting = host.runServiceStart(key, serviceType, serviceClass).then((service) => service)
  const start = runDetached(onExit(
    asLegacy(Error, startServiceClass(host, serviceClass, starting)),
    () => sync(() => host.startingServiceClasses().delete(serviceClass)),
  ))
  host.startingServiceClasses().set(serviceClass, start)
  return start
}

effect function serviceStarts(
  host: RuntimeServiceLifecycleHost,
  key: ServiceTypeName,
  serviceType: string,
  classes: readonly ServiceClass[],
): Promise<Service>[]!Foreign {
  const instances = host.serviceInstancesByClass()
  const startedClass = classes.find((serviceClass) => instances.has(serviceClass))
  const startedImplementation = startedClass && instances.get(startedClass)
  const starts: Promise<Service>[] = []
  for (const serviceClass of classes) {
    const { start } = try foreignSync(() => ({ start: classStart(host, key, serviceType, serviceClass, startedImplementation) }))
    starts.push(start)
  }
  return starts
}

effect function settleStarts(starts: readonly Promise<Service>[]): Result.Result<Service, Foreign>[]!! {
  const settled: Result.Result<Service, Foreign>[] = []
  for concurrent (const [index, start] of starts.entries()) {
    settled[index] = try result(foreign(() => start))
  }
  return settled
}

effect function firstStarted(starts: readonly Promise<Service>[]): (Service | null)!! {
  const settled = try settleStarts(starts)
  return settled.find(Result.isSuccess)?.success ?? null
}

function publishAggregateStart(
  host: RuntimeServiceLifecycleHost,
  key: ServiceTypeName,
  starts: readonly Promise<Service>[],
): void {
  const allStarts: Promise<Service | null> = runDetached(onExit(
    firstStarted(starts),
    () => sync(() => {
      if (host.startingServices().get(key) === allStarts) {
        host.startingServices().delete(key)
      }
    }),
  ))
  host.startingServices().set(key, allStarts)
}

export effect function ensureServiceStarted(
  lifecycle: RuntimeServiceLifecycle,
  serviceType: ServiceTypeName | string,
): (Service | null)!(Foreign | ElizaError) {
  const { runtime, host } = lifecycle
  if (host.stopRequested()) return null
  const key = host.resolveServiceTypeAlias(
    serviceType,
  ) as ServiceTypeName

  const alreadyRunning = runtime.services.get(key)?.[0]
  if (alreadyRunning && host.initResolver()) return alreadyRunning
  try foreign(() => runtime.initPromise)

  if (host.stopRequested() || host.initializationFailed()) {
    return null
  }
  const classes = host.serviceTypes().get(key)
  if (!classes || classes.length === 0) {
    return null
  }
  const starts = try serviceStarts(host, key, serviceType, classes)
  publishAggregateStart(host, key, starts)

  const settled = try settleStarts(starts)
  const first = runtime.services.get(key)?.[0] ?? null
  if (first) {
    host.serviceRegistrationStatus().set(key, "registered")
    const handler = host.servicePromiseHandlers().get(key)
    if (handler) {
      handler.resolve(first)
      host.servicePromiseHandlers().delete(key)
    }
    return first
  }

  const cause = new AggregateError(
    settled.flatMap((settledStart) => Result.isFailure(settledStart) ? [settledStart.failure.cause] : []),
    `All implementations of service ${serviceType} failed`,
  )
  const startupError = new ElizaError(
    `Service ${serviceType} not found or failed to start`,
    {
      code: "SERVICE_START_FAILED",
      context: {
        serviceType,
        implementationCount: classes.length,
      },
      cause,
    },
  )
  const handler = host.servicePromiseHandlers().get(key)
  if (handler) {
    handler.reject(startupError)
    host.servicePromiseHandlers().delete(key)
    host.servicePromises().delete(key)
  }

  if (host.serviceTypes().get(key)?.length) {
    host.serviceRegistrationStatus().set(key, "failed")
  } else {
    host.serviceRegistrationStatus().delete(key)
  }
  throw startupError
}

effect function publishStartedService(
  lifecycle: RuntimeServiceLifecycle,
  key: ServiceTypeName,
  serviceType: string,
  serviceDef: ServiceClass,
): Service!(Foreign | ElizaError | ServiceStartAfterStop | ServiceUnregisteredDuringStart) {
  const { runtime, host } = lifecycle
  if (host.stopped() || host.stopRequested()) {
    throw new ServiceStartAfterStop({
      message: `Runtime stop requested before service ${serviceType} could start`,
    })
  }
  const serviceInstance = try foreign(() => serviceDef.start(runtime))
  if (!serviceInstance) {
    throw new ElizaError("Service start returned no instance", {
      code: "SERVICE_START_RESULT_INVALID",
      context: { serviceType },
    })
  }
  if (host.stopped() || host.stopRequested()) {
    try stopServiceInstance(
      lifecycle,
      key,
      serviceInstance,
      "late service start after runtime stop",
    )
    throw new ServiceStartAfterStop({
      message: `Runtime stop requested while service ${serviceType} was starting`,
    })
  }

  if (!host.serviceTypes().get(key)?.includes(serviceDef)) {
    try stopServiceInstance(
      lifecycle,
      key,
      serviceInstance,
      "late service start after plugin unload",
    )
    throw new ServiceUnregisteredDuringStart({
      message: `Service ${serviceType} was unregistered while it was starting`,
    })
  }
  host.serviceInstancesByClass().set(serviceDef, serviceInstance)
  const orderedInstances = (
    host.serviceTypes().get(key) ?? []
  ).flatMap((serviceClass) => {
    const instance = host
      .serviceInstancesByClass()
      .get(serviceClass)
    return instance ? [instance] : []
  })
  runtime.services.set(key, orderedInstances)
  host.serviceRegistrationStatus().set(key, "registered")
  if (serviceDef.registerSendHandlers) {
    try foreignSync(() => serviceDef.registerSendHandlers!(runtime, serviceInstance))
  }

  foreign(() => runtime.emitEvent(EventType.SERVICE_STARTED, {
    runtime,
    source: "runtime",
    serviceType,
  })) catch ({ cause: error }) => {
    runtime.reportError(
      "AgentRuntime.serviceStartedObserver",
      error,
      {
        serviceType,
      },
    )
  }
  return serviceInstance
}

effect function runServiceStart(
  lifecycle: RuntimeServiceLifecycle,
  key: ServiceTypeName,
  serviceType: string,
  serviceDef: ServiceClass,
): Service!(Foreign | ElizaError) {
  const { runtime, host } = lifecycle
  if ((runtime.services.get(key)?.length ?? 0) === 0) {
    host.serviceRegistrationStatus().set(key, "registering")
  }
  if (typeof serviceDef.start !== "function") {
    throw new ElizaError("Service class has no static start method", {
      code: "SERVICE_START_METHOD_MISSING",
      context: { serviceType },
    })
  }
  return Effect.catchDefect(publishStartedService(lifecycle, key, serviceType, serviceDef), (cause) => fail(new Foreign({ cause }))) catch effect (failure) => {
    const error = thrownValue(failure)
    runtime.reportError("AgentRuntime.serviceStart", error, {
      serviceType,
    })

    throw new ElizaError(`Service ${serviceType} failed to start`, {
      code: "SERVICE_START_FAILED",
      cause: error,
      context: { serviceType },
    })
  }
}

export class RuntimeServiceLifecycle {
  async startServiceEagerly(
    serviceType: ServiceTypeName | string,
    pluginName: string,
  ): Promise<void> {
    return runDetached(startServiceEagerly(this, serviceType, pluginName))
  }

  constructor(
    readonly runtime: IAgentRuntime,
    readonly host: RuntimeServiceLifecycleHost,
    readonly retirement: RuntimeRetirement,
  ) {}

  private readonly stopOperations = new WeakMap<Service, Promise<void>>()

  stopServiceOnce(serviceType: string, service: Service): Promise<void> {
    let operation = this.stopOperations.get(service)
    if (!operation) {
      operation = this.retirement.run(() => Promise.resolve().then(() => runDetached(stopServiceOperation(this.retirement, serviceType, service))))
      this.stopOperations.set(service, operation)
    }
    return operation
  }

  async _stopServiceInstance(
    serviceType: string,
    service: Service | null | undefined,
    reason: string,
  ): Promise<void> {
    return runDetached(stopServiceInstance(this, serviceType, service, reason))
  }

  async _ensureServiceStarted(
    serviceType: ServiceTypeName | string,
  ): Promise<Service | null> {
    return runDetached(ensureServiceStarted(this, serviceType))
  }

  _runServiceStart(
    key: ServiceTypeName,
    serviceType: string,
    serviceDef: ServiceClass,
  ): Promise<Service | null> {
    return this.retirement.run(() => runDetached(runServiceStart(this, key, serviceType, serviceDef)))
  }
}
