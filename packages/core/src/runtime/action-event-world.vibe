// spec/core/execution.md, "Story: Settle an action before publishing its callback"
import { foreign, foreignSync, promised, type Foreign } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import type { Memory } from "../types/memory.vibe"
import type { UUID } from "../types/primitives.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"

type ActionEventWorldRuntime = Pick<
  IAgentRuntime,
  "agentId" | "getRoom" | "reportError"
>

type ActionEventWorldMessage = Pick<Memory, "roomId" | "worldId">

effect function fallBackToAgentWorld(
  runtime: ActionEventWorldRuntime,
  reportScope: string,
  message: ActionEventWorldMessage,
  text: string,
  code: string,
  cause?: Error,
): UUID!Foreign {
  const error = new ElizaError(text, {
    code,
    cause,
    severity: "ephemeral",
    context: { roomId: message.roomId },
  })
  try foreignSync(() => runtime.reportError(reportScope, error))
  return runtime.agentId
}

export effect function resolveActionEventWorldId(
  runtime: ActionEventWorldRuntime,
  message: ActionEventWorldMessage,
  reportScope: string,
): UUID!Foreign {
  if (message.worldId) {
    return message.worldId
  }

  const lookup = try result(foreign(() => runtime.getRoom(message.roomId)))
  if (Result.isFailure(lookup)) {
    const cause = lookup.failure.cause
    return try fallBackToAgentWorld(
      runtime,
      reportScope,
      message,
      "Action event world lookup failed",
      "ACTION_EVENT_WORLD_LOOKUP_FAILED",
      cause instanceof Error ? cause : new Error(String(cause)),
    )
  }
  const room = lookup.success

  if (!room) {
    return try fallBackToAgentWorld(runtime, reportScope, message, "Action event room was not found", "ACTION_EVENT_ROOM_NOT_FOUND")
  }

  if (!room.worldId) {
    return try fallBackToAgentWorld(runtime, reportScope, message, "Action event room has no world", "ACTION_EVENT_ROOM_WORLD_MISSING")
  }

  return room.worldId
}

export const resolveActionEventWorldIdPromise = promised(resolveActionEventWorldId)
