// spec/core/ingressSnapshots.md, "Binding requires matching message, agent, room and entity identity"; spec/core/ingressSnapshots.md, "Reuse requires exact redacted content and every projected stored segment"
import { foreign, type Foreign, promised, thrown, thrownValue } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import type { Memory } from "../types/memory.vibe"
import type { Content, UUID } from "../types/primitives.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import { utf8ByteLength } from "../utils/unicode.vibe"
import {
  buildMessageContentProjection,
  canonicalAttachmentText,
  MESSAGE_CONTENT_PARENT_INLINE_MAX_BYTES,
  MESSAGE_CONTENT_SEGMENT_TABLE,
} from "./message-content-segments.vibe"

module node {
  function equalValues(left: unknown, right: unknown, seen: WeakMap<object, WeakSet<object>>): boolean {
    if (Object.is(left, right)) return true
    if (typeof left !== "object" || typeof right !== "object" || left === null || right === null) return false
    if (Object.getPrototypeOf(left) !== Object.getPrototypeOf(right)) return false
    const paired = seen.get(left)
    if (paired?.has(right)) return true
    if (paired) paired.add(right)
    else seen.set(left, new WeakSet([right]))
    if (left instanceof Date && right instanceof Date) return Object.is(left.getTime(), right.getTime())
    if (left instanceof RegExp && right instanceof RegExp) return left.source === right.source && left.flags === right.flags
    if (ArrayBuffer.isView(left) && ArrayBuffer.isView(right)) {
      if (left.byteLength !== right.byteLength) return false
      const a = new Uint8Array(left.buffer, left.byteOffset, left.byteLength)
      const b = new Uint8Array(right.buffer, right.byteOffset, right.byteLength)
      for (let i = 0; i < a.length; i += 1) if (a[i] !== b[i]) return false
      return true
    }
    if (Array.isArray(left) && Array.isArray(right)) {
      if (left.length !== right.length) return false
      for (let i = 0; i < left.length; i += 1) {
        if (Object.hasOwn(left, i) !== Object.hasOwn(right, i)) return false
        if (!equalValues(left[i], right[i], seen)) return false
      }
      return true
    }
    if (left instanceof Map && right instanceof Map) {
      if (left.size !== right.size) return false
      for (const [k, v] of left) if (!right.has(k) || !equalValues(v, right.get(k), seen)) return false
      return true
    }
    if (left instanceof Set && right instanceof Set) {
      if (left.size !== right.size) return false
      for (const v of left) if (!right.has(v)) return false
      return true
    }
    const leftKeys = Reflect.ownKeys(left)
    const rightKeys = Reflect.ownKeys(right)
    if (leftKeys.length !== rightKeys.length) return false
    const lObj = left as Record<PropertyKey, unknown>
    const rObj = right as Record<PropertyKey, unknown>
    for (const key of leftKeys) {
      if (!Object.hasOwn(right, key)) return false
      if (!equalValues(lObj[key], rObj[key], seen)) return false
    }
    return true
  }

  /** @throws {never} */
  export function deepEqual(left: unknown, right: unknown): boolean {
    return equalValues(left, right, new WeakMap())
  }
}
import { deepEqual } from node
export { deepEqual }

const ingressPersistenceSnapshots = new WeakMap<Memory, Memory>()

function snapshotIdentityDiffers(message: Memory, persisted: Memory): boolean {
  return message.id !== persisted.id
    || message.agentId !== persisted.agentId
    || message.roomId !== persisted.roomId
    || message.entityId !== persisted.entityId
}

function publicationConflict(text: string, messageId: UUID | null): ElizaError {
  return new ElizaError(text, { code: "MESSAGE_CONTENT_PUBLICATION_CONFLICT", context: { messageId } })
}

effect function bindIncomingMessagePersistence(
  message: Memory,
  persisted: Memory,
): void!ElizaError {
  if (!message.id || snapshotIdentityDiffers(message, persisted)) {
    throw publicationConflict("Ingress persistence snapshot identity differs from its routed message", message.id ?? null)
  }
  ingressPersistenceSnapshots.set(message, structuredClone(persisted))
}
export const bindIncomingMessagePersistenceOrThrow = thrown(bindIncomingMessagePersistence)

effect function inheritIncomingMessagePersistence(
  source: Memory,
  augmented: Memory,
): void!ElizaError {
  const persisted = ingressPersistenceSnapshots.get(source)
  if (persisted) try bindIncomingMessagePersistence(augmented, persisted)
}
export const inheritIncomingMessagePersistenceOrThrow = thrown(inheritIncomingMessagePersistence)

effect function incomingMessagePersistenceSnapshot(
  message: Memory,
): (Memory | undefined)!ElizaError {
  const persisted = ingressPersistenceSnapshots.get(message)
  if (!persisted) return undefined
  if (snapshotIdentityDiffers(message, persisted)) {
    throw publicationConflict("Ingress persistence snapshot identity changed", message.id ?? null)
  }
  return structuredClone(persisted)
}
export const incomingMessagePersistenceSnapshotOrThrow = thrown(incomingMessagePersistenceSnapshot)

function contentNeedsNativeSegments(content: Content): boolean {
  if (
    typeof content.text === "string"
    && utf8ByteLength(content.text) > MESSAGE_CONTENT_PARENT_INLINE_MAX_BYTES
  ) {
    return true
  }
  return (content.attachments ?? []).some(
    (attachment) =>
      utf8ByteLength(canonicalAttachmentText(attachment))
      > MESSAGE_CONTENT_PARENT_INLINE_MAX_BYTES,
  )
}

effect function persistMessageMemory(
  runtime: IAgentRuntime,
  memory: Memory,
): UUID!(ElizaError | Foreign) {
  const createMessageMemory = runtime.createMessageMemory
  if (createMessageMemory) {
    return try foreign(() => createMessageMemory.call(runtime, memory))
  }
  if (contentNeedsNativeSegments(memory.content)) {
    throw new ElizaError(
      "Runtime cannot atomically publish oversized message content",
      {
        code: "MESSAGE_CONTENT_SEGMENT_STORAGE_UNAVAILABLE",
        context: { messageId: memory.id ?? null },
      },
    )
  }
  return try foreign(() => runtime.createMemory(memory, "messages"))
}
export const persistMessageMemoryPromise = promised(persistMessageMemory)

effect function persistIncomingMessageMemory(
  runtime: IAgentRuntime,
  memory: Memory,
): UUID!(ElizaError | Foreign) {
  if (!memory.id) return try persistMessageMemory(runtime, memory)
  const id = memory.id
  const conflict = () => publicationConflict("Incoming message id is bound to different or incomplete content", id)
  const assertExisting = effect (existing: Memory): UUID!(ElizaError | Foreign) => {
    if (
      existing.id !== id
      || existing.agentId !== (memory.agentId ?? runtime.agentId)
      || existing.roomId !== memory.roomId
      || existing.entityId !== memory.entityId
    ) {
      throw conflict()
    }

    const textRedacted = {
      ...memory.content,
      ...(typeof memory.content.text === "string"
        ? { text: runtime.redactSecrets(memory.content.text) }
        : {}),
    }
    const allRedacted = {
      ...textRedacted,
      ...(memory.content.attachments
        ? {
          attachments: memory.content.attachments.map((attachment) => ({
            ...attachment,
            ...(typeof attachment.text === "string"
              ? { text: runtime.redactSecrets(attachment.text) }
              : {}),
            ...(typeof attachment.description === "string"
              ? { description: runtime.redactSecrets(attachment.description) }
              : {}),
          })),
        }
        : {}),
    }
    for (const content of [memory.content, textRedacted, allRedacted]) {
      if (deepEqual(existing.content, content)) return id
      const projection = try buildMessageContentProjection({
        ...memory,
        id,
        agentId: memory.agentId ?? runtime.agentId,
        content,
      })
      if (!deepEqual(existing.content, projection.content)) continue
      const expected = projection.segments
      const segmentIds: UUID[] = []
      for (const segment of expected) {
        if (!segment.id) throw conflict()
        segmentIds.push(segment.id)
      }
      const rows = try foreign(() => runtime.getMemoriesByIds(segmentIds, MESSAGE_CONTENT_SEGMENT_TABLE))
      const byId = new Map(rows.map((row) => [row.id, row]))
      if (
        expected.every((segment) => {
          const row = byId.get(segment.id)

          const { timestamp: _expectedTime, ...expectedMetadata } = segment.metadata ?? {}
          const { timestamp: _storedTime, ...storedMetadata } = row?.metadata ?? {}
          return (
            row
            && row.agentId === segment.agentId
            && row.roomId === segment.roomId
            && row.entityId === segment.entityId
            && deepEqual(row.content, segment.content)
            && deepEqual(storedMetadata, expectedMetadata)
          )
        })
      ) {
        return id
      }
      throw conflict()
    }
    throw conflict()
  }
  const [existing] = try foreign(() => runtime.getMemoriesByIds([id], "messages"))
  if (existing) return try assertExisting(existing)
  return persistMessageMemory(runtime, memory) catch effect (error) => {
    const failure = thrownValue(error)
    if (
      !(failure instanceof ElizaError)
      || failure.code !== "MESSAGE_CONTENT_PUBLICATION_CONFLICT"
    ) {
      throw error
    }
    const [raced] = try foreign(() => runtime.getMemoriesByIds([id], "messages"))
    if (!raced) throw error
    return try assertExisting(raced)
  }
}
export const persistIncomingMessageMemoryPromise = promised(persistIncomingMessageMemory)

effect function replaceStoredMessageContent(
  runtime: IAgentRuntime,
  messageId: UUID,
  content: Content,
): void!(ElizaError | Foreign) {
  const replaceMessageMemoryContent = runtime.replaceMessageMemoryContent
  if (replaceMessageMemoryContent) {
    try foreign(() => replaceMessageMemoryContent.call(runtime, messageId, content))
    return
  }
  if (contentNeedsNativeSegments(content)) {
    throw new ElizaError(
      "Runtime cannot atomically replace oversized message content",
      {
        code: "MESSAGE_CONTENT_SEGMENT_STORAGE_UNAVAILABLE",
        context: { messageId },
      },
    )
  }
  try foreign(() => runtime.updateMemory({ id: messageId, content }))
}
export const replaceStoredMessageContentPromise = promised(replaceStoredMessageContent)
