// spec/core/storage.md, "Story: Preserve storage compatibility without hiding unsupported operations"; spec/core/storage.md, "Revisions and pagination reject invalid numeric inputs"
import { revisionMatches } from "../../gen/core__storage.effect.vibe"
import { type Foreign, foreignSync, thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import type { Metadata } from "../types/primitives.vibe"
import { isPlainObject } from "../utils/type-guards.vibe"

export const WORLD_METADATA_REVISION_KEY = "__eliza_world_metadata_revision" as const

export const WORLD_METADATA_ROLE_AUDIT_KEY = "__eliza_role_audit" as const

export function worldMetadataValueEquals(
  left: unknown,
  right: unknown,
): boolean {
  if (left === right) return true
  if (Array.isArray(left) && Array.isArray(right)) {
    return (
      left.length === right.length
      && left.every((item, index) => worldMetadataValueEquals(item, right[index]))
    )
  }
  if (isPlainObject(left) && isPlainObject(right)) {
    const leftKeys = Object.keys(left).filter((key) => left[key] !== undefined)
    const rightKeys = Object.keys(right).filter(
      (key) => right[key] !== undefined,
    )
    if (leftKeys.length !== rightKeys.length) return false
    return leftKeys.every(
      (key) =>
        Object.hasOwn(right, key)
        && worldMetadataValueEquals(left[key], right[key]),
    )
  }
  return false
}

export function getWorldMetadataRevision(
  metadata: Metadata | undefined,
): number | null {
  const value = metadata?.[WORLD_METADATA_REVISION_KEY]
  if (value === undefined) return 0
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0
    ? value
    : null
}

effect function cloneMetadata(metadata: Metadata | undefined): Metadata!Foreign {
  return try foreignSync(() => structuredClone(metadata ?? {}) as Metadata)
}

export effect function requireFreshWorldMetadataRevision(
  storedMetadata: Metadata | undefined,
  writerMetadata: Metadata | undefined,
  worldId: string,
): number!ElizaError {
  const storedRevision = getWorldMetadataRevision(storedMetadata)
  const writerRevision = getWorldMetadataRevision(writerMetadata)
  if (storedRevision !== null && writerRevision !== null && revisionMatches(storedRevision, writerRevision)) {
    return storedRevision
  }
  throw new ElizaError("World metadata write used a stale revision", {
    code: "WORLD_METADATA_STALE_WRITE",
    context: {
      worldId,
      storedRevision,
      writerRevision,
      reason: storedRevision === null || writerRevision === null
        ? "malformed_revision"
        : "revision_mismatch",
    },
  })
}
export const requireFreshWorldMetadataRevisionOrThrow = thrown(requireFreshWorldMetadataRevision)

export effect function mergeWorldMetadataForLegacyWrite(
  storedMetadata: Metadata | undefined,
  incomingMetadata: Metadata | undefined,
  worldId: string,
): Metadata!(ElizaError | Foreign) {
  const storedRevision = getWorldMetadataRevision(storedMetadata)
  if (storedRevision === null) {
    throw new ElizaError("Stored world metadata revision is malformed", {
      code: "WORLD_METADATA_STALE_WRITE",
      context: { worldId, storedRevision, reason: "malformed_revision" },
    })
  }
  const stored = try cloneMetadata(storedMetadata)
  const incoming = try cloneMetadata(incomingMetadata)

  delete incoming.roles
  delete incoming.roleSources

  delete incoming[WORLD_METADATA_ROLE_AUDIT_KEY]
  return {
    ...stored,
    ...incoming,
    ...(stored.roles === undefined ? {} : { roles: stored.roles }),
    ...(stored.roleSources === undefined
      ? {}
      : { roleSources: stored.roleSources }),
    ...(stored[WORLD_METADATA_ROLE_AUDIT_KEY] === undefined
      ? {}
      : {
        [WORLD_METADATA_ROLE_AUDIT_KEY]: stored[WORLD_METADATA_ROLE_AUDIT_KEY],
      }),
    [WORLD_METADATA_REVISION_KEY]: storedRevision,
  }
}
export const mergeWorldMetadataForLegacyWriteOrThrow = thrown(mergeWorldMetadataForLegacyWrite)

export effect function advanceWorldMetadataRevision(
  metadata: Metadata | undefined,
  currentRevision: number,
): Metadata!(ElizaError | Foreign) {
  if (!Number.isSafeInteger(currentRevision) || currentRevision < 0) {
    throw new ElizaError("World metadata revision is invalid", {
      code: "WORLD_METADATA_REVISION_INVALID",
      context: { currentRevision },
    })
  }
  if (currentRevision === Number.MAX_SAFE_INTEGER) {
    throw new ElizaError("World metadata revision is exhausted", {
      code: "WORLD_METADATA_REVISION_EXHAUSTED",
    })
  }
  const replacement = try cloneMetadata(metadata)
  replacement[WORLD_METADATA_REVISION_KEY] = currentRevision + 1
  return replacement
}
export const advanceWorldMetadataRevisionOrThrow = thrown(advanceWorldMetadataRevision)

export effect function appendWorldMetadataRoleAudit(
  metadata: Metadata | undefined,
  audit: Record<string, unknown>,
): Metadata!Foreign {
  const replacement = try cloneMetadata(metadata)
  const prior = replacement[WORLD_METADATA_ROLE_AUDIT_KEY]
  const entries = Array.isArray(prior) ? prior : []
  replacement[WORLD_METADATA_ROLE_AUDIT_KEY] = [
    ...entries,
    try foreignSync(() => structuredClone(audit)),
  ] as never
  return replacement
}
export const appendWorldMetadataRoleAuditOrThrow = thrown(appendWorldMetadataRoleAudit)

export effect function initializeWorldMetadataRevision(
  metadata: Metadata | undefined,
): Metadata!Foreign {
  const replacement = try cloneMetadata(metadata)
  replacement[WORLD_METADATA_REVISION_KEY] = 0
  return replacement
}
export const initializeWorldMetadataRevisionOrThrow = thrown(initializeWorldMetadataRevision)
