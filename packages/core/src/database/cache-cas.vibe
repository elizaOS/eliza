// spec/core/storage.md, "Story: Preserve storage compatibility without hiding unsupported operations"
import { thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"

module jsonb {
  /** @throws {Error} */
  export function encodeJsonb(value: unknown): string {
    const ancestors = new Set<object>()
    const string = (text: string): string => {
      if (text.includes("\u0000") || !text.isWellFormed()) {
        throw new Error("Invalid jsonb string")
      }
      return JSON.stringify(text)
    }
    const encode = (item: unknown): string => {
      if (item === null) return "null"
      if (typeof item === "string") return string(item)
      if (typeof item === "boolean") return String(item)
      if (typeof item === "number" && Number.isFinite(item)) {
        return JSON.stringify(item)
      }
      if (typeof item !== "object") throw new Error("Expected JSON value")
      if (ancestors.has(item)) throw new Error("Cyclic cache value")
      const array = Array.isArray(item)
      const prototype = Object.getPrototypeOf(item)
      if (!array && prototype !== Object.prototype && prototype !== null) {
        throw new Error("Expected plain object")
      }
      ancestors.add(item)
      try {
        const descriptors = Object.getOwnPropertyDescriptors(item)
        if (Object.getOwnPropertySymbols(item).length) {
          throw new Error("Symbol cache properties")
        }
        const keys = Object.keys(descriptors).filter(
          (key) => !array || key !== "length",
        )
        for (const key of keys) {
          const descriptor = descriptors[key]
          if (!descriptor || !("value" in descriptor) || !descriptor.enumerable) {
            throw new Error("Expected enumerable data property")
          }
        }
        if (array) {
          if (
            keys.length !== item.length
            || keys.some((key, index) => key !== String(index))
          ) {
            throw new Error("Expected dense JSON array")
          }
          return `[${keys.map((key) => encode(descriptors[key]?.value)).join(",")}]`
        }
        return `{${
          keys
            .sort()
            .map((key) => `${string(key)}:${encode(descriptors[key]?.value)}`)
            .join(",")
        }}`
      } finally {
        ancestors.delete(item)
      }
    }
    return encode(value)
  }
}
import { encodeJsonb } from jsonb

export effect function encodeCacheCasValue(value: unknown): string!ElizaError {
  return try Effect.try({
    try: () => encodeJsonb(value),
    catch: (cause) =>
      new ElizaError("Cache compare-and-set requires representable JSON values", {
        code: "CACHE_CAS_INVALID_VALUE",
        cause,
      }),
  })
}
export const encodeCacheCasValueOrThrow = thrown(encodeCacheCasValue)
