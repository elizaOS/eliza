  message?: Memory
  parameters?: ActionParameters | Record<string, unknown>
  accountId?: string
  purpose?: ConnectorAccountPurpose
}

export interface ConnectorAccountPolicyEvaluation {
  allowed: boolean
  reason?: string
  provider?: string
  account?: ConnectorAccount
  policy?: ConnectorAccountPolicy
}

type ActionWithConnectorAccountPolicy = Action & {
  connectorAccountPolicy?:
    | ConnectorAccountPolicy
    | readonly ConnectorAccountPolicy[]
  accountPolicy?: ConnectorAccountPolicy | readonly ConnectorAccountPolicy[]
}

export interface ConnectorAccountManagerState {
  readonly manager: ConnectorAccountManager
  readonly runtime: IAgentRuntime | undefined
  readonly providers: Map<string, ConnectorAccountProvider>
  readonly operations: Semaphore.Semaphore
  explicitStorage: ConnectorAccountStorage | undefined
  database: { readonly adapter: unknown; readonly storage: ConnectorAccountStorage } | undefined
  fallbackStorage: InMemoryConnectorAccountStorage | undefined
  warnedFallback: boolean
}

error MissingAccountId { message: string }
error MissingAccountProvider { message: string }
error InvalidPersistedAccountStatus { message: string }
export error MissingProviderId { message: string }
error OAuthUnsupported { message: string }
error UnknownOAuthFlow { message: string }
error OAuthFlowNotPending { message: string }

const runtimeManagers = new WeakMap<IAgentRuntime, ConnectorAccountManager>()
let standaloneManager: ConnectorAccountManager | null = null
const oauthCodeVerifierSecrets = new Map<
  string,
  { codeVerifier: string; expiresAt?: number }
>()
const oauthCompletionQueues = new Map<string, { readonly lock: Semaphore.Semaphore; waiting: number }>()

function randomId(prefix: string): string {
  return `${prefix}_${randomUuid()}`
}

function looksLikeUuid(value: string): boolean {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    value,
  )
}

function normalizeStringArray<T extends string>(
  value: T | T[] | undefined,
): T[] {
  if (Array.isArray(value)) {
    return value.map((item) => item.trim()).filter(Boolean) as T[]
  }
  if (typeof value === "string" && value.trim()) {
    return [value.trim() as T]
  }
  return []
}

function normalizeConnectorAccountRole(
  role: ConnectorAccountRole | undefined,
): ConnectorAccountRole {
  return normalizedAccountRole(
    typeof role === "string" ? { present: true, text: role.trim().toUpperCase() } : absentText,
  ) as ConnectorAccountRole
}

function cloneMetadata(metadata: Metadata | undefined): Metadata | undefined {
  return metadata ? ({ ...metadata } as Metadata) : undefined
}

function cloneAccount(account: ConnectorAccount): ConnectorAccount {
  return {
    ...account,
    purpose: [...account.purpose],
    metadata: cloneMetadata(account.metadata),
  }
}

function mergeStoredAndProviderAccount(
  stored: ConnectorAccount,
  providerAccount: ConnectorAccount,
  providerOwnsStatus = false,
): ConnectorAccount {
  return {
    ...providerAccount,
    id: stored.id,
    provider: stored.provider,
    accountKey: stored.accountKey ?? providerAccount.accountKey,
    label: stored.label ?? providerAccount.label,
    role: stored.role,
    purpose: [...stored.purpose],
    accessGate: stored.accessGate,
    status: providerOwnsStatus
        && stored.status !== "disabled"
        && stored.status !== "revoked"
      ? providerAccount.status
      : stored.status,
    externalId: stored.externalId ?? providerAccount.externalId,
    displayHandle: stored.displayHandle ?? providerAccount.displayHandle,
    ownerBindingId: stored.ownerBindingId ?? providerAccount.ownerBindingId,
    ownerIdentityId: stored.ownerIdentityId ?? providerAccount.ownerIdentityId,
    createdAt: stored.createdAt,
    updatedAt: Math.max(stored.updatedAt, providerAccount.updatedAt),
    metadata: {
      ...(cloneMetadata(providerAccount.metadata) ?? {}),
      ...(cloneMetadata(stored.metadata) ?? {}),
    },
  }
}

function cloneFlow(flow: ConnectorOAuthFlow): ConnectorOAuthFlow {
  return {
    ...flow,
    metadata: cloneMetadata(flow.metadata),
  }
}

effect function normalizeAccount(
  input: ConnectorAccount | ConnectorAccountPatch,
  provider: string,
  accountId?: string,
): ConnectorAccount!(MissingAccountId | MissingAccountProvider) {
  const now = Date.now()
  const full = input as Partial<ConnectorAccount>
  const id = (full.id ?? accountId ?? "").trim()
  if (!id) {
    throw new MissingAccountId({ message: "Connector account requires an id" })
  }
  const normalizedProvider = normalizeProvider(full.provider ?? provider)
  if (!normalizedProvider) {
    throw new MissingAccountProvider({ message: "Connector account requires a provider" })
  }
  return {
    id,
    provider: normalizedProvider,
    accountKey: typeof full.accountKey === "string" && full.accountKey.trim()
      ? full.accountKey.trim()
      : undefined,
    label: typeof full.label === "string" ? full.label : undefined,
    role: normalizeConnectorAccountRole(full.role),
    purpose: normalizeStringArray(full.purpose),
    accessGate: (full.accessGate ?? "open") as ConnectorAccountAccessGate,
    status: (full.status ?? "connected") as ConnectorAccountStatus,
    externalId: typeof full.externalId === "string" && full.externalId
      ? full.externalId
      : undefined,
    displayHandle: typeof full.displayHandle === "string" && full.displayHandle
      ? full.displayHandle
      : undefined,
    ownerBindingId: typeof full.ownerBindingId === "string" && full.ownerBindingId
      ? full.ownerBindingId
      : undefined,
    ownerIdentityId: typeof full.ownerIdentityId === "string" && full.ownerIdentityId
      ? full.ownerIdentityId
      : undefined,
    createdAt: typeof full.createdAt === "number" ? full.createdAt : now,
    updatedAt: now,
    metadata: cloneMetadata(full.metadata),
  }
}

effect function mergeAccountPatch(
  account: ConnectorAccount,
  patch: ConnectorAccountPatch,
): ConnectorAccount!(MissingAccountId | MissingAccountProvider) {
  return try normalizeAccount(
    {
      ...account,
      ...patch,
      provider: account.provider,
      id: account.id,
      accountKey: patch.accountKey ?? account.accountKey,
      purpose: patch.purpose !== undefined
        ? normalizeStringArray(patch.purpose)
        : account.purpose,
      externalId: patch.externalId === null
        ? undefined
        : (patch.externalId ?? account.externalId),
      displayHandle: patch.displayHandle === null
        ? undefined
        : (patch.displayHandle ?? account.displayHandle),
      ownerBindingId: patch.ownerBindingId === null
        ? undefined
        : (patch.ownerBindingId ?? account.ownerBindingId),
      ownerIdentityId: patch.ownerIdentityId === null
        ? undefined
        : (patch.ownerIdentityId ?? account.ownerIdentityId),
      createdAt: account.createdAt,
      metadata: patch.metadata !== undefined ? patch.metadata : account.metadata,
    },
    account.provider,
    account.id,
  )
}

export function isConnectorAccountStorage(
  value: unknown,
): value is ConnectorAccountStorage {
  if (!value || typeof value !== "object") return false
  const candidate = value as Partial<ConnectorAccountStorage>
  return (
    typeof candidate.listAccounts === "function"
    && typeof candidate.getAccount === "function"
    && typeof candidate.upsertAccount === "function"
    && typeof candidate.deleteAccount === "function"
    && typeof candidate.createOAuthFlow === "function"
    && typeof candidate.getOAuthFlow === "function"
    && typeof candidate.updateOAuthFlow === "function"
    && typeof candidate.deleteOAuthFlow === "function"
  )
}

export class InMemoryConnectorAccountStorage implements ConnectorAccountStorage {
  private accounts = new Map<string, ConnectorAccount>()
  private flows = new Map<string, ConnectorOAuthFlow>()
  private consumedFlows = new Set<string>()
  private ownerBindings = new Map<string, ConnectorOwnerBindingRecord>()

  async listAccounts(provider?: string): Promise<ConnectorAccount[]> {
    const normalized = provider ? normalizeProvider(provider) : undefined
    return Array.from(this.accounts.values())
      .filter((account) => !normalized || account.provider === normalized)
      .map(cloneAccount)
      .sort((a, b) => {
        const aTime = Number.isFinite(a.createdAt) ? a.createdAt : 0
        const bTime = Number.isFinite(b.createdAt) ? b.createdAt : 0
        return (
          a.provider.localeCompare(b.provider)
          || aTime - bTime
          || compareMemoryIds(a.id, b.id)
        )
      })
  }

  async getAccount(
    provider: string,
    accountId: string,
  ): Promise<ConnectorAccount | null> {
    const normalizedProvider = normalizeProvider(provider)
    const account = this.accounts.get(accountKey(normalizedProvider, accountId))
      ?? Array.from(this.accounts.values()).find(
        (candidate) =>
          candidate.provider === normalizedProvider
          && candidate.accountKey === accountId,
      )
    return account ? cloneAccount(account) : null
  }

  async upsertAccount(account: ConnectorAccount): Promise<ConnectorAccount> {
    const normalized = runDetachedSync(asLegacy(Error, normalizeAccount(account, account.provider, account.id)))
    this.accounts.set(
      accountKey(normalized.provider, normalized.id),
      normalized,
    )
    return cloneAccount(normalized)
  }

  async deleteAccount(provider: string, accountId: string): Promise<boolean> {
    const account = await this.getAccount(provider, accountId)
    return account
      ? this.accounts.delete(accountKey(account.provider, account.id))
      : false
  }

  async createOAuthFlow(flow: ConnectorOAuthFlow): Promise<ConnectorOAuthFlow> {
    this.deleteExpiredOAuthFlows(Date.now())
    const cloned = cloneFlow(flow)
    this.flows.set(flowKey(cloned.provider, cloned.id), cloned)
    this.flows.set(flowKey(cloned.provider, cloned.state), cloned)
    return cloneFlow(cloned)
  }

  async getOAuthFlow(
    provider: string,
    flowIdOrState: string,
  ): Promise<ConnectorOAuthFlow | null> {
    const flow = this.flows.get(flowKey(provider, flowIdOrState))
    return flow ? cloneFlow(flow) : null
  }

  async updateOAuthFlow(
    provider: string,
    flowIdOrState: string,
    patch: Partial<ConnectorOAuthFlow>,
  ): Promise<ConnectorOAuthFlow | null> {
    const existing = this.flows.get(flowKey(provider, flowIdOrState))
    if (!existing) return null
    const next: ConnectorOAuthFlow = {
      ...existing,
      ...patch,
      provider: existing.provider,
      id: existing.id,
      state: existing.state,
      updatedAt: Date.now(),
      metadata: patch.metadata !== undefined
        ? cloneMetadata(patch.metadata)
        : cloneMetadata(existing.metadata),
    }
    if (next.status !== "pending") delete next.codeVerifier
    this.flows.set(flowKey(next.provider, next.id), next)
    this.flows.set(flowKey(next.provider, next.state), next)
    return cloneFlow(next)
  }

  async consumeOAuthFlow(
    provider: string,
    state: string,
    _consumedBy?: string,
  ): Promise<ConnectorOAuthFlow | null> {
    const key = flowKey(provider, state)
    if (this.consumedFlows.has(key)) return null
    const flow = this.flows.get(key)
    if (flow?.status !== "pending") return null
    if (flow.expiresAt && flow.expiresAt <= Date.now()) return null
    this.consumedFlows.add(flowKey(flow.provider, flow.id))
    this.consumedFlows.add(flowKey(flow.provider, flow.state))
    return cloneFlow(flow)
  }

  async deleteOAuthFlow(
    provider: string,
    flowIdOrState: string,
  ): Promise<boolean> {
    const existing = this.flows.get(flowKey(provider, flowIdOrState))
    if (!existing) return false
    this.flows.delete(flowKey(existing.provider, existing.id))
    this.flows.delete(flowKey(existing.provider, existing.state))
    this.consumedFlows.delete(flowKey(existing.provider, existing.id))
    this.consumedFlows.delete(flowKey(existing.provider, existing.state))
    return true
  }

  async findOwnerBinding(
    lookup: ConnectorOwnerBindingLookup,
  ): Promise<ConnectorOwnerBindingRecord | null> {
    const normalized = ownerBindingKey(
      lookup.connector,
      lookup.externalId,
      lookup.instanceId,
    )
    const binding = this.ownerBindings.get(normalized)
    return binding ? { ...binding } : null
  }

  deleteExpiredOAuthFlows(now: number): void {
    for (const [key, flow] of this.flows) {
      if (!flow.expiresAt || flow.expiresAt > now) continue
      if (this.consumedFlows.has(flowKey(flow.provider, flow.id))) continue
      this.flows.delete(key)
    }
  }

  hasStateForMigration(): boolean {
    return this.accounts.size > 0 || this.flows.size > 0
  }

  snapshotForMigration(): {
    accounts: ConnectorAccount[]
    flows: ConnectorOAuthFlow[]
    consumedPendingFlows: ConnectorOAuthFlow[]
  } {
    const accounts = Array.from(this.accounts.values()).map(cloneAccount)
    const flows: ConnectorOAuthFlow[] = []
    const consumedPendingFlows: ConnectorOAuthFlow[] = []
    const seen = new Set<string>()
    for (const flow of this.flows.values()) {
      const key = flowKey(flow.provider, flow.id)
      if (seen.has(key)) continue
      seen.add(key)
      if (flow.status !== "pending") continue
      if (flow.expiresAt && flow.expiresAt <= Date.now()) continue
      if (this.consumedFlows.has(key)) {
        consumedPendingFlows.push(cloneFlow(flow))
      } else {
        flows.push(cloneFlow(flow))
      }
    }
    return { accounts, flows, consumedPendingFlows }
  }

  clearAfterMigration(): void {
    this.accounts.clear()
    this.flows.clear()
    this.consumedFlows.clear()
  }

  upsertOwnerBindingForTest(binding: ConnectorOwnerBindingRecord): void {
    this.ownerBindings.set(
      ownerBindingKey(
        binding.connector,
        binding.externalId,
        binding.instanceId,
      ),
      { ...binding },
    )
  }
}

class DatabaseConnectorAccountStorage implements ConnectorAccountStorage {
  readonly oauthFallback = new InMemoryConnectorAccountStorage()

  constructor(readonly adapter: ConnectorAccountDatabaseAdapter) {}

  listAccounts(provider?: string): Promise<ConnectorAccount[]> {
    return runDetached(listDatabaseAccounts(this, provider))
  }

  getAccount(provider: string, accountId: string): Promise<ConnectorAccount | null> {
    return runDetached(getDatabaseAccount(this, provider, accountId))
  }

  upsertAccount(account: ConnectorAccount): Promise<ConnectorAccount> {
    return runDetached(upsertDatabaseAccount(this, account))
  }

  deleteAccount(provider: string, accountId: string): Promise<boolean> {
    return runDetached(deleteDatabaseAccount(this, provider, accountId))
  }

  findOwnerBinding(lookup: ConnectorOwnerBindingLookup): Promise<ConnectorOwnerBindingRecord | null> {
    return runDetached(findDatabaseOwnerBinding(this, lookup))
  }

  createOAuthFlow(flow: ConnectorOAuthFlow): Promise<ConnectorOAuthFlow> {
    return runDetached(createDatabaseOAuthFlow(this, flow))
  }

  getOAuthFlow(provider: string, flowIdOrState: string): Promise<ConnectorOAuthFlow | null> {
    return runDetached(getDatabaseOAuthFlow(this, provider, flowIdOrState))
  }

  updateOAuthFlow(
    provider: string,
    flowIdOrState: string,
    patch: Partial<ConnectorOAuthFlow>,
  ): Promise<ConnectorOAuthFlow | null> {
    return runDetached(updateDatabaseOAuthFlow(this, provider, flowIdOrState, patch))
  }

  consumeOAuthFlow(provider: string, state: string, consumedBy?: string): Promise<ConnectorOAuthFlow | null> {
    return runDetached(consumeDatabaseOAuthFlow(this, provider, state, consumedBy))
  }

  deleteOAuthFlow(provider: string, flowIdOrState: string): Promise<boolean> {
    return runDetached(deleteDatabaseOAuthFlow(this, provider, flowIdOrState))
  }
}

effect function listDatabaseAccounts(storage: DatabaseConnectorAccountStorage, provider?: string) {
  const records = try foreign(() =>
    storage.adapter.listConnectorAccounts({
      provider: provider ? normalizeProvider(provider) : undefined,
    })
  )
  return try Effect.forEach(records, databaseRecordToAccount)
}

effect function getDatabaseAccount(storage: DatabaseConnectorAccountStorage, provider: string, accountId: string) {
  if (looksLikeUuid(accountId)) {
    const byId = try foreign(() => storage.adapter.getConnectorAccount({ id: accountId }))
    if (byId && normalizeProvider(byId.provider) === normalizeProvider(provider)) {
      return try databaseRecordToAccount(byId)
    }
  }
  const byKey = try foreign(() =>
    storage.adapter.getConnectorAccount({
      provider: normalizeProvider(provider),
      accountKey: accountId,
    })
  )
  return byKey ? (try databaseRecordToAccount(byKey)) : null
}

effect function upsertDatabaseAccount(storage: DatabaseConnectorAccountStorage, account: ConnectorAccount) {
  const record = try foreign(() =>
    storage.adapter.upsertConnectorAccount({
      ...(looksLikeUuid(account.id) ? { id: account.id } : {}),
      provider: normalizeProvider(account.provider),
      accountKey: account.accountKey ?? account.externalId ?? account.id,
      externalId: account.externalId ?? null,
      displayName: account.label ?? null,
      username: account.displayHandle ?? null,
      ownerBindingId: account.ownerBindingId ?? null,
      ownerIdentityId: account.ownerIdentityId ?? null,
      role: account.role,
      purpose: [...account.purpose],
      accessGate: account.accessGate,
      status: account.status,
      metadata: cloneMetadata(account.metadata),
      connectedAt: account.createdAt,
    })
  )
  return try databaseRecordToAccount(record)
}

effect function deleteDatabaseAccount(storage: DatabaseConnectorAccountStorage, provider: string, accountId: string) {
  const account = try getDatabaseAccount(storage, provider, accountId)
  return try foreign(() =>
    storage.adapter.deleteConnectorAccount(
      account
        ? { id: account.id }
        : { provider: normalizeProvider(provider), accountKey: accountId },
    )
  )
}

effect function findDatabaseOwnerBinding(storage: DatabaseConnectorAccountStorage, lookup: ConnectorOwnerBindingLookup) {
  const adapter = storage.adapter
  const find = supportedMethod(adapter, "findConnectorOwnerBinding")
  if (typeof find !== "function") return null
  return try foreign(() =>
    find.call(adapter, {
      connector: normalizeProvider(lookup.connector),
      externalId: lookup.externalId,
      instanceId: lookup.instanceId,
    })
  )
}

function persistsOAuthFlows(adapter: ConnectorAccountDatabaseAdapter): boolean {
  return (
    supportedMethod(adapter, "getOAuthFlowState") !== undefined
    && supportedMethod(adapter, "updateOAuthFlowState") !== undefined
  )
}

effect function createDatabaseOAuthFlow(storage: DatabaseConnectorAccountStorage, flow: ConnectorOAuthFlow) {
  const { adapter, oauthFallback } = storage
  try foreign(() => oauthFallback.createOAuthFlow(flow))
  const createState = supportedMethod(adapter, "createOAuthFlowState")
  if (typeof createState !== "function") {
    return cloneFlow(flow)
  }
  const record = try foreign(() =>
    createState.call(adapter, {
      state: flow.state,
      provider: normalizeProvider(flow.provider),
      accountId: flow.accountId && looksLikeUuid(flow.accountId) ? flow.accountId : null,
      redirectUri: flow.redirectUri ?? null,
      codeVerifierRef: stringMetadataValue(flow.metadata, "codeVerifierRef"),
      metadata: oauthFlowMetadata(flow),
      expiresAt: flow.expiresAt,
    })
  )
  if (record.expiresAt !== flow.expiresAt) {
    try foreign(() => oauthFallback.updateOAuthFlow(flow.provider, flow.id, { expiresAt: record.expiresAt }))
  }
  return databaseRecordToOAuthFlow(record, flow.state, flow)
}

effect function getDatabaseOAuthFlow(storage: DatabaseConnectorAccountStorage, provider: string, flowIdOrState: string) {
  const { adapter, oauthFallback } = storage
  const normalizedProvider = normalizeProvider(provider)
  const fallback = try foreign(() => oauthFallback.getOAuthFlow(normalizedProvider, flowIdOrState))
  const getState = supportedMethod(adapter, "getOAuthFlowState")
  if (typeof getState !== "function") {
    return fallback
  }
  const byFlowId = try foreign(() =>
    getState.call(adapter, {
      provider: normalizedProvider,
      flowId: flowIdOrState,
      includeConsumed: true,
      includeExpired: true,
    })
  )
  const record = byFlowId
    ?? (try foreign(() =>
      getState.call(adapter, {
        provider: normalizedProvider,
        state: flowIdOrState,
        includeConsumed: true,
        includeExpired: true,
      })
    ))
  return record
    ? databaseRecordToOAuthFlow(record, flowIdOrState, fallback ?? undefined)
    : fallback
}

effect function updateDatabaseOAuthFlow(
  storage: DatabaseConnectorAccountStorage,
  provider: string,
  flowIdOrState: string,
  patch: Partial<ConnectorOAuthFlow>,
) {
  const { adapter, oauthFallback } = storage
  const normalizedProvider = normalizeProvider(provider)
  const fallback = try foreign(() => oauthFallback.updateOAuthFlow(normalizedProvider, flowIdOrState, patch))
  const updateState = supportedMethod(adapter, "updateOAuthFlowState")
  if (typeof updateState !== "function") {
    return fallback
  }
  const metadata = oauthFlowPatchMetadata(patch)
  const metadataCodeVerifierRef = stringMetadataValue(patch.metadata, "codeVerifierRef")
  const storedCodeVerifierRef = storeOAuthCodeVerifier(
    normalizedProvider,
    fallback?.id ?? flowIdOrState,
    patch.codeVerifier,
    patch.expiresAt ?? fallback?.expiresAt,
  )
  const codeVerifierRef = storedCodeVerifierRef ?? metadataCodeVerifierRef
  if (codeVerifierRef) {
    metadata.codeVerifierRef = codeVerifierRef
  }
  const update = {
    provider: normalizedProvider,
    ...(patch.accountId !== undefined
        && patch.accountId
        && looksLikeUuid(patch.accountId)
      ? { accountId: patch.accountId }
      : {}),
    ...(patch.redirectUri !== undefined
      ? { redirectUri: patch.redirectUri }
      : {}),
    ...(codeVerifierRef !== undefined
      ? {
        codeVerifierRef,
      }
      : {}),
    ...(patch.expiresAt !== undefined ? { expiresAt: patch.expiresAt } : {}),
    metadata,
  }
  const record = (try foreign(() => updateState.call(adapter, { ...update, flowId: flowIdOrState })))
    ?? (try foreign(() => updateState.call(adapter, { ...update, state: flowIdOrState })))
  const flow = record
    ? databaseRecordToOAuthFlow(record, flowIdOrState, fallback ?? undefined)
    : fallback
  if (flow && flow.status !== "pending" && persistsOAuthFlows(adapter)) {
    if (record) {
      try foreign(() => oauthFallback.deleteOAuthFlow(normalizedProvider, flow.id))
    }
    deleteOAuthCodeVerifier(stringMetadataValue(flow.metadata, "codeVerifierRef"))
  } else if (record?.expiresAt !== undefined) {
    const expiresAt = record.expiresAt
    if (fallback && fallback.expiresAt !== expiresAt) {
      try foreign(() => oauthFallback.updateOAuthFlow(normalizedProvider, fallback.id, { expiresAt }))
    }
    setOAuthCodeVerifierExpiry(storedCodeVerifierRef, expiresAt)
  }
  return flow
}

effect function consumeDatabaseOAuthFlow(
  storage: DatabaseConnectorAccountStorage,
  provider: string,
  state: string,
  consumedBy?: string,
) {
  const { adapter, oauthFallback } = storage
  const normalizedProvider = normalizeProvider(provider)
  const consumeState = supportedMethod(adapter, "consumeOAuthFlowState")
  if (typeof consumeState !== "function") {
    return try foreign(() => oauthFallback.consumeOAuthFlow(normalizedProvider, state, consumedBy))
  }
  const fallback = try foreign(() => oauthFallback.getOAuthFlow(normalizedProvider, state))
  const record = try foreign(() =>
    consumeState.call(adapter, {
      provider: normalizedProvider,
      state,
      consumedBy: consumedBy ?? null,
    })
  )
  return record
    ? databaseRecordToOAuthFlow(record, state, fallback ?? undefined)
    : null
}

effect function deleteDatabaseOAuthFlow(storage: DatabaseConnectorAccountStorage, provider: string, flowIdOrState: string) {
  const { adapter, oauthFallback } = storage
  const normalizedProvider = normalizeProvider(provider)
  const fallbackDeleted = try foreign(() => oauthFallback.deleteOAuthFlow(normalizedProvider, flowIdOrState))
  const deleteState = supportedMethod(adapter, "deleteOAuthFlowState")
  if (typeof deleteState !== "function") {
    return fallbackDeleted
  }
  const dbDeleted = (try foreign(() => deleteState.call(adapter, { provider: normalizedProvider, flowId: flowIdOrState })))
    || (try foreign(() => deleteState.call(adapter, { provider: normalizedProvider, state: flowIdOrState })))
  return fallbackDeleted || dbDeleted
}

function isConnectorAccountDatabaseAdapter(
  value: unknown,
): value is ConnectorAccountDatabaseAdapter {
  if (!value || typeof value !== "object") return false
  const candidate = value as Partial<ConnectorAccountDatabaseAdapter>
  return (
    supportedMethod(candidate, "listConnectorAccounts") !== undefined
    && supportedMethod(candidate, "getConnectorAccount") !== undefined
    && supportedMethod(candidate, "upsertConnectorAccount") !== undefined
    && supportedMethod(candidate, "deleteConnectorAccount") !== undefined
  )
}

function supportedMethod<K extends keyof ConnectorAccountDatabaseAdapter>(
  adapter: Partial<ConnectorAccountDatabaseAdapter>,
  name: K,
): ConnectorAccountDatabaseAdapter[K] | undefined {
  const method = adapter[name]
  return typeof method === "function" && method !== Reflect.get(DatabaseAdapter.prototype, name)
    ? method
    : undefined
}

function stringMetadataValue(
  metadata: Metadata | Record<string, unknown> | undefined,
  key: string,
): string | undefined {
  const value = metadata?.[key]
  return typeof value === "string" && value.trim() ? value : undefined
}

function oauthCodeVerifierRef(provider: string, flowId: string): string {
  return `connector-oauth-pkce:${normalizeProvider(provider)}:${flowId}`
}

function storeOAuthCodeVerifier(
  provider: string,
  flowId: string,
  codeVerifier: string | undefined,
  expiresAt: number | undefined,
): string | undefined {
  if (typeof codeVerifier !== "string" || !codeVerifier.trim()) {
    return undefined
  }

  const now = Date.now()
  for (const [ref, secret] of oauthCodeVerifierSecrets) {
    if (secret.expiresAt && secret.expiresAt <= now) {
      oauthCodeVerifierSecrets.delete(ref)
    }
  }
  const ref = oauthCodeVerifierRef(provider, flowId)
  oauthCodeVerifierSecrets.set(ref, { codeVerifier, expiresAt })
  return ref
}

function readOAuthCodeVerifier(
  ref: string | null | undefined,
): string | undefined {
  if (!ref) return undefined
  return oauthCodeVerifierSecrets.get(ref)?.codeVerifier
}

function setOAuthCodeVerifierExpiry(
  ref: string | undefined,
  expiresAt: number,
): void {
  const secret = ref ? oauthCodeVerifierSecrets.get(ref) : undefined
  if (secret) secret.expiresAt = expiresAt
}

function deleteOAuthCodeVerifier(ref: string | null | undefined): void {
  if (!ref) return
  oauthCodeVerifierSecrets.delete(ref)
}

function safeOAuthMetadata(
  metadata: Metadata | Record<string, unknown> | undefined,
): Metadata {
  const cleaned: Record<string, unknown> = {}
  for (const [key, value] of Object.entries(metadata ?? {})) {
    if (
      key === "codeVerifier"
      || key === "code_verifier"
      || key === "oauthCodeVerifier"
    ) {
      continue
    }
    cleaned[key] = value
  }
  return cleaned as Metadata
}

function oauthFlowMetadata(flow: ConnectorOAuthFlow): Record<string, unknown> {
  const metadata: Record<string, unknown> = {
    ...safeOAuthMetadata(flow.metadata),
    flowId: flow.id,
    status: flow.status,
    updatedAt: flow.updatedAt,
  }
  if (flow.authUrl) metadata.authUrl = flow.authUrl
  if (flow.error) metadata.error = flow.error
  if (flow.codeVerifier) {
    metadata.hasCodeVerifier = true
  }
  return metadata
}

function oauthFlowPatchMetadata(
  patch: Partial<ConnectorOAuthFlow>,
): Record<string, unknown> {
  const metadata: Record<string, unknown> = {
    ...safeOAuthMetadata(patch.metadata),
    updatedAt: Date.now(),
  }
  if (patch.id) metadata.flowId = patch.id
  if (patch.status) metadata.status = patch.status
  if (patch.authUrl !== undefined) metadata.authUrl = patch.authUrl
  if (patch.error !== undefined) metadata.error = patch.error
  if (patch.codeVerifier) {
    metadata.hasCodeVerifier = true
  }
  return metadata
}

const isConnectorAccountStatus = Schema.is(ConnectorAccountStatus)

effect function databaseRecordToAccount(
  record: ConnectorAccountDatabaseRecord,
): ConnectorAccount!InvalidPersistedAccountStatus {
  const now = Date.now()
  const status = record.status === "active"
    ? "connected"
    : (record.status ?? "connected")
  if (!isConnectorAccountStatus(status)) {
    throw new InvalidPersistedAccountStatus({ message: "The stored connector account has an unknown status" })
  }
  return {
    id: record.id,
    provider: normalizeProvider(record.provider),
    accountKey: record.accountKey,
    label: record.displayName
      ?? record.email
      ?? record.username
      ?? record.externalId
      ?? record.accountKey,
    role: normalizeConnectorAccountRole(record.role as ConnectorAccountRole),
    purpose: normalizeStringArray(
      (record.purpose ?? ["messaging"]) as ConnectorAccountPurpose[],
    ),
    accessGate: (record.accessGate ?? "open") as ConnectorAccountAccessGate,
    status,
    externalId: record.externalId ?? undefined,
    displayHandle: record.username ?? record.email ?? undefined,
    ownerBindingId: record.ownerBindingId ?? undefined,
    ownerIdentityId: record.ownerIdentityId ?? undefined,
    createdAt: record.createdAt ?? now,
    updatedAt: record.updatedAt ?? now,
    metadata: cloneMetadata(record.metadata),
  }
}

function databaseRecordToOAuthFlow(
  record: ConnectorOAuthDatabaseRecord,
  lookupValue?: string,
  fallback?: ConnectorOAuthFlow,
): ConnectorOAuthFlow {
  const now = Date.now()
  const metadata = (record.metadata ?? {}) as Metadata
  const flowId = stringMetadataValue(metadata, "flowId")
    ?? fallback?.id
    ?? (lookupValue?.startsWith("oauth_")
      ? lookupValue
      : `oauth_${record.stateHash.slice(0, 16)}`)
  const state = fallback?.state
    ?? (lookupValue && !lookupValue.startsWith("oauth_")
      ? lookupValue
      : record.stateHash)
  const statusValue = stringMetadataValue(metadata, "status")
    ?? fallback?.status
    ?? (record.consumedAt ? "completed" : "pending")
  const codeVerifierRef = record.codeVerifierRef
    ?? stringMetadataValue(metadata, "codeVerifierRef")
    ?? stringMetadataValue(metadata, "code_verifier_ref")
  const metadataForFlow = safeOAuthMetadata(metadata)
  if (codeVerifierRef) {
    metadataForFlow.codeVerifierRef = codeVerifierRef
  }
  return {
    id: flowId,
    provider: normalizeProvider(record.provider),
    state,
    status: statusValue as ConnectorOAuthFlowStatus,
    accountId: record.accountId ?? fallback?.accountId,
    authUrl: stringMetadataValue(metadata, "authUrl") ?? fallback?.authUrl,
    error: stringMetadataValue(metadata, "error") ?? fallback?.error,
    redirectUri: record.redirectUri ?? fallback?.redirectUri,
    codeVerifier: fallback?.codeVerifier ?? readOAuthCodeVerifier(codeVerifierRef),
    createdAt: record.createdAt ?? fallback?.createdAt ?? now,
    updatedAt: typeof metadata.updatedAt === "number"
      ? metadata.updatedAt
      : (fallback?.updatedAt ?? record.createdAt ?? now),
    expiresAt: record.expiresAt ?? fallback?.expiresAt,
    metadata: cloneMetadata(metadataForFlow),
  }
}

function accountKey(provider: string, accountId: string): string {
  return `${normalizeProvider(provider)}:${accountId}`
}

function flowKey(provider: string, flowIdOrState: string): string {
  return `${normalizeProvider(provider)}:${flowIdOrState}`
}

function ownerBindingKey(
  connector: string,
  externalId: string,
  instanceId?: string,
): string {
  return `${normalizeProvider(connector)}:${externalId}:${instanceId ?? ""}`
}

effect function resolveBackend(state: ConnectorAccountManagerState) {
  if (state.explicitStorage) {
    return state.explicitStorage
  }
  const runtime = state.runtime
  if (runtime && typeof runtime.getService === "function") {
    const service = try foreignSync(() => runtime.getService(CONNECTOR_ACCOUNT_STORAGE_SERVICE_TYPE))
    if (isConnectorAccountStorage(service)) {
      return service
    }
    const adapter = (runtime as { adapter?: unknown }).adapter
    if (isConnectorAccountDatabaseAdapter(adapter)) {
      const database = state.database?.adapter === adapter
        ? state.database
        : { adapter, storage: new DatabaseConnectorAccountStorage(adapter) }
      state.database = database
      return database.storage
    }
    if (!state.warnedFallback) {
      state.warnedFallback = true
      logger.warn(
        "[ConnectorAccountManager] no durable connector-account storage available yet; using in-memory fallback until a database adapter registers",
      )
    }
  }
  state.fallbackStorage ??= new InMemoryConnectorAccountStorage()
  return state.fallbackStorage
}

effect function migrateFallbackState(fallback: InMemoryConnectorAccountStorage, target: ConnectorAccountStorage) {
  const { accounts, flows, consumedPendingFlows } = fallback.snapshotForMigration()
  for (const account of accounts) {
    try foreign(() => target.upsertAccount(account))
  }
  for (const flow of flows) {
    try foreign(() => target.createOAuthFlow(flow))
  }
  for (const flow of consumedPendingFlows) {
    try foreign(() => target.createOAuthFlow(flow))
    try foreign(() => target.consumeOAuthFlow(flow.provider, flow.state, "fallback-migration"))
  }
  fallback.clearAfterMigration()
  logger.info(
    `[ConnectorAccountManager] migrated ${accounts.length} connector account(s), ${flows.length} pending OAuth flow(s), and ${consumedPendingFlows.length} in-flight consumed OAuth flow(s) from the boot-time in-memory fallback to durable storage`,
  )
}

effect function onBackend<A>(
  state: ConnectorAccountManagerState,
  call: (backend: ConnectorAccountStorage) => A | PromiseLike<A>,
): A!Foreign {
  try yieldNow
  return try state.operations.withPermits(1)(effect {
    const backend = try resolveBackend(state)
    const fallback = state.fallbackStorage
    if (fallback && backend !== fallback && fallback.hasStateForMigration()) {
      try migrateFallbackState(fallback, backend)
    }
    return try foreign(() => call(backend))
  })
}

export function connectorAccountStorageFacade(state: ConnectorAccountManagerState): ConnectorAccountStorage {
  return {
    listAccounts: (provider) => runDetached(onBackend(state, (b) => b.listAccounts(provider))),
    getAccount: (provider, accountId) => runDetached(onBackend(state, (b) => b.getAccount(provider, accountId))),
    upsertAccount: (account) => runDetached(onBackend(state, (b) => b.upsertAccount(account))),
    deleteAccount: (provider, accountId) => runDetached(onBackend(state, (b) => b.deleteAccount(provider, accountId))),
    createOAuthFlow: (flow) => runDetached(onBackend(state, (b) => b.createOAuthFlow(flow))),
    getOAuthFlow: (provider, flowIdOrState) => runDetached(onBackend(state, (b) => b.getOAuthFlow(provider, flowIdOrState))),
    updateOAuthFlow: (provider, flowIdOrState, patch) =>
      runDetached(onBackend(state, (b) => b.updateOAuthFlow(provider, flowIdOrState, patch))),
    consumeOAuthFlow: (provider, flowState, consumedBy) =>
      runDetached(onBackend(state, (b) => b.consumeOAuthFlow(provider, flowState, consumedBy))),
    deleteOAuthFlow: (provider, flowIdOrState) =>
      runDetached(onBackend(state, (b) => b.deleteOAuthFlow(provider, flowIdOrState))),
    findOwnerBinding: (lookup) => runDetached(findOwnerBinding(state, lookup)),
  }
}

effect function findOwnerBinding(state: ConnectorAccountManagerState, lookup: ConnectorOwnerBindingLookup) {
  return try onBackend(state, (b) => typeof b.findOwnerBinding === "function" ? b.findOwnerBinding(lookup) : null)
}

effect function registerConnectorOnce(
  source: string,
  registered: () => ReadonlyArray<{ source: string }>,
  register: () => void,
) {
  const exists = (try foreignSync(registered)).some((connector) => connector.source === source)
  if (!exists) {
    try foreignSync(register)
  }
  return exists
}

export effect function registerManagedProvider(
  state: ConnectorAccountManagerState,
  provider: ConnectorAccountProvider,
): ConnectorAccountProviderRegistrationResult!(MissingProviderId | Foreign) {
  const providerId = normalizeProvider(provider.provider)
  if (!providerId) {
    throw new MissingProviderId({ message: "Connector account provider requires a provider id" })
  }
  const normalized: ConnectorAccountProvider = {
    ...provider,
    provider: providerId,
  }
  state.providers.set(providerId, normalized)

  let messageConnectorRegistered = false
  let messageConnectorSkipped = false
  let postConnectorRegistered = false
  let postConnectorSkipped = false
  const runtime = state.runtime
  const messageConnector = normalized.messageConnector
  const postConnector = normalized.postConnector

  if (runtime && messageConnector) {
    messageConnectorSkipped = try registerConnectorOnce(
      messageConnector.source.trim(),
      () => runtime.getMessageConnectors(),
      () => runtime.registerMessageConnector(messageConnector),
    )
    messageConnectorRegistered = !messageConnectorSkipped
  }

  if (runtime && postConnector) {
    postConnectorSkipped = try registerConnectorOnce(
      postConnector.source.trim(),
      () => runtime.getPostConnectors(),
      () => runtime.registerPostConnector(postConnector),
    )
    postConnectorRegistered = !postConnectorSkipped
  }

  return {
    provider: providerId,
    messageConnectorRegistered,
    messageConnectorSkipped,
    postConnectorRegistered,
    postConnectorSkipped,
  }
}

effect function liveProviderAccounts(
  state: ConnectorAccountManagerState,
  registered: ConnectorAccountProvider,
  list: NonNullable<ConnectorAccountProvider["listAccounts"]>,
) {
  return (try foreign(() => list.call(registered, state.manager))).map(cloneAccount)
}

effect function reconcileProviderInventory(
  providerId: string,
  storedAccounts: readonly ConnectorAccount[],
  providerAccounts: readonly ConnectorAccount[],
) {
  const consumed = new Set<ConnectorAccount>()
  const reconciled: ConnectorAccount[] = []
  for (const stored of storedAccounts) {
    const matches = providerAccounts.filter(
      (account) =>
        account.id === stored.id
        || (stored.accountKey !== undefined
          && (account.id === stored.accountKey
            || account.accountKey === stored.accountKey)),
    )
    const current = matches[0]
    if (matches.length > 1 || (current && consumed.has(current))) {
      throw new ElizaError(
        "Connector inventory contains ambiguous account identities",
        {
          code: "CONNECTOR_ACCOUNT_AMBIGUOUS",
          context: { provider: providerId, accountId: stored.id },
        },
      )
    }
    if (!current) {
      reconciled.push({
        ...stored,
        status: stored.status === "disabled" || stored.status === "revoked"
          ? stored.status
          : "pending",
      })
      continue
    }
    consumed.add(current)
    reconciled.push(mergeStoredAndProviderAccount(stored, current, true))
  }
  return [
    ...reconciled,
    ...providerAccounts.filter((account) => !consumed.has(account)),
  ]
}

export effect function listManagedAccounts(state: ConnectorAccountManagerState, provider: string) {
  const providerId = normalizeProvider(provider)
  const registered = state.providers.get(providerId)
  const storedAccounts = try onBackend(state, (b) => b.listAccounts(providerId))
  const list = registered?.listAccounts
  if (!registered || !list) {
    return storedAccounts
  }
  const providerAccounts = try liveProviderAccounts(state, registered, list)
  if (registered.statusAuthority === "provider") {
    return try reconcileProviderInventory(providerId, storedAccounts, providerAccounts)
  }
  const merged = new Map<string, ConnectorAccount>()
  for (const account of storedAccounts) {
    merged.set(account.id, account)
  }
  for (const account of providerAccounts) {
    const stored = merged.get(account.id)
    merged.set(
      account.id,
      stored ? mergeStoredAndProviderAccount(stored, account) : account,
    )
  }
  return Array.from(merged.values())
}

export effect function getManagedAccount(state: ConnectorAccountManagerState, provider: string, accountId: string) {
  const providerId = normalizeProvider(provider)
  const stored = try onBackend(state, (b) => b.getAccount(providerId, accountId))
  const registered = state.providers.get(providerId)
  if (stored) {
    if (registered?.statusAuthority !== "provider") return stored
    const accounts = try listManagedAccounts(state, providerId)
    return accounts.find((account) => account.id === stored.id) ?? null
  }
  const list = registered?.listAccounts
  if (!registered || !list) return null
  const providerAccounts = try liveProviderAccounts(state, registered, list)
  const exactAccount = providerAccounts.find(
    (account) => account.id === accountId || account.accountKey === accountId,
  )
  if (exactAccount) return exactAccount
  const aliases = providerAccounts.filter(
    (account) => account.externalId === accountId || account.displayHandle === accountId,
  )
  return aliases.length === 1 ? aliases[0] : null
}

effect function ownerBindingFor(state: ConnectorAccountManagerState, account: ConnectorAccount) {
  const externalId = account.externalId
  if (!externalId) {
    return null
  }
  const instanceId = typeof account.metadata?.instanceId === "string"
    ? account.metadata.instanceId
    : undefined
  return try findOwnerBinding(state, { connector: account.provider, externalId, instanceId })
}

export effect function upsertManagedAccount(
  state: ConnectorAccountManagerState,
  provider: string,
  input: ConnectorAccount | ConnectorAccountPatch,
  accountId?: string,
) {
  const normalized = try normalizeAccount(input, provider, accountId)
  const ownerBinding = try ownerBindingFor(state, normalized)
  const account = ownerBinding
    ? {
      ...normalized,
      ownerBindingId: normalized.ownerBindingId ?? ownerBinding.id,
      ownerIdentityId: normalized.ownerIdentityId ?? ownerBinding.identityId,
      displayHandle: normalized.displayHandle ?? ownerBinding.displayHandle,
    }
    : normalized
  return try onBackend(state, (b) => b.upsertAccount(account))
}

export effect function createManagedAccount(
  state: ConnectorAccountManagerState,
  provider: string,
  input: ConnectorAccountPatch,
) {
  const providerId = normalizeProvider(provider)
  const registered = state.providers.get(providerId)
  const requestedId = (input as Partial<ConnectorAccount>).id
  const accountId = typeof requestedId === "string" && requestedId.trim()
    ? requestedId
    : randomId(`acct_${providerId}`)
  const create = registered?.createAccount
  if (create) {
    const created = try foreign(() => create.call(registered, input, state.manager))
    return try upsertManagedAccount(state, providerId, created, accountId)
  }
  return try upsertManagedAccount(state, providerId, input, accountId)
}

export effect function patchManagedAccount(
  state: ConnectorAccountManagerState,
  provider: string,
  accountId: string,
  patch: ConnectorAccountPatch,
) {
  const providerId = normalizeProvider(provider)
  const registered = state.providers.get(providerId)
  const patchProvider = registered?.patchAccount
  if (patchProvider) {
    const existing = try onBackend(state, (b) => b.getAccount(providerId, accountId))
    const patched = try foreign(() => patchProvider.call(registered, accountId, patch, state.manager))
    const merged = existing ? try mergeAccountPatch(existing, patched) : patched
    return try upsertManagedAccount(state, providerId, merged, accountId)
  }
  const existing = try onBackend(state, (b) => b.getAccount(providerId, accountId))
  if (!existing) return null
  return try upsertManagedAccount(state, providerId, try mergeAccountPatch(existing, patch))
}

export effect function deleteManagedAccount(state: ConnectorAccountManagerState, provider: string, accountId: string) {
  const providerId = normalizeProvider(provider)
  const registered = state.providers.get(providerId)
  const remove = registered?.deleteAccount
  if (remove) {
    try foreign(() => remove.call(registered, accountId, state.manager))
  }
  return try onBackend(state, (b) => b.deleteAccount(providerId, accountId))
}

effect function markFlowFailed(state: ConnectorAccountManagerState, providerId: string, flowId: string, error: string) {
  return try onBackend(state, (b) => b.updateOAuthFlow(providerId, flowId, { status: "failed", error }))
}

export effect function startManagedOAuth(
  state: ConnectorAccountManagerState,
  provider: string,
  input: {
    redirectUri?: string
    accountId?: string
    label?: string
    scopes?: string[]
    servedOrigin?: string
    metadata?: Metadata
  },
) {
  const providerId = normalizeProvider(provider)
  const registered = state.providers.get(providerId)
  const start = registered?.startOAuth
  if (!start) {
    throw new OAuthUnsupported({ message: `OAuth not supported for connector provider: ${providerId}` })
  }

  const now = Date.now()
  const flow: ConnectorOAuthFlow = {
    id: randomId("oauth"),
    provider: providerId,
    state: randomId("state"),
    status: "pending",
    accountId: input.accountId,
    redirectUri: input.redirectUri,
    createdAt: now,
    updatedAt: now,
    metadata: cloneMetadata(input.metadata),
  }
  try onBackend(state, (b) => b.createOAuthFlow(flow))

  const request: ConnectorOAuthStartRequest = {
    provider: providerId,
    flow,
    redirectUri: input.redirectUri,
    accountId: input.accountId,
    label: input.label,
    scopes: input.scopes,
    servedOrigin: input.servedOrigin,
    metadata: input.metadata,
  }
  const result = foreign(() => start.call(registered, request, state.manager)) catch effect (failure) => {
    const cause = thrownValue(failure)
    markFlowFailed(state, providerId, flow.id, errorText(cause)) catch effect (persistenceError) => {
      throw new Foreign({
        cause: new AggregateError(
          [cause, thrownValue(persistenceError)],
          `OAuth start and failure-state persistence failed for ${providerId}`,
        ),
      })
    }
    throw failure
  }
  const patch: Partial<ConnectorOAuthFlow> = {
    authUrl: result.authUrl,
    redirectUri: result.redirectUri ?? flow.redirectUri,
    expiresAt: result.expiresAt,
    codeVerifier: result.codeVerifier,
    metadata: result.metadata ?? flow.metadata,
  }
  const updated = try onBackend(state, (b) => b.updateOAuthFlow(providerId, flow.id, patch))
  return (
    updated ?? {
      ...flow,
      authUrl: result.authUrl,
      redirectUri: result.redirectUri ?? flow.redirectUri,
    }
  )
}

export effect function getManagedOAuthFlow(state: ConnectorAccountManagerState, provider: string, flowIdOrState: string) {
  const providerId = normalizeProvider(provider)
  return try onBackend(state, (b) => b.getOAuthFlow(providerId, flowIdOrState))
}

export interface ConnectorOAuthCompletionInput {
  state: string
  code?: string
  error?: string
  errorDescription?: string
  query?: Record<string, string>
  body?: Record<string, unknown>
}

export interface ConnectorOAuthCompletion {
  flow: ConnectorOAuthFlow
  account?: ConnectorAccount
  redirectUrl?: string
}

export effect function completeManagedOAuth(
  state: ConnectorAccountManagerState,
  provider: string,
  input: ConnectorOAuthCompletionInput,
) {
  const providerId = normalizeProvider(provider)
  const queueKey = `${state.runtime?.agentId ?? "standalone"}\u0000${providerId}`
  return try serializedOAuthCompletion(queueKey, completeOAuthUnserialized(state, providerId, input))
}

effect function serializedOAuthCompletion<A, E>(queueKey: string, operation: A!E) {
  const queue = oauthCompletionQueues.get(queueKey) ?? { lock: Semaphore.makeUnsafe(1), waiting: 0 }
  queue.waiting += 1
  oauthCompletionQueues.set(queueKey, queue)
  return try ensuring(
    queue.lock.withPermits(1)(operation),
    sync(() => {
      queue.waiting -= 1
      if (queue.waiting === 0) oauthCompletionQueues.delete(queueKey)
    }),
  )
}

function callbackRequest(
  providerId: string,
  flow: ConnectorOAuthFlow,
  input: ConnectorOAuthCompletionInput,
): ConnectorOAuthCallbackRequest {
  return {
    provider: providerId,
    flow,
    code: input.code,
    error: input.error,
    errorDescription: input.errorDescription,
    query: input.query ?? {},
    body: input.body,
  }
}

effect function completeOAuthUnserialized(
  state: ConnectorAccountManagerState,
  providerId: string,
  input: ConnectorOAuthCompletionInput,
): ConnectorOAuthCompletion!(Foreign | ElizaError | UnknownOAuthFlow | OAuthFlowNotPending | OAuthUnsupported) {
  const flow = try onBackend(state, (b) => b.consumeOAuthFlow(providerId, input.state, "connector-oauth-callback"))
  if (!flow) {
    throw new UnknownOAuthFlow({ message: "Unknown, expired, or already used OAuth flow state" })
  }
  if (flow.status !== "pending") {
    throw new OAuthFlowNotPending({ message: `OAuth flow is already ${flow.status}` })
  }

  if (input.error) {
    const failed = try markFlowFailed(state, providerId, flow.id, input.errorDescription ?? input.error)
    return { flow: failed ?? flow }
  }

  const codeVerifierRef = stringMetadataValue(flow.metadata, "codeVerifierRef")
  if (codeVerifierRef && !flow.codeVerifier) {
    const failed = try markFlowFailed(
      state,
      providerId,
      flow.id,
      "This authorization link was created before the agent restarted, so its one-time PKCE secret no longer exists. Start the OAuth flow again and use the fresh link.",
    )
    return { flow: failed ?? flow }
  }

  const registered = state.providers.get(providerId)
  const complete = registered?.completeOAuth
  if (!registered || !complete) {
    throw new OAuthUnsupported({ message: `OAuth callback not supported for connector provider: ${providerId}` })
  }

  return try ensuring(
    finishOAuthCompletion(state, providerId, flow, input, registered, complete),
    sync(() => deleteOAuthCodeVerifier(stringMetadataValue(flow.metadata, "codeVerifierRef"))),
  )
}

effect function finishOAuthCompletion(
  state: ConnectorAccountManagerState,
  providerId: string,
  flow: ConnectorOAuthFlow,
  input: ConnectorOAuthCompletionInput,
  registered: ConnectorAccountProvider,
  complete: NonNullable<ConnectorAccountProvider["completeOAuth"]>,
) {
  const result = foreign(() => complete.call(registered, callbackRequest(providerId, flow, input), state.manager)) catch effect (failure) => {
    const publicFailureMessage =
      `Connector OAuth completion failed for ${providerId} after the one-time state was consumed; start the flow again.`
    const completionError = new ElizaError(publicFailureMessage, {
      code: "CONNECTOR_OAUTH_COMPLETION_FAILED",
      cause: thrownValue(failure),
      context: { provider: providerId, flowId: flow.id },
    })
    const write: { persisted: ConnectorOAuthFlow | null; error: unknown } = Effect.map(
      markFlowFailed(state, providerId, flow.id, publicFailureMessage),
      (persisted) => ({ persisted, error: undefined }),
    ) catch (writeError) => ({ persisted: null, error: thrownValue(writeError) })
    if (!write.persisted) {
      const persistenceError =
        write.error ?? new Error(`updateOAuthFlow returned null persisting the failed state for flow ${flow.id}`)
      throw new ElizaError(
        `OAuth completion and failure-state persistence both failed for ${providerId}; the consumed flow could not be marked failed. Start the flow again.`,
        {
          code: "CONNECTOR_OAUTH_FAILURE_STATE_PERSISTENCE_FAILED",
          cause: new AggregateError(
            [completionError, persistenceError],
            `OAuth completion and failure-state persistence failed for ${providerId}`,
          ),
          context: { provider: providerId, flowId: flow.id },
        },
      )
    }
    throw completionError
  }

  const account = try persistOAuthAccount(state, providerId, flow, input, registered, result)
  const patch: Partial<ConnectorOAuthFlow> = {
    ...result.flow,
    status: result.flow?.status ?? "completed",
    accountId: account?.id ?? result.flow?.accountId ?? flow.accountId,
    metadata: result.metadata ?? result.flow?.metadata ?? flow.metadata,
  }
  const completed = try onBackend(state, (b) => b.updateOAuthFlow(providerId, flow.id, patch))
  return {
    flow: completed ?? flow,
    account,
    redirectUrl: result.redirectUrl,
  }
}

effect function persistOAuthAccount(
  state: ConnectorAccountManagerState,
  providerId: string,
  flow: ConnectorOAuthFlow,
  input: ConnectorOAuthCompletionInput,
  registered: ConnectorAccountProvider,
  result: ConnectorOAuthCallbackResult,
) {
  const resultAccount = result.account
  if (!resultAccount) {
    return undefined
  }
  return asLegacy(Error, upsertManagedAccount(state, providerId, resultAccount, flow.accountId)) catch effect (failure) => {
    const accountWriteCause = thrownValue(failure)
    const failures: unknown[] = [accountWriteCause]
    const compensate = registered.compensateOAuthCompletion
    if (compensate) {
      foreign(() =>
        compensate.call(registered, callbackRequest(providerId, flow, input), result, accountWriteCause, state.manager)
      ) catch (compensationCause) => {
        failures.push(thrownValue(compensationCause))
      }
    }
    const publicFailureMessage =
      `Connector OAuth account persistence failed for ${providerId}; the issued grant was compensated and the flow must be restarted.`
    try markFlowFailed(state, providerId, flow.id, publicFailureMessage)
    throw new ElizaError(publicFailureMessage, {
      code: "CONNECTOR_OAUTH_ACCOUNT_PERSISTENCE_FAILED",
      cause: failures.length === 1
        ? accountWriteCause
        : new AggregateError(failures, publicFailureMessage),
      context: { provider: providerId, flowId: flow.id },
      severity: "fatal",
    })
  }
}

export effect function evaluateManagedPolicy(
  state: ConnectorAccountManagerState,
  policy: ConnectorAccountPolicy,
  context: ConnectorAccountPolicyContext,
) {
  const providerId = normalizeProvider(policy.provider)
  if (!providerId) {
    return {
      allowed: policy.required === false,
      reason: "Connector account policy is missing provider",
      policy,
    }
  }

  const explicitAccountId = context.accountId ?? resolveAccountIdFromParameters(policy, context)
  if (policy.accountIdParam && context.parameters && !explicitAccountId) {
    return {
      allowed: policy.required === false,
      provider: providerId,
      reason: `Missing connector account parameter: ${policy.accountIdParam}`,
      policy,
    }
  }

  let accounts: ConnectorAccount[]
  if (explicitAccountId) {
    const account = try getManagedAccount(state, providerId, explicitAccountId)
    accounts = account ? [account] : []
  } else {
    accounts = try listManagedAccounts(state, providerId)
  }

  let lastFailure: string | undefined
  for (const account of accounts) {
    const failure = try accountPolicyFailure(state, account, policy, context)
    if (!failure) {
      return { allowed: true, provider: providerId, account, policy }
    }
    lastFailure = failure
  }

  const accountText = explicitAccountId
    ? `account ${explicitAccountId}`
    : `a ${providerId} account`
  return {
    allowed: policy.required === false,
    provider: providerId,
    reason: explicitAccountId && lastFailure
      ? lastFailure
      : `No ${accountText} satisfies connector account policy`,
    policy,
  }
}

effect function accountPolicyFailure(
  state: ConnectorAccountManagerState,
  account: ConnectorAccount,
  policy: ConnectorAccountPolicy,
  context: ConnectorAccountPolicyContext,
) {
  const statuses = policy.statuses ?? ["connected"]
  if (!statuses.includes(account.status)) {
    return `status ${account.status} is not allowed`
  }
  if (
    policy.roles?.length
    && !policy.roles
      .map((role) => normalizeConnectorAccountRole(role))
      .includes(normalizeConnectorAccountRole(account.role))
  ) {
    return `role ${account.role} is not allowed`
  }
  const expectedPurposes = context.purpose
    ? [...(policy.purposes ?? []), context.purpose]
    : policy.purposes
  if (expectedPurposes?.length) {
    const actual = new Set(account.purpose)
    if (!expectedPurposes.some((purpose) => actual.has(purpose))) {
      return `purpose ${account.purpose.join(",")} is not allowed`
    }
  }
  if (
    policy.accessGates?.length
    && !policy.accessGates.includes(account.accessGate)
  ) {
    return `access gate ${account.accessGate} is not allowed`
  }
  if (account.accessGate === "disabled") {
    return "access gate disabled"
  }
  if (account.accessGate === "owner_binding") {
    const binding = try ownerBindingFor(state, account)
    if (!binding) {
      return "owner binding has not been verified"
    }
  }
  return undefined
}

module edge {
  import { Semaphore, type Effect } from "effect"
  import { asLegacy, runDetached, runDetachedSync } from "../edge.vibe"
  import { ElizaError } from "../errors.vibe"
  import type { ConnectorAccountPolicy } from "../types/connector-account-policy.vibe"
  import type { Metadata } from "../types/primitives.vibe"
  import type { IAgentRuntime } from "../types/runtime.vibe"
  import { Service } from "../types/service.vibe"
  import {
    completeManagedOAuth,
    connectorAccountStorageFacade,
    createManagedAccount,
    deleteManagedAccount,
    evaluateManagedPolicy,
    getConnectorAccountManager,
    getManagedAccount,
    getManagedOAuthFlow,
    listManagedAccounts,
    patchManagedAccount,
    registerManagedProvider,
    startManagedOAuth,
    upsertManagedAccount,
    type ConnectorAccount,
    type ConnectorAccountManagerState,
    type ConnectorAccountPatch,
    type ConnectorAccountPolicyContext,
    type ConnectorAccountPolicyEvaluation,
    type ConnectorAccountProvider,
    type ConnectorAccountProviderRegistrationResult,
    type ConnectorAccountStorage,
    type ConnectorOAuthCompletion,
    type ConnectorOAuthCompletionInput,
    type ConnectorOAuthFlow,
  } from "./account-manager.vibe"

  export const CONNECTOR_ACCOUNT_SERVICE_TYPE = "connector_account"

  /** @throws {never} */
  export function normalizeProvider(provider: string): string {
    return provider.trim().toLowerCase()
  }

  /** @throws {never} */
  function settled<A, E extends Error>(effect: Effect.Effect<A, E>): Promise<A> {
    return runDetached(asLegacy(Error, effect, ElizaError))
  }

  export class ConnectorAccountManager extends Service {
    static override serviceType = CONNECTOR_ACCOUNT_SERVICE_TYPE
    capabilityDescription = "Manages connector account providers, OAuth flows, and account access policy"

    readonly #state: ConnectorAccountManagerState
    readonly #storage: ConnectorAccountStorage

    /** @throws {never} */
    constructor(runtime?: IAgentRuntime, storage?: ConnectorAccountStorage) {
      super(runtime)
      this.#state = {
        manager: this,
        runtime,
        providers: new Map(),
        operations: Semaphore.makeUnsafe(1),
        explicitStorage: storage,
        database: undefined,
        fallbackStorage: undefined,
        warnedFallback: false,
      }
      this.#storage = connectorAccountStorageFacade(this.#state)
    }

    /** @throws {never} */
    static override async start(runtime: IAgentRuntime): Promise<ConnectorAccountManager> {
      return getConnectorAccountManager(runtime)
    }

    /** @throws {never} */
    async stop(): Promise<void> {}

    /** @throws {never} */
    getStorage(): ConnectorAccountStorage {
      return this.#storage
    }

    /** @throws {never} */
    setStorage(storage: ConnectorAccountStorage): void {
      this.#state.explicitStorage = storage
    }

    /** @throws {Error} */
    registerProvider(provider: ConnectorAccountProvider): ConnectorAccountProviderRegistrationResult {
      return runDetachedSync(asLegacy(Error, registerManagedProvider(this.#state, provider)))
    }

    /** @throws {never} */
    unregisterProvider(provider: string): boolean {
      return this.#state.providers.delete(normalizeProvider(provider))
    }

    /** @throws {never} */
    getProvider(provider: string): ConnectorAccountProvider | undefined {
      return this.#state.providers.get(normalizeProvider(provider))
    }

    /** @throws {never} */
    listProviders(): ConnectorAccountProvider[] {
      return Array.from(this.#state.providers.values()).sort((a, b) => a.provider.localeCompare(b.provider))
    }

    /** @throws {never} */
    listAccounts(provider: string): Promise<ConnectorAccount[]> {
      return settled(listManagedAccounts(this.#state, provider))
    }

    /** @throws {never} */
    getAccount(provider: string, accountId: string): Promise<ConnectorAccount | null> {
      return settled(getManagedAccount(this.#state, provider, accountId))
    }

    /** @throws {never} */
    upsertAccount(
      provider: string,
      input: ConnectorAccount | ConnectorAccountPatch,
      accountId?: string,
    ): Promise<ConnectorAccount> {
      return settled(upsertManagedAccount(this.#state, provider, input, accountId))
    }

    /** @throws {never} */
    createAccount(provider: string, input: ConnectorAccountPatch): Promise<ConnectorAccount> {
      return settled(createManagedAccount(this.#state, provider, input))
    }

    /** @throws {never} */
    patchAccount(provider: string, accountId: string, patch: ConnectorAccountPatch): Promise<ConnectorAccount | null> {
      return settled(patchManagedAccount(this.#state, provider, accountId, patch))
    }

    /** @throws {never} */
    deleteAccount(provider: string, accountId: string): Promise<boolean> {
      return settled(deleteManagedAccount(this.#state, provider, accountId))
    }

    /** @throws {never} */
    startOAuth(
      provider: string,
      input: {
        redirectUri?: string
        accountId?: string
        label?: string
        scopes?: string[]
        servedOrigin?: string
        metadata?: Metadata
      } = {},
    ): Promise<ConnectorOAuthFlow> {
      return settled(startManagedOAuth(this.#state, provider, input))
    }

    /** @throws {never} */
    getOAuthFlow(provider: string, flowIdOrState: string): Promise<ConnectorOAuthFlow | null> {
      return settled(getManagedOAuthFlow(this.#state, provider, flowIdOrState))
    }

    /** @throws {never} */
    completeOAuth(provider: string, input: ConnectorOAuthCompletionInput): Promise<ConnectorOAuthCompletion> {
      return settled(completeManagedOAuth(this.#state, provider, input))
    }

    /** @throws {never} */
    evaluatePolicy(
      policy: ConnectorAccountPolicy,
      context: ConnectorAccountPolicyContext = {},
    ): Promise<ConnectorAccountPolicyEvaluation> {
      return settled(evaluateManagedPolicy(this.#state, policy, context))
    }
  }
}
import { CONNECTOR_ACCOUNT_SERVICE_TYPE, ConnectorAccountManager, normalizeProvider } from edge
export { CONNECTOR_ACCOUNT_SERVICE_TYPE, ConnectorAccountManager }

export function getConnectorAccountManager(
  runtime?: IAgentRuntime | null,
  storage?: ConnectorAccountStorage,
): ConnectorAccountManager {
  if (runtime) {
    const service = runtime.getService(CONNECTOR_ACCOUNT_SERVICE_TYPE)
    if (service instanceof ConnectorAccountManager) {
      if (storage) service.setStorage(storage)
      return service
    }
    if (
      service
      && "registerProvider" in service
      && "evaluatePolicy" in service
    ) {
      return service as ConnectorAccountManager
    }

    const existing = runtimeManagers.get(runtime)
    if (existing) {
      if (storage) existing.setStorage(storage)
      return existing
    }
    const manager = new ConnectorAccountManager(runtime, storage)
    runtimeManagers.set(runtime, manager)
    return manager
  }

  if (!standaloneManager) {
    standaloneManager = new ConnectorAccountManager(undefined, storage)
  } else if (storage) {
    standaloneManager.setStorage(storage)
  }
  return standaloneManager
}

export effect function evaluateConnectorAccountPolicies(
  runtime: IAgentRuntime,
  action: Action,
  context: ConnectorAccountPolicyContext = {},
): ConnectorAccountPolicyEvaluation!Foreign {
  const policies = getActionConnectorAccountPolicies(action)
  if (policies.length === 0) {
    return { allowed: true }
  }

  const manager = getConnectorAccountManager(runtime)
  let lastDenied: ConnectorAccountPolicyEvaluation | undefined
  for (const policy of policies) {
    const result = try foreign(() => manager.evaluatePolicy(policy, context))
    if (result.allowed) {
      return result
    }
    lastDenied = result
  }

  return {
    allowed: false,
    reason: lastDenied?.reason
      ?? (policies.length === 1
        ? `Connector account policy denied action ${action.name}`
        : `No connector account policy option allowed action ${action.name}`),
    policy: lastDenied?.policy ?? policies[0],
  }
}

export const evaluateConnectorAccountPoliciesPromise = promised(evaluateConnectorAccountPolicies)

export function getActionConnectorAccountPolicies(
  action: Action,
): ConnectorAccountPolicy[] {
  const withPolicy = action as ActionWithConnectorAccountPolicy
  const raw = withPolicy.connectorAccountPolicy ?? withPolicy.accountPolicy
  if (!raw) return []
  return (Array.isArray(raw) ? raw : [raw]).map((policy) => ({
    ...policy,
    provider: normalizeProvider(policy.provider),
    roles: policy.roles ? [...policy.roles] : undefined,
    purposes: policy.purposes ? [...policy.purposes] : undefined,
    accessGates: policy.accessGates ? [...policy.accessGates] : undefined,
    statuses: policy.statuses ? [...policy.statuses] : undefined,
  }))
}

function resolveAccountIdFromParameters(
  policy: ConnectorAccountPolicy,
  context: ConnectorAccountPolicyContext,
): string | undefined {
  if (!policy.accountIdParam || !context.parameters) {
    return undefined
  }
  const value = context.parameters[policy.accountIdParam]
  return typeof value === "string" && value.trim() ? value.trim() : undefined
}
