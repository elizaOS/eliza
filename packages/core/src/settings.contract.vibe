// spec/core/settingsKeys.md, "Story: Keep persisted settings decryptable under the selected key"
import { Arbitrary, Effect, Exit, Schema } from "effect";
import { contract } from "vibestack/testing";
import { decryptStringValue, encryptStringValue } from "./settings.vibe";

const text = Arbitrary.schema(Schema.String).pipe(Arbitrary.map((s) => s.toWellFormed()));
const setting = Arbitrary.all({ value: text.pipe(Arbitrary.map((s) => `p${s}`)), salt: text });

const succeeded = <A, E>(effect: A!E): A | null => {
  const exit = Effect.runSyncExit(effect);
  return Exit.isSuccess(exit) ? exit.value : null;
};

const seal = ({ value, salt }: { value: string; salt: string }) => {
  const sealed = succeeded(encryptStringValue(value, salt));
  return sealed === null
    ? { sealed, opened: null, resealed: null }
    : { sealed, opened: succeeded(decryptStringValue(sealed, salt)), resealed: succeeded(encryptStringValue(sealed, salt)) };
};

export const aSealedSettingOpensUnderItsSaltAndIsNotSealedTwice = contract({
  input: setting,
  run: seal,
  invariant: ({ value }, { sealed, opened, resealed }) =>
    sealed !== null && sealed.startsWith("v2:") && opened === value && resealed === sealed,
});

const malformedV2Envelopes = [
  // Non-hex junk in the IV part: 24 hex digits plus "!".
  "v2:0123456789abcdef01234567!:abcd:0123456789abcdef0123456789abcdef",
  // Non-hex junk in the tag part: 32 hex digits plus "!".
  "v2:0123456789abcdef01234567:abcd:0123456789abcdef0123456789abcdef!",
  // Empty ciphertext part.
  "v2:0123456789abcdef01234567::0123456789abcdef0123456789abcdef",
  // Non-hex ciphertext part.
  "v2:0123456789abcdef01234567:not-hex:0123456789abcdef0123456789abcdef",
] as const;

const malformed = ({ salt }: { salt: string }) =>
  malformedV2Envelopes.map((value) => ({
    value,
    opened: succeeded(decryptStringValue(value, salt)),
    sealed: succeeded(encryptStringValue(value, salt)),
  }));

export const aMalformedV2EnvelopeStaysPlaintext = contract({
  input: Arbitrary.all({ salt: text }),
  run: malformed,
  invariant: (_input, checked) =>
    checked.every(
      ({ value, opened, sealed }) =>
        opened === value && sealed !== null && sealed !== value && sealed.startsWith("v2:"),
    ),
});
