export const EXTERNAL_CONTENT_RISK_PATTERNS: readonly RegExp[] = [
  /\bexec\b(?:(?!\bexec\b).)*command\s*=/i,
  /elevated\s*=\s*true/i,
  /rm\s+-rf/i,
  /delete\s+all\s+(emails?|files?|data)/i,
  /<\/?system>/i,
  /\]\s*\n\s*\[?(system|assistant|user)\]?:/i,
]

export const URGENCY_KEYWORDS: readonly string[] = [
