// spec/core/privacy.md, "Story: Publish scrub completion only after durable privacy work"
const MAPS_CARD = /\[[ \t]*MAPSCARD[ \t]*\][ \t]*\r?\n[ \t]*\{[^\n]*\}[ \t]*(?=\r?\n|$)(?:\r?\n[ \t]*\[[ \t]*\/[ \t]*MAPSCARD[ \t]*\])?/g
const COORDINATE_KEY_BEFORE = /(?:^|[^\p{L}\p{N}_])(?:lat|lng|lon|long|latitude|longitude)\\?["']?\s*[:=]\s*\\?["']?\s*[-+]?\s*$/iu
const GEO_CONTEXT = /(?:^|[^\p{L}])(?:lat|lng|lon|latitude|longitude|coordinates?|coords?|geo(?:json|location)?|bbox|bounds|center|centre|location|waypoints?|polyline)(?![\p{L}])/iu
const GEO_CONTEXT_WINDOW = 160
const COORDINATE_DECIMAL = /^\d{1,3}\.\d{4,}$/

function mapsCardRegions(text: string): Array<readonly [number, number]> {
  if (!/MAPSCARD/i.test(text)) return []
  return [...text.matchAll(MAPS_CARD)].map((found) => [found.index, found.index + found[0].length] as const)
}

export function coordinateSpanTest(text: string): (start: number, end: number) => boolean {
  const cards = mapsCardRegions(text)
  return (start, end) => {
    if (cards.some(([from, to]) => start >= from && end <= to)) return true
    if (COORDINATE_KEY_BEFORE.test(text.slice(Math.max(0, start - 48), start))) return true
    if (!COORDINATE_DECIMAL.test(text.slice(start, end).trim())) return false
    const prefix = text.slice(Math.max(0, start - GEO_CONTEXT_WINDOW), start)
    return /-\s*$/.test(prefix)
      || /\d\.\d{4,}\s*[,;/]\s*[-+]?\s*$/.test(prefix)
      || /^\s*[,;/]\s*[-+]?\d{1,3}\.\d{4,}/.test(text.slice(end, end + 24))
      || GEO_CONTEXT.test(prefix)
  }
}
