// spec/core/privacy.md, "Story: Publish scrub completion only after durable privacy work"
import type { Plugin } from "../types/plugin.vibe"
import { registerCoreIncomingMessageSecurityHook } from "./incoming-message-security.vibe"

const CORE_SECURITY_HOOKS_PLUGIN_NAME = "core-security-hooks"

export function createCoreSecurityHooksPlugin(): Plugin {
  return {
    name: CORE_SECURITY_HOOKS_PLUGIN_NAME,
    description: "Always-on incoming-message external-content hardening.",
    init: (_config, runtime) => {
      registerCoreIncomingMessageSecurityHook(runtime)
    },
  }
}
