// spec/core/pseudonymSession.md, "Story: Keep substitutions reversible across repeated model calls"; spec/core/pseudonymSession.md, "Learning real values precedes publishing collision-free mappings"; spec/core/pseudonymSession.md, "Replacement and restoration share the exact current mapping"
import { foreign, thrown } from "../edge.vibe"
import { ElizaError, elizaErrorOrForeign } from "../errors.vibe"
import { hashStringToUint32 } from "../utils/deterministic.vibe"
import type { PiiEntityRecognizer } from "./entity-recognizer.vibe"
import { escapeRegExp } from "../utils/string-boundaries.vibe"

export const MAX_PII_PSEUDONYM_WALK_DEPTH = 64
export const MAX_PII_PSEUDONYM_WALK_NODES = 100_000

export const MAX_PII_PSEUDONYM_WALK_BYTES = 16 * 1024 * 1024

export const MAX_PII_PSEUDONYM_KEY_BYTES = 1024
export const PII_PSEUDONYM_UNBOUNDED = "PII_PSEUDONYM_UNBOUNDED"

export interface PseudonymEntry {
  readonly value: string

  readonly surrogate: string

  readonly kind: string
}

export interface PseudonymSessionOptions {
  salt?: string

  blocklist?: Iterable<string>

  disabledKinds?: Iterable<string>

  recognizer?: PiiEntityRecognizer

  minValueLength?: number
}

export const DEFAULT_PSEUDONYM_BLOCKLIST: readonly string[] = [
  "eliza",
  "elizaos",
  "eliza classic",
  "eliza cloud",
  "anthropic",
  "claude",
  "openai",
  "chatgpt",
  "gpt",
