// spec/core/privacy.md, "Story: Publish scrub completion only after durable privacy work"; spec/core/privacy.md, "A marker follows successful scrub and persisted pseudonym assignments"
import { errorText } from "../utils/errors.vibe"
import { Foreign, foreign } from "../edge.vibe"
import { getSalt } from "../settings.vibe"
import { BufferUtils } from "../utils/buffer.vibe"
import { decryptAes256GcmSync, encryptAes256GcmSync, sha256Bytes } from "../utils/web-crypto-sync.ts"
import { assertValidSnapshot, type PseudonymMapSnapshot } from "./pii-pseudonym-map.vibe"
import type { ScrubMarkerCache } from "./pii-scrub-markers.vibe"

export const PII_PSEUDONYM_MAP_CACHE_KEY = "pii:pseudonym-map:v1"

export const PII_PSEUDONYM_MAP_AAD = "elizaos:pii-pseudonym-map:v1"

const PII_PSEUDONYM_MAP_AAD_BYTES = new TextEncoder().encode(
  PII_PSEUDONYM_MAP_AAD,
)

const CIPHERTEXT_PREFIX = "v2"

export class PseudonymMapStoreError extends Data.TaggedError("PseudonymMapStoreError") {
  constructor(message: string) {
    super()
    this.message = `Pseudonym map store (fail-closed): ${message}`
    this.name = "PseudonymMapStoreError"
  }
}

export interface PseudonymMapStore {
  load(): Promise<PseudonymMapSnapshot | null>

  save(snapshot: PseudonymMapSnapshot): Promise<void>
}

export interface EncryptedCachePseudonymMapStoreOptions {
  readonly encryptionSalt?: string
}

export effect function pseudonymMapKey(options: EncryptedCachePseudonymMapStoreOptions) {
  const salt = options.encryptionSalt ?? try getSalt()
  if (typeof salt !== "string" || salt.length === 0) {
    throw new PseudonymMapStoreError(
      "no encryption salt available; refusing to operate an unencrypted map store",
    )
  }
  return try Effect.try({
    try: () => sha256Bytes(salt).slice(0, 32),
    catch: (cause) => new Foreign({ cause }),
  })
}

export effect function loadPseudonymMap(cache: ScrubMarkerCache, key: Uint8Array) {
  const stored = try foreign(() => cache.getCache<string>(PII_PSEUDONYM_MAP_CACHE_KEY))
  if (stored === undefined || stored === null) return null
  if (typeof stored !== "string") {
    throw new PseudonymMapStoreError(
      "stored artifact is not a string (unexpected shape in the cache)",
    )
  }
  const parts = stored.split(":")
  if (parts.length !== 4 || parts[0] !== CIPHERTEXT_PREFIX) {
    throw new PseudonymMapStoreError(
      "stored artifact is not v2 ciphertext; refusing to interpret it",
    )
  }
  const bytes = try Effect.try({
    try: () => decryptAes256GcmSync(
      key,
      BufferUtils.fromHex(parts[1]),
      BufferUtils.fromHex(parts[2]),
      BufferUtils.fromHex(parts[3]),
      PII_PSEUDONYM_MAP_AAD_BYTES,
    ),
    catch: (failure) => new PseudonymMapStoreError(
      `decryption failed (wrong SECRET_SALT or tampered artifact): ${
        errorText(failure)
      }`,
    ),
  })
  const parsed: unknown = try Effect.try({
    try: () => JSON.parse(BufferUtils.bufferToString(bytes, "utf8")),
    catch: () => new PseudonymMapStoreError("decrypted artifact is not valid JSON"),
  })
  try assertValidSnapshot(parsed)
  return parsed as PseudonymMapSnapshot
}

export effect function savePseudonymMap(
  cache: ScrubMarkerCache,
  key: Uint8Array,
  snapshot: PseudonymMapSnapshot,
) {
  try assertValidSnapshot(snapshot)
  const plaintext = JSON.stringify(snapshot)
  const iv = BufferUtils.randomBytes(12)
  const { ciphertext, tag } = try Effect.try({
    try: () => encryptAes256GcmSync(
      key,
      iv,
      BufferUtils.fromString(plaintext, "utf8"),
      PII_PSEUDONYM_MAP_AAD_BYTES,
    ),
    catch: (cause) => new Foreign({ cause }),
  })
  const blob = `${CIPHERTEXT_PREFIX}:${BufferUtils.toHex(iv)}:${BufferUtils.toHex(ciphertext)}:${BufferUtils.toHex(tag)}`
  if (!blob.startsWith(`${CIPHERTEXT_PREFIX}:`) || blob.includes("{")) {
    throw new PseudonymMapStoreError(
      "refusing to persist a non-ciphertext pseudonym map artifact",
    )
  }
  const ok = try foreign(() => cache.setCache<string>(PII_PSEUDONYM_MAP_CACHE_KEY, blob))
  if (!ok) {
    throw new PseudonymMapStoreError(
      "cache write failed; the map artifact was NOT persisted",
    )
  }
}

module edge {
  import { asLegacy, runDetached, runDetachedSync } from "../edge.vibe"
  import type { PseudonymMapSnapshot } from "./pii-pseudonym-map.vibe"
  import { PseudonymMapIntegrityError } from "./pii-pseudonym-map.vibe"
  import type { ScrubMarkerCache } from "./pii-scrub-markers.vibe"
  import {
    type EncryptedCachePseudonymMapStoreOptions,
    loadPseudonymMap,
    type PseudonymMapStore,
    PseudonymMapStoreError,
    pseudonymMapKey,
    savePseudonymMap,
  } from "./pii-pseudonym-map-store.vibe"

  export class EncryptedCachePseudonymMapStore implements PseudonymMapStore {
    private readonly cache: ScrubMarkerCache
    private readonly key: Uint8Array

    /** @throws {Error} */
    constructor(
      cache: ScrubMarkerCache,
      options: EncryptedCachePseudonymMapStoreOptions = {},
    ) {
      this.cache = cache
      this.key = runDetachedSync(asLegacy(Error, pseudonymMapKey(options), PseudonymMapStoreError))
    }

    /** @throws {never} */
    async load(): Promise<PseudonymMapSnapshot | null> {
      return runDetached(asLegacy(Error, loadPseudonymMap(this.cache, this.key), PseudonymMapStoreError, PseudonymMapIntegrityError))
    }

    /** @throws {never} */
    async save(snapshot: PseudonymMapSnapshot): Promise<void> {
      return runDetached(asLegacy(Error, savePseudonymMap(this.cache, this.key, snapshot), PseudonymMapStoreError, PseudonymMapIntegrityError))
    }
  }
}
import { EncryptedCachePseudonymMapStore } from edge
export { EncryptedCachePseudonymMapStore }
