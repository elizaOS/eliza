// spec/core/privacy.md, "Story: Publish scrub completion only after durable privacy work"; spec/core/privacy.md, "A marker follows successful scrub and persisted pseudonym assignments"
import { failingAs, foreign, promised, thrown } from "../edge.vibe"
import { sha256Hex } from "../runtime/trajectory-provider-attribution.vibe"

export const PII_SCRUB_MARKER_PREFIX = "pii"

export interface PiiScrubDoneMarker {
  readonly contentHash: string

  readonly rulesetVersion: string

  readonly modelId: string

  readonly completedAt: number

  readonly tier0Only: boolean
}

export error MissingRulesetVersion { message: string }
export error MissingContentHash { message: string }

export function hashScrubContent(content: string): string {
  return sha256Hex(content)
}

export effect function scrubMarkerKey(
  contentHash: string,
  rulesetVersion: string,
) {
  if (typeof rulesetVersion !== "string" || rulesetVersion.length === 0) {
    throw new MissingRulesetVersion({
      message: "[pii-scrub-markers] rulesetVersion must be a non-empty string; refusing to build a version-collapsed marker key",
    })
  }
  if (typeof contentHash !== "string" || contentHash.length === 0) {
    throw new MissingContentHash({
      message: "[pii-scrub-markers] contentHash must be a non-empty string",
    })
  }
  return `${PII_SCRUB_MARKER_PREFIX}:${contentHash}:v${rulesetVersion}`
}

export const scrubMarkerKeyOrThrow = thrown(failingAs(Error, scrubMarkerKey))

export effect function scrubMarkerKeyForContent(
  content: string,
  rulesetVersion: string,
) {
  return try scrubMarkerKey(hashScrubContent(content), rulesetVersion)
}

export const scrubMarkerKeyForContentOrThrow = thrown(failingAs(Error, scrubMarkerKeyForContent))

export interface ScrubMarkerCache {
  getCache<T>(key: string): Promise<T | undefined>
  setCache<T>(key: string, value: T): Promise<boolean>
  deleteCache(key: string): Promise<boolean>
}

export effect function isScrubDone(
  cache: ScrubMarkerCache,
  content: string,
  rulesetVersion: string,
) {
  return (try getScrubMarker(cache, content, rulesetVersion)) !== undefined
}

export const isScrubDonePromise = promised(failingAs(Error, isScrubDone))

export effect function markScrubDone(
  cache: ScrubMarkerCache,
  content: string,
  marker: Omit<PiiScrubDoneMarker, "contentHash" | "completedAt"> & {
    completedAt?: number
  },
) {
  const contentHash = hashScrubContent(content)
  const key = try scrubMarkerKey(contentHash, marker.rulesetVersion)
  const record: PiiScrubDoneMarker = {
    contentHash,
    rulesetVersion: marker.rulesetVersion,
    modelId: marker.modelId,
    tier0Only: marker.tier0Only,
    completedAt: marker.completedAt ?? Date.now(),
  }
  return try foreign(() => cache.setCache<PiiScrubDoneMarker>(key, record))
}

export const markScrubDonePromise = promised(failingAs(Error, markScrubDone))

export effect function getScrubMarker(
  cache: ScrubMarkerCache,
  content: string,
  rulesetVersion: string,
) {
  const key = try scrubMarkerKeyForContent(content, rulesetVersion)
  const marker = try foreign(() => cache.getCache<PiiScrubDoneMarker>(key))
  return marker ?? undefined
}

export const getScrubMarkerPromise = promised(failingAs(Error, getScrubMarker))
