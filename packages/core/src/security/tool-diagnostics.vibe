// spec/core/privacy.md, "Story: Publish scrub completion only after durable privacy work"
import { thrown } from "../edge.vibe"
import { elizaErrorOrForeign } from "../errors.vibe"
import { type RedactSensitiveMode, redactSensitiveText } from "./redact.vibe"

export const TOOL_DIAGNOSTIC_MASK = "[REDACTED]"

export type ToolDiagnosticTextRedactor = (text: string) => string

module walk {
  import { ElizaError } from "../errors.vibe"
  import { isSensitiveKeyName } from "./redact.vibe"
  import { TOOL_DIAGNOSTIC_MASK, type ToolDiagnosticTextRedactor } from "./tool-diagnostics.vibe"

  const MAX_TOOL_DIAGNOSTIC_DEPTH = 8
  const CYCLE_CODE = "MODEL_TOOL_DATA_CYCLE"

  const JSON_SCHEMA_DEFINITION_MAP_KEYS = new Set([
    "$defs",
    "definitions",
    "dependencies",
    "dependentSchemas",
    "patternProperties",
    "properties",
  ])

  const JSON_SCHEMA_SINGLE_SCHEMA_KEYS = new Set([
    "additionalProperties",
    "contains",
    "else",
    "if",
    "items",
    "not",
    "propertyNames",
    "then",
    "unevaluatedItems",
    "unevaluatedProperties",
  ])

  const JSON_SCHEMA_SCHEMA_ARRAY_KEYS = new Set([
    "allOf",
    "anyOf",
    "oneOf",
    "prefixItems",
  ])

  const TOOL_DEFINITION_SCHEMA_KEYS = new Set([
    "inputSchema",
    "input_schema",
    "parameters",
    "responseSchema",
    "response_schema",
    "schema",
  ])

  interface Walk {
    readonly redactText: ToolDiagnosticTextRedactor
    readonly seen: WeakSet<object>
    readonly complete: boolean
  }

  function isPrivateToolField(key: string): boolean {
    return (
      key === "chatIdempotency"
      || key === "replyRecoveryJson"
      || isSensitiveKeyName(key)
    )
  }

  function isNameList(value: unknown): boolean {
    return Array.isArray(value) && value.every((name) => typeof name === "string")
  }

  function schemaCycle(): ElizaError {
    return new ElizaError("Model-call schema contains a cycle", { code: CYCLE_CODE })
  }

  function toolSchemaCycle(): ElizaError {
    return new ElizaError("Model-call tool schema contains a cycle", { code: CYCLE_CODE })
  }

  function dataCycle(value: object): ElizaError {
    return new ElizaError("Model-bound tool data contains a cycle", {
      code: CYCLE_CODE,
      context: { valueType: value.constructor?.name ?? "object" },
    })
  }

  /** @throws {ElizaError} */
  function enter(value: object, walk: Walk, depth: number, cycle: (value: object) => ElizaError): boolean {
    if (walk.seen.has(value)) {
      if (walk.complete) throw cycle(value)
      return false
    }
    if (!walk.complete && depth >= MAX_TOOL_DIAGNOSTIC_DEPTH) return false
    walk.seen.add(value)
    return true
  }

  function projectError(value: Error, redactText: ToolDiagnosticTextRedactor): Error {
    const projected = new Error(redactText(value.message))
    projected.name = value.name
    projected.stack = value.stack ? redactText(value.stack) : undefined
    return projected
  }

  /** @throws {ElizaError} */
  export function projectData(value: unknown, walk: Walk, depth: number): unknown {
    if (typeof value === "string") return walk.redactText(value)
    if (value === null || typeof value !== "object" || value instanceof Date) return value
    if (!enter(value, walk, depth, dataCycle)) return TOOL_DIAGNOSTIC_MASK
    try {
      if (Array.isArray(value)) {
        let changed = false
        const projected = value.map((item) => {
          const next = projectData(item, walk, depth + 1)
          if (next !== item) changed = true
          return next
        })
        return changed ? projected : value
      }
      if (value instanceof Error) return projectError(value, walk.redactText)
      let changed = false
      const projected: Record<string, unknown> = {}
      for (const [key, entry] of Object.entries(value)) {
        if (isPrivateToolField(key)) {
          projected[key] = TOOL_DIAGNOSTIC_MASK
          changed = true
          continue
        }
        const next = projectData(entry, walk, depth + 1)
        if (next !== entry) changed = true
        projected[key] = next
      }
      return changed || Object.getPrototypeOf(value) !== Object.prototype ? projected : value
    } finally {
      walk.seen.delete(value)
    }
  }

  function projectDefinitionMap(value: unknown, walk: Walk, depth: number): unknown {
    if (!value || typeof value !== "object" || Array.isArray(value)) return projectData(value, walk, depth)
    if (!enter(value, walk, depth, schemaCycle)) return TOOL_DIAGNOSTIC_MASK
    try {
      let changed = false
      const projected: Record<string, unknown> = {}
      for (const [name, schema] of Object.entries(value)) {
        const next = isNameList(schema) ? schema : projectSchemaNode(schema, walk, depth + 1)
        if (next !== schema) changed = true
        projected[name] = next
      }
      return changed ? projected : value
    } finally {
      walk.seen.delete(value)
    }
  }

  function isNameListMap(value: unknown): boolean {
    return !!value && typeof value === "object" && !Array.isArray(value) && Object.values(value).every(isNameList)
  }

  /** @throws {ElizaError} */
  export function projectSchemaNode(value: unknown, walk: Walk, depth: number): unknown {
    if (!value || typeof value !== "object" || Array.isArray(value)) return projectData(value, walk, depth)
    if (!enter(value, walk, depth, schemaCycle)) return TOOL_DIAGNOSTIC_MASK
    try {
      let changed = false
      const projected: Record<string, unknown> = {}
      for (const [key, entry] of Object.entries(value)) {
        const next = JSON_SCHEMA_DEFINITION_MAP_KEYS.has(key)
          ? projectDefinitionMap(entry, walk, depth + 1)
          : (key === "items" || JSON_SCHEMA_SCHEMA_ARRAY_KEYS.has(key)) && Array.isArray(entry)
          ? entry.map((item) => projectSchemaNode(item, walk, depth + 1))
          : JSON_SCHEMA_SINGLE_SCHEMA_KEYS.has(key)
          ? projectSchemaNode(entry, walk, depth + 1)
          : key === "required" && isNameList(entry) || key === "dependentRequired" && isNameListMap(entry)
          ? entry
          : isPrivateToolField(key)
          ? TOOL_DIAGNOSTIC_MASK
          : projectData(entry, walk, depth + 1)
        if (next !== entry) changed = true
        projected[key] = next
      }
      return changed ? projected : value
    } finally {
      walk.seen.delete(value)
    }
  }

  /** @throws {ElizaError} */
  export function projectToolDefinition(value: unknown, walk: Walk, depth: number): unknown {
    if (!value || typeof value !== "object") return projectData(value, walk, depth)
    if (!enter(value, walk, depth, toolSchemaCycle)) return TOOL_DIAGNOSTIC_MASK
    try {
      let changed = false
      if (Array.isArray(value)) {
        const projected = value.map((entry) => {
          const next = projectToolDefinition(entry, walk, depth + 1)
          if (next !== entry) changed = true
          return next
        })
        return changed ? projected : value
      }
      const projected: Record<string, unknown> = {}
      for (const [key, entry] of Object.entries(value)) {
        const next = TOOL_DEFINITION_SCHEMA_KEYS.has(key)
          ? projectSchemaNode(entry, walk, depth + 1)
          : key === "function"
          ? projectToolDefinition(entry, walk, depth + 1)
          : isPrivateToolField(key)
          ? TOOL_DIAGNOSTIC_MASK
          : projectData(entry, walk, depth + 1)
        if (next !== entry) changed = true
        projected[key] = next
      }
      return changed ? projected : value
    } finally {
      walk.seen.delete(value)
    }
  }

  /** @throws {never} */
  export function walkWith(redactText: ToolDiagnosticTextRedactor, complete: boolean): Walk {
    return { redactText, seen: new WeakSet<object>(), complete }
  }

  /** @throws {never} */
  export function projectDiagnostic(value: unknown, redactText: ToolDiagnosticTextRedactor): unknown {
    return projectData(value, walkWith(redactText, false), 0)
  }
}
import { projectData, projectDiagnostic, projectSchemaNode, projectToolDefinition, walkWith } from walk

const TOOLS_MODE: { mode: RedactSensitiveMode } = { mode: "tools" }

export function composeToolDiagnosticRedactor(runtime?: {
  redactSecrets?(text: string): string
}): ToolDiagnosticTextRedactor {
  const redactSecrets = runtime?.redactSecrets?.bind(runtime)
  if (!redactSecrets) {
    return (text) => redactSensitiveText(text, TOOLS_MODE)
  }
  return (text) => redactSensitiveText(redactSecrets(text), TOOLS_MODE)
}

function overlay(base: Record<string, unknown>) {
  let next = base
  return {
    set(key: string, projected: unknown): void {
      if (projected === base[key]) return
      if (next === base) next = { ...base }
      next[key] = projected
    },
    result(): Record<string, unknown> {
      return next
    },
  }
}

export function projectToolDiagnosticValue(
  value: unknown,
  redactText: ToolDiagnosticTextRedactor,
): unknown {
  return projectDiagnostic(value, redactText)
}

export effect function projectCompleteToolValueForModel(
  value: unknown,
  redactText: ToolDiagnosticTextRedactor,
) {
  return try Effect.try({ try: () => projectData(value, walkWith(redactText, true), 0), catch: elizaErrorOrForeign })
}
export const projectCompleteToolValueForModelOrThrow = thrown(projectCompleteToolValueForModel)

export effect function projectCompleteToolArgsForModel(
  args: Record<string, unknown> | undefined,
  redactText: ToolDiagnosticTextRedactor,
) {
  if (args === undefined) return undefined
  return (try projectCompleteToolValueForModel(args, redactText)) as Record<string, unknown>
}
export const projectCompleteToolArgsForModelOrThrow = thrown(projectCompleteToolArgsForModel)

effect function projectModelCallSchemas(
  value: Record<string, unknown>,
  redactText: ToolDiagnosticTextRedactor,
  complete: boolean,
  projected: ReturnType<typeof overlay>,
) {
  for (const schemaKey of ["responseSchema", "response_schema"]) {
    if (!(schemaKey in value)) continue
    projected.set(schemaKey, try Effect.try({
      try: () => projectSchemaNode(value[schemaKey], walkWith(redactText, complete), 0),
      catch: elizaErrorOrForeign,
    }))
  }
  if ("tools" in value) {
    projected.set("tools", try Effect.try({
      try: () => projectToolDefinition(value.tools, walkWith(redactText, complete), 0),
      catch: elizaErrorOrForeign,
    }))
  }
}

export effect function projectModelCallDiagnosticValue(
  value: Record<string, unknown>,
  redactText: ToolDiagnosticTextRedactor,
) {
  const projected = overlay(projectToolDiagnosticValue(value, redactText) as Record<string, unknown>)
  try projectModelCallSchemas(value, redactText, false, projected)
  return projected.result()
}
export const projectModelCallDiagnosticValueOrThrow = thrown(projectModelCallDiagnosticValue)

export effect function projectProtectedModelCallValue(
  value: Record<string, unknown>,
  redactText: ToolDiagnosticTextRedactor,
) {
  const projected = overlay(try projectModelCallDiagnosticValue(value, redactText))
  for (
    const key of [
      "systemPrompt",
      "userPrompt",
      "prompt",
      "messages",
      "toolChoice",
      "providerOptions",
      "response",
      "toolCalls",
      "reasoning",
    ]
  ) {
    if (!(key in value)) continue
    projected.set(key, try projectCompleteToolValueForModel(value[key], redactText))
  }
  try projectModelCallSchemas(value, redactText, true, projected)
  return projected.result()
}
export const projectProtectedModelCallValueOrThrow = thrown(projectProtectedModelCallValue)

export function projectToolDiagnosticArgs(
  args: Record<string, unknown> | undefined,
  redactText: ToolDiagnosticTextRedactor,
): Record<string, unknown> | undefined {
  if (args === undefined) {
    return undefined
  }
  return projectToolDiagnosticValue(args, redactText) as Record<
    string,
    unknown
  >
}
