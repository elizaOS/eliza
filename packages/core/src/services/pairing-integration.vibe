// spec/core/services.md, "Story: Acquire a declared service"
import { type Foreign, foreign, promised } from "../edge.vibe"
import { getPairingIdLabel, type PairingChannel } from "../types/pairing.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import { ServiceType } from "../types/service.vibe"
import type { PairingService } from "./pairing.vibe"

export interface PairingCheckResult {
  allowed: boolean

  pairingCode?: string

  newRequest?: boolean

  replyMessage?: string

  idLabel?: string
}

export interface PairingCheckParams {
  channel: PairingChannel

  senderId: string

  metadata?: Record<string, string>

  suppressReply?: boolean
}

export function getPairingService(
  runtime: IAgentRuntime,
): PairingService | null {
  return runtime.getService<PairingService>(ServiceType.PAIRING)
}

effect function checkPairingAllowed(
  runtime: IAgentRuntime,
  params: PairingCheckParams,
): PairingCheckResult!Foreign {
  const { channel, senderId, metadata, suppressReply } = params

  const pairingService = getPairingService(runtime)
  if (!pairingService) {
    runtime.reportError(
      "pairing-integration",
      new Error(
        "PairingService is not registered but the DM policy is 'pairing'; denying sender",
      ),
      { channel, senderId },
    )
    return {
      allowed: false,
      replyMessage: "Access pairing is temporarily unavailable.",
      idLabel: getPairingIdLabel(channel),
    }
  }

  const isAllowed = try foreign(() => pairingService.isAllowed(channel, senderId))
  if (isAllowed) {
    return { allowed: true }
  }

  if (suppressReply) {
    return { allowed: false }
  }

  const { code, created } = try foreign(() =>
    pairingService.upsertRequest({
      channel,
      senderId,
      metadata,
    })
  )

  const idLabel = getPairingIdLabel(channel)

  if (!code) {
    return { allowed: false, idLabel }
  }

  const replyMessage = created && pairingService.claimPairingReply(channel, senderId)
    ? buildPairingReplyMessage({
      channel,
      senderId,
      code,
      idLabel,
    })
    : undefined

  return {
    allowed: false,
    pairingCode: code,
    newRequest: created,
    replyMessage,
    idLabel,
  }
}

export function buildPairingReplyMessage(params: {
  channel: PairingChannel
  senderId: string
  code: string
  idLabel?: string
}): string {
  const { channel, senderId, code, idLabel = "userId" } = params

  const lines = [
    "Access not configured.",
    "",
    `Your ${idLabel}: ${senderId}`,
    "",
    `Pairing code: ${code}`,
    "",
    "Ask the bot owner to approve with:",
    `  pairing approve ${channel} ${code}`,
  ]

  return lines.join("\n")
}

effect function addToAllowlist(
  runtime: IAgentRuntime,
  channel: PairingChannel,
  senderId: string,
  metadata?: Record<string, string>,
) {
  const pairingService = getPairingService(runtime)
  if (!pairingService) {
    runtime.logger.warn(
      { src: "pairing-integration", channel },
      "PairingService not available",
    )
    return false
  }

  try foreign(() => pairingService.addToAllowlist(channel, senderId, metadata))
  return true
}

effect function removeFromAllowlist(
  runtime: IAgentRuntime,
  channel: PairingChannel,
  senderId: string,
) {
  const pairingService = getPairingService(runtime)
  if (!pairingService) {
    return false
  }

  return try foreign(() => pairingService.removeFromAllowlist(channel, senderId))
}

effect function isInAllowlist(
  runtime: IAgentRuntime,
  channel: PairingChannel,
  senderId: string,
) {
  const pairingService = getPairingService(runtime)
  if (!pairingService) {
    return false
  }

  return try foreign(() => pairingService.isAllowed(channel, senderId))
}

effect function approvePairingCode(
  runtime: IAgentRuntime,
  channel: PairingChannel,
  code: string,
) {
  const pairingService = getPairingService(runtime)
  if (!pairingService) {
    return null
  }

  const result = try foreign(() => pairingService.approveCode({ channel, code }))
  return result?.senderId ?? null
}

export const checkPairingAllowedPromise = promised(checkPairingAllowed)

export const addToAllowlistPromise = promised(addToAllowlist)

export const removeFromAllowlistPromise = promised(removeFromAllowlist)

export const isInAllowlistPromise = promised(isInAllowlist)

export const approvePairingCodePromise = promised(approvePairingCode)
