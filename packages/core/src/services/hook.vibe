// spec/agent/host/eventHooks.md, "Registration identities, event membership and live metadata are separate"; spec/agent/host/eventHooks.md, "Eligibility returns every failure in source order and caches successful binary probes"; spec/agent/host/eventHooks.md, "A captured interceptor dispatches sequentially against one payload object"; spec/agent/host/eventHooks.md, "Stopping detaches every registration without resetting counters"
import { foreign, runDetached } from "../edge.vibe"
import { EventType, type EventPayload } from "../types/events.vibe"
import type {
  HookEligibilityResult,
  HookHandler,
  HookLoadResult,
  HookMetadata,
  HookPriority,
  HookRegistration,
  HookRegistrationOptions,
  HookRequirements,
  HookSnapshot,
  HookSource,
  HookSummary,
  IHookService,
} from "../types/hook.vibe"
import { DEFAULT_HOOK_PRIORITY } from "../types/hook.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import { Service, ServiceType } from "../types/service.vibe"
import { rawEnv } from "../utils/environment.vibe"

module node {
  import { accessSync, constants as fsConstants, statSync } from "node:fs"
  import { platform } from "node:os"
  import { join as joinPath, delimiter as pathDelimiter } from "node:path"

  /** @throws {never} */
  export function currentPlatform(): string {
    return platform()
  }

  /** @throws {never} */
  export function hasBinary(bin: string, pathValue: string): boolean {
    if (!bin || bin.includes("/") || bin.includes("\\") || !pathValue) {
      return false
    }
    const windows = platform() === "win32"
    const extensions = windows ? [".exe", ".cmd", ".bat", ""] : [""]
    for (const dir of pathValue.split(pathDelimiter)) {
      if (!dir) continue
      for (const extension of extensions) {
        const candidate = joinPath(dir, `${bin}${extension}`)
        try {
          if (!statSync(candidate).isFile()) continue
          if (!windows) accessSync(candidate, fsConstants.X_OK)
          return true
        } catch {
          continue
        }
      }
    }
    return false
  }
}
import { currentPlatform, hasBinary } from node

effect function runHooks(registrations: readonly HookRegistration[], payload: EventPayload) {
  for (const registration of registrations) {
    try foreign(() => registration.handler(payload))
  }
}

function normalizeHookPriority(
  priority: HookPriority | undefined,
): HookPriority {
  return typeof priority === "number" && Number.isFinite(priority)
    ? priority
    : DEFAULT_HOOK_PRIORITY
}

export class HookService extends Service implements IHookService {
  static serviceType = ServiceType.HOOKS
  capabilityDescription = "Hook registration and execution"

  private registry = new Map<string, HookRegistration>()

  private eventIndex = new Map<EventType, Set<string>>()

  private idCounter = 0

  private snapshotVersion = 0

  private hookConfig: Record<string, unknown> = {}

  private readonly binaryCache = new Set<string>()
  private binaryCachePath: string | undefined

  private readonly interceptors: Array<{
    eventType: EventType
    handler: (payload: EventPayload) => Promise<void>
  }> = []

  static async start(runtime: IAgentRuntime): Promise<HookService> {
    const service = new HookService(runtime)

    service.setupEventInterceptors()

    return service
  }

  async stop(): Promise<void> {
    for (const { eventType, handler } of this.interceptors) {
      this.runtime.unregisterEvent(eventType, handler)
    }
    this.interceptors.length = 0
    this.registry.clear()
    this.eventIndex.clear()
    this.binaryCache.clear()
  }

  private hasCachedBinary(bin: string): boolean {
    const pathValue = rawEnv("PATH")
    if (this.binaryCachePath !== pathValue) {
      this.binaryCache.clear()
      this.binaryCachePath = pathValue
    }
    if (this.binaryCache.has(bin)) return true
    const found = hasBinary(bin, pathValue ?? "")
    if (found) this.binaryCache.add(bin)
    return found
  }

  private setupEventInterceptors(): void {
    const hookEventTypes = Object.values(EventType).filter(
      (e) => typeof e === "string" && e.startsWith("HOOK_"),
    ) as EventType[]

    for (const eventType of hookEventTypes) {
      const handler = (payload: EventPayload) => this.dispatchToHooks(eventType, payload)
      this.runtime.registerEvent(eventType, handler)
      this.interceptors.push({ eventType, handler })
    }
  }

  private dispatchToHooks(
    eventType: EventType,
    payload: EventPayload,
  ): Promise<void> {
    return runDetached(suspend(() => runHooks(this.eligibleHooks(eventType), payload)))
  }

  private eligibleHooks(eventType: EventType): HookRegistration[] {
    const registrations: HookRegistration[] = []
    for (const id of this.eventIndex.get(eventType) ?? []) {
      const reg = this.registry.get(id)
      if (reg?.metadata.enabled && this.checkEligibilityInternal(reg).eligible) {
        registrations.push(reg)
      }
    }
    registrations.sort((a, b) => {
      if (b.metadata.priority !== a.metadata.priority) {
        return b.metadata.priority - a.metadata.priority
      }
      return a.registeredAt - b.registeredAt
    })
    return registrations
  }

  private checkEligibilityInternal(
    registration: HookRegistration,
  ): HookEligibilityResult {
    const { metadata } = registration

    if (metadata.always) {
      return { eligible: true }
    }

    const requirements = metadata.requires
    if (!requirements) {
      return { eligible: true }
    }

    return this.checkRequirements(requirements, this.hookConfig)
  }

  register(
    events: EventType | EventType[],
    handler: HookHandler,
    options: HookRegistrationOptions,
  ): string {
    const eventArray = Array.isArray(events) ? events : [events]

    const id = `hook_${++this.idCounter}_${options.name.replace(/\s+/g, "_").toLowerCase()}`

    const metadata: HookMetadata = {
      name: options.name,
      description: options.description,
      source: options.source ?? "runtime",
      pluginId: options.pluginId,
      events: eventArray,
      priority: normalizeHookPriority(options.priority),
      enabled: true,
      always: options.always,
      requires: options.requires,
    }

    const registration: HookRegistration = {
      id,
      metadata,
      handler,
      registeredAt: Date.now(),
    }

    this.registry.set(id, registration)

    for (const event of eventArray) {
      if (!this.eventIndex.has(event)) {
        this.eventIndex.set(event, new Set())
      }
      this.eventIndex.get(event)?.add(id)
    }

    this.snapshotVersion++

    this.runtime.logger.debug(
      {
        src: "hook-service",
        hookId: id,
        events: eventArray,
        priority: metadata.priority,
      },
      `Registered hook: ${options.name}`,
    )

    return id
  }

  unregister(hookId: string): boolean {
    const registration = this.registry.get(hookId)
    if (!registration) {
      return false
    }

    for (const event of registration.metadata.events) {
      const hookIds = this.eventIndex.get(event)
      if (hookIds) {
        hookIds.delete(hookId)
        if (hookIds.size === 0) {
          this.eventIndex.delete(event)
        }
      }
    }

    this.registry.delete(hookId)

    this.snapshotVersion++

    this.runtime.logger.debug(
      { src: "hook-service", hookId },
      `Unregistered hook: ${registration.metadata.name}`,
    )

    return true
  }

  async registerFromDirectory(
    _dir: string,
    _source: HookSource,
    _options?: { pluginId?: string },
  ): Promise<HookLoadResult> {
    throw new Error(
      "registerFromDirectory is not supported in the environment-agnostic core.",
    )
  }

  getSnapshot(): HookSnapshot {
    const hooks: HookSummary[] = Array.from(this.registry.values()).map(
      (reg) => ({
        name: reg.metadata.name,
        events: reg.metadata.events,
        source: reg.metadata.source,
        enabled: reg.metadata.enabled,
        pluginId: reg.metadata.pluginId,
        priority: reg.metadata.priority,
      }),
    )

    return {
      hooks,
      version: this.snapshotVersion,
      timestamp: Date.now(),
    }
  }

  getHooksByEvent(event: EventType): HookRegistration[] {
    const hookIds = this.eventIndex.get(event)
    if (!hookIds) {
      return []
    }

    return Array.from(hookIds)
      .map((id) => this.registry.get(id))
      .filter((reg): reg is HookRegistration => reg !== undefined)
  }

  getHook(hookId: string): HookRegistration | undefined {
    return this.registry.get(hookId)
  }

  getAllHooks(): HookRegistration[] {
    return Array.from(this.registry.values())
  }

  setEnabled(hookId: string, enabled: boolean): void {
    const registration = this.registry.get(hookId)
    if (registration) {
      registration.metadata.enabled = enabled
      this.snapshotVersion++
    }
  }

  setPriority(hookId: string, priority: HookPriority): void {
    const registration = this.registry.get(hookId)
    if (registration) {
      registration.metadata.priority = normalizeHookPriority(priority)
      this.snapshotVersion++
    }
  }

  setConfig(config: Record<string, unknown>): void {
    this.hookConfig = config
  }

  checkEligibility(hookId: string): HookEligibilityResult {
    const registration = this.registry.get(hookId)
    if (!registration) {
      return { eligible: false, reasons: ["Hook not found"] }
    }
    return this.checkEligibilityInternal(registration)
  }

  checkRequirements(
    requirements: HookRequirements,
    config?: Record<string, unknown>,
  ): HookEligibilityResult {
    const reasons: string[] = []

    if (requirements.os && requirements.os.length > 0) {
      const platform = currentPlatform()
      if (!requirements.os.includes(platform)) {
        reasons.push(
          `OS '${platform}' not in allowed list: ${requirements.os.join(", ")}`,
        )
      }
    }

    if (requirements.bins && requirements.bins.length > 0) {
      for (const bin of requirements.bins) {
        if (!this.hasCachedBinary(bin)) {
          reasons.push(`Required binary '${bin}' not found`)
        }
      }
    }

    if (requirements.anyBins && requirements.anyBins.length > 0) {
      const hasAny = requirements.anyBins.some((bin) => this.hasCachedBinary(bin))
      if (!hasAny) {
        reasons.push(
          `None of required binaries found: ${requirements.anyBins.join(", ")}`,
        )
      }
    }

    if (requirements.env && requirements.env.length > 0) {
      for (const envVar of requirements.env) {
        if (!rawEnv(envVar)) {
          reasons.push(`Required environment variable '${envVar}' not set`)
        }
      }
    }

    if (requirements.config && requirements.config.length > 0 && config) {
      for (const configPath of requirements.config) {
        const value = this.resolveConfigPath(config, configPath)
        if (!this.isTruthy(value)) {
          reasons.push(`Required config path '${configPath}' is not truthy`)
        }
      }
    }

    return {
      eligible: reasons.length === 0,
      reasons: reasons.length > 0 ? reasons : undefined,
    }
  }

  private resolveConfigPath(
    config: Record<string, unknown>,
    pathStr: string,
  ): unknown {
    const parts = pathStr.split(".").filter(Boolean)
    let current: unknown = config

    for (const part of parts) {
      if (typeof current !== "object" || current === null) {
        return undefined
      }
      current = (current as Record<string, unknown>)[part]
    }

    return current
  }

  private isTruthy(value: unknown): boolean {
    if (value === undefined || value === null) {
      return false
    }
    if (typeof value === "boolean") {
      return value
    }
    if (typeof value === "number") {
      return value !== 0
    }
    if (typeof value === "string") {
      return value.trim().length > 0
    }
    return true
  }
}
