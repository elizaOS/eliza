// spec/core/services.md, "Story: Acquire a declared service"
import { foreignSync, thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import { toWellFormedUnicode } from "../utils/unicode.vibe"

export const OPTIMIZED_PROMPT_SERVICE = "optimized_prompt"

export interface RuntimePromptDemonstration {
  input: { system?: string; user: string }
  expectedOutput: string
}

export interface RuntimePromptResolver {
  getPrompt(
    task: string,
    baseline?: string,
  ): {
    prompt: string
    fewShotExamples?: RuntimePromptDemonstration[]
  } | null
}

export interface OptimizedPromptRuntimeLike {
  getService?: (name: string) => unknown
}

export effect function resolveOptimizedPrompt(
  service: RuntimePromptResolver | null | undefined,
  task: string,
  baseline: string,
) {
  if (!service) return baseline
  const optimized = try foreignSync(() => service.getPrompt(task, baseline))
  if (!optimized) return baseline
  if (!optimized.fewShotExamples || optimized.fewShotExamples.length === 0) {
    return optimized.prompt
  }
  return try injectDemonstrations(optimized.prompt, optimized.fewShotExamples)
}
export const resolveOptimizedPromptOrThrow = thrown(resolveOptimizedPrompt)

effect function completeDemonstrationText(value: string) {
  if (toWellFormedUnicode(value) !== value) {
    throw new ElizaError(
      "Optimized prompt text contains an unpaired Unicode surrogate; regenerate the complete artifact",
      { code: "OPTIMIZED_PROMPT_INVALID_UNICODE" },
    )
  }
  return value
}

effect function injectDemonstrations(
  prompt: string,
  examples: RuntimePromptDemonstration[],
) {
  const lines: string[] = [try completeDemonstrationText(prompt), "", "Demonstrations:", ""]
  let idx = 1
  for (const example of examples) {
    lines.push(`Example ${idx}:`)
    if (example.input.system !== undefined) {
      lines.push(`System:\n${try completeDemonstrationText(example.input.system)}`)
    }
    lines.push(`Input:\n${try completeDemonstrationText(example.input.user)}`)
    lines.push(`Expected:\n${try completeDemonstrationText(example.expectedOutput)}`)
    lines.push("")
    idx += 1
  }
  return lines.join("\n")
}

export effect function resolveOptimizedPromptForRuntime(
  runtime: OptimizedPromptRuntimeLike,
  task: string,
  baseline: string,
) {
  const service = (try foreignSync(() => runtime.getService?.(OPTIMIZED_PROMPT_SERVICE)) as RuntimePromptResolver | null | undefined) ?? null
  return try resolveOptimizedPrompt(service, task, baseline)
}
export const resolveOptimizedPromptForRuntimeOrThrow = thrown(resolveOptimizedPromptForRuntime)
