// spec/core/approvals.md, "Claiming removes pending ownership before a callback starts"; spec/core/approvals.md, "Restart drops process-owned callbacks and service retirement drains a claimed callback"; spec/core/approvalWorkers.md, "Successful registrations retain one name and failed registrations retain none"; spec/core/approvalService.md, "Admission and callback ownership compose under one service stop"; spec/core/approvalRetirement.md, "Stop closes admission and joins the original read and approval work"
import { Foreign, foreign, foreignSync, promised, runDetached } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import { logger } from "../logger.vibe"
import { checkSenderRole } from "../roles.vibe"
import { RuntimeRetirement } from "../runtime/retirement.vibe"
import type { Memory } from "../types/memory.vibe"
import { PENDING_USER_ACTION_WEIGHT, type PendingUserAction } from "../types/pending-user-action.vibe"
import type { UUID } from "../types/primitives.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import { Service, ServiceType } from "../types/service.vibe"
import type { Task, TaskWorker } from "../types/task.vibe"

export interface ApprovalOption {
  name: string
  description?: string
  isDefault?: boolean
  isCancel?: boolean
}

export interface ApprovalRequest {
  name: string
  description: string
  roomId: UUID
  entityId?: UUID
  options: ApprovalOption[]
  tags?: string[]
  timeoutMs?: number
  timeoutDefault?: string
  metadata?: Record<string, unknown>
  onSelect?: (
    option: string,
    task: Task,
    runtime: IAgentRuntime,
  ) => Promise<void>
  onTimeout?: (task: Task, runtime: IAgentRuntime) => Promise<void>
  allowedRoles?: string[]
}

export interface ApprovalResult {
  selectedOption: string
  success: boolean
  timedOut: boolean
  cancelled: boolean
  taskId: UUID
  resolvedBy?: UUID
  resolvedAt: number
}

interface PendingApproval {
  taskId: UUID
  cancelling?: boolean
  settled?: Deferred.Deferred<void>
  request: ApprovalRequest
  createdAt: number
  expiresAt?: number
  timer?: Fiber.Fiber<void>
  decision: Deferred.Deferred<ApprovalResult, Error>
}

interface Approvals {
  readonly runtime: IAgentRuntime
  readonly pending: Map<UUID, PendingApproval>
  readonly registeredWorkers: Set<string>
  readonly operations: RuntimeRetirement
  stopped: boolean
}

export const STANDARD_OPTIONS = {
  CONFIRM: [
    { name: "confirm", description: "Confirm and proceed", isDefault: false },
    { name: "cancel", description: "Cancel the operation", isCancel: true },
  ] as ApprovalOption[],

  APPROVE_DENY: [
    { name: "approve", description: "Approve the request" },
    { name: "deny", description: "Deny the request", isCancel: true },
  ] as ApprovalOption[],

  YES_NO: [
    { name: "yes", description: "Yes" },
    { name: "no", description: "No", isCancel: true },
  ] as ApprovalOption[],

  ALLOW_ONCE_ALWAYS_DENY: [
    { name: "allow-once", description: "Allow this one time" },
    { name: "allow-always", description: "Always allow this" },
    { name: "deny", description: "Deny the request", isCancel: true },
  ] as ApprovalOption[],
} as const

const APPROVAL_TAGS = ["AWAITING_CHOICE", "APPROVAL"]

function isCancelApprovalOption(
  options: readonly ApprovalOption[] | undefined,
  selectedName: string,
): boolean {
  if (!options) return true
  const option = options.find((o) => o.name === selectedName)
  return option ? option.isCancel === true : true
}

function cancelled(taskId: UUID): ApprovalResult {
  return { selectedOption: "cancel", success: false, timedOut: false, cancelled: true, taskId, resolvedAt: Date.now() }
}

function asError(cause: unknown): Error {
  return cause instanceof Error ? cause : new Error(String(cause))
}

function callbackUnavailable(taskId: UUID): ElizaError {
  return new ElizaError("Approval callback is no longer available", {
    code: "APPROVAL_CALLBACK_UNAVAILABLE",
    context: { taskId },
  })
}

effect function requireRunning(approvals: Approvals) {
  if (approvals.stopped) {
    throw new ElizaError("Approval service has stopped", {
      code: "APPROVAL_SERVICE_STOPPED",
    })
  }
}

effect function withAdmission<A, E>(approvals: Approvals, operation: A!E) {
  try requireRunning(approvals)
  return try foreign(() => approvals.operations.run(() => runDetached(operation)))
}

effect function stopApprovals(approvals: Approvals) {
  approvals.stopped = true
  for (const pending of approvals.pending.values()) {
    if (pending.cancelling) continue
    pending.timer?.interruptUnsafe()
    try Deferred.succeed(pending.decision, cancelled(pending.taskId))
  }
  approvals.pending.clear()
  try foreign(() => approvals.operations.drain())
}

effect function createAdmittedTask(approvals: Approvals, request: ApprovalRequest, isAsync: boolean) {
  const taskId = try createApprovalTask(approvals, request, isAsync)
  if (approvals.stopped) {
    try foreign(() => approvals.runtime.deleteTask(taskId))
    try requireRunning(approvals)
  }
  return taskId
}

effect function requestApproval(approvals: Approvals, request: ApprovalRequest) {
  return try withAdmission(approvals, effect {
    const taskId = try createAdmittedTask(approvals, request, false)
    const settled = try Deferred.make<void>()
    const pending: PendingApproval = {
      settled,
      taskId,
      request,
      createdAt: Date.now(),
      decision: try Deferred.make<ApprovalResult, Error>(),
    }
    try armTimeout(approvals, pending, "ApprovalService.timeout")
    approvals.pending.set(taskId, pending)
    logger.info(
      {
        src: "service:approval",
        taskId,
        name: request.name,
        roomId: request.roomId,
        options: request.options.map((o) => o.name),
        timeoutMs: request.timeoutMs,
      },
      "Approval request created",
    )
    return try ensuring(Deferred.await(pending.decision), Deferred.done(settled, Exit.void))
  })
}

effect function requestApprovalAsync(approvals: Approvals, request: ApprovalRequest) {
  return try withAdmission(approvals, effect {
    const taskId = try createAdmittedTask(approvals, request, true)
    const pending: PendingApproval = {
      taskId,
      request,
      createdAt: Date.now(),
      decision: try Deferred.make<ApprovalResult, Error>(),
    }
    try armTimeout(approvals, pending, "ApprovalService.asyncTimeout")
    approvals.pending.set(taskId, pending)
    logger.info(
      {
        src: "service:approval",
        taskId,
        name: request.name,
        roomId: request.roomId,
        async: true,
      },
      "Async approval request created",
    )
    return taskId
  })
}

effect function createApprovalTask(approvals: Approvals, request: ApprovalRequest, isAsync: boolean) {
  try ensureWorkerRegistered(approvals, request)
  try requireRunning(approvals)
  return try foreign(() =>
    approvals.runtime.createTask({
      name: request.name,
      description: request.description,
      roomId: request.roomId,
      entityId: request.entityId,
      tags: [...APPROVAL_TAGS, ...(request.tags ?? [])],
      metadata: {
        ...(request.metadata ?? {}),
        options: request.options.map((opt) => ({
          name: opt.name,
          description: opt.description ?? "",
        })),
        approvalRequest: {
          timeoutMs: request.timeoutMs,
          timeoutDefault: request.timeoutDefault,
          allowedRoles: request.allowedRoles ?? ["OWNER", "ADMIN"],
          createdAt: Date.now(),
          ...(isAsync ? { isAsync: true } : {}),
        },
        onSelectCallback: !!request.onSelect,
        onTimeoutCallback: !!request.onTimeout,
      },
    })
  )
}

effect function armTimeout(approvals: Approvals, pending: PendingApproval, scope: string) {
  const { timeoutMs } = pending.request
  if (pending.expiresAt === undefined) {
    if (!timeoutMs || timeoutMs <= 0) return
    pending.expiresAt = pending.createdAt + timeoutMs
  }
  const delay = Math.max(0, pending.expiresAt - Date.now())
  pending.timer = fork.detached effect {
    try sleep(delay > 2147483647 ? 1 : delay)
    if (!approvals.stopped) admitTimeout(approvals, pending, scope)
  }
}

function admitTimeout(approvals: Approvals, pending: PendingApproval, scope: string): void {
  void approvals.operations.run(() => runDetached(expire(approvals, pending, scope)))
}

effect function expire(approvals: Approvals, pending: PendingApproval, scope: string) {
  const { taskId } = pending
  handleTimeout(approvals, taskId) catch effect (failure) => {
    const error = failure instanceof Foreign ? failure.cause : failure
    approvals.runtime.reportError(scope, error, { taskId })
    approvals.pending.delete(taskId)
    try Deferred.fail(pending.decision, asError(error))
  }
}

effect function cancelApproval(approvals: Approvals, taskId: UUID) {
  return try withAdmission(approvals, effect {
    const pending = approvals.pending.get(taskId)
    if (pending?.cancelling) {
      throw new ElizaError("Approval cancellation is already in progress", {
        code: "APPROVAL_CALLBACK_UNAVAILABLE",
        context: { taskId },
      })
    }
    if (pending) {
      pending.timer?.interruptUnsafe()
      try Deferred.succeed(pending.decision, cancelled(taskId))
      approvals.pending.delete(taskId)
    }
    try foreign(() => approvals.runtime.deleteTask(taskId))
    logger.info({ src: "service:approval", taskId }, "Approval cancelled")
  })
}

effect function cancelPendingApproval(approvals: Approvals, taskId: UUID) {
  return try withAdmission(approvals, effect {
    const pending = approvals.pending.get(taskId)
    if (!pending || pending.cancelling) throw callbackUnavailable(taskId)
    pending.cancelling = true
    pending.timer?.interruptUnsafe()
    foreign(() => approvals.runtime.deleteTask(taskId)) catch effect (failure) => {
      pending.cancelling = false
      if (approvals.stopped) {
        try Deferred.fail(pending.decision, asError(failure.cause))
      } else {
        approvals.pending.set(taskId, pending)
        try armTimeout(approvals, pending, "ApprovalService.cancelRetryTimeout")
      }
      throw failure
    }
    approvals.pending.delete(taskId)
    try Deferred.succeed(pending.decision, cancelled(taskId))
    if (pending.settled) try Deferred.await(pending.settled)
    logger.info(
      { src: "service:approval", taskId },
      "Approval cancellation confirmed",
    )
  })
}

effect function listApprovalTasks(approvals: Approvals, scope: { roomId?: UUID }) {
  return try withAdmission(approvals, foreign(() =>
    approvals.runtime.getTasks({
      ...scope,
      tags: [...APPROVAL_TAGS],
      agentIds: [approvals.runtime.agentId],
    })
  ))
}

function pendingUserActions(approvals: Approvals): PendingUserAction[] {
  return [...approvals.pending.values()].map((pending) => ({
    id: pending.taskId,
    kind: "task_approval",
    source: "approval-service",
    title: pending.request.description,
    roomId: pending.request.roomId,
    options: pending.request.options.map((option) => ({
      id: option.name,
      label: option.description ?? option.name,
      ...(option.isDefault ? { isDefault: true } : {}),
      ...(option.isCancel ? { isCancel: true } : {}),
    })),
    weight: PENDING_USER_ACTION_WEIGHT.task_approval,
    resolution: {
      target: "approval_service",
      requestId: pending.taskId,
    },
    createdAt: pending.createdAt,
    expiresAt: pending.expiresAt ?? null,
  }))
}

effect function handleTimeout(approvals: Approvals, taskId: UUID) {
  const pending = approvals.pending.get(taskId)
  if (!pending || pending.cancelling) return
  approvals.pending.delete(taskId)
  const { request } = pending
  logger.info(
    { src: "service:approval", taskId, name: request.name },
    "Approval timed out",
  )
  const task = try foreign(() => approvals.runtime.getTask(taskId))
  if (!task) {
    throw new ElizaError("Approval task is no longer available for timeout", {
      code: "APPROVAL_TASK_UNAVAILABLE",
      context: { taskId },
    })
  }
  if (request.onTimeout) try foreign(() => request.onTimeout!(task, approvals.runtime))
  const defaultOption = request.timeoutDefault ?? "cancel"
  const isCancel = isCancelApprovalOption(request.options, defaultOption)
  try Deferred.succeed(pending.decision, {
    selectedOption: defaultOption,
    success: !isCancel,
    timedOut: true,
    cancelled: isCancel,
    taskId,
    resolvedAt: Date.now(),
  })
  try foreign(() => approvals.runtime.deleteTask(taskId))
}

function isCallbackFreeAsync(task: Task): boolean {
  const persistedRequest = task.metadata?.approvalRequest as Record<string, unknown> | undefined
  return persistedRequest?.isAsync === true
    && task.metadata?.onSelectCallback === false
    && task.metadata?.onTimeoutCallback === false
}

effect function handleSelection(approvals: Approvals, taskId: UUID, selectedOption: string, resolvedBy?: UUID) {
  return try withAdmission(approvals, effect {
    const task = try foreign(() => approvals.runtime.getTask(taskId))
    if (approvals.stopped) return
    if (!task) {
      logger.warn(
        { src: "service:approval", taskId },
        "Task not found for approval selection",
      )
      return
    }
    const pending = approvals.pending.get(taskId)
    if (pending?.cancelling || (!pending && !isCallbackFreeAsync(task))) throw callbackUnavailable(taskId)
    if (pending) {
      approvals.pending.delete(taskId)
      pending.timer?.interruptUnsafe()
    }
    const request = pending?.request
    const isCancel = isCancelApprovalOption(request?.options, selectedOption)
    logger.info(
      {
        src: "service:approval",
        taskId,
        selectedOption,
        resolvedBy,
        isCancel,
      },
      "Approval selection handled",
    )
    if (pending && request?.onSelect) {
      foreign(() => request.onSelect!(selectedOption, task, approvals.runtime)) catch effect (failure) => {
        try Deferred.fail(pending.decision, asError(failure.cause))
        throw failure
      }
    }
    if (pending) {
      try Deferred.succeed(pending.decision, {
        selectedOption,
        success: !isCancel,
        timedOut: false,
        cancelled: isCancel,
        taskId,
        resolvedBy,
        resolvedAt: Date.now(),
      })
    }
  })
}

effect function canExecuteApproval(approvals: Approvals, request: ApprovalRequest, runtime: IAgentRuntime, message: Memory) {
  return try withAdmission(approvals, effect {
    const tasks = try foreign(() =>
      runtime.getTasks({
        roomId: message.roomId,
        tags: [...APPROVAL_TAGS],
        agentIds: [runtime.agentId],
      })
    )
    const matchingTask = tasks.find((t) => t.name === request.name)
    if (!matchingTask) return false
    const allowedRoles = (
      matchingTask.metadata?.approvalRequest as Record<string, unknown>
    )?.allowedRoles as string[] | undefined
    if (!allowedRoles || allowedRoles.length === 0) return true
    const room = try foreign(() => runtime.getRoom(message.roomId))
    if (!room?.worldId) return true
    const senderRole = try checkSenderRole(runtime, message)
    return senderRole ? allowedRoles.includes(senderRole.role) : false
  })
}

effect function executeApproval(approvals: Approvals, runtime: IAgentRuntime, options: Record<string, unknown>, task: Task) {
  const taskId = task.id
  if (!taskId) {
    logger.error({ src: "service:approval" }, "Task has no ID")
    return undefined
  }
  return try withAdmission(approvals, effect {
    try handleSelection(approvals, taskId, options.option as string, options.resolvedBy as UUID | undefined)
    try foreign(() => runtime.deleteTask(taskId))
    return undefined
  })
}

effect function ensureWorkerRegistered(approvals: Approvals, request: ApprovalRequest) {
  if (approvals.registeredWorkers.has(request.name)) return
  const worker: TaskWorker = {
    name: request.name,
    canExecute: (runtime, message) => runDetached(canExecuteApproval(approvals, request, runtime, message)),
    execute: (runtime, options, task) => runDetached(executeApproval(approvals, runtime, options, task)),
  }
  try foreignSync(() => approvals.runtime.registerTaskWorker(worker))
  approvals.registeredWorkers.add(request.name)
  logger.debug(
    { src: "service:approval", name: request.name },
    "Registered approval task worker",
  )
}

function approvalsOf(runtime: () => IAgentRuntime): Approvals {
  return {
    get runtime() {
      return runtime()
    },
    pending: new Map(),
    registeredWorkers: new Set(),
    operations: new RuntimeRetirement(),
    stopped: false,
  }
}

export class ApprovalService extends Service {
  static serviceType: string = ServiceType.APPROVAL
  capabilityDescription = "Manages approval workflows using the task system"

  private readonly approvals: Approvals = approvalsOf(() => this.runtime)

  static async start(runtime: IAgentRuntime): Promise<Service> {
    return new ApprovalService(runtime)
  }

  stop(): Promise<void> {
    return runDetached(stopApprovals(this.approvals))
  }

  requestApproval(request: ApprovalRequest): Promise<ApprovalResult> {
    return runDetached(requestApproval(this.approvals, request))
  }

  requestApprovalAsync(request: ApprovalRequest): Promise<UUID> {
    return runDetached(requestApprovalAsync(this.approvals, request))
  }

  cancelApproval(taskId: UUID): Promise<void> {
    return runDetached(cancelApproval(this.approvals, taskId))
  }

  cancelPendingApproval(taskId: UUID): Promise<void> {
    return runDetached(cancelPendingApproval(this.approvals, taskId))
  }

  getPendingApprovals(roomId: UUID): Promise<Task[]> {
    return runDetached(listApprovalTasks(this.approvals, { roomId }))
  }

  getAllPendingApprovals(): Promise<Task[]> {
    return runDetached(listApprovalTasks(this.approvals, {}))
  }

  listPendingUserActions(): PendingUserAction[] {
    return pendingUserActions(this.approvals)
  }

  handleSelection(
    taskId: UUID,
    selectedOption: string,
    resolvedBy?: UUID,
  ): Promise<void> {
    return runDetached(handleSelection(this.approvals, taskId, selectedOption, resolvedBy))
  }
}

export effect function requestConfirmation(
  runtime: IAgentRuntime,
  params: {
    description: string
    roomId: UUID
    entityId?: UUID
    timeoutMs?: number
    onConfirm?: (task: Task, runtime: IAgentRuntime) => Promise<void>
    onCancel?: (task: Task, runtime: IAgentRuntime) => Promise<void>
  },
) {
  const service = try foreignSync(() => runtime.getService(ServiceType.APPROVAL) as ApprovalService | null)
  if (!service) {
    logger.warn("ApprovalService not available, auto-denying")
    return false
  }
  const result = try foreign(() =>
    service.requestApproval({
      name: "CONFIRM",
      description: params.description,
      roomId: params.roomId,
      entityId: params.entityId,
      options: STANDARD_OPTIONS.CONFIRM,
      timeoutMs: params.timeoutMs,
      timeoutDefault: "cancel",
      onSelect: (option, task, rt) => runDetached(effect {
        if (option === "confirm" && params.onConfirm) {
          try foreign(() => params.onConfirm!(task, rt))
        } else if (option === "cancel" && params.onCancel) {
          try foreign(() => params.onCancel!(task, rt))
        }
      }),
    })
  )
  return result.success && result.selectedOption === "confirm"
}
export const requestConfirmationPromise = promised(requestConfirmation)

export default ApprovalService
