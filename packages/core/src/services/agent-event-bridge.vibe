// spec/core/services.md, "Story: Acquire a declared service"
import { errorText } from "../utils/errors.vibe"
import { isPassiveConnectorSource } from "../connectors.vibe"
import { foreign, foreignSync, promised } from "../edge.vibe"
import { logger } from "../logger.vibe"
import type { MessageEventData } from "../types/agent-event.vibe"
import type { ActionEventPayload, EvaluatorEventPayload, MessagePayload, RunEventPayload } from "../types/events.vibe"
import type { NotificationInput } from "../types/notification.vibe"
import type { JsonValue } from "../types/primitives.vibe"
import { ChannelType } from "../types/primitives.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import { ServiceType } from "../types/service.vibe"
import { isObjectRecord, asNonEmptyString, readFiniteNumber, readBoolean } from "../utils/type-guards.vibe"
import type { AgentEventService } from "./agent-event.vibe"

interface NotificationServiceLike {
  notify: (input: NotificationInput) => Promise<unknown> | unknown
}

interface RuntimeServiceHost {
  agentId: IAgentRuntime["agentId"]
  getService: IAgentRuntime["getService"]
  getCurrentRunId?: IAgentRuntime["getCurrentRunId"]
  reportError?: IAgentRuntime["reportError"]
}

export const CONNECTOR_MESSAGE_RECEIVED_EVENT_TYPES = [
  "line:message_received",
  "GOOGLE_CHAT_MESSAGE_RECEIVED",
  "TWITCH_MESSAGE_RECEIVED",
  "NOSTR_MESSAGE_RECEIVED",
] as const

const CONNECTOR_EVENT_SOURCES: Readonly<Record<string, string>> = {
  "line:message_received": "line",
  GOOGLE_CHAT_MESSAGE_RECEIVED: "google-chat",
  TWITCH_MESSAGE_RECEIVED: "twitch",
  NOSTR_MESSAGE_RECEIVED: "nostr",
}

function reportBridgeFailure(
  runtime: RuntimeServiceHost,
  scope: string,
  error: unknown,
  message: string,
  context: Record<string, unknown> = {},
): void {
  logger.debug(
    {
      src: "agent-event-bridge",
      scope,
      err: errorText(error),
      ...context,
    },
    message,
  )
  runtime.reportError?.(`AgentEventBridge.${scope}`, error, context)
}

function readRecord(value: unknown): Record<string, unknown> {
  return isObjectRecord(value) ? value : {}
}

function isRuntimeServiceHost(value: unknown): value is RuntimeServiceHost {
  return (
    isObjectRecord(value)
    && typeof value.agentId === "string"
    && typeof value.getService === "function"
  )
}

function reportBridgeError(
  runtime: RuntimeServiceHost,
  scope: string,
  error: unknown,
): void {
  if (runtime.reportError) {
    runtime.reportError(scope, error)
    return
  }
  logger.warn({ src: "agent-event-bridge", scope, error }, "Bridge error")
}

function firstString(...values: unknown[]): string | undefined {
  for (const value of values) {
    const string = asNonEmptyString(value)
    if (string) return string
  }
  return undefined
}

function readAttachments(value: unknown): boolean {
  const record = readRecord(value)
  return (
    (Array.isArray(record.attachments) && record.attachments.length > 0)
    || (Array.isArray(record.attachment) && record.attachment.length > 0)
    || (Array.isArray(record.files) && record.files.length > 0)
  )
}

function resolveAgentEventService(
  runtime: RuntimeServiceHost,
): AgentEventService | null {
  try {
    const service = runtime.getService(ServiceType.AGENT_EVENT)
    if (
      service
      && typeof (service as AgentEventService).emitActionStart === "function"
    ) {
      return service as AgentEventService
    }
  } catch (error) {
    reportBridgeError(
      runtime,
      "AgentEventBridge.resolveAgentEventService",
      error,
    )
  }
  return null
}

function resolveNotificationService(
  runtime: RuntimeServiceHost,
): NotificationServiceLike | null {
  try {
    const service = runtime.getService(ServiceType.NOTIFICATION)
    const candidate = service as Partial<NotificationServiceLike>
    if (candidate && typeof candidate.notify === "function") {
      return candidate as NotificationServiceLike
    }
  } catch (error) {
    reportBridgeError(
      runtime,
      "AgentEventBridge.resolveNotificationService",
      error,
    )
  }
  return null
}

function resolveRunId(
  runtime: RuntimeServiceHost,
  payloadRunId?: string,
): string | null {
  if (payloadRunId) {
    return payloadRunId
  }
  try {
    return runtime.getCurrentRunId?.() ?? null
  } catch (error) {
    reportBridgeError(runtime, "AgentEventBridge.resolveRunId", error)
    return null
  }
}

function resolveActionName(payload: ActionEventPayload): string {
  const actions = payload.content?.actions
  if (Array.isArray(actions) && typeof actions[0] === "string") {
    return actions[0]
  }
  return "unknown"
}

function readContentRunId(payload: ActionEventPayload): string | undefined {
  const runId = (payload.content as Record<string, unknown> | undefined)?.runId
  return typeof runId === "string" && runId.length > 0 ? runId : undefined
}

function messageMetadata(payload: MessagePayload): Record<string, unknown> {
  return readRecord(payload.message.metadata)
}

function resolveMessageSource(payload: MessagePayload): string {
  const metadata = messageMetadata(payload)
  const base = readRecord(metadata.base)
  return (
    asNonEmptyString(payload.source)
      ?? asNonEmptyString(payload.message.content.source)
      ?? asNonEmptyString(metadata.source)
      ?? asNonEmptyString(base.source)
      ?? asNonEmptyString(metadata.provider)
      ?? "message"
  )
}

function resolveMessageChannel(
  payload: MessagePayload,
  source: string,
): string {
  const metadata = messageMetadata(payload)
  const origin = isObjectRecord(metadata.origin) ? metadata.origin : {}
  const session = isObjectRecord(metadata.session) ? metadata.session : {}
  const delivery = isObjectRecord(metadata.delivery) ? metadata.delivery : {}
  return (
    asNonEmptyString(payload.message.content.channelType)
      ?? asNonEmptyString(metadata.chatType)
      ?? asNonEmptyString(metadata.channel)
      ?? asNonEmptyString(session.channel)
      ?? asNonEmptyString(origin.channel)
      ?? asNonEmptyString(origin.provider)
      ?? asNonEmptyString(delivery.channel)
      ?? source
  )
}

function resolveMessageSessionKey(payload: MessagePayload): string | undefined {
  const metadata = messageMetadata(payload)
  const session = isObjectRecord(metadata.session) ? metadata.session : {}
  return (
    asNonEmptyString(payload.message.sessionKey)
      ?? asNonEmptyString(metadata.sessionKey)
      ?? asNonEmptyString(session.sessionKey)
  )
}

function resolveMessageSenderName(payload: MessagePayload): string | undefined {
  const metadata = messageMetadata(payload)
  const sender = isObjectRecord(metadata.sender) ? metadata.sender : {}
  return (
    asNonEmptyString(sender.name)
      ?? asNonEmptyString(sender.username)
      ?? asNonEmptyString(metadata.entityName)
      ?? asNonEmptyString(metadata.entityUserName)
  )
}

function isBackfillMessage(metadata: Record<string, unknown>): boolean {
  return (
    readBoolean(metadata.historical) === true
    || readBoolean(metadata.backfill) === true
    || readBoolean(metadata.isBackfill) === true
    || readBoolean(metadata.replay) === true
    || readBoolean(metadata.imported) === true
  )
}

function isBotMessage(metadata: Record<string, unknown>): boolean {
  const discord = isObjectRecord(metadata.discord) ? metadata.discord : {}
  const discordAuthor = isObjectRecord(discord.discordAuthor)
    ? discord.discordAuthor
    : {}
  return (
    readBoolean(metadata.fromBot) === true
    || readBoolean(discordAuthor.bot) === true
  )
}

const NON_USER_FACING_CHANNEL_TYPES: ReadonlySet<string> = new Set(
  [ChannelType.API, ChannelType.AUTONOMOUS, ChannelType.SELF].map((value) => value.toLowerCase()),
)

function hasTrustedNotificationProvenance(
  payload: MessagePayload,
  source: string,
): boolean {
  if (!isPassiveConnectorSource(source)) return false
  const channelType = resolveMessageChannel(payload, source)
  return !NON_USER_FACING_CHANNEL_TYPES.has(channelType.toLowerCase())
}

function shouldNotifyForInboundMessage(
  payload: MessagePayload,
  source: string,
): boolean {
  const metadata = messageMetadata(payload)
  if (!hasTrustedNotificationProvenance(payload, source)) {
    return false
  }
  if (payload.message.entityId === payload.runtime.agentId) {
    return false
  }
  if (isBotMessage(metadata) || isBackfillMessage(metadata)) {
    return false
  }
  return true
}

function hasAttachments(payload: MessagePayload): boolean {
  const attachments = payload.message.content.attachments
  return Array.isArray(attachments) && attachments.length > 0
}

interface MessageRunId {
  runId: string
  oneShot: boolean
}

function resolveMessageRunId(
  payload: MessagePayload,
  source: string,
): MessageRunId | null {
  const metadata = messageMetadata(payload)
  const explicitRunId = asNonEmptyString(metadata.trajectoryId)
  if (explicitRunId) {
    return { runId: explicitRunId, oneShot: false }
  }
  const messageId = asNonEmptyString(payload.message.id)
  if (messageId && shouldNotifyForInboundMessage(payload, source)) {
    return { runId: messageId, oneShot: true }
  }
  const currentRunId = resolveRunId(payload.runtime)
  if (currentRunId) {
    return { runId: currentRunId, oneShot: false }
  }
  const fallbackId = messageId ?? asNonEmptyString(payload.message.roomId)
  return fallbackId ? { runId: fallbackId, oneShot: true } : null
}

function notificationData(
  payload: MessagePayload,
  source: string,
): Record<string, JsonValue> {
  return {
    source,
    messageId: payload.message.id ?? null,
    roomId: payload.message.roomId,
    entityId: payload.message.entityId,
  }
}

interface RawConnectorMessageSummary {
  runtime: RuntimeServiceHost
  source: string
  channel: string
  channelType?: string
  messageId?: string
  roomId?: string
  senderId?: string
  senderName?: string
  content?: string
  hasAttachments: boolean
  isBot: boolean
  isBackfill: boolean
  isSelf: boolean
  deliveredAt?: number
  accountId?: string
}

function hasTrueFlag(...values: unknown[]): boolean {
  return values.some((value) => readBoolean(value) === true)
}

function normalizeRawConnectorMessage(
  eventType: string,
  payload: unknown,
): RawConnectorMessageSummary | null {
  const source = CONNECTOR_EVENT_SOURCES[eventType]
  if (!source) return null
  const root = readRecord(payload)
  const runtime = isRuntimeServiceHost(root.runtime) ? root.runtime : null
  if (!runtime) return null

  const message = readRecord(root.message)
  const event = readRecord(root.event)
  const eventMessage = readRecord(event.message)
  const lineSource = readRecord(root.lineSource)
  const space = readRecord(root.space ?? message.space ?? event.space)
  const user = readRecord(root.user ?? message.user ?? message.sender)
  const twitchUser = readRecord(message.user)
  const metadata = readRecord(
    message.metadata ?? root.metadata ?? event.metadata,
  )
  const author = readRecord(
    message.author ?? eventMessage.author ?? root.author,
  )

  const channel = firstString(
    message.channel,
    lineSource.type,
    space.type,
    space.displayName,
    source,
  )
  const channelType = firstString(
    message.channelType,
    root.channelType,
    event.channelType,
    metadata.channelType,
  )
  const content = firstString(
    message.content,
    message.text,
    message.argumentText,
    message.altText,
    eventMessage.text,
    eventMessage.argumentText,
    root.text,
  )
  const messageId = firstString(
    message.id,
    message.messageId,
    message.name,
    eventMessage.name,
    root.eventId,
    root.messageId,
  )
  const roomId = firstString(
    message.roomId,
    message.groupId,
    message.channel,
    lineSource.groupId,
    lineSource.roomId,
    lineSource.userId,
    space.name,
  )
  const senderId = firstString(
    message.entityId,
    message.senderId,
    message.userId,
    lineSource.userId,
    twitchUser.userId,
    user.id,
    author.userId,
    author.id,
    metadata.senderId,
    root.from,
    user.name,
  )
  const senderName = firstString(
    message.name,
    message.displayName,
    user.displayName,
    twitchUser.displayName,
    twitchUser.username,
    root.from,
  )
  const accountId = asNonEmptyString(root.accountId)
  const deliveredAt = readFiniteNumber(message.timestamp)
    ?? readFiniteNumber(root.createdAt)
    ?? (message.timestamp instanceof Date
      ? message.timestamp.getTime()
      : undefined)

  return {
    runtime,
    source,
    channel: channel ?? source,
    ...(channelType ? { channelType } : {}),
    ...(messageId ? { messageId } : {}),
    ...(roomId ? { roomId } : {}),
    ...(senderId ? { senderId } : {}),
    ...(senderName ? { senderName } : {}),
    ...(content ? { content } : {}),
    hasAttachments: readAttachments(message)
      || readAttachments(eventMessage)
      || readAttachments(root),
    isBot: hasTrueFlag(
      message.fromBot,
      message.isBot,
      user.bot,
      twitchUser.bot,
      author.bot,
      metadata.fromBot,
    ),
    isBackfill: hasTrueFlag(
      message.historical,
      message.backfill,
      message.isBackfill,
      message.replay,
      message.imported,
      root.historical,
      root.backfill,
      root.isBackfill,
      root.replay,
      root.imported,
      metadata.historical,
      metadata.backfill,
      metadata.isBackfill,
      metadata.replay,
      metadata.imported,
    ),
    isSelf: hasTrueFlag(
      message.fromSelf,
      message.isSelf,
      root.fromSelf,
      root.isSelf,
      metadata.fromSelf,
      metadata.isSelf,
    ),
    ...(deliveredAt !== undefined ? { deliveredAt } : {}),
    ...(accountId ? { accountId } : {}),
  }
}

function shouldNotifyForRawConnectorMessage(
  message: RawConnectorMessageSummary,
): boolean {
  if (!isPassiveConnectorSource(message.source)) return false
  if (
    message.channelType
    && NON_USER_FACING_CHANNEL_TYPES.has(message.channelType.toLowerCase())
  ) {
    return false
  }
  if (message.senderId === message.runtime.agentId) return false
  return !message.isBot && !message.isBackfill && !message.isSelf
}

function rawConnectorNotificationData(
  message: RawConnectorMessageSummary,
): Record<string, JsonValue> {
  return {
    source: message.source,
    messageId: message.messageId ?? null,
    roomId: message.roomId ?? null,
    entityId: message.senderId ?? null,
    accountId: message.accountId ?? null,
  }
}

function messageEventData(
  message: RawConnectorMessageSummary,
): MessageEventData {
  return {
    type: "received",
    ...(message.messageId
      ? { messageId: message.messageId as MessageEventData["messageId"] }
      : {}),
    channel: message.channel,
    ...(message.senderId
      ? { userId: message.senderId as MessageEventData["userId"] }
      : {}),
    ...(message.roomId
      ? { roomId: message.roomId as MessageEventData["roomId"] }
      : {}),
    ...(message.content ? { content: message.content } : {}),
    hasAttachments: message.hasAttachments,
    ...(message.deliveredAt !== undefined
      ? { deliveredAt: message.deliveredAt }
      : {}),
  }
}

effect function bridgeConnectorMessageReceivedToStreams(
  eventType: string,
  payload: unknown,
) {
  const message = normalizeRawConnectorMessage(eventType, payload)
  if (!message) return

  const runId = message.messageId
    ?? message.roomId
    ?? `${message.source}:${message.senderId ?? message.channel}`
  const sessionKey = message.roomId
    ? `${message.source}:${message.roomId}`
    : undefined

  const agentEvents = resolveAgentEventService(message.runtime)
  if (agentEvents) {
    foreignSync(() => {
      agentEvents.emitMessage(runId, messageEventData(message), sessionKey)
      agentEvents.clearRunContext(runId)
    }) catch ({ cause }) =>
      reportBridgeFailure(
        message.runtime,
        "connectorMessage",
        cause,
        "Failed to bridge connector message event to AgentEventService",
        { eventType },
      )
  }

  const notifications = resolveNotificationService(message.runtime)
  if (!notifications || !shouldNotifyForRawConnectorMessage(message)) return

  foreign(() =>
    notifications.notify({
      title: message.senderName
        ? `New ${message.channel} message from ${message.senderName}`
        : `New ${message.channel} message`,
      body: message.content
        || (message.hasAttachments ? "Message includes attachments" : undefined),
      category: "message",
      priority: "normal",
      source: message.source,
      groupKey: `message:${message.source}:${message.roomId ?? message.senderId ?? message.channel}`,
      data: rawConnectorNotificationData(message),
      agentId: message.runtime.agentId,
    })
  ) catch ({ cause }) =>
    reportBridgeFailure(
      message.runtime,
      "connectorNotification",
      cause,
      "Failed to create connector-message notification",
      { eventType },
    )
}

export const bridgeConnectorMessageReceivedToStreamsPromise = promised(bridgeConnectorMessageReceivedToStreams)

effect function bridgeMessageReceivedToStreams(payload: MessagePayload) {
  const source = resolveMessageSource(payload)
  const channel = resolveMessageChannel(payload, source)
  const sessionKey = resolveMessageSessionKey(payload)
  const messageRunId = resolveMessageRunId(payload, source)
  const content = asNonEmptyString(payload.message.content.text)
  const attachments = hasAttachments(payload)

  if (messageRunId) {
    const { runId, oneShot } = messageRunId
    const service = resolveAgentEventService(payload.runtime)
    if (service) {
      foreignSync(() => {
        service.emitMessageReceived(
          runId,
          {
            messageId: payload.message.id,
            channel,
            userId: payload.message.entityId,
            roomId: payload.message.roomId,
            content,
            hasAttachments: attachments,
          },
          sessionKey,
        )
        if (oneShot) service.clearRunContext(runId)
      }) catch ({ cause }) =>
        reportBridgeFailure(
          payload.runtime,
          "messageReceived",
          cause,
          "Failed to bridge MESSAGE_RECEIVED to AgentEventService",
        )
    }
  }

  if (!shouldNotifyForInboundMessage(payload, source)) return

  const notifications = resolveNotificationService(payload.runtime)
  if (!notifications) return

  const senderName = resolveMessageSenderName(payload)
  const title = senderName
    ? `New ${channel} message from ${senderName}`
    : `New ${channel} message`
  const wasMentioned = readBoolean(messageMetadata(payload).wasMentioned) === true
    || (isObjectRecord(payload.message.content.mentionContext)
      && readBoolean(payload.message.content.mentionContext.isMention) === true)

  foreign(() =>
    notifications.notify({
      title,
      body: content || (attachments ? "Message includes attachments" : undefined),
      category: "message",
      priority: wasMentioned ? "high" : "normal",
      source,
      deepLink: payload.message.content.url,
      groupKey: `message:${source}:${payload.message.roomId}`,
      data: notificationData(payload, source),
      agentId: payload.runtime.agentId,
    })
  ) catch ({ cause }) =>
    reportBridgeFailure(
      payload.runtime,
      "inboundNotification",
      cause,
      "Failed to create inbound-message notification",
    )
}

export const bridgeMessageReceivedToStreamsPromise = promised(bridgeMessageReceivedToStreams)

function bridgeToAgentEvents(
  runtime: RuntimeServiceHost,
  payloadRunId: string | undefined,
  scope: string,
  message: string,
  emit: (service: AgentEventService, runId: string) => void,
): void {
  const service = resolveAgentEventService(runtime)
  if (!service) return
  const runId = resolveRunId(runtime, payloadRunId)
  if (!runId) return
  try {
    emit(service, runId)
  } catch (err) {
    reportBridgeFailure(runtime, scope, err, message)
  }
}

export function bridgeActionStartedToStreams(
  payload: ActionEventPayload,
): void {
  bridgeToAgentEvents(
    payload.runtime,
    readContentRunId(payload),
    "actionStarted",
    "Failed to bridge ACTION_STARTED to AgentEventService",
    (service, runId) => {
      const actionName = resolveActionName(payload)
      service.emitActionStart(runId, { actionName })
      service.emitLifecycle(runId, { type: "action_start", actionName })
    },
  )
}

export function bridgeActionCompletedToStreams(
  payload: ActionEventPayload,
): void {
  bridgeToAgentEvents(
    payload.runtime,
    readContentRunId(payload),
    "actionCompleted",
    "Failed to bridge ACTION_COMPLETED to AgentEventService",
    (service, runId) => {
      const actionName = resolveActionName(payload)
      const success = (payload.content as Record<string, unknown> | undefined)?.actionStatus !== "failed"
      service.emitActionComplete(runId, { actionName, success })
      service.emitLifecycle(runId, { type: "action_end", actionName, success })
    },
  )
}

export function bridgeRunStartedToStreams(payload: RunEventPayload): void {
  bridgeToAgentEvents(
    payload.runtime,
    payload.runId,
    "runStarted",
    "Failed to bridge RUN_STARTED to AgentEventService",
    (service, runId) => service.emitLifecycle(runId, { type: "run_start" }),
  )
}

export function bridgeRunEndedToStreams(payload: RunEventPayload): void {
  bridgeToAgentEvents(
    payload.runtime,
    payload.runId,
    "runEnded",
    "Failed to bridge RUN_ENDED to AgentEventService",
    (service, runId) => {
      const duration = typeof payload.duration === "number" ? payload.duration : undefined
      service.emitLifecycle(runId, {
        type: "run_end",
        success: payload.status === "completed",
        ...(duration !== undefined ? { duration } : {}),
      })
      service.clearRunContext(runId)
    },
  )
}

export function bridgeEvaluatorStartedToStreams(
  payload: EvaluatorEventPayload,
): void {
  bridgeToAgentEvents(
    payload.runtime,
    undefined,
    "evaluatorStarted",
    "Failed to bridge EVALUATOR_STARTED to AgentEventService",
    (service, runId) => service.emitEvaluatorStart(runId, { evaluatorName: payload.evaluatorName }),
  )
}

export function bridgeEvaluatorCompletedToStreams(
  payload: EvaluatorEventPayload,
): void {
  bridgeToAgentEvents(
    payload.runtime,
    undefined,
    "evaluatorCompleted",
    "Failed to bridge EVALUATOR_COMPLETED to AgentEventService",
    (service, runId) =>
      service.emitEvaluatorComplete(runId, {
        evaluatorName: payload.evaluatorName,
        validated: payload.completed === true,
      }),
  )
}
