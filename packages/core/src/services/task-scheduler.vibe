// spec/core/sharedScheduler.md, "Each timer tick queues process work and captures at most one query for its own generation"; spec/core/sharedScheduler.md, "Adapter replacement and stop retain detached query and process ownership"; spec/core/processScheduler.md, "Process task names are unique only while registered and stale disposers preserve replacements"; spec/core/processScheduler.md, "Adapter detachment keeps the timer only for registered process work"; spec/core/queryDrain.md, "Queries capture every selected registration and their adapter ownership"; spec/core/queryDrain.md, "Each result group rechecks registration identity after the prior worker settles"; spec/core/queryDrain.md, "Adapter handoff keeps both handles owned until every captured query settles"
import { foreign, runDetached, thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import { logger } from "../logger.vibe"
import type { IDatabaseAdapter } from "../types/database.vibe"
import type { UUID } from "../types/primitives.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import type { Task } from "../types/task.vibe"

interface TaskServiceLike {
  runTick(tasks: Task[]): Promise<void>
}

interface SchedulerRegistration {
  runtime: IAgentRuntime
  taskService: TaskServiceLike
  registrationId: number
}

const registry = new Map<string, SchedulerRegistration>()

const dirtyAgents = new Set<string>()
let timer: Fiber.Fiber<never> | null = null
let adapter: IDatabaseAdapter | null = null
let activeTick: Fiber.Fiber<void> | null = null
let schedulerGeneration = 0
let nextRegistrationId = 0

const busyServices = new Set<TaskServiceLike>()

const pendingQueries = new Map<
  Deferred.Deferred<void>,
  { adapters: Set<IDatabaseAdapter>; services: Set<TaskServiceLike> }
>()

const TICK_INTERVAL_MS = 1000

interface ProcessTask {
  controller: AbortController
  run: (signal: AbortSignal) => Promise<void>
  active?: Fiber.Fiber<void>
}
const processTasks = new Map<string, ProcessTask>()

function stopTimer(): void {
  timer?.interruptUnsafe()
  timer = null
}

effect function disposeProcessTask(name: string, task: ProcessTask) {
  if (processTasks.get(name) === task) processTasks.delete(name)
  task.controller.abort()
  if (!adapter && processTasks.size === 0 && timer) stopTimer()
  if (task.active) try join task.active
}

export effect function registerScheduledProcessTask(
  name: string,
  run: (signal: AbortSignal) => Promise<void>,
) {
  if (processTasks.has(name)) {
    throw new ElizaError("Scheduled process task is already registered", {
      code: "TASK_SCHEDULER_DUPLICATE_PROCESS_TASK",
      context: { name },
    })
  }
  const task: ProcessTask = { controller: new AbortController(), run }
  processTasks.set(name, task)
  ensureTimer()
  return (): Promise<void> => runDetached(disposeProcessTask(name, task))
}

export const registerScheduledProcessTaskOrThrow = thrown(registerScheduledProcessTask)

effect function runProcessTask(name: string, task: ProcessTask) {
  const signal = task.controller.signal
  if (signal.aborted) return
  foreign(() => task.run(signal)) catch ({ cause }) =>
    logger.error(
      {
        err: new ElizaError("Scheduled process task failed", {
          code: "TASK_SCHEDULER_PROCESS_TASK_FAILED",
          context: { name },
          cause,
        }),
      },
      "[TaskScheduler] process task failed",
    )
}

effect function runProcessTasks() {
  for (const [name, task] of processTasks) {
    if (task.active || task.controller.signal.aborted) continue
    task.active = fork.detached ensuring(runProcessTask(name, task), sync(() => {
      task.active = undefined
    }))
  }
}

function staleGenerationError(
  expectedGeneration: number,
  cause?: unknown,
): ElizaError {
  return new ElizaError("Task scheduler generation changed during a tick", {
    code: "TASK_SCHEDULER_STALE_GENERATION",
    context: {
      expectedGeneration,
      currentGeneration: schedulerGeneration,
    },
    cause,
    severity: "ephemeral",
  })
}

function currentRegistration(
  agentId: string,
  registrationId: number,
  generation: number,
): SchedulerRegistration | undefined {
  if (generation !== schedulerGeneration) return undefined
  const entry = registry.get(agentId)
  return entry?.registrationId === registrationId ? entry : undefined
}

function queryFailure(
  generation: number,
  registrations: ReadonlyMap<string, number>,
  agentIds: UUID[],
  cause: unknown,
): ElizaError {
  if (generation !== schedulerGeneration) return staleGenerationError(generation, cause)
  const error = new ElizaError("Shared task queue query failed", {
    code: "TASK_SCHEDULER_QUERY_FAILED",
    context: { agentIds },
    cause,
    severity: "ephemeral",
  })
  for (const [aid, registrationId] of registrations) {
    const entry = currentRegistration(aid, registrationId, generation)
    if (!entry) continue
    dirtyAgents.add(aid)
    entry.runtime.reportError("TaskScheduler.query", error, { agentId: aid })
  }
  return error
}

function registrationChanged(agentId: string, registrationId: number, message: string): void {
  logger.error(
    {
      err: new ElizaError(message, {
        code: "TASK_SCHEDULER_REGISTRATION_CHANGED",
        context: { agentId, registrationId },
        severity: "ephemeral",
      }),
    },
    "[TaskScheduler] rejected tasks for a stale registration",
  )
}

effect function tick(generation: number) {
  if (generation !== schedulerGeneration) throw staleGenerationError(generation)

  const snapshot = Array.from(dirtyAgents)
  const registrations = new Map<string, number>()
  const queryOwners = new Set<TaskServiceLike>()
  for (const agentId of snapshot) {
    const entry = registry.get(agentId)
    if (entry && busyServices.has(entry.taskService)) continue
    if (entry) {
      registrations.set(agentId, entry.registrationId)
      queryOwners.add(entry.taskService)
    }
    dirtyAgents.delete(agentId)
  }
  if (registrations.size === 0) return

  const adp = adapter
  if (!adp) return

  const agentIds = Array.from(registrations.keys()) as UUID[]
  const queryDone = try Deferred.make<void>()
  pendingQueries.set(queryDone, { adapters: new Set([adp]), services: queryOwners })
  const allTasks = try ensuring(
    mapError(
      foreign(() => adp.getTasks({ tags: ["queue"], agentIds })),
      ({ cause }) => queryFailure(generation, registrations, agentIds, cause),
    ),
    sync(() => {
      pendingQueries.delete(queryDone)
      Deferred.doneUnsafe(queryDone, Exit.void)
    }),
  )
  if (generation !== schedulerGeneration) throw staleGenerationError(generation)

  const byAgent = new Map<string, { registrationId: number; tasks: Task[] }>()
  const staleRegistrations = new Set<string>()
  for (const task of allTasks) {
    const aid = task.agentId ?? ""
    const registrationId = aid ? registrations.get(aid) : undefined
    if (!aid || registrationId === undefined) {
      const error = new ElizaError("Task scheduler adapter returned an out-of-scope task", {
        code: "TASK_SCHEDULER_SCOPE_VIOLATION",
        context: { taskId: task.id, returnedAgentId: aid || null, queriedAgentIds: agentIds },
        severity: "fatal",
      })
      for (const [queriedAgentId, queriedRegistrationId] of registrations) {
        currentRegistration(queriedAgentId, queriedRegistrationId, generation)?.runtime.reportError(
          "TaskScheduler.scope",
          error,
          { agentId: queriedAgentId },
        )
      }
      continue
    }
    if (!currentRegistration(aid, registrationId, generation)) {
      if (!staleRegistrations.has(aid)) {
        staleRegistrations.add(aid)
        registrationChanged(aid, registrationId, "Task scheduler registration changed during a tick")
      }
      continue
    }
    const group = byAgent.get(aid)
    if (group) group.tasks.push(task)
    else byAgent.set(aid, { registrationId, tasks: [task] })
  }

  for (const [agentIdKey, { registrationId, tasks }] of byAgent) {
    const entry = currentRegistration(agentIdKey, registrationId, generation)
    if (!entry) {
      registrationChanged(agentIdKey, registrationId, "Task scheduler registration changed before dispatch")
      continue
    }
    busyServices.add(entry.taskService)
    try ensuring(
      effect {
        foreign(() => entry.taskService.runTick(tasks)) catch ({ cause }) =>
          entry.runtime.reportError("TaskScheduler.runTick", cause, { agentId: agentIdKey })
      },
      sync(() => busyServices.delete(entry.taskService)),
    )
    if (currentRegistration(agentIdKey, registrationId, generation)) dirtyAgents.add(agentIdKey)
  }
}

export function startTaskScheduler(adapterInstance: IDatabaseAdapter): void {
  if (timer && adapter === adapterInstance) return

  schedulerGeneration += 1
  adapter = adapterInstance
  activeTick = null
  if (timer) {
    for (const agentId of registry.keys()) dirtyAgents.add(agentId)
    return
  }
  ensureTimer()
}

effect function onTimer() {
  try runProcessTasks()
  if (!adapter || activeTick) return
  const generation = schedulerGeneration
  const tickFiber: Fiber.Fiber<void> = fork.detached ensuring(
    catchCause(tick(generation), (cause) => sync(() => logger.error({ err: Cause.squash(cause) }, "[TaskScheduler] tick failed"))),
    sync(() => {
      if (activeTick === tickFiber) activeTick = null
    }),
  )
  activeTick = tickFiber
}

function ensureTimer(): void {
  if (timer) return
  timer = runFork(forever(andThen(sleep(TICK_INTERVAL_MS), onTimer())))
}

export function stopTaskScheduler(): Promise<void> {
  detachTaskScheduler()
  return drainQueries()
}

export function stopTaskSchedulerForAdapter(
  closingAdapter: IDatabaseAdapter,
): Promise<void> {
  if (adapter === closingAdapter) detachTaskScheduler()
  return drainQueries(undefined, closingAdapter)
}

export function handoffTaskSchedulerAdapter(
  retiringAdapter: IDatabaseAdapter,
  replacementAdapter: IDatabaseAdapter,
): Promise<void> {
  if (retiringAdapter === replacementAdapter) return Promise.resolve()
  for (const ownership of pendingQueries.values()) {
    if (ownership.adapters.has(retiringAdapter)) {
      ownership.adapters.add(replacementAdapter)
    }
  }
  if (adapter === retiringAdapter) startTaskScheduler(replacementAdapter)
  return stopTaskSchedulerForAdapter(retiringAdapter)
}

function detachTaskScheduler(): void {
  schedulerGeneration += 1
  if (timer && processTasks.size === 0) stopTimer()
  registry.clear()
  dirtyAgents.clear()
  adapter = null

  activeTick = null
}

export function registerTaskSchedulerRuntime(
  runtime: IAgentRuntime,
  taskService: TaskServiceLike,
): void {
  const agentIdKey = runtime.agentId
  nextRegistrationId += 1
  registry.set(agentIdKey, {
    runtime,
    taskService,
    registrationId: nextRegistrationId,
  })
  dirtyAgents.add(agentIdKey)
}

export function unregisterTaskSchedulerRuntime(
  agentId: UUID,
  taskService?: TaskServiceLike,
): Promise<void> {
  const agentIdKey = agentId
  const entry = registry.get(agentIdKey)
  const owner = taskService ?? entry?.taskService

  if (!taskService || entry?.taskService === taskService) {
    registry.delete(agentIdKey)
    dirtyAgents.delete(agentIdKey)
  }
  return owner ? drainQueries(owner) : Promise.resolve()
}

function drainQueries(
  owner?: TaskServiceLike,
  closingAdapter?: IDatabaseAdapter,
): Promise<void> {
  const queries = Array.from(pendingQueries)
    .filter(
      ([, ownership]) =>
        (!owner || ownership.services.has(owner))
        && (!closingAdapter || ownership.adapters.has(closingAdapter)),
    )
    .map(([done]) => done)
  return runDetached(forEach(queries, (done) => Deferred.await(done), { discard: true }))
}

export function markTaskSchedulerDirty(agentId: UUID): void {
  dirtyAgents.add(agentId)
}

export function getTaskSchedulerAdapter(): IDatabaseAdapter | null {
  return adapter
}
