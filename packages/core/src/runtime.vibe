  async getRoom(roomId: UUID): Promise<Room | null> {
    const cached = this.roomReadMemo.peek(roomId)
    if (cached) return cached.promise
    return this.roomReadMemo.put(
      roomId,
      undefined,
      (async () => {
        const rooms = await this.adapter.getRoomsByIds([roomId])
        return rooms[0] ?? null
      })(),
    )
  }

