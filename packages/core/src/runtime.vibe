// spec/core/runtime.md, "Story: Initialize an explicit host composition"; spec/core/runtime.md, "Story: Retire every owned operation"; spec/core/packageExports.md, "Story: Preserve the imported core surface in the consumer build and the npm package"

module edge {
  import type { ReportedError } from "./errors.vibe"
  import type { FetchLike } from "./media/fetch.vibe"
  import type { ExecutionTrace, PromptOptimizationRuntimeHooks } from "./prompt-optimization.vibe"
  import type { ActivePromptTraces } from "./runtime/active-prompt-traces.vibe"
  import type { RuntimeConnectorRegistry } from "./runtime/connector-registry.vibe"
  import type { RuntimeDataMutations } from "./runtime/data-mutations.vibe"
  import type { RuntimeEmbeddings } from "./runtime/embeddings.vibe"
  import type { RuntimeModelDispatch } from "./runtime/model-dispatch.vibe"
  import type { RuntimePipelineHooks } from "./runtime/pipeline-hooks.vibe"
  import type { ResponseHandlerEvaluator } from "./runtime/response-handler-evaluators.vibe"
  import type { ResponseHandlerFieldEvaluator } from "./runtime/response-handler-fields.vibe"
  import type { ServicePromiseHandler } from "./runtime/service-lifecycle.vibe"
  import type { SecretFragment, SecretFragmentTaintProfile } from "./security/fragment-redaction.vibe"
  import type { Agent, Character } from "./types/agent.vibe"
  import type { ChatPreHandler, ChatPreHandlerContext, ChatPreHandlerResult } from "./types/chat-pre-handler.vibe"
  import type { Action, ActionMode, ActionResult, HandlerCallback, Provider } from "./types/components.vibe"
  import type { AgentContext } from "./types/contexts.vibe"
  import type { ConnectorAccountRecord, DeleteConnectorAccountParams, GetConnectorAccountParams, IDatabaseAdapter, ListConnectorAccountsParams, LogBody } from "./types/database.vibe"
  import type { Component, Entity, Participant, Relationship, Room, World } from "./types/environment.vibe"
  import type { RegisteredEvaluator } from "./types/evaluator.vibe"
  import type { EventHandler, EventPayload, EventPayloadMap } from "./types/events.vibe"
  import type { Memory } from "./types/memory.vibe"
  import type { IMessageService } from "./types/message-service.vibe"
  import type { IMessagingAdapter } from "./types/messaging.vibe"
  import type { GenerateTextOptions, GenerateTextResult, LLMModeType, ModelHandler, ModelParamsMap, ModelResultMap } from "./types/model.vibe"
  import type { PairingAllowlistEntry, PairingChannel, PairingRequest } from "./types/pairing.vibe"
  import type { Plugin, PluginOwnership, RemotePluginInstallOptions, RemotePluginInstanceHandle, RuntimeEventStorage, ServiceClass } from "./types/plugin.vibe"
  import type { ChannelType, JsonValue, UUID } from "./types/primitives.vibe"
  import type { IAgentRuntime, RuntimeStopOptions } from "./types/runtime.vibe"
  import type { SearchCategoryEnumerationOptions, SearchCategoryLookupOptions, SearchCategoryRegistration } from "./types/search.vibe"
  import type { Service, ServiceTypeName } from "./types/service.vibe"
  import type { RuntimeSettings } from "./types/settings.vibe"
  import type { State } from "./types/state.vibe"
  import type { Task, TaskMetadataPatch, TaskMetadataPatchOutcome, TaskWorker } from "./types/task.vibe"
  import { createLogger } from "./logger.vibe"
  import { installRuntimePluginLifecycle } from "./plugin-lifecycle.vibe"
  import { ChatPreHandlerRegistry } from "./runtime/chat-pre-handler-registry.vibe"
  import { ContextRegistry } from "./runtime/context-registry.vibe"
  import { resolveProviderModelString } from "./runtime/model-policy.vibe"
  import { ResponseHandlerFieldRegistry } from "./runtime/response-handler-fields.vibe"
  import { RoomHandlerQueue } from "./runtime/room-handler-queue.vibe"
  import { TurnControllerRegistry } from "./runtime/turn-controller.vibe"
  import { Kernel, runDetachedSync } from "./edge.vibe"
  import { forward, forwardAsync, helpers, kernelLayer, legacy, type RuntimeHelpers, type RuntimeKernel } from "./runtime/kernel.vibe"
  import type { AgentRuntimeOptions } from "./runtime/host.vibe"
  import { AGENT_SCOPED, DELEGATED, MUTATIONS, type GetMemoriesParams } from "./runtime/store.vibe"
  import { CONNECTOR_FORWARDS, PIPELINE_FORWARDS } from "./runtime/components.vibe"
  import { EMBEDDING_FORWARDS, MODEL_FORWARDS, TRACE_FORWARDS } from "./runtime/dispatch.vibe"
  import * as lifecycle from "./runtime/lifecycle.vibe"
  import { getConversationLength, getLLMMode, getOptimizationDir, getSetting, isActionPlanningEnabled, isCheckShouldRespondEnabled, locateConfiguredSecretFragmentTaint, redactSecrets, replaceRuntimeSettings, runtimeSettings, setSetting } from "./runtime/agent-settings.vibe"
  import * as store from "./runtime/store.vibe"
  import * as services from "./runtime/service-lifecycle.vibe"
  import * as components from "./runtime/components.vibe"
  import * as dispatch from "./runtime/dispatch.vibe"

  type Logger = ReturnType<typeof createLogger>

  export interface AgentRuntime
    extends Pick<IDatabaseAdapter<object>, (typeof DELEGATED)[number] | (typeof AGENT_SCOPED)[number]>,
      Pick<RuntimeDataMutations, (typeof MUTATIONS)[number]>,
      Pick<RuntimeConnectorRegistry, (typeof CONNECTOR_FORWARDS)[number]>,
      Pick<RuntimePipelineHooks, (typeof PIPELINE_FORWARDS)[number]>,
      Pick<ActivePromptTraces, (typeof TRACE_FORWARDS)[number]>,
      Pick<RuntimeEmbeddings, (typeof EMBEDDING_FORWARDS)[number]>,
      Pick<RuntimeModelDispatch, (typeof MODEL_FORWARDS)[number]> {}

  export class AgentRuntime implements IAgentRuntime {
    static readonly ownerToolExecutionObserverVersion = 1 as const
    readonly ownerToolExecutionObserverVersion = 1 as const
    ownerToolExecutionObserver?: IAgentRuntime["ownerToolExecutionObserver"]
    structuredPromptExecutor?: IAgentRuntime["dynamicPromptExecFromState"]
    readonly supportsModelAttemptPreparation = true
    readonly agentId: UUID
    readonly runtimeInstanceId: UUID
    readonly character: Character
    adapter!: IDatabaseAdapter
    readonly actions: Action[] = []
    readonly providers: Provider[] = []
    readonly evaluators: RegisteredEvaluator[] = []
    readonly responseHandlerEvaluators: ResponseHandlerEvaluator[] = []
    readonly responseHandlerFieldEvaluators: ResponseHandlerFieldEvaluator[] = []
    readonly chatPreHandlerRegistry = new ChatPreHandlerRegistry()
    readonly responseHandlerFieldRegistry = new ResponseHandlerFieldRegistry()
    readonly turnControllers = new TurnControllerRegistry()
    readonly roomHandlerQueue = new RoomHandlerQueue({
      onListenerError: (error, event) => this.reportError("AgentRuntime.roomHandlerQueue.listener", error, { event, diagnosticOnly: true }),
    })
    readonly plugins: Plugin[] = []
    readonly contexts: ContextRegistry = new ContextRegistry([])
    unloadPlugin!: (pluginName: string) => Promise<PluginOwnership | null>
    reloadPlugin!: (plugin: Plugin) => Promise<void>
    applyPluginConfig!: (pluginName: string, config: Record<string, string>) => Promise<boolean>
    getPluginOwnership!: (pluginName: string) => PluginOwnership | null
    getAllPluginOwnership!: () => PluginOwnership[]
    events: RuntimeEventStorage = {}
    stateCache = new Map<string, State>()
    readonly fetch: FetchLike
    services = new Map<ServiceTypeName, Service[]>()
    serviceTypes = new Map<ServiceTypeName, ServiceClass[]>()
    models = new Map<string, ModelHandler[]>()
    servicePromiseHandlers = new Map<string, ServicePromiseHandler>()
    servicePromises = new Map<string, Promise<Service>>()
    startingServices = new Map<string, Promise<Service | null>>()
    startingServiceClasses = new Map<ServiceClass, Promise<Service>>()
    serviceInstancesByClass = new Map<ServiceClass, Service>()
    failedServiceClasses = new Set<ServiceClass>()
    serviceRegistrationStatus = new Map<ServiceTypeName, "pending" | "registering" | "registered" | "failed">()
    logger: Logger
    enableAutonomy: boolean
    initPromise: Promise<void>
    messageService: IMessageService | null = null
    readonly #kernel: Kernel<RuntimeKernel>
    readonly #helpers: RuntimeHelpers
    #strictStop: Promise<void> | undefined

    static {
      forwardAsync(this.prototype, DELEGATED, (self: AgentRuntime) => self.adapter)
      forwardAsync(this.prototype, AGENT_SCOPED, (self: AgentRuntime) => self.adapter, (self, [params]) => [{ ...(params as object), agentId: (params as { agentId?: UUID }).agentId ?? self.agentId }])
      forward(this.prototype, MUTATIONS, (self: AgentRuntime) => self.#helpers.mutations)
      forward(this.prototype, CONNECTOR_FORWARDS, (self: AgentRuntime) => self.#helpers.connectors)
      forward(this.prototype, PIPELINE_FORWARDS, (self: AgentRuntime) => self.#helpers.pipelineHooks)
      forward(this.prototype, TRACE_FORWARDS, (self: AgentRuntime) => self.#helpers.promptTraces)
      forward(this.prototype, EMBEDDING_FORWARDS, (self: AgentRuntime) => self.#helpers.embeddings)
      forward(this.prototype, MODEL_FORWARDS, (self: AgentRuntime) => self.#helpers.models)
    }

    /** @throws {unknown} */
    constructor(opts: AgentRuntimeOptions) {
      runDetachedSync(lifecycle.adoptProcessingPolicy(this, opts))
      const identity = runDetachedSync(legacy(lifecycle.resolveIdentity(opts), TypeError))
      this.agentId = identity.agentId
      this.runtimeInstanceId = identity.runtimeInstanceId
      this.character = identity.character
      this.enableAutonomy = identity.enableAutonomy
      this.logger = createLogger({ namespace: `agent:${identity.character.name ?? "unknown"}`, level: opts.logLevel ?? "error" })
      this.fetch = opts.fetch ?? fetch
      this.#kernel = new Kernel(kernelLayer(this, opts, () => this.#kernel))
      this.#helpers = this.#kernel.runSync(helpers())
      this.initPromise = this.#kernel.run(lifecycle.initialized())
      this.#kernel.runSync(legacy(lifecycle.attach()))
      installRuntimePluginLifecycle(this)
    }

    /** @throws {never} */
    createRunId(): UUID {
      return this.#kernel.runSync(lifecycle.createRunId())
    }

    /** @throws {unknown} */
    startRun(roomId?: UUID): UUID {
      return this.#kernel.runSync(lifecycle.startRun(roomId))
    }

    /** @throws {never} */
    endRun(): void {
      return this.#kernel.runSync(lifecycle.endRun())
    }

    /** @throws {unknown} */
    getCurrentRunId(): UUID {
      return this.#kernel.runSync(lifecycle.getCurrentRunId())
    }

    /** @throws {never} */
    registerPlugin<T extends Plugin>(plugin: T): Promise<void> {
      return this.#kernel.run(legacy(components.registerPlugin<T>(plugin)))
    }

    /** @throws {never} */
    getAllServices(): Map<ServiceTypeName, Service[]> {
      return this.services
    }

    /** @throws {never} */
    stop(options?: RuntimeStopOptions): Promise<void> {
      if (!options?.requireQuiescence) return this.#kernel.run(legacy(lifecycle.stop(options)))
      if (this.#strictStop) return this.#strictStop
      const strict = Promise.withResolvers<void>()
      this.#strictStop = strict.promise
      void this.#kernel.run(legacy(lifecycle.stop(options))).then(strict.resolve, strict.reject)
      return strict.promise
    }

    /** @throws {never} */
    initialize(options?: { skipMigrations?: boolean }): Promise<void> {
      return this.#kernel.run(legacy(lifecycle.initialize(options)))
    }

    /** @throws {never} */
    assertResolvableWorldOwners(): Promise<void> {
      return this.#kernel.run(lifecycle.assertResolvableWorldOwners())
    }

    /** @throws {never} */
    registerDatabaseAdapter(adapter: IDatabaseAdapter) {
      return this.#kernel.runSync(lifecycle.registerDatabaseAdapter(adapter))
    }

    /** @throws {never} */
    runPluginMigrations(): Promise<void> {
      return this.#kernel.run(lifecycle.runPluginMigrations())
    }

    /** @throws {never} */
    getConnection(): Promise<object> {
      return this.#kernel.run(legacy(lifecycle.getConnection()))
    }

    /** @throws {never} */
    setSetting(key: string, value: string | boolean | null, secret = false) {
      return this.#kernel.runSync(setSetting(key, value, secret))
    }

    /** @throws {unknown} */
    getSetting(key: string): string | boolean | number | null {
      return this.#kernel.runSync(legacy(getSetting(key)))
    }

    /** @throws {never} */
    get settings(): RuntimeSettings {
      return this.#kernel.runSync(runtimeSettings())
    }

    /** @throws {never} */
    set settings(value: RuntimeSettings) {
      this.#kernel.runSync(replaceRuntimeSettings(value))
    }

    /** @throws {never} */
    getConversationLength() {
      return this.#kernel.runSync(getConversationLength())
    }

    /** @throws {unknown} */
    isActionPlanningEnabled(): boolean {
      return this.#kernel.runSync(legacy(isActionPlanningEnabled()))
    }

    /** @throws {unknown} */
    getLLMMode(): LLMModeType {
      return this.#kernel.runSync(legacy(getLLMMode()))
    }

    /** @throws {unknown} */
    isCheckShouldRespondEnabled(): boolean {
      return this.#kernel.runSync(legacy(isCheckShouldRespondEnabled()))
    }

    /** @throws {unknown} */
    getOptimizationDir(): string {
      return this.#kernel.runSync(legacy(getOptimizationDir()))
    }

    /** @throws {never} */
    registerPromptOptimizationHooks(hooks: PromptOptimizationRuntimeHooks | null): void {
      return this.#kernel.runSync(components.registerPromptOptimizationHooks(hooks))
    }

    /** @throws {never} */
    getPromptOptimizationHooks(): PromptOptimizationRuntimeHooks | null {
      return this.#kernel.runSync(components.getPromptOptimizationHooks())
    }

    /** @throws {never} */
    resolveProviderModelString(resolvedModelType: string, optionsModel?: string, effectiveModelId?: string): string {
      return resolveProviderModelString(this, resolvedModelType, optionsModel, effectiveModelId)
    }

    /** @throws {never} */
    recordPromptTrace(trace: ExecutionTrace): void {
      return this.#helpers.promptTraces.record(trace)
    }

    /** @throws {never} */
    purgePromptTraces(): void {
      return this.#helpers.promptTraces.purgeStaleActiveTraces()
    }

    /** @throws {never} */
    getMessagingAdapter(): IMessagingAdapter | null {
      return this.#kernel.runSync(store.getMessagingAdapter())
    }

    /** @throws {never} */
    registerProvider(provider: Provider) {
      return this.#kernel.runSync(components.registerProvider(provider))
    }

    /** @throws {never} */
    registerAction(action: Action) {
      return this.#kernel.runSync(components.registerAction(action))
    }

    /** @throws {never} */
    registerChatPreHandler(handler: ChatPreHandler) {
      return this.#kernel.runSync(components.registerChatPreHandler(handler))
    }

    /** @throws {never} */
    registerChatPreHandlers(handlers: readonly ChatPreHandler[]) {
      return this.#kernel.runSync(components.registerChatPreHandlers(handlers))
    }

    /** @throws {never} */
    unregisterChatPreHandler(id: string) {
      return this.#kernel.runSync(components.unregisterChatPreHandler(id))
    }

    /** @throws {never} */
    drainChatPreHandlers(ctx: ChatPreHandlerContext): Promise<ChatPreHandlerResult | null> {
      return this.chatPreHandlerRegistry.drain(ctx)
    }

    /** @throws {never} */
    registerEvaluator(evaluator: RegisteredEvaluator) {
      return this.#kernel.runSync(components.registerEvaluator(evaluator))
    }

    /** @throws {never} */
    unregisterEvaluator(name: string): boolean {
      return this.#kernel.runSync(components.unregisterEvaluator(name))
    }

    /** @throws {never} */
    registerResponseHandlerEvaluator(evaluator: ResponseHandlerEvaluator) {
      return this.#kernel.runSync(components.registerResponseHandlerEvaluator(evaluator))
    }

    /** @throws {never} */
    unregisterResponseHandlerEvaluator(name: string): boolean {
      return this.#kernel.runSync(components.unregisterResponseHandlerEvaluator(name))
    }

    /** @throws {unknown} */
    registerResponseHandlerFieldEvaluator(evaluator: ResponseHandlerFieldEvaluator) {
      return this.#kernel.runSync(components.registerResponseHandlerFieldEvaluator(evaluator))
    }

    /** @throws {never} */
    unregisterResponseHandlerFieldEvaluator(name: string): boolean {
      return this.#kernel.runSync(components.unregisterResponseHandlerFieldEvaluator(name))
    }

    /** @throws {never} */
    abortTurn(roomId: string, reason: string): boolean {
      return this.turnControllers.abortTurn(roomId, reason)
    }

    /** @throws {never} */
    unregisterAction(name: string): boolean {
      return this.#kernel.runSync(components.unregisterAction(name))
    }

    /** @throws {never} */
    getAllActions(): Action[] {
      return this.#kernel.runSync(components.getAllActions())
    }

    /** @throws {never} */
    getActionResults(messageId: UUID): ActionResult[] {
      return this.#kernel.runSync(dispatch.getActionResults(messageId))
    }

    /** @throws {never} */
    runActionsByMode(mode: ActionMode, message: Memory, state?: State, options?: { didRespond?: boolean; callback?: HandlerCallback; responses?: Memory[]; selectedContexts?: readonly AgentContext[]; }): Promise<Action[]> {
      return this.#kernel.run(legacy(dispatch.runActionsByMode(mode, message, state, options)))
    }

    /** @throws {never} */
    ensureConnections(entities: Entity[], rooms: Room[], source: string, world: World): Promise<void> {
      return this.#kernel.run(legacy(store.ensureConnections(entities, rooms, source, world)))
    }

    /** @throws {never} */
    ensureConnection(params: { entityId: UUID; roomId: UUID; roomName?: string; worldId?: UUID; worldName?: string; userName?: string; name?: string; source?: string; type?: ChannelType | string; channelId?: string; serverId?: string; messageServerId?: UUID; userId?: UUID; metadata?: Record<string, JsonValue>; }) {
      return this.#kernel.run(legacy(store.ensureConnection(params)))
    }

    /** @throws {never} */
    ensureParticipantInRoom(entityId: UUID, roomId: UUID) {
      return this.#kernel.run(legacy(store.ensureParticipantInRoom(entityId, roomId)))
    }

    /** @throws {never} */
    getParticipantsForEntity(entityId: UUID): Promise<Participant[]> {
      return this.#kernel.run(legacy(store.getParticipantsForEntity(entityId)))
    }

    /** @throws {never} */
    getParticipantsForRoom(roomId: UUID): Promise<UUID[]> {
      return this.#kernel.run(legacy(store.getParticipantsForRoom(roomId)))
    }

    /** @throws {never} */
    isRoomParticipant(roomId: UUID, entityId: UUID): Promise<boolean> {
      return this.#kernel.run(legacy(store.isRoomParticipant(roomId, entityId)))
    }

    /** @throws {never} */
    addParticipant(entityId: UUID, roomId: UUID): Promise<boolean> {
      return this.#kernel.run(legacy(store.addParticipant(entityId, roomId)))
    }

    /** @throws {never} */
    createRoomParticipants(entityIds: UUID[], roomId: UUID): Promise<UUID[]> {
      return this.#kernel.run(legacy(store.createRoomParticipants(entityIds, roomId)))
    }

    /** @throws {never} */
    ensureWorldExists(world: World) {
      return this.#kernel.run(legacy(store.ensureWorldExists(world)))
    }

    /** @throws {never} */
    ensureRoomExists(room: Room) {
      return this.#kernel.run(legacy(store.ensureRoomExists(room)))
    }

    /** @throws {never} */
    composeState(...args: Parameters<IAgentRuntime["composeState"]>): ReturnType<IAgentRuntime["composeState"]> {
      return this.#helpers.providerState.composeState(...args)
    }

    /** @throws {never} */
    _runServiceStart(key: ServiceTypeName, serviceType: string, serviceDef: ServiceClass): Promise<Service | null> {
      return this.#kernel.run(legacy(services.runServiceStart(key, serviceType, serviceDef)))
    }

    /** @throws {never} */
    _stopServiceOnce(serviceType: string, service: Service): Promise<void> {
      return this.#kernel.runSync(services.stopServiceOnce(serviceType, service))
    }

    /** @throws {never} */
    getService<T extends Service = Service>(serviceName: ServiceTypeName | string): T | null {
      return this.#kernel.runSync(services.getService<T>(serviceName))
    }

    /** @throws {never} */
    getTypedService<T extends Service = Service>(serviceName: ServiceTypeName | string): T | null {
      return this.#kernel.runSync(services.getTypedService<T>(serviceName))
    }

    /** @throws {never} */
    getServicesByType<T extends Service = Service>(serviceName: ServiceTypeName | string): T[] {
      return this.#kernel.runSync(services.getServicesByType<T>(serviceName))
    }

    /** @throws {never} */
    getRegisteredServiceTypes(): ServiceTypeName[] {
      return this.#kernel.runSync(services.getRegisteredServiceTypes())
    }

    /** @throws {never} */
    hasService(serviceType: ServiceTypeName | string): boolean {
      return this.#kernel.runSync(services.hasService(serviceType))
    }

    /** @throws {never} */
    getServiceRegistrationStatus(serviceType: ServiceTypeName | string): "pending" | "registering" | "registered" | "failed" | "unknown" {
      return this.#kernel.runSync(services.getServiceRegistrationStatus(serviceType))
    }

    /** @throws {never} */
    getLifecycleState(): | "initializing" | "running" | "failed" | "stopping" | "stopped" {
      return this.#kernel.runSync(lifecycle.getLifecycleState())
    }

    /** @throws {never} */
    getStopSignal(): AbortSignal {
      return this.#kernel.runSync(lifecycle.getStopSignal())
    }

    /** @throws {never} */
    getServiceHealth(): Record< string, { status: "pending" | "registering" | "registered" | "failed" | "unknown"; instances: number; hasPromise: boolean; } > {
      return this.#kernel.runSync(services.getServiceHealth())
    }

    /** @throws {never} */
    registerService(serviceDef: ServiceClass): Promise<void> {
      return this.#kernel.run(legacy(services.registerService(serviceDef)))
    }

    /** @throws {never} */
    getServiceLoadPromise(serviceType: ServiceTypeName | string): Promise<Service> {
      return this.#kernel.run(legacy(services.getServiceLoadPromise(serviceType)))
    }

    /** @throws {never} */
    useModel<T extends keyof ModelParamsMap, R = ModelResultMap[T]>(modelType: T, params: ModelParamsMap[T], provider?: string): Promise<R> {
      return this.#helpers.models.useModel<T, R>(modelType, params, provider)
    }

    /** @throws {never} */
    generateText(input: string, options?: GenerateTextOptions): Promise<GenerateTextResult> {
      return this.#kernel.run(legacy(dispatch.generateText(input, options)))
    }

    /** @throws {never} */
    dynamicPromptExecFromState(args: Parameters<IAgentRuntime["dynamicPromptExecFromState"]>[0]): Promise<Record<string, unknown> | null> {
      return this.#kernel.run(legacy(dispatch.dynamicPromptExecFromState(args)))
    }

    registerEvent<T extends keyof EventPayloadMap>(event: T, handler: EventHandler<T>): void
    registerEvent<P extends EventPayload = EventPayload>(event: string, handler: (params: P) => Promise<void>): void
    /** @throws {never} */
    registerEvent(event: string, handler: (params: EventPayload) => Promise<void>): void {
      return this.#kernel.runSync(components.registerEvent(event, handler))
    }

    unregisterEvent<T extends keyof EventPayloadMap>(event: T, handler: EventHandler<T>): void
    unregisterEvent<P extends EventPayload = EventPayload>(event: string, handler: (params: P) => Promise<void>): void
    /** @throws {never} */
    unregisterEvent(event: string, handler: (params: EventPayload) => Promise<void>): void {
      return this.#kernel.runSync(components.unregisterEvent(event, handler))
    }

    /** @throws {never} */
    getEvent(event: string): | (( params: EventPayloadMap[keyof EventPayloadMap] | EventPayload, ) => Promise<void>)[] | undefined {
      return this.#kernel.runSync(components.getEvent(event))
    }

    /** @throws {never} */
    emitEvent(event: string | string[], params: JsonValue | object) {
      return this.#kernel.run(legacy(dispatch.emitEvent(event, params)))
    }

    /** @throws {never} */
    reportError(scope: string, error: unknown, context?: Record<string, unknown>): void {
      return this.#kernel.runSync(dispatch.reportError(scope, error, context))
    }

    /** @throws {never} */
    getRecentReportedErrors(): ReportedError[] {
      return this.#kernel.runSync(dispatch.getRecentReportedErrors())
    }

    /** @throws {unknown} */
    registerTaskWorker(taskHandler: TaskWorker): void {
      return this.#kernel.runSync(components.registerTaskWorker(taskHandler))
    }

    /** @throws {never} */
    getTaskWorker(name: string): TaskWorker | undefined {
      return this.#kernel.runSync(components.getTaskWorker(name))
    }

    /** @throws {never} */
    unregisterTaskWorker(name: string): boolean {
      return this.#kernel.runSync(components.unregisterTaskWorker(name))
    }

    /** @throws {unknown} */
    get db(): object {
      return this.adapter.db
    }

    /** @throws {never} */
    init(): Promise<void> {
      return this.#kernel.run(lifecycle.init())
    }

    /** @throws {never} */
    close(): Promise<void> {
      return this.#kernel.run(legacy(lifecycle.close()))
    }

    /** @throws {never} */
    retainSharedAdapterRetirement(operation: () => Promise<void>): Promise<void> {
      return this.#kernel.run(lifecycle.retainSharedAdapterRetirement(operation))
    }

    /** @throws {never} */
    getAgent(agentId: UUID): Promise<Agent | null> {
      return this.#kernel.run(legacy(store.getAgent(agentId)))
    }

    /** @throws {never} */
    createAgent(agent: Partial<Agent>): Promise<boolean> {
      return this.#kernel.run(legacy(store.createAgent(agent)))
    }

    /** @throws {never} */
    updateAgent(agentId: UUID, agent: Partial<Agent>): Promise<boolean> {
      return this.#kernel.run(legacy(store.updateAgent(agentId, agent)))
    }

    /** @throws {never} */
    deleteAgent(agentId: UUID): Promise<boolean> {
      return this.#kernel.run(legacy(store.deleteAgent(agentId)))
    }

    /** @throws {never} */
    ensureAgentExists(agent: Partial<Agent>): Promise<Agent> {
      return this.#kernel.run(legacy(store.ensureAgentExists(agent)))
    }

    /** @throws {never} */
    getEntityById(entityId: UUID): Promise<Entity | null> {
      return this.#kernel.run(legacy(store.getEntityById(entityId)))
    }

