// spec/core/providers.md, "Story: Share provider work without sharing cancellation"
import type { JsonObject, JsonValue } from "../types/primitives.vibe"
import type { PageLayoutManifest, SurfaceCapability } from "../types/surface-manifest.vibe"
import type { ViewKind } from "../types/view-kind.vibe"
import {
  type CapabilityEndpointSelection,
  CapabilityError,
  type FileStat,
  type GitOperation,
  type PluginGetProviderResult,
  type PluginInvokeActionResult,
  type PluginResponseHandlerFieldEvaluatorHandleResult,
  type RemotePluginActionManifest,
  type RemotePluginAppBridgeHook,
  type RemotePluginAppManifest,
  type RemotePluginAppNavTabManifest,
  type RemotePluginAppSessionManifest,
  type RemotePluginAppViewerManifest,
  type RemotePluginComponentTypeManifest,
  type RemotePluginConfigMap,
  type RemotePluginEvaluatorManifest,
  type RemotePluginEventManifest,
  type RemotePluginJsonSchemaDefinition,
  type RemotePluginLifecycleHook,
  type RemotePluginModelManifest,
  type RemotePluginModuleManifest,
  type RemotePluginModuleProvenance,
  type RemotePluginProviderManifest,
  type RemotePluginResponseHandlerEvaluatorManifest,
  type RemotePluginResponseHandlerFieldEvaluatorManifest,
  type RemotePluginRouteManifest,
  type RemotePluginServiceManifest,
  type RemotePluginSurfaceManifest,
  type RemotePluginViewManifest,
  type RemotePluginWidgetManifest,
} from "./protocol.vibe"

export effect function endpointSelection(
  params: CapabilityEndpointSelection,
): JsonObject!CapabilityError {
  if (params.endpointId === undefined) return {}
  try validateRemotePluginCallTarget(
    params.endpointId,
    "endpointId",
    "capability.endpoint",
  )
  try validateHeaderSafeString(
    params.endpointId,
    "endpointId",
    "capability.endpoint",
  )
  return { endpointId: params.endpointId }
}

export effect function requireObject(
  value: JsonValue | undefined,
  method: string,
): JsonObject!CapabilityError {
  if (isJsonObject(value)) return value
  throw decodeError(method, "Expected object response.")
}

function isJsonObject(value: JsonValue | undefined): value is JsonObject {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

export effect function requireString(
  object: JsonObject,
  key: string,
  method: string,
): string!CapabilityError {
  const value = object[key]
  if (typeof value === "string") return value
  throw decodeError(method, `${key} must be a string.`)
}

export effect function requireNonEmptyString(
  object: JsonObject,
  key: string,
  method: string,
): string!CapabilityError {
  const value = try requireString(object, key, method)
  if (value.trim().length > 0) return value
  throw decodeError(method, `${key} must be a non-empty string.`)
}

effect function requireRemotePluginModuleId(
  object: JsonObject,
  key: string,
  method: string,
): string!CapabilityError {
  const value = try requireNonEmptyString(object, key, method)
  try validateRemotePluginModuleId(value, key, method)
  return value
}

export effect function optionalString(
  object: JsonObject,
  key: string,
  method: string,
): (string | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (typeof value === "string") return value
  throw decodeError(method, `${key} must be a string when present.`)
}

effect function optionalNonEmptyString(
  object: JsonObject,
  key: string,
  method: string,
): (string | undefined)!CapabilityError {
  const value = try optionalString(object, key, method)
  if (value === undefined) return undefined
  if (value.trim().length > 0) return value
  throw decodeError(method, `${key} must be a non-empty string when present.`)
}

export effect function optionalJsonObject(
  object: JsonObject,
  key: string,
  method: string,
): (JsonObject | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (isJsonObject(value)) return value
  throw decodeError(method, `${key} must be an object when present.`)
}

effect function optionalRemotePluginConfig(
  object: JsonObject,
  key: string,
  method: string,
): (RemotePluginConfigMap | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (!isJsonObject(value)) {
    throw decodeError(method, `${key} must be an object when present.`)
  }
  const config: RemotePluginConfigMap = {}
  for (const [configKey, configValue] of Object.entries(value)) {
    if (
      typeof configValue === "string"
      || (typeof configValue === "number" && Number.isFinite(configValue))
      || typeof configValue === "boolean"
      || configValue === null
    ) {
      config[configKey] = configValue
      continue
    }
    throw decodeError(
      method,
      `${key}.${configKey} must be a string, number, boolean, or null.`,
    )
  }
  return config
}

effect function requireJsonObject(
  object: JsonObject,
  key: string,
  method: string,
): JsonObject!CapabilityError {
  const value = object[key]
  if (isJsonObject(value)) return value
  throw decodeError(method, `${key} must be an object.`)
}

export effect function optionalNumber(
  object: JsonObject,
  key: string,
  method: string,
): (number | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (typeof value === "number" && Number.isFinite(value)) return value
  throw decodeError(method, `${key} must be a finite number when present.`)
}

export effect function requireNumber(
  object: JsonObject,
  key: string,
  method: string,
): number!CapabilityError {
  const value = object[key]
  if (typeof value === "number" && Number.isFinite(value)) return value
  throw decodeError(method, `${key} must be a finite number.`)
}

export effect function requireObjectArray(
  object: JsonObject,
  key: string,
  method: string,
): JsonObject[]!CapabilityError {
  const value = object[key]
  if (
    Array.isArray(value)
    && value.every((entry): entry is JsonObject => isJsonObject(entry))
  ) {
    return value
  }
  throw decodeError(method, `${key} must be an object array.`)
}

effect function decodeEntries<T>(
  value: JsonValue[],
  method: string,
  decode: (value: JsonValue, method: string) => T!CapabilityError,
): T[]!CapabilityError {
  const decoded = new Array<T>(value.length)
  for (let index = 0; index < value.length; index += 1) {
    if (index in value) decoded[index] = try decode(value[index], method)
  }
  return decoded
}

effect function requireArray<T>(
  object: JsonObject,
  key: string,
  method: string,
  decode: (value: JsonValue, method: string) => T!CapabilityError,
): T[]!CapabilityError {
  const value = object[key]
  if (!Array.isArray(value)) {
    throw decodeError(method, `${key} must be an array.`)
  }
  return try decodeEntries(value, `${method}.${key}`, decode)
}

export effect function requireFileStatArray(
  object: JsonObject,
  key: string,
  method: string,
): FileStat[]!CapabilityError {
  return try requireArray(object, key, method, requireFileStat)
}

effect function requireFileStat(value: JsonValue, method: string): FileStat!CapabilityError {
  const object = try requireObject(value, method)
  const kind = try requireString(object, "kind", method)
  if (
    kind !== "file"
    && kind !== "directory"
    && kind !== "symlink"
    && kind !== "other"
  ) {
    throw decodeError(method, "kind must be a valid file entry kind.")
  }
  const modifiedAt = try optionalString(object, "modifiedAt", method)
  const isText = try optionalBoolean(object, "isText", method)
  return {
    path: try requireString(object, "path", method),
    name: try requireString(object, "name", method),
    kind,
    size: try requireNumber(object, "size", method),
    ...(modifiedAt === undefined ? {} : { modifiedAt }),
    ...(isText === undefined ? {} : { isText }),
  }
}

effect function requireStringArray(
  object: JsonObject,
  key: string,
  method: string,
): string[]!CapabilityError {
  const value = object[key]
  if (
    Array.isArray(value)
    && value.every((entry) => typeof entry === "string")
  ) {
    return value
  }
  throw decodeError(method, `${key} must be a string array.`)
}

effect function optionalStringArray(
  object: JsonObject,
  key: string,
  method: string,
): (string[] | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (
    Array.isArray(value)
    && value.every((entry) => typeof entry === "string")
  ) {
    return value
  }
  throw decodeError(method, `${key} must be a string array when present.`)
}

export effect function optionalStringRecord(
  object: JsonObject,
  key: string,
  method: string,
): (Record<string, string> | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (
    isJsonObject(value)
    && Object.values(value).every((entry) => typeof entry === "string")
  ) {
    return value as Record<string, string>
  }
  throw decodeError(method, `${key} must be a string record when present.`)
}

export effect function nullableNumber(
  object: JsonObject,
  key: string,
  method: string,
): (number | null)!CapabilityError {
  const value = object[key]
  if (value === null) return null
  if (typeof value === "number" && Number.isFinite(value)) return value
  throw decodeError(method, `${key} must be a finite number or null.`)
}

effect function optionalNullableNumber(
  object: JsonObject,
  key: string,
  method: string,
): (number | null | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (value === null) return null
  if (typeof value === "number" && Number.isFinite(value)) return value
  throw decodeError(
    method,
    `${key} must be a finite number or null when present.`,
  )
}

effect function optionalNullableString(
  object: JsonObject,
  key: string,
  method: string,
): (string | null | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (value === null) return null
  if (typeof value === "string") return value
  throw decodeError(method, `${key} must be a string or null when present.`)
}

export effect function requireBoolean(
  object: JsonObject,
  key: string,
  method: string,
): boolean!CapabilityError {
  const value = object[key]
  if (typeof value === "boolean") return value
  throw decodeError(method, `${key} must be a boolean.`)
}

export effect function optionalBoolean(
  object: JsonObject,
  key: string,
  method: string,
): (boolean | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (typeof value === "boolean") return value
  throw decodeError(method, `${key} must be a boolean when present.`)
}

effect function optionalSurfaceManifest(
  object: JsonObject,
  key: string,
  method: string,
): (RemotePluginSurfaceManifest | undefined)!CapabilityError {
  const value = try optionalJsonObject(object, key, method)
  if (value === undefined) return undefined

  const background = try optionalString(value, "background", `${method}.${key}`)
  if (
    background !== undefined
    && background !== "opaque"
    && background !== "shared"
  ) {
    throw decodeError(
      method,
      `${key}.background must be "opaque" or "shared".`,
    )
  }

  const header = try optionalString(value, "header", `${method}.${key}`)
  if (
    header !== undefined
    && header !== "normal"
    && header !== "fullscreen"
    && header !== "modal"
    && header !== "immersive"
  ) {
    throw decodeError(
      method,
      `${key}.header must be "normal", "fullscreen", "modal", or "immersive".`,
    )
  }

  const isolation = try optionalString(value, "isolation", `${method}.${key}`)
  if (
    isolation !== undefined
    && isolation !== "in-process"
    && isolation !== "sandboxed-iframe"
    && isolation !== "native-webview"
    && isolation !== "immersive"
  ) {
    throw decodeError(method, `${key}.isolation is not supported.`)
  }

  const lifecycle = try optionalString(value, "lifecycle", `${method}.${key}`)
  if (
    lifecycle !== undefined
    && lifecycle !== "ephemeral"
    && lifecycle !== "retained"
  ) {
    throw decodeError(
      method,
      `${key}.lifecycle must be "ephemeral" or "retained".`,
    )
  }

  const capabilities = try optionalSurfaceCapabilities(
    value,
    "capabilities",
    `${method}.${key}`,
  )
  const layout = try optionalPageLayoutManifest(
    value,
    "layout",
    `${method}.${key}`,
  )

  return {
    ...(background === undefined ? {} : { background }),
    ...(header === undefined ? {} : { header }),
    ...(isolation === undefined ? {} : { isolation }),
    ...(lifecycle === undefined ? {} : { lifecycle }),
    ...(capabilities === undefined ? {} : { capabilities }),
    ...(layout === undefined ? {} : { layout }),
  }
}

effect function optionalPageLayoutManifest(
  object: JsonObject,
  key: string,
  method: string,
): (PageLayoutManifest | undefined)!CapabilityError {
  const value = try optionalJsonObject(object, key, method)
  if (value === undefined) return undefined
  const kind = try requireString(value, "kind", `${method}.${key}`)
  const width = try requireString(value, "width", `${method}.${key}`)
  const scroll = try requireString(value, "scroll", `${method}.${key}`)
  const topology = try optionalString(value, "topology", `${method}.${key}`)
  const gutter = try optionalString(value, "gutter", `${method}.${key}`)
  if (
    topology !== undefined
    && topology !== "framed"
    && topology !== "ambient"
  ) {
    throw decodeError(method, `${key}.topology must be "framed" or "ambient".`)
  }
  if (gutter !== undefined && gutter !== "standard" && gutter !== "none") {
    throw decodeError(method, `${key}.gutter must be "standard" or "none".`)
  }
  if (
    kind === "content"
    && ["reading", "standard", "wide"].includes(width)
    && (scroll === "shell" || scroll === "view")
  ) {
    return {
      kind,
      ...(topology === undefined ? {} : { topology }),
      width: width as "reading" | "standard" | "wide",
      scroll,
      ...(gutter === undefined ? {} : { gutter }),
    }
  }
  if (
    kind === "workspace"
    && ["wide", "full"].includes(width)
    && scroll === "view"
  ) {
    return {
      kind,
      ...(topology === undefined ? {} : { topology }),
      width: width as "wide" | "full",
      scroll,
      ...(gutter === undefined ? {} : { gutter }),
    }
  }
  if (
    kind === "immersive"
    && width === "full"
    && scroll === "view"
    && gutter === "none"
  ) {
    return {
      kind,
      ...(topology === undefined ? {} : { topology }),
      width,
      scroll,
      gutter,
    }
  }
  throw decodeError(method, `${key} is not a valid page layout manifest.`)
}

const SURFACE_CAPABILITIES: ReadonlySet<string> = new Set<SurfaceCapability>([
  "wallpaper",
  "background:apply",
  "navigate",
  "storage",
  "agent-surface",
])

effect function optionalSurfaceCapabilities(
  object: JsonObject,
  key: string,
  method: string,
): (SurfaceCapability[] | undefined)!CapabilityError {
  const values = try optionalStringArray(object, key, method)
  if (values === undefined) return undefined
  const capabilities: SurfaceCapability[] = []
  for (const value of values) {
    if (!SURFACE_CAPABILITIES.has(value)) {
      throw decodeError(method, `${key} contains unsupported capability.`)
    }
    capabilities.push(value as SurfaceCapability)
  }
  return capabilities
}

export effect function requireResponseHandlerFieldEffect(
  value: JsonValue,
  method: string,
): NonNullable<PluginResponseHandlerFieldEvaluatorHandleResult["effect"]>!CapabilityError {
  const object = try requireObject(value, method)
  const patch = try optionalJsonObject(object, "patch", method)
  const preempt = object.preempt === undefined
    ? undefined
    : try requireResponseHandlerFieldPreempt(object.preempt, `${method}.preempt`)
  const debug = try optionalStringArray(object, "debug", method)
  return {
    ...(patch === undefined ? {} : { patch }),
    ...(preempt === undefined ? {} : { preempt }),
    ...(debug === undefined ? {} : { debug }),
  }
}

effect function requireResponseHandlerFieldPreempt(
  value: JsonValue,
  method: string,
): NonNullable<NonNullable<PluginResponseHandlerFieldEvaluatorHandleResult["effect"]>["preempt"]>!CapabilityError {
  const object = try requireObject(value, method)
  const mode = try requireString(object, "mode", method)
  if (mode !== "ack-and-stop" && mode !== "ignore" && mode !== "direct-reply") {
    throw decodeError(method, "preempt.mode is not supported.")
  }
  return {
    mode,
    reason: try requireString(object, "reason", method),
  }
}

export effect function requireGitOperation(
  value: JsonValue | undefined,
  method: string,
): GitOperation!CapabilityError {
  const object = try requireObject(value, method)
  const status = try requireString(object, "status", method)
  if (status !== "running" && status !== "completed" && status !== "failed") {
    throw decodeError(method, "status must be a valid Git operation status.")
  }
  const exitCode = try optionalNullableNumber(object, "exitCode", method)
  const signal = try optionalNullableString(object, "signal", method)
  const completedAt = try optionalString(object, "completedAt", method)
  const error = try optionalString(object, "error", method)
  return {
    id: try requireString(object, "id", method),
    name: try requireString(object, "name", method),
    cwd: try requireString(object, "cwd", method),
    command: try requireStringArray(object, "command", method),
    status,
    stdout: try requireString(object, "stdout", method),
    stderr: try requireString(object, "stderr", method),
    ...(exitCode === undefined ? {} : { exitCode }),
    ...(signal === undefined ? {} : { signal }),
    startedAt: try requireString(object, "startedAt", method),
    ...(completedAt === undefined ? {} : { completedAt }),
    ...(error === undefined ? {} : { error }),
  }
}

export effect function requireRemotePluginModuleArray(
  object: JsonObject,
  key: string,
  method: string,
): RemotePluginModuleManifest[]!CapabilityError {
  return try requireArray(object, key, method, requireRemotePluginModule)
}

effect function requireRemotePluginModule(
  value: JsonValue,
  method: string,
): RemotePluginModuleManifest!CapabilityError {
  const object = try requireObject(value, method)
  const capabilityEndpointId = try optionalString(
    object,
    "capabilityEndpointId",
    method,
  )
  const version = try optionalString(object, "version", method)
  const description = try optionalString(object, "description", method)
  const priority = try optionalNumber(object, "priority", method)
  const contexts = try optionalStringArray(object, "contexts", method)
  const config = try optionalRemotePluginConfig(object, "config", method)
  const schema = try optionalJsonObject(object, "schema", method)
  const actions = try optionalArray(
    object,
    "actions",
    method,
    requireRemotePluginAction,
  )
  const providers = try optionalArray(
    object,
    "providers",
    method,
    requireRemotePluginProvider,
  )
  const evaluators = try optionalArray(
    object,
    "evaluators",
    method,
    requireRemotePluginEvaluator,
  )
  const responseHandlerEvaluators = try optionalArray(
    object,
    "responseHandlerEvaluators",
    method,
    requireRemotePluginResponseHandlerEvaluator,
  )
  const responseHandlerFieldEvaluators = try optionalArray(
    object,
    "responseHandlerFieldEvaluators",
    method,
    requireRemotePluginResponseHandlerFieldEvaluator,
  )
  const events = try optionalArray(
    object,
    "events",
    method,
    requireRemotePluginEvent,
  )
  const models = try optionalArray(
    object,
    "models",
    method,
    requireRemotePluginModel,
  )
  const services = try optionalArray(
    object,
    "services",
    method,
    requireRemotePluginService,
  )
  const componentTypes = try optionalArray(
    object,
    "componentTypes",
    method,
    requireRemotePluginComponentType,
  )
  const widgets = try optionalArray(
    object,
    "widgets",
    method,
    requireRemotePluginWidget,
  )
  const app = object.app === undefined
    ? undefined
    : try requireRemotePluginApp(object.app, `${method}.app`)
  const appBridge = object.appBridge === undefined
    ? undefined
    : try requireHooks(object.appBridge, `${method}.appBridge`, isRemotePluginAppBridgeHook, "plugin app bridge")
  const lifecycle = object.lifecycle === undefined
    ? undefined
    : try requireHooks(object.lifecycle, `${method}.lifecycle`, isRemotePluginLifecycleHook, "plugin lifecycle")
  const routes = try optionalArray(
    object,
    "routes",
    method,
    requireRemotePluginRoute,
  )
  const views = try optionalArray(object, "views", method, requireRemotePluginView)
  const provenance = object.provenance === undefined
    ? undefined
    : try requireRemotePluginModuleProvenance(
      object.provenance,
      `${method}.provenance`,
    )
  const metadata = try optionalJsonObject(object, "metadata", method)
  return {
    id: try requireRemotePluginModuleId(object, "id", method),
    name: try requireNonEmptyString(object, "name", method),
    ...(capabilityEndpointId === undefined ? {} : { capabilityEndpointId }),
    ...(version === undefined ? {} : { version }),
    ...(description === undefined ? {} : { description }),
    ...(priority === undefined ? {} : { priority }),
    ...(contexts === undefined ? {} : { contexts }),
    ...(config === undefined ? {} : { config }),
    ...(schema === undefined ? {} : { schema }),
    ...(actions === undefined ? {} : { actions }),
    ...(providers === undefined ? {} : { providers }),
    ...(evaluators === undefined ? {} : { evaluators }),
    ...(responseHandlerEvaluators === undefined
      ? {}
      : { responseHandlerEvaluators }),
    ...(responseHandlerFieldEvaluators === undefined
      ? {}
      : { responseHandlerFieldEvaluators }),
    ...(events === undefined ? {} : { events }),
    ...(models === undefined ? {} : { models }),
    ...(services === undefined ? {} : { services }),
    ...(componentTypes === undefined ? {} : { componentTypes }),
    ...(widgets === undefined ? {} : { widgets }),
    ...(app === undefined ? {} : { app }),
    ...(appBridge === undefined ? {} : { appBridge }),
    ...(lifecycle === undefined ? {} : { lifecycle }),
    ...(routes === undefined ? {} : { routes }),
    ...(views === undefined ? {} : { views }),
    ...(provenance === undefined ? {} : { provenance }),
    ...(metadata === undefined ? {} : { metadata }),
  }
}

effect function requireRemotePluginModuleProvenance(
  value: JsonValue,
  method: string,
): RemotePluginModuleProvenance!CapabilityError {
  const object = try requireObject(value, method)
  const digestSha256 = try requireNonEmptyString(object, "digestSha256", method)
  if (!/^[0-9a-f]{64}$/i.test(digestSha256)) {
    throw decodeError(method, "digestSha256 must be a SHA-256 hex digest.")
  }
  return {
    issuer: try requireNonEmptyString(object, "issuer", method),
    subject: try requireNonEmptyString(object, "subject", method),
    digestSha256: digestSha256.toLowerCase(),
    signatureAlgorithm: try requireNonEmptyString(
      object,
      "signatureAlgorithm",
      method,
    ),
    signature: try requireNonEmptyString(object, "signature", method),
  }
}

effect function optionalArray<T>(
  object: JsonObject,
  key: string,
  method: string,
  decode: (value: JsonValue, method: string) => T!CapabilityError,
): (T[] | undefined)!CapabilityError {
  const value = object[key]
  if (value === undefined) return undefined
  if (!Array.isArray(value)) {
    throw decodeError(method, `${key} must be an array when present.`)
  }
  return try decodeEntries(value, `${method}.${key}`, decode)
}

effect function requireRemotePluginAction(
  value: JsonValue,
  method: string,
): RemotePluginActionManifest!CapabilityError {
  const object = try requireObject(value, method)
  const descriptionCompressed = try optionalString(
    object,
    "descriptionCompressed",
    method,
  )
  const similes = try optionalStringArray(object, "similes", method)
  return {
    name: try requireNonEmptyString(object, "name", method),
    description: try requireNonEmptyString(object, "description", method),
    ...(descriptionCompressed === undefined ? {} : { descriptionCompressed }),
    ...(similes === undefined ? {} : { similes }),
    ...(object.parameters === undefined
      ? {}
      : { parameters: object.parameters }),
  }
}

effect function requireRemotePluginProvider(
  value: JsonValue,
  method: string,
): RemotePluginProviderManifest!CapabilityError {
  const object = try requireObject(value, method)
  const description = try optionalString(object, "description", method)
  const descriptionCompressed = try optionalString(
    object,
    "descriptionCompressed",
    method,
  )
  const dynamic = try optionalBoolean(object, "dynamic", method)
  const isPrivate = try optionalBoolean(object, "private", method)
  return {
    name: try requireNonEmptyString(object, "name", method),
    ...(description === undefined ? {} : { description }),
    ...(descriptionCompressed === undefined ? {} : { descriptionCompressed }),
    ...(dynamic === undefined ? {} : { dynamic }),
    ...(isPrivate === undefined ? {} : { private: isPrivate }),
  }
}

effect function requireRemotePluginEvaluator(
  value: JsonValue,
  method: string,
): RemotePluginEvaluatorManifest!CapabilityError {
  const object = try requireObject(value, method)
  const similes = try optionalStringArray(object, "similes", method)
  const priority = try optionalNumber(object, "priority", method)
  const providers = try optionalStringArray(object, "providers", method)
  const modelType = try optionalString(object, "modelType", method)
  const hasPrepare = try optionalBoolean(object, "hasPrepare", method)
  const hasProcessor = try optionalBoolean(object, "hasProcessor", method)
  return {
    name: try requireNonEmptyString(object, "name", method),
    description: try requireNonEmptyString(object, "description", method),
    prompt: try requireNonEmptyString(object, "prompt", method),
    ...(similes === undefined ? {} : { similes }),
    ...(priority === undefined ? {} : { priority }),
    ...(providers === undefined ? {} : { providers }),
    schema: try requireJsonObject(object, "schema", method),
    ...(modelType === undefined ? {} : { modelType }),
    ...(hasPrepare === undefined ? {} : { hasPrepare }),
    ...(hasProcessor === undefined ? {} : { hasProcessor }),
  }
}

effect function requireRemotePluginResponseHandlerEvaluator(
  value: JsonValue,
  method: string,
): RemotePluginResponseHandlerEvaluatorManifest!CapabilityError {
  const object = try requireObject(value, method)
  const description = try optionalString(object, "description", method)
  const priority = try optionalNumber(object, "priority", method)
  return {
    name: try requireNonEmptyString(object, "name", method),
    ...(description === undefined ? {} : { description }),
    ...(priority === undefined ? {} : { priority }),
  }
}

effect function requireRemotePluginResponseHandlerFieldEvaluator(
  value: JsonValue,
  method: string,
): RemotePluginResponseHandlerFieldEvaluatorManifest!CapabilityError {
  const object = try requireObject(value, method)
  const priority = try optionalNumber(object, "priority", method)
  const hasParse = try optionalBoolean(object, "hasParse", method)
  const hasHandle = try optionalBoolean(object, "hasHandle", method)
  return {
    name: try requireNonEmptyString(object, "name", method),
    description: try requireNonEmptyString(object, "description", method),
    schema: try requireObject(object.schema, `${method}.schema`),
    ...(priority === undefined ? {} : { priority }),
    ...(hasParse === undefined ? {} : { hasParse }),
    ...(hasHandle === undefined ? {} : { hasHandle }),
  }
}

effect function requireRemotePluginEvent(
  value: JsonValue,
  method: string,
): RemotePluginEventManifest!CapabilityError {
  const object = try requireObject(value, method)
  return {
    eventName: try requireNonEmptyString(object, "eventName", method),
  }
}

effect function requireRemotePluginModel(
  value: JsonValue,
  method: string,
): RemotePluginModelManifest!CapabilityError {
  const object = try requireObject(value, method)
  const priority = try optionalNumber(object, "priority", method)
  return {
    modelType: try requireNonEmptyString(object, "modelType", method),
    ...(priority === undefined ? {} : { priority }),
  }
}

effect function requireRemotePluginService(
  value: JsonValue,
  method: string,
): RemotePluginServiceManifest!CapabilityError {
  const object = try requireObject(value, method)
  const capabilityDescription = try optionalString(
    object,
    "capabilityDescription",
    method,
  )
  const methods = try optionalStringArray(object, "methods", method)
  try validateRemotePluginServiceMethods(methods, method)
  const config = try optionalJsonObject(object, "config", method)
  return {
    serviceType: try requireNonEmptyString(object, "serviceType", method),
    ...(capabilityDescription === undefined ? {} : { capabilityDescription }),
    ...(methods === undefined ? {} : { methods }),
    ...(config === undefined ? {} : { config }),
  }
}

effect function requireRemotePluginComponentType(
  value: JsonValue,
  method: string,
): RemotePluginComponentTypeManifest!CapabilityError {
  const object = try requireObject(value, method)
  return {
    name: try requireNonEmptyString(object, "name", method),
    schema: try requireRemotePluginJsonSchemaDefinition(
      object.schema,
      `${method}.schema`,
    ),
  }
}

effect function requireRemotePluginJsonSchemaDefinition(
  value: JsonValue,
  method: string,
): RemotePluginJsonSchemaDefinition!CapabilityError {
  const object = try requireObject(value, method)
  const propertiesValue = object.properties
  const properties = propertiesValue === undefined
    ? undefined
    : try requireRemotePluginJsonSchemaProperties(propertiesValue, method)
  const items = object.items === undefined
    ? undefined
    : try requireRemotePluginJsonSchemaDefinition(
      object.items,
      `${method}.items`,
    )
  const required = try optionalStringArray(object, "required", method)
  const enumValues = try optionalStringArray(object, "enumValues", method)
  const description = try optionalString(object, "description", method)
  return {
    type: try requireNonEmptyString(object, "type", method),
    ...(properties === undefined ? {} : { properties }),
    ...(items === undefined ? {} : { items }),
    ...(required === undefined ? {} : { required }),
    ...(enumValues === undefined ? {} : { enumValues }),
    ...(description === undefined ? {} : { description }),
  }
}

effect function requireRemotePluginJsonSchemaProperties(
  value: JsonValue,
  method: string,
): Record<string, RemotePluginJsonSchemaDefinition>!CapabilityError {
  const object = try requireObject(value, `${method}.properties`)
  const properties: Record<string, RemotePluginJsonSchemaDefinition> = {}
  for (const [key, property] of Object.entries(object)) {
    properties[key] = try requireRemotePluginJsonSchemaDefinition(
      property,
      `${method}.properties.${key}`,
    )
  }
  return properties
}

const REMOTE_SERVICE_RESERVED_METHODS = new Set([
  "callRemote",
  "constructor",
  "hasOwnProperty",
  "isPrototypeOf",
  "propertyIsEnumerable",
  "toLocaleString",
  "toString",
  "valueOf",
  "__defineGetter__",
  "__defineSetter__",
  "__lookupGetter__",
  "__lookupSetter__",
  "__proto__",
])

export effect function validateRemotePluginServiceMethods(
  methods: string[] | undefined,
  method: string,
): void!CapabilityError {
  if (methods === undefined) return
  const seen = new Set<string>()
  for (const serviceMethod of methods) {
    if (!/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(serviceMethod)) {
      throw decodeError(
        method,
        "methods must contain valid JavaScript method identifiers.",
      )
    }
    if (seen.has(serviceMethod)) {
      throw decodeError(
        method,
        "methods must not contain duplicate method names.",
      )
    }
    seen.add(serviceMethod)
    if (REMOTE_SERVICE_RESERVED_METHODS.has(serviceMethod)) {
      throw decodeError(
        method,
        "methods must not include reserved local service method names.",
      )
    }
  }
}

export effect function validateRemotePluginCallTarget(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  if (typeof value !== "string" || value.trim().length === 0) {
    throw decodeError(method, `${key} must be a non-empty string.`)
  }
  if (key === "moduleId") {
    try validateRemotePluginModuleId(value, key, method)
  }
}

effect function validateRemotePluginModuleId(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  if (!/^[A-Za-z0-9._-]+$/.test(value)) {
    throw decodeError(
      method,
      `${key} must use letters, numbers, dots, underscores, or hyphens.`,
    )
  }
}

effect function optionalViewKind(
  object: JsonObject,
  method: string,
): (ViewKind | undefined)!CapabilityError {
  const value = try optionalString(object, "viewKind", method)
  if (
    value === undefined
    || value === "system"
    || value === "release"
    || value === "developer"
    || value === "preview"
  ) {
    return value
  }
  throw decodeError(
    method,
    "viewKind must be system, release, developer, or preview.",
  )
}

effect function requireRemotePluginWidget(
  value: JsonValue,
  method: string,
): RemotePluginWidgetManifest!CapabilityError {
  const object = try requireObject(value, method)
  const slot = try requireString(object, "slot", method)
  if (slot !== "chat-sidebar" && slot !== "character" && slot !== "nav-page") {
    throw decodeError(method, "slot must be a valid plugin widget slot.")
  }
  const pluginId = try optionalNonEmptyString(object, "pluginId", method)
  const icon = try optionalString(object, "icon", method)
  const order = try optionalNumber(object, "order", method)
  const defaultEnabled = try optionalBoolean(object, "defaultEnabled", method)
  const navGroup = try optionalString(object, "navGroup", method)
  const viewKind = try optionalViewKind(object, method)
  const componentExport = try optionalString(object, "componentExport", method)
  return {
    id: try requireNonEmptyString(object, "id", method),
    ...(pluginId === undefined ? {} : { pluginId }),
    slot,
    label: try requireNonEmptyString(object, "label", method),
    ...(icon === undefined ? {} : { icon }),
    ...(order === undefined ? {} : { order }),
    ...(defaultEnabled === undefined ? {} : { defaultEnabled }),
    ...(navGroup === undefined ? {} : { navGroup }),
    ...(viewKind === undefined ? {} : { viewKind }),
    ...(componentExport === undefined ? {} : { componentExport }),
  }
}

effect function requireRemotePluginApp(
  value: JsonValue,
  method: string,
): RemotePluginAppManifest!CapabilityError {
  const object = try requireObject(value, method)
  const displayName = try optionalNonEmptyString(object, "displayName", method)
  const category = try optionalString(object, "category", method)
  const launchType = try optionalString(object, "launchType", method)
  const launchUrl = try optionalNullableString(object, "launchUrl", method)
  if (typeof launchUrl === "string") {
    try validateRemotePluginBrowserUrl(launchUrl, "launchUrl", method)
  }
  const icon = try optionalNullableString(object, "icon", method)
  const capabilities = try optionalStringArray(object, "capabilities", method)
  const minPlayers = try optionalNullableNumber(object, "minPlayers", method)
  const maxPlayers = try optionalNullableNumber(object, "maxPlayers", method)
  const runtimePlugin = try optionalString(object, "runtimePlugin", method)
  const viewer = object.viewer === undefined
    ? undefined
    : try requireRemotePluginAppViewer(object.viewer, `${method}.viewer`)
  const session = object.session === undefined
    ? undefined
    : try requireRemotePluginAppSession(object.session, `${method}.session`)
  const bridgeExport = try optionalString(object, "bridgeExport", method)
  const uiExtension = object.uiExtension === undefined
    ? undefined
    : try requireRemotePluginAppUiExtension(
      object.uiExtension,
      `${method}.uiExtension`,
    )
  const viewKind = try optionalViewKind(object, method)
  const visibleInAppStore = try optionalBoolean(
    object,
    "visibleInAppStore",
    method,
  )
  const navTabs = try optionalArray(
    object,
    "navTabs",
    method,
    requireRemotePluginAppNavTab,
  )
  return {
    ...(displayName === undefined ? {} : { displayName }),
    ...(category === undefined ? {} : { category }),
    ...(launchType === undefined ? {} : { launchType }),
    ...(launchUrl === undefined ? {} : { launchUrl }),
    ...(icon === undefined ? {} : { icon }),
    ...(capabilities === undefined ? {} : { capabilities }),
    ...(minPlayers === undefined ? {} : { minPlayers }),
    ...(maxPlayers === undefined ? {} : { maxPlayers }),
    ...(runtimePlugin === undefined ? {} : { runtimePlugin }),
    ...(viewer === undefined ? {} : { viewer }),
    ...(session === undefined ? {} : { session }),
    ...(bridgeExport === undefined ? {} : { bridgeExport }),
    ...(uiExtension === undefined ? {} : { uiExtension }),
    ...(viewKind === undefined ? {} : { viewKind }),
    ...(visibleInAppStore === undefined ? {} : { visibleInAppStore }),
    ...(navTabs === undefined ? {} : { navTabs }),
  }
}

effect function requireRemotePluginAppViewer(
  value: JsonValue,
  method: string,
): RemotePluginAppViewerManifest!CapabilityError {
  const object = try requireObject(value, method)
  const embedParams = try optionalStringRecord(object, "embedParams", method)
  const postMessageAuth = try optionalBoolean(object, "postMessageAuth", method)
  const sandbox = try optionalString(object, "sandbox", method)
  const url = try requireNonEmptyString(object, "url", method)
  try validateRemotePluginBrowserUrl(url, "url", method)
  return {
    url,
    ...(embedParams === undefined ? {} : { embedParams }),
    ...(postMessageAuth === undefined ? {} : { postMessageAuth }),
    ...(sandbox === undefined ? {} : { sandbox }),
  }
}

effect function validateRemotePluginBrowserUrl(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  if (isBrowserUrl(value)) return
  throw decodeError(
    method,
    `${key} must be an absolute http(s) URL without embedded credentials.`,
  )
}

function isBrowserUrl(value: string): boolean {
  try {
    const parsed = new URL(value)
    return (parsed.protocol === "http:" || parsed.protocol === "https:")
      && !parsed.username
      && !parsed.password
  } catch {
    return false
  }
}

effect function requireRemotePluginAppSession(
  value: JsonValue,
  method: string,
): RemotePluginAppSessionManifest!CapabilityError {
  const object = try requireObject(value, method)
  const mode = try requireString(object, "mode", method)
  if (
    mode !== "viewer"
    && mode !== "spectate-and-steer"
    && mode !== "external"
  ) {
    throw decodeError(method, "mode must be a valid plugin app session mode.")
  }
  const features = try optionalStringArray(object, "features", method)
  if (
    features?.some(
      (feature) =>
        feature !== "commands"
        && feature !== "telemetry"
        && feature !== "pause"
        && feature !== "resume"
        && feature !== "suggestions",
    )
  ) {
    throw decodeError(
      method,
      "features must be valid plugin app session features.",
    )
  }
  return {
    mode,
    ...(features === undefined
      ? {}
      : {
        features: features as RemotePluginAppSessionManifest["features"],
      }),
  }
}

effect function requireRemotePluginAppUiExtension(
  value: JsonValue,
  method: string,
): NonNullable<RemotePluginAppManifest["uiExtension"]>!CapabilityError {
  const object = try requireObject(value, method)
  const detailPanelId = try optionalString(object, "detailPanelId", method)
  return {
    ...(detailPanelId === undefined ? {} : { detailPanelId }),
  }
}

effect function requireRemotePluginAppNavTab(
  value: JsonValue,
  method: string,
): RemotePluginAppNavTabManifest!CapabilityError {
  const object = try requireObject(value, method)
  const icon = try optionalString(object, "icon", method)
  const order = try optionalNumber(object, "order", method)
  const viewKind = try optionalViewKind(object, method)
  const group = try optionalString(object, "group", method)
  const surface = try optionalSurfaceManifest(object, "surface", method)
  const componentExport = try optionalString(object, "componentExport", method)
  const path = try requireNonEmptyString(object, "path", method)
  try validateRemotePluginPath(path, "path", method)
  return {
    id: try requireNonEmptyString(object, "id", method),
    label: try requireNonEmptyString(object, "label", method),
    ...(icon === undefined ? {} : { icon }),
    path,
    ...(order === undefined ? {} : { order }),
    ...(viewKind === undefined ? {} : { viewKind }),
    ...(group === undefined ? {} : { group }),
    ...(surface === undefined ? {} : { surface }),
    ...(componentExport === undefined ? {} : { componentExport }),
  }
}

effect function requireHooks<Hook extends string>(
  value: JsonValue,
  method: string,
  isHook: (hook: string) => hook is Hook,
  kind: string,
): { hooks: Hook[] }!CapabilityError {
  const object = try requireObject(value, method)
  const hooks = try requireStringArray(object, "hooks", method)
  if (hooks.length === 0) {
    throw decodeError(method, "hooks must not be empty.")
  }
  if (hooks.some((hook) => !isHook(hook))) {
    throw decodeError(method, `hooks must be valid ${kind} hooks.`)
  }
  return {
    hooks: hooks as Hook[],
  }
}

export function isRemotePluginAppBridgeHook(
  value: string,
): value is RemotePluginAppBridgeHook {
  return (
    value === "prepareLaunch"
    || value === "resolveViewerAuthMessage"
    || value === "ensureRuntimeReady"
    || value === "collectLaunchDiagnostics"
    || value === "resolveLaunchSession"
    || value === "refreshRunSession"
    || value === "stopRun"
    || value === "handleAppRoutes"
  )
}

export function isRemotePluginLifecycleHook(
  value: string,
): value is RemotePluginLifecycleHook {
  return value === "init" || value === "dispose" || value === "applyConfig"
}

effect function requireRemotePluginRoute(
  value: JsonValue,
  method: string,
): RemotePluginRouteManifest!CapabilityError {
  const object = try requireObject(value, method)
  const routeMethod = try validateRemotePluginRouteMethod(
    try requireString(object, "method", method),
    "method",
    method,
    true,
  )
  const name = try optionalString(object, "name", method)
  const isPublic = try optionalBoolean(object, "public", method)
  const publicReason = try optionalString(object, "publicReason", method)
  const publicWrite = try optionalString(object, "publicWrite", method)
  const description = try optionalString(object, "description", method)
  const path = try requireNonEmptyString(object, "path", method)
  try validateRemotePluginPath(path, "path", method)
  if (isPublic === true && !publicReason?.trim()) {
    throw decodeError(
      method,
      "publicReason must be a non-empty string for public routes.",
    )
  }
  return {
    method: routeMethod,
    path,
    ...(name === undefined ? {} : { name }),
    ...(isPublic === undefined ? {} : { public: isPublic }),
    ...(publicReason === undefined ? {} : { publicReason }),
    ...(publicWrite === undefined ? {} : { publicWrite }),
    ...(description === undefined ? {} : { description }),
  }
}

export effect function validateRemotePluginRouteMethod(
  value: string,
  key: string,
  method: string,
  allowStatic: boolean,
): RemotePluginRouteManifest["method"]!CapabilityError {
  if (
    value === "GET"
    || value === "POST"
    || value === "PUT"
    || value === "PATCH"
    || value === "DELETE"
    || (allowStatic && value === "STATIC")
  ) {
    return value
  }
  throw decodeError(method, `${key} must be a valid plugin route method.`)
}

export effect function validateRemotePluginPath(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  if (
    !value.startsWith("/")
    || value.startsWith("//")
    || value.includes("?")
    || value.includes("#")
    || value.includes("\\")
    || /^[a-zA-Z][a-zA-Z\d+.-]*:/.test(value)
  ) {
    throw decodeError(
      method,
      `${key} must be an absolute app path without URL scheme, query, hash, or backslash.`,
    )
  }
  const segments = value === "/" ? [] : value.split("/").slice(1)
  if (
    segments.some((segment) => segment === "." || segment === ".." || !segment)
  ) {
    throw decodeError(
      method,
      `${key} must not contain empty, current-directory, or parent-directory segments.`,
    )
  }
}

effect function requireRemotePluginView(
  value: JsonValue,
  method: string,
): RemotePluginViewManifest!CapabilityError {
  const object = try requireObject(value, method)
  const viewKind = try optionalViewKind(object, method)
  const viewType = try optionalString(object, "viewType", method)
  if (
    viewType !== undefined
    && viewType !== "gui"
    && viewType !== "tui"
    && viewType !== "xr"
  ) {
    throw decodeError(method, "viewType must be gui, tui, or xr when present.")
  }
  const bundlePath = try optionalNonEmptyString(object, "bundlePath", method)
  const bundleUrl = try optionalNonEmptyString(object, "bundleUrl", method)
  const framePath = try optionalNonEmptyString(object, "framePath", method)
  const frameUrl = try optionalNonEmptyString(object, "frameUrl", method)
  if (bundlePath !== undefined) {
    try validateRemotePluginAssetPath(bundlePath, "bundlePath", method)
  }
  if (bundleUrl !== undefined) {
    try validateRemotePluginBundleUrl(bundleUrl, "bundleUrl", method)
  }
  if (framePath !== undefined) {
    try validateRemotePluginAssetPath(framePath, "framePath", method)
  }
  if (frameUrl !== undefined) {
    try validateRemotePluginBundleUrl(frameUrl, "frameUrl", method)
  }
  const surface = try optionalSurfaceManifest(object, "surface", method)
  const contentType = try optionalString(object, "contentType", method)
  const integrity = try optionalString(object, "integrity", method)
  return {
    id: try requireNonEmptyString(object, "id", method),
    label: try requireNonEmptyString(object, "label", method),
    ...(viewType === undefined ? {} : { viewType }),
    ...(viewKind === undefined ? {} : { viewKind }),
    ...(surface === undefined ? {} : { surface }),
    ...(bundlePath === undefined ? {} : { bundlePath }),
    ...(bundleUrl === undefined ? {} : { bundleUrl }),
    ...(framePath === undefined ? {} : { framePath }),
    ...(frameUrl === undefined ? {} : { frameUrl }),
    ...(contentType === undefined ? {} : { contentType }),
    ...(integrity === undefined ? {} : { integrity }),
  }
}

effect function validateRemotePluginBundleUrl(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  if (value.startsWith("/")) {
    try validateRemotePluginPath(value, key, method)
    return
  }
  try validateRemotePluginBrowserUrl(value, key, method)
}

export effect function validateRemotePluginAssetPath(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  const path = value.trim()
  if (
    !path
    || path.includes("?")
    || path.includes("#")
    || path.includes("\\")
    || path.startsWith("//")
    || /^[a-zA-Z][a-zA-Z\d+.-]*:/.test(path)
  ) {
    throw decodeError(
      method,
      `${key} must be an asset path without query, hash, URL scheme, or backslash.`,
    )
  }
  const segments = path.replace(/^\/+/, "").split("/")
  if (
    segments.length === 0
    || segments.some((segment) => !segment || segment === "." || segment === "..")
  ) {
    throw decodeError(
      method,
      `${key} must not contain empty, current-directory, or parent-directory segments.`,
    )
  }
}

export effect function validateHeaderSafeString(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  if (!isControlSafeString(value)) {
    throw decodeError(method, `${key} must not contain control characters.`)
  }
}

function isControlSafeString(value: string): boolean {
  return !/[\r\n\0]/.test(value)
}

export effect function validateHeaderRecord(
  headers: Record<string, string>,
  key: string,
  method: string,
): void!CapabilityError {
  for (const [headerName, headerValue] of Object.entries(headers)) {
    if (!/^[!#$%&'*+\-.^_`|~0-9A-Za-z]+$/.test(headerName)) {
      throw decodeError(method, `${key} must contain valid header names.`)
    }
    try validateHeaderSafeString(headerValue, key, method)
  }
}

export effect function validateRouteQueryRecord(
  query: Record<string, string | string[]>,
  key: string,
  method: string,
): void!CapabilityError {
  for (const [queryKey, queryValue] of Object.entries(query)) {
    if (!queryKey || !isControlSafeString(queryKey)) {
      throw decodeError(method, `${key} must contain valid query keys.`)
    }
    const values = Array.isArray(queryValue) ? queryValue : [queryValue]
    if (
      values.some(
        (value) => typeof value !== "string" || !isControlSafeString(value),
      )
    ) {
      throw decodeError(method, `${key} must contain valid query values.`)
    }
  }
}

export effect function validateHttpStatusCode(
  value: number,
  key: string,
  method: string,
): void!CapabilityError {
  if (!Number.isInteger(value) || value < 100 || value > 599) {
    throw decodeError(method, `${key} must be an integer HTTP status code.`)
  }
}

export effect function validateBase64String(
  value: string,
  key: string,
  method: string,
): void!CapabilityError {
  if (
    value.length > 0
    && !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(
      value,
    )
  ) {
    throw decodeError(method, `${key} must be valid base64.`)
  }
}

export effect function requirePluginActionResult(
  value: JsonValue | undefined,
  method: string,
): PluginInvokeActionResult!CapabilityError {
  const object = try requireObject(value, method)
  const text = try optionalString(object, "text", method)
  const actions = try optionalStringArray(object, "actions", method)
  return {
    ...(text === undefined ? {} : { text }),
    ...(actions === undefined ? {} : { actions }),
    ...try optionalValuesAndData(object, method),
  }
}

effect function optionalValuesAndData(
  object: JsonObject,
  method: string,
): { values?: JsonObject; data?: JsonObject }!CapabilityError {
  const values = try optionalJsonObject(object, "values", method)
  const data = try optionalJsonObject(object, "data", method)
  return {
    ...(values === undefined ? {} : { values }),
    ...(data === undefined ? {} : { data }),
  }
}

export effect function requirePluginProviderResult(
  value: JsonValue | undefined,
  method: string,
): PluginGetProviderResult!CapabilityError {
  const object = try requireObject(value, method)
  const text = try optionalString(object, "text", method)
  return {
    ...(text === undefined ? {} : { text }),
    ...try optionalValuesAndData(object, method),
  }
}

export function decodeError(method: string, message: string): CapabilityError {
  return new CapabilityError({
    code: "CAPABILITY_DECODE_FAILED",
    message,
    method,
  })
}
