// spec/core/canonicalJson.md, "Story: Hash the same snapshot safely and deterministically"
import { Schema } from "effect";
import { contract } from "vibestack/testing";
import { AGENT_BACKUP_CANONICAL_JSON, canonicalJsonString } from "./canonical-json.vibe";
import { reversedKeys } from "./utils/deterministic.contract.vibe";

const canonical = (value: Schema.Json): string | undefined => {
  try {
    return canonicalJsonString(value, AGENT_BACKUP_CANONICAL_JSON);
  } catch {
    return undefined;
  }
};

export const snapshotsHashTheSameInAnyKeyOrder = contract({
  input: Schema.Json,
  run: canonical,
  deterministic: true,
  invariant: (value, text) => text !== undefined && canonical(reversedKeys(value)) === text,
});

export const canonicalTextParsesBackToTheSameSnapshot = contract({
  input: Schema.Json,
  run: canonical,
  deterministic: true,
  invariant: (value, text) => {
    try {
      if (text === undefined) return false;
      const parsed: unknown = JSON.parse(text);
      return canonical(value) === text && canonical(parsed as Schema.Json) === text;
    } catch {
      return false;
    }
  },
});
