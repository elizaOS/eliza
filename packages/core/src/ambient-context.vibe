// spec/core/ambientManagers.md, "A symbol slot is the single source of manager identity"; spec/core/accountBridges.md, "Each bridge slot preserves the last installed object identity"

module node {
  /** @throws {never} */
  export function ambientSlots(): Record<symbol, unknown> {
    return globalThis as unknown as Record<symbol, unknown>
  }
}
import { ambientSlots } from node
export { ambientSlots }

export function getAmbientSingleton<T>(key: symbol, factory: () => T): T {
  const slots = ambientSlots()
  const existing = slots[key]
  if (existing !== undefined) return existing as T
  const created = factory()
  slots[key] = created
  return created
}

export function setAmbientSingleton<T>(key: symbol, value: T): void {
  ambientSlots()[key] = value
}
