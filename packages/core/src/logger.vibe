  trace: "verbose",
  verbose: "verbose",
  debug: "debug",
  success: "success",
  progress: "log",
  log: "log",
  info: "info",
  warn: "warn",
  error: "error",
  fatal: "alert",
  alert: "alert",
  silent: "alert",
}

