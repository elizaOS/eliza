// spec/core/awarenessRegistry.md, "A registry keeps one ordered contributor and one cache per ID"; spec/core/awareness.md, "Story: Cache each runtime independently and invalidate selected contributors"; spec/core/awarenessRegistry.md, "Story: Register independent awareness contributors"; spec/core/awarenessRegistry.md, "A request uses its contributor's TTL and runtime cache"
import { type Foreign, foreign, foreignSync } from "./edge.vibe"
import type { IAgentRuntime } from "./types/runtime.vibe"
import { toWellFormedUnicode } from "./utils/unicode.vibe"

export const SELF_STATUS_SCHEMA_VERSION = 1

export const DEFAULT_CACHE_TTL_MS = 60_000

export type AwarenessInvalidationEvent =
  | "permission-changed"
  | "plugin-changed"
  | "wallet-updated"
  | "provider-changed"
  | "config-changed"
  | "runtime-restarted"
  | "opinion-updated"

export interface AwarenessContributor {
  id: string

  position: number

  summary: (runtime: IAgentRuntime) => Promise<string>

  detail?: (runtime: IAgentRuntime, level: "brief" | "full") => Promise<string>

  cacheTtl?: number

  invalidateOn?: AwarenessInvalidationEvent[]

  trusted?: boolean
}

const SANITIZE_PATTERNS: RegExp[] = [
  /sk-ant-\S+/gi,
  /sk-\S{20,}/gi,
  /gsk_\S+/gi,
  /xai-\S+/gi,
  /0x[a-fA-F0-9]{64}/gi,
  /[a-fA-F0-9]{64,}/gi,
  /ignore\s+(all\s+)?(previous\s+)?instructions/gi,
  /you are now/gi,
]

function sanitize(input: string): string {
  let output = input
  for (const pattern of SANITIZE_PATTERNS) {
    output = output.replace(pattern, "[REDACTED]")
  }
  return output
}

interface CacheEntry {
  value: string
  expiresAt: number
}

type DetailLevel = "brief" | "full"

export interface AwarenessContributors {
  readonly ordered: AwarenessContributor[]
  readonly ids: Set<string>
  readonly cache: Map<string, WeakMap<IAgentRuntime, CacheEntry>>
}

export error DuplicateAwarenessContributor { message: string }

export effect function registerAwarenessContributor(
  contributors: AwarenessContributors,
  contributor: AwarenessContributor,
): void!DuplicateAwarenessContributor {
  if (contributors.ids.has(contributor.id)) {
    throw new DuplicateAwarenessContributor({
      message: `AwarenessRegistry: duplicate contributor id "${contributor.id}"`,
    })
  }
  contributors.ids.add(contributor.id)
  const idx = contributors.ordered.findIndex((c) => c.position > contributor.position)
  if (idx === -1) {
    contributors.ordered.push(contributor)
  } else {
    contributors.ordered.splice(idx, 0, contributor)
  }
}

export effect function composeAwarenessSummary(
  contributors: AwarenessContributors,
  runtime: IAgentRuntime,
): string!Foreign {
  const lines: string[] = []
  for (const contributor of contributors.ordered) {
    const line = cachedSummary(contributors, contributor, runtime) catch effect (error) => {
      try foreignSync(() => runtime.reportError("AwarenessRegistry.summary", error.cause, { contributorId: contributor.id }))
      return `[${contributor.id}: unavailable]`
    }
    if (line === "") continue
    lines.push(toWellFormedUnicode(contributor.trusted ? line : sanitize(line)))
  }
  return `[Self Status v${SELF_STATUS_SCHEMA_VERSION}]\n${lines.join("\n")}`
}

export effect function awarenessDetail(
  contributors: AwarenessContributors,
  runtime: IAgentRuntime,
  module: string,
  level: DetailLevel,
): string!Foreign {
  if (module === "all") {
    const parts: string[] = []
    for (const contributor of contributors.ordered) {
      parts.push(try readDetail(contributor, runtime, level))
    }
    return parts.join("\n")
  }
  const contributor = contributors.ordered.find((c) => c.id === module)
  if (!contributor) {
    const available = contributors.ordered.map((c) => c.id).join(", ")
    return `[Error: unknown module "${module}". Available: ${available}]`
  }
  return try readDetail(contributor, runtime, level)
}

effect function cachedSummary(
  contributors: AwarenessContributors,
  contributor: AwarenessContributor,
  runtime: IAgentRuntime,
): string!Foreign {
  const ttl = contributor.cacheTtl ?? DEFAULT_CACHE_TTL_MS
  let cache = contributors.cache.get(contributor.id)
  if (!cache) {
    cache = new WeakMap()
    contributors.cache.set(contributor.id, cache)
  }
  const cached = cache.get(runtime)
  const now = try Clock.currentTimeMillis
  if (cached && cached.expiresAt > now) {
    return cached.value
  }
  const value = try foreign(() => contributor.summary(runtime))
  cache.set(runtime, { value, expiresAt: now + ttl })
  return value
}

effect function readDetail(
  contributor: AwarenessContributor,
  runtime: IAgentRuntime,
  level: DetailLevel,
): string!Foreign {
  if (!contributor.detail) {
    return `[${contributor.id}: no detail available]`
  }
  return effect {
    const text = try foreign(() => contributor.detail!(runtime, level))
    return try foreignSync(() => contributor.trusted ? text : sanitize(text))
  } catch effect (error) => {
    try foreignSync(() => runtime.reportError("AwarenessRegistry.detail", error.cause, { contributorId: contributor.id }))
    return `[${contributor.id}: unavailable]`
  }
}

module edge {
  import { asLegacy, runDetached, runDetachedSync } from "./edge.vibe"
  import type { IAgentRuntime } from "./types/runtime.vibe"
  import {
    type AwarenessContributor,
    type AwarenessContributors,
    type AwarenessInvalidationEvent,
    awarenessDetail,
    composeAwarenessSummary,
    registerAwarenessContributor,
  } from "./awareness.vibe"

  export class AwarenessRegistry {
    readonly #contributors: AwarenessContributors = { ordered: [], ids: new Set(), cache: new Map() }

    /** @throws {Error} */
    register(contributor: AwarenessContributor): void {
      runDetachedSync(asLegacy(Error, registerAwarenessContributor(this.#contributors, contributor)))
    }

    /** @throws {never} */
    composeSummary(runtime: IAgentRuntime): Promise<string> {
      return runDetached(composeAwarenessSummary(this.#contributors, runtime))
    }

    /** @throws {never} */
    getDetail(runtime: IAgentRuntime, module: string, level: "brief" | "full"): Promise<string> {
      return runDetached(awarenessDetail(this.#contributors, runtime, module, level))
    }

    /** @throws {never} */
    invalidate(event: AwarenessInvalidationEvent): void {
      for (const contributor of this.#contributors.ordered) {
        if (contributor.invalidateOn?.includes(event)) {
          this.#contributors.cache.delete(contributor.id)
        }
      }
    }
  }
}
import { AwarenessRegistry } from edge
export { AwarenessRegistry }
