// spec/core/protocols.md, "Story: Share canonical values across hosts and plugins"
import { failingAs, thrown } from "../edge.vibe"
import { ElizaError } from "../errors.vibe"
import type { UUID } from "../types/primitives.vibe"
import { stringToUuid } from "./string-to-uuid.vibe"

export const PROJECT_WORLD_PREFIX = "project:"

function projectMemoryScopeError(message: string, code: string, context: Record<string, unknown>): ElizaError {
  return new ElizaError(message, { code, context, severity: "fatal" })
}

function normalizeProjectId(projectId: string | undefined): string | undefined {
  const trimmed = projectId?.trim()
  return trimmed && trimmed.length > 0 ? trimmed : undefined
}

effect function projectWorldId(agentId: UUID, projectId: string) {
  const normalizedProjectId = normalizeProjectId(projectId)
  if (!normalizedProjectId) {
    throw projectMemoryScopeError(
      "projectWorldId: projectId must be a non-empty string",
      "PROJECT_MEMORY_SCOPE_INVALID_PROJECT_ID",
      { projectId },
    )
  }
  if (!agentId || (agentId as string).length === 0) {
    throw projectMemoryScopeError(
      "projectWorldId: agentId must be a non-empty UUID",
      "PROJECT_MEMORY_SCOPE_INVALID_AGENT_ID",
      { agentId },
    )
  }
  return try stringToUuid(`${PROJECT_WORLD_PREFIX}${normalizedProjectId}:${agentId}`)
}

export const projectWorldIdOrThrow = thrown(failingAs(TypeError, projectWorldId, ElizaError))

export interface ProjectScopeOptions {
  agentId: UUID

  projectId?: string
}

export interface WorldScopedFilter {
  worldId?: UUID
  [key: string]: unknown
}

export effect function scopeMemoryFilterToProject<T extends WorldScopedFilter>(filter: T, opts: ProjectScopeOptions) {
  const projectId = normalizeProjectId(opts.projectId)
  if (!projectId) return filter
  const worldId = try projectWorldId(opts.agentId, projectId)
  if (filter.worldId !== undefined && filter.worldId !== worldId) {
    throw projectMemoryScopeError(
      `scopeMemoryFilterToProject: filter.worldId (${filter.worldId}) conflicts with active project world (${worldId}); refusing cross-project read`,
      "PROJECT_MEMORY_SCOPE_FILTER_WORLD_CONFLICT",
      { agentId: opts.agentId, projectId, filterWorldId: filter.worldId, projectWorldId: worldId },
    )
  }
  return { ...filter, worldId }
}

export interface WorldScopedMemory {
  worldId?: UUID | null
  [key: string]: unknown
}

export effect function scopeMemoryToProject<T extends WorldScopedMemory>(memory: T, opts: ProjectScopeOptions) {
  const projectId = normalizeProjectId(opts.projectId)
  if (!projectId) return memory
  const worldId = try projectWorldId(opts.agentId, projectId)
  if (memory.worldId !== undefined && memory.worldId !== worldId) {
    throw projectMemoryScopeError(
      `scopeMemoryToProject: memory.worldId (${memory.worldId}) conflicts with active project world (${worldId}); refusing to write cross-project memory`,
      "PROJECT_MEMORY_SCOPE_MEMORY_WORLD_CONFLICT",
      { agentId: opts.agentId, projectId, memoryWorldId: memory.worldId, projectWorldId: worldId },
    )
  }
  return { ...memory, worldId }
}

export effect function assertMemoriesInProject<T extends WorldScopedMemory>(memories: readonly T[], opts: ProjectScopeOptions) {
  const projectId = normalizeProjectId(opts.projectId)
  if (!projectId) return memories
  const worldId = try projectWorldId(opts.agentId, projectId)
  for (const memory of memories) {
    if (memory.worldId == null) continue
    if (memory.worldId !== worldId) {
      throw projectMemoryScopeError(
        `assertMemoriesInProject: retrieved memory in world ${memory.worldId} does not belong to active project world ${worldId}; refusing cross-project leak`,
        "PROJECT_MEMORY_SCOPE_RETRIEVED_WORLD_CONFLICT",
        { agentId: opts.agentId, projectId, memoryWorldId: memory.worldId, projectWorldId: worldId },
      )
    }
  }
  return memories
}

module edge {
  import { ElizaError } from "../errors.vibe"
  import { asLegacy, runDetachedSync } from "../edge.vibe"
  import {
    assertMemoriesInProject,
    type ProjectScopeOptions,
    scopeMemoryFilterToProject,
    scopeMemoryToProject,
    type WorldScopedFilter,
    type WorldScopedMemory,
  } from "./project-memory-scope.vibe"

  /** @throws {ElizaError} */
  export function scopeMemoryFilterToProjectOrThrow<T extends WorldScopedFilter>(filter: T, opts: ProjectScopeOptions): T {
    return runDetachedSync(asLegacy(TypeError, scopeMemoryFilterToProject(filter, opts), ElizaError))
  }

  /** @throws {ElizaError} */
  export function scopeMemoryToProjectOrThrow<T extends WorldScopedMemory>(memory: T, opts: ProjectScopeOptions): T {
    return runDetachedSync(asLegacy(TypeError, scopeMemoryToProject(memory, opts), ElizaError))
  }

  /** @throws {ElizaError} */
  export function assertMemoriesInProjectOrThrow<T extends WorldScopedMemory>(memories: readonly T[], opts: ProjectScopeOptions): readonly T[] {
    return runDetachedSync(asLegacy(TypeError, assertMemoriesInProject(memories, opts), ElizaError))
  }
}
import { assertMemoriesInProjectOrThrow, scopeMemoryFilterToProjectOrThrow, scopeMemoryToProjectOrThrow } from edge
export { assertMemoriesInProjectOrThrow, scopeMemoryFilterToProjectOrThrow, scopeMemoryToProjectOrThrow }
