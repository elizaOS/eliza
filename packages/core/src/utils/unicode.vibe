// spec/core/unicode.md, "Byte counting combines surrogate pairs and replaces unpaired surrogates"; spec/core/unicode.md, "Prefix and suffix boundaries cannot introduce a split surrogate pair"
import { countCodeUnit, highSurrogate, lowSurrogate } from "../../gen/core__unicode.effect.vibe"
import type { Utf8Counter } from "../../gen/core__unicode.ts"
import { thrown } from "../edge.vibe"
import { elizaErrorOrForeign } from "../errors.vibe"

export function utf8ByteLength(text: string): number {
  let counter: Utf8Counter = { pendingHigh: false, bytes: 0 }
  for (let index = 0; index < text.length; index += 1) counter = countCodeUnit(counter, text.charCodeAt(index))
  return counter.bytes + (counter.pendingHigh ? 3 : 0)
}

export function toWellFormedUnicode(text: string): string {
  return text.toWellFormed()
}

export function truncateWellFormed(text: string, maxLength: number): string {
  if (!Number.isFinite(maxLength) || maxLength <= 0) {
    return ""
  }
  if (text.length <= maxLength) {
    return text
  }
  const end = highSurrogate(text.charCodeAt(maxLength - 1))
      && lowSurrogate(text.charCodeAt(maxLength))
    ? maxLength - 1
    : maxLength
  return text.slice(0, end)
}

export function tailWellFormed(text: string, maxLength: number): string {
  if (!Number.isFinite(maxLength) || maxLength <= 0) {
    return ""
  }
  if (text.length <= maxLength) {
    return text
  }
  let start = text.length - maxLength
  if (
    lowSurrogate(text.charCodeAt(start))
    && highSurrogate(text.charCodeAt(start - 1))
  ) {
    start++
  }
  return text.slice(start)
}

export const MAX_WELL_FORMED_DEPTH = 64

export const MAX_WELL_FORMED_VISITS = 65_536

module walk {
  import { ElizaError } from "../errors.vibe"
  import { MAX_WELL_FORMED_DEPTH, MAX_WELL_FORMED_VISITS, toWellFormedUnicode } from "./unicode.vibe"

  type WalkCtx = {
    visits: number
    visiting: WeakSet<object>
  }

  function reserveVisits(ctx: WalkCtx, count: number): void {
    if (count > MAX_WELL_FORMED_VISITS - ctx.visits) {
      failUnbounded("visits", {
        visits: ctx.visits + count,
        max: MAX_WELL_FORMED_VISITS,
      })
    }
    ctx.visits += count
  }

  function failUnbounded(
    reason: "depth" | "cycle" | "visits",
    context: Record<string, unknown>,
  ): never {
    const message = reason === "cycle"
      ? "deepToWellFormedUnicode: cyclic object"
      : reason === "depth"
      ? "deepToWellFormedUnicode: nesting exceeds cap"
      : "deepToWellFormedUnicode: visit budget exceeded"
    throw new ElizaError(message, {
      code: "WELL_FORMED_UNBOUNDED",
      context: { reason, ...context },
      severity: "fatal",
    })
  }

  function failUnsafeValue(
    operation: "accessor" | "reflection",
    cause?: unknown,
    key?: string,
  ): never {
    throw new ElizaError(
      operation === "accessor"
        ? "deepToWellFormedUnicode: enumerable accessor cannot be serialized safely"
        : "deepToWellFormedUnicode: value cannot be inspected safely",
      {
        code: "WELL_FORMED_UNSAFE_VALUE",
        cause,

        context: {
          operation,
          ...(key !== undefined ? { propertyName: key } : {}),
        },
        severity: "fatal",
      },
    )
  }

  function enterContainer(value: object, depth: number, ctx: WalkCtx): void {
    if (depth >= MAX_WELL_FORMED_DEPTH) {
      failUnbounded("depth", { depth, max: MAX_WELL_FORMED_DEPTH })
    }
    if (ctx.visiting.has(value)) {
      failUnbounded("cycle", { depth })
    }
    ctx.visiting.add(value)
  }

  function sanitizeObjectPreservingDescriptors<T>(
    value: T,
    depth: number,
    ctx: WalkCtx,
    ownKeys: readonly (string | symbol)[],
    descriptors: readonly (PropertyDescriptor | undefined)[],
  ): T {
    const source = value as Record<PropertyKey, unknown>
    const clone = Object.create(null) as Record<PropertyKey, unknown>
    let changed = false
    for (let index = 0; index < ownKeys.length; index += 1) {
      const key = ownKeys[index]
      const descriptor = descriptors[index]
      if (!descriptor) {
        continue
      }

      if (typeof key === "symbol" || !descriptor.enumerable) {
        Object.defineProperty(clone, key, descriptor)
        continue
      }

      const sanitizedKey = toWellFormedUnicode(key)

      if (!("value" in descriptor)) {
        failUnsafeValue("accessor", undefined, key)
      }
      const entry = descriptor.value
      const sanitizedValue = walkDeep(entry, depth + 1, ctx, true)
      if (sanitizedKey !== key || sanitizedValue !== entry) {
        changed = true
      }
      if (!Object.hasOwn(clone, sanitizedKey)) {
        Object.defineProperty(clone, sanitizedKey, {
          ...descriptor,
          value: sanitizedValue,
        })
      }
    }
    Object.setPrototypeOf(clone, Object.getPrototypeOf(source))
    return (changed ? clone : value) as T
  }

  function walkDeep<T>(
    value: T,
    depth: number,
    ctx: WalkCtx,
    visitAlreadyReserved = false,
  ): T {
    if (!visitAlreadyReserved) reserveVisits(ctx, 1)
    if (typeof value === "string") {
      return toWellFormedUnicode(value) as unknown as T
    }
    if (Array.isArray(value)) {
      enterContainer(value, depth, ctx)
      try {
        reserveVisits(ctx, value.length)
        let changed = false
        const next = value.map((item) => {
          const sanitized = walkDeep(item, depth + 1, ctx, true)
          if (sanitized !== item) {
            changed = true
          }
          return sanitized
        })
        return (changed ? next : value) as T
      } finally {
        ctx.visiting.delete(value)
      }
    }
    if (value !== null && typeof value === "object") {
      const proto = Object.getPrototypeOf(value)
      if (proto !== Object.prototype && proto !== null) {
        return value
      }

      enterContainer(value, depth, ctx)
      try {
        const ownKeys = Reflect.ownKeys(value)

        reserveVisits(ctx, ownKeys.length)

        const descriptors = ownKeys.map((key) => Object.getOwnPropertyDescriptor(value, key))
        const needsDescriptorPreservingClone = ownKeys.some((key, index) => {
          const descriptor = descriptors[index]
          return (
            typeof key === "symbol"
            || Boolean(descriptor && !("value" in descriptor))
            || typeof descriptor?.value === "function"
          )
        })
        if (needsDescriptorPreservingClone) {
          return sanitizeObjectPreservingDescriptors(
            value,
            depth,
            ctx,
            ownKeys,
            descriptors,
          )
        }
        let changed = false
        const next = Object.create(null) as Record<string, unknown>
        for (let index = 0; index < ownKeys.length; index += 1) {
          const key = ownKeys[index]
          if (typeof key !== "string") continue
          const descriptor = descriptors[index]
          if (!descriptor?.enumerable || !("value" in descriptor)) continue
          const entry = descriptor.value
          const sanitizedKey = toWellFormedUnicode(key)
          const sanitized = walkDeep(entry, depth + 1, ctx, true)
          if (sanitizedKey !== key || sanitized !== entry) {
            changed = true
          }
          if (!(sanitizedKey in next)) {
            Object.defineProperty(next, sanitizedKey, {
              value: sanitized,
              writable: true,
              enumerable: true,
              configurable: true,
            })
          }
        }

        Object.setPrototypeOf(next, proto)
        return (changed ? next : value) as T
      } finally {
        ctx.visiting.delete(value)
      }
    }
    return value
  }

  /** @throws {ElizaError} */
  export function walkDeepFromRoot<T>(value: T): T {
    try {
      return walkDeep(value, 0, { visits: 0, visiting: new WeakSet<object>() })
    } catch (error) {
      if (error instanceof ElizaError) throw error
      return failUnsafeValue("reflection", error)
    }
  }

  const SCHEMA_ANNOTATION_KEYS = new Set(["default", "examples", "const"])
  function isAnnotationKey(key: string): boolean {
    return SCHEMA_ANNOTATION_KEYS.has(key) || key.startsWith("x-")
  }

  type SchemaWalkCtx = WalkCtx & { maxDepth: number }

  /** @throws {ElizaError} */
  export function walkSchemaFromRoot<T>(
    value: T,
    options: { maxDepth?: number } = {},
  ): T {
    const ctx: SchemaWalkCtx = {
      visits: 0,
      visiting: new WeakSet<object>(),
      maxDepth: options.maxDepth ?? MAX_WELL_FORMED_DEPTH,
    }
    try {
      return walkSchemaStrings(value, 0, ctx)
    } catch (error) {
      if (error instanceof ElizaError) throw error
      return failUnsafeValue("reflection", error)
    }
  }

  function failSchemaDepth(depth: number, ctx: SchemaWalkCtx): never {
    throw new ElizaError("deepToWellFormedUnicode: nesting exceeds cap", {
      code: "WELL_FORMED_UNBOUNDED",
      context: { reason: "depth", depth, max: ctx.maxDepth },
      severity: "fatal",
    })
  }

  const SCHEMA_MAP_KEYWORDS = new Set([
    "properties",
    "patternProperties",
    "$defs",
    "definitions",
    "dependentSchemas",
    "dependencies",
  ])
  const SCHEMA_ARRAY_WRAPPER_KEYWORDS = new Set([
    "anyOf",
    "oneOf",
    "allOf",
    "prefixItems",
  ])

  function walkSchemaStrings<T>(
    value: T,
    depth: number,
    ctx: SchemaWalkCtx,
    visitAlreadyReserved = false,
  ): T {
    if (!visitAlreadyReserved) reserveVisits(ctx, 1)
    if (typeof value === "string") {
      return toWellFormedUnicode(value) as unknown as T
    }
    if (!value || typeof value !== "object") {
      return value
    }
    if (depth > ctx.maxDepth) {
      failSchemaDepth(depth, ctx)
    }
    if (ctx.visiting.has(value)) {
      failUnbounded("cycle", { depth })
    }
    ctx.visiting.add(value)
    try {
      if (Array.isArray(value)) {
        reserveVisits(ctx, value.length)
        return walkSchemaItems(value, depth, ctx) as unknown as T
      }
      return walkSchemaEntries(value, isAnnotationKey, (key, entry) => {
        if (
          SCHEMA_MAP_KEYWORDS.has(key)
          && entry
          && typeof entry === "object"
          && !Array.isArray(entry)
        ) {
          return walkSchemaMapEntry(entry, depth, ctx)
        }
        if (
          (SCHEMA_ARRAY_WRAPPER_KEYWORDS.has(key)
            || key === "items"
            || key === "prefixItems")
          && Array.isArray(entry)
        ) {
          return walkSchemaArrayEntry(entry, depth, ctx)
        }
        return walkSchemaStrings(entry, depth + 1, ctx)
      }) as unknown as T
    } finally {
      ctx.visiting.delete(value)
    }
  }

  /** @throws {ElizaError} */
  export function assertAnnotationsFromRoot(
    value: unknown,
    options: { maxDepth?: number } = {},
  ): void {
    const ctx: SchemaWalkCtx = {
      visits: 0,
      visiting: new WeakSet<object>(),
      maxDepth: options.maxDepth ?? MAX_WELL_FORMED_DEPTH,
    }
    try {
      assertAnnotationsWalk(value, 0, ctx, false)
    } catch (error) {
      if (error instanceof ElizaError) throw error
      failUnsafeValue("reflection", error)
    }
  }

  function isArrayIndexKey(key: string, arr: unknown[]): boolean {
    if (!/^\d+$/.test(key)) return false
    const index = Number(key)
    return Number.isInteger(index) && index < arr.length && String(index) === key
  }

  function assertAnnotationsWalk(
    value: unknown,
    depth: number,
    ctx: SchemaWalkCtx,
    inAnnotation: boolean,
    visitAlreadyReserved = false,
  ): void {
    if (!visitAlreadyReserved) reserveVisits(ctx, 1)
    if (!value || typeof value !== "object") return
    if (depth > ctx.maxDepth) {
      failSchemaDepth(depth, ctx)
    }
    if (ctx.visiting.has(value)) {
      failUnbounded("cycle", { depth })
    }
    ctx.visiting.add(value)
    try {
      let keys: PropertyKey[] = []
      try {
        keys = Reflect.ownKeys(value)
      } catch (cause) {
        failUnsafeValue("reflection", cause)
      }
      if (Array.isArray(value)) {
        reserveVisits(ctx, value.length)
      }
      for (const key of keys) {
        if (typeof key !== "string") continue
        let descriptor: PropertyDescriptor | undefined
        try {
          descriptor = Object.getOwnPropertyDescriptor(value, key)
        } catch (cause) {
          failUnsafeValue("reflection", cause, key)
        }
        if (!descriptor?.enumerable) continue
        if (!("value" in descriptor)) {
          if (inAnnotation) {
            failUnsafeValue("accessor", undefined, key)
          }
          continue
        }
        const nextInAnnotation = inAnnotation || isAnnotationKey(key)

        const prepaid = Array.isArray(value) && isArrayIndexKey(key, value)

        assertAnnotationsWalk(
          descriptor.value,
          depth + 1,
          ctx,
          nextInAnnotation,
          prepaid,
        )
      }
    } finally {
      ctx.visiting.delete(value)
    }
  }

  function walkSchemaMapEntry(
    map: object,
    depth: number,
    ctx: SchemaWalkCtx,
  ): Record<string, unknown> {
    if (depth > ctx.maxDepth) failSchemaDepth(depth, ctx)
    reserveVisits(ctx, 1)
    return walkSchemaEntries(map, () => false, (_key, entry) => walkSchemaStrings(entry, depth + 1, ctx)) as Record<string, unknown>
  }

  function walkSchemaEntries(
    source: object,
    keepsEntry: (sanitizedKey: string) => boolean,
    walkEntry: (sanitizedKey: string, entry: unknown) => unknown,
  ): object {
    let changed = false
    const sourceProto = Object.getPrototypeOf(source)
    const next = Object.create(null) as Record<string, unknown>
    for (const key of Reflect.ownKeys(source)) {
      if (typeof key !== "string") continue
      const descriptor = Object.getOwnPropertyDescriptor(source, key)
      if (!descriptor?.enumerable) continue
      if (!("value" in descriptor)) {
        failUnsafeValue("accessor", undefined, key)
      }
      const sanitizedKey = toWellFormedUnicode(key)
      const kept = keepsEntry(sanitizedKey)
      const walked = kept ? descriptor.value : walkEntry(sanitizedKey, descriptor.value)
      if (sanitizedKey !== key || (!kept && walked !== descriptor.value)) changed = true
      if (!(sanitizedKey in next)) {
        Object.defineProperty(next, sanitizedKey, {
          value: walked,
          writable: true,
          enumerable: true,
          configurable: true,
        })
      }
    }
    Object.setPrototypeOf(next, sourceProto)
    return changed ? next : source
  }

  function walkSchemaArrayEntry(
    arr: unknown[],
    depth: number,
    ctx: SchemaWalkCtx,
  ): unknown[] {
    if (depth > ctx.maxDepth) failSchemaDepth(depth, ctx)
    reserveVisits(ctx, arr.length || 1)
    return walkSchemaItems(arr, depth, ctx)
  }

  function walkSchemaItems(arr: unknown[], depth: number, ctx: SchemaWalkCtx): unknown[] {
    let changed = false
    const next = new Array<unknown>(arr.length)
    for (let index = 0; index < arr.length; index += 1) {
      const descriptor = Object.getOwnPropertyDescriptor(arr, index)
      if (!descriptor) continue
      if (!("value" in descriptor)) {
        failUnsafeValue("accessor", undefined, String(index))
      }
      const walked = walkSchemaStrings(descriptor.value, depth + 1, ctx, true)
      if (walked !== descriptor.value) changed = true
      next[index] = walked
    }
    return changed ? next : arr
  }
}
import { assertAnnotationsFromRoot, walkDeepFromRoot, walkSchemaFromRoot } from walk

export effect function deepToWellFormedUnicode<T>(value: T) {
  return try Effect.try({ try: () => walkDeepFromRoot(value), catch: elizaErrorOrForeign })
}

export effect function wellFormedUnicodeSchemaStructure<T>(value: T, options: { maxDepth?: number } = {}) {
  return try Effect.try({ try: () => walkSchemaFromRoot(value, options), catch: elizaErrorOrForeign })
}

effect function assertSchemaAnnotationsSerializable(value: unknown, options: { maxDepth?: number } = {}) {
  try Effect.try({ try: () => assertAnnotationsFromRoot(value, options), catch: elizaErrorOrForeign })
}

export const assertSchemaAnnotationsSerializableOrThrow = thrown(assertSchemaAnnotationsSerializable)

module edge {
  import { runDetachedSync } from "../edge.vibe"
  import { ElizaError } from "../errors.vibe"
  import { deepToWellFormedUnicode, wellFormedUnicodeSchemaStructure } from "./unicode.vibe"

  /** @throws {ElizaError} */
  export function deepToWellFormedUnicodeOrThrow<T>(value: T): T {
    return runDetachedSync(deepToWellFormedUnicode(value))
  }

  /** @throws {ElizaError} */
  export function wellFormedUnicodeSchemaStructureOrThrow<T>(value: T, options: { maxDepth?: number } = {}): T {
    return runDetachedSync(wellFormedUnicodeSchemaStructure(value, options))
  }
}
import { deepToWellFormedUnicodeOrThrow, wellFormedUnicodeSchemaStructureOrThrow } from edge
export { deepToWellFormedUnicodeOrThrow, wellFormedUnicodeSchemaStructureOrThrow }
