// spec/core/confirmation.md, "Story: Settle an explicit confirmation from the user's reply"; spec/core/confirmation.md, "A refusal overrides an initial affirmative and an unclear reply stays pending"
import { initial, step } from "../../gen/core__confirmation.effect.vibe"
import { type Foreign, foreign, promised } from "../edge.vibe"
import { unwrapUserMessageText } from "../security/incoming-message-security.vibe"
import type { HandlerCallback } from "../types/components.vibe"
import type { Memory } from "../types/memory.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"

const DEFAULT_TTL_MS = 5 * 60_000

const AFFIRMATIVE_WORDS = new Set([
  "yes",
  "yeah",
  "yep",
  "y",
  "ok",
  "okay",
  "sure",
  "confirm",
  "confirmed",
  "proceed",
  "approve",
  "approved",
  "si",
  "sí",
  "oui",
  "ja",
  "hai",
  "はい",
  "确认",
  "確認",
  "확인",
])
const AFFIRMATIVE_PHRASES = new Set(["do it", "go ahead"])

const FILLER_WORDS = new Set(["please"])
const FILLER_PHRASES = new Set(["por favor"])

const ACKNOWLEDGING_WORDS = new Set(["ok", "okay", "sure"])
const THANKS_WORDS = new Set(["thanks", "thank", "thx", "ty", "cheers"])

const NEGATIVE_WORDS = new Set([
  "no",
  "n",
  "nope",
  "nah",
  "not",
  "never",
  "nevermind",
  "nvm",
  "negative",
  "don't",
  "dont",
  "cancel",
  "abort",
  "stop",
  "wait",
  "non",
  "pas",
  "nein",
  "nicht",
  "いいえ",
  "不",
  "不要",
  "取消",
  "아니",
  "아니요",
  "아뇨",
  "마",
  "마요",
  "마세요",
  "말아",
  "말아요",
  "말고",
])

const UNSPACED_SCRIPT = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/u
const UNSPACED_NEGATIVE_WORDS = [...NEGATIVE_WORDS].filter((word) => UNSPACED_SCRIPT.test(word))

const KOREAN_NEGATIVE_STEMS = ["아니", "않", "안", "못", "취소", "그만"]

const KOREAN_NONNEGATIVE_COMPOUND =
  /^(?:그만큼(?:만|은|의)?|취소선(?:[은는이가을를도만]|으로|로)?|안녕(?:하세요|하십니까|히)?)$/u

const KOREAN_NEGATED_VERB = /지[마말않못]/u

function isKoreanNegativeWord(word: string): boolean {
  return (
    (KOREAN_NEGATIVE_STEMS.some((stem) => word.startsWith(stem))
      && !KOREAN_NONNEGATIVE_COMPOUND.test(word))
    || KOREAN_NEGATED_VERB.test(word)
  )
}

function isNegativeWord(word: string): boolean {
  return (
    NEGATIVE_WORDS.has(word)
    || (UNSPACED_SCRIPT.test(word)
      && UNSPACED_NEGATIVE_WORDS.some((negative) => word.includes(negative)))
    || isKoreanNegativeWord(word)
  )
}

const NEGATIVE_SYMBOLS = /[\u{1F44E}\u274C\u274E\u{1F6AB}\u2716]/u

type ConfirmationReply = "affirmative" | "negative" | "unclear"

function classifyConfirmationReply(message: Memory): ConfirmationReply {
  const text = unwrapUserMessageText(message)
    .normalize("NFKC")
    .toLowerCase()
    .replace(/\u2019/g, "'")
  const words = (text.match(/[\p{L}\p{N}']+/gu) ?? [])
    .map((word) => word.replace(/^'+|'+$/g, ""))
    .filter(Boolean)
  if (NEGATIVE_SYMBOLS.test(text) || words.some(isNegativeWord)) {
    return "negative"
  }
  if (/[?？¿]/u.test(text)) return "unclear"

  let i = 0
  while (i < words.length) {
    if (FILLER_PHRASES.has(`${words[i]} ${words[i + 1]}`)) i += 2
    else if (FILLER_WORDS.has(words[i])) i++
    else break
  }
  const opensWithYes = AFFIRMATIVE_PHRASES.has(`${words[i]} ${words[i + 1]}`)
    || AFFIRMATIVE_WORDS.has(words[i])
  if (!opensWithYes) return "unclear"

  const thanked = words.some((word) => THANKS_WORDS.has(word))
  const firmYes = words.some(
    (word, j) =>
      (AFFIRMATIVE_WORDS.has(word) && !ACKNOWLEDGING_WORDS.has(word))
      || AFFIRMATIVE_PHRASES.has(`${word} ${words[j + 1]}`),
  )
  if (thanked && !firmYes) return "unclear"
  return "affirmative"
}

export type ConfirmationStatus = "pending" | "confirmed" | "cancelled"

interface PendingConfirmation {
  readonly actionName: string
  readonly pendingKey: string
  readonly prompt: string
  readonly createdAt: number
  readonly ttlMs: number
  readonly metadata?: Record<string, unknown>

  readonly requestMessageId?: string
}

export interface RequireConfirmationArgs {
  runtime: IAgentRuntime
  message: Memory

  actionName: string

  pendingKey: string

  prompt: string

  callback?: HandlerCallback

  ttlMs?: number

  metadata?: Record<string, unknown>
}

export interface ConfirmationDecision {
  status: ConfirmationStatus

  metadata?: Record<string, unknown>
}

function buildCacheKey(
  roomId: string,
  userId: string,
  actionName: string,
  pendingKey: string,
): string {
  return `confirmation:${roomId}:${userId}:${actionName}:${pendingKey}`
}

export function isAffirmativeConfirmationReply(message: Memory): boolean {
  return classifyConfirmationReply(message) === "affirmative"
}

function settleReply(reply: ConfirmationReply): ConfirmationStatus {
  const settled = step(
    initial,
    reply === "unclear"
      ? { type: "answerUnclear" }
      : { type: "answerClear", refusal: reply === "negative", affirmative: reply === "affirmative" },
  )
  if (settled.status === "Waiting") return "pending"
  return settled.status === "Confirmed" ? "confirmed" : "cancelled"
}

effect function requireConfirmation(
  args: RequireConfirmationArgs,
): ConfirmationDecision!Foreign {
  const ttlMs = typeof args.ttlMs === "number"
      && Number.isFinite(args.ttlMs)
      && args.ttlMs > 0
    ? args.ttlMs
    : DEFAULT_TTL_MS
  const cacheKey = buildCacheKey(
    String(args.message.roomId),
    String(args.message.entityId),
    args.actionName,
    args.pendingKey,
  )

  const existing = try foreign(() => args.runtime.getCache<PendingConfirmation>(cacheKey))
  const live = existing && Date.now() - existing.createdAt <= existing.ttlMs
    ? existing
    : undefined
  if (live) {
    const sameMessage = live.requestMessageId !== undefined
      && args.message.id !== undefined
      && String(args.message.id) === live.requestMessageId
    if (sameMessage) {
      return { status: "pending" }
    }
    const status = settleReply(classifyConfirmationReply(args.message))
    if (status !== "pending") {
      try foreign(() => args.runtime.deleteCache(cacheKey))
      return { status, metadata: live.metadata }
    }
  }

  const record: PendingConfirmation = {
    actionName: args.actionName,
    pendingKey: args.pendingKey,
    prompt: args.prompt,
    createdAt: Date.now(),
    ttlMs,
    metadata: args.metadata ?? live?.metadata,
    ...(args.message.id ? { requestMessageId: String(args.message.id) } : {}),
  }
  try foreign(() => args.runtime.setCache(cacheKey, record))
  const callback = args.callback
  if (callback) {
    try foreign(() =>
      callback({
        text: args.prompt,
        source: args.message.content.source,
      })
    )
  }
  return { status: "pending" }
}
export const requireConfirmationPromise = promised(requireConfirmation)

export type DestructiveConfirmationGateResult =
  | {
    readonly status: "confirmed"
    readonly metadata?: Record<string, unknown>
  }
  | { readonly status: "pending" }
  | {
    readonly status: "cancelled"
    readonly metadata?: Record<string, unknown>
  }

effect function gateDestructiveConfirmation(
  args: RequireConfirmationArgs,
): DestructiveConfirmationGateResult!Foreign {
  const decision = try requireConfirmation(args)
  if (decision.status === "pending") {
    return { status: "pending" }
  }
  return { status: decision.status, metadata: decision.metadata }
}
export const gateDestructiveConfirmationPromise = promised(gateDestructiveConfirmation)
