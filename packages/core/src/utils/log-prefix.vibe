// spec/core/protocols.md, "Story: Share canonical values across hosts and plugins"
import { readEnv } from "./environment.vibe"

module node {
  type RuntimeProcess = { argv?: string[]; env?: NodeJS.ProcessEnv }

  function runtimeProcess(): RuntimeProcess | undefined {
    const candidate = (globalThis as { process?: RuntimeProcess }).process
    return candidate && typeof candidate === "object" ? candidate : undefined
  }

  /** @throws {never} */
  export function processArgs(): readonly string[] {
    const argv = runtimeProcess()?.argv
    return Array.isArray(argv) ? argv : []
  }

  /** @throws {never} */
  export function processEnv(): NodeJS.ProcessEnv {
    return runtimeProcess()?.env ?? {}
  }
}
import { processArgs, processEnv } from node

let cachedPrefix: string | null = null

function prefixFromPackageName(name: string): string {
  const packageName = name.startsWith("@") ? (name.split("/")[1] ?? name) : name
  return packageName.includes("eliza") ? "[eliza]" : `[${packageName}]`
}

function resolveLogPrefix(): string {
  const appCliName = readEnv("APP_CLI_NAME", { env: processEnv() })
  if (appCliName) return `[${appCliName}]`
  const packageName = readEnv("npm_package_name", { env: processEnv() })
  if (packageName) return prefixFromPackageName(packageName)
  const name = processArgs().find((a) => a.startsWith("--name="))?.slice("--name=".length).trim()
  return name ? `[${name}]` : "[eliza]"
}

export function getLogPrefix(): string {
  cachedPrefix ??= resolveLogPrefix()
  return cachedPrefix
}
