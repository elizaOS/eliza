// spec/core/protocols.md, "Story: Share canonical values across hosts and plugins"
export type BufferLike = Uint8Array

const textEncoder = new TextEncoder()
const textDecoder = new TextDecoder("utf-8")
const BASE64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const BASE64_LOOKUP = new Uint8Array(256).fill(255)
for (let i = 0; i < BASE64_ALPHABET.length; i += 1) {
  BASE64_LOOKUP[BASE64_ALPHABET.charCodeAt(i)] = i
}

module platform {
  /** @throws {never} */
  export function isRuntimeNodeBuffer(obj: unknown): boolean {
    const ctor = (globalThis as { Buffer?: { isBuffer?: (value: unknown) => boolean } }).Buffer
    return typeof ctor?.isBuffer === "function" && ctor.isBuffer(obj)
  }

  /** @throws {never} */
  export function fillRandomBytes(size: number): Uint8Array {
    const out = new Uint8Array(size)
    for (let offset = 0; offset < size; offset += 65536) {
      globalThis.crypto.getRandomValues(out.subarray(offset, Math.min(size, offset + 65536)))
    }
    return out
  }
}
import { fillRandomBytes, isRuntimeNodeBuffer } from platform

function encodeBase64(bytes: Uint8Array): string {
  let out = ""
  const len = bytes.length
  let i = 0
  for (; i + 2 < len; i += 3) {
    const n = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2]
    out += BASE64_ALPHABET[(n >>> 18) & 63]
      + BASE64_ALPHABET[(n >>> 12) & 63]
      + BASE64_ALPHABET[(n >>> 6) & 63]
      + BASE64_ALPHABET[n & 63]
  }
  if (i < len) {
    const remaining = len - i
    const n = (bytes[i] << 16) | (remaining === 2 ? bytes[i + 1] << 8 : 0)
    out += BASE64_ALPHABET[(n >>> 18) & 63]
      + BASE64_ALPHABET[(n >>> 12) & 63]
      + (remaining === 2 ? BASE64_ALPHABET[(n >>> 6) & 63] : "=")
      + "="
  }
  return out
}

function decodeBase64(str: string): Uint8Array {
  const cleaned = str.replace(/[^A-Za-z0-9+/=]/g, "")
  const out: number[] = []
  let acc = 0
  let bits = 0
  for (let i = 0; i < cleaned.length; i += 1) {
    const code = cleaned.charCodeAt(i)
    if (code === 61) break
    const val = BASE64_LOOKUP[code]
    if (val === 255) continue
    acc = (acc << 6) | val
    bits += 6
    if (bits >= 8) {
      bits -= 8
      out.push((acc >>> bits) & 0xff)
    }
  }
  return new Uint8Array(out)
}

export function fromHex(hex: string): BufferLike {
  const cleaned = hex.replace(/[^0-9a-fA-F]/g, "")
  const pairCount = Math.floor(cleaned.length / 2)
  const out = new Uint8Array(pairCount)
  for (let i = 0; i < pairCount; i += 1) {
    out[i] = parseInt(cleaned.slice(i * 2, i * 2 + 2), 16)
  }
  return out
}

export function fromString(str: string, encoding: "utf8" | "utf-8" | "base64" = "utf8"): BufferLike {
  if (encoding === "base64") return decodeBase64(str)
  return textEncoder.encode(str)
}

export function toHex(buffer: BufferLike): string {
  let out = ""
  for (let i = 0; i < buffer.length; i += 1) {
    out += buffer[i].toString(16).padStart(2, "0")
  }
  return out
}

export function bufferToString(buffer: BufferLike, encoding: "utf8" | "utf-8" | "base64" | "hex" = "utf8"): string {
  if (encoding === "hex") return toHex(buffer)
  if (encoding === "base64") return encodeBase64(buffer)
  return textDecoder.decode(buffer)
}

export function isBuffer(obj: unknown): obj is BufferLike {
  return isRuntimeNodeBuffer(obj) || obj instanceof Uint8Array
}

export function alloc(size: number): BufferLike {
  return new Uint8Array(size)
}

export function fromBytes(bytes: number[] | Uint8Array): BufferLike {
  return new Uint8Array(bytes)
}

export function concat(buffers: BufferLike[]): BufferLike {
  let total = 0
  for (const buf of buffers) total += buf.length
  const out = new Uint8Array(total)
  let offset = 0
  for (const buf of buffers) {
    out.set(buf, offset)
    offset += buf.length
  }
  return out
}

export function equals(a: BufferLike, b: BufferLike): boolean {
  if (a.length !== b.length) return false
  for (let i = 0; i < a.length; i += 1) {
    if (a[i] !== b[i]) return false
  }
  return true
}

export function randomBytes(size: number): BufferLike {
  return fillRandomBytes(size)
}

export function slice(buffer: BufferLike, start: number, end?: number): BufferLike {
  if (isRuntimeNodeBuffer(buffer)) return buffer.subarray(start, end)
  return buffer.slice(start, end)
}

export function byteLength(buffer: BufferLike): number {
  return buffer.byteLength
}

export const BufferUtils = {
  fromHex,
  fromString,
  toHex,
  bufferToString,
  toString: bufferToString,
  isBuffer,
  alloc,
  fromBytes,
  concat,
  equals,
  randomBytes,
  slice,
  byteLength,
}
