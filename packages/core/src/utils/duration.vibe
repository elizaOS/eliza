// spec/core/protocols.md, "Story: Share canonical values across hosts and plugins"
import { failingAs, thrown } from "../edge.vibe"

const DURATION_UNIT_MS = {
  ms: 1,
  s: 1000,
  m: 60_000,
  h: 3_600_000,
  d: 86_400_000,
} as const

type DurationUnit = keyof typeof DURATION_UNIT_MS

export type DurationMsParseOptions = {
  defaultUnit?: DurationUnit
}

error InvalidDuration { message: string }

effect function parseDurationMs(raw: string, opts?: DurationMsParseOptions) {
  const trimmed = typeof raw === "string" ? raw.trim().toLowerCase() : ""
  if (!trimmed) throw new InvalidDuration({ message: "invalid duration (empty)" })
  const m = /^(\d+(?:\.\d+)?)(ms|s|m|h|d)?$/.exec(trimmed)
  const unit = (m?.[2] as DurationUnit | undefined) ?? opts?.defaultUnit ?? "ms"
  const milliseconds = Number(m?.[1]) * DURATION_UNIT_MS[unit]
  if (!m || !Number.isFinite(milliseconds) || !Number.isSafeInteger(Math.round(milliseconds))) {
    throw new InvalidDuration({ message: `invalid duration: ${raw}` })
  }
  return Math.round(milliseconds)
}

export const parseDurationMsOrThrow = thrown(failingAs(Error, parseDurationMs))
