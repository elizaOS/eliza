// spec/core/serialisation.md, "Only the head callback executes and every settlement releases its successor"; spec/core/semaphore.md, "A permit is always available or owned by one caller"; spec/core/semaphore.md, "A release skips cancelled waiters before granting the oldest live ticket"; spec/core/taskDrain.md, "Every asynchronous start retains its own storage operation and checks disposal after lookup"; spec/core/taskDrain.md, "Interval writes and disposal use captured IDs while retaining their source-visible races"
import * as EffectSemaphore from "effect/Semaphore"
import type { UUID } from "../types/primitives.vibe"
import type { IAgentRuntime } from "../types/runtime.vibe"
import type { Task } from "../types/task.vibe"
import { asLegacy, Foreign, foreign, runDetached } from "../edge.vibe"
import { whenAborted } from "./retry.vibe"

export function createSerialise(): <T>(fn: () => Promise<T>) => Promise<T> {
  const lock = EffectSemaphore.makeUnsafe(1)
  return <T>(fn: () => Promise<T>): Promise<T> => runDetached(lock.withPermit(foreign(() => Promise.resolve().then(fn))))
}

interface PermitWaiter {
  readonly signal: AbortSignal | undefined
  readonly turn: Deferred.Deferred<void, Foreign>
}

interface Permits {
  available: number
  readonly waiters: PermitWaiter[]
}

effect function cancelWhenAborted(permits: Permits, waiter: PermitWaiter, signal: AbortSignal) {
  const reason = try whenAborted(signal)
  const index = permits.waiters.indexOf(waiter)
  if (index < 0) return
  permits.waiters.splice(index, 1)
  try Deferred.fail(waiter.turn, new Foreign({ cause: reason }))
}

export effect function acquirePermit(semaphore: Semaphore, signal?: AbortSignal) {
  const permits = semaphore.permits
  if (signal?.aborted) throw new Foreign({ cause: signal.reason })
  if (permits.available > 0) {
    permits.available -= 1
    return
  }
  const waiter: PermitWaiter = { signal, turn: try Deferred.make<void, Foreign>() }
  permits.waiters.push(waiter)
  try scoped(effect {
    if (signal) fork.scoped cancelWhenAborted(permits, waiter, signal)
    try Deferred.await(waiter.turn)
  })
}

export class Semaphore {
  readonly permits: Permits

  constructor(count: number) {
    this.permits = { available: Number.isFinite(count) ? Math.max(1, Math.floor(count)) : 1, waiters: [] }
  }

  get availablePermits(): number {
    return this.permits.available
  }

  get queueLength(): number {
    return this.permits.waiters.length
  }

  async acquire(signal?: AbortSignal): Promise<void> {
    return runDetached(acquirePermit(this, signal))
  }

  release(): void {
    const permits = this.permits
    for (let next = permits.waiters.shift(); next; next = permits.waiters.shift()) {
      if (next.signal?.aborted) {
        Deferred.doneUnsafe(next.turn, fail(new Foreign({ cause: next.signal.reason })))
        continue
      }
      Deferred.doneUnsafe(next.turn, Effect.void)
      return
    }
    permits.available += 1
  }
}

export interface TaskDrainOptions {
  taskName: string

  intervalMs: number

  description?: string

  taskMetadata?: Record<string, unknown>

  skipRegisterWorker?: boolean

  onDrain?: (
    runtime: IAgentRuntime,
  ) => Promise<void> | Promise<number | undefined>

  idleIntervalMs?: number
}

interface DrainState {
  readonly taskName: string
  readonly description: string
  readonly taskMetadata: Record<string, unknown>
  readonly skipRegisterWorker: boolean
  readonly onDrain: TaskDrainOptions["onDrain"]
  readonly idleIntervalMs: number | undefined
  intervalMs: number
  taskId: UUID | null
  disposed: boolean
}

export error TaskDrainMisconfigured { message: string }

function matchesTask(state: DrainState, t: Task, agentId: string): boolean {
  if (t.agentId == null || String(t.agentId) !== agentId) return false
  const tags = Array.isArray(t.tags) ? t.tags : []
  if (!tags.includes("queue") || !tags.includes("repeat")) return false
  const meta = (t.metadata ?? {}) as Record<string, unknown>
  return Object.entries(state.taskMetadata).every(([key, value]) => meta[key] === value)
}

effect function drainOnce(state: DrainState, onDrain: NonNullable<TaskDrainOptions["onDrain"]>, rt: IAgentRuntime) {
  const processed = try foreign<number | void>(() => onDrain(rt))
  if (state.idleIntervalMs === undefined || typeof processed !== "number") return undefined
  return { nextInterval: processed > 0 ? state.intervalMs : state.idleIntervalMs }
}

export effect function startTaskDrain(drain: TaskDrain, runtime: IAgentRuntime) {
  const state = drain.state
  if (state.disposed) return
  if (!state.skipRegisterWorker) {
    const onDrain = state.onDrain
    if (!onDrain) throw new TaskDrainMisconfigured({ message: "TaskDrain: onDrain is required when registerWorker is enabled" })
    runtime.registerTaskWorker({ name: state.taskName, execute: (rt) => runDetached(drainOnce(state, onDrain, rt)) })
  }
  try ensureTask(drain, runtime)
}

effect function ensureTask(drain: TaskDrain, runtime: IAgentRuntime) {
  const state = drain.state
  if (typeof runtime.getTasksByName !== "function" || typeof runtime.createTask !== "function") return
  const agentId = runtime.agentId
  const existing = try foreign(() => runtime.getTasksByName(state.taskName))
  if (state.disposed) return
  const matchingTasks = existing.filter((t) => matchesTask(state, t, String(agentId)))
  const mine = matchingTasks[0]
  if (mine?.id) {
    state.taskId = mine.id
    if (matchingTasks.length > 1 && typeof runtime.deleteTask === "function") {
      const pending = matchingTasks.slice(1).filter((task) => task.id).map((task) => runtime.deleteTask(task.id as UUID))
      for concurrent (const deletion of pending) foreign(() => deletion) catch () => undefined
    }
    if (typeof runtime.getTask === "function" && typeof runtime.updateTask === "function") {
      try updateTaskDrainInterval(drain, runtime, state.intervalMs)
    }
    return
  }
  state.taskId = try foreign(() => runtime.createTask({
    name: state.taskName,
    description: state.description,
    tags: ["queue", "repeat"],
    agentId: agentId as UUID,
    worldId: agentId as UUID,
    metadata: {
      ...state.taskMetadata,
      updateInterval: state.intervalMs,
      baseInterval: state.intervalMs,
      updatedAt: Date.now(),
      maxFailures: -1,
    },
  }))
  if (state.disposed) try disposeTaskDrain(drain, runtime)
}

export effect function updateTaskDrainInterval(drain: TaskDrain, runtime: IAgentRuntime, newIntervalMs: number) {
  const state = drain.state
  state.intervalMs = newIntervalMs
  const taskId = state.taskId
  if (!taskId || typeof runtime.getTask !== "function" || typeof runtime.updateTask !== "function") return
  const task = try foreign(() => runtime.getTask(taskId))
  if (!task) {
    state.taskId = null
    return
  }
  const current = (task.metadata as Record<string, unknown> | undefined)?.updateInterval
  if (current === newIntervalMs && task.metadata?.baseInterval === newIntervalMs) return
  try foreign(() => runtime.updateTask(taskId, {
    metadata: { ...task.metadata, updateInterval: newIntervalMs, baseInterval: newIntervalMs },
  }))
}

export effect function disposeTaskDrain(drain: TaskDrain, runtime: IAgentRuntime) {
  const state = drain.state
  state.disposed = true
  const taskId = state.taskId
  if (!taskId || typeof runtime.deleteTask !== "function") return
  const pending = try Effect.try({
    try: () => runtime.deleteTask(taskId).catch((err) => runtime.reportError("TaskDrain.dispose", err, { taskId })),
    catch: (cause) => new Foreign({ cause }),
  })
  try foreign(() => pending)
  state.taskId = null
}

export class TaskDrain {
  readonly state: DrainState

  constructor(options: TaskDrainOptions, initialIntervalMs?: number) {
    this.state = {
      taskName: options.taskName,
      description: options.description ?? `Repeat drain: ${options.taskName}`,
      taskMetadata: { ...(options.taskMetadata ?? {}) },
      skipRegisterWorker: options.skipRegisterWorker ?? false,
      onDrain: options.onDrain,
      idleIntervalMs: options.idleIntervalMs,
      intervalMs: initialIntervalMs ?? options.intervalMs,
      taskId: null,
      disposed: false,
    }
  }

  get id(): UUID | null {
    return this.state.taskId
  }

  async start(runtime: IAgentRuntime): Promise<void> {
    return runDetached(asLegacy(Error, startTaskDrain(this, runtime)))
  }

  async updateInterval(runtime: IAgentRuntime, newIntervalMs: number): Promise<void> {
    return runDetached(updateTaskDrainInterval(this, runtime, newIntervalMs))
  }

  getIntervalMs(): number {
    return this.state.intervalMs
  }

  async dispose(runtime: IAgentRuntime): Promise<void> {
    return runDetached(disposeTaskDrain(this, runtime))
  }
}
