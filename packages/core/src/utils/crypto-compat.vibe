// spec/core/protocols.md, "Binary helpers preserve byte contents and the input slice ownership contract"
import { Foreign, thrown } from "../edge.vibe"

module node {
  import { Buffer } from "node:buffer"
  import { createCipheriv, createDecipheriv, createHash } from "node:crypto"

  type Encoding = "utf8" | "utf-8" | "base64" | "hex"

  /** @throws {Error} */
  function normalizeEncoding(value: string): Encoding {
    const encoding = value.toLowerCase()
    if (encoding === "utf8" || encoding === "utf-8" || encoding === "base64" || encoding === "hex") return encoding
    throw new Error(`Unsupported encoding: ${value}. Supported: utf8, utf-8, base64, hex.`)
  }

  /** @throws {never} */
  export function hashBuilder(algorithm: string) {
    const hash = createHash(algorithm)
    function digest(): Uint8Array
    function digest(encoding: Encoding): string
    function digest(encoding?: Encoding): Uint8Array | string {
      const bytes = hash.digest()
      return encoding ? bytes.toString(normalizeEncoding(encoding)) : bytes
    }
    const builder = {
      update(data: string | Uint8Array) {
        hash.update(data)
        return builder
      },
      digest,
    }
    return builder
  }

  /** @throws {never} */
  export function cbcDecipher(key: Uint8Array, iv: Uint8Array) {
    const decipher = createDecipheriv("aes-256-cbc", key, iv)
    return {
      /** @throws {Error} */
      update(data: string, inputEncoding: string, outputEncoding: string): string {
        return decipher.update(data, normalizeEncoding(inputEncoding), normalizeEncoding(outputEncoding))
      },
      /** @throws {Error} */
      final(encoding: string): string {
        return decipher.final(normalizeEncoding(encoding))
      },
    }
  }

  /** @throws {never} */
  export function gcmEncrypt(key: Uint8Array, iv: Uint8Array, plaintext: Uint8Array, aad?: Uint8Array): { ciphertext: Uint8Array; tag: Uint8Array } {
    const cipher = createCipheriv("aes-256-gcm", key, iv)
    if (aad) cipher.setAAD(aad)
    const ciphertext = Buffer.concat([cipher.update(plaintext), cipher.final()])
    return { ciphertext, tag: cipher.getAuthTag() }
  }

  /** @throws {Error} */
  export function gcmDecrypt(key: Uint8Array, iv: Uint8Array, ciphertext: Uint8Array, tag: Uint8Array, aad?: Uint8Array): Uint8Array {
    const cipher = createDecipheriv("aes-256-gcm", key, iv)
    if (aad) cipher.setAAD(aad)
    cipher.setAuthTag(tag)
    return Buffer.concat([cipher.update(ciphertext), cipher.final()])
  }
}
import { cbcDecipher, gcmDecrypt, gcmEncrypt, hashBuilder } from node

export error UnsupportedAlgorithm { message: string }
export error InvalidKeyMaterial { message: string }

const HASH_ALGORITHMS = new Set(["md5", "ripemd160", "sha1", "sha224", "sha256", "sha384", "sha512"])

export effect function createHash(algorithm: string) {
  if (!HASH_ALGORITHMS.has(algorithm.toLowerCase())) {
    throw new UnsupportedAlgorithm({ message: `Unsupported algorithm: ${algorithm}. Supported: ${[...HASH_ALGORITHMS].join(", ")}` })
  }
  return hashBuilder(algorithm)
}

export const createHashOrThrow = thrown(createHash)

effect function validateKey(key: Uint8Array) {
  if (key.length !== 32) {
    throw new InvalidKeyMaterial({ message: `Invalid key length: ${key.length} bytes. Expected 32 bytes for AES-256.` })
  }
}

effect function validateKeyAndIv(key: Uint8Array, iv: Uint8Array) {
  try validateKey(key)
  if (iv.length !== 16) {
    throw new InvalidKeyMaterial({ message: `Invalid IV length: ${iv.length} bytes. Expected 16 bytes for AES-CBC.` })
  }
}

effect function validateKeyAndGcmIv(key: Uint8Array, iv: Uint8Array) {
  try validateKey(key)
  if (iv.length !== 12) {
    throw new InvalidKeyMaterial({ message: `Invalid IV length: ${iv.length} bytes. Expected 12 bytes for AES-GCM.` })
  }
}

export effect function createDecipheriv(algorithm: string, key: Uint8Array, iv: Uint8Array) {
  if (algorithm !== "aes-256-cbc") {
    throw new UnsupportedAlgorithm({ message: `Unsupported algorithm: ${algorithm}. Only 'aes-256-cbc' is supported.` })
  }
  try validateKeyAndIv(key, iv)
  return cbcDecipher(key, iv)
}

export const createDecipherivOrThrow = thrown(createDecipheriv)

export effect function encryptAes256Gcm(key: Uint8Array, iv: Uint8Array, plaintext: Uint8Array, aad?: Uint8Array) {
  try validateKeyAndGcmIv(key, iv)
  return gcmEncrypt(key, iv, plaintext, aad)
}

export const encryptAes256GcmOrThrow = thrown(encryptAes256Gcm)

export effect function decryptAes256Gcm(key: Uint8Array, iv: Uint8Array, ciphertext: Uint8Array, tag: Uint8Array, aad?: Uint8Array) {
  try validateKeyAndGcmIv(key, iv)
  if (tag.length !== 16) {
    throw new InvalidKeyMaterial({ message: `Invalid tag length: ${tag.length} bytes. Expected 16 bytes for AES-GCM tag.` })
  }
  return try Effect.try({ try: () => gcmDecrypt(key, iv, ciphertext, tag, aad), catch: (cause) => new Foreign({ cause }) })
}

export const decryptAes256GcmOrThrow = thrown(decryptAes256Gcm)
