      "created_at",
      "updated_at",
    ],
    indexes: ["idx_life_escalation_states_agent_resolved"],
  },
}

export const REMINDERS_SQLITE_DDL: readonly string[] = [
  `CREATE TABLE IF NOT EXISTS life_reminder_plans (
    id TEXT PRIMARY KEY,
    agent_id TEXT NOT NULL,
    owner_type TEXT NOT NULL,
    owner_id TEXT NOT NULL,
    steps_json TEXT NOT NULL DEFAULT '[]',
    mute_policy_json TEXT NOT NULL DEFAULT '{}',
    quiet_hours_json TEXT NOT NULL DEFAULT '{}',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
  )`,
  `CREATE INDEX IF NOT EXISTS idx_life_reminder_plans_owner ON life_reminder_plans(agent_id, owner_type, owner_id)`,
  `CREATE TABLE IF NOT EXISTS life_reminder_attempts (
    id TEXT PRIMARY KEY,
    agent_id TEXT NOT NULL,
    plan_id TEXT NOT NULL,
    owner_type TEXT NOT NULL,
    owner_id TEXT NOT NULL,
    occurrence_id TEXT,
    channel TEXT NOT NULL,
    step_index INTEGER NOT NULL DEFAULT 0,
    scheduled_for TEXT NOT NULL,
    attempted_at TEXT,
    outcome TEXT NOT NULL DEFAULT 'pending',
    connector_ref TEXT,
    delivery_metadata_json TEXT NOT NULL DEFAULT '{}',
    review_at TEXT,
    review_status TEXT,
    review_claimed_at TEXT,
    review_claimed_by TEXT,
    review_attempt_count INTEGER NOT NULL DEFAULT 0,
    review_next_retry_at TEXT,
    review_last_error TEXT
  )`,
  `CREATE INDEX IF NOT EXISTS idx_life_reminder_attempts_plan ON life_reminder_attempts(plan_id, owner_type, owner_id)`,
  `CREATE INDEX IF NOT EXISTS idx_life_reminder_attempts_review_scan ON life_reminder_attempts(agent_id, outcome, review_status, review_at)`,
  `CREATE TABLE IF NOT EXISTS life_escalation_states (
    id TEXT PRIMARY KEY,
    agent_id TEXT NOT NULL,
    reason TEXT NOT NULL DEFAULT '',
    text TEXT NOT NULL DEFAULT '',
    current_step INTEGER NOT NULL DEFAULT 0,
    channels_sent_json TEXT NOT NULL DEFAULT '[]',
    started_at TEXT NOT NULL,
    last_sent_at TEXT NOT NULL,
    resolved INTEGER NOT NULL DEFAULT 0,
    resolved_at TEXT,
    metadata_json TEXT NOT NULL DEFAULT '{}',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
  )`,
  `CREATE INDEX IF NOT EXISTS idx_life_escalation_states_agent_resolved ON life_escalation_states(agent_id, resolved)`,
  `CREATE TABLE IF NOT EXISTS reminders_migration_state (
    table_name TEXT PRIMARY KEY,
    migrated_at TEXT NOT NULL
  )`,
  `CREATE TABLE IF NOT EXISTS reminder_deliveries (
    owner_id TEXT NOT NULL,
    reminder_id TEXT NOT NULL,
    scheduled_at INTEGER NOT NULL,
    escalation_at INTEGER NOT NULL,
    delivery_status TEXT NOT NULL,
    attempt INTEGER NOT NULL,
    PRIMARY KEY (owner_id, reminder_id)
  )`,
]
