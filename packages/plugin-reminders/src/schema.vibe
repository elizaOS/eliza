// spec/reminders/index.md, "Story: Preserve a reminder and its escalation policy"; spec/reminders/migration.md, "Migration copies only into an empty target, records a durable marker, and never alters the source"
export const REMINDERS_SCHEMA_NAME = "app_reminders" as const
export const REMINDERS_SOURCE_SCHEMA = "app_lifeops" as const

export const MIGRATED_REMINDER_TABLES = [
  "life_reminder_plans",
  "life_reminder_attempts",
  "life_escalation_states",
] as const

export type MigratedReminderTable = (typeof MIGRATED_REMINDER_TABLES)[number]

export interface ReminderPlanRow {
  readonly id: string
  readonly agentId: string
  readonly ownerType: string
  readonly ownerId: string
  readonly stepsJson: string
  readonly mutePolicyJson: string
  readonly quietHoursJson: string
  readonly createdAt: string
  readonly updatedAt: string
}

export interface ReminderAttemptRow {
  readonly id: string
  readonly agentId: string
  readonly planId: string
  readonly ownerType: string
  readonly ownerId: string
  readonly occurrenceId: string | null
  readonly channel: string
  readonly stepIndex: number
  readonly scheduledFor: string
  readonly attemptedAt: string | null
  readonly outcome: string
  readonly connectorRef: string | null
  readonly deliveryMetadataJson: string
  readonly reviewAt: string | null
  readonly reviewStatus: string | null
  readonly reviewClaimedAt: string | null
  readonly reviewClaimedBy: string | null
  readonly reviewAttemptCount: number
  readonly reviewNextRetryAt: string | null
  readonly reviewLastError: string | null
}

export interface EscalationStateRow {
  readonly id: string
  readonly agentId: string
  readonly reason: string
  readonly text: string
  readonly currentStep: number
  readonly channelsSentJson: string
  readonly startedAt: string
  readonly lastSentAt: string
  readonly resolved: boolean
  readonly resolvedAt: string | null
  readonly metadataJson: string
  readonly createdAt: string
  readonly updatedAt: string
}

export interface ReminderTableSchemaSpec {
  readonly schema: typeof REMINDERS_SCHEMA_NAME
  readonly name: MigratedReminderTable
  readonly primaryKey: "id"
  readonly columns: readonly string[]
  readonly indexes: readonly string[]
}

export const remindersDbSchema: Readonly<Record<MigratedReminderTable, ReminderTableSchemaSpec>> = {
  life_reminder_plans: {
    schema: REMINDERS_SCHEMA_NAME,
    name: "life_reminder_plans",
    primaryKey: "id",
    columns: [
      "id",
      "agent_id",
      "owner_type",
      "owner_id",
      "steps_json",
      "mute_policy_json",
      "quiet_hours_json",
      "created_at",
      "updated_at",
    ],
    indexes: ["idx_life_reminder_plans_owner"],
  },
  life_reminder_attempts: {
    schema: REMINDERS_SCHEMA_NAME,
    name: "life_reminder_attempts",
    primaryKey: "id",
    columns: [
      "id",
      "agent_id",
      "plan_id",
      "owner_type",
      "owner_id",
      "occurrence_id",
      "channel",
      "step_index",
      "scheduled_for",
      "attempted_at",
      "outcome",
      "connector_ref",
      "delivery_metadata_json",
      "review_at",
      "review_status",
      "review_claimed_at",
      "review_claimed_by",
      "review_attempt_count",
      "review_next_retry_at",
      "review_last_error",
    ],
    indexes: ["idx_life_reminder_attempts_plan", "idx_life_reminder_attempts_review_scan"],
  },
  life_escalation_states: {
    schema: REMINDERS_SCHEMA_NAME,
    name: "life_escalation_states",
    primaryKey: "id",
    columns: [
      "id",
      "agent_id",
      "reason",
      "text",
      "current_step",
      "channels_sent_json",
      "started_at",
      "last_sent_at",
      "resolved",
      "resolved_at",
