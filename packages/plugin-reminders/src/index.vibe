// spec/reminders/index.md, "Story: Preserve a reminder and its escalation policy"
import { mayImportReminder, type ReminderDelivery } from "../gen/reminders.effect.vibe"

export error ReminderRecordsUnavailable { reason: string }

export service ReminderRecords {
  idsForOwner(ownerId: string): string[]!ReminderRecordsUnavailable
  insertMissing(row: ReminderDelivery): boolean!ReminderRecordsUnavailable
}

export effect function importReminder(ownerId: string, row: ReminderDelivery) {
  const records = try ReminderRecords
  const ids = try records.idsForOwner(ownerId)
  if (!mayImportReminder(row, ownerId, [...new Set(ids)])) return false
  return try records.insertMissing(row)
}
