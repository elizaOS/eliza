// spec/browser/control.md, "My whole-message request to see my open tabs shows my phone's own tab list without waiting on the model's choice"
import { assert, it } from "@effect/vitest"
import { browserPlugin } from "../src/index.vibe"
import { deviceActionsModuleName } from "../../agent/src/device-actions/proposal/module.vibe"
import { builtinModuleFactories } from "../../agent/src/plugins/profile.vibe"
import { cloudFake, deviceKey, host, startInProcess } from "../../agent/test/support/kernel.vibe"

module node {
  import { deviceClient, openConversation } from "../../agent/test/support/device.ts"
  import { text, type CloudFake } from "../../agent/test/support/cloud-fake.ts"

  interface Proposal {
    readonly id: string
    readonly digest: string
    readonly state: string
    readonly payload: { readonly operation: unknown; readonly requestMessageId?: string }
    readonly execution?: { readonly attemptId: string }
  }

  export async function overviewJourney(socket: string, token: string, agentId: string, model: CloudFake) {
    const capability = "browser.tabs.show.v1"
    const client = deviceClient(socket, token, agentId, capability)
    const registered = await client.call("POST", "/api/client-devices/register", { capabilities: [capability], workflowProtocol: 1 })
    const conversation = await openConversation(client)
    const turns = `/api/conversations/${conversation.id}/messages`
    const proposals = "/api/client-devices/proposals"
    const list = async () => ((await client.call("GET", proposals)).json as { proposals: Proposal[] }).proposals
    const metadata = { observation: { view: "home", revision: 3, sensitive: false } }

    model.script(text("I can help with the browser."))
    const compound = await client.call("POST", turns, { text: "Show my tabs and close one.", metadata })
    const compoundCount = (await list()).length

    model.script(text("Okay."))
    const asked = await client.call("POST", turns, { text: "Show my open tabs.", metadata })
    const rows = await list()
    const [proposal] = rows
    if (proposal === undefined) throw new Error(`No browser proposal: ${JSON.stringify(asked)}`)
    const at = `${proposals}/${proposal.id}`
    const approved = await client.call("POST", `${at}/decision`, { digest: proposal.digest, decision: "approve" })
    const claimed = await client.call("POST", `${at}/claim`, { digest: proposal.digest })
    const attemptId = (claimed.json as { proposal: Proposal }).proposal.execution?.attemptId ?? ""
    const outcome = { outcome: "applied", operationId: "tabs-overview-fixture" }
    const leaked = await client.call("POST", `${at}/receipt`, {
      digest: proposal.digest, attemptId, receipt: { ...outcome, result: { count: 1, tabs: ["private-fixture"] } },
    })
    const settled = await client.call("POST", `${at}/receipt`, { digest: proposal.digest, attemptId, receipt: outcome })
    const kept = (settled.json as { proposal: Proposal }).proposal
    const direct = { ...metadata, voiceUi: { viewDelivery: "completed-action", uiClientId: "renderer-1", agentActionMode: "direct-request-v1" } }

    model.script(text("Okay."))
    const locked = await client.call("POST", turns, { text: "Show my open tabs.", metadata: { ...direct, observation: { ...metadata.observation, sensitive: true } } })
    const lockedProposals = (await list()).filter(({ id }) => id !== proposal.id)

    model.script(text("Okay."))
    const requested = await client.call("POST", turns, { text: "Show my open tabs.", metadata: direct })
    const directProposal = (await list()).find(({ id }) => id !== proposal.id)
    if (directProposal === undefined) throw new Error(`No direct Browser proposal: ${JSON.stringify(requested)}`)
    const directClaim = await client.call("POST", `${proposals}/${directProposal.id}/claim`, { digest: directProposal.digest })
    return {
      statuses: [registered.status, compound.status, asked.status, approved.status, claimed.status, settled.status],
      compoundCount,
      count: rows.length,
      operation: proposal.payload.operation,
      leakedStatus: leaked.status,
      leakedKept: JSON.stringify(kept).includes("private-fixture"),
      state: kept.state,
      locked: [locked.status, lockedProposals.length],
      direct: {
        statuses: [requested.status, directClaim.status], operation: directProposal.payload.operation,
        sameRequest: directProposal.payload.requestMessageId === (requested.json as { userMessageId: string }).userMessageId,
      },
    }
  }
}
import { overviewJourney } from node

it.live('The enrolled owner can approve a tab overview and the result contains no tab data (spec/browser/control.md, "My whole-message request to see my open tabs shows my phone\'s own tab list without waiting on the model\'s choice")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { callerRole: "owner", backend: { kind: "cloud", origin: cloud.origin }, load: [deviceActionsModuleName, browserPlugin.name], allowed: ["REPLY", "IGNORE", "NONE", "PROPOSE_DEVICE_ACTION"] },
    frame: { credential: { version: 1, value: deviceKey } },
    bundled: new Map([[browserPlugin.name, browserPlugin]]),
    modules: builtinModuleFactories,
  })
  const socket = agent.transport.kind === "socket" ? agent.transport.path : ""
  const result = try host("the enrolled Browser overview", () => overviewJourney(socket, agent.frame.token, agent.agent.runtime.agentId, cloud))
  try Effect.try(() => {
    assert.deepStrictEqual(result.statuses, [200, 200, 200, 200, 200, 200])
    assert.strictEqual(result.compoundCount, 0)
    assert.strictEqual(result.count, 1)
    assert.deepStrictEqual(result.operation, { type: "browser_tabs_show" })
    assert.isAtLeast(result.leakedStatus, 400)
    assert.isFalse(result.leakedKept)
    assert.strictEqual(result.state, "done")
    assert.deepStrictEqual(result.locked, [200, 0])
    assert.deepStrictEqual(result.direct, { statuses: [200, 200], operation: { type: "browser_tabs_show" }, sameRequest: true })
  })
}, 120_000)
