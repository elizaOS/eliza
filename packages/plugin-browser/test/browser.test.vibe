it.effect('Open only a destination the owner wrote in this message, spelled as written, or an exact link of its page (spec/browser/requestGrounding.md, "Story: Open a destination stated in this message"; spec/browser/requestGrounding.md, "A negated destination cannot be authorized by a proposal"; spec/browser/requestGrounding.md, "A page link opens only as an exact link of the page my message carried, and only after my review"; spec/browser/requestGrounding.md, "A closing mark that could belong to the address leaves the open for my review")', effect () => {
  const grounded = [
    groundBrowserDestination("open example.com/docs please", "https://example.com/docs"),
    groundBrowserDestination("don't open example.com", "https://example.com/"),
    groundBrowserDestination("Open example.com. Actually, don't open example.com", "https://example.com/"),
    groundBrowserDestination("Open WWW.Example.com", "https://example.com"),
    groundBrowserDestination("open example.com", "https://example.com/admin"),
    groundBrowserDestination("I read example.com yesterday", "https://example.com"),
    groundBrowserDestination("summarize main.py", "https://main.py"),
    groundBrowserDestination("open example dot com", "https://example.com"),
    groundBrowserDestination("open example.com", "https://other.com"),
  ]
  const links = ["https://one.example/story", "https://two.example/post?id=2"]
  const linked = ["https://two.example/post?id=2", "https://one.example/story#top", "https://two.example/post?id=3", "https://two.example/post", "https://one.example/story/",
    "http://one.example:8080/story", "javascript:alert(1)", ""].map((proposed) => groundBrowserDestination("Open the second story.", proposed, "Eliza", links))
  const direct = [
    directBrowserDestination("open example.com"),
    directBrowserDestination("Alpha, can you pull up example.com?", "Alpha"),
    directBrowserDestination("I read example.com yesterday"),
    spokenBrowserDestination("open example dot com"),
    directBrowserDestination("open example dot com"),
  ]
  const world = "https://nytimes.com/section/world"
  const marked = [
    ["open nytimes.com/section/world.", world], ["Hey Eliza, open nytimes.com/section/world.", world], ["nytimes.com/section/world.", world],
    ["https://example.com/path!", "https://example.com/path"], ["example.com?!", "https://example.com/"], ["example.com.", "https://example.com/"],
  ].map(([text, proposed]) => [directBrowserDestination(text), groundBrowserDestination(text, proposed)])
  const unmarked = ["nytimes.com/section/world", "https://example.com/a?", "Open Reddit.com!", "open example.com/a, please", "open example.com?!", "example.com?"]
    .map((text) => directBrowserDestination(text))
  const searched = [
    directBrowserSearchQuery("search the web for cheap flights please"),
    groundBrowserSearchQuery("find me cheap   flights", "Cheap flights"),
    groundBrowserSearchQuery("find me cheapflights", "cheap"),
    typedBrowserWords("find me cheapflights", "cheap"),
    groundBrowserSearchQuery("find me cheap flights", " "),
  ]
  try Effect.try(() => {
    assert.deepStrictEqual(grounded, [
      "https://example.com/docs", undefined, undefined, "https://www.example.com/", "https://example.com/",
      "https://example.com/", undefined, "https://example.com/", undefined,
    ])
    assert.deepStrictEqual(linked, ["https://two.example/post?id=2", "https://one.example/story", undefined, undefined, undefined, undefined, undefined, undefined])
    assert.deepStrictEqual(
      [groundBrowserDestination("Do not open https://two.example/post?id=2.", "https://two.example/post?id=2", "Eliza", links), groundBrowserDestination("Open the second story.", "https://one.example/story")],
      [undefined, undefined])
    assert.deepStrictEqual(direct, ["https://example.com/", "https://example.com/", undefined, "https://example.com/", undefined])
    assert.deepStrictEqual(marked, [
      [undefined, world], [undefined, world], [undefined, world], [undefined, "https://example.com/path"], [undefined, "https://example.com/"], [undefined, "https://example.com/"],
    ])
    assert.deepStrictEqual(unmarked, [world, "https://example.com/a", "https://reddit.com/", "https://example.com/a", "https://example.com/", "https://example.com/"])
    assert.deepStrictEqual(searched, ["cheap flights", "cheap flights", "cheap", undefined, undefined])
    assert.isTrue(browserSearchQueryMatches("\"Cheap Flights\"", searched[0]))
    assert.isTrue(browserDestinationMatches({ type: "browser_navigate", url: "example.com" }, direct[0]))
    assert.isFalse(browserDestinationMatches({ type: "browser_search", url: "example.com" }, direct[0]))
  })
})

it.effect(`Offer a Browser control only as negotiated and review it only on the unlocked phone (spec/browser/control.md, "Story: Offer only the Browser controls my phone negotiated"; spec/browser/control.md, "Each control needs its group's capability, and a new-tab open needs its own"; spec/browser/control.md, "Closing every tab is its own negotiated form, refused rather than narrowed, and reviewed only on a card that lists those tabs"; spec/browser/control.md, "A control is reviewed only on the unlocked phone, and closing a tab always waits for that review")`, effect () => {
  const tabsOnly = [BROWSER_TABS_CAPABILITY]
  try Effect.try(() => {
    assert.deepStrictEqual(parseBrowserControl({ type: "browser_search", query: "  cheap   flights " }), { ok: true, operation: { type: "browser_search", query: "cheap flights" } })
    assert.deepStrictEqual(parseBrowserControl({ type: "browser_tab_new", private: false }), { ok: true, operation: { type: "browser_tab_new" } })
    assert.deepStrictEqual(parseBrowserControl({ type: "browser_tab_new", private: true }), { ok: true, operation: { type: "browser_tab_new", private: true } })
    assert.deepStrictEqual(
      [{ type: "browser_tab_new", private: "yes" }, { type: "browser_history", action: "back", tab: 1 }, { type: "browser_find", text: "a\u0000b" }, { type: "browser_history", action: "close" }]
        .map((value) => parseBrowserControl(value).ok),
      [false, false, false, false])
    assert.deepStrictEqual(
      [parseBrowserControl({ type: "browser_tabs_show" }), parseBrowserControl({ type: "browser_tabs_show", target: "bbc" }).ok, parseBrowserControl({ type: "browser_tabs_show", all: true }).ok],
      [{ ok: true, operation: { type: "browser_tabs_show" } }, false, false])
    assert.deepStrictEqual(
      [browserControlCapabilityAvailable("browser_tabs_show", tabsOnly), browserControlCapabilityAvailable("browser_tabs_show", [BROWSER_TABS_SHOW_CAPABILITY]),
        browserControlCapabilityAvailable("browser_tab_switch", [BROWSER_TABS_SHOW_CAPABILITY])],
      [false, true, false])
    assert.deepStrictEqual(
      [browserControlCapabilityAvailable("browser_tab_close", tabsOnly), browserControlCapabilityAvailable("browser_find", tabsOnly), browserControlCapabilityAvailable("browser_find", [BROWSER_FIND_CAPABILITY])],
      [true, false, true])
    assert.deepStrictEqual(
      [browserNavigationAvailable(true, tabsOnly), browserNavigationAvailable(true, [BROWSER_OPEN_NEW_TAB_CAPABILITY]), browserNavigationAvailable(false, [])],
      [false, true, true])
    assert.deepStrictEqual(parseBrowserNavigate({ type: "browser_navigate", url: "https://example.com/a", newTab: false }), { ok: true, operation: { type: "browser_navigate", url: "https://example.com/a" } })
    assert.deepStrictEqual(
      [{ type: "browser_navigate", url: "http://example.com" }, { type: "browser_navigate", url: "https://owner:pw@example.com" }, { type: "browser_navigate", url: "https://example.com", private: true }]
        .map((value) => parseBrowserNavigate(value).ok),
      [false, false, false])
    assert.deepStrictEqual(BROWSER_CONTROL_DIRECT_TYPES, ["browser_search", "browser_tab_new", "browser_tab_switch", "browser_tabs_show", "browser_find", "browser_history"])
    assert.deepStrictEqual(
      [
        browserControlRunsUnreviewed({ type: "browser_tab_close" }, { boundToMessage: true, wordsTyped: true }),
        browserControlRunsUnreviewed({ type: "browser_find", text: "price" }, { boundToMessage: true, wordsTyped: false }),
        browserControlRunsUnreviewed({ type: "browser_history", action: "back" }, { boundToMessage: true, wordsTyped: false }),
        browserControlRunsUnreviewed({ type: "browser_history", action: "back" }, { boundToMessage: false, wordsTyped: false }),
        browserControlRunsUnreviewed({ type: "browser_tabs_show" }, { boundToMessage: true, wordsTyped: false }),
        browserControlRunsUnreviewed({ type: "browser_tabs_show" }, { boundToMessage: false, wordsTyped: false }),
      ],
      [false, false, true, false, true, false])
    assert.deepStrictEqual(describeBrowserControl({ type: "browser_tabs_show" }), {
      title: "Show open tabs",
      description: "Shows the list of your open tabs in Browser. The agent does not see your tabs.",
    })
    assert.isDefined(browserControlReviewNotice({ sensitive: true }))
    assert.isUndefined(browserControlReviewNotice({ sensitive: false }))
    const closeAll = { type: "browser_tab_close", all: true } as const
    const tabs = [{ title: "News", host: "news.example" }, { title: "Docs", host: "Docs" }, { title: "Secret", private: true }]
    const everyTab = [BROWSER_TABS_CAPABILITY, BROWSER_TABS_CLOSE_ALL_CAPABILITY]
    assert.deepStrictEqual(
      [parseBrowserControl({ type: "browser_tab_close", all: true }), parseBrowserControl({ type: "browser_tab_close", all: true, target: "News" }).ok, parseBrowserControl({ type: "browser_tab_close", all: false }).ok],
      [{ ok: true, operation: closeAll }, false, false])
    assert.deepStrictEqual(
      [browserControlRefusal(closeAll, everyTab), browserControlRefusal({ type: "browser_tab_close" }, tabsOnly), browserControlRefusal(closeAll, [BROWSER_TABS_CLOSE_ALL_CAPABILITY]) !== undefined],
      [undefined, undefined, true])
    assert.notStrictEqual(browserControlRefusal(closeAll, tabsOnly), browserControlRefusal(closeAll, []))
    assert.isFalse(browserControlRunsUnreviewed(closeAll, { boundToMessage: true, wordsTyped: true }))
    assert.deepStrictEqual(
      [browserControlFormAvailable(closeAll, tabsOnly), browserControlFormAvailable(closeAll, [BROWSER_TABS_CLOSE_ALL_CAPABILITY]),
        browserControlFormAvailable(closeAll, everyTab), browserControlFormAvailable({ type: "browser_tab_close" }, tabsOnly)],
      [false, false, true, true])
    assert.deepStrictEqual(describeBrowserControl(closeAll, tabs), {
      title: "Close 3 tabs",
      description: "• News (news.example)\n• Docs\n• 1 private tab\n\nCloses every tab listed here. The agent does not see your tabs.",
    })
    assert.deepStrictEqual(
      [browserCloseAllNotice(tabs), browserCloseAllNotice(null), browserCloseAllNotice([]), browserCloseAllApprovable(tabs), browserCloseAllApprovable(undefined), browserCloseAllApprovable([])],
      [undefined, BROWSER_TABS_UNLISTED_NOTICE, BROWSER_NO_TABS_TO_CLOSE_NOTICE, true, false, false])
  })
})

const receipt = (data: unknown) => ({ ok: true, data })
const dispatched = receipt({ dispatched: true, completed: false, requiresReadback: true })
const replied = (result: unknown): BrowserViewAsked => ({ kind: "asked", wait: succeed<BrowserViewWait>({ kind: "Replied", reply: "Answered", answer: { success: true, result } }) })
const browserTab = { view: "browser", revision: 4, sensitive: false, selectedObject: { kind: "browser-tab", id: "tab-a", revision: "r1" } }

function turn(observation?: unknown): Memory {
  return {
    entityId: "00000000-0000-4000-8000-000000000001",
    roomId: "00000000-0000-4000-8000-000000000002",
    content: { text: "go back", metadata: { viewClientId: "client-1", ...(observation === undefined ? {} : { observation }) } },
  } as unknown as Memory
}

function renderer(answers: BrowserViewAsked[]) {
  const asks: unknown[] = []
  const views: BrowserViewAsker = {
    effect ask(request) {
      asks.push(request.params)
      const next: BrowserViewAsked = answers.shift() ?? { kind: "unavailable" }
      return next
    },
  }
  const runtime = { getService: (name: string) => (name === "agent_view_host" ? { views } : null) } as unknown as IAgentRuntime
  return { asks, runtime }
}

const failureKind = (result: ActionResult) => {
  const failure = result.data?.dispatchFailure
  return typeof failure === "object" && failure !== null && "kind" in failure ? failure.kind : undefined
}

it.effect('Go back on the tab the turn observed and say only that the browser was asked (spec/browser/remoteControl.md, "Story: Go back, forward or reload only on the tab the turn observed"; spec/browser/remoteControl.md, "A history command carries the observed tab and revision, and the renderer refuses a changed page"; spec/browser/control.md, "Story: Tell me a Browser command was sent, never that the page finished"; spec/browser/control.md, "A history receipt proves dispatch only, and any other answer is a typed refusal or uncertain"; spec/browser/control.md, "A history move has one home: the Browser control where my phone negotiated it, or else the BROWSER command"; spec/agent/conversation/planning.md, "An action may narrow its tool to the turn, never beyond its registered form")', effect () => {
  const back = browserPlugin.actions?.find((action) => action.name === "BROWSER_BACK")
  const reload = browserPlugin.actions?.find((action) => action.name === "BROWSER_RELOAD")
  try Effect.try(() => assert.isTrue(back !== undefined && reload !== undefined))
  const device = renderer([
    replied(dispatched),
    replied(dispatched),
    replied(receipt({ dispatched: true, completed: true, requiresReadback: true })),
    replied({ ok: false, code: "UNAVAILABLE", message: "Browser is not showing." }),
    replied({ ok: false, code: "CLICKED_SOMETHING", message: "?" }),
    { kind: "asked", wait: succeed<BrowserViewWait>({ kind: "Unknown" }) },
    { kind: "refused" },
  ])
  const run = (message: Memory, action = back) => promise(() => action!.handler(device.runtime, message, undefined, {}))
  const commandOffered = try promise(() => back!.validate(device.runtime, turn(browserTab)))
  const commandWithoutBrowser = try promise(() => back!.validate({ getService: () => null } as unknown as IAgentRuntime, turn(browserTab)))
  const toolsOffered = (getService: IAgentRuntime["getService"]) =>
    offeredActions({ actions: browserPlugin.actions ?? [], getService } as unknown as AgentRuntime, turn(browserTab), () => undefined).map(({ name }) => name).toSorted()
  const offeredWithBrowser = toolsOffered(device.runtime.getService)
  const offeredWithoutBrowser = toolsOffered(() => null)
  const observed = try run(turn(browserTab))
  const sensitive = try run(turn({ ...browserTab, sensitive: true, selectedObject: undefined }), reload)
  const completed = try run(turn(browserTab))
  const refusedFirst = try run(turn(browserTab))
  const unknownCode = try run(turn(browserTab))
  const lost = try run(turn(browserTab))
  const notOffered = try run(turn(browserTab))
  const noFeed = try run(turn(browserTab))
  const noClient = try promise(() => back!.handler(device.runtime, { ...turn(browserTab), content: { text: "go back" } }, undefined, {}))
  const command = parseNativeHistoryCommand({ subaction: "back" }, { id: "tab-a", revision: "r1" })
  try Effect.try(() => {
    assert.deepStrictEqual(device.asks.slice(0, 2), [
      { command: { subaction: "back" }, selection: { id: "tab-a", revision: "r1" } },
      { command: { subaction: "reload" } },
    ])
    assert.strictEqual(device.asks.length, 8)
    assert.deepStrictEqual([commandOffered, commandWithoutBrowser], [true, false])
    assert.deepStrictEqual([offeredWithBrowser, offeredWithoutBrowser], [["BROWSER", "BROWSER_BACK", "BROWSER_FORWARD", "BROWSER_RELOAD"], []])
    assert.deepStrictEqual([observed.success, observed.turnComplete, observed.verifiedUserFacing, observed.userFacingText, observed.data?.executionStatus], [true, true, undefined, undefined, "dispatched"])
    assert.deepStrictEqual((observed.data?.result as { value?: unknown } | undefined)?.value, { dispatched: true, completed: false, requiresReadback: false })
    assert.match(observed.text ?? "", /^The phone's browser was asked to go back, and the previous page may still be loading\. Say only that you asked it to go back: never that it went back, arrived or what it shows\. \{/u)
    assert.isTrue(sensitive.success)
    assert.deepStrictEqual(
      [completed, refusedFirst, unknownCode, lost, notOffered, noFeed, noClient].map((result) => [result.success, failureKind(result)]),
      [[false, "UNCERTAIN_OUTCOME"], [false, "UNAVAILABLE"], [false, "UNCERTAIN_OUTCOME"], [false, "UNCERTAIN_OUTCOME"], [false, "UNSUPPORTED"], [false, "UNAVAILABLE"], [false, "UNAVAILABLE"]])
    assert.deepStrictEqual(browserPlugin.views?.map(({ id, path, modalities, capabilities }) => [id, path, modalities, capabilities?.map((offered) => offered.id)]),
      [[BROWSER_VIEW.viewId, "/browser", ["gui"], [BROWSER_VIEW.capability]]])
    assert.deepStrictEqual(command, { ok: true, command: { subaction: "back", selection: { id: "tab-a", revision: "r1" } } })
    assert.isFalse(parseNativeHistoryCommand({ subaction: "click" }).ok)
    assert.isFalse(parseNativeHistoryCommand({ subaction: "back" }, { id: "tab-a" }).ok)
    assert.deepStrictEqual(
      [observedTabCurrent({ id: "tab-a", revision: "r1" }, { id: "tab-a", revision: "r1" }), observedTabCurrent({ id: "tab-a", revision: "r1" }, { id: "tab-a", revision: "r2" }),
        observedTabCurrent({ id: "tab-a", revision: "r1" }, { id: "tab-b", revision: "r1" }), observedTabCurrent(undefined, { id: "tab-b", revision: "r9" })],
      [true, false, false, true])
  })
})

module node {
  import type { IAgentRuntime } from "@elizaos/core"
  import { negotiatedOwnerTurn, type DeviceTurn } from "@elizaos/agent-host"
  import { readOperation } from "@elizaos/agent"
  import { browserProposalFamily } from "../src/proposal.vibe"

  export const everyBrowserCapability = ["browser.search.v1", "browser.tabs.v1", "browser.tabs.close-all.v1", "browser.tabs.show.v1", "browser.find.v1", "browser.history.v1", "browser.open-new-tab.v1"]
  export const pageObservation = { view: "browser", revision: 1, sensitive: false, selectedObject: { kind: "browser-tab", id: "session:tab", revision: "4" } }
  export const pageLinks = [{ text: "The first story", url: "https://one.example/story" }, { text: "The second story", url: "https://two.example/post?id=2" }]
  /** @throws {never} */
  export function frontPage(revision = "4") {
    return {
      tabId: "session:tab", revision, url: "https://news.example/", title: "Front page", capturedAt: 1,
      text: "1. The first story\n2. The second story", truncated: false, links: pageLinks,
    }
  }

  /** @throws {never} */
  export function ownerTurn(ownerText: string, capabilities: readonly string[], browserPage?: unknown, observation: unknown = pageObservation): DeviceTurn {
    return negotiatedOwnerTurn(capabilities, {
      runtime: {} as IAgentRuntime, by: {} as DeviceTurn["by"],
      message: {
        id: "00000000-0000-4000-8000-000000000010", entityId: "00000000-0000-4000-8000-000000000001", roomId: "00000000-0000-4000-8000-000000000002",
        content: { text: ownerText, ...(browserPage === undefined ? {} : { metadata: { observation, browserPage } }) },
      } as DeviceTurn["message"],
      ownerText, observation: (browserPage === undefined ? undefined : observation) as DeviceTurn["observation"],
      completedActionNavigation: false, completesReads: false, conversationId: "conversation", requestId: "request", startedAt: 0, timeZone: undefined,
    })
  }


  export function checked(operation: unknown) {
    const read = readOperation(operation)
    if (read === undefined) throw new Error(`Not a device operation: ${JSON.stringify(operation)}`)
    return read
  }

  /** @throws {never} */
  export function offeredForms(turn: DeviceTurn) {
    return browserProposalFamily.forms.filter((form) => form.offered(turn)).map((form) => [form.types[0], ...Object.keys(form.schema.properties ?? {}).filter((key) => key !== "type")].join(" "))
  }
}

import { checked, everyBrowserCapability, frontPage, offeredForms, ownerTurn, pageObservation } from node

it.effect(`Ground a Browser proposal in the owner's own words or an exact page link, bind only a whole-message request, or offer nothing, and run a command from any owner chat but never for another role, showing Browser while it runs (spec/agent/conversation/planning.md, "A tool's progress names its app only when one labelled app applies, and never its arguments or results"; spec/browser/control.md, "Story: Propose a Browser control in my own words"; spec/browser/control.md, "A search runs on my words as I typed them, and a search the model words differently runs only after my review"; spec/browser/control.md, "A search, tab switch or find runs without my review only on words I typed for it, and a search only as my whole message"; spec/browser/control.md, "Closing every tab on a phone that closes one tab at a time is refused with its reason, never narrowed"; spec/browser/control.md, "A refused Browser proposal tells me how to ask, and never says anything opened"; spec/browser/control.md, "Each control needs its group's capability, and a new-tab open needs its own"; spec/browser/control.md, "A history move has one home: the Browser control where my phone negotiated it, or else the BROWSER command"; spec/browser/requestGrounding.md, "A page link opens only as an exact link of the page my message carried, and only after my review"; spec/browser/requestGrounding.md, "An open runs without my review only when my whole message asked to open that address"; spec/browser/requestGrounding.md, "An address opens in a tab of its own only when the model asked for one and the phone has one, and an empty tab stays empty"; spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/browser/control.md, "Story: Tell me a Browser command was sent, never that the page finished")`, effect () => {
  const tabsOnly = ["browser.tabs.v1"]
  const propose = effect (ownerText: string, operation: unknown, capabilities: readonly string[] = everyBrowserCapability, page?: unknown, observation: unknown = pageObservation) => {
    const proposed = try Effect.try(() => checked(operation))
    const grounding = try browserProposalFamily.ground(proposed, ownerTurn(ownerText, capabilities, page, observation))
    return grounding.kind === "Grounded" ? { operation: grounding.operation, reviewed: grounding.grounding === "GroundedForReview" } : grounding.code
  }
  const navigate = (url: string, newTab?: true): DeviceOperation => ({ type: "browser_navigate", url, ...(newTab === undefined ? {} : { newTab }) })
  const direct = (operation: DeviceOperation) => ({ operation, reviewed: false })
  const reviewed = (operation: DeviceOperation) => ({ operation, reviewed: true })
  const notRequested = "DEVICE_BROWSER_NOT_REQUESTED"
  const opened = [
    try propose("can you open wikipedia.org in a new tab?", navigate("wikipedia.org")),
    try propose("open example.com/docs please", navigate("https://example.com/docs", true), tabsOnly),
    try propose("I read example.com yesterday", navigate("https://example.com")),
    try propose("open example dot com", navigate("https://example.com")),
    try propose("open example dot com in a new tab", navigate("https://example.com")),
    try propose("open example.com", navigate("https://evil.example/")),
    try propose("do that in the browser", navigate("https://example.com/")),
  ]
  const dictatedOperation = navigate("https://alphacompute.ai/")
  const dictatedPage = { ...frontPage(), links: [{ text: "The first story", url: "https://alphacompute.ai/" }] }
  const dictated = [
    [try propose("Can you open alphacompute. AI in the browser, please?", dictatedOperation), direct(dictatedOperation)],
    [try propose("Can you open up alphacompute.ai in the browser?", dictatedOperation), direct(dictatedOperation)],
    [try propose("Open up alphacompute.ai", dictatedOperation), direct(dictatedOperation)],
    [try propose("Can you open alphacompute. AI in the browser, please?", navigate("https://example.com/")), reviewed(navigate("https://example.com/"))],
    [try propose("Can you open alphacompute. AI in the browser, please?", navigate("https://alphacompute.ai/extra")), notRequested],
    [try propose("Can you open alphacompute.ai/path. ZZ in the browser?", navigate("https://alphacompute.ai/path.zz")), notRequested],
    [try propose("Summarize alphacompute. AI in the browser, please.", dictatedOperation), notRequested],
    [try propose("Can you open alphacompute. AI in the browser or open example.com?", dictatedOperation), notRequested],
    [try propose("Can you open alphacompute. AI in the browser? Actually, don't.", dictatedOperation), notRequested],
    [try propose("Can you open alphacompute. ZZ in the browser, please?", navigate("https://alphacompute.zz/")), notRequested],
    [try propose("Can you open alphacompute. AI, please?", dictatedOperation), reviewed(dictatedOperation)],
    [try propose("Open alphacompute.ai. Don't open alphacompute. AI in the browser.", dictatedOperation), notRequested],
    [try propose("Open the first story, but don't open alphacompute. AI in the browser.", dictatedOperation, everyBrowserCapability, dictatedPage), notRequested],
  ]
  const refusedOpen = effect (ownerText: string, operation: unknown) => {
    const grounding = try browserProposalFamily.ground(try Effect.try(() => checked(operation)), ownerTurn(ownerText, everyBrowserCapability))
    return grounding.kind === "Refused" ? { code: grounding.code, userFacingText: grounding.forOwner } : grounding.kind
  }
  const refusedOpens = [
    try refusedOpen("open the news site", navigate("https://news.example/")),
    try refusedOpen("open example.com", navigate("https://evil.example/")),
    try refusedOpen("don't open example.com, take me to the bank", navigate("https://example.com/")),
  ]
  const emptyTab: DeviceOperation = { type: "browser_tab_new" }
  const tabbed = [
    try propose("open wikipedia.org in a new tab", emptyTab),
    try propose("open example dot com in a new tab", emptyTab),
    try propose("open wikipedia.org in a new tab", emptyTab, tabsOnly),
    try propose("open wikipedia.org in a new tab", { type: "browser_tab_new", private: true }),
    try propose("open a new tab", emptyTab),
  ]
  const linked = [
    try propose("Open the second story.", navigate("https://two.example/post?id=2"), everyBrowserCapability, frontPage()),
    try propose("Open the second story.", navigate("https://one.example/story#top"), everyBrowserCapability, frontPage()),
    try propose("Open the second story.", navigate("https://evil.example/"), everyBrowserCapability, frontPage()),
    try propose("Open the second story.", navigate("https://one.example/story/"), everyBrowserCapability, frontPage()),
    try propose("Open the second story.", navigate("https://two.example/post?id=2"), everyBrowserCapability, frontPage("5")),
    try propose("Open the second story.", navigate("https://two.example/post?id=2"), everyBrowserCapability, frontPage(), { ...pageObservation, view: "home" }),
    try propose("Do not open https://two.example/post?id=2.", navigate("https://two.example/post?id=2"), everyBrowserCapability, frontPage()),
    try propose("Open the second story.", navigate("https://two.example/post?id=2")),
  ]
  const tabList: DeviceOperation = { type: "browser_tabs_show" }
  const controls = [
    try propose("search the web for cheap flights please", { type: "browser_search", query: "Cheap  flights" }),
    try propose("find me cheap flights", { type: "browser_search", query: "cheap flights" }),
    try propose("search for cheap flights", { type: "browser_search", query: "cheap hotels" }),
    try propose("switch to the bbc tab", { type: "browser_tab_switch", target: "bbc" }),
    try propose("switch to the bbc tab", { type: "browser_tab_switch", target: "BBC News" }),
    try propose("find price on this page", { type: "browser_find", text: "price" }),
    try propose("find price on this page", { type: "browser_find", text: "cost" }),
    try propose("open a new private tab", { type: "browser_tab_new", private: true }),
    try propose("close all the browser tabs", { type: "browser_tab_close", all: true }, tabsOnly),
    try propose("close all the browser tabs", { type: "browser_tab_close", all: true }),
    try propose("close the bbc tab", { type: "browser_tab_close", target: "bbc" }, tabsOnly),
    try propose("go back", { type: "browser_history", action: "back" }),
    try propose("show my open tabs", tabList),
    try propose("show my contacts", tabList),
    try propose("don't show my tabs", tabList),
    try propose("show my tabs and close the bbc one", tabList),
  ]
  const outright = [
    try propose("open example.com in a new tab", navigate("https://example.com/")),
    try propose("open example.com in a new tab", navigate("https://example.com/", true)),
    try propose("open example.com in a new tab", navigate("https://example.com/", true), tabsOnly),
    try propose("Hey Eliza, visit wikipedia.org.", navigate("https://wikipedia.org/")),
  ]
  const shown = (try Effect.try(() => checked({ type: "browser_tabs_show" }))).operation
  const wikipedia = (try Effect.try(() => checked(navigate("https://wikipedia.org/", true)))).operation
  const told = [
    browserProposalFamily.proposedText(wikipedia, { direct: true, timeZone: undefined, ownerText: "open wikipedia.org in a new tab" })?.forOwner,
    browserProposalFamily.proposedText(wikipedia, { direct: true, timeZone: undefined, ownerText: "open wikipedia.org in a new tab" })?.forModel,
    browserProposalFamily.proposedText(wikipedia, { direct: false, timeZone: undefined, ownerText: "open wikipedia.org in a new tab" }),
    browserProposalFamily.settledText(wikipedia, { outcome: "applied" }, undefined),
  ]
  const toldShown = browserProposalFamily.proposedText(shown, { direct: true, timeZone: undefined, ownerText: "show my open tabs" })
  const runtime = { contexts: try Effect.try(() => new ContextRegistry()) } as unknown as IAgentRuntime
  try promise(() => Promise.resolve(browserPlugin.init?.({}, runtime)))
  const again = try Effect.result(registerDeviceProposalFamily(runtime, browserProposalFamily))
  const rival = try Effect.result(registerDeviceProposalFamily(runtime, { ...browserProposalFamily, name: "files" }))
  try Effect.try(() => {
    assert.deepStrictEqual(opened, [
      direct(navigate("https://wikipedia.org/")), direct(navigate("https://example.com/docs")), reviewed(navigate("https://example.com/")),
      reviewed(navigate("https://example.com/")), reviewed(navigate("https://example.com/")), notRequested, reviewed(navigate("https://example.com/")),
    ])
    assert.deepStrictEqual(dictated.map(([actual]) => actual), dictated.map(([, expected]) => expected))
    assert.deepStrictEqual(refusedOpens, [
      { code: notRequested, userFacingText: "Tell me the address, like example.com." },
      { code: notRequested, userFacingText: "I didn't open that address." },
      { code: notRequested, userFacingText: "I didn't open that address." },
    ])
    assert.deepStrictEqual(tabbed, [
      direct(emptyTab), direct(emptyTab), direct(emptyTab),
      direct({ type: "browser_tab_new", private: true }), direct(emptyTab),
    ])
    assert.deepStrictEqual(linked, [
      reviewed(navigate("https://two.example/post?id=2")), reviewed(navigate("https://one.example/story")),
      notRequested, notRequested, notRequested, notRequested, notRequested, notRequested,
    ])
    assert.deepStrictEqual(controls, [
      direct({ type: "browser_search", query: "cheap flights" }), reviewed({ type: "browser_search", query: "cheap flights" }), reviewed({ type: "browser_search", query: "cheap hotels" }),
      direct({ type: "browser_tab_switch", target: "bbc" }), reviewed({ type: "browser_tab_switch", target: "BBC News" }),
      direct({ type: "browser_find", text: "price" }), reviewed({ type: "browser_find", text: "cost" }),
      direct({ type: "browser_tab_new", private: true }),
      "DEVICE_BROWSER_CLOSE_ALL_UNAVAILABLE", direct({ type: "browser_tab_close", all: true }), direct({ type: "browser_tab_close", target: "bbc" }),
      direct({ type: "browser_history", action: "back" }), direct(tabList), direct(tabList), direct(tabList), direct(tabList),
    ])
    assert.strictEqual(told[0], "Opening wikipedia.org.")
    assert.match(String(told[1] ?? ""), /opens this exact requested address in its Browser right after this reply, with no review\. It has not loaded yet.*Which screen shows later is what each later message's screen context says/)
    assert.notMatch(`${told[0]} ${told[1]}`, /for the owner to open|ready to open/)
    assert.deepStrictEqual(told.slice(2), [undefined, undefined])
    assert.strictEqual(toldShown?.forOwner, "Doing that in Browser.")
    assert.match(toldShown?.forModel ?? "", /has not run yet/)
    assert.isUndefined(browserProposalFamily.settledText(shown, { outcome: "applied" }, undefined))
    assert.deepStrictEqual(outright, [
      direct(navigate("https://example.com/")), direct(navigate("https://example.com/", true)), direct(navigate("https://example.com/")), direct(navigate("https://wikipedia.org/")),
    ])
    assert.deepStrictEqual(offeredForms(ownerTurn("", everyBrowserCapability)), [
      "browser_navigate url newTab", "browser_search query", "browser_tab_new private", "browser_tab_switch target", "browser_tab_close target all", "browser_tabs_show",
      "browser_find text", "browser_history action",
    ])
    assert.deepStrictEqual(offeredForms(ownerTurn("", tabsOnly)), ["browser_navigate url", "browser_tab_new private", "browser_tab_switch target", "browser_tab_close target all"])
    assert.deepStrictEqual(offeredForms(ownerTurn("", ["browser.tabs.show.v1"])), ["browser_navigate url", "browser_tabs_show"])
    assert.deepStrictEqual(offeredForms(ownerTurn("", [])), [])
    assert.deepStrictEqual([Result.isSuccess(again), Result.isFailure(rival) ? rival.failure._tag : "registered"], [true, "FamilyConflict"])
    assert.deepStrictEqual(browserPlugin.actions?.map((action) => activityLabel(runtime, action)), browserPlugin.actions?.map(() => "Using Browser"))
    const registered = (action: Action) => ({ ...action, contexts: resolveActionContexts(action) })
    const runsOnTurn = (action: Action) => canActionRun(registered(action), { userRoles: ["OWNER"], activeContexts: ["general"] })
    const runsForUser = (action: Action) => canActionRun(registered(action), { userRoles: ["USER"], activeContexts: ["general"] })
    assert.deepStrictEqual([browserAction.contexts, registered(browserAction).contexts, runsOnTurn(browserAction), runsForUser(browserAction)], [undefined, ["browser", "general"], true, false])
  })
})

it.effect(`Review a reload of a page the phone withheld on the phone, and run it as the BROWSER command only when the model says the owner asked, on the observed tab and never on a sign-in page (spec/browser/control.md, "Story: Tell me you cannot read my page, and never reload it unasked"; spec/browser/control.md, "A reload of a page my phone withheld runs only after my review on the phone, or as the BROWSER command only when the model says I asked for it"; spec/browser/control.md, "A refused Browser proposal tells me how to ask, and never says anything opened")`, effect () => {
  const summarize = "summarize this page in two sentences"
  const withheld = (reason: "unreadable" | "sensitive-page", tabId = "session:tab", revision = "4") =>
    ({ tabId, revision, url: "https://bank.example.com/statement", title: "Statement", capturedAt: 1, withheld: reason })
  const reload: DeviceOperation = { type: "browser_history", action: "reload" }
  const propose = effect (ownerText: string, operation: DeviceOperation, page?: unknown) => {
    const proposed = try Effect.try(() => checked(operation))
    return try browserProposalFamily.ground(proposed, ownerTurn(ownerText, everyBrowserCapability, page, pageObservation))
  }
  const outcome = effect (ownerText: string, operation: DeviceOperation, page?: unknown) => {
    const grounding = try propose(ownerText, operation, page)
    return grounding.kind === "Grounded" ? { operation: grounding.operation, reviewed: grounding.grounding === "GroundedForReview" } : grounding.code
  }
  const proposals = [
    try outcome(summarize, reload, withheld("unreadable")),
    try outcome(summarize, reload, withheld("sensitive-page")),
    try outcome("reload this page", reload, withheld("unreadable")),
    try outcome("Can you refresh it?", reload, withheld("unreadable")),
    try outcome("Don't reload it, just summarize it", reload, withheld("unreadable")),
    try outcome(summarize, reload, frontPage()),
    try outcome(summarize, reload),
    try outcome("go back", { type: "browser_history", action: "back" }, withheld("unreadable")),
  ]
  const samePage = { type: "browser_navigate", url: "https://bank.example.com/statement#heading" } as const
  const reopen = [
    try outcome("Summarize https://bank.example.com/statement#heading", samePage, withheld("unreadable")),
    try outcome("Summarize https://bank.example.com/statement#heading", samePage, withheld("sensitive-page")),
    try outcome("Open https://bank.example.com/statement#heading", samePage, withheld("unreadable")),
    try outcome("Can you open https://bank.example.com/statement#heading in the browser?", samePage, withheld("unreadable")),
    try outcome("Summarize https://bank.example.com/statement#heading", samePage),
  ]
  const statement = { type: "browser_navigate", url: "https://bank.example.com/statement" } as const
  const dictatedSite = { type: "browser_navigate", url: "https://alphacompute.ai/" } as const
  const exactReopen = [
    try outcome("Please summarize https://bank.example.com/statement in two sentences.", statement, withheld("unreadable")),
    try outcome("reload this page", statement, withheld("unreadable")),
    try outcome("open https://bank.example.com/statement#details", statement, withheld("unreadable")),
    try outcome("Eliza, can you open https://bank.example.com/statement?", statement, withheld("unreadable")),
    try outcome("open https://bank.example.com/statement", statement, withheld("unreadable")),
    try outcome("Eliza, can you open https://bank.example.com/statement", statement, withheld("unreadable")),
    try outcome("Can you open alphacompute. AI in the browser, please?", dictatedSite, { ...withheld("unreadable"), url: "https://alphacompute.ai/" }),
  ]
  const reloadCommand = browserPlugin.actions?.find((action) => action.name === "BROWSER_RELOAD")
  try Effect.try(() => assert.isTrue(reloadCommand !== undefined))
  const asks = [
    "reload this page", "please refresh", "can you re-open this page?", "Couldn't you refresh it?", "Don't go back, just refresh it",
    "Please don't navigate away; just refresh", "Don't open anything new, just reload this page",
    "try reloading", "hit refresh", "can you open it again?",
    "Reload this page. Actually, don't send the email.",
    "Reload this page. Send the email. Actually, don't.",
    "Reload this page, send the email, actually, don't.",
    "Refresh", "please refresh the page", "can you reload it?", "re-open this page", "open it again", "It looks stuck, reload",
    "it isn't loading so reload it", "the page won't load so please refresh", "this page doesn't work so reload it",
    "could you please refresh the page?", "Don't go back but reload it", "open the article then reload it",
  ]
  const mentions = [
    summarize, "don't reload it", "why won't this page reload?", "refresh my memory about this page", "I reloaded it already",
    "This page keeps asking me to refresh, why?", "Summarize this. If it fails to load I'll refresh it myself", "Refresh me on what this page says",
    "Summarize this refreshing article", "Reload it. Actually, no, don't.", "yes please",
    "Reload this page. Actually, don't reload it.",
    "Reload this page. Actually, don't open it again.",
    "Reload this page. Actually, do not close the tab or reload it.",
    "Reload this page. Actually, don't. Tell me the time.",
    "Reload this page — wait, do not.",
    "Reload this page — actually don't reload it.",
    "Reload this page; never mind; tell me the time.",
    "Reload it. Actually don’t, thanks.",
    "Reload it, never mind, open a new tab.",
    "Reload it: do not — tell me the time.",
    "Reload this page. Never mind. Summarize what you have.",
    "what is this page about?", "don't reload the page", "do not reopen or refresh this page", "please do not close this tab and reload it",
    "Reload this page. Actually, don't.", "Reload this page. Never mind.", "Reload this page, actually, don't.",
    "do not refresh it, just tell me what it says", "summarize it without reloading", "no need to reload, just read it", "please don't reload it",
    "reload this page\nand then summarize it", "summarize this article about the reopening of Notre-Dame",
    "what is the refresh rate on this monitor page?", "summarize this page about refreshing your skin", "why did you reload the page?",
    "If it fails to load then I'll refresh it myself", "it won't load, so don't reload it, just read it", "it's slow so don't refresh it",
  ]
  const modelSays = (text: string) => asks.includes(text) ? { ownerAskedReload: true } : {}
  const device = renderer(Array.from({ length: asks.length + 1 }, () => replied(dispatched)))
  const commandTurn = (text: string, browserPage: unknown, observation: unknown = browserTab): Memory =>
    ({ ...turn(observation), content: { text, metadata: { viewClientId: "client-1", observation, browserPage } } }) as Memory
  const command = (text: string, browserPage: unknown, parameters: { readonly ownerAskedReload?: boolean } = modelSays(text), observation: unknown = browserTab) =>
    promise(() => reloadCommand!.handler(device.runtime, commandTurn(text, browserPage, observation), undefined, { parameters }))
  const refusedMentions: string[] = []
  for (const text of mentions) if ((try command(text, withheld("unreadable", "tab-a", "r1"))).success) refusedMentions.push(text)
  const unasked = try command(summarize, withheld("unreadable", "tab-a", "r1"))
  const sensitive = try command(summarize, withheld("sensitive-page", "tab-a", "r1"))
  const withdrawn = try command("Reload this page. Actually, don't. Tell me the time.", withheld("unreadable", "tab-a", "r1"))
  const askedSensitive = try command("refresh it", withheld("sensitive-page", "tab-a", "r1"), { ownerAskedReload: true })
  const asksAfterRefusal = device.asks.length
  const askedRuns: string[] = []
  for (const text of asks) if (!(try command(text, withheld("unreadable", "tab-a", "r1"))).success) askedRuns.push(text)
  const readable = try command(summarize, { ...frontPage(), tabId: "tab-a", revision: "r1" })
  try Effect.try(() => {
    assert.deepStrictEqual(proposals, [
      { operation: reload, reviewed: true }, { operation: reload, reviewed: true }, { operation: reload, reviewed: true },
      { operation: reload, reviewed: true }, { operation: reload, reviewed: true },
      { operation: reload, reviewed: false }, { operation: reload, reviewed: false },
      { operation: { type: "browser_history", action: "back" }, reviewed: false },
    ])
    assert.deepStrictEqual(reopen.map(result => typeof result === "string" ? result : result.operation), ["DEVICE_BROWSER_NOT_REQUESTED", "DEVICE_BROWSER_NOT_REQUESTED", samePage, samePage, samePage])
    assert.deepStrictEqual(exactReopen, [
      "DEVICE_BROWSER_NOT_REQUESTED", "DEVICE_BROWSER_NOT_REQUESTED",
      { operation: { type: "browser_navigate", url: "https://bank.example.com/statement#details" }, reviewed: false }, { operation: statement, reviewed: false },
      { operation: statement, reviewed: false }, { operation: statement, reviewed: false }, { operation: dictatedSite, reviewed: false },
    ])
    assert.deepStrictEqual(refusedMentions, [])
    assert.deepStrictEqual([unasked, sensitive, withdrawn, askedSensitive].map((result) => [result.success, failureKind(result), result.text]),
      Array.from({ length: 4 }, () => [false, "POLICY_BLOCKED", BROWSER_RELOAD_WITHHELD_REFUSAL]))
    assert.strictEqual(asksAfterRefusal, 0)
    assert.deepStrictEqual(askedRuns, [])
    assert.deepStrictEqual([readable.success, readable.data?.executionStatus], [true, "dispatched"])
    assert.strictEqual(device.asks.length, asks.length + 1)
  })
})

it.effect('Open on the screen the owner asked from an address their whole message asked for, show any other for the owner to open, and nowhere an enrolled phone takes it (spec/browser/control.md, "Story: Open an address on the screen I asked from"; spec/browser/control.md, "An open has one home: the Browser proposal where my enrolled phone takes it, else the screen I asked from"; spec/browser/control.md, "The screen opens an address my whole message asked for at once, and shows any other address for me to open"; spec/browser/control.md, "A refused Browser proposal tells me how to ask, and never says anything opened")', effect () => {
  const runtime = { character: { name: "Eliza" } } as unknown as IAgentRuntime
  const asked = (text: string, delivery: unknown = "completed-action") => ({
    id: "00000000-0000-4000-8000-000000000011", entityId: "00000000-0000-4000-8000-000000000001", roomId: "00000000-0000-4000-8000-000000000002",
    content: { text, metadata: { viewClientId: "client-1", viewDelivery: delivery } },
  }) as unknown as Memory
  const open = (text: string, url: string) => promise(() => browserOpenAction.handler(runtime, asked(text), undefined, { parameters: { url } }) as Promise<ActionResult>)
  const results = [
    try open("open example.com", "https://example.com"),
    try open("Open the Wikipedia article about the Eiffel Tower", "https://en.wikipedia.org/wiki/Eiffel_Tower"),
    try open("don't open example.com", "https://example.com"),
    try open("open http://example.com:8080", "http://example.com:8080"),
    try open("Open https://www.alphacompute.ai/ in Browser.", "https://www.alphacompute.ai/"),
    try open("Visit alphacompute.ai.", "https://alphacompute.ai/"),
  ]
  const opened = (url: string, atOnce: boolean) => ({ actionName: "BROWSER_OPEN", mode: "open", operation: { type: "browser_navigate", url }, clientId: "client-1", atOnce })
  const owner = { agentId: "00000000-0000-4000-8000-000000000003", actorId: "00000000-0000-4000-8000-000000000001", connector: "device" }
  const phone = try Effect.try(() => deviceTurnPort(runtime as AgentRuntime, () => Effect.succeed(owner), { completesReads: true, viewsAllowed: true }))
  const fromPhone = (capabilities: readonly string[]) => promise(async () => {
    const message = asked("open example.com")
    const session = await phone.begin({
      headers: new Map([[capabilitiesHeader, capabilities.join(",")]]), conversationId: "conversation-1", requestId: "request-1",
      message: message as Memory & { readonly id: UUID }, signal: new AbortController().signal,
    })
    if (session === undefined) return "no phone turn"
    const during = await session.run(async () => [opensOnScreen(runtime, message), await browserOpenAction.validate(runtime, message)])
    await session.end()
    return [...during, opensOnScreen(runtime, message)]
  })
  const takesOpens = try fromPhone(everyBrowserCapability)
  const takesNoBrowser = try fromPhone([])
  try Effect.try(() => {
    assert.deepStrictEqual([opensOnScreen(runtime, asked("open example.com")), opensOnScreen(runtime, asked("open example.com", "stream"))], [true, false])
    assert.deepStrictEqual(takesOpens, [false, false, true])
    assert.deepStrictEqual(takesNoBrowser, [true, true, true])
    assert.deepStrictEqual(results.map((result) => result.success ? result.data : { code: result.data?.code, userFacingText: result.userFacingText }), [
      opened("https://example.com/", true),
      opened("https://en.wikipedia.org/wiki/Eiffel_Tower", false),
      { code: "DEVICE_BROWSER_NOT_REQUESTED", userFacingText: "I didn't open that address." },
      { code: "DEVICE_BROWSER_NOT_REQUESTED", userFacingText: "Tell me the address, like example.com." },
      opened("https://www.alphacompute.ai/", true),
      opened("https://alphacompute.ai/", true),
    ])
    assert.match(results[0]?.text ?? "", /^Opening example\.com\. .*opens this address in its Browser right after this reply, with no review\. It has not loaded yet.*Which screen shows later is what each later message's screen context says/)
    assert.match(results[1]?.text ?? "", /^Showing en\.wikipedia\.org for the owner to open\. .*opens only if they choose Open there\. It has not opened/)
    assert.notMatch(results.slice(1, 4).map((result) => result.text ?? "").join(" "), /Opening|with no review/)
    assert.isTrue(browserPlugin.actions?.includes(browserOpenAction))
    assert.match(browserOpenAction.description ?? "", /To show Browser itself, with no address to open, use VIEWS\./)
  })
})

it.effect(`Arbitrate visible browser targets, preserve epoch binding fences, lease credentials safely, and bound redacted inference retries (spec/browser/arbitration.md, "Story: Follow the browser the person can see"; spec/browser/arbitration.md, "Story: Keep task binding authority on its original browser"; spec/browser/clipboardLease.md, "Story: A copied credential is erased by the command that wrote it"; spec/browser/inference.md, "Story: Send each model call through my account's route with private text removed, and drop stale results")`, effect () => {
  const arb = createBrowserArbitrationSession()
  const begun = try promise(() => arb.beginBind(1))
  const chosen = try promise(() => arb.choosePeer("EmbeddedPeer"))
  const finished = try promise(() => arb.finishBind(true))
  const boundSnap = try promise(() => arb.snapshot())
  const staleRejected = try promise(() => arb.beginBind(0))
  const revoked = try promise(() => arb.revokeBrowser(1))
  const revokedSnap = try promise(() => arb.snapshot())
  const postRevokeRejected = try promise(() => arb.beginBind(1))

  let activeClipboardPort = 0
  const clipStore = new Map<number, string>([[0, ""], [1, ""]])
  const clipCleared: number[] = []
  const clipLayer = Layer.succeed(ClipboardPort, {
    effect currentPort() {
      return activeClipboardPort
    },
    effect writeSecret(port: number, secret: string) {
      clipStore.set(port, secret)
    },
    effect readText(port: number) {
      return clipStore.get(port) ?? ""
    },
    effect clear(port: number) {
      clipCleared.push(port)
      clipStore.set(port, "")
    },
  })
  const runClipLease = effect () => {
    provide clipLayer {
      const first = try withCredentialClipboardLease("top-secret-password", (boundPort) => effect {
        activeClipboardPort = 1
        return `pasted-from-${boundPort}`
      })
      const second = try withCredentialClipboardLease("second-secret", (boundPort) => effect {
        clipStore.set(boundPort, "user-copied-note")
        return boundPort
      })
      return { first, second }
    }
  }
  const { first: pasted, second: keptNewer } = try runClipLease()
  const clipSession = createClipboardLeaseSession()
  try promise(() => clipSession.admitLease())
  const activeClipValue = try promise(() => clipSession.valueAtPort(0))
  try promise(() => clipSession.finishLease())
  const clearedClipValue = try promise(() => clipSession.valueAtPort(0))

  const sentPayloads: string[] = []
  let callIndex = 0
  const inferLayer = Layer.succeed(BrowserInferenceChannel, {
    effect send(request) {
      sentPayloads.push(request.payload)
      callIndex += 1
      if (callIndex === 1) return { reply: "ReplyQuota", waitAcceptable: true }
      return { reply: "ReplyObject", waitAcceptable: false, advice: "click submit" }
    },
  })
  const runInferenceChecks = effect () => {
    provide inferLayer {
      const first = try runBoundedBrowserInference({
        bodyId: 10,
        accountRoute: 2,
        content: "PlainText",
        rawText: "Contact alice@example.com card 4111 1111 1111 1111 key sk-abcdefghijklmnop",
        isLookCurrent: () => true,
      })
      const second = try runBoundedBrowserInference({
        bodyId: 11,
        accountRoute: 2,
        content: "SystemText",
        rawText: "keep alice@example.com",
        isLookCurrent: () => false,
      })
      return { first, second }
    }
  }
  const { first: accepted, second: stale } = try runInferenceChecks()
  try Effect.try(() => {
    assert.strictEqual(resolveBrowserGuideComposition(true, true, "trusted"), "DualTargets")
    assert.strictEqual(resolveBrowserGuideComposition(true, true, "untrusted"), "EmbeddedOnly")
    assert.strictEqual(resolveActiveBrowserPeer("EmbeddedPeer", true, true), "EmbeddedPeer")
    assert.strictEqual(resolveBrowserPageRoute({ embeddedProfile: true, ownedProfile: true, gotPage: true, failed: false, errorKind: "", errorCode: "" }), "EmbeddedPage")
    assert.deepStrictEqual(resolveBrowserOperationRoute({ matchedPeer: "OwnedPeer", cleanup: false, readFailed: false, observedPeer: "EmbeddedPeer" }), { tag: "StaleRef" })
    assert.strictEqual(
      resolveBrowserRevokeOutcome(
        { reached: true, accepted: true, kindPresent: false, kind: "", code: "" },
        { reached: false, accepted: false, kindPresent: false, kind: "", code: "" },
      ),
      "OwnedAccepted",
    )
    assert.deepStrictEqual([begun, chosen, finished, boundSnap.phase, boundSnap.boundPeer, staleRejected, revoked, revokedSnap.boundPeer, postRevokeRejected], [true, true, true, "Bound", "EmbeddedPeer", false, true, "NoPeer", false])
    assert.isTrue(isBindingEpochAdmitted(revokedSnap.fence, 2))
    assert.isFalse(isBindingEpochCurrent(revokedSnap.fence, 1))
    assert.strictEqual(pasted, "pasted-from-0")
    assert.deepStrictEqual(clipCleared, [0])
    assert.strictEqual(clipStore.get(0), "")
    assert.strictEqual(keptNewer, 1)
    assert.strictEqual(clipStore.get(1), "user-copied-note")
    assert.deepStrictEqual([activeClipValue, clearedClipValue], ["ClipOwned", "ClipEmpty"])
    assert.deepStrictEqual(accepted, { status: "AcceptedObject", attempts: 2, advice: "click submit" })
    assert.strictEqual(sentPayloads[0], sentPayloads[1])
    assert.notInclude(sentPayloads[0] ?? "", "alice@example.com")
    assert.notInclude(sentPayloads[0] ?? "", "sk-abcdefghijklmnop")
    assert.strictEqual(redactNonSystemText("SystemText", "alice@example.com").redaction, "Preserved")
    assert.deepStrictEqual(stale, { status: "DiscardedStale", attempts: 1 })
  })
})

it.effect(`Enforce manual activity readback, payment control confirmation, and website goal completion retention (spec/browser/manualActivity.md, "Story: Ask about manual activity when the browser's record leaves it uncertain"; spec/browser/manualActivity.md, "Story: Let a known harmless form step explain only its own readback"; spec/browser/paymentControl.md, "Story: Distinguish a control that may pay from entry, navigation and other sends"; spec/browser/paymentControl.md, "Story: Ask before guiding the person to a payment control"; spec/browser/websiteGoal.md, "Story: Show a website answer for the entire request with the supporting words"; spec/browser/websiteGoal.md, "Story: Preserve a checked answer while honoring the task's completion and ownership fences")`, effect () => {
  const tracker = new ManualActivityTracker()
  tracker.shownFormStep({
    stepKey: "search", origin: "site", documentId: "doc1", epoch: 1,
    idsKnown: true, ids: [], isPerson: true, knownControl: true, hasFormIndex: true, sameTaskOrigin: true, quiet: true, commits: false,
  })
  tracker.shownFormStep({
    stepKey: "next", origin: "site", documentId: "doc1", epoch: 1,
    idsKnown: true, ids: ["ev1"], isPerson: true, knownControl: false, hasFormIndex: false, sameTaskOrigin: true, quiet: true, commits: false,
  })
  const submit = {
    formSubmit: true, originString: true, documentString: true, origin: "site", documentId: "doc1",
    epoch: 1, observedAt: 5, credentialMarkerValid: true, credential: false, idPresent: true, eventId: "ev1",
  }
  const attribution = tracker.attributeSubmits([submit], "site", 2)
  const cleanActivity = {
    present: true, eventsArray: true, events: [], overflowBoolean: true, overflow: false,
    gapBoolean: true, captureGap: false, idsPresent: false, idsArray: true, gapIds: [],
  }
  const submitActivity = { ...cleanActivity, events: [submit] }
  const landingGapActivity = { ...cleanActivity, captureGap: true }
  const waiting = {
    waits: true, theirs: true, commits: false, quietBefore: true, gapBefore: false,
    leadsAnywhere: true, exactDestination: false, readable: true, pageUnchanged: false, addressPresent: true, addressChanged: true,
  }
  const paymentAssessment = assessPaymentControl(
    {
      controlPresent: true, controlKind: "GuideButton", ownViewsOnlyOnward: false, narrowMoneyWords: true,
      narrowSectionWords: false, narrowSubmits: true, narrowSendWords: false, narrowOwnCode: false,
      ownNamePresent: true, rawReadable: true, handedMoneyForRef: false,
    },
    {
      elementPresent: true, disabled: false, sensitive: false, fieldElement: false, explicitPreparation: false,
      ownMoney: true, payWords: true, sectionWords: false, linkElement: false, nonCommitName: false,
      sendsForm: true, formFunding: true, addToCart: false, allSelectionFields: false, formMoney: true, editableAmount: false, pageTotal: true,
    },
  )
  const reportedBoxes = filterReportedOptInBoxes(true, [
    { choice: true, enabledBox: true, optInWords: true, sameForm: true, observedState: "BoxUnknown" },
    { choice: true, enabledBox: true, optInWords: true, sameForm: true, observedState: "BoxClear" },
  ])

  const goalSession = createWebsiteGoalSession()
  const t0 = WEBSITE_GOAL_RETENTION_MS * 2
  const reading = {
    versionOne: true, redactedGoal: true, cleanHttps: true, answerValid: true,
    observedAt: t0, revision: 3, epoch: 2, hasConstraint: false,
  }
  const saved = try promise(() => goalSession.saveReading(reading, t0, true))
  const completed = try promise(() => goalSession.completeReading(true, false))
  const completedSnap = try promise(() => goalSession.snapshot())
  const swept = try promise(() => goalSession.sweepReading(t0 + WEBSITE_GOAL_RETENTION_MS + 1))
  const sweptSnap = try promise(() => goalSession.snapshot())
  const taskShape = { taskStatus: "active", taskRevision: 3, taskEpoch: 2 }

  try Effect.try(() => {
    assert.strictEqual(tracker.getWindows().length, 1)
    assert.isTrue(attribution.sawEarlier)
    assert.isTrue(validateManualActivity(cleanActivity))
    assert.strictEqual(resolveManualActivityQuestion({ ...cleanActivity, overflow: true }, "site", 2, 0, false), "manual-activity")
    assert.isTrue(canUpstreamPointExplainGap({
      pointExists: true, gapAlreadyOpen: false, sameEpoch: true, pointedDocumentString: true,
      sameDocument: true, pointAddressPresent: true, readAddressPresent: true, addressChanged: true,
    }, 1, true))
    assert.isTrue(canHostCoverLanding(waiting, landingGapActivity, "site", 2, true, true))
    assert.isTrue(shouldWithdrawHostAnswer(waiting))
    assert.isFalse(shouldWithdrawHostAnswer({ ...waiting, pageUnchanged: true, addressChanged: false }))
    assert.isTrue(tracker.isPointedOnly(submitActivity, "site", 2, true))

    assert.deepStrictEqual(paymentAssessment, {
      isPaymentCommit: true, rendered: "GuideMoney", person: "GuideMoney", agentMayPress: false,
    })
    assert.strictEqual(assessReplacementPaymentControl(
      {
        controlPresent: true, controlKind: "GuideButton", ownViewsOnlyOnward: false, narrowMoneyWords: false,
        narrowSectionWords: false, narrowSubmits: true, narrowSendWords: false, narrowOwnCode: false,
        ownNamePresent: true, rawReadable: true, handedMoneyForRef: false,
      },
      {
        elementPresent: true, disabled: false, sensitive: false, fieldElement: false, explicitPreparation: false,
        ownMoney: true, payWords: true, sectionWords: false, linkElement: false, nonCommitName: false,
        sendsForm: true, formFunding: true, addToCart: false, allSelectionFields: false, formMoney: true, editableAmount: false, pageTotal: true,
      },
      true,
    ), "GuideMoney")
    assert.isTrue(isPaymentHandoffPresent(true, true, true, true, true))
    assert.strictEqual(reportedBoxes.length, 1)
    assert.strictEqual(resolvePaymentPointer({ currentObservation: true, optInNeedsAnswer: true, moneyAnswerCurrent: true }), "AskAboutOptIns")
    assert.strictEqual(resolvePaymentPointer({ currentObservation: true, optInNeedsAnswer: false, moneyAnswerCurrent: true }), "PointForPerson")

    assert.isTrue(validateWebsiteGoal({
      exactKeys: true, goalNonblank: true, goalUnits: 20, exactSourceText: true,
      segments: [{ exactKeys: true, textNonempty: true, conditionNonblank: true, conditionUnits: 8, role: "requirement", kind: "read" }],
    }))
    assert.isTrue(validateGoalRequirementReview({
      exactKeys: true, requirementKind: "read", status: "supported",
      quotes: [{ exactKeys: true, sourceKnown: true, textNonblank: true, textUnits: 7, exactSubstring: true }],
    }))
    assert.strictEqual(evaluateWebsiteGoalReview({
      exactTopKeys: true, exactRequirementIds: true,
      entries: [{
        exactKeys: true, requirementKind: "read", status: "supported",
        quotes: [{ exactKeys: true, sourceKnown: true, textNonblank: true, textUnits: 7, exactSubstring: true }],
      }],
    }, 1), "supported")
    assert.isTrue(validateObservedWebsiteAnswer(
      {
        goalRevalidated: true, reportsAllSupported: true, requirementCountMatches: true,
        coverage: [{ requirementKind: "read", onceSupported: true, quotes: [{ sourceIsCurrent: true, inRedactedBody: true, exactTextId: 1 }] }],
      },
      { versionOne: true, canonicalGoal: true, addressMatches: true, observationOnly: true, excerptsArray: true, excerptsTotal: 1, excerptsAllCurrent: true, messageUnits: 37 },
    ))
    assert.isTrue(evaluateHostWebsiteResult({ done: true, heldAnswer: true, taskActive: true, sameEpoch: true, sameGoalRevision: true }))
    assert.strictEqual(evaluateWebsiteResultSave({ task: taskShape, record: reading, clock: t0, previous: "none", equalExceptTime: false }), "write")
    const completedTask = { taskStatus: "completed", taskRevision: 4, taskEpoch: 3 }
    const projected = evaluateWebsiteResultProjection(completedTask, "answer", true, true, 3, 2)
    assert.isTrue(projected.saved && projected.completed)
    assert.strictEqual(evaluateWebsiteResultRoute(completedTask, projected, "GET", "read"), "retained-finished")
    assert.strictEqual(evaluateWebsiteResultExpiry({
      marker: false, selectedBySweep: true, fieldsReadable: true, observedAt: t0, revision: 3, epoch: 2, constraintScanReadable: true, hasConstraint: false,
    }), "marker")
    assert.strictEqual(evaluateWebsiteCompletionAdmission(taskShape, 3, true, false), "complete")
    assert.strictEqual(evaluateRouteAfterWebsiteSave(true, true), "finished")
    assert.deepStrictEqual([saved, completed, completedSnap.task.taskStatus, completedSnap.answerFields, swept, sweptSnap.answerFields, sweptSnap.task.taskStatus], [true, true, "completed", true, true, false, "completed"])
  })
})

it.effect(`Manage browser workspace service, provider, strict action, waitForUrl, routes, autoEnable, and dispose (spec/browser/control.md, "Story: Propose a Browser control in my own words"; spec/browser/arbitration.md, "Story: Follow the browser the person can see")`, effect () => {
  const service = try promise(() => BrowserService.start({} as IAgentRuntime))
  const runtime = {
    getService: (name: string) => (name === BROWSER_SERVICE_TYPE ? service : null),
  } as unknown as IAgentRuntime
  const offeredWithWorkspace = offeredActions({ actions: browserPlugin.actions ?? [], getService: runtime.getService } as unknown as AgentRuntime, turn(browserTab), () => undefined).map(({ name }) => name)
  const opened = try promise(() => browserWorkspaceAction.handler(runtime, turn(browserTab), undefined, {
    parameters: { action: "open", title: "Docs", url: "https://docs.example.com/start" },
  }))
  const badScheme = try promise(() => browserWorkspaceAction.handler(runtime, turn(browserTab), undefined, {
    parameters: { action: "open", url: "javascript:alert(1)" },
  }))
  const tabId = (opened.data?.tab as { readonly id: string } | undefined)?.id ?? ""
  service.navigateTab(tabId, "https://docs.example.com/guide", "x".repeat(9_000))
  const snapshot = try promise(() => browserWorkspaceAction.handler(runtime, turn(browserTab), undefined, {
    parameters: { action: "snapshot", tabId },
  }))
  const hidden = try promise(() => browserWorkspaceAction.handler(runtime, turn(browserTab), undefined, {
    parameters: { action: "hide", tabId },
  }))
  const listed = try promise(() => browserWorkspaceAction.handler(runtime, turn(browserTab), undefined, {
    parameters: { action: "list" },
  }))
  const hostProvider = try promise(() => browserWorkspaceProvider.get(runtime, turn(), {} as never))
  const nativeProvider = try promise(() => browserWorkspaceProvider.get(runtime, {
    ...turn(pageObservation),
    content: { text: "check", metadata: { observation: pageObservation, browserPage: frontPage() } },
  } as Memory, {} as never))

  let clock = 0
  let step = 0
  const waited = try promise(() => waitForUrl({
    pattern: "/\\/dashboard$/i",
    timeoutMs: 5_000,
    pollIntervalMs: 100,
    now: () => clock,
    sleep: async (ms) => {
      clock += ms
    },
    readUrl: async () => {
      step += 1
      return step >= 3 ? "https://app.example.com/DASHBOARD" : "https://app.example.com/login"
    },
  }))
  let timeoutClock = 0
  const timedOut = try promise(() => waitForUrl({
    pattern: "never-arrives",
    timeoutMs: 250,
    pollIntervalMs: 100,
    now: () => timeoutClock,
    sleep: async (ms) => {
      timeoutClock += ms
    },
    readUrl: async () => "https://app.example.com/still-loading",
  }))
  const ac = new AbortController()
  ac.abort()
  const cancelled = try promise(() => waitForUrl({
    pattern: "anything",
    signal: ac.signal,
    readUrl: async () => "https://app.example.com/",
  }))

  const unauthRoute = handleBrowserWorkspaceRoute(service, { method: "GET", pathname: "/api/browser-workspace/tabs", isOwner: false })
  const statusRoute = handleBrowserWorkspaceRoute(service, { method: "GET", pathname: "/api/browser-workspace/status", isOwner: true })
  const openRoute = handleBrowserWorkspaceRoute(service, { method: "POST", pathname: "/api/browser-workspace/open", isOwner: true, body: { url: "https://example.org/a", title: "A" } })
  const cmdOk = handleBrowserWorkspaceRoute(service, { method: "POST", pathname: "/api/browser-workspace/command", isOwner: true, body: { steps: [{ op: "click" }, { op: "read" }] } })
  const cmdTooMany = handleBrowserWorkspaceRoute(service, { method: "POST", pathname: "/api/browser-workspace/command", isOwner: true, body: { steps: Array.from({ length: 300 }, () => ({ op: "click" })) } })
  const routeMissing = handleBrowserWorkspaceRoute(service, { method: "GET", pathname: "/api/browser-workspace/unknown", isOwner: true })
  const pluginStatusRoute = browserPlugin.routes.find((r) => r.path === "/api/browser-workspace/status")?.handler(runtime, { pathname: "/api/browser-workspace/status", isOwner: true })
  const closeTab = try promise(() => browserWorkspaceAction.handler(runtime, turn(browserTab), undefined, {
    parameters: { action: "close", tabId },
  }))
  const shouldEnableTrue = try promise(() => Promise.resolve(browserPlugin.autoEnable?.shouldEnable?.({}, { features: { browser: true } })))
  const shouldEnableFalse = try promise(() => Promise.resolve(browserPlugin.autoEnable?.shouldEnable?.({}, { features: { browser: { enabled: false } } })))
  try promise(() => Promise.resolve(browserPlugin.dispose?.(runtime)))

  try Effect.try(() => {
    const paramNames = (browserWorkspaceAction.parameters ?? []).map((p) => p.name)
    assert.deepStrictEqual(paramNames, [...paramNames].toSorted())
    assert.isTrue(browserWorkspaceAction.toolSchemaStrict)
    assert.isTrue(browserWorkspaceAction.cacheStable)
    assert.isDefined(browserWorkspaceAction.descriptionCompressed)
    assert.strictEqual(browserWorkspaceAction.summarize?.(opened, { action: "open" }), "BROWSER_WORKSPACE(open): ok")
    assert.isTrue(validateToolArgs(browserWorkspaceAction, { action: "list" }).valid)
    assert.isFalse(validateToolArgs(browserWorkspaceAction, { action: "bogus" }).valid)
    assert.include(offeredWithWorkspace, "BROWSER_WORKSPACE")
    assert.isTrue(opened.success)
    assert.isFalse(badScheme.success)
    assert.isTrue(snapshot.success)
    assert.strictEqual((JSON.parse(snapshot.text ?? "{}") as { text: string }).text.length, 8_000)
    assert.isTrue(hidden.success)
    assert.isTrue(listed.success)
    assert.include(hostProvider.text ?? "", "docs.example.com/guide")
    assert.include(nativeProvider.text ?? "", "native-client")
    assert.isFalse(buildWaitForUrlPredicate("/(a+)+$/").ok)
    assert.strictEqual(waited.status, "matched")
    assert.strictEqual(waited.polls, 3)
    assert.strictEqual(timedOut.status, "timeout")
    assert.strictEqual(cancelled.status, "cancelled")
    assert.strictEqual(unauthRoute.status, 403)
    assert.strictEqual(statusRoute.status, 200)
    assert.strictEqual(openRoute.status, 201)
    assert.strictEqual(cmdOk.status, 200)
    assert.strictEqual(cmdTooMany.status, 400)
    assert.strictEqual(routeMissing.status, 404)
    assert.strictEqual(browserPlugin.routes.length, 9)
    assert.strictEqual(pluginStatusRoute?.status, 200)
    assert.isTrue(closeTab.success)
    assert.deepStrictEqual([shouldEnableTrue, shouldEnableFalse], [true, false])
    assert.strictEqual(service.listTabs().length, 0)
  })
})
