// spec/browser/remoteControl.md, "Story: Go back, forward or reload only on the tab the turn observed"; spec/browser/remoteControl.md, "A history command carries the observed tab and revision, and the renderer refuses a changed page"
import { noSelection, observedSelection, rendererRunsHistory, type TurnObservation } from "../gen/browser__remoteControl.effect.vibe"

export const NATIVE_HISTORY_SUBACTIONS = ["back", "forward", "reload"] as const

export type NativeHistorySubaction = (typeof NATIVE_HISTORY_SUBACTIONS)[number]

export interface NativeHistorySelection {
  readonly id: string
  readonly revision: string
  readonly navigation?: string
}

export interface NativeHistoryCommand {
  readonly subaction: NativeHistorySubaction
  readonly selection?: NativeHistorySelection
}

export type NativeHistoryParse = { readonly ok: true; readonly command: NativeHistoryCommand } | { readonly ok: false; readonly message: string }

export error NativeHistoryRefused { message: string }

const SELECTION_ID = /^[A-Za-z0-9][A-Za-z0-9._:@=+-]{0,511}$/
const SELECTION_TOKEN = /^[A-Za-z0-9][A-Za-z0-9._:@=+-]{0,255}$/
const SELECTION_KEYS: readonly string[] = ["id", "revision", "navigation"]

export function record(value: unknown): object | undefined {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value : undefined
}

export function field(value: object, key: string): unknown {
  return Object.getOwnPropertyDescriptor(value, key)?.value
}

function token(value: unknown, pattern: RegExp): value is string {
  return typeof value === "string" && pattern.test(value)
}

export function isNativeHistorySubaction(value: unknown): value is NativeHistorySubaction {
  return NATIVE_HISTORY_SUBACTIONS.some((subaction) => subaction === value)
}

function selectionOf(value: unknown): NativeHistorySelection | undefined {
  const selection = record(value)
  if (selection === undefined || Object.keys(selection).some((key) => !SELECTION_KEYS.includes(key))) return undefined
  const id = field(selection, "id")
  const revision = field(selection, "revision")
  const navigation = field(selection, "navigation")
  if (!token(id, SELECTION_ID) || !token(revision, SELECTION_TOKEN)) return undefined
  if (navigation === undefined) return { id, revision }
  return token(navigation, SELECTION_TOKEN) ? { id, revision, navigation } : undefined
}

export function parseNativeHistoryCommand(value: unknown, selection?: unknown): NativeHistoryParse {
  const command = record(value)
  if (command === undefined) return { ok: false, message: "Browser command is required" }
  const subaction = field(command, "subaction")
  if (Object.keys(command).some((key) => key !== "subaction") || !isNativeHistorySubaction(subaction)) {
    return { ok: false, message: "This mounted browser supports back, forward and reload without server tab IDs" }
  }
  if (selection === undefined) return { ok: true, command: { subaction } }
  const observed = selectionOf(selection)
  return observed === undefined ? { ok: false, message: "Browser selection is invalid" } : { ok: true, command: { subaction, selection: observed } }
}

export effect function decodeNativeHistoryCommand(value: unknown, selection?: unknown): NativeHistoryCommand!NativeHistoryRefused {
  const parsed = parseNativeHistoryCommand(value, selection)
  if (!parsed.ok) throw new NativeHistoryRefused({ message: parsed.message })
  return parsed.command
}

function turnObservation(message: { readonly content: unknown }): TurnObservation {
  const content = record(message.content)
  const metadata = content === undefined ? undefined : record(field(content, "metadata"))
  const observation = metadata === undefined ? undefined : record(field(metadata, "observation"))
  const selected = observation === undefined ? undefined : record(field(observation, "selectedObject"))
  const sensitive = observation === undefined ? undefined : field(observation, "sensitive")
  const id = selected === undefined ? undefined : field(selected, "id")
  const revision = selected === undefined ? undefined : field(selected, "revision")
  return {
    present: observation !== undefined && typeof sensitive === "boolean",
    sensitive: sensitive === true,
    browserView: observation !== undefined && field(observation, "view") === "browser",
    browserTab: selected !== undefined && field(selected, "kind") === "browser-tab",
    hasRevision: revision !== undefined,
    tokensValid: token(id, SELECTION_ID) && token(revision, SELECTION_TOKEN),
    observedTab: typeof id === "string" ? id : "",
    observedRevision: typeof revision === "string" ? revision : "",
  }
}

export function observedNativeHistorySelection(message: { readonly content: unknown }, subaction: string): NativeHistorySelection | undefined {
  const selection = observedSelection(turnObservation(message), isNativeHistorySubaction(subaction))
  return selection.tabId === noSelection.tabId ? undefined : { id: selection.tabId, revision: selection.revision }
}

export function observedTabCurrent(selection: NativeHistorySelection | undefined, current: { readonly id: string; readonly revision: string }): boolean {
  return rendererRunsHistory(selection === undefined ? noSelection : { tabId: selection.id, revision: selection.revision }, current.id, current.revision)
}
