// spec/browser/control.md, "Story: Propose a Browser control in my own words"; spec/browser/control.md, "A search runs on my words as I typed them, and a search the model words differently runs only after my review"; spec/browser/control.md, "A search, tab switch or find runs without my review only on words I typed for it, and a search only as my whole message"; spec/browser/control.md, "Closing every tab on a phone that closes one tab at a time is refused with its reason, never narrowed"; spec/browser/control.md, "A refused Browser proposal tells me how to ask, and never says anything opened"; spec/browser/control.md, "Each control needs its group's capability, and a new-tab open needs its own"; spec/browser/control.md, "Closing every tab is its own negotiated form, refused rather than narrowed, and reviewed only on a card that lists those tabs"; spec/browser/control.md, "A history move has one home: the Browser control where my phone negotiated it, or else the BROWSER command"; spec/browser/requestGrounding.md, "A page link opens only as an exact link of the page my message carried, and only after my review"; spec/browser/requestGrounding.md, "An open runs without my review only when my whole message asked to open that address"; spec/browser/requestGrounding.md, "An address opens in a tab of its own only when the model asked for one and the phone has one, and an empty tab stays empty"; spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/browser/control.md, "A reload of a page my phone withheld runs only after my review on the phone, or as the BROWSER command only when the model says I asked for it"; spec/browser/control.md, "An address my whole message asked for opens at once only on a phone that negotiated it, and every other open waits for my review"
import type { ActionParameterSchema, Memory } from "@elizaos/core"
import { decodeBrowserPage, type BrowserPage, type CheckedOperation, type DeviceOperation } from "@elizaos/agent"
import type { DeviceProposalFamily, DeviceTurn, Grounding, NegotiatedDevice, ProposalForm, ProposalText } from "@elizaos/agent-host"
import { refusalReply, type BrowserRefusal, type RefusalReply } from "../gen/browser__control.effect.vibe"
import { openBound, opensInNewTab } from "../gen/browser__requestGrounding.effect.vibe"
import { BROWSER_HISTORY_ACTIONS, BROWSER_RELOAD_WITHHELD_REFUSAL, browserCloseAnswer, browserControlBound, browserControlCapabilityAvailable, browserHistoryHome, browserWithheldReload, browserNavigationAvailable, browserReopenRefused, type BrowserControlOperation, type BrowserControlType, browserDestinationMatches, browserSearchQueryMatches, containsWebAddress, directBrowserDestination, directBrowserSearchQuery, groundBrowserDestination, groundBrowserSearchQuery, reviewableBrowserDestination, spokenBrowserOpen, typedBrowserWords } from "@elizaos/plugin-browser-client"
import { browserContext } from "./native-browser.vibe"

type BrowserProposalType = "browser_navigate" | BrowserControlType

export const BROWSER_PROPOSAL_TYPES: readonly BrowserProposalType[] = [
  "browser_navigate", "browser_search", "browser_tab_new", "browser_tab_switch", "browser_tab_close", "browser_tabs_show", "browser_find", "browser_history",
]

const NAVIGATE_GUIDANCE = 'browser_navigate: open an https URL now when owner asks to open/visit a typed address (spoken "dot" -> "."), an exact carried browserPage link url, or a named site\'s known https URL (links & untyped URLs require review). Use this, not open_view browser/VIEWS/browser_tab_new. Never for deferred, hypothetical, questioned, past, reported, or negated mentions; never claim page loaded or content.'
const NEW_TAB_GUIDANCE = "Open a URL in a new tab with browser_navigate newTab=true, not browser_tab_new."
const SEARCH_GUIDANCE = "browser_search: open a web search in phone Browser now. Copy owner's exact search words in query (runs directly; reworded queries require review). No results or page content return; never claim search results."
const TABS_GUIDANCE = "Tabs: browser_tab_new opens empty tab only; browser_tab_switch focuses a tab; browser_tab_close closes one or all=true (always reviewed; never narrow multi/all-tab close to current tab). Never claim which tabs are open (no tab list/titles/URLs returned)."
const TABS_SHOW_GUIDANCE = "browser_tabs_show: show the phone's open tabs list on-device. You receive no tabs, titles, URLs, or count; say you are opening the list."
const FIND_GUIDANCE = "browser_find: highlight text on the open page (no match count or content returned)."
const HISTORY_GUIDANCE = "browser_history: back, forward, reload, or stop on the current tab."

const REFUSALS: Readonly<Record<BrowserRefusal, { readonly code: string; readonly forModel: string }>> = {
  DestinationNotRequested: {
    code: "DEVICE_BROWSER_NOT_REQUESTED",
    forModel: "This browser destination is not a valid https web address with a known top-level domain and no port, the owner said not to open it, or the request could not be read. No proposal was created or navigation executed.",
  },
  SearchWordsMissing: {
    code: "DEVICE_BROWSER_NOT_REQUESTED",
    forModel: "The search words are empty, longer than the phone accepts, or the request could not be read. No proposal was created or search executed.",
  },
  CloseEveryUnavailable: {
    code: "DEVICE_BROWSER_CLOSE_ALL_UNAVAILABLE",
    forModel: "This phone's Browser closes one tab at a time and cannot close all tabs at once. Nothing was closed. Tell the owner, and offer to close the tab that is showing or a tab they name.",
  },
  ReloadNotRequested: { code: "DEVICE_BROWSER_NOT_REQUESTED", forModel: BROWSER_RELOAD_WITHHELD_REFUSAL },
}

const REPLIES: Readonly<Record<RefusalReply, string>> = {
  AskForAddress: "Tell me the address, like example.com.",
  SayAddressNotOpened: "I didn't open that address.",
  AskForSearchWords: 'Tell me the words to search for, like "search for weather in Paris".',
  SayOneTabAtATime: "Your phone's Browser closes one tab at a time, so nothing was closed. I can close the tab that's showing, or one you name.",
  SayPageNotReloaded: "I didn't reload the page: your phone doesn't share its text with me, and reloading won't change that.",
}

const tabWord = "Tab title or site word as owner said"

function form(type: BrowserProposalType, fields: Record<string, ActionParameterSchema>, required: readonly string[], offered: (device: NegotiatedDevice) => boolean, guidance?: readonly string[]): ProposalForm {
  return {
    types: [type], offered, ...(guidance === undefined ? {} : { guidance }),
    schema: { type: "object", additionalProperties: false, required: ["type", ...required], properties: { type: { type: "string", enum: [type] }, ...fields } },
  }
}

const negotiated = (type: BrowserControlType) => (device: NegotiatedDevice) => browserControlCapabilityAvailable(type, device.capabilities)
const opensInItsOwnTab = (device: NegotiatedDevice) => browserNavigationAvailable(true, device.capabilities)
const opensAddresses = (device: NegotiatedDevice) => device.admit({ type: "browser_navigate", url: "https://example.com/" }) !== undefined
const address: ActionParameterSchema = { type: "string" }

const FORMS: readonly ProposalForm[] = [
  form("browser_navigate", { url: address }, ["url"], (device) => !opensInItsOwnTab(device) && opensAddresses(device), [NAVIGATE_GUIDANCE]),
  form("browser_navigate", { url: address, newTab: { type: "boolean", description: "True to open in a new tab." } }, ["url"],
    (device) => opensInItsOwnTab(device) && opensAddresses(device), [NAVIGATE_GUIDANCE, NEW_TAB_GUIDANCE]),
  form("browser_search", { query: { type: "string", description: "Exact search words owner typed." } }, ["query"],
    negotiated("browser_search"), [SEARCH_GUIDANCE]),
  form("browser_tab_new", { private: { type: "boolean", description: "True only if owner asked for a private tab." } }, [], negotiated("browser_tab_new")),
  form("browser_tab_switch", { target: { type: "string", description: `${tabWord} (e.g. example.com, bbc).` } }, ["target"], negotiated("browser_tab_switch")),
  form("browser_tab_close", {
    target: { type: "string", description: `${tabWord}; omit both target & all to close current tab.` },
    all: { type: "boolean", enum: [true], description: "True to close all tabs (never with target)." },
  }, [], negotiated("browser_tab_close")),
  form("browser_tabs_show", {}, [], negotiated("browser_tabs_show"), [TABS_SHOW_GUIDANCE]),
  form("browser_find", { text: { type: "string", description: "Text to find on page." } }, ["text"], negotiated("browser_find"), [FIND_GUIDANCE]),
  form("browser_history", { action: { type: "string", enum: [...BROWSER_HISTORY_ACTIONS] } }, ["action"],
    (device) => browserHistoryHome(device.capabilities, false) === "HistoryAsControl", [HISTORY_GUIDANCE]),
]

function field(value: unknown, key: string): unknown {
  return typeof value === "object" && value !== null ? Object.getOwnPropertyDescriptor(value, key)?.value : undefined
}

export function browserRefusal(refusal: BrowserRefusal, ownerText: string): { readonly code: string; readonly forModel: string; readonly forOwner: string } {
  return { ...REFUSALS[refusal], forOwner: REPLIES[refusalReply(refusal, containsWebAddress(ownerText))] }
}

function refused(refusal: BrowserRefusal, turn: DeviceTurn): Grounding {
  return { kind: "Refused", ...browserRefusal(refusal, turn.ownerText) }
}

function grounded(operation: DeviceOperation, bound: boolean): Grounding {
  return { kind: "Grounded", operation, grounding: bound ? "GroundedAsAsked" : "GroundedForReview" }
}

export type OpenAsked = Pick<DeviceTurn, "ownerText" | "assistantName" | "observation"> & { readonly message: Memory }

export type OpenGrounding =
  | { readonly kind: "Grounded"; readonly url: string; readonly bound: boolean }
  | { readonly kind: "Refused"; readonly refusal: BrowserRefusal }

effect function carriedPage(turn: OpenAsked): (BrowserPage | undefined)!! {
  const carried = field(turn.message.content.metadata, "browserPage")
  if (carried === undefined) return undefined
  return decodeBrowserPage(carried, turn.observation) catch () => undefined
}

// spec/browser/requestGrounding.md, "Story: Open a destination stated in this message"; spec/browser/control.md, "The screen opens an address my whole message asked for at once, and shows any other address for me to open"
export effect function groundOpen(asked: OpenAsked, url: string): OpenGrounding!! {
  const page = try carriedPage(asked)
  const links = page !== undefined && "text" in page ? (page.links ?? []).map(({ url }) => url) : []
  const destination = groundBrowserDestination(asked.ownerText, url, asked.assistantName, links) ?? reviewableBrowserDestination(asked.ownerText, url, asked.assistantName)
  if (destination === undefined) return { kind: "Refused", refusal: "DestinationNotRequested" }
  const exactOpen = browserDestinationMatches({ type: "browser_navigate", url: destination }, directBrowserDestination(asked.ownerText, asked.assistantName) ?? spokenBrowserOpen(asked.ownerText, asked.assistantName)?.href)
  if (browserReopenRefused(page, destination, exactOpen)) return { kind: "Refused", refusal: "ReloadNotRequested" }
  const pageLink = groundBrowserDestination(asked.ownerText, url, asked.assistantName) === undefined
  const bound = openBound(pageLink, browserDestinationMatches({ type: "browser_navigate", url: destination }, directBrowserDestination(asked.ownerText, asked.assistantName)))
  return { kind: "Grounded", url: destination, bound }
}

effect function opened(turn: DeviceTurn, url: string, proposedNewTab: boolean): Grounding!! {
  const open = try groundOpen(turn, url)
  if (open.kind === "Refused") return refused(open.refusal, turn)
  const newTab = opensInNewTab({ proposedNewTab, newTabNegotiated: opensInItsOwnTab(turn) })
  const operation: DeviceOperation = newTab ? { type: "browser_navigate", url: open.url, newTab: true } : { type: "browser_navigate", url: open.url }
  return grounded(operation, open.bound)
}

function typedWords(operation: BrowserControlOperation): string | undefined {
  switch (operation.type) {
    case "browser_search": return operation.query
    case "browser_tab_switch": return operation.target
    case "browser_find": return operation.text
    default: return undefined
  }
}

function controlled(operation: Extract<DeviceOperation, { readonly type: BrowserControlType }>, turn: DeviceTurn, wholeMessage: boolean): Grounding {
  const words = typedWords(operation)
  const wordsTyped = words !== undefined && typedBrowserWords(turn.ownerText, words) !== undefined
  return grounded(operation, browserControlBound(operation, { wholeMessage, wordsTyped }))
}

effect function ground(proposed: CheckedOperation, turn: DeviceTurn): Grounding!! {
  const operation = proposed.operation
  switch (operation.type) {
    case "browser_navigate":
      return try opened(turn, operation.url, operation.newTab === true)
    case "browser_search": {
      const query = groundBrowserSearchQuery(turn.ownerText, operation.query)
      if (query === undefined) return refused("SearchWordsMissing", turn)
      return controlled({ type: "browser_search", query }, turn, browserSearchQueryMatches(query, directBrowserSearchQuery(turn.ownerText, turn.assistantName)))
    }
    case "browser_tab_close":
      return browserCloseAnswer(operation, turn.capabilities) === "CloseEveryRefused" ? refused("CloseEveryUnavailable", turn) : controlled(operation, turn, false)
    case "browser_tab_new":
      return controlled(operation, turn, false)
    case "browser_history": {
      const page = try carriedPage(turn)
      return browserWithheldReload(operation.action, page) ? grounded(operation, false) : controlled(operation, turn, false)
    }
    case "browser_tabs_show":
      return controlled(operation, turn, false)
    case "browser_tab_switch":
    case "browser_find":
      return controlled(operation, turn, false)
    default:
      return grounded(operation, false)
  }
}

const OPENING = "The requesting phone opens this exact requested address in its Browser right after this reply, with no review. It has not loaded yet; do not claim that it loaded or what it shows. Which screen shows later is what each later message's screen context says, not this result."
const CONTROLLING = "The requesting phone runs this requested Browser control right after this reply, with no review. It has not run yet; do not claim that it finished, what a search found or what a page shows."

function directText(operation: DeviceOperation): ProposalText | undefined {
  switch (operation.type) {
    case "browser_navigate": return { forOwner: `Opening ${URL.parse(operation.url)?.host ?? operation.url}.`, forModel: OPENING }
    case "browser_search": return { forOwner: `Searching the web for “${operation.query}”.`, forModel: CONTROLLING }
    case "browser_tab_new":
    case "browser_tab_switch":
    case "browser_tabs_show":
    case "browser_find":
    case "browser_history": return { forOwner: "Doing that in Browser.", forModel: CONTROLLING }
    default: return undefined
  }
}

export const browserProposalFamily: DeviceProposalFamily = {
  name: "browser",
  app: browserContext.id,
  types: BROWSER_PROPOSAL_TYPES,
  forms: FORMS,
  guidance: (device) => browserControlCapabilityAvailable("browser_tab_new", device.capabilities) ? [TABS_GUIDANCE] : [],
  ground,
  proposedText: (operation, { direct }) => direct ? directText(operation) : undefined,
  settledText: () => undefined,
}
