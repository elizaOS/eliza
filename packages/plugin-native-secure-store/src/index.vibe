// spec/nativeSecureStore/index.md, "Story: Read or change an app credential only on my device"
import { nativeReply } from "@elizaos/os-bridges"
import { secureStorePlugin } from "@elizaos/os-bridges"
import { availableStore, type SecureAccount } from "../gen/nativeSecureStore.effect.vibe"

export { secureStoreClient, secureStorePlugin } from "@elizaos/os-bridges"
export type { ElizaSecureStoreKey, ElizaSecureStoreReadError, ElizaSecureStoreError, ElizaSecureStoreRead, ElizaSecureStoreResult, ElizaSecureStoreStatus, ElizaSecureStoreExchange, ElizaSecureStorePlugin } from "@elizaos/os-bridges"

const NATIVE_STORE = "ElizaSecureStore"
const Status = Schema.Struct({
  available: Schema.Boolean,
  backend: Schema.Literals(["apple_keychain", "android_keystore", "unavailable"]),
  accessibility: Schema.Literals(["after_first_unlock_this_device_only", "credential_encrypted_device_only", "unavailable"]),
  accessGroup: Schema.Literal("app_only"),
  synchronized: Schema.Boolean,
})
const Read = Schema.Union([
  Schema.Struct({ ok: Schema.Literal(true), value: Schema.String }),
  Schema.Struct({ ok: Schema.Literal(false), error: Schema.Literals(["invalid_input", "not_found", "unreadable", "denied", "unavailable", "native_error"]) }),
])

const nativeKeys = {
  DeviceAuthAccount: "session.device_auth",
  StewardAccount: "session.steward_token",
  PendingCloudAccount: "session.cloud_mobile_pending",
  ActiveServerAccount: "runtime.active_server",
  AgentProfilesAccount: "runtime.agent_profiles",
} satisfies Record<SecureAccount, string>

export interface NativeSecureRead {
  status(): Promise<unknown>
  get(input: { key: string }): Promise<unknown>
}

export interface NativeSecureChange extends NativeSecureRead {
  set(input: { key: string; value: string }): Promise<unknown>
  remove(input: { key: string }): Promise<unknown>
}

type SecureChange = { readonly kind: "write"; readonly value: string } | { readonly kind: "remove" }

const Changed = Schema.Struct({ ok: Schema.Boolean })

export error NativeSecureStoreUnavailable
export error NativeSecureChangeUnconfirmed { slot: SecureAccount }

export const ElizaSecureStore = secureStorePlugin()

effect function confirmNativeCustody(port: NativeSecureRead) {
  const status = try nativeReply(NATIVE_STORE, "status", Status, () => port.status())
  if (!status.available || !availableStore({
    backend: status.backend === "apple_keychain" ? "AppleKeychain" :
      status.backend === "android_keystore" ? "AndroidKeystore" : "NoSecureBackend",
    accessibility: status.accessibility === "after_first_unlock_this_device_only" ? "AppleAfterFirstUnlock" :
      status.accessibility === "credential_encrypted_device_only" ? "AndroidCredentialEncrypted" : "AccessUnavailable",
    appOnly: true,
    synchronized: status.synchronized,
  })) throw new NativeSecureStoreUnavailable()
}

export effect function readNativeSecureAccount(slot: SecureAccount, port: NativeSecureRead = ElizaSecureStore) {
  try confirmNativeCustody(port)
  return try nativeReply(NATIVE_STORE, "get", Read, () => port.get({ key: nativeKeys[slot] }))
}

export effect function changeNativeSecureAccount(slot: SecureAccount, change: SecureChange, port: NativeSecureChange = ElizaSecureStore) {
  try confirmNativeCustody(port)
  const key = nativeKeys[slot]
  const changed = try (change.kind === "write"
    ? nativeReply(NATIVE_STORE, "set", Changed, () => port.set({ key, value: change.value }))
    : nativeReply(NATIVE_STORE, "remove", Changed, () => port.remove({ key })))
  if (!changed.ok) throw new NativeSecureChangeUnconfirmed({ slot })
  const observed = try readNativeSecureAccount(slot, port)
  const confirmed = change.kind === "write"
    ? observed.ok && observed.value === change.value
    : !observed.ok && observed.error === "not_found"
  if (!confirmed) throw new NativeSecureChangeUnconfirmed({ slot })
  return change.kind === "write" ? "StoreWritten" as const : "StoreRemoved" as const
}
