// spec/notes/records.md, "Story: Keep my notes as one collection the agent edits only as I asked"; spec/notes/records.md, "Story: Keep the notes I saved before this version"; spec/notes/read.md, "Story: Search private notes and share only what I select"; spec/notes/trash.md, "Story: Recover a deleted note"; spec/notes/trash.md, "Story: Let deleted notes expire after three days when I choose that"; spec/notes/organize.md, "Story: Organize my notes only where I can see it"; spec/notes/client.md, "Story: Read and save a note under the current connection"; spec/notes/read.md, "Story: Ask about or change a phone note in my own words"; spec/notes/trash.md, "Story: Delete the phone note I asked to delete"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { negotiation, validate, type DeviceOperation, type LocalRoute } from "@elizaos/agent"
import type { DeviceTurn, EarlierRequest } from "@elizaos/agent-host"
import { bindIncomingMessagePersistence, satisfiesContextGate, stringToUuid, type Content, type IAgentRuntime, type Memory } from "@elizaos/core"
import { noteChangeResult, notesPlugin, notesRefusalResult, notesRoutes } from "../src/agent.vibe"
import { notesDeviceFamily } from "../src/device-proposals.vibe"
import {
  createNotesClient, noteScheduleText, recordNoteOriginFor, authoredNoteText, noteShareText, parseNoteFormat, decodeNotesOrganizeOperation, findNoteFolder, isNotesOrganizeType, notesOrganizeContextAllowed, notesOrganizeOffered, notesOrganizeRunsDirectly, readNoteFolders, noteLimits, type NotesOrganizeType, NotesReadRefused, selectedNotes, type NotesAuthority, type NotesClaim, type NotesOwner, type NotesReadOperation, type NotesReadPorts, type NotesTarget, type StickyNote,
} from "@elizaos/plugin-notes-client"
import { ownerRequestText } from "../src/lookup.vibe"
import { notesCollection, type NotesFailure, type NotesHost, type VerifyRecordingCleanup } from "../src/service.vibe"
import type { NotesStorage } from "../src/store.vibe"

const day = 86_400_000
const start = Date.parse("2026-11-20T10:00:00.000Z")

interface Fixture {
  readonly storage: NotesStorage
  readonly clock: { ms: number }
  readonly kept: { value: unknown; refuseNext: boolean; loseNext: boolean }
  readonly hostVerifier: { verify: VerifyRecordingCleanup | undefined }
  readonly published: string[]
  readonly prior: { raw: string | undefined; reads: number }
}

function fixture(): Fixture {
  const kept: Fixture["kept"] = { value: undefined, refuseNext: false, loseNext: false }
  return {
    kept,
    clock: { ms: start },
    hostVerifier: { verify: undefined },
    published: [],
    prior: { raw: undefined, reads: 0 },
    storage: {
      get: async () => kept.value === undefined ? undefined : structuredClone(kept.value),
      set: async (document) => {
        if (kept.loseNext) {
          kept.loseNext = false
          return false
        }
        kept.value = structuredClone(document)
        if (kept.refuseNext) {
          kept.refuseNext = false
          return false
        }
        return true
      },
    },
  }
}

function notesOver(f: Fixture, options: { threeDayTrash?: boolean; verify?: VerifyRecordingCleanup; prior?: boolean } = {}) {
  let created = 0
  const host: NotesHost = {
    agentId: "agent-1",
    storage: f.storage,
    ...(options.prior === true ? { prior: { read: async () => {
      f.prior.reads++
      return f.prior.raw === undefined ? undefined : { raw: f.prior.raw, digest: "a".repeat(64) }
    } } } : {}),
    now: sync(() => f.clock.ms),
    threeDayTrash: options.threeDayTrash ?? false,
    newNoteId: () => `note-${++created}`,
    newOperationId: () => `0000000${created}-0000-4000-8000-000000000000`,
    ...(options.verify === undefined ? {} : { verifyRecordingCleanup: options.verify }),
    registeredVerifier: () => f.hostVerifier.verify,
    published: (_snapshot, mutation) => { f.published.push(mutation) },
  }
  return notesCollection(host)
}

const code = <A>(plan: A!NotesFailure) => map(Effect.flip(plan), (error) => error.code)

const owner = {
  id: "11111111-1111-4111-8111-111111111111", agentId: "22222222-2222-4222-8222-222222222222",
  roomId: "33333333-3333-4333-8333-333333333333", entityId: "44444444-4444-4444-8444-444444444444",
} as const

function message(text: string, metadata?: Content[string], id: string = owner.id): Memory {
  return { ...owner, id: id as Memory["id"], content: { text, ...(metadata === undefined ? {} : { metadata }) } }
}

const turnId = (n: number) => `00000000-0000-4000-8000-00000000000${n}`

function roomCache() {
  const kept = new Map<string, unknown>()
  return {
    getCache: async (key: string) => kept.get(key),
    setCache: async (key: string, value: unknown) => {
      kept.set(key, value)
      return true
    },
    age: (ms: number) => {
      for (const [key, value] of kept) {
        if (typeof value === "object" && value !== null && "offeredAt" in value && typeof value.offeredAt === "number") kept.set(key, { ...value, offeredAt: value.offeredAt - ms })
      }
    },
  }
}

function action(plugin: ReturnType<typeof notesPlugin>, name: string, runtime?: ReturnType<typeof roomCache>) {
  const found = (plugin.actions ?? []).find((candidate) => candidate.name === name)
  assert.isDefined(found)
  return (said: Memory, parameters: Record<string, unknown>) => promise(() => found!.handler(runtime as never, said, undefined, { parameters } as never))
}

const voice = (id: string, audioId: string) => ({ kind: "voice", data: { recordingId: audioId, audio: { audioId }, lines: [{ s: "speaker-1", t: `Said in ${id}` }] } })

it.effect('Keep notes as one collection edited only on the owner\'s words (spec/notes/records.md, "Story: Keep my notes as one collection the agent edits only as I asked"; spec/notes/records.md, "A checklist the owner asks for is a new note holding the owner\'s items"; spec/notes/records.md, "A read by a title no saved note has cites no other note and asks which one"; spec/notes/records.md, "A Notes write runs when the model calls a write action, and a read action never writes"; spec/notes/records.md, "A calendar draft made from a note is admitted only while that exact note is unchanged"; spec/notes/records.md, "A move by name takes the identical copies of the note along"; spec/notes/records.md, "A delete or an edit by name leaves no identical copy behind"; spec/notes/records.md, "A Notes change answers with a receipt of the note and the revision it committed, and a refusal says what it waits on"; spec/notes/records.md, "A read tells a note\'s times in the owner\'s zone when the turn knows it"; spec/notes/records.md, "The agent reads and changes Notes only for the owner, and changes the note the model picked"; spec/notes/records.md, "A note\'s title and body are saved as well-formed text")', effect () => {
  const f = fixture()
  const notes = notesOver(f)
  const first = try notes.create({ content: "Groceries\n- milk", creationId: "step-1" })
  assert.deepEqual([first.value.note.id, first.value.replayed, first.snapshot.revision], ["note-1", false, 1])
  const replayed = try notes.create({ content: "Groceries\n- milk", creationId: "step-1" })
  assert.deepEqual([replayed.value.note.id, replayed.value.replayed, replayed.snapshot.revision], ["note-1", true, 1])
  const plainAgain = try notes.create({ content: "Groceries\n- milk" })
  assert.equal(plainAgain.value.note.id, "note-1")
  const draft = try notes.create({ content: "Groceries\n- milk", forceNew: true })
  assert.notEqual(draft.value.note.id, "note-1")
  assert.equal(draft.snapshot.notes.length, 2)
  assert.equal(try code(notes.update({ id: "note-1" }, { textEdit: { field: "body", oldText: "milk", newText: "oat milk" } }, 0)), "NOTES_EDIT_CONFLICT")
  const literal = try notes.update({ id: "note-1" }, { textEdit: { field: "body", oldText: "milk", newText: "oat milk" } })
  assert.equal(literal.value.body, "\n- oat milk")
  assert.equal(try code(notes.update({ id: "note-1" }, { textEdit: { action: "append", field: "item", text: "eggs" } })), "NOTES_EDIT_REVISION_REQUIRED")
  const appended = try notes.update({ id: "note-1" }, { textEdit: { action: "append", field: "item", text: "eggs" } }, literal.snapshot.revision)
  assert.equal(appended.value.body, "\n- oat milk\n- eggs")
  assert.equal(try code(notes.update({ selector: "query", value: "groceries" }, { color: "green" }, appended.snapshot.revision)), "NOTES_AMBIGUOUS_NOTE")
  assert.equal(try code(notes.update({ id: "note-1" }, { content: "Groceries" }, literal.snapshot.revision)), "NOTES_EDIT_CONFLICT")
  const receipted = [try noteChangeResult("WriteCreate", "Created", first.value.note, first.snapshot.revision), try noteChangeResult("WriteCreate", "Already saved", replayed.value.note, replayed.snapshot.revision, true),
    try noteChangeResult("WriteMove", "Moved to Work:", appended.value, appended.snapshot.revision)]
  assert.deepEqual(receipted.map((result) => [result.data?.op, result.data?.noteId, ...(result.effectReceipts ?? []).map((receipt) => [receipt.operation, receipt.outcome, receipt.resource, receipt.idempotency.replayed])]), [
    ["create", "note-1", ["notes.note.create", "applied", { kind: "notes.note", id: "note-1", version: "1" }, false]],
    ["create", "note-1", ["notes.note.create", "noop", { kind: "notes.note", id: "note-1", version: "1" }, true]],
    ["update", "note-1", ["notes.note.update", "applied", { kind: "notes.note", id: "note-1", version: String(appended.snapshot.revision) }, false]],
  ])
  const choice = try notesRefusalResult(notes, try Effect.flip(notes.update({ selector: "query", value: "groceries" }, { color: "green" }, appended.snapshot.revision)))
  const stale = try notesRefusalResult(notes, try Effect.flip(notes.update({ id: "note-1" }, { content: "Groceries" }, literal.snapshot.revision)))
  const missing = try notesRefusalResult(notes, try Effect.flip(notes.update({ id: "note-404" }, { color: "green" }, appended.snapshot.revision)))
  const size = (value: unknown) => Array.isArray(value) ? value.length : 0
  assert.deepEqual(
    [choice, stale, missing].map((result) => [result.data?.code, result.data?.awaitingUserInput, size(result.data?.candidates), result.transcriptVisibility, result.data?.coachingFailure]),
    [["NOTES_AMBIGUOUS_NOTE", true, 2, undefined, undefined], ["NOTES_EDIT_CONFLICT", undefined, 0, "internal", true], ["NOTES_NOT_FOUND", undefined, 0, undefined, undefined]])

  const plugin = notesPlugin(notes)
  const room = roomCache()
  const deleting = action(plugin, "NOTES_DELETE", room)
  const live = effect () => (try notes.snapshot()).notes.map((note) => note.id)
  const guessed = try deleting(message("delete my groceries note", undefined, turnId(1)), { noteId: draft.value.note.id })
  const guessedAgain = try deleting(message("delete my groceries note", undefined, turnId(1)), { noteId: draft.value.note.id })
  assert.deepEqual([guessed.success, guessed.data?.code, guessed.data?.candidateIds, guessed.data?.awaitingUserInput, guessedAgain.data?.code, try live()],
    [false, "NOTES_AMBIGUOUS_NOTE", [draft.value.note.id, "note-1"], true, "NOTES_AMBIGUOUS_NOTE", [draft.value.note.id, "note-1"]])
  const picked = try deleting(message("the one with just milk", undefined, turnId(2)), { noteId: draft.value.note.id })
  assert.deepEqual([picked.success, picked.data?.noteId, try live()], [true, draft.value.note.id, ["note-1"]])
  const wrapped = message("Contextual documents: Groceries FAQ")
  try Effect.try(() => bindIncomingMessagePersistence(wrapped, message("delete my trip note")))
  assert.equal(try ownerRequestText(wrapped), "delete my trip note")
  const closest = try deleting(message("get rid of the grocery note"), { content: "oat milk" })
  assert.deepEqual([closest.success, closest.data?.code, closest.data?.candidateIds, closest.text?.includes('"Groceries"')], [false, "NOTES_DELETE_NAME_MISMATCH", ["note-1"], true])
  const trip = try notes.create({ content: "Trip\npack the tent" })
  const byTitle = try deleting(message("get rid of my camping note"), { content: "trip" })
  assert.deepEqual([byTitle.success, byTitle.data?.noteId], [true, trip.value.note.id])
  assert.deepEqual((try notes.snapshot()).trash?.map((entry) => entry.note.id), [draft.value.note.id, trip.value.note.id])
  const errands = (try notes.create({ content: "Errands\nbank" })).value.note.id
  try notes.create({ content: "Errands\npost office" })
  const byModel = { ownerChose: [] }
  assert.equal(try code(notes.delete({ selector: "query", value: "errands" }, byModel)), "NOTES_AMBIGUOUS_NOTE")
  assert.equal(try code(notes.delete({ id: errands }, byModel)), "NOTES_AMBIGUOUS_NOTE")
  assert.equal((try notes.delete({ id: errands })).value.id, errands)
  const milk = [try notes.create({ content: "Milk\nbuy two", forceNew: true }), try notes.create({ content: "Milk\nbuy two", forceNew: true })].map((made) => made.value.note.id)
  assert.equal((try notes.update({ id: milk[0] ?? "" }, { textEdit: { field: "body", oldText: "two", newText: "two" } }, undefined, byModel)).value.id, milk[0])
  assert.isTrue(milk.includes((try notes.delete({ selector: "query", value: "milk" }, byModel)).value.id))
  const afterMilk = try notes.snapshot()
  assert.deepEqual([afterMilk.notes.filter((note) => milk.includes(note.id)).length, afterMilk.trash?.filter((entry) => milk.includes(entry.note.id)).length], [0, 2])
  const chores = [try notes.create({ content: "Chores\nsweep", forceNew: true }), try notes.create({ content: "Chores\nsweep", forceNew: true })].map((made) => made.value.note.id)
  const mopped = try notes.update({ selector: "title", value: "chores" }, { textEdit: { field: "body", oldText: "sweep", newText: "mop" } })
  assert.isTrue(chores.includes(mopped.value.id))
  assert.deepEqual(mopped.snapshot.notes.filter((note) => note.title === "Chores").map((note) => [note.id, note.body]), [[mopped.value.id, "\nmop"]])
  const lists = [try notes.create({ content: "Lists\none" }), try notes.create({ content: "Lists\ntwo" })].map((made) => made.value.note.id)
  const renumber = { textEdit: { field: "body", oldText: "one", newText: "1" } }
  assert.equal(try code(notes.update({ selector: "query", value: "lists" }, renumber)), "NOTES_AMBIGUOUS_NOTE")
  assert.equal((try notes.update({ id: lists[0] ?? "" }, renumber)).value.body, "\n1")
  const updating = action(plugin, "NOTES_UPDATE", room)
  const reading = action(plugin, "NOTES_LIST", room)
  const second = { noteId: lists[1] ?? "", textEdit: { field: "body", oldText: "two", newText: "2" } }
  const firstList = { noteId: lists[0] ?? "", textEdit: { field: "body", oldText: "1", newText: "one" } }
  const bodyOf = (id: string) => effect () => (try notes.snapshot()).notes.find((note) => note.id === id)?.body
  const read = try reading(message("number my lists note", undefined, turnId(3)), { content: "lists" })
  const unasked = try updating(message("number my lists note", undefined, turnId(3)), second)
  try reading(message("the second one", undefined, turnId(4)), { content: "lists" })
  const chosen = try updating(message("the second one", undefined, turnId(4)), second)
  const later = try updating(message("and put a 1 back in the first lists note", undefined, turnId(5)), firstList)
  try Effect.sync(() => room.age(11 * 60_000))
  const expired = try updating(message("the first one", undefined, turnId(6)), firstList)
  const unique = try updating(message("add oat to my groceries note", undefined, turnId(7)), { noteId: "note-1", textEdit: { field: "body", oldText: "eggs", newText: "oat eggs" } })
  assert.deepEqual([read.success, unasked.data?.code, unasked.data?.candidateIds, chosen.success, try bodyOf(lists[1] ?? "")(), later.data?.code, expired.data?.code, try bodyOf(lists[0] ?? "")(), unique.success],
    [true, "NOTES_AMBIGUOUS_NOTE", [...lists].reverse(), true, "\n2", "NOTES_AMBIGUOUS_NOTE", "NOTES_AMBIGUOUS_NOTE", "\n1", true])

  const folders = readNoteFolders({ notesFolders: [{ id: "folder-home", name: "Home  stuff" }, { id: "folder-work", name: "Work" }] })
  const home = findNoteFolder(folders ?? [], "home stuff")
  assert.deepEqual(home, { id: "folder-home", name: "Home stuff" })
  try notes.move({ id: "note-1" }, home?.id ?? null)
  assert.equal((try notes.snapshot()).notes.find((note) => note.id === "note-1")?.format?.data.folderId, "folder-home")
  const packing = [try notes.create({ content: "Packing\n- tent", forceNew: true }), try notes.create({ content: "Packing\n- tent", forceNew: true })].map((made) => made.value.note.id)
  try notes.move({ selector: "query", value: "packing" }, findNoteFolder(folders ?? [], "work")?.id ?? null)
  assert.deepEqual((try notes.snapshot()).notes.filter((note) => packing.includes(note.id)).map((note) => note.format?.data.folderId), ["folder-work", "folder-work"])
  assert.isUndefined(readNoteFolders({ notesFolders: [{ id: "a", name: "Work" }, { id: "b", name: "work" }] }))

  const listed = try action(plugin, "NOTES_LIST")(message("latest note"), { latestBy: "createdAt" })
  const none = try action(notesPlugin(notesOver(fixture())), "NOTES_LIST")(message("list my notes"), {})
  assert.isTrue((plugin.actions ?? []).every((candidate) => satisfiesContextGate(["general"], { contexts: candidate.contexts }, ["OWNER"])))
  const farEast = { voiceUi: { uiTimeZone: "Pacific/Kiritimati" } }
  const zoned = [try action(plugin, "NOTES_GET")(message("when did I write note-1", farEast), { noteId: "note-1" }), try action(plugin, "NOTES_GET")(message("when did I write note-1"), { noteId: "note-1" }),
    try action(plugin, "NOTES_GET")(message("when did I write note-1", { voiceUi: { uiTimeZone: "Nowhere/Land" } }), { noteId: "note-1" })]
  const shownTimes = zoned.map((read) => read.data?.noteTimestampDisplay as { readonly timeZone: string; readonly createdAt: string } | undefined)
  assert.deepEqual(shownTimes.map((times) => [times?.timeZone, times?.createdAt.startsWith("Nov 21, 2026")]), [["Pacific/Kiritimati", true], [undefined, undefined], [undefined, undefined]])
  assert.deepEqual([listed.success, listed.data?.op, listed.effectReceipts, listed.emptyTrackedState, { ...none.emptyTrackedState, observedAt: "" }],
    [true, "list", undefined, undefined, { resource: "notes", scope: "entire_current_inventory", count: 0, revision: 0, observedAt: "" }])
  const routing = (plugin.providers ?? []).find((provider) => provider.name === "NAMED_NOTE_ROUTING")
  const availability = try promise(() => routing!.get(undefined as never, message("what is in my trip note"), undefined as never))
  assert.equal(availability.data?.namedNoteMatchAvailable, true)
  const saved = (plugin.providers ?? []).find((provider) => provider.name === "SAVED_NOTES")
  const savedText = (try promise(() => saved!.get(undefined as never, message("what is in my trip note"), undefined as never))).text ?? ""
  assert.include(savedText, "If no row has the note title the owner asked for, ask which note to use before citing another note.")
  const groceries = (try notes.snapshot()).notes.find((note) => note.id === "note-1")!
  const reference = notes.sourceReference(groceries)
  try notes.assertSourceReference(reference)
  assert.equal(try code(notes.assertSourceReference({ ...reference, agentId: "another-agent" })), "CALENDAR_NOTE_SOURCE_CONFLICT")
  try notes.update({ id: "note-1" }, { textEdit: { field: "title", oldText: "Groceries", newText: "Shopping" } })
  assert.equal(try code(notes.assertSourceReference(reference)), "CALENDAR_NOTE_SOURCE_CONFLICT")
  assert.deepEqual(f.published, ["note:created", "note:created", "note:updated", "note:updated", "note:deleted", "note:created", "note:deleted", "note:created", "note:created", "note:deleted", "note:created", "note:created", "note:updated", "note:deleted", "note:created", "note:created", "note:updated", "note:created", "note:created", "note:updated", "note:updated", "note:updated", "note:moved", "note:created", "note:created", "note:moved", "note:updated"])
  const asked = try action(plugin, "NOTES_CREATE")(message("add a note: call the plumber Tuesday"), { content: "Call the plumber Tuesday" })
  assert.deepEqual([asked.success, asked.data?.op, (try notes.snapshot()).notes.some((note) => note.title === "Call the plumber Tuesday")], [true, "create", true])
  const creating = action(plugin, "NOTES_CREATE")
  const trek = try creating(message("start a trek checklist: tent, stove"), { content: "Trek", checklist: ["tent", "stove"] })
  const trekAgain = try creating(message("make me a new trek checklist with tent and stove"), { content: "Trek", checklist: ["tent", "stove"] })
  const fullItems = Array.from({ length: noteLimits.checklistItems }, (_, index) => `${index}`.padEnd(noteLimits.checklistItem, "x"))
  const full = try creating(message("make a supplies checklist with all of these"), { content: "Supplies", checklist: fullItems })
  const beforeRefused = (try notes.snapshot()).revision
  const untitled = [
    try creating(message("make me a checklist: tent, stove"), { checklist: ["tent", "stove"] }),
    try creating(message("make me a checklist: tent, stove"), { content: "  ", checklist: ["tent", "stove"] }),
  ]
  const refusedLists = [
    try creating(message("make an empty checklist"), { content: "Empty", checklist: [] }),
    try creating(message("make a checklist with tent and a blank line"), { content: "Blank", checklist: ["tent", " "] }),
    try creating(message("make a trek checklist with tent and a note to bring snacks"), { content: "Trek\nbring snacks", checklist: ["tent"] }),
    try creating(message("make a long checklist"), { content: "Long", checklist: [...fullItems, "one more"] }),
    try creating(message("make a checklist with one very long item"), { content: "Long", checklist: ["x".repeat(noteLimits.checklistItem + 1)] }),
    ...untitled,
  ]
  const trekList = { kind: "list", data: { items: [{ t: "tent", done: false }, { t: "stove", done: false }] } }
  const afterRefused = try notes.snapshot()
  const packed = afterRefused.notes.find((note) => note.id === full.data?.noteId)
  assert.deepEqual([
    [trek.success, trek.data?.op, trekAgain.success, trekAgain.data?.op, trekAgain.data?.noteId === trek.data?.noteId],
    afterRefused.notes.filter((note) => note.title === "Trek").map((note) => [note.body, note.format]),
    [full.success, packed?.title, packed?.format?.kind === "list" && Array.isArray(packed.format.data.items) ? packed.format.data.items.length : 0],
    refusedLists.map((result) => [result.success, result.data?.code]),
    untitled.map((result) => result.text?.includes("Ask the owner what to call the checklist")),
    afterRefused.revision === beforeRefused,
    afterRefused.notes.some((note) => note.title.trim() === "" && note.format?.kind === "list"),
  ], [
    [true, "create", true, "create", false],
    [["", trekList], ["", trekList]],
    [true, "Supplies", noteLimits.checklistItems],
    refusedLists.map(() => [false, "NOTES_VALIDATION_FAILED"]),
    [true, true],
    true,
    false,
  ])
  const described = (name: string) => (plugin.actions ?? []).find((candidate) => candidate.name === name)
  assert.deepEqual([
    described("NOTES_CREATE")?.description.includes("A new checklist the owner asks for is a creation, never items added to a checklist already saved: put the title the owner gave it alone in content and the owner's items, in their order, in checklist"),
    described("NOTES_CREATE")?.description.includes(`at most ${noteLimits.checklistItems} items of at most ${noteLimits.checklistItem} characters each. When the owner gave the checklist no title, ask what to call it instead of creating it.`),
    described("NOTES_CREATE")?.parameters?.some((parameter) => parameter.name === "checklist" && parameter.schema.items?.maxLength === noteLimits.checklistItem),
    described("NOTES_UPDATE")?.description.includes("adds one list item in the note's own form, to a note the owner named, never as a new checklist the owner asked for (that is NOTES_CREATE with checklist)"),
    described("NOTES_GET")?.description.includes("A title no saved note has reads nothing and asks the owner which note they mean, so never cite another note in its place."),
  ], [true, true, true, true, true])
  const getting = action(plugin, "NOTES_GET")
  const weekend = try notes.create({ content: "Weekend\nbring the gear bag" })
  const absentTitle = try getting(message("what's in my gear note"), { title: "gear" })
  const weekendRead = try getting(message("what's in my weekend note"), { title: "weekend" })
  const sharedTitle = try getting(message("what's on my trek checklist"), { title: "trek" })
  const both = try getting(message("what's in my gear note"), { title: "gear", content: "gear" })
  const trekIds = [trek.data?.noteId, trekAgain.data?.noteId]
  const offered: unknown = sharedTitle.data?.candidateIds
  const shown: unknown = sharedTitle.data?.candidates
  assert.deepEqual([
    [absentTitle.success, absentTitle.data?.code, absentTitle.data?.awaitingUserInput, absentTitle.data?.requiresInput, absentTitle.data?.candidateIds, absentTitle.data?.candidates, absentTitle.text?.includes("bring the gear bag")],
    [weekendRead.success, weekendRead.data?.noteId],
    [sharedTitle.success, sharedTitle.data?.code, sharedTitle.data?.awaitingUserInput, sharedTitle.data?.requiresInput, sharedTitle.data?.note, sharedTitle.data?.noteId],
    [Array.isArray(offered) && offered.length === 2 && trekIds.every((id) => offered.includes(id)), Array.isArray(shown) ? shown.length : 0],
    [both.success, both.text?.includes("noteId, title or content")],
  ], [
    [false, "NOTES_TITLE_NOT_FOUND", true, true, [weekend.value.note.id], [{ id: weekend.value.note.id, title: "Weekend" }], false],
    [true, weekend.value.note.id],
    [false, "NOTES_AMBIGUOUS_NOTE", true, true, undefined, undefined],
    [true, 2],
    [false, true],
  ])

  const camp = try notes.create({ content: "Camp", format: { kind: "list", data: { items: [{ t: "tent", done: false }] } } })
  const oversized = { field: "checklist", index: 0, expectedText: "tent", text: "x".repeat(262_145) } as const
  assert.equal(try code(notes.update({ id: camp.value.note.id }, { authoredEdit: oversized }, camp.snapshot.revision)), "NOTES_VALIDATION_FAILED")
  assert.equal((try notes.snapshot()).revision, camp.snapshot.revision)

  const lone = try notes.create({ content: "Trip \uD83C\nTent \uDC00 poles 🏕" })
  const retitled = try notes.update({ id: lone.value.note.id }, { title: "Camp \uDFD5 trip" }, lone.snapshot.revision)
  const literalLone = try notes.update({ id: lone.value.note.id }, { textEdit: { field: "body", oldText: "poles", newText: "pegs \uD800" } })
  const titled = try notes.create({ title: "Hike \uDC00", body: "boots" })
  assert.deepEqual(
    [lone.value.note.title, lone.value.note.body, retitled.value.title, literalLone.value.body, titled.value.note.title, (try notes.create({ title: "Hike \uDC00", body: "boots" })).value.note.id],
    ["Trip �", "\nTent � poles 🏕", "Camp � trip", "\nTent � pegs � 🏕", "Hike �", titled.value.note.id])
})

it.effect('Restore a deleted note exactly, at the revision the owner saw (spec/notes/trash.md, "Story: Recover a deleted note")', effect () => {
  const f = fixture()
  const notes = notesOver(f)
  const made = try notes.create({ content: "Passport\nrenew in March", color: "rose" })
  const deleted = try notes.delete({ id: made.value.note.id })
  const entry = deleted.snapshot.trash?.[0]
  assert.isDefined(entry)
  assert.equal(try code(notes.restore({ id: made.value.note.id, expectedRevision: made.snapshot.revision })), "NOTES_EDIT_CONFLICT")
  assert.equal(try code(notes.restore({ id: made.value.note.id, expectedRevision: deleted.snapshot.revision, deletedAt: "2020-01-01T00:00:00.000Z" })), "NOTES_NOT_FOUND")
  const restored = try notes.restore({ id: made.value.note.id, expectedRevision: deleted.snapshot.revision, deletedAt: entry!.deletedAt })
  assert.deepEqual(restored.value, made.value.note)
  assert.deepEqual([restored.snapshot.notes, restored.snapshot.trash], [[made.value.note], []])
  assert.equal(try code(notes.restore({ id: made.value.note.id, expectedRevision: restored.snapshot.revision })), "NOTES_NOT_FOUND")
  assert.equal(try code(notes.eraseTrash({ scope: "all", expectedRevision: restored.snapshot.revision })), "NOTES_TRASH_RETENTION_DISABLED")
  f.kept.value = { ...(f.kept.value as object), schemaVersion: 3 }
  assert.equal(try code(notes.snapshot()), "NOTES_STORE_UNAVAILABLE")
})

it.effect('Import the earlier notes once, exactly, and never over the collection (spec/notes/records.md, "Story: Keep the notes I saved before this version"; spec/notes/records.md, "The earlier document is imported once, exactly, and never over the collection")', effect () => {
  const saved: StickyNote = { id: "trip-plan", title: "Trip", body: "\npack the tent", color: "green", createdAt: "2026-10-01T08:00:00.000Z", updatedAt: "2026-10-02T08:00:00.000Z" }
  const gone: StickyNote = { id: "old-list", title: "Old list", body: "", color: "yellow", createdAt: "2026-09-01T08:00:00.000Z", updatedAt: "2026-09-01T08:00:00.000Z" }
  const earlier = {
    schemaVersion: 3, revision: 7, persistedAt: "2026-10-02T08:00:00.000Z", notes: [saved],
    trash: [{ note: gone, deletedAt: "2026-10-03T08:00:00.000Z" }], noteRevisions: { "trip-plan": 7 }, noteCreations: { "workflow-step": "trip-plan" },
  }
  const f = fixture()
  f.prior.raw = JSON.stringify(earlier)
  const notes = notesOver(f, { prior: true })
  f.kept.loseNext = true
  assert.equal(try code(notes.snapshot()), "NOTES_COMMIT_UNCONFIRMED")
  assert.isUndefined(f.kept.value)
  const imported = try notes.snapshot()
  assert.deepEqual(imported, { notes: [saved], revision: 8, trash: [{ note: gone, deletedAt: "2026-10-03T08:00:00.000Z" }] })
  const persisted = try promise(() => f.storage.get())
  const receipt = typeof persisted === "object" && persisted !== null && "imported" in persisted ? persisted.imported : undefined
  assert.deepEqual(receipt, {
    source: "notes-state", schemaVersion: 3, sourceRevision: 7, sourceDigest: "a".repeat(64), notes: 1, trash: 1, importedAt: "2026-11-20T10:00:00.000Z",
  })
  const replay = try notes.create({ content: "Trip\npack the tent", creationId: "workflow-step" })
  assert.deepEqual([replay.value.replayed, replay.value.note.id], [true, "trip-plan"])
  try notes.create({ content: "New since the update" })
  f.prior.raw = JSON.stringify({ ...earlier, notes: [] })
  assert.deepEqual((try notes.snapshot()).notes.map((note) => note.id), ["note-2", "trip-plan"])
  assert.equal(f.prior.reads, 2)

  const legacy = fixture()
  legacy.prior.raw = JSON.stringify({ schemaVersion: 1, revision: 0, persistedAt: "2026-01-01T00:00:00.000Z", notes: [{ ...saved, body: "pack the tent" }] })
  assert.equal((try notesOver(legacy, { prior: true }).snapshot()).notes[0]?.body, "\npack the tent")
  const broken = fixture()
  broken.prior.raw = JSON.stringify({ ...earlier, notes: [saved, saved] })
  assert.equal(try code(notesOver(broken, { prior: true }).snapshot()), "NOTES_STORE_UNAVAILABLE")
  broken.prior.raw = "{"
  assert.equal(try code(notesOver(broken, { prior: true }).snapshot()), "NOTES_STORE_UNAVAILABLE")
  assert.isUndefined(broken.kept.value)
  const absent = fixture()
  assert.deepEqual(try notesOver(absent, { prior: true }).snapshot(), { notes: [], revision: 0, trash: [] })
})

it.effect('Erase only a reviewed, unshared deletion, sweep after three days and retire a recording only on the device\'s literal proof (spec/notes/trash.md, "Story: Let deleted notes expire after three days when I choose that"; spec/notes/trash.md, "Story: Erase or recover only the recording of my reviewed note"; spec/notes/trash.md, "The proof of erase comes from the service\'s own verifier, else the host\'s verifier found when the cleanup is acknowledged, and only a literal true is proof")', effect () => {
  const f = fixture()
  const notes = notesOver(f, { threeDayTrash: true })
  const memo = try notes.create({ content: "", format: voice("memo", "audio-memo") })
  const shared = try notes.create({ content: "", format: voice("copy", "audio-shared") })
  try notes.create({ content: "", format: voice("live", "audio-shared") })
  const plain = try notes.create({ content: "Old list" })
  try notes.delete({ id: memo.value.note.id })
  try notes.delete({ id: shared.value.note.id })
  const trashed = try notes.delete({ id: plain.value.note.id })
  const rows = trashed.snapshot.trash ?? []
  const memoRow = rows.find((row) => row.note.id === memo.value.note.id)!
  const sharedRow = rows.find((row) => row.note.id === shared.value.note.id)!
  assert.equal(try code(notes.eraseTrash({ scope: "entry", expectedRevision: trashed.snapshot.revision - 1, id: memoRow.note.id, deletedAt: memoRow.deletedAt })), "NOTES_EDIT_CONFLICT")
  assert.equal(try code(notes.eraseTrash({ scope: "entry", expectedRevision: trashed.snapshot.revision, id: sharedRow.note.id, deletedAt: sharedRow.deletedAt })), "NOTES_TRASH_RECORDING_UNAVAILABLE")

  f.kept.loseNext = true
  assert.equal(try code(notes.eraseTrash({ scope: "entry", expectedRevision: trashed.snapshot.revision, id: memoRow.note.id, deletedAt: memoRow.deletedAt })), "NOTES_COMMIT_UNCONFIRMED")
  f.kept.refuseNext = true
  assert.equal(try code(notes.eraseTrash({ scope: "entry", expectedRevision: trashed.snapshot.revision, id: memoRow.note.id, deletedAt: memoRow.deletedAt })), "NOTES_COMMIT_UNCONFIRMED")
  const pending = try notes.readTrashRecordingCleanup()
  assert.deepEqual(pending.map((row) => [row.noteId, row.audioId]), [[memo.value.note.id, "audio-memo"]])
  const receipt = pending[0]!

  assert.equal(try code(notes.acknowledgeTrashRecordingCleanup(receipt)), "NOTES_TRASH_RECORDING_UNAVAILABLE")
  f.hostVerifier.verify = async () => "true"
  assert.equal(try code(notes.acknowledgeTrashRecordingCleanup(receipt)), "NOTES_TRASH_RECORDING_UNAVAILABLE")
  f.hostVerifier.verify = async () => { throw new Error("device offline") }
  assert.equal(try code(notes.acknowledgeTrashRecordingCleanup(receipt)), "NOTES_TRASH_RECORDING_UNAVAILABLE")
  const asked: string[] = []
  f.hostVerifier.verify = async (proof) => {
    asked.push(`host:${proof.audioId}`)
    return true
  }
  const withOwn = notesOver(f, { threeDayTrash: true, verify: async (proof) => { asked.push(`own:${proof.audioId}`); return false } })
  assert.equal(try code(withOwn.acknowledgeTrashRecordingCleanup(receipt)), "NOTES_TRASH_RECORDING_UNAVAILABLE")
  assert.equal(try notes.acknowledgeTrashRecordingCleanup({ ...receipt, operationId: "99999999-9999-4999-8999-999999999999" }), false)
  assert.equal(try notes.acknowledgeTrashRecordingCleanup(receipt), true)
  assert.deepEqual(asked, ["own:audio-memo", "host:audio-memo"])
  assert.deepEqual(try notes.readTrashRecordingCleanup(), [])

  f.clock.ms = start + 3 * day - 1
  assert.deepEqual((try notes.snapshot()).trash?.map((row) => row.note.id), [shared.value.note.id, plain.value.note.id])
  f.clock.ms = start + 3 * day
  assert.equal(try code(notes.restore({ id: plain.value.note.id, expectedRevision: (try notes.snapshot()).revision })), "NOTES_NOT_FOUND")
  assert.deepEqual((try notes.snapshot()).trash?.map((row) => row.note.id), [shared.value.note.id])
  assert.isTrue(f.published.includes("trash:expired"))
})

it.effect('Offer organizing and recording only where the device advertised and can review it (spec/notes/organize.md, "Story: Organize my notes only where I can see it")', effect () => {
  const recordOnly = ["notes.record.v1"]
  const legacyPair = ["notes.organize.v1", "notes.local-record.v1"]
  assert.deepEqual(["notes_move", "constructor"].map(isNotesOrganizeType), [true, false])
  const recordFirst: NotesOrganizeType[] = ["notes_record", "notes_move", "notes_folder_create", "notes_restore", "notes_filter"]
  assert.deepEqual(recordFirst.map((type) => notesOrganizeOffered(type, recordOnly)), [true, false, false, false, false])
  const legacyTypes: NotesOrganizeType[] = ["notes_record", "notes_move", "notes_list_filter"]
  assert.deepEqual(legacyTypes.map((type) => notesOrganizeOffered(type, legacyPair)), [true, true, false])
  assert.isFalse(notesOrganizeOffered("notes_move", ["notes.organize.v1"]))
  assert.isTrue(notesOrganizeOffered("notes_list_filter", ["notes.list-filter.v1"]))
  assert.deepEqual([
    notesOrganizeContextAllowed({ view: "home" }, "notes_move"),
    notesOrganizeContextAllowed({ view: "notes" }, "notes_restore"),
    notesOrganizeContextAllowed({ view: "home" }, "notes_record"),
    notesOrganizeContextAllowed({ view: "notes" }, "notes_record"),
    notesOrganizeContextAllowed({ view: "notes", sensitive: true }, "notes_record"),
    notesOrganizeContextAllowed({ view: "calendar" }, "notes_filter"),
    notesOrganizeContextAllowed({ view: "notes", selectedObject: { kind: "canonical-note-source", id: "notes", revision: "4" } }, "notes_list_filter"),
    notesOrganizeContextAllowed({ view: "notes" }, "notes_list_filter"),
  ], [true, true, false, true, false, false, true, false])
  assert.deepEqual([notesOrganizeRunsDirectly("notes_record", true, false), notesOrganizeRunsDirectly("notes_move", true, false), notesOrganizeRunsDirectly("notes_filter", true, true)], [true, false, false])
  assert.deepEqual(try decodeNotesOrganizeOperation({ type: "notes_folder_create", name: "  Trip   plans " }), { type: "notes_folder_create", name: "Trip plans" })
  assert.deepEqual(try decodeNotesOrganizeOperation({ type: "notes_record", action: "stop" }), { type: "notes_record", action: "stop" })
  assert.deepEqual(try decodeNotesOrganizeOperation({ type: "notes_move", target, folder: " Work " }), { type: "notes_move", target, folder: "Work" })
  const refusedReason = (value: unknown) => map(Effect.flip(decodeNotesOrganizeOperation(value)), (error) => error.reason)
  assert.deepEqual([
    try refusedReason({ type: "notes_record", action: "start", title: "Memo" }),
    try refusedReason({ type: "notes_folder_create", name: "x".repeat(41) }),
    try refusedReason({ type: "notes_filter" }),
    try refusedReason({ type: "notes_list_filter", folder: "Work" }),
  ], ["Unexpected Notes field", "Invalid folder name", "Empty Notes filter", "Unexpected Notes field"])
})

function routed(routes: readonly LocalRoute[]) {
  return {
    async fetch<T>(path: string, init: { method: "GET" | "POST"; body?: string; signal?: AbortSignal }): Promise<T> {
      const route = routes.find((candidate) => candidate.path === path && candidate.method === init.method)
      if (route === undefined) throw new Error(`no route ${init.method} ${path}`)
      let body: unknown
      try {
        body = init.body === undefined ? undefined : JSON.parse(init.body)
      } catch {
        body = undefined
      }
      const reply = (await route.handler({
        parameters: new Map(), query: new Map(), headers: new Map(), body, signal: init.signal ?? new AbortController().signal,
      })) as { status: number; body: unknown }
      if (reply.status >= 400) {
        const failure = reply.body as { error?: { message?: string } | string }
        throw new Error(typeof failure.error === "string" ? failure.error : failure.error?.message ?? `status ${reply.status}`)
      }
      return reply.body as T
    },
  }
}

it.effect('Read and save through the owner\'s client, adopting only the committed target (spec/notes/client.md, "Story: Read and save a note under the current connection"; spec/notes/read.md, "Wire and authored content have different boundaries")', effect () => {
  const f = fixture()
  const notes = notesOver(f, { threeDayTrash: true })
  const client = createNotesClient(routed(notesRoutes(notes)))
  const empty = try promise(() => client.readState())
  assert.deepEqual(empty, { notes: [], revision: 0, trash: [] })
  const format = { kind: "list", data: { items: [{ t: "tent", done: true }, { t: "stove" }], recordingHandle: "local-only" } }
  const created = try promise(() => client.interact("create-note", { content: "Camping", format, forceNew: true }))
  const note: StickyNote = created.note!
  assert.deepEqual(created.target, { id: note.id, revision: 1 })
  assert.equal(authoredNoteText(note.format), "tent\nstove")
  assert.equal(noteScheduleText(note), "stove")
  assert.deepEqual(noteShareText(note), { title: "Camping", text: "Camping\n\n[x] tent\n[ ] stove" })
  assert.isDefined(try promise(() => recordNoteOriginFor(note)))
  assert.isUndefined(parseNoteFormat({ kind: "list", data: { bad: Number.NaN } }))
  const stale = try exit(promise(() => client.interact("update-note", { id: note.id, content: "Camping trip", expectedRevision: 0 })))
  assert.isTrue(Exit.isFailure(stale))
  const updated = try promise(() => client.interact("update-note", { id: note.id, authoredEdit: { field: "checklist", index: 1, expectedText: "stove", done: true }, expectedRevision: 1 }))
  assert.equal(noteScheduleText(updated.note!), "")
  try promise(() => client.interact("delete-note", { id: note.id }))
  const state = try promise(() => client.readState())
  const row = state.trash![0]!
  const erased = try promise(() => client.eraseTrash({ scope: "entry", expectedRevision: state.revision, id: row.note.id, deletedAt: row.deletedAt }))
  assert.deepEqual([erased.erased, erased.recordingCleanup, erased.state.trash], [1, [], []])
  assert.deepEqual(try promise(() => client.readTrashRecordingCleanup()), [])
})

const collection = "11111111-1111-4111-8111-111111111111"
const target: NotesTarget = { sourceId: collection, sourceRevision: "1265a4d998c8f7f4765ebbc9b2eb385d6a052a89cc85985d63548f158ccc4ea4",
  noteId: "one", revision: "6f1ad1d8b56dd18f1e742e31b7e1942c35ba33312273f54aeebb1be8273c880c" }
const alice: NotesOwner = { ownerId: "alice", agentId: "agent", installationId: "installation", enrollmentId: "enrollment",
  origin: "https://local.example", scope: "private-notes" }
const proposal = { proposalId: "proposal", operationId: "operation", digest: "exact", owner: alice }
const claim: NotesClaim = { proposalId: proposal.proposalId, operationId: proposal.operationId, attemptId: 11 }
const one = { id: "one", kind: "text", title: "Work Ｐlan", body: "Reviewed body", createdAt: 100, updatedAt: 300 }
const two = { id: "two", kind: "voice", title: "Work plan upstairs", body: "Unselected body", createdAt: 100, updatedAt: 150,
  format: { kind: "voice", data: { recordingHandle: "secret-local-recording" } } }
const title = { type: "notes_query", query: { kind: "title", text: " ＰＬＡＮ " } } as const
const latest = { type: "notes_query", query: { kind: "latest", by: "created" } } as const
const direct: NotesReadOperation = { type: "notes_read_selected", target }
const missing = { type: "notes_query", query: { kind: "title", text: "absent" } } as const

const refused = <A>(plan: A!NotesReadRefused) => map(Effect.flip(plan), (error) => error.code)
const record = { version: 1, kind: "notes_read_selected", sourceId: collection, noteId: "one", revision: target.revision,
  fields: { title: one.title, body: one.body } } as const

effect function vaultFixture() {
  const files = try FileSystem.FileSystem
  const root = try files.makeTempDirectoryScoped({ prefix: "selected-notes-" })
  const path = try Path.Path
  const ownFile = path.join(root, "alice.committed")
  const otherFile = path.join(root, "bob.committed")
  const controls: {
    authority: NotesAuthority
    confirmed: boolean
    claimLive: boolean
    chose: string | undefined
    offered: ReadonlyArray<unknown>
    reviewed: unknown
    afterRead?: () => void
  } = {
    authority: { ...proposal, owner: alice, viewRevision: 1, view: "notes", foreground: true, permitted: true, selected: target },
    confirmed: true, claimLive: true, chose: "one", offered: [], reviewed: undefined,
  }
  effect function write(revision: string, records: readonly unknown[], file = ownFile) {
    const raw = JSON.stringify({ version: 2, collectionId: collection, records, deleted: [] })
    try files.writeFileString(file, JSON.stringify({ revision, raw }))
  }
  try write("original", [two, one])
  try write("foreign", [{ ...one, id: "foreign", body: "Foreign account body" }], otherFile)
  schema Envelope { revision: string; raw: string }
  const ports: NotesReadPorts = {
    current: () => controls.authority,
    effect readCommitted(owner) {
      if (owner.scope !== "private-notes") throw new NotesReadRefused({ code: "unavailable" })
      const file = owner.ownerId === "alice" ? ownFile : owner.ownerId === "bob" ? otherFile : undefined
      if (file === undefined) return undefined
      const input = try mapError(files.readFileString(file), () => new NotesReadRefused({ code: "unavailable" }))
      const snapshot = try mapError(Schema.decodeUnknownEffect(Schema.fromJsonString(Envelope))(input), () => new NotesReadRefused({ code: "unavailable" }))
      controls.afterRead?.()
      return snapshot
    },
    effect choose(choices) {
      controls.offered = choices
      return controls.chose
    },
    effect review(preview) {
      controls.reviewed = preview
      return controls.confirmed
    },
    hasClaim: (request, call) => request.digest === proposal.digest && call.attemptId === claim.attemptId && controls.claimLive,
  }
  return { local: try selectedNotes(ports), controls, write, remove: () => files.remove(ownFile) }
}

it.effect('Select and review a current local note and share its exact receipt (spec/notes/read.md, "Story: Search private notes and share only what I select"; spec/notes/read.md, "A query receipt carries the original query, an allowed basis and a record only on a match")', effect () => {
  provide NodeServices.layer {
    const { local, controls, write } = try vaultFixture()
    const selected = try local.prepare(title, proposal)
    assert.deepEqual(controls.offered, [{ id: "two", title: two.title }, { id: "one", title: one.title }])
    assert.deepEqual(controls.reviewed, { target, fields: record.fields })
    assert.deepEqual(try selected.execute(claim), { version: 1, kind: "notes_query", query: title.query, basis: "title-match", target, record })
    assert.equal(try refused(selected.execute(claim)), "not_current")
    assert.deepEqual(try (try local.prepare(direct, proposal)).execute(claim), record)
    assert.deepEqual(try (try local.prepare(latest, proposal)).execute(claim),
      { version: 1, kind: "notes_query", query: latest.query, basis: "owner-choice-uncertain", target, record })
    const updated = { type: "notes_query", query: { kind: "latest", by: "updated" } } as const
    assert.deepEqual(try (try local.prepare(updated, proposal)).execute(claim),
      { version: 1, kind: "notes_query", query: updated.query, basis: "latest-updated", target, record })
    try write("legacy-dates", [two, { ...one, createdAt: "2026-02-31T10:12:30Z" }])
    const uncertain = try (try local.prepare(latest, proposal)).execute(claim)
    assert.equal(uncertain.kind === "notes_query" && uncertain.basis, "owner-choice-uncertain")
    try write("sole-note", [one])
    const only = try (try local.prepare(latest, proposal)).execute(claim)
    assert.equal(only.kind === "notes_query" && only.basis, "only-note")
    assert.deepEqual(try (try local.prepare(missing, proposal)).execute(claim),
      { version: 1, kind: "notes_query", query: missing.query, basis: "no-match" })
  }
})

it.effect('Decline publication after cancellation, authority drift or a changed committed note (spec/notes/read.md, "Story: Search private notes and share only what I select"; spec/notes/read.md, "Wire and authored content have different boundaries")', effect () => {
  provide NodeServices.layer {
    const { local, controls, write, remove } = try vaultFixture()
    const held = controls.authority
    const approved = try local.prepare(title, proposal)
    const wrongScope = { ...alice, scope: "another-scope" }
    controls.authority = { ...held, owner: wrongScope }
    assert.equal(try refused(approved.execute(claim)), "not_current")
    controls.authority = { ...held, owner: { ...alice, ownerId: "bob" } }
    assert.equal(try refused(local.prepare(title, proposal)), "not_current")
    controls.authority = held
    const previous = try local.prepare(direct, proposal)
    const replacement = try local.prepare(direct, proposal)
    assert.equal(try refused(previous.execute(claim)), "not_current")
    controls.afterRead = () => { controls.authority = { ...held, owner: { ...alice, ownerId: "bob" } } }
    assert.equal(try refused(replacement.execute(claim)), "not_current")
    controls.afterRead = undefined
    controls.authority = held
    const changed = try local.prepare(direct, proposal)
    try write("original", [two, { ...one, body: "Changed after review" }])
    assert.equal(try refused(changed.execute(claim)), "source_changed")
    assert.equal(try refused(local.prepare(direct, proposal)), "source_changed")
    try write("other-revision", [two, one])
    const empty = try local.prepare(missing, proposal)
    controls.afterRead = () => { controls.claimLive = false }
    assert.equal(try refused(empty.execute(claim)), "not_current")
    controls.afterRead = undefined
    controls.claimLive = true
    controls.confirmed = false
    assert.equal(try refused(local.prepare(direct, proposal)), "cancelled")
    controls.confirmed = true
    const revoked = try local.prepare(direct, proposal)
    controls.authority = { ...held, permitted: false, view: "sensitive", viewRevision: 2, foreground: false }
    assert.equal(try refused(revoked.execute(claim)), "not_current")
    controls.authority = { ...held, viewRevision: 3 }
    assert.equal(try refused(revoked.execute(claim)), "not_current")
    controls.chose = "two"
    try write("checklist", [one, { ...two, kind: "list" }])
    assert.equal(try refused(local.prepare(title, proposal)), "not_shareable")
    try write("over-wire-budget", [{ ...one, body: "界".repeat(25_000) }])
    assert.equal(try refused(local.prepare(title, proposal)), "oversize")
    try remove()
    assert.equal(try refused(local.prepare(missing, proposal)), "unavailable")
  }
})

const phoneCapabilities = "notes.local-record.v1,notes.query.v1,notes.search.v1,notes.organize.v1,device.named-target.v1"
const phoneNote = { sourceId: "phone-notes", sourceRevision: "a".repeat(64), noteId: "note-7", revision: "b".repeat(64) }
const openPhoneNote = { kind: "note", id: phoneNote.noteId, revision: phoneNote.revision, accountId: phoneNote.sourceId, sourceRevision: phoneNote.sourceRevision }

function phoneModel(replies: string[]) {
  const asked: string[] = []
  const cache = new Map<string, unknown>()
  const runtime = {
    useModel: async (_type: unknown, params: { readonly messages?: readonly { readonly content: string }[] }) => {
      asked.push(params.messages?.[0]?.content ?? "")
      return replies.shift() ?? ""
    },
    getCache: async (key: string) => cache.get(key),
    setCache: async (key: string, value: unknown) => {
      cache.set(key, value)
      return true
    },
    logger: { warn: () => undefined },
  } as unknown as IAgentRuntime
  return { runtime, asked }
}

function phoneTurn(runtime: IAgentRuntime, words: string, observation: DeviceTurn["observation"], metadata: Record<string, unknown> = {}, earlier: readonly EarlierRequest[] = [], completesReads = true): DeviceTurn {
  const negotiated = negotiation(true, phoneCapabilities)
  return {
    runtime, by: {} as DeviceTurn["by"], negotiation: negotiated, capabilities: phoneCapabilities.split(","),
    message: { ...owner, id: stringToUuid(words), content: { text: words, metadata: { ...metadata, ...(observation === undefined ? {} : { observation }) } } } as DeviceTurn["message"],
    ownerText: words, observation, completedActionNavigation: false, completesReads, conversationId: "conversation", requestId: "request", assistantName: "Eliza",
    swapped: [], startedAt: start, timeZone: "Etc/UTC", signal: new AbortController().signal,
    admit: (operation) => validate(operation, negotiated, "NoBinding"),
    earlier: () => succeed(earlier),
  }
}

const sharedNote = (title: string, body: string) => ({ version: 1, kind: "notes_read_selected", sourceId: phoneNote.sourceId, noteId: phoneNote.noteId, revision: phoneNote.revision, fields: { title, body } })
const titleFound = (text: string, body: string) => ({ version: 1, kind: "notes_query", query: { kind: "title", text }, basis: "title-match", target: phoneNote, record: sharedNote(text, body) })
const patch = (textEdit: unknown, changes: unknown[] = []) => JSON.stringify({ requiresInput: false, clarification: null, changes, textEdit })
const question = "What should the note say instead?"
const deletedRequestId = stringToUuid("Delete this note")

it.effect('Ask about, delete or change a phone note only as the owner said it (spec/notes/read.md, "Story: Ask about or change a phone note in my own words"; spec/notes/read.md, "A phone Notes operation is offered only where the turn\'s own screen selects the phone\'s Notes"; spec/notes/read.md, "A phone note proposal names only words the owner said and only the note the owner has open"; spec/notes/read.md, "A phone note is edited only from the note the owner shared, in a review of its own"; spec/notes/trash.md, "Story: Delete the phone note I asked to delete"; spec/notes/trash.md, "A phone note a lookup found is offered for deletion only when the model read the request as a deletion"; spec/notes/organize.md, "A proposed folder is one the device sent, or a new name the owner said"; spec/notes/organize.md, "A proposal is reviewed or run only on the unlocked phone in Home or Notes, and recording only in Notes"; spec/notes/organize.md, "Moving, creating a folder or restoring is reviewed first; filtering and recording may run directly")', effect () => {
  const eggs = patch({ action: "append", field: "item", text: "eggs" })
  const model = phoneModel([eggs, eggs, eggs, JSON.stringify({ requiresInput: true, clarification: question, changes: [], textEdit: null })])
  const family = notesDeviceFamily(model.runtime)
  assert.strictEqual(family.app, "notes")
  const home = { view: "home", revision: 1, sensitive: false }
  const opened = { view: "notes", revision: 2, sensitive: false, selectedObject: openPhoneNote }
  const offered = (observation: DeviceTurn["observation"]) => family.forms.filter((form) => { const turn = phoneTurn(model.runtime, "", observation); return form.offered(turn) && (form.now?.available(turn) ?? true) }).flatMap((form) => [...form.types])
  assert.deepEqual({
    home: offered(home),
    opened: offered(opened),
    canonical: offered({ view: "notes", revision: 3, sensitive: false, selectedObject: { kind: "canonical-note", id: "note-1", revision: "1" } }),
    sensitive: offered({ ...opened, sensitive: true }),
    elsewhere: offered({ view: "calendar", revision: 4, sensitive: false }),
    unobserved: offered(undefined),
  }, {
    home: ["notes_query", "notes_search", "notes_named", "notes_named", "notes_filter", "notes_folder_create", "notes_restore"],
    opened: ["notes_query", "notes_search", "notes_named", "notes_named", "notes_read_selected", "notes_update", "notes_delete", "notes_move", "notes_filter", "notes_folder_create", "notes_restore", "notes_record"],
    canonical: ["notes_filter", "notes_folder_create", "notes_restore", "notes_record"],
    sensitive: [],
    elsewhere: [],
    unobserved: ["notes_filter", "notes_folder_create", "notes_restore", "notes_record"],
  })

  const grounding = (words: string, observation: DeviceTurn["observation"], call: unknown, metadata?: Record<string, unknown>, earlier?: readonly EarlierRequest[], completesReads?: boolean) => {
    const turn = phoneTurn(model.runtime, words, observation, metadata, earlier, completesReads)
    const checked = turn.admit(family.prepare?.(call) ?? call)
    assert.isDefined(checked)
    return map(family.ground(checked!, turn, call), (found) => found.kind === "Grounded" ? found.operation : found.code)
  }
  const folders = { notesFolders: [{ id: "f1", name: "Errands" }] }
  const deletedHere: EarlierRequest = { proposalId: "deleted", requestMessageId: deletedRequestId, operation: { type: "notes_delete", target: phoneNote }, result: undefined, settledAt: start }
  const noFields = { title: "", body: "" }
  assert.deepEqual([
    try grounding("Delete my note called Groceries", home, { type: "notes_query", query: { kind: "title", text: "groceries" }, intent: "delete" }),
    try grounding("Find my shopping note", home, { type: "notes_query", query: { kind: "title", text: "Bank passwords" }, intent: "read" }),
    try grounding("Add eggs to my Shopping note", home, { type: "notes_named", action: "update", name: "Shopping", fields: noFields }),
    try grounding("Delete this note", opened, { type: "notes_delete", target: { ...phoneNote, noteId: "note-8" } }),
    try grounding("Add eggs to this note", opened, { type: "notes_update", target: phoneNote, fields: noFields }),
    try grounding("Change this note", opened, { type: "notes_update", target: phoneNote, fields: noFields }),
    try grounding("Add milk to this note", opened, { type: "notes_update", target: phoneNote, fields: noFields }, {}, [], false),
    try grounding("Add milk to my Shopping note", home, { type: "notes_named", action: "update", name: "Shopping", fields: noFields }, {}, [], false),
    try grounding("Add eggs to that other note", opened, { type: "notes_update", target: { ...phoneNote, noteId: "note-8" }, fields: noFields }),
    try grounding("Move this note to errands", opened, { type: "notes_move", target: phoneNote, folder: "errands" }, folders),
    try grounding("Move this note to Work", opened, { type: "notes_move", target: phoneNote, folder: "Work" }, folders),
    try grounding("Make a folder called Recipes", home, { type: "notes_folder_create", name: "Recipes" }),
    try grounding("Make a folder for my taxes", home, { type: "notes_folder_create", name: "Finance" }),
    try grounding("Bring back the note I deleted", home, { type: "notes_restore", noteId: phoneNote.noteId }, {}, [deletedHere]),
    try grounding("Bring back my old note", home, { type: "notes_restore", noteId: "note-9" }, {}, [deletedHere]),
    try grounding("get rid of my latest note", home, { type: "notes_query", query: { kind: "latest", by: "created" }, intent: "delete" }, {}, [], false),
    try grounding("Find my groceries note and add eggs", home, { type: "notes_query", query: { kind: "title", text: "groceries" }, intent: "edit" }, {}, [], false),
    try grounding("What does my groceries note say?", home, { type: "notes_query", query: { kind: "title", text: "groceries" }, intent: "read" }, {}, [], false),
    try grounding("", home, { type: "notes_query", query: { kind: "latest", by: "created" }, intent: "delete" }),
    try grounding("", home, { type: "notes_query", query: { kind: "latest", by: "created" }, intent: "read" }),
  ], [
    { type: "notes_query", query: { kind: "title", text: "groceries" } },
    "NOTES_LOOKUP_NOT_REQUESTED",
    { type: "notes_query", query: { kind: "title", text: "Shopping" } },
    "NOTES_TARGET_NOT_SELECTED",
    { type: "notes_read_selected", target: phoneNote },
    { type: "notes_read_selected", target: phoneNote },
    "NOTES_UPDATE_UNAVAILABLE",
    "NOTES_UPDATE_UNAVAILABLE",
    "NOTES_TARGET_NOT_SELECTED",
    { type: "notes_move", target: phoneNote, folder: "Errands" },
    "NOTES_FOLDER_UNKNOWN",
    { type: "notes_folder_create", name: "Recipes" },
    "NOTES_FOLDER_NOT_REQUESTED",
    { type: "notes_restore", noteId: phoneNote.noteId },
    "NOTES_RESTORE_UNKNOWN",
    "NOTES_DELETE_UNAVAILABLE",
    "NOTES_UPDATE_UNAVAILABLE",
    { type: "notes_query", query: { kind: "title", text: "groceries" } },
    "NOTES_LOOKUP_NOT_REQUESTED",
    { type: "notes_query", query: { kind: "latest", by: "created" } },
  ])
  const erase = { type: "notes_query", query: { kind: "title", text: "groceries" }, intent: "erase" }
  assert.deepEqual([family.prepare?.(erase), phoneTurn(model.runtime, "erase my groceries note", home).admit(family.prepare?.(erase) ?? erase)], [erase, undefined])
  const unkept = { ...model.runtime, setCache: async () => { throw new Error("cache unavailable") } } as unknown as IAgentRuntime
  const unkeptFamily = notesDeviceFamily(unkept)
  const unkeptGrounding = (words: string, call: unknown) => {
    const turn = phoneTurn(unkept, words, home)
    return map(unkeptFamily.ground(turn.admit(unkeptFamily.prepare?.(call) ?? call)!, turn, call), (found) => found.kind === "Grounded" ? found.operation : found.code)
  }
  assert.deepEqual([
    try unkeptGrounding("get rid of my groceries note", { type: "notes_query", query: { kind: "title", text: "groceries" }, intent: "delete" }),
    try unkeptGrounding("pull up my groceries note", { type: "notes_query", query: { kind: "title", text: "groceries" }, intent: "read" }),
  ], ["NOTES_LOOKUP_UNAVAILABLE", { type: "notes_query", query: { kind: "title", text: "groceries" } }])

  const pending = (operation: DeviceOperation, direct: boolean) => family.proposedText(operation, { direct, timeZone: "Etc/UTC", ownerText: "" })?.forOwner
  const handedOff = (operation: DeviceOperation) => pending(operation, true) !== pending(operation, false)
  const waiting: DeviceOperation[] = [{ type: "notes_record", action: "start" }, { type: "notes_filter", kind: "list" }, { type: "notes_delete", target: phoneNote }]
  assert.deepEqual(waiting.map(handedOff), [true, true, false])

  const negotiated = negotiation(true, phoneCapabilities)
  const continued = (words: string, operation: DeviceOperation, result: unknown) => {
    const after = family.continueAfterRead
    assert.isDefined(after)
    const turn = phoneTurn(model.runtime, words, opened)
    return map(after!({ proposalId: "read", requestMessageId: turn.message.id, operation, result, settledAt: start },
      { ownerText: words, message: turn.message, negotiation: negotiated, startedAt: start, timeZone: "Etc/UTC" }),
      (next) => next === undefined ? undefined : {
        operation: next.operation === undefined ? undefined : validate(next.operation, negotiated, "NoBinding")?.operation,
        answers: next.text === question ? "the reading's question" : next.text !== undefined,
      })
  }
  const afterRead = effect (words: string, call: unknown, result: unknown, observation: DeviceTurn["observation"] = home) => {
    const read = try grounding(words, observation, call)
    return typeof read === "string" ? read : try continued(words, read, result)
  }
  const byTitle = (text: string, intent?: string) => ({ type: "notes_query", query: { kind: "title", text }, ...(intent === undefined ? {} : { intent }) })
  const latest = { type: "notes_query", query: { kind: "latest", by: "updated" }, intent: "delete" }
  const deletion = { operation: { type: "notes_delete", target: phoneNote }, answers: true }
  const nothingDeleted = { operation: undefined, answers: true }
  const eggsAdded = { operation: { type: "notes_update", target: phoneNote, fields: { title: "Shopping", body: "- milk\n- eggs" } }, answers: true }
  assert.deepEqual([
    try afterRead("Delete my note called Groceries", byTitle("Groceries", "delete"), titleFound("Groceries", "milk")),
    try afterRead("Delete my note called How to bake bread", byTitle("How to bake bread", "delete"), titleFound("How to bake bread", "flour")),
    try afterRead("get rid of my groceries note", byTitle("groceries", "delete"), titleFound("groceries", "milk")),
    try afterRead("Delete the note I changed last", latest, { version: 1, kind: "notes_query", query: { kind: "latest", by: "updated" }, basis: "owner-choice-uncertain", target: phoneNote, record: sharedNote("Groceries", "milk") }),
    try afterRead("Delete my note called Groceries", byTitle("Groceries", "delete"), { version: 1, kind: "notes_query", query: { kind: "title", text: "Groceries" }, basis: "no-match" }),
    try afterRead("Delete my note called Groceries; why did I keep it?", byTitle("Groceries", "read"), titleFound("Groceries", "milk")),
    try afterRead("Delete the note Groceries, but never mind", byTitle("Groceries", "read"), titleFound("Groceries", "milk")),
    try afterRead("pull up my shopping list", byTitle("shopping list", "read"), titleFound("Shopping list", "- milk")),
    try afterRead("open the note titled shopping list", byTitle("shopping list"), titleFound("Shopping list", "- milk")),
    try afterRead("get rid of the grocery note", byTitle("Groceries", "delete"), titleFound("Groceries", "milk")),
    try afterRead("Find my Shopping note and add eggs", byTitle("Shopping", "edit"), titleFound("Shopping", "- milk")),
    try afterRead("Add eggs to my Shopping note", { type: "notes_named", action: "update", name: "Shopping", fields: { title: "", body: "" } }, titleFound("Shopping", "- milk")),
    try afterRead("Add eggs to this note", { type: "notes_update", target: phoneNote, fields: { title: "", body: "" } }, sharedNote("Shopping", "- milk"), opened),
    try afterRead("Change this note", { type: "notes_update", target: phoneNote, fields: { title: "", body: "" } }, sharedNote("Shopping", "- milk"), opened),
    try afterRead("What does this note say?", { type: "notes_read_selected", target: phoneNote }, sharedNote("Shopping", "- milk"), opened),
  ], [
    deletion,
    deletion,
    deletion,
    nothingDeleted,
    nothingDeleted,
    undefined,
    undefined,
    undefined,
    undefined,
    "NOTES_LOOKUP_NOT_REQUESTED",
    eggsAdded,
    eggsAdded,
    eggsAdded,
    { operation: undefined, answers: "the reading's question" },
    undefined,
  ])
  assert.deepEqual(model.asked, ["Find my Shopping note and add eggs", "Add eggs to my Shopping note", "Add eggs to this note", "Change this note"])
})
