{
  "name": "@elizaos/plugin-notes",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Notes, their folders, Trash and recorded audio custody, changed only on the owner's words.",
  "license": "MIT",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/agent.d.ts",
        "import": "./dist/src/agent.js",
        "default": "./dist/src/agent.js"
      }
    }
  },
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@elizaos/agent": "workspace:*",
    "@elizaos/agent-host": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/plugin-notes-client": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/agent.vibe",
      "types": "./dist/src/agent.d.ts",
      "import": "./dist/src/agent.js",
      "default": "./dist/src/agent.js"
    }
  }
}
