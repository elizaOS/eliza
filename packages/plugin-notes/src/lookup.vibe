// spec/notes/records.md, "The agent reads and changes Notes only for the owner, and changes the note the model picked"
import { authoredNoteText } from "@elizaos/plugin-notes-client"
import { reconstructNoteContent, type StickyNote } from "@elizaos/plugin-notes-client"

module edge {
  /** @throws {never} */
  export function namedPhrase(text: string, phrase: string): boolean {
    if (text === "" || phrase === "") return false
    const escaped = phrase.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
    try {
      return new RegExp(`(?:^|[^\\p{L}\\p{N}\\p{M}])${escaped}(?=$|[^\\p{L}\\p{N}\\p{M}])`, "u").test(text)
    } catch {
      return false
    }
  }
}
import { namedPhrase } from edge

export interface Indexed {
  readonly index: number
  readonly note: StickyNote
}

export type NoteSelector = "title" | "query"

function normalizedLookup(value: string): string {
  return value.normalize("NFC").trim().toLowerCase().normalize("NFC").replace(/\s+/gu, " ")
}

export function sameTitle(title: string, value: string): boolean {
  return normalizedLookup(title) === normalizedLookup(value)
}

export function titleAppearsAsNamedPhrase(text: string, title: string): boolean {
  return namedPhrase(normalizedLookup(text), normalizedLookup(title))
}

function searchable(note: StickyNote): string {
  return `${reconstructNoteContent(note)} ${authoredNoteText(note.format)} ${note.color}`
}

function queryMatches(notes: readonly StickyNote[], value: string): Indexed[] {
  const target = normalizedLookup(value)
  if (target === "") return []
  const indexed = notes.map((note, index) => ({ index, note }))
  const tiers = [
    indexed.filter(({ note }) => normalizedLookup(note.title) === target),
    indexed.filter(({ note }) => titleAppearsAsNamedPhrase(searchable(note), value)),
    indexed.filter(({ note }) => normalizedLookup(searchable(note)).includes(target)),
    indexed.filter(({ note }) => titleAppearsAsNamedPhrase(value, note.title)),
  ]
  return tiers.find((tier) => tier.length > 0) ?? []
}

export function lookupMatches(notes: readonly StickyNote[], selector: NoteSelector, value: string): Indexed[] {
  const target = normalizedLookup(value)
  if (target === "") return []
  return selector === "title"
    ? notes.flatMap((note, index) => normalizedLookup(note.title) === target ? [{ index, note }] : [])
    : queryMatches(notes, value)
}

export function noteContentKey(note: StickyNote): string {
  return [note.format === undefined ? "" : note.id, note.title, note.body, note.color].join("\u0000")
}

export function notesNamedIn(text: string, notes: readonly StickyNote[]): StickyNote[] {
  return text === "" ? [] : notes.filter((note) => titleAppearsAsNamedPhrase(text, note.title))
}
