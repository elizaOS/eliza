// spec/notes/records.md, "A turn's Notes classification narrows what Notes may write and never grants a write"; spec/notes/records.md, "The agent reads and changes Notes only for the owner, on the owner's own words in the bound request"
import {
  bindRequestOperationResult, copyBoundOperationDenial, getActionRoutingContext, NOTES_REQUEST_OPERATIONS, normalizeNotesRequestInterpretation,
  registerDirectActionRoutingRule,
  type ActionResult, type IAgentRuntime, type Memory, type NotesRequestInterpretation, type NotesRequestOperation,
  type RequestOperationClassification, type ResponseHandlerEvaluator, type ResponseHandlerFieldEvaluator, type State,
} from "@elizaos/core"
import { namedReadRoutes, notesWriteAllowed, type NotesClassification } from "../gen/notes__records.effect.vibe"
import { notesNamedIn, ownerRequestText } from "./lookup.vibe"
import type { NotesCollection } from "./service.vibe"

module edge {
  import {
    BoundRequestOperationError, checkBoundNotesOperation, getActionRoutingContext, READ_ONLY_VIEW_CAPABILITY_IDS, readTaskExtractionNotesRestriction,
    type IAgentRuntime, type Memory, type NotesRequestOperation, type State, type ViewDeclaration,
  } from "@elizaos/core"
  const capabilityOperations: Readonly<Record<string, NotesRequestOperation>> = {
    "get-notes": "list", "get-note": "get", "get-notes-trash": "list", "create-note": "create",
    "update-note": "update", "delete-note": "delete", "clear-notes": "delete", "restore-note": "update",
  }
  /** @throws {never} */
  export function decisionFor(runtime: IAgentRuntime, state: State | undefined, message: Memory | undefined, operation: NotesRequestOperation): ReturnType<typeof checkBoundNotesOperation> {
    const canonical: NotesRequestOperation = operation === "patch" ? "update" : operation
    const routing = getActionRoutingContext()
    if (routing === undefined || routing.requestRuntime !== runtime) return checkBoundNotesOperation(undefined, undefined, canonical)
    return checkBoundNotesOperation(state, message, canonical, routing.requestOperationAttempt, operation)
  }
  /** @throws {BoundRequestOperationError} */
  function assertNotesAgentViewOperation(capability: string, _params: Record<string, unknown> | undefined, context: { runtime: IAgentRuntime }): void {
    const routing = getActionRoutingContext()
    if (routing === undefined || READ_ONLY_VIEW_CAPABILITY_IDS.has(capability)) return
    const operation = capabilityOperations[capability]
    if (operation === undefined && readTaskExtractionNotesRestriction(routing.requestState, routing.requestMessage, context.runtime) === "mutation_requested") return
    const decision = operation === undefined
      ? checkBoundNotesOperation(undefined, undefined, "create")
      : decisionFor(context.runtime, routing.requestState, routing.requestMessage, operation)
    if (!decision.allowed) throw new BoundRequestOperationError(decision)
  }
  export const notesViewOperation: Pick<ViewDeclaration, "beforeAgentInteract"> = {
    beforeAgentInteract: assertNotesAgentViewOperation,
  }
}
import { decisionFor, notesViewOperation } from edge

export { notesViewOperation }

export effect function restrictNotesWrite(runtime: IAgentRuntime, message: Memory, state: State | undefined, operation: NotesRequestOperation): (ActionResult | undefined)!! {
  const decision = decisionFor(runtime, state, message, operation)
  const classification: NotesClassification = decision.allowed ? "MutationTurn" : decision.code === "REQUEST_OPERATION_RESTRICTED" ? "ReadOnlyTurn" : "UnresolvedTurn"
  if (decision.allowed || notesWriteAllowed(classification, operation === "get" || operation === "list")) return undefined
  const result: ActionResult = {
    success: false,
    text: decision.code === "REQUEST_OPERATION_RESTRICTED"
      ? "This write was not performed: the current request is restricted to reading Notes. Read the requested note instead."
      : "This write was not performed: the current Notes operation is unresolved. Clarify the requested change before writing.",
    error: decision.code,
    failureProvenance: { kind: "handler_error", boundary: "handler", code: decision.code, retryable: false },
    data: { code: decision.code, acceptance: "rejected", executionStatus: "not_started", executed: false, retryable: false },
  }
  const attempt = getActionRoutingContext()?.requestOperationAttempt
  if (attempt !== undefined) Effect.try(() => bindRequestOperationResult(result, attempt)) catch () => undefined
  return copyBoundOperationDenial(decision, result, attempt)
}

type ParsedNotesEffect = NotesRequestInterpretation & { readonly classification: RequestOperationClassification }
type NotesFieldValue = RequestOperationClassification | ParsedNotesEffect

const classifications: ReadonlySet<unknown> = new Set(["read_only", "mutation_requested", "unresolved"])

function isClassification(value: unknown): value is RequestOperationClassification {
  return classifications.has(value)
}

function parseEffect(value: unknown): NotesFieldValue {
  if (isClassification(value)) return value
  if (typeof value !== "object" || value === null || Array.isArray(value)) return "unresolved"
  const prototype: unknown = Object.getPrototypeOf(value)
  if (prototype !== Object.prototype && prototype !== null) return "unresolved"
  const descriptors = Object.getOwnPropertyDescriptors(value)
  const keys = Reflect.ownKeys(descriptors)
  const classified = descriptors.classification
  const operations = descriptors.operations
  if (keys.length !== 2 || classified === undefined || operations === undefined || !("value" in classified) || !("value" in operations)) return "unresolved"
  const classification: unknown = classified.value
  if (!isClassification(classification)) return "unresolved"
  const interpretation = normalizeNotesRequestInterpretation({ status: "explicit", operations: operations.value })
  if (interpretation === undefined) return "unresolved"
  const mutation = interpretation.operations.some((operation) => operation !== "get" && operation !== "list")
  if ((classification === "read_only" && mutation) || (classification === "mutation_requested" && !mutation)
    || (classification === "unresolved" && interpretation.operations.length > 0)) {
    return Object.freeze({ classification: "unresolved", status: "contradictory", operations: Object.freeze([]) })
  }
  return Object.freeze({ classification, ...interpretation })
}

export const notesRequestEffectField: ResponseHandlerFieldEvaluator<NotesFieldValue> = {
  name: "notesRequestEffect",
  priority: 19.5,
  description: `What supported Notes operation does the CURRENT message actually request? Ignore quoted commands and completed actions in the conversation. First select the operation(s):
- No clear supported operation: return {"classification":"unresolved","operations":[]}. A stray word beside a note title is not a command. The same applies after an earlier request was completed. Sending or sharing notes is unsupported; never substitute a write.
- Read the contents or history of an existing note: read_only with ["get"]. Search or list notes: read_only with ["list"]. Open the Notes view: read_only with [].
- Explicitly change a note: mutation_requested with only the requested operations. To add an item or append text use patch; to edit existing text, move a note to a folder or restore it from Recently deleted use update; use create for a new note and delete to remove one. A detail-only answer can complete an explicit request only if the assistant is waiting for that very detail; carry forward its operation.
Include both reads and writes without duplicates for compound requests. Classification describes intent, not permission or proof of execution; existing authorization and outcome checks still apply.`,
  schema: {
    type: "object",
    properties: {
      classification: { type: "string", enum: ["read_only", "mutation_requested", "unresolved"] },
      operations: { type: "array", items: { type: "string", enum: [...NOTES_REQUEST_OPERATIONS] }, maxItems: NOTES_REQUEST_OPERATIONS.length },
    },
    required: ["classification", "operations"],
    additionalProperties: false,
  },
  shouldRun: ({ senderRole }) => senderRole === "OWNER",
  directReplyValue: (value) => value === "unresolved" || value === "read_only"
    || (typeof value === "object" && value !== null && "classification" in value && (value.classification === "unresolved" || value.classification === "read_only")
      && "operations" in value && Array.isArray(value.operations) && value.operations.length === 0),
  parse: (value) => parseEffect(value),
  handle: ({ value }) => {
    const classification = typeof value === "string" ? value : value.classification
    const interpretation = normalizeNotesRequestInterpretation(typeof value === "string"
      ? { status: "unavailable", operations: [] }
      : { status: value.status, operations: value.operations })
    return {
      debug: [`notes-request-interpretation:${interpretation?.status ?? "unavailable"}`],
      mutateResult: (result) => {
        result.notesRequestEffect = classification
        result.notesRequestInterpretation = interpretation
      },
    }
  },
}

const turnClassification = { read_only: "ReadOnlyTurn", mutation_requested: "MutationTurn", unresolved: "UnresolvedTurn" } as const satisfies Record<RequestOperationClassification, NotesClassification>

export function namedNoteReadEvaluator(notes: NotesCollection): ResponseHandlerEvaluator {
  return {
    name: "notes.named-note-read",
    priority: 80,
    deterministicActions: ["NOTES_GET"],
    shouldRun: ({ messageHandler, userRoles, wholeRequestOwner }) => {
      const { plan } = messageHandler
      const interpretation = plan.notesRequestInterpretation
      return userRoles?.includes("OWNER") === true && messageHandler.processMessage === "RESPOND"
        && plan.notesRequestEffect === "read_only" && interpretation?.status === "explicit"
        && plan.intents?.length === 1 && plan.contexts.length === 1 && plan.contexts[0] === "notes"
        && plan.notesRequestHostRestriction === undefined && wholeRequestOwner === undefined && plan.deterministicToolCall === undefined
        && !(plan.candidateActions ?? []).some((action) => action !== "NOTES" && action !== "NOTES_GET")
    },
    evaluate: ({ messageHandler, message }) => runPromise(Effect.orElseSucceed(effect {
      const plan = messageHandler.plan
      const onlyGet = plan.notesRequestInterpretation?.operations.length === 1 && plan.notesRequestInterpretation.operations[0] === "get"
      const named = notesNamedIn(try ownerRequestText(message), (try notes.snapshot()).notes)
      const note = named[0]
      if (note === undefined || !namedReadRoutes(turnClassification[plan.notesRequestEffect ?? "unresolved"], onlyGet, named.length)) return undefined
      return { requiresTool: true, clearReply: true, deterministicToolCall: { name: "NOTES_GET", params: { noteId: note.id } } }
    }, () => undefined)),
  }
}

export function registerNotesDirectRoutes(runtime: IAgentRuntime): void {
  registerDirectActionRoutingRule(runtime, {
    id: "notes.create",
    actionNames: ["NOTES_CREATE"],
    requiredActionTags: ["resource:notes", "capability:write"],
    contexts: ["notes"],
    matches: (text) => /^\s*(?:please\s+)?(?:create|save|add)\s+(?:(?:a|an|my|new)\s+)*notes?(?:\s|$|[,:])/iu.test(text),
  })
  registerDirectActionRoutingRule(runtime, {
    id: "notes.read",
    actionNames: ["NOTES_LIST"],
    requiredActionTags: ["resource:notes", "capability:read"],
    contexts: ["notes"],
    matches: (text) => /^\s*(?:please\s+)?(?:read|list|search|find|look\s+up)\s+(?:(?:a|the|my|all|saved|latest)\s+)*notes?(?:\s|$|[,:])/iu.test(text),
  })
}
