// spec/notes/records.md, "Story: Keep my notes as one collection the agent edits only as I asked"; spec/notes/records.md, "A calendar draft made from a note is admitted only while that exact note is unchanged"; spec/notes/records.md, "Story: Keep the notes I saved before this version"; spec/notes/trash.md, "Story: Recover a deleted note"; spec/notes/trash.md, "Story: Let deleted notes expire after three days when I choose that"; spec/notes/trash.md, "A recording's cleanup is acknowledged only with the device's proof that the audio is gone"; spec/notes/trash.md, "The proof of erase comes from the service's own verifier, else the host's verifier found when the cleanup is acknowledged, and only a literal true is proof"
import { Service, type IAgentRuntime, type ServiceClass } from "@elizaos/core"
import { sourceStillExact } from "../gen/notes__records.effect.vibe"
import { cleanupVerifier, mayAcknowledgeCleanup, verifierProvedErase, type VerifierAnswer } from "../gen/notes__trash.effect.vibe"
import {
  acknowledgeIn, clearIn, createIn, deleteIn, eraseIn, listIn, moveIn, NotesRefused, restoreIn, sameCleanup, updateIn,
  type Instant, type NoteTarget, type NotesQuery,
} from "./collection.vibe"
import { CleanupReceipt, CreateRequest, RestoreRequest, Revision, TrashErase, UpdateRequest } from "./records.schema.vibe"
import type { PriorDocumentText } from "./prior.vibe"
import { cacheStorage, notesStore, NotesUnavailable, type Committed, type NotesStorage } from "./store.vibe"
import type { NotesSnapshot, NotesTrashRecordingCleanup, StickyNote } from "./types.vibe"

module edge {
  import { createHash, randomUUID } from "node:crypto"
  import { readFile } from "node:fs/promises"
  import { join } from "node:path"
  import { Cause, Effect, Exit } from "effect"
  /** @throws {never} */
  export function sourceHash(parts: readonly string[]): string {
    return createHash("sha256").update(JSON.stringify(parts)).digest("hex")
  }
  /** @throws {never} */
  export function priorNotesFile(stateDirectory: string, agentId: string): string | undefined {
    return /^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$/.test(agentId) ? join(stateDirectory, "notes", "agents", agentId, "state.json") : undefined
  }
  /** @throws {never} */
  export async function readPriorNotes(file: string): Promise<{ raw: string; digest: string } | undefined> {
    let raw: string
    try {
      raw = await readFile(file, "utf8")
    } catch (error) {
      if (typeof error === "object" && error !== null && "code" in error && error.code === "ENOENT") return undefined
      throw error
    }
    return { raw, digest: createHash("sha256").update(raw).digest("hex") }
  }
  /** @throws {never} */
  export function newUuid(): string {
    return randomUUID()
  }
  /** @throws {never} */
  export function isoOf(ms: number): string | undefined {
    const at = new Date(ms)
    return Number.isNaN(at.getTime()) ? undefined : at.toISOString()
  }
  /** @throws {never} */
  export async function run<A, E>(program: Effect.Effect<A, E>): Promise<A> {
    const exit = await Effect.runPromiseExit(program)
    if (Exit.isSuccess(exit)) return exit.value
    throw Cause.squash(exit.cause)
  }
}
import { isoOf, newUuid, priorNotesFile, readPriorNotes, run, sourceHash } from edge

const notesServiceType = "notes"

const notesRecordingCleanupVerifierServiceType = "notes-recording-cleanup-verifier"

const notesTrashRetentionSetting = "ELIZA_NOTES_TRASH_RETENTION_DAYS"

export const notesStateUpdatedEvent = "notes:state-updated"

interface NotesRecordingCleanupVerifier {
  verifyRecordingCleanup(receipt: NotesTrashRecordingCleanup, signal?: AbortSignal): Promise<boolean>
}

export type VerifyRecordingCleanup = (receipt: NotesTrashRecordingCleanup, signal?: AbortSignal) => Promise<unknown>

export interface NoteSourceReference {
  readonly agentId: string
  readonly noteId: string
  readonly contentHash: string
}

export interface NotesHost {
  readonly agentId: string
  readonly storage: NotesStorage
  readonly prior?: { read(): Promise<PriorDocumentText | undefined> }
  readonly now: number!!
  readonly threeDayTrash: boolean
  newNoteId(): string
  newOperationId(): string
  readonly verifyRecordingCleanup?: VerifyRecordingCleanup
  registeredVerifier(): VerifyRecordingCleanup | undefined
  published?(snapshot: NotesSnapshot, mutation: string): void
}

export type NotesFailure = NotesRefused | NotesUnavailable

export interface NotesCollection {
  readonly threeDayTrash: boolean
  snapshot(): NotesSnapshot!NotesFailure
  list(query: NotesQuery): { notes: StickyNote[]; revision: number }!NotesFailure
  create(input: unknown): Committed<{ note: StickyNote; replayed: boolean }>!NotesFailure
  update(target: NoteTarget, patch: unknown, expectedRevision?: unknown, ownerWords?: string): Committed<StickyNote>!NotesFailure
  delete(target: NoteTarget, ownerWords?: string): Committed<StickyNote>!NotesFailure
  restore(input: unknown): Committed<StickyNote>!NotesFailure
  clear(expectedRevision: unknown): Committed<number>!NotesFailure
  move(target: NoteTarget, folderId: string | null): Committed<StickyNote>!NotesFailure
  eraseTrash(input: unknown): Committed<{ erased: number; recordingCleanup: NotesTrashRecordingCleanup[] }>!NotesFailure
  readTrashRecordingCleanup(): NotesTrashRecordingCleanup[]!NotesFailure
  acknowledgeTrashRecordingCleanup(input: unknown, signal?: AbortSignal): boolean!NotesFailure
  sourceReference(note: StickyNote): NoteSourceReference
  assertSourceReference(reference: unknown): void!NotesRefused
}

const invalid = (field: string) => new NotesRefused({ code: "NOTES_VALIDATION_FAILED", message: `The Notes request has an invalid ${field}.` })

const options = { onExcessProperty: "error" } as const
const createRequest = Schema.decodeUnknownEffect(CreateRequest, options)
const updateRequest = Schema.decodeUnknownEffect(UpdateRequest, options)
const restoreRequest = Schema.decodeUnknownEffect(RestoreRequest, options)
const eraseRequest = Schema.decodeUnknownEffect(TrashErase, options)
const cleanupReceipt = Schema.decodeUnknownEffect(CleanupReceipt, options)
const revisionValue = Schema.decodeUnknownEffect(Revision)
const sourceReferenceOf = Schema.decodeUnknownEffect(Schema.Struct({ agentId: Schema.String, noteId: Schema.String, contentHash: Schema.String }), options)

effect function optionalRevision(value: unknown): (number | undefined)!NotesRefused {
  return value === undefined ? undefined : try mapError(revisionValue(value), () => invalid("expectedRevision"))
}

export function notesCollection(host: NotesHost): NotesCollection {
  effect function at(): Instant!NotesUnavailable {
    const ms = try host.now
    const iso = isoOf(ms)
    if (iso === undefined) throw new NotesUnavailable({ code: "NOTES_STORE_UNAVAILABLE", reason: "The clock is out of range." })
    return { ms, iso }
  }

  const prior = host.prior
  const store = notesStore(host.storage, prior === undefined ? undefined : { read: () => prior.read(), at: map(at(), (now) => now.iso) })

  function sourceReference(note: StickyNote): NoteSourceReference {
    return { agentId: host.agentId, noteId: note.id, contentHash: sourceHash([host.agentId, note.id, note.title, note.body]) }
  }

  effect function assertSourceReference(input: unknown): void!NotesRefused {
    const conflict = new NotesRefused({ code: "CALENDAR_NOTE_SOURCE_CONFLICT", message: "The source note changed or is unavailable. Read it again and reconcile the calendar draft before creating the event." })
    const reference = try mapError(sourceReferenceOf(input), () => conflict)
    const document = store.read() catch () => undefined
    const note = document?.notes.find((candidate) => candidate.id === reference.noteId)
    const exact = sourceStillExact(document !== undefined, note !== undefined, reference.agentId === host.agentId,
      note !== undefined && sourceReference(note).contentHash === reference.contentHash)
    if (!exact) throw conflict
  }

  effect function published<A>(committed: Committed<A>): Committed<A>!! {
    if (committed.changed && host.published !== undefined) {
      const publish = host.published
      Effect.try(() => publish(committed.snapshot, committed.mutation)) catch () => undefined
    }
    return committed
  }

  effect function requireRetention(): void!NotesRefused {
    if (!host.threeDayTrash) throw new NotesRefused({ code: "NOTES_TRASH_RETENTION_DISABLED", message: "Permanent Notes Trash erase is disabled for this host." })
  }

  effect function snapshot(): NotesSnapshot!NotesFailure {
    if (!host.threeDayTrash) {
      const document = try store.read()
      return { notes: document.notes, revision: document.revision, trash: document.trash }
    }
    const now = try at()
    return (try published(try store.transact((document) => eraseIn(document, undefined, now, true, host.newOperationId),
      (value) => value.recordingCleanup.length > 0))).snapshot
  }

  effect function verifierAnswer(verify: VerifyRecordingCleanup | undefined, receipt: NotesTrashRecordingCleanup, signal?: AbortSignal): VerifierAnswer!! {
    if (verify === undefined) return "AnswerFailed"
    const answer = tryPromise(() => verify(receipt, signal)) catch () => "failed" as const
    return answer === true ? "AnsweredTrue" : answer === "failed" ? "AnswerFailed" : "AnsweredOther"
  }

  effect function acknowledge(input: unknown, signal?: AbortSignal): boolean!NotesFailure {
    try requireRetention()
    const receipt = try mapError(cleanupReceipt(input), () => invalid("recording cleanup receipt"))
    const pending = (try store.read()).recordingCleanup.some((entry) => sameCleanup(entry, receipt))
    if (!pending) return false
    const own = host.verifyRecordingCleanup
    const registered = own === undefined ? host.registeredVerifier() : undefined
    const source = cleanupVerifier(own !== undefined, registered !== undefined)
    const verify = source === "OwnVerifier" ? own : source === "HostVerifier" ? registered : undefined
    const proved = verifierProvedErase(source, try verifierAnswer(verify, receipt, signal))
    if (!mayAcknowledgeCleanup(try store.ready(), true, true, pending, proved)) {
      throw new NotesRefused({ code: "NOTES_TRASH_RECORDING_UNAVAILABLE", message: "The device has not confirmed recording erase." })
    }
    return (try published(try store.transact((document) => acknowledgeIn(document, receipt)))).value
  }

  return {
    threeDayTrash: host.threeDayTrash,
    snapshot,
    list: (query) => effect {
      const current = try snapshot()
      return { notes: try listIn(current.notes, query), revision: current.revision }
    },
    create: (input) => effect {
      const request = try mapError(createRequest(input), () => invalid("creation"))
      const now = try at()
      const id = host.newNoteId()
      return try published(try store.transact((document) => createIn(document, request, id, now)))
    },
    update: (target, patch, expectedRevision, ownerWords) => effect {
      const request = try mapError(updateRequest(patch), () => invalid("edit"))
      const revision = try optionalRevision(expectedRevision)
      const now = try at()
      return try published(try store.transact((document) => updateIn(document, target, request, revision, now, ownerWords)))
    },
    delete: (target, ownerWords) => effect {
      const now = try at()
      return try published(try store.transact((document) => deleteIn(document, target, now, ownerWords)))
    },
    restore: (input) => effect {
      const request = try mapError(restoreRequest(input), () => invalid("restore"))
      const now = try at()
      return try published(try store.transact((document) => restoreIn(document, request, now, host.threeDayTrash)))
    },
    clear: (expectedRevision) => effect {
      const revision = try optionalRevision(expectedRevision)
      const now = try at()
      return try published(try store.transact((document) => clearIn(document, revision, now)))
    },
    move: (target, folderId) => effect {
      const now = try at()
      return try published(try store.transact((document) => moveIn(document, target, folderId, now)))
    },
    eraseTrash: (input) => effect {
      try requireRetention()
      const review = try mapError(eraseRequest(input), () => invalid("Trash erase"))
      const now = try at()
      return try published(try store.transact((document) => eraseIn(document, review, now, true, host.newOperationId),
        (value) => value.recordingCleanup.length > 0))
    },
    readTrashRecordingCleanup: () => effect {
      try requireRetention()
      return (try store.read()).recordingCleanup
    },
    acknowledgeTrashRecordingCleanup: acknowledge,
    sourceReference,
    assertSourceReference,
  }
}

function isVerifier(value: unknown): value is NotesRecordingCleanupVerifier {
  return typeof value === "object" && value !== null && "verifyRecordingCleanup" in value && typeof value.verifyRecordingCleanup === "function"
}

export interface NotesOptions {
  readonly stateDirectory?: string
  readonly verifyRecordingCleanup?: VerifyRecordingCleanup
  readonly publish?: (snapshot: NotesSnapshot, mutation: string) => void
}

export function runtimeNotesHost(runtime: IAgentRuntime, options: NotesOptions = {}): NotesHost {
  const retention = runtime.getSetting(notesTrashRetentionSetting)
  const agentId = String(runtime.agentId)
  const priorFile = options.stateDirectory === undefined ? undefined : priorNotesFile(options.stateDirectory, agentId)
  return {
    agentId,
    storage: cacheStorage(runtime),
    ...(priorFile === undefined ? {} : { prior: { read: () => readPriorNotes(priorFile) } }),
    now: Clock.currentTimeMillis,
    threeDayTrash: retention === "3" || retention === 3,
    newNoteId: () => `note-${newUuid()}`,
    newOperationId: newUuid,
    ...(options.verifyRecordingCleanup === undefined ? {} : { verifyRecordingCleanup: options.verifyRecordingCleanup }),
    registeredVerifier: () => {
      const found: unknown = runtime.getService(notesRecordingCleanupVerifierServiceType)
      return isVerifier(found) ? (receipt, signal) => found.verifyRecordingCleanup(receipt, signal) : undefined
    },
    ...(options.publish === undefined ? {} : { published: options.publish }),
  }
}

export function notesServiceClass(notes: NotesCollection): ServiceClass {
  return class NotesService extends Service {
    static override serviceType = notesServiceType
    override capabilityDescription = "The owner's durable Notes: saved notes, Trash and recording cleanup"
    readonly notes: NotesCollection = notes

    static override start(runtime: IAgentRuntime): Promise<Service> {
      return Promise.resolve(new NotesService(runtime))
    }

    snapshot(): Promise<NotesSnapshot> {
      return run(notes.snapshot())
    }

    acknowledgeTrashRecordingCleanup(receipt: unknown, signal?: AbortSignal): Promise<boolean> {
      return run(notes.acknowledgeTrashRecordingCleanup(receipt, signal))
    }

    sourceReference(note: StickyNote): NoteSourceReference {
      return notes.sourceReference(note)
    }

    assertSourceReference(reference: unknown): Promise<void> {
      return run(notes.assertSourceReference(reference))
    }

    override stop(): Promise<void> {
      return Promise.resolve()
    }
  }
}
