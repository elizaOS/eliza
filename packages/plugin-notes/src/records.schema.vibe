// spec/notes/records.md, "A creation the client names is made once, and every record is one bounded note"; spec/notes/records.md, "A checklist the owner asks for is a new note holding the owner's items"; spec/notes/trash.md, "Canonical Trash restores the exact deleted ID against the current revision"; spec/notes/trash.md, "Fresh Notes references and the exact audio operation receipt govern cleanup"
import { SchemaGetter } from "effect"
import { authoredNoteText, parseNoteFormat } from "./format.vibe"
import { STICKY_COLORS, type NoteFormat } from "./types.vibe"

export const noteIdPattern = /^(?:[a-z][a-z0-9-]{2,127}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$/

export const recordingIdPattern = /^[A-Za-z0-9_-]{1,100}$/

export const noteLimits = { title: 240, body: 20_001, content: 20_241, trash: 10_000, cleanup: 10_000, creationId: 200 } as const

export const NoteId = Schema.String.check(Schema.isPattern(noteIdPattern))

export const Instant = Schema.String.check(Schema.isPattern(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{3})?Z$/))

export const Revision = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))

export const Color = Schema.Literals(STICKY_COLORS)

const FormatText = Schema.String.check(Schema.isMaxLength(128))
const FormatSeed = Schema.Struct({
  kind: Schema.Literals(["text", "list", "voice", "link"]),
  folderId: Schema.optionalKey(FormatText),
  title: FormatText,
  entries: Schema.Array(Schema.Struct({ t: FormatText, done: Schema.Boolean })).check(Schema.isMaxLength(8)),
})

function sampledFormat({ kind, folderId, title, entries }: typeof FormatSeed.Type): NoteFormat {
  const data = {
    text: {},
    list: { items: entries.map(({ t, done }) => ({ t, done })) },
    voice: { lines: entries.map(({ t }) => ({ s: "speaker", t })), summary: [title], actions: entries.map(({ t, done }) => ({ t, done })) },
    link: { clips: [title, ...entries.map(({ t }) => t)] },
  } satisfies Record<NoteFormat["kind"], NoteFormat["data"]>
  return { kind, data: { ...data[kind], ...(folderId === undefined ? {} : { folderId }) } }
}

export const Format = Schema.declare((value: unknown): value is NoteFormat => parseNoteFormat(value) !== undefined, {
  toCodecArbitrary: () => Schema.link<NoteFormat>()(FormatSeed, { decode: SchemaGetter.transform(sampledFormat), encode: SchemaGetter.forbiddenEncoding }),
})

function sampled<Wire extends Schema.Constraint, Seed extends Schema.Constraint>(wire: Wire, seed: Seed, build: (value: Seed["Type"]) => Wire["Type"]) {
  const domain = Schema.declare(Schema.is(Schema.toType(wire)), {
    toCodecArbitrary: () => Schema.link<Wire["Type"]>()(seed, { decode: SchemaGetter.transform(build), encode: SchemaGetter.forbiddenEncoding }),
  })
  return Schema.decodeTo(domain)(wire)
}

const NoteWire = Schema.Struct({
  id: NoteId,
  title: Schema.String.check(Schema.isMaxLength(noteLimits.title)),
  body: Schema.String.check(Schema.isMaxLength(noteLimits.body)),
  color: Color,
  format: Schema.optionalKey(Format),
  createdAt: Instant,
  updatedAt: Instant,
}).check(Schema.makeFilter((note) => (note.title + note.body).trim() !== "" || authoredNoteText(note.format).trim() !== ""))

const NoteSeed = Schema.Struct({
  ...NoteWire.fields,
  title: FormatText,
  body: FormatText,
  contentIn: Schema.Literals(["title", "body", "format"]),
  words: FormatText.check(Schema.isPattern(/\S/)),
})

export const NoteRow = sampled(NoteWire, NoteSeed, ({ contentIn, words, ...note }): typeof NoteWire.Type => {
  if (contentIn === "title") return { ...note, title: words }
  if (contentIn === "body") return { ...note, body: words }
  return { ...note, title: "", body: "", format: { kind: "list", data: { items: [{ t: words, done: false }] } } }
})

export const TrashRow = Schema.Struct({ note: NoteRow, deletedAt: Instant })

export const CleanupReceipt = Schema.Struct({
  operationId: Schema.String.check(Schema.isPattern(/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/)),
  noteId: NoteId.check(Schema.isPattern(recordingIdPattern)),
  audioId: Schema.String.check(Schema.isPattern(recordingIdPattern)),
  deletedAt: Instant,
})

export const TrashErase = Schema.Union([
  Schema.Struct({ scope: Schema.Literal("all"), expectedRevision: Revision }),
  Schema.Struct({ scope: Schema.Literal("entry"), expectedRevision: Revision, id: NoteId, deletedAt: Instant }),
])

export const RestoreRequest = Schema.Struct({ id: NoteId, expectedRevision: Revision, deletedAt: Schema.optionalKey(Instant) })

export const ImportReceipt = Schema.Struct({
  source: Schema.Literal("notes-state"),
  schemaVersion: Schema.Literals([1, 2, 3]),
  sourceRevision: Revision,
  sourceDigest: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/)),
  notes: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
  trash: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
  importedAt: Instant,
})

const CreationKey = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(noteLimits.creationId))
const DocumentWire = Schema.Struct({
  schemaVersion: Schema.Literal(1),
  revision: Revision,
  notes: Schema.Array(NoteRow),
  trash: Schema.Array(TrashRow).check(Schema.isMaxLength(noteLimits.trash)),
  creations: Schema.Record(CreationKey, NoteId),
  recordingCleanup: Schema.Array(CleanupReceipt).check(Schema.isMaxLength(noteLimits.cleanup)),
  imported: Schema.optionalKey(ImportReceipt),
}).check(Schema.makeFilter((document) => {
  const ids = [...document.notes.map((note) => note.id), ...document.trash.map((entry) => entry.note.id)]
  const known = new Set(ids)
  return known.size === ids.length && Object.values(document.creations).every((id) => known.has(id))
}))

const DocumentSeed = Schema.Struct({
  ...DocumentWire.fields,
  notes: Schema.Array(NoteRow).check(Schema.isMaxLength(4)),
  trash: Schema.Array(TrashRow).check(Schema.isMaxLength(4)),
  creations: Schema.Array(CreationKey).check(Schema.isMaxLength(8)),
  recordingCleanup: Schema.Array(CleanupReceipt).check(Schema.isMaxLength(4)),
})

export const StoredDocument = sampled(DocumentWire, DocumentSeed, ({ notes, trash, creations, ...document }) => {
  const saved = notes.map((note, index) => ({ ...note, id: `note-${index}` }))
  const deleted = trash.map((row, index) => ({ ...row, note: { ...row.note, id: `trash-${index}` } }))
  const ids = [...saved.map((note) => note.id), ...deleted.map((row) => row.note.id)]
  const references = ids.length === 0 ? {} : Object.fromEntries(creations.map((key, index) => [key, ids[index % ids.length]]))
  return { ...document, notes: saved, trash: deleted, creations: references }
})

const NoteDraftFields = {
  content: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(noteLimits.content))),
  title: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(noteLimits.title))),
  body: Schema.optionalKey(Schema.String.check(Schema.isMaxLength(noteLimits.body - 1))),
  format: Schema.optionalKey(Format),
  color: Schema.optionalKey(Color),
}

export const CreateRequest = Schema.Struct({
  ...NoteDraftFields,
  checklist: Schema.optionalKey(Schema.Array(Schema.String.check(Schema.isMaxLength(noteLimits.body)))),
  forceNew: Schema.optionalKey(Schema.Boolean),
  creationId: Schema.optionalKey(Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(noteLimits.creationId))),
})

const TextReplace = Schema.Struct({
  action: Schema.optionalKey(Schema.Literal("replace")),
  field: Schema.Literals(["title", "body"]),
  oldText: Schema.String.check(Schema.isMinLength(1)),
  newText: Schema.String,
})
const TextAppend = Schema.Struct({
  action: Schema.Literal("append"),
  field: Schema.Literals(["body", "item"]),
  text: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(noteLimits.body)),
})
const AuthoredReplace = Schema.Struct({
  action: Schema.optionalKey(Schema.Literal("replace")),
  field: Schema.Literals(["checklist", "voice-line", "voice-summary", "voice-action", "link-clip"]),
  index: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
  expectedText: Schema.String,
  text: Schema.optionalKey(Schema.String),
  done: Schema.optionalKey(Schema.Boolean),
})
const AuthoredAppend = Schema.Struct({
  action: Schema.Literal("append"),
  field: Schema.Literal("checklist"),
  text: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(noteLimits.body)),
})

export const UpdateRequest = Schema.Struct({
  textEdit: Schema.optionalKey(Schema.Union([TextReplace, TextAppend])),
  authoredEdit: Schema.optionalKey(Schema.Union([AuthoredReplace, AuthoredAppend])),
  ...NoteDraftFields,
})

export type ImportReceipt = typeof ImportReceipt.Type
export type StoredDocument = typeof StoredDocument.Type
export type CreateRequest = typeof CreateRequest.Type
export type UpdateRequest = typeof UpdateRequest.Type
