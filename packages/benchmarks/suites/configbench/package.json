{
  "name": "@elizaos/configbench",
  "private": true,
  "version": "2.0.0-beta.0",
  "type": "module",
  "description": "Configuration & Secrets Security Benchmark for @elizaos/plugin-assistant secrets and built-in plugin-manager",
  "scripts": {
    "bench": "bun run src/index.ts",
    "bench:eliza": "bun run src/index.ts --eliza",
    "bench:all": "bun run src/index.ts --eliza --all",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint:check && bun run format:check"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/plugin-anthropic": "workspace:*",
    "@elizaos/plugin-groq": "beta",
    "@elizaos/plugin-openai": "workspace:*",
    "@elizaos/plugin-sqlite": "workspace:*",
    "@elizaos/plugin-assistant": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "bun-types": "1.4.2",
    "vitest": "4.1.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3"
  }
}
