{
  "name": "@elizaos/lifeops-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LifeOpsBench server-side harness: HTTP bench server, LifeOps fake backend, Cerebras autowirer, and bench plugin driven by the Python runners in suites/. Runs against an elizaOS checkout (ELIZA_REPO_DIR); never published.",
  "main": "./src/server.ts",
  "scripts": {
    "benchmark:server": "node --conditions=eliza-source --conditions=development --import tsx src/server.ts",
    "trusted-runtime:server": "node --conditions=eliza-source --conditions=development --import tsx src/trusted-runtime-server.ts",
    "normalize-capture": "node --import tsx scripts/normalize-eliza-capture.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun run typecheck"
  },
  "dependencies": {
    "@elizaos/agent": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/plugin-agent-orchestrator": "workspace:*",
    "@elizaos/plugin-calendar": "workspace:*",
    "@elizaos/plugin-groq": "beta",
    "@elizaos/plugin-local-inference": "workspace:*",
    "@elizaos/plugin-personal-assistant": "workspace:*",
    "@elizaos/plugin-sql": "workspace:*",
    "@elizaos/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "tsx": "^4.21.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
