{
  "name": "@elizaos/lifeops-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LifeOps simulated backend and HTTP task contract for the shared Eliza benchmark host.",
  "main": "./src/index.ts",
