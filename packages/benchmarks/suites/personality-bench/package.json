{
  "name": "@elizaos/personality-bench",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Layered judge (regex + LLM cross-check + embedding fallback) for the personality benchmark scenarios authored under W3-2.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "elizaos": {
    "scripts": {
      "testLanes": [
        "server"
      ]
    }
  },
  "scripts": {
    "grade": "bun run src/runner.ts",
    "test": "bun x vitest run && bun run scenarios:validate",
    "test:watch": "bun x vitest",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "typecheck": "tsc --noEmit",
    "scenarios:validate": "bun --conditions=eliza-source ../../../testing/scenario-runner/src/cli.ts list scenarios --validate-scenarios"
  },
  "dependencies": {
    "@elizaos/testing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "bun-types": "1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  }
}
