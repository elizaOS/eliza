{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "customConditions": ["eliza-source", "development"],
    "jsx": "react-jsx",
    "paths": {
      "@elizaos/app/api/auth": ["../../../../app/src/api/auth.ts"],
      "@elizaos/app/api/compat-route-shared": [
        "../../../../app/src/api/compat-route-shared.ts"
      ],
      "@elizaos/app/services/task-host-capabilities": [
        "../../../../app/src/services/task-host-capabilities.ts"
      ],
      "@elizaos/plugin-pdf": ["../../../../../plugins/plugin-pdf/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
