{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "bun-types"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["eliza-source"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@elizaos/plugin-browser": ["../../plugins/plugin-browser/src/index.ts"],
      "@elizaos/core": ["../../packages/core/src/index.ts"],
      "@elizaos/shared": ["../../packages/shared/src/index.ts"],
      "@elizaos/auth/vault": ["../../packages/auth/src/vault/index.ts"],
      "@elizaos/plugin-assistant": [
        "../../plugins/plugin-assistant/src/index.ts"
      ],
      "@elizaos/shared/contracts/remote-control": [
        "../../packages/shared/src/contracts/remote-control.ts"
      ],
      "@elizaos/shared/elizacloud/domain-contract": [
        "../../packages/shared/src/elizacloud/domain-contract.ts"
      ],
      "@elizaos/shared/browser-contracts": [
        "../shared/src/browser-contracts.ts"
      ],
      "@elizaos/shared/logger": ["../shared/src/logger.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
