// spec/nativeDesktop/index.md, "Story: Use desktop controls with truthful capability and result states"
import type { DesktopPlugin } from "./native-contract.vibe"

export type * from "./native-contract.vibe"

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { DesktopPlugin } from "./native-contract.vibe"

  export const native = registerPlugin<DesktopPlugin>("Desktop")
}
import { native } from capacitor

export const Desktop = native

import { nativeCall, nativeReply } from "@elizaos/os-bridges"
import { mayUseDesktop, validWindowGeometry, type DesktopHost } from "../gen/nativeDesktop.effect.vibe"
import type { WindowBounds } from "./native-contract.vibe"

const Bounds = Schema.Struct({ x: Schema.Int, y: Schema.Int, width: Schema.Int, height: Schema.Int })

export error DesktopWindowRefused

export effect function setDesktopWindowBounds(host: DesktopHost, bounds: WindowBounds, port: DesktopPlugin = Desktop) {
  const { x, y, width, height } = bounds
  if (![x, y, width, height].every((value) => Number.isSafeInteger(value)) ||
      !mayUseDesktop(host, "DesktopWindow") || !validWindowGeometry({ widthPx: width, heightPx: height, opacityMillionths: 1000000 })) {
    throw new DesktopWindowRefused()
  }
  try nativeCall("Desktop", "setWindowBounds", () => port.setWindowBounds(bounds))
  return try nativeReply("Desktop", "getWindowBounds", Bounds, () => port.getWindowBounds())
}
