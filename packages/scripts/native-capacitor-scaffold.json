    },
    {
      "packageName": "plugin-native-mobile-signals",
      "globalName": "capacitorElizaMobileSignals",
      "nodeResolve": true
    },
    {
      "packageName": "plugin-native-network-policy",
      "globalName": "capacitorNetworkPolicy"
    },
    { "packageName": "plugin-native-phone", "globalName": "capacitorPhone" },
    {
      "packageName": "plugin-native-screencapture",
      "globalName": "capacitorScreenCapture",
      "nodeResolve": true
    },
    {
      "packageName": "plugin-native-secure-store",
      "globalName": "capacitorElizaSecureStore"
    },
    { "packageName": "plugin-native-system", "globalName": "capacitorSystem" },
    {
      "packageName": "plugin-native-talkmode",
      "globalName": "capacitorTalkMode"
    },
    {
      "packageName": "plugin-native-websiteblocker",
      "globalName": "capacitorWebsiteBlocker"
    },
    { "packageName": "plugin-native-wifi", "globalName": "capacitorWifi" }
  ]
}
