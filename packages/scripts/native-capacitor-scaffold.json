    },
    {
      "packageName": "plugin-native-bun-runtime",
      "globalName": "capacitorBunRuntime"
    },
    {
      "packageName": "plugin-native-calendar",
      "globalName": "capacitorAppleCalendar"
    },
    {
      "packageName": "plugin-native-camera",
      "globalName": "capacitorElizaCamera",
      "nodeResolve": true
    },
    {
      "packageName": "plugin-native-canvas",
      "globalName": "capacitorElizaCanvas",
      "nodeResolve": true
    },
    {
      "packageName": "plugin-native-contacts",
      "globalName": "capacitorContacts"
    },
    {
      "packageName": "plugin-native-desktop",
      "globalName": "capacitorDesktop",
      "nodeResolve": true
    },
    {
      "packageName": "plugin-native-eliza-tasks",
      "globalName": "capacitorElizaTasks",
      "nodeResolve": true
    },
    {
      "packageName": "plugin-native-gateway",
      "globalName": "capacitorGateway"
    },
    {
      "packageName": "plugin-native-location",
      "globalName": "capacitorLocation"
    },
    {
      "packageName": "plugin-native-messages",
      "globalName": "capacitorMessages",
      "nodeResolve": true
    },
    {
      "packageName": "plugin-native-mlkit-text",
      "globalName": "capacitorMlKitText"
    },
    {
      "packageName": "plugin-native-mobile-agent-bridge",
