// spec/elizaCloud/index.md, "Story: Read account state and use Cloud under my current connection"; spec/elizaCloud/index.md, "Story: See which configured Cloud models can answer my request"
import { cloudServiceType, type CloudLinkRequest, type CloudLinkService } from "@elizaos/agent"
import { creditFromSnapshot, snapshotFromResponse } from "@elizaos/cloud/client"
import { resolveCanonicalOwnerId, validateUuid, type Action, type IAgentRuntime, type Memory, type Plugin, type Provider } from "@elizaos/core"
import { Schema } from "effect"
import { Machine, cloudTextReadiness, effectiveCloudModel, machine } from "../gen/elizaCloud.effect.vibe"

export error CloudAccountUnavailable { reason: string }

const profileSchema = Schema.Struct({
  success: Schema.Literal(true),
  data: Schema.Struct({ id: Schema.String }),
})
const modelSchema = Schema.Struct({
  object: Schema.Literal("list"),
  data: Schema.Array(Schema.Struct({ id: Schema.String })),
})

function getLink(runtime: IAgentRuntime) {
  const service = runtime.getService<CloudLinkService>(cloudServiceType)
  return service === null || service === undefined || typeof service.request !== "function" ? undefined : service
}

function getSetting(runtime: IAgentRuntime, key: string): string {
  const value = runtime.getSetting(key)
  return typeof value === "string" ? value.trim() : ""
}

effect function readCloud(link: CloudLinkService, path: CloudLinkRequest["path"]) {
  const response = try tryPromise({
    try: (signal) => link.request({ method: "GET", path, signal }),
    catch: () => new CloudAccountUnavailable({ reason: "Cloud could not be reached through the current connection." }),
  })
  if (response.kind !== "answered") throw new CloudAccountUnavailable({ reason: "The current Cloud connection refused this request." })
  return response.body
}

export effect function accountStatus(runtime: IAgentRuntime) {
  const link = getLink(runtime)
  if (link === undefined) throw new CloudAccountUnavailable({ reason: "The agent has no authenticated Cloud connection." })
  const account = try Schema.decodeUnknownEffect(profileSchema)(try readCloud(link, "/api/v1/user"))
  const accountId = account.data.id
  const originId = String(runtime.agentId)
  provide machine() {
    const view = try Machine
    try view.send({ type: "attachCloud", accountId, originId, epoch: 1, originAllowed: true })
    if (getLink(runtime) !== link) throw new CloudAccountUnavailable({ reason: "The Cloud connection changed during the account request." })
    try view.send({ type: "observeCloud", accountId, originId, epoch: 1, observation: "ProfileSummary" })
    const billing = try snapshotFromResponse(try readCloud(link, "/api/v1/billing/limits"))
    if (getLink(runtime) !== link) throw new CloudAccountUnavailable({ reason: "The Cloud connection changed during the funding request." })
    try view.send({ type: "observeCloud", accountId, originId, epoch: 1, observation: "CreditSummary" })
    const catalog = (effect {
      return try Schema.decodeUnknownEffect(modelSchema)(try readCloud(link, "/api/v1/models"))
    }) catch () => undefined
    if (getLink(runtime) !== link) throw new CloudAccountUnavailable({ reason: "The Cloud connection changed during the catalog request." })
    const small = effectiveCloudModel(getSetting(runtime, "ELIZAOS_CLOUD_SMALL_MODEL"), getSetting(runtime, "SMALL_MODEL"), "gpt-4.1-mini")
    const large = effectiveCloudModel(getSetting(runtime, "ELIZAOS_CLOUD_LARGE_MODEL"), getSetting(runtime, "LARGE_MODEL"), "gpt-4.1")
    const readiness = cloudTextReadiness(catalog === undefined ? "CatalogUnavailable" : "CatalogSnapshot", catalog?.data.map((entry) => entry.id) ?? [], small.modelId, large.modelId)
    return { accountId, credit: creditFromSnapshot(billing, try Clock.currentTimeMillis), readiness, small, large }
  }
}

function isAccountOwner(runtime: IAgentRuntime, message: Memory): boolean {
  const owner = validateUuid(resolveCanonicalOwnerId(runtime))
  return owner !== null && owner === message.entityId
}

export const accountStatusAction: Action = {
  name: "CLOUD_ACCOUNT_STATUS",
  description: "Show the owner's current Eliza Cloud funding and configured model availability.",
  validate: (runtime, message) => Promise.resolve(isAccountOwner(runtime, message) && getLink(runtime) !== undefined),
  handler: (runtime, message) => runPromise(effect {
    if (!isAccountOwner(runtime, message)) throw new CloudAccountUnavailable({ reason: "Cloud account status is visible only to the configured owner." })
    const status = try accountStatus(runtime)
    const text = status.readiness === "TextModelsAvailable"
      ? "Cloud is connected and both configured text models are available."
      : status.readiness === "UnknownTextModels"
        ? "Cloud is connected. Model availability is temporarily unknown."
        : "Cloud is connected, but a configured text model is missing from its catalog."
    return { success: true, text, data: status }
  }),
}

export const connectionProvider: Provider = {
  name: "cloud-status",
  description: "Whether the agent has an authenticated Cloud link.",
  get: (runtime) => Promise.resolve({ text: getLink(runtime) === undefined ? "Cloud is disconnected." : "Cloud is connected." }),
}

export const plugin: Plugin = {
  name: "@elizaos/plugin-elizacloud",
  description: "Owner-scoped Cloud status, credit, and model catalog using the agent’s authenticated Cloud link.",
  actions: [accountStatusAction],
  providers: [connectionProvider],
}

export default plugin
