// spec/elizaCloud/index.md, "Story: Read account state and use Cloud under my current connection"; spec/elizaCloud/index.md, "Story: See which configured Cloud models can answer my request"; spec/elizaCloud/apiKeys.md, "Story: Mint a Cloud API key safely from chat"; spec/elizaCloud/inference.md, "Story: Route Cloud inference with bounded retries and uniform wire tool schemas"; spec/elizaCloud/delegation.md, "Story: Gate managed Google delegation and gateway relay on owner consent"
import type { AgentPlugin } from "@elizaos/agent-host"
import { ModelType, type IAgentRuntime } from "@elizaos/core"
import {
  accountStatus,
  accountStatusAction,
  createCloudApiKeyAction,
  parseApiKeyName,
} from "./actions.vibe"
import {
  DEFAULT_CLOUD_BASE_URL,
  getApiKey,
  getBaseURL,
  isApprovedCloudOrigin,
  isCloudInferenceEnabled,
  isCloudSttAvailable,
  isCloudTtsAvailable,
  isSlotServedByCloud,
  resolveCloudApiKeysUrl,
  resolveCloudBillingUrl,
  resolveCloudTimeoutMs,
  resolveSlotModel,
} from "./config.vibe"
import {
  CloudAccountUnavailable,
  CloudApiFailure,
  CloudSttUnavailableError,
  toCloudTokenUsage,
  unavailableResearchError,
} from "./http.vibe"
import {
  fetchTextToSpeech,
  handleActionPlanner,
  handleAudioGeneration,
  handleBatchTextEmbedding,
  handleImageDescription,
  handleImageGeneration,
  handleResearch,
  handleResponseHandler,
  handleTextEmbedding,
  handleTextLarge,
  handleTextMedium,
  handleTextMega,
  handleTextNano,
  handleTextSmall,
  handleTextToSpeech,
  handleTokenizerDecode,
  handleTokenizerEncode,
  handleTranscription,
  handleVideoGeneration,
  resolveTokenizerEncodingName,
} from "./models.vibe"
import {
  cloudAccountProvider,
  cloudStatusProvider,
  connectionProvider,
  creditBalanceProvider,
  fetchCreditBalance,
  getCachedAccountSnapshot,
  invalidateCloudAccountCache,
  modelRegistryProvider,
  type CloudAccountSnapshot,
} from "./providers.vibe"
import { elizaCloudRoutes, type CloudRouteRuntimeTarget } from "./routes.vibe"
import {
  CLOUD_AUTH_SERVICE_TYPE,
  CLOUD_GOOGLE_DELEGATION_SERVICE_TYPE,
  CLOUD_MANAGED_GATEWAY_RELAY_SERVICE_TYPE,
  CLOUD_MODEL_REGISTRY_SERVICE_TYPE,
  CloudAuthService,
  CloudGoogleDelegationService,
  CloudManagedGatewayRelayService,
  CloudModelRegistryService,
  normalizeCloudCatalogIdentifiers,
  type CloudCatalogModel,
  type CloudTextReadinessReport,
  type ModelsByProvider,
} from "./services.vibe"
import {
  clearCloudVoiceCatalogCache,
  fetchCloudVoiceCatalog,
  isOpenAiVoiceAlias,
  type CloudVoiceCatalogEntry,
} from "./voice-catalog.vibe"

let activeRuntime: IAgentRuntime | undefined = undefined

export function setActiveCloudRuntime(runtime: IAgentRuntime | undefined): void {
  activeRuntime = runtime
}

export function getActiveCloudRuntime(): IAgentRuntime | undefined {
  return activeRuntime
}

const cloudModels = {
  [ModelType.TEXT_NANO]: handleTextNano,
  [ModelType.TEXT_SMALL]: handleTextSmall,
  [ModelType.TEXT_MEDIUM]: handleTextMedium,
  [ModelType.TEXT_LARGE]: handleTextLarge,
  [ModelType.TEXT_MEGA]: handleTextMega,
  [ModelType.RESPONSE_HANDLER]: handleResponseHandler,
  [ModelType.ACTION_PLANNER]: handleActionPlanner,
  [ModelType.TEXT_EMBEDDING]: handleTextEmbedding,
  [ModelType.TEXT_EMBEDDING_BATCH]: handleBatchTextEmbedding,
  [ModelType.IMAGE]: handleImageGeneration,
  [ModelType.IMAGE_DESCRIPTION]: handleImageDescription,
  [ModelType.AUDIO]: handleAudioGeneration,
  [ModelType.VIDEO]: handleVideoGeneration,
  [ModelType.TEXT_TO_SPEECH]: handleTextToSpeech,
  [ModelType.TRANSCRIPTION]: handleTranscription,
  [ModelType.TEXT_TOKENIZER_ENCODE]: handleTokenizerEncode,
  [ModelType.TEXT_TOKENIZER_DECODE]: handleTokenizerDecode,
  [ModelType.RESEARCH]: handleResearch,
} as const

export const plugin: AgentPlugin = {
  name: "@elizaos/plugin-elizacloud",
  description: "Owner-scoped Eliza Cloud inference, media, voice, account status, API keys, delegation, relay, and billing routes.",
  actions: [accountStatusAction, createCloudApiKeyAction],
  providers: [connectionProvider, cloudStatusProvider, creditBalanceProvider, modelRegistryProvider, cloudAccountProvider],
  services: [CloudAuthService, CloudModelRegistryService, CloudGoogleDelegationService, CloudManagedGatewayRelayService],
  models: cloudModels,
  routes: elizaCloudRoutes(() => activeRuntime),
  init: async (_config, runtime) => {
    activeRuntime = runtime
  },
  dispose: async (runtime) => {
    invalidateCloudAccountCache(runtime)
    if (activeRuntime === runtime) activeRuntime = undefined
  },
}

export const elizaCloudPlugin = plugin
export default plugin

export {
  CLOUD_AUTH_SERVICE_TYPE,
  CLOUD_GOOGLE_DELEGATION_SERVICE_TYPE,
  CLOUD_MANAGED_GATEWAY_RELAY_SERVICE_TYPE,
  CLOUD_MODEL_REGISTRY_SERVICE_TYPE,
  CloudAccountUnavailable,
  CloudApiFailure,
  CloudAuthService,
  CloudGoogleDelegationService,
  CloudManagedGatewayRelayService,
  CloudModelRegistryService,
  CloudSttUnavailableError,
  DEFAULT_CLOUD_BASE_URL,
  accountStatus,
  accountStatusAction,
  clearCloudVoiceCatalogCache,
  cloudAccountProvider,
  cloudStatusProvider,
  connectionProvider,
  createCloudApiKeyAction,
  creditBalanceProvider,
  elizaCloudRoutes,
  fetchCloudVoiceCatalog,
  fetchCreditBalance,
  fetchTextToSpeech,
  getApiKey,
  getBaseURL,
  getCachedAccountSnapshot,
  handleActionPlanner,
  handleAudioGeneration,
  handleBatchTextEmbedding,
  handleImageDescription,
  handleImageGeneration,
  handleResearch,
  handleResponseHandler,
  handleTextEmbedding,
  handleTextLarge,
  handleTextMedium,
  handleTextMega,
  handleTextNano,
  handleTextSmall,
  handleTextToSpeech,
  handleTokenizerDecode,
  handleTokenizerEncode,
  handleTranscription,
  handleVideoGeneration,
  invalidateCloudAccountCache,
  isApprovedCloudOrigin,
  isCloudInferenceEnabled,
  isCloudSttAvailable,
  isCloudTtsAvailable,
  isOpenAiVoiceAlias,
  isSlotServedByCloud,
  modelRegistryProvider,
  normalizeCloudCatalogIdentifiers,
  parseApiKeyName,
  resolveCloudApiKeysUrl,
  resolveCloudBillingUrl,
  resolveCloudTimeoutMs,
  resolveSlotModel,
  resolveTokenizerEncodingName,
  toCloudTokenUsage,
  unavailableResearchError,
  type CloudAccountSnapshot,
  type CloudCatalogModel,
  type CloudRouteRuntimeTarget,
  type CloudTextReadinessReport,
  type CloudVoiceCatalogEntry,
  type ModelsByProvider,
}
