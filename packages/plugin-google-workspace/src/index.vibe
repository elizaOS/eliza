// spec/googleWorkspace/index.md, "Story: Use only the Google account and permissions I connected"; spec/googleWorkspace/index.md, "Story: Send Gmail to the confirmed recipient"; spec/googleWorkspace/oauth.md, "Story: Connect, refresh, and disconnect a Google Workspace account without leaving stale grants active"
import { getConnectorAccountManager, logger, type IAgentRuntime, type Plugin } from "@elizaos/core"
import { readEnv } from "./boundary.vibe"
import { GoogleChatService, createGoogleChatConnectorAccountProvider } from "./chat.vibe"
import { GoogleWorkspaceService, createGoogleConnectorAccountProvider } from "./service.vibe"
import { GOOGLE_SERVICE_NAME } from "./types.vibe"

export * from "./auth.vibe"
export * from "./calendar.vibe"
export * from "./chat.vibe"
export * from "./drive-people-meet.vibe"
export * from "./gmail.vibe"
export * from "./scopes.vibe"
export * from "./service.vibe"
export * from "./types.vibe"

export const googlePlugin: Plugin = {
  name: GOOGLE_SERVICE_NAME,
  description: "Google Workspace integration for Gmail, Calendar, Drive, Meet, People, and Chat with account-scoped OAuth and service-account Chat auth",
  services: [GoogleWorkspaceService, GoogleChatService],
  connectorSources: [
    {
      source: "google-chat",
      aliases: ["google-chat", "googlechat"],
      sourceKind: "passive",
      isPassive: true,
    },
  ],
  actions: [],
  providers: [],
  tests: [],
  autoEnable: {
    connectorKeys: ["googlechat"],
  },
  async dispose(runtime: IAgentRuntime): Promise<void> {
    const chat = runtime.getService<GoogleChatService>(GoogleChatService.serviceType)
    if (chat !== null && chat !== undefined) await chat.stop()
  },
  async init(config: Record<string, string>, runtime: IAgentRuntime): Promise<void> {
    const hasClient = Boolean(config.GOOGLE_CLIENT_ID || readEnv("GOOGLE_CLIENT_ID"))
    const hasSecret = Boolean(config.GOOGLE_CLIENT_SECRET || readEnv("GOOGLE_CLIENT_SECRET"))
    logger.info({ hasClient, hasSecret }, "Initializing Google Workspace plugin")
    const manager = getConnectorAccountManager(runtime)
    manager.registerProvider(createGoogleConnectorAccountProvider(runtime))
    manager.registerProvider(createGoogleChatConnectorAccountProvider(runtime))
  },
}

export default googlePlugin
