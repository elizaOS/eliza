// spec/googleWorkspace/index.md, "Story: Use only the Google account and permissions I connected"; spec/googleWorkspace/index.md, "Story: Send Gmail to the confirmed recipient"
import type { Service } from "@elizaos/core"
import type { WorkspaceAccount } from "../gen/googleWorkspace.effect.vibe"
import type { GoogleCapability } from "./scopes.vibe"

export const GOOGLE_SERVICE_NAME = "google"

export type GoogleAccountId = string

export interface GoogleAccountRef {
  readonly accountId: GoogleAccountId
  readonly ownerId?: string
  readonly seenEpoch?: number
}

export interface GoogleAuthClient {
  readonly accessToken: string
  readonly refreshToken?: string
  readonly expiryDate?: number
  readonly scopes: readonly string[]
  readonly accountId: GoogleAccountId
  readonly email?: string
  readonly epoch: number
}

export interface GoogleAuthResolutionRequest {
  readonly accountId: GoogleAccountId
  readonly requiredCapabilities?: readonly GoogleCapability[]
  readonly requiredScopes?: readonly string[]
  readonly ownerId?: string
  readonly seenEpoch?: number
}

export interface GoogleCredentialResolver {
  resolve(request: GoogleAuthResolutionRequest): Promise<GoogleAuthClient>
  invalidate?(accountId: GoogleAccountId): Promise<void> | void
}

export interface GoogleOAuthProviderMetadata {
  readonly provider: "google"
  readonly displayName: string
  readonly authorizationEndpoint: string
  readonly tokenEndpoint: string
  readonly revocationEndpoint: string
  readonly userInfoEndpoint: string
  readonly pkceRequired: boolean
}

export interface GoogleOAuthProviderConfig {
  readonly provider: "google"
  readonly clientId: string
  readonly clientSecret: string
  readonly redirectUri: string
  readonly scopes: readonly string[]
  readonly capabilities: readonly GoogleCapability[]
  readonly authorizationEndpoint: string
  readonly tokenEndpoint: string
}

export interface GoogleEmailAddress {
  readonly email: string
  readonly name?: string
}

export type GoogleCalendarAttendeeResponseStatus = "needsAction" | "declined" | "tentative" | "accepted"

export interface GoogleCalendarAttendeeInput {
  readonly email: string
  readonly displayName?: string
  readonly optional?: boolean
  readonly responseStatus?: GoogleCalendarAttendeeResponseStatus
}

export interface GoogleCalendarAttendee {
  readonly email: string
  readonly displayName?: string
  readonly optional?: boolean
  readonly organizer?: boolean
  readonly self?: boolean
  readonly responseStatus?: GoogleCalendarAttendeeResponseStatus
}

export type GoogleCalendarSendUpdates = "all" | "externalOnly" | "none"
export type GoogleCalendarTransparency = "opaque" | "transparent"
export type GoogleCalendarVisibility = "default" | "public" | "private" | "confidential"

export interface GoogleMessageSummary {
  readonly id: string
  readonly threadId: string
  readonly snippet: string
  readonly subject: string
  readonly from: string
  readonly to: readonly string[]
  readonly cc?: readonly string[]
  readonly date: string
  readonly labelIds: readonly string[]
  readonly bodyText?: string
  readonly bodyHtml?: string
}

export interface GoogleSendEmailInput extends GoogleAccountRef {
  readonly to: readonly string[]
  readonly cc?: readonly string[]
  readonly bcc?: readonly string[]
  readonly subject: string
  readonly bodyText: string
  readonly bodyHtml?: string
  readonly threadId?: string
  readonly inReplyTo?: string
  readonly references?: string
  readonly confirmedContactEmail?: string
}

export type GoogleGmailBulkOperation = "archive" | "trash" | "markRead" | "markUnread" | "star" | "unstar" | "addLabels" | "removeLabels"

export interface GoogleGmailMutationFailure {
  readonly messageId: string
  readonly code: string
  readonly message: string
}

export interface GoogleGmailMutationReceipt {
  readonly operation: GoogleGmailBulkOperation
  readonly succeededIds: readonly string[]
  readonly failed: readonly GoogleGmailMutationFailure[]
}

export interface GoogleGmailMessageSummary {
  readonly id: string
  readonly threadId: string
  readonly historyId?: string
  readonly internalDate?: string
  readonly snippet: string
  readonly subject: string
  readonly from: string
  readonly fromEmail?: string
  readonly to: readonly string[]
  readonly cc: readonly string[]
  readonly date: string
  readonly labelIds: readonly string[]
  readonly isUnread: boolean
  readonly isStarred: boolean
  readonly isImportant: boolean
  readonly isSentBySelf: boolean
  readonly hasAttachments: boolean
  readonly messageIdHeader?: string
  readonly referencesHeader?: string
}

export interface GoogleGmailAttachment {
  readonly partId: string
  readonly filename: string
  readonly mimeType: string
  readonly size: number
  readonly attachmentId: string | null
}

export interface GoogleGmailAttachmentContent extends GoogleGmailAttachment {
  readonly messageId: string
  readonly sha256: string
  readonly data: Uint8Array
}

export interface GoogleGmailMessageDetail extends GoogleGmailMessageSummary {
  readonly bodyText: string
  readonly bodyHtml?: string
  readonly attachments: readonly GoogleGmailAttachment[]
}

export interface GoogleGmailUnrespondedThread {
  readonly threadId: string
  readonly latestMessageId: string
  readonly subject: string
  readonly from: string
  readonly fromEmail?: string
  readonly lastReceivedAt: string
  readonly ageDays: number
  readonly messageCount: number
  readonly snippet: string
}

export interface GoogleGmailSendResult {
  readonly id: string
  readonly threadId: string
  readonly labelIds: readonly string[]
}

export interface GoogleGmailDraftResult {
  readonly id: string
  readonly messageId: string
  readonly threadId: string
}

export interface GoogleGmailHistoryMessageRef {
  readonly id: string
  readonly threadId: string
}

export interface GoogleGmailHistoryChange {
  readonly id: string
  readonly messagesAdded: readonly GoogleGmailHistoryMessageRef[]
  readonly messagesDeleted: readonly GoogleGmailHistoryMessageRef[]
  readonly labelsAdded: readonly { readonly message: GoogleGmailHistoryMessageRef; readonly labelIds: readonly string[] }[]
  readonly labelsRemoved: readonly { readonly message: GoogleGmailHistoryMessageRef; readonly labelIds: readonly string[] }[]
}

export interface GoogleGmailHistoryPage {
  readonly historyId: string
  readonly changes: readonly GoogleGmailHistoryChange[]
  readonly nextPageToken?: string
}

export interface GoogleGmailSearchPage {
  readonly messages: readonly GoogleGmailMessageSummary[]
  readonly nextPageToken?: string
  readonly resultSizeEstimate: number
}

export interface GoogleGmailSubscriptionMessageHeaders {
  readonly messageId: string
  readonly threadId: string
  readonly from: string
  readonly subject: string
  readonly listUnsubscribe?: string
  readonly listUnsubscribePost?: string
  readonly listId?: string
}

export interface GoogleGmailFilterCreateResult {
  readonly id: string
  readonly fromAddress: string
  readonly trash: boolean
}

export interface GoogleParsedMailto {
  readonly to: string
  readonly subject?: string
  readonly body?: string
}

export interface GoogleCalendarEventInput extends GoogleAccountRef {
  readonly calendarId?: string
  readonly summary: string
  readonly description?: string
  readonly location?: string
  readonly start: string
  readonly end: string
  readonly allDay?: boolean
  readonly timeZone?: string
  readonly attendees?: readonly GoogleCalendarAttendeeInput[]
  readonly sendUpdates?: GoogleCalendarSendUpdates
  readonly recurrence?: readonly string[]
  readonly transparency?: GoogleCalendarTransparency
  readonly visibility?: GoogleCalendarVisibility
  readonly createMeetLink?: boolean
  readonly idempotencyKey?: string
}

export interface GoogleCalendarEventPatchInput extends GoogleAccountRef {
  readonly calendarId?: string
  readonly eventId: string
  readonly expectedEtag?: string
  readonly summary?: string
  readonly description?: string
  readonly location?: string
  readonly start?: string
  readonly end?: string
  readonly allDay?: boolean
  readonly timeZone?: string
  readonly attendees?: readonly GoogleCalendarAttendeeInput[]
  readonly sendUpdates?: GoogleCalendarSendUpdates
  readonly recurrence?: readonly string[]
  readonly transparency?: GoogleCalendarTransparency
  readonly visibility?: GoogleCalendarVisibility
}

export interface GoogleCalendarEventDeleteInput extends GoogleAccountRef {
  readonly calendarId?: string
  readonly eventId: string
  readonly expectedEtag?: string
  readonly sendUpdates?: GoogleCalendarSendUpdates
}

export interface GoogleCalendarEventResponseInput extends GoogleAccountRef {
  readonly calendarId?: string
  readonly eventId: string
  readonly responseStatus: GoogleCalendarAttendeeResponseStatus
  readonly attendeeEmail?: string
  readonly comment?: string
  readonly sendUpdates?: GoogleCalendarSendUpdates
}

export interface GoogleCalendarEvent {
  readonly id: string
  readonly calendarId: string
  readonly etag?: string
  readonly status?: string
  readonly htmlLink?: string
  readonly summary: string
  readonly description?: string
  readonly location?: string
  readonly start: string
  readonly end: string
  readonly allDay: boolean
  readonly timeZone?: string
  readonly organizerEmail?: string
  readonly attendees: readonly GoogleCalendarAttendee[]
  readonly recurrence?: readonly string[]
  readonly conferenceLink?: string
  readonly updated?: string
  readonly idempotencyKey?: string
}

export interface GoogleCalendarListEntry {
  readonly id: string
  readonly summary: string
  readonly description?: string
  readonly timeZone?: string
  readonly primary: boolean
  readonly accessRole?: string
