export type GoogleMeetAccessType = "ACCESS_TYPE_UNSPECIFIED" | "OPEN" | "TRUSTED" | "RESTRICTED"
export type GoogleMeetStatus = "scheduled" | "active" | "ended"

export interface GoogleMeetSpace {
  readonly name: string
  readonly meetingUri: string
  readonly meetingCode: string
  readonly accessType?: GoogleMeetAccessType
  readonly activeConference?: string
}

export interface GoogleMeetMeeting {
  readonly spaceName: string
  readonly meetingUri: string
  readonly meetingCode: string
  readonly status: GoogleMeetStatus
  readonly activeConference?: string
}

export interface GoogleMeetConferenceRecord {
  readonly name: string
  readonly space: string
  readonly startTime: string
  readonly endTime?: string
  readonly expireTime?: string
}

export interface GoogleMeetParticipant {
  readonly name: string
  readonly displayName: string
  readonly email?: string
  readonly earliestStartTime?: string
  readonly latestEndTime?: string
  readonly anonymous?: boolean
}

export interface GoogleMeetParticipantSession {
  readonly name: string
  readonly participantName: string
  readonly startTime: string
  readonly endTime?: string
}

export interface GoogleMeetTranscript {
  readonly name: string
  readonly participant?: string
  readonly text: string
  readonly languageCode?: string
  readonly startOffset?: string
  readonly endOffset?: string
}

export interface GoogleMeetTranscriptArtifact {
  readonly name: string
  readonly state: string
  readonly startTime?: string
  readonly endTime?: string
  readonly docsDocumentId?: string
  readonly docsExportUri?: string
}

export interface GoogleMeetRecording {
  readonly name: string
  readonly state: string
  readonly startTime?: string
  readonly endTime?: string
  readonly driveFileId?: string
  readonly exportUri?: string
}

export interface GoogleMeetActionItem {
  readonly text: string
  readonly owner?: string
}

export type GoogleMeetCanonicalStreamKind = "transcript" | "recording" | "notes"

export interface GoogleMeetCanonicalStream {
  readonly kind: GoogleMeetCanonicalStreamKind
  readonly resourceName: string
  readonly available: boolean
}

export interface GoogleMeetCanonicalParticipant {
  readonly id: string
  readonly displayName: string
  readonly email?: string
}

export interface GoogleMeetCanonicalParticipantSession {
  readonly sessionId: string
  readonly participantId: string
  readonly startTime: string
  readonly endTime?: string
}

export interface GoogleMeetCanonicalTranscriptSpan {
  readonly id: string
  readonly speaker: string
  readonly text: string
  readonly startOffset?: string
  readonly endOffset?: string
}

export interface GoogleMeetCanonicalGeneratedNote {
  readonly title: string
  readonly summary: string
  readonly actionItems: readonly GoogleMeetActionItem[]
}

export type GoogleMeetMissingArtifactReason = "not_recorded" | "processing" | "permission_denied" | "not_found"

export interface GoogleMeetMissingArtifact {
  readonly kind: GoogleMeetCanonicalStreamKind
  readonly reason: GoogleMeetMissingArtifactReason
  readonly detail: string
}

export interface GoogleMeetCanonicalWarning {
  readonly code: string
  readonly message: string
}

export interface GoogleMeetBotFreeCaptureArtifact {
  readonly source: "google_meet"
  readonly conferenceRecord: string
  readonly streams: readonly GoogleMeetCanonicalStream[]
}

export interface GoogleMeetCanonicalArtifact {
  readonly source: "google_meet"
  readonly conferenceRecord: GoogleMeetConferenceRecord
  readonly participants: readonly GoogleMeetCanonicalParticipant[]
  readonly sessions: readonly GoogleMeetCanonicalParticipantSession[]
  readonly transcriptSpans: readonly GoogleMeetCanonicalTranscriptSpan[]
  readonly generatedNote: GoogleMeetCanonicalGeneratedNote
  readonly recordings: readonly GoogleMeetRecording[]
  readonly missingArtifacts: readonly GoogleMeetMissingArtifact[]
  readonly warnings: readonly GoogleMeetCanonicalWarning[]
  readonly capture: GoogleMeetBotFreeCaptureArtifact
}

export interface GoogleMeetCanonicalArtifactInput {
  readonly conferenceRecord: GoogleMeetConferenceRecord
  readonly participants: readonly GoogleMeetParticipant[]
  readonly sessions: readonly GoogleMeetParticipantSession[]
  readonly transcriptEntries: readonly GoogleMeetTranscript[]
  readonly recordings: readonly GoogleMeetRecording[]
  readonly missingArtifacts?: readonly GoogleMeetMissingArtifact[]
  readonly warnings?: readonly GoogleMeetCanonicalWarning[]
}

export interface GoogleMeetReport {
  readonly conferenceRecord: string
  readonly summary: string
  readonly participantCount: number
  readonly transcriptEntryCount: number
  readonly actionItems: readonly GoogleMeetActionItem[]
  readonly recordingUrls: readonly string[]
}

export interface GoogleMeetCreateMeetingInput extends GoogleAccountRef {
  readonly accessType?: GoogleMeetAccessType
}

export interface GoogleMeetGetMeetingInput extends GoogleAccountRef {
  readonly spaceNameOrCode: string
}

export interface GoogleMeetConferenceRecordInput extends GoogleAccountRef {
  readonly conferenceRecordName: string
}

export interface GoogleMeetParticipantSessionInput extends GoogleAccountRef {
  readonly participantName: string
}

export interface GoogleMeetTranscriptInput extends GoogleAccountRef {
  readonly transcriptName: string
}

export interface GoogleMeetRecordingInput extends GoogleAccountRef {
  readonly recordingName: string
}

export interface GoogleMeetGenerateReportInput extends GoogleAccountRef {
  readonly conferenceRecordName: string
}

export interface IGoogleGmailService extends Service {
  getGmailHistoryId(params: GoogleAccountRef): Promise<string>
  listGmailHistoryPage(params: GoogleAccountRef & { readonly startHistoryId: string; readonly pageToken?: string; readonly maxResults?: number }): Promise<GoogleGmailHistoryPage>
  searchMessages(params: GoogleAccountRef & { readonly query: string; readonly limit?: number }): Promise<GoogleMessageSummary[]>
  getMessage(params: GoogleAccountRef & { readonly messageId: string; readonly includeBody?: boolean }): Promise<GoogleMessageSummary>
  sendEmail(params: GoogleSendEmailInput): Promise<{ readonly id: string; readonly threadId?: string }>
  listGmailTriageMessages(params: GoogleAccountRef & { readonly selfEmail?: string | null; readonly maxResults?: number }): Promise<GoogleGmailMessageSummary[]>
  searchGmailMessages(params: GoogleAccountRef & { readonly query: string; readonly selfEmail?: string | null; readonly maxResults?: number; readonly includeSpamTrash?: boolean; readonly labelIds?: readonly string[] }): Promise<GoogleGmailMessageSummary[]>
  searchGmailMessagesPage(params: GoogleAccountRef & { readonly query: string; readonly selfEmail?: string | null; readonly pageToken?: string | null; readonly pageSize?: number; readonly includeSpamTrash?: boolean }): Promise<GoogleGmailSearchPage>
  getGmailMessage(params: GoogleAccountRef & { readonly messageId: string; readonly selfEmail?: string | null }): Promise<GoogleGmailMessageSummary | null>
  getGmailMessageDetail(params: GoogleAccountRef & { readonly messageId: string; readonly selfEmail?: string | null }): Promise<GoogleGmailMessageDetail | null>
  getGmailAttachment(params: GoogleAccountRef & { readonly messageId: string; readonly partId: string; readonly maxBytes: number }): Promise<GoogleGmailAttachmentContent>
  getGmailMessageRevision(params: GoogleAccountRef & { readonly messageId: string }): Promise<string | null>
  listGmailUnrespondedThreads(params: GoogleAccountRef & { readonly selfEmail?: string | null; readonly olderThanDays?: number; readonly maxResults?: number; readonly now?: Date }): Promise<GoogleGmailUnrespondedThread[]>
  modifyGmailMessages(params: GoogleAccountRef & { readonly messageIds: readonly string[]; readonly operation: GoogleGmailBulkOperation; readonly labelIds?: readonly string[] }): Promise<GoogleGmailMutationReceipt>
  sendGmailReply(params: GoogleAccountRef & { readonly to: readonly string[]; readonly cc?: readonly string[]; readonly subject: string; readonly bodyText: string; readonly threadId: string; readonly inReplyTo?: string | null; readonly references?: string | null }): Promise<GoogleGmailSendResult>
  sendGmailMessage(params: GoogleAccountRef & { readonly to: readonly string[]; readonly cc?: readonly string[]; readonly bcc?: readonly string[]; readonly subject: string; readonly bodyText: string }): Promise<GoogleGmailSendResult>
  createGmailDraft(params: GoogleAccountRef & { readonly to: readonly string[]; readonly cc?: readonly string[]; readonly bcc?: readonly string[]; readonly subject: string; readonly bodyText: string; readonly threadId?: string; readonly inReplyTo?: string | null; readonly references?: string | null }): Promise<GoogleGmailDraftResult>
  getGmailSubscriptionHeaders(params: GoogleAccountRef & { readonly query?: string; readonly maxMessages?: number }): Promise<GoogleGmailSubscriptionMessageHeaders[]>
  createGmailFilterForSender(params: GoogleAccountRef & { readonly fromAddress: string; readonly trash?: boolean }): Promise<GoogleGmailFilterCreateResult>
  trashGmailThread(params: GoogleAccountRef & { readonly threadId: string }): Promise<void>
  modifyGmailMessageLabels(params: GoogleAccountRef & { readonly messageId: string; readonly addLabelIds?: readonly string[]; readonly removeLabelIds?: readonly string[] }): Promise<void>
  sendMailtoUnsubscribeEmail(params: GoogleAccountRef & { readonly mailto: GoogleParsedMailto }): Promise<void>
}

export interface IGoogleCalendarService extends Service {
  listCalendars(params: GoogleAccountRef): Promise<GoogleCalendarListEntry[]>
  listCalendarPage(params: GoogleCalendarListPageInput): Promise<GoogleCalendarListPage>
  listEvents(params: GoogleAccountRef & { readonly calendarId?: string; readonly timeMin?: string; readonly timeMax?: string; readonly limit?: number; readonly timeZone?: string }): Promise<GoogleCalendarEvent[]>
  listEventPage(params: GoogleCalendarEventListPageInput): Promise<GoogleCalendarEventListPage>
  watchEvents(params: GoogleCalendarWatchInput): Promise<GoogleCalendarWatchResponse>
  stopCalendarChannel(params: GoogleCalendarStopChannelInput): Promise<void>
  queryFreeBusy(params: GoogleCalendarFreeBusyInput): Promise<GoogleCalendarFreeBusyResult>
  getEvent(params: GoogleAccountRef & { readonly calendarId?: string; readonly eventId: string; readonly timeZone?: string }): Promise<GoogleCalendarEvent>
  findEventByIdempotencyKey(params: GoogleAccountRef & { readonly calendarId: string; readonly idempotencyKey: string; readonly timeZone?: string }): Promise<GoogleCalendarEvent | null>
  createEvent(params: GoogleCalendarEventInput): Promise<GoogleCalendarEvent>
  updateEvent(params: GoogleCalendarEventPatchInput): Promise<GoogleCalendarEvent>
  deleteEvent(params: GoogleCalendarEventDeleteInput): Promise<void>
  respondToEvent(params: GoogleCalendarEventResponseInput): Promise<GoogleCalendarEvent>
}

export interface IGoogleDriveService extends Service {
  searchFiles(params: GoogleAccountRef & { readonly query: string; readonly limit?: number }): Promise<GoogleDriveFile[]>
  getFile(params: GoogleAccountRef & { readonly fileId: string }): Promise<GoogleDriveFile>
  listDriveFiles(params: GoogleAccountRef & { readonly folderId?: string; readonly maxResults?: number; readonly pageToken?: string }): Promise<GoogleDriveFileList>
  searchDriveFiles(params: GoogleAccountRef & { readonly query: string; readonly maxResults?: number; readonly pageToken?: string }): Promise<GoogleDriveFileList>
  getDocContent(params: GoogleAccountRef & { readonly documentId: string }): Promise<GoogleDocContent>
  getSheetContent(params: GoogleAccountRef & { readonly spreadsheetId: string; readonly range?: string }): Promise<GoogleSheetContent>
  createDriveFile(params: GoogleDriveCreateFileInput): Promise<GoogleDriveFile>
  appendToDoc(params: GoogleAccountRef & { readonly documentId: string; readonly text: string }): Promise<void>
  updateSheetCells(params: GoogleAccountRef & { readonly spreadsheetId: string; readonly range: string; readonly values: readonly (readonly (string | number)[])[] }): Promise<GoogleSheetUpdateResult>
}

export interface IGooglePeopleService extends Service {
  listContacts(params: GooglePeopleListContactsInput): Promise<GooglePeopleContactPage>
  searchContacts(params: GooglePeopleSearchContactsInput): Promise<GooglePersonContact[]>
  getContact(params: GooglePeopleGetContactInput): Promise<GooglePersonContact>
}

export interface IGoogleMeetService extends Service {
  createMeeting(params: GoogleMeetCreateMeetingInput): Promise<GoogleMeetMeeting>
  getMeeting(params: GoogleMeetGetMeetingInput): Promise<GoogleMeetMeeting>
  getMeetingSpace(params: GoogleMeetGetMeetingInput): Promise<GoogleMeetSpace>
  getConferenceRecord(params: GoogleMeetConferenceRecordInput): Promise<GoogleMeetConferenceRecord>
  listMeetingParticipants(params: GoogleMeetConferenceRecordInput & { readonly limit?: number }): Promise<GoogleMeetParticipant[]>
  listMeetingParticipantSessions(params: GoogleMeetParticipantSessionInput & { readonly limit?: number }): Promise<GoogleMeetParticipantSession[]>
  listMeetingTranscripts(params: GoogleMeetConferenceRecordInput): Promise<GoogleMeetTranscriptArtifact[]>
  getMeetingTranscript(params: GoogleMeetTranscriptInput): Promise<GoogleMeetTranscript[]>
  listMeetingRecordings(params: GoogleMeetConferenceRecordInput): Promise<GoogleMeetRecording[]>
  getMeetingRecordingUrl(params: GoogleMeetRecordingInput): Promise<string | null>
  endMeeting(params: GoogleAccountRef & { readonly spaceName: string }): Promise<void>
  generateReport(params: GoogleMeetGenerateReportInput): Promise<GoogleMeetReport>
}

export interface IGoogleWorkspaceService
  extends IGoogleGmailService,
    IGoogleCalendarService,
    IGoogleDriveService,
    IGoogleMeetService,
    IGooglePeopleService {
  getOAuthProviderConfig(capabilities: readonly GoogleCapability[]): GoogleOAuthProviderConfig
  getOAuthProviderMetadata(): GoogleOAuthProviderMetadata
}

export error WorkspaceAccessRefused { accountId: string }
export error GoogleWorkspaceFailure { source: string; status: number }

export interface WorkspaceCredential {
  readonly account: WorkspaceAccount
  readonly token: Redacted.Redacted<string>
}

export service WorkspaceCredentials {
  account(ownerId: string, accountId: string): (WorkspaceCredential | undefined)!WorkspaceAccessRefused
}

export type WorkspaceQuery =
  | { readonly kind: "gmail"; readonly query: string }
  | { readonly kind: "calendar"; readonly calendarId: string; readonly updatedMin?: string }
  | { readonly kind: "drive"; readonly query: string }
  | { readonly kind: "meet"; readonly meetingCode: string }
  | { readonly kind: "contacts"; readonly query: string }

export interface WorkspacePrincipal {
  readonly ownerId: string
  readonly accountId: string
  readonly seenEpoch: number
}

export interface GoogleApiBaseUrls {
  readonly gmail: string
  readonly calendar: string
  readonly drive: string
  readonly docs: string
  readonly sheets: string
  readonly meet: string
  readonly people: string
  readonly chat: string
  readonly oauth: string
  readonly userInfo: string
}

export const DEFAULT_GOOGLE_API_BASE_URLS: GoogleApiBaseUrls = {
  gmail: "https://gmail.googleapis.com",
  calendar: "https://www.googleapis.com",
  drive: "https://www.googleapis.com",
  docs: "https://docs.googleapis.com",
  sheets: "https://sheets.googleapis.com",
  meet: "https://meet.googleapis.com",
  people: "https://people.googleapis.com",
  chat: "https://chat.googleapis.com",
  oauth: "https://oauth2.googleapis.com",
  userInfo: "https://openidconnect.googleapis.com",
}
