  DEFAULT_GOOGLE_API_BASE_URLS,
  GOOGLE_SERVICE_NAME,
  type GoogleAccountRef,
  type GoogleApiBaseUrls,
  type GoogleCalendarEvent,
  type GoogleCalendarEventDeleteInput,
  type GoogleCalendarEventInput,
