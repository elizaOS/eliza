// spec/files/images.md, "An image is admitted only within its byte, pixel and page bounds"; spec/files/images.md, "A decoded image is scaled down to its longer-side bound, never up"
module browser {
  export interface Bitmap {
    readonly width: number
    readonly height: number
    /** @throws {never} */
    close(): void
  }
  export interface Raster {
    readonly width: number
    readonly height: number
    pixels(): Uint8ClampedArray
    put(data: Uint8ClampedArray): void
    /** @throws {never} */
    blank(): Uint8ClampedArray<ArrayBuffer>
    /** @throws {never} */
    encode(type: string, quality?: number): Promise<Blob | null>
  }

  export async function decodeBitmap(image: Blob): Promise<Bitmap> {
    return createImageBitmap(image)
  }

  function rasterOf(canvas: HTMLCanvasElement | OffscreenCanvas,
    context: CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D): Raster {
    return {
      width: canvas.width,
      height: canvas.height,
      pixels: () => context.getImageData(0, 0, canvas.width, canvas.height).data,
      put: (data) => context.putImageData(new ImageData(new Uint8ClampedArray(data), canvas.width, canvas.height), 0, 0),
      blank: () => new Uint8ClampedArray(canvas.width * canvas.height * 4),
      encode: async (type, quality) => "convertToBlob" in canvas
        ? canvas.convertToBlob({ type, quality })
        : new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, type, quality)),
    }
  }

  export function paint(bitmap: Bitmap | undefined, width: number, height: number): Raster | undefined {
    const canvas = typeof document === "undefined" ? new OffscreenCanvas(width, height) : document.createElement("canvas")
    if ("toBlob" in canvas) {
      canvas.width = width
      canvas.height = height
    }
    const context = canvas.getContext("2d", { willReadFrequently: true })
    if (context === null) return undefined
    context.fillStyle = "white"
    context.fillRect(0, 0, width, height)
    if (bitmap !== undefined) context.drawImage(bitmap as ImageBitmap, 0, 0, width, height)
    return rasterOf(canvas, context)
  }

  export async function bytesOf(blob: Blob): Promise<Uint8Array<ArrayBuffer>> {
    return new Uint8Array(await blob.arrayBuffer())
  }

  /** @throws {never} */
  export function blobOf(parts: readonly BlobPart[], type: string): Blob {
    return new Blob([...parts], { type })
  }
}

import { admitsDecodedPixels, admitsImageBytes, admitsPageSet, longSide, maxLongSide, scaledLongSide } from "../../gen/files__images.effect.vibe"
import { blobOf, bytesOf, decodeBitmap, paint, type Bitmap, type Raster } from browser
export { blobOf, bytesOf, type Bitmap, type Raster }

export const scanImageTypes: readonly string[] = ["image/jpeg", "image/png", "image/webp"]

export type ImageRefusal = "unsupported" | "no-dimensions" | "too-many-pixels" | "page-set" | "unavailable" | "conversion-failed"

const imageText: Readonly<Record<ImageRefusal, string>> = {
  unsupported: "Choose a JPEG, PNG or WebP image up to 16 MB.",
  "no-dimensions": "The image has no readable dimensions.",
  "too-many-pixels": "Choose an image with at most 32 million pixels.",
  "page-set": "Choose 1 to 20 pages, up to 64 MB total.",
  unavailable: "Image processing is unavailable.",
  "conversion-failed": "Image conversion failed.",
}

export error ImageRefused { reason: ImageRefusal; message: string }

export function imageRefused(reason: ImageRefusal): ImageRefused {
  return new ImageRefused({ reason, message: imageText[reason] })
}

export function imageAdmitted(image: { readonly type: string; readonly size: number }): boolean {
  return admitsImageBytes(scanImageTypes.includes(image.type), image.size)
}

export function pageSetAdmitted(pages: readonly { readonly type: string; readonly size: number }[]): boolean {
  return pages.every(imageAdmitted) && admitsPageSet(pages.length, pages.reduce((total, page) => total + page.size, 0))
}

export effect function decodedImage(image: Blob) {
  if (!imageAdmitted(image)) throw imageRefused("unsupported")
  const bitmap: Bitmap = try acquireRelease(
    tryPromise({ try: () => decodeBitmap(image), catch: () => imageRefused("unsupported") }),
    (open) => sync(() => open.close()),
  )
  if (!(bitmap.width > 0) || !(bitmap.height > 0)) throw imageRefused("no-dimensions")
  if (!admitsDecodedPixels(bitmap.width, bitmap.height)) throw imageRefused("too-many-pixels")
  return bitmap
}

export function fittedSize(width: number, height: number, bound: number = maxLongSide, minimum = 1) {
  const long = longSide(width, height)
  const target = bound === maxLongSide ? scaledLongSide(width, height) : Math.min(long, bound)
  const scale = target / long
  return { width: Math.max(minimum, Math.round(width * scale)), height: Math.max(minimum, Math.round(height * scale)) }
}

export effect function rasterOf(bitmap: Bitmap | undefined, width: number, height: number): Raster!ImageRefused {
  const raster = try Effect.try({ try: () => paint(bitmap, width, height), catch: () => imageRefused("unavailable") })
  if (raster === undefined) throw imageRefused("unavailable")
  return raster
}

export effect function scaledImage(image: Blob, bound: number = maxLongSide, minimum = 1): Raster!ImageRefused {
  return try scoped(effect {
    const bitmap = try decodedImage(image)
    const size = fittedSize(bitmap.width, bitmap.height, bound, minimum)
    return try rasterOf(bitmap, size.width, size.height)
  })
}

export effect function encoded(raster: Raster, type: string, quality?: number): Blob!ImageRefused {
  const blob = try tryPromise({ try: () => raster.encode(type, quality), catch: () => imageRefused("conversion-failed") })
  if (blob === null) throw imageRefused("conversion-failed")
  return blob
}

export effect function readBytes(blob: Blob): Uint8Array<ArrayBuffer>!ImageRefused {
  return try tryPromise({ try: () => bytesOf(blob), catch: () => imageRefused("unavailable") })
}
