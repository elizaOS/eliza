// spec/nativeInference/index.md, "Story: Use a native engine only for an admitted model or recognized image"
import { normalizeRecognizedElement, type RecognizedElement } from "../gen/nativeInference.effect.vibe"

export { AndroidInferenceEngine, androidInferenceEngine, androidInferenceLayer, EngineFailed, EngineUnavailable } from "@elizaos/os"
export type { Capability, EndOfTurnScore, EngineVector, InstalledModel, Pcm, SpeechReadiness, VectorSpace } from "@elizaos/os"

const OcrElement = Schema.Struct({
  text: Schema.String,
  leftPx: Schema.Int,
  topPx: Schema.Int,
  rightPx: Schema.Int,
  bottomPx: Schema.Int,
  confidencePercent: Schema.Int,
})

export error MalformedNativeOcr

export effect function decodeRecognizedElement(input: unknown, dimensions: { readonly widthPx: number; readonly heightPx: number }): RecognizedElement!MalformedNativeOcr {
  const element = Schema.decodeUnknownEffect(OcrElement)(input) catch effect () => { throw new MalformedNativeOcr() }
  if (!Number.isSafeInteger(dimensions.widthPx) || !Number.isSafeInteger(dimensions.heightPx)) throw new MalformedNativeOcr()
  const parsed = normalizeRecognizedElement(element, dimensions.widthPx, dimensions.heightPx)
  if (parsed.tag === "InvalidText") throw new MalformedNativeOcr()
  return element
}
