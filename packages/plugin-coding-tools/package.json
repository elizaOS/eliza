{
  "name": "@elizaos/plugin-coding-tools",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Native Claude-Code/Pi-style coding tools (FILE, READ, WRITE, EDIT, SHELL, WORKTREE, WEB_FETCH, WEB_SEARCH) for Eliza.",
  "license": "MIT",
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@elizaos/core": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  }
}
