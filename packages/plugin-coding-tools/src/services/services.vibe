module node {
  import { execFile, spawn, type ChildProcess } from "node:child_process"
  import * as fs from "node:fs/promises"
  import * as path from "node:path"

  export interface FileStatInfo {
    readonly exists: boolean
    readonly isFile: boolean
    readonly isDirectory: boolean
    readonly ino: number
    readonly size: number
    readonly mtimeMs: number
  }

  export async function statPathNode(target: string): Promise<FileStatInfo> {
    try {
      const info = await fs.stat(target)
      return {
        exists: true,
        isFile: info.isFile(),
        isDirectory: info.isDirectory(),
        ino: info.ino,
        size: info.size,
        mtimeMs: info.mtimeMs,
      }
    } catch {
      return { exists: false, isFile: false, isDirectory: false, ino: 0, size: 0, mtimeMs: 0 }
    }
  }

  export async function existsDirNode(target: string): Promise<boolean> {
    try {
      const info = await fs.stat(target)
      return info.isDirectory()
    } catch {
      return false
    }
  }

  export interface ExecProcessOutput {
    readonly exitCode: number
    readonly stdout: string
    readonly stderr: string
    readonly timedOut: boolean
    readonly signal: string | null
  }

  export function execFileNode(
    executable: string,
    args: readonly string[],
    options: { readonly cwd: string; readonly timeoutMs: number; readonly maxBuffer?: number },
  ): Promise<ExecProcessOutput> {
    return new Promise((resolve) => {
      execFile(
        executable,
        [...args],
        {
          cwd: options.cwd,
          timeout: options.timeoutMs,
          maxBuffer: options.maxBuffer ?? 8 * 1024 * 1024,
          windowsHide: true,
        },
        (error, stdout, stderr) => {
          if (!error) {
            resolve({ exitCode: 0, stdout: String(stdout), stderr: String(stderr), timedOut: false, signal: null })
            return
          }
          const killed = Boolean((error as { killed?: boolean }).killed)
          const signal = (error as { signal?: string | null }).signal ?? null
          const code = typeof (error as { code?: unknown }).code === "number" ? Number((error as { code?: number }).code) : 1
          resolve({
            exitCode: code,
            stdout: String(stdout),
            stderr: String(stderr || error.message),
            timedOut: killed && signal === "SIGTERM",
            signal,
          })
        },
      )
    })
  }

  export function runShellProcessNode(
    command: string,
    options: { readonly cwd: string; readonly timeoutMs: number },
  ): Promise<ExecProcessOutput> {
    const shell = process.platform === "win32" ? "powershell.exe" : (process.env.SHELL?.endsWith("fish") ? "/bin/bash" : (process.env.SHELL || "/bin/sh"))
    const shellArgs = process.platform === "win32" ? ["-NoProfile", "-NonInteractive", "-Command", command] : ["-c", command]
    return execFileNode(shell, shellArgs, { cwd: options.cwd, timeoutMs: options.timeoutMs, maxBuffer: 16 * 1024 * 1024 })
  }

  export interface SpawnedBgChild {
    readonly pid: number | undefined
    readonly writeStdin: (text: string) => boolean
    readonly kill: (sig?: NodeJS.Signals) => boolean
    readonly exited: () => boolean
  }

  export function spawnBgShellNode(
    command: string,
    cwd: string,
    onStdout: (chunk: string) => void,
    onStderr: (chunk: string) => void,
    onExit: (code: number | null, signal: string | null) => void,
  ): SpawnedBgChild {
    const shell = process.platform === "win32" ? "powershell.exe" : "/bin/sh"
    const shellArgs = process.platform === "win32" ? ["-NoProfile", "-NonInteractive", "-Command", command] : ["-c", command]
    const child: ChildProcess = spawn(shell, shellArgs, { cwd, stdio: ["pipe", "pipe", "pipe"], windowsHide: true })
    let hasExited = false
    child.stdout?.on("data", (chunk: Buffer) => onStdout(chunk.toString("utf8")))
    child.stderr?.on("data", (chunk: Buffer) => onStderr(chunk.toString("utf8")))
    child.on("close", (code, sig) => {
      hasExited = true
      onExit(code, sig)
    })
    child.on("error", (err) => {
      onStderr(err.message)
      hasExited = true
      onExit(1, null)
    })
    return {
      pid: child.pid,
      writeStdin: (text: string) => {
        if (hasExited || !child.stdin || !child.stdin.writable) return false
        return child.stdin.write(text, "utf8")
      },
      kill: (sig?: NodeJS.Signals) => {
        if (hasExited) return true
        return child.kill(sig ?? "SIGTERM")
      },
      exited: () => hasExited,
    }
  }

  export async function fallbackGrepWalkNode(params: {
    readonly root: string
    readonly regex: RegExp
    readonly glob?: string
    readonly mode: "content" | "files_with_matches" | "count"
    readonly showLineNumbers: boolean
    readonly contextBefore: number
    readonly contextAfter: number
    readonly headLimit: number
  }): Promise<{ readonly stdout: string; readonly matchCount: number; readonly filesMatched: number }> {
    const excluded = new Set(["node_modules", ".git", "dist", ".turbo", ".spec-cache", ".next"])
    const linesOut: string[] = []
    let matchCount = 0
    let filesMatched = 0

    const matchGlob = (name: string, pattern: string): boolean => {
      const escaped = pattern.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*").replace(/\?/g, ".")
      return new RegExp(`^${escaped}$`).test(name)
    }

    async function searchFile(filePath: string): Promise<void> {
      if (linesOut.length >= params.headLimit) return
      let bytes: Buffer
      try {
        bytes = await fs.readFile(filePath)
      } catch {
        return
      }
      if (bytes.includes(0) || bytes.byteLength > 2 * 1024 * 1024) return
      const text = bytes.toString("utf8")
      const fileLines = text.split("\n")
      const hitIndices: number[] = []
      for (let i = 0; i < fileLines.length; i += 1) {
        params.regex.lastIndex = 0
        if (params.regex.test(fileLines[i])) hitIndices.push(i)
      }
      if (hitIndices.length === 0) return
      filesMatched += 1
      matchCount += hitIndices.length
      if (params.mode === "files_with_matches") {
        linesOut.push(filePath)
        return
      }
      if (params.mode === "count") {
        linesOut.push(`${filePath}:${hitIndices.length}`)
        return
      }
      const emitted = new Set<number>()
      for (const idx of hitIndices) {
        const start = Math.max(0, idx - params.contextBefore)
        const end = Math.min(fileLines.length - 1, idx + params.contextAfter)
        for (let j = start; j <= end; j += 1) {
          if (emitted.has(j)) continue
          emitted.add(j)
          const prefix = params.showLineNumbers ? `${filePath}:${j + 1}:` : `${filePath}:`
          linesOut.push(`${prefix}${fileLines[j]}`)
          if (linesOut.length >= params.headLimit) return
        }
      }
    }

    async function walk(current: string): Promise<void> {
      if (linesOut.length >= params.headLimit) return
      const info = await fs.stat(current).catch(() => undefined)
      if (!info) return
      if (info.isFile()) {
        await searchFile(current)
        return
      }
      if (!info.isDirectory()) return
      const entries = await fs.readdir(current, { withFileTypes: true }).catch(() => [])
      entries.sort((a, b) => a.name.localeCompare(b.name))
      for (const entry of entries) {
        if (linesOut.length >= params.headLimit) return
        if (excluded.has(entry.name)) continue
        const full = path.join(current, entry.name)
        if (entry.isDirectory()) {
          await walk(full)
        } else if (entry.isFile()) {
          if (params.glob && !matchGlob(entry.name, params.glob)) continue
          await searchFile(full)
        }
      }
    }

    await walk(params.root)
    return { stdout: linesOut.join("\n"), matchCount, filesMatched }
  }

  export async function readJsonFileSafeNode(filePath: string): Promise<string | undefined> {
    try {
      return await fs.readFile(filePath, "utf8")
    } catch {
      return undefined
    }
  }

  export async function writeJsonFileSafeNode(filePath: string, content: string): Promise<void> {
    await fs.mkdir(path.dirname(filePath), { recursive: true })
    await fs.writeFile(filePath, content, "utf8")
  }
}

import {
  execFileNode,
  existsDirNode,
  fallbackGrepWalkNode,
  readJsonFileSafeNode,
  runShellProcessNode,
  spawnBgShellNode,
  statPathNode,
  writeJsonFileSafeNode,
  type ExecProcessOutput,
  type FileStatInfo,
  type SpawnedBgChild,
} from node

export { runShellProcessNode, statPathNode, type ExecProcessOutput, type FileStatInfo }

function parseCsvList(raw: string | undefined): string[] {
  if (!raw) return []
  return raw.split(",").map((item) => item.trim()).filter((item) => item.length > 0)
}

function dedupeStrings(items: readonly string[]): string[] {
  return [...new Set(items)].sort()
}

export type SandboxValidation =
  | { readonly ok: true; readonly resolved: string }
  | { readonly ok: false; readonly reason: "blocked" | "invalid"; readonly message: string }

export class SandboxService extends Service {
  static override serviceType = SANDBOX_SERVICE
  override capabilityDescription = "Path safety policy for coding tools. Blocks sensitive paths and enforces configured workspace roots."

  private blockedPaths: string[] = []
  private allowedRoots: string[] = []
  private conversationRoots = new Map<string, Set<string>>()

  static override async start(runtime: IAgentRuntime): Promise<SandboxService> {
    const svc = new SandboxService(runtime)
    await svc.loadConfig()
    return svc
  }

  override async stop(): Promise<void> {
    this.blockedPaths = []
    this.allowedRoots = []
    this.conversationRoots.clear()
  }

  async loadConfig(): Promise<void> {
    const replace = readStringSetting(this.runtime, "CODING_TOOLS_BLOCKED_PATHS")
    const additions = readStringSetting(this.runtime, "CODING_TOOLS_BLOCKED_PATHS_ADD")
    const rootsRaw = readStringSetting(this.runtime, "CODING_TOOLS_WORKSPACE_ROOTS")
    let rawBlocked = replace ? parseCsvList(replace) : defaultBlockedPaths()
    if (additions) rawBlocked = rawBlocked.concat(parseCsvList(additions))
    const resolvedBlocked = await Promise.all(
      rawBlocked.map((p) => resolveRealPathNode(pathResolve(expandHome(p)))),
    )
    this.blockedPaths = dedupeStrings(resolvedBlocked)
    const rawRoots = parseCsvList(rootsRaw)
    const resolvedRoots = await Promise.all(
      rawRoots.map((p) => resolveRealPathNode(pathResolve(expandHome(p)))),
    )
    this.allowedRoots = dedupeStrings(resolvedRoots)
  }

  getBlockedPaths(): string[] {
    return this.blockedPaths.slice()
  }

  getAllowedRoots(conversationId?: string): string[] {
    const extra = conversationId ? [...(this.conversationRoots.get(conversationId) ?? [])] : []
    return dedupeStrings([...this.allowedRoots, ...extra])
  }

  addRoot(conversationId: string | undefined, absPath: string): void {
    if (!conversationId || !isAbsolutePath(absPath) || isUncPath(absPath)) return
    const roots = this.conversationRoots.get(conversationId) ?? new Set<string>()
    roots.add(pathResolve(expandHome(absPath)))
    this.conversationRoots.set(conversationId, roots)
  }

  removeRoot(conversationId: string | undefined, absPath: string): void {
    if (!conversationId) return
    const roots = this.conversationRoots.get(conversationId)
    if (!roots) return
    roots.delete(pathResolve(expandHome(absPath)))
    if (roots.size === 0) this.conversationRoots.delete(conversationId)
  }

  async validatePath(conversationId: string | undefined, inputPath: string): Promise<SandboxValidation> {
    const expanded = expandHome(inputPath)
    const isEmpty = expanded.trim().length === 0
    const hasNul = expanded.includes("\0")
    const unc = isUncPath(expanded)
    if (isEmpty || hasNul || unc || !isAbsolutePath(expanded)) {
      return { ok: false, reason: "invalid", message: `invalid or non-absolute path: ${inputPath}` }
    }
    const traverses = await traversesBlockedPath(expanded)
    const resolved = await resolveRealPathNode(expanded)
    const blockedPseudo = isBlockedPseudoPath(expanded) || isBlockedPseudoPath(resolved)
    const blockedConfigured = this.blockedPaths.some((root) => isWithin(root, resolved))
    const activeRoots = await Promise.all(this.getAllowedRoots(conversationId).map((r) => resolveRealPathNode(r)))
    const hasAllowRoots = activeRoots.length > 0
    const withinAllowedRoot = !hasAllowRoots || activeRoots.some((root) => isWithin(root, resolved))
    const allowed = pathAllowed({
      isEmpty,
      hasNul,
      isUnc: unc,
      isBlocked: blockedPseudo || blockedConfigured,
      traversesBlocked: traverses,
      hasAllowRoots,
      withinAllowedRoot,
    })
    if (!allowed) {
      return {
        ok: false,
        reason: "blocked",
        message: blockedPseudo || blockedConfigured || traverses
          ? `path is blocked by sandbox policy: ${inputPath}`
          : `path is outside allowed workspace roots: ${inputPath}`,
      }
    }
    return { ok: true, resolved }
  }
}

export function fileRevision(stat: FileStatInfo): string {
  return `${stat.ino}:${stat.size}:${Math.trunc(stat.mtimeMs)}`
}

interface TrackedFileEntry {
  readonly meta: FileMeta
  readonly session: FileSession
}

export type WritableGate =
  | { readonly ok: true; readonly exists: boolean; readonly currentRevision?: string }
  | { readonly ok: false; readonly reason: "stale_read" | "unread"; readonly message: string }

export class FileStateService extends Service {
  static override serviceType = FILE_STATE_SERVICE
  override capabilityDescription = "Tracks per-conversation file revisions to prevent stale edits and blind overwrites."

  private sessions = new Map<string, Map<string, TrackedFileEntry>>()

  static override async start(runtime: IAgentRuntime): Promise<FileStateService> {
    return new FileStateService(runtime)
  }

  override async stop(): Promise<void> {
    this.sessions.clear()
  }

  private convMap(conversationId: string): Map<string, TrackedFileEntry> {
    let map = this.sessions.get(conversationId)
    if (!map) {
      map = new Map()
      this.sessions.set(conversationId, map)
    }
    return map
  }

  private saveEntry(
    map: Map<string, TrackedFileEntry>,
    absPath: string,
    stat: FileStatInfo,
    revision: string,
    session: FileSession,
  ): FileMeta {
    const meta: FileMeta = { path: absPath, mtimeMs: stat.mtimeMs, size: stat.size, readAt: Date.now(), revision }
    map.set(absPath, { meta, session })
    return meta
  }

  async recordRead(conversationId: string, absPath: string, statOverride?: FileStatInfo): Promise<FileMeta> {
    const stat = statOverride ?? (await statPathNode(absPath))
    const revision = fileRevision(stat)
    const map = this.convMap(conversationId)
    const prev = map.get(absPath)
    let nextSession = prev ? prev.session : initialFileSession
    if (!nextSession.fileExists) {
      nextSession = canCreateNewFile(nextSession, false) ? createNewFile(nextSession, false) : initialFileSession
    }
    if (prev && prev.meta.revision !== revision && nextSession.fileExists) {
      nextSession = externalModify(nextSession)
    }
    if (canReadFile(nextSession)) {
      nextSession = stepReadFile(nextSession)
    }
    return this.saveEntry(map, absPath, stat, revision, nextSession)
  }

  async recordWrite(conversationId: string, absPath: string, mode: "write" | "edit" = "write"): Promise<FileMeta> {
    const stat = await statPathNode(absPath)
    const revision = fileRevision(stat)
    const map = this.convMap(conversationId)
    const prev = map.get(absPath)
    let nextSession = prev ? prev.session : deleteExternally(initialFileSession)
    if (mode === "edit" && canEditFile(nextSession, false, 1, false)) {
      nextSession = editFile(nextSession, false, 1, false)
    } else if (canWriteExistingFile(nextSession, true, false)) {
      nextSession = writeExistingFile(nextSession, true, false)
    } else if (canCreateNewFile(nextSession, false)) {
      nextSession = createNewFile(nextSession, false)
    } else {
      nextSession = stepReadFile(initialFileSession)
    }
    invalidateFileReadReferences(conversationId, absPath)
    return this.saveEntry(map, absPath, stat, revision, nextSession)
  }

  get(conversationId: string, absPath: string): FileMeta | undefined {
    return this.sessions.get(conversationId)?.get(absPath)?.meta
  }

  async assertWritable(conversationId: string, absPath: string): Promise<WritableGate> {
    const stat = await statPathNode(absPath)
    if (!stat.exists) {
      return { ok: true, exists: false }
    }
    const currentRevision = fileRevision(stat)
    const entry = this.sessions.get(conversationId)?.get(absPath)
    if (!entry) {
      return {
        ok: false,
        reason: "unread",
        message: `file must be read in this conversation before editing or overwriting: ${absPath}`,
      }
    }
    if (entry.meta.revision !== currentRevision) {
      const staled = entry.session.fileExists ? externalModify(entry.session) : entry.session
      this.convMap(conversationId).set(absPath, { meta: entry.meta, session: staled })
      return {
        ok: false,
        reason: "stale_read",
        message: `file changed on disk since last read (${entry.meta.revision} != ${currentRevision}); re-read ${absPath} first`,
      }
    }
    return { ok: true, exists: true, currentRevision }
  }

  invalidate(conversationId: string, absPath: string): void {
    this.sessions.get(conversationId)?.delete(absPath)
    invalidateFileReadReferences(conversationId, absPath)
  }

  clearConversation(conversationId: string): void {
    this.sessions.delete(conversationId)
  }
}

export class SessionCwdService extends Service {
  static override serviceType = SESSION_CWD_SERVICE
  override capabilityDescription = "Tracks per-conversation working directory and git worktree stack."

  private worktrees = new Map<string, WorktreeSession>()

  static override async start(runtime: IAgentRuntime): Promise<SessionCwdService> {
    return new SessionCwdService(runtime)
  }

  override async stop(): Promise<void> {
    this.worktrees.clear()
  }

  defaultCwd(): string {
    const configured = parseCsvList(readStringSetting(this.runtime, "CODING_TOOLS_WORKSPACE_ROOTS"))
    if (configured.length > 0) return pathResolve(expandHome(configured[0]))
    return currentProcessCwd()
  }

  private sessionFor(conversationId: string): WorktreeSession {
    let state = this.worktrees.get(conversationId)
    if (!state) {
      state = { ...initialWorktreeSession, baseCwd: this.defaultCwd() }
      this.worktrees.set(conversationId, state)
    }
    return state
  }

  getCwd(conversationId: string | undefined): string {
    if (!conversationId) return this.defaultCwd()
    return specCurrentCwd(this.sessionFor(conversationId))
  }

  async getExistingCwd(conversationId: string | undefined): Promise<{ readonly cwd: string; readonly fallback: boolean }> {
    const candidate = this.getCwd(conversationId)
    if (await existsDirNode(candidate)) return { cwd: candidate, fallback: false }
    const fallback = this.defaultCwd()
    return { cwd: fallback, fallback: true }
  }

  setCwd(conversationId: string, absPath: string): void {
    const resolved = pathResolve(expandHome(absPath))
    const current = this.sessionFor(conversationId)
    this.worktrees.set(conversationId, { ...current, baseCwd: resolved, stack: [] })
  }

  pushWorktree(conversationId: string, absPath: string): string {
    const resolved = pathResolve(expandHome(absPath))
    const current = this.sessionFor(conversationId)
    if (canEnterWorktree(current, resolved)) {
      const next = specEnterWorktree(current, resolved)
      this.worktrees.set(conversationId, next)
      return specCurrentCwd(next)
    }
    return specCurrentCwd(current)
  }

  popWorktree(conversationId: string, cleanup = false): { readonly entered: string; readonly previousCwd: string } | undefined {
    const current = this.sessionFor(conversationId)
    if (!canExitWorktree(current)) return undefined
    const entered = specCurrentCwd(current)
    const next = specExitWorktree(current, cleanup)
    this.worktrees.set(conversationId, next)
    return { entered, previousCwd: specCurrentCwd(next) }
  }

  worktreeDepth(conversationId: string): number {
    return this.sessionFor(conversationId).stack.length
  }

  getWorktreeState(conversationId: string): WorktreeSession {
    const state = this.sessionFor(conversationId)
    return { baseCwd: state.baseCwd, stack: state.stack.slice(), cleanedCount: state.cleanedCount }
  }
}

export function resolveInputPath(
  runtime: IAgentRuntime,
  conversationId: string | undefined,
  rawPath: string,
): ToolResult<string> {
  const trimmed = rawPath.trim()
  if (trimmed.length === 0) return failure("missing_param", "path is empty")
  const expanded = expandHome(trimmed)
  if (isUncPath(expanded)) return failure("path_blocked", "UNC paths are not allowed")
  if (isAbsolutePath(expanded)) return success(pathResolve(expanded))
  const session = runtime.getService(SESSION_CWD_SERVICE) as SessionCwdService | null
  const base = session ? session.getCwd(conversationId) : currentProcessCwd()
  return success(pathResolve(base, expanded))
}

export async function runGitCommand(args: {
  readonly cwd: string
  readonly gitArgs: readonly string[]
  readonly timeoutMs?: number
}): Promise<ExecProcessOutput> {
  return execFileNode("git", args.gitArgs, {
    cwd: args.cwd,
    timeoutMs: args.timeoutMs ?? 30_000,
  })
}

export type RipgrepMode = "content" | "files_with_matches" | "count"

export interface RipgrepOptions {
  readonly pattern: string
  readonly path: string
  readonly glob?: string
  readonly type?: string
  readonly contextBefore?: number
  readonly contextAfter?: number
  readonly contextAround?: number
  readonly caseInsensitive?: boolean
  readonly multiline?: boolean
  readonly showLineNumbers?: boolean
  readonly headLimit?: number
}

export interface RipgrepResult {
  readonly exitCode: number
  readonly stdout: string
  readonly stderr: string
  readonly engine: "rg" | "fallback"
}

export class RipgrepService extends Service {
  static override serviceType = RIPGREP_SERVICE
  override capabilityDescription = "Fast content search over workspace files via ripgrep with pure-Node fallback."

  static override async start(runtime: IAgentRuntime): Promise<RipgrepService> {
    return new RipgrepService(runtime)
  }

  override async stop(): Promise<void> {}

  async search(options: RipgrepOptions, mode: RipgrepMode): Promise<RipgrepResult> {
    const args: string[] = ["--color=never", "--no-heading"]
    if (mode === "files_with_matches") args.push("--files-with-matches")
    else if (mode === "count") args.push("--count")
    else {
      args.push("--with-filename")
      if (options.showLineNumbers !== false) args.push("--line-number")
      if (options.contextAround !== undefined && options.contextAround > 0) args.push("-C", String(options.contextAround))
      else {
        if (options.contextBefore !== undefined && options.contextBefore > 0) args.push("-B", String(options.contextBefore))
        if (options.contextAfter !== undefined && options.contextAfter > 0) args.push("-A", String(options.contextAfter))
      }
    }
    if (options.caseInsensitive) args.push("-i")
    if (options.multiline) args.push("-U", "--multiline-dotall")
    if (options.glob) args.push("--glob", options.glob)
    if (options.type) args.push("--type", options.type)
    args.push("--glob", "!node_modules/**", "--glob", "!.git/**", "--glob", "!dist/**", "--glob", "!.turbo/**")
    args.push("-e", options.pattern, options.path)

    const rgOut = await execFileNode("rg", args, { cwd: pathDirname(options.path), timeoutMs: 20_000 })
    if (rgOut.exitCode === 0 || rgOut.exitCode === 1) {
      return { exitCode: rgOut.exitCode, stdout: rgOut.stdout, stderr: rgOut.stderr, engine: "rg" }
    }
    const flags = `${options.caseInsensitive ? "i" : ""}${options.multiline ? "s" : ""}`
    const regex = new RegExp(options.pattern, flags)
    const fallback = await fallbackGrepWalkNode({
      root: options.path,
      regex,
      glob: options.glob,
      mode,
      showLineNumbers: options.showLineNumbers !== false,
      contextBefore: options.contextBefore ?? options.contextAround ?? 0,
      contextAfter: options.contextAfter ?? options.contextAround ?? 0,
      headLimit: options.headLimit ?? 500,
    })
    return {
      exitCode: fallback.matchCount > 0 ? 0 : 1,
      stdout: fallback.stdout,
      stderr: "",
      engine: "fallback",
    }
  }
}

const MAX_BG_SESSIONS_PER_CONV = 16
const MAX_BG_SESSIONS_GLOBAL = 128
const MAX_BG_BUFFER_CHARS = 1_000_000

export interface BackgroundShellSessionSnapshot {
  readonly handle: string
  readonly conversationId: string
  readonly command: string
  readonly cwd: string
  readonly status: "running" | "exited" | "killed"
  readonly pid: number | undefined
  readonly startedAt: number
  readonly endedAt?: number
  readonly exitCode: number | null
  readonly signal: string | null
  readonly stdoutTotalChars: number
  readonly stderrTotalChars: number
}

export interface BackgroundShellPollResult {
  readonly snapshot: BackgroundShellSessionSnapshot
  readonly stdout: string
  readonly stderr: string
  readonly nextStdoutOffset: number
  readonly nextStderrOffset: number
}

interface InternalBgSession {
  readonly handle: string
  readonly conversationId: string
  readonly command: string
  readonly cwd: string
  readonly startedAt: number
  readonly child: SpawnedBgChild
  status: "running" | "exited" | "killed"
  endedAt?: number
  exitCode: number | null
  signal: string | null
  stdoutBuf: string
  stderrBuf: string
  specState: ShellSession
}

export class BackgroundShellService extends Service {
  static override serviceType = BACKGROUND_SHELL_SERVICE
  override capabilityDescription = "Manages bounded per-conversation background shell sessions with incremental output polling."

  private sessions = new Map<string, InternalBgSession>()

  static override async start(runtime: IAgentRuntime): Promise<BackgroundShellService> {
    return new BackgroundShellService(runtime)
  }

  override async stop(): Promise<void> {
    for (const session of this.sessions.values()) {
      if (session.status === "running") {
        session.child.kill("SIGTERM")
        session.status = "killed"
      }
    }
    this.sessions.clear()
  }

  startSession(args: {
    readonly conversationId: string
    readonly command: string
    readonly cwd: string
  }): { readonly ok: true; readonly snapshot: BackgroundShellSessionSnapshot } | { readonly ok: false; readonly message: string } {
    if (this.sessions.size >= MAX_BG_SESSIONS_GLOBAL) {
      return { ok: false, message: `global background shell cap reached (${MAX_BG_SESSIONS_GLOBAL})` }
    }
    const convRunning = [...this.sessions.values()].filter(
      (s) => s.conversationId === args.conversationId && s.status === "running",
    ).length
    if (convRunning >= MAX_BG_SESSIONS_PER_CONV) {
      return { ok: false, message: `conversation background shell cap reached (${MAX_BG_SESSIONS_PER_CONV})` }
    }
    const handle = `bg_${newUuid().replace(/-/g, "").slice(0, 16)}`
    let specState = initialShellSession
    if (canStartBackground(specState)) specState = startBackground(specState)

    const session: InternalBgSession = {
      handle,
      conversationId: args.conversationId,
      command: args.command,
      cwd: args.cwd,
      startedAt: Date.now(),
      status: "running",
      exitCode: null,
      signal: null,
      stdoutBuf: "",
      stderrBuf: "",
      specState,
      child: spawnBgShellNode(
        args.command,
        args.cwd,
        (chunk) => {
          if (session.stdoutBuf.length + chunk.length <= MAX_BG_BUFFER_CHARS) {
            session.stdoutBuf += chunk
            const delta = Math.min(Math.max(1, chunk.length), 1000)
            if (canAppendBgOutput(session.specState, delta)) {
              session.specState = appendBgOutput(session.specState, delta)
            }
          }
        },
        (chunk) => {
          if (session.stderrBuf.length + chunk.length <= MAX_BG_BUFFER_CHARS) {
            session.stderrBuf += chunk
          }
        },
        (code, sig) => {
          if (session.status === "running") {
            session.status = "exited"
            if (canExitBackground(session.specState)) {
              session.specState = exitBackground(session.specState)
            }
          }
          session.endedAt = Date.now()
          session.exitCode = code
          session.signal = sig
        },
      ),
    }
    this.sessions.set(handle, session)
    return { ok: true, snapshot: this.toSnapshot(session) }
  }

  private lookupSession(
    conversationId: string,
    handle: string,
  ): { readonly ok: true; readonly session: InternalBgSession } | { readonly ok: false; readonly message: string } {
    const session = this.sessions.get(handle)
    if (!session || session.conversationId !== conversationId) {
      return { ok: false, message: `unknown background session handle: ${handle}` }
    }
    return { ok: true, session }
  }

  poll(args: {
    readonly conversationId: string
    readonly handle: string
    readonly stdoutOffset?: number
    readonly stderrOffset?: number
  }): { readonly ok: true; readonly result: BackgroundShellPollResult } | { readonly ok: false; readonly message: string } {
    const found = this.lookupSession(args.conversationId, args.handle)
    if (!found.ok) return found
    const { session } = found
    const stdoutOffset = Math.max(0, Math.min(Math.floor(args.stdoutOffset ?? 0), session.stdoutBuf.length))
    const stderrOffset = Math.max(0, Math.min(Math.floor(args.stderrOffset ?? 0), session.stderrBuf.length))
    const specOffset = Math.min(stdoutOffset, session.specState.bgStdoutTotal)
    if (canPollBackground(session.specState, specOffset)) {
      session.specState = pollBackground(session.specState, specOffset)
    }
    const rawStdout = session.stdoutBuf.slice(stdoutOffset)
    const rawStderr = session.stderrBuf.slice(stderrOffset)
    return {
      ok: true,
      result: {
        snapshot: this.toSnapshot(session),
        stdout: redactShellText(this.runtime, rawStdout),
        stderr: redactShellText(this.runtime, rawStderr),
        nextStdoutOffset: session.stdoutBuf.length,
        nextStderrOffset: session.stderrBuf.length,
      },
    }
  }

  write(args: {
    readonly conversationId: string
    readonly handle: string
    readonly stdin: string
  }): { readonly ok: true; readonly bytesWritten: number } | { readonly ok: false; readonly message: string } {
    const found = this.lookupSession(args.conversationId, args.handle)
    if (!found.ok) return found
    const { session } = found
    if (session.status !== "running") {
      return { ok: false, message: `background session is not running: ${args.handle}` }
    }
    const ok = session.child.writeStdin(args.stdin)
    if (!ok) return { ok: false, message: `failed to write stdin to ${args.handle}` }
    return { ok: true, bytesWritten: new TextEncoder().encode(args.stdin).byteLength }
  }

  kill(args: {
    readonly conversationId: string
    readonly handle: string
  }): { readonly ok: true; readonly snapshot: BackgroundShellSessionSnapshot } | { readonly ok: false; readonly message: string } {
    const found = this.lookupSession(args.conversationId, args.handle)
    if (!found.ok) return found
    const { session } = found
    if (session.status === "running") {
      session.child.kill("SIGTERM")
      session.status = "killed"
      session.endedAt = Date.now()
      if (canKillBackground(session.specState)) {
        session.specState = killBackground(session.specState)
      }
    }
    return { ok: true, snapshot: this.toSnapshot(session) }
  }

  list(conversationId: string): BackgroundShellSessionSnapshot[] {
    return [...this.sessions.values()]
      .filter((s) => s.conversationId === conversationId)
      .sort((a, b) => a.handle.localeCompare(b.handle))
      .map((s) => this.toSnapshot(s))
  }

  private toSnapshot(session: InternalBgSession): BackgroundShellSessionSnapshot {
    return {
      handle: session.handle,
      conversationId: session.conversationId,
      command: redactShellText(this.runtime, session.command),
      cwd: redactShellText(this.runtime, session.cwd),
      status: session.status,
      pid: session.child.pid,
      startedAt: session.startedAt,
      ...(session.endedAt === undefined ? {} : { endedAt: session.endedAt }),
      exitCode: session.exitCode,
      signal: session.signal,
      stdoutTotalChars: session.stdoutBuf.length,
      stderrTotalChars: session.stderrBuf.length,
    }
  }
}

export const DEFAULT_SAFE_BINS: readonly string[] = [
  "cat", "cut", "diff", "echo", "find", "git", "grep", "head", "jq", "ls",
  "pwd", "rg", "sed", "sort", "stat", "tail", "tr", "uniq", "wc", "which",
]

export interface ExecAllowlistEntry {
  readonly id: string
  readonly pattern: string
  readonly addedAt: number
}

export interface ExecCommandAnalysis {
  readonly executable: string
  readonly args: readonly string[]
  readonly safeBin: boolean
  readonly allowlisted: boolean
}

export class ExecApprovalService extends Service {
  static override serviceType = EXEC_APPROVAL_SERVICE
  override capabilityDescription = "Analyzes shell commands and evaluates per-agent exec approval allowlists."

  private allowlist: ExecAllowlistEntry[] = []

  static override async start(runtime: IAgentRuntime): Promise<ExecApprovalService> {
    return new ExecApprovalService(runtime)
  }

  override async stop(): Promise<void> {
    this.allowlist = []
  }

  addAllowlistEntry(pattern: string): ExecAllowlistEntry {
    const entry: ExecAllowlistEntry = { id: newUuid(), pattern: pattern.trim(), addedAt: Date.now() }
    this.allowlist.push(entry)
    return entry
  }

  getAllowlist(): readonly ExecAllowlistEntry[] {
    return this.allowlist.slice()
  }

  analyzeCommand(command: string): ExecCommandAnalysis {
    const tokens = splitShellArgs(command) ?? []
    const executable = (tokens[0] ?? "").split("/").pop() ?? ""
    const args = tokens.slice(1)
    const safeBin = DEFAULT_SAFE_BINS.includes(executable)
    const allowlisted = this.allowlist.some((entry) => command.trim().startsWith(entry.pattern))
    return { executable, args, safeBin, allowlisted }
  }

  async persistAllowlist(filePath: string): Promise<void> {
    await writeJsonFileSafeNode(filePath, JSON.stringify({ allowlist: this.allowlist }, null, 2))
  }

  async loadAllowlist(filePath: string): Promise<void> {
    const raw = await readJsonFileSafeNode(filePath)
    if (!raw) return
    try {
      const parsed = JSON.parse(raw) as { allowlist?: ExecAllowlistEntry[] }
      if (Array.isArray(parsed.allowlist)) this.allowlist = parsed.allowlist
    } catch {
      return
    }
  }
}

export interface CommandHistoryEntry {
  readonly command: string
  readonly cwd: string
  readonly exitCode: number
  readonly timestamp: number
  readonly stdoutPreview: string
}

export class ShellService extends Service {
  static override serviceType = SHELL_SERVICE
  override capabilityDescription = "Executes shell commands and records per-conversation redacted command history."

  private history = new Map<string, CommandHistoryEntry[]>()

  static override async start(runtime: IAgentRuntime): Promise<ShellService> {
    return new ShellService(runtime)
  }

  override async stop(): Promise<void> {
    this.history.clear()
  }

  recordHistory(conversationId: string, entry: CommandHistoryEntry): void {
    const list = this.history.get(conversationId) ?? []
    list.push({
      ...entry,
      command: redactShellText(this.runtime, entry.command),
      cwd: redactShellText(this.runtime, entry.cwd),
      stdoutPreview: redactShellText(this.runtime, entry.stdoutPreview).slice(0, 400),
    })
    if (list.length > 50) list.splice(0, list.length - 50)
    this.history.set(conversationId, list)
  }

  getHistory(conversationId: string, limit?: number): readonly CommandHistoryEntry[] {
    const list = this.history.get(conversationId) ?? []
    if (limit !== undefined && limit > 0) return list.slice(-limit)
    return list.slice()
  }

  clearHistory(conversationId: string): void {
    this.history.delete(conversationId)
  }

  async execute(command: string, cwd: string, timeoutMs = 120_000): Promise<ExecProcessOutput> {
    return runShellProcessNode(command, { cwd, timeoutMs })
  }
}

export function detectTerminalSupported(env: Readonly<Record<string, string | undefined>>): boolean {
  const variant = (env.ELIZA_BUILD_VARIANT ?? "").trim().toLowerCase()
  if (variant === "store") return false
  const platform = (env.ELIZA_PLATFORM ?? "").trim().toLowerCase()
  const mobile = platform === "android" || platform === "ios" || Boolean(env.ANDROID_ROOT || env.ANDROID_DATA)
  if (!mobile) return true
  return platform === "android" && (env.ELIZA_RUNTIME_MODE ?? "").trim().toLowerCase() === "local-yolo"
}

export function platformShellDialect(): "posix" | "powershell" {
  return osPlatform() === "win32" ? "powershell" : "posix"
}
