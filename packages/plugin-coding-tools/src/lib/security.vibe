// spec/codingTools/index.md, "Sandbox path policy blocks sensitive locations, pseudo-descriptors, and escapes outside configured roots"; spec/codingTools/shellSession.md, "Destructive commands require a bound, unexpired, single-use confirmation challenge"; spec/codingTools/shellSession.md, "Background stdin reaches a command interpreter only through the command policy"
import type { ActionResult, AppliedEffectReceipt, HandlerCallback, IAgentRuntime, Memory, ProviderDataRecord } from "@elizaos/core"
import { ElizaError } from "@elizaos/core"
import { canConsumeChallenge, canIssueChallenge, consumeChallenge, initial as initialShellSession, issueChallenge, type ShellSession } from "../../gen/codingTools__shellSession.effect.vibe"
import { finalLineEnding, successActionResult } from "./format.vibe"

module node {
  import { createHash, randomBytes, randomUUID } from "node:crypto"
  import * as fs from "node:fs/promises"
  import { homedir } from "node:os"
  import * as path from "node:path"

  export function osHomeDir(): string {
    return homedir()
  }

  export function osPlatform(): string {
    return process.platform
  }

  export function envVar(name: string): string | undefined {
    return process.env[name]
  }

  export function currentProcessCwd(): string {
    return process.cwd()
  }

  export function pathResolve(...parts: string[]): string {
    return path.resolve(...parts)
  }

  export function pathJoin(...parts: string[]): string {
    return path.join(...parts)
  }

  export function pathDirname(p: string): string {
    return path.dirname(p)
  }

  export function pathRelative(from: string, to: string): string {
    return path.relative(from, to)
  }

  export function pathIsAbsolute(p: string): boolean {
    return path.isAbsolute(p)
  }

  export function pathSep(): string {
    return path.sep
  }

  export function sha256Hex(value: string | Uint8Array): string {
    return createHash("sha256").update(value).digest("hex")
  }

  export function randomTokenBase64Url(bytes = 18): string {
    return randomBytes(bytes).toString("base64url")
  }

  export function newUuid(): string {
    return randomUUID()
  }

  export async function resolveRealPathNode(target: string): Promise<string> {
    const resolved = path.resolve(target)
    try {
      return await fs.realpath(resolved)
    } catch {
      const parent = path.dirname(resolved)
      if (parent === resolved) return resolved
      const realParent = await resolveRealPathNode(parent)
      return path.join(realParent, path.basename(resolved))
    }
  }

  export async function readFileBytesNode(target: string): Promise<Uint8Array> {
    return fs.readFile(target)
  }

  export async function readLinkSafeNode(target: string): Promise<string | undefined> {
    try {
      return await fs.readlink(target)
    } catch {
      return undefined
    }
  }
}

import {
  currentProcessCwd,
  envVar,
  newUuid,
  osHomeDir,
  osPlatform,
  pathDirname,
  pathIsAbsolute,
  pathJoin,
  pathRelative,
  pathResolve,
  pathSep,
  randomTokenBase64Url,
  readFileBytesNode,
  readLinkSafeNode,
  resolveRealPathNode,
  sha256Hex,
} from node

export {
  currentProcessCwd,
