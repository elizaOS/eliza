export effect function readWorkspaceFile(workspace: WorkspaceDirectory, relativePath: string) {
  const file = try resolveWorkspaceFile(workspace, relativePath)
  const fs = try FileSystem
  const details = try fs.stat(file)
  if (details.type !== "File") throw new WorkspaceDenied({ target: relativePath })
  const contents = try fs.readFileString(file)
  const afterRead = try fs.stat(file)
  const revision = versionOf(details)
  if (revision !== versionOf(afterRead)) throw new StaleWorkspaceFile({ target: relativePath })
  return { contents, revision }
}

export effect function runWorkspaceCommand(workspace: WorkspaceDirectory, request: {
  readonly argv: readonly [string, ...string[]]
  readonly needsApproval: boolean
  readonly approvedKey: string
}) {
  const fs = try FileSystem
  const root = try fs.realPath(workspace.root)
  const commandKey = JSON.stringify([root, ...request.argv])
  if (!mayRunCommand(workspace.access, { inWorkspace: root, commandKey, needsApproval: request.needsApproval }, request.approvedKey)) {
    throw new WorkspaceDenied({ target: root })
  }
  const [executable, ...args] = request.argv
  const runner = try ChildProcessSpawner
  return try runner.string(ChildProcess.make(executable, args, { cwd: root, shell: false }))
}

export effect function editWorkspaceFile(workspace: WorkspaceDirectory, relativePath: string, revision: string, replacement: string) {
  const fs = try FileSystem
  const file = try resolveWorkspaceFile(workspace, relativePath)
  const root = try fs.realPath(workspace.root)
  const details = try fs.stat(file)
  if (details.type !== "File" || !mayEditFile(workspace.access, { workspaceKey: root, fileKey: file, revision: versionOf(details), protectedPath: false }, revision)) {
    throw new StaleWorkspaceFile({ target: relativePath })
  }
  const path = try Path
  return try scoped(effect {
    const staged = try fs.makeTempFileScoped({ directory: path.dirname(file) })
    try fs.writeFileString(staged, replacement)
    try fs.chmod(staged, details.mode)
    const current = try fs.stat(file)
    if (versionOf(current) !== revision) throw new StaleWorkspaceFile({ target: relativePath })
    try fs.rename(staged, file)
    return { revision: versionOf(try fs.stat(file)) }
  })
}

effect function resolveWorkspaceFile(workspace: WorkspaceDirectory, relativePath: string) {
  const fs = try FileSystem
  const path = try Path
  const root = try fs.realPath(workspace.root)
  if (relativePath === "" || path.isAbsolute(relativePath)) throw new WorkspaceDenied({ target: relativePath })
  const absolute = try fs.realPath(path.resolve(root, relativePath))
  const relative = path.relative(root, absolute)
  const protectedPath = relative === "" || path.isAbsolute(relative) || relative.split(path.sep).some(
    (part) => part === ".." || part === ".git" || part === ".ssh" || part === ".env" || part.startsWith(".env."),
  )
  if (!mayReadFile(workspace.access, { workspaceKey: root, fileKey: absolute, revision: "", protectedPath })) {
    throw new WorkspaceDenied({ target: relativePath })
  }
  return absolute
}

function versionOf(file: FileSystem.File.Info) {
  return String(file.ino) + ":" + String(file.size) + ":" + (Option.isSome(file.mtime) ? String(file.mtime.value.getTime()) : "")
}

function isFeatureFlagEnabled(feature: unknown): boolean {
  if (feature === true) return true
  return typeof feature === "object" && feature !== null && (feature as { enabled?: unknown }).enabled !== false
}

export const codingToolsPlugin: Plugin = {
  name: "@elizaos/plugin-coding-tools",
  description: "Native coding tools: READ, WRITE, EDIT, FILE (grep/glob/ls), SHELL (run/background/artifacts/history), WORKTREE, WEB_FETCH, WEB_SEARCH.",
  services: [
    ShellService,
    ExecApprovalService,
    BackgroundShellService,
    FileStateService,
    SandboxService,
    SessionCwdService,
    RipgrepService,
  ],
  providers: [availableToolsProvider, shellHistoryProvider],
  actions: [
    readAction,
    writeAction,
    editAction,
    fileAction,
    shellAction,
    worktreeAction,
    webFetchAction,
    webSearchAction,
  ],
  init: async (_config, _runtime: IAgentRuntime) => {},
  dispose: async (runtime: IAgentRuntime) => {
    const types = [
      SHELL_SERVICE,
      EXEC_APPROVAL_SERVICE,
      BACKGROUND_SHELL_SERVICE,
      SANDBOX_SERVICE,
      FILE_STATE_SERVICE,
      SESSION_CWD_SERVICE,
      RIPGREP_SERVICE,
    ]
    for (const serviceType of types) {
      const svc = runtime.getService(serviceType) as { stop?: () => Promise<void> } | null
      if (svc && typeof svc.stop === "function") await svc.stop()
    }
  },
  autoEnable: {
    shouldEnable: (env, config) => {
      const features = config.features as Record<string, unknown> | undefined
      return (
        (isFeatureFlagEnabled(features?.codingTools) ||
          isFeatureFlagEnabled(features?.["coding-agent"]) ||
          isFeatureFlagEnabled(features?.shell)) &&
        detectTerminalSupported(env)
      )
    },
  },
}

export const plugin = codingToolsPlugin
export default codingToolsPlugin
