// spec/knowledge/index.md, "Story: Find and manage the documents I am allowed to use"
import { Service, type IAgentRuntime, type Plugin } from "@elizaos/core"
import {
  documentManageable,
  documentReadable,
  searchableDocuments,
  visibleDocuments,
  type KnowledgeDocument,
} from "../gen/knowledge.effect.vibe"
import {
  DocumentUrlFetcher,
  handleKnowledgeRoute,
  InMemoryKnowledgeRepository,
  KnowledgeRouteFailure,
  type KnowledgeRepository,
  type KnowledgeRouteRequest,
  type KnowledgeRouteResponse,
} from "./routes.vibe"

export {
  getDocumentContentType,
  getDocumentDeleteability,
  getDocumentEditability,
  getDocumentProvenance,
  getDocumentTitleFromMetadata,
  getDocumentVisibilityScope,
  isDocumentTextBacked,
  normalizeDocumentSource,
  presentDocument,
  type DocumentProvenance,
  type DocumentProvenanceKind,
  type PresentedDocument,
} from "./presenter.vibe"

export {
  DOCUMENT_UPLOAD_MAX_BODY_BYTES,
  DocumentUrlFetcher,
  handleKnowledgeRoute,
  InMemoryKnowledgeRepository,
  KnowledgeRouteFailure,
  resolveTrustedLocalDocumentAccessContext,
  validateDocumentContentType,
  type DocumentAccessContext,
  type KnowledgeRepository,
  type KnowledgeRouteRequest,
  type KnowledgeRouteResponse,
  type StoredKnowledgeDocument,
} from "./routes.vibe"

export error DocumentStoreUnavailable { reason: string }
export error DocumentMissingOrDenied { docId: string }

export service KnowledgeStore {
  list(viewerId: string): KnowledgeDocument[]!DocumentStoreUnavailable
  document(viewerId: string, docId: string): (KnowledgeDocument | undefined)!DocumentStoreUnavailable
  setPinned(ownerId: string, docId: string, pinned: boolean): boolean!DocumentStoreUnavailable
}

export effect function listDocuments(viewerId: string, indexedOnly: boolean) {
  if (viewerId === "") return []
  const rows = try (try KnowledgeStore).list(viewerId)
  return indexedOnly ? searchableDocuments(rows, viewerId) : visibleDocuments(rows, viewerId)
}

export effect function readDocument(viewerId: string, docId: string) {
  if (viewerId === "" || docId === "") throw new DocumentMissingOrDenied({ docId })
  const row = try (try KnowledgeStore).document(viewerId, docId)
  if (row === undefined || row.docId !== docId || !documentReadable(row, viewerId)) {
    throw new DocumentMissingOrDenied({ docId })
  }
  return row
}

export effect function pinDocument(ownerId: string, docId: string, pinned: boolean) {
  const row = try readDocument(ownerId, docId)
  if (!documentManageable(row, ownerId)) throw new DocumentMissingOrDenied({ docId })
  return try (try KnowledgeStore).setPinned(ownerId, docId, pinned)
}

export class KnowledgeService extends Service {
  static override serviceType = "knowledge"
  override capabilityDescription = "Stores, searches, presents, and governs owner-scoped knowledge documents."
  readonly repository: KnowledgeRepository

  constructor(runtime?: IAgentRuntime, repository: KnowledgeRepository = new InMemoryKnowledgeRepository()) {
    super(runtime)
    this.repository = repository
  }

  static override start(runtime: IAgentRuntime): Promise<KnowledgeService> {
    return Promise.resolve(new KnowledgeService(runtime))
  }

  override stop(): Promise<void> {
    return Promise.resolve()
  }

  handleRoute(
    request: KnowledgeRouteRequest,
    urlFetcher?: Layer.Layer<DocumentUrlFetcher>,
  ): Promise<KnowledgeRouteResponse> {
    const fetcherLayer = urlFetcher ?? Layer.succeed(DocumentUrlFetcher, {
      fetch: () => effect { throw new KnowledgeRouteFailure({ reason: "No URL fetcher configured." }) },
    })
    return Effect.runPromise(
      Effect.provide(handleKnowledgeRoute(this.repository, { ...request, runtime: request.runtime ?? this.runtime }), fetcherLayer),
    )
  }
}

export const knowledgePlugin: Plugin = {
  name: "@elizaos/plugin-knowledge",
  description: "Owner-scoped knowledge document storage, presentation, search, and management routes.",
  services: [KnowledgeService],
  actions: [],
  async dispose(runtime) {
    const svc = runtime.getService<KnowledgeService>(KnowledgeService.serviceType)
    await svc?.stop()
  },
}

export default knowledgePlugin
