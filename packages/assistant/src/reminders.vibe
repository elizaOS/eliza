// spec/assistant/reminders.md, "Story: Create the reminder I asked for, and only that"; spec/assistant/reminders.md, "The original message is checked before a reminder is written"; spec/assistant/reminders.md, "A reminder is written at most once, and a refusal writes nothing"; spec/assistant/reminders.md, "The written reminder keeps the planned clock"; spec/assistant/reminders.md, "A known delivery choice is kept, and only an unknown one is taken from the message"; spec/assistant/reminderPresentation.md, "Story: Carry an exact saved reminder to its delivery"; spec/assistant/replies.md, "A claim that something was not done needs a cited result that failed and was not superseded"; spec/assistant/reminderEscalation.md, "Story: Nudge me again about a reminder I did not answer, never in my quiet hours"; spec/assistant/reminders.md, "Story: Take back the reminder I just saved"; spec/assistant/reminders.md, "A retraction takes back only the reminder this conversation just saved, from a later message within five minutes"; spec/assistant/reminderEscalation.md, "A reminder, nudge or check-in that may have reached the owner is never sent again"; spec/assistant/reminders.md, "Story: Move the reminder I just saved"; spec/assistant/reminders.md, "A delay moves a waiting reminder to that long after the request, and anything else changes nothing"
import { createReminderPresentation, type Action, type ActionResult, type IAgentRuntime, type Memory, type Provider, type UUID } from "@elizaos/core"
import { Machine, machine, moveAdmitted, movedDueAt, maxMoveDelayMs, recoveredChoice, retractsRecentSave, type DeliveryChoice, type ReminderClock, type ReminderIntent } from "../gen/assistant__reminders.effect.vibe"
import {
  Facts, Model, Scheduler, SchedulerUnavailable, onAgent, presentOnce, readRecord, removeRecord, writeRecord,
  type DeliveryAnswer, type TaskRow, type TaskVerb, type VerbAnswer,
} from "./host.vibe"
import { changeEscalation, scheduleEscalation } from "./escalation.vibe"
import { appliedReceipt, attributed, failedReceipt, unchangedReceipt, type Attempt } from "./replies.vibe"
import { ReminderAnswer, ReminderCheck, ReminderEscalation, ReminderPlan } from "./requests.schema.vibe"
import { ownerClockAt } from "./timezone.vibe"

import { fireTimeText, offsetInstant, wallText, zonedInstant } from "./time.vibe"

/** The scheduled-task kind of a saved one-shot reminder. */
export const reminderKind = "personal-assistant.reminder"

const destinationChoice = { chat: "FirstChoice", device: "SecondChoice" } as const satisfies Record<string, DeliveryChoice>
const alertChoice = { alert: "FirstChoice", silent: "SecondChoice" } as const satisfies Record<string, DeliveryChoice>
const choiceOf = <K extends string>(table: Readonly<Record<K, DeliveryChoice>>, value: K | null): DeliveryChoice => value === null ? "UnknownChoice" : table[value]
const destinationOf = (choice: DeliveryChoice) => choice === "SecondChoice" ? "device" : "chat"

const decodePlan = Schema.decodeUnknownOption(ReminderPlan, { onExcessProperty: "error" })
const decodeCheck = Schema.decodeUnknownOption(Schema.fromJsonString(ReminderCheck))

const checkSystem = [
  "You re-read the owner's own message before a reminder is saved. A planner's plan never grants that authority: only the message does.",
  "Say whether the message itself explicitly asks the assistant to remind the owner, or to set a reminder or alarm for them.",
  "A negated, quoted, hypothetical, reported or third-party mention of a reminder is not a request, and neither is a question about reminders.",
  "clock is owner_local when the message names a wall time or day on the owner's clock, and utc when it names only a duration or an instant with its offset.",
  "destination is device when the message asks for the phone's own reminder app, chat when it asks to be reminded here, and null when it says neither.",
  "alert is silent when the message asks for no alert or no notification, alert when it asks to be alerted or notified, and null when it says neither.",
  'Reply with one JSON object and nothing else: {"requested": boolean, "clock": "utc" | "owner_local", "destination": "chat" | "device" | null, "alert": "alert" | "silent" | null}.',
].join("\n")

/** The owner's message read again for what it asks, or undefined when the check could not run. */
export effect function checkOriginalMessage(text: string) {
  if (text.trim() === "") return undefined
  const model = try Model
  const said = model.complete(checkSystem, text) catch () => ""
  const check = decodeCheck(said.trim().replace(/^```(?:json)?\s*|\s*```$/gu, ""))
  return Option.isSome(check) ? check.value : undefined
}

function durationWords(minutes: number): string {
  const parts: string[] = []
  const days = Math.floor(minutes / 1440)
  const hours = Math.floor((minutes % 1440) / 60)
  const rest = minutes % 60
  if (days > 0) parts.push(`${days} ${days === 1 ? "day" : "days"}`)
  if (hours > 0) parts.push(`${hours} ${hours === 1 ? "hour" : "hours"}`)
  if (rest > 0) parts.push(`${rest} ${rest === 1 ? "minute" : "minutes"}`)
  return parts.join(" ")
}

/** Where a request to save a reminder came from: the owner's own message. */
export interface ReminderRequest {
  readonly plan: unknown
  readonly messageId: string
  readonly text: string
  readonly roomId: UUID | undefined
}

/** What became of a request to save a reminder. */
export type ReminderOutcome =
  | { readonly kind: "malformed" }
  | { readonly kind: "notRequested"; readonly intent: ReminderIntent }
  | { readonly kind: "unverified"; readonly intent: ReminderIntent }
  | { readonly kind: "askAlert"; readonly intent: ReminderIntent }
  | { readonly kind: "badTime"; readonly intent: ReminderIntent }
  | { readonly kind: "past"; readonly intent: ReminderIntent }
  | { readonly kind: "settled"; readonly intent: ReminderIntent; readonly attempts: readonly Attempt[]; readonly target: string; readonly said: string; readonly taskId: string | undefined }

const saveAction = "OWNER_REMINDERS"

const RecentSave = Schema.Struct({ taskId: Schema.String, title: Schema.String, messageId: Schema.String, savedAt: Schema.Number })
const decodeRecentSave = Schema.decodeUnknownOption(RecentSave)
const recentSaveKey = (roomId: string) => `reminder-recent-save:${roomId}`

/** Saves the reminder the plan proposes, only after the owner's own message is checked again, at most once per message. */
export effect function createReminder(request: ReminderRequest) {
  const planned = decodePlan(request.plan)
  if (Option.isNone(planned)) return { kind: "malformed" } satisfies ReminderOutcome
  const plan = planned.value
  const check = try checkOriginalMessage(request.text)
  const host = try Facts
  const now = try host.now()
  const zone = try ownerClockAt(now)
  provide machine() {
    const intent = try Machine
    const send = (event: Parameters<Machine.Shape["send"]>[0]) => orDie(intent.send(event))
    const plannedClock: ReminderClock = plan.due.kind === "local" ? "OwnerLocalClock" : "UtcClock"
    try send({
      type: "proposeReminder", requested: check?.requested ?? false, plannedClock,
      extractedClock: check?.clock === "owner_local" ? "OwnerLocalClock" : "UtcClock",
      plannedDestination: choiceOf(destinationChoice, plan.destination), extractedDestination: choiceOf(destinationChoice, check?.destination ?? null),
      plannedAlert: choiceOf(alertChoice, plan.alert), extractedAlert: choiceOf(alertChoice, check?.alert ?? null),
    })
    const checked = try send(check === undefined ? { type: "checkUnavailable" } : { type: "checkRequest" })
    if (checked.reminderPhase !== "IntentReady") {
      return { kind: check === undefined ? "unverified" : "notRequested", intent: checked } satisfies ReminderOutcome
    }
    const alert = recoveredChoice(checked.plannedAlert, checked.extractedAlert)
    if (alert === "UnknownChoice") return { kind: "askAlert", intent: try send({ type: "cancelReminder" }) } satisfies ReminderOutcome
    const due = plan.due
    const at = due.kind === "in" ? now + due.minutes * 60_000 : due.kind === "at" ? offsetInstant(due.instant) : zonedInstant(due.date, due.time, zone)
    if (at === undefined) return { kind: "badTime", intent: try send({ type: "cancelReminder" }) } satisfies ReminderOutcome
    if (at <= now) return { kind: "past", intent: try send({ type: "cancelReminder" }) } satisfies ReminderOutcome
    const destination = destinationOf(recoveredChoice(checked.plannedDestination, checked.extractedDestination))
    const key = `reminder:${request.messageId}`
    const facts = { operation: "reminder.create", kind: "reminder", id: key, key }
    const scheduler = try Scheduler
    const task = {
      kind: reminderKind, ownerVisible: true, promptInstructions: plan.title, idempotencyKey: key,
      trigger: { kind: "once", atIso: new Date(at).toISOString() } as const,
      metadata: {
        title: plan.title, body: plan.body ?? "", destination, alert: alert === "SecondChoice" ? "silent" : "alert",
        clock: checked.plannedClock, zone, roomId: request.roomId ?? null, requestMessageId: request.messageId,
      },
    }
    const attempts: Attempt[] = []
    let taskId: string | undefined
    for (const round of [1, 2]) {
      const made = scheduler.create(task) catch (refused) => refused
      if (made instanceof SchedulerUnavailable) {
        attempts.push({ actionName: saveAction, success: false, receipts: [failedReceipt({ ...facts, at: now + round }, "SCHEDULER_UNAVAILABLE", "unknown")] })
        continue
      }
      attempts.push({ actionName: saveAction, success: true, receipts: [appliedReceipt({ ...facts, at: now + round }, !made.created)] })
      taskId = made.task.taskId
      break
    }
    const settled = try send(taskId === undefined ? { type: "cancelReminder" } : { type: "saveReminder" })
    if (taskId !== undefined && request.roomId !== undefined) {
      try writeRecord(recentSaveKey(request.roomId), { taskId, title: plan.title, messageId: request.messageId, savedAt: now } satisfies typeof RecentSave.Type)
    }
    const when = due.kind === "in" ? `in ${durationWords(due.minutes)}, at ${wallText(at, zone)}` : `at ${wallText(at, zone)} (${zone})`
    return { kind: "settled", intent: settled, attempts, target: "reminder:" + key, said: `I'll remind you: "${plan.title}" ${when}.`, taskId } satisfies ReminderOutcome
  }
}

/** The action result that tells the owner what became of the reminder request, claiming only what the attempts prove. */
export function reminderReply(outcome: ReminderOutcome): ActionResult {
  switch (outcome.kind) {
    case "malformed": return { success: false, text: "The reminder plan was incomplete, so no reminder was saved.", data: { outcome: "REMINDER_PLAN_INVALID" } }
    case "notRequested": return { success: false, text: "I didn't save a reminder because your message didn't ask me to remind you.", data: { outcome: "OWNER_REMINDER_INTENT_MISMATCH" } }
    case "unverified": return { success: false, text: "I couldn't confirm from your message that you asked for a reminder, so no reminder was saved.", data: { outcome: "OWNER_REMINDER_INTENT_UNVERIFIED" } }
    case "askAlert": return { success: false, text: "Should this reminder alert you, or only keep the due time without an alert?", data: { outcome: "REMINDER_ALERT_PREFERENCE_UNRESOLVED" } }
    case "badTime": return { success: false, text: "I couldn't read that reminder time. When should I remind you?", data: { outcome: "REMINDER_TIME_INVALID" } }
    case "past": return { success: false, text: "That reminder time has already passed. When should I remind you?", data: { outcome: "REMINDER_TIME_PASSED" } }
    case "settled": return attributed(outcome.attempts, outcome.target, {
      done: outcome.said,
      notDone: "The reminder couldn't be saved, so you won't be reminded.",
      unproven: "I couldn't confirm the reminder was saved. Check your reminders before relying on it.",
    }, { taskId: outcome.taskId ?? null })
  }
}

function metadataText(task: TaskRow, name: string): string {
  const value = task.metadata[name]
  return typeof value === "string" ? value : ""
}

/** Presents a fired reminder to the owner as the exact presentation issued for it, schedules its escalation steps, and says how the delivery went. */
export effect function deliverReminder(task: TaskRow) {
  const body = metadataText(task, "body").trim() || metadataText(task, "title").trim() || task.promptInstructions.trim()
  const presentation = Effect.try({ try: () => createReminderPresentation(body, body, "Reminder"), catch: () => "unpresentable" }) catch () => undefined
  if (presentation === undefined) return { kind: "undeliverable", error: "The reminder has no text to present" } satisfies DeliveryAnswer
  const room = task.metadata.roomId
  const answer = try presentOnce({ taskId: task.taskId, kind: task.kind, roomId: typeof room === "string" ? room as UUID : undefined, presentation })
  if (answer.kind === "delivered") scheduleEscalation(task) catch () => undefined
  return answer
}

const live = new Set(["Scheduled", "Fired", "Acknowledged"])

/** The owner's saved reminders that have not settled. */
export effect function liveReminders() {
  const scheduler = try Scheduler
  return (try scheduler.list()).filter((task) => task.kind === reminderKind && live.has(task.status))
}

function verbOf(answer: ReminderAnswer): TaskVerb {
  switch (answer.op) {
    case "complete": return { tag: "Complete" }
    case "dismiss": return { tag: "Dismiss" }
    case "acknowledge": return { tag: "Acknowledge" }
    case "snooze": return { tag: "SnoozeFor", minutes: answer.minutes ?? 10 }
  }
}

const said = { complete: "Marked done", dismiss: "Dismissed", acknowledge: "Acknowledged", snooze: "Snoozed" } as const
const decodeAnswer = Schema.decodeUnknownOption(ReminderAnswer, { onExcessProperty: "error" })
const decodeEscalation = Schema.decodeUnknownOption(ReminderEscalation, { onExcessProperty: "error" })

/** The live reminders a target names: by id, or by its whole title. */
export effect function namedReminders(target: string) {
  const name = target.trim().toLowerCase()
  return (try liveReminders()).filter((task) => task.taskId === target || task.promptInstructions.trim().toLowerCase() === name)
}

function unmatched(op: string, target: string, matches: readonly TaskRow[], key: string, at: number): ActionResult {
  const receipt = unchangedReceipt({ operation: `reminder.${op}`, kind: "reminder", id: target, key, at }, matches.length === 0 ? "no_match" : "ambiguous")
  return {
    success: false, effectReceipts: [receipt],
    text: matches.length === 0 ? `No live reminder is called "${target}", so nothing was changed.`
      : `${matches.length} reminders match "${target}", so nothing was changed. Which one did you mean: ${matches.map((task) => `"${task.promptInstructions}"`).join(", ")}?`,
    data: { outcome: matches.length === 0 ? "not_found" : "ambiguous", target: `reminder:${target}`, candidates: matches.map((task) => task.taskId) },
  }
}

/** Completes, dismisses, snoozes or acknowledges the one live reminder the owner named, once per message. */
export effect function answerReminder(input: unknown, messageId: string) {
  const decoded = decodeAnswer(input)
  if (Option.isNone(decoded)) return { success: false, text: "Say which reminder and what to do with it.", data: { outcome: "REMINDER_ANSWER_INVALID" } } satisfies ActionResult
  const answer = decoded.value
  const matches = try namedReminders(answer.target)
  const host = try Facts
  const at = try host.now()
  const key = `reminder:${answer.op}:${messageId}`
  if (matches.length !== 1) return unmatched(answer.op, answer.target, matches, key, at)
  const task = matches[0]
  const facts = { operation: `reminder.${answer.op}`, kind: "reminder", id: task.taskId, key, at }
  const scheduler = try Scheduler
  const reply: VerbAnswer | SchedulerUnavailable = scheduler.answer(task.taskId, verbOf(answer), key) catch (refused) => refused
  const receipt = reply instanceof SchedulerUnavailable ? failedReceipt(facts, "SCHEDULER_UNAVAILABLE", "unknown")
    : reply.kind === "applied" ? appliedReceipt(facts)
    : failedReceipt(facts, reply.kind === "refused" ? reply.reason : "NOT_FOUND", "rejected")
  return attributed([{ actionName: saveAction, success: receipt.outcome === "applied", receipts: [receipt] }], `reminder:${task.taskId}`, {
    done: `${said[answer.op]} "${task.promptInstructions}".`,
    notDone: `"${task.promptInstructions}" was not changed.`,
    unproven: `I couldn't confirm "${task.promptInstructions}" was changed.`,
  }, { taskId: task.taskId })
}

/** Sets how the one live reminder the owner named escalates while they do not answer it; a request that names no reminder changes nothing. */
export effect function escalateReminder(input: unknown, messageId: string) {
  const decoded = decodeEscalation(input)
  if (Option.isNone(decoded)) {
    return { success: false, text: "Say which reminder should escalate and how, such as: nudge me again if I don't respond in 30 minutes.", data: { outcome: "REMINDER_ESCALATION_INVALID" } } satisfies ActionResult
  }
  const request = decoded.value
  const target = request.target?.trim() ?? ""
  if (target === "") {
    return { success: false, text: "Global escalation rules are not supported yet. Name a reminder and I'll set its escalation.", data: { outcome: "GLOBAL_ESCALATION_UNSUPPORTED" } } satisfies ActionResult
  }
  const matches = try namedReminders(target)
  if (matches.length !== 1) return unmatched("escalate", target, matches, `reminder:escalate:${messageId}`, try (try Facts).now())
  return try changeEscalation(matches[0], request, messageId)
}

const retraction = /^\s*(?:(?:oh|ok|okay|wait|actually|no|nah|hmm|sorry|ugh)\b[\s,.!-]*)*(?:(?:don['’]?t|do not)\b(?!\s+forget\b)[^.!?\n]{0,40}\b(?:save|keep|schedule|add|create)\b\s+(?:that(?:\s+one)?|this(?:\s+one)?|it)\b|(?:cancel|undo|scrap|delete|remove|drop)\s+(?:that(?:\s+one)?|it|this(?:\s+one)?|the last one)\b|never\s?mind\b|get rid of (?:that|it)\b)/iu
const deictic = /^(?:(?:that|this)(?:\s+one)?|it|the last one)$/iu
const retractionBlockers = new Set<unknown>(["complete", "snooze", "acknowledge", "escalate", "move"])
const namedTarget = (target: unknown) => typeof target === "string" && target.trim() !== "" && !deictic.test(target.trim()) ? target : undefined

/** Takes back the reminder this conversation just saved when a later message retracts it, or answers undefined when the message is no retraction of it. */
export effect function retractRecentSave(request: Pick<ReminderRequest, "messageId" | "text" | "roomId">, target: unknown) {
  if (request.roomId === undefined || !retraction.test(request.text)) return undefined
  const key = recentSaveKey(request.roomId)
  const recent = try readRecord(key, decodeRecentSave)
  if (recent === undefined) return undefined
  const live = (try liveReminders()).some((task) => task.taskId === recent.taskId)
  const named = namedTarget(target)
  let otherTarget = false
  if (named !== undefined) otherTarget = !(try namedReminders(named)).some((task) => task.taskId === recent.taskId)
  const now = try (try Facts).now()
  if (!retractsRecentSave(recent.savedAt, now, recent.messageId === request.messageId, live, otherTarget)) {
    if (!live) {
      try removeRecord(key)
    }
    return undefined
  }
  const facts = { operation: "reminder.retract", kind: "reminder", id: recent.taskId, key: `reminder:retract:${request.messageId}`, at: now }
  const reply: VerbAnswer | SchedulerUnavailable = (try Scheduler).answer(recent.taskId, { tag: "Dismiss" }, facts.key) catch (refused) => refused
  const receipt = reply instanceof SchedulerUnavailable ? failedReceipt(facts, "SCHEDULER_UNAVAILABLE", "unknown")
    : reply.kind === "applied" ? appliedReceipt(facts)
    : failedReceipt(facts, reply.kind === "refused" ? reply.reason : "NOT_FOUND", "rejected")
  if (receipt.outcome === "applied") {
    try removeRecord(key)
  }
  return attributed([{ actionName: saveAction, success: receipt.outcome === "applied", receipts: [receipt] }], `reminder:${recent.taskId}`, {
    done: `Okay — I removed "${recent.title}". Nothing is saved for it now.`,
    notDone: `"${recent.title}" is still saved.`,
    unproven: `I couldn't confirm "${recent.title}" was removed. Check your reminders before relying on it.`,
  }, { taskId: recent.taskId, retractedRecentSave: true })
}

const positiveWhole = (raw: unknown) => {
  const value = typeof raw === "number" ? raw : typeof raw === "string" && /^\d+$/u.test(raw.trim()) ? Number(raw.trim()) : undefined
  return value !== undefined && Number.isSafeInteger(value) && value > 0 ? value : undefined
}
const fraction = (raw: unknown) => typeof raw === "number" && Number.isFinite(raw) && !Number.isInteger(raw)

function moveDelayMs(delaySeconds: unknown, delayMinutes: unknown): number {
  const seconds = positiveWhole(delaySeconds)
  const minutes = positiveWhole(delayMinutes)
  if (fraction(delaySeconds) || (seconds === undefined && fraction(delayMinutes))) return 0
  return seconds !== undefined ? seconds * 1_000 : minutes !== undefined ? minutes * 60_000 : 0
}

/** What a move asks: the reminder it names, if any, and its delay. */
export interface MoveRequest {
  readonly target?: unknown
  readonly delaySeconds?: unknown
  readonly delayMinutes?: unknown
}

/** Moves the one waiting reminder the owner named, or the one this conversation just saved, to the delay after their message. */
export effect function moveReminder(move: MoveRequest, request: OwnerRequest) {
  const host = try Facts
  const now = try host.now()
  const named = namedTarget(move.target)
  const recent = named !== undefined || request.roomId === undefined ? undefined : try readRecord(recentSaveKey(request.roomId), decodeRecentSave)
  const matches = named !== undefined ? try namedReminders(named) : (try liveReminders()).filter((task) => task.taskId === recent?.taskId)
  const key = `reminder:move:${request.messageId}`
  if (named === undefined && matches.length === 0) return { success: false, text: "Which reminder should I move?", data: { outcome: "not_found" } } satisfies ActionResult
  if (matches.length !== 1) return unmatched("move", named ?? "", matches, key, now)
  const task = matches[0]
  const title = task.promptInstructions
  const delayMs = moveDelayMs(move.delaySeconds, move.delayMinutes)
  const askedAt = request.askedAt ?? now
  if (!moveAdmitted(task.status === "Scheduled", delayMs, askedAt, now)) {
    const [outcome, text] = task.status !== "Scheduled" ? ["REMINDER_ALREADY_FIRED", `"${title}" already went off, so nothing changed. Snooze it to hear it again later.`]
      : delayMs <= 0 || delayMs > maxMoveDelayMs ? ["REMINDER_DELAY_INVALID", `Nothing changed on "${title}". How many minutes from now should it go off?`]
      : ["REMINDER_TIME_PASSED", `That time has already passed, so nothing changed on "${title}". When should it go off?`]
    return { success: false, text, data: { outcome, taskId: task.taskId } } satisfies ActionResult
  }
  const at = movedDueAt(askedAt, delayMs)
  const facts = { operation: "reminder.move", kind: "reminder", id: task.taskId, key, at: now }
  const reply: VerbAnswer | SchedulerUnavailable = (try Scheduler).retrigger(task.taskId, { kind: "once", atIso: new Date(at).toISOString() }, key) catch (refused) => refused
  const receipt = reply instanceof SchedulerUnavailable ? failedReceipt(facts, "SCHEDULER_UNAVAILABLE", "unknown")
    : reply.kind === "applied" ? appliedReceipt(facts)
    : failedReceipt(facts, reply.kind === "refused" ? reply.reason : "NOT_FOUND", "rejected")
  return attributed([{ actionName: saveAction, success: receipt.outcome === "applied", receipts: [receipt] }], `reminder:${task.taskId}`, {
    done: `Moved "${title}" to ${fireTimeText(at, try ownerClockAt(now), now)}.`,
    notDone: `"${title}" was not moved.`,
    unproven: `I couldn't confirm "${title}" was moved. Check your reminders before relying on it.`,
  }, { taskId: task.taskId, dueAt: new Date(at).toISOString() })
}

const escalationFields = ["target", "steps", "afterMinutes", "replace", "quietHours"] as const

function parameters(options: unknown): Readonly<Record<string, unknown>> {
  const found = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
  return typeof found === "object" && found !== null ? found as Record<string, unknown> : {}
}

/** The owner's request as this package reads it from a message, with the instant it was sent when known. */
export function requestOf(message: Memory) {
  return {
    messageId: message.id ?? "", text: typeof message.content.text === "string" ? message.content.text : "", roomId: message.roomId,
    askedAt: typeof message.createdAt === "number" && Number.isSafeInteger(message.createdAt) ? message.createdAt : undefined,
  }
}

/** The owner's request as this package reads it from a message. */
export type OwnerRequest = ReturnType<typeof requestOf>

/** Saves, completes, dismisses, snoozes or acknowledges the owner's own reminders. */
export const ownerRemindersAction: Action = {
  name: saveAction,
  description: "Save a one-shot reminder the owner asked for in this message, complete, dismiss, snooze or acknowledge one of their saved reminders, move one by a delay from now (\"actually make that 30 minutes\" is op move with delayMinutes 30), set how one saved reminder escalates while they do not answer it, or take back the reminder just saved when the owner says \"actually, don't save that one\" (op dismiss). A reminder is saved only after the owner's own message is checked again.",
  similes: ["REMINDER", "REMINDERS", "SET_REMINDER", "REMIND_ME", "REMIND_ME_TO", "CREATE_REMINDER", "SNOOZE_REMINDER", "DISMISS_REMINDER", "COMPLETE_REMINDER", "ESCALATE_REMINDER"],
  parameters: [
    { name: "op", required: true, description: "create, complete, dismiss, snooze, acknowledge, move or escalate.", schema: { type: "string", enum: ["create", "complete", "dismiss", "snooze", "acknowledge", "move", "escalate"] } },
    { name: "plan", required: false, description: 'For create: {"title", "body"?, "due": {"kind":"in","minutes"} | {"kind":"at","instant" with Z or ±HH:MM} | {"kind":"local","date":"YYYY-MM-DD","time":"HH:MM"}, "destination": "chat"|"device"|null, "alert": "alert"|"silent"|null}. Leave a choice null unless the owner stated it.', schema: { type: "object" } },
    { name: "target", required: false, description: "For any other op: the saved reminder's title or id; for move, \"that\" means the reminder just saved.", schema: { type: "string" } },
    { name: "minutes", required: false, description: "For snooze: minutes, 1 to 1440; 10 when omitted.", schema: { type: "number" } },
    { name: "delayMinutes", required: false, description: "For move: whole minutes from now until the reminder goes off.", schema: { type: "integer" } },
    { name: "delaySeconds", required: false, description: "For move: whole seconds from now, when the owner gave seconds; wins over delayMinutes.", schema: { type: "integer" } },
    { name: "steps", required: false, description: 'For escalate: [{"channel": "push" | "in_app", "afterMinutes": 1 to 1440}], each counted from when the reminder fires. push is a phone notification, in_app a message in this conversation. Name any other channel the owner asked for, such as voice or sms, as they said it.', schema: { type: "array" } },
    { name: "afterMinutes", required: false, description: "For escalate: one phone notification this many minutes after the reminder fires, when steps is omitted.", schema: { type: "number" } },
    { name: "replace", required: false, description: "For escalate: true only when the owner asked to replace every earlier step.", schema: { type: "boolean" } },
    { name: "quietHours", required: false, description: 'For escalate: {"start": "HH:MM", "end": "HH:MM"} on the owner\'s clock, when the owner asked for quiet hours.', schema: { type: "object" } },
  ],
  tags: ["domain:reminders", "capability:write", "effect:receipt-required"],
  roleGate: { minRole: "OWNER" },
  validate: async () => true,
  handler: async (runtime: IAgentRuntime, message, _state, options) => {
    const given = parameters(options)
    const request = requestOf(message)
    const retracted = retractionBlockers.has(given.op) ? undefined : await onAgent(runtime, retractRecentSave(request, given.target))
    if (retracted !== undefined && given.op !== "create") return retracted
    if (given.op === "create") return reminderReply(await onAgent(runtime, createReminder({ ...request, plan: given.plan })))
    if (given.op === "move") return onAgent(runtime, moveReminder({ target: given.target, delaySeconds: given.delaySeconds, delayMinutes: given.delayMinutes }, request))
    if (given.op === "escalate") {
      const asked = Object.fromEntries(escalationFields.flatMap((field) => given[field] === undefined || given[field] === null ? [] : [[field, given[field]] as const]))
      return onAgent(runtime, escalateReminder({ op: "escalate", ...asked }, request.messageId))
    }
    const { op, target, minutes } = given
    return onAgent(runtime, answerReminder({ op, target, ...(minutes === undefined ? {} : { minutes }) }, request.messageId))
  },
}

/** The owner's live reminders, for the planner to name the right one. */
export const ownerRemindersProvider: Provider = {
  name: "PERSONAL_ASSISTANT_REMINDERS",
  description: "The owner's saved reminders that have not settled, with their due times.",
  dynamic: true,
  private: true,
  get: async (runtime) => {
    const tasks = await onAgent(runtime, Effect.orElseSucceed(liveReminders(), () => []))
    const lines = tasks.map((task) => `- "${task.promptInstructions}" (${task.status.toLowerCase()}${task.trigger.kind === "once" ? `, due ${task.trigger.atIso}` : ""}) id ${task.taskId}`)
    return { text: lines.length === 0 ? "" : ["# Owner reminders", ...lines].join("\n"), data: { reminders: tasks.map(({ taskId, promptInstructions, status }) => ({ taskId, title: promptInstructions, status })) } }
  },
}
