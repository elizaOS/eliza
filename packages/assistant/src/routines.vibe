// spec/assistant/routines.md, "Story: Keep my habits on their cadence"; spec/assistant/routines.md, "A starter routine is created at most once for each template"; spec/assistant/routines.md, "An occurrence is answered only after it was shown"; spec/assistant/routines.md, "An unanswered occurrence expires when its window ends"; spec/assistant/routines.md, "A muted routine shows nothing until it is unmuted"; spec/assistant/routines.md, "Story: Create, change and delete a routine from my own client"; spec/assistant/routines.md, "A creation with an idempotency key creates at most one definition"; spec/assistant/routines.md, "A change answers with the definition as saved, and a deletion answers deleted"; spec/assistant/routines.md, "Story: Keep my habits from the conversation"; spec/assistant/routines.md, "A request from the conversation changes the one routine it names, and none when it names none or several"
import { createReminderPresentation, type Action, type ActionResult, type IAgentRuntime, type Provider } from "@elizaos/core"
import type { AgentPlugin } from "@elizaos/agent"
import { Machine, Rejected, routineNamed, stored, type DefinitionStatus, type Event, type Routines } from "../gen/assistant__routines.effect.vibe"
import { Facts, Presenter, Scheduler, onAgent, readRecord, writeRecord, type DeliveryAnswer, type TaskRow } from "./host.vibe"
import { requestOf } from "./reminders.vibe"
import { appliedReceipt, attributed, failedReceipt, unchangedReceipt } from "./replies.vibe"
import { OccurrenceAnswer, RoutineCreate, RoutineRequest, RoutineUpdate } from "./requests.schema.vibe"
import { ownerClockAt } from "./timezone.vibe"

/** The scheduled-task kind of a routine's occurrences. */
export const routineKind = "personal-assistant.routine"

type Window = RoutineCreate["windows"][number]
const windowHours: Readonly<Record<Window, number>> = { morning: 9, afternoon: 15, evening: 18, night: 21 }

/** The starter routines offered during onboarding, each at most once. */
export const starterRoutines: Readonly<Record<string, { readonly title: string; readonly windows: readonly Window[] }>> = {
  "brush-teeth": { title: "Brush teeth", windows: ["morning", "night"] },
  "drink-water": { title: "Drink water", windows: ["morning", "afternoon", "evening"] },
  stretch: { title: "Stretch", windows: ["afternoon"] },
}

const RoutineRecord = Schema.Struct({
  routineId: Schema.String, title: Schema.String,
  windows: Schema.Array(Schema.Literals(["morning", "afternoon", "evening", "night"])), taskId: Schema.String,
})
/** A routine's words and its scheduled task, beside its spec state. */
export type RoutineRecord = typeof RoutineRecord.Type
const decodeIndex = Schema.decodeUnknownOption(Schema.Struct({ routines: Schema.Array(RoutineRecord), keys: Schema.Record(Schema.String, Schema.String) }))
const indexKey = "routines"
const offeredKey = "routines:offered"
const stateKey = (routineId: string) => `routine:${routineId}`
const statusNames = { active: "DefinitionActive", paused: "DefinitionPaused", archived: "DefinitionArchived" } as const satisfies Record<string, DefinitionStatus>
const wireStatus: Readonly<Record<DefinitionStatus, string>> = { DefinitionActive: "active", DefinitionPaused: "paused", DefinitionArchived: "archived", DefinitionAbsent: "deleted" }

effect function routineIndex() {
  return (try readRecord(indexKey, decodeIndex)) ?? { routines: [], keys: {} }
}

/** A routine as the owner's client reads it. */
export function wireRoutine(record: RoutineRecord, state: Routines) {
  return { id: record.routineId, title: record.title, windows: record.windows, status: wireStatus[state.definition], occurrence: state.occurrence, muted: state.muted }
}

effect function stepRoutine(routineId: string, event: Event) {
  provide stored(stateKey(routineId)) {
    return try (try Machine).send(event)
  }
}

effect function routineState(routineId: string) {
  provide stored(stateKey(routineId)) {
    return try (try Machine).get()
  }
}

/** Creates a routine once per idempotency key, answering a repeat with the routine as it is. */
export effect function createRoutine(input: RoutineCreate) {
  const index = try routineIndex()
  const known = index.keys[input.idempotencyKey]
  const routineId = known ?? `routine-${encodeURIComponent(input.idempotencyKey)}`
  if (known === undefined) {
    const scheduler = try Scheduler
    const zone = try ownerClockAt(try (try Facts).now())
    const hours = [...new Set(input.windows.map((window) => windowHours[window]))].sort((a, b) => a - b)
    const made = try scheduler.create({
      kind: routineKind, ownerVisible: true, promptInstructions: input.title,
      trigger: { kind: "cron", expression: `0 ${hours.join(",")} * * *`, tz: zone },
      metadata: { routineId, title: input.title }, idempotencyKey: `routine:${input.idempotencyKey}`,
    })
    const record: RoutineRecord = { routineId, title: input.title, windows: input.windows, taskId: made.task.taskId }
    try writeRecord(indexKey, { routines: [...index.routines, record], keys: { ...index.keys, [input.idempotencyKey]: routineId } })
  }
  const state = try stepRoutine(routineId, { type: "createDefinition", idempotencyKey: input.idempotencyKey })
  const record = (try routineIndex()).routines.find((routine) => routine.routineId === routineId)
  return { created: known === undefined, routine: record === undefined ? undefined : wireRoutine(record, state) }
}

effect function offerTemplate(templateKey: string) {
  provide stored(offeredKey) {
    const offered = (try Machine).send({ type: "seedRoutine", templateKey }) catch (refused) => refused
    return !(offered instanceof Rejected)
  }
}

/** Offers a starter routine from its template, creating it at most once. */
export effect function seedStarter(templateKey: string) {
  const template = starterRoutines[templateKey]
  if (template === undefined) return undefined
  if (!(try offerTemplate(templateKey))) return undefined
  return try createRoutine({ idempotencyKey: `template:${templateKey}`, title: template.title, windows: [...template.windows] })
}

/** Changes a routine's status and answers with the routine as saved. */
export effect function updateRoutine(routineId: string, input: RoutineUpdate) {
  const record = (try routineIndex()).routines.find((routine) => routine.routineId === routineId)
  if (record === undefined) return undefined
  const state = stepRoutine(routineId, { type: "updateDefinition", status: statusNames[input.status] }) catch () => undefined
  if (state === undefined) return undefined
  const scheduler = try Scheduler
  if (input.status !== "active") scheduler.answer(record.taskId, { tag: "Skip" }, `routine:${routineId}:${input.status}:${state.occurrences}`) catch () => undefined
  return wireRoutine(record, state)
}

/** Deletes a routine and its scheduled task, answering deleted. */
export effect function deleteRoutine(routineId: string) {
  const index = try routineIndex()
  const record = index.routines.find((routine) => routine.routineId === routineId)
  if (record === undefined) return false
  const state = stepRoutine(routineId, { type: "deleteDefinition" }) catch () => undefined
  if (state === undefined) return false
  (try Scheduler).answer(record.taskId, { tag: "Dismiss" }, `routine:${routineId}:delete`) catch () => undefined
  try writeRecord(indexKey, { ...index, routines: index.routines.filter((routine) => routine.routineId !== routineId) })
  return true
}

const occurrenceEvents = {
  complete: "completeOccurrence", skip: "skipOccurrence", snooze: "snoozeOccurrence", mute: "muteRoutine", unmute: "unmuteRoutine",
} as const satisfies Record<OccurrenceAnswer["op"], Event["type"]>

/** Answers a routine's current occurrence; an occurrence not shown yet cannot be answered. */
export effect function answerOccurrence(routineId: string, answer: OccurrenceAnswer) {
  const record = (try routineIndex()).routines.find((routine) => routine.routineId === routineId)
  if (record === undefined) return undefined
  const event = { type: occurrenceEvents[answer.op] } as Event
  const state = stepRoutine(routineId, event) catch (refused) => refused
  if (state instanceof Rejected) return { refused: true, routine: wireRoutine(record, state.state) }
  if (answer.op === "snooze") (try Scheduler).answer(record.taskId, { tag: "SnoozeFor", minutes: 10 }, `routine:${routineId}:snooze:${state.occurrences}:${state.snoozes}`) catch () => undefined
  return { refused: false, routine: wireRoutine(record, state) }
}

/** Shows a routine's occurrence when its window opens, expiring the last one if nobody answered it. */
export effect function deliverRoutine(task: TaskRow) {
  const routineId = task.metadata.routineId
  if (typeof routineId !== "string") return { kind: "undeliverable", error: "The occurrence names no routine" } satisfies DeliveryAnswer
  let state = try routineState(routineId)
  if (state.definition !== "DefinitionActive") return { kind: "undeliverable", error: "The routine is not active" } satisfies DeliveryAnswer
  if (state.occurrence === "OccurrenceVisible") state = try stepRoutine(routineId, { type: "expireOccurrence" })
  if (state.occurrence === "OccurrenceCompleted" || state.occurrence === "OccurrenceSkipped" || state.occurrence === "OccurrenceExpired") {
    state = try stepRoutine(routineId, { type: "nextOccurrence" })
  }
  if (state.muted) return { kind: "undeliverable", error: "The routine is muted" } satisfies DeliveryAnswer
  try stepRoutine(routineId, { type: "showOccurrence" })
  const title = typeof task.metadata.title === "string" && task.metadata.title.trim() !== "" ? task.metadata.title : task.promptInstructions
  const presentation = try (Effect.try({ try: () => createReminderPresentation(title, title, "Routine"), catch: () => "unpresentable" }) catch () => undefined)
  if (presentation === undefined) return { kind: "undeliverable", error: "The routine has no text to present" } satisfies DeliveryAnswer
  return try ((try Presenter).present({ taskId: task.taskId, kind: task.kind, roomId: undefined, presentation })
    |> Effect.as(%, { kind: "delivered" } as DeliveryAnswer)
    |> Effect.catch(%, (failed) => Effect.succeed({ kind: "retry", afterMs: 60_000, reason: failed.reason } as DeliveryAnswer)))
}

type LocalRoute = NonNullable<AgentPlugin["routes"]>[number]
const strict = { onExcessProperty: "error" } as const
const decodeCreate = Schema.decodeUnknownOption(RoutineCreate, strict)
const decodeUpdate = Schema.decodeUnknownOption(RoutineUpdate, strict)
const decodeAnswer = Schema.decodeUnknownOption(OccurrenceAnswer, strict)
const malformed = { status: 400, body: { error: "malformed" } }
const notFound = { status: 404, body: { error: "not_found" } }
const offline = { status: 503, body: { error: "assistant_unavailable" } }

/** The routes the owner's client creates, changes, deletes and answers routines through. */
export function routineRoutes(agent: () => IAgentRuntime | undefined): LocalRoute[] {
  const run = async <A>(program: (runtime: IAgentRuntime) => Promise<A>) => {
    const runtime = agent()
    return runtime === undefined ? offline : program(runtime)
  }
  return [
    {
      method: "GET", path: "/api/personal-assistant/routines",
      handler: () => run(async (runtime) => {
        const listed = await onAgent(runtime, listRoutines())
        return { status: 200, body: { routines: listed } }
      }),
    },
    {
      method: "POST", path: "/api/personal-assistant/routines",
      handler: ({ body }) => {
        const input = decodeCreate(body)
        return Option.isNone(input) ? malformed : run(async (runtime) => {
          const made = await onAgent(runtime, createRoutine(input.value))
          return { status: made.created ? 201 : 200, body: { routine: made.routine, idempotency: { key: input.value.idempotencyKey, replayed: !made.created } } }
        })
      },
    },
    {
      method: "PATCH", path: "/api/personal-assistant/routines/{id}",
      handler: ({ parameters, body }) => {
        const input = decodeUpdate(body)
        return Option.isNone(input) ? malformed : run(async (runtime) => {
          const saved = await onAgent(runtime, updateRoutine(parameters.get("id") ?? "", input.value))
          return saved === undefined ? notFound : { status: 200, body: { routine: saved } }
        })
      },
    },
    {
      method: "DELETE", path: "/api/personal-assistant/routines/{id}",
      handler: ({ parameters }) => run(async (runtime) => (await onAgent(runtime, deleteRoutine(parameters.get("id") ?? ""))) ? { status: 200, body: { deleted: true } } : notFound),
    },
    {
      method: "POST", path: "/api/personal-assistant/routines/{id}/occurrence",
      handler: ({ parameters, body }) => {
        const input = decodeAnswer(body)
        return Option.isNone(input) ? malformed : run(async (runtime) => {
          const answered = await onAgent(runtime, answerOccurrence(parameters.get("id") ?? "", input.value))
          return answered === undefined ? notFound : { status: answered.refused ? 409 : 200, body: answered }
        })
      },
    },
    {
      method: "POST", path: "/api/personal-assistant/routines/starters/{template}",
      handler: ({ parameters }) => run(async (runtime) => {
        const seeded = await onAgent(runtime, seedStarter(parameters.get("template") ?? ""))
        return seeded === undefined ? { status: 409, body: { error: "already_offered" } } : { status: 201, body: { routine: seeded.routine } }
      }),
    },
  ]
}

const routineActionName = "OWNER_ROUTINES"
const decodeRequest = Schema.decodeUnknownOption(RoutineRequest, strict)
const statusOf = { pause: "paused", resume: "active", archive: "archived" } as const satisfies Record<string, RoutineUpdate["status"]>
const answeredWords = { complete: "Marked done", skip: "Skipped", snooze: "Snoozed", mute: "Muted", unmute: "Unmuted" } as const satisfies Record<OccurrenceAnswer["op"], string>

effect function namedRoutines(target: string) {
  const name = target.trim().toLowerCase()
  return (try routineIndex()).routines.filter((record) => record.routineId === target || record.title.trim().toLowerCase() === name)
}

/** The owner's routines with their status, as the planner and the owner read them. */
export effect function listRoutines() {
  const listed = []
  for (const record of (try routineIndex()).routines) listed.push(wireRoutine(record, try routineState(record.routineId)))
  return listed
}

/** Adds, pauses, resumes, archives, deletes, lists or answers the one routine a message names. */
export effect function changeRoutine(input: unknown, messageId: string) {
  const decoded = decodeRequest(input)
  if (Option.isNone(decoded)) return { success: false, text: "Say which routine to add or change.", data: { outcome: "ROUTINE_REQUEST_INVALID" } } satisfies ActionResult
  const request = decoded.value
  const at = try (try Facts).now()
  if (request.op === "list") {
    const routines = try listRoutines()
    return { success: true, text: routines.length === 0 ? "You have no routines." : routines.map((routine) => `- "${routine.title}" (${routine.status}, ${routine.windows.join(", ")})`).join("\n"), data: { routines } } satisfies ActionResult
  }
  if (request.op === "create") {
    const made = try createRoutine({ idempotencyKey: `chat:${messageId}`, title: request.title, windows: request.windows })
    const id = made.routine?.id ?? ""
    const facts = { operation: "routine.create", kind: "routine", id, key: `routine:create:${messageId}`, at }
    return attributed([{ actionName: routineActionName, success: made.routine !== undefined, receipts: [appliedReceipt(facts, !made.created)] }], `routine:${id}`, {
      done: made.created ? `Added the routine "${request.title}" for the ${request.windows.join(", ")}.` : `"${request.title}" was already added by this request; nothing new was created.`,
      notDone: `"${request.title}" was not added.`,
      unproven: `I couldn't confirm "${request.title}" was added.`,
    }, { routineId: id })
  }
  const matches = try namedRoutines(request.target)
  const named = routineNamed(matches.length)
  const key = `routine:${request.op}:${messageId}`
  if (named !== "OneRoutineNamed") {
    const receipt = unchangedReceipt({ operation: `routine.${request.op}`, kind: "routine", id: request.target, key, at }, named === "NoRoutineNamed" ? "no_match" : "ambiguous")
    return {
      success: false, effectReceipts: [receipt],
      text: named === "NoRoutineNamed" ? `No routine is called "${request.target}", so nothing was changed.`
        : `${matches.length} routines are called "${request.target}", so nothing was changed. Which one did you mean: ${matches.map((record) => record.routineId).join(", ")}?`,
      data: { outcome: named === "NoRoutineNamed" ? "not_found" : "ambiguous", candidates: matches.map((record) => record.routineId) },
    } satisfies ActionResult
  }
  const record = matches[0]
  const facts = { operation: `routine.${request.op}`, kind: "routine", id: record.routineId, key, at }
  const target = `routine:${record.routineId}`
  const reply = (applied: boolean, done: string, refusal: string) => attributed(
    [{ actionName: routineActionName, success: applied, receipts: [applied ? appliedReceipt(facts) : failedReceipt(facts, refusal, "rejected")] }], target,
    { done, notDone: `"${record.title}" was not changed.`, unproven: `I couldn't confirm "${record.title}" was changed.` }, { routineId: record.routineId },
  )
  switch (request.op) {
    case "pause":
    case "resume":
    case "archive": {
      const saved = try updateRoutine(record.routineId, { status: statusOf[request.op] })
      return reply(saved !== undefined, `"${record.title}" is now ${saved?.status ?? statusOf[request.op]}.`, "ROUTINE_UNCHANGED")
    }
    case "delete": return reply(try deleteRoutine(record.routineId), `Deleted the routine "${record.title}".`, "ROUTINE_UNCHANGED")
    default: {
      const answered = try answerOccurrence(record.routineId, { op: request.op })
      return reply(answered !== undefined && !answered.refused, `${answeredWords[request.op]} "${record.title}".`, "OCCURRENCE_NOT_SHOWN")
    }
  }
}

function parametersOf(options: unknown): Readonly<Record<string, unknown>> {
  const given = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
  return typeof given === "object" && given !== null ? Object.fromEntries(Object.entries(given).filter(([, value]) => value !== undefined && value !== null)) : {}
}

/** Adds, changes, deletes, lists and answers the owner's routines from the conversation. */
export const ownerRoutinesAction: Action = {
  name: routineActionName,
  description: "The owner's recurring habits and routines, such as stretching every afternoon: create one with its daily windows, pause, resume, archive or delete one, list them, or complete, skip, snooze, mute or unmute the one showing now. A change names the routine by its title or id and applies only when exactly one routine matches. A one-time reminder is OWNER_REMINDERS.",
  similes: ["ROUTINES", "HABITS", "CREATE_ROUTINE", "ADD_HABIT", "PAUSE_ROUTINE", "DELETE_ROUTINE", "COMPLETE_ROUTINE"],
  parameters: [
    { name: "op", required: true, description: "create, pause, resume, archive, delete, list, complete, skip, snooze, mute or unmute.", schema: { type: "string", enum: ["create", "pause", "resume", "archive", "delete", "list", "complete", "skip", "snooze", "mute", "unmute"] } },
    { name: "title", required: false, description: "For create: the routine's title.", schema: { type: "string" } },
    { name: "windows", required: false, description: "For create: the daily windows it shows in, from morning (9:00), afternoon (15:00), evening (18:00) and night (21:00).", schema: { type: "array" } },
    { name: "target", required: false, description: "For any other op but list: the routine's title or id.", schema: { type: "string" } },
  ],
  tags: ["domain:routines", "capability:write", "effect:receipt-required"],
  roleGate: { minRole: "OWNER" },
  validate: async () => true,
  handler: async (runtime, message, _state, options) => {
    const { messageId } = requestOf(message)
    return onAgent(runtime, Effect.catch(changeRoutine(parametersOf(options), messageId), (failed) => Effect.succeed({ success: false, text: "The routine could not be changed.", data: { outcome: failed._tag } } satisfies ActionResult)))
  },
}

/** The owner's routines, for the planner to name the right one. */
export const ownerRoutinesProvider: Provider = {
  name: "PERSONAL_ASSISTANT_ROUTINES",
  description: "The owner's routines, with their status, windows and ids.",
  dynamic: true,
  private: true,
  get: async (runtime) => {
    const routines = await onAgent(runtime, Effect.orElseSucceed(listRoutines(), () => []))
    const lines = routines.map((routine) => `- "${routine.title}" (${routine.status}, ${routine.windows.join(", ")}) id ${routine.id}`)
    return { text: lines.length === 0 ? "" : ["# Owner routines", ...lines].join("\n"), data: { routines } }
  },
}
