// spec/workflow/worker.md, "Story: Run workflows from the reviewed source and signed device assets"; spec/workflow/worker.md, "Producer, package and installed tree must each prove their own identity"
import { GENERATED_ENGINE_DECLARATION } from "@elizaos/plugin-workflow-client"
import { initial, machineOver, type Worker } from "../gen/workflow__worker.effect.vibe"

export interface StagedWorkerArtifact { readonly files: number; readonly bytes: number; readonly indexSha256: string }

export const WORKER_REQUIRED_FILES: readonly string[] = [
  "src/worker/main.js", "src/worker/protocol.js", "src/worker/engine.js", "src/worker/guest.js", "src/worker/compiler.js", "workflow-worker.json", "dependencies.json", "compiler/compiler.json", "compiler/eliza-workflow.d.ts",
]
export const WORKER_EXECUTABLE = "src/worker/main.js"

export error WorkerArtifactRefused { reason: string }

module node {
  import { createHash, randomUUID } from "node:crypto"
  import { builtinModules } from "node:module"
  import { copyFile, lstat, mkdir, readdir, readFile, realpath, rename, rm, writeFile } from "node:fs/promises"
  import { dirname, isAbsolute, join, relative, resolve } from "node:path"
  import type { Node as SyntaxNode } from "typescript"

  export interface WorkerIdentity { readonly sourceStampSha256: string; readonly lockSha256: string }
  export interface WorkerManifest extends WorkerIdentity { readonly version: 1; readonly compiler?: unknown; readonly files: Readonly<Record<string, string>> }
  export interface VerifiedWorkerArtifact {
    readonly manifest: WorkerManifest
    readonly files: readonly (readonly [string, string])[]
    readonly manifestHash: string
    readonly bytes: number
  }

  export type Checked<A> = { readonly ok: true; readonly value: A } | { readonly ok: false; readonly reason: string }

  const sha256 = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex")
  const refuse = <A>(reason: string): Checked<A> => ({ ok: false, reason })
  const digestPattern = /^[a-f0-9]{64}$/
  const pathPattern = /^[A-Za-z0-9@_.+/-]+$/

  function validRelativePath(path: string): boolean {
    return pathPattern.test(path) && !path.split("/").some((part) => part === "" || part === "." || part === "..")
  }

  async function exists(path: string): Promise<boolean> {
    try {
      await lstat(path)
      return true
    } catch {
      return false
    }
  }

  async function noSymlinks(path: string): Promise<boolean> {
    for (let current = resolve(path); ; current = dirname(current)) {
      if (await lstat(current).then((info) => info.isSymbolicLink(), () => false)) return false
      if (dirname(current) === current) return true
    }
  }

  async function listFiles(root: string, directory = root, found: string[] = []): Promise<string[] | undefined> {
    for (const name of await readdir(directory)) {
      const file = join(directory, name)
      const info = await lstat(file)
      if (info.isSymbolicLink()) return undefined
      if (info.isDirectory()) {
        if (await listFiles(root, file, found) === undefined) return undefined
        continue
      }
      if (!info.isFile()) return undefined
      found.push(relative(root, file).split("\\").join("/"))
    }
    return found
  }

  export async function verify(directory: string, expected: Partial<WorkerIdentity>, required: readonly string[]): Promise<Checked<VerifiedWorkerArtifact>> {
    const root = resolve(directory)
    try {
      if (!await noSymlinks(root)) return refuse("The worker artifact path contains a symlink")
      const manifestInfo = await lstat(join(root, "manifest.json"))
      if (!manifestInfo.isFile() || manifestInfo.size > 1024 * 1024) return refuse("Invalid worker manifest file")
      const manifestBytes = await readFile(join(root, "manifest.json"))
      const manifest = JSON.parse(manifestBytes.toString("utf8")) as WorkerManifest
      if (manifest.version !== 1 || typeof manifest.files !== "object" || manifest.files === null || Array.isArray(manifest.files)) return refuse("Invalid worker manifest")
      for (const key of ["sourceStampSha256", "lockSha256"] as const) {
        if (typeof manifest[key] !== "string" || !digestPattern.test(manifest[key]) || (expected[key] !== undefined && manifest[key] !== expected[key])) return refuse(`Worker ${key} mismatch`)
      }
      const entries = Object.entries(manifest.files)
      if (entries.length === 0 || entries.length > 4095) return refuse("Worker file count out of bounds")
      const present = await listFiles(root)
      if (present === undefined) return refuse("The worker artifact contains a symlink or special file")
      const seen = new Set(present.filter((path) => path !== "manifest.json" && path !== "files.sha256"))
      if ([...seen].some((path) => !Object.hasOwn(manifest.files, path))) return refuse("Unexpected worker file")
      let total = manifestBytes.byteLength
      const files: (readonly [string, string])[] = []
      for (const [path, hash] of entries) {
        if (!validRelativePath(path) || path === "manifest.json" || !seen.has(path)) {
          return refuse("Invalid or missing worker file")
        }
        const bytes = await readFile(join(root, path))
        total += bytes.byteLength
        if (total > 64 * 1024 * 1024) return refuse("Worker artifact exceeds 64 MiB")
        if (typeof hash !== "string" || !digestPattern.test(hash) || sha256(bytes) !== hash) return refuse("Worker file hash mismatch")
        files.push([path, hash])
      }
      if (required.some((path) => !seen.has(path)) || !await dependenciesStaged(root, seen)) return refuse("Worker dependency missing")
      const compiler = await compilerStaged(root, seen, manifest)
      if (!compiler.typescript || !compiler.engine) return refuse("The worker's compiler assets are missing or not bound to its manifest")
      const manifestHash = sha256(manifestBytes)
      files.push(["manifest.json", manifestHash])
      return { ok: true, value: { manifest, files, manifestHash, bytes: total } }
    } catch {
      return refuse("The worker artifact is unreadable")
    }
  }

  export interface WorkerClosure { readonly entries: readonly { readonly path: string; readonly from: string }[]; readonly dependencies: Readonly<Record<string, string>> }

  type ModuleMode = "import" | "require"
  const commonConditions = ["node", "node-addons", "module-sync", "default"]
  const conditions = {
    import: new Set([...commonConditions, "import"]),
    require: new Set([...commonConditions, "require"]),
  }

  function target(exportsField: unknown, subpath: string, mode: ModuleMode): string | undefined {
    const pick = (value: unknown): string | undefined => {
      if (typeof value === "string") return value
      if (Array.isArray(value)) return value.map(pick).find((found) => found !== undefined)
      if (typeof value === "object" && value !== null) for (const [condition, candidate] of Object.entries(value)) if (conditions[mode].has(condition)) {
        const found = pick(candidate)
        if (found !== undefined) return found
      }
      return undefined
    }
    if (typeof exportsField === "string" || Array.isArray(exportsField)) return subpath === "." ? pick(exportsField) : undefined
    if (typeof exportsField !== "object" || exportsField === null) return undefined
    const keys = Object.keys(exportsField)
    if (keys.every((key) => !key.startsWith("."))) return subpath === "." ? pick(exportsField) : undefined
    if (subpath in exportsField) return pick(Reflect.get(exportsField, subpath))
    const patternKeys = keys
      .filter((key) => key.includes("*"))
      .sort((left, right) => right.indexOf("*") - left.indexOf("*") || right.length - left.length)
    for (const key of patternKeys) {
      const star = key.indexOf("*")
      const prefix = key.slice(0, star)
      const suffix = key.slice(star + 1)
      if (subpath.length < prefix.length + suffix.length || !subpath.startsWith(prefix) || !subpath.endsWith(suffix)) continue
      const found = pick(Reflect.get(exportsField, key))
      return found?.replaceAll("*", subpath.slice(prefix.length, subpath.length - suffix.length))
    }
    return undefined
  }

  async function packageOf(name: string, from: string): Promise<{ root: string; manifest: { name?: string; version?: string; exports?: unknown; main?: string } } | undefined> {
    for (let directory = dirname(from); ; directory = dirname(directory)) {
      const candidate = join(directory, "node_modules", name)
      if (await exists(join(candidate, "package.json"))) return { root: await realpath(candidate), manifest: JSON.parse(await readFile(join(candidate, "package.json"), "utf8")) }
      if (dirname(directory) === directory) return undefined
    }
  }

  async function file(path: string): Promise<string | undefined> {
    for (const candidate of [path, `${path}.js`, join(path, "index.js")]) {
      try {
        if ((await lstat(candidate)).isFile()) return await realpath(candidate)
      } catch {
        continue
      }
    }
    return undefined
  }

  async function owningPackage(path: string): Promise<{ root: string; name: string; version: string } | undefined> {
    for (let directory = dirname(path); ; directory = dirname(directory)) {
      if (await exists(join(directory, "package.json"))) {
        const manifest = JSON.parse(await readFile(join(directory, "package.json"), "utf8")) as { name?: unknown; version?: unknown }
        if (typeof manifest.name === "string") return { root: directory, name: manifest.name, version: typeof manifest.version === "string" ? manifest.version : "0.0.0" }
      }
      if (dirname(directory) === directory) return undefined
    }
  }

  async function isCommonJsModule(path: string): Promise<boolean> {
    if (path.endsWith(".cjs")) return true
    if (path.endsWith(".mjs")) return false
    for (let directory = dirname(path); ; directory = dirname(directory)) {
      if (await exists(join(directory, "package.json"))) {
        const manifest = JSON.parse(await readFile(join(directory, "package.json"), "utf8")) as { type?: unknown }
        return manifest.type !== "module"
      }
      if (dirname(directory) === directory) return true
    }
  }

  export async function closure(packageDir: string, executable: string): Promise<Checked<WorkerClosure>> {
    const ts = (await import("typescript")).default
    const root = await realpath(resolve(packageDir))
    const dist = join(root, "dist")
    const start = await file(join(dist, executable))
    if (start === undefined) return refuse("The built worker program is missing")
    const pending = [start]
    const seen = new Set<string>()
    const entries: { path: string; from: string }[] = []
    const dependencies: Record<string, string> = {}
    while (pending.length > 0) {
      const current = pending.pop() as string
      if (seen.has(current)) continue
      seen.add(current)
      const inside = relative(dist, current)
      if (!inside.startsWith("..") && !isAbsolute(inside)) entries.push({ path: inside.split("\\").join("/"), from: current })
      else {
        const owner = await owningPackage(current)
        if (owner === undefined) return refuse(`A worker dependency file has no package: ${current}`)
        if (!(owner.name in dependencies)) {
          dependencies[owner.name] = owner.version
          entries.push({ path: `node_modules/${owner.name}/package.json`, from: join(owner.root, "package.json") })
        }
        entries.push({ path: `node_modules/${owner.name}/${relative(owner.root, current).split("\\").join("/")}`, from: current })
      }
      if (!/\.(?:m|c)?js$/.test(current)) continue
      const text = await readFile(current, "utf8")
      const loads = new Map<string, { specifier: string; mode: ModuleMode; optional: boolean }>()
      const commonJs = await isCommonJsModule(current)
      const visit = (node: SyntaxNode, tried = false): void => {
        if (ts.isFunctionLike(node) && !ts.isSourceFile(node)) tried = false
        if (ts.isTryStatement(node)) {
          visit(node.tryBlock, tried || node.catchClause !== undefined)
          if (node.catchClause !== undefined) visit(node.catchClause, tried)
          if (node.finallyBlock !== undefined) visit(node.finallyBlock, tried)
          return
        }
        let argument: SyntaxNode | undefined
        let mode: ModuleMode = "import"
        if (ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) argument = node.moduleSpecifier
        if (ts.isCallExpression(node)) {
          if (node.expression.kind === ts.SyntaxKind.ImportKeyword) argument = node.arguments[0]
          if (commonJs && ts.isIdentifier(node.expression) && node.expression.text === "require") {
            argument = node.arguments[0]
            mode = "require"
          }
        }
        if (argument !== undefined && ts.isStringLiteralLike(argument)) {
          const key = `${mode}:${argument.text}`
          const previous = loads.get(key)
          loads.set(key, { specifier: argument.text, mode, optional: (previous?.optional ?? true) && mode === "require" && tried })
        }
        ts.forEachChild(node, (child) => visit(child, tried))
      }
      visit(ts.createSourceFile(current, text, ts.ScriptTarget.ESNext, false, ts.ScriptKind.JS))
      for (const { specifier, mode, optional } of loads.values()) {
        if (specifier.startsWith("node:") || builtinModules.includes(specifier.split("/")[0])) continue
        if (specifier.startsWith(".") || specifier.startsWith("/")) {
          const next = await file(resolve(dirname(current), specifier))
          if (next === undefined) {
            if (optional) continue
            return refuse(`A worker module is missing: ${specifier}`)
          }
          pending.push(next)
          continue
        }
        const parts = specifier.split("/")
        const name = specifier.startsWith("@") ? parts.slice(0, 2).join("/") : parts[0]
        const subpath = "." + specifier.slice(name.length)
        const found_ = await packageOf(name, current)
        if (found_ === undefined) {
          if (optional) continue
          return refuse(`A worker dependency cannot be resolved: ${name}`)
        }
        const mapped = found_.manifest.exports === undefined ? (subpath === "." ? found_.manifest.main ?? "index.js" : subpath) : target(found_.manifest.exports, subpath, mode)
        const next = mapped === undefined ? undefined : await file(join(found_.root, mapped))
        if (next === undefined) {
          if (optional) continue
          return refuse(`A worker dependency entry cannot be resolved: ${specifier}`)
        }
        pending.push(next)
      }
    }
    const unique = [...new Map(entries.map((entry) => [entry.path, entry])).values()]
    return { ok: true, value: { entries: unique, dependencies } }
  }

  export async function build(input: { outputDir: string; identity: WorkerIdentity; entries: readonly { readonly path: string; readonly from: string }[]; generated: Readonly<Record<string, string>>; compiler: CompilerDescriptor }): Promise<Checked<string>> {
    const output = resolve(input.outputDir)
    if (!isAbsolute(input.outputDir) || await exists(output)) return refuse("The worker artifact output must be fresh")
    if (input.entries.some((entry) => { const inside = relative(output, entry.from); return inside === "" || (!inside.startsWith("..") && !isAbsolute(inside)) })) return refuse("The worker artifact cannot replace its source")
    if (!await noSymlinks(dirname(output))) return refuse("The worker artifact path contains a symlink")
    try {
      const listed: Record<string, string> = {}
      const all = [...input.entries.map((entry) => ({ path: entry.path, from: entry.from as string | undefined, text: undefined as string | undefined })),
        ...Object.entries(input.generated).map(([path, text]) => ({ path, from: undefined, text }))]
      for (const entry of all.sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0)) {
        if (!validRelativePath(entry.path) || entry.path in listed) return refuse("Invalid worker file name")
        await mkdir(dirname(join(output, entry.path)), { recursive: true })
        if (entry.from !== undefined) {
          const info = await lstat(entry.from)
          if (!info.isFile()) return refuse("A worker source file is not a regular file")
          await copyFile(entry.from, join(output, entry.path))
        } else await writeFile(join(output, entry.path), entry.text ?? "")
        listed[entry.path] = sha256(await readFile(join(output, entry.path)))
      }
      const manifest: WorkerManifest = { version: 1, ...input.identity, compiler: input.compiler, files: listed }
      const bytes = Buffer.from(JSON.stringify(manifest, null, 2) + "\n")
      await writeFile(join(output, "manifest.json"), bytes)
      return { ok: true, value: sha256(bytes) }
    } catch {
      return refuse("The worker artifact could not be written")
    }
  }

  export async function dependenciesStaged(root: string, seen: ReadonlySet<string>): Promise<boolean> {
    try {
      const declared = JSON.parse(await readFile(join(root, "dependencies.json"), "utf8")) as Record<string, unknown>
      return Object.keys(declared).every((name) => seen.has(`node_modules/${name}/package.json`))
    } catch {
      return false
    }
  }

  export interface CompilerDescriptor { readonly compilerModule: string; readonly engineDeclaration: string; readonly declarationFiles: number; readonly packages: Readonly<Record<string, string>> }

  export async function compilerFiles(entries: readonly { readonly path: string; readonly from: string }[], dependencies: Readonly<Record<string, string>>): Promise<Checked<{ entries: { path: string; from: string }[]; descriptor: CompilerDescriptor }>> {
    const manifest = entries.find((entry) => entry.path === "node_modules/typescript/package.json")
    const version = dependencies.typescript
    if (manifest === undefined || version === undefined) return refuse("The worker does not import the TypeScript compiler")
    const root = dirname(manifest.from)
    const pkg = JSON.parse(await readFile(manifest.from, "utf8")) as { main?: string }
    const compilerModule = `node_modules/typescript/${(pkg.main ?? "./lib/typescript.js").replace(/^\.\//, "")}`
    if (!entries.some((entry) => entry.path === compilerModule)) return refuse("The staged TypeScript compiler module is missing")
    const libraries = (await readdir(join(root, "lib"))).filter((name) => /^lib\.[A-Za-z0-9.]+\.d\.ts$/.test(name) || name === "lib.d.ts").sort()
    if (!libraries.includes("lib.es2022.d.ts")) return refuse("The staged TypeScript compiler has no ES2022 declarations")
    return {
      ok: true,
      value: {
        entries: libraries.map((name) => ({ path: `node_modules/typescript/lib/${name}`, from: join(root, "lib", name) })),
        descriptor: { compilerModule, engineDeclaration: "compiler/eliza-workflow.d.ts", declarationFiles: libraries.length, packages: { typescript: version } },
      },
    }
  }

  export async function compilerStaged(root: string, seen: ReadonlySet<string>, manifest: { readonly compiler?: unknown }): Promise<{ readonly typescript: boolean; readonly engine: boolean }> {
    try {
      const descriptor = JSON.parse(await readFile(join(root, "compiler/compiler.json"), "utf8")) as CompilerDescriptor
      const libraries = [...seen].filter((path) => /^node_modules\/typescript\/lib\/lib\..*\.d\.ts$|^node_modules\/typescript\/lib\/lib\.d\.ts$/.test(path))
      const bound = JSON.stringify(manifest.compiler) === JSON.stringify(descriptor)
      return {
        typescript: bound && seen.has(descriptor.compilerModule) && libraries.length === descriptor.declarationFiles && seen.has("node_modules/typescript/lib/lib.es2022.d.ts"),
        engine: bound && seen.has(descriptor.engineDeclaration) && seen.has("src/worker/compiler.js") && seen.has("src/worker/engine.js") && seen.has("src/worker/guest.js"),
      }
    } catch {
      return { typescript: false, engine: false }
    }
  }

  export async function sha256Of(path: string): Promise<string> {
    return sha256(await readFile(path))
  }

  export async function stage(source: string, destination: string, verified: VerifiedWorkerArtifact, expected: Partial<WorkerIdentity>, required: readonly string[]): Promise<Checked<{ files: number; bytes: number; indexSha256: string; copiedManifest: string }>> {
    const target = resolve(destination)
    if (!await noSymlinks(target)) return refuse("The worker staging path contains a symlink")
    const parent = dirname(target)
    await mkdir(parent, { recursive: true })
    const temporary = join(parent, `.workflow-worker-${randomUUID()}`)
    const backup = `${temporary}.previous`
    try {
      await mkdir(temporary)
      for (const [path] of verified.files) {
        await mkdir(dirname(join(temporary, path)), { recursive: true })
        await copyFile(join(source, path), join(temporary, path))
      }
      const copied = await verify(temporary, expected, required)
      if (!copied.ok) return copied
      const index = verified.files.map(([path, hash]) => `${hash}\t${path}\n`).join("")
      if (Buffer.byteLength(index) > 1024 * 1024) return refuse("The worker extraction index exceeds 1 MiB")
      await writeFile(join(temporary, "files.sha256"), index)
      let moved = false
      if (await exists(target)) {
        await rename(target, backup)
        moved = true
      }
      try {
        await rename(temporary, target)
      } catch (error) {
        if (moved) await rename(backup, target)
        throw error
      }
      if (moved) await rm(backup, { recursive: true, force: true })
      return { ok: true, value: { files: verified.files.length, bytes: verified.bytes, indexSha256: sha256(Buffer.from(index)), copiedManifest: copied.value.manifestHash } }
    } catch {
      return refuse("The worker artifact could not be staged")
    } finally {
      await rm(temporary, { recursive: true, force: true })
    }
  }

  export async function installed(directory: string, packageStamp: string, index: string): Promise<Checked<{ manifestDigest: string; exactIndex: boolean; filesMatch: boolean; pathSafe: boolean; program: boolean; engine: boolean }>> {
    const root = resolve(directory)
    try {
      let pathSafe = await noSymlinks(root)
      const stored = await readFile(join(root, "files.sha256"), "utf8")
      const exactIndex = stored === index && Buffer.byteLength(stored) <= 1024 * 1024
      const lines = stored.split("\n").filter((line) => line !== "").map((line) => line.split("\t"))
      let filesMatch = lines.length > 0
      for (const parts of lines) {
        const [hash, path] = parts
        if (parts.length !== 2 || hash === undefined || path === undefined || !digestPattern.test(hash) || !validRelativePath(path)) {
          if (path !== undefined && !validRelativePath(path)) pathSafe = false
          filesMatch = false
          break
        }
        if (sha256(await readFile(join(root, path))) !== hash) { filesMatch = false; break }
      }
      const listed = new Set(lines.map(([, path]) => path))
      const present = await listFiles(root)
      if (present === undefined || present.some((path) => path !== "files.sha256" && !listed.has(path))) filesMatch = false
      const manifestDigest = sha256(await readFile(join(root, "manifest.json")))
      const manifest = JSON.parse(await readFile(join(root, "manifest.json"), "utf8")) as { readonly compiler?: unknown }
      const compiler = await compilerStaged(root, new Set([...listed].flatMap((path) => path === undefined ? [] : [path])), manifest)
      return { ok: true, value: { manifestDigest, exactIndex: exactIndex && packageStamp !== "", filesMatch, pathSafe, program: compiler.typescript && listed.has("src/worker/main.js"), engine: compiler.engine && listed.has("src/worker/protocol.js") } }
    } catch {
      return refuse("The installed worker tree is unreadable")
    }
  }
}
import { build, closure, compilerFiles, installed, sha256Of, stage, verify, type VerifiedWorkerArtifact, type WorkerClosure, type WorkerIdentity } from node
export type { VerifiedWorkerArtifact, WorkerClosure, WorkerIdentity, WorkerManifest } from node

export effect function workerArtifactClosure(packageDir: string): WorkerClosure!WorkerArtifactRefused {
  return try checked(() => closure(packageDir, WORKER_EXECUTABLE))
}

effect function checked<A>(call: () => Promise<{ readonly ok: true; readonly value: A } | { readonly ok: false; readonly reason: string }>): A!WorkerArtifactRefused {
  const result = try promise(call)
  if (!result.ok) throw new WorkerArtifactRefused({ reason: result.reason })
  return result.value
}

export effect function verifyWorkerArtifact(directory: string, expected: Partial<WorkerIdentity> = {}): VerifiedWorkerArtifact!WorkerArtifactRefused {
  return try checked(() => verify(directory, expected, WORKER_REQUIRED_FILES))
}

export effect function workerProvenance(start: Worker = initial) {
  const state = try Ref.make(start)
  const worker = try machineOver(() => Ref.get(state), (next) => Ref.set(state, next))
  const send = (event: Parameters<typeof worker.send>[0]) => mapError(worker.send(event), () => new WorkerArtifactRefused({ reason: "The worker provenance is out of step" }))

  effect function refusedUnless(next: Worker, reason: string): Worker!WorkerArtifactRefused {
    if (next.phase === "WorkerRefused") throw new WorkerArtifactRefused({ reason })
    return next
  }

  return {
    state: worker.get(),
    effect build(input: { readonly packageDir: string; readonly outputDir: string; readonly identity: WorkerIdentity; readonly observeIdentity: () => WorkerIdentity!WorkerArtifactRefused }) {
      try send({ type: "selectSource", sourceStamp: input.identity.sourceStampSha256, lockDigest: input.identity.lockSha256 })
      const manifestDigest = (effect {
        const found = try workerArtifactClosure(input.packageDir)
        const program = found.entries.find((entry) => entry.path === WORKER_EXECUTABLE)
        if (program === undefined) throw new WorkerArtifactRefused({ reason: "The built worker program is missing" })
        const compiler = try checked(() => compilerFiles(found.entries, found.dependencies))
        const generated = {
          "compiler/compiler.json": JSON.stringify(compiler.descriptor, null, 2) + "\n",
          "compiler/eliza-workflow.d.ts": GENERATED_ENGINE_DECLARATION,
          "package.json": JSON.stringify({ name: "workflow-worker", private: true, type: "module", dependencies: found.dependencies }, null, 2) + "\n",
          "dependencies.json": JSON.stringify(found.dependencies, null, 2) + "\n",
          "workflow-worker.json": JSON.stringify({ executable: WORKER_EXECUTABLE, sha256: try promise(() => sha256Of(program.from)) }) + "\n",
        }
        const entries = [...found.entries, ...compiler.entries.filter((extra) => !found.entries.some((entry) => entry.path === extra.path))]
        return try checked(() => build({ outputDir: input.outputDir, identity: input.identity, entries: entries.filter((entry) => !(entry.path in generated)), generated, compiler: compiler.descriptor }))
      } catch effect (error) => {
        try send({ type: "observeArtifact", build: { sourceStamp: "", lockDigest: "", manifestDigest: "", treeMatches: false, pathSafe: false, requiredFiles: false } })
        throw error
      })
      const after = try input.observeIdentity()
      const verified = (verifyWorkerArtifact(input.outputDir, input.identity) catch () => undefined)
      return try refusedUnless(try send({ type: "observeArtifact", build: {
        sourceStamp: after.sourceStampSha256, lockDigest: after.lockSha256, manifestDigest: verified?.manifestHash === manifestDigest ? manifestDigest : "",
        treeMatches: verified !== undefined, pathSafe: verified !== undefined, requiredFiles: verified !== undefined,
      } }), "The producer identity changed or the artifact did not verify")
    },
    effect reuse(directory: string, identity: WorkerIdentity) {
      try send({ type: "selectSource", sourceStamp: identity.sourceStampSha256, lockDigest: identity.lockSha256 })
      const verified = (verifyWorkerArtifact(directory, identity) catch () => undefined)
      return try refusedUnless(try send({ type: "observeArtifact", build: {
        sourceStamp: verified?.manifest.sourceStampSha256 ?? "", lockDigest: verified?.manifest.lockSha256 ?? "", manifestDigest: verified?.manifestHash ?? "",
        treeMatches: verified !== undefined, pathSafe: verified !== undefined, requiredFiles: verified !== undefined,
      } }), "The existing artifact does not match the reviewed source")
    },
    effect stage(source: string, destination: string, packageStamp: string, expected: WorkerIdentity) {
      const verified = try verifyWorkerArtifact(source, expected)
      const staged = (checked(() => stage(source, destination, verified, expected, WORKER_REQUIRED_FILES)) catch effect (error) => {
        try send({ type: "packageArtifact", packageStamp, observedManifest: "", copiedTreeMatches: false })
        throw error
      })
      try refusedUnless(try send({ type: "packageArtifact", packageStamp, observedManifest: staged.copiedManifest, copiedTreeMatches: true }), "The staged copy changed")
      return { files: staged.files, bytes: staged.bytes, indexSha256: staged.indexSha256 } satisfies StagedWorkerArtifact
    },
    effect step(event: Parameters<typeof worker.send>[0]) {
      return try worker.send(event)
    },
    effect install(directory: string, packageStamp: string, index: string) {
      const tree = (checked(() => installed(directory, packageStamp, index)) catch () => undefined)
      const current = try worker.get()
      return send({ type: "installArtifact", device: {
        packageStamp: tree === undefined ? "" : packageStamp, manifestDigest: tree?.manifestDigest ?? "", exactIndex: tree?.exactIndex ?? false,
        filesMatch: tree?.filesMatch ?? false, pathSafe: tree?.pathSafe ?? false, typescriptCompiler: tree?.program ?? false, engineCompiler: tree?.engine ?? false,
      } }) catch () => ({ ...current, phase: "WorkerRefused" as const, enabled: false })
    },
  }
}
