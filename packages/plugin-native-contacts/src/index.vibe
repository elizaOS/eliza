// spec/nativeContacts/index.md, "Story: Read or add contacts only within my device permissions"
export { addressBookPlugin, contactsClient, contactsPlugin, createAddressBookClient, createContactNames } from "@elizaos/os-bridges"
export type { ContactId, ContactVersion, ContactCursor, ContactPhoneKind, ContactEmailKind, ContactCustomType, ContactPhoneType, ContactEmailType, AddressBookStatus, AddressBookContact, AddressBookIncompleteReason, IncompleteAddressBookContact, AddressBookRow, AddressBookPage, ContactPageAsk, ContactPhone, ContactEmail, ContactDetail, ReviewedContact, ContactDraft, ContactSaveResult, ContactRemoveResult, NameSurface, NameScreen, DisplayOnlyName, ContactName, ContactDraftProblem, ContactRequestProblem, AddressBookNativePlugin, AddressBookClientOptions, AddressBookClient, ContactNamesClient, ContactSummary, ContactsPermissionStatus, ListContactsOptions, ContactsPlugin } from "@elizaos/os-bridges"

import { ADDRESS_BOOK_DEFAULT_PAGE } from "@elizaos/os-bridges"
import type { AddressBookClient, ContactPageAsk } from "@elizaos/os-bridges"
import { mayUseContacts, validContactsPage } from "../gen/nativeContacts.effect.vibe"

export error NativeContactsUnavailable

export effect function readNativeContacts(device: AddressBookClient, ask: ContactPageAsk) {
  const status = try tryPromise(() => device.status())
  if (!status.available || !mayUseContacts(status, "BrowseContacts")) throw new NativeContactsUnavailable()
  const page = try tryPromise(() => device.list(ask))
  const maxRows = ask.limit ?? ADDRESS_BOOK_DEFAULT_PAGE
  if (!Number.isSafeInteger(maxRows) || !validContactsPage({ maxRows, returnedRows: page.contacts.length, hasContinuation: page.next !== null })) {
    throw new NativeContactsUnavailable()
  }
  return page
}
