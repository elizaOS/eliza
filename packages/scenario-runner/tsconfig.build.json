{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "paths": {
      "@elizaos/core": ["../core/dist/index.d.ts"],
      "@elizaos/testing/*": ["../testing/src/*"],
      "@elizaos/common": ["../common/dist/index.d.ts"]
    },
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/__tests__/**/*",
    "src/executor.test.ts",
    "src/seeds.ts"
  ]
}
