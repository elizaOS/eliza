    ANTHROPIC_MAX_OUTPUT_TOKENS: env.ANTHROPIC_MAX_OUTPUT_TOKENS ?? null,
    ANTHROPIC_PROMPT_CACHE_TTL: env.ANTHROPIC_PROMPT_CACHE_TTL ?? null,
  },
  init: async (config, runtime) => {
    initializeAnthropic(config as PluginConfig, runtime)
  },
  modelMetadata,
  models: {
    [ModelType.TEXT_NANO]: handleTextNano,
    [ModelType.TEXT_SMALL]: handleTextSmall,
    [ModelType.TEXT_MEDIUM]: handleTextMedium,
    [ModelType.TEXT_LARGE]: handleTextLarge,
    [ModelType.TEXT_MEGA]: handleTextMega,
    [ModelType.RESPONSE_HANDLER]: handleResponseHandler,
    [ModelType.ACTION_PLANNER]: handleActionPlanner,
    [ModelType.TEXT_REASONING_SMALL]: handleReasoningSmall,
    [ModelType.TEXT_REASONING_LARGE]: handleReasoningLarge,
    [ModelType.IMAGE_DESCRIPTION]: handleImageDescription,
  },
}

