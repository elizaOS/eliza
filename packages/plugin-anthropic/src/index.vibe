    displayModelDefault: DEFAULT_LARGE_MODEL,
  },
  [ModelType.RESPONSE_HANDLER]: {
    streamable: true,
    displayModelSettings: [
      "ANTHROPIC_RESPONSE_HANDLER_MODEL",
      "ANTHROPIC_SHOULD_RESPOND_MODEL",
      "RESPONSE_HANDLER_MODEL",
      "SHOULD_RESPOND_MODEL",
      "ANTHROPIC_SMALL_MODEL",
    ],
    displayModelDefault: DEFAULT_SMALL_MODEL,
  },
  [ModelType.ACTION_PLANNER]: {
    streamable: true,
    displayModelSettings: [
      "ANTHROPIC_ACTION_PLANNER_MODEL",
      "ANTHROPIC_PLANNER_MODEL",
      "ACTION_PLANNER_MODEL",
      "PLANNER_MODEL",
      "ANTHROPIC_LARGE_MODEL",
    ],
    displayModelDefault: DEFAULT_LARGE_MODEL,
  },
  [ModelType.TEXT_REASONING_SMALL]: {
    streamable: true,
    displayModelSettings: ["ANTHROPIC_REASONING_SMALL_MODEL", "REASONING_SMALL_MODEL", "ANTHROPIC_SMALL_MODEL"],
    displayModelDefault: DEFAULT_SMALL_MODEL,
  },
  [ModelType.TEXT_REASONING_LARGE]: {
    streamable: true,
    displayModelSettings: ["ANTHROPIC_REASONING_LARGE_MODEL", "REASONING_LARGE_MODEL", "ANTHROPIC_LARGE_MODEL"],
    displayModelDefault: DEFAULT_LARGE_MODEL,
  },
  [ModelType.IMAGE_DESCRIPTION]: {
    streamable: false,
    displayModelSettings: ["ANTHROPIC_IMAGE_MODEL", "ANTHROPIC_SMALL_MODEL", "SMALL_MODEL"],
    displayModelDefault: DEFAULT_SMALL_MODEL,
  },
}

export const plugin: Plugin = {
  name: "@elizaos/plugin-anthropic",
  description: "Anthropic text tiers, native tools, structured output, prompt caching, reasoning, and image description.",
  autoEnable: {
    envKeys: ["ANTHROPIC_API_KEY", "CLAUDE_API_KEY"],
    shouldEnable: (runtimeEnv) => shouldEnable({ env: runtimeEnv }),
  },
  config: {
    ANTHROPIC_API_KEY: env.ANTHROPIC_API_KEY ?? null,
    ANTHROPIC_NANO_MODEL: env.ANTHROPIC_NANO_MODEL ?? null,
