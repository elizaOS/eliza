    ANTHROPIC_REASONING_SMALL_MODEL: env.ANTHROPIC_REASONING_SMALL_MODEL ?? null,
    ANTHROPIC_REASONING_LARGE_MODEL: env.ANTHROPIC_REASONING_LARGE_MODEL ?? null,
