    displayModelSettings: ["ANTHROPIC_MEDIUM_MODEL", "MEDIUM_MODEL", "ANTHROPIC_SMALL_MODEL", "SMALL_MODEL"],
    displayModelDefault: DEFAULT_SMALL_MODEL,
  },
  [ModelType.TEXT_LARGE]: {
    streamable: true,
    displayModelSettings: ["ANTHROPIC_LARGE_MODEL", "LARGE_MODEL"],
