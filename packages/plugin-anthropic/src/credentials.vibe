// spec/anthropic/index.md, "Transport must support the request and keeps the requested output budget"
import {
  ElizaError,
  getAnthropicAccountPoolBridge,
  processEnv,
  promised,
  thrown,
} from "@elizaos/core"

export interface OAuthToken {
  readonly accessToken: string
  readonly expiresAt: number
  readonly accountId?: string
}

export interface ClaudeOAuthMeta {
  readonly accessToken: string
  readonly refreshToken: string
  readonly expiresAt: number
  readonly scopes: readonly string[]
  readonly subscriptionType: string
  readonly rateLimitTier: string
}

interface ClaudeCredentialsFile {
  readonly claudeAiOauth?: ClaudeOAuthMeta
}

interface AppSubscriptionFile {
  readonly credentials?: {
    readonly access?: string
    readonly expires?: number
  }
}

module node {
  import { readFileSync } from "node:fs"
  import { homedir } from "node:os"
  import { join } from "node:path"

  /** @throws {never} */
  export function resolveStateBaseDir(env: Record<string, string | undefined>): string {
    const configured = env.ELIZA_STATE_DIR?.trim()
    return configured && configured.length > 0 ? configured : join(homedir(), ".eliza")
  }

  /** @throws {never} */
  export function resolveAppCredentialPaths(env: Record<string, string | undefined>): string[] {
    const stateDir = resolveStateBaseDir(env)
    const accountId = env.ANTHROPIC_SUBSCRIPTION_ACCOUNT_ID?.trim() || "default"
    return [
      join(stateDir, "auth", "anthropic-subscription", `${accountId}.json`),
      join(homedir(), ".eliza", "auth", "anthropic-subscription", `${accountId}.json`),
      join(homedir(), ".eliza", "auth", "anthropic-subscription.json"),
    ]
  }

  /** @throws {never} */
  export function resolveClaudeCredentialPath(env: Record<string, string | undefined>): string {
    const override = env.CLAUDE_CONFIG_DIR?.trim()
    const configDir = override && override.length > 0 ? override : join(homedir(), ".claude")
    return join(configDir, ".credentials.json")
  }

  /** @throws {unknown} */
  export function readUtf8FileSync(filePath: string): string {
    return readFileSync(filePath, "utf-8")
  }
}
import {
  readUtf8FileSync,
  resolveAppCredentialPaths,
  resolveClaudeCredentialPath,
} from node

const tokenCache = new Map<string, OAuthToken>()
const ENV_CACHE_KEY = "__env__"
const APP_CREDENTIAL_CACHE_KEY = "__app_anthropic_subscription__"

export function clearTokenCache(accountId?: string): void {
  if (accountId) {
    tokenCache.delete(accountId)
    return
  }
  tokenCache.clear()
}

function readAppManagedAnthropicToken(): OAuthToken | null {
  const cached = tokenCache.get(APP_CREDENTIAL_CACHE_KEY)
  if (cached && Date.now() < cached.expiresAt - 60_000) return cached
  const paths = resolveAppCredentialPaths(processEnv())
  for (const credentialPath of paths) {
    try {
      const raw = readUtf8FileSync(credentialPath)
      const parsed = JSON.parse(raw) as AppSubscriptionFile
      const access = parsed.credentials?.access?.trim()
      if (!access) continue
      const expires = parsed.credentials?.expires
      const token: OAuthToken = {
        accessToken: access,
        expiresAt:
          typeof expires === "number" && Number.isFinite(expires)
            ? expires
            : Number.POSITIVE_INFINITY,
      }
      if (Date.now() < token.expiresAt - 60_000) {
        tokenCache.set(APP_CREDENTIAL_CACHE_KEY, token)
        return token
      }
    } catch {
      continue
    }
  }
  tokenCache.delete(APP_CREDENTIAL_CACHE_KEY)
  return null
}

effect function readFromCredentialStoreEffect(): (ClaudeCredentialsFile | null)!ElizaError {
  const credPath = resolveClaudeCredentialPath(processEnv())
  const raw = Effect.try({
    try: () => readUtf8FileSync(credPath),
    catch: (cause) =>
      new ElizaError("Failed to read Claude credential file", {
        code: "CREDENTIALS_UNREADABLE",
        cause,
        context: { credPath },
      }),
  }) catch effect (err) => {
    const cause = err.cause
    const code = typeof cause === "object" && cause !== null && "code" in cause
      ? (cause as { code?: unknown }).code
      : undefined
    if (code === "ENOENT") return null
    throw err
  }
  if (raw === null) return null
  return try Effect.try({
    try: () => JSON.parse(raw) as ClaudeCredentialsFile,
    catch: (cause) =>
      new ElizaError("Claude credential file is corrupt (invalid JSON)", {
        code: "CREDENTIALS_CORRUPT",
        cause,
        context: { credPath },
      }),
  })
}

export effect function getClaudeOAuthTokenEffect(opts?: { accountId?: string }): OAuthToken!ElizaError {
  const appToken = readAppManagedAnthropicToken()
  if (appToken) return appToken

  const cacheKey = opts?.accountId ?? ENV_CACHE_KEY
  const cached = tokenCache.get(cacheKey)
  if (cached && Date.now() < cached.expiresAt - 60_000) return cached

  const envToken = processEnv().CLAUDE_CODE_OAUTH_TOKEN?.trim()
  if (envToken) {
    const token: OAuthToken = { accessToken: envToken, expiresAt: Number.POSITIVE_INFINITY }
    tokenCache.set(ENV_CACHE_KEY, token)
    return token
  }

  const credentials = try readFromCredentialStoreEffect()
  if (!credentials?.claudeAiOauth?.accessToken) {
    throw new ElizaError(
      "[Anthropic] Could not read Claude OAuth token. Either set CLAUDE_CODE_OAUTH_TOKEN env var (via `claude setup-token`), or ensure Claude Code is authenticated (run `claude auth login`).",
      { code: "ANTHROPIC_OAUTH_MISSING" },
    )
  }

  const token: OAuthToken = {
    accessToken: credentials.claudeAiOauth.accessToken,
    expiresAt: credentials.claudeAiOauth.expiresAt,
  }
  tokenCache.set(cacheKey, token)
  return token
}

export const getClaudeOAuthToken = thrown(getClaudeOAuthTokenEffect)

export effect function getClaudeOAuthTokenAsyncEffect(opts?: {
  sessionKey?: string
  exclude?: string[]
}): OAuthToken!ElizaError {
  const appToken = readAppManagedAnthropicToken()
  if (appToken) return appToken

  const envToken = processEnv().CLAUDE_CODE_OAUTH_TOKEN?.trim()
  if (envToken) {
    const token: OAuthToken = { accessToken: envToken, expiresAt: Number.POSITIVE_INFINITY }
    tokenCache.set(ENV_CACHE_KEY, token)
    return token
  }

  const bridge = getAnthropicAccountPoolBridge()
  if (bridge) {
    const account = try tryPromise({
      try: () => bridge.selectAnthropicSubscription(opts),
      catch: (cause) =>
        new ElizaError("Failed to select Anthropic OAuth account from pool", {
          code: "ANTHROPIC_OAUTH_POOL_FAILED",
          cause,
        }),
    })
    if (account) {
      const cached = tokenCache.get(account.id)
      if (cached && Date.now() < cached.expiresAt - 60_000) return cached
      const access = try tryPromise({
        try: () => bridge.getAccessToken("anthropic-subscription", account.id),
        catch: (cause) =>
          new ElizaError("Failed to read Anthropic OAuth access token from pool", {
            code: "ANTHROPIC_OAUTH_POOL_FAILED",
            cause,
          }),
      })
      if (access) {
        const token: OAuthToken = {
          accessToken: access,
          expiresAt: account.expiresAt || Number.POSITIVE_INFINITY,
          accountId: account.id,
        }
        tokenCache.set(account.id, token)
        return token
      }
    }
  }

  return try getClaudeOAuthTokenEffect()
}

export const getClaudeOAuthTokenAsync = promised(getClaudeOAuthTokenAsyncEffect)

export function reportClaudeOAuthInvalid(accountId: string | undefined, detail?: string): boolean {
  if (accountId) tokenCache.delete(accountId)
  else tokenCache.clear()
  const bridge = getAnthropicAccountPoolBridge()
  if (!bridge || !accountId) return false
  void bridge.markInvalid(accountId, detail).catch(() => undefined)
  return true
}

export function reportClaudeOAuthRateLimited(
  accountId: string | undefined,
  untilMs: number,
  detail?: string,
): boolean {
  if (accountId) tokenCache.delete(accountId)
  const bridge = getAnthropicAccountPoolBridge()
  if (!bridge || !accountId) return false
  void bridge.markRateLimited(accountId, untilMs, detail).catch(() => undefined)
  return true
}

export effect function getClaudeOAuthMetaEffect(): (ClaudeOAuthMeta | null)!ElizaError {
  const appToken = readAppManagedAnthropicToken()
  if (appToken) {
    return {
      accessToken: appToken.accessToken,
      refreshToken: "",
      expiresAt: appToken.expiresAt,
      scopes: [],
      subscriptionType: "app-managed",
      rateLimitTier: "",
    }
  }
  if (processEnv().CLAUDE_CODE_OAUTH_TOKEN?.trim()) return null
  const credentials = try readFromCredentialStoreEffect()
  return credentials?.claudeAiOauth ?? null
}

export const getClaudeOAuthMeta = thrown(getClaudeOAuthMetaEffect)
