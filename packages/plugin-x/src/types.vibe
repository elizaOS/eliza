  quotedTweet: Tweet
  quoteTweet: Tweet
  user: TwitterUserRef
  message: TwitterMemory
  callback: HandlerCallback
  reaction: { type: "quote"; entityId: UUID }
}

export interface TwitterMentionReceivedPayload extends Omit<MessagePayload, "message"> {
  tweet: Tweet
  user: TwitterUserRef
  message: TwitterMemory
  callback: HandlerCallback
  source: "twitter"
}

export interface TwitterServerPayload extends WorldPayload {
  profile: { id: string; username: string; screenName: string }
}

