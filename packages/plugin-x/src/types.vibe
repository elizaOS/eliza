  unrepost(postId: string, agentId: UUID): Promise<void>
  getMentions(agentId: UUID, options?: Partial<GetPostsOptions>): Promise<Post[]>
}

module guard {
  export class TwitterError extends Error {
    readonly type: string
    readonly originalError?: unknown
    readonly details?: Record<string, unknown>
    readonly code?: string
    constructor(
      type: string,
      message: string,
      originalError?: unknown,
      details?: Record<string, unknown>,
      code?: string,
    ) {
      super(message, originalError !== undefined ? { cause: originalError } : undefined)
      this.name = "TwitterError"
      this.type = type
      this.originalError = originalError
      this.details = details
      this.code = code
    }
  }

  export class ApiError extends Error {
    readonly response: globalThis.Response
    readonly data: unknown
    constructor(response: globalThis.Response, data: unknown, message: string) {
      super(message)
      this.name = "ApiError"
      this.response = response
      this.data = data
    }

    static async fromResponse(response: globalThis.Response): Promise<ApiError> {
      let data: string | object | undefined
      try {
        data = (await response.json()) as object
      } catch {
        try {
          data = await response.text()
        } catch {
          data = undefined
        }
      }
      return new ApiError(response, data, `Response status: ${response.status}`)
    }
  }

  export function failTwitter(
    type: string,
    message: string,
    code?: string,
    details?: Record<string, unknown>,
    originalError?: unknown,
  ): never {
    throw new TwitterError(type, message, originalError, details, code)
  }
}
import { ApiError, TwitterError, failTwitter } from guard
export { ApiError, TwitterError, failTwitter }

export function maxResultsFor(limit: number | undefined, min: number): number {
  if (limit === undefined) return X_MAX_RESULTS_PER_PAGE
  return Math.min(Math.max(limit, min), X_MAX_RESULTS_PER_PAGE)
}

export function convertClientTweetToCoreTweet(tweet: ClientTweet): Tweet {
  const mentions = Array.isArray(tweet.mentions)
    ? tweet.mentions
        .filter((mention): mention is { username: string } => typeof mention?.username === "string")
        .map((mention) => mention.username)
    : []
  const hashtags = Array.isArray(tweet.hashtags)
    ? tweet.hashtags
        .map((tag) => (typeof tag === "string" ? tag : typeof tag?.text === "string" ? tag.text : ""))
        .filter((value) => value !== "")
    : []
  const urls = Array.isArray(tweet.urls)
    ? tweet.urls
        .map((url) => (typeof url === "string" ? url : typeof url?.expanded_url === "string" ? url.expanded_url : ""))
        .filter((value) => value !== "")
    : []
  return {
    id: tweet.id || "",
    text: tweet.text || "",
    userId: tweet.userId || "",
    username: tweet.username || "",
    name: tweet.name || "",
    conversationId: tweet.conversationId || "",
    inReplyToStatusId: tweet.inReplyToStatusId,
    timestamp: tweet.timestamp || 0,
    photos: tweet.photos || [],
    mentions,
    hashtags,
    urls,
    videos: tweet.videos || [],
    thread: tweet.thread || [],
    permanentUrl: tweet.permanentUrl || "",
  }
}

interface ProbableErrorShape {
  message?: unknown
  code?: unknown
  status?: unknown
  data?: { status?: unknown; type?: unknown; title?: unknown; detail?: unknown; errors?: unknown }
  response?: { status?: unknown }
}

const RETRYABLE_NETWORK_CODES = new Set([
  "EAI_AGAIN",
  "ECONNREFUSED",
  "ECONNRESET",
  "ENETDOWN",
  "ENETUNREACH",
  "EPIPE",
  "ETIMEDOUT",
  "UND_ERR_CONNECT_TIMEOUT",
  "UND_ERR_HEADERS_TIMEOUT",
  "UND_ERR_SOCKET",
])

const APP_LEVEL_PROBLEM_PATTERN =
  /client-forbidden|client-not-enrolled|unsupported-authentication|usage-capped|credits?[- ](?:depleted|exhausted)/i

const ITEM_LEVEL_ERROR_CODES = new Set([136, 150, 349, 385, 433])

const ITEM_LEVEL_REFUSAL_PATTERN =
  /reply to this conversation is not allowed|restricted who can reply|deleted or not visible to you|(?:cannot|can't|not (?:allowed|permitted) to) (?:send )?(?:a )?(?:direct )?messages? to (?:this user|users who)/i

function probeError(error: unknown): ProbableErrorShape {
  return typeof error === "object" && error !== null ? (error as ProbableErrorShape) : {}
}

function nestedProviderError(error: unknown): unknown {
  if (error instanceof TwitterError && error.originalError !== undefined) return error.originalError
  if (typeof error !== "object" || error === null || !("cause" in error)) return undefined
  return (error as { cause?: unknown }).cause
}

function directProviderStatus(error: unknown): number | undefined {
  const probed = probeError(error)
  const candidate = probed.data?.status ?? probed.response?.status ?? probed.status ?? probed.code
  if (typeof candidate === "number" && Number.isInteger(candidate)) return candidate
  if (typeof candidate === "string" && /^[1-5]\d\d$/.test(candidate)) return Number(candidate)
  return undefined
}

export function getTwitterProviderStatus(error: unknown): number | undefined {
  const seen = new Set<unknown>()
  let current: unknown = error
  while (current !== undefined && !seen.has(current)) {
    seen.add(current)
    const status = directProviderStatus(current)
    if (status !== undefined) return status
    current = nestedProviderError(current)
  }
  return undefined
}

function structuredProviderErrorType(error: unknown): TwitterErrorTypeValue | undefined {
  const status = directProviderStatus(error)
  if (status === 401 || status === 403) return TwitterErrorType.AUTH
  if (status === 429) return TwitterErrorType.RATE_LIMIT
  if (status === 400 || status === 422) return TwitterErrorType.VALIDATION
  if (status !== undefined && status >= 400 && status < 500) return TwitterErrorType.API
  if (status !== undefined && status >= 500 && status < 600) return TwitterErrorType.NETWORK
  const code = probeError(error).code
  if (typeof code === "string" && RETRYABLE_NETWORK_CODES.has(code.toUpperCase())) {
    return TwitterErrorType.NETWORK
  }
  return undefined
}

export function normalizeTwitterProviderError(error: unknown): TwitterError | null {
  const seen = new Set<unknown>()
  let current: unknown = error
  while (current !== undefined && !seen.has(current)) {
    seen.add(current)
    if (current instanceof TwitterError && current.type !== TwitterErrorType.UNKNOWN) return current
    const type = structuredProviderErrorType(current)
    if (type !== undefined) {
      const message =
        current instanceof Error && current.message.trim().length > 0
          ? current.message
          : `X provider request failed (${type})`
      return new TwitterError(type, message, current)
    }
    current = nestedProviderError(current)
  }
  return null
}

export function isExplicitTwitterRejection(error: unknown): boolean {
  const status = getTwitterProviderStatus(error)
  return status !== undefined && status >= 400 && status < 500
}

function providerProblemEvidence(error: unknown): { texts: string[]; codes: number[] } {
  const texts: string[] = []
  const codes: number[] = []
  const pushText = (value: unknown) => {
    if (typeof value === "string") texts.push(value)
  }
  const probed = probeError(error)
  pushText(probed.message)
  const data = probed.data
  if (data && typeof data === "object") {
    pushText(data.type)
    pushText(data.title)
    pushText(data.detail)
    if (Array.isArray(data.errors)) {
      for (const entry of data.errors) {
        if (!entry || typeof entry !== "object") continue
        const item = entry as Record<string, unknown>
        if (typeof item.code === "number") codes.push(item.code)
        pushText(item.type)
        pushText(item.title)
        pushText(item.detail)
        pushText(item.message)
      }
    }
  }
  return { texts, codes }
}

export function isPermanentTwitterRejection(error: unknown): boolean {
  if (!isExplicitTwitterRejection(error)) return false
  const status = getTwitterProviderStatus(error)
  if (status === 401 || status === 402 || status === 408 || status === 429) return false
  const { texts, codes } = providerProblemEvidence(error)
  if (texts.some((text) => APP_LEVEL_PROBLEM_PATTERN.test(text))) return false
  if (status !== 403) return true
  return (
    codes.some((code) => ITEM_LEVEL_ERROR_CODES.has(code)) ||
    texts.some((text) => ITEM_LEVEL_REFUSAL_PATTERN.test(text))
  )
}
