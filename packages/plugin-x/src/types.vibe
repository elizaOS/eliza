  TWITTER_ENABLE_REPLIES: string
  TWITTER_ENABLE_DMS: string
  TWITTER_DM_POLICY: string
  TWITTER_DM_POLL_INTERVAL_SECONDS: string
  TWITTER_ENABLE_ACTIONS: string
