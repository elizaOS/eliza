// spec/sqlite/index.md, "Story: Reopen my agent's SQLite database in the owning runtime"
module recordDocuments {
  import {
    authorizeMessageContentRead,
    canonicalAttachmentText,
    canRequesterManageDocumentDirectGrants,
    canRequesterMutateDocument,
    DOCUMENT_SOURCE_READ_LOOKAHEAD_SEGMENTS,
    documentMutationSnapshotMatches,
    ElizaError,
    hashAttachmentIdForLocator,
    isDocumentVisibleToRequester,
    MemoryType,
    MESSAGE_CONTENT_PARENT_INLINE_MAX_BYTES,
    MESSAGE_CONTENT_READ_MAX_SEGMENTS,
    queryDocumentFragmentsInMemory,
    queryDocumentsInMemory,
    readDocumentSourceProjection,
    readMessageContentProjection,
    requireDocumentSourceReadMetadata,
    resolveMessageContentSourceDescriptor,
    validateDocumentDirectGrantEntityIds,
    validateDocumentRevisionReplacement,
    type DocumentCompareAndSwapParams,
    type DocumentDeleteParams,
    type DocumentDirectGrantUpdateParams,
    type DocumentFragmentQueryParams,
    type DocumentGetQueryParams,
    type DocumentListQueryParams,
    type DocumentListQueryResult,
    type DocumentMutationResult,
    type DocumentRangeReadParams,
    type DocumentRangeReadResult,
    type DocumentRequesterContext,
    type DocumentRevisionReplaceParams,
    type Entity,
    type Memory,
    type MemoryMetadata,
    type MessageContentPublicationParams,
    type MessageContentPublicationResult,
    type MessageContentRangeReadParams,
    type MessageContentRangeReadResult,
    type UUID,
  } from "@elizaos/core"
  import type { EphemeralHNSW } from "./hnsw.vibe"
  import { persistableMemory, storedMemoryTableName, toMemory, type StoredMemory, type StoredParticipant } from "./record-helpers.vibe"
  import { COLLECTIONS, type IStorage } from "./types.vibe"

  export interface DocumentOpsHost {
    readonly storage: IStorage
    readonly vectorIndex: EphemeralHNSW
    readonly embeddingDimension: number
    getRoomsForParticipants(entityIds: UUID[]): Promise<UUID[]>
    getEntitiesByIds(entityIds: UUID[]): Promise<Entity[]>
    withMemoryMutationLock<T>(operation: () => Promise<T>): Promise<T>
  }

  async function currentDocumentRequester<T extends DocumentRequesterContext>(host: DocumentOpsHost, params: T): Promise<T> {
    return { ...params, requesterRoomIds: await host.getRoomsForParticipants([params.requesterEntityId]) }
  }

  async function loadOwnedDocument(
    host: DocumentOpsHost,
    documentId: UUID,
    agentId: UUID,
  ): Promise<{ stored: StoredMemory; existing: Memory } | null> {
    const stored = await host.storage.get<StoredMemory>(COLLECTIONS.MEMORIES, documentId)
    if (!stored || storedMemoryTableName(stored) !== "documents" || stored.agentId !== agentId) return null
    return { stored, existing: toMemory(stored) }
  }

  async function listDocumentMemories(host: DocumentOpsHost): Promise<Memory[]> {
    const memories = await host.storage.getWhere<StoredMemory>(
      COLLECTIONS.MEMORIES,
      (memory) => storedMemoryTableName(memory) === "documents" || storedMemoryTableName(memory) === "document_fragments",
    )
    return memories.map(toMemory)
  }

  type DocumentMutationCheck =
    | { ok: true; scoped: DocumentRequesterContext; stored: StoredMemory; existing: Memory }
    | { ok: false; result: DocumentMutationResult }

  async function checkDocumentMutation<T extends DocumentRequesterContext & { documentId: UUID; agentId: UUID; expected: DocumentCompareAndSwapParams["expected"] }>(
    host: DocumentOpsHost,
    params: T,
    mode: "mutate" | "grants" | "visible-mutate",
  ): Promise<(DocumentMutationCheck & { ok: true; scoped: T }) | { ok: false; result: DocumentMutationResult }> {
    const scoped = await currentDocumentRequester(host, params)
    const loaded = await loadOwnedDocument(host, scoped.documentId, scoped.agentId)
    if (!loaded) return { ok: false, result: { status: "not_found" } }
    if (!documentMutationSnapshotMatches(loaded.existing, scoped.expected)) return { ok: false, result: { status: "conflict" } }
    if (mode === "grants") {
      if (!canRequesterManageDocumentDirectGrants(loaded.existing, scoped)) return { ok: false, result: { status: "forbidden" } }
    } else if (mode === "visible-mutate") {
      if (!isDocumentVisibleToRequester(loaded.existing, scoped)) return { ok: false, result: { status: "not_found" } }
      if (!canRequesterMutateDocument(loaded.existing, scoped)) return { ok: false, result: { status: "forbidden" } }
    } else if (!canRequesterMutateDocument(loaded.existing, scoped)) {
      return { ok: false, result: { status: isDocumentVisibleToRequester(loaded.existing, scoped) ? "forbidden" : "not_found" } }
    }
    return { ok: true, scoped, stored: loaded.stored, existing: loaded.existing }
  }

  export async function runQueryDocuments(host: DocumentOpsHost, params: DocumentListQueryParams): Promise<DocumentListQueryResult> {
    const scoped = await currentDocumentRequester(host, params)
    return queryDocumentsInMemory(await listDocumentMemories(host), scoped)
  }

  export async function runGetDocument(host: DocumentOpsHost, params: DocumentGetQueryParams): Promise<Memory | null> {
    const scoped = await currentDocumentRequester(host, params)
    const loaded = await loadOwnedDocument(host, scoped.documentId, scoped.agentId)
    if (!loaded) return null
    return isDocumentVisibleToRequester(loaded.existing, scoped) ? loaded.existing : null
  }

  export async function runReadDocumentRange(
    host: DocumentOpsHost,
    params: DocumentRangeReadParams,
  ): Promise<DocumentRangeReadResult | null> {
    if (
      !["line", "fragment", "byte"].includes(params.unit) ||
      !Number.isSafeInteger(params.offset) ||
      params.offset < 0 ||
      !Number.isSafeInteger(params.limit) ||
      params.limit < 1 ||
      params.offset > Number.MAX_SAFE_INTEGER - params.limit
    ) {
      throw new ElizaError("Document range read requires a bounded safe-integer range", { code: "DOCUMENT_READ_INVALID_RANGE" })
    }
    const document = await runGetDocument(host, params)
    if (!document) return null
    const parent = requireDocumentSourceReadMetadata((document.metadata ?? {}) as Record<string, unknown>, params.documentId)
    const prefix = params.unit === "byte" ? "sourceByte" : params.unit === "line" ? "sourceLine" : "sourceFragment"
    const total =
      params.unit === "byte" ? parent.sourceByteLength : params.unit === "line" ? parent.sourceLineCount : parent.sourceFragmentCount
    const end = Math.min(params.offset + params.limit, total)
    const rows =
      params.offset >= total
        ? []
        : await host.storage.getWhere<StoredMemory>(COLLECTIONS.MEMORIES, (memory) => {
            const metadata = memory.metadata as Record<string, unknown> | undefined
            return (
              storedMemoryTableName(memory) === "document_fragments" &&
              memory.agentId === params.agentId &&
              metadata?.documentId === params.documentId &&
              metadata.fragmentRole === "source-segment" &&
              metadata.sourceSegmentVersion === 1 &&
              typeof metadata[`${prefix}Start`] === "number" &&
              typeof metadata[`${prefix}End`] === "number" &&
              Number(metadata[`${prefix}Start`]) < end &&
              Number(metadata[`${prefix}End`]) > params.offset
            )
          })
    const segments = rows
      .sort(
        (left, right) =>
          Number((left.metadata as Record<string, unknown> | undefined)?.sourceByteStart) -
          Number((right.metadata as Record<string, unknown> | undefined)?.sourceByteStart),
      )
      .slice(0, DOCUMENT_SOURCE_READ_LOOKAHEAD_SEGMENTS)
      .map(toMemory)
    return readDocumentSourceProjection({
      segments,
      params,
      parent,
      documentId: params.documentId,
      examinedSourceSegments: rows.length,
      sourceQueryCount: params.offset >= total ? 1 : 2,
    })
  }

  export async function runQueryDocumentFragments(host: DocumentOpsHost, params: DocumentFragmentQueryParams): Promise<Memory[]> {
    const scoped = await currentDocumentRequester(host, params)
    return queryDocumentFragmentsInMemory(await listDocumentMemories(host), scoped, host.embeddingDimension)
  }

  export async function runCompareAndSwapDocument(
    host: DocumentOpsHost,
    params: DocumentCompareAndSwapParams,
  ): Promise<DocumentMutationResult> {
    return host.withMemoryMutationLock(async () => {
      const checked = await checkDocumentMutation(host, params, "mutate")
      if (!checked.ok) return checked.result
      const { scoped, stored } = checked
      const replacement: StoredMemory = {
        ...stored,
        ...scoped.replacement,
        id: scoped.documentId,
        tableName: "documents",
        agentId: scoped.agentId,
        metadata: scoped.replacement.metadata,
      }
      await host.storage.set(COLLECTIONS.MEMORIES, scoped.documentId, replacement)
      return { status: "updated", document: toMemory(replacement) }
    })
  }

  export async function runUpdateDocumentDirectGrants(
    host: DocumentOpsHost,
    params: DocumentDirectGrantUpdateParams,
  ): Promise<DocumentMutationResult> {
    const directGrantEntityIds = validateDocumentDirectGrantEntityIds(params.directGrantEntityIds)
    return host.withMemoryMutationLock(async () => {
      const checked = await checkDocumentMutation(host, params, "grants")
      if (!checked.ok) return checked.result
      const { scoped, stored } = checked
      const grantees = await host.getEntitiesByIds(directGrantEntityIds)
      if (grantees.length !== directGrantEntityIds.length || grantees.some((entity) => entity.agentId !== scoped.agentId)) {
        return { status: "not_found" }
      }
      const metadata = { ...((stored.metadata ?? {}) as Record<string, unknown>) }
      if (directGrantEntityIds.length > 0) metadata.directGrantEntityIds = directGrantEntityIds
      else delete metadata.directGrantEntityIds
      const updated: StoredMemory = { ...stored, metadata: metadata as MemoryMetadata }
      await host.storage.set(COLLECTIONS.MEMORIES, scoped.documentId, updated)
      return { status: "updated", document: toMemory(updated) }
    })
  }

  export async function runReplaceDocumentRevision(
    host: DocumentOpsHost,
    params: DocumentRevisionReplaceParams,
  ): Promise<DocumentMutationResult> {
    validateDocumentRevisionReplacement(params)
    return host.withMemoryMutationLock(async () => {
      const checked = await checkDocumentMutation(host, params, "visible-mutate")
      if (!checked.ok) return checked.result
      const { scoped, stored } = checked
      if (!host.storage.applyBatch) {
        throw new ElizaError("SQLite record storage cannot atomically replace documents", {
          code: "DOCUMENT_REVISION_ATOMIC_STORAGE_REQUIRED",
          context: { documentId: scoped.documentId },
        })
      }
      const oldFragments = await host.storage.getWhere<StoredMemory>(
        COLLECTIONS.MEMORIES,
        (memory) =>
          memory.agentId === scoped.agentId &&
          memory.metadata?.type === MemoryType.FRAGMENT &&
          memory.metadata.documentId === scoped.documentId,
      )
      const oldIds = oldFragments.map(({ id }) => id).filter((id): id is string => typeof id === "string")
      for (const fragment of scoped.fragments) {
        const collision = await host.storage.get<StoredMemory>(COLLECTIONS.MEMORIES, fragment.id as UUID)
        if (collision) {
          throw new ElizaError("Atomic document fragment id already exists", {
            code: "DOCUMENT_REVISION_FRAGMENT_ID_CONFLICT",
            context: { documentId: scoped.documentId, fragmentId: fragment.id },
          })
        }
      }
      const replacement: StoredMemory = {
        ...stored,
        ...scoped.replacement,
        id: scoped.documentId,
        tableName: "documents",
        agentId: scoped.agentId,
      }
      const newFragments: StoredMemory[] = scoped.fragments.map((fragment) => ({
        ...fragment,
        id: fragment.id,
        tableName: "document_fragments",
        agentId: scoped.agentId,
        createdAt: fragment.createdAt ?? Date.now(),
      }))
      const indexedNewIds: string[] = []
      try {
        for (const fragment of newFragments) {
          if (!fragment.embedding || fragment.embedding.length === 0) continue
          await host.vectorIndex.add(fragment.id as string, fragment.embedding)
          indexedNewIds.push(fragment.id as string)
        }
        await host.storage.applyBatch({
          collection: COLLECTIONS.MEMORIES,
          deletes: oldIds,
          sets: [
            { id: scoped.documentId, data: replacement },
            ...newFragments.map((data) => ({ id: data.id as string, data })),
          ],
        })
      } catch (error) {
        await Promise.all(indexedNewIds.map((id) => host.vectorIndex.remove(id)))
        throw new ElizaError("Failed to stage an atomic document revision", {
          code: "DOCUMENT_REVISION_STAGE_FAILED",
          context: { documentId: scoped.documentId },
          cause: error,
        })
      }
      await Promise.all(oldIds.map((id) => host.vectorIndex.remove(id)))
      return { status: "updated", document: toMemory(replacement) }
    })
  }

  export async function runDeleteDocumentWithSnapshot(
    host: DocumentOpsHost,
    params: DocumentDeleteParams,
  ): Promise<DocumentMutationResult> {
    return host.withMemoryMutationLock(async () => {
      const checked = await checkDocumentMutation(host, params, "mutate")
      if (!checked.ok) return checked.result
      const { scoped, existing } = checked
      const fragments = await host.storage.getWhere<StoredMemory>(COLLECTIONS.MEMORIES, (memory) => {
        const metadata = memory.metadata as Record<string, unknown> | undefined
        return (
          memory.agentId === scoped.agentId &&
          metadata?.type === MemoryType.FRAGMENT &&
          metadata.documentId === scoped.documentId
        )
      })
      const fragmentIds = fragments.map((memory) => memory.id).filter((id): id is string => typeof id === "string")
      await host.storage.deleteMany(COLLECTIONS.MEMORIES, [...fragmentIds, scoped.documentId])
      await Promise.all(fragmentIds.map((id) => host.vectorIndex.remove(id)))
      return { status: "deleted", document: existing }
    })
  }

  async function validateRemovedSegments(
    host: DocumentOpsHost,
    params: Extract<MessageContentPublicationParams, { mode: "replace" }>,
  ): Promise<void> {
    for (const segmentId of params.removeSegmentIds) {
      const segment = await host.storage.get<StoredMemory>(COLLECTIONS.MEMORIES, segmentId)
      const metadata = segment?.metadata as Record<string, unknown> | undefined
      if (
        !segment ||
        segment.agentId !== params.agentId ||
        metadata?.type !== "message-content-segment" ||
        metadata.messageId !== params.messageId
      ) {
        throw new ElizaError("Message content replacement cannot remove an unrelated or missing segment", {
          code: "MESSAGE_CONTENT_DELETE_INCOMPLETE",
          context: { messageId: params.messageId, segmentId },
        })
      }
    }
  }

  async function validateNewSegments(
    host: DocumentOpsHost,
    segments: readonly Memory[],
    parentId: UUID,
    publicationAgentId: UUID,
    removedIds: ReadonlySet<string>,
  ): Promise<void> {
    const newSegmentIds = new Set<string>()
    for (const segment of segments) {
      if (!segment.id || segment.agentId !== publicationAgentId) {
        throw new ElizaError("Message content segment identity is invalid", {
          code: "MESSAGE_CONTENT_PUBLICATION_INVALID",
          context: { messageId: parentId },
        })
      }
      if (newSegmentIds.has(segment.id)) {
        throw new ElizaError("Message content segment id is duplicated", {
          code: "MESSAGE_CONTENT_SEGMENT_ID_CONFLICT",
          context: { messageId: parentId, segmentId: segment.id },
        })
      }
      newSegmentIds.add(segment.id)
      const collision = await host.storage.get<StoredMemory>(COLLECTIONS.MEMORIES, segment.id)
      if (collision && !removedIds.has(segment.id)) {
        throw new ElizaError("Message content segment id already exists", {
          code: "MESSAGE_CONTENT_SEGMENT_ID_CONFLICT",
          context: { messageId: parentId, segmentId: segment.id },
        })
      }
    }
  }

  export async function runPublishMessageContentSegments(
    host: DocumentOpsHost,
    params: MessageContentPublicationParams,
  ): Promise<MessageContentPublicationResult> {
    return host.withMemoryMutationLock(async () => {
      if (!host.storage.applyBatch) {
        throw new ElizaError("The configured storage cannot atomically publish message content", {
          code: "MESSAGE_CONTENT_ATOMIC_STORAGE_REQUIRED",
        })
      }
      const parentId = params.mode === "create" ? params.parent.id : params.messageId
      const publicationAgentId = params.mode === "create" ? params.parent.agentId : params.agentId
      if (!parentId || !publicationAgentId) {
        throw new ElizaError("Message content publication requires parent and agent IDs", {
          code: "MESSAGE_CONTENT_PUBLICATION_INVALID",
        })
      }
      const existing = await host.storage.get<StoredMemory>(COLLECTIONS.MEMORIES, parentId)
      if (params.mode === "create" && existing) return { status: "conflict" }
      if (params.mode === "replace") {
        if (!existing || storedMemoryTableName(existing) !== "messages" || existing.agentId !== params.agentId) {
          return { status: "not_found" }
        }
        if (JSON.stringify(existing.content) !== JSON.stringify(params.expectedContent)) return { status: "conflict" }
        await validateRemovedSegments(host, params)
      }
      const removedIds = params.mode === "replace" ? new Set<string>(params.removeSegmentIds) : new Set<string>()
      await validateNewSegments(host, params.segments, parentId, publicationAgentId, removedIds)
      const now = Date.now()
      const storedSegments: StoredMemory[] = params.segments.map((segment) => ({
        ...persistableMemory(segment),
        id: segment.id,
        tableName: "message_content_segments",
        agentId: publicationAgentId,
        createdAt: segment.createdAt ?? now,
      }))
      const storedParent: StoredMemory =
        params.mode === "create"
          ? {
              ...persistableMemory(params.parent),
              id: parentId,
              tableName: "messages",
              agentId: publicationAgentId,
              unique: params.parent.unique ?? true,
              createdAt: params.parent.createdAt ?? now,
            }
          : {
              ...(existing as StoredMemory),
              content: persistableMemory({ content: params.replacementContent }).content,
            }
      let parentIndexStaged = false
      try {
        if (params.mode === "create" && storedParent.embedding?.length) {
          await host.vectorIndex.add(parentId, storedParent.embedding)
          parentIndexStaged = true
        }
        await host.storage.applyBatch({
          collection: COLLECTIONS.MEMORIES,
          deletes: [...removedIds],
          sets: [...storedSegments.map((data) => ({ id: data.id as string, data })), { id: parentId, data: storedParent }],
        })
      } catch (cause) {
        if (parentIndexStaged) await host.vectorIndex.remove(parentId)
        throw new ElizaError("Failed to publish atomic message content", {
          code: "MESSAGE_CONTENT_PUBLICATION_FAILED",
          context: { messageId: parentId },
          cause,
        })
      }
      for (const removedId of removedIds) await host.vectorIndex.remove(removedId)
      for (const segment of storedSegments) {
        if (segment.id && segment.embedding && segment.embedding.length > 0) {
          await host.vectorIndex.add(segment.id, segment.embedding)
        }
      }
      return {
        status: params.mode === "create" ? "created" : "updated",
        parent: toMemory(storedParent),
        removedSegmentIds: params.mode === "create" ? [] : [...params.removeSegmentIds],
      }
    })
  }

  export async function runReadMessageContentRange(
    host: DocumentOpsHost,
    params: MessageContentRangeReadParams,
  ): Promise<MessageContentRangeReadResult> {
    if (
      !Number.isSafeInteger(params.offset) ||
      params.offset < 0 ||
      !Number.isSafeInteger(params.limit) ||
      params.limit < 1 ||
      params.limit > MESSAGE_CONTENT_PARENT_INLINE_MAX_BYTES
    ) {
      throw new ElizaError("Message content range is invalid", { code: "MESSAGE_CONTENT_INVALID_RANGE" })
    }
    const storedParent = await host.storage.get<StoredMemory>(COLLECTIONS.MEMORIES, params.messageId)
    if (
      !storedParent ||
      storedMemoryTableName(storedParent) !== "messages" ||
      storedParent.agentId !== params.agentId ||
      storedParent.roomId !== params.authorizedRoomId
    ) {
      return { status: "not_found" }
    }
    const parent = toMemory(storedParent)
    const participants = await host.storage.getWhere<StoredParticipant>(
      COLLECTIONS.PARTICIPANTS,
      (participant) => participant.roomId === parent.roomId && participant.entityId === params.accessContext.requesterEntityId,
    )
    if (
      !authorizeMessageContentRead({
        parent,
        authorizedRoomId: params.authorizedRoomId,
        requester: params.accessContext,
        agentId: params.agentId,
        participantCurrent: participants.length > 0,
        selector: params.source,
      })
    ) {
      return { status: "forbidden" }
    }
    const descriptor = resolveMessageContentSourceDescriptor(parent.content, params.source)
    if (!descriptor) {
      let inline: string
      if (params.source.kind === "message-text") {
        inline = parent.content.text ?? ""
      } else {
        const attachment = (parent.content.attachments ?? []).find(
          (item) => hashAttachmentIdForLocator(item.id) === params.source.attachmentIdHash,
        )
        inline = attachment ? canonicalAttachmentText(attachment) : ""
      }
      if (new TextEncoder().encode(inline).length > MESSAGE_CONTENT_PARENT_INLINE_MAX_BYTES) {
        throw new ElizaError("Legacy content requires explicit segmented reindexing", {
          code: params.source.kind === "message-text" ? "MESSAGE_REINDEX_REQUIRED" : "ATTACHMENT_REINDEX_REQUIRED",
          context: { messageId: params.messageId },
        })
      }
      return { status: "inline", parent, text: inline }
    }
    if (params.offset > 0 && !params.expectedRevision) {
      throw new ElizaError("Message content continuation requires a revision", { code: "MESSAGE_CONTENT_EXPECTED_REVISION_REQUIRED" })
    }
    if (params.expectedRevision && params.expectedRevision !== descriptor.revision) {
      throw new ElizaError("Message content changed before continuation", {
        code: "MESSAGE_CONTENT_STALE_REVISION",
        context: { messageId: params.messageId },
      })
    }
    const requestedEnd = Math.min(params.offset + params.limit, descriptor.byteLength)
    const selected = await host.storage.getWhere<StoredMemory>(COLLECTIONS.MEMORIES, (segment) => {
      const metadata = segment.metadata as Record<string, unknown> | undefined
      return (
        segment.agentId === params.agentId &&
        storedMemoryTableName(segment) === "message_content_segments" &&
        metadata?.type === "message-content-segment" &&
        metadata.messageId === params.messageId &&
        metadata.sourceKind === params.source.kind &&
        metadata.attachmentIdHash === params.source.attachmentIdHash &&
        metadata.sourceRevision === descriptor.revision &&
        typeof metadata.byteStart === "number" &&
        typeof metadata.byteEnd === "number" &&
        metadata.byteEnd > params.offset &&
        metadata.byteStart < requestedEnd
      )
    })
    selected.sort(
      (left, right) =>
        Number((left.metadata as Record<string, unknown> | undefined)?.byteStart ?? -1) -
        Number((right.metadata as Record<string, unknown> | undefined)?.byteStart ?? -1),
    )
    return {
      status: "ok",
      parent,
      page: readMessageContentProjection({
        descriptor,
        segments: selected.slice(0, MESSAGE_CONTENT_READ_MAX_SEGMENTS).map(toMemory),
        messageId: params.messageId,
        offset: params.offset,
        limit: params.limit,
        sourceQueryCount: 0,
      }),
    }
  }
}

import {
  runCompareAndSwapDocument,
  runDeleteDocumentWithSnapshot,
  runGetDocument,
  runPublishMessageContentSegments,
  runQueryDocumentFragments,
  runQueryDocuments,
  runReadDocumentRange,
  runReadMessageContentRange,
  runReplaceDocumentRevision,
  runUpdateDocumentDirectGrants,
  type DocumentOpsHost,
} from recordDocuments

export {
  runCompareAndSwapDocument,
  runDeleteDocumentWithSnapshot,
  runGetDocument,
  runPublishMessageContentSegments,
  runQueryDocumentFragments,
  runQueryDocuments,
  runReadDocumentRange,
  runReadMessageContentRange,
  runReplaceDocumentRevision,
  runUpdateDocumentDirectGrants,
  type DocumentOpsHost,
}
