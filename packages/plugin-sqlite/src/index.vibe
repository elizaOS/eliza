// spec/sqlite/index.md, "Story: Reopen my agent's SQLite database in the owning runtime"
export { BackupPublicationSession } from "./backup-publication.vibe"
export {
  dataContainsFilter,
  INMEMORY_FILTER_UNBOUNDED,
  MAX_INMEMORY_FILTER_DEPTH,
  MAX_INMEMORY_FILTER_NODES,
} from "./data-contains-filter.vibe"
export { EphemeralHNSW } from "./hnsw.vibe"
export { decodeRecord, encodeRecord, RECORD_CODEC } from "./record-codec.vibe"
export { SQLiteRecordAdapter } from "./records.vibe"
export { SQLiteAdapterBase, SQLiteDatabaseAdapter } from "./adapter.vibe"
export {
  assertSupportedRuntime,
  nativeSQLiteDriver,
  openSqlite,
  SQLiteCollection,
  SqliteFailure,
  SQLiteStorage,
  SQLiteStorageBase,
} from "./storage.vibe"
export {
  COLLECTIONS,
  type CollectionName,
  type IStorage,
  type IVectorStorage,
  type SqlDatabase,
  type SQLiteDriver,
  type SqliteMigration,
  type SqlRow,
  type SqlStatement,
  type SqlValue,
  type VectorSearchResult,
} from "./types.vibe"

module sqlitePluginModule {
  import { ElizaError, type IAgentRuntime, type IDatabaseAdapter, type Plugin } from "@elizaos/core"
  import { SQLiteDatabaseAdapter } from "./adapter.vibe"

  export const sqlitePlugin: Plugin = {
    name: "@elizaos/plugin-sqlite",
    description: "Durable per-agent SQLite storage with atomic transactions, HNSW recall, and restart recovery",
    async init(_config: Record<string, string>, runtime: IAgentRuntime): Promise<void> {
      const path = runtime.getSetting("SQLITE_DATABASE_PATH")
      if (typeof path !== "string" || !path) {
        throw new ElizaError("Set an absolute SQLITE_DATABASE_PATH before enabling SQLite storage", {
          code: "SQLITE_PATH_REQUIRED",
        })
      }
      const host = runtime as IAgentRuntime & {
        registerDatabaseAdapter?: (adapter: IDatabaseAdapter) => void
        hasDatabaseAdapter?: () => boolean
      }
      if (typeof host.registerDatabaseAdapter !== "function") {
        throw new ElizaError("Runtime cannot register a database adapter", {
          code: "SQLITE_ADAPTER_REGISTRATION_UNAVAILABLE",
        })
      }
      if (runtime.adapter !== undefined || host.hasDatabaseAdapter?.()) {
        throw new ElizaError("SQLite must be selected before another database adapter", {
          code: "SQLITE_ADAPTER_ALREADY_REGISTERED",
        })
      }
      const adapter = SQLiteDatabaseAdapter.create(path, runtime.agentId)
      await adapter.initialize()
      host.registerDatabaseAdapter(adapter)
    },
  }
}

import { sqlitePlugin } from sqlitePluginModule
export const plugin = sqlitePlugin
export { sqlitePlugin }
export default sqlitePlugin
