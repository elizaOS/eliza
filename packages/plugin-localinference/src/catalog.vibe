// spec/localInference/models.md, "Only a model in the curated catalog is downloaded, and only when it is not already present"; spec/localInference/textAndEmbeddings.md, "Vectors are compared only within one vector space"
import { BGE_SMALL_VECTOR_SPACE } from "@elizaos/core"
import { catalog, initial, modelOf, type ModelRole } from "../gen/localInference__models.effect.vibe"
import type { VectorSpace } from "../gen/localInference__textAndEmbeddings.effect.vibe"

export type CatalogId = "model1" | "model2"

export interface PublishedFile {
  readonly path: string
  readonly url: string
  readonly sha256: string
}

export type ModelSource =
  | { readonly kind: "bundle"; readonly manifestUrl: string; readonly fileBase: string }
  | { readonly kind: "pinned"; readonly files: readonly PublishedFile[] }

export interface EmbeddingSpace {
  readonly space: VectorSpace
  readonly spaceId: string
}

export interface CatalogModel {
  readonly id: CatalogId
  readonly name: string
  readonly role: ModelRole
  readonly source: ModelSource
  readonly embedding?: EmbeddingSpace
}

const eliza1Bundle = "https://huggingface.co/elizaos/eliza-1/resolve/main/bundles/e2b"
const bgeRevision = "d32f8c040ea3b516330eeb75b72bcc2d3a780ab7"
const bgeFile = "bge-small-en-v1.5-f16.gguf"

export type Catalog = Readonly<Record<CatalogId, CatalogModel>>

export const curatedModels: Catalog = {
  model1: {
    id: "model1",
    name: "eliza-1-2b",
    role: modelOf(initial, "model1").role,
    source: { kind: "bundle", manifestUrl: `${eliza1Bundle}/eliza-1.manifest.json`, fileBase: eliza1Bundle },
  },
  model2: {
    id: "model2",
    name: "bge-small-en-v1.5",
    role: modelOf(initial, "model2").role,
    source: {
      kind: "pinned",
      files: [{
        path: bgeFile,
        url: `https://huggingface.co/CompendiumLabs/bge-small-en-v1.5-gguf/resolve/${bgeRevision}/${bgeFile}`,
        sha256: "f0b2fef971e8366438bfd2d9aefea1b0115919389448806d290237f638bae999",
      }],
    },
    embedding: { space: { spaceModel: "BAAI/bge-small-en-v1.5", dimensions: 384, pooling: "ClsPooling" }, spaceId: BGE_SMALL_VECTOR_SPACE },
  },
}

export function isCatalogId(value: string): value is CatalogId {
  return catalog.includes(value) && Object.hasOwn(curatedModels, value)
}

export function modelNamed(name: string, models: Catalog = curatedModels): CatalogModel | undefined {
  return Object.values(models).find((model) => model.name === name)
}
