// spec/localInference/models.md, "Story: Run a model of my choice on my device"; spec/localInference/models.md, "Only a model in the curated catalog is downloaded, and only when it is not already present"; spec/localInference/models.md, "A download is installed only when every file matches its published digest"; spec/localInference/models.md, "A slot is assigned only to an installed model whose role serves it, one slot per change"; spec/localInference/models.md, "An unreadable assignment record is reported, never rewritten from empty"; spec/localInference/models.md, "Only an installed model whose evaluations passed is activated"; spec/localInference/models.md, "Removing a model first unloads it and clears every slot that named it"; spec/localInference/models.md, "A model whose files cannot be read is reported unreadable, never as absent"; spec/localInference/textAndEmbeddings.md, "Text is generated only by the active model once it is ready"; spec/localInference/textAndEmbeddings.md, "An embedding is computed only by the model assigned to embeddings"
import { HttpClient, HttpClientRequest } from "effect/http"
import {
  Machine, Rejected, allSlots, assignModel, assignedTo, assignmentsUnreadable, canAssignModel, decodeState, enabled, initial, installed, machine, modelOf, withInstall,
  type ActiveStatus, type Event, type InstallPhase, type LocalModels, type ModelSlot,
} from "../gen/localInference__models.effect.vibe"
import { localEmbeddingModel, localTextModel } from "../gen/localInference__textAndEmbeddings.effect.vibe"
import { curatedModels, isCatalogId, modelNamed, type Catalog, type CatalogId, type CatalogModel, type PublishedFile } from "./catalog.vibe"
import { sha256 } from "./digest.ts"
import { InferenceEngine, type InstalledModel } from "./engine.vibe"
import { AssignmentRecord, BundleManifest, InstalledRecord } from "./records.schema.vibe"

export { Rejected }

export const slotNames = {
  TextSmallSlot: "TEXT_SMALL",
  TextLargeSlot: "TEXT_LARGE",
  EmbeddingSlot: "TEXT_EMBEDDING",
  SpeechSlot: "TEXT_TO_SPEECH",
  TranscriptionSlot: "TRANSCRIPTION",
} as const satisfies Record<ModelSlot, string>

export type SlotName = typeof slotNames[ModelSlot]

export function slotNamed(name: string): ModelSlot | undefined {
  return allSlots.find((slot) => slotNames[slot] === name)
}

export error DownloadFailed { model: string; reason: string }

export error AssignmentsUnreadable { path: string }

interface InstalledFile {
  readonly path: string
  readonly sha256: string
  readonly bytes: number
}

const installNames = { NotInstalled: "absent", Downloading: "downloading", Installed: "installed", Unreadable: "unreadable" } as const satisfies Record<InstallPhase, string>
const statusNames = { ActiveIdle: "idle", ActiveLoading: "loading", ActiveReady: "ready", ActiveFailed: "failed" } as const satisfies Record<ActiveStatus, string>

export interface ModelView {
  readonly name: string
  readonly role: "chat" | "embedding"
  readonly install: typeof installNames[InstallPhase]
  readonly evalsPassed: boolean
  readonly active: boolean
  readonly slots: readonly SlotName[]
}

export interface ModelsView {
  readonly models: readonly ModelView[]
  readonly active: { readonly model: string | null; readonly status: typeof statusNames[ActiveStatus]; readonly servesText: boolean }
  readonly assignmentsReadable: boolean
  readonly unreadable: string | null
}

export interface LocalModelsApi {
  readonly catalog: Catalog
  readonly changes: Stream.Stream<LocalModels>
  state(): LocalModels!!
  view(): ModelsView!!
  download(id: CatalogId): void!Rejected
  cancelDownload(id: CatalogId): void!Rejected
  assign(slot: ModelSlot, id: CatalogId | undefined): void!Rejected
  activate(id: CatalogId): void!Rejected
  deactivate(): void!Rejected
  uninstall(id: CatalogId): void!Rejected
  repairAssignments(): void!(Rejected | AssignmentsUnreadable)
  embeddingModel(): (InstalledModel | undefined)!!
  textModel(): (InstalledModel | undefined)!!
  close(): void!!
}

const decodeInstalled = Schema.decodeUnknownOption(Schema.fromJsonString(InstalledRecord))
const decodeAssignments = Schema.decodeUnknownOption(Schema.fromJsonString(AssignmentRecord))
const decodeManifest = Schema.decodeUnknownEffect(Schema.fromJsonString(BundleManifest))

type Recorded = AssignmentRecord["assignments"]

type Read<A> = { readonly kind: "read"; readonly value: A } | { readonly kind: "absent" } | { readonly kind: "unreadable"; readonly code: string }

function unreadableCode(failure: PlatformError.PlatformError): string | undefined {
  const reason = failure.reason
  if (reason._tag === "NotFound") return undefined
  const cause: unknown = reason.cause
  return typeof cause === "object" && cause !== null && "code" in cause && typeof cause.code === "string" ? cause.code : reason._tag
}

effect function read<A>(work: A!PlatformError.PlatformError) {
  return (map(work, (value): Read<A> => ({ kind: "read", value })) catch (failure: PlatformError.PlatformError): Read<A> => {
    const code = unreadableCode(failure)
    return code === undefined ? { kind: "absent" } : { kind: "unreadable", code }
  })
}

function withRecorded(state: LocalModels, recorded: Recorded, catalog: Catalog): LocalModels {
  return allSlots.reduce((current, slot) => {
    const name = recorded[slotNames[slot]]
    const model = name === undefined ? undefined : modelNamed(name, catalog)
    return model !== undefined && canAssignModel(current, slot, model.id) ? assignModel(current, slot, model.id) : current
  }, state)
}

function recordOf(state: LocalModels, catalog: Catalog): Recorded {
  return Object.fromEntries(allSlots.flatMap((slot) => {
    const id = assignedTo(state, slot)
    return isCatalogId(id) ? [[slotNames[slot], catalog[id].name]] : []
  }))
}

effect function machineOf(start: LocalModels) {
  provide machine(start) {
    return try Machine
  }
}

const failed = (model: CatalogModel, reason: string) => new DownloadFailed({ model: model.name, reason })

effect function presence(fs: FileSystem.FileSystem, path: Path.Path, directory: string, list: readonly InstalledFile[]) {
  for (const file of list) {
    const info = try read(fs.stat(path.join(directory, file.path)))
    if (info.kind !== "read") return info
    if (Number(info.value.size) !== file.bytes) return { kind: "absent" } satisfies Read<never>
  }
  return { kind: "read", value: list } satisfies Read<readonly InstalledFile[]>
}

effect function digestOf(fs: FileSystem.FileSystem, file: string) {
  const digest = sha256()
  try Stream.runForEach(fs.stream(file), (chunk) => sync(() => digest.update(chunk)))
  return digest.hex()
}

effect function stagedFile(fs: FileSystem.FileSystem, target: string) {
  const info = try read(fs.stat(target))
  if (info.kind !== "read") return info
  const digest = try read(digestOf(fs, target))
  if (digest.kind !== "read") return digest
  return { kind: "read", value: { sha256: digest.value, bytes: Number(info.value.size) } } satisfies Read<{ sha256: string; bytes: number }>
}

effect function writeAtomically(fs: FileSystem.FileSystem, file: string, value: object) {
  const temporary = `${file}.tmp`
  try fs.writeFileString(temporary, JSON.stringify(value, null, 2) + "\n")
  try fs.rename(temporary, file)
}

effect function fetchPlan(http: HttpClient.HttpClient, model: CatalogModel) {
  const source = model.source
  if (source.kind === "pinned") return { files: source.files, evalsPassed: true }
  const response = (http.execute(HttpClientRequest.get(source.manifestUrl)) catch effect () => { throw failed(model, "the manifest is unreachable") })
  if (response.status !== 200) throw failed(model, `the manifest answered ${response.status}`)
  const text = (response.text catch effect () => { throw failed(model, "the manifest did not arrive whole") })
  const manifest = (decodeManifest(text) catch effect () => { throw failed(model, "the manifest is malformed") })
  const digests = new Map<string, string>()
  for (const entry of Object.values(manifest.files).flat()) {
    const seen = digests.get(entry.path)
    if (seen !== undefined && seen !== entry.sha256) throw failed(model, `the manifest gives ${entry.path} two digests`)
    digests.set(entry.path, entry.sha256)
  }
  const published: PublishedFile[] = [...digests].map(([file, digest]) => ({ path: file, sha256: digest, url: `${source.fileBase}/${file}` }))
  return { files: published, evalsPassed: manifest.evals.textEval.passed }
}

effect function fetchFile(stores: { readonly fs: FileSystem.FileSystem; readonly path: Path.Path; readonly http: HttpClient.HttpClient }, model: CatalogModel, file: PublishedFile, directory: string) {
  const { fs, path, http } = stores
  const target = path.join(directory, file.path)
  const partial = `${target}.part`
  fs.makeDirectory(path.dirname(target), { recursive: true }) catch effect () => { throw failed(model, "the model directory cannot be created") }
  const response = (http.execute(HttpClientRequest.get(file.url)) catch effect () => { throw failed(model, `${file.path} is unreachable`) })
  if (response.status !== 200) throw failed(model, `${file.path} answered ${response.status}`)
  const digest = sha256()
  let bytes = 0
  const counted = Stream.tap(response.stream, (chunk: Uint8Array) => sync(() => {
    digest.update(chunk)
    bytes += chunk.byteLength
  }))
  Stream.run(counted, fs.sink(partial)) catch effect () => { throw failed(model, `${file.path} did not arrive whole`) }
  if (digest.hex() !== file.sha256) {
    fs.remove(partial) catch () => undefined
    return undefined
  }
  fs.rename(partial, target) catch effect () => { throw failed(model, `${file.path} cannot be stored`) }
  return { path: file.path, sha256: file.sha256, bytes } satisfies InstalledFile
}

export effect function openLocalModels(stateDirectory: string, catalog: Catalog = curatedModels) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const http = try HttpClient.HttpClient
  const engine = try InferenceEngine
  const root = path.join(stateDirectory, "local-inference")
  const modelsDirectory = path.join(root, "models")
  const installedFile = path.join(root, "installed.json")
  const assignmentsFile = path.join(root, "assignments.json")
  const store = try read(fs.makeDirectory(modelsDirectory, { recursive: true }))

  const files = new Map<CatalogId, readonly InstalledFile[]>()
  const kept = new Map<CatalogId, { readonly evalsPassed: boolean; readonly files: readonly InstalledFile[] }>()
  const fibers = new Map<CatalogId, Fiber.Fiber<void, never>>()
  let loading: Fiber.Fiber<void, never> | undefined = undefined
  const lock = Semaphore.makeUnsafe(1)
  const directoryOf = (model: CatalogModel) => model.source.kind === "pinned" ? modelsDirectory : path.join(modelsDirectory, model.name)

  const readText = (file: string) => read(fs.readFileString(file))

  const installedText = store.kind === "unreadable" ? store : try readText(installedFile)
  const storeUnreadable = installedText.kind === "unreadable" ? installedText.code : undefined
  let unreadable = storeUnreadable
  const installedRecord = installedText.kind === "read" ? Option.getOrUndefined(decodeInstalled(installedText.value)) : installedText.kind === "absent" ? { version: 1 as const, models: [] } : undefined
  let start = initial
  if (storeUnreadable !== undefined) {
    for (const model of Object.values(catalog)) start = withInstall(model.id, start, "Unreadable", false)
    try logWarning("The local model store cannot be read, so every model is reported unreadable", { directory: modelsDirectory, code: storeUnreadable })
  }
  for (const entry of installedRecord?.models ?? []) {
    const found = try presence(fs, path, directoryOf(catalog[entry.id]), entry.files)
    if (found.kind === "absent") continue
    if (found.kind === "unreadable") {
      start = withInstall(entry.id, start, "Unreadable", false)
      kept.set(entry.id, { evalsPassed: entry.evalsPassed, files: entry.files })
      unreadable ??= found.code
      try logWarning("An installed model cannot be read and is reported unreadable", { model: catalog[entry.id].name, code: found.code })
      continue
    }
    start = withInstall(entry.id, start, "Installed", entry.evalsPassed)
    files.set(entry.id, entry.files)
  }
  const assignmentsText = storeUnreadable === undefined ? try readText(assignmentsFile) : installedText
  const recorded = assignmentsText.kind === "absent" ? {} : assignmentsText.kind === "read" ? Option.getOrUndefined(Option.map(decodeAssignments(assignmentsText.value), (record) => record.assignments)) : undefined
  start = installedRecord !== undefined && recorded !== undefined ? withRecorded(start, recorded, catalog) : assignmentsUnreadable(start)
  const models = try machineOf(try orDie(decodeState(start)))

  const keptSlots = (state: LocalModels): Recorded => Object.fromEntries(Object.entries(recorded ?? {}).filter(([, name]) => {
    const model = typeof name === "string" ? modelNamed(name, catalog) : undefined
    return model !== undefined && modelOf(state, model.id).install === "Unreadable"
  }))

  effect function persist() {
    const state = try models.get()
    const record = [
      ...[...files].filter(([id]) => installed(state, id)).map(([id, list]) => ({ id, evalsPassed: modelOf(state, id).evalsPassed, files: list })),
      ...[...kept].filter(([id]) => modelOf(state, id).install === "Unreadable").map(([id, entry]) => ({ id, ...entry })),
    ]
    if (storeUnreadable === undefined) try orDie(writeAtomically(fs, installedFile, { version: 1, models: record }))
    if (state.assignmentsReadable) try orDie(writeAtomically(fs, assignmentsFile, { version: 1, assignments: { ...keptSlots(state), ...recordOf(state, catalog) } }))
  }

  effect function changed(event: Event) {
    const next = try models.send(event)
    try persist()
    return next
  }

  const change = (event: Event) => lock.withPermits(1)(changed(event))

  effect function stopLoading() {
    if (loading !== undefined) try Fiber.interrupt(loading)
    loading = undefined
  }

  function installedOf(id: CatalogId): InstalledModel {
    const model = catalog[id]
    const directory = directoryOf(model)
    return { model, directory, files: (files.get(id) ?? []).map((file) => path.join(directory, file.path)) }
  }

  effect function discard(model: CatalogModel) {
    const directory = directoryOf(model)
    if (model.source.kind === "bundle") {
      fs.remove(directory, { recursive: true }) catch () => undefined
      return
    }
    for (const file of model.source.files) {
      fs.remove(path.join(directory, `${file.path}.part`)) catch () => undefined
      if (!installed(try models.get(), model.id)) (fs.remove(path.join(directory, file.path)) catch () => undefined)
    }
  }

  effect function fetchModel(model: CatalogModel) {
    const plan = try fetchPlan(http, model)
    const directory = directoryOf(model)
    const fetched: InstalledFile[] = []
    for (const file of plan.files) {
      const got = try fetchFile({ fs, path, http }, model, file, directory)
      if (got === undefined) {
        try change({ type: "finishDownload", modelId: model.id, digestMatches: false, evalsPassed: false })
        try discard(model)
        return
      }
      fetched.push(got)
    }
    files.set(model.id, fetched)
    try change({ type: "finishDownload", modelId: model.id, digestMatches: true, evalsPassed: plan.evalsPassed })
  }

  effect function settleAbandoned(model: CatalogModel) {
    if (modelOf(try models.get(), model.id).install === "Downloading") {
      change({ type: "cancelDownload", modelId: model.id }) catch () => undefined
    }
    if (!installed(try models.get(), model.id)) files.delete(model.id)
    try discard(model)
  }

  effect function adoptStaged(model: CatalogModel) {
    if (model.source.kind !== "pinned" || modelOf(try models.get(), model.id).install !== "NotInstalled") return
    const directory = directoryOf(model)
    const verified: InstalledFile[] = []
    for (const file of model.source.files) {
      const staged = try stagedFile(fs, path.join(directory, file.path))
      if (staged.kind === "absent") return
      if (staged.kind === "unreadable") {
        unreadable ??= staged.code
        try logWarning("A staged model file cannot be read and is reported unreadable", { model: model.name, file: file.path, code: staged.code })
        try change({ type: "modelUnreadable", modelId: model.id })
        return
      }
      if (staged.value.sha256 !== file.sha256) {
        try logWarning("A staged model does not match its published digest and stays absent", { model: model.name, file: file.path })
        return
      }
      verified.push({ path: file.path, sha256: file.sha256, bytes: staged.value.bytes })
    }
    files.set(model.id, verified)
    try change({ type: "startDownload", modelId: model.id })
    try change({ type: "finishDownload", modelId: model.id, digestMatches: true, evalsPassed: true })
  }

  for (const model of Object.values(catalog)) (adoptStaged(model) catch () => undefined)
  const opened = try models.get()
  const embedder = Object.values(catalog).find((model) => model.embedding !== undefined && installed(opened, model.id))
  if (embedder !== undefined && assignedTo(opened, "EmbeddingSlot") === "" && canAssignModel(opened, "EmbeddingSlot", embedder.id)) {
    change({ type: "assignModel", slot: "EmbeddingSlot", modelId: embedder.id }) catch () => undefined
  }

  return {
    catalog,
    changes: models.changes,
    state: () => models.get(),
    effect view() {
      const state = try models.get()
      const active = isCatalogId(state.active) ? catalog[state.active].name : null
      return {
        models: Object.values(catalog).map((model): ModelView => {
          const entry = modelOf(state, model.id)
          return {
            name: model.name,
            role: model.role === "ChatRole" ? "chat" : "embedding",
            install: installNames[entry.install],
            evalsPassed: entry.evalsPassed,
            active: state.active === model.id,
            slots: allSlots.filter((slot) => assignedTo(state, slot) === model.id).map((slot) => slotNames[slot]),
          }
        }),
        active: { model: active, status: statusNames[state.activeStatus], servesText: localTextModel(state.active, state.activeStatus) !== "" },
        assignmentsReadable: state.assignmentsReadable,
        unreadable: unreadable ?? null,
      } satisfies ModelsView
    },
    effect download(id) {
      try change({ type: "startDownload", modelId: id })
      const model = catalog[id]
      const work = onExit(fetchModel(model), effect (exit) => {
        fibers.delete(id)
        if (Exit.isFailure(exit)) {
          try logWarning("A model download stopped before it was installed", { model: model.name, cause: String(Cause.squash(exit.cause)) })
          try settleAbandoned(model)
        }
      })
      const fiber = fork.detached Effect.ignore(work)
      fibers.set(id, fiber)
    },
    effect cancelDownload(id) {
      const fiber = fibers.get(id)
      if (fiber === undefined) {
        try change({ type: "cancelDownload", modelId: id })
        return
      }
      try Fiber.interrupt(fiber)
    },
    effect assign(slot, id) {
      try change(id === undefined ? { type: "clearAssignment", slot } : { type: "assignModel", slot, modelId: id })
    },
    activate: (id) => lock.withPermits(1)(effect {
      uninterruptible {
        try changed({ type: "activateModel", modelId: id })
        const load = onExit(engine.load(installedOf(id)), effect (exit) => {
          if (Exit.hasInterrupts(exit)) return
          models.send({ type: "finishLoading", loaded: Exit.isSuccess(exit) }) catch effect () => { try engine.unload() }
        })
        loading = fork.detached Effect.interruptible(Effect.ignore(load))
      }
    }),
    deactivate: () => lock.withPermits(1)(effect {
      try stopLoading()
      try changed({ type: "deactivateModel" })
      try engine.unload()
    }),
    uninstall: (id) => lock.withPermits(1)(effect {
      const before = try models.get()
      const event: Event = { type: "uninstallModel", modelId: id }
      if (!enabled(before, event)) throw new Rejected({ event, state: before })
      if (before.active === id) {
        try stopLoading()
        try engine.unload()
      }
      try changed(event)
      const directory = directoryOf(catalog[id])
      for (const file of files.get(id) ?? []) (fs.remove(path.join(directory, file.path)) catch () => undefined)
      files.delete(id)
      if (catalog[id].source.kind === "bundle") (fs.remove(directory, { recursive: true }) catch () => undefined)
    }),
    repairAssignments: () => lock.withPermits(1)(effect {
      const text = try readText(assignmentsFile)
      const repaired = text.kind === "absent" ? {} : text.kind === "read" ? Option.getOrUndefined(Option.map(decodeAssignments(text.value), (record) => record.assignments)) : undefined
      if (repaired === undefined) throw new AssignmentsUnreadable({ path: assignmentsFile })
      let state = try models.send({ type: "assignmentsRepaired" })
      for (const slot of allSlots) {
        const name = repaired[slotNames[slot]]
        const model = name === undefined ? undefined : modelNamed(name, catalog)
        if (model !== undefined && canAssignModel(state, slot, model.id)) state = try models.send({ type: "assignModel", slot, modelId: model.id })
      }
      try persist()
    }),
    effect embeddingModel() {
      const state = try models.get()
      const assigned = assignedTo(state, "EmbeddingSlot")
      const id = localEmbeddingModel(assigned, installed(state, assigned))
      return isCatalogId(id) ? installedOf(id) : undefined
    },
    effect textModel() {
      const state = try models.get()
      const id = localTextModel(state.active, state.activeStatus)
      return isCatalogId(id) ? installedOf(id) : undefined
    },
    effect close() {
      try stopLoading()
      for (const fiber of [...fibers.values()]) try Fiber.interrupt(fiber)
    },
  } satisfies LocalModelsApi
}
