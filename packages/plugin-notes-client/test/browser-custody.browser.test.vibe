// spec/notes/audioCustody.md, "Story: Keep a stopped recording until it is claimed for its note"; spec/notes/audioCustody.md, "A stopped recording is claimed once and committed only to its canonical note"; spec/notes/audioCustody.md, "A browser recording answers only to the connection that recorded it"
import { describe, expect, it } from "@effect/vitest"
import { NotesAudioRefused, createNotesAudioStore } from "../src/browser-audio.vibe"
import { RecordingJournalRefused, createBrowserRecordingJournal } from "../src/browser-recording-journal.vibe"

module browser {
  /** @throws {never} */
  export const unique = (): string => crypto.randomUUID()
  /** @throws {never} */
  export const fragment = (units: number[]): Blob => new Blob([Uint8Array.from(units)], { type: "audio/webm" })
  /** @throws {never} */
  export function seedInstalledAudio(database: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const opened = indexedDB.open(database, 1)
      opened.onupgradeneeded = () => opened.result.createObjectStore("audio", { keyPath: "audioId" })
      opened.onerror = () => reject(opened.error)
      opened.onsuccess = () => {
        const tx = opened.result.transaction("audio", "readwrite")
        tx.oncomplete = () => { opened.result.close(); resolve() }
        tx.onabort = () => { opened.result.close(); reject(tx.error) }
        tx.objectStore("audio").add({ audioId: "earlier-capture", noteId: "earlier-note", durationMs: 1400,
          bytes: Uint8Array.from([7, 9, 11]).buffer, mimeType: "audio/webm", transcript: "", createdAt: 1 })
      }
    })
  }
  /** @throws {never} */
  export async function bytes(clip: Blob): Promise<number[]> {
    return Array.from(new Uint8Array(await clip.arrayBuffer()))
  }
}
import { bytes, fragment, seedInstalledAudio, unique } from browser

describe("Browser Notes custody", () => {
  it("Recovers durable parts and gives their exact note the same bytes once", async () => {
    const owner = "a".repeat(64)
    const former = "b".repeat(64)
    const id = unique()
    const capture = "capture-" + id
    const audio = { databaseName: "audio-" + id }
    const writer = createBrowserRecordingJournal(capture)
    await writer.start({ ownerDigest: owner, recordingId: id, folderId: "f-interview", startedAt: 1, mimeType: "audio/webm" })
    await writer.append(id, owner, 0, 1200, fragment([4, 8]))
    const renewed = createBrowserRecordingJournal(capture)
    expect(await renewed.latest(former)).toBeUndefined()
    await expect(renewed.append(id, former, 1, 2400, fragment([6]))).rejects.toEqual(new RecordingJournalRefused({ reason: "anotherConnection" }))
    await expect(renewed.append(id, owner, 0, 2400, fragment([6]))).rejects.toEqual(new RecordingJournalRefused({ reason: "historyChanged" }))
    await expect(renewed.clip(id, former)).rejects.toEqual(new RecordingJournalRefused({ reason: "anotherConnection" }))
    const clip = await renewed.clip(id, owner)
    await seedInstalledAudio(audio.databaseName)
    const store = createNotesAudioStore(audio)
    const earlier = await store.audioRecord("earlier-capture", former)
    expect({ note: earlier.noteId, duration: earlier.durationMs, data: await bytes(earlier.blob) })
      .toEqual({ note: "earlier-note", duration: 1400, data: [7, 9, 11] })
    await store.retainPendingAudio(id, { ownerDigest: owner, folderId: "f-interview" }, clip, "A short recording")
    const recovered = createNotesAudioStore(audio)
    expect(await recovered.pendingAudio(former)).toEqual([])
    expect((await recovered.pendingAudio(owner)).map((row) => [row.audioId, row.durationMs, row.recordingSave?.folderId]))
      .toEqual([[id, 1200, "f-interview"]])
    await expect(recovered.claimPendingAudio(id, former)).rejects.toEqual(new NotesAudioRefused({ reason: "anotherConnection" }))
    await expect(recovered.discardPendingAudio(id, former)).rejects.toEqual(new NotesAudioRefused({ reason: "anotherConnection" }))
    await expect(recovered.commitPendingAudio(id, owner, "note-1", "")).rejects.toEqual(new NotesAudioRefused({ reason: "notClaimed" }))
    expect(await recovered.claimPendingAudio(id, owner)).toBe(true)
    expect(await recovered.claimPendingAudio(id, owner)).toBe(false)
    expect((await recovered.pendingAudio(owner)).map((row) => row.recordingSave?.phase)).toEqual(["claimed"])
    await expect(recovered.commitPendingAudio(id, former, "note-1", "")).rejects.toEqual(new NotesAudioRefused({ reason: "anotherConnection" }))
    await expect(recovered.discardPendingAudio(id, owner)).rejects.toEqual(new NotesAudioRefused({ reason: "claimed" }))
    const receipt = await recovered.commitPendingAudio(id, owner, "note-1", "A short recording")
    expect(await recovered.commitPendingAudio(id, owner, "note-1", "A rewritten recording")).toEqual(receipt)
    await expect(recovered.commitPendingAudio(id, owner, "note-2", "")).rejects.toEqual(new NotesAudioRefused({ reason: "anotherNote" }))
    await expect(recovered.commitPendingAudio(id, former, "note-1", "")).rejects.toEqual(new NotesAudioRefused({ reason: "anotherConnection" }))
    await expect(recovered.discardPendingAudio(id, owner)).rejects.toEqual(new NotesAudioRefused({ reason: "claimed" }))
    await expect(recovered.audioRecord(id, former)).rejects.toEqual(new NotesAudioRefused({ reason: "anotherConnection" }))
    await expect(createNotesAudioStore(audio).audioRecord(id, former)).rejects.toEqual(new NotesAudioRefused({ reason: "anotherConnection" }))
    await renewed.discard(id, owner)
    const saved = await recovered.audioRecord(id, owner)
    expect({ parts: await renewed.latest(owner), pending: await recovered.pendingAudio(owner), note: saved.noteId,
      transcript: saved.transcript, audio: await bytes(saved.blob) })
      .toEqual({ parts: undefined, pending: [], note: "note-1", transcript: "A short recording", audio: [4, 8] })
  })

  it("Permanently erases only the exact owner's committed recording and keeps a byte-free receipt", async () => {
    const owner = "a".repeat(64)
    const foreign = "b".repeat(64)
    const audioId = unique()
    const options = { databaseName: "purge-" + audioId }
    const store = createNotesAudioStore(options)
    await store.retainPendingAudio(audioId, { ownerDigest: owner, folderId: null },
      { blob: fragment([1, 2, 3]), durationMs: 1000 }, "private transcript")
    await store.claimPendingAudio(audioId, owner)
    await store.commitPendingAudio(audioId, owner, "saved-note", "private transcript")
    const erase = { audioId, connection: owner, noteId: "saved-note", operationId: unique(), deletedAt: 10 }
    await expect(store.purgeCommittedAudio({ ...erase, connection: foreign })).rejects.toMatchObject({ reason: "anotherConnection" })
    await expect(store.purgeCommittedAudio({ ...erase, noteId: "different-note" })).rejects.toMatchObject({ reason: "anotherNote" })
    expect(await bytes((await store.audioRecord(audioId, owner)).blob)).toEqual([1, 2, 3])
    await store.purgeCommittedAudio(erase)
    const reopened = createNotesAudioStore(options)
    await expect(reopened.audioRecord(audioId, owner)).rejects.toMatchObject({ reason: "unavailable" })
    await expect(reopened.purgeCommittedAudio(erase)).resolves.toBeUndefined()
    await expect(reopened.purgeCommittedAudio({ ...erase, operationId: unique() })).rejects.toMatchObject({ reason: "unavailable" })
    await expect(reopened.retainPendingAudio(audioId, { ownerDigest: owner, folderId: null },
      { blob: fragment([1, 2, 3]), durationMs: 1000 }, "")).rejects.toMatchObject({ reason: "binding" })
  })
})
