// spec/notes/client.md, "Browser recordings can only be recovered or bound by their recording owner"
module browser {
  import { Schema } from "effect"

  const Metadata = Schema.Struct({
    ownerDigest: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/)),
    recordingId: Schema.NonEmptyString,
    folderId: Schema.NullOr(Schema.String.check(Schema.isPattern(/^f-[A-Za-z0-9_-]{1,64}$/))),
    startedAt: Schema.Int,
    durationMs: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
    count: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)),
    mimeType: Schema.String,
  })
  const Part = Schema.Struct({ recordingId: Schema.NonEmptyString, index: Schema.Int, blob: Schema.instanceOf(Blob) })
  export type BrowserRecording = typeof Metadata.Type
  type Start = Omit<BrowserRecording, "durationMs" | "count">

  /** Append browser media chunks and their exact elapsed time in the same transaction. */
  export function createBrowserRecordingJournal(databaseName: string) {
    let opening: Promise<IDBDatabase> | undefined

    function database(): Promise<IDBDatabase> {
      return opening ??= new Promise((resolve, reject) => {
        const request = indexedDB.open(databaseName, 1)
        request.onupgradeneeded = () => {
          const recording = request.result.createObjectStore("recording", { keyPath: "recordingId" })
          recording.createIndex("ownerDigest", "ownerDigest")
          request.result.createObjectStore("part", { keyPath: ["recordingId", "index"] })
        }
        request.onsuccess = () => {
          const result = request.result
          result.onversionchange = () => { result.close(); opening = undefined }
          resolve(result)
        }
        request.onerror = () => { opening = undefined; reject(request.error) }
      })
    }

    async function transaction<T>(tables: string[], mode: IDBTransactionMode,
      work: (transaction: IDBTransaction, complete: (value: T) => void, fail: (cause: unknown) => void) => void): Promise<T> {
      const connection = await database()
      return new Promise((resolve, reject) => {
        const active = connection.transaction(tables, mode)
        let result: { readonly value: T } | undefined
        let problem: unknown
        active.oncomplete = () => {
          if (result === undefined) reject(Error("Recording journal did not settle"))
          else resolve(result.value)
        }
        active.onabort = () => reject(problem ?? active.error ?? Error("Recording journal was interrupted"))
        const fail = (cause: unknown) => { problem = cause; active.abort() }
        try { work(active, (value) => { result = { value } }, fail) } catch (cause) { fail(cause) }
      })
    }

    function read<T>(request: IDBRequest, found: (raw: unknown) => T, done: (value: T) => void, fail: (cause: unknown) => void) {
      request.onsuccess = () => {
        try { done(found(request.result)) } catch (cause) { fail(cause) }
      }
    }

    function exact(raw: unknown, ownerDigest: string): BrowserRecording {
      const row = Schema.decodeUnknownSync(Metadata)(raw)
      if (row.ownerDigest !== ownerDigest) throw Error("Recording owner changed")
      return row
    }

    function idRange(id: string) {
      return IDBKeyRange.bound([id, 0], [id, Number.MAX_SAFE_INTEGER])
    }

    return {
      start(input: Start): Promise<BrowserRecording> {
        const row = Schema.decodeUnknownSync(Metadata)({ ...input, count: 0, durationMs: 0 })
        return transaction(["recording"], "readwrite", (tx, done) => {
          tx.objectStore("recording").add(row)
          done(row)
        })
      },
      async append(recordingId: string, ownerDigest: string, index: number, durationMs: number, blob: Blob): Promise<BrowserRecording> {
        return transaction(["recording", "part"], "readwrite", (tx, done, fail) => {
          const rows = tx.objectStore("recording")
          read(rows.get(recordingId), (raw) => exact(raw, ownerDigest), (row) => {
            if (index !== row.count || blob.size < 1 || !Number.isSafeInteger(durationMs) || durationMs < row.durationMs)
              throw Error("Recording history changed")
            const next = { ...row, count: row.count + 1, durationMs }
            tx.objectStore("part").add({ recordingId, index, blob })
            rows.put(next)
            done(next)
          }, fail)
        })
      },
      find(recordingId: string, ownerDigest: string): Promise<BrowserRecording | undefined> {
        return transaction(["recording"], "readonly", (tx, done, fail) => {
          read(tx.objectStore("recording").get(recordingId), (raw) => raw === undefined ? undefined : exact(raw, ownerDigest), done, fail)
        })
      },
      latest(ownerDigest: string): Promise<BrowserRecording | undefined> {
        return transaction(["recording"], "readonly", (tx, done, fail) => {
          read(tx.objectStore("recording").index("ownerDigest").getAll(IDBKeyRange.only(ownerDigest)), (raw) =>
            Schema.decodeUnknownSync(Schema.Array(Metadata))(raw)
              .filter((row) => row.count > 0 && row.durationMs > 0)
              .sort((first, next) => next.startedAt - first.startedAt || first.recordingId.localeCompare(next.recordingId))[0], done, fail)
        })
      },
      clip(recordingId: string, ownerDigest: string): Promise<{ readonly blob: Blob; readonly durationMs: number }> {
        return transaction(["recording", "part"], "readonly", (tx, done, fail) => {
          read(tx.objectStore("recording").get(recordingId), (raw) => exact(raw, ownerDigest), (row) => {
            read(tx.objectStore("part").getAll(idRange(recordingId)), (raw) => {
              const parts = Schema.decodeUnknownSync(Schema.Array(Part))(raw)
              if (row.count < 1 || row.durationMs < 1 || parts.length !== row.count || parts.some((part, index) => part.recordingId !== recordingId || part.index !== index))
                throw Error("Recording is incomplete")
              return { blob: new Blob(parts.map((part) => part.blob), { type: row.mimeType }), durationMs: row.durationMs }
            }, done, fail)
          }, fail)
        })
      },
      discard(recordingId: string, ownerDigest: string): Promise<void> {
        return transaction(["recording", "part"], "readwrite", (tx, done, fail) => {
          const rows = tx.objectStore("recording")
          read(rows.get(recordingId), (raw) => raw === undefined ? undefined : exact(raw, ownerDigest), (row) => {
            if (row !== undefined) {
              tx.objectStore("part").delete(idRange(recordingId))
              rows.delete(recordingId)
            }
            done(undefined)
          }, fail)
        })
      },
    }
  }
}
import { createBrowserRecordingJournal, type BrowserRecording } from browser
export { createBrowserRecordingJournal, type BrowserRecording }
