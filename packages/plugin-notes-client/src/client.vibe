// spec/notes/client.md, "A save owns the captured draft and adopts only the server's exact target"; spec/notes/client.md, "Late reads and old owner snapshots cannot replace the current collection"; spec/notes/trash.md, "A recording's cleanup is acknowledged only with the device's proof that the audio is gone"
import { sameJson } from "./json-equality.vibe"
import { NoteRow, Revision, TrashRow } from "./records.schema.vibe"
import type { NoteJson, NotesSnapshot, NotesTrashErase, NotesTrashRecordingCleanup, StickyNote } from "./types.vibe"

module browser {
  /** @throws {never} */
  export async function sha256(text: string): Promise<string> {
    const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text))
    return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("")
  }
}
import { sha256 } from browser
import { encode, run } from "./json.vibe"

export error NotesClientRefused { message: string }

export interface NotesTransport {
  fetch<T = unknown>(
    path: string,
    init: { method: "GET" | "POST"; headers: Record<string, string>; body?: string; signal?: AbortSignal },
    options?: { skipResume?: boolean },
  ): Promise<T>
}

export interface NotesInteractResult {
  success: true
  text: string
  state: NotesSnapshot
  note?: StickyNote
  data?: { note: StickyNote }
  target?: { id: string; revision: number }
}

export const NOTES_CAPABILITY_IDS: ReadonlySet<string> = new Set(["get-notes-trash", "restore-note", "get-notes", "get-note", "create-note", "update-note", "delete-note", "clear-notes"])

const mutations: ReadonlySet<string> = new Set(["create-note", "update-note", "delete-note", "restore-note"])

const Snapshot = Schema.Struct({
  notes: Schema.Array(NoteRow), revision: Revision, trash: Schema.optionalKey(Schema.Array(TrashRow)),
  deleteAtRevision: Schema.optionalKey(Schema.Literal(true)),
})
  .check(Schema.makeFilter((state) => {
    const ids = [...state.notes.map((note) => note.id), ...(state.trash ?? []).map((entry) => entry.note.id)]
    return new Set(ids).size === ids.length
  }))
const Cleanup = Schema.Struct({ operationId: Schema.String, noteId: Schema.String, audioId: Schema.String, deletedAt: Schema.String })
const Envelope = Schema.Struct({ success: Schema.Literal(true), data: Schema.Unknown })
const Broker = Schema.Struct({ requestId: Schema.NonEmptyString, success: Schema.Boolean, error: Schema.optionalKey(Schema.Unknown), result: Schema.optionalKey(Schema.Unknown) })
const BrokerResult = Schema.Struct({ success: Schema.Literal(true), text: Schema.String, state: Schema.Unknown, data: Schema.optionalKey(Schema.Unknown) })
const Erased = Schema.Struct({ erased: Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)), recordingCleanup: Schema.Array(Cleanup), state: Schema.Unknown })
const Acknowledged = Schema.Struct({ acknowledged: Schema.Boolean })

const refusal = (message: string) => () => new NotesClientRefused({ message })
const decodeSnapshot = Schema.decodeUnknownEffect(Snapshot)
const decodeEnvelope = Schema.decodeUnknownEffect(Envelope)
const decodeBroker = Schema.decodeUnknownEffect(Broker)
const decodeResult = Schema.decodeUnknownEffect(BrokerResult)
const decodeNote = Schema.decodeUnknownEffect(NoteRow)
const decodeErased = Schema.decodeUnknownEffect(Erased)
const decodeCleanups = Schema.decodeUnknownEffect(Schema.Array(Cleanup))
const decodeAcknowledged = Schema.decodeUnknownEffect(Acknowledged)

const snapshotOf = (value: unknown) => mapError(decodeSnapshot(value), refusal("Notes returned an invalid state snapshot."))
const envelopeOf = (value: unknown) => mapError(decodeEnvelope(value), refusal("Notes returned an invalid success envelope."))
const brokerOf = (value: unknown) => mapError(decodeBroker(value), refusal("Notes returned an invalid broker envelope."))
const resultOf = (value: unknown) => mapError(decodeResult(value), refusal("Notes returned an invalid broker result."))
const noteOf = (value: unknown) => mapError(decodeNote(value), refusal("Notes returned an invalid note."))
const erasedOf = (value: unknown) => mapError(decodeErased(value), refusal("Notes returned an invalid Trash erase result."))
const cleanupsOf = (value: unknown) => mapError(decodeCleanups(value), refusal("Notes returned an invalid recording cleanup list."))
const acknowledgedOf = (value: unknown) => mapError(decodeAcknowledged(value), refusal("Notes returned an invalid recording cleanup result."))

function snapshot(state: typeof Snapshot.Type): NotesSnapshot {
  return {
    notes: state.notes.map((note) => ({ ...note })),
    revision: state.revision,
    ...(state.deleteAtRevision === true ? { deleteAtRevision: true as const } : {}),
    ...(state.trash === undefined ? {} : { trash: state.trash.map((entry) => ({ note: { ...entry.note }, deletedAt: entry.deletedAt })) }),
  }
}

function failureText(value: { readonly error?: unknown; readonly result?: unknown }): string {
  if (typeof value.error === "string" && value.error.trim() !== "") return value.error
  const result = value.result
  if (typeof result === "object" && result !== null && "text" in result && typeof result.text === "string" && result.text.trim() !== "") return result.text
  return "Notes returned an invalid broker failure result."
}

effect function brokerResult(value: unknown, capability: string, params?: Record<string, unknown>): NotesInteractResult!NotesClientRefused {
  const envelope = try brokerOf(value)
  if (!envelope.success) throw new NotesClientRefused({ message: failureText(envelope) })
  const result = try resultOf(envelope.result)
  const state = snapshot(try snapshotOf(result.state))
  const data = result.data
  const note = typeof data === "object" && data !== null && "note" in data ? { ...(try noteOf(data.note)) } : undefined
  if (mutations.has(capability) && note === undefined) throw new NotesClientRefused({ message: "Notes mutation returned no canonical note identity." })
  if (note !== undefined) {
    const committed = [...state.notes, ...(state.trash ?? []).map((entry) => entry.note)].find((item) => item.id === note.id)
    if (committed === undefined || !sameJson(committed, note)) throw new NotesClientRefused({ message: "Notes mutation identity does not match its committed snapshot." })
    if (mutations.has(capability) && typeof params?.id === "string" && note.id !== params.id) throw new NotesClientRefused({ message: "Notes mutation returned a different target." })
  }
  return {
    success: true,
    text: result.text,
    state,
    ...(note === undefined ? {} : { note, data: { note }, target: { id: note.id, revision: state.revision } }),
  }
}

export function createNotesClient(api: NotesTransport) {
  async function request(path: string, body: unknown, signal?: AbortSignal, options?: { skipResume?: boolean }): Promise<unknown> {
    signal?.throwIfAborted()
    const value = await api.fetch<unknown>(path, {
      method: body === undefined ? "GET" : "POST",
      headers: body === undefined ? { Accept: "application/json" } : { Accept: "application/json", "Content-Type": "application/json" },
      ...(body === undefined ? {} : { body: encode(body) }),
      ...(signal === undefined ? {} : { signal }),
    }, options)
    signal?.throwIfAborted()
    return value
  }
  async function data(path: string, body: unknown, signal?: AbortSignal): Promise<unknown> {
    return (await run(envelopeOf(await request(path, body, signal)))).data
  }
  return {
    async readState(signal?: AbortSignal): Promise<NotesSnapshot> {
      return snapshot(await run(snapshotOf(await data("/api/notes/state", undefined, signal))))
    },
    async interact(capability: string, params?: Record<string, unknown>, signal?: AbortSignal): Promise<NotesInteractResult> {
      signal?.throwIfAborted()
      if (!NOTES_CAPABILITY_IDS.has(capability)) throw new NotesClientRefused({ message: `Notes does not support capability "${capability}".` })
      const value = await request("/api/notes/interact", { capability, ...(params === undefined ? {} : { params }) }, signal, { skipResume: true })
      return run(brokerResult(value, capability, params))
    },
    async eraseTrash(review: NotesTrashErase, signal?: AbortSignal): Promise<{ erased: number; recordingCleanup: NotesTrashRecordingCleanup[]; state: NotesSnapshot }> {
      const result = await run(erasedOf(await data("/api/notes/trash/erase", review, signal)))
      return {
        erased: result.erased,
        recordingCleanup: result.recordingCleanup.map((entry) => ({ ...entry })),
        state: snapshot(await run(snapshotOf(result.state))),
      }
    },
    async readTrashRecordingCleanup(signal?: AbortSignal): Promise<NotesTrashRecordingCleanup[]> {
      return (await run(cleanupsOf(await data("/api/notes/trash/recordings", undefined, signal)))).map((entry) => ({ ...entry }))
    },
    async completeTrashRecordingCleanup(receipt: NotesTrashRecordingCleanup, signal?: AbortSignal): Promise<boolean> {
      return (await run(acknowledgedOf(await data("/api/notes/trash/recordings/complete", receipt, signal)))).acknowledged
    },
  }
}

export type NotesClient = ReturnType<typeof createNotesClient>

export interface NoteOrigin {
  version: 1
  noteId: string
  audioId: string
  revision: string
}

export interface RecordNoteOrigin {
  version: 2
  noteId: string
  revision: string
}

export type NoteLink = NoteOrigin | RecordNoteOrigin

export type NoteOriginKind = "event" | "reminder"

export type NoteLinkResolution = { status: "missing" } | { status: "found"; origin: NoteLink; note: Record<string, unknown> }

function controlFree(value: unknown, max: number): value is string {
  // eslint-disable-next-line no-control-regex -- Notes receipt identifiers exclude C0 controls and DEL.
  return typeof value === "string" && value.length > 0 && value.length <= max && !/[\u0000-\u001f\u007f]/.test(value)
}

const hexRevision = /^[a-f0-9]{64}$/

export function noteOriginOf(value: unknown): NoteOrigin | undefined {
  if (typeof value !== "object" || value === null || !("version" in value) || value.version !== 1) return undefined
  const noteId = "noteId" in value ? value.noteId : undefined
  const audioId = "audioId" in value ? value.audioId : undefined
  const revision = "revision" in value ? value.revision : undefined
  return controlFree(noteId, 128) && controlFree(audioId, 128) && typeof revision === "string" && hexRevision.test(revision)
    ? { version: 1, noteId, audioId, revision } : undefined
}

export function recordNoteOriginOf(value: unknown): RecordNoteOrigin | undefined {
  if (typeof value !== "object" || value === null || !("version" in value) || value.version !== 2) return undefined
  const noteId = "noteId" in value ? value.noteId : undefined
  const revision = "revision" in value ? value.revision : undefined
  return controlFree(noteId, 128) && typeof revision === "string" && hexRevision.test(revision) ? { version: 2, noteId, revision } : undefined
}

export function noteLinkOf(value: unknown): NoteLink | undefined {
  return noteOriginOf(value) ?? recordNoteOriginOf(value)
}

export function recordNoteRevision(note: { id: string; title?: unknown; body?: unknown; format?: unknown }): Promise<string> {
  return sha256(encode([note.id, String(note.title ?? ""), String(note.body ?? ""), note.format ?? null]))
}

export async function recordNoteOriginFor(note: { id: string; title?: unknown; body?: unknown; format?: unknown }): Promise<RecordNoteOrigin | undefined> {
  return recordNoteOriginOf({ version: 2, noteId: note.id, revision: await recordNoteRevision(note) })
}

export function noteOriginKey(kind: NoteOriginKind, id: string): string {
  return `${kind}:${kind === "event" ? id.replace(/:occ:-?\d+$/, "") : id}`
}

export function resolveNoteLink(value: unknown, notes: readonly unknown[]): NoteLinkResolution {
  const origin = noteLinkOf(value)
  if (origin === undefined) return { status: "missing" }
  const matches = notes.filter((note): note is Record<string, unknown> => typeof note === "object" && note !== null && "id" in note && note.id === origin.noteId)
  const note = matches[0]
  if (matches.length !== 1 || note === undefined) return { status: "missing" }
  if (origin.version === 1) {
    const audio = note.audio
    if (typeof audio !== "object" || audio === null || !("audioId" in audio) || audio.audioId !== origin.audioId) return { status: "missing" }
  }
  return { status: "found", origin, note }
}

export function noteOriginTitle(note: unknown, fallback = "Voice note"): string {
  const title = typeof note === "object" && note !== null && "title" in note && typeof note.title === "string" ? note.title : ""
  // eslint-disable-next-line no-control-regex -- Note list titles replace each consecutive run of C0 controls and DEL.
  return title.replace(/[\u0000-\u001f\u007f]+/g, " ").trim().slice(0, 120) || fallback
}

export type NoteScheduleKind = "event" | "reminder"

export const NOTE_SCHEDULE_TEXT_LIMIT = 4000

export interface NoteScheduleDraft {
  kind: NoteScheduleKind
  title: string
  notes: string
  origin: RecordNoteOrigin
}

export type NoteScheduleDraftResult =
  | { status: "ready"; draft: NoteScheduleDraft }
  | { status: "empty" | "too-long" | "invalid"; message: string }

function openItems(value: NoteJson | undefined): string[] {
  if (!Array.isArray(value)) return []
  return value.flatMap((item) => typeof item === "object" && item !== null && !Array.isArray(item) && item.done !== true
    && typeof item.t === "string" && item.t.trim() !== "" ? [item.t.trim()] : [])
}

export function noteScheduleText(note: StickyNote): string {
  const data = note.format?.data ?? {}
  const actions = openItems(data.actions)
  if (actions.length > 0) return actions.join("\n")
  const items = openItems(data.items)
  if (items.length > 0) return items.join("\n")
  return note.body.trim()
}

export async function noteScheduleDraft(note: StickyNote, kind: NoteScheduleKind): Promise<NoteScheduleDraftResult> {
  const notes = noteScheduleText(note)
  if (notes === "") return { status: "empty", message: "This note has no open items or text to schedule." }
  if (notes.length > NOTE_SCHEDULE_TEXT_LIMIT) {
    return {
      status: "too-long",
      message: kind === "event" ? "Shorten this note before creating an event. Nothing was added to your calendar." : "Shorten this note before creating a reminder. Nothing scheduled.",
    }
  }
  const origin = await recordNoteOriginFor(note)
  if (origin === undefined) return { status: "invalid", message: "This note cannot be linked." }
  return { status: "ready", draft: { kind, title: note.title, notes, origin } }
}
