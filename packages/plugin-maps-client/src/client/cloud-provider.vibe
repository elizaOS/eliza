// spec/maps/cloudConnection.md, "The newest qualifying coverage read can install the Cloud provider"; spec/maps/cloudConnection.md, "Maps requests and tiles retain the captured account through completion"; spec/maps/requests.md, "No request starts while a pause is in effect"; spec/maps/requests.md, "Only a refusal of the current request sets the pause"; spec/maps/attribution.md, "Moving the view or asking again hides the shown attribution"; spec/maps/attribution.md, "Only the reply to the latest request, for the current view, is shown"; spec/maps/routing.md, "An answer Maps cannot use is said in the owner's words, naming the place a start could not look up"
import { CloudError, type CloudClient, type CloudFailure } from "@elizaos/cloud"
import { cloudReadMayReturn, cloudReadMayStart, initial as neverConnected, machineOver as connectionOver, signedOut, type CloudReadKind, type CoverageReply, type MapsBinding } from "../../gen/maps__cloudConnection.effect.vibe"
import { canRequest, initial as unpaused, machineOver as requestsOver, type MapRequests } from "../../gen/maps__requests.effect.vibe"
import { initial as unattributed, machineOver as attributionOver } from "../../gen/maps__attribution.effect.vibe"
import { boundedText, coordinate, MapsFailure, place, route, type Coordinate, type MapsDiagnostics, type MapsProvider, type Place, type ProviderConfig, type Route, type TravelMode } from "./contracts.vibe"

module browser {
  /** @throws {never} */
  export function localTime(at: number): string {
    return new Date(at).toLocaleString()
  }
}
import { localTime } from browser

export type MapsCloud = Pick<CloudClient, "mapsCapabilities" | "mapsPlacesSearch" | "mapsPlaceDetails" | "mapsRoutes" | "mapsViewport" | "mapsTile">

export interface CloudMapsAccount {
  readonly session: string
  readonly credential: string
  readonly client: MapsCloud
}

type Capabilities = Awaited<ReturnType<MapsCloud["mapsCapabilities"]>>
type Offer = Extract<Capabilities, { readonly available: true }>

export type CloudMapsDisclosure = Offer["disclosure"]

export interface CloudMapsCoverage {
  readonly providerId: string
  readonly revision: string
  readonly attribution: string
  readonly regions: Offer["regions"]
  readonly sources: Offer["sources"]
  readonly disclosure: CloudMapsDisclosure
  readonly tiles?: NonNullable<Offer["tiles"]>
}

export interface MapsViewport {
  readonly zoom: number
  readonly north: number
  readonly south: number
  readonly east: number
  readonly west: number
}

export interface CloudMapsBasemap {
  readonly kind: "cloud-raster"
  readonly attribution: string
  readonly minZoom: number
  readonly maxZoom: number
  readonly tileSize: number
  tile(z: number, x: number, y: number): Uint8Array!MapsFailure
  copyright(view: MapsViewport): string!MapsFailure
}

export function retryWait(ms: number): string {
  const seconds = Math.max(1, Math.ceil(ms / 1000))
  if (seconds < 90) return `about ${seconds} second${seconds === 1 ? "" : "s"}`
  const minutes = Math.ceil(seconds / 60)
  return minutes < 90 ? `about ${minutes} minutes` : `about ${Math.ceil(minutes / 60)} hours`
}

export function describeLocationRecipients(recipients: CloudMapsDisclosure["recipients"], gatewayFallback?: string): string {
  const gateway = recipients.find((recipient) => recipient.role === "gateway")?.name ?? gatewayFallback
  const targets = [
    ...(gateway === undefined ? [] : [gateway]),
    ...recipients.filter((recipient) => recipient.role !== "gateway").map((recipient) => `${recipient.name} for ${recipient.role}, operated by ${recipient.operator}`),
  ]
  return targets.length > 0 ? `Searches, search areas and route points are sent to ${targets.join(" and ")}.` : ""
}

export function describeMapsDisclosure(disclosure: CloudMapsDisclosure | undefined): string {
  return disclosure === undefined ? "" : `${describeLocationRecipients(disclosure.recipients, "Cloud Maps")} Cloud keeps only the request type and result, not your searches or locations.`
}

export function insideCloudCoverage(coverage: Pick<CloudMapsCoverage, "regions">, point: Coordinate): boolean {
  return coverage.regions.some(({ bounds: [west, south, east, north] }) => point.longitude >= west && point.longitude <= east && point.latitude >= south && point.latitude <= north)
}

const dayMs = 86_400_000

export const unusableMapsAnswer = "Maps got an answer it couldn't use. Try again in a moment."

export function cloudMapsFailure(failure: CloudFailure, now: number): MapsFailure {
  const refused = (code: MapsFailure["code"], message: string) => new MapsFailure({ code, message })
  switch (failure.tag) {
    case "CloudCredentialInvalid": return refused("unauthorized", "Sign in to Cloud to use Maps.")
    case "CloudInsufficientCredits": return refused("unauthorized", "Add balance or choose a plan to use Maps.")
    case "CloudConsentRequired": return refused("unauthorized", "Cloud refused this Maps request.")
    case "CloudAllowanceExhausted": {
      const reset = failure.resetsAt > now && failure.resetsAt - now <= 400 * dayMs ? ` It resets ${localTime(failure.resetsAt)}.` : ""
      return refused("rate-limited", `You have used your Maps allowance for this period.${reset}`)
    }
    case "CloudRateLimited": {
      const wait = failure.retryAt > now && failure.retryAt - now <= dayMs ? `Try again in ${retryWait(failure.retryAt - now)}.` : "Try again later."
      return refused("rate-limited", `Maps request limit reached. ${wait}`)
    }
    case "CloudUnavailable": return refused("unavailable", "Cloud Maps is temporarily unavailable. Try again later.")
    case "CloudProviderIssue": return refused("invalid-response", unusableMapsAnswer)
    case "CloudNetwork": return refused("offline", "Cloud Maps is unreachable. Check the connection.")
    case "CloudRefused": switch (failure.code) {
      case "NoRoute": return refused("unsupported", "No route is available between these places.")
      case "UnsupportedMode": return refused("unsupported", "This travel mode is not available from Cloud Maps.")
      case "UnsupportedRegion": return refused("unsupported", "This location is outside Cloud Maps coverage.")
      case "CapabilityUnavailable":
      case "NotFound": return refused("unconfigured", "Cloud Maps is not available yet.")
      case "AccessDenied": return refused("unauthorized", "Maps needs an active Cloud subscription.")
      case "IdempotencyConflict":
      case "AlreadyDispatched": return refused("unavailable", "This Maps request could not be confirmed. It will not retry automatically.")
      case "BillingStateConflict": return refused("unavailable", "Your plan changed. Try the Maps request again.")
      case "ProviderInvalidResponse": return refused("invalid-response", unusableMapsAnswer)
      case "InvalidRequest": return refused("unsupported", "Cloud Maps could not use this request.")
      case "RateLimited": return refused("rate-limited", "Maps request limit reached. Try again later.")
      default: return refused("unavailable", "Cloud Maps could not complete this request.")
    }
  }
}

function pauseOf(failure: CloudFailure, now: number): number {
  switch (failure.tag) {
    case "CloudRateLimited": return failure.retryAt > now && failure.retryAt - now <= 400 * dayMs ? Math.ceil(failure.retryAt - now) : 0
    case "CloudAllowanceExhausted": return failure.resetsAt > now && failure.resetsAt - now <= 400 * dayMs ? Math.ceil(failure.resetsAt - now) : 0
    case "CloudUnavailable": return failure.retryAfter > now ? Math.ceil(failure.retryAfter - now) : 0
    default: return 0
  }
}

const changed = () => new MapsFailure({ code: "cancelled", message: "Maps connection changed." })
const placeIdPattern = /^[A-Za-z0-9][A-Za-z0-9:._-]{0,255}$/

function identities() {
  const numbers = new Map<string, number>()
  const clients = new WeakMap<object, number>()
  let nextClient = 0
  return {
    of(account: CloudMapsAccount | undefined): MapsBinding {
      if (account === undefined) return signedOut
      const number = (value: string) => {
        const known = numbers.get(value)
        if (known !== undefined) return known
        numbers.set(value, numbers.size + 1)
        return numbers.size
      }
      const client = clients.get(account.client) ?? ++nextClient
      clients.set(account.client, client)
      return { session: number(`session:${account.session}`), credential: number(`credential:${account.credential}`), client }
    },
  }
}

export effect function cloudMaps(configure: (config: ProviderConfig, provider?: MapsProvider) => void) {
  const connection = try Ref.make(neverConnected)
  const machine = try connectionOver(() => Ref.get(connection), (next) => Ref.set(connection, next))
  const paused = try Ref.make<MapRequests>(unpaused)
  const pause = try requestsOver(effect () => {
    const kept = try Ref.get(paused)
    return { ...kept, now: Math.max(kept.now, try Clock.currentTimeMillis) }
  }, (next) => Ref.set(paused, next))
  const serialize = (try Semaphore.make(1)).withPermits(1)
  const ids = identities()
  let account: CloudMapsAccount | undefined
  let coverage: CloudMapsCoverage | undefined
  let installed = false
  let pauseFailure: MapsFailure | undefined
  let diagnostics: MapsDiagnostics = { configured: false, error: "", message: "" }

  function uninstall(): void {
    coverage = undefined
    if (installed) {
      installed = false
      configure({ status: "unconfigured" })
    }
  }

  effect function cloudCall<A>(call: (client: MapsCloud, signal: AbortSignal) => Promise<A>, client: MapsCloud, token: number): A!MapsFailure {
    return tryPromise({ try: (signal) => call(client, signal), catch: (error) => error }) catch effect (error) => {
      const now = try Clock.currentTimeMillis
      if (!(error instanceof CloudError)) throw new MapsFailure({ code: "unavailable", message: "Cloud Maps could not complete this request." })
      const retryAfter = pauseOf(error.failure, now)
      const refused = cloudMapsFailure(error.failure, now)
      if (token > 0 && retryAfter > 0) {
        const before = try pause.get()
        const after = try orDie(pause.send({ type: "refusal", token, retryAfter }))
        if (after.until !== before.until) pauseFailure = refused
      }
      throw refused
    }
  }

  effect function fenced<A>(kind: CloudReadKind, owner: MapsBinding, generation: number, call: (client: MapsCloud, signal: AbortSignal) => Promise<A>): A!MapsFailure {
    const before = try machine.get()
    const requests = try pause.get()
    const client = account?.client
    if (client === undefined || !cloudReadMayStart(kind, before.binding, owner, before.generation, generation, canRequest(requests), false)) {
      if (!canRequest(requests)) throw pauseFailure ?? new MapsFailure({ code: "rate-limited", message: "Maps request limit reached. Try again later." })
      throw changed()
    }
    const sent = try orDie(pause.send({ type: "request" }))
    const token = sent.pending
    const value = try ensuring(cloudCall(call, client, token), Effect.ignore(pause.send({ type: "settleRequest", token })))
    const after = try machine.get()
    if (!cloudReadMayReturn(kind, after.binding, owner, after.generation, generation, true, false)) throw changed()
    return value
  }

  function provider(offer: Offer, owner: MapsBinding, generation: number): MapsProvider {
    const read = <A>(call: (client: MapsCloud, signal: AbortSignal) => Promise<A>) => fenced("ProviderOperation", owner, generation, call)
    const providerId = offer.providerId
    effect function routes(from: Coordinate, to: Coordinate, mode: TravelMode, alternatives: boolean): (readonly Route[])!MapsFailure {
      const start = try coordinate(from)
      const end = try coordinate(to)
      const answer = try read((client, signal) => client.mapsRoutes({ from: start, to: end, mode, ...(alternatives ? { alternatives: true } : {}) }, { signal }))
      if (answer.routes.length > (alternatives ? 3 : 1)) throw new MapsFailure({ code: "invalid-response", message: "The Maps route response is invalid." })
      const planned: Route[] = []
      for (const item of answer.routes) planned.push(try route(item, providerId))
      return planned
    }
    return {
      providerId,
      connectionId: offer.connectionId,
      search: effect (query, options) => {
        const text = query.trim()
        if (text === "") return []
        if (text.length > 300) throw new MapsFailure({ code: "unsupported", message: "Search text is too long." })
        const near = options?.near === undefined ? undefined : try coordinate(options.near)
        const answer = try read((client, signal) => client.mapsPlacesSearch({ query: text, ...(near === undefined ? {} : { near }) }, { signal }))
        const places: Place[] = []
        for (const item of answer.places) places.push(try place(item, providerId))
        return places
      },
      detail: effect (id) => {
        if (!placeIdPattern.test(id)) return null
        const answer = try read((client, signal) => client.mapsPlaceDetails({ id }, { signal }))
        return answer.place === null ? null : try place(answer.place, providerId)
      },
      route: effect (from, to, mode) => {
        const [first] = try routes(from, to, mode, false)
        if (first === undefined) throw new MapsFailure({ code: "invalid-response", message: "The Maps route response is invalid." })
        return first
      },
      routes: (from, to, mode) => routes(from, to, mode, offer.capabilities.alternatives),
    }
  }

  function coverageOf(offer: Offer): CloudMapsCoverage {
    return {
      providerId: offer.providerId, revision: offer.revision, attribution: offer.attribution, regions: offer.regions,
      sources: offer.sources, disclosure: offer.disclosure, ...(offer.tiles === undefined ? {} : { tiles: offer.tiles }),
    }
  }

  function configuration(offer: Offer): ProviderConfig {
    const caps = offer.capabilities
    return {
      status: "configured", providerId: offer.providerId, connectionId: offer.connectionId, revision: offer.revision,
      capabilities: {
        map: caps.map && offer.tiles !== undefined, search: true, placeDetails: true, modes: [...caps.modes], traffic: caps.traffic,
        transit: caps.transit, offline: { map: false, search: false, routing: false }, alternatives: caps.alternatives,
      },
    }
  }

  effect function settle(attempt: number, reply: CoverageReply): boolean!! {
    const now = try machine.get()
    if (attempt !== now.generation || now.phase !== "PendingCoverage") return false
    try orDie(machine.send({ type: "coverageSettles", attempt, reply }))
    return true
  }

  effect function initialize(force: boolean = false): void!! {
    const started = try serialize(effect {
      const before = try machine.get()
      if (!(force || before.phase === "NeverRead" || before.phase === "FailedCoverage" || before.phase === "RetiredCoverage")) return undefined
      uninstall()
      const read = try orDie(machine.send({ type: "readCoverage", force }))
      diagnostics = { configured: true, error: "", message: "" }
      if (read.phase !== "PendingCoverage" || account === undefined) {
        diagnostics = { configured: true, error: "unauthorized", message: "Sign in to Cloud to use Maps." }
        return undefined
      }
      return { attempt: read.generation, owner: read.binding, client: account.client }
    })
    if (started === undefined) return
    const answer = try exit(cloudCall((client, signal) => client.mapsCapabilities({ signal }), started.client, 0))
    try serialize(effect {
      if (answer._tag === "Failure") {
        const refused = Exit.findErrorOption(answer)
        if (try settle(started.attempt, "CoverageUnavailable")) {
          diagnostics = refused._tag === "Some"
            ? { configured: true, error: refused.value.code, message: refused.value.message }
            : { configured: true, error: "cancelled", message: "Maps request cancelled." }
        }
        return
      }
      const offer = answer.value
      if (!offer.available) {
        if (try settle(started.attempt, "CoverageUnavailable")) diagnostics = { configured: true, error: "unconfigured", message: "Cloud Maps is not available yet." }
        return
      }
      if (!(try settle(started.attempt, "ValidCoverage"))) return
      coverage = coverageOf(offer)
      installed = true
      configure(configuration(offer), provider(offer, started.owner, started.attempt))
    })
  }

  effect function bind(next: CloudMapsAccount | undefined): void!! {
    try serialize(effect {
      const binding = ids.of(next)
      account = next
      const before = try machine.get()
      if (binding.session === before.binding.session && binding.credential === before.binding.credential && binding.client === before.binding.client) return
      const after = try orDie(machine.send({ type: "bindMaps", binding }))
      if (after.generation !== before.generation) {
        uninstall()
        try orDie(pause.send({ type: "retireSession" }))
        pauseFailure = undefined
        diagnostics = next === undefined ? { configured: true, error: "unauthorized", message: "Sign in to Cloud to use Maps." } : diagnostics
      }
    })
  }

  effect function basemap(): (CloudMapsBasemap | undefined)!! {
    const state = try machine.get()
    const tiles = coverage?.tiles
    if (tiles === undefined || state.phase !== "PublishedCoverage") return undefined
    const owner = state.publisher
    const generation = state.generation
    return {
      kind: "cloud-raster", attribution: tiles.attribution, minZoom: tiles.minZoom, maxZoom: tiles.maxZoom, tileSize: tiles.tileSize,
      tile: effect (z, x, y) => {
        if (!Number.isInteger(z) || z < tiles.minZoom || z > tiles.maxZoom || !Number.isInteger(x) || !Number.isInteger(y) || x < 0 || y < 0 || x >= 2 ** z || y >= 2 ** z) {
          throw new MapsFailure({ code: "unsupported", message: "This map tile is unavailable." })
        }
        return (try fenced("RasterTileOperation", owner, generation, (client, signal) => client.mapsTile({ z, x, y }, { signal }))).bytes
      },
      copyright: effect (view) => {
        const answer = try fenced("ProviderOperation", owner, generation, (client, signal) => client.mapsViewport({
          zoom: Math.max(0, Math.min(22, Math.round(view.zoom))), north: view.north, south: view.south, east: view.east, west: view.west,
        }, { signal }))
        return boundedText(answer.copyright, 500) ? answer.copyright : tiles.attribution
      },
    }
  }

  return {
    bind,
    initialize,
    retire: () => bind(undefined),
    reopen: () => map(orDie(pause.send({ type: "reopen" })), () => undefined),
    coverage: () => coverage,
    basemap,
    diagnostics: () => diagnostics,
    connection: machine.get,
    requests: pause.get,
  }
}

export type CloudMaps = Effect.Success<ReturnType<typeof cloudMaps>>

export effect function viewportAttribution(basemap: CloudMapsBasemap) {
  const kept = try Ref.make(unattributed)
  const machine = try attributionOver(() => Ref.get(kept), (next) => Ref.set(kept, next))
  const serialize = (try Semaphore.make(1)).withPermits(1)
  let text = ""
  let attributed: MapsViewport | undefined

  const inside = (view: MapsViewport, area: MapsViewport) =>
    view.north <= area.north && view.south >= area.south && view.east <= area.east && view.west >= area.west && Math.round(view.zoom) === Math.round(area.zoom)

  effect function move(view: MapsViewport): void!! {
    try serialize(effect {
      const now = try machine.get()
      if (!now.alive || (attributed !== undefined && inside(view, attributed))) return
      try orDie(machine.send({ type: "moveView" }))
      attributed = undefined
    })
  }

  effect function show(view: MapsViewport): string!! {
    const asked = try serialize(effect {
      const now = try machine.get()
      if (!now.alive) return undefined
      return try orDie(machine.send({ type: "requestAttribution" }))
    })
    if (asked === undefined) return try current()
    const token = asked.pending
    const answer = try exit(basemap.copyright(view))
    return try serialize(effect {
      const success = answer._tag === "Success"
      const after = try orDie(machine.send({ type: "replyAttribution", token, success }))
      if (after.visible && after.shownView === asked.requestedView && success) {
        text = answer.value
        attributed = view
      }
      return after.visible ? text : ""
    })
  }

  effect function current(): string!! {
    return (try machine.get()).visible ? text : ""
  }

  return {
    move,
    show,
    current,
    state: machine.get,
    dispose: () => serialize(effect {
      const now = try machine.get()
      if (now.alive) try orDie(machine.send({ type: "disposeMap" }))
    }),
  }
}
