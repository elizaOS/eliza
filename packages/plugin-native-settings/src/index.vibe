// spec/nativeSettings/index.md, "Story: Adjust the device settings from the local overlay"; spec/nativeSettings/index.md, "A setting write is admitted by its current capability and valid level"
import type { Plugin } from "@elizaos/core"
import {
  System,
  systemClient,
  type AndroidRoleName,
  type ControlReading,
  type RoleRequestReport,
  type SettingsHandoff,
  type SystemClient,
  type SystemSettingsPage,
  type SystemVolumeStream,
} from "@elizaos/os-bridges"
import { settingsLevelAllowed, settingsOutcome, type ControlLimit, type SettingsOutcome } from "../gen/nativeSettings.effect.vibe"

export { systemClient }
export type { AndroidRoleName, ControlReading, RoleRequestReport, SettingsHandoff, SettingsOutcome, SystemClient, SystemSettingsPage, SystemVolumeStream }

export const DEVICE_SETTINGS_APP_NAME = "@elizaos/plugin-native-settings"

export const DEVICE_SETTINGS_ROLES: readonly AndroidRoleName[] = [
  "assistant",
  "dialer",
  "sms",
  "home",
]

export error DeviceSettingRefused { requestedLevel: number }

function observedLevel(reading: ControlReading, requestedLevel: number): boolean {
  return reading.kind === "reported" && reading.level === requestedLevel
}

export effect function applyBrightness(requestedLevel: number, device: SystemClient = System) {
  const settings = try tryPromise(() => device.getDeviceSettings())
  const limits: ControlLimit = { maxLevel: 255, canWrite: settings.canWriteSettings }
  if (!Number.isSafeInteger(requestedLevel) || !settingsLevelAllowed(limits, requestedLevel)) {
    throw new DeviceSettingRefused({ requestedLevel })
  }
  const changed = try tryPromise(() => device.setScreenBrightness({ brightness: requestedLevel / limits.maxLevel }))
  return settingsOutcome(limits, requestedLevel, observedLevel(changed.reading, requestedLevel), false)
}

export effect function applyVolume(stream: SystemVolumeStream, requestedLevel: number, device: SystemClient = System) {
  const settings = try tryPromise(() => device.getDeviceSettings())
  const selected = settings.volumes.find((entry) => entry.stream === stream)
  const limits: ControlLimit = { maxLevel: selected?.max ?? 0, canWrite: selected !== undefined }
  if (!Number.isSafeInteger(requestedLevel) || !settingsLevelAllowed(limits, requestedLevel)) {
    throw new DeviceSettingRefused({ requestedLevel })
  }
  const changed = try tryPromise(() => device.setVolume({ stream, volume: requestedLevel }))
  return settingsOutcome(limits, requestedLevel, observedLevel(changed.reading, requestedLevel), false)
}

export effect function openNativeSettingsShortcut(page: SystemSettingsPage, device: SystemClient = System) {
  const handoff = try tryPromise(() => device.openSettingsPage({ page }))
  const outcome = settingsOutcome({ maxLevel: 255, canWrite: true }, 0, false, true)
  return { handoff, outcome }
}

export effect function requestAndroidRoleShortcut(role: AndroidRoleName, device: SystemClient = System) {
  const report = try tryPromise(() => device.requestRole({ role }))
  const outcome = settingsOutcome({ maxLevel: 255, canWrite: true }, 0, false, true)
  return { report, outcome }
}

export const appDeviceSettingsPlugin: Plugin = {
  name: DEVICE_SETTINGS_APP_NAME,
  description: "Android Device Settings overlay: inspect roles and control brightness or volume through the native system bridge.",
}

const defaultAppDeviceSettingsPlugin: Plugin = appDeviceSettingsPlugin
export default defaultAppDeviceSettingsPlugin
