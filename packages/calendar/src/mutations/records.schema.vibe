// spec/calendar/mutationLedger.md, "A replay needs a durable receipt, and a recorded receipt never changes"; spec/calendar/actions.md, "An approved change runs only with its reviewed fields for the account that approved it"; spec/calendar/actions.md, "Only an invitee answers an invitation, and an invitee's delete is a decline"
import type { CalendarEvent, CalendarEventFields, CalendarSourceKey } from "../model.vibe"
import { RecurrenceRecord, WriteScopeRecord } from "../series/rows.schema.vibe"

const Text = Schema.String.check(Schema.isMaxLength(16_000))

/** A provider calendar's exact identity as stored or sent. */
export const SourceKeyRecord = Schema.Struct({
  provider: Schema.Literals(["eliza", "google", "microsoft", "apple_calendar", "ics", "device"]),
  side: Schema.Literals(["owner", "agent"]),
  grantId: Schema.String.check(Schema.isMaxLength(512)),
  connectorAccountId: Schema.String.check(Schema.isMaxLength(512)),
  calendarId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(1024)),
})

const Attendee = Schema.Struct({
  email: Schema.NullOr(Schema.String),
  displayName: Schema.NullOr(Schema.String),
  responseStatus: Schema.NullOr(Schema.String),
  self: Schema.Boolean,
  organizer: Schema.Boolean,
  optional: Schema.Boolean,
})

/** One calendar event as a store or a provider holds it. */
export const EventRecord = Schema.Struct({
  id: Schema.String.check(Schema.isMinLength(1)),
  externalId: Schema.String,
  agentId: Schema.String,
  provider: SourceKeyRecord.fields.provider,
  side: SourceKeyRecord.fields.side,
  calendarId: Schema.String,
  title: Schema.String.check(Schema.isMaxLength(500)),
  description: Text,
  location: Schema.String.check(Schema.isMaxLength(2_000)),
  status: Schema.String,
  startAt: Schema.String,
  endAt: Schema.String,
  isAllDay: Schema.Boolean,
  timezone: Schema.NullOr(Schema.String),
  htmlLink: Schema.NullOr(Schema.String),
  conferenceLink: Schema.NullOr(Schema.String),
  organizer: Schema.NullOr(Schema.Record(Schema.String, Schema.Unknown)),
  attendees: Schema.Array(Attendee),
  metadata: Schema.Record(Schema.String, Schema.Unknown),
  recurrence: Schema.optionalKey(Schema.NullOr(Schema.Array(Schema.String))),
  recurringEventId: Schema.optionalKey(Schema.NullOr(Schema.String)),
  syncedAt: Schema.String,
  updatedAt: Schema.String,
  calendarSummary: Schema.optionalKey(Schema.String),
  connectorAccountId: Schema.optionalKey(Schema.String),
  grantId: Schema.optionalKey(Schema.String),
  accountEmail: Schema.optionalKey(Schema.String),
})

/** The exact fields an owner reviews for a create or an update. */
export const FieldsRecord = Schema.Struct({
  title: Schema.String.check(Schema.isMaxLength(500), Schema.isPattern(/^\s*[^\s\u0000][^\u0000]*$/)),
  description: Text,
  location: Schema.String.check(Schema.isMaxLength(2_000)),
  startAt: Schema.String,
  endAt: Schema.String,
  isAllDay: Schema.Boolean,
  timeZone: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128)),
})

const Target = Schema.Struct({
  source: SourceKeyRecord,
  eventId: Schema.String.check(Schema.isMinLength(1)),
  expectedVersion: Schema.String.check(Schema.isMinLength(1)),
})

/** The reviewed change itself: its operation, the account that approved it, its target and its fields. */
export const PayloadRecord = Schema.Union([
  Schema.Struct({ action: Schema.Literal("schedule_event"), account: Schema.String, source: SourceKeyRecord, fields: FieldsRecord, recurrence: Schema.NullOr(RecurrenceRecord) }),
  Schema.Struct({ action: Schema.Literal("modify_event"), account: Schema.String, target: Target, scope: WriteScopeRecord, fields: FieldsRecord }),
  Schema.Struct({ action: Schema.Literal("cancel_event"), account: Schema.String, target: Target, scope: WriteScopeRecord }),
  Schema.Struct({ action: Schema.Literal("respond_invitation"), account: Schema.String, target: Target, scope: Schema.Literals(["instance", "series"]),
    response: Schema.Literals(["accepted", "tentative", "declined"]) }),
])

/** The provider's receipt for one applied change. */
export const ReceiptRecord = Schema.Struct({
  operation: Schema.Literals(["schedule_event", "modify_event", "cancel_event", "respond_invitation"]),
  source: SourceKeyRecord,
  eventId: Schema.String.check(Schema.isMinLength(1)),
  providerVersion: Schema.String.check(Schema.isMinLength(1)),
  event: Schema.NullOr(EventRecord),
  target: Schema.NullOr(EventRecord),
  acceptedAt: Schema.String,
})

/** Why an attempt did not apply. */
export const FailureRecord = Schema.Struct({ code: Schema.String, message: Schema.String, retryable: Schema.Boolean })

/** The durable receipt row: the claim token it was recorded under, and the receipt. */
export const ReceiptRow = Schema.Struct({ token: Schema.Int.check(Schema.isGreaterThan(0)), receipt: ReceiptRecord })

/** The durable request row: the reviewed digest and payload the ledger first saw under this id. */
export const RequestRow = Schema.Struct({ digest: Schema.String.check(Schema.isMinLength(1)), payload: PayloadRecord })

type Assignable<A, B extends A> = B
/** The stored event shape is the model's event shape. */
export type StoredEvent = Assignable<CalendarEvent, typeof EventRecord.Type>
/** The stored source shape is the model's source key shape. */
export type StoredSource = Assignable<CalendarSourceKey, typeof SourceKeyRecord.Type>
/** The stored fields are the model's reviewed fields. */
export type StoredFields = Assignable<CalendarEventFields, typeof FieldsRecord.Type>
