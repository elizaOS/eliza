// spec/calendar/availability.md, "Choose a bounded interval and accept occupancy-only rows"; spec/calendar/availability.md, "Return sorted rows and preserve their multiplicity"
import { SchemaGetter } from "effect"
import { knownTimeZone } from "../clock.vibe"

const day = 86_400_000
const lastInstant = Date.parse("9999-12-31T23:59:59.999Z")
const instantText = (millis: number) => new Date(millis).toISOString()
const between = (minimum: number, maximum: number) => Schema.Int.check(Schema.isBetween({ minimum, maximum }))

function roundTrips(value: string) {
  const stamp = Date.parse(value)
  return Number.isFinite(stamp) && instantText(stamp) === value
}

function sampled<Wire extends Schema.Constraint, Seed extends Schema.Constraint>(wire: Wire, seed: Seed, build: (seed: Seed["Type"]) => Wire["Type"]) {
  const domain = Schema.declare(Schema.is(Schema.toType(wire)), {
    toCodecArbitrary: () => Schema.link<Wire["Type"]>()(seed, { decode: SchemaGetter.transform(build), encode: SchemaGetter.forbiddenEncoding }),
  })
  return Schema.decodeTo(domain)(wire)
}

const ZoneSeed = Schema.Literals(["UTC", "America/Los_Angeles", "America/New_York", "Europe/London", "Australia/Lord_Howe"])

/** A four-digit-year UTC instant with millisecond precision that round-trips. */
export const Instant = sampled(Schema.String.check(Schema.isPattern(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/), Schema.makeFilter(roundTrips)),
  between(0, lastInstant), instantText)

/** A zone Intl supports, nonempty, at most 128 UTF-16 units and free of NUL. */
export const ZoneName = sampled(Schema.String.check(Schema.makeFilter((name: string) => knownTimeZone(name))), ZoneSeed, (zone) => zone)

function boundedSpan({ start, end }: { readonly start: string; readonly end: string }) {
  const from = Date.parse(start), to = Date.parse(end)
  return from >= 0 && to > from && to - from <= 7 * day
}

const OperationWire = Schema.Struct({ type: Schema.Literal("calendar_availability"), start: Instant, end: Instant, timeZone: ZoneName })
  .check(Schema.makeFilter(boundedSpan))

/** The availability operation: exactly its type, a positive interval of at most seven days from a nonnegative start, and a zone. */
export const AvailabilityOperation = sampled(OperationWire,
  Schema.Struct({ from: between(0, lastInstant - 7 * day), duration: between(1, 7 * day), timeZone: ZoneSeed }),
  ({ from, duration, timeZone }) => ({ type: "calendar_availability", start: instantText(from), end: instantText(from + duration), timeZone } as const))

/** One occupancy-only row a reader returns: exactly its interval, all-day flag and availability. */
export const AvailabilityEventRow = Schema.Struct({
  start: Instant, end: Instant, allDay: Schema.Boolean, availability: Schema.Literals(["busy", "free", "tentative"]),
})

/** One readable calendar the picker may offer: a distinct nonempty identity and a lowercase 64-hex revision; labels stay local. */
export const AvailabilitySourceRow = Schema.Struct({
  id: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128), Schema.makeFilter((id: string) => !id.includes("\0"))),
  sourceRevision: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/)),
  name: Schema.optionalKey(Schema.Unknown),
  account: Schema.optionalKey(Schema.Unknown),
})

const BusyInterval = Schema.Struct({ start: Instant, end: Instant, allDay: Schema.Boolean, tentative: Schema.Boolean })

/** The shared availability result: exactly its version, kind, window, calendar count, status, busy intervals and transparent count. */
export const AvailabilityResult = Schema.Struct({
  version: Schema.Literal(1),
  kind: Schema.Literal("calendar_availability"),
  window: Schema.Struct({ start: Instant, end: Instant, timeZone: ZoneName }),
  calendarCount: between(1, 16),
  status: Schema.Literals(["free", "busy"]),
  busy: Schema.Array(BusyInterval).check(Schema.isMaxLength(200)),
  transparentIgnored: between(0, 200),
})

/** The availability operation's type. */
export type AvailabilityOperation = typeof AvailabilityOperation.Type
/** An occupancy-only row's type. */
export type AvailabilityEventRow = typeof AvailabilityEventRow.Type
/** A shared availability result's type. */
export type AvailabilityResult = typeof AvailabilityResult.Type
