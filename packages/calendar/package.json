{
  "name": "@elizaos/plugin-calendar",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Calendar reads, linked and managed sync, availability and reviewed series writes.",
  "license": "MIT",
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/os": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "eliza-source": "./src/client/index.vibe",
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    },
    "./linked-sync": {
      "eliza-source": "./src/linked-sync/index.vibe",
      "types": "./dist/src/linked-sync/index.d.ts",
      "import": "./dist/src/linked-sync/index.js",
      "default": "./dist/src/linked-sync/index.js"
    },
    "./availability": {
      "eliza-source": "./src/availability/index.vibe",
      "types": "./dist/src/availability/index.d.ts",
      "import": "./dist/src/availability/index.js",
      "default": "./dist/src/availability/index.js"
    },
    "./feed": {
      "eliza-source": "./src/feed/index.vibe",
      "types": "./dist/src/feed/index.d.ts",
      "import": "./dist/src/feed/index.js",
      "default": "./dist/src/feed/index.js"
    },
    "./series": {
      "eliza-source": "./src/series/index.vibe",
      "types": "./dist/src/series/index.d.ts",
      "import": "./dist/src/series/index.js",
      "default": "./dist/src/series/index.js"
    }
  }
}
