{
  "name": "@elizaos/plugin-files",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Reviewed file operations, local text recognition, archives and document scans.",
  "license": "MIT",
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@elizaos/agent": "workspace:*",
    "@elizaos/agent-host": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/core-node": "workspace:*",
    "@elizaos/plugin-files-client": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@elizaos/os-bridges": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
