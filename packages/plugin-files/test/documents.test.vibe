// spec/files/sourceReferences.md, "Story: Keep a source link and reopen the exact document I reviewed"; spec/files/scan/event.md, "Story: Turn a scanned poster into a Calendar draft I review"; spec/files/scan/links.md, "Story: Review links in my scanned text and open the one I choose"; spec/files/archive.md, "Story: Download exactly the files I selected"; spec/files/pdfInterpretation.md, "Story: Interpret the complete attachment only while it is still authorized"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import {
  fileArchive, mediaDownloads, type SelectedMedia, blobOf, readBytes, scanLinkReview, scannedLinks, copyScanTextLayers, scanTextLayer, admitSourceReopen, documentSourceOf, recordingRevision, recordingSourceOf, retainedSourceReferences, reviewMailAttachment, sourceKeepSet, sourceProvesPast, summarySourceOf, webSourceOf,
} from "@elizaos/plugin-files-client"
import { interpretPdf, loadDocumentRuntime, PdfInterpretationFailed, type ParsedPage, type PdfPorts } from "../src/documents/pdf-interpretation.vibe"
import { reviewScanAllDayEvent, reviewScanEvent, suggestScanEvent, suggestScanEventDetails } from "../src/documents/scan-event.vibe"

const pdfBytes = new TextEncoder().encode("%PDF-1.7\n1 0 obj<<>>endobj\n%%EOF\n")
const base64 = (bytes: Uint8Array) => btoa(String.fromCharCode(...bytes))
const reason = <A, E extends { readonly reason: string }>(plan: A!E) => map(Effect.flip(plan), (error) => error.reason)
const check = (assertion: () => void) => Effect.try(assertion)

it.effect('Keep a source link and reopen the exact document I reviewed (spec/files/sourceReferences.md, "Story: Keep a source link and reopen the exact document I reviewed")', effect () => {
  const reviewed = try reviewMailAttachment({ name: "lease.pdf", mimeType: "application/pdf", dataBase64: base64(pdfBytes) })
  const reference = `a1:${"c".repeat(64)}`
  const link = documentSourceOf({ version: 1, name: reviewed.name, mimeType: reviewed.mimeType, sha256: reviewed.sha256, size: reviewed.size, reference, extra: true })
  const live = { link: link!, mimeType: "application/pdf", bytes: Uint8Array.from(pdfBytes), accessible: true, approved: true, currentGeneration: true, focused: true }
  const changed = Uint8Array.from(pdfBytes)
  changed[changed.length - 2] = 0x20
  const text = try reviewMailAttachment({ name: "empty.txt", mimeType: "text/plain", dataBase64: "" })
  const revision = try recordingRevision({ id: "note", body: "x" })
  try check(() => {
    assert.deepEqual(link, { version: 1, name: "lease.pdf", mimeType: "application/pdf", sha256: reviewed.sha256, size: pdfBytes.length, reference })
    assert.deepEqual(documentSourceOf({ ...link, reference: "a1:short" }), { version: 1, name: "lease.pdf", mimeType: "application/pdf", sha256: reviewed.sha256, size: pdfBytes.length })
    assert.equal(documentSourceOf({ ...link, size: 5 * 1024 * 1024 + 1 }), undefined)
    assert.equal(documentSourceOf({ ...link, name: "a/b.pdf" }), undefined)
    assert.deepEqual(text, { name: "empty.txt", mimeType: "text/plain", size: 0, sha256: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", text: "" })
    assert.deepEqual(retainedSourceReferences([{ documentSource: link }, { documentSource: link }, { documentSource: { ...link, reference: `b1:${"0".repeat(36)}` } }]), [reference])
    assert.match(revision, /^[a-f0-9]{64}$/)
    assert.deepEqual(recordingSourceOf({ kind: "recording", version: 1, name: "Call", noteId: "n1", revision }), { kind: "recording", version: 1, name: "Call", noteId: "n1", revision })
    assert.equal(webSourceOf({ kind: "web-page", version: 1, name: "Bank", url: "https://user:pw@bank.example/" }), undefined)
    assert.equal(webSourceOf({ kind: "web-page", version: 1, name: "Sign in", url: "https://example.com/login" }, (url) => url.endsWith("/login")), undefined)
    const page = summarySourceOf({ kind: "web-page", version: 1, name: "Docs", url: "https://example.com/ab" })
    assert.equal(page !== undefined && sourceProvesPast(page), false)
    assert.equal(sourceProvesPast(link!), true)
  })
  assert.deepEqual(try admitSourceReopen(live), link)
  assert.equal(try reason(admitSourceReopen({ ...live, bytes: changed })), "changed")
  assert.equal(try reason(admitSourceReopen({ ...live, currentGeneration: false })), "not-current")
  assert.equal(try reason(reviewMailAttachment({ name: "lease.png", mimeType: "image/png", dataBase64: base64(pdfBytes) })), "content-mismatch")
  assert.equal(try reason(reviewMailAttachment({ name: "lease.pdf", mimeType: "application/pdf", dataBase64: "not base64!" })), "invalid-attachment")
  assert.deepEqual(try sourceKeepSet([reference, reference]), [reference])
  assert.equal(try reason(sourceKeepSet([reference, "b1:" + "0".repeat(36)])), "invalid-keep-set")
})

it.effect('Review links in my scanned text and open the one I choose (spec/files/scan/links.md, "Story: Review links in my scanned text and open the one I choose")', effect () => {
  const opened: string[] = []
  let active = true
  const review = try scanLinkReview(effect (url) => {
    opened.push(url)
    return true
  }, () => active)
  const shown = try review.update("Visit www.Example.com/menu, (https://a.example/x) and https://a.example/x again; http:///bad https://u:p@x.example")
  try check(() => {
    assert.deepEqual(shown.urls, ["https://www.example.com/menu", "https://a.example/x"])
    assert.deepEqual(scannedLinks(Array.from({ length: 12 }, (_, n) => `https://s${n}.example`).join(" ")).length, 10)
    assert.deepEqual(scannedLinks("x".repeat(100_001)), [])
  })
  assert.equal((try review.open("https://elsewhere.example/")).status, "NoLinkStatus")
  assert.equal((try review.open("https://a.example/x")).status, "LinkOpened")
  active = false
  assert.equal((try review.open("https://a.example/x")).status, "LinkOpened")
  assert.deepEqual(opened, ["https://a.example/x"])
  assert.equal((try review.update("no links")).status, "NoLinkStatus")
})

it.effect('Save the reviewed text beside the image of its own page (spec/files/scan/searchablePdf.md, "Story: Save the reviewed text beside the image of its own page")', effect () => {
  const line = { text: "Total\t12", x: 0.1, y: 0.2, width: 0.5, height: 0.05, confidence: 91 }
  assert.deepEqual(try scanTextLayer([line]), [{ text: "Total\t12", x: 0.1, y: 0.2, width: 0.5, height: 0.05 }])
  assert.equal(try reason(scanTextLayer([{ ...line, x: 0.6 }])), "invalid-line")
  assert.equal(try reason(scanTextLayer([{ ...line, text: "a\nb" }])), "invalid-line")
  assert.equal(try reason(copyScanTextLayers([[line]], 2)), "page-mismatch")
  assert.deepEqual(try copyScanTextLayers([null, []], 2), [null, []])
})

effect function zipNames(file: Blob) {
  const bytes = try orDie(readBytes(file))
  const view = new DataView(bytes.buffer)
  const names: string[] = []
  for (let at = 0; at + 30 <= bytes.length && view.getUint32(at, true) === 0x04034b50;) {
    const size = view.getUint32(at + 18, true), length = view.getUint16(at + 26, true)
    names.push(new TextDecoder().decode(bytes.subarray(at + 30, at + 30 + length)))
    at += 30 + length + size
  }
  return names
}

it.effect('Download exactly the files I selected (spec/files/archive.md, "Story: Download exactly the files I selected")', effect () => {
  const media: SelectedMedia[] = [
    { source: "video", name: "clip.MP4", mimeType: "video/mp4", bytes: Uint8Array.from([1, 2, 3]) },
    { source: "photo", name: "photo.jpg", mimeType: "image/jpeg", bytes: Uint8Array.from([4]) },
  ]
  const controls = { matches: true, visible: true, delivered: [] as { name: string; type: string }[] }
  const downloads = try mediaDownloads({
    read: effect (sources) => media.filter((item) => sources.includes(item.source)).sort((a, b) => sources.indexOf(a.source) - sources.indexOf(b.source)),
    reread: effect () => controls.matches,
    ownerCurrent: () => true,
    visible: () => controls.visible,
    deliver: effect (file, name) => { controls.delivered.push({ name, type: file.type }) },
  })
  assert.deepEqual(try downloads.download(["video", "photo"]), { kind: "requested", name: "Download.zip" })
  assert.deepEqual(try downloads.download(["photo"]), { kind: "requested", name: "photo.jpg" })
  controls.matches = false
  assert.deepEqual(try downloads.download(["video"]), { kind: "refused" })
  controls.matches = true
  controls.visible = false
  assert.deepEqual(try downloads.download(["video"]), { kind: "refused" })
  assert.deepEqual(try downloads.download(["video", "video"]), { kind: "refused" })
  assert.deepEqual(controls.delivered, [{ name: "Download.zip", type: "application/zip" }, { name: "photo.jpg", type: "image/jpeg" }])
  const archive = try fileArchive([{ path: "Docs/", bytes: new Uint8Array() }, { path: "Docs/ü.txt", bytes: Uint8Array.from([9]) }])
  assert.deepEqual(try zipNames(archive), ["Docs/", "Docs/ü.txt"])
  assert.equal(try reason(fileArchive([{ path: "../x", bytes: new Uint8Array() }])), "unsafe-path")
  assert.deepEqual(try zipNames(blobOf([], "application/zip")), [])
})

const held = { ownerCurrent: true, notAborted: true, outboundAllowed: true, exactAuthority: true, ambientAttribution: false }

function pdfPorts(pages: readonly Partial<ParsedPage>[], vision: readonly (string | undefined)[], scope = () => held): PdfPorts {
  const page = (n: number): ParsedPage => ({
    width: 612, height: 792, nativeText: "", nativePositionedText: [], operatorCount: 1, hasVisualContent: false,
    render: effect () => "data:image/png;base64,iVBORw0KGgo=", ...pages[n - 1],
  })
  return {
    open: effect () => ({ pageCount: pages.length, page: effect (n) => page(n) }),
    describe: effect (_url, prompt) => {
      const answer = vision[Number(/PDF page (\d+)/.exec(prompt)?.[1]) - 1]
      if (answer === undefined) throw new PdfInterpretationFailed({ reason: "transcription-unavailable" })
      return answer
    },
    scope,
    lifecycle: effect () => {},
  }
}

it.effect('Interpret the complete attachment only while it is still authorized (spec/files/pdfInterpretation.md, "Story: Interpret the complete attachment only while it is still authorized"; spec/files/pdfInterpretation.md, "Story: Load only the reviewed document runtime")', effect () => {
  const two = try interpretPdf("application/pdf", pdfBytes, pdfPorts([{ nativeText: "Lease  \n" }, { operatorCount: 0 }], ["Lease terms", "[BLANK PAGE]"]), 7,
    effect (document) => document.pages.map((page) => [page.pageNumber, page.method, page.text]))
  assert.deepEqual(two, [[1, "native+vision", "Lease\n\n[Rendered-page transcription and visual context]\nLease terms"],
    [2, "blank", "[Rendered-page transcription and visual context]\n[BLANK PAGE]"]])
  const refusal = <A>(plan: A!PdfInterpretationFailed) => map(Effect.flip(plan), ({ reason, pageNumber }) => [reason, pageNumber])
  const mapper = effect () => "mapped"
  assert.deepEqual(try refusal(interpretPdf("application/pdf", pdfBytes, pdfPorts([{ nativeText: "x" }], ["[BLANK PAGE]"]), 1, mapper)), ["page-failed", 1])
  assert.deepEqual(try refusal(interpretPdf("application/pdf", pdfBytes, pdfPorts([{}, {}], ["ok", undefined]), 1, mapper)), ["transcription-unavailable", 2])
  assert.deepEqual(try refusal(interpretPdf("application/pdf", pdfBytes, pdfPorts([{}], ["ok"], () => ({ ...held, ownerCurrent: false })), 1, mapper)), ["owner-lost", undefined])
  assert.deepEqual(try refusal(interpretPdf("text/plain", pdfBytes, pdfPorts([{}], ["ok"]), 1, mapper)), ["unsupported", undefined])
  assert.deepEqual(try refusal(interpretPdf("application/pdf", new TextEncoder().encode("hello"), pdfPorts([{}], ["ok"]), 1, mapper)), ["invalid-pdf", undefined])
  provide NodeServices.layer {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const commit = "a".repeat(40)
    try scoped(effect {
      const root = try files.makeTempDirectoryScoped({ prefix: "document-runtime-" })
      const artifact = path.join(root, "runtime.mjs")
      const source = ["pdfService", "imageDescription", "resolveAuthority", "nativeSlot", "callerAttribution"].map((name) => `export function ${name}() {}`).join("\n")
      try files.writeFileString(artifact, source)
      const { sha256 } = try reviewMailAttachment({ name: "runtime.txt", mimeType: "text/plain", dataBase64: base64(new TextEncoder().encode(source)) })
      try files.writeFileString(`${artifact}.json`, JSON.stringify({ schema: 1, commit, canvas: "0.1.80", sha256 }))
      const runtime = try loadDocumentRuntime({ path: artifact, expectedCommit: commit, expectedCanvas: "0.1.80" })
      assert.deepEqual(Object.keys(runtime).sort(), ["callerAttribution", "imageDescription", "nativeSlot", "pdfService", "resolveAuthority"])
      const wrong = map(Effect.flip(loadDocumentRuntime({ path: artifact, expectedCommit: "b".repeat(40), expectedCanvas: "0.1.80" })), (error) => "reason" in error ? error.reason : "io")
      assert.equal(try wrong, "artifact-refused")
      try files.writeFileString(artifact, source + "\n")
      assert.equal(try map(Effect.flip(loadDocumentRuntime({ path: artifact, expectedCommit: commit, expectedCanvas: "0.1.80" })), (error) => "reason" in error ? error.reason : "io"), "artifact-refused")
    })
  }
})

it.effect('Turn a scanned poster into a Calendar draft I review (spec/files/scan/event.md, "Story: Turn a scanned poster into a Calendar draft I review"; spec/files/scan/event.md, "A date is suggested only when every date printed agrees, and a year, weekday or relative day is inferred only from the device\'s clock and disclosed"; spec/files/scan/event.md, "A start time is suggested only when every time printed agrees, in the device\'s zone or in one explicit zone it converts from"; spec/files/scan/event.md, "A repeat is only a hint the owner turns on"; spec/files/scan/event.md, "A draft holds only reviewed fields within their bounds, timed or all day as the owner reviewed it")', effect () => {
  const now = new Date("2026-10-03T15:00:00Z")
  const details = (text: string, timeZone = "America/New_York") => suggestScanEventDetails(text, { now, timeZone })
  const valid = { title: " Reviewed event ", date: "2027-01-02", time: "23:45", minutes: 90, location: " Hall " }
  const timed = try reviewScanEvent(valid, "Exact reviewed OCR text", new Date(2026, 11, 31, 12))
  const allDay = try reviewScanAllDayEvent({ title: "Book fair", date: "2026-10-10", location: "Library", repeat: "weekly" }, "text", new Date(2026, 9, 3))
  const refusals = try all([
    { ...valid, title: "" }, { ...valid, date: "2026-02-30" }, { ...valid, date: "1969-12-31" }, { ...valid, date: "" }, { ...valid, time: "24:00" },
    { ...valid, minutes: 15.5 }, { ...valid, minutes: 1441 }, { ...valid, allDay: true },
  ].map((fields) => map(Effect.flip(reviewScanEvent(fields, "text")), (refused) => refused.answer)))
  const longNotes = try map(Effect.flip(reviewScanEvent(valid, "x".repeat(16_001))), (refused) => refused.answer)
  const converted = details("Launch\nOctober 10, 2026\n18:30\nTime zone: Europe/London")
  const repeating = details("Yoga\nEvery Tuesday\n6 PM")
  try check(() => {
    assert.deepEqual(suggestScanEvent("Open studio\nOctober 10, 2026\nTime: 6:30 p.m.\nVenue: Main hall"), { title: "Open studio", date: "2026-10-10", time: "18:30", minutes: 60, location: "Main hall" })
    assert.deepEqual(suggestScanEvent("Studio\nOctober 10, 2026\nTime: 6 PM - 8 PM"), { title: "Studio", date: "2026-10-10", time: "18:00", minutes: 120, location: "" })
    assert.deepEqual(["Event\nOctober 10", "Event\n10/11/2026", "Event\n2026-02-30", "Event\n2026-10-10\nOctober 11"].map((text) => suggestScanEvent(text).date), ["", "", "", ""])
    assert.deepEqual(["Event\n2026-10-10\n6 PM PST", "Event\n2026-10-10\n18:30\n19:00", "Event\n2026-10-10T18:30+02:00", "Event\n2026-10-10\n13 AM"].map((text) => suggestScanEvent(text).time), ["", "", "", ""])
    assert.equal(suggestScanEvent("AC/DC tribute\nOctober 10, 2026\n6 PM\nhttps://example.com/events").time, "18:00")
    assert.deepEqual([details("Open studio\nOctober 10\n7 PM"), details("Book club\nTuesday\n6:30 PM"), details("Party\nTomorrow\n8 PM"), details("Gala\n2 March\n7 PM")].map(({ fields }) => fields.date),
      ["2026-10-10", "2026-10-06", "2026-10-04", "2027-03-02"])
    assert.match(details("Open studio\nOctober 10\n7 PM").disclosures.join("\n"), /Year inferred/)
    assert.match(details("Event\nFriday, October 10, 2026\n7 PM").disclosures.join("\n"), /does not match/)
    assert.deepEqual({ date: converted.fields.date, time: converted.fields.time, sourceZone: converted.sourceZone }, { date: "2026-10-10", time: "13:30", sourceZone: "Europe/London" })
    assert.deepEqual(["Event\n2026-10-10\n18:30 ET", "Event\n2026-10-10\n18:30 UTC\nTime zone: Asia/Tokyo", "Event\n2026-03-08\n02:30\nTime zone: America/New_York"]
      .map((text) => { const found = details(text); return [found.fields.time, found.sourceZone, found.disclosures.length > 0] }), [["", null, true], ["", null, true], ["", null, true]])
    assert.deepEqual([details("Book fair\nOctober 10, 2026\nVenue: Library").allDay, details("Book fair\nOctober 10, 2026\nNoon").allDay], [true, false])
    assert.deepEqual(repeating.recurrence, { repeat: "weekly", evidence: "Every Tuesday" })
    assert.deepEqual([details("Club\nEvery other week\n6 PM").recurrence, details("Club\nDaily and every Tuesday\n6 PM").recurrence], [null, null])
    assert.deepEqual(timed, { title: "Reviewed event", location: "Hall", notes: "Exact reviewed OCR text", repeat: "none", date: "2027-01-02", dayOffset: 2, allDay: false, time: "23:45", minutes: 90 })
    assert.deepEqual(allDay, { title: "Book fair", location: "Library", notes: "text", repeat: "weekly", date: "2026-10-10", dayOffset: 7, allDay: true })
    assert.deepEqual(refusals, ["TitleOrLocationOutOfBounds", "DayMissing", "YearOutOfRange", "DateAndTimeMissing", "DateAndTimeMissing", "DurationOutOfRange", "DurationOutOfRange", "TimedNeedsStart"])
    assert.equal(longNotes, "NotesTooLong")
  })
})
