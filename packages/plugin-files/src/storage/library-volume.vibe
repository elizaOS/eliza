// spec/files/library.md, "Story: Keep my browser files and change each only as I last saw it"; spec/files/library.md, "A selection reads its file only while the file still has the revision it selected"; spec/files/library.md, "A change commits only at the revision it expected, never takes a name in use, and never puts a folder inside itself"; spec/files/library.md, "An unreadable Trash journal refuses the request and keeps the stored rows"; spec/files/reviewedOperations.md, "The mutation re-reads each selected row and reports each outcome"; spec/files/reviewedOperations.md, "Trash owns a journal entry before moving the row"; spec/files/requests.md, "An empty or complete claim needs a full, known listing"; spec/files/requests.md, "Downloads is the Download folder with its folders, and a missing one is empty"
module browser {
  export async function identityToken(id: string, revision: string): Promise<string> {
    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify([id, revision])))
    return btoa(String.fromCharCode(...new Uint8Array(digest))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
  }

  export async function storageEstimate(): Promise<{ free: number; total: number } | undefined> {
    const estimate = await navigator.storage?.estimate?.().catch(() => undefined)
    const quota = estimate?.quota, usage = estimate?.usage
    return typeof quota === "number" && typeof usage === "number" && Number.isFinite(quota) && quota > 0 && usage >= 0 && usage <= quota
      ? { free: quota - usage, total: quota } : undefined
  }

  /** @throws {never} */
  export function base64(bytes: Uint8Array): string {
    let raw = ""
    for (let index = 0; index < bytes.length; index += 16_384) raw += String.fromCharCode(...bytes.subarray(index, index + 16_384))
    return btoa(raw)
  }

  export function fileBlob(bytes: Uint8Array<ArrayBuffer>, type: string): Blob {
    return new Blob([bytes], { type })
  }

  export function decodeUtf8(bytes: Uint8Array<ArrayBuffer>): string | undefined {
    try { return new TextDecoder("utf-8", { fatal: true }).decode(bytes) }
    catch { return undefined }
  }

  export async function shareFile(name: string, archive: Blob): Promise<"opened" | "cancelled" | "unsupported"> {
    const file = new File([archive], name, { type: "application/zip" })
    if (navigator.share === undefined || navigator.canShare?.({ files: [file] }) !== true) return "unsupported"
    return navigator.share({ files: [file] }).then(() => "opened" as const,
      (error: unknown) => error instanceof DOMException && error.name === "AbortError" ? "cancelled" as const : "unsupported" as const)
  }
}
import { base64, decodeUtf8, fileBlob, identityToken, shareFile, storageEstimate } from browser
import { apply, canPrune, classifyRow, listed, initial as fresh } from "../../gen/files__reviewedOperations.effect.vibe"
import { chatLimit, mailLimit, selectionReadable, textLimit, trashJournalVerdict } from "../../gen/files__library.effect.vibe"
import { batchMax, type FileOutcome, type FilesOp, type FilesRowCheck } from "../../gen/os__android__files__storage.effect.vibe"
import { fileArchive } from "../documents/archive.vibe"
import { downloadsListing, filterMatches, freeName, inCategory, joinPath, listing, parentOf, validName, validPath, within, DOWNLOAD_FOLDER, type StorageEntry, type TrashEntry } from "./model.vibe"
import { allocateLibraryId, deletePlan, insertPlan, LibraryStore, LIBRARY_ROOT, childrenOf, newId, placePlan, subtreeOf, type LibraryPlan, type LibraryRefusal, type LibraryRow } from "./library.vibe"
import { BROWSER_RECEIPT_FOLDER, BROWSER_TRASH_FOLDER as TRASH } from "./library-adoption.vibe"
import { checkSelection, FilesVolume, succeeded, VolumeRefused, type RowOutcome, type RowStatus } from "./volume.vibe"

const WALK_LIMIT = 5_000
const ANSWERS: Readonly<Record<FileOutcome, RowStatus>> = {
  Invalid: "invalid", Missing: "missing", Changed: "changed", Unchanged: "unchanged", Admitted: "failed",
  Copied: "copied", Moved: "moved", Trashed: "trashed", Failed: "failed",
}
schema JournalRow { phase: "Visible" | "Journaled" | "InTrash" | "MoveFailed" | "Expiring" | "Gone"; journal: boolean; resident: boolean; deletedAt: number }
schema TrashRecord { name: string; origin: string; directory: boolean; size: number; mimeType: string; row: JournalRow }
const readRecord = Schema.decodeUnknownOption(Schema.fromJsonString(TrashRecord))

const refused = (status: VolumeRefused["status"], message: string) => new VolumeRefused({ status, message })
const allocateId = mapError(allocateLibraryId, (failure) => refused("unavailable", failure.message))
const visible = (rows: readonly LibraryRow[], folderId: string) => childrenOf(rows, folderId).filter((row) => !row.name.startsWith("."))

function visiblePath(raw: string, allowRoot = false): string | undefined {
  const path = validPath(raw, allowRoot)
  const first = path?.split("/")[0]
  return first === TRASH || first === BROWSER_RECEIPT_FOLDER ? undefined : path
}

function rowAt(rows: readonly LibraryRow[], path: string): LibraryRow | undefined {
  let id = LIBRARY_ROOT
  let found: LibraryRow | undefined
  for (const part of path === "" ? [] : path.split("/")) {
    found = childrenOf(rows, id).find((row) => row.name === part)
    if (found === undefined) return undefined
    id = found.id
  }
  return found
}

function folderIdAt(rows: readonly LibraryRow[], path: string): string | undefined {
  if (path === "") return LIBRARY_ROOT
  const found = rowAt(rows, path)
  return found?.directory === true ? found.id : undefined
}

function nameClash(rows: readonly LibraryRow[], row: LibraryRow, name: string): boolean {
  return childrenOf(rows, row.parentId).some((other) => other.id !== row.id && other.name.toLowerCase() === name.toLowerCase())
}

function entryOf(rows: readonly LibraryRow[], path: string, row: LibraryRow): StorageEntry {
  return {
    path, name: row.name, directory: row.directory, mimeType: row.directory ? "" : row.mimeType || "application/octet-stream",
    size: row.directory ? 0 : row.size, modified: row.modifiedAt ?? 0, ...(row.directory ? { children: visible(rows, row.id).length } : {}),
  }
}

effect function walkRows(all: readonly LibraryRow[], from: string, keep: (entry: StorageEntry) => boolean) {
  const start = folderIdAt(all, from)
  if (start === undefined) throw refused("missing", "The folder is not there")
  const found: StorageEntry[] = []
  const queue: [string, string][] = [[start, from]]
  let visited = 0
  for (let index = 0; index < queue.length; index++) {
    const [id, path] = queue[index]
    for (const row of visible(all, id)) {
      if (++visited > WALK_LIMIT) return { found, partial: true }
      const entry = entryOf(all, joinPath(path, row.name), row)
      if (keep(entry)) found.push(entry)
      if (row.directory) queue.push([row.id, entry.path])
    }
  }
  return { found, partial: false }
}

effect function checkRow(all: readonly LibraryRow[], op: FilesOp, raw: string, reviewed: string | undefined, dest: string) {
  const path = visiblePath(raw) ?? ""
  const valid = path !== ""
  const row = valid ? rowAt(all, path) : undefined
  const matches = reviewed !== undefined && row !== undefined && (try promise(() => identityToken(row.id, row.revision))) === reviewed
  const facts: FilesRowCheck = {
    validPath: valid, pathExists: row !== undefined, reviewRequired: reviewed !== undefined, reviewMatches: matches, currentOwner: valid,
    sameFolder: op === "Move" && parentOf(path) === dest, descendant: row?.directory === true && within(dest, path),
  }
  return { path, row, facts, admission: classifyRow(op, facts) }
}

effect function freeNameIn(all: readonly LibraryRow[], folderId: string, name: string, directory: boolean): string!VolumeRefused {
  const free = freeName(name, childrenOf(all, folderId).map((row) => row.name), directory)
  if (free === undefined) throw refused("exists", "No free name")
  return free
}

effect function archiveOf(all: readonly LibraryRow[], selected: readonly string[]) {
  const files: { path: string; bytes: Uint8Array<ArrayBuffer> }[] = []
  for (const raw of selected) {
    const path = visiblePath(raw)
    const row = path === undefined ? undefined : rowAt(all, path)
    if (row === undefined) throw refused("missing", "A selected item changed. Refresh and select again.")
    for (const id of subtreeOf(all, row.id)) {
      const item = all.find((candidate) => candidate.id === id)
      if (item === undefined) continue
      let name = item.name
      for (let parent = item.parentId; parent !== row.parentId && parent !== LIBRARY_ROOT;) {
        const above = all.find((candidate) => candidate.id === parent)
        if (above === undefined) break
        name = `${above.name}/${name}`
        parent = above.parentId
      }
      if (item.directory) files.push({ path: `${name}/`, bytes: new Uint8Array(0) })
      else if (item.bytes === undefined) throw refused("failed", "File bytes unavailable.")
      else files.push({ path: name, bytes: item.bytes })
    }
  }
  return try mapError(fileArchive(files), (failure) => refused("invalid", failure.message))
}

type JournalEntry = { readonly metadata: LibraryRow; readonly record: typeof TrashRecord.Type; readonly data?: LibraryRow }
type TrashJournal =
  | { readonly kind: "JournalAbsent" }
  | { readonly kind: "JournalUnreadable" }
  | { readonly kind: "JournalReadable"; readonly folder: LibraryRow; readonly records: ReadonlyMap<string, JournalEntry> }
type ReadableTrash = Exclude<TrashJournal, { readonly kind: "JournalUnreadable" }>

function readTrashJournal(all: readonly LibraryRow[]): TrashJournal {
  const matching = childrenOf(all, LIBRARY_ROOT).filter(({ name }) => name === TRASH)
  if (matching.length === 0) return { kind: "JournalAbsent" }
  const [folder] = matching
  if (matching.length !== 1 || !folder?.directory) return { kind: "JournalUnreadable" }
  const rows = childrenOf(all, folder.id)
  const children = new Map(rows.map((row) => [row.name, row]))
  if (children.size !== rows.length) return { kind: "JournalUnreadable" }
  const records = new Map<string, JournalEntry>()
  for (const [name, metadata] of children) {
    if (!name.endsWith(".json")) continue
    const id = name.slice(0, -".json".length)
    const text = metadata.directory || metadata.bytes === undefined ? undefined : decodeUtf8(metadata.bytes)
    const record = text === undefined ? undefined : Option.getOrUndefined(readRecord(text))
    if (record === undefined || id === "") return { kind: "JournalUnreadable" }
    const data = children.get(id)
    records.set(id, { metadata, record, ...(data === undefined ? {} : { data }) })
  }
  const orphaned = [...children.keys()].some((name) => !name.endsWith(".json") && !records.has(name))
  return trashJournalVerdict("JournalReadable", orphaned) === "TrashAvailable"
    ? { kind: "JournalReadable", folder, records } : { kind: "JournalUnreadable" }
}

function removeTrashPlan(all: readonly LibraryRow[], rows: readonly LibraryRow[]) {
  if (rows.length === 0) return { put: [], remove: [] }
  return deletePlan(rows.map(({ id, revision }) => ({ id, expectedRevision: revision })), true, true)(all)
}

function folderPlan(all: readonly LibraryRow[], path: string, at: number): { readonly id: string; readonly put: readonly LibraryRow[] } | undefined {
  let id = LIBRARY_ROOT
  const put: LibraryRow[] = []
  for (const name of path === "" ? [] : path.split("/")) {
    const found = childrenOf(all, id).find((row) => row.name === name)
    if (found !== undefined) {
      if (!found.directory) return undefined
      id = found.id
    } else {
      const folder = newId()
      const plan = insertPlan({ id: folder, parentId: id, name, mimeType: "", directory: true, size: 0 }, at)([...all, ...put])
      if (typeof plan === "string") return undefined
      put.push(...plan.put)
      id = folder
    }
  }
  return { id, put }
}

function stageRows(working: Map<string, LibraryRow>, plan: LibraryPlan, put: Map<string, LibraryRow>, remove: Set<string>) {
  for (const id of plan.remove) {
    working.delete(id)
    put.delete(id)
    remove.add(id)
  }
  for (const row of plan.put) {
    working.set(row.id, row)
    put.set(row.id, row)
    remove.delete(row.id)
  }
}

export function libraryVolume(archiveName = "Files.zip") {
  return Layer.effect(FilesVolume, effect {
    const library = try LibraryStore
    const namespace = (try Semaphore.make(1)).withPermits(1)
    const rows = () => mapError(library.rows(), (failure) => refused("unavailable", failure.message))
    const now = Clock.currentTimeMillis

    effect function commit(plan: Parameters<LibraryStore.Shape["commit"]>[0]): void!VolumeRefused {
      try mapError(library.commit(plan), (failure) => failure._tag === "LibraryRefused"
        ? refused(failure.answer === "LibraryTrashUnreadable" ? "failed" : failure.answer === "LibraryNameTaken" ? "exists"
          : failure.answer === "LibraryStale" || failure.answer === "LibraryBatchRefused" ? "changed" : "invalid", failure.message)
        : refused("unavailable", failure.message))
    }

    effect function commitTrash<A>(select: (all: readonly LibraryRow[], snapshot: ReadableTrash) => { readonly value: A; readonly plan: LibraryPlan } | LibraryRefusal): A!VolumeRefused {
      const result: { pending?: { readonly value: A } } = {}
      try commit((all) => {
        const snapshot = readTrashJournal(all)
        if (snapshot.kind === "JournalUnreadable") return "LibraryTrashUnreadable"
        const planned = select(all, snapshot)
        if (typeof planned === "string") return planned
        result.pending = planned
        return planned.plan
      })
      if (result.pending === undefined) throw refused("unavailable", "Trash did not commit.")
      return result.pending.value
    }

    effect function folder(path: string, create = false): string!VolumeRefused {
      const valid = validPath(path, true)
      if (valid === undefined) throw refused("invalid", "Invalid folder")
      let id = LIBRARY_ROOT
      for (const part of valid === "" ? [] : valid.split("/")) {
        const all = try rows()
        let found = childrenOf(all, id).find((row) => row.name === part)
        if (found === undefined && create) {
          try commit(insertPlan({ id: try allocateId, parentId: id, name: part, mimeType: "", directory: true, size: 0 }, try now))
          found = childrenOf(try rows(), id).find((row) => row.name === part)
        }
        if (found?.directory !== true) throw refused("missing", "The folder is not there")
        id = found.id
      }
      return id
    }

    const token = (row: LibraryRow) => promise(() => identityToken(row.id, row.revision))
    effect function freeIn(folderId: string, name: string, directory: boolean): string!VolumeRefused { return try freeNameIn(try rows(), folderId, name, directory) }

    effect function copyInto(row: LibraryRow, folderId: string, name: string): void!VolumeRefused {
      const id = try allocateId
      try commit(insertPlan({ id, parentId: folderId, name, mimeType: row.mimeType, directory: row.directory, size: row.size,
        ...(row.bytes === undefined ? {} : { bytes: row.bytes }) }, try now))
      if (row.directory) for (const child of childrenOf(try rows(), row.id)) try copyInto(child, id, child.name)
    }

    effect function transferRow(op: FilesOp, raw: string, reviewed: string | undefined, dest: string, destId: string): RowOutcome!VolumeRefused {
      const { path, row, admission } = try checkRow(try rows(), op, raw, reviewed, dest)
      if (admission === "Unchanged") return { path, status: "unchanged", to: path }
      if (admission !== "Admitted" || row === undefined) return { path: raw, status: ANSWERS[admission] }
      const name = (freeIn(destId, row.name, row.directory) catch () => undefined)
      if (name === undefined) return { path, status: "failed" }
      const written = op === "Copy" ? try succeeded(copyInto(row, destId, name))
        : try succeeded(commit(placePlan({ id: row.id, expectedRevision: row.revision, destinationId: destId, name }, try now)))
      return written ? { path, status: op === "Copy" ? "copied" : "moved", to: joinPath(dest, name) } : { path, status: "failed" }
    }

    return {
      effect state() {
        const estimate = (tryPromise(() => storageEstimate()) catch () => undefined)
        const all = (rows() catch () => [] as readonly LibraryRow[])
        const kept = all.filter((row) => !row.directory)
        return { access: "granted" as const, volumes: [{ id: "primary", name: "Internal storage", primary: true, free: estimate?.free ?? 0, total: estimate?.total ?? 0,
          ...(estimate === undefined ? { usage: { bytes: kept.reduce((sum, row) => sum + (row.bytes?.byteLength ?? row.size), 0), files: kept.length } } : {}) }] }
      },
      effect requestAccess() { return "granted" as const },
      effect list(path) {
        const at = visiblePath(path, true)
        if (at === undefined) throw refused("invalid", "Invalid folder")
        const all = try rows()
        const id = folderIdAt(all, at)
        if (id === undefined) throw refused("missing", "The folder is not there")
        return listing(visible(all, id).map((row) => entryOf(all, joinPath(at, row.name), row)), { metadataKnown: true, partial: false, failed: false })
      },
      effect category(category) {
        if (category === "downloads") {
          const all = try rows()
          const id = folderIdAt(all, DOWNLOAD_FOLDER)
          if (id === undefined) return { ...downloadsListing("DownloadFolderAbsent", [], { metadataKnown: false, partial: false }), count: 0 }
          const found = visible(all, id).map((row) => entryOf(all, joinPath(DOWNLOAD_FOLDER, row.name), row))
          return { ...downloadsListing("DownloadFolderListed", found, { metadataKnown: true, partial: false }), count: found.length }
        }
        const { found, partial } = try walkRows(try rows(), "", (entry) => inCategory(category, entry))
        const sorted = [...found].sort((a, b) => b.modified - a.modified)
        return { ...listing(sorted, { metadataKnown: true, partial, failed: false }), count: sorted.length }
      },
      effect query(filter) {
        const folder = visiblePath(filter.folder ?? "", true)
        if (folder === undefined) throw refused("invalid", "Invalid folder")
        const { found, partial } = try walkRows(try rows(), folder, (entry) => filterMatches(filter, entry))
        return listing(found, { metadataKnown: true, partial, failed: false })
      },
      effect reviewedIdentities(selected) {
        try checkSelection(selected, undefined)
        const all = try rows()
        const tokens: string[] = []
        for (const raw of selected) {
          const path = visiblePath(raw)
          const row = path === undefined ? undefined : rowAt(all, path)
          if (row === undefined) throw refused("missing", "A selected file is not there")
          tokens.push(try token(row))
        }
        return tokens
      },
      effect transfer({ paths: selected, dest, copy, reviewed }) {
        try checkSelection(selected, reviewed)
        const target = visiblePath(dest, true)
        if (target === undefined) throw refused("invalid", "Invalid folder")
        const destId = try folder(target)
        const outcomes: RowOutcome[] = []
        for (const [index, path] of selected.entries()) outcomes.push(try transferRow(copy ? "Copy" : "Move", path, reviewed?.[index], target, destId))
        return outcomes
      },
      trash: ({ paths: selected, reviewed }) => namespace(effect {
        try checkSelection(selected, reviewed)
        const at = try now
        const prepared: ({ readonly outcome: RowOutcome } | { readonly path: string; readonly row: LibraryRow; readonly bytes: Uint8Array<ArrayBuffer> })[] = []
        const observed = try rows()
        for (const [index, raw] of selected.entries()) {
          const { path, row, facts, admission } = try checkRow(observed, "Trash", raw, reviewed?.[index], "")
          if (admission !== "Admitted" || row === undefined) prepared.push({ outcome: { path: raw, status: ANSWERS[admission] } })
          else {
            const journal = try orDie(apply(fresh, { type: "journal", op: "Trash", row: facts, at }))
            const saved = try orDie(apply(journal, { type: "moveToTrash", acknowledged: true }))
            const record = { name: row.name, origin: path, directory: row.directory, size: row.directory ? 0 : row.size, mimeType: row.directory ? "" : row.mimeType, row: saved }
            prepared.push({ path, row, bytes: new TextEncoder().encode(JSON.stringify(record)) })
          }
        }
        return try commitTrash((all, snapshot) => {
          const outcomes: RowOutcome[] = []
          const working = new Map(all.map((row) => [row.id, row]))
          const put = new Map<string, LibraryRow>()
          const remove = new Set<string>()
          for (const candidate of prepared) {
            if ("outcome" in candidate) {
              outcomes.push(candidate.outcome)
              continue
            }
            const { path, row, bytes } = candidate
            const current = rowAt([...working.values()], path)
            if (current?.id !== row.id || current.revision !== row.revision) {
              outcomes.push({ path, status: "failed" })
              continue
            }
            const trash = snapshot.kind === "JournalReadable" ? { id: snapshot.folder.id, put: [] }
              : folderPlan([...working.values()], TRASH, at)
            if (trash === undefined) return "LibraryTrashUnreadable"
            const state = [...working.values(), ...trash.put]
            const id = newId()
            const moved = placePlan({ id: row.id, expectedRevision: row.revision, destinationId: trash.id, name: id }, at)(state)
            const journal = insertPlan({ id: newId(), parentId: trash.id, name: `${id}.json`, mimeType: "application/json", directory: false,
              size: bytes.byteLength, bytes }, at)(state)
            if (typeof moved === "string" || typeof journal === "string") {
              outcomes.push({ path, status: "failed" })
              continue
            }
            stageRows(working, { put: [...trash.put, ...moved.put, ...journal.put], remove: [] }, put, remove)
            outcomes.push({ path, status: "trashed", to: id })
          }
          return { value: outcomes, plan: { put: [...put.values()], remove: [...remove] } }
        })
      }),
      trashList: () => namespace(effect {
        const at = try now
        return try commitTrash((all, snapshot) => {
          const items: TrashEntry[] = []
          const expired: LibraryRow[] = []
          if (snapshot.kind === "JournalReadable") for (const [id, { metadata, record, data }] of snapshot.records) {
            if (data === undefined) {
              if (record.row.phase === "Expiring") expired.push(metadata)
            } else if (canPrune(record.row, at)) expired.push(metadata, data)
            else if (listed(record.row, at)) items.push({ id, name: record.name, origin: record.origin, directory: record.directory, mimeType: record.mimeType, size: record.size, deletedAt: record.row.deletedAt })
          }
          const plan = removeTrashPlan(all, expired)
          return typeof plan === "string" ? plan : { value: items.sort((a, b) => b.deletedAt - a.deletedAt), plan }
        })
      }),
      restore: (ids) => namespace(effect {
        const at = try now
        return try commitTrash((all, snapshot) => {
          const outcomes: RowOutcome[] = []
          const working = new Map(all.map((row) => [row.id, row]))
          const put = new Map<string, LibraryRow>()
          const remove = new Set<string>()
          for (const id of ids) {
            const entry = snapshot.kind === "JournalReadable" ? snapshot.records.get(id) : undefined
            if (entry?.data === undefined || remove.has(entry.metadata.id)) {
              outcomes.push({ path: id, status: "missing" })
              continue
            }
            const { data, record, metadata } = entry
            const state = [...working.values()]
            const wanted = visiblePath(parentOf(record.origin), true) ?? ""
            const destination = folderPlan(state, wanted, at)
            const destinationId = destination?.id ?? LIBRARY_ROOT
            const into = destination === undefined ? "" : wanted
            const name = validName(record.name) === undefined ? undefined
              : freeName(record.name, childrenOf(state, destinationId).map((row) => row.name), record.directory)
            const moved = name === undefined ? "LibraryNameTaken"
              : placePlan({ id: data.id, expectedRevision: data.revision, destinationId, name }, at)([...state, ...(destination?.put ?? [])])
            if (typeof moved === "string" || name === undefined) {
              outcomes.push({ path: id, status: "failed" })
              continue
            }
            const erased = removeTrashPlan(state, [metadata])
            if (typeof erased === "string") return erased
            stageRows(working, { put: [...(destination?.put ?? []), ...moved.put], remove: erased.remove }, put, remove)
            outcomes.push({ path: id, status: "restored", to: joinPath(into, name) })
          }
          return { value: outcomes, plan: { put: [...put.values()], remove: [...remove] } }
        })
      }),
      emptyTrash: (ids, confirmed) => namespace(effect {
        if (!confirmed) throw refused("confirmation-required", "Confirm before deleting permanently.")
        if (ids.length < 1 || ids.length > batchMax || new Set(ids).size !== ids.length) throw refused("invalid", "Invalid name or path.")
        return try commitTrash((all, snapshot) => {
          const selected: LibraryRow[] = []
          let count = 0
          if (snapshot.kind === "JournalReadable") for (const id of ids) {
            const record = snapshot.records.get(id)
            if (record?.data === undefined) continue
            selected.push(record.data, record.metadata)
            count++
          }
          const plan = removeTrashPlan(all, selected)
          return typeof plan === "string" ? plan : { value: count, plan }
        })
      }),
      effect createFolder(parent, folderName) {
        const at = visiblePath(parent, true)
        const valid = validName(folderName)
        if (at === undefined || valid === undefined || valid.startsWith(".")) throw refused("invalid", "Invalid name")
        const id = try folder(at, at === DOWNLOAD_FOLDER)
        const name = try freeIn(id, valid, true)
        try commit(insertPlan({ id: try allocateId, parentId: id, name, mimeType: "", directory: true, size: 0 }, try now))
        return joinPath(at, name)
      },
      effect rename(path, newName) {
        const from = visiblePath(path)
        const valid = validName(newName)
        if (from === undefined || valid === undefined || valid.startsWith(".")) throw refused("invalid", "Invalid name")
        const all = try rows()
        const row = rowAt(all, from)
        if (row === undefined) throw refused("missing", "The file is not there")
        if (valid === row.name) return from
        if (nameClash(all, row, valid)) throw refused("exists", "A file with that name is already there")
        try commit(placePlan({ id: row.id, expectedRevision: row.revision, destinationId: row.parentId, name: valid }, try now))
        return joinPath(parentOf(from), valid)
      },
      effect share(selected) {
        if (selected.length === 0) throw refused("unsupported", "Select files to share.")
        const archive = try archiveOf(try rows(), selected)
        const handed = try promise(() => shareFile(archiveName, archive))
        if (handed === "opened") return 1
        throw handed === "cancelled" ? refused("cancelled", "Sharing was cancelled.") : refused("unsupported", "Sharing is unavailable in this browser.")
      },
      open: () => fail(refused("unsupported", "Open a selected file to view it.")),
    } satisfies FilesVolume.Shape
  })
}

export effect function importLibraryFile(folderPath: string, file: { readonly name: string; readonly mimeType: string; readonly bytes: Uint8Array<ArrayBuffer> }) {
  const library = try LibraryStore
  const name = validName(file.name)
  const at = visiblePath(folderPath, true)
  if (name === undefined || at === undefined) throw refused("invalid", "Choose a valid file name.")
  const all = try mapError(library.rows(), (failure) => refused("unavailable", failure.message))
  const folderId = folderIdAt(all, at)
  if (folderId === undefined) throw refused("missing", "Choose a folder.")
  try mapError(library.commit(insertPlan({ id: try allocateId, parentId: folderId, name, mimeType: file.mimeType || "application/octet-stream", directory: false,
    size: file.bytes.byteLength, bytes: file.bytes }, try Clock.currentTimeMillis)), (failure) => refused(failure._tag === "LibraryRefused" ? "exists" : "unavailable", failure.message))
  return joinPath(at, name)
}

export type SelectedText =
  | { readonly kind: "read"; readonly text: string; readonly mimeType: string; readonly bytes: number }
  | { readonly kind: "large" }
  | { readonly kind: "binary"; readonly mimeType: string; readonly bytes: number }

export type SelectedFile = { readonly selectionId: string; readonly name: string; readonly mimeType: string; readonly size: number }
type SelectionBinding = { readonly id: string; readonly revision: string }

const TEXT_TYPES = ["application/json", "application/xml", "application/javascript"]

export effect function librarySelections() {
  const library = try LibraryStore
  const bound = try Ref.make(new Map<string, SelectionBinding>())

  effect function bind(row: LibraryRow | undefined): SelectedFile!VolumeRefused {
    if (row === undefined || row.directory || row.bytes === undefined) throw refused("missing", "Choose a file.")
    const selectionId = try allocateId
    try Ref.update(bound, (map) => new Map(map).set(selectionId, { id: row.id, revision: row.revision }))
    return { selectionId, name: row.name, mimeType: row.mimeType, size: row.size }
  }

  effect function capture(selectionId: string): SelectionBinding!VolumeRefused {
    const binding = (try Ref.get(bound)).get(selectionId)
    if (binding === undefined) throw refused("changed", "Select this file again.")
    return binding
  }

  effect function current(selectionId: string, binding: SelectionBinding, limit: number): (LibraryRow & { readonly bytes: Uint8Array<ArrayBuffer> })!VolumeRefused {
    const all = try mapError(library.rows(), (failure) => refused("unavailable", failure.message))
    const row = all.find((candidate) => candidate.id === binding.id)
    const bindingMatches = (try Ref.get(bound)).get(selectionId) === binding
    const readable = selectionReadable({ present: row?.bytes !== undefined, bindingMatches, revisionMatches: row?.revision === binding.revision, bytes: row?.bytes?.byteLength ?? 0, limit })
    if (row?.bytes === undefined || !bindingMatches || row.revision !== binding.revision) throw refused("changed", "Select this file again.")
    if (!readable) throw refused("invalid", limit === chatLimit ? "Choose a file up to 20 MiB." : "Choose a file up to 5 MiB.")
    return { ...row, bytes: row.bytes }
  }

  return {
    effect select(path: string): SelectedFile!VolumeRefused {
      const at = visiblePath(path)
      const all = try mapError(library.rows(), (failure) => refused("unavailable", failure.message))
      return try bind(at === undefined ? undefined : rowAt(all, at))
    },
    effect selectId(id: string): SelectedFile!VolumeRefused {
      const all = try mapError(library.rows(), (failure) => refused("unavailable", failure.message))
      const byId = new Map(all.map((row) => [row.id, row]))
      const source = byId.get(id)
      let row = source
      for (let depth = 0; row !== undefined && depth < all.length; depth++) {
        if (row.name.startsWith(".")) break
        if (row.parentId === LIBRARY_ROOT) return try bind(source)
        row = byId.get(row.parentId)
      }
      throw refused("missing", "Choose a file.")
    },
    effect readText(selectionId: string): SelectedText!VolumeRefused {
      const binding = try capture(selectionId)
      const row = try current(selectionId, binding, Number.MAX_SAFE_INTEGER)
      const large = row.bytes.byteLength > textLimit
      const textual = row.mimeType.startsWith("text/") || TEXT_TYPES.includes(row.mimeType)
      const text = !large && textual ? decodeUtf8(row.bytes) : undefined
      try current(selectionId, binding, Number.MAX_SAFE_INTEGER)
      if (large) return { kind: "large" }
      if (text === undefined || text.includes("\0")) return { kind: "binary", mimeType: row.mimeType, bytes: row.size }
      return { kind: "read", text, mimeType: row.mimeType, bytes: row.size }
    },
    effect attachment(selectionId: string, purpose: "mail" | "chat" = "mail") {
      if (purpose !== "mail" && purpose !== "chat") throw refused("invalid", "Unknown attachment purpose.")
      const limit = purpose === "chat" ? chatLimit : mailLimit
      const binding = try capture(selectionId)
      const row = try current(selectionId, binding, limit)
      const dataBase64 = base64(row.bytes)
      try current(selectionId, binding, limit)
      return { name: row.name, mimeType: row.mimeType, dataBase64 }
    },
    effect rename(selectionId: string, newName: string): SelectedFile!VolumeRefused {
      const binding = try capture(selectionId)
      const row = try current(selectionId, binding, Number.MAX_SAFE_INTEGER)
      const valid = validName(newName)
      if (valid === undefined || valid.startsWith(".")) throw refused("invalid", "Invalid name")
      const change = placePlan({ id: row.id, expectedRevision: row.revision, destinationId: row.parentId, name: valid }, try Clock.currentTimeMillis)
      const committed: { row?: LibraryRow } = {}
      try mapError(library.commit((rows) => {
        const plan = change(rows)
        if (typeof plan === "string") return plan
        if (nameClash(rows, row, valid)) return "LibraryNameTaken"
        committed.row = plan.put[0]
        return plan
      }),
        (failure) => failure._tag === "LibraryRefused" ? refused(failure.answer === "LibraryNameTaken" ? "exists" : "changed", failure.message) : refused("unavailable", failure.message))
      const renamed = committed.row
      if (renamed === undefined) throw refused("changed", "Select this file again.")
      const renewed = try Ref.modify(bound, (map): [boolean, Map<string, SelectionBinding>] => map.get(selectionId) === binding
        ? [true, new Map(map).set(selectionId, { id: renamed.id, revision: renamed.revision })]
        : [false, map])
      if (!renewed) throw refused("changed", "Select this file again.")
      return { selectionId, name: renamed.name, mimeType: renamed.mimeType, size: renamed.size }
    },
    effect bytes(selectionId: string) {
      const binding = try capture(selectionId)
      const row = try current(selectionId, binding, Number.MAX_SAFE_INTEGER)
      const blob = try Effect.try({ try: () => fileBlob(row.bytes, row.mimeType), catch: () => refused("unavailable", "The file could not be opened.") })
      try current(selectionId, binding, Number.MAX_SAFE_INTEGER)
      return { name: row.name, mimeType: row.mimeType, blob }
    },
    forget: (selectionId: string) => Ref.update(bound, (map) => {
      const next = new Map(map)
      next.delete(selectionId)
      return next
    }),
  }
}
