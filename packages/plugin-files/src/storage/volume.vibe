// spec/files/reviewedOperations.md, "The mutation re-reads each selected row and reports each outcome"; spec/files/requests.md, "An empty or complete claim needs a full, known listing"; spec/os/android/files/storage.md, "A row answers copied, moved or trashed only for an admitted row whose own write was acknowledged"
import { filesClient, type ElizaFilesPlugin, type FileOutcomeRow, type FilesResult } from "@elizaos/os/bridges/files"
import { nativeAcknowledged, receiptOutcome, type FilesOp, type WriteResult } from "../../gen/os__android__files__storage.effect.vibe"
import { filterMatches, filterTime, listing, type CategoryFolder, type FilesCategory, type FilesFilter, type Listing, type StorageVolume, type TrashEntry } from "./model.vibe"

/** One row's answer; `unknown` is a row whose write may have happened and is never repeated on its own. */
export type RowStatus = "copied" | "moved" | "unchanged" | "trashed" | "restored" | "changed" | "missing" | "invalid" | "failed" | "unknown"
export type RowOutcome = { readonly path: string; readonly status: RowStatus; readonly to?: string }
export type VolumeRefusal = "cancelled" | "denied" | "unavailable" | "invalid" | "exists" | "missing" | "failed" | "changed" | "superseded" | "unsupported" | "confirmation-required"
export type CategoryListing = Listing & { readonly count?: number; readonly folders?: readonly CategoryFolder[] }
export type StorageAccess = { readonly access: "granted" | "denied" | "unsupported"; readonly legacy?: boolean; readonly volumes: readonly StorageVolume[] }

export error VolumeRefused { status: VolumeRefusal; message: string }

/** One mounted volume of the owner's files, every change answered row by row. */
export service FilesVolume {
  state(): StorageAccess!VolumeRefused
  requestAccess(settings: boolean): StorageAccess["access"]!VolumeRefused
  list(path: string): Listing!VolumeRefused
  category(category: FilesCategory): CategoryListing!VolumeRefused
  query(filter: FilesFilter): Listing!VolumeRefused
  reviewedIdentities(paths: readonly string[]): readonly string[]!VolumeRefused
  transfer(input: { readonly paths: readonly string[]; readonly dest: string; readonly copy: boolean; readonly reviewed?: readonly string[] }): readonly RowOutcome[]!VolumeRefused
  trash(input: { readonly paths: readonly string[]; readonly reviewed?: readonly string[] }): readonly RowOutcome[]!VolumeRefused
  trashList(): readonly TrashEntry[]!VolumeRefused
  restore(ids: readonly string[]): readonly RowOutcome[]!VolumeRefused
  emptyTrash(ids: readonly string[], confirmed: boolean): number!VolumeRefused
  createFolder(parent: string, name: string): string!VolumeRefused
  rename(path: string, name: string): string!VolumeRefused
  share(paths: readonly string[]): number!VolumeRefused
  open(path: string): number!VolumeRefused
}

const WRITTEN: Readonly<Partial<Record<RowStatus, WriteResult>>> = { copied: "WriteCopied", moved: "WriteMoved", trashed: "WriteMoved", restored: "WriteMoved" }
const OPS: Readonly<Partial<Record<RowStatus, FilesOp>>> = { copied: "Copy", moved: "Move", trashed: "Trash", restored: "Move" }

/** One outcome per requested path in request order: a row the device did not answer is unknown, and an applied row without its receipt failed. */
export function settleRows(requested: readonly string[], rows: readonly { readonly path: string; readonly status: string; readonly to?: string }[] | undefined): RowOutcome[] {
  return requested.map((path) => {
    const row = rows?.find((candidate) => candidate.path === path)
    if (row === undefined) return { path, status: "unknown" }
    const status = row.status as RowStatus
    const write = WRITTEN[status]
    const op = OPS[status]
    if (write === undefined || op === undefined) return { path, status }
    const answer = receiptOutcome(op, "Admitted", nativeAcknowledged(op, write), row.to ?? "")
    return answer === "Failed" || row.to === undefined ? { path, status: "failed" } : { path, status, to: row.to }
  })
}

function refusal(result: FilesResult): VolumeRefused {
  const status = result.status === "ready" ? "failed" : result.status
  return new VolumeRefused({ status, message: result.message ?? status })
}

effect function read<R extends FilesResult>(call: () => Promise<R>): R!VolumeRefused {
  const result = try tryPromise({ try: call, catch: () => new VolumeRefused({ status: "unavailable", message: "Files storage is not available" }) })
  if (result.status !== "ready") throw refusal(result)
  return result
}

effect function written(requested: readonly string[], call: () => Promise<FilesResult & { readonly outcomes?: readonly FileOutcomeRow[] }>): readonly RowOutcome[]!VolumeRefused {
  const result = (tryPromise(call) catch () => undefined)
  if (result === undefined) return settleRows(requested, undefined)
  if (result.status !== "ready" && result.outcomes === undefined) throw refusal(result)
  return settleRows(requested, result.outcomes)
}

effect function handedOff(call: () => Promise<{ readonly status: string; readonly count?: number; readonly message?: string }>): number!VolumeRefused {
  const result = try tryPromise({ try: call, catch: () => new VolumeRefused({ status: "unavailable", message: "Files storage is not available" }) })
  if (result.status === "opened" && result.count !== undefined) return result.count
  throw refusal({ status: result.status === "opened" ? "failed" : result.status as FilesResult["status"], message: result.message })
}

function filterQuery(filter: FilesFilter) {
  return {
    ...(filter.text === undefined ? {} : { text: filter.text }),
    ...(filter.kind === "image" ? { mimePrefix: "image/" } : filter.kind === "video" ? { mimePrefix: "video/" } : filter.kind === "audio" ? { mimePrefix: "audio/" }
      : filter.kind === "pdf" ? { mimePrefix: "application/pdf" } : filter.kind === "document" ? { documents: true } : filter.kind === "folder" ? { folders: true } : {}),
    ...(filter.folder === undefined ? {} : { folder: filter.folder }),
    ...(filter.from === undefined ? {} : { from: filterTime(filter.from) }),
    ...(filter.to === undefined ? {} : { to: filterTime(filter.to, true) }),
  }
}

/** The owner's shared storage through the device's files bridge. */
export function nativeVolume(plugin: ElizaFilesPlugin = filesClient()) {
  return Layer.succeed(FilesVolume, {
    effect state() {
      const result = try read(() => plugin.storageState())
      return { access: result.access ?? "granted", ...(result.legacy === undefined ? {} : { legacy: result.legacy }), volumes: result.volumes ?? [] }
    },
    effect requestAccess(settings) {
      const result = try tryPromise({ try: () => plugin.storageRequestAccess({ settings }), catch: () => new VolumeRefused({ status: "unavailable", message: "Files storage is not available" }) })
      return result.access ?? (result.status === "ready" ? "granted" : "denied")
    },
    effect list(path) {
      const result = try read(() => plugin.storageList({ path }))
      return listing(result.entries ?? [], { metadataKnown: result.entries !== undefined, partial: result.truncated === true, failed: false })
    },
    effect category(category) {
      const result = try read(() => plugin.storageCategory({ category }))
      return {
        ...listing(result.entries ?? [], { metadataKnown: result.entries !== undefined, partial: result.truncated === true, failed: false }),
        ...(result.count === undefined ? {} : { count: result.count }),
        ...(result.folders === undefined ? {} : { folders: result.folders }),
      }
    },
    effect query(filter) {
      const result = try read(() => plugin.storageQuery(filterQuery(filter)))
      const partial = "truncated" in result && result.truncated === true
      return listing((result.entries ?? []).filter((entry) => filterMatches(filter, entry)), { metadataKnown: result.entries !== undefined, partial, failed: false })
    },
    effect reviewedIdentities(paths) {
      const result = try read(() => plugin.storageReviewedIdentities({ paths }))
      if (result.reviewed === undefined || result.reviewed.length !== paths.length) throw new VolumeRefused({ status: "changed", message: "Files could not read every reviewed file" })
      return result.reviewed
    },
    transfer: (input) => written(input.paths, () => plugin.storageTransfer(input)),
    trash: (input) => written(input.paths, () => plugin.storageTrash(input)),
    effect trashList() {
      return (try read(() => plugin.storageTrashList())).items ?? []
    },
    restore: (ids) => written(ids, () => plugin.storageRestore({ ids })),
    effect emptyTrash(ids, confirmed) {
      if (!confirmed) throw new VolumeRefused({ status: "confirmation-required", message: "Confirm before deleting permanently." })
      return (try read(() => plugin.storageEmptyTrash({ ids, confirmed }))).count ?? 0
    },
    effect createFolder(parent, name) {
      const result = try read(() => plugin.storageCreateFolder({ parent, name }))
      if (result.path === undefined) throw new VolumeRefused({ status: "failed", message: "The folder was not created" })
      return result.path
    },
    effect rename(path, name) {
      const result = try read(() => plugin.storageRename({ path, name }))
      if (result.path === undefined) throw new VolumeRefused({ status: "failed", message: "The file was not renamed" })
      return result.path
    },
    share: (paths) => handedOff(() => plugin.storageShare({ paths })),
    open: (path) => handedOff(() => plugin.storageOpen({ path })),
  })
}
