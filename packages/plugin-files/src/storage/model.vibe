// spec/files/requests.md, "An empty or complete claim needs a full, known listing"; spec/files/requests.md, "Downloads is the Download folder with its folders, and a missing one is empty"; spec/files/reviewedOperations.md, "Trash owns a journal entry before moving the row"; spec/files/reviewedOperations.md, "The mutation re-reads each selected row and reports each outcome"; spec/files/reviewedOperations.md, "A trash record that cannot be read is listed as unreadable, refuses only its own restore, and can be emptied"
import { expiryMillis } from "../../gen/files__reviewedOperations.effect.vibe"
import { downloadsKnown, listingComplete, listingEmpty, type DownloadFolder } from "../../gen/files__requests.effect.vibe"

export type StorageEntry = {
  readonly path: string
  readonly name: string
  readonly directory: boolean
  readonly mimeType: string
  readonly size: number
  readonly modified: number
  readonly children?: number
}
export type TrashEntry = {
  readonly id: string
  readonly name: string
  readonly origin: string
  readonly directory: boolean
  readonly mimeType: string
  readonly size: number
  readonly deletedAt: number
  readonly unreadable?: true
}
export function unreadableTrashEntry(id: string): TrashEntry {
  return { id, name: id, origin: "", directory: false, mimeType: "", size: 0, deletedAt: 0, unreadable: true }
}
export type StorageVolume = {
  readonly id: string
  readonly name: string
  readonly primary: boolean
  readonly free: number
  readonly total: number
  readonly usage?: { readonly bytes: number; readonly files: number }
}
export type FilesCategory = "downloads" | "images" | "videos" | "audio" | "documents"
export type SortMode = "name" | "date" | "size"
export type CategoryFolder = { readonly folder: string; readonly count: number; readonly latest: StorageEntry }

export type Listing = {
  readonly entries: readonly StorageEntry[]
  readonly complete: boolean
  readonly empty: boolean
}

const DAY = 86_400_000
export const TRASH_RETENTION_DAYS = expiryMillis / DAY
export const DOWNLOAD_FOLDER = "Download"
export const CATEGORIES: readonly { readonly id: FilesCategory; readonly label: string }[] = [
  { id: "downloads", label: "Downloads" },
  { id: "images", label: "Images" },
  { id: "videos", label: "Videos" },
  { id: "audio", label: "Audio" },
  { id: "documents", label: "Documents" },
]
export const DOCUMENT_MIME_TYPES: readonly string[] = [
  "application/pdf", "application/msword", "application/rtf", "text/plain", "text/csv", "text/markdown",
  "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.ms-excel",
  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.ms-powerpoint",
  "application/vnd.openxmlformats-officedocument.presentationml.presentation", "application/vnd.oasis.opendocument.text",
  "application/vnd.oasis.opendocument.spreadsheet", "application/vnd.oasis.opendocument.presentation",
]
const EXTENSIONS: Readonly<Record<string, string>> = {
  pdf: "application/pdf", doc: "application/msword", docx: DOCUMENT_MIME_TYPES[6], xls: "application/vnd.ms-excel",
  xlsx: DOCUMENT_MIME_TYPES[8], ppt: "application/vnd.ms-powerpoint", pptx: DOCUMENT_MIME_TYPES[10],
  odt: DOCUMENT_MIME_TYPES[11], ods: DOCUMENT_MIME_TYPES[12], odp: DOCUMENT_MIME_TYPES[13], rtf: "application/rtf",
  txt: "text/plain", csv: "text/csv", md: "text/markdown", jpg: "image/jpeg", jpeg: "image/jpeg", png: "image/png",
  gif: "image/gif", webp: "image/webp", heic: "image/heic", heif: "image/heif", mp4: "video/mp4", m4v: "video/mp4",
  webm: "video/webm", mov: "video/quicktime", "3gp": "video/3gpp", mkv: "video/x-matroska", mp3: "audio/mpeg",
  m4a: "audio/mp4", aac: "audio/aac", ogg: "audio/ogg", opus: "audio/ogg", wav: "audio/wav", flac: "audio/flac",
  amr: "audio/amr", zip: "application/zip", apk: "application/vnd.android.package-archive",
}

export function mimeFromName(name: string): string {
  const dot = name.lastIndexOf(".")
  return dot > 0 ? EXTENSIONS[name.slice(dot + 1).toLowerCase()] ?? "application/octet-stream" : "application/octet-stream"
}

export function parentOf(path: string): string {
  const slash = path.lastIndexOf("/")
  return slash < 0 ? "" : path.slice(0, slash)
}

export function baseName(path: string): string {
  return path.slice(path.lastIndexOf("/") + 1)
}

export function joinPath(folder: string, name: string): string {
  return folder === "" ? name : `${folder}/${name}`
}

export function within(path: string, folder: string): boolean {
  return folder === "" || path === folder || path.startsWith(`${folder}/`)
}

export function inCategory(category: FilesCategory, entry: Pick<StorageEntry, "path" | "directory" | "mimeType">): boolean {
  if (category === "downloads") return parentOf(entry.path) === DOWNLOAD_FOLDER
  if (entry.directory) return false
  switch (category) {
    case "images": return entry.mimeType.startsWith("image/")
    case "videos": return entry.mimeType.startsWith("video/")
    case "audio": return entry.mimeType.startsWith("audio/")
    case "documents": return DOCUMENT_MIME_TYPES.includes(entry.mimeType)
  }
}

export function groupByFolder(entries: readonly StorageEntry[], counted?: readonly CategoryFolder[]) {
  const groups = new Map<string, { count: number; latest: StorageEntry }>()
  for (const group of counted ?? []) groups.set(group.folder, { count: group.count, latest: group.latest })
  if (counted === undefined) {
    for (const entry of entries) {
      const key = parentOf(entry.path)
      const group = groups.get(key)
      if (group === undefined) groups.set(key, { count: 1, latest: entry })
      else groups.set(key, { count: group.count + 1, latest: entry.modified > group.latest.modified ? entry : group.latest })
    }
  }
  return [...groups].map(([folder, { count, latest }]) => ({ folder, name: folder === "" ? "Internal storage" : baseName(folder), count, latest }))
    .sort((a, b) => b.latest.modified - a.latest.modified || a.folder.localeCompare(b.folder))
}

// eslint-disable-next-line no-control-regex -- File names reject path separators, C0 controls, and DEL.
const invalidNameCharacter = /[/\\\u0000-\u001f\u007f]/
// eslint-disable-next-line no-control-regex -- File filter text excludes exactly the C0 control range.
const filterControlCharacter = /[\u0000-\u001f]/

export function validName(value: unknown): string | undefined {
  if (typeof value !== "string") return undefined
  const name = value.trim()
  return name !== "" && name.length <= 255 && name !== "." && name !== ".." && !invalidNameCharacter.test(name) ? name : undefined
}

export function validPath(value: unknown, allowRoot = false): string | undefined {
  if (typeof value !== "string" || value.length > 1024) return undefined
  const path = value.replace(/^\/+|\/+$/g, "")
  if (path === "") return allowRoot ? "" : undefined
  return path.split("/").every((part) => validName(part) === part) ? path : undefined
}

export function freeName(name: string, taken: Iterable<string>, directory = false): string | undefined {
  const used = new Set(Array.from(taken, (value) => value.toLowerCase()))
  if (!used.has(name.toLowerCase())) return name
  const dot = directory ? -1 : name.lastIndexOf(".")
  const stem = (dot > 0 ? name.slice(0, dot) : name).replace(/ \(\d+\)$/, "")
  const extension = dot > 0 ? name.slice(dot) : ""
  for (let n = 1; n < 10_000; n++) {
    const candidate = `${stem} (${n})${extension}`
    if (!used.has(candidate.toLowerCase())) return candidate
  }
  return undefined
}

export function sortEntries<T extends Pick<StorageEntry, "name" | "directory" | "modified" | "size">>(entries: readonly T[], mode: SortMode, reverse = false): T[] {
  const byName = (a: T, b: T) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: "base" })
  const order = (a: T, b: T) => a.directory && b.directory ? byName(a, b)
    : mode === "date" ? b.modified - a.modified || byName(a, b)
    : mode === "size" ? b.size - a.size || byName(a, b)
    : byName(a, b)
  return [...entries].sort((a, b) => Number(b.directory) - Number(a.directory) || (reverse ? -1 : 1) * order(a, b))
}

export const SORT_LABELS: Readonly<Record<SortMode, string>> = { name: "Name", date: "Date", size: "Size" }

export function breadcrumbs(path: string, rootLabel = "Internal storage"): { label: string; path: string }[] {
  const parts = path === "" ? [] : path.split("/")
  return [{ label: rootLabel, path: "" }, ...parts.map((label, index) => ({ label, path: parts.slice(0, index + 1).join("/") }))]
}

export function trashDaysLeft(deletedAt: number, now: number): number {
  return Math.max(0, Math.ceil((deletedAt + expiryMillis - now) / DAY))
}

export function trashExpired(deletedAt: number, now: number): boolean {
  return now - deletedAt >= expiryMillis
}

export function formatSize(bytes: number): string {
  if (!Number.isFinite(bytes) || bytes < 0) return ""
  if (bytes < 1024) return `${bytes} B`
  const units = ["KB", "MB", "GB", "TB"]
  let value = bytes / 1024
  let unit = 0
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024
    unit++
  }
  return `${value >= 100 ? Math.round(value) : Math.round(value * 10) / 10} ${units[unit]}`
}

export function formatFree(volume: Pick<StorageVolume, "free" | "total" | "usage">): string {
  if (volume.total > 0) return `${formatSize(volume.free)} free of ${formatSize(volume.total)}`
  if (volume.usage === undefined) return ""
  return `${formatSize(volume.usage.bytes)} in ${volume.usage.files} app ${volume.usage.files === 1 ? "file" : "files"}`
}

export function listing(entries: readonly StorageEntry[], read: { readonly metadataKnown: boolean; readonly partial: boolean; readonly failed: boolean }): Listing {
  return {
    entries,
    complete: listingComplete(read.metadataKnown, read.partial, read.failed),
    empty: listingEmpty(read.metadataKnown, read.partial, read.failed, entries.length > 0),
  }
}

export function downloadsListing(folder: Exclude<DownloadFolder, "DownloadFolderUnreadable">, entries: readonly StorageEntry[], read: { readonly metadataKnown: boolean; readonly partial: boolean }): Listing {
  const listed = folder === "DownloadFolderListed"
  return listing(listed ? entries : [], { metadataKnown: downloadsKnown(folder, read.metadataKnown), partial: listed && read.partial, failed: false })
}

export const FILTER_KINDS = ["image", "video", "audio", "document", "pdf", "folder"] as const
export type FilterKind = typeof FILTER_KINDS[number]

const FilterText = Schema.String.check(Schema.isMaxLength(120), Schema.makeFilter((text: string) => text.trim() !== "" && !filterControlCharacter.test(text)))
const FilterDate = Schema.String.check(Schema.isMaxLength(40), Schema.isPattern(/^\d{4}-\d\d-\d\d(?:T[\d:.]+(?:Z|[+-]\d\d:\d\d))?$/),
  Schema.makeFilter((value: string) => Number.isFinite(Date.parse(value))))
const FilterFolder = Schema.String.check(Schema.makeFilter((value: string) => !value.startsWith("/") && validPath(value, true) !== undefined))
const FilterFields = {
  text: Schema.optionalKey(FilterText),
  kind: Schema.optionalKey(Schema.Literals(FILTER_KINDS)),
  folder: Schema.optionalKey(FilterFolder),
  from: Schema.optionalKey(FilterDate),
  to: Schema.optionalKey(FilterDate),
}
const filterChecks = Schema.makeFilter(({ text, kind, folder, from, to }: { text?: string; kind?: FilterKind; folder?: string; from?: string; to?: string }) =>
  (text !== undefined || kind !== undefined || folder !== undefined || from !== undefined || to !== undefined) &&
  (from === undefined || to === undefined || Date.parse(from) <= Date.parse(to)))
export const FilesFilter = Schema.Struct(FilterFields).check(filterChecks)
export type FilesFilter = typeof FilesFilter.Type
export const FilesFilterOperation = Schema.Struct({ type: Schema.Literal("files_filter"), ...FilterFields }).check(filterChecks)

export error FilterRefused { input: unknown }

const decodeFilter = Schema.decodeUnknownEffect(FilesFilter, { onExcessProperty: "error" })

export effect function decodeFilesFilter(input: unknown): FilesFilter!FilterRefused {
  const filter = try mapError(decodeFilter(input), () => new FilterRefused({ input }))
  return {
    ...filter,
    ...(filter.text === undefined ? {} : { text: filter.text.trim() }),
    ...(filter.folder === undefined ? {} : { folder: validPath(filter.folder, true) ?? "" }),
  }
}

export function filterTime(value: string, end = false): number {
  if (value.length !== 10) return Date.parse(value)
  const [year, month, day] = value.split("-").map(Number)
  return end ? new Date(year, month - 1, day + 1).getTime() - 1 : new Date(year, month - 1, day).getTime()
}

const words = (value: string) => value.toLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "").split(/[^a-z0-9]+/).filter((word) => word !== "")

function kindMatches(kind: FilterKind, entry: StorageEntry): boolean {
  if (kind === "folder") return entry.directory
  if (entry.directory) return false
  switch (kind) {
    case "image": return entry.mimeType.startsWith("image/")
    case "video": return entry.mimeType.startsWith("video/")
    case "audio": return entry.mimeType.startsWith("audio/")
    case "pdf": return entry.mimeType === "application/pdf"
    case "document": return DOCUMENT_MIME_TYPES.includes(entry.mimeType)
  }
}

export function filterMatches(filter: FilesFilter, entry: StorageEntry): boolean {
  if (filter.kind !== undefined && !kindMatches(filter.kind, entry)) return false
  if (filter.folder !== undefined && !within(parentOf(entry.path), filter.folder)) return false
  if (filter.from !== undefined && entry.modified < filterTime(filter.from)) return false
  if (filter.to !== undefined && entry.modified > filterTime(filter.to, true)) return false
  if (filter.text === undefined) return true
  const name = words(entry.name)
  return words(filter.text).every((word) => name.some((part) => part.startsWith(word)))
}

const KIND_LABELS: Readonly<Record<FilterKind, string>> = { image: "Images", video: "Videos", audio: "Audio", document: "Documents", pdf: "PDFs", folder: "Folders" }

export function filterLabel(filter: FilesFilter): string {
  return [
    filter.text === undefined ? "" : `“${filter.text}”`,
    filter.kind === undefined ? "" : KIND_LABELS[filter.kind],
    filter.folder === undefined ? "" : `in ${baseName(filter.folder) || "Internal storage"}`,
    filter.from === undefined && filter.to === undefined ? "" : [filter.from?.slice(0, 10), filter.to?.slice(0, 10)].filter((day) => day !== undefined).join(" – "),
  ].filter((part) => part !== "").join(" · ")
}
