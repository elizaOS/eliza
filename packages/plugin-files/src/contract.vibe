// spec/files/shownTargets.md, "Story: Name what Files shows without leaking or guessing a file"; spec/files/shownTargets.md, "Files operations need files.browser.v1, and a shown share, move or trash also needs files.shown-target.v1"; spec/files/shownTargets.md, "A move or trash binds the identity of each reviewed file, and a share binds none"
import { bindsIdentity, formAdmitted, type FilesForm, type FilesKind } from "../gen/files__shownTargets.effect.vibe"
import { baseName, filterLabel, FilesFilterOperation, validName, validPath, type FilesFilter } from "./storage/model.vibe"

/** The capability every Files operation needs. */
export const FILES_CAPABILITY = "files.browser.v1"
/** The capability a share, move or trash needs to name files by their shown positions. */
export const FILES_SHOWN_TARGET_CAPABILITY = "files.shown-target.v1"
/** Every Files operation type. */
export const FILES_OPERATION_TYPES = ["files_filter", "files_open", "files_share", "files_move", "files_trash", "files_folder_create"] as const
/** Read-only or view-only operations: they change nothing, so they need no separate review. */
export const FILES_DIRECT_TYPES: readonly FilesOperationType[] = ["files_filter", "files_open"]
/** The most files one operation names. */
export const FILES_PATHS_MAX = 50

export type FilesOperationType = typeof FILES_OPERATION_TYPES[number]
/** The opaque storage identity of a reviewed file. */
export type FilesIdentity = string

const AgentPath = Schema.String.check(Schema.makeFilter((value: string) => !value.startsWith("/") && validPath(value) !== undefined))
const AgentFolder = Schema.String.check(Schema.makeFilter((value: string) => !value.startsWith("/") && validPath(value, true) !== undefined))
const Paths = Schema.Array(AgentPath).check(Schema.isMinLength(1), Schema.isMaxLength(FILES_PATHS_MAX),
  Schema.makeFilter((paths) => new Set(paths.map((path) => validPath(path))).size === paths.length))
const Shown = Schema.Array(Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: Number.MAX_SAFE_INTEGER }))).check(Schema.isMinLength(1), Schema.isMaxLength(FILES_PATHS_MAX),
  Schema.makeFilter((shown) => new Set(shown).size === shown.length))
const Reviewed = Schema.Array(Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{43}$/)))
const FolderName = Schema.String.check(Schema.makeFilter((value: string) => { const name = validName(value); return name !== undefined && !name.startsWith(".") }))
const reviewCount = Schema.makeFilter(({ paths, reviewed }: { readonly paths: readonly string[]; readonly reviewed?: readonly string[] }) =>
  reviewed === undefined || reviewed.length === paths.length)

const Operation = Schema.Union([
  FilesFilterOperation,
  Schema.Struct({ type: Schema.Literal("files_open"), path: AgentPath }),
  Schema.Struct({ type: Schema.Literal("files_open"), shown: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: Number.MAX_SAFE_INTEGER })) }),
  Schema.Struct({ type: Schema.Literal("files_share"), paths: Paths }),
  Schema.Struct({ type: Schema.Literal("files_share"), shown: Shown }),
  Schema.Struct({ type: Schema.Literal("files_move"), paths: Paths, dest: AgentFolder, reviewed: Schema.optionalKey(Reviewed) }).check(reviewCount),
  Schema.Struct({ type: Schema.Literal("files_move"), shown: Shown, dest: AgentFolder }),
  Schema.Struct({ type: Schema.Literal("files_trash"), paths: Paths, reviewed: Schema.optionalKey(Reviewed) }).check(reviewCount),
  Schema.Struct({ type: Schema.Literal("files_trash"), shown: Shown }),
  Schema.Struct({ type: Schema.Literal("files_folder_create"), parent: AgentFolder, name: FolderName }),
])
const decodeOperation = Schema.decodeUnknownEffect(Operation, { onExcessProperty: "error" })

export type FilesAgentOperation = typeof Operation.Type
/** A share, move or trash that names shown positions instead of paths; the phone resolves them before the owner reviews the card. */
export type FilesShownOperation = Extract<FilesAgentOperation, { readonly shown: readonly number[] }>
/** Every operation but a not yet resolved shown share, move or trash. */
export type FilesPathOperation = Exclude<FilesAgentOperation, FilesShownOperation>

export error FilesOperationRefused { input: unknown; reason: string }

function normalized(op: FilesAgentOperation): FilesAgentOperation {
  const path = (value: string, root = false) => validPath(value, root) ?? value
  switch (op.type) {
    case "files_filter": return op.folder === undefined ? { ...op, ...(op.text === undefined ? {} : { text: op.text.trim() }) }
      : { ...op, folder: path(op.folder, true), ...(op.text === undefined ? {} : { text: op.text.trim() }) }
    case "files_open": return "path" in op ? { ...op, path: path(op.path) } : op
    case "files_share": return "paths" in op ? { ...op, paths: op.paths.map((item) => path(item)) } : op
    case "files_move": return "paths" in op ? { ...op, paths: op.paths.map((item) => path(item)), dest: path(op.dest, true) } : { ...op, dest: path(op.dest, true) }
    case "files_trash": return "paths" in op ? { ...op, paths: op.paths.map((item) => path(item)) } : op
    case "files_folder_create": return { ...op, parent: path(op.parent, true), name: op.name.trim() }
  }
}

/** Whether a value claims to be a Files operation; `decodeFilesOperation` says whether it is one. */
export function isFilesOperation(value: unknown): value is { readonly type: FilesOperationType } {
  return typeof value === "object" && value !== null && "type" in value && FILES_OPERATION_TYPES.some((type) => type === value.type)
}

/** A Files operation from untrusted input, with its paths normalized; a validated operation decodes again unchanged. */
export effect function decodeFilesOperation(input: unknown): FilesAgentOperation!FilesOperationRefused {
  const op = try mapError(decodeOperation(input), (issue) => new FilesOperationRefused({ input, reason: issue.message }))
  return normalized(op)
}

/** Whether a share, move or trash names shown positions. */
export function filesShownTarget(op: FilesAgentOperation): op is FilesShownOperation {
  return (op.type === "files_share" || op.type === "files_move" || op.type === "files_trash") && "shown" in op
}

/** The kind and form the shown-target rules speak of. */
export function filesForm(op: FilesAgentOperation): { readonly kind: FilesKind; readonly form: FilesForm } {
  const kinds: Readonly<Record<FilesOperationType, FilesKind>> = {
    files_filter: "FilterKind", files_open: "OpenKind", files_share: "ShareKind", files_move: "MoveKind", files_trash: "TrashKind", files_folder_create: "FolderCreateKind",
  }
  return { kind: kinds[op.type], form: "shown" in op ? "ShownForm" : "PathForm" }
}

/** Whether a path move or trash must carry the identity of each file as the card showed it. */
export function filesNeedsIdentity(op: FilesAgentOperation): op is Extract<FilesPathOperation, { readonly type: "files_move" | "files_trash" }> {
  return bindsIdentity(filesForm(op).kind) && !filesShownTarget(op)
}

/** Whether a peer that negotiated these capabilities may be offered, and may send, this operation. */
export function filesOperationAdmitted(op: FilesAgentOperation, capabilities: readonly string[]): boolean {
  const { kind, form } = filesForm(op)
  return formAdmitted(kind, form, capabilities.includes(FILES_CAPABILITY), capabilities.includes(FILES_SHOWN_TARGET_CAPABILITY))
}

/** The filter fields of a files_filter operation. */
export function filesFilterOf(op: Extract<FilesAgentOperation, { readonly type: "files_filter" }>): FilesFilter {
  const { type: _type, ...filter } = op
  return filter
}

const place = (path: string) => path === "" ? "Internal storage" : path.split("/").join(" › ")
const listed = (list: readonly string[]) => list.length <= 3 ? list.map(baseName).join(", ") : `${list.slice(0, 2).map(baseName).join(", ")} and ${list.length - 2} more`
const count = (n: number) => n === 1 ? "1 item" : `${n} items`
const shownLabel = (list: readonly number[]) => `${list.length === 1 ? "Item" : "Items"} ${list.join(", ")} in the results shown`

/** The owner-facing title and the exact effect of a proposal. */
export function describeFilesOperation(op: FilesAgentOperation): { readonly title: string; readonly description: string } {
  switch (op.type) {
    case "files_filter": return { title: "Show files", description: filterLabel(filesFilterOf(op)) }
    case "files_open": return { title: "Open file", description: "shown" in op ? `Shown item ${op.shown}` : place(op.path) }
    case "files_share": return "shown" in op ? { title: `Share ${count(op.shown.length)}`, description: shownLabel(op.shown) }
      : { title: `Share ${count(op.paths.length)}`, description: listed(op.paths) }
    case "files_trash": return "shown" in op ? { title: `Move ${count(op.shown.length)} to Trash`, description: shownLabel(op.shown) }
      : { title: `Move ${count(op.paths.length)} to Trash`, description: listed(op.paths) }
    case "files_move": return {
      title: `Move ${count("shown" in op ? op.shown.length : op.paths.length)}`,
      description: `${"shown" in op ? shownLabel(op.shown) : listed(op.paths)} → ${place(op.dest)}`,
    }
    case "files_folder_create": return { title: "New folder", description: place(op.parent === "" ? op.name : `${op.parent}/${op.name}`) }
  }
}

/** Changes are reviewed only where the owner sees Files on the unlocked phone; filter and open may start from any unlocked screen. */
export function filesContextAllowed(op: { readonly type: string }, context: { readonly view: string; readonly sensitive?: boolean }): boolean {
  if (context.sensitive === true) return false
  return FILES_DIRECT_TYPES.some((type) => type === op.type) || context.view === "files"
}

const filesPath = { type: "string", description: 'Path on Internal storage, for example "Download/lease.pdf"' } as const
const filesPaths = { type: "array", items: filesPath, description: "1-50 paths on Internal storage" } as const
const filesShown = { type: "array", items: { type: "integer", minimum: 1 }, description: "Instead of paths: 1-50 positions of items in the files_filter results on screen; 1 is the first" } as const
const destination = { ...filesPath, description: 'Destination folder; "" is Internal storage' } as const
const branch = (type: FilesOperationType, required: readonly string[], properties: Readonly<Record<string, unknown>>) =>
  ({ type: "object", additionalProperties: false, required: ["type", ...required], properties: { type: { type: "string", enum: [type] }, ...properties } }) as const

const PATH_SCHEMAS = [
  branch("files_filter", [], {
    text: { type: "string", description: "Words in the file name" },
    kind: { type: "string", enum: ["image", "video", "audio", "document", "pdf", "folder"] },
    folder: { type: "string", description: 'Folder path, for example "Download"; "" is Internal storage' },
    from: { type: "string", description: "Modified on or after, YYYY-MM-DD" },
    to: { type: "string", description: "Modified on or before, YYYY-MM-DD" },
  }),
  branch("files_open", [], { path: filesPath, shown: { type: "integer", minimum: 1, description: "Instead of path: position of an item in the files_filter results on screen; 1 is the first" } }),
  branch("files_share", ["paths"], { paths: filesPaths }),
  branch("files_trash", ["paths"], { paths: filesPaths }),
  branch("files_move", ["paths", "dest"], { paths: filesPaths, dest: destination }),
  branch("files_folder_create", ["parent", "name"], { parent: { ...filesPath, description: 'Parent folder; "" is Internal storage' }, name: { type: "string" } }),
]
const SHOWN_SCHEMAS = [
  branch("files_share", ["shown"], { shown: filesShown }),
  branch("files_trash", ["shown"], { shown: filesShown }),
  branch("files_move", ["shown", "dest"], { shown: filesShown, dest: destination }),
]

/** Guidance offered with files.shown-target.v1. */
export const FILES_SHOWN_TARGET_GUIDANCE = "files_share, files_move and files_trash may also name files by shown instead of paths: the positions (1 is the first) of items in the files_filter results on screen, for example shown [1] after a filter found one file. The phone shows the owner the actual files to review."

/** The tool schema branches and guidance a peer is offered for the capabilities it negotiated. */
export function filesToolSurface(capabilities: readonly string[]): { readonly schemas: readonly unknown[]; readonly guidance: readonly string[] } {
  const browser = capabilities.includes(FILES_CAPABILITY)
  const shown = capabilities.includes(FILES_SHOWN_TARGET_CAPABILITY)
  const offered = formAdmitted("ShareKind", "ShownForm", browser, shown)
  return {
    schemas: !browser ? [] : offered ? [...PATH_SCHEMAS, ...SHOWN_SCHEMAS] : PATH_SCHEMAS,
    guidance: offered ? [FILES_SHOWN_TARGET_GUIDANCE] : [],
  }
}

/** What the Files view registers while it is installed, for the coordinator to review and run operations. */
export interface FilesAgentRunner {
  readonly reviewedIdentities: (paths: readonly string[]) => readonly FilesIdentity[]!FilesOperationRefused
  readonly shownPaths: (shown: readonly number[]) => readonly string[]!FilesOperationRefused
  readonly run: (op: FilesPathOperation, openFiles?: () => boolean!!) => { readonly status: "succeeded" | "failed"; readonly summary: string }!!
}
