// spec/files/sourceReferences.md, "Link metadata names approved content without authorizing a read"; spec/files/sourceReferences.md, "Reconciliation keeps live and restorable links, picker leases and covering tree grants"; spec/files/sourceReferences.md, "A summary link keeps the kind and authority of its source"
module browser {
  /** @throws {never} */
  export function decodeBase64(text: string): Uint8Array<ArrayBuffer> | undefined {
    try {
      const raw = atob(text)
      return btoa(raw) === text ? Uint8Array.from(raw, (character) => character.charCodeAt(0)) : undefined
    } catch {
      return undefined
    }
  }

  /** @throws {never} */
  export function utf8(bytes: Uint8Array): string | undefined {
    try {
      return new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(bytes)
    } catch {
      return undefined
    }
  }

  /** @throws {never} */
  export function parsedUrl(text: string): URL | undefined {
    try {
      return new URL(text)
    } catch {
      return undefined
    }
  }

  export async function sha256Hex(bytes: Uint8Array<ArrayBuffer>): Promise<string> {
    return Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256", bytes)), (byte) => byte.toString(16).padStart(2, "0")).join("")
  }
}

import {
  allowsSourceDispatch, exactSourceBytes, keepsReference, selectedDocumentAllowed, sourceProvesPastBytes, validDescriptor,
  type LinkRef, type SourceDescriptor, type SourceKind, type SourceMime,
} from "../../gen/files__sourceReferences.effect.vibe"
import { decodeBase64, parsedUrl, sha256Hex, utf8 } from browser

/** Document types a source link may name. */
export const SOURCE_DOCUMENT_TYPES = ["text/plain", "application/pdf", "image/png", "image/jpeg", "image/webp"] as const
/** Largest linked source document. */
export const SOURCE_DOCUMENT_MAX_BYTES = 5 * 1024 * 1024

/** A version-1 link to a document by its exact bytes, with an optional device or browser reference. */
export interface DocumentSourceLink {
  readonly version: 1
  readonly name: string
  readonly mimeType: string
  readonly sha256: string
  readonly size: number
  readonly reference?: string
}
/** A link to the current page at a safe HTTPS address; never proof of the page's earlier bytes. */
export interface WebSourceLink { readonly kind: "web-page"; readonly version: 1; readonly name: string; readonly url: string }
/** A link to an exact recording note revision. */
export interface RecordingSourceLink { readonly kind: "recording"; readonly version: 1; readonly name: string; readonly noteId: string; readonly revision: string }
/** Any link a summary keeps to where it came from. */
export type SummarySourceLink = DocumentSourceLink | WebSourceLink | RecordingSourceLink

const mimes: Readonly<Record<string, SourceMime>> = {
  "application/pdf": "Pdf", "image/png": "Png", "image/jpeg": "Jpeg", "image/webp": "Webp", "text/plain": "PlainText",
}
const hex64 = /^[a-f0-9]{64}$/
const control = (text: string, extra = "") => [...text].some((character) => {
  const code = character.charCodeAt(0)
  return code < 0x20 || code === 0x7f || extra.includes(character)
})
const label = (name: unknown): name is string => typeof name === "string" && name.trim() !== "" && name.length <= 120 && !control(name)

function field(value: unknown, key: string): unknown {
  return typeof value === "object" && value !== null && key in value ? (value as Record<string, unknown>)[key] : undefined
}

function referenceKind(reference: unknown): LinkRef {
  if (reference === undefined) return "NoRef"
  if (typeof reference === "string" && /^a1:[a-f0-9]{64}$/.test(reference)) return "AndroidRef"
  if (typeof reference === "string" && /^b1:[a-f0-9-]{36}$/.test(reference)) return "BrowserRef"
  return "MalformedRef"
}

function descriptorOf(value: unknown): SourceDescriptor {
  const name = field(value, "name"), mime = field(value, "mimeType"), sha = field(value, "sha256"), size = field(value, "size")
  return {
    schema: field(value, "version") === 1 ? 1 : 0,
    nameUnits: typeof name === "string" ? name.length : 0,
    safeName: typeof name === "string" && !control(name, "\\/"),
    mime: typeof mime === "string" ? mimes[mime] ?? "Unsupported" : "Unsupported",
    digest: typeof sha === "string" ? sha : "",
    hashValid: typeof sha === "string" && hex64.test(sha),
    bytes: typeof size === "number" && Number.isSafeInteger(size) ? size : -1,
  }
}

/** A normalized document link, dropping extra fields and a malformed reference, or undefined when it is not one. */
export function documentSourceOf(value: unknown): DocumentSourceLink | undefined {
  const descriptor = descriptorOf(value)
  if (!validDescriptor(descriptor)) return undefined
  const reference = field(value, "reference")
  return {
    version: 1, name: field(value, "name") as string, mimeType: field(value, "mimeType") as string, sha256: descriptor.digest, size: descriptor.bytes,
    ...(keepsReference(descriptor, referenceKind(reference)) ? { reference: reference as string } : {}),
  }
}

/** A normalized recording link, or undefined when it is not one. */
export function recordingSourceOf(value: unknown): RecordingSourceLink | undefined {
  const name = field(value, "name"), noteId = field(value, "noteId"), revision = field(value, "revision")
  if (field(value, "kind") !== "recording" || field(value, "version") !== 1 || !label(name) || typeof noteId !== "string" || noteId === ""
    || noteId.length > 128 || control(noteId) || typeof revision !== "string" || !hex64.test(revision)) return undefined
  return { kind: "recording", version: 1, name, noteId, revision }
}

/** A normalized HTTPS page link without credentials that the host's reading policy does not treat as sensitive. */
export function webSourceOf(value: unknown, isSensitiveUrl: (url: string) => boolean = () => false): WebSourceLink | undefined {
  const name = field(value, "name"), raw = field(value, "url")
  if (field(value, "kind") !== "web-page" || field(value, "version") !== 1 || !label(name) || typeof raw !== "string" || raw.length > 4096
    || control(raw, " ")) return undefined
  const url = parsedUrl(raw)
  if (url === undefined || url.protocol !== "https:" || url.hostname === "" || url.username !== "" || url.password !== "" || isSensitiveUrl(url.href)) return undefined
  return { kind: "web-page", version: 1, name, url: url.href }
}

/** Any summary link, checked by the rules of its own kind. */
export function summarySourceOf(value: unknown, isSensitiveUrl?: (url: string) => boolean): SummarySourceLink | undefined {
  return recordingSourceOf(value) ?? webSourceOf(value, isSensitiveUrl) ?? documentSourceOf(value)
}

/** Whether a link of this kind can prove the bytes its source had when it was made. */
export function sourceProvesPast(link: SummarySourceLink): boolean {
  const kind: SourceKind = "kind" in link ? (link.kind === "web-page" ? "WebLink" : "RecordingLink") : "DocumentLink"
  return sourceProvesPastBytes(kind, true)
}

/** The lowercase SHA-256 of a recording note's JSON, its exact revision. */
export effect function recordingRevision(note: unknown): string!SourceRefused {
  const json: string | undefined = try Effect.try({ try: () => JSON.stringify(note), catch: () => sourceRefused("unreadable") })
  if (typeof json !== "string") throw sourceRefused("unreadable")
  return try tryPromise({ try: () => sha256Hex(new TextEncoder().encode(json)), catch: () => sourceRefused("unreadable") })
}

/** The largest keep set a reconciliation accepts. */
export const SOURCE_KEEP_MAX = 20_000

/** The durable `a1:` references that saved and restorable items still name, each once. */
export function retainedSourceReferences(items: readonly unknown[], link: (item: unknown) => unknown = (item) => field(item, "documentSource")): string[] {
  return [...new Set(items.map((item) => documentSourceOf(link(item))?.reference).filter((reference): reference is string => reference?.startsWith("a1:") === true))]
}

/** The complete validated keep set for reconciliation, refused whole when any identity is invalid or there are too many. */
export effect function sourceKeepSet(references: readonly unknown[]): string[]!SourceRefused {
  if (references.length > SOURCE_KEEP_MAX || !references.every((reference) => referenceKind(reference) === "AndroidRef")) throw sourceRefused("invalid-keep-set")
  return [...new Set(references as readonly string[])]
}

export type SourceRefusal = "invalid-attachment" | "too-large" | "content-mismatch" | "unreadable" | "changed" | "not-current" | "invalid-keep-set"

const sourceText: Readonly<Record<SourceRefusal, string>> = {
  "invalid-attachment": "Invalid attachment name or encoding",
  "too-large": "Attachment exceeds 5 MiB",
  "content-mismatch": "Supported attachments: PDF, PNG, JPEG, WebP and UTF-8 TXT up to 5 MiB. File content must match its type.",
  unreadable: "The document could not be read.",
  changed: "The document changed since it was linked.",
  "not-current": "This document review is no longer current.",
  "invalid-keep-set": "The kept document references are not all valid.",
}

/** A document whose bytes, type or review no longer allow it to be linked or reopened. */
export error SourceRefused { reason: SourceRefusal; message: string }

/** The refusal for a reason, worded as the reviewed text. */
export function sourceRefused(reason: SourceRefusal): SourceRefused {
  return new SourceRefused({ reason, message: sourceText[reason] })
}

/** A reviewed document: its link metadata, and its text when it is plain text. */
export interface ReviewedDocument {
  readonly name: string
  readonly mimeType: string
  readonly size: number
  readonly sha256: string
  readonly text?: string
}

const ascii = (bytes: Uint8Array, at: number, text: string) => [...text].every((character, index) => bytes[at + index] === character.charCodeAt(0))
const extensions: Readonly<Record<string, RegExp>> = {
  "text/plain": /\.txt$/, "application/pdf": /\.pdf$/, "image/png": /\.png$/, "image/jpeg": /\.jpe?g$/, "image/webp": /\.webp$/,
}

function contentMatches(mimeType: string, bytes: Uint8Array): { readonly matches: boolean; readonly text?: string } {
  if (mimeType === "text/plain") {
    const text = utf8(bytes)
    return text === undefined || text.includes("\0") ? { matches: false } : { matches: true, text }
  }
  if (mimeType === "application/pdf") return { matches: ascii(bytes, 0, "%PDF-") }
  if (mimeType === "image/png") return { matches: [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a].every((byte, index) => bytes[index] === byte) }
  if (mimeType === "image/jpeg") return { matches: bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff }
  return { matches: mimeType === "image/webp" && ascii(bytes, 0, "RIFF") && ascii(bytes, 8, "WEBP") }
}

/** Reviews exact document bytes: safe name, extension, type and leading signature or strict UTF-8, within 5 MiB. */
export effect function reviewDocumentBytes(name: string, mimeType: string, bytes: Uint8Array<ArrayBuffer>): ReviewedDocument!SourceRefused {
  if (bytes.length > SOURCE_DOCUMENT_MAX_BYTES) throw sourceRefused("too-large")
  const content = contentMatches(mimeType, bytes)
  const sha256 = try tryPromise({ try: () => sha256Hex(bytes), catch: () => sourceRefused("unreadable") })
  const descriptor = descriptorOf({ version: 1, name, mimeType, sha256, size: bytes.length })
  if (!validDescriptor(descriptor)) throw sourceRefused(descriptor.safeName && descriptor.nameUnits <= 120 ? "content-mismatch" : "invalid-attachment")
  if (!selectedDocumentAllowed(descriptor, extensions[mimeType]?.test(name.toLowerCase()) === true, content.matches)) throw sourceRefused("content-mismatch")
  return { name, mimeType, size: bytes.length, sha256, ...(content.text === undefined ? {} : { text: content.text }) }
}

/** A mail attachment as base64, as a picker or mailbox hands it over. */
export interface MailAttachment {
  readonly name: string
  readonly mimeType: string
  readonly dataBase64: string
}

/** Decodes canonical base64 within its bound and reviews the attachment's exact bytes. */
export effect function reviewMailAttachment(file: MailAttachment): ReviewedDocument!SourceRefused {
  if (typeof file.name !== "string" || file.name.length > 120 || control(file.name, "\\/") || typeof file.dataBase64 !== "string"
    || file.dataBase64.length > 7 * 1024 * 1024) throw sourceRefused("invalid-attachment")
  const bytes = decodeBase64(file.dataBase64)
  if (bytes === undefined) throw sourceRefused("invalid-attachment")
  return try reviewDocumentBytes(file.name, file.mimeType, bytes)
}

/** The facts of a reopen request the shell observed: the bridge's fresh read and the review that asked for it. */
export interface SourceReopen {
  readonly link: DocumentSourceLink
  readonly mimeType: string
  readonly bytes: Uint8Array<ArrayBuffer>
  readonly accessible: boolean
  readonly approved: boolean
  readonly currentGeneration: boolean
  readonly focused: boolean
}

/** Rechecks a fresh read against the linked identity and the live review, then allows the viewer handoff or refuses. */
export effect function admitSourceReopen(reopen: SourceReopen): DocumentSourceLink!SourceRefused {
  const descriptor = descriptorOf(reopen.link)
  const sha256 = try tryPromise({ try: () => sha256Hex(reopen.bytes), catch: () => sourceRefused("unreadable") })
  const exact = exactSourceBytes(descriptor, mimes[reopen.mimeType] ?? "Unsupported", sha256, reopen.bytes.length)
  const content = contentMatches(reopen.mimeType, reopen.bytes).matches
  if (!exact || !content) throw sourceRefused("changed")
  if (!allowsSourceDispatch(exact, content, reopen.accessible, reopen.approved, reopen.currentGeneration, reopen.focused)) throw sourceRefused("not-current")
  return reopen.link
}
