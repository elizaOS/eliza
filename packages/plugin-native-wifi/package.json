{
  "name": "@elizaos/plugin-native-wifi",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Wi-Fi overlay app for the Eliza Android build \u2014 scan, inspect, and connect to nearby networks via @elizaos/plugin-native-wifi/bridge.",
  "license": "MIT",
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@elizaos/os": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13",
    "@repo/ui": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "@types/react": "catalog:"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./bridge": {
      "eliza-source": "./src/index.vibe",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./ui": {
      "eliza-source": "./src/components/WifiPanel.tsx",
      "types": "./dist/src/components/WifiPanel.d.ts",
      "import": "./dist/src/components/WifiPanel.js",
      "default": "./dist/src/components/WifiPanel.js"
    }
  }
}
