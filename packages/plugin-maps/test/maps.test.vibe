const ferry = { latitude: 37.7955, longitude: -122.3937 }
const tower = { latitude: 37.8024, longitude: -122.4058 }
const here = { latitude: 37.7946, longitude: -122.3999 }
const connectionId = "conn_0123456789abcdef"

effect function routeTo(id: string, to: { readonly latitude: number; readonly longitude: number }, mode: Route["mode"], minutes: number): Route!! {
  return {
    providerId: "google", id, from: here, to, mode, geometry: [here, to], distanceMeters: minutes * 400, durationSeconds: minutes * 60,
    steps: [{ instruction: "Head north", coordinate: here, distanceMeters: minutes * 400, maneuver: "depart" }, { instruction: "Arrive", coordinate: to, distanceMeters: 0, maneuver: "arrive" }],
    attribution: "Google", fetchedAt: try Clock.currentTimeMillis, traffic: "live",
  }
}

const offer = {
  available: true as const, providerId: "google", connectionId, revision: "2026-11", attribution: "Google Maps Platform via Eliza Cloud",
  sources: { data: "Google", search: "Google", routing: "Google" },
  disclosure: { recipients: [{ role: "gateway" as const, name: "Eliza Cloud", operator: "Eliza Labs" }, { role: "search" as const, name: "Google Maps Platform", operator: "Google" }], cloudRecords: "operation-and-result-code" as const },
  regions: [{ id: "world", name: "World", bounds: [-180, -90, 180, 90] as const }],
  capabilities: { map: true, search: true as const, placeDetails: true as const, geocode: true as const, reverseGeocode: true as const, placeLookup: true, modes: ["drive", "walk"] as const, alternatives: true, traffic: "live" as const, transit: "none" as const, offline: { map: false as const, search: false as const, routing: false as const } },
  tiles: { urlTemplate: "/api/v1/maps/tiles/{z}/{x}/{y}" as const, mapType: "roadmap" as const, minZoom: 0, maxZoom: 20, tileSize: 256 as const, attribution: "Google" },
}

function cloudFake() {
  const calls: string[] = []
  const gates: { search?: { started: Deferred.Deferred<void>; finish: Deferred.Deferred<void> }; refuseSearch?: CloudError } = {}
  const client = {
    async mapsCapabilities() { calls.push("capabilities"); return offer },
    async mapsPlacesSearch(request: { readonly query: string }) {
      calls.push(`search:${request.query}`)
      const search = gates.search
      if (search !== undefined) {
        await runPromise(Deferred.succeed(search.started, undefined))
        await runPromise(Deferred.await(search.finish))
      }
      if (gates.refuseSearch !== undefined) throw gates.refuseSearch
      return { providerId: "google", attribution: "Google", places: [{ providerId: "google", id: "ferry", name: "Ferry Building", coordinate: ferry, attribution: "Google", fetchedAt: Date.now() }] }
    },
    async mapsPlaceDetails() { calls.push("details"); return { providerId: "google", attribution: "Google", place: null } },
    async mapsRoutes() { calls.push("routes"); return { providerId: "google", attribution: "Google", routes: [] } },
    async mapsViewport() { calls.push("viewport"); return { providerId: "google", copyright: "Map data ©2026 Google" } },
    async mapsTile() { calls.push("tile"); return { contentType: "image/png", bytes: new Uint8Array([1, 2, 3]) } },
  } as unknown as MapsCloud
  return { client, calls, gates }
}

it.live('Keep Cloud Maps on the account that requested it: coverage installs the provider for the bound account, a request outliving the account is fenced, a Cloud pause holds the next request, and signed out reads nothing (spec/maps/cloudConnection.md, "Story: Keep Cloud Maps on the account that requested it"; spec/maps/requests.md, "Story: Back off when Maps asks me to wait")', effect () => {
  const cloud = cloudFake()
  const installs: ProviderConfig["status"][] = []
  const holder: { provider?: MapsProvider } = {}
  const maps = try cloudMaps((config, installed) => {
    installs.push(config.status)
    holder.provider = installed
  })
  try maps.initialize()
  const signedOut = maps.diagnostics()
  const signedOutCalls = cloud.calls.length
  try maps.bind({ session: "s1", credential: "k1", client: cloud.client })
  try maps.initialize(true)
  const installed = holder.provider
  if (installed === undefined) return try Effect.die(new Error("Cloud Maps installed no provider"))
  const found = try installed.search("ferry building")
  const gate = { started: try Deferred.make<void>(), finish: try Deferred.make<void>() }
  cloud.gates.search = gate
  const inFlight = fork installed.search("coit tower")
  try Deferred.await(gate.started)
  try maps.bind({ session: "s2", credential: "k2", client: cloud.client })
  try Deferred.succeed(gate.finish, undefined)
  const fenced = try Fiber.await(inFlight)
  cloud.gates.search = undefined
  try maps.initialize()
  const second = holder.provider
  if (second === undefined) return try Effect.die(new Error("Cloud Maps installed no provider for the new account"))
  cloud.gates.refuseSearch = new CloudError({ failure: { tag: "CloudRateLimited", retryAt: Date.now() + 60_000 }, cause: "" })
  const limited = try Effect.flip(second.search("pharmacy"))
  cloud.gates.refuseSearch = undefined
  const before = cloud.calls.length
  const held = try Effect.flip(second.search("pharmacy"))
  try Effect.try(() => assert.deepStrictEqual({
    signedOut: [signedOut.error, signedOutCalls],
    installs,
    found: found.map((item: Place) => [item.id, item.attribution]),
    fenced: fenced._tag === "Failure" ? "fenced" : "returned",
    limited: [limited.code, held.code, cloud.calls.length === before],
  }, {
    signedOut: ["unauthorized", 0],
    installs: ["configured", "unconfigured", "configured"],
    found: [["ferry", "Google"]],
    fenced: "fenced",
    limited: ["rate-limited", "rate-limited", true],
  }))
})

it.live('Show the right copyright for the map I am looking at: a view inside the attributed area keeps its copyright and a reply for a view I left is never shown (spec/maps/attribution.md, "Story: Show the right copyright for the map I am looking at")', effect () => {
  const replies = try Queue.unbounded<Deferred.Deferred<string>>()
  const asked: number[] = []
  const basemap: CloudMapsBasemap = {
    kind: "cloud-raster", attribution: "Google", minZoom: 0, maxZoom: 20, tileSize: 256,
    tile: () => succeed(new Uint8Array()),
    effect copyright(view) {
      const reply = try Deferred.make<string>()
      asked.push(view.north)
      try Queue.offer(replies, reply)
      return try Deferred.await(reply)
    },
  }
  const attribution = try viewportAttribution(basemap)
  const city = { zoom: 12, north: 38, south: 37, east: -122, west: -123 }
  const first = fork attribution.show(city)
  const firstReply = try Queue.take(replies)
  try Deferred.succeed(firstReply, "Map data ©2026 Google")
  const shown = try join first
  try attribution.move({ ...city, north: 37.9, south: 37.1 })
  const within = try attribution.current()
  const elsewhere = { zoom: 12, north: 41, south: 40, east: -73, west: -74 }
  try attribution.move(elsewhere)
  const hidden = try attribution.current()
  const stale = fork attribution.show(elsewhere)
  const staleReply = try Queue.take(replies)
  const further = { ...elsewhere, north: 42, south: 41 }
  try attribution.move(further)
  const moved = fork attribution.show(further)
  const currentReply = try Queue.take(replies)
  try Deferred.succeed(staleReply, "Stale copyright")
  const late = try join stale
  try Deferred.succeed(currentReply, "Map data ©2026 Google, INEGI")
  const current = try join moved
  try attribution.dispose()
  const disposed = try attribution.current()
  try Effect.try(() => assert.deepStrictEqual({ shown, within, hidden, asked, late, current, disposed },
    { shown: "Map data ©2026 Google", within: "Map data ©2026 Google", hidden: "", asked: [38, 41, 42], late: "", current: "Map data ©2026 Google, INEGI", disposed: "" }))
})

function screenFake() {
  const destination: { place?: Place; mode: Route["mode"] } = { mode: "drive" }
  const state: { granted: boolean; fix?: Position; guidance: ActiveGuidance | null; revision: number; route?: Route; stopped: number; changeWhileLocating: boolean } =
    { granted: false, guidance: null, revision: 1, stopped: 0, changeWhileLocating: false }
  const config: ProviderConfig = { status: "configured", providerId: "google", connectionId, revision: "2026-11", capabilities: {
    map: true, search: true, placeDetails: true, modes: ["drive", "walk"], traffic: "live", transit: "none", offline: { map: false, search: false, routing: false }, alternatives: true,
  } }
  const snapshot = (): NavigationSnapshot => ({
    provider: config,
    selection: destination.place === undefined ? { phase: "idle", value: null, error: null } : { phase: "ready", value: destination.place, error: null },
    route: state.route === undefined ? { phase: "idle", value: null, error: null } : { phase: "ready", value: state.route, error: null },
    revision: state.revision,
    mode: destination.mode,
  })
  const surface: MapsNavigationSurface = {
    present: () => succeed(true),
    snapshot,
    showPlace: effect (shown) => { destination.place = shown },
    showDirections: effect (shown, mode) => {
      destination.place = shown
      destination.mode = mode
      state.route = undefined
    },
    locationGranted: () => succeed(state.granted),
    locate: effect () => {
      if (state.changeWhileLocating) state.revision++
      if (state.fix === undefined) throw new MapsFailure({ code: "timeout", message: "No location fix arrived." })
      return state.fix
    },
    planFrom: effect () => {
      const to = destination.place?.coordinate
      if (to !== undefined) state.route = try routeTo("planned", to, destination.mode, 12)
    },
    guidance: () => state.guidance,
    reroute: effect () => ({ session: state.guidance?.session ?? 0, ...(state.route === undefined ? {} : { route: state.route }) }),
    stop: effect () => {
      state.stopped++
      state.guidance = null
    },
  }
  return { surface, state }
}

const towerRef = { provider: "eliza-cloud", providerPlaceId: "tower", name: "Coit Tower", coordinates: tower }

it.live('Plan directions and keep me in control of guidance: an agent request waits for permitted location, refuses a stale fix and a changed sheet, reaches confirmation only for the exact destination, and only my Start turns guidance on (spec/maps/navigation.md, "Story: Plan directions and keep me in control of guidance"; spec/maps/sessionReroute.md, "Story: Reroute the navigation I started, whoever planned the route")', effect () => {
  const { surface, state } = screenFake()
  const phone = try deviceMapsNavigation(surface, { providerId: "google", attribution: "Google", current: () => true }, "200 millis")
  const withoutPermission = try phone.start({ destination: towerRef, travelMode: "walk" })
  state.granted = true
  const now = try Clock.currentTimeMillis
  state.fix = { coordinate: here, accuracyMeters: 12, timestamp: now - 45_000, precision: "precise" }
  const stale = try phone.start({ destination: towerRef, travelMode: "walk" })
  state.fix = { coordinate: here, accuracyMeters: 12, timestamp: now, precision: "approximate" }
  const approximate = try phone.start({ destination: towerRef, travelMode: "walk" })
  state.fix = { coordinate: here, accuracyMeters: 12, timestamp: now, precision: "precise" }
  state.changeWhileLocating = true
  const changed = try Effect.flip(phone.start({ destination: towerRef, travelMode: "walk" }))
  state.changeWhileLocating = false
  const ready = try phone.start({ destination: towerRef, travelMode: "walk" })
  const beforeStart = (try phone.directions()).active
  const started = try phone.confirmed()
  const agentPlanned: ActiveGuidance = { session: 1, routeId: "planned", placeName: "Coit Tower", travelMode: "walk", fix: state.fix, rerouting: false, arrived: false }
  state.guidance = agentPlanned
  try phone.guidanceStarted(agentPlanned)
  const another = try Effect.flip(phone.start({ destination: towerRef, travelMode: "walk" }))
  const rerouted = try phone.reroute()
  const stopped = try phone.stop()
  const ownerPlanned: ActiveGuidance = { session: 2, routeId: "own", placeName: "Ferry Building", travelMode: "drive", fix: { coordinate: here, accuracyMeters: 10, timestamp: try Clock.currentTimeMillis, precision: "precise" }, rerouting: false, arrived: false }
  state.guidance = ownerPlanned
  const adopted = try phone.guidanceStarted(ownerPlanned)
  const ownReroute = try phone.reroute()
  state.guidance = null
  try phone.guidanceEnded()
  const unsupported = try Effect.flip(phone.start({ destination: towerRef, travelMode: "transit" }))
  try Effect.try(() => assert.deepStrictEqual({
    withoutPermission: withoutPermission.state, stale: stale.state, approximate: approximate.state, changed: changed.code,
    ready: [ready.state, ready.placeName, ready.route?.durationSeconds], beforeStart, started, another: another.code,
    rerouted: rerouted.state, stopped: [stopped.state, state.stopped], unsupported: unsupported.code,
    fresh: usableNavigationFix(state.fix, now + 31_000), ownerPlanned: [adopted, ownReroute.state, ownReroute.placeName],
  }, {
    withoutPermission: "awaiting-location", stale: "awaiting-location", approximate: "awaiting-location", changed: "MAPS_DEVICE_UNAVAILABLE",
    ready: ["awaiting-confirmation", "Coit Tower", 720], beforeStart: false, started: true, another: "MAPS_INVALID_INPUT",
    rerouted: "navigating", stopped: ["stopped", 1], unsupported: "MAPS_UNSUPPORTED_REGION",
    fresh: false, ownerPlanned: [true, "navigating", "Ferry Building"],
  }))
})

it.live('Navigate again when the phone never received my request: a lost delivery is delivered again to the same offer after its lease lapses, the phone runs it once and answers once, the agent bundle reaches the phone that opened its relay for the turn\'s conversation, and a request made once its turn has ended never reaches the phone (spec/maps/relay.md, "Story: Navigate again when the phone never received my request"; spec/maps/navigation.md, "A resident relay delivers each command at most once within its offer"; spec/maps/navigation.md, "A valid agent request prepares a route and never turns on guidance itself")', effect () => {
  const relay = try mapsNavigationRelay({ leaseMs: 40, commandMs: 3_000, liveMs: 2_000, idleMs: 30_000, pollMs: 20 })
  const conversationId = "11111111-2222-4333-8444-555555555555"
  const agent = relay.navigation("phone-scope", conversationId, () => true)
  const runs: string[] = []
  let dropNextDelivery = true
  const screen = {}
  const phoneHost = {
    current: () => screen,
    execute: effect (_owner: object, operation: { readonly kind: string }) => {
      runs.push(operation.kind)
      if (operation.kind === "stop") return { state: "stopped" as const }
      return { state: "awaiting-confirmation" as const, placeName: "Coit Tower", travelMode: "walk" as const, route: { durationSeconds: 720, distanceMeters: 4800, traffic: "live" as const } }
    },
    connected: () => {},
  }
  const transport = effect (body: Readonly<Record<string, unknown>>) => {
    const answer = try mapError(relay.handle("phone-scope", body), (refused) => new RelayUnavailable({ reason: refused.reason }))
    if (answer.request !== null && dropNextDelivery) {
      dropNextDelivery = false
      return { protocol: 1, request: null }
    }
    return answer
  }
  const turn = fork withMapsNavigationRelay(phoneHost, transport, conversationId, sleep("1500 millis"))
  try sleep("50 millis")
  const available = try agent.available()
  const status = try agent.start({ destination: towerRef, travelMode: "walk" })
  try Fiber.interrupt(turn)
  const roomId = "66666666-2222-4333-8444-555555555555"
  const turns = new TurnControllerRegistry()
  const runtime = {
    getService: () => linkFake().link,
    getRoom: (id: string) => Promise.resolve(id === roomId ? { id: roomId, metadata: { deviceConversation: { id: conversationId, createdAt: 1, updatedAt: 1 } } } : null),
    turnControllers: turns,
    contexts: { tryRegister: () => true },
  } as unknown as IAgentRuntime
  try promise(() => mapsPlugin.init?.({}, runtime) ?? Promise.resolve())
  const route = mapsPlugin.routes?.[0]
  const viaBundle = effect (body: Readonly<Record<string, unknown>>) => {
    const sent = try mapError(tryPromise(async () => await route?.handler({ parameters: new Map(), query: new Map(), headers: new Map(), body, signal: new AbortController().signal })),
      () => new RelayUnavailable({ reason: "The relay route failed." })) as { readonly status: number; readonly body: { readonly error?: string } } | undefined
    if (sent?.status !== 200) throw new RelayUnavailable({ reason: sent?.body.error ?? "The relay route is missing." })
    return sent.body
  }
  const stopAction = mapsPlugin.actions?.find((found) => found.name === "MAPS_NAVIGATION_STOP")
  const phoneTurn = fork withMapsNavigationRelay(phoneHost, viaBundle, conversationId, sleep("1500 millis"))
  try sleep("50 millis")
  const stopTurn = { entityId: "00000000-0000-4000-8000-000000000001", roomId, content: { text: "stop navigation", source: "device" } } as unknown as Memory
  const afterItsTurn = try promise(async () => await stopAction?.handler(runtime, stopTurn, undefined, {}))
  const stopped = try promise(() => turns.runWith(roomId, async () => await stopAction?.handler(runtime, stopTurn, undefined, {})))
  try Fiber.interrupt(phoneTurn)
  try Effect.try(() => assert.deepStrictEqual({
    available, status: status.state, route: status.route?.durationSeconds, runs, afterItsTurn: afterItsTurn?.success,
    stopped: [stopped?.success, (stopped?.data as { readonly status?: { readonly state: string } } | undefined)?.status?.state],
  }, { available: true, status: "awaiting-confirmation", route: 720, runs: ["start", "stop"], afterItsTurn: false, stopped: [true, "stopped"] }))
})

it.live('A command delivered to an offer that is then replaced is abandoned rather than replayed, and a queued one reaches the new offer (spec/maps/relay.md, "A queued command waits for the phone\'s current offer and survives a new offer it never reached")', effect () => {
  const relay = try mapsNavigationRelay({ leaseMs: 1_000, commandMs: 3_000, liveMs: 2_000, idleMs: 30_000, pollMs: 20 })
  const conversationId = "11111111-2222-4333-8444-555555555555"
  const first = "aaaaaaaa-2222-4333-8444-555555555555"
  const second = "bbbbbbbb-2222-4333-8444-555555555555"
  const agent = relay.navigation("scope", conversationId, () => true)
  const message = (offerId: string, phase: string) => ({ phase, conversationId, offerId })
  try relay.handle("scope", message(first, "open"))
  const queued = fork agent.stop()
  try sleep("20 millis")
  try relay.handle("scope", message(second, "open"))
  const delivered = try relay.handle("scope", message(second, "poll"))
  const id = delivered.request?.id ?? ""
  try relay.handle("scope", { ...message(second, "result"), id, status: { state: "stopped" } })
  const stopped = try join queued
  const held = fork Effect.flip(agent.stop())
  try sleep("20 millis")
  const leased = try relay.handle("scope", message(second, "poll"))
  try relay.handle("scope", message(first, "open"))
  const abandoned = try join held
  const late = try Effect.flip(relay.handle("scope", { ...message(second, "result"), id: leased.request?.id ?? "", status: { state: "stopped" } }))
  try Effect.try(() => assert.deepStrictEqual({ carried: delivered.request?.operation, stopped: stopped.state, abandoned: abandoned.code, late: late.reason },
    { carried: { kind: "stop" }, stopped: "stopped", abandoned: "MAPS_DEVICE_UNAVAILABLE", late: "Navigation request retired" }))
})

it.effect('Move on to the next step only when I have really passed the turn (spec/maps/guidanceRecovery.md, "Story: Move on to the next step only when I have really passed the turn")', effect () => {
  const start = { latitude: 37.7946, longitude: -122.3999 }
  const turn = { latitude: 37.7986, longitude: -122.3999 }
  const end = { latitude: 37.7986, longitude: -122.3899 }
  const route = { geometry: [start, turn, end], durationSeconds: 600, steps: [
    { instruction: "Head north", coordinate: start, distanceMeters: 445 },
    { instruction: "Turn right", coordinate: turn, distanceMeters: 880, maneuver: "right" as const },
    { instruction: "Arrive", coordinate: end, distanceMeters: 0, maneuver: "arrive" as const },
  ] }
  const past = { latitude: 37.7986, longitude: -122.3969 }
  const progress = routeProgress(past, route)
  const fix = { coordinate: past, accuracyMeters: 10 }
  const once = advanceStep({ index: 1, cleared: 0 }, route, progress, fix, true)
  const twice = advanceStep(once, route, progress, fix, true)
  const offRoute = advanceStep(once, route, progress, fix, false)
  const near = advanceStep({ index: 1, cleared: 0 }, route, routeProgress(turn, route), { coordinate: turn, accuracyMeters: 5 }, true)
  const last = advanceStep({ index: 2, cleared: 0 }, route, routeProgress(end, route), { coordinate: end, accuracyMeters: 5 }, true)
  try Effect.try(() => assert.deepStrictEqual({ once, twice, offRoute, near, last },
    { once: { index: 1, cleared: 1 }, twice: { index: 2, cleared: 0 }, offRoute: { index: 1, cleared: 0 }, near: { index: 2, cleared: 0 }, last: { index: 2, cleared: 0 } }))
})

it.live('Hear the newest turn instruction when my current route can speak: one key speaks once, a new key interrupts it, a hidden screen owes only the current instruction, and a failure mutes (spec/maps/guidanceVoice.md, "Story: Hear the newest turn instruction when my current route can speak")', effect () => {
  const spoken: string[] = []
  const interrupted: string[] = []
  let failNext = false
  let muted = 0
  const voice = try navigationVoice({
    speak: (text) => effect {
      spoken.push(text)
      if (failNext) throw new GuidanceSpeechStopped({ reason: "failed" })
      try onInterrupt(sleep("200 millis"), () => sync(() => { interrupted.push(text) }))
    },
  }, () => { muted++ })
  try voice.offer("route:1:step:1:500", "In 500 m, turn right", true)
  try voice.offer("route:1:step:1:500", "In 500 m, turn right onto Main", true)
  try sleep("10 millis")
  try voice.offer("route:1:step:1:100", "In 100 m, turn right", true)
  try sleep("10 millis")
  try voice.hide()
  try voice.offer("route:1:step:2:500", "In 500 m, turn left", true)
  const hidden = try voice.state()
  try voice.show(true)
  try sleep("10 millis")
  failNext = true
  try voice.offer("route:1:step:3:500", "In 500 m, arrive", true)
  try sleep("20 millis")
  const after = try voice.state()
  try Effect.try(() => assert.deepStrictEqual({ spoken, interrupted, owed: hidden.owedInstruction > 0, muted, voiceOn: after.voiceOn },
    { spoken: ["In 500 m, turn right", "In 100 m, turn right", "In 500 m, turn left", "In 500 m, arrive"], interrupted: ["In 500 m, turn right", "In 100 m, turn right", "In 500 m, turn left"], owed: true, muted: 1, voiceOn: false }))
})

it.live('Keep guiding with the screen off when the exact native session can continue: only the device confirms screen-off, a notification Stop ends that guidance, and a missing service falls back to the visible screen (spec/maps/navigationService.md, "Story: Keep guiding with the screen off when the exact native session can continue")', effect () => {
  const listeners = new Map<string, (reason: string) => void>()
  const native = { background: true, started: [] as string[], stopped: [] as string[], updates: [] as string[] }
  const ended: string[] = []
  const screenOff = try backgroundNavigation({
    availability: () => succeed({ background: native.background }),
    listen: (sessionId, stopped) => sync(() => {
      listeners.set(sessionId, stopped)
      return () => { listeners.delete(sessionId) }
    }),
    start: (input) => sync(() => { native.started.push(input.sessionId) }),
    update: (input) => sync(() => {
      native.updates.push(input.title)
      return { active: true }
    }),
    stop: (input) => sync(() => {
      native.stopped.push(input.sessionId)
      return { stopped: true }
    }),
  }, (reason) => { ended.push(reason) })
  const confirmed = try screenOff.start("route-1", "500 m · Turn right", "12 min · 4.8 km remaining")
  const hidden = try screenOff.hide()
  try screenOff.update("100 m · Turn right", "11 min · 4.4 km remaining")
  try sleep("10 millis")
  const [session] = native.started
  listeners.get(session ?? "")?.("notification")
  try sleep("10 millis")
  const afterStop = try screenOff.state()
  try screenOff.show()
  native.background = false
  const fallback = try screenOff.start("route-2", "500 m · Turn left", "9 min")
  const visible = try screenOff.state()
  try Effect.try(() => assert.deepStrictEqual({
    confirmed, hidden: [hidden.visible, hidden.background], updates: native.updates, ended, afterStop: afterStop.phase,
    stoppedTwice: native.stopped.filter((id) => id === session).length, fallback, visible: [visible.phase, visible.fallback, visible.watchOwned],
  }, {
    confirmed: true, hidden: [false, "ScreenOff"], updates: ["100 m · Turn right"], ended: ["notification"], afterStop: "NoGuidance",
    stoppedTwice: 0, fallback: false, visible: ["LiveGuidance", true, true],
  }))
})

it.effect('Let the agent see only what the Maps screen shows now (spec/maps/observation.md, "Story: Let the agent see only what the Maps screen shows now")', effect () => {
  const observation = try mapsObservation()
  const source = { query: "coffee", area: "mission", results: ["a", "b"], provider: "google", ready: true }
  try observation.publish(source)
  const seen = try observation.observe()
  if (seen === undefined) return try Effect.die(new Error("No observation was captured"))
  const current = try observation.validate(seen)
  try observation.publish(source)
  const republished = try observation.validate(seen)
  try observation.publish({ ...source, results: ["c"] })
  const changed = try observation.validate(seen)
  try observation.renew({ ...source, results: ["c"] })
  const renewed = try observation.observe()
  const retired = try observation.validate(seen)
  try Effect.try(() => assert.deepStrictEqual({ current, republished, changed, retired, fresh: renewed?.id !== seen.id },
    { current: true, republished: true, changed: false, retired: false, fresh: true }))
})

service MapsChatFixture {
  readonly chat: Awaited<ReturnType<typeof mapsChat>>
  readonly bodies: ReturnType<typeof linkFake>["bodies"]
}

const mapsChatFixture = Layer.effect(MapsChatFixture, effect {
  const { link, bodies } = linkFake()
  const chat = try acquireRelease(tryPromise(() => mapsChat(mapsPlugin, link.request)), (running) => promise(() => running.close()))
  return { chat, bodies }
})

layer(mapsChatFixture, { excludeTestServices: true, timeout: "3 minutes" })("Maps recovery over the resident API", (it) => {
  it.effect('Recover directions from a phone Maps selection without asking for the named place again (spec/maps/routing.md, "A Maps screen selection asks the planner to name the place"; spec/agent/conversation/planning.md, "A coaching response stays in the planner transcript")', effect () => {
    const { chat, bodies } = try MapsChatFixture
    const observed = try mapsObservation()
    try observed.publish({ query: "Coit Tower", area: "San Francisco", results: ["Coit Tower"], provider: "google", ready: true })
    const selectedObject = try observed.observe()
    if (selectedObject === undefined) return try die("The Maps screen has no selection handle")
    try Effect.try(() => chat.script(mapsToolCall("MAPS_PLACE", { query: "Coit Tower", placeId: selectedObject.id }), { content: "Here is Coit Tower." }))
    const opened = try tryPromise(() => chat.post("/api/conversations", {}))
    const { conversation } = try Schema.decodeUnknownEffect(Schema.Struct({ conversation: Schema.Struct({ id: Schema.String }) }))(opened.body)
    const path = `/api/conversations/${conversation.id}/messages`
    const first = try tryPromise(() => chat.post(path, { text: "Show me Coit Tower on the map." }))
    if (first.status !== 200) return try die("Showing the original place was refused")
    try Effect.try(() => chat.script(
      mapsToolCall("MAPS_NAVIGATION_START", { placeId: selectedObject.id }),
      mapsToolCall("MAPS_NAVIGATION_START", { placeId: selectedObject.id, destination: "Coit Tower" }),
      { content: "Here are directions to Coit Tower." },
    ))
    const sent = try tryPromise(() => chat.post(path, {
      text: "Directions to it.", metadata: { observation: { view: "maps", revision: 1, sensitive: false, selectedObject } },
    }))
    if (sent.status !== 200) return try die("The directions turn was refused")
    const answer = try Schema.decodeUnknownEffect(Schema.Struct({
      text: Schema.String,
      actionResults: Schema.Array(Schema.Struct({
        action: Schema.String, data: Schema.Struct({ card: Schema.optionalKey(Schema.Struct({ kind: Schema.String })) }),
      })),
    }))(sent.body)
    const planningRequest = try Schema.decodeUnknownEffect(Schema.Struct({
      messages: Schema.Array(Schema.Struct({ role: Schema.String, content: Schema.optionalKey(Schema.Unknown) })),
    }))(chat.prompts.at(-3))
    try Effect.try(() => {
      const prompts = chat.prompts.slice(-3).map((body) => JSON.stringify(body))
      const sentDetails = bodies.filter(({ path }) => path.endsWith("/places/details"))
      const searches = bodies.filter(({ path }) => path.endsWith("/places/search"))
      assert.deepStrictEqual({
        sawSelection: prompts[0]?.includes(selectedObject.id),
        priorPlace: planningRequest.messages.some(({ role, content }) => role === "user" && content === "Show me Coit Tower on the map."),
        coached: prompts[1]?.includes("MAPS_SELECTION_HANDLE") && prompts[1]?.includes("destination"),
        lookupsOfHandle: sentDetails.length,
        searches: searches.map(({ body }) => body),
        actions: answer.actionResults.map(({ action }) => action),
        route: answer.actionResults[0]?.data.card?.kind ?? recognizedMapsCards(answer.text)[0]?.card.kind,
        named: answer.text.includes("Coit Tower"),
        falseFailure: /did not start|did not complete|MAPS_SELECTION_HANDLE/iu.test(answer.text),
      }, {
        sawSelection: true, priorPlace: true, coached: true, lookupsOfHandle: 0, searches: [{ query: "Coit Tower" }, { query: "Coit Tower", limit: 5 }],
        actions: ["MAPS_NAVIGATION_START"], route: "handoff", named: true, falseFailure: false,
      })
    })
  })
})

it.effect('Keep my saved places safe on this phone: saving the same place again replaces it, and a list that cannot be read is never written over (spec/maps/savedPlaces.md, "Story: Keep my saved places safe on this phone")', effect () => {
  provide KeyValueStore.layerMemory {
    try TestClock.adjust("1000 seconds")
    const saved = try savedPlaces("maps.saved.v1")
    const first = try saved.save({ label: "Ferry", coordinate: ferry, providerId: "google", providerPlaceId: "ferry" })
    const again = try saved.save({ label: "Ferry Building", coordinate: ferry, providerId: "google", providerPlaceId: "ferry" })
    try saved.save({ label: "Pin", coordinate: tower })
    const listed = try saved.host.list()
    const store = try KeyValueStore.KeyValueStore
    try store.set("maps.saved.v1", "{\"version\":2}")
    const refused = try Effect.flip(saved.save({ label: "Another", coordinate: here }))
    const kept = try store.get("maps.saved.v1")
    try Effect.try(() => assert.deepStrictEqual({ sameId: first.id === again.id, labels: listed.map((item) => item.label), refused: refused.code, kept },
      { sameId: true, labels: ["Ferry Building", "Pin"], refused: "storage", kept: "{\"version\":2}" }))
  }
})

function linkFake() {
  const bodies: Array<{ readonly path: string; readonly body: unknown; readonly key: boolean }> = []
  const link: MapsCloudLink = {
    async request(request) {
      bodies.push({ path: request.path, body: request.body, key: request.idempotencyKey !== undefined })
      const at = Date.now()
      const place = (id: string, name: string, coordinate: { readonly latitude: number; readonly longitude: number }, address?: string) => ({ providerId: "google", id, name, coordinate, attribution: "Google", fetchedAt: at, ...(address === undefined ? {} : { address }) })
      const chicagoUnion = place("union-chicago", "Union Station", { latitude: 41.8787, longitude: -87.6403 }, "225 S Canal St, Chicago, IL 60606, USA")
      const washingtonUnion = place("union-dc", "Union Station", { latitude: 38.8971, longitude: -77.0064 }, "50 Massachusetts Ave NE, Washington, DC 20002, USA")
      switch (request.path) {
        case "/api/v1/maps/capabilities": return { kind: "answered", status: 200, body: offer }
        case "/api/v1/maps/places/search": {
          const query = (request.body as { readonly query: string }).query
          if (query === "Golden Gate Park") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [place("park", "Golden Gate Park", { latitude: 37.7694, longitude: -122.4862 }, "San Francisco, CA, USA"), place("district", "Golden Gate Park", { latitude: 37.77, longitude: -122.47 }, "Golden Gate Park, San Francisco, CA, USA")] } }
          if (query === "Starbucks") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [place("market", "Starbucks", ferry, "1 Market St, San Francisco, CA, USA"), place("powell", "Starbucks", here, "201 Powell St, San Francisco, CA, USA")] } }
          if (query === "pharmacy") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [place("far", "Far Pharmacy", tower), place("near", "Near Pharmacy", ferry)] } }
          if (query === "Ferry Building") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [place("ferry", "Ferry Building", ferry)] } }
          if (query === "Union Station, Washington, DC") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [chicagoUnion, washingtonUnion] } }
          if (query === "Union Square") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [place("union-nyc", "Union Square", { latitude: 40.7359, longitude: -73.9911 }, "New York, NY 10003, USA"), place("union-sf", "Union Square", { latitude: 37.788, longitude: -122.4075 }, "San Francisco, CA 94108, USA")] } }
          if (query === "Union Station in Washington") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [chicagoUnion] } }
          if (query === "the Ferry Plaza") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [place("plaza", "Ferry Plaza", ferry, "San Francisco, CA, USA"), place("plaza-market", "Ferry Plaza Farmers Market", { latitude: 37.7956, longitude: -122.3935 }, "1 Ferry Building, San Francisco, CA, USA"), place("plaza-seafood", "Ferry Plaza Seafood", tower, "1 Telegraph Hill Blvd, San Francisco, CA, USA")] } }
          if (query === "Nowhere Plaza") return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [] } }
          if (query === "Broken Plaza") return { kind: "answered", status: 200, body: { providerId: "google", places: [] } }
          return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", places: [place("tower", "Coit Tower", tower)] } }
        }
        case "/api/v1/maps/places/details": {
          const id = (request.body as { readonly id: string }).id
          if (id === "refused-id") return { kind: "refused", status: 400, body: { error: "invalid_request" } }
          const known = [place("far", "Far Pharmacy", tower), place("near", "Near Pharmacy", ferry), place("tower", "Coit Tower", tower), place("union-sf", "Union Square", { latitude: 37.788, longitude: -122.4075 }, "San Francisco, CA 94108, USA")].find((item) => item.id === id)
          return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", place: known ?? null } }
        }
        case "/api/v1/maps/reverse": {
          const at = (request.body as { readonly coordinate: { readonly latitude: number } }).coordinate
          const sun = place("sun", "The Sun Building", { latitude: 40.7128, longitude: -74.006 }, "278 W Broadway, New York, NY 10006, USA")
          return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google", place: at.latitude === 40.7128 ? sun : at.latitude === 0 ? place("sea", "Gulf of Guinea", { latitude: 0, longitude: 0 }, "12345") : null } }
        }
        case "/api/v1/maps/routes": {
          const planned = (id: string, minutes: number) => ({ providerId: "google", id, from: ferry, to: tower, mode: "walk", geometry: [ferry, tower], distanceMeters: minutes * 80, durationSeconds: minutes * 60, steps: [], attribution: "Google", fetchedAt: at, traffic: "none" })
          return { kind: "answered", status: 200, body: { providerId: "google", attribution: "Google Maps Platform via Eliza Cloud", routes: [planned("best", 20), planned("other", 24)] } }
        }
        default: return { kind: "refused", status: 404, body: { error: "not_found" } }
      }
    },
  }
  return { link, bodies }
}

function locateCard(result: { readonly text?: string }) {
  const card = recognizedMapsCards(result.text ?? "")[0]?.card
  return card?.kind === "locate" ? [card.intent, card.query, card.destination?.name, card.travelMode] : card?.kind
}

function nearPlace(result: { readonly text?: string }) {
  const card = recognizedMapsCards(result.text ?? "")[0]?.card
  return card?.kind === "places" ? card.near?.name : undefined
}

function messageWith(location: unknown, text = "coffee near me"): Memory {
  const observation = { view: "maps", revision: 1, sensitive: false, ...(location === undefined ? {} : { location }) }
  return { entityId: "00000000-0000-4000-8000-000000000001", roomId: "00000000-0000-4000-8000-000000000002", content: { text, metadata: { observation } } } as unknown as Memory
}

it.live('Search near me with where my phone is now: a recent reported position searches around the phone at any accuracy, an old one asks the phone for its location, routes keep their alternatives and attribution, a route from here goes to the phone with its destination, a place named with its locality is never a namesake elsewhere, a landmark and its same-named area are one place while same-named branches still ask, a kind of place near a named place is searched around that place even when only the owner\'s words name it, a place not found or not one is said or asked, coordinates are looked up or searched around, a destination is searched around the start, a first result named as asked is taken with the parts of its site around it, a route planned without traffic is warned on its card, every answer is the action\'s own text and an unreachable Maps says asking again can help, and the card stays recognizable outside a fence (spec/maps/phonePosition.md, "Story: Search near me with where my phone is now"; spec/maps/phonePosition.md, "A kind of place near a named place is searched around that place, never around the phone"; spec/maps/phonePosition.md, "A reported position never becomes a route origin"; spec/maps/phonePosition.md, "Coordinates the owner names are looked up or searched around as given, never the phone\'s position"; spec/maps/attribution.md, "Story: Show the right copyright for the map I am looking at"; spec/maps/routing.md, "A place named with its locality is taken only from that locality, and otherwise Maps asks which one"; spec/maps/routing.md, "A route\'s destination that names no locality is taken from within 100 km of its start when any result is there"; spec/maps/routing.md, "Same-named areas close together are one place, and same-named street addresses still ask"; spec/maps/routing.md, "Only the owner\'s next turn answers an open question, by its position or the place\'s name, within ten minutes"; spec/maps/routing.md, "A first result named as asked is taken when the others are parts of it or mostly around it"; spec/maps/routing.md, "Every Maps answer is the action\'s own text, and a failure says whether asking again can help"; spec/maps/routing.md, "Places found around a point are listed nearest first with how far each is"; spec/maps/routing.md, "A route planned without any traffic says so on its card")', effect () => {
  const { link, bodies } = linkFake()
  const plugin = createMapsPlugin({ cloud: () => link, navigation: () => sync(() => undefined), savedPlaces: () => undefined, namesView: () => false })
  const runtime = {} as IAgentRuntime
  const act = (name: string, message: Memory, parameters: JsonObject) => promise(async () => {
    const action = plugin.actions?.find((found) => found.name === name)
    if (action === undefined) throw new Error(`${name} is not registered`)
    return await action.handler(runtime, message, undefined, { parameters })
  })
  const now = Date.now()
  const recent = messageWith({ latitude: here.latitude, longitude: here.longitude, accuracyMeters: 25, capturedAt: now - 60_000 })
  const old = messageWith({ latitude: here.latitude, longitude: here.longitude, capturedAt: now - 31 * 60_000 })
  const nearby = try act("MAPS_PLACE", recent, { query: "pharmacy", useCurrentLocation: true })
  const asked = try act("MAPS_PLACE", old, { query: "nearest pharmacy" })
  const nearBy = try act("MAPS_PLACE", old, { query: "pharmacy near by" })
  const route = try act("MAPS_ROUTE", recent, { origin: "Ferry Building", destination: "Coit Tower", travelMode: "walk" })
  const fromHere = try act("MAPS_ROUTE", recent, { origin: "here", destination: "Coit Tower" })
  const park = try act("MAPS_ROUTE", recent, { origin: "Ferry Building", destination: "Golden Gate Park", travelMode: "walk" })
  const chain = try act("MAPS_ROUTE", recent, { origin: "Ferry Building", destination: "Starbucks", travelMode: "walk" })
  const handoff = try act("MAPS_NAVIGATION_START", recent, { destination: "Coit Tower", travelMode: "walk" })
  const toLocality = try act("MAPS_ROUTE", recent, { origin: "Ferry Building", destination: "Union Station, Washington, DC", travelMode: "walk" })
  const namesake = try act("MAPS_ROUTE", recent, { origin: "Ferry Building", destination: "Union Station in Washington", travelMode: "walk" })
  const anchored = try act("MAPS_PLACE", old, { query: "pharmacy near the Ferry Building", useCurrentLocation: true })
  const aroundStart = try act("MAPS_ROUTE", recent, { origin: "Ferry Building", destination: "Union Square", travelMode: "walk" })
  const anywhere = try act("MAPS_SELECT", recent, { query: "Union Square" })
  const site = try act("MAPS_SELECT", recent, { query: "the Ferry Plaza" })
  const unreachable = createMapsPlugin({ cloud: () => ({ async request() { throw new Error("Cloud is unreachable") } }), navigation: () => sync(() => undefined), savedPlaces: () => undefined, namesView: () => false })
  const down = try promise(async () => await unreachable.actions?.find((found) => found.name === "MAPS_COVERAGE")?.handler(runtime, recent, undefined, { parameters: {} }))
  const provider = try promise(() => phonePositionProvider.get(runtime, recent, {} as never))
  const rough = try act("MAPS_PLACE", messageWith({ latitude: here.latitude, longitude: here.longitude, accuracyMeters: 25_000, capturedAt: now - 60_000 }), { query: "pharmacy", useCurrentLocation: true })
  const tail = try act("MAPS_PLACE", recent, { query: "coffee near me right now" })
  const ownWords = try act("MAPS_PLACE", messageWith({ latitude: here.latitude, longitude: here.longitude, capturedAt: now - 31 * 60_000 }, "pharmacy near the Ferry Building"), { query: "pharmacy", useCurrentLocation: true })
  const notFound = try act("MAPS_PLACE", old, { query: "pharmacy near Nowhere Plaza" })
  const pointAt = try act("MAPS_PLACE", old, { latitude: 40.7128, longitude: -74.006 })
  const pointNear = try act("MAPS_PLACE", old, { query: "pharmacy", latitude: tower.latitude, longitude: tower.longitude })
  const outOfRange = try act("MAPS_PLACE", old, { latitude: 95, longitude: 0 })
  const nearestFromHere = try act("MAPS_ROUTE", old, { destination: "nearest pharmacy", travelMode: "walk" })
  const namesakeFromHere = try act("MAPS_ROUTE", old, { origin: "my current location", destination: "Union Square" })
  const whichAnchor = try act("MAPS_PLACE", recent, { query: "pharmacy near Union Square" })
  const second = try act("MAPS_PLACE", messageWith(undefined, "the second one"), {})
  const routeText = route.text ?? ""
  const nearByCard = recognizedMapsCards(nearBy.text ?? "")[0]?.card
  const fenced = `\`\`\`\n${appendMapsCard("", { kind: "place", place: { name: "X", latitude: 1, longitude: 1, provider: "p", providerPlaceId: "x", categories: [] }, attribution: null })}\n\`\`\``
  const searched = bodies.find((made) => made.path === "/api/v1/maps/places/search")
  const searchedNear = (query: string) => bodies.filter((made) => made.path === "/api/v1/maps/places/search" && (made.body as { readonly query: string }).query === query)
    .map((made) => (made.body as { readonly near?: unknown }).near)
  try Effect.try(() => assert.deepStrictEqual({
    nearby: [nearby.success, (nearby.data as { readonly places: ReadonlyArray<{ readonly providerPlaceId: string }> }).places.map((item) => item.providerPlaceId)],
    searchedNear: (searched?.body as { readonly near?: unknown } | undefined)?.near, keyed: searched?.key,
    asked: [asked.success, (asked.data as { readonly state: string }).state, recognizedMapsCards(asked.text ?? "")[0]?.card.kind],
    nearBy: [nearBy.success, nearByCard?.kind, nearByCard?.kind === "locate" ? nearByCard.query : undefined],
    route: [route.success, routeText.includes("Alternatives: 1. 20 min"), routeText.includes("Google Maps Platform via Eliza Cloud"), recognizedMapsCards(routeText).map((found) => found.card.kind === "route" ? found.card.warnings : found.card.kind)],
    plain: withoutMapsCards(routeText).includes("MAPSCARD"),
    fromHere: [fromHere.success, locateCard(fromHere)],
    landmark: [park.success, chain.success, (chain.data as { readonly choice?: string }).choice],
    handoff: recognizedMapsCards(handoff.text ?? "")[0]?.card.kind,
    localities: [
      [toLocality.success, (toLocality.data as { readonly destination?: { readonly providerPlaceId: string } }).destination?.providerPlaceId],
      [namesake.success, (namesake.data as { readonly choice?: string }).choice],
    ],
    anchored: [anchored.success, (anchored.text ?? "").startsWith("Near Ferry Building:"), searchedNear("pharmacy")[1], nearPlace(anchored)],
    aroundStart: [aroundStart.success, (aroundStart.data as { readonly destination?: { readonly providerPlaceId: string } }).destination?.providerPlaceId, searchedNear("Union Square")[0]],
    anywhere: [anywhere.success, (anywhere.data as { readonly choice?: string }).choice],
    site: [site.success, (site.data as { readonly place?: { readonly providerPlaceId: string } }).place?.providerPlaceId],
    ownWordsShown: [route.verifiedUserFacing, route.userFacingText === route.text, chain.verifiedUserFacing, chain.userFacingText === chain.text],
    down: [down?.success, down?.data],
    provider: provider.values,
    fenced: recognizedMapsCards(fenced).length,
    kinds: [nearbyPlaceKind("the nearest pharmacy"), nearbyPlaceKind("round to the nearest dollar"), nearbyPlaceKind("coffee near me"), nearbyPlaceKind("coffee near me, thanks"),
      nearbyPlaceKind("gas near where I am right now"), nearbyPlaceKind("food near my phone"), nearbyPlaceKind("the nearest pharmacy to me"), nearbyPlaceKind("the nearest pharmacy to the Ferry Building")],
    rough: [rough.success, searchedNear("pharmacy")[2]],
    tail: [tail.success, searchedNear("coffee")],
    ownWords: [ownWords.success, (ownWords.text ?? "").startsWith("Near Ferry Building:"), searchedNear("pharmacy")[3]],
    notFound: [notFound.success, notFound.text],
    points: [pointAt.success, withoutMapsCards(pointAt.userFacingText ?? ""), pointNear.success, searchedNear("pharmacy")[4], outOfRange.success],
    fromHereCards: [locateCard(nearestFromHere), locateCard(namesakeFromHere)],
    whichAnchor: [whichAnchor.success, (whichAnchor.data as { readonly choice?: string }).choice],
    second: [second.success, (second.text ?? "").startsWith("Near Union Square:"), searchedNear("pharmacy")[5]],
  }, {
    nearby: [true, ["near", "far"]],
    searchedNear: { latitude: here.latitude, longitude: here.longitude }, keyed: true,
    asked: [false, "awaiting-location", "locate"],
    nearBy: [false, "locate", "pharmacy"],
    route: [true, true, true, [["No live traffic."]]],
    plain: false,
    fromHere: [false, ["route-origin", undefined, "Coit Tower", undefined]],
    landmark: [true, false, "destination"],
    handoff: "handoff",
    localities: [[true, "union-dc"], [false, "destination"]],
    anchored: [true, true, ferry, "Ferry Building"],
    aroundStart: [true, "union-sf", ferry],
    anywhere: [false, "place"],
    site: [true, "plaza"],
    ownWordsShown: [true, true, true, true],
    down: [false, { code: "offline", retryable: true }],
    provider: { phonePositionAvailable: true },
    fenced: 0,
    kinds: ["pharmacy", undefined, "coffee", "coffee", "gas", "food", "pharmacy", undefined],
    rough: [true, { latitude: here.latitude, longitude: here.longitude }],
    tail: [true, [{ latitude: here.latitude, longitude: here.longitude }]],
    ownWords: [true, true, ferry],
    notFound: [false, "I couldn't find “Nowhere Plaza” to search near. Name another place or area to search near."],
    points: [true, "The Sun Building — 278 W Broadway, New York, NY 10006, USA", true, tower, false],
    fromHereCards: [["route-origin", "nearest pharmacy", undefined, "walk"], ["route-origin", "Union Square", undefined, undefined]],
    whichAnchor: [false, "place to search near"],
    second: [true, true, { latitude: 37.788, longitude: -122.4075 }],
  }))
})

it.live('Ask where I am: a recent precise position names the place there, a rough one names only its area with no card, and an old one looks nothing up (spec/maps/phonePosition.md, "Story: Ask where I am"; spec/maps/phonePosition.md, "Where I am is the place at my phone\'s recent position, and only its area when that position is rough")', effect () => {
  const { link, bodies } = linkFake()
  const plugin = createMapsPlugin({ cloud: () => link, navigation: () => sync(() => undefined), savedPlaces: () => undefined, namesView: () => false })
  const action = plugin.actions?.find((found) => found.name === "MAPS_PLACE")
  const ask = (location: unknown) => promise(async () => {
    if (action === undefined) throw new Error("MAPS_PLACE is not registered")
    return await action.handler({} as IAgentRuntime, messageWith(location), undefined, { parameters: { useCurrentLocation: true } })
  })
  const now = Date.now()
  const nyc = { latitude: 40.7128, longitude: -74.006 }
  const rough = try ask({ ...nyc, accuracyMeters: 25_000, capturedAt: now - 60_000 })
  const precise = try ask({ ...nyc, accuracyMeters: 20, capturedAt: now - 60_000 })
  const unknownArea = try ask({ latitude: 0, longitude: 0, accuracyMeters: 1_500, capturedAt: now })
  const nothing = try ask({ latitude: 1, longitude: 1, capturedAt: now })
  const before = bodies.length
  const old = try ask({ ...nyc, accuracyMeters: 20, capturedAt: now - 31 * 60_000 })
  const missing = try ask(undefined)
  const shown = (result: { readonly userFacingText?: string; readonly text?: string }) => [result.userFacingText, recognizedMapsCards(result.text ?? "").map((found) => found.card.kind)]
  try Effect.try(() => assert.deepStrictEqual({
    rough: [...shown(rough), rough.data], precise: [precise.success, withoutMapsCards(precise.userFacingText ?? ""), recognizedMapsCards(precise.text ?? "").map((found) => found.card.kind)],
    unknownArea: shown(unknownArea), nothing: shown(nothing), lookups: bodies.length - before,
    old: [old.success, old.text], missing: [missing.success, missing.data],
    areas: [addressArea("278 W Broadway, New York, NY 10006, USA"), addressArea("Unter den Linden 77, 10117 Berlin, Germany"), addressArea("Paris, France"), addressArea("12345")],
  }, {
    rough: ["Your phone's position is approximate (within about 25 km): somewhere around New York, NY, USA.", [], { status: "approximate", accuracyMeters: 25_000, area: "New York, NY, USA", place: null }],
    precise: [true, "The Sun Building — 278 W Broadway, New York, NY 10006, USA", ["place"]],
    unknownArea: ["Your phone's position is approximate (within about 1.5 km), and no area is known there.", []],
    nothing: ["No named place is known where your phone is.", []], lookups: 0,
    old: [false, "Your phone didn't report a recent position with this message, so I can't tell where you are."], missing: [false, { state: "no-position" }],
    areas: ["New York, NY, USA", "Berlin, Germany", "Paris, France", undefined],
  }))
})

it.live('Keep one location watch and clean up stale callbacks and handles: listeners attach before the watch, a grant received while hidden waits for the screen, a stale fix is skipped, an invalid one ends the watch, and cleanup is confirmed (spec/maps/navigationService.md, "Story: Keep one location watch and clean up stale callbacks and handles")', effect () => {
  const order: string[] = []
  const listeners: { fix?: (fix: NativeFix) => void } = {}
  let hidden = true
  const waitingForVisibility = try Deferred.make<void>()
  const shown = try Deferred.make<void>()
  const watchCleared = try Deferred.make<void>()
  const location = try nativeMapsLocation({
    checkPermissions: () => sync(() => ({ location: "prompt" as const })),
    requestPermissions: () => sync(() => {
      order.push("prompt")
      return { location: "granted" as const, accuracy: "precise" as const }
    }),
    cancelPermissionRequest: () => sync(() => { order.push("cancel") }),
    watchPosition: () => sync(() => {
      order.push("watch")
      return { watchId: "w1" }
    }),
    clearWatch: (watchId) => effect {
      order.push(`clear:${watchId}`)
      try Deferred.succeed(watchCleared, undefined)
    },
    onFix: (listener) => sync(() => {
      order.push("fixes")
      listeners.fix = listener
      return sync(() => { order.push("remove:fixes") })
    }),
    onError: () => sync(() => {
      order.push("errors")
      return sync(() => { order.push("remove:errors") })
    }),
  }, {
    isNative: () => true,
    available: () => true,
    hidden: () => hidden,
    visible: () => effect {
      try Deferred.succeed(waitingForVisibility, undefined)
      try Deferred.await(shown)
    },
  })
  const fixes: number[] = []
  const errors: string[] = []
  const starting = fork location.start(false, (position) => { fixes.push(position.accuracyMeters) }, (error) => { errors.push(error.code) })
  try Deferred.await(waitingForVisibility)
  const waiting = [...order]
  hidden = false
  try Deferred.succeed(shown, undefined)
  try join starting
  const now = Date.now()
  listeners.fix?.({ coords: { latitude: here.latitude, longitude: here.longitude, accuracy: 8, timestamp: now } })
  listeners.fix?.({ coords: { latitude: here.latitude, longitude: here.longitude, accuracy: 9, timestamp: now - 60_000 } })
  listeners.fix?.({ coords: { latitude: 200, longitude: here.longitude, accuracy: 9, timestamp: now } })
  try Deferred.await(watchCleared)
  try Effect.try(() => assert.deepStrictEqual({ waiting, order, fixes, errors },
    { waiting: ["prompt"], order: ["prompt", "fixes", "errors", "watch", "remove:fixes", "remove:errors", "clear:w1"], fixes: [8], errors: ["invalid-response"] }))
})

function memoryStore(): AgentSavedPlaceStore {
  const documents = new Map<string, { readonly revision: number; readonly text: string }>()
  return {
    read: (owner) => sync(() => documents.get(owner)),
    write: (owner, expected, text) => sync(() => {
      const current = documents.get(owner)
      if (current?.revision !== expected) return false
      documents.set(owner, { revision: (current?.revision ?? 0) + 1, text })
      return true
    }),
  }
}

function ownerTurn(text: string, roomId = "00000000-0000-4000-8000-000000000002", id?: string): Memory {
  return { ...(id === undefined ? {} : { id }), entityId: "00000000-0000-4000-8000-000000000001", roomId, content: { text, source: "device" } } as unknown as Memory
}

it.live('Save a place with my assistant once, and answer the question Maps asked: a repeat saves nothing, a superseded repeat is a new change, a reused key is refused, a saved place or named coordinates can be the destination, "the second one" continues the request that asked only on my next turn, a place\'s name answers too, a route keeps its destination for my next turn, and a plain Maps request owns the whole message so a view switch is refused (spec/maps/savedPlaces.md, "Story: Save a place with my assistant once"; spec/maps/savedPlaces.md, "A destination may be a place saved with the assistant, or coordinates the owner names"; spec/maps/routing.md, "Story: Send my directions request to Maps, not to a view"; spec/maps/routing.md, "Only the owner\'s next turn answers an open question, by its position or the place\'s name, within ten minutes"; spec/maps/routing.md, "A route\'s settled end is kept for the owner\'s next turn, which may name only the other")', effect () => {
  const { link } = linkFake()
  const store = memoryStore()
  const plugin = createMapsPlugin({ cloud: () => link, navigation: () => sync(() => undefined), savedPlaces: () => store, namesView: (_runtime, destination) => destination === "settings" })
  const runtime = { contexts: { tryRegister: () => true } } as unknown as IAgentRuntime
  try promise(async () => await plugin.init?.({}, runtime))
  const owned = (message: Memory) => Effect.try(() => getDirectActionRoutingRules(runtime)
    .filter((rule) => rule.wholeRequest?.matches(typeof message.content.text === "string" ? message.content.text : "", message) === true)
    .map((rule) => [rule.id, ...(rule.replacesActionNames ?? [])]))
  const act = (name: string, message: Memory, parameters: JsonObject) => promise(async () => {
    const action = plugin.actions?.find((found) => found.name === name)
    if (action === undefined) throw new Error(`${name} is not registered`)
    return await action.handler(runtime, message, undefined, { parameters })
  })
  const turn = ownerTurn("save Coit Tower as Work")
  const work = try act("MAPS_SAVE", turn, { query: "Coit Tower", label: "Work" })
  const again = try act("MAPS_SAVE", turn, { query: "Coit Tower", label: "Work" })
  const home = try act("MAPS_SAVE", turn, { query: "Coit Tower", label: "Home" })
  const back = try act("MAPS_SAVE", turn, { query: "Coit Tower", label: "Work" })
  const keyed = try act("MAPS_SAVE", turn, { query: "Coit Tower", label: "Office", idempotencyKey: "k1" })
  const reused = try act("MAPS_SAVE", turn, { query: "Coit Tower", label: "Gym", idempotencyKey: "k1" })
  const listed = try act("MAPS_SAVED", turn, {})
  const office = (listed.data as { readonly savedPlaces: ReadonlyArray<{ readonly id: string }> }).savedPlaces[0]?.id ?? ""
  const toSaved = try act("MAPS_NAVIGATION_START", turn, { savedPlaceId: office })
  const toUnsaved = try act("MAPS_NAVIGATION_START", turn, { savedPlaceId: "maps-place:unknown" })
  const toPoint = try act("MAPS_NAVIGATION_START", turn, { destination: "Trailhead", latitude: 37.8, longitude: -122.4 })
  const asked = try act("MAPS_NAVIGATION_START", ownerTurn("take me to the pharmacy"), { destination: "pharmacy" })
  const answered = try act("MAPS_NAVIGATION_START", ownerTurn("the second one"), {})
  const elsewhere = try act("MAPS_NAVIGATION_START", ownerTurn("the second one", "00000000-0000-4000-8000-000000000003"), {})
  const room = "00000000-0000-4000-8000-000000000004"
  const turnId = (index: number) => `00000000-0000-4000-8000-0000000000b${index}`
  const askedFirst = try act("MAPS_NAVIGATION_START", ownerTurn("take me to the pharmacy", room, turnId(1)), { destination: "pharmacy" })
  const movedOn = try owned(ownerTurn("call mom", room, turnId(2)))
  const tooLate = try act("MAPS_NAVIGATION_START", ownerTurn("the second one", room, turnId(3)), {})
  const askedAgain = try act("MAPS_NAVIGATION_START", ownerTurn("take me to the pharmacy", room, turnId(4)), { destination: "pharmacy" })
  const byName = try act("MAPS_NAVIGATION_START", ownerTurn("Near Pharmacy", room, turnId(5)), {})
  const fromHere = try act("MAPS_ROUTE", ownerTurn("walking directions to Coit Tower", room, turnId(6)), { destination: "Coit Tower", travelMode: "walk" })
  const fromFerry = try act("MAPS_ROUTE", ownerTurn("from the Ferry Building", room, turnId(7)), { origin: "Ferry Building" })
  const nothingKept = try act("MAPS_ROUTE", ownerTurn("from the Ferry Building", room, turnId(8)), { origin: "Ferry Building" })
  const ownedRequests = [try owned(ownerTurn("directions to Coit Tower")), try owned(ownerTurn("take me to settings")), try owned(ownerTurn("what is the capital of France?"))]
  const routes = [
    routeOf("directions to Coit Tower", ownerTurn("directions to Coit Tower"), false, () => false),
    routeOf("take me to Coit Tower", { ...ownerTurn("x"), content: { text: "x", source: "device", channelType: "VOICE_DM" } } as unknown as Memory, false, () => false),
    routeOf("take me to settings", ownerTurn("take me to settings"), false, (destination) => destination === "settings"),
    routeOf("take me to Coit Tower then text Sam", ownerTurn("x"), false, () => false),
    routeOf("find the nearest pharmacy", ownerTurn("x"), false, () => false),
    routeOf("directions to Coit Tower", { ...ownerTurn("x"), content: { text: "x", source: "discord", channelType: "GROUP" } } as unknown as Memory, false, () => false),
    routeOf("directions to assemble the shelf", ownerTurn("x"), false, () => false),
    ...["go to coit tower", "go to the ferry building", "go to SFO", "go to UCSF Medical Center", "go to Starbucks", "go to the Presidio",
      "go to US 101", "go to gate 12", "go to la jolla",
      "go to Sam", "go to Notion", "go to sleep", "go to the PDF", "go to my inbox", "go to the right place", "go to main branch", "go to test results"]
      .map((text) => routeOf(text, ownerTurn(text), false, () => false)),
    routeOf("how do I get to see the Eiffel Tower", ownerTurn("x"), false, () => false),
    routeOf("how do I get to See's Candies?", ownerTurn("x"), false, () => false),
    routeOf("how do I get to talk to a real person?", ownerTurn("x"), false, () => false),
    routeOf("How can I get to see my test results?", ownerTurn("x"), false, () => false),
    routeOf("find a pharmacy near the Ferry Building", ownerTurn("x"), false, () => false),
    routeOf("what's the weather near Austin", ownerTurn("x"), false, () => false),
    routeOf("is there traffic near the Bay Bridge", ownerTurn("x"), false, () => false),
    routeOf("show me photos near the Ferry Building", ownerTurn("x"), false, () => false),
    routeOf("find a hotel around Christmas", ownerTurn("x"), false, () => false),
    routeOf("show me the route to the settings page", ownerTurn("x"), false, () => false),
    routeOf("what's the weather near Times Square", ownerTurn("x"), false, () => false),
    routeOf("find coffee near Union Square", ownerTurn("x"), false, () => false),
    routeOf("what's the weather near me", ownerTurn("x"), false, () => false),
    routeOf("weather near me", ownerTurn("x"), false, () => false),
    routeOf("any weather nearby", ownerTurn("x"), false, () => false),
    routeOf("any coffee nearby", ownerTurn("x"), false, () => false),
  ]
  const receipt = (result: { readonly effectReceipts?: ReadonlyArray<{ readonly outcome: string }> }) => result.effectReceipts?.[0]?.outcome
  try Effect.try(() => assert.deepStrictEqual({
    saves: [[work.success, receipt(work)], [again.success, receipt(again), again.text], [home.success, receipt(home)], [back.success, receipt(back)], [keyed.success, receipt(keyed)], reused.success],
    reusedCanRetry: (reused.data as { readonly retryable?: boolean }).retryable,
    listed: (listed.data as { readonly savedPlaces: ReadonlyArray<{ readonly label: string }> }).savedPlaces.map((saved) => saved.label),
    phoneListLeftOut: (listed.text ?? "").endsWith("Places saved only on the phone's Maps screen aren't included."),
    destinations: [toSaved, toUnsaved, toPoint].map((result) => {
      const destination = (result.data as { readonly destination?: { readonly provider: string; readonly providerPlaceId: string; readonly name: string } }).destination
      return [result.success, destination?.provider, destination?.providerPlaceId, destination?.name]
    }),
    nextTurnOnly: [askedFirst.success, movedOn, tooLate.success, askedAgain.success],
    byName: [byName.success, (byName.data as { readonly destination?: { readonly providerPlaceId: string } }).destination?.providerPlaceId],
    continued: [
      [fromHere.success, locateCard(fromHere)],
      [fromFerry.success, (fromFerry.data as { readonly destination?: { readonly providerPlaceId: string } }).destination?.providerPlaceId, (fromFerry.data as { readonly travelMode?: string }).travelMode],
      nothingKept.success,
    ],
    ownedRequests,
    contexts: [...new Set(plugin.actions?.flatMap((action) => action.contexts ?? []))],
    asked: [asked.success, (asked.data as { readonly choice?: string }).choice],
    answered: [answered.success, (answered.data as { readonly destination?: { readonly providerPlaceId: string } }).destination?.providerPlaceId],
    elsewhere: elsewhere.success,
    routes,
  }, {
    saves: [[true, "applied"], [true, "noop", "Work was already saved."], [true, "applied"], [true, "applied"], [true, "applied"], false],
    reusedCanRetry: false,
    listed: ["Office"],
    phoneListLeftOut: true,
    destinations: [[true, "eliza-cloud", "tower", "Coit Tower"], [false, undefined, undefined, undefined], [true, "coordinates", "coordinates:37.8,-122.4", "Trailhead"]],
    nextTurnOnly: [false, [], false, false],
    byName: [true, "near"],
    continued: [[false, ["route-origin", undefined, "Coit Tower", "walk"]], [true, "tower", "walk"], false],
    ownedRequests: [[["maps.ToDirections", "VIEWS", "VIEWS_SHOW"]], [], []],
    contexts: ["maps", "general"],
    asked: [false, "destination"],
    answered: [true, "near"],
    elsewhere: false,
    routes: ["ToDirections", "ToTravel", "ToPlanner", "ToPlanner", "ToPlaceSearch", "ToPlanner", "ToPlanner",
      "ToTravel", "ToTravel", "ToTravel", "ToTravel", "ToTravel", "ToTravel", "ToTravel", "ToTravel", "ToTravel",
      "ToPlanner", "ToPlanner", "ToPlanner", "ToPlanner", "ToPlanner", "ToPlanner", "ToPlanner", "ToPlanner",
      "ToTravel", "ToTravel", "ToPlanner", "ToPlanner",
      "ToPlaceSearch", "ToPlanner", "ToPlanner", "ToPlanner", "ToPlanner",
      "ToPlanner", "ToPlanner", "ToPlaceSearch", "ToPlanner", "ToPlanner", "ToPlanner", "ToPlaceSearch"],
  }))
})

it.live('Share a place only once I agree, and hear where Maps works: the asking turn shares nothing, my later yes shares its map links, a no shares nothing, and coverage states only what Cloud reports (spec/maps/routing.md, "Story: Share a place only once I agree, and hear where Maps works"; spec/maps/routing.md, "A place\'s location is shared only after the owner\'s own later yes to sharing that place"; spec/maps/routing.md, "Asked where Maps works, the reply states only what Cloud Maps reports")', effect () => {
  const { link } = linkFake()
  const plugin = createMapsPlugin({ cloud: () => link, navigation: () => sync(() => undefined), savedPlaces: () => undefined, namesView: () => false })
  const cache = new Map<string, unknown>()
  const runtime = {
    getCache: async (key: string) => cache.get(key),
    setCache: async (key: string, value: unknown) => {
      cache.set(key, value)
      return true
    },
    deleteCache: async (key: string) => cache.delete(key),
  } as unknown as IAgentRuntime
  const act = (name: string, text: string, id: string, parameters: JsonObject) => promise(async () => {
    const action = plugin.actions?.find((found) => found.name === name)
    if (action === undefined) throw new Error(`${name} is not registered`)
    return await action.handler(runtime, { ...ownerTurn(text), id } as Memory, undefined, { parameters })
  })
  const ferryBuilding = { query: "Ferry Building" }
  const asked = try act("MAPS_SHARE", "share the Ferry Building", "00000000-0000-4000-8000-0000000000a1", ferryBuilding)
  const yes = try act("MAPS_SHARE", "yes", "00000000-0000-4000-8000-0000000000a2", ferryBuilding)
  const again = try act("MAPS_SHARE", "share the Ferry Building", "00000000-0000-4000-8000-0000000000a3", ferryBuilding)
  const no = try act("MAPS_SHARE", "no", "00000000-0000-4000-8000-0000000000a4", ferryBuilding)
  const coverage = try act("MAPS_COVERAGE", "where does Maps work?", "00000000-0000-4000-8000-0000000000a5", {})
  const shared = recognizedMapsCards(yes.text ?? "")[0]?.card
  try Effect.try(() => assert.deepStrictEqual({
    asked: [asked.success, asked.text, (asked.data as { readonly state?: string }).state],
    yes: [yes.success, shared?.kind === "handoff" ? [shared.handoffKind, shared.geoUri, shared.webUri] : shared?.kind],
    again: again.success, no: [no.success, no.text],
    coverage: [coverage.success, coverage.text],
  }, {
    asked: [false, "Share the location of Ferry Building?", "confirmation-required"],
    yes: [true, ["share", "geo:37.7955,-122.3937?q=37.7955,-122.3937(Ferry%20Building)", "https://www.openstreetmap.org/?mlat=37.7955&mlon=-122.3937#map=17/37.7955/-122.3937"]],
    again: false, no: [false, "Not shared."],
    coverage: [true, "Maps covers World (dataset 2026-11). Routes: driving and walking, with alternatives. No transit schedules or offline use. Searches, search areas and route points are sent to Eliza Cloud and Google Maps Platform for search, operated by Google. Data: Google Maps Platform via Eliza Cloud"],
  }))
})

it.live('Ask for directions to the place on my phone\'s map: a selection handle alone is sent back to the planner with nothing looked up, a handle beside the place\'s name is found by name, a place id Cloud refuses falls back to the name, a choice reply still continues, "where am I" with a handle still answers, the place shown on the phone carries its provider id, and an answer Maps cannot use names the place (spec/maps/routing.md, "Story: Ask for directions to the place on my phone\'s map"; spec/maps/routing.md, "A Maps screen selection asks the planner to name the place"; spec/maps/routing.md, "A place id Cloud refuses or no longer knows falls back to the place\'s name"; spec/maps/routing.md, "An answer Maps cannot use is said in the owner\'s words, naming the place a start could not look up")', effect () => {
  const { link, bodies } = linkFake()
  const handle = "maps_3b0f6a52-6a4e-4c1b-9d55-0d1f2e3a4b5c"
  const phone: MapsDeviceNavigation = {
    available: () => sync(() => true),
    select: (place) => sync(() => ({ state: "selected" as const, placeName: place.name })),
    start: ({ destination }) => sync(() => ({ state: "awaiting-confirmation" as const, placeName: destination.name })),
    reroute: () => sync(() => ({ state: "stopped" as const })),
    stop: () => sync(() => ({ state: "stopped" as const })),
  }
  const plugin = createMapsPlugin({ cloud: () => link, navigation: () => sync(() => phone), savedPlaces: () => memoryStore(), namesView: () => false })
  const runtime = {} as IAgentRuntime
  const act = (name: string, text: string, parameters: JsonObject) => promise(async () => {
    const action = plugin.actions?.find((found) => found.name === name)
    if (action === undefined) throw new Error(`${name} is not registered`)
    return await action.handler(runtime, ownerTurn(text, "00000000-0000-4000-8000-000000000009"), undefined, { parameters })
  })
  const sentBack = (result: { readonly success: boolean; readonly error?: unknown; readonly transcriptVisibility?: string; readonly data?: unknown }) => {
    const data = result.data as { readonly field?: string; readonly coachingFailure?: boolean }
    return [result.success, result.error, result.transcriptVisibility, data.field, data.coachingFailure]
  }
  const said = (result: { readonly success: boolean; readonly text?: string }) => [result.success, result.text]
  const placeOf = (result: { readonly data?: unknown }) => (result.data as { readonly place?: { readonly providerPlaceId: string } }).place?.providerPlaceId
  const before = bodies.length
  const select = try act("MAPS_SELECT", "show it on the map", { placeId: handle })
  const save = try act("MAPS_SAVE", "save it as Work", { placeId: handle, label: "Work" })
  const share = try act("MAPS_SHARE", "share it", { placeId: handle })
  const start = try act("MAPS_NAVIGATION_START", "directions to it", { placeId: handle })
  const place = try act("MAPS_PLACE", "what is it", { placeId: handle })
  const toIt = try act("MAPS_ROUTE", "how far is it from the Ferry Building", { origin: "Ferry Building", destinationPlaceId: handle })
  const fromIt = try act("MAPS_ROUTE", "how far is Coit Tower from it", { originPlaceId: handle, destination: "Coit Tower" })
  const lookedUpForHandles = bodies.length - before
  const shown = try act("MAPS_SELECT", "show Coit Tower", { placeId: handle, query: "Coit Tower" })
  const directions = try act("MAPS_NAVIGATION_START", "directions to it", { placeId: placeOf(shown) ?? "" })
  const routedByName = try act("MAPS_ROUTE", "walk from the Ferry Building to Coit Tower", { origin: "Ferry Building", destination: "Coit Tower", destinationPlaceId: handle, travelMode: "walk" })
  const refusedWithName = try act("MAPS_SELECT", "show Coit Tower", { placeId: "refused-id", query: "Coit Tower" })
  const refusedAlone = try act("MAPS_SELECT", "show it", { placeId: "refused-id" })
  const asked = try act("MAPS_NAVIGATION_START", "take me to the pharmacy", { destination: "pharmacy" })
  const picked = try act("MAPS_NAVIGATION_START", "the first one", { placeId: handle })
  const broken = try act("MAPS_NAVIGATION_START", "take me to Broken Plaza", { destination: "Broken Plaza" })
  const brokenSearch = try act("MAPS_PLACE", "find Broken Plaza", { query: "Broken Plaza" })
  const fromHere = try act("MAPS_ROUTE", "how far is Coit Tower from here", { originPlaceId: handle, destination: "Coit Tower", useCurrentLocation: true })
  const atPoint = try act("MAPS_PLACE", "what is at 37.8024, -122.4058", { placeId: handle, latitude: 37.8024, longitude: -122.4058 })
  const whereAmI = try act("MAPS_PLACE", "where am I", { placeId: handle, useCurrentLocation: true })
  const handleSentToCloud = bodies.some((made) => made.path === "/api/v1/maps/places/details" && (made.body as { readonly id: string }).id === handle)
  try Effect.try(() => assert.deepStrictEqual({
    handleOnly: [select, save, share, start, place, toIt, fromIt].map(sentBack), lookedUpForHandles, handleSentToCloud,
    shown: [shown.success, placeOf(shown)], directions: said(directions), routedByName: routedByName.success,
    refusedWithName: [refusedWithName.success, placeOf(refusedWithName)], refusedAlone: said(refusedAlone),
    asked: [asked.success, (asked.data as { readonly choice?: string }).choice], picked: said(picked),
    broken: said(broken), brokenSearch: said(brokenSearch),
    placedOtherwise: [fromHere, atPoint, whereAmI].map((result) => (result.data as { readonly coachingFailure?: boolean } | undefined)?.coachingFailure === true),
    whereAmI: said(whereAmI),
  }, {
    handleOnly: [
      [false, "MAPS_SELECTION_HANDLE", "internal", "placeId", true], [false, "MAPS_SELECTION_HANDLE", "internal", "placeId", true],
      [false, "MAPS_SELECTION_HANDLE", "internal", "placeId", true], [false, "MAPS_SELECTION_HANDLE", "internal", "placeId", true],
      [false, "MAPS_SELECTION_HANDLE", "internal", "placeId", true], [false, "MAPS_SELECTION_HANDLE", "internal", "destinationPlaceId", true],
      [false, "MAPS_SELECTION_HANDLE", "internal", "originPlaceId", true],
    ],
    lookedUpForHandles: 0, handleSentToCloud: false,
    shown: [true, "tower"], directions: [true, "The route to Coit Tower is on your phone. Press Start on the phone to begin guidance."], routedByName: true,
    refusedWithName: [true, "tower"], refusedAlone: [false, "Cloud Maps could not use this request."],
    asked: [false, "destination"], picked: [true, "The route to Far Pharmacy is on your phone. Press Start on the phone to begin guidance."],
    broken: [false, "Maps couldn't look up Broken Plaza right now, so the route isn't planned. Try again in a moment."],
    brokenSearch: [false, "Maps got an answer it couldn't use. Try again in a moment."],
    placedOtherwise: [false, false, false],
    whereAmI: [false, "Your phone didn't report a recent position with this message, so I can't tell where you are."],
  }))
})
