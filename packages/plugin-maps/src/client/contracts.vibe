// spec/maps/cloudConnection.md, "Maps requests and tiles retain the captured account through completion"; spec/maps/attribution.md, "Only the reply to the latest request, for the current view, is shown"; spec/maps/navigation.md, "A valid agent request prepares a route and never turns on guidance itself"
module browser {
  /** @throws {never} */
  export function webAddress(value: string): boolean {
    const url = URL.parse(value)
    return url !== null && (url.protocol === "https:" || url.protocol === "http:") && url.username === "" && url.password === "" && value.length <= 2048
  }
}
import { webAddress } from browser

// eslint-disable-next-line no-control-regex -- Maps display text allows tab and line breaks and rejects the listed C0 controls.
const controlCharacters = /[\u0000-\u0008\u000b\u000c\u000e-\u001f]/

export function boundedText(value: unknown, limit: number): value is string {
  return typeof value === "string" && value.trim().length > 0 && value.length <= limit && !controlCharacters.test(value)
}

const Text = (limit: number) => Schema.String.check(Schema.makeFilter((value: string) => boundedText(value, limit)))
const Between = (minimum: number, maximum: number) => Schema.Finite.check(Schema.isBetween({ minimum, maximum }))
const Meters = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0))
const Instant = Text(40).check(Schema.makeFilter((value: string) => Number.isFinite(Date.parse(value))))

export const travelModes = ["drive", "walk", "bicycle", "transit"] as const
export const TravelMode = Schema.Literals(travelModes)
export type TravelMode = typeof TravelMode.Type

export const Maneuver = Schema.Literals(["depart", "continue", "slight-left", "left", "sharp-left", "slight-right", "right", "sharp-right", "keep-left", "keep-right", "u-turn", "roundabout", "arrive"])
export type Maneuver = typeof Maneuver.Type
export const isManeuver = Schema.is(Maneuver)

export const Coordinate = Schema.Struct({ latitude: Between(-90, 90), longitude: Between(-180, 180) })
export type Coordinate = typeof Coordinate.Type

export const MapsFailureCode = Schema.Literals(["unconfigured", "unavailable", "permission-denied", "timeout", "cancelled", "offline", "rate-limited", "unauthorized", "invalid-response", "unsupported", "storage"])
export type MapsFailureCode = typeof MapsFailureCode.Type

export error MapsFailure { code: MapsFailureCode; message: string }

export interface ProviderCapabilities {
  readonly map: boolean
  readonly search: boolean
  readonly placeDetails: boolean
  readonly modes: readonly TravelMode[]
  readonly traffic: "none" | "approximated" | "live"
  readonly transit: "none" | "approximated" | "scheduled"
  readonly offline: { readonly map: boolean; readonly search: boolean; readonly routing: boolean }
  readonly alternatives: boolean
}

export const unavailableCapabilities: ProviderCapabilities = {
  map: false, search: false, placeDetails: false, modes: [], traffic: "none", transit: "none",
  offline: { map: false, search: false, routing: false }, alternatives: false,
}

export type ProviderConfig =
  | { readonly status: "unconfigured" }
  | { readonly status: "configured"; readonly providerId: string; readonly connectionId: string; readonly revision: string; readonly capabilities: ProviderCapabilities }

export const placeCategoryLimit = 32

const PlaceWire = Schema.Struct({
  providerId: Text(80),
  id: Text(512),
  name: Text(300),
  coordinate: Coordinate,
  address: Schema.optionalKey(Text(1000)),
  website: Schema.optionalKey(Schema.String.check(Schema.makeFilter(webAddress))),
  phone: Schema.optionalKey(Schema.String.check(Schema.isPattern(/^[+0-9() .-]{3,80}$/))),
  openingHours: Schema.optionalKey(Text(255)),
  categories: Schema.optionalKey(Schema.Array(Schema.Unknown)),
  attribution: Text(2000),
  fetchedAt: Schema.Finite.check(Schema.isGreaterThan(0)),
})
const decodePlaceWire = Schema.decodeUnknownEffect(PlaceWire)

export interface Place {
  readonly providerId: string
  readonly id: string
  readonly name: string
  readonly coordinate: Coordinate
  readonly address?: string
  readonly website?: string
  readonly phone?: string
  readonly openingHours?: string
  readonly categories?: readonly string[]
  readonly attribution: string
  readonly fetchedAt: number
}

export const TransitDetails = Schema.Struct({
  line: Text(100),
  vehicle: Text(50),
  headsign: Schema.optionalKey(Text(200)),
  departureStop: Text(200),
  arrivalStop: Text(200),
  departureTime: Schema.optionalKey(Instant),
  arrivalTime: Schema.optionalKey(Instant),
  stopCount: Schema.optionalKey(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
  color: Schema.optionalKey(Schema.String.check(Schema.isPattern(/^#[0-9a-fA-F]{6}$/))),
})
export type TransitDetails = typeof TransitDetails.Type

export const RouteStep = Schema.Struct({
  instruction: Text(2000),
  coordinate: Coordinate,
  distanceMeters: Meters,
  maneuver: Schema.optionalKey(Maneuver),
  transit: Schema.optionalKey(TransitDetails),
})
export type RouteStep = typeof RouteStep.Type

export const Route = Schema.Struct({
  providerId: Text(80),
  id: Text(512),
  from: Coordinate,
  to: Coordinate,
  mode: TravelMode,
  geometry: Schema.Array(Coordinate).check(Schema.isMinLength(2)),
  distanceMeters: Meters,
  durationSeconds: Meters,
  steps: Schema.Array(RouteStep),
  attribution: Text(2000),
  fetchedAt: Schema.Finite.check(Schema.isGreaterThan(0)),
  traffic: Schema.Literals(["none", "approximated", "live"]),
  staticDurationSeconds: Schema.optionalKey(Meters),
})
export type Route = typeof Route.Type

export interface MapsProvider {
  readonly providerId: string
  readonly connectionId: string
  search(query: string, options?: { readonly near?: Coordinate }): (readonly Place[])!MapsFailure
  detail(id: string): (Place | null)!MapsFailure
  route(from: Coordinate, to: Coordinate, mode: TravelMode): Route!MapsFailure
  routes(from: Coordinate, to: Coordinate, mode: TravelMode): (readonly Route[])!MapsFailure
}

export interface ResultState<T> {
  readonly phase: "idle" | "loading" | "ready" | "empty" | "error"
  readonly value: T
  readonly error: MapsFailure | null
}

const invalid = (message: string) => new MapsFailure({ code: "invalid-response", message })

export effect function coordinate(value: unknown): Coordinate!MapsFailure {
  return try mapError(Schema.decodeUnknownEffect(Coordinate)(value), () => invalid("The coordinate is invalid."))
}

function categoriesOf(labels: readonly unknown[]): string[] {
  const kept: string[] = []
  for (const item of labels) {
    if (kept.length >= placeCategoryLimit) break
    if (typeof item !== "string") continue
    const label = item.trim()
    if (boundedText(label, 80) && !kept.includes(label)) kept.push(label)
  }
  return kept
}

export effect function place(value: unknown, expectedProvider?: string): Place!MapsFailure {
  const wire = try mapError(decodePlaceWire(value), () => invalid("The place identity or provenance is invalid."))
  const now = try Clock.currentTimeMillis
  if (wire.fetchedAt > now + 60_000 || (expectedProvider !== undefined && wire.providerId !== expectedProvider)) {
    throw invalid("The place identity or provenance is invalid.")
  }
  const { categories, ...fields } = wire
  const labels = categoriesOf(categories ?? [])
  return { ...fields, ...(labels.length > 0 ? { categories: labels } : {}) }
}

export effect function transitDetails(value: unknown): TransitDetails!MapsFailure {
  const ride = try mapError(Schema.decodeUnknownEffect(TransitDetails)(value), () => invalid("A transit ride is invalid."))
  return ride.color === undefined ? ride : { ...ride, color: ride.color.toLowerCase() }
}

export effect function route(value: unknown, expectedProvider?: string): Route!MapsFailure {
  const planned = try mapError(Schema.decodeUnknownEffect(Route)(value), () => invalid("The Maps route response is invalid."))
  if (expectedProvider !== undefined && planned.providerId !== expectedProvider) throw invalid("The Maps route response is invalid.")
  return planned
}

export effect function configuredProvider(config: ProviderConfig, provider?: MapsProvider): MapsProvider!MapsFailure {
  if (config.status === "unconfigured") throw new MapsFailure({ code: "unconfigured", message: "Connect a Maps provider to search places and plan routes." })
  if (provider === undefined || !boundedText(config.revision, 100) || !/^conn_[A-Za-z0-9_-]{16,}$/.test(config.connectionId)
    || provider.connectionId !== config.connectionId || provider.providerId !== config.providerId) {
    throw new MapsFailure({ code: "unavailable", message: "The configured Maps connection is unavailable." })
  }
  return provider
}

export interface MapsDiagnostics {
  readonly configured: boolean
  readonly error: MapsFailureCode | ""
  readonly message: string
}

export function mapsUnavailableMessage(diagnostics?: MapsDiagnostics, unconfiguredText?: string): string {
  if (diagnostics === undefined || !diagnostics.configured) return unconfiguredText ?? "Connect a Maps provider to search places and plan routes."
  if (diagnostics.error !== "") return diagnostics.message === "" ? "Cloud Maps could not start." : diagnostics.message
  return "Maps is not ready yet."
}

export function failure(error: unknown): MapsFailure {
  return error instanceof MapsFailure ? error : new MapsFailure({ code: "unavailable", message: "Maps could not complete this request." })
}
