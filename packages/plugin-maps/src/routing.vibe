// spec/maps/phonePosition.md, "A kind of place near a named place is searched around that place, never around the phone"; spec/maps/phonePosition.md, "A reported position never becomes a route origin"; spec/maps/routing.md, "Only the owner's next turn answers an open question, by its position or the place's name, within ten minutes"
import type { IAgentRuntime, Memory } from "@elizaos/core"
import { choiceBinds, choiceOpenAt, namedOption, type ChoiceTurn } from "../gen/maps__routing.effect.vibe"
import type { AgentPlaceRef } from "@elizaos/plugin-maps-client"

const courtesy = String.raw`(?:(?:please|hey|ok(?:ay)?|so)[,\s]+)*(?:(?:can|could|would|will)\s+you\s+)?(?:please\s+)?`
const end = String.raw`(?:,?\s+(?:please|for\s+me))*\s*[.!?]*\s*$`
const notAPlaceKind = String.raw`(?!(?:neighbou?rs?|integers?|whole|numbers?|dollars?|cents?|penn(?:y|ies)|hundreds?|thousands?|millions?|tens?|tenths?|decimals?|minutes?|hours?|seconds?|days?|weeks?|months?|years?|multiples?|powers?|points?|values?|match(?:es)?|percent|degrees?|units?|digits?|fractions?|primes?|pairs?|stars?|planets?|relatives?|synonyms?|words?|colou?rs?|versions?|results?)\b)`
const findVerb = String.raw`(?:(?:find|show|locate|get|search\s+for|look\s+(?:for|up))\s+(?:me\s+)?|where(?:'s|’s|\s+is|\s+are)\s+|what(?:'s|’s|\s+is)\s+)`
const notAThere = String.raw`(?!(?:anyone|anybody|someone|somebody|no\s?one|nobody|one|(?:a|any)\s+(?:way|chance|reason|problem|issue|bug|error|difference|need|point))\b)`
const ownPosition = /^(?:me|here|us|by|myself|this\s+(?:place|spot|location)|(?:my|the)\s+phone)$|^(?:me|here|us|myself)\b(?=[,\s]+(?:that|which|who|where|for|to|with|and|so|if|in|at|on|by|open|right|now|tonight|today|please|thanks|thank)\b)|^(?:my\s+(?:location|position|place|current\s+location)|where\s+(?:i|we)\s+(?:am|are)|current\s+location)\b|\b(?:near|around|close\s+to|next\s+to)\s+(?:me|here|us)$/iu
const ownPositionQuery = /^(?:(?:from|at)\s+)?(?:me|here|right\s+here|us|myself|(?:my|our)\s+(?:current\s+|present\s+|gps\s+)?(?:location|position)|(?:my\s+)?current\s+(?:location|position)|where\s+(?:i|we)\s+(?:am|are)(?:\s+(?:right\s+)?now)?|(?:my|the)\s+phone(?:(?:'s|’s)\s+location)?)$/iu
const anchorTail = /(?:,?\s+(?:please|thanks|thank\s+you|for\s+me|right\s+now|now|today|tonight|(?:(?:that|which)(?:'s|’s|\s+(?:is|are))\s+)?open(?:\s+(?:now|late|today|tonight))?))+$/iu
const placeKindWords = new RegExp(String.raw`^${notAPlaceKind}`, "iu")
const leadingKindWords = /^(?:(?:the|a|an|some|any)\s+)?(?:(?:nearest|closest)\s+)?/iu
const nearestKind = /^(?:(?:the|a|an|any)\s+)?(?:nearest|closest)\s+(?!to\b)(\S.{0,79})$/iu
const nearestToPoint = /^(.+?)\s+(?:to|near|around|close\s+to|next\s+to|in|at|by|on)\s+(\S.*)$/iu
const nearbyKind = /^(\S.{0,79}?)\s+(?:nearby|around\s+here|close\s+by)$/iu
const anchoredQuery = new RegExp(String.raw`^\s*${courtesy}(?:${findVerb})?(?:(?:is|are)\s+there\s+${notAThere})?(?:(?:the|a|an|some|any)\s+)?(?:(?:nearest|closest)\s+)?(\S.{0,79}?)\s+(?:near|around|close\s+to|next\s+to)\s+(\S.{0,119}?)${end}`, "iu")
const nearNotAPlace = /^(?:home|work|the\s+office|(?:my|our)\s+.+|(?:the\s+)?(?:top|bottom|end|beginning|start|middle|deadline|weekend|holidays?)|midnight|noon|midday|dawn|dusk|sunrise|sunset|lunch(?:time)?|dinner(?:time)?|breakfast|christmas(?:\s+eve)?|thanksgiving|easter|halloween|new\s+year(?:'s|’s)?(?:\s+(?:eve|day))?|(?:mon|tues|wednes|thurs|fri|satur|sun)day|january|february|march|april|june|july|august|september|october|november|december|line\s+\d+|page\s+\d+|\d{1,2}(?::\d{2})?\s*(?:am|pm|a\.m\.?|p\.m\.?|o'?clock)?|\d[\d,.]*\s*(?:dollars?|bucks|euros?|pounds?)(?:\s+(?:a|per)\s+(?:night|day|week|month))?|\d[\d,.]*\s+(?:a|per)\s+(?:night|day|week|month))$/iu
const nearNotAPlaceKind = /\b(?:photos?|pictures?|pics?|images?|videos?|clips?|selfies?|screenshots?|e-?mails?|mail|messages?|texts?|chats?|notes?|files?|documents?|docs?|songs?|music|tracks?|albums?|playlists?|podcasts?|events?|meetings?|appointments?|reminders?|alarms?|contacts?|tasks?|to-?dos?|bugs?|issues?|errors?|lines?|comments?|posts?|tweets?|results?|calls?|voicemails?|weather|forecasts?|traffic|news)$/iu
const choiceReply = /^\s*(?:(?:yes|yeah|yep|ok(?:ay)?|sure|um+|uh+|so|hmm+|let'?s\s+(?:go\s+with|do)|i\s+(?:meant?|want|mean)|go\s+with|pick|choose|use|take)[,\s]+)*(?:(?:the|number|no\.?|#|option|item)\s*)*(first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|1st|2nd|3rd|4th|5th|6th|7th|8th|9th|10th|one|two|three|four|five|six|seven|eight|nine|ten|last|top|\d{1,2})(?:\s+(?:one|option|place|result|choice))?(?:[,\s]+(?:one|please|thanks|thank\s+you))*\s*[.!?]*\s*$/iu
const ordinals: Readonly<Record<string, number>> = {
  first: 1, "1st": 1, one: 1, second: 2, "2nd": 2, two: 2, third: 3, "3rd": 3, three: 3, fourth: 4, "4th": 4, four: 4, fifth: 5, "5th": 5, five: 5,
  sixth: 6, "6th": 6, six: 6, seventh: 7, "7th": 7, seven: 7, eighth: 8, "8th": 8, eight: 8, ninth: 9, "9th": 9, nine: 9, tenth: 10, "10th": 10, ten: 10, top: 1,
}

export const choiceActions = { place: "MAPS_PLACE", route: "MAPS_ROUTE", select: "MAPS_SELECT", save: "MAPS_SAVE", share: "MAPS_SHARE", "navigation-start": "MAPS_NAVIGATION_START" } as const
export type ChoiceOperation = keyof typeof choiceActions

export const mapsSelectionHandlePattern = /^maps_[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$/u

export function isMapsSelectionHandle(id: string | undefined): boolean {
  return id !== undefined && mapsSelectionHandlePattern.test(id)
}

export interface PlaceChoice {
  readonly operation: ChoiceOperation
  readonly field: "originPlaceId" | "destinationPlaceId" | "placeId"
  readonly options: readonly AgentPlaceRef[]
  readonly params: Readonly<Record<string, unknown>>
  readonly askedAt: number
}

interface OpenQuestion {
  readonly choice: PlaceChoice
  readonly askedBy: string | undefined
  answeredBy: string | undefined
}

const questions = new WeakMap<IAgentRuntime, Map<string, OpenQuestion>>()

function openQuestions(runtime: IAgentRuntime): Map<string, OpenQuestion> {
  const known = questions.get(runtime)
  if (known !== undefined) return known
  const made = new Map<string, OpenQuestion>()
  questions.set(runtime, made)
  return made
}

function conversationOf(message: Memory): string {
  return `${message.roomId}|${message.entityId}`
}

export function openChoice(runtime: IAgentRuntime, message: Memory, choice: PlaceChoice): void {
  openQuestions(runtime).set(conversationOf(message), { choice, askedBy: message.id, answeredBy: undefined })
}

export function choicePosition(reply: string, count: number): number | undefined {
  if (reply.length > 60) return undefined
  const word = choiceReply.exec(reply)?.[1]?.toLowerCase()
  if (word === undefined || (word === "one" && /\bthe\s+one\b/iu.test(reply))) return undefined
  return word === "last" ? count : /^\d+$/u.test(word) ? Number(word) : ordinals[word]
}

export function placeKey(value: string): string {
  return value.normalize("NFKD").replace(/\p{M}/gu, "").toLowerCase().replace(/&/g, " and ").replace(/['’`]/g, "")
    .replace(/[^\p{L}\p{N}]+/gu, " ").trim().replace(/^the\s+/u, "")
}

function namedPosition(reply: string, options: readonly AgentPlaceRef[]): number | undefined {
  const key = placeKey(reply)
  if (key === "") return undefined
  const positions = (names: (option: AgentPlaceRef) => boolean) => options.flatMap((option, index) => names(option) ? [index + 1] : [])
  const labelled = positions((option) => option.providerPlaceId === reply.trim() || placeKey(`${option.name} ${option.formattedAddress ?? ""}`) === key)
  const named = positions((option) => placeKey(option.name) === key)
  switch (namedOption(labelled.length, named.length)) {
    case "ByListedLabel": return labelled[0]
    case "ByNameAlone": return named[0]
    case "NoOptionNamed": return undefined
  }
}

function turnOf(question: OpenQuestion, message: Memory): ChoiceTurn {
  if (message.id === undefined || question.askedBy === undefined) return "NextOwnerTurn"
  if (message.id === question.askedBy) return "AskingTurn"
  return question.answeredBy === undefined || question.answeredBy === message.id ? "NextOwnerTurn" : "LaterTurn"
}

function questionFor(runtime: IAgentRuntime, message: Memory, now: number): { readonly choice: PlaceChoice; readonly turn: ChoiceTurn } | undefined {
  const open = openQuestions(runtime)
  const conversation = conversationOf(message)
  const question = open.get(conversation)
  if (question === undefined) return undefined
  const turn = turnOf(question, message)
  if (!choiceOpenAt(turn, Math.floor(now - question.choice.askedAt))) {
    open.delete(conversation)
    return undefined
  }
  if (turn === "NextOwnerTurn" && question.askedBy !== undefined) question.answeredBy = message.id
  return { choice: question.choice, turn }
}

export function pendingChoice(runtime: IAgentRuntime, message: Memory, now: number): PlaceChoice | undefined {
  const open = questionFor(runtime, message, now)
  return open !== undefined && open.turn === "NextOwnerTurn" && open.choice.options.length > 0 ? open.choice : undefined
}

export function answeredChoice(runtime: IAgentRuntime, message: Memory, now: number): { readonly choice: PlaceChoice; readonly place: AgentPlaceRef } | undefined {
  const open = questionFor(runtime, message, now)
  if (open === undefined) return undefined
  const { choice, turn } = open
  const reply = typeof message.content.text === "string" ? message.content.text : ""
  const position = choicePosition(reply, choice.options.length) ?? namedPosition(reply, choice.options) ?? 0
  if (!choiceBinds({ open: true, sameConversation: true, turn, age: Math.floor(now - choice.askedAt), position, options: choice.options.length })) return undefined
  const place = choice.options[position - 1]
  return place === undefined ? undefined : { choice, place }
}

export function keptRequest(runtime: IAgentRuntime, message: Memory, now: number): PlaceChoice | undefined {
  const open = questionFor(runtime, message, now)
  return open !== undefined && open.turn === "NextOwnerTurn" && open.choice.options.length === 0 ? open.choice : undefined
}

export function closeChoice(runtime: IAgentRuntime, message: Memory): void {
  openQuestions(runtime).delete(conversationOf(message))
}

function withoutTail(words: string): string {
  return words.trim().replace(/[\s?.!]+$/u, "").replace(anchorTail, "").trim()
}

function kindOf(words: string | undefined): string | undefined {
  const kind = words?.replace(leadingKindWords, "").trim()
  return kind === undefined || kind === "" || !placeKindWords.test(kind) ? undefined : kind
}

export function namesOwnPosition(words: string): boolean {
  return ownPositionQuery.test(withoutTail(words))
}

export function nearbyPlaceKind(query: string): string | undefined {
  const trimmed = withoutTail(query)
  const nearest = nearestKind.exec(trimmed)?.[1]
  if (nearest !== undefined) {
    const split = nearestToPoint.exec(nearest)
    return split === null ? kindOf(nearest) : ownPosition.test(withoutTail(split[2] ?? "")) ? kindOf(split[1]) : undefined
  }
  const nearby = nearbyKind.exec(trimmed)?.[1]
  if (nearby !== undefined) return kindOf(nearby)
  const match = anchoredQuery.exec(trimmed)
  return match?.[2] !== undefined && ownPosition.test(withoutTail(match[2])) ? kindOf(match[1]) : undefined
}

export function anchoredPlace(query: string): { readonly kind: string; readonly anchor: string } | undefined {
  const match = anchoredQuery.exec(query)
  const kind = match?.[1]?.trim()
  const anchor = match?.[2] === undefined ? undefined : withoutTail(match[2])
  if (kind === undefined || kind === "" || anchor === undefined || anchor === "" || ownPosition.test(anchor) || nearNotAPlace.test(anchor) || nearNotAPlaceKind.test(kind)) return undefined
  return { kind, anchor: anchor.replace(/^the\s+/iu, "") }
}

