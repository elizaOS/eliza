// spec/maps/cloudConnection.md, "Maps requests and tiles retain the captured account through completion"; spec/maps/routing.md, "Asked where Maps works, the reply states only what Cloud Maps reports"; spec/maps/attribution.md, "Only the reply to the latest request, for the current view, is shown"; spec/cloud/services/maps.md, "Every operation except capabilities and viewport needs an idempotency key and runs over one hold of the calling credential"; spec/maps/routing.md, "A Maps screen selection asks the planner to name the place"; spec/maps/routing.md, "An answer Maps cannot use is said in the owner's words, naming the place a start could not look up"; spec/maps/phonePosition.md, "A search around a point asks Cloud for the closest places whenever Cloud ranks by distance"
import type { CloudLinkReply, CloudLinkRequest } from "@elizaos/agent"
import { readCloudError } from "@elizaos/cloud/client"
import { asksForClosest } from "../gen/maps__phonePosition.effect.vibe"
import { cloudMapsFailure, unusableMapsAnswer } from "./client/cloud-provider.vibe"
import { boundedText, type Coordinate, MapsFailure, place, route, TravelMode, type Place, type Route } from "./client/contracts.vibe"
import type { AgentPlaceRef } from "./client/device-navigation.vibe"
import { isMapsSelectionHandle } from "./routing.vibe"

module node {
  /** @throws {never} */
  export function idempotencyKey(): string {
    return globalThis.crypto.randomUUID()
  }
}
import { idempotencyKey } from node

export interface MapsCloudLink {
  request(request: CloudLinkRequest): Promise<CloudLinkReply>
}

export const agentCloudProvider = "eliza-cloud"

const Text = (limit: number) => Schema.String.check(Schema.makeFilter((value: string) => boundedText(value, limit)))
const Recipient = Schema.Struct({ role: Text(40), name: Text(200), operator: Text(200) })
const Capabilities = Schema.Union([
  Schema.Struct({ available: Schema.Literal(false) }),
  Schema.Struct({
    available: Schema.Literal(true),
    providerId: Text(80),
    attribution: Text(2000),
    revision: Schema.optionalKey(Text(200)),
    regions: Schema.optionalKey(Schema.Array(Schema.Struct({ name: Text(200) })).check(Schema.isMaxLength(64))),
    disclosure: Schema.optionalKey(Schema.Struct({ recipients: Schema.Array(Recipient).check(Schema.isMaxLength(16)) })),
    capabilities: Schema.Struct({
      modes: Schema.Array(TravelMode), alternatives: Schema.Boolean, traffic: Schema.Literals(["none", "live"]),
      reverseGeocode: Schema.optionalKey(Schema.Boolean), distanceRank: Schema.optionalKey(Schema.Boolean), transit: Schema.optionalKey(Schema.Literals(["none", "scheduled"])),
      offline: Schema.optionalKey(Schema.Struct({ map: Schema.Boolean, search: Schema.Boolean, routing: Schema.Boolean })),
    }),
  }),
])
const Places = Schema.Struct({ providerId: Text(80), attribution: Text(2000), places: Schema.Array(Schema.Unknown).check(Schema.isMaxLength(100)) })
const Detail = Schema.Struct({ providerId: Text(80), attribution: Text(2000), place: Schema.Unknown })
const Routes = Schema.Struct({ providerId: Text(80), attribution: Text(2000), routes: Schema.Array(Schema.Unknown).check(Schema.isMinLength(1), Schema.isMaxLength(3)) })

export interface PlaceResults {
  readonly providerId: string
  readonly attribution: string
  readonly places: readonly Place[]
}

export interface RouteResults {
  readonly providerId: string
  readonly attribution: string
  readonly routes: readonly Route[]
}

export interface MapsOffer {
  readonly providerId: string
  readonly attribution: string
  readonly modes: readonly TravelMode[]
  readonly alternatives: boolean
  readonly revision?: string
  readonly regions: readonly string[]
  readonly liveTraffic: boolean
  readonly reverseGeocode?: boolean
  readonly distanceRank?: boolean
  readonly transitSchedules?: boolean
  readonly offline?: boolean
  readonly recipients: ReadonlyArray<{ readonly role: string; readonly name: string; readonly operator: string }>
}

export function agentPlace(found: Place): AgentPlaceRef {
  return {
    provider: agentCloudProvider,
    providerPlaceId: found.id,
    name: found.name,
    coordinates: found.coordinate,
    ...(found.address === undefined ? {} : { formattedAddress: found.address }),
    categories: [...(found.categories ?? [])],
  }
}

const unreachable = () => new MapsFailure({ code: "offline", message: "Cloud Maps is unreachable. Check the connection." })
const unusable = () => new MapsFailure({ code: "invalid-response", message: unusableMapsAnswer })

export function mapsService(link: MapsCloudLink) {
  effect function call<A>(request: Omit<CloudLinkRequest, "signal" | "idempotencyKey">, schema: Schema.Codec<A>, metered: boolean): A!MapsFailure {
    const reply = try tryPromise({
      try: (signal) => link.request({ ...request, signal, ...(metered ? { idempotencyKey: idempotencyKey() } : {}) }),
      catch: unreachable,
    })
    const now = try Clock.currentTimeMillis
    if (reply.kind === "changes-off") throw new MapsFailure({ code: "unauthorized", message: "Cloud refused this Maps request." })
    if (reply.kind === "refused") {
      const body = JSON.stringify(reply.body ?? null)
      const refused = try tryPromise({
        try: () => readCloudError({ status: reply.status, headers: { get: () => null }, text: () => Promise.resolve(body) }, now),
        catch: unreachable,
      })
      throw cloudMapsFailure(refused.failure, now)
    }
    return try mapError(Schema.decodeUnknownEffect(schema)(reply.body), unusable)
  }

  effect function offer(): (MapsOffer | undefined)!MapsFailure {
    const answer = try call({ method: "GET", path: "/api/v1/maps/capabilities" }, Capabilities, false)
    if (!answer.available) return undefined
    const { modes, alternatives, traffic, reverseGeocode, distanceRank, transit, offline } = answer.capabilities
    return {
      providerId: answer.providerId, attribution: answer.attribution, modes, alternatives,
      ...(answer.revision === undefined ? {} : { revision: answer.revision }),
      regions: (answer.regions ?? []).map((region) => region.name),
      liveTraffic: traffic === "live",
      ...(reverseGeocode === undefined ? {} : { reverseGeocode }),
      ...(distanceRank === undefined ? {} : { distanceRank }),
      ...(transit === undefined ? {} : { transitSchedules: transit === "scheduled" }),
      ...(offline === undefined ? {} : { offline: offline.map || offline.search || offline.routing }),
      recipients: answer.disclosure?.recipients ?? [],
    }
  }

  effect function search(query: string, near?: Coordinate, limit?: number, rank?: "distance"): PlaceResults!MapsFailure {
    const text = query.trim()
    if (!boundedText(text, 300)) throw new MapsFailure({ code: "unsupported", message: "Search text is too long or empty." })
    const aroundPoint = near !== undefined && rank === "distance"
    const cloudRanks = aroundPoint ? (try offer())?.distanceRank === true : false
    const answer = try call({
      method: "POST", path: "/api/v1/maps/places/search",
      body: {
        query: text, ...(near === undefined ? {} : { near }), ...(asksForClosest(aroundPoint, cloudRanks) ? { rank: "distance" } : {}),
        ...(limit === undefined ? {} : { limit: Math.max(1, Math.min(20, Math.round(limit))) }),
      },
    }, Places, true)
    const places: Place[] = []
    for (const item of answer.places) places.push(try mapError(place(item, answer.providerId), unusable))
    return { providerId: answer.providerId, attribution: answer.attribution, places }
  }

  effect function detail(id: string): (Place | null)!MapsFailure {
    if (isMapsSelectionHandle(id) || !/^[A-Za-z0-9][A-Za-z0-9:._-]{0,255}$/.test(id)) return null
    const answer = try call({ method: "POST", path: "/api/v1/maps/places/details", body: { id } }, Detail, true)
    return answer.place === null ? null : try mapError(place(answer.place, answer.providerId), unusable)
  }

  effect function reverse(at: Coordinate): { readonly attribution: string; readonly place: Place | null }!MapsFailure {
    const answer = try call({ method: "POST", path: "/api/v1/maps/reverse", body: { coordinate: at } }, Detail, true)
    return { attribution: answer.attribution, place: answer.place === null ? null : try mapError(place(answer.place, answer.providerId), unusable) }
  }

  effect function routes(from: Coordinate, to: Coordinate, mode: TravelMode, alternatives: boolean): RouteResults!MapsFailure {
    const answer = try call({ method: "POST", path: "/api/v1/maps/routes", body: { from, to, mode, ...(alternatives ? { alternatives: true } : {}) } }, Routes, true)
    if (!alternatives && answer.routes.length > 1) throw unusable()
    const planned: Route[] = []
    for (const item of answer.routes) {
      const checked = try mapError(route(item, answer.providerId), unusable)
      if (checked.mode !== mode) throw unusable()
      planned.push(checked)
    }
    return { providerId: answer.providerId, attribution: answer.attribution, routes: planned }
  }

  return { offer, search, detail, reverse, routes }
}

export type MapsService = ReturnType<typeof mapsService>
