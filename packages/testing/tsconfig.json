{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "bun"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@elizaos/core": [
        "../core/src/index.ts"
      ],
      "@elizaos/testing": [
        "./src/index.ts"
      ],
      "@elizaos/plugin-sqlite": [
        "../../plugins/plugin-sqlite/index.ts"
      ],
      "@elizaos/testing/scenario-runner": [
        "./scenario-runner/src/index.ts"
      ],
      "@elizaos/testing/scenario-runner/*": [
        "./scenario-runner/src/*"
      ],
      "@elizaos/testing/synthetic-world": [
        "./synthetic-world/src/index.ts"
      ]
    },
    "composite": false,
    "incremental": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ]
}
