{
  "compilerOptions": {
    "target": "es2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "paths": {
      "@elizaos/core": ["../../core/src/index.ts"],
      "@elizaos/testing": ["../src/index.ts"],
      "@elizaos/agent": ["../../agent/src/index.ts"],
      "@elizaos/agent/*": ["../../agent/src/*"],
      "@elizaos/auth/auth": ["../../auth/src/auth/index.ts"],
      "@elizaos/auth/auth/*": ["../../auth/src/auth/*"],
      "@elizaos/shared": ["../../shared/src/index.ts"],
      "@elizaos/shared/local-inference": [
        "../../shared/src/local-inference/index.ts"
      ],
      "@elizaos/shared/*": ["../../shared/src/*"],
      "@elizaos/auth/vault": ["../../auth/src/vault/index.ts"],
      "@elizaos/auth/vault/*": ["../../auth/src/vault/*"],
      "@elizaos/cloud-routing": ["../../cloud/routing/src/index.ts"],
      "@elizaos/cloud-routing/*": ["../../cloud/routing/src/*"],
      "@elizaos/app": ["../../app/src/index.ts"],
      "@elizaos/app/*": ["../../app/src/*"],
      "@elizaos/ui": ["../../src/ui/index.ts"],
      "@elizaos/ui/*": ["../../src/ui/*"],
      "@elizaos/plugin-browser": [
        "../../../plugins/plugin-browser/src/index.ts"
      ],
      "@elizaos/plugin-browser/*": ["../../../plugins/plugin-browser/src/*"],
      "@elizaos/plugin-coding-tools": [
        "../../../plugins/plugin-coding-tools/src/index.ts"
      ],
      "@elizaos/plugin-coding-tools/*": [
        "../../../plugins/plugin-coding-tools/src/*"
      ],
      "@elizaos/plugin-elizacloud": [
        "../../../plugins/plugin-elizacloud/dist/node/index.d.ts"
      ],
      "@elizaos/plugin-agent-orchestrator": [
        "../../../plugins/plugin-agent-orchestrator/src/index.ts"
      ],
      "@elizaos/plugin-github": ["../../../plugins/plugin-github/src/index.ts"],
      "@elizaos/plugin-scheduling": [
        "../../../plugins/plugin-scheduling/src/index.ts"
      ],
      "@elizaos/plugin-scheduling/*": [
        "../../../plugins/plugin-scheduling/src/*"
      ],
      "@elizaos/plugin-sql": ["../../../plugins/plugin-sql/src/index.ts"],
      "@elizaos/plugin-telegram": [
        "../../../plugins/plugin-telegram/src/index.ts"
      ],
      "@elizaos/plugin-mcp": ["../../../plugins/plugin-mcp/src/index.ts"],
      "@elizaos/plugin-mcp/*": ["../../../plugins/plugin-mcp/src/*"],
      "@elizaos/plugin-todos": ["../../../plugins/plugin-todos/src/index.ts"],
      "@elizaos/plugin-todos/*": ["../../../plugins/plugin-todos/src/*"],
      "@elizaos/plugin-video": ["../../../plugins/plugin-video/src/index.ts"],
      "@elizaos/plugin-vision": ["../../../plugins/plugin-vision/src/index.ts"],
      "@elizaos/plugin-workflow": [
        "../../../plugins/plugin-workflow/src/index.ts"
      ],
      "@elizaos/plugin-native-inference/host-bridge": [
        "../../../plugins/plugin-native-inference/src/bridge.ts"
      ],
      "@elizaos/plugin-native-inference/*": [
        "../../../plugins/plugin-native-inference/src/*"
      ],
      "@elizaos/plugin-native-filesystem": [
        "../../../plugins/plugin-native-filesystem/src/index.ts"
      ],
      "@elizaos/plugin-local-inference": [
        "../../../plugins/plugin-local-inference/src/index.ts"
      ],
      "@elizaos/plugin-local-inference/*": [
        "../../../plugins/plugin-local-inference/src/*"
      ],
      "@elizaos/capacitor-appblocker": [
        "../../../plugins/plugin-native-appblocker/src/index.ts"
      ],
      "@elizaos/plugin-native-contacts/bridge": [
        "../../../plugins/plugin-native-contacts/src/bridge.ts"
      ],
      "@elizaos/capacitor-calendar": [
        "../../../plugins/plugin-native-calendar/src/index.ts"
      ],
      "@elizaos/plugin-native-messages/bridge": [
        "../../../plugins/plugin-native-messages/src/bridge.ts"
      ],
      "@elizaos/capacitor-mobile-signals": [
        "../../../plugins/plugin-native-mobile-signals/src/index.ts"
      ],
      "@elizaos/plugin-native-phone/bridge": [
        "../../../plugins/plugin-native-phone/src/bridge.ts"
      ],
      "@elizaos/capacitor-secure-store": [
        "../../../plugins/plugin-native-secure-store/src/index.ts"
      ],
      "@elizaos/capacitor-system": [
        "../../../plugins/plugin-native-system/src/index.ts"
      ],
      "@elizaos/testing/*": ["../src/*"],
      "@elizaos/testing/scenario-runner": ["./src/index.ts"],
      "@elizaos/testing/scenario-runner/*": ["./src/*"],
      "@elizaos/testing/synthetic-world": ["../synthetic-world/src/index.ts"],
      "@elizaos/testing/scenario-runner/schema": ["./schema/index.js"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
