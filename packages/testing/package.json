{
  "name": "@elizaos/testing",
  "version": "2.0.3-beta.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "bun run test:fixtures && bun run test:scenarios",
    "typecheck": "bun run typecheck:fixtures && bun run typecheck:scenarios",
    "test:fixtures": "node ../scripts/run-vitest.mjs run",
    "test:scenarios": "bun test --conditions eliza-source scenarios && bun run scenarios:validate",
    "scenarios:validate": "bun --conditions eliza-source ../scenario-runner/src/cli.ts list scenarios --validate-scenarios",
    "typecheck:fixtures": "tsc --noEmit -p tsconfig.json",
    "typecheck:scenarios": "tsc --noEmit -p scenarios/tsconfig.json",
    "format": "bunx @biomejs/biome format --write package.json scenarios",
    "format:check": "bunx @biomejs/biome format package.json scenarios"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/plugin-sql": "workspace:*",
    "zod": "^4.4.3",
    "@elizaos/shared": "workspace:*",
    "@elizaos/plugin-sqlite": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "@types/node": "^25.0.3",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "elizaos": {
    "scripts": {
      "testLanes": [
        "server"
      ]
    }
  },
  "description": "Private runtime fixtures and repository-wide scenario definitions.",
  "peerDependencies": {
    "@elizaos/agent": "workspace:*",
    "@elizaos/scenario-runner": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@elizaos/agent": {
      "optional": true
    },
    "@elizaos/scenario-runner": {
      "optional": true
    }
  }
}
