{
  "contract": "alphaphone-native-signin-callback",
  "version": 1,
  "description": "Shared fixture for the Alpha Phone in-app Eliza Cloud sign-in callback. The same file is committed in elizaOS/eliza and AlphaCompute/alphaphone; both sides run every vector. Values are synthetic.",
  "rules": [
    "Parse the raw URL text. It must be exactly https://{host}{path}, optionally followed by ?query and/or #fragment. No port, userinfo, other scheme, other case or other path.",
    "An empty query or fragment (a bare ? or #) is treated as absent. If both the query and the fragment are non-empty, reject.",
    "Split the non-empty component on & into key=value pairs. Every pair needs exactly one =, a non-empty value, a key in allowedKeys, and no repeated key. Values are compared raw (no percent-decoding) against the patterns.",
    "success: the fragment holds exactly {code,state}, code matches codePattern, state matches statePattern. A code anywhere else rejects.",
    "error: the query or the fragment holds exactly {error,state}, error is in errorAllowlist, state matches statePattern.",
    "empty: no query and no fragment. The app keeps its pending record until expiry or an explicit retry and shows a retry message.",
    "reject: anything else. The app ignores the return and keeps its pending record; it compares state before burning the record.",
    "The browser fallback page never forwards a code. Its hand-off is the callback URL with ?error=app_link_unverified&state={state} when a state matching statePattern is present in the fragment (checked first) or the query, otherwise the bare callback URL."
  ],
  "hosts": {
    "production": "eliza.app",
    "staging": "staging.eliza.app"
  },
  "path": "/alphaphone/auth/callback",
  "package": "ai.elizaresearch.alphaphone",
  "allowedKeys": ["code", "state", "error"],
  "codePattern": "^[A-Za-z0-9_-]{43}$",
  "statePattern": "^[A-Za-z0-9_-]{43}$",
  "fallbackError": "app_link_unverified",
  "errorAllowlist": [
    "app_link_unverified",
    "mfa_required",
    "oauth_account_provisioning_failed",
    "oauth_authentication_failed",
    "oauth_authorization_failed",
    "oauth_callback_incomplete",
    "oauth_identity_incomplete",
    "oauth_profile_fetch_failed",
    "oauth_provider_unavailable",
    "oauth_state_consumed",
    "oauth_token_exchange_failed",
    "oauth_verified_email_required"
  ],
  "stewardCodesWithoutReturn": [
    "oauth_login_disabled",
    "oauth_provider_mismatch",
    "oauth_provider_unknown",
    "oauth_redirect_invalid",
    "oauth_state_expired",
    "oauth_state_invalid"
  ],
  "authorize": {
    "path": "/steward/auth/oauth/google/authorize",
    "requiredParams": {
      "response_type": "code",
      "tenant_id": "elizacloud",
      "code_challenge_method": "S256",
      "prompt": "select_account",
      "mfa": "exchange"
    },
    "notes": "mfa=exchange: for an account with a second factor, the success return is unchanged ({code,state} in the fragment) and POST /steward/auth/oauth/exchange answers {ok:true, mfaRequired:true, mfa:{type,challengeId,expiresAt}, user} with no tokens; the app completes through /steward/auth/mfa/{type}/complete. Older Steward deployments ignore the parameter and show their error page instead.",
    "redirectUri": {
      "production": "https://eliza.app/alphaphone/auth/callback",
      "staging": "https://staging.eliza.app/alphaphone/auth/callback"
    }
  },
  "cases": [
    {
      "name": "success: code and state in the fragment, as Steward emits",
      "env": "production",
      "url": "https://eliza.app/alphaphone/auth/callback#code=L14j9ZUPE0a3DJXAF5pmQiJ9yfl9Mkz2oiEWIlLHbZ0&state=-XpdaBcldq8nhHvl3cGAo65cM3lLV1bF7rBO_fi3hDI",
      "expect": {
        "kind": "success",
        "code": "L14j9ZUPE0a3DJXAF5pmQiJ9yfl9Mkz2oiEWIlLHbZ0",
        "state": "-XpdaBcldq8nhHvl3cGAo65cM3lLV1bF7rBO_fi3hDI"
