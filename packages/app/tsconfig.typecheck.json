{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["eliza-source"],
    "paths": {
      "@elizaos/cloud-sdk/*": ["../cloud/sdk/src/*"],
      "@elizaos/ui/*": ["../ui/src/*"],
      "@elizaos/plugin-assistant/*": ["../../plugins/plugin-assistant/src/*"],
      "@elizaos/plugin-elizacloud/*": ["../../plugins/plugin-elizacloud/src/*"],
      "@elizaos/app": ["./src/index.ts"],
      "@elizaos/app/*": ["./src/*"],
      "@elizaos/plugin-wallet/ui": [
        "../../plugins/plugin-wallet/dist/ui/index.d.ts"
      ],
      "@elizaos/plugin-browser/*": ["../../plugins/plugin-browser/src/*"],
      "@elizaos/cloud-shared/*": ["../cloud/shared/src/*"],
      "@elizaos/plugin-native-settings/register": [
        "../../plugins/plugin-native-settings/src/register.ts"
      ],
      "@elizaos/plugin-native-inference/*": [
        "../../plugins/plugin-native-inference/src/*"
      ],
      "@elizaos/capacitor-desktop": [
        "../../plugins/plugin-native-desktop/src/index.ts"
      ],
      "@elizaos/plugin-native-contacts/bridge/*": [
        "../../plugins/plugin-native-contacts/src/*"
      ],
      "@elizaos/core/*": ["../core/src/*"]
    }
  },
  "include": [
    "src/first-run-boot-patches.ts",
    "src/native-transcript-bridge.ts",
    "src/env-prefix.js",
    "src/web-ws-base-fix.ts",
    "src/camera-bridge-responder.ts",
    "src/remote-controller-deep-link.ts",
    "src/brand-env.ts",
    "src/main.tsx",
    "src/embed-bootstrap.ts",
    "src/types",
    "src/app-config.ts",
    "src/native",
    "src/ios-voice-selftest-smoke.ts",
    "src/public-web-entry.test.tsx",
    "src/character-catalog.ts",
    "src/ios-full-bun-entrypoint.ts",
    "src/desktop-fn-hold-policy.ts",
    "src/public-web-boot-config.ts",
    "src/renderer-entry.ts",
    "src/deep-link-handler.ts",
    "src/ios-cloud-onboarding-smoke.ts",
    "src/sw-registration.ts",
    "src/packaged-shell-storage-test-bridge.ts",
    "src/cloud-apps-view.ts",
    "src/boot-failure.ts",
    "src/mobile-remote-fallback.ts",
    "src/keyboard-dictation.ts",
    "src/ios-runtime.ts",
    "src/__tests__",
    "src/shims",
    "src/public-web-entry.tsx",
    "src/boot-voice-load.ts",
    "src/app-module-cache.ts",
    "src/renderer-build-stamp.ts",
    "src/web-entry-policy.ts",
    "src/mobile-lifecycle.ts",
    "src/desktop-hotkey.ts",
    "src/deep-link-routing.ts",
    "src/env-prefix.d.ts",
    "src/url-trust-policy.ts",
    "src/host-externals.ts",
    "src/renderer-build-manifest-plugin.test.ts",
    "src/renderer-shell-scope.ts",
    "src/runtime-chooser-override.ts",
    "src/plugin-registrations.ts",
    "src/ios-attachment-smoke.ts",
    "src/cloud-only-branding.ts"
  ]
}
