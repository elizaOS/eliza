{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"declaration": false,
		"outDir": "./dist",
		"rootDir": "../../../..",
		"types": ["bun-types"],
		"paths": {
			"@elizaos/plugin-assistant/*": [
				"../../../../plugins/plugin-assistant/src/*"
			],
			"@elizaos/plugin-github/*": ["../../../../plugins/plugin-github/src/*"],
			"drizzle-orm": [
				"../../../../plugins/plugin-sql/node_modules/drizzle-orm"
			],
			"drizzle-orm/*": [
				"../../../../plugins/plugin-sql/node_modules/drizzle-orm/*"
			],
			"@capacitor/app": [
				"../../../app/node_modules/@capacitor/app/dist/esm/index.d.ts"
			],
			"@clack/prompts": ["../../../agent/node_modules/@clack/prompts"],
			"@elizaos/app": ["../../src/index.ts"],
			"@elizaos/app/*": ["../../src/*"],
			"@elizaos/agent": ["../../../agent/src/index.ts"],
			"@elizaos/agent/*": ["../../../agent/src/*"],
			"@elizaos/capacitor-bun-runtime": [
				"../../../../plugins/plugin-native-bun-runtime/src/index.ts"
			],
			"@elizaos/capacitor-bun-runtime/*": [
				"../../../../plugins/plugin-native-bun-runtime/src/*"
			],
			"@elizaos/capacitor-secure-store": [
				"../../../../plugins/plugin-native-secure-store/src/index.ts"
			],
			"@elizaos/capacitor-secure-store/*": [
				"../../../../plugins/plugin-native-secure-store/src/*"
			],
			"@elizaos/core": ["../../../core/src/index.ts"],
			"@elizaos/plugin-elizacloud": [
				"../../../../plugins/plugin-elizacloud/src/index.node.ts"
			],
			"@elizaos/plugin-elizacloud/*": [
				"../../../../plugins/plugin-elizacloud/src/*"
			],
			"@elizaos/cloud-sdk": ["../../../cloud/sdk/src/index.ts"],
			"@elizaos/cloud-sdk/*": ["../../../cloud/sdk/src/*"],
			"@elizaos/plugin-coding-tools": [
				"../../../../plugins/plugin-coding-tools/src/index.ts"
			],
			"@elizaos/plugin-coding-tools/*": [
				"../../../../plugins/plugin-coding-tools/src/*"
			],
			"@elizaos/plugin-workflow": [
				"../../../../plugins/plugin-workflow/src/index.ts"
			],
			"@elizaos/plugin-workflow/*": [
				"../../../../plugins/plugin-workflow/src/*"
			],
			"@elizaos/plugin-wallet/ui": [
				"../../../../plugins/plugin-wallet/src/ui/index.ts"
			],
			"@elizaos/plugin-wallet/*": ["../../../../plugins/plugin-wallet/src/*"],
			"@elizaos/plugin-agent-orchestrator": [
				"../../../../plugins/plugin-agent-orchestrator/src/index.ts"
			],
			"@elizaos/plugin-agent-orchestrator/ui": [
				"../../../../plugins/plugin-agent-orchestrator/src/ui/index.ts"
			],
			"@elizaos/plugin-agent-orchestrator/ui/*": [
				"../../../../plugins/plugin-agent-orchestrator/src/ui/*"
			],
			"@elizaos/auth/vault": ["../../../auth/src/vault/index.ts"],
			"@elizaos/auth/vault/*": ["../../../auth/src/vault/*"],
			"@elizaos/plugin-wallet": [
				"../../../../plugins/plugin-wallet/src/index.ts"
			],
			"@elizaos/plugin-sql": ["../../../../plugins/plugin-sql/src/index.ts"],
			"@elizaos/plugin-native-inference/host-bridge": [
				"../../../../plugins/plugin-native-inference/src/bridge.ts"
			],
			"@elizaos/plugin-native-inference/*": [
				"../../../../plugins/plugin-native-inference/src/*"
			],
			"@elizaos/plugin-local-inference": [
				"../../../../plugins/plugin-local-inference/src/index.ts"
			],
			"@elizaos/plugin-local-inference/*": [
				"../../../../plugins/plugin-local-inference/src/*"
			],
			"@elizaos/capacitor-*": [
				"../../../../plugins/plugin-native-*/src/index.ts"
			],
			"@elizaos/plugin-anthropic": [
				"../../../../plugins/plugin-anthropic/index.ts"
			],
			"@elizaos/plugin-browser": [
				"../../../../plugins/plugin-browser/src/index.ts"
			],
			"@elizaos/plugin-computeruse": [
				"../../../../plugins/plugin-computeruse/src/index.ts"
			],
			"@elizaos/plugin-discord": [
				"../../../../plugins/plugin-discord/index.ts"
			],
			"@elizaos/plugin-elizacloud/endpoint-config": [
				"../../../../plugins/plugin-elizacloud/src/utils/config.ts"
			],
			"@elizaos/plugin-native-inference": [
				"../../../../plugins/plugin-native-inference/src/index.ts"
			],
			"@elizaos/plugin-openai": ["../../../../plugins/plugin-openai/index.ts"],
			"@elizaos/plugin-video": [
				"../../../../plugins/plugin-video/src/index.ts"
			],
			"@elizaos/core/*": ["../../../core/src/*"]
		}
	},
	"include": ["src/**/*.ts", "../../scripts/electrobun/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
