{
  "//": [
    "Source resolution for the accounts UI browser fixture API server.",
    "The real account pool, credentials, and shared runtime dependencies must",
    "resolve to this checkout during a clean install with no dist artifacts."
  ],
  "compilerOptions": {
    "baseUrl": "../../../..",
    "paths": {
      "@elizaos/app-core/account-pool": [
        "packages/app-core/src/services/account-pool.ts"
      ],
      "@elizaos/core": ["packages/core/src/index.ts"],
      "@elizaos/cloud-routing": ["packages/cloud/routing/src/index.ts"],
      "@elizaos/cloud-routing/*": ["packages/cloud/routing/src/*"],
      "@elizaos/shared": ["packages/shared/src/index.ts"],
      "@elizaos/shared/*": ["packages/shared/src/*"],
      "@elizaos/credentials/vault": ["packages/credentials/src/vault/index.ts"],
      "@elizaos/credentials/vault/*": ["packages/credentials/src/vault/*"],
      "@elizaos/credentials/auth": ["packages/credentials/src/auth/index.ts"],
      "@elizaos/credentials/auth/*": ["packages/credentials/src/auth/*"]
    }
  }
}
