{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.{ts,tsx}",
    "app.config.ts",
    "capacitor.config.ts",
    "vite.config.ts",
    "vite-dev-origin.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "playwright.*.config.ts",
    "scripts/**/*.{mjs,ts}",
    "vite/**/*.ts",
    "test/**/*.{ts,tsx}",
    "platforms/**/*.{ts,tsx}",
    "vitest*.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts}",
    "vite/**/*.ts",
    "*.ts",
    "test/**/*.{ts,tsx}",
    "platforms/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@capacitor/barcode-scanner",
    "@capacitor/browser",
    "@capacitor/haptics",
    "@capacitor/push-notifications",
    "@elizaos/app-.*",
    "@elizaos/capacitor-.*",
    "@elizaos/plugin-.*",
    "@elizaos/ui",
    "@pixiv/three-vrm",
    "llama-cpp-capacitor",
    "pathe",
    "tailwindcss",
    "three",
    "ws",
    "@capacitor/background-runner",
    "@capacitor/keyboard",
    "@capacitor/local-notifications",
    "@elizaos/plugin-anthropic",
    "@elizaos/plugin-openai",
    "@elizaos/plugin-wechat"
  ],
  "ignoreUnresolved": ["tsx", "scripts/build.mjs"],
  "ignore": ["dist/**", "ios/**", "android/**", "web-dist/**"],
  "vite": false,
  "vitest": false,
  "ignoreBinaries": [
    "adb",
    "afconvert",
    "anvil",
    "brew",
    "cmake",
    "file",
    "findstr",
    "hf",
    "log",
    "netstat",
    "ninja",
    "nm",
    "nvidia-smi",
    "otool",
    "pgrep",
    "rg",
    "ruby",
    "say",
    "secret-tool",
    "strip",
    "swift",
    "tsc6",
    "where",
    "winget"
  ]
}
