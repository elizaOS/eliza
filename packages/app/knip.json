{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/*.{ts,tsx}",
    "src/api/auth.ts",
    "src/api/automation-node-contributors.ts",
    "src/api/cloud-pair-route.ts",
    "src/api/compat-route-shared.ts",
    "src/api/ios-local-agent-transport.ts",
    "src/api/response.ts",
    "src/platform/ios-runtime-backends.ts",
    "src/platform/native-plugin-entrypoints.ts",
    "src/security/agent-vault-id.ts",
    "src/security/platform-secure-store-node.ts",
    "src/security/platform-secure-store.ts",
    "src/services/auth-store.ts",
    "src/services/steward-credentials.ts",
    "src/services/steward-sidecar/helpers.ts",
    "src/services/task-host-capabilities.ts",
    "src/services/vault-mirror.ts",
    "src/terminal/links.ts",
    "src/terminal/theme.ts",
    "src/shims/**/*.{ts,tsx}",
    "src/api/dev-stack.ts",
    "src/api/first-run-routes.ts",
    "src/api/i18n-locale-routes.ts",
    "src/api/internal-routes.ts",
    "src/api/server-cors.ts",
    "src/api/server.ts",
    "src/platform/chat-failure-strings.ts",
    "src/platform/ios-runtime-bridge.ts",
    "src/runtime/dev-server.ts",
    "src/runtime/dev-trajectory-recovery-ipc.ts",
    "src/runtime/eliza.ts",
    "src/runtime/install-agent-host-bridge.ts",
    "src/services/confidential-environment.ts",
    "src/services/confidential-provision.ts",
    "src/services/confidential-release.ts",
    "src/**/*.{test,spec}.{ts,tsx}",
    "app.config.ts",
    "capacitor.config.ts",
    "vite.config.ts",
    "vite-dev-origin.ts",
    "vitest*.config.ts",
    "playwright.*.config.ts",
    "scripts/**/*.ts",
    "vite/**/*.ts",
    "test/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx,mjs}",
    "platforms/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "vite/**/*.ts",
    "*.ts",
    "test/**/*.{ts,tsx}",
    "platforms/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@capacitor/barcode-scanner",
    "@capacitor/browser",
    "@capacitor/haptics",
    "@capacitor/push-notifications",
    "@elizaos/app-.*",
    "@elizaos/capacitor-.*",
    "@elizaos/plugin-.*",
    "@elizaos/ui",
    "@pixiv/three-vrm",
    "llama-cpp-capacitor",
    "pathe",
    "tailwindcss",
    "three",
    "ws",
    "@capacitor/background-runner",
    "@capacitor/keyboard",
    "@capacitor/local-notifications",
    "@elizaos/plugin-anthropic",
    "@elizaos/plugin-openai",
    "@elizaos/plugin-wechat"
  ],
  "ignoreUnresolved": ["tsx", "scripts/build.ts"],
  "ignore": ["dist/**", "ios/**", "android/**", "web-dist/**"],
  "vite": false,
  "vitest": false,
  "ignoreBinaries": [
    "adb",
    "afconvert",
    "anvil",
    "brew",
    "cmake",
    "file",
    "findstr",
    "hf",
    "log",
    "netstat",
    "ninja",
    "nm",
    "nvidia-smi",
    "otool",
    "pgrep",
    "rg",
    "ruby",
    "say",
    "secret-tool",
    "strip",
    "swift",
    "tsc6",
    "where",
    "winget"
  ]
}
