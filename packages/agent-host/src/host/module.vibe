// spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"; spec/agent/plugins/profile.md, "A product route never claims a route prefix an agent module owns"
import type { AgentRuntime, Plugin, UUID } from "@elizaos/core"
import type { LocalRoute } from "@elizaos/agent"
import type { ConversationOwner } from "../conversation/turns.vibe"
import type { ModelBinding } from "../../gen/agent__models__binding.effect.vibe"
import type { LaunchDocument, LaunchFrame } from "@elizaos/agent"

export type AgentPlugin = Plugin & { readonly routes?: readonly LocalRoute[] }

export interface AgentModule {
  readonly name: string
  readonly plugin: AgentPlugin
}

export error ModuleRefused { module: string; reason: string }

export interface ViewFeeds {
  receivers(clientId: string): number
  onRendererClosed(clientId: string, closed: () => void): () => void
}

export type PublishEvent = (stream: string, payload: unknown, clientId?: string) => void

export interface ConversationNews {
  readonly updated: (payload: unknown) => void
  readonly proactive: (payload: unknown) => void
}

export interface ModuleContext {
  readonly runtime: AgentRuntime
  readonly launch: LaunchDocument
  readonly stateDirectory: string
  readonly storageKey?: NonNullable<LaunchFrame["storageKey"]>
  readonly timeZone: string
  readonly epoch: number
  readonly ownerEntityId: UUID
  readonly conversationOwner?: ConversationOwner
  readonly binding: () => ModelBinding
  readonly publishEvent?: PublishEvent | undefined
  readonly conversationNews?: ConversationNews | undefined
  readonly viewFeeds?: ViewFeeds | undefined
}

export type ModuleFactory<R> = (context: ModuleContext) => AgentModule!ModuleRefused!R

export function routePrefix(path: string): string {
  return `/${path.split("/").filter((segment) => segment !== "").slice(0, 2).join("/")}`
}

export function routePrefixes(plugin: AgentPlugin): string[] {
  return [...new Set((plugin.routes ?? []).map((route) => routePrefix(route.path)))]
}

export function actionNames(runtime: AgentRuntime): Set<string> {
  return new Set(runtime.actions.map((action) => action.name))
}
