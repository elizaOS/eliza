// spec/agent/schedule/triggers.md, "An event trigger runs once for each emitted event of its name, never for its own run's events"
module node {
  import { Option, Schema } from "effect"
  import { EventType, type AgentRuntime, type EventPayload } from "@elizaos/core"

  export const triggerEventNames = [EventType.MESSAGE_RECEIVED, EventType.MESSAGE_SENT, EventType.REACTION_RECEIVED, EventType.ENTITY_JOINED] as const
  export type TriggerEventName = typeof triggerEventNames[number]

  export interface TriggerEventTarget {
    eventTriggers(name: TriggerEventName): Promise<readonly string[]>
    receiveEvent(triggerId: string, eventId: string, name: TriggerEventName, ownRun: boolean): Promise<void>
  }

  export interface TriggerEvents {
    idle(): Promise<void>
    stop(): Promise<void>
  }

  const Id = Schema.String.check(Schema.isMinLength(1))
  const messageEvent = Schema.decodeUnknownOption(Schema.Struct({ message: Schema.Struct({ id: Id, metadata: Schema.optional(Schema.Unknown) }) }))
  const entityEvent = Schema.decodeUnknownOption(Schema.Struct({ entityId: Id, roomId: Id }))
  const raisedBy = Schema.decodeUnknownOption(Schema.Struct({ triggerId: Id }))

  function emitted(name: TriggerEventName, payload: unknown): { readonly eventId: string; readonly raisedBy: string | undefined } | undefined {
    if (name === EventType.ENTITY_JOINED) {
      const joined = Option.getOrUndefined(entityEvent(payload))
      return joined === undefined ? undefined : { eventId: `${joined.entityId}:${joined.roomId}`, raisedBy: undefined }
    }
    const message = Option.getOrUndefined(messageEvent(payload))?.message
    return message === undefined ? undefined : { eventId: message.id, raisedBy: Option.getOrUndefined(raisedBy(message.metadata))?.triggerId }
  }

  export function startTriggerEvents(runtime: AgentRuntime, target: TriggerEventTarget): TriggerEvents {
    const queues = new Map<string, Promise<void>>()
    let stopped = false

    function enqueue(triggerId: string, receive: () => Promise<void>) {
      const next = (queues.get(triggerId) ?? Promise.resolve())
        .then(() => stopped ? undefined : receive())
        .catch((cause: unknown) => runtime.reportError("triggers.events", cause, { triggerId }))
      queues.set(triggerId, next)
      void next.then(() => { if (queues.get(triggerId) === next) queues.delete(triggerId) })
    }

    const handlers = triggerEventNames.map((name) => {
      const handler = async (payload: EventPayload) => {
        const event = stopped ? undefined : emitted(name, payload)
        if (event === undefined) return
        try {
          for (const triggerId of await target.eventTriggers(name))
            enqueue(triggerId, () => target.receiveEvent(triggerId, event.eventId, name, event.raisedBy === triggerId))
        } catch (cause) {
          runtime.reportError("triggers.events", cause, { name })
        }
      }
      runtime.registerEvent(name, handler)
      return { name, handler }
    })

    const idle = async () => { while (queues.size > 0) await Promise.all(queues.values()) }

    return {
      idle,
      async stop() {
        stopped = true
        for (const { name, handler } of handlers) runtime.unregisterEvent(name, handler)
        await idle()
      },
    }
  }
}
export { startTriggerEvents, triggerEventNames, type TriggerEventName, type TriggerEventTarget, type TriggerEvents } from node
