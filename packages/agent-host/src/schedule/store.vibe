// spec/agent/schedule/triggers.md, "An edit, enable or removal is refused only when it names a revision that has moved on"; spec/agent/schedule/triggers.md, "The run history keeps the last 100 records"; spec/agent/schedule/scheduledTasks.md, "Every change commits against the revision it read"; spec/agent/schedule/scheduledTasks.md, "A keyed verb applies once per key"; spec/agent/storage/database.md, "Queries run only while the store is open, and close waits for every one in flight"
import type { IDatabaseAdapter } from "@elizaos/core"
import { initial as unsavedTrigger, type Trigger } from "../../gen/agent__schedule__triggers.effect.vibe"
import type { ScheduledTask } from "../../gen/agent__schedule__scheduledTasks.effect.vibe"
import { currentFiber, readFirst } from "../storage/transaction.vibe"

export error ScheduleStoreUnavailable { step: string; cause: unknown }
export error StaleRevision { table: "schedule_triggers" | "schedule_tasks"; id: string; revision: number }
/** @public */
export error MissingTriggerDetails { id: string }
/** @public */
export error NoScheduledTask { taskId: string }
/** @public */
export error TaskIdTaken { taskId: string }

module node {
  import { Schema } from "effect"
  import type { IDatabaseAdapter } from "@elizaos/core"
  import { withinTransaction, type Sql } from "../storage/transaction.vibe"
  import { maxRunHistory, parseState as parseTrigger, type RunSource, type RunStatus, type Trigger } from "../../gen/agent__schedule__triggers.ts"
  import { parseState as parseTask, type ScheduledTask } from "../../gen/agent__schedule__scheduledTasks.ts"

  export interface TriggerDetails {
    readonly displayName: string
    readonly instructions: string
    readonly triggerType: "once" | "cron" | "event"
    readonly timezone: string
    readonly scheduledAtIso?: string
    readonly cronExpression?: string
    readonly eventKind?: string
  }

  export interface TriggerRun {
    readonly startedAt: number
    readonly finishedAt: number
    readonly status: RunStatus
    readonly source: RunSource
    readonly error?: string
    readonly missedOccurrenceAt?: number
  }

  export interface StoredTrigger {
    readonly id: string
    readonly revision: number
    readonly state: Trigger
    readonly details: TriggerDetails
  }

  export type StoredTaskTrigger =
    | { readonly kind: "once"; readonly atIso: string }
    | { readonly kind: "cron"; readonly expression: string; readonly tz: string }
    | { readonly kind: "manual" }

  export interface ScheduledTaskDetails {
    readonly kind: string
    readonly promptInstructions: string
    readonly trigger: StoredTaskTrigger
    readonly metadata: Readonly<Record<string, unknown>>
    readonly firedAt?: number
    readonly lastDecisionLog?: string
  }

  export interface NewScheduledTask {
    readonly taskId: string
    readonly idempotencyKey?: string
    readonly ownerVisible: boolean
    readonly state: ScheduledTask
    readonly details: ScheduledTaskDetails
  }

  export interface StoredTask extends NewScheduledTask {
    readonly revision: number
  }

  export type Written = "written" | "stale"
  export type Created =
    | { readonly kind: "created"; readonly task: StoredTask }
    | { readonly kind: "existing"; readonly task: StoredTask }
    | { readonly kind: "taken" }

  type Row = { revision: number; data: unknown }
  type TaskRow = Row & { task_id: string; idempotency_key: string | null; owner_visible: boolean }

  const Text = Schema.String
  const Details = Schema.Struct({
    displayName: Text, instructions: Text, triggerType: Schema.Literals(["once", "cron", "event"]), timezone: Text,
    scheduledAtIso: Schema.optionalKey(Text), cronExpression: Schema.optionalKey(Text), eventKind: Schema.optionalKey(Text),
  })
  const Run = Schema.Struct({
    startedAt: Schema.Number, finishedAt: Schema.Number,
    status: Schema.Literals(["RunSuccess", "RunError", "RunSkipped"]),
    source: Schema.Literals(["RunNow", "Scheduled", "FromEvent"]),
    error: Schema.optionalKey(Text), missedOccurrenceAt: Schema.optionalKey(Schema.Number),
  })
  const TaskDetails = Schema.Struct({
    kind: Text, promptInstructions: Text,
    trigger: Schema.Union([
      Schema.Struct({ kind: Schema.Literal("once"), atIso: Text }),
      Schema.Struct({ kind: Schema.Literal("cron"), expression: Text, tz: Text }),
      Schema.Struct({ kind: Schema.Literal("manual") }),
    ]),
    metadata: Schema.Record(Schema.String, Schema.Unknown),
    firedAt: Schema.optionalKey(Schema.Number), lastDecisionLog: Schema.optionalKey(Text),
  })
  const decodeDetails = Schema.decodeUnknownSync(Details)
  const decodeRun = Schema.decodeUnknownSync(Run)
  const decodeTaskDetails = Schema.decodeUnknownSync(TaskDetails)

  const within = <A>(adapter: IDatabaseAdapter, work: (sql: Sql) => Promise<A>): Promise<A> => withinTransaction(adapter, "schedule store", work)

  function field(data: unknown, name: string): unknown {
    return typeof data === "object" && data !== null ? Reflect.get(data, name) : undefined
  }

  function trigger(id: string, row: Row): StoredTrigger {
    const state = parseTrigger(field(row.data, "state"))
    if (state === undefined) throw new TypeError(`The stored trigger ${id} holds no trigger state`)
    return { id, revision: row.revision, state, details: decodeDetails(field(row.data, "details")) }
  }

  function task(row: TaskRow): StoredTask {
    const state = parseTask(field(row.data, "state"))
    if (state === undefined) throw new TypeError(`The stored scheduled task ${row.task_id} holds no task state`)
    return {
      taskId: row.task_id, revision: row.revision, ownerVisible: row.owner_visible, state,
      details: decodeTaskDetails(field(row.data, "details")),
      ...(row.idempotency_key === null ? {} : { idempotencyKey: row.idempotency_key }),
    }
  }

  const saved = "data->'state'->>'life' = 'Saved'"

  export function readTrigger(adapter: IDatabaseAdapter, id: string): Promise<StoredTrigger | undefined> {
    return within(adapter, async (sql) => {
      const found = await sql.query<Row>("SELECT revision, data FROM schedule_triggers WHERE id = $1", [id])
      const row = found.rows[0]
      return row === undefined ? undefined : trigger(id, row)
    })
  }

  export function savedTriggers(adapter: IDatabaseAdapter): Promise<StoredTrigger[]> {
    return within(adapter, async (sql) => {
      const found = await sql.query<Row & { id: string }>(`SELECT id, revision, data FROM schedule_triggers WHERE ${saved} ORDER BY id`)
      return found.rows.map((row) => trigger(row.id, row))
    })
  }

  export function enabledTriggers(adapter: IDatabaseAdapter, except: string | undefined): Promise<number> {
    return within(adapter, async (sql) => {
      const found = await sql.query<{ count: number }>(
        `SELECT count(*)::int AS count FROM schedule_triggers
          WHERE ${saved} AND data->'state'->'enabled' = 'true'::jsonb AND ($1::text IS NULL OR id <> $1)`,
        [except ?? null],
      )
      return found.rows[0]?.count ?? 0
    })
  }

  async function addRun(sql: Sql, id: string, run: TriggerRun): Promise<boolean> {
    const added = await sql.query<{ seq: number }>(
      `INSERT INTO schedule_trigger_runs (trigger_id, seq, data)
         SELECT $1, COALESCE((SELECT max(seq) FROM schedule_trigger_runs WHERE trigger_id = $1), 0) + 1, $2::jsonb
         WHERE EXISTS (SELECT 1 FROM schedule_triggers WHERE id = $1 AND ${saved})
         RETURNING seq`,
      [id, JSON.stringify(decodeRun(run))],
    )
    const seq = added.rows[0]?.seq
    if (seq === undefined) return false
    await sql.query("DELETE FROM schedule_trigger_runs WHERE trigger_id = $1 AND seq <= $2", [id, seq - maxRunHistory])
    return true
  }

  export function appendRun(adapter: IDatabaseAdapter, id: string, run: TriggerRun): Promise<boolean> {
    return within(adapter, (sql) => addRun(sql, id, run))
  }

  export function triggerRuns(adapter: IDatabaseAdapter, id: string): Promise<TriggerRun[]> {
    return within(adapter, async (sql) => {
      const found = await sql.query<{ data: unknown }>("SELECT data FROM schedule_trigger_runs WHERE trigger_id = $1 ORDER BY seq", [id])
      return found.rows.map((row) => decodeRun(row.data))
    })
  }

  export function writeTrigger(
    adapter: IDatabaseAdapter, id: string, read: number, next: Trigger, details: TriggerDetails, run: TriggerRun | undefined,
  ): Promise<Written> {
    return within(adapter, async (sql) => {
      const gone = next.life === "Removed" && next.activity.tag === "Idle"
      if (next.life === "Unsaved" || (gone && read === 0)) return "written"
      const data = JSON.stringify({ state: next, details: decodeDetails(details) })
      const result = read === 0
        ? await sql.query("INSERT INTO schedule_triggers (id, revision, data) VALUES ($1, 1, $2::jsonb) ON CONFLICT (id) DO NOTHING", [id, data])
        : gone
          ? await sql.query("DELETE FROM schedule_triggers WHERE id = $1 AND revision = $2", [id, read])
          : await sql.query("UPDATE schedule_triggers SET revision = revision + 1, data = $3::jsonb WHERE id = $1 AND revision = $2", [id, read, data])
      if (result.affectedRows !== 1) return "stale"
      if (run !== undefined) await addRun(sql, id, run)
      return "written"
    })
  }

  const taskColumns = "task_id, revision, idempotency_key, owner_visible, data"

  export function readTask(adapter: IDatabaseAdapter, taskId: string): Promise<StoredTask | undefined> {
    return within(adapter, async (sql) => {
      const found = await sql.query<TaskRow>(`SELECT ${taskColumns} FROM schedule_tasks WHERE task_id = $1`, [taskId])
      const row = found.rows[0]
      return row === undefined ? undefined : task(row)
    })
  }

  export function taskByKey(adapter: IDatabaseAdapter, key: string): Promise<StoredTask | undefined> {
    return within(adapter, async (sql) => {
      const found = await sql.query<TaskRow>(`SELECT ${taskColumns} FROM schedule_tasks WHERE idempotency_key = $1`, [key])
      const row = found.rows[0]
      return row === undefined ? undefined : task(row)
    })
  }

  export function tasks(adapter: IDatabaseAdapter, ownerVisibleOnly: boolean): Promise<StoredTask[]> {
    return within(adapter, async (sql) => {
      const found = await sql.query<TaskRow>(
        `SELECT ${taskColumns} FROM schedule_tasks WHERE owner_visible OR NOT $1::boolean ORDER BY task_id`, [ownerVisibleOnly],
      )
      return found.rows.map(task)
    })
  }

  export function insertTask(adapter: IDatabaseAdapter, row: NewScheduledTask): Promise<Created> {
    return within(adapter, async (sql) => {
      const data = JSON.stringify({ state: row.state, details: decodeTaskDetails(row.details) })
      const inserted = await sql.query<TaskRow>(
        `INSERT INTO schedule_tasks (${taskColumns}) VALUES ($1, 1, $2, $3, $4::jsonb) ON CONFLICT DO NOTHING RETURNING ${taskColumns}`,
        [row.taskId, row.idempotencyKey ?? null, row.ownerVisible, data],
      )
      const created = inserted.rows[0]
      if (created !== undefined) return { kind: "created", task: task(created) }
      if (row.idempotencyKey === undefined) return { kind: "taken" }
      const found = await sql.query<TaskRow>(`SELECT ${taskColumns} FROM schedule_tasks WHERE idempotency_key = $1`, [row.idempotencyKey])
      const existing = found.rows[0]
      return existing === undefined ? { kind: "taken" } : { kind: "existing", task: task(existing) }
    })
  }

  export function writeTask(adapter: IDatabaseAdapter, taskId: string, read: number, next: ScheduledTask, details: ScheduledTaskDetails): Promise<Written> {
    return within(adapter, async (sql) => {
      const data = JSON.stringify({ state: next, details: decodeTaskDetails(details) })
      const result = await sql.query(
        "UPDATE schedule_tasks SET revision = revision + 1, data = $3::jsonb WHERE task_id = $1 AND revision = $2", [taskId, read, data],
      )
      return result.affectedRows === 1 ? "written" : "stale"
    })
  }
}
import {
  appendRun, enabledTriggers, insertTask, readTask, readTrigger, savedTriggers, taskByKey, tasks, triggerRuns, writeTask, writeTrigger,
  type NewScheduledTask, type ScheduledTaskDetails, type StoredTask, type StoredTrigger, type TriggerDetails, type TriggerRun,
} from node
export type {
  NewScheduledTask, ScheduledTaskDetails, StoredTask, StoredTaskTrigger, StoredTrigger, TriggerDetails, TriggerRun,
} from node

export interface TriggerWrite {
  readonly details?: TriggerDetails
  readonly run?: TriggerRun
}

export type ReviseDetails = (details: ScheduledTaskDetails, next: ScheduledTask) => ScheduledTaskDetails

effect function stored<A>(step: string, call: () => Promise<A>) {
  return try tryPromise({ try: () => call(), catch: (cause) => new ScheduleStoreUnavailable({ step, cause }) })
}

export function triggerKeeping(adapter: IDatabaseAdapter, id: string, write: TriggerWrite = {}) {
  const reads = new Map<number, { readonly revision: number; readonly details: TriggerDetails | undefined }>()
  const load = effect function (): Trigger!ScheduleStoreUnavailable {
    const row = try stored("read a trigger", () => readTrigger(adapter, id))
    reads.set(try currentFiber(), { revision: row?.revision ?? 0, details: row?.details })
    return row?.state ?? unsavedTrigger
  }
  const keep = effect function (next: Trigger): void!! {
    const read = try readFirst(reads, "schedule")
    const details = write.details ?? read.details
    if (details === undefined) return try die(new MissingTriggerDetails({ id }))
    const written = try orDie(stored("keep a trigger", () => writeTrigger(adapter, id, read.revision, next, details, write.run)))
    if (written === "stale") try die(new StaleRevision({ table: "schedule_triggers", id, revision: read.revision }))
  }
  return { load, keep }
}

export function scheduledTaskKeeping(adapter: IDatabaseAdapter, taskId: string, revise: ReviseDetails = (details) => details) {
  const reads = new Map<number, StoredTask>()
  const load = effect function (): ScheduledTask!(ScheduleStoreUnavailable | NoScheduledTask) {
    const row = try stored("read a scheduled task", () => readTask(adapter, taskId))
    if (row === undefined) throw new NoScheduledTask({ taskId })
    reads.set(try currentFiber(), row)
    return row.state
  }
  const keep = effect function (next: ScheduledTask): void!! {
    const read = try readFirst(reads, "schedule")
    const written = try orDie(stored("keep a scheduled task", () => writeTask(adapter, taskId, read.revision, next, revise(read.details, next))))
    if (written === "stale") try die(new StaleRevision({ table: "schedule_tasks", id: taskId, revision: read.revision }))
  }
  return { load, keep }
}

export effect function getTrigger(adapter: IDatabaseAdapter, id: string): (StoredTrigger | undefined)!ScheduleStoreUnavailable {
  const row = try stored("read a trigger", () => readTrigger(adapter, id))
  return row?.state.life === "Saved" ? row : undefined
}

export effect function listTriggers(adapter: IDatabaseAdapter): StoredTrigger[]!ScheduleStoreUnavailable {
  return try stored("list triggers", () => savedTriggers(adapter))
}

export effect function countEnabledTriggers(adapter: IDatabaseAdapter, except?: string): number!ScheduleStoreUnavailable {
  return try stored("count enabled triggers", () => enabledTriggers(adapter, except))
}

export effect function appendTriggerRun(adapter: IDatabaseAdapter, id: string, run: TriggerRun): boolean!ScheduleStoreUnavailable {
  return try stored("append a trigger run", () => appendRun(adapter, id, run))
}

export effect function listTriggerRuns(adapter: IDatabaseAdapter, id: string): TriggerRun[]!ScheduleStoreUnavailable {
  return try stored("list trigger runs", () => triggerRuns(adapter, id))
}

export effect function createScheduledTask(adapter: IDatabaseAdapter, row: NewScheduledTask) {
  const created = try stored("create a scheduled task", () => insertTask(adapter, row))
  if (created.kind === "taken") throw new TaskIdTaken({ taskId: row.taskId })
  return created
}

export effect function getScheduledTask(adapter: IDatabaseAdapter, taskId: string): (StoredTask | undefined)!ScheduleStoreUnavailable {
  return try stored("read a scheduled task", () => readTask(adapter, taskId))
}

export effect function scheduledTaskByKey(adapter: IDatabaseAdapter, key: string): (StoredTask | undefined)!ScheduleStoreUnavailable {
  return try stored("find a scheduled task by key", () => taskByKey(adapter, key))
}

export effect function listScheduledTasks(adapter: IDatabaseAdapter, filter: { readonly ownerVisibleOnly: boolean }): StoredTask[]!ScheduleStoreUnavailable {
  return try stored("list scheduled tasks", () => tasks(adapter, filter.ownerVisibleOnly))
}
