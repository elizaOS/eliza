// spec/agent/deviceActions/operations.md, "A turn targets the photo open on the owner's screen only from the Photos view, never on a sensitive screen, and names its library ID only under the library capability"; spec/agent/deviceActions/operations.md, "Each operation has one capability need, which a clock-only device meets only for the Clock handoff"; spec/agent/deviceActions/surfaces.md, "A Photos proposal names only the item open in the viewer or library IDs the phone returned"; spec/agent/deviceActions/index.md, "The proposal tool states each rule once, names no capability, and shares a branch only between forms that accept the same calls"
import { negotiatedHas, type Negotiation } from "../../gen/agent__deviceActions__capabilities.effect.vibe"
import { shownPhotoTarget } from "../../gen/agent__deviceActions__operations.effect.vibe"
import { photosVerdict, type PhotoNaming, type SurfaceVerdict } from "../../gen/agent__deviceActions__surfaces.effect.vibe"
import { type Observation, readOperation, readResult, type CheckedOperation, type DeviceOperation } from "@elizaos/agent"
import type { DeviceTurn, EarlierRequest, Grounding } from "./proposal/family.vibe"
import type { DeviceStoreUnavailable } from "./store.vibe"

const photosView = "photos"

export type ShownPhoto = { readonly ids: readonly []; readonly selected: true } | { readonly ids: readonly [string] }

function libraryIdOf(observation: Observation): string | undefined {
  const id = observation.selectedObject?.id
  return id !== undefined && readOperation({ type: "photos_open", id }) !== undefined ? id : undefined
}

export function shownPhoto(observation: Observation | undefined, negotiation: Negotiation): ShownPhoto | undefined {
  if (observation === undefined) return undefined
  const id = libraryIdOf(observation)
  switch (shownPhotoTarget(observation.view === photosView, observation.sensitive, id !== undefined, negotiation)) {
    case "OpenPhoto": return { ids: [], selected: true }
    case "ShownLibraryId": return id === undefined ? undefined : { ids: [id] }
    case "NoPhotoTarget": return undefined
  }
}

export const returnedIdsGuidance = "Use only phone-returned library ids/revisions; never guess."

export function photosViewGuidance(negotiation: Negotiation): readonly string[] {
  if (!negotiatedHas(negotiation, "PhotosLibraryV1") || !negotiatedHas(negotiation, "PhotosViewV1")) return []
  const base = "photos_filter filters Photos grid (returns count only); photos_open opens one item (both direct only if asked). photos_album_create/photos_share open Photos review (share then opens Android sheet); review_opened proves neither."
  return negotiatedHas(negotiation, "PhotosViewSelectedV1")
    ? [base, "photos_album_create/photos_share with selected:true use the one item the owner has open in the Photos viewer instead of ids (for 'this photo/video/open one').", returnedIdsGuidance]
    : [base, returnedIdsGuidance]
}

interface NamedItem {
  readonly id: string
  readonly revision?: string
}

interface PhotoNames {
  readonly naming: PhotoNaming
  readonly items: readonly NamedItem[]
}

const noPhoto: PhotoNames = { naming: "NoPhotoNamed", items: [] }
const byIds = (ids: readonly string[]): PhotoNames => ({ naming: "LibraryIdsNamed", items: ids.map((id) => ({ id })) })

function photoNames(operation: DeviceOperation): PhotoNames {
  switch (operation.type) {
    case "photos_open":
    case "photo_library_inspect":
      return byIds([operation.id])
    case "photo_library_select":
      return byIds(operation.ids)
    case "photo_library_review":
      return { naming: "LibraryIdsNamed", items: operation.items }
    case "photos_album_create":
    case "photos_share":
      return "selected" in operation ? { naming: "OpenItemNamed", items: [] } : byIds(operation.ids)
    default:
      return noPhoto
  }
}

const returningReads = ["photo_library_search", "photo_library_inspect", "camera_capture_photo"] as const
const scanned = 50

function returnedRevisions(read: EarlierRequest): readonly NamedItem[] {
  const { operation, result } = read
  switch (operation.type) {
    case "photo_library_search": return (readResult<"photo_library_search">(operation, result) as { readonly items?: readonly NamedItem[] } | undefined)?.items ?? []
    case "photo_library_inspect": {
      const item = (readResult<"photo_library_inspect">(operation, result) as { readonly item?: NamedItem } | undefined)?.item
      return item === undefined ? [] : [item]
    }
    case "camera_capture_photo": {
      const libraryId = readResult<"camera_capture_photo">(operation, result)?.libraryId
      return libraryId === undefined ? [] : [{ id: libraryId }]
    }
    default: return []
  }
}

function returned(items: readonly NamedItem[], known: readonly NamedItem[]): boolean {
  return items.every(({ id, revision }) => known.some((seen) => seen.id === id && (revision === undefined || seen.revision === revision)))
}

type Refusal = Extract<Grounding, { readonly kind: "Refused" }>

const openItemUnshown: Refusal = {
  kind: "Refused", code: "PHOTOS_OPEN_ITEM_NOT_SHOWN",
  forModel: "No photo is open in the Photos viewer on the owner's unlocked screen this turn, so the open item cannot be named. No device proposal was created. Ask the owner to open it in Photos.",
  forOwner: "Open the photo in Photos first, then ask me again.",
}

const idsUnreturned: Refusal = {
  kind: "Refused", code: "PHOTOS_ID_NOT_RETURNED",
  forModel: "A library id or revision in this operation is not one the phone returned in this conversation or shows open now. Never guess library ids. No device proposal was created.",
  forOwner: "I couldn't tell which photos you meant. Open them in Photos or ask me to find them first.",
}

function openLibraryId(observation: Observation | undefined): readonly NamedItem[] {
  const id = observation?.view === photosView && observation.sensitive === false ? libraryIdOf(observation) : undefined
  return id === undefined ? [] : [{ id }]
}

export interface PhotosDecision {
  readonly verdict: SurfaceVerdict
  readonly refusal: Refusal
}

export effect function photosDecision(proposed: CheckedOperation, turn: DeviceTurn): PhotosDecision!DeviceStoreUnavailable {
  const names = photoNames(proposed.operation)
  const shown = shownPhoto(turn.observation, turn.negotiation)
  const reads = names.naming === "LibraryIdsNamed" ? (try turn.earlier(returningReads, scanned)) : []
  const known = [...reads.flatMap(returnedRevisions), ...openLibraryId(turn.observation)]
  return {
    verdict: photosVerdict(names.naming, shown !== undefined && "selected" in shown, returned(names.items, known)),
    refusal: names.naming === "OpenItemNamed" ? openItemUnshown : idsUnreturned,
  }
}
