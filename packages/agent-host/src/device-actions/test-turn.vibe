// spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/agent/deviceActions/capabilities.md, "A request negotiates exactly the capabilities its header names, and only on a live enrollment"
import { Effect } from "effect"
import { negotiation, validate } from "@elizaos/agent"
import type { DeviceTurn } from "./proposal/family.vibe"

export type OwnerTurnFields = Omit<DeviceTurn, "negotiation" | "capabilities" | "admit" | "signal" | "earlier" | "swapped" | "assistantName">
  & Partial<Pick<DeviceTurn, "earlier" | "swapped" | "assistantName">>

export function negotiatedOwnerTurn(capabilities: readonly string[], fields: OwnerTurnFields): DeviceTurn {
  const negotiated = negotiation(true, capabilities.join(","))
  return {
    assistantName: "Eliza", swapped: [], earlier: () => Effect.succeed([]),
    ...fields,
    negotiation: negotiated, capabilities, signal: new AbortController().signal,
    admit: (operation) => validate(operation, negotiated, "NoBinding"),
  }
}
