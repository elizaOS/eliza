// spec/agent/deviceActions/index.md, "Each wire type belongs to at most one proposal family, and a family offers forms only of its own types"; spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/agent/conversation/planning.md, "Each call of a conversation starts with the same system prompt and tools, and what changes per turn follows the history"
import type { IAgentRuntime } from "@elizaos/core"
import { registrationAdmitted } from "../../../gen/agent__deviceActions.effect.vibe"
import type { DeviceOperationType } from "@elizaos/agent"
import type { DeviceProposalFamily, DeviceTurn, NegotiatedDevice, ProposalForm } from "./family.vibe"

export {
  directRequests, unoffered, untrustedReturnGuidance,
  type DeviceProposalFamily, type DeviceTurn, type EarlierRequest, type FamilyName, type Grounding, type NegotiatedDevice, type PendingRequest,
  type ProposalForm, type ProposalGrounding, type ProposalText, type ReadContinuation, type SwappedValue,
} from "./family.vibe"

export error FamilyConflict { family: string; type: string }

const registries = new WeakMap<IAgentRuntime, Map<DeviceOperationType, DeviceProposalFamily>>()

function registryOf(runtime: IAgentRuntime): Map<DeviceOperationType, DeviceProposalFamily> {
  const known = registries.get(runtime)
  if (known !== undefined) return known
  const created = new Map<DeviceOperationType, DeviceProposalFamily>()
  registries.set(runtime, created)
  return created
}

export effect function registerDeviceProposalFamily(runtime: IAgentRuntime, family: DeviceProposalFamily): void!FamilyConflict {
  const registry = registryOf(runtime)
  const claimed = family.types.find((type) => { const owner = registry.get(type); return owner !== undefined && owner !== family })
  const foreign = family.forms.flatMap(({ types }) => types).find((type) => !family.types.includes(type))
  if (!registrationAdmitted(claimed !== undefined, foreign === undefined)) {
    throw new FamilyConflict({ family: family.name, type: claimed ?? foreign ?? "" })
  }
  for (const type of family.types) registry.set(type, family)
}

export function familyOf(runtime: IAgentRuntime, type: DeviceOperationType): DeviceProposalFamily | undefined {
  return registries.get(runtime)?.get(type)
}

export function registeredFamilies(runtime: IAgentRuntime): readonly DeviceProposalFamily[] {
  return [...new Set(registries.get(runtime)?.values() ?? [])]
}

export function negotiatedPart({ negotiation, capabilities, viewProfile, admit }: NegotiatedDevice): NegotiatedDevice {
  return { negotiation, capabilities, admit, ...(viewProfile === undefined ? {} : { viewProfile }) }
}

export function offeredForms(runtime: IAgentRuntime, device: NegotiatedDevice): readonly ProposalForm[] {
  return registeredFamilies(runtime).flatMap((family) => family.forms.filter((form) => form.offered(device)))
}

export function availableNow(form: ProposalForm, turn: DeviceTurn): boolean {
  return form.now?.available(turn) ?? true
}

export function messageNote(runtime: IAgentRuntime, turn: DeviceTurn): string | undefined {
  const heldBack = new Map<string, readonly string[]>()
  for (const form of offeredForms(runtime, turn)) {
    if (form.now !== undefined && !availableNow(form, turn)) heldBack.set(form.now.unavailable, [...new Set([...(heldBack.get(form.now.unavailable) ?? []), ...form.types])])
  }
  const notes = [
    ...registeredFamilies(runtime).flatMap((family) => family.now?.(turn) ?? []),
    ...[...heldBack].map(([reason, types]) => `${types.join(", ")} ${types.length === 1 ? "is" : "are"} not available on this message: ${reason}.`),
  ]
  return notes.length === 0 ? undefined : [...new Set(notes)].join(" ")
}
