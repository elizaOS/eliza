// spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/agent/deviceActions/index.md, "A later turn of the same conversation learns at most six outcomes of its own requests: what changed, and what ended without running"; spec/agent/deviceActions/index.md, "An unclaimed offer retires at its deadline or at the end of its turn"; spec/agent/conversation/turnContext.md, "Story: Tell the agent what my screen shows, and nothing more"
module node {
  import { AsyncLocalStorage } from "node:async_hooks"
  import { Effect } from "effect"
  import { extractUserText, getTrajectoryContext, unwrapUserMessageText, type AgentRuntime, type IAgentRuntime, type Memory, type UUID } from "@elizaos/core"
  import { capabilityName, isRefused } from "../../../gen/agent__deviceActions__capabilities.ts"
  import { type RouteInput, readTurnContext, capabilitiesHeader, negotiation, validate } from "@elizaos/agent"
  import type { DeviceEnrollment } from "../enrollment.vibe"
  import { viewProfile } from "../store.vibe"
  import type { DeviceTurn } from "./family.vibe"
  import { deviceOutcomesNote, earlierRequests, outcomesUnchecked } from "./receipts.vibe"
  import { offeredForms } from "./registry.vibe"

  export interface DeviceTurnStart {
    readonly headers: RouteInput["headers"]
    readonly conversationId: string
    readonly requestId: string
    readonly message: Memory & { readonly id: UUID }
    readonly signal: AbortSignal
  }

  export interface DeviceTurnSession {
    readonly context: string | undefined
    run<A>(work: () => Promise<A>): Promise<A>
    end(): Promise<void>
  }

  export interface DeviceTurnPort {
    begin(start: DeviceTurnStart): Promise<DeviceTurnSession | undefined>
  }

  export type TurnOffer = (turn: DeviceTurn) => Promise<(() => Promise<void>) | undefined>

  export interface DeviceTurnOptions {
    readonly completesReads: boolean
    readonly agenda?: TurnOffer
  }

  const bound = new AsyncLocalStorage<DeviceTurn>()
  const live = new WeakSet<DeviceTurn>()

  export function ownerWords(message: Memory): string {
    return extractUserText(unwrapUserMessageText(message))
  }

  export function turnLive(turn: DeviceTurn): boolean {
    return live.has(turn) && !turn.signal.aborted
  }

  export function deviceTurnFor(runtime: IAgentRuntime, message: Memory): DeviceTurn | undefined {
    const turn = bound.getStore()
    return turn !== undefined && turnLive(turn) && turn.runtime === runtime && message.id !== undefined && turn.message.id === message.id ? turn : undefined
  }

  export function deviceTurnPort(runtime: AgentRuntime, sender: DeviceEnrollment["deviceSender"], options: DeviceTurnOptions): DeviceTurnPort {
    return {
      begin: async ({ headers, conversationId, requestId, message, signal }) => {
        const by = await Effect.runPromise(sender({ headers }))
        if (by === undefined) return undefined
        const negotiated = negotiation(true, headers.get(capabilitiesHeader))
        const context = readTurnContext(message)
        const profile = await Effect.runPromise(Effect.orElseSucceed(viewProfile(runtime.adapter), () => undefined))
        const turn: DeviceTurn = {
          runtime, by, negotiation: negotiated, message, conversationId, requestId, signal,
          capabilities: negotiated.tag === "Negotiated" ? negotiated.capabilities.map(capabilityName) : [],
          ownerText: ownerWords(message),
          observation: context.observation,
          completedActionNavigation: context.voiceUi?.viewDelivery === "completed-action",
          completesReads: options.completesReads,
          assistantName: runtime.character.name ?? "",
          get swapped() {
            return getTrajectoryContext()?.secretSwapSession?.entries ?? []
          },
          startedAt: message.createdAt ?? Date.now(),
          timeZone: context.observation?.timeZone ?? context.voiceUi?.uiTimeZone,
          ...(profile === undefined ? {} : { viewProfile: profile }),
          admit: (operation) => validate(operation, negotiated, "NoBinding"),
          earlier: (types, limit) => Effect.map(earlierRequests(runtime.adapter, by, conversationId),
            (applied) => applied.filter(({ operation }) => types.includes(operation.type)).slice(0, limit)),
        }
        live.add(turn)
        const described = !isRefused(negotiated) && offeredForms(runtime, turn).length > 0
        const note = await deviceOutcomesNote(turn, described).catch(() => outcomesUnchecked)
        const retire = await options.agenda?.(turn)
        return {
          context: note,
          run: (work) => bound.run(turn, work),
          end: async () => {
            live.delete(turn)
            await retire?.()
          },
        }
      },
    }
  }
}

export { deviceTurnFor, deviceTurnPort, ownerWords, turnLive, type DeviceTurnOptions, type DeviceTurnPort, type DeviceTurnSession, type DeviceTurnStart, type TurnOffer } from node
