// spec/agent/deviceActions/index.md, "An offer goes only to the enrolled device, for a capability it declared"; spec/agent/deviceActions/index.md, "An unclaimed offer retires at its deadline or at the end of its turn"; spec/agent/deviceActions/index.md, "A proposal's identity is its request message and its operation, so a repeat returns the same request"; spec/agent/deviceActions/operations.md, "A proposal is valid only when its shape, its need and its binding all hold"; spec/agent/conversation/turnContext.md, "Story: Tell the agent what my screen shows, and nothing more"; spec/agent/deviceActions/index.md, "A proposal carries the owner's message only for a live turn that asked for it directly, so otherwise the phone shows its card"
module node {
  import { Effect, Schema } from "effect"
  import { ModelType, type AgentRuntime } from "@elizaos/core"
  import { readTurnContext, firstOfLocalDay, CalendarSource, localCalendarDay as day, validate } from "@elizaos/agent"
  import type { AgendaOperation } from "./proposal-review.vibe"
  import type { DeviceTurn } from "./proposal/family.vibe"
  import { offerProposal } from "./proposal/offer.vibe"
  import type { TurnOffer } from "./proposal/turn.vibe"
  import { enrollment, retireRequest } from "./store.vibe"

  const AgendaSource = Schema.Struct({ clientDevice: Schema.Struct({ calendarAgendaSource: Schema.Unknown }) })
  const agendaSource = Schema.decodeUnknownOption(AgendaSource)
  const sourceOf = Schema.decodeUnknownOption(CalendarSource, { onExcessProperty: "error" })
  const decision = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Struct({
    kind: Schema.Literals(["read_agenda", "reply"]),
  })), { onExcessProperty: "error" })
  const capability = "calendar.agenda-read.v1"

  export function agendaOffer(runtime: AgentRuntime): TurnOffer {
    return async (turn: DeviceTurn) => {
      const { message, signal } = turn
      const sent = agendaSource(message.content.metadata)
      if (sent._tag !== "Some" || !message.content.text) return undefined
      const source = sourceOf(sent.value.clientDevice.calendarAgendaSource)
      if (source._tag !== "Some") return undefined
      const calendarAgendaSource = source.value
      const { observation } = readTurnContext(message)
      if (observation?.view !== "calendar" || observation.sensitive || observation.calendarDay === undefined) return undefined
      const enrolled = await Effect.runPromise(enrollment(runtime.adapter))
      if (!enrolled.bridge.devices.some(({ id, capabilities }) => id === turn.by.connector && capabilities.includes(capability))) return undefined
      const { date, timeZone } = observation.calendarDay
      const wallDay = Date.parse(`${date}T00:00:00.000Z`)
      const operation: AgendaOperation = {
        type: "read_calendar_range", calendarIds: [calendarAgendaSource.sourceId],
        start: new Date(firstOfLocalDay(wallDay, timeZone)).toISOString(),
        end: new Date(firstOfLocalDay(wallDay + day, timeZone)).toISOString(),
        timeZone, maximumEvents: 200,
      }
      const checked = validate(operation, turn.negotiation, "AgendaBinding")
      if (checked === undefined) return undefined
      signal.throwIfAborted()
      let classification: unknown
      try {
        classification = await runtime.useModel(ModelType.TEXT_SMALL, {
          system: `The owner is viewing their Calendar on ${date} in ${timeZone}. Classify only whether the message explicitly asks to read their agenda for this displayed day. Reply with exactly {"kind":"read_agenda"} in that case or {"kind":"reply"} otherwise. Do not choose an operation, calendar, date or identity.`,
          messages: [{ role: "user", content: message.content.text }], signal,
        })
      } catch {
        signal.throwIfAborted()
        return undefined
      }
      const intent = decision(classification)
      if (intent._tag !== "Some" || intent.value.kind !== "read_agenda") return undefined
      signal.throwIfAborted()
      const offer = await Effect.runPromise(offerProposal(turn, checked, { readBack: true, agenda: calendarAgendaSource, grounding: "GroundedOnScreen" }, turn))
      if (offer.kind !== "offered") return undefined
      const bound = { proposalId: offer.record.proposalId, digest: offer.digest, by: turn.by }
      return () => Effect.runPromise(retireRequest(runtime.adapter, bound))
    }
  }
}

export { agendaOffer } from node
