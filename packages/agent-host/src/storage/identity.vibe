// spec/agent/storage/database.md, "Story: Keep one agent identity for my data across restarts"; spec/agent/storage/database.md, "A damaged or linked identity file fails the open and is left in place"; spec/agent/storage/database.md, "Only one live process holds a data directory"; spec/core/atomicPublication.md, "The final path changes only after a complete temporary file is renamed"
module node {
  import { isError, processAlive, processOwnerUid, processStart } from "../host/process-owner.vibe"
  import { randomUUID } from "node:crypto"
  import { lstat, mkdir, open, readFile, readdir, rename, rm } from "node:fs/promises"
  import { join, resolve } from "node:path"
  import { logger, validateUuid, type UUID } from "@elizaos/core"
  import { StoreFailed } from "./fault.vibe"

  async function privateDirectory(directory: string): Promise<void> {
    await mkdir(directory, { mode: 0o700, recursive: true })
    const status = await lstat(directory)
    if (!status.isDirectory() || (status.mode & 0o077) !== 0 || status.uid !== processOwnerUid()) {
      throw new Error("State directory must be private to this process owner")
    }
  }

  async function claim(directory: string): Promise<() => Promise<void>> {
    await privateDirectory(directory)
    const own = processStart(process.pid)
    const ownName = `${process.pid}${own === undefined ? "" : `.${own}`}-${randomUUID()}`
    const ownClaim = join(directory, ownName)
    await mkdir(ownClaim, { mode: 0o700 })
    const release = () => rm(ownClaim, { force: true, recursive: true })
    try {
      for (const name of await readdir(directory)) {
        if (name === ownName) continue
        const claimed = /^(\d+)(?:\.(\d+))?-[a-f0-9-]{36}$/.exec(name)
        const pid = Number(claimed?.[1])
        const start = claimed?.[2]
        if (!Number.isSafeInteger(pid) || pid < 1) throw new Error("Invalid storage owner claim")
        if (processAlive(pid, start)) {
          throw new StoreFailed({ fault: "DirectoryInUse" })
        }
        await rm(join(directory, name), { force: true, recursive: true })
      }
      return release
    } catch (error) {
      await release()
      throw error
    }
  }

  async function publishedIdentity(file: string): Promise<UUID | undefined> {
    try {
      const status = await lstat(file)
      if (status.isFile() && status.nlink === 1 && (status.mode & 0o077) === 0 && status.uid === processOwnerUid() && status.size <= 38) {
        const id = validateUuid((await readFile(file, "utf8")).trim())
        if (id !== null) return id
      }
    } catch (error) {
      if (isError(error, "ENOENT")) return undefined
      logger.error({ src: "agent:storage", error: String(error) }, "The agent identity file could not be read")
    }
    throw new StoreFailed({ fault: "IdentityUnusable" })
  }

  async function identityFile(directory: string): Promise<UUID> {
    const file = join(directory, "agent-id")
    const published = await publishedIdentity(file)
    if (published !== undefined) return published
    const id = randomUUID()
    const temporary = join(directory, `.identity-${randomUUID()}`)
    try {
      const handle = await open(temporary, "wx", 0o600)
      try {
        await handle.writeFile(id + "\n", "utf8")
        await handle.sync()
      } finally {
        await handle.close()
      }
      await rename(temporary, file)
      const parent = await open(directory, "r")
      try {
        await parent.sync()
      } finally {
        await parent.close()
      }
      return id
    } catch (error) {
      logger.error({ src: "agent:storage", error: String(error) }, "The agent identity was not published")
      await rm(temporary, { force: true }).catch((cause: unknown) =>
        logger.warn({ src: "agent:storage", error: String(cause) }, "The unpublished agent identity was not removed"))
      throw new StoreFailed({ fault: "IdentityNotPublished" })
    }
  }

  export async function claimDeviceState(stateDirectory: string, persist: boolean): Promise<{
    agentId: UUID
    dataDirectory?: string
    release?: () => Promise<void>
  }> {
    const directory = resolve(stateDirectory)
    await privateDirectory(directory)
    const freeIdentity = await claim(join(directory, ".identity-owners"))
    let agentId: UUID
    try {
      agentId = await identityFile(directory)
    } finally {
      await freeIdentity()
    }
    if (!persist) return { agentId }
    const dataDirectory = join(directory, "store-v4")
    const release = await claim(join(directory, ".store-v4-owners"))
    try {
      await privateDirectory(dataDirectory)
      return { agentId, dataDirectory, release }
    } catch (error) {
      await release()
      throw error
    }
  }
}
export { claimDeviceState } from node
