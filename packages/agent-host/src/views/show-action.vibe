// spec/agent/views.md, "The agent prepares a navigation only for the renderer bound to its turn and one view its name resolves to"; spec/agent/views.md, "A specific saved Notes editor is prepared only after a matching current lookup on a supported renderer"; spec/agent/deviceActions/surfaces.md, "An app view opens with VIEWS where views arrive as completed actions, else with open_view as the installation's profile enables it"; spec/agent/conversation/planning.md, "An action may narrow its tool to the turn, never beyond its registered form"; spec/agent/conversation/planning.md, "Every call of a turn is one the model chose, and a call this message serves in another place is refused before it runs and is no step of the turn"
import type { Action, ActionResult, HandlerOptions, IAgentRuntime, Memory } from "@elizaos/core"
import { viewsShowsOnDevice } from "../../gen/agent__deviceActions__surfaces.ts"
import { declaredAt, namesOf, savedNotePreparationAllowed, screenCanShow, type DeclaredView } from "../../gen/agent__views.effect.vibe"
import { turnElsewhere, turnNotes } from "../conversation/planning.vibe"
import { readTurnContext } from "@elizaos/agent"
import { completedActionRenderer, deviceTurnFor } from "../device-actions/proposal/turn.vibe"
import { foldName } from "./declarations.vibe"
import type { ViewHost } from "./host.vibe"

module node {
  import { randomUUID } from "node:crypto"
  /** @throws {never} */
  export function newRequestId(): string { return randomUUID() }
}
import { newRequestId } from node

const refused = (text: string): ActionResult => ({ success: false, text })
const coached = (text: string): ActionResult => ({ ...refused(text), transcriptVisibility: "internal", data: { coachingFailure: true } })
const savedNoteEditor = "notes-editor"
const noteIdPattern = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$/u

function offersEditor(message: Memory, clientId: string, noteNamed: boolean, lookupConfirmed: boolean): boolean {
  const { voiceUi, observation } = readTurnContext(message)
  const kind = observation?.selectedObject?.kind ?? ""
  return savedNotePreparationAllowed(noteNamed, voiceUi?.uiClientId === clientId,
    voiceUi?.uiNotesEditor === "saved-note-v1", !/^(?:note|legacy-app-notes-)/u.test(kind), observation?.sensitive === true, lookupConfirmed)
}

/** The one declared view `target` names (the Notes view for a saved Notes editor), if any. */
function viewNamed(declared: readonly DeclaredView[], target: string): DeclaredView | undefined {
  const named = declared.filter((view) => target === savedNoteEditor ? view.viewId === "notes" : namesOf(view).includes(target))
  return named.length === 1 ? named[0] : undefined
}

// spec/agent/views.md, "The agent prepares a navigation only for the renderer bound to its turn and one view its name resolves to"
/** Whether this turn's screen can show `view`: every declared view unless its renderer said which it can show now. */
function screenShows(message: Memory, view: DeclaredView): boolean {
  const stated = readTurnContext(message).voiceUi?.uiViews
  return screenCanShow(stated !== undefined, [...stated ?? []], view.viewId)
}

function listedIds(results: readonly ActionResult[]): Set<string> {
  return new Set(results.filter((result) => result.success && result.data?.actionName === "NOTES_LIST").flatMap((result) => {
    const notes: unknown = result.data?.notes
    return Array.isArray(notes) ? notes.flatMap((note: unknown) =>
      typeof note === "object" && note !== null && "id" in note && typeof note.id === "string" && noteIdPattern.test(note.id) ? [note.id] : []) : []
  }))
}

function resolvedNote(options: HandlerOptions | undefined, query: string | undefined): string | undefined {
  const results = options?.actionContext?.previousResults ?? []
  const reads = results.filter((result) => result.data?.actionName === "NOTES_GET")
  if (reads.some((result) => result.data?.code === "NOTES_AMBIGUOUS_NOTE")) return undefined
  const ids = [...new Set(reads.flatMap((result) => {
    const id = result.data?.noteId
    return result.success && typeof id === "string" && noteIdPattern.test(id) ? [id] : []
  }))]
  if (ids.length > 0) return ids.length === 1 ? ids[0] : undefined
  return query !== undefined && listedIds(results).has(query) ? query : undefined
}

function sameTitle(a: string, b: string): boolean {
  const folded = (text: string) => text.normalize("NFC").trim().toLowerCase().replace(/\s+/gu, " ")
  return folded(a) === folded(b)
}

function createdNote(options: HandlerOptions | undefined, query: string | undefined): string | undefined {
  const made = options?.actionContext?.previousResults.filter((result) => result.success && result.data?.actionName === "NOTES_CREATE") ?? []
  const notes = [...new Map(made.flatMap((result) => {
    const id = result.data?.noteId
    const note: unknown = result.data?.note
    const title = typeof note === "object" && note !== null && "title" in note && typeof note.title === "string" ? note.title : undefined
    return typeof id === "string" && noteIdPattern.test(id) && title !== undefined ? [[id, title] as const] : []
  })).entries()]
  const [only] = notes
  return notes.length === 1 && only !== undefined && query !== undefined && sameTitle(only[1], query) ? only[0] : undefined
}

async function noteIsHeld(runtime: IAgentRuntime, noteId: string): Promise<boolean> {
  const service: unknown = runtime.getService("notes")
  if (typeof service !== "object" || service === null || !("snapshot" in service) || typeof service.snapshot !== "function") return false
  const held: unknown = await service.snapshot()
  return typeof held === "object" && held !== null && "notes" in held && Array.isArray(held.notes)
    && held.notes.some((note: unknown) => typeof note === "object" && note !== null && "id" in note && note.id === noteId)
}

async function noteIsCurrent(runtime: IAgentRuntime, noteId: string, query: string): Promise<boolean> {
  const service: unknown = runtime.getService("notes")
  return typeof service === "object" && service !== null && "matchesSavedEditor" in service
    && typeof service.matchesSavedEditor === "function" && await service.matchesSavedEditor(noteId, query) === true
}

function parameterOf(options: unknown, key: "view" | "note"): string | undefined {
  const parameters = typeof options === "object" && options !== null && "parameters" in options ? options.parameters : undefined
  const value = typeof parameters === "object" && parameters !== null ? Object.entries(parameters).find(([name]) => name === key)?.[1] : undefined
  return typeof value === "string" && value.trim() !== "" ? value.trim() : undefined
}

function targetOf(options: unknown): string | undefined {
  const view = parameterOf(options, "view")
  const target = view === undefined ? "" : foldName(view)
  return target === "" ? undefined : target
}

effect function show(views: ViewHost.Shape, labels: ReadonlyMap<string, string>, runtime: IAgentRuntime, message: Memory, options: HandlerOptions | undefined) {
  const clientId = completedActionRenderer(message)
  if (clientId === undefined) return refused("No renderer is bound to this turn, so no view can be shown.")
  const target = targetOf(options)
  if (target === undefined) return refused("Name the view to show by its id, label or alias.")
  const exact = target === savedNoteEditor
  const named = viewNamed((try views.current()).views, target)
  if (named !== undefined && !screenShows(message, named)) {
    const label = labels.get(named.viewId) ?? named.label
    return refused(`The owner's screen here has no ${label}, so it was not opened and will not open on this screen.`)
  }
  const query = exact ? parameterOf(options, "note") : undefined
  if (exact && !offersEditor(message, clientId, true, true)) return refused("This turn cannot open a saved Notes editor.")
  if (exact && query === undefined) return coached("Name the saved note to open with note: the content argument given to NOTES_GET, or the title of the note this turn created with NOTES_CREATE.")
  const created = exact ? createdNote(options, query) : undefined
  const noteId = exact ? created ?? resolvedNote(options, query) : undefined
  if (exact && noteId === undefined) return coached("Read the exact current note with NOTES_GET first. If several notes match, ask which one.")
  if (noteId !== undefined && query !== undefined) {
    const confirmed = tryPromise(() => created === undefined ? noteIsCurrent(runtime, noteId, query) : noteIsHeld(runtime, noteId)) catch () => false
    if (!offersEditor(message, clientId, true, confirmed)) {
      return coached("The current Notes collection did not match note to the one note NOTES_GET found. No editor was prepared. Set note to the content argument given to NOTES_GET, or ask which note.")
    }
  }
  const requestId = newRequestId()
  const pending = noteId === undefined ? (try views.show(requestId, clientId, target)) : (try views.showSavedNote(requestId, clientId, noteId))
  if (pending === undefined) return refused(`No single view named "${target}" can be shown now.`)
  const binding = pending.binding
  const view = declaredAt(try views.current(), binding.viewId)
  const label = labels.get(view.viewId) ?? view.label
  if (binding.requestId !== requestId || binding.clientId !== clientId || binding.viewType !== "gui" || binding.installationId !== view.installationId) {
    try views.abandon(requestId)
    return refused("The prepared navigation is not bound to this turn's renderer.")
  }
  return {
    success: true,
    text: `The screen opens ${label} once this reply is shown. It is not open yet, and a screen that cannot show ${label} stays where it is.`,
    values: {
      mode: "show", viewId: view.viewId, viewPath: view.path, viewType: "gui", label,
      ...(noteId === undefined ? {} : { subview: "saved-note-v1" }),
      completedActionDelivered: false, completedActionHandoffId: requestId, navigationPrepared: true,
      navigationBinding: { requestId, clientId, viewId: view.viewId, viewType: "gui", installationId: view.installationId },
    },
  } satisfies ActionResult
}

const elsewhere = {
  code: "VIEWS_NOT_ON_THIS_MESSAGE",
  text: "Views do not open with VIEWS on this message, so it did not run and nothing was shown. Open the view with the device tool's open_view where that tool offers it, or tell the person it can't be opened here.",
}

export const viewsActionName = "VIEWS"

const editorNote = "To open one saved note the owner asks for, in any words, first resolve it with NOTES_GET. When it found one current note, call VIEWS with view=notes-editor and note set to the content argument given to NOTES_GET, word for word, or to the noteId it read the note by, never its result. If there are several matches, ask which one. To open the note this turn created with NOTES_CREATE, call VIEWS with view=notes-editor and note set to its title right after the creation, with no NOTES_GET. For the Notes list or any other view, use its name."

function labelOf(view: DeclaredView, labels: ReadonlyMap<string, string>): string {
  return labels.get(view.viewId) ?? view.label
}

function namedViews(declared: readonly DeclaredView[], labels: ReadonlyMap<string, string>): string {
  const named = declared.map((view) => view.aliases.length === 0 ? labelOf(view, labels) : `${labelOf(view, labels)} (${view.aliases.join(", ")})`)
  return named.length === 0 ? "" : ` The owner's views are ${named.join(", ")}.`
}

function screenNote(declared: readonly DeclaredView[], labels: ReadonlyMap<string, string>, message: Memory): string | undefined {
  const view = readTurnContext(message).observation?.view
  if (view === undefined) return undefined
  const shown = declared.find((candidate) => namesOf(candidate).includes(foldName(view)))
  return shown === undefined ? undefined : `The owner's screen showed ${labelOf(shown, labels)} as they sent this message; it is the only view showing now, whatever earlier turns showed.`
}

export function viewsShowAction(views: ViewHost.Shape, labels: ReadonlyMap<string, string>, declared: readonly DeclaredView[]): Action {
  const action: Action = {
    name: viewsActionName,
    similes: ["VIEWS_SHOW", "OPEN_VIEW", "NAVIGATE_VIEW"],
    description: `Show one of the owner's views (id, label, or alias).${namedViews(declared, labels)} Going to a view by its name, such as go home, go to Calendar or back to Notes, is showing that view with VIEWS; only directions/routes use Maps. Navigation only: does not read, change, or act on records. Showing Camera takes no photo; showing Maps searches/routes nothing—use the action that does it.`,
    roleGate: { minRole: "OWNER" },
    parameters: [
      { name: "action", description: "", required: false, schema: { type: "string", enum: ["show"] } },
      { name: "view", description: "View id, label, or alias.", required: true, schema: { type: "string" } },
      { name: "note", description: "For view=notes-editor only: exact content arg or noteId given to NOTES_GET this turn, a noteId NOTES_LIST returned this turn, or title created by NOTES_CREATE this turn.", required: false, schema: { type: "string", minLength: 1, maxLength: 20_000 } },
    ],
    validate: async (runtime, message) => {
      const turn = deviceTurnFor(runtime, message)
      return completedActionRenderer(message) !== undefined && (turn === undefined || viewsShowsOnDevice(turn.completedActionNavigation))
    },
    handler: (runtime, message, _state, options) => runPromise(show(views, labels, runtime, message, options)),
  }
  turnNotes.set(action, (_runtime, message) => {
    const clientId = completedActionRenderer(message)
    if (clientId === undefined) return undefined
    const notes = [screenNote(declared, labels, message), offersEditor(message, clientId, true, true) ? editorNote : undefined].filter((note) => note !== undefined)
    return notes.length === 0 ? undefined : notes.join(" ")
  })
  turnElsewhere.set(action, (runtime, message) => {
    const turn = deviceTurnFor(runtime, message)
    return turn === undefined || viewsShowsOnDevice(turn.completedActionNavigation) ? undefined : elsewhere
  })
  return action
}
