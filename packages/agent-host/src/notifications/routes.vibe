// spec/agent/notifications.md, "A list query is refused unless each parameter is given once and well formed"; spec/agent/notifications.md, "A native page takes no filter and names its epoch to continue"; spec/agent/notifications.md, "An owner list holds only visible notices that match its filter, newest first"; spec/agent/notifications.md, "An inbox that is not durably available answers 503, never an empty list"; spec/agent/notifications.md, "Marking a notice read answers ok only when this call durably marked an unread notice"
import { NotificationNativeError, NotificationService, logger, type AgentNotification, type AgentRuntime, type NativeNotificationQuery } from "@elizaos/core"
import { emptyNotice, type WriteOutcome } from "../../gen/core__notifications.effect.vibe"
import { listAnswer, listRequest, markReadAnswer, unreadNotice, type DecimalText, type EpochText, type InboxStatus, type ListAnswer, type ListParams, type MarkReadAnswer, type NoticeIdText, type Row } from "../../gen/agent__notifications.effect.vibe"
import type { LocalRoute } from "@elizaos/agent"

const listKeys = ["category", "unreadOnly", "limit", "nativeTransport", "nativeEpoch", "afterSequence", "throughSequence"] as const
const decimal = /^(0|[1-9][0-9]*)$/
const uuidShape = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const currentEpoch = 0
const otherEpoch = 1
const startingRetrySeconds = 1

interface Inbox {
  readonly status: InboxStatus
  readonly service: NotificationService | undefined
  readonly notices: readonly AgentNotification[]
}

const absent = (status: InboxStatus): Inbox => ({ status, service: undefined, notices: [] })

const notDurable = (cause: unknown): boolean => cause instanceof NotificationNativeError && cause.code === "NOTIFICATION_INBOX_UNAVAILABLE"

effect function durableInbox(service: NotificationService) {
  const notices = try inboxCall(() => service.listDurableIncludingExpired())
  return { status: "InboxReady" as const, service, notices: notices.toReversed() } satisfies Inbox
}

effect function inboxOf(runtime: AgentRuntime) {
  const found = runtime.getService(NotificationService.serviceType)
  const service = found instanceof NotificationService ? found : undefined
  switch (NotificationService.getAvailability(runtime)) {
    case "registered": {
      if (service === undefined) return absent("InboxStarting")
      return durableInbox(service) catch effect (failure) => {
        if (!notDurable(failure.cause)) throw failure
        return absent("InboxClosed")
      }
    }
    case "pending":
    case "registering": return absent("InboxStarting")
    case "failed": return absent("InboxFailed")
    case "disabled": return absent("InboxClosed")
  }
}

function decimalText(text: string): DecimalText {
  const value = Number(text)
  return decimal.test(text) && Number.isSafeInteger(value) ? { tag: "Decimal", value } : { tag: "NotDecimal" }
}

function epochText(text: string, current: string | undefined): EpochText {
  return uuidShape.test(text) ? { tag: "KnownEpoch", epoch: text.toLowerCase() === current ? currentEpoch : otherEpoch } : { tag: "NotUuid" }
}

function listParams(query: ReadonlyMap<string, string>, current: string | undefined): ListParams {
  const given = (key: typeof listKeys[number]): string[] => query.has(key) ? [query.get(key) ?? ""] : []
  return {
    category: given("category"),
    unreadOnly: given("unreadOnly"),
    limit: given("limit").map(decimalText),
    nativeTransport: given("nativeTransport"),
    nativeEpoch: given("nativeEpoch").map((text) => epochText(text, current)),
    afterSequence: given("afterSequence").map(decimalText),
    throughSequence: given("throughSequence").map(decimalText),
  }
}

function nativeQuery(query: ReadonlyMap<string, string>, limit: number): NativeNotificationQuery {
  const epoch = query.get("nativeEpoch")
  const after = query.get("afterSequence")
  const through = query.get("throughSequence")
  return {
    limit,
    ...(epoch === undefined ? {} : { nativeEpoch: epoch }),
    ...(after === undefined ? {} : { afterSequence: Number(after) }),
    ...(through === undefined ? {} : { throughSequence: Number(through) }),
  }
}

function rowOf(notice: AgentNotification): Row {
  return {
    notice: {
      ...emptyNotice,
      id: notice.id,
      sequence: notice.nativeSequence ?? 0,
      read: notice.readAt != null,
      expiry: notice.expiresAt == null ? { mode: "Permanent", at: 0 } : { mode: "Deadline", at: notice.expiresAt },
    },
    category: notice.category,
    silent: notice.priority === "low",
  }
}

interface Answer {
  readonly status: number
  readonly body: object
  readonly retryAfter?: number
}

module node {
  interface Sent {
    readonly status: number
    readonly body: object
    readonly retryAfter?: number
  }

  export async function sent(answer: Promise<Sent>): Promise<Response> {
    const { status, body, retryAfter } = await answer
    return Response.json(body, { status, ...(retryAfter === undefined ? {} : { headers: { "retry-after": String(retryAfter) } }) })
  }
}
import { sent } from node

const reply = (status: number, body: object, retryAfter?: number): Answer =>
  retryAfter === undefined ? { status, body } : { status, body, retryAfter }

function unavailable(runtime: AgentRuntime, recover: boolean): Answer {
  const retryAfter = recover ? NotificationService.requestRecovery(runtime).retryAfterSeconds : startingRetrySeconds
  return reply(503, { error: "notification_inbox_unavailable", retryAfter }, retryAfter)
}

function refusedByCore(cause: unknown): Answer | undefined {
  if (!(cause instanceof NotificationNativeError)) return undefined
  return reply(cause.status, { error: cause.message, code: cause.code }, cause.status === 503 ? startingRetrySeconds : undefined)
}

error InboxCallFailed { cause: unknown }

effect function inboxCall<A>(call: () => Promise<A>) {
  return try tryPromise({ try: () => call(), catch: (cause) => new InboxCallFailed({ cause }) })
}

effect function nativePage(service: NotificationService, query: NativeNotificationQuery) {
  const page = try inboxCall(() => service.listNativePage(query))
  return reply(200, page)
}

function ownerList(notices: readonly AgentNotification[], listed: Extract<ListAnswer, { tag: "Listed" }>): Answer {
  const byId = new Map(notices.map((notice) => [notice.id, notice]))
  const notifications = listed.notices.flatMap((row) => byId.get(row.notice.id) ?? [])
  return reply(200, { notifications, unreadCount: listed.unreadCount, serviceStatus: "ready" })
}

effect function listAnswered(runtime: AgentRuntime, query: ReadonlyMap<string, string>) {
  const checked = listRequest(listParams(query, undefined), currentEpoch, 0)
  const inbox = checked.tag === "BadQuery" ? absent("InboxStarting") : try inboxOf(runtime)
  const latest = inbox.notices.at(-1)
  const request = checked.tag === "BadQuery" ? checked : listRequest(listParams(query, latest?.nativeEpoch), currentEpoch, latest?.nativeSequence ?? 0)
  const answer: ListAnswer = listAnswer(request, inbox.status, inbox.notices.map(rowOf), try Clock.currentTimeMillis)
  switch (answer.tag) {
    case "Refused": return reply(400, { error: "invalid_notification_query" })
    case "Unavailable": return unavailable(runtime, answer.recover)
    case "Listed": return ownerList(inbox.notices, answer)
    case "PagedByCursor": {
      if (request.tag !== "NativePage" || inbox.service === undefined) return unavailable(runtime, false)
      const service = inbox.service
      return nativePage(service, nativeQuery(query, request.limit)) catch effect (failure) => {
        const refused = refusedByCore(failure.cause)
        if (refused === undefined) throw failure
        return refused
      }
    }
  }
}

effect function marked(service: NotificationService, id: string) {
  return inboxCall(() => service.markRead(id)) catch (failure) => {
    logger.warn({ src: "agent:notifications", notificationId: id, cause: failure.cause instanceof Error ? failure.cause.message : String(failure.cause) }, "The read mark was not acknowledged")
    return undefined
  }
}

function markReply(runtime: AgentRuntime, answer: MarkReadAnswer): Answer {
  switch (answer.tag) {
    case "BadNoticeId": return reply(400, { error: "invalid_notification_id" })
    case "MarkedRead": return reply(200, { ok: answer.ok })
    case "MarkUnavailable": return unavailable(runtime, answer.recover)
  }
}

effect function markAnswered(runtime: AgentRuntime, id: string) {
  const requested: NoticeIdText = uuidShape.test(id) ? { tag: "NoticeUuid", id } : { tag: "NotNoticeUuid" }
  const inbox = requested.tag === "NotNoticeUuid" ? absent("InboxStarting") : try inboxOf(runtime)
  const service = inbox.service
  const rows = inbox.notices.map(rowOf)
  const notWritten: WriteOutcome = "RejectedBefore"
  if (service === undefined || inbox.status !== "InboxReady" || !unreadNotice(rows, id)) {
    return markReply(runtime, markReadAnswer(requested, inbox.status, rows, notWritten))
  }
  const written = try marked(service, id)
  if (written === false) return markReply(runtime, markReadAnswer(requested, inbox.status, service.listIncludingExpired().toReversed().map(rowOf), notWritten))
  return markReply(runtime, markReadAnswer(requested, inbox.status, rows, written === true ? "Acknowledged" : "LostAcknowledgement"))
}

export function notificationRoutes(runtime: AgentRuntime): LocalRoute[] {
  return [
    {
      method: "GET", path: "/api/notifications",
      query: listKeys.map((key) => ({ key, accepts: { kind: "any" as const } })),
      handler: ({ query }) => sent(runPromise(listAnswered(runtime, query))),
    },
    {
      method: "POST", path: "/api/notifications/{id}/read",
      handler: ({ parameters }) => sent(runPromise(markAnswered(runtime, parameters.get("id") ?? ""))),
    },
  ]
}
