// spec/agent/conversation/planning.md, "An earlier reply reaches the model with the host's record of the tools its turn ran and how each ended"
import { Schema } from "effect"
import type { GenerateTextParams } from "@elizaos/core"
import { carriesARecord, maxRecordedArguments, maxRecordedValueChars, recordedOutcome, recordedSteps, type RecordedOutcome } from "../../gen/agent__conversation__planning.ts"
import type { PlannedStep } from "./planning.vibe"
import { maxCueLength } from "./reply-text.vibe"

type ChatMessage = NonNullable<GenerateTextParams["messages"]>[number]
type RecordedValue = string | number | boolean
type RecordedArgument = [name: string, value: RecordedValue]

export type RecordedStep = {
  action: string
  args: RecordedArgument[]
  outcome: RecordedOutcome
}

export type ToolRecord = {
  steps: RecordedStep[]
  more: number
}

schema StoredStep {
  readonly action: string
  readonly args: Schema.Unknown
  readonly outcome: "RecordedDone" | "RecordedUnchanged" | "RecordedProposed" | "RecordedFailed" | "RecordedPartly" | "RecordedRefused"
}

schema StoredToolRecord {
  readonly steps: readonly StoredStep[]
  readonly more: Schema.Int
}

const decodeRecord = Schema.decodeUnknownOption(StoredToolRecord)
const cueName = "cue"

const outcomeWords: Readonly<Record<RecordedOutcome, string>> = {
  RecordedDone: "done",
  RecordedUnchanged: "no change",
  RecordedProposed: "proposed to the person (not applied by this call)",
  RecordedFailed: "failed",
  RecordedPartly: "partly failed",
  RecordedRefused: "refused, did not run",
}

const byKey = ([a]: readonly [string, unknown], [b]: readonly [string, unknown]) => a < b ? -1 : a > b ? 1 : 0
const cut = (text: string) => text.length > maxRecordedValueChars ? `${text.slice(0, maxRecordedValueChars - 1)}…` : text
const plainOf = (text: string) => text.replace(/\s+/gu, " ").trim()
const cutCue = (text: string) => text.length > maxCueLength ? text.slice(0, maxCueLength) : text
const cutCopy = (value: string, said: string) => value.length === maxRecordedValueChars && value.endsWith("…") && said.startsWith(value.slice(0, -1))
const copies = (value: string, text: string) => plainOf(text) !== "" && (value.includes(plainOf(text)) || cutCopy(value, plainOf(text)))
const withoutCopies = (value: string, text: string, notice: string) => cutCopy(value, plainOf(text)) ? notice : value.replaceAll(plainOf(text), notice)

function valueOf(value: unknown): RecordedValue | undefined {
  if (typeof value === "boolean") return value
  if (typeof value === "number") return Number.isFinite(value) ? value : undefined
  const written = typeof value === "string" ? value : value === undefined || value === null ? "" : JSON.stringify(value) ?? ""
  const plain = plainOf(written)
  return plain === "" ? undefined : cut(plain)
}

function argsOf(params: Readonly<Record<string, unknown>>): RecordedStep["args"] {
  return Object.entries(params).flatMap(([name, value]) => {
    const kept = valueOf(value)
    return kept === undefined ? [] : [[name, kept] satisfies RecordedArgument]
  }).slice(0, maxRecordedArguments)
}

export function toolRecordOf(steps: readonly PlannedStep[]): ToolRecord | undefined {
  if (!carriesARecord(true, false, steps.length)) return undefined
  const kept = steps.slice(0, recordedSteps(steps.length))
  return {
    steps: kept.map(({ action, cue, params, outcomes, result }) => ({
      action, args: [[cueName, cutCue(plainOf(cue))], ...argsOf(params)], outcome: recordedOutcome(outcomes.map(({ outcome }) => outcome), (result.effectReceipts ?? []).length > 0),
    })),
    more: steps.length - kept.length,
  }
}

const isValue = (value: unknown): value is RecordedValue =>
  typeof value === "string" || (typeof value === "number" && Number.isFinite(value)) || typeof value === "boolean"

const isPair = (entry: unknown): entry is readonly [string, unknown] => Array.isArray(entry) && entry.length === 2 && typeof entry[0] === "string"

function storedArgs(args: unknown): RecordedArgument[] | undefined {
  const entries = Array.isArray(args) ? (args.every(isPair) ? args : undefined)
    : typeof args === "object" && args !== null ? Object.entries(args).sort(byKey) : undefined
  return entries?.flatMap(([name, value]): RecordedArgument[] => isValue(value) ? [[name, value]] : [])
}

function storedRecord(value: unknown): ToolRecord | undefined {
  const decoded = decodeRecord(value)
  if (decoded._tag !== "Some" || decoded.value.more < 0) return undefined
  const read = decoded.value.steps.flatMap(({ action, args, outcome }) => {
    const stored = storedArgs(args)
    if (!/^[A-Za-z0-9_-]{1,64}$/u.test(action) || stored === undefined) return []
    const cue = stored[0]?.[0] === cueName && typeof stored[0][1] === "string" ? [[cueName, cutCue(stored[0][1])] satisfies RecordedArgument] : []
    const kept = stored.slice(cue.length, cue.length + maxRecordedArguments)
    return [{ action, args: [...cue, ...kept.map(([name, keptValue]): RecordedArgument => [name, typeof keptValue === "string" ? cut(keptValue) : keptValue])], outcome }]
  })
  return read.length === decoded.value.steps.length ? { steps: read.slice(0, recordedSteps(read.length)), more: decoded.value.more } : undefined
}

export function toolRecordHolds(stored: unknown, text: string): boolean {
  const decoded = decodeRecord(stored)
  if (decoded._tag !== "Some") return false
  return decoded.value.steps.some(({ args }) => (storedArgs(args) ?? []).some(([, value]) => typeof value === "string" && copies(value, text)))
}

export function scrubToolRecord(stored: unknown, text: string, notice: string): ToolRecord | undefined {
  const decoded = decodeRecord(stored)
  if (decoded._tag !== "Some" || decoded.value.more < 0) return undefined
  return {
    steps: decoded.value.steps.map(({ action, args, outcome }) => ({
      action,
      args: (storedArgs(args) ?? []).map(([key, value]): RecordedArgument => [key, typeof value === "string" ? withoutCopies(value, text, notice) : value]),
      outcome,
    })),
    more: decoded.value.more,
  }
}

export function recordedTurn(stored: unknown, redacted: boolean, replyId: string): ChatMessage[] {
  const record = storedRecord(stored)
  if (record === undefined || !carriesARecord(true, redacted, record.steps.length)) return []
  const key = replyId.replace(/[^A-Za-z0-9]/gu, "").slice(0, 24)
  const calls = record.steps.map(({ action, args }, index) => ({ id: `history_${key}_${index}`, name: action, arguments: Object.fromEntries(args) }))
  const last = record.steps.length - 1
  return [
    { role: "assistant", content: null, toolCalls: calls },
    ...record.steps.map(({ outcome }, index): ChatMessage => ({
      role: "tool", toolCallId: calls[index]?.id ?? "", name: calls[index]?.name ?? "",
      content: index === last && record.more > 0 ? `${outcomeWords[outcome]}; ${record.more} more calls followed` : outcomeWords[outcome],
    })),
  ]
}
