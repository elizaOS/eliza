// spec/agent/conversation/replyStream.md, "Story: See a reply as it is written"; spec/agent/conversation/replyStream.md, "A frame is written only when the one before it has left, and nothing waits while the transport is free"; spec/agent/conversation/replyStream.md, "The acknowledgment is written at most once, before the text and progress waiting with it, and only its own frame clears it"; spec/agent/conversation/replyStream.md, "Every stream that is not dropped ends with exactly one done or error frame, after which nothing is written"; spec/agent/conversation/replyStream.md, "A client that leaves aborts the turn it streams, and nothing more is written to it"; spec/agent/conversation/planning.md, "A delivered cue is told to the model as already said, so the reply never repeats it or takes it as evidence"
module node {
  import { logger } from "@elizaos/core"
  import { type LocalRoute, textOf, unitsOf } from "@elizaos/agent"
  import { enabled, initial, roleFor, step, type Event, type Frame, type Progress, type ReplyStream } from "../../gen/agent__conversation__replyStream.ts"
  import { failureKind, type Admission, type ReplyKind } from "../../gen/agent__conversation__turns.ts"

  export type Activity = "thinking" | "streaming" | "running_action" | "running_tool" | "evaluating" | "waking" | "speaking"

  export interface ActionResultFrame {
    readonly action: string
    readonly data: unknown
  }

  export interface DoneFrame {
    readonly type: "done"; readonly fullText: string; readonly messageId: string; readonly userMessageId: string; readonly agentName: string
    readonly actionResults: readonly ActionResultFrame[]; readonly taskChoices?: readonly unknown[]; readonly failureKind?: string
    readonly cloudCode?: string; readonly planAction?: "sign-in" | "funding" | "retry"; readonly retryAfterMs?: number
    readonly cutOffEffect?: "applied"
    readonly action?: { readonly kind: string; readonly validatedCard: boolean }
  }

  export interface ErrorFrame { readonly type: "error"; readonly code: string; readonly message: string }

  type Mark = { readonly provisional?: true }

  export type ReplyFrame =
    | ({ readonly type: "token"; readonly text: string } & Mark)
    | ({ readonly type: "token"; readonly text: string; readonly fullText: string } & Mark)
    | ({ readonly type: "token"; readonly fullText: string } & Mark)
    | { readonly type: "acknowledgment"; readonly text: string }
    | { readonly type: "status"; readonly activity: string }
    | { readonly type: "tool"; readonly name: string; readonly label: string }
    | { readonly type: "reply_ready"; readonly fullText: string; readonly actionResults: readonly ActionResultFrame[] }
    | DoneFrame
    | ErrorFrame

  export type TurnEnd =
    | (Omit<DoneFrame, "failureKind"> & { readonly kind: ReplyKind })
    | ErrorFrame

  export interface ReplyWriter {
    readonly append: (text: string, provisional?: boolean) => void
    readonly replace: (fullText: string, provisional?: boolean) => void
    readonly restart: (fullText: string, provisional?: boolean) => void
    readonly acknowledge: (text: string) => boolean
    readonly status: (activity: Activity) => void
    readonly tool: (name: string, label: string) => void
    readonly ready: (fullText: string, actionResults: readonly ActionResultFrame[]) => void
  }

  export interface AdmittedStream {
    readonly kind: "admitted"
    readonly verdict: Admission
    readonly run: (writer: ReplyWriter, left: AbortSignal) => Promise<TurnEnd>
  }

  export type StreamStart = { readonly kind: "refused"; readonly status: number; readonly error: string } | AdmittedStream

  export type StartStream = (conversationId: string, body: unknown, headers: ReadonlyMap<string, string>, signal: AbortSignal) => Promise<StreamStart>

  export interface ReplySink {
    readonly write: (frame: ReplyFrame) => void
    readonly abortTurn: () => void
  }

  const serverFailure: ErrorFrame = { type: "error", code: "SERVER_ERROR", message: "The turn failed" }

  const mark = (provisional: boolean): Mark => provisional ? { provisional: true } : {}

  export class ReplyWire {
    #state: ReplyStream = initial
    #end: TurnEnd | undefined
    #announced: readonly ActionResultFrame[] = []

    constructor(readonly sink: ReplySink) {}

    get state(): ReplyStream { return this.#state }
    get open(): boolean { return this.#state.phase.tag === "Open" && (this.#state.role === "Streams" || this.#state.role === "Waits") }
    get ended(): boolean { return this.#state.phase.tag === "Ended" }

    #render(frame: Frame): ReplyFrame | undefined {
      switch (frame.tag) {
        case "Token": return { type: "token", text: textOf(frame.text), ...mark(frame.provisional) }
        case "TokenSnapshot": return { type: "token", text: textOf(frame.text), fullText: textOf(frame.fullText), ...mark(frame.provisional) }
        case "Replace": return { type: "token", fullText: textOf(frame.fullText), ...mark(frame.provisional) }
        case "AckFrame": return { type: "acknowledgment", text: textOf(frame.cue) }
        case "ReadyFrame": return { type: "reply_ready", fullText: textOf(frame.fullText), actionResults: this.#announced }
        case "Progressed": return progressFrame(frame.progress)
        case "Final": {
          const end = this.#end
          if (end === undefined || end.type === "error")
            return { type: "error", code: frame.end.tag === "Errored" ? frame.end.code : serverFailure.code, message: end?.message ?? serverFailure.message }
          const { kind, ...done } = end
          const failure = failureKind(kind)
          return failure === "" ? done : { ...done, failureKind: failure }
        }
      }
    }

    #send(event: Event): boolean {
      if (!enabled(this.#state, event)) return false
      const { state, out } = step(this.#state, event)
      this.#state = state
      for (const effect of out) {
        switch (effect.tag) {
          case "Write": {
            const frame = this.#render(effect.frame)
            if (frame !== undefined) this.sink.write(frame)
            break
          }
          case "AbortTurn": this.sink.abortTurn(); break
        }
      }
      return true
    }

    admit(verdict: Admission): boolean { return this.#send({ type: "admit", verdict }) }
    flushed(): boolean { return this.#send({ type: "frameFlushed" }) }
    append(text: string, provisional: boolean): boolean { return this.#send({ type: "appendText", units: unitsOf(text), provisional }) }
    replace(fullText: string, provisional: boolean): boolean { return this.#send({ type: "replaceText", units: unitsOf(fullText), provisional }) }
    restart(fullText: string, provisional: boolean): boolean { return this.#send({ type: "restartText", units: unitsOf(fullText), provisional }) }
    acknowledge(text: string): boolean { return this.#send({ type: "acknowledge", units: unitsOf(text) }) }
    progress(progress: Progress): boolean { return this.#send({ type: "showProgress", progress }) }

    ready(fullText: string, actionResults: readonly ActionResultFrame[]): boolean {
      const event: Event = { type: "announceReply", units: unitsOf(fullText), results: actionResults.length }
      if (!enabled(this.#state, event)) return false
      this.#announced = actionResults
      return this.#send(event)
    }

    finish(end: TurnEnd): boolean {
      const event: Event = end.type === "done"
        ? { type: "finish", reply: 1, units: unitsOf(end.fullText), kind: end.kind, results: end.actionResults.length }
        : { type: "answerError", code: end.code }
      if (!enabled(this.#state, event)) return false
      this.#end = end
      return this.#send(event)
    }

    leave(): boolean { return this.#send({ type: "clientLeft" }) }
  }

  function progressFrame(progress: Progress): ReplyFrame | undefined {
    switch (progress.tag) {
      case "Activity": return { type: "status", activity: progress.activity }
      case "ToolUse": return { type: "tool", name: progress.name, label: progress.label }
      case "NoProgress": return undefined
    }
  }

  export function writeReplyStream(admitted: AdmittedStream, incoming: AbortSignal): Response {
    const encoder = new TextEncoder()
    const left = new AbortController()
    let controller: ReadableStreamDefaultController<Uint8Array> | undefined
    const wire = new ReplyWire({
      write: (frame) => {
        controller?.enqueue(encoder.encode(`data: ${JSON.stringify(frame)}\n\n`))
        if (wire.ended) controller?.close()
      },
      abortTurn: () => left.abort(),
    })
    const settle = (end: TurnEnd) => {
      if (wire.finish(end) || !wire.open) return
      logger.warn({ src: "agent", end: end.type === "error" ? end.code : "done" }, "A streamed turn ended in a way its stream refused")
      wire.finish(serverFailure)
    }
    const writer: ReplyWriter = {
      append: (text, provisional) => { wire.append(text, provisional === true) },
      replace: (fullText, provisional) => { wire.replace(fullText, provisional === true) },
      restart: (fullText, provisional) => { wire.restart(fullText, provisional === true) },
      acknowledge: (text) => wire.acknowledge(text),
      status: (activity) => { wire.progress({ tag: "Activity", activity }) },
      tool: (name, label) => { wire.progress({ tag: "ToolUse", name, label }) },
      ready: (fullText, actionResults) => { wire.ready(fullText, actionResults) },
    }
    const body = new ReadableStream<Uint8Array>({
      start(given) {
        controller = given
        wire.admit(admitted.verdict)
      },
      pull() { wire.flushed() },
      cancel() { wire.leave() },
    }, { highWaterMark: 0 })
    if (incoming.aborted) wire.leave()
    else incoming.addEventListener("abort", () => { wire.leave() }, { once: true })
    void admitted.run(writer, left.signal).then(settle, (error: unknown) => {
      if (!left.signal.aborted) logger.warn({ src: "agent", error: String(error) }, "A streamed turn failed")
      settle(serverFailure)
    })
    return new Response(body, {
      headers: { "content-type": "text/event-stream; charset=utf-8", "cache-control": "no-store" },
    })
  }

  function refusal(verdict: Admission): { readonly status: number; readonly body: { readonly error: string } } {
    switch (verdict.tag) {
      case "Conflict": return { status: 409, body: { error: "CHAT_IDEMPOTENCY_CONFLICT" } }
      case "Busy": return { status: 429, body: { error: "ROOM_BUSY" } }
      case "InferenceUnavailable": return { status: 503, body: { error: "INFERENCE_UNAVAILABLE" } }
      case "Owner": case "Unkeyed": case "Duplicate": case "Settled": return { status: 500, body: { error: "SERVER_ERROR" } }
    }
  }

  const hasStreamProtocol = (body: unknown) => typeof body === "object" && body !== null && Object.hasOwn(body, "streamProtocol")

  export function streamRoutes(startStream: StartStream): LocalRoute[] {
    return [{
      method: "POST", path: "/api/conversations/{id}/messages/stream", stream: true,
      handler: async ({ parameters, body, headers, signal }) => {
        if (hasStreamProtocol(body)) return { status: 400, body: { error: "stream_protocol_unsupported" } }
        const started = await startStream(parameters.get("id") ?? "", body, headers, signal)
        if (started.kind === "refused") return { status: started.status, body: { error: started.error } }
        return roleFor(started.verdict) === "Refused" ? refusal(started.verdict) : writeReplyStream(started, signal)
      },
    }]
  }
}
export {
  ReplyWire, streamRoutes,
  type Activity, type ActionResultFrame, type AdmittedStream, type DoneFrame, type ErrorFrame, type ReplyFrame, type ReplySink, type ReplyWriter,
  type StartStream, type StreamStart, type TurnEnd,
} from node
