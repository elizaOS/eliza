// spec/agent/conversation/planning.md, "Story: Ask what time it is and hear my own clock"; spec/agent/conversation/planning.md, "Each turn's model sees the clock of the phone's zone, else the launch zone, else the host's, and it is the owner's local time only from the phone or, for the owner, the launch"; spec/agent/conversation/planning.md, "A standalone answer to a current-time question that names a date, weekday or clock the clock did not observe is asked for again, and the clock's own reading is the last resort"; spec/agent/conversation/planning.md, "A reply that gives a just-changed calendar event a time range other than the one it got is asked for again, and the change's own words are the last resort"
import type { ActionResult, Memory } from "@elizaos/core"
import { clockSource, eventRangeIsUngrounded, statedTimeIsUngrounded, type LocalClock, type StatedTime } from "../../gen/agent__conversation__planning.ts"
import { knownZone, readTurnContext } from "@elizaos/agent"

export interface TurnClock {
  readonly instant: number
  readonly zone: string
  readonly reading: string
  readonly line: string
}

const monthNames = ["january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december"]
const weekdayNames = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"]
const timeQuestion = /^(?:what(?:['’]s|s| is)?\s+(?:the\s+)?(?:(?:current|local|today['’]s)\s+)?(?:time|day|date)(?:\s+is it)?|what day of the week is it)(?:\s+(?:right now|now|today|for me|please))*[?.!]*$/i
const monthDay = /\b(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2})(?:st|nd|rd|th)?(?:,?\s*(\d{4}))?/gi
const clockTime = /\b(\d{1,2})(?::(\d{2}))?(?::\d{2})?\s*(AM|PM|a\.m\.|p\.m\.)/gi
const weekday = /\b(Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)\b/gi
const filler = /\b(?:it['’]s|it is|today is|currently|right now|about|at|for you|in your local time|your local time|AM|PM|EST|EDT|CST|CDT|MST|MDT|PST|PDT|AKST|AKDT|HST|HAST|HADT|AST|ADT|(?:UTC|GMT)(?:[+-]\d{1,2}(?::\d{2})?)?)\b/gi

function fullReading(instant: number, zone: string): string {
  return new Intl.DateTimeFormat("en-US", { timeZone: zone, dateStyle: "full", timeStyle: "long" }).format(new Date(instant))
}

const civilWeekday = new Intl.DateTimeFormat("en-US", { timeZone: "UTC", weekday: "long" })

function comingDays(localDate: string, zone: string): string {
  const [year, month, day] = localDate.split("-").map(Number)
  const named = (ahead: number) => {
    const civil = new Date(Date.UTC(year, month - 1, day + ahead, 12))
    return `${civilWeekday.format(civil)} ${civil.toISOString().slice(0, 10)}`
  }
  return `Today in ${zone} is ${named(0)}. Next 7 days: ${[1, 2, 3, 4, 5, 6, 7].map(named).join(", ")}.`
}

export function turnClock(message: Memory, launchZone: string | undefined, owner: boolean, instant: number): TurnClock {
  const context = readTurnContext(message)
  const said = context.voiceUi?.uiTimeZone
  const phone = knownZone(said) ? said : context.observation?.timeZone ?? ""
  const source = clockSource(phone, launchZone ?? "", Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC", owner)
  const zone = source.clockZone
  const minute = Math.floor(instant / 60_000) * 60_000
  const minuteInstant = `${new Date(minute).toISOString().slice(0, 16)}Z`
  const minuteReading = fullReading(minute, zone).replace(/(\d{1,2}:\d{2}):00/, "$1")
  const localDate = new Date(minute).toLocaleDateString("en-CA", { timeZone: zone })
  const reading = source.ownersLocal
    ? `Local date: ${localDate} (${zone}). ${minuteReading}. Resolve today/tomorrow from this local date, not the UTC date. UTC instant: ${minuteInstant}.`
    : `${source.origin === "LaunchZone" ? "Agent" : "Server"} time: ${minuteReading} (${zone}), ISO (UTC): ${minuteInstant}; user timezone unknown.`
  return { instant, zone, reading: fullReading(instant, zone), line: `${reading} ${comingDays(localDate, zone)}` }
}

function localClockOf(clock: TurnClock): LocalClock {
  const parts = new Intl.DateTimeFormat("en-US", {
    timeZone: clock.zone, hourCycle: "h23", year: "numeric", month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit", weekday: "long",
  }).formatToParts(new Date(clock.instant))
  const read = (type: string) => parts.find((part) => part.type === type)?.value ?? ""
  return {
    month: Number(read("month")), day: Number(read("day")), year: Number(read("year")),
    weekday: weekdayNames.indexOf(read("weekday").toLowerCase()), minuteOfDay: Number(read("hour")) * 60 + Number(read("minute")),
  }
}

function statedTimes(reply: string): StatedTime[] {
  return [
    ...Array.from(reply.matchAll(monthDay), (found): StatedTime => ({
      tag: "StatedDay", month: monthNames.indexOf(found[1].toLowerCase()) + 1, day: Number(found[2]), year: found[3] === undefined ? 0 : Number(found[3]),
    })),
    ...Array.from(reply.matchAll(weekday), (found): StatedTime => ({ tag: "StatedWeekday", weekday: weekdayNames.indexOf(found[1].toLowerCase()) })),
    ...Array.from(reply.matchAll(clockTime), (found): StatedTime => ({
      tag: "StatedClock", minuteOfDay: (Number(found[1]) % 12) * 60 + Number(found[2] ?? "0") + (/^p/i.test(found[3]) ? 720 : 0),
    })),
  ]
}

function standalone(reply: string): boolean {
  return reply.replace(monthDay, " ").replace(weekday, " ").replace(clockTime, " ").replace(filler, " ").replace(/[\s,.!():]/g, "") === ""
}

export interface Ungrounded {
  readonly note: string
  readonly fixed: string
}

export function ungroundedTimeReply(reply: string, request: string, clock: TurnClock): Ungrounded | undefined {
  const answer = reply.trim()
  if (!answer || !statedTimeIsUngrounded(timeQuestion.test(request.trim()), standalone(answer), statedTimes(answer), localClockOf(clock))) return undefined
  return {
    note: `The person asked for the current date or time, and the reply stated one this turn's clock did not observe. The clock reads ${clock.reading}. Answer from it.`,
    fixed: `It's ${clock.reading}.`,
  }
}

const clockRange = /\b(\d{1,2})(?::(\d{2}))?\s*(a\.?m\.?|p\.?m\.?)?\s*(?:-|–|—|to|until|till)\s*(\d{1,2})(?::(\d{2}))?\s*(a\.?m\.?|p\.?m\.?)(?![a-z])|\b([01]?\d|2[0-3]):([0-5]\d)\s*(?:-|–|—|to|until|till)\s*([01]?\d|2[0-3]):([0-5]\d)\b/gi
const clockMention = /\b\d{1,2}(?::\d{2})?\s*(?:a\.?m\.?|p\.?m\.?)(?![a-z])|\b(?:[01]?\d|2[0-3]):[0-5]\d\b/i
const moveStatement = /\bmoved\b[^.!?\n]{0,80}\bfrom\s+\d{1,2}(?::\d{2})?\s*(?:a\.?m\.?|p\.?m\.?)?\s*(?:to|until|till)\s+\d{1,2}(?::\d{2})?\s*(?:a\.?m\.?|p\.?m\.?)/i
const changeOperations: ReadonlySet<string> = new Set(["calendar.event.create", "calendar.event.update"])

interface StatedRange {
  readonly start: number
  readonly end: number
}

function minuteOf(hour: string | undefined, minute: string | undefined, half: string | undefined): number | undefined {
  const h = Number(hour), m = Number(minute ?? "0")
  if (!Number.isInteger(h) || !Number.isInteger(m) || m > 59) return undefined
  if (half === undefined) return h <= 23 ? h * 60 + m : undefined
  return h >= 1 && h <= 12 ? ((h % 12) + (/^p/i.test(half) ? 12 : 0)) * 60 + m : undefined
}

function oneRange(reply: string): StatedRange | undefined {
  const found = [...reply.matchAll(clockRange)]
  const [only] = found
  if (only === undefined || found.length !== 1 || moveStatement.test(reply) || clockMention.test(reply.replace(only[0], " "))) return undefined
  const start = only[1] !== undefined ? minuteOf(only[1], only[2], only[3] ?? only[6]) : minuteOf(only[7], only[8], undefined)
  const end = only[1] !== undefined ? minuteOf(only[4], only[5], only[6]) : minuteOf(only[9], only[10], undefined)
  return start === undefined || end === undefined ? undefined : { start, end }
}

function namesAZone(reply: string): boolean {
  return reply.split(/[\s,;()]+/).some((token) => {
    const zone = token.replace(/[.!?"'“”‘’]+$/g, "")
    if (zone === "" || /^(?:am|pm)$/i.test(zone)) return false
    if (/^(?:UTC|GMT)[+-]/i.test(zone)) return true
    try {
      new Intl.DateTimeFormat("en-US", { timeZone: zone })
      return true
    } catch {
      return false
    }
  })
}

function record(value: unknown): Record<string, unknown> | undefined {
  return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : undefined
}

function eventMinutes(instant: string, zone: string): number | undefined {
  try {
    const parts = new Intl.DateTimeFormat("en-US", { timeZone: zone, hourCycle: "h23", hour: "2-digit", minute: "2-digit" }).formatToParts(new Date(instant))
    return Number(parts.find((part) => part.type === "hour")?.value) * 60 + Number(parts.find((part) => part.type === "minute")?.value)
  } catch {
    return undefined
  }
}

interface ChangedEvent {
  readonly key: string
  readonly start: number
  readonly end: number
  readonly words: string
}

function changedEvent(result: ActionResult, agentId: string): ChangedEvent | undefined {
  const event = record(record(result.data)?.event)
  const metadata = record(event?.metadata)
  if (result.success !== true || event === undefined || metadata === undefined || typeof event.id !== "string" || event.agentId !== agentId || event.isAllDay !== false) return undefined
  const { id, startAt, endAt, timezone, title } = event
  if (typeof startAt !== "string" || typeof endAt !== "string" || typeof timezone !== "string" || (typeof title === "string" && clockMention.test(title))) return undefined
  const version = typeof metadata.etag === "string" ? metadata.etag : event.updatedAt
  const applied = (result.effectReceipts ?? []).some((receipt) => receipt.outcome === "applied" && changeOperations.has(receipt.operation)
    && receipt.resource.kind === "calendar.event" && receipt.resource.id === id && receipt.resource.version === version)
  const start = eventMinutes(startAt, timezone), end = eventMinutes(endAt, timezone)
  const words = (result.userFacingText ?? result.text ?? "").trim()
  if (typeof version !== "string" || !applied || start === undefined || end === undefined || !(Date.parse(endAt) > Date.parse(startAt)) || words === "") return undefined
  return { key: JSON.stringify([id, version, startAt, endAt, timezone]), start, end, words }
}

export function ungroundedEventReply(reply: string, request: string, results: readonly ActionResult[], agentId: string): Ungrounded | undefined {
  const stated = oneRange(reply)
  const changed = [...new Map(results.flatMap((result) => {
    const event = changedEvent(result, agentId)
    return event === undefined ? [] : [[event.key, event] as const]
  })).values()]
  const [event] = changed
  const matches = event !== undefined && stated !== undefined && stated.start === event.start && stated.end === event.end
  if (event === undefined || !eventRangeIsUngrounded(timeQuestion.test(request.trim()), stated !== undefined, namesAZone(reply), changed.length, matches)) return undefined
  return {
    note: `The calendar change this turn applied reports ${JSON.stringify(event.words)}, and the reply gave that event another time range. State the time the change reports.`,
    fixed: event.words,
  }
}
