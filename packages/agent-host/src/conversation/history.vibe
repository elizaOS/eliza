// spec/agent/conversation/conversations.md, "Story: Read history a page at a time"; spec/agent/conversation/conversations.md, "The first page is the newest 200 messages"; spec/agent/conversation/conversations.md, "An older page holds only messages before its cursor, and hasMore says whether any are left"; spec/agent/conversation/conversations.md, "A jump to a message answers it with up to 100 messages on each side, and an unknown one is 404"; spec/agent/conversation/conversations.md, "A search page is a slice of the complete set of visible matches"; spec/agent/conversation/conversations.md, "A history row carries its send key only on the owner's message, and a failure kind only on the agent's reply"; spec/agent/schedule/triggers.md, "A run's prompt is told to the model as the trigger that fired, and the history never shows it as the owner's message"
module node {
  import { createHash } from "node:crypto"
  import { MESSAGE_CONTENT_SEGMENT_TABLE, MESSAGE_SOURCE_TRIGGER_PROMPT, messageContentSegmentId, messageTextSourceDescriptor, parseCanonicalInteger, readDurableConversationChatMarker, readMessageContentProjection, type AgentRuntime, type IDatabaseAdapter, type Memory, type MessageContentSegmentMetadata, type UUID } from "@elizaos/core"
  import { around, aroundRadius, cursorOf, olderPage, olderThan, pageOf, pageSize, precedes, privateNotice, recentPage, recentWindow, rowMarks, searchAdmitted, searchSize, shownText, type Body, type Page, type Row } from "../../gen/agent__conversation__conversations.ts"
  import type { IntegerResult } from "../../gen/core__numbers.ts"
  import { historyShows } from "../../gen/agent__schedule__triggers.ts"
  import type { LocalRoute } from "@elizaos/agent"
  import type { ConversationRecord, ConversationStore } from "./conversations.vibe"

  interface Placed {
    readonly row: Row
    readonly memory: Memory
  }

  interface Ordered {
    readonly placed: readonly Placed[]
    readonly rank: ReadonlyMap<string, number>
  }

  const failure = (status: number, error: string) => ({ status, body: { error } })
  const anyValue = (key: string) => ({ key, accepts: { kind: "any" as const } })

  function integerOf(raw: string | undefined): IntegerResult {
    const parsed = parseCanonicalInteger(raw)
    return parsed === undefined ? { tag: "MissingInteger" } : parsed === "invalid" ? { tag: "InvalidInteger" } : { tag: "ParsedInteger", value: parsed }
  }

  const countOf = (result: IntegerResult) => result.tag === "ParsedInteger" ? result.value : 0

  export function bodyOf(text: string): Body {
    return text === privateNotice ? { tag: "Redacted" } : { tag: "Said", text }
  }

  export function textSegmentIds(memory: Memory): UUID[] {
    const descriptor = messageTextSourceDescriptor(memory.content)
    const messageId = memory.id
    if (descriptor === null || messageId === undefined) return []
    return Array.from({ length: descriptor.segmentCount }, (_, ordinal) =>
      messageContentSegmentId({ messageId, kind: "message-text", revision: descriptor.revision, ordinal }))
  }

  export async function storedText(adapter: IDatabaseAdapter, memory: Memory): Promise<string> {
    if (typeof memory.content.text === "string") return memory.content.text
    const descriptor = messageTextSourceDescriptor(memory.content)
    const messageId = memory.id
    if (descriptor === null || messageId === undefined) return ""
    const ids = textSegmentIds(memory)
    const found = new Map((await adapter.getMemoriesByIds(ids, MESSAGE_CONTENT_SEGMENT_TABLE)).map((segment) => [segment.id, segment]))
    const text = ids.map((id) => {
      const segment = found.get(id)
      const meta = segment?.metadata as unknown as MessageContentSegmentMetadata | undefined
      if (segment === undefined || meta === undefined || segment.roomId !== memory.roomId) {
        throw new Error("The conversation's stored content is incomplete")
      }
      return readMessageContentProjection({ descriptor, segments: [segment], messageId, offset: meta.byteStart, limit: meta.byteEnd - meta.byteStart }).text
    }).join("")
    if (createHash("sha256").update(text).digest("hex") !== descriptor.sha256) throw new Error("The conversation's stored content is incomplete")
    return text
  }

  function ordered(memories: readonly Memory[], named: readonly string[] = []): Ordered {
    const stored = memories.filter((memory) => memory.id !== undefined)
    const ids = [...new Set([...stored.map((memory) => String(memory.id)), ...named])].sort()
    const rank = new Map(ids.map((id, index) => [id, index + 1]))
    const placed = stored
      .map((memory) => ({ row: { id: rank.get(String(memory.id)) ?? 0, at: memory.createdAt ?? 0 }, memory }))
      .sort((a, b) => precedes(a.row, b.row) ? -1 : precedes(b.row, a.row) ? 1 : 0)
    return { placed, rank }
  }

  export async function messageView(runtime: AgentRuntime, memory: Memory) {
    const fromAgent = memory.entityId === runtime.agentId
    const { failureKind: failed, abortCause: cause, stopReason } = memory.content
    const marks = rowMarks(fromAgent ? "Agent" : "User",
      readDurableConversationChatMarker(memory.content.chatIdempotency)?.clientMessageId ?? "", typeof failed === "string" ? failed : "", typeof cause === "string" ? cause : "")
    return {
      id: String(memory.id), role: fromAgent ? "assistant" as const : "user" as const,
      text: shownText(bodyOf(await storedText(runtime.adapter, memory))), timestamp: memory.createdAt ?? 0,
      ...(marks.sendKey === "" ? {} : { clientMessageId: marks.sendKey }),
      ...(marks.failed === "" ? {} : { failureKind: marks.failed }),
      ...(marks.cause === "" ? {} : { abortCause: marks.cause, ...(typeof stopReason === "string" ? { stopReason } : {}) }),
    }
  }

  export function historyRoutes(runtime: AgentRuntime, store: ConversationStore): LocalRoute[] {
    const messagesOf = async (record: ConversationRecord, textContains?: string) =>
      (await runtime.adapter.getMemories({ roomId: record.roomId, tableName: "messages", ...(textContains === undefined ? {} : { textContains }) }))
        .filter((memory) => historyShows(memory.entityId === runtime.agentId, memory.content.source === MESSAGE_SOURCE_TRIGGER_PROMPT ? "FiredByTrigger" : "SaidByOwner"))
    const shown = (order: Ordered, rows: readonly Row[]) => {
      const byRow = new Map(order.placed.map(({ row, memory }) => [row.id, memory]))
      return Promise.all(rows.flatMap((row) => {
        const memory = byRow.get(row.id)
        return memory === undefined ? [] : [messageView(runtime, memory)]
      }))
    }

    return [
      {
        method: "GET", path: "/api/conversations/messages/search",
        query: [anyValue("q"), anyValue("limit"), anyValue("offset")],
        handler: async ({ query }) => {
          const text = (query.get("q") ?? "").trim().replace(/\s+/gu, " ")
          const limit = integerOf(query.get("limit"))
          const offset = integerOf(query.get("offset"))
          if (limit.tag === "InvalidInteger" || offset.tag === "InvalidInteger" || !searchAdmitted(text.length, countOf(offset))) {
            return failure(400, "invalid_search")
          }
          const conversations = await store.list()
          const found = await Promise.all(conversations.map(async (record) =>
            (await messagesOf(record, text)).filter((memory) => bodyOf(memory.content.text ?? "").tag === "Said").map((memory) => ({ record, memory }))))
          const hits = found.flat()
          const owner = new Map(hits.map(({ record, memory }) => [String(memory.id), record]))
          const newestFirst = ordered(hits.map(({ memory }) => memory)).placed.toReversed()
          const page = pageOf(newestFirst.map((_, index) => index), countOf(offset), searchSize(countOf(limit)))
          const results = (await Promise.all(page.map(async (index) => {
            const { memory } = newestFirst[index]
            const record = owner.get(String(memory.id))
            if (record === undefined) return []
            const view = await messageView(runtime, memory)
            return [{ messageId: view.id, conversationId: record.id, roomId: record.roomId, role: view.role, text: view.text, createdAt: view.timestamp }]
          }))).flat()
          return { status: 200, body: { results, count: results.length } }
        },
      },
      {
        method: "GET", path: "/api/conversations/{id}/messages",
        query: [anyValue("before"), anyValue("beforeId"), anyValue("limit"), anyValue("around")],
        handler: async ({ parameters, query }) => {
          const record = await store.find(parameters.get("id") ?? "")
          if (record === undefined) return failure(404, "unknown_conversation")
          const memories = await messagesOf(record)
          const pivotId = query.get("around")
          if (pivotId !== undefined) {
            const order = ordered(memories)
            const index = order.placed.findIndex(({ memory }) => String(memory.id) === pivotId)
            if (index < 0) return failure(404, "unknown_message")
            const window = order.placed.slice(Math.max(0, index - aroundRadius), index + aroundRadius + 1).map(({ row }) => row)
            return { status: 200, body: { messages: await shown(order, around(window, order.placed[index].row, aroundRadius)) } }
          }
          const beforeId = query.get("beforeId")
          const order = ordered(memories, beforeId === undefined ? [] : [beforeId])
          const limit = integerOf(query.get("limit"))
          const cursor = cursorOf(integerOf(query.get("before")), beforeId !== undefined, beforeId === undefined ? 0 : order.rank.get(beforeId) ?? 0)
          if (cursor.tag === "BadCursor") return failure(400, "invalid_cursor")
          if (limit.tag === "InvalidInteger") return failure(400, "invalid_limit")
          const rows = order.placed.map(({ row }) => row)
          const page: Page = cursor.tag === "NoCursor"
            ? recentPage(rows.slice(-(recentWindow + 1)))
            : olderPage(rows.filter((row) => olderThan(row, cursor.cursor)).slice(-(pageSize(countOf(limit)) + 1)), cursor.cursor, countOf(limit))
          return { status: 200, body: { messages: await shown(order, page.rows), hasMore: page.hasMore } }
        },
      },
    ]
  }
}
export { bodyOf, historyRoutes, messageView, storedText, textSegmentIds } from node
