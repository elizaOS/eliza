// spec/agent/models/binding.md, "No text handler is ever served by a model on the device"; spec/agent/models/binding.md, "Plugins reach the cloud only through the cloud service of a cloud backend, and a managed Google change needs the owner's consent"
import type { IAgentRuntime } from "@elizaos/core"
import { cloudLinkPlugin } from "../../gen/agent__plugins__profile.effect.vibe"
import type { LaunchDocument } from "@elizaos/agent"
import type { AgentPlugin } from "../host/module.vibe"
import type { BoundModels } from "./binding.vibe"
import { cloudLinkServices } from "./cloud-link.vibe"
import { registerCloudModels } from "./cloud-provider.vibe"
import { registerOwnKeyModels } from "./own-key-provider.vibe"

function registerModels(runtime: IAgentRuntime, model: LaunchDocument["model"], bound: BoundModels): void {
  switch (model.backend) {
    case "cloud":
      return registerCloudModels(runtime, bound, { baseUrl: model.cloudBaseUrl, small: model.smallModel, large: model.largeModel, image: model.imageModel })
    case "own-key":
      return registerOwnKeyModels(runtime, bound, { baseUrl: model.ownKeyBaseUrl, small: model.ownKeySmall, large: model.ownKeyLarge })
    case "none":
      return
  }
}

export function modelPlugin(launch: LaunchDocument, bound: BoundModels): AgentPlugin {
  return {
    name: cloudLinkPlugin,
    description: "Answer with the backend the launch chose and give plugins the owner's cloud link",
    routes: bound.routes,
    services: cloudLinkServices(launch, bound.credential),
    init: async (_config, runtime) => registerModels(runtime, launch.model, bound),
  }
}
