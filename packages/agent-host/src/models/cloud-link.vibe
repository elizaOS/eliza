// spec/agent/models/binding.md, "Plugins reach the cloud only through the cloud service of a cloud backend, and a managed Google change needs the owner's consent"
import { Service, type IAgentRuntime, type ServiceClass } from "@elizaos/core"
import type { CloudLinkReply, CloudLinkRequest, CloudLinkService, GoogleAdmission, GoogleChange } from "@elizaos/agent"
import { runSquashed } from "./run-squashed.vibe"
import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import type { Backend, GoogleConsent } from "../../gen/agent__host__launch.ts"
import { googleAdmitted, pluginCloudPathAllowed, type GoogleOperation } from "../../gen/agent__models__binding.effect.vibe"
import { backendOf, type LaunchDocument } from "../host/launch.vibe"

export const cloudServiceType = "cloud"

export type { CloudLinkReply, CloudLinkRequest, CloudLinkService, GoogleAdmission, GoogleChange }

error CloudLinkUnreachable { path: string }

error CloudLinkRequestRefused { path: string; reason: "path" | "body" }

interface Link {
  readonly backend: Backend
  readonly origin: string
  readonly google: GoogleConsent
  readonly credential: () => Redacted.Redacted<string>
}

const operationOf = { gmail_change: "GmailChange", calendar_edit: "CalendarEdit", read: "GoogleRead" } as const satisfies Record<GoogleChange, GoogleOperation>

const managedGoogle = "/api/v1/eliza/google/"

function googleChangeOf(method: CloudLinkRequest["method"], pathname: string): GoogleChange | undefined {
  if (!pathname.startsWith(managedGoogle)) return undefined
  if (method === "GET") return "read"
  const area = pathname.slice(managedGoogle.length).split("/")[0]
  return area === "gmail" ? "gmail_change" : area === "calendar" ? "calendar_edit" : "read"
}

const decodeJson = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Unknown))

effect function send(link: Link, request: CloudLinkRequest, target: URL) {
  const headers = {
    authorization: "Bearer " + Redacted.value(link.credential()),
    accept: "application/json",
    ...(request.idempotencyKey === undefined ? {} : { "idempotency-key": request.idempotencyKey }),
    ...(request.ifMatch === undefined ? {} : { "if-match": request.ifMatch }),
  }
  const bare = HttpClientRequest.make(request.method)(target, { headers })
  const encoded = request.body === undefined ? undefined : try Effect.try({
    try: () => JSON.stringify(request.body),
    catch: () => new CloudLinkRequestRefused({ path: target.pathname, reason: "body" }),
  })
  const prepared = encoded === undefined ? bare : HttpClientRequest.bodyText(bare, encoded, "application/json")
  const response = Effect.provideService(HttpClient.execute(prepared), FetchHttpClient.RequestInit, { redirect: "error" })
  const unreachable = new CloudLinkUnreachable({ path: target.pathname })
  const result = timeout(response, "60 seconds") catch effect () => { throw unreachable }
  const text = timeout(result.text, "60 seconds") catch effect () => { throw unreachable }
  const parsed = decodeJson(text)
  const body = parsed._tag === "Some" ? parsed.value : text
  const reply: CloudLinkReply = result.status >= 200 && result.status < 300
    ? { kind: "answered", status: result.status, body }
    : { kind: "refused", status: result.status, body }
  return reply
}

module edge {
  /** @throws {never} */
  export function targetOf(origin: string, path: string): URL | undefined {
    if (!path.startsWith("/") || path.startsWith("//")) return undefined
    const target = URL.parse(path, origin)
    return target !== null && target.origin === origin ? target : undefined
  }
}
import { targetOf } from edge

export function cloudLinkServices(launch: LaunchDocument, credential: () => Redacted.Redacted<string>): ServiceClass[] {
  const backend = backendOf(launch.model)
  if (backend.tag !== "CloudBackend") return []
  const link: Link = { backend, origin: new URL(backend.baseUrl).origin, google: launch.google ?? { gmailChanges: false, calendarEdits: false }, credential }
  const admitGoogle = (operation: GoogleChange): GoogleAdmission =>
    googleAdmitted(link.backend, link.google, operationOf[operation]) ? { kind: "admitted" } : { kind: "refused", reason: "changes-off" }
  return [class CloudLink extends Service implements CloudLinkService {
    static override serviceType = cloudServiceType
    override capabilityDescription = "The owner's authenticated cloud link, with managed Gmail and calendar changes only where the owner consented"

    static override start(runtime: IAgentRuntime): Promise<Service> {
      return Promise.resolve(new CloudLink(runtime))
    }

    admitGoogle(operation: GoogleChange): GoogleAdmission {
      return admitGoogle(operation)
    }

    request(request: CloudLinkRequest): Promise<CloudLinkReply> {
      const target = targetOf(link.origin, request.path)
      if (target === undefined || !pluginCloudPathAllowed(target.pathname)) return Promise.reject(new CloudLinkRequestRefused({ path: request.path, reason: "path" }))
      const change = googleChangeOf(request.method, target.pathname)
      if (change !== undefined && admitGoogle(change).kind === "refused") return Promise.resolve({ kind: "changes-off", operation: change })
      return runSquashed(Effect.provide(send(link, request, target), FetchHttpClient.layer), { signal: request.signal, message: "The cloud call was aborted" })
    }

    override stop(): Promise<void> {
      return Promise.resolve()
    }
  }]
}
