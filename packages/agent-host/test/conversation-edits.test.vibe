// spec/agent/conversation/conversations.md, "Story: Fork a conversation at a message without changing the original"; spec/agent/conversation/conversations.md, "Story: Remove private text I sent by mistake"
module node {
  import { randomUUID } from "node:crypto"
  import { collectMessageContentSegmentIds, MESSAGE_CONTENT_SEGMENT_TABLE, stringToUuid, type AgentRuntime, type Log, type Memory, type MessageContentSegmentMetadata, type UUID } from "@elizaos/core"
  import { conversationStore } from "../src/conversation/conversations.vibe"
  import { forkService, type ForkRequest } from "../src/conversation/fork.vibe"
  import { textSegmentIds } from "../src/conversation/history.vibe"

  export const fresh = (): UUID => randomUUID()
  const ownerId = (runtime: AgentRuntime) => stringToUuid(`device-owner:${runtime.agentId}`)

  export async function seedMessages(runtime: AgentRuntime, roomId: UUID, rows: readonly { readonly text: string; readonly agent: boolean; readonly foreign?: boolean }[], from: number) {
    const memories = rows.map(({ text, agent, foreign }, index): Memory => ({
      id: fresh(), roomId, agentId: runtime.agentId, createdAt: from + index,
      entityId: agent ? runtime.agentId : foreign === true ? fresh() : ownerId(runtime), content: { text, source: "device" },
    }))
    await runtime.adapter.createMemories(memories.map((memory) => ({ memory, tableName: "messages" })))
    return memories.map((memory) => String(memory.id))
  }

  export async function seedLong(runtime: AgentRuntime, roomId: UUID, text: string, at: number) {
    const id = fresh()
    await runtime.createMessageMemory({ id, roomId, agentId: runtime.agentId, createdAt: at, entityId: ownerId(runtime), content: { text, source: "device" } })
    return String(id)
  }

  export async function seedStoredContent(runtime: AgentRuntime, roomId: UUID, long: string, from: number) {
    const marked: Memory = {
      id: fresh(), roomId, agentId: runtime.agentId, createdAt: from, entityId: ownerId(runtime),
      content: { text: "marked", source: "device", chatIdempotency: { scope: "device-chat", clientMessageId: "m1" } },
    }
    await runtime.adapter.createMemories([{ memory: marked, tableName: "messages" }])
    const longId = await seedLong(runtime, roomId, long, from + 1)
    const [next] = await seedMessages(runtime, roomId, [{ text: "next", agent: false }], from + 2)
    return [longId, next]
  }

  export async function textSegmentsOf(runtime: AgentRuntime, id: string) {
    const [memory] = await runtime.adapter.getMemoriesByIds([id as UUID], "messages")
    return memory === undefined ? [] : textSegmentIds(memory)
  }

  export async function heldSegments(runtime: AgentRuntime, ids: UUID[]) {
    return (await runtime.adapter.getMemoriesByIds(ids, MESSAGE_CONTENT_SEGMENT_TABLE)).length
  }

  export async function storedCopies(runtime: AgentRuntime, roomId: UUID) {
    const copies = (await runtime.adapter.getMemories({ roomId, tableName: "messages" })).sort((a, b) => (a.createdAt ?? 0) - (b.createdAt ?? 0))
    return Promise.all(copies.map(async (copy) => {
      const ids = collectMessageContentSegmentIds(copy.id as UUID, copy.content)
      const segments = await runtime.adapter.getMemoriesByIds(ids, MESSAGE_CONTENT_SEGMENT_TABLE)
      const owned = segments.length === ids.length && segments.every((segment) =>
        segment.roomId === roomId && (segment.metadata as unknown as MessageContentSegmentMetadata).messageId === copy.id)
      return { text: copy.content.text ?? segments.map((segment) => segment.content.text ?? "").join(""), marked: "chatIdempotency" in copy.content, segments: owned ? segments.length : -1 }
    }))
  }

  export async function seedLogs(runtime: AgentRuntime, rows: readonly { readonly roomId: UUID; readonly type: string; readonly prompt: string }[]) {
    await runtime.adapter.createLogs(rows.map(({ roomId, type, prompt }) => ({ entityId: runtime.agentId, roomId, type, body: { prompt, response: "noted" } })))
  }

  export async function promptsOf(runtime: AgentRuntime, roomId: UUID) {
    return (await runtime.adapter.getLogs({ roomId })).map(({ body }: Log) => (body as { prompt?: string }).prompt ?? "").sort()
  }

  export async function forkRecordText(runtime: AgentRuntime, id: string) {
    const key = `conversation-forks:${id}`
    return JSON.stringify((await runtime.adapter.getCaches<unknown>([key])).get(key)) ?? ""
  }

  export async function interruptedFork(runtime: AgentRuntime, id: string, request: ForkRequest) {
    const store = conversationStore(runtime, { user: ownerId(runtime), world: stringToUuid(`device:${runtime.agentId}`) })
    const source = await store.find(id)
    if (source === undefined) throw new Error("The source conversation is not listed")
    const begun = await forkService(runtime, store, ownerId(runtime)).begin(source, request)
    if (begun.kind !== "forked") throw new Error(`The fork was refused: ${begun.kind}`)
    return begun.fork.id
  }
}

import { fresh, forkRecordText, heldSegments, interruptedFork, promptsOf, seedLogs, seedLong, seedMessages, seedStoredContent, storedCopies, textSegmentsOf } from node
import { assert, it } from "@effect/vitest"
import type { UUID } from "@elizaos/core"
import { privateNotice } from "../gen/agent__conversation__conversations.ts"
import { textDigest } from "../src/conversation/fork.vibe"
import { ask, host, startInProcess, type InProcess } from "./support/kernel.vibe"
import type { Conversation, Message } from "./support/streaming.vibe"


const base = 1_700_000_000_000

effect function open(agent: InProcess, title: string) {
  const answer = try ask(agent, { method: "POST", path: "/api/conversations", body: { title } })
  return (answer.body as { conversation: Conversation }).conversation
}

effect function seed(agent: InProcess, roomId: UUID, rows: readonly { readonly text: string; readonly agent: boolean; readonly foreign?: boolean }[], from: number) {
  return try host("seed messages", () => seedMessages(agent.agent.runtime, roomId, rows, from))
}

effect function history(agent: InProcess, id: string) {
  const answer = try ask(agent, { method: "GET", path: `/api/conversations/${id}/messages` })
  return { status: answer.status, messages: (answer.body as { messages?: readonly Message[] }).messages ?? [] }
}

effect function forkAt(agent: InProcess, id: string, body: object) {
  const answer = try ask(agent, { method: "POST", path: `/api/conversations/${id}/fork`, body })
  return { status: answer.status, conversation: (answer.body as { conversation?: Conversation }).conversation }
}

effect function redactOf(agent: InProcess, id: string, messageId: string, body: object) {
  const answer = try ask(agent, { method: "POST", path: `/api/conversations/${id}/messages/${messageId}/redact`, body })
  return { status: answer.status, body: answer.body as { result?: string } }
}

effect function listed(agent: InProcess) {
  const answer = try ask(agent, { method: "GET", path: "/api/conversations" })
  return (answer.body as { conversations: readonly Conversation[] }).conversations
}

const texts = (messages: readonly Message[]) => messages.map(({ text }) => text)

it.effect('Fork at my own message: the copy is whole before it is listed, a retry answers the same fork, and the original stays (spec/agent/conversation/conversations.md, "A fork starts only at my own message whose stored text is what I saw"; spec/agent/conversation/conversations.md, "A fork copies every message before the chosen one, and only those, before it is listed"; spec/agent/conversation/conversations.md, "No message is ever removed, and only redaction changes one")', effect () => {
  const agent = try startInProcess()
  const runtime = agent.agent.runtime
  const plans = try open(agent, "Plans")
  const [hello, greeting, trip, sure, foreign] = try seed(agent, plans.roomId, [
    { text: "hello", agent: false }, { text: "hi there", agent: true }, { text: "plan a trip", agent: false }, { text: "sure", agent: false },
    { text: "foreign author", agent: false, foreign: true },
  ], base)
  const before = try history(agent, plans.id)

  const made = try forkAt(agent, plans.id, { messageId: trip, requestId: "r1", expectedText: "plan a trip" })
  const again = try forkAt(agent, plans.id, { messageId: trip, requestId: "r1", expectedText: "plan a trip" })
  const otherMessage = try forkAt(agent, plans.id, { messageId: hello, requestId: "r1", expectedText: "hello" })
  const otherText = try forkAt(agent, plans.id, { messageId: trip, requestId: "r1", expectedText: "plan a walk" })
  const changed = try forkAt(agent, plans.id, { messageId: trip, requestId: "r2", expectedText: "plan a walk" })
  const agentMessage = try forkAt(agent, plans.id, { messageId: greeting, requestId: "r2", expectedText: "hi there" })
  const foreignMessage = try forkAt(agent, plans.id, { messageId: foreign, requestId: "r2", expectedText: "foreign author" })
  const unknownId = try Effect.try(fresh)
  const unknownMessage = try forkAt(agent, plans.id, { messageId: unknownId, requestId: "r2", expectedText: "hello" })
  const unknownConversation = try forkAt(agent, unknownId, { messageId: trip, requestId: "r2", expectedText: "plan a trip" })
  const malformed = try forkAt(agent, plans.id, { messageId: trip, expectedText: "plan a trip" })
  const copied = try history(agent, made.conversation?.id ?? "")
  const after = try history(agent, plans.id)
  const record = try host("fork records", () => forkRecordText(runtime, plans.id))
  const pendingId = try host("interrupted fork", () => interruptedFork(runtime, plans.id, { messageId: sure, requestId: "r3", expectedText: "sure" }))
  const whilePending = try listed(agent)
  const pendingHistory = try history(agent, pendingId)
  const retried = try forkAt(agent, plans.id, { messageId: sure, requestId: "r3", expectedText: "sure" })
  const published = try history(agent, pendingId)
  const finally_ = try listed(agent)
  const notes = try open(agent, "Notes")
  const long = "a".repeat(70_000)
  const [longId, next] = try host("seed stored content", () => seedStoredContent(runtime, notes.roomId, long, base))
  const noted = try forkAt(agent, notes.id, { messageId: next, requestId: "n1", expectedText: "next" })
  const stored = try host("stored copies", () => storedCopies(runtime, noted.conversation?.roomId ?? notes.roomId))
  const notesShown = try history(agent, notes.id)
  const longFork = try forkAt(agent, notes.id, { messageId: longId, requestId: "n2", expectedText: long })
  const longChanged = try forkAt(agent, notes.id, { messageId: longId, requestId: "n3", expectedText: long.slice(1) })

  try Effect.try(() => {
    assert.deepStrictEqual({
      made: [made.status, made.conversation?.title, again.status, again.conversation?.id === made.conversation?.id],
      refused: [otherMessage.status, otherText.status, changed.status, agentMessage.status, foreignMessage.status, unknownMessage.status, unknownConversation.status, malformed.status],
      copied: copied.messages.map(({ text, timestamp }) => [text, timestamp]),
      copiedIds: copied.messages.some(({ id }) => id === hello || id === greeting),
      original: after.messages, digest: [record.includes("plan a trip"), record.includes(textDigest("plan a trip"))],
    }, {
      made: [200, "Plans · edit", 200, true],
      refused: [409, 409, 409, 404, 404, 404, 404, 400],
      copied: [["hello", base], ["hi there", base + 1]], copiedIds: false,
      original: before.messages, digest: [false, true],
    })
    assert.deepStrictEqual({
      pendingListed: whilePending.some(({ id }) => id === pendingId), pendingHistory: pendingHistory.status,
      retried: [retried.status, retried.conversation?.id === pendingId], published: texts(published.messages),
      listed: finally_.filter(({ title }) => title === "Plans · edit").length,
    }, {
      pendingListed: false, pendingHistory: 404,
      retried: [200, true], published: ["hello", "hi there", "plan a trip"], listed: 2,
    })
    assert.deepStrictEqual({ noted: noted.status, stored, shown: texts(notesShown.messages), long: [longFork.status, longChanged.status] }, {
      noted: 200, stored: [{ text: "marked", marked: false, segments: 0 }, { text: long, marked: false, segments: 2 }],
      shown: ["marked", long, "next"], long: [200, 409],
    })
  })
}, 180_000)

it.effect('Redact a secret: the message, its exact copies and the model-call logs of that conversation show the notice, and nothing else changes (spec/agent/conversation/conversations.md, "A search page is a slice of the complete set of visible matches"; spec/agent/conversation/conversations.md, "Redacting replaces the message and every exact copy of its text in its conversation with a fixed notice"; spec/agent/conversation/conversations.md, "No message is ever removed, and only redaction changes one")', effect () => {
  const agent = try startInProcess()
  const runtime = agent.agent.runtime
  const secret = "my pin is 4321"
  const private_ = try open(agent, "Private")
  const other = try open(agent, "Other")
  const [said, echoed, fine] = try seed(agent, private_.roomId, [
    { text: secret, agent: false }, { text: secret, agent: true }, { text: "ok, noted", agent: false },
  ], base)
  const [elsewhere] = try seed(agent, other.roomId, [{ text: secret, agent: false }], base + 10)
  const longSecret = `${secret} `.repeat(5_000)
  const longSaid = try host("seed long secret", () => seedLong(runtime, private_.roomId, longSecret, base + 3))
  const longSegments = try host("long secret segments", () => textSegmentsOf(runtime, longSaid))
  const beforeHistory = try history(agent, private_.id)
  const beforeSearch = try ask(agent, { method: "GET", path: "/api/conversations/messages/search?q=4321" })
  const beforeHits = (beforeSearch.body as { results: readonly { messageId: string; text: string }[] }).results
  assert.deepStrictEqual({
    history: [beforeHistory.status, beforeHistory.messages.some(({ id, text }) => id === longSaid && text === longSecret)],
    search: [beforeSearch.status, beforeHits.some(({ messageId, text }) => messageId === longSaid && text === longSecret)],
  }, { history: [200, true], search: [200, true] })
  try host("model-call logs", () => seedLogs(runtime, [
    { roomId: private_.roomId, type: "useModel:TEXT_LARGE", prompt: `The owner said: ${secret}` },
    { roomId: private_.roomId, type: "useModel:TEXT_SMALL", prompt: "unrelated" },
    { roomId: private_.roomId, type: "action", prompt: secret },
    { roomId: other.roomId, type: "useModel:TEXT_LARGE", prompt: secret },
  ]))
  const forked = try forkAt(agent, private_.id, { messageId: fine, requestId: "keep", expectedText: "ok, noted" })

  const wrongText = try redactOf(agent, private_.id, said, { expectedText: "my pin is 1234" })
  const wrongConversation = try redactOf(agent, private_.id, elsewhere, { expectedText: secret })
  const unknownId = try Effect.try(fresh)
  const unknown = try redactOf(agent, private_.id, unknownId, { expectedText: secret })
  const malformed = try redactOf(agent, private_.id, said, {})
  const redacted = try redactOf(agent, private_.id, said, { expectedText: secret })
  const repeated = try redactOf(agent, private_.id, said, { expectedText: secret })
  const echoAfter = try redactOf(agent, private_.id, echoed, { expectedText: secret })
  const longWrong = try redactOf(agent, private_.id, longSaid, { expectedText: secret })
  const longRedacted = try redactOf(agent, private_.id, longSaid, { expectedText: longSecret })
  const longHeld = try host("long secret segments left", () => heldSegments(runtime, longSegments))

  const shown = try history(agent, private_.id)
  const untouched = try history(agent, other.id)
  const copy = try history(agent, forked.conversation?.id ?? "")
  const search = try ask(agent, { method: "GET", path: "/api/conversations/messages/search?q=4321" })
  const prompts = try host("logs", () => promptsOf(runtime, private_.roomId))
  const otherPrompts = try host("other logs", () => promptsOf(runtime, other.roomId))

  try Effect.try(() => {
    assert.deepStrictEqual({
      statuses: [wrongText.status, wrongConversation.status, unknown.status, malformed.status, redacted.status, repeated.status, echoAfter.status, longWrong.status, longRedacted.status],
      results: [redacted.body.result, repeated.body.result, echoAfter.body.result, longRedacted.body.result],
      longSegments: [longSegments.length, longHeld],
      shown: shown.messages.map(({ id, text }) => [id, text]),
      untouched: texts(untouched.messages), copy: texts(copy.messages),
      found: (search.body as { results: readonly { messageId: string }[] }).results.map(({ messageId }) => messageId).sort(),
      prompts, otherPrompts,
    }, {
      statuses: [409, 404, 404, 400, 200, 200, 200, 409, 200],
      results: ["redacted", "unchanged", "unchanged", "redacted"],
      longSegments: [2, 0],
      shown: [[said, privateNotice], [echoed, privateNotice], [fine, "ok, noted"], [longSaid, privateNotice]],
      untouched: [secret], copy: [secret, secret],
      found: [elsewhere, ...copy.messages.map(({ id }) => id)].sort(),
      prompts: [`The owner said: ${privateNotice}`, secret, "unrelated"], otherPrompts: [secret],
    })
  })
}, 180_000)
