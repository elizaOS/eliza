// spec/agent/conversation/replyStream.md, "Story: See a reply as it is written"
import { assert, describe, it } from "@effect/vitest"
import { held, insufficientCredits, partial, text } from "./support/cloud-fake.ts"
import { call, host, stream, type InProcess } from "./support/kernel.vibe"
import { streamingConversation } from "./support/streaming.vibe"
import type { StreamCut, StreamedAnswer } from "./support/socket-client.ts"

type Frame = {
  readonly type: string
  readonly text?: string
  readonly fullText?: string
  readonly failureKind?: string
  readonly provisional?: boolean
  readonly actionResults?: readonly unknown[]
}

module node {
  import type { AgentRuntime } from "@elizaos/core"
  import { Effect } from "effect"

  /** @throws {never} */
  export function delayReplyWrite(runtime: AgentRuntime, reject: boolean): void {
    const save = runtime.createMessageMemory.bind(runtime)
    runtime.createMessageMemory = async (memory, unique) => {
      if (memory.entityId === runtime.agentId && memory.content.actions?.includes("REPLY")) {
        await Effect.runPromise(Effect.sleep("300 millis"))
        if (reject) throw new Error("Reply storage refused the write")
      }
      return save(memory, unique)
    }
  }
}
import { delayReplyWrite } from node

const parsed = Schema.decodeUnknownOption(Schema.fromJsonString(Schema.Record(Schema.String, Schema.Unknown)))

function framesOf(answer: StreamedAnswer): Frame[] {
  return answer.text.split("\n\n").flatMap((event) => event.startsWith("data: ") ? Option.toArray(parsed(event.slice(6))) : [])
    .map((frame) => frame as Frame)
}

function rebuilt(frames: readonly Frame[]): string {
  return frames.reduce((shown, frame) => frame.type !== "token" ? shown : frame.fullText ?? shown + (frame.text ?? ""), "")
}

const kinds = (frames: readonly Frame[]) => frames.map((frame) =>
  frame.type !== "token" ? frame.type : frame.text === undefined ? "replace" : frame.fullText === undefined ? "append" : "snapshot")

effect function send(agent: InProcess, id: string, body: object, cut?: StreamCut, opened?: (status: number) => void) {
  return try stream(agent, { method: "POST", path: `/api/conversations/${id}/messages/stream`, body }, cut, opened)
}

const piece = (letter: string) => letter.repeat(1500)

for (const transport of ["socket", "http"] as const) {
  describe(`See a reply as it is written over the ${transport} (spec/agent/conversation/replyStream.md, "Story: See a reply as it is written")`, () => {
    it.live(`Appended text carries the whole text again at the cadence, and retries receive only the same done (spec/agent/conversation/replyStream.md, "Appended text carries the whole text again once the units appended since the last whole text reach the larger of 2048 and that text's length"; spec/agent/conversation/replyStream.md, "Only a message that starts its own turn streams text, a repeat waits for its reply, and a refusal opens no stream")`, effect () => {
      const { cloud, agent, id } = try streamingConversation(transport)
      try Effect.sync(() => delayReplyWrite(agent.agent.runtime, false))
      const offered = { text: "Write at length.", channelType: "VOICE_DM", metadata: { voiceUi: { surface: "voice" } }, clientMessageId: "cadence" }
      const release = Promise.withResolvers<void>()
      try Effect.sync(() => cloud.script(held(release.promise, text(piece("a"), piece("b"), piece("c")))))
      const started = try Effect.sync(() => cloud.nextCompletion())
      const [answer, { conflict, duplicate }] = try Effect.all([
        send(agent, id, offered),
        effect {
          try host("the first inference has started", () => started)
          const conflict = try send(agent, id, { ...offered, text: "Use another body." })
          const awaitingReply = Promise.withResolvers<number>()
          const [duplicate] = try Effect.all([
            send(agent, id, offered, undefined, awaitingReply.resolve),
            effect {
              if (transport === "socket") {
                const status = try host("the duplicate joined before the reply", () => awaitingReply.promise)
                try Effect.try(() => assert.strictEqual(status, 200))
              }
              try Effect.sync(() => release.resolve())
            },
          ], { concurrency: "unbounded" })
          return { conflict, duplicate }
        },
      ], { concurrency: "unbounded" })
      const frames = framesOf(answer)
      const terminal = frames.at(-1)
      const refused = try send(agent, id, { text: "Again.", streamProtocol: "v2" })
      const replay = try send(agent, id, offered)
      const buffered = try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`, body: offered })
      try Effect.try(() => assert.deepStrictEqual({
        status: answer.status, error: answer.error, first: frames[0], ends: frames.filter((frame) => frame.type === "done" || frame.type === "error").length,
        terminal: terminal?.type === "done" ? "done" : JSON.stringify([terminal, cloud.calls.map((made) => made.path)]), fullText: terminal?.fullText, rebuilt: rebuilt(frames),
        snapshots: kinds(frames).includes("snapshot"), provisional: frames.some((frame) => frame.provisional === true),
        ready: frames.filter(({ type }) => type === "reply_ready"), refused: [refused.status, refused.json],
      }, {
        status: 200, error: undefined, first: { type: "status", activity: "thinking" }, ends: 1,
        terminal: "done", fullText: piece("a") + piece("b") + piece("c"), rebuilt: piece("a") + piece("b") + piece("c"),
        snapshots: true, provisional: true,
        ready: [{ type: "reply_ready", fullText: piece("a") + piece("b") + piece("c"), actionResults: [] }],
        refused: [400, { error: "stream_protocol_unsupported" }],
      }))
      if (!("status" in buffered) || terminal === undefined) return try die(new Error("The buffered reply did not complete"))
      try Effect.try(() => {
        assert.deepStrictEqual([conflict.status, conflict.json, framesOf(conflict)], [409, { error: "CHAT_IDEMPOTENCY_CONFLICT" }, []])
        assert.deepStrictEqual([framesOf(duplicate), framesOf(replay)], [[terminal], [terminal]])
        assert.strictEqual(kinds(frames).at(-2), "reply_ready")
        assert.strictEqual(buffered.status, 200)
        const { type: _frame, ...reply } = terminal
        assert.deepStrictEqual(buffered.json, { ...reply, text: terminal.fullText })
        assert.lengthOf(cloud.calls.filter(({ path }) => path === "/api/v1/chat/completions"), 1)
      })
    }, 120_000)

    it.live('A client that leaves aborts the turn it streams (spec/agent/conversation/replyStream.md, "A client that leaves aborts the turn it streams, and nothing more is written to it"; spec/agent/conversation/turns.md, "An aborted reply records what ended its turn, and never in its text")', effect () => {
      const { cloud, agent, id } = try streamingConversation(transport, () => partial("Let me think"))
      const started = try Effect.sync(() => cloud.nextCompletion())
      const body = { text: "Think forever.", clientMessageId: "cut-with-text" }
      const answer = try send(agent, id, body, { afterChunks: 2, ready: started })
      const completion = try host("model call started", () => started)
      try host("model call cancelled", () => completion.aborted)
      const recovered = try call(agent, { method: "POST", path: `/api/conversations/${id}/messages`, body })
      if (!("status" in recovered)) return try Effect.die(new Error("The cut reply was not recovered"))
      const saved = recovered.json as { text?: string; failureKind?: string }
      const history = try call(agent, { method: "GET", path: `/api/conversations/${id}/messages` })
      const row = "status" in history ? (history.json as { messages: readonly { id: string; role: string; failureKind?: string; abortCause?: string; stopReason?: string }[] }).messages.find(({ role }) => role === "assistant") : undefined
      try Effect.try(() => assert.deepStrictEqual({
        status: answer.status, frames: framesOf(answer), error: answer.error,
        recovered: [recovered.status, saved.text, saved.failureKind],
        calls: cloud.calls.filter(({ path }) => path === "/api/v1/chat/completions").length,
        marks: [row?.failureKind, row?.abortCause, row?.stopReason],
      }, {
        status: 200, frames: [{ type: "status", activity: "thinking" }, { type: "token", text: "Let me think", provisional: true }], error: "closed before complete",
        recovered: [200, "Let me think", "aborted"], calls: 1, marks: ["aborted", "client_left", undefined],
      }))
    }, 120_000)

    it.live('A refused reply write ends without announcing the preview (spec/agent/conversation/replyStream.md, "The early reply is written at most once, and a stream that announced it ends with an answered done carrying the same action results")', effect () => {
      const { cloud, agent, id } = try streamingConversation(transport)
      try Effect.sync(() => {
        delayReplyWrite(agent.agent.runtime, true)
        cloud.script(text("This reply never committed."))
      })
      const answer = try send(agent, id, { text: "Answer me.", clientMessageId: "refused-write" })
      const frames = framesOf(answer)
      try Effect.try(() => {
        assert.strictEqual(answer.status, 200)
        assert.strictEqual(rebuilt(frames), "This reply never committed.")
        assert.isTrue(frames.filter(({ type }) => type === "token").every(({ provisional }) => provisional === true))
        assert.deepStrictEqual(frames.filter(({ type }) => type !== "status" && type !== "token").map(({ type }) => type), ["error"])
      })
    }, 120_000)

    it.live('An account refusal still ends with done and its failure kind (spec/agent/conversation/replyStream.md, "Every stream that is not dropped ends with exactly one done or error frame, after which nothing is written")', effect () => {
      const { agent, id } = try streamingConversation(transport, () => insufficientCredits())
      const answer = try send(agent, id, { text: "Answer me." })
      const frames = framesOf(answer)
      try Effect.try(() => assert.deepStrictEqual(
        { status: answer.status, ends: kinds(frames).filter((kind) => kind === "done" || kind === "error"), failureKind: frames.at(-1)?.failureKind },
        { status: 200, ends: ["done"], failureKind: "insufficient_credits" }))
    }, 120_000)

    it.live('A tool call the model wrote as text is never streamed, not even its first characters (spec/agent/conversation/planning.md, "A tool call the model wrote as text never reaches the owner, and its step is asked again once")', effect () => {
      const { cloud, agent, id } = try streamingConversation(transport)
      try Effect.sync(() => cloud.script(text("Let me open Maps.\n\n<", "tool_", "call>\n<function=phone_use>"), text("I can't open Maps from this chat.")))
      const answer = try send(agent, id, { text: "Show me coffee shops near me on the map." })
      const frames = framesOf(answer)
      try Effect.try(() => assert.deepStrictEqual({
        markup: frames.some((frame) => `${frame.text ?? ""}${frame.fullText ?? ""}`.includes("<")),
        fullText: frames.at(-1)?.fullText, rebuilt: rebuilt(frames),
      }, { markup: false, fullText: "I can't open Maps from this chat.", rebuilt: "I can't open Maps from this chat." }))
    }, 120_000)
  })
}
