// spec/agent/conversation/planning.md, "An identical call runs at most once per model response, and a settled effect is never repeated in the turn"
// spec/agent/views.md, "Story: Switch to the view the agent named"; spec/agent/views.md, "Story: Answer what the agent asks a view"; spec/agent/views.md, "Story: Stop waiting when my agent stops"
import { assert, it } from "@effect/vitest"
import { findViewActionHandoff, Service, type Action, type ActionResult, type IAgentRuntime, type Memory, type UUID } from "@elizaos/core"
import { navigationBusyWaitMs, navigationClaimLeaseMs, navigationWaitMs } from "../gen/agent__views.effect.vibe"
import type { AgentPlugin } from "../src/host/module.vibe"
import type { ViewBinding, ViewHost, ViewInteractFrame } from "../src/views/host.vibe"
import { viewHostServiceType, viewsModuleName } from "../src/views/module.vibe"
import { turnNotes } from "../src/conversation/planning.vibe"
import { text, toolCalls } from "./support/cloud-fake.ts"
import { ask, cloudFake, deviceKey, events, host, startInProcess, type InProcess } from "./support/kernel.vibe"

const loaded = {
  launch: {
    load: [viewsModuleName],
    views: [
      { id: "notes", label: "Notes", path: "/notes", aliases: ["jottings"] },
      { id: "chat", label: "Chat", path: "/chat" },
    ],
  },
}

effect function viewHost(agent: InProcess) {
  try host("view host start", () => agent.agent.runtime.getServiceLoadPromise(viewHostServiceType))
  const found = agent.agent.runtime.getService(viewHostServiceType)
  return try Effect.try(() => {
    assert.isDefined(found)
    return found as unknown as { readonly views: ViewHost.Shape; stop(): Promise<void> }
  })
}

const prepare = (agent: InProcess, viewId: string, requestId: string, clientId: string, extra: Record<string, unknown> = {}) => ask(agent, {
  method: "POST", path: `/api/views/${viewId}/navigate`, headers: { "x-elizaos-client-id": clientId },
  body: { delivery: "completed-action", prepareOnly: true, viewType: "gui", completedActionHandoffId: requestId, source: "agent", ...extra },
})
const claim = (agent: InProcess, binding: unknown) => ask(agent, { method: "POST", path: "/api/views/interact-claim", body: binding })
const result = (agent: InProcess, binding: unknown, claimId: string, switched: boolean) =>
  ask(agent, { method: "POST", path: "/api/views/interact-result", body: { ...(binding as object), claimId, success: true, result: { switched } } })
const bindingOf = (body: unknown): ViewBinding => (body as { navigationBinding: ViewBinding }).navigationBinding
const claimIdOf = (body: unknown): string => (body as { claimId: string }).claimId

it.effect(`Prepare, claim and confirm a switch through the routes (spec/agent/views.md, "A navigation is prepared only for a declared view and a request id not seen before"; spec/agent/views.md, "A claim names its request's exact binding and succeeds once"; spec/agent/views.md, "A result is accepted once, with its claim id, and a navigation result says whether it switched")`, effect () => {
  const agent = try startInProcess(loaded)
  try viewHost(agent)

  const prepared = try prepare(agent, "notes", "r1", "c1")
  const binding = bindingOf(prepared.body)
  const replayed = try prepare(agent, "chat", "r1", "c1")
  const undeclared = try prepare(agent, "nowhere", "r9", "c1")
  const wrongType = try prepare(agent, "notes", "r8", "c1", { viewType: "tui" })
  const extraKey = try prepare(agent, "notes", "r8", "c1", { surprise: true })
  const noClient = try ask(agent, { method: "POST", path: "/api/views/notes/navigate", body: { delivery: "completed-action", prepareOnly: true, viewType: "gui", completedActionHandoffId: "r8" } })
  const missingField = try claim(agent, { requestId: binding.requestId, clientId: "c1", viewId: "notes", viewType: "gui" })
  const wrongBinding = try claim(agent, { ...binding, installationId: "another-installation" })
  const claimed = try claim(agent, binding)
  const claimedAgain = try claim(agent, binding)
  const wrongClaim = try result(agent, binding, "not-the-claim", true)
  const switched = try result(agent, binding, claimIdOf(claimed.body), true)
  const twice = try result(agent, binding, claimIdOf(claimed.body), true)
  try Effect.try(() => {
    assert.deepStrictEqual(prepared, {
      status: 200,
      body: { ok: true, status: "prepared", viewId: "notes", completedActionHandoffId: "r1", navigationBinding: { requestId: "r1", clientId: "c1", viewId: "notes", viewType: "gui", installationId: binding.installationId } },
    })
    assert.deepStrictEqual([replayed.status, undeclared.status], [409, 409])
    assert.deepStrictEqual([wrongType.status, extraKey.status, noClient.status, missingField.status], [400, 400, 400, 400])
    assert.strictEqual(wrongBinding.status, 409)
    assert.strictEqual(claimed.status, 200)
    assert.isString(claimIdOf(claimed.body))
    assert.strictEqual(claimedAgain.status, 409)
    assert.deepStrictEqual(wrongClaim, { status: 200, body: { ok: true, accepted: false } })
    assert.deepStrictEqual(switched, { status: 200, body: { ok: true, accepted: true } })
    assert.deepStrictEqual(twice, { status: 200, body: { ok: true, accepted: false } })
  })

  const chat = try prepare(agent, "chat", "r2", "c1")
  const chatClaim = try claim(agent, bindingOf(chat.body))
  const notSwitched = try result(agent, bindingOf(chat.body), claimIdOf(chatClaim.body), false)
  try Effect.try(() => assert.deepStrictEqual(notSwitched.body, { ok: true, accepted: true }))
}, 120_000)

it.effect('A saved Notes editor requires a supported claim and an exact mounted-editor result (spec/agent/views.md, "A saved Notes editor claim requires support and only its exact editor can confirm the switch")', effect () => {
  const agent = try startInProcess(loaded)
  const { views } = try viewHost(agent)
  const prepared = try views.showSavedNote("saved-note-request", "current-renderer", "note-a")
  const binding = try Effect.try(() => {
    assert.isDefined(prepared)
    return prepared!.binding
  })
  const support = { targetProtocol: "saved-note-v1" }
  const oldRenderer = try claim(agent, binding)
  const otherRenderer = try claim(agent, { ...binding, ...support, clientId: "different-renderer" })
  const otherInstallation = try claim(agent, { ...binding, ...support, installationId: "different-installation" })
  const claimed = try claim(agent, { ...binding, ...support })
  const repeated = try claim(agent, { ...binding, ...support })
  const claimId = claimIdOf(claimed.body)
  const generic = try result(agent, binding, claimId, true)
  const report = (noteId: string) => ask(agent, {
    method: "POST", path: "/api/views/interact-result",
    body: { ...binding, claimId, success: true, result: { switched: true, shown: { kind: "saved-note", noteId } } },
  })
  const wrong = try report("note-b")
  const exact = try report("note-a")
  const repeatedResult = try report("note-a")
  try Effect.try(() => {
    assert.deepStrictEqual([oldRenderer.status, otherRenderer.status, otherInstallation.status, repeated.status], [409, 409, 409, 409])
    assert.strictEqual(claimed.status, 200)
    assert.deepStrictEqual(claimed.body, { claimId, target: { kind: "saved-note", noteId: "note-a" } })
    assert.deepStrictEqual([generic.body, wrong.body, repeatedResult.body], Array(3).fill({ ok: true, accepted: false }))
    assert.deepStrictEqual(exact.body, { ok: true, accepted: true })
  })
}, 120_000)

it.live('A completed chat reply gives its renderer the exact prepared switch it can claim (spec/agent/views.md, "The agent prepares a navigation only for the renderer bound to its turn and one view its name resolves to")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { ...loaded.launch, callerRole: "owner", backend: { kind: "cloud", origin: cloud.origin }, allowed: ["REPLY", "IGNORE", "NONE", "VIEWS"] },
    frame: { credential: { version: 1, value: deviceKey } },
  })
  const opened = try ask(agent, { method: "POST", path: "/api/conversations", body: {} })
  const { id } = (opened.body as { conversation: { id: string } }).conversation
  const headers = { "x-elizaos-client-id": "c2" }
  const body = { text: "Show my notes.", metadata: { viewDelivery: "completed-action", viewClientId: "c2" } }
  const show = { name: "VIEWS", arguments: { action: "show", view: "Jottings" } }
  try Effect.sync(() => cloud.script(toolCalls("", show, show), toolCalls("", show), text("Notes are ready.")))
  const reply = try ask(agent, { method: "POST", path: `/api/conversations/${id}/messages`, headers, body })
  const completed = (reply.body as { actionResults: readonly { action: string; data: { values?: { navigationBinding?: ViewBinding } } }[] }).actionResults
  const binding = completed.find(({ action }) => action === "VIEWS")?.data.values?.navigationBinding
  const taken = try claim(agent, binding)
  const applied = try result(agent, binding, claimIdOf(taken.body), true)
  try Effect.try(() => {
    assert.strictEqual(reply.status, 200)
    const toolResults = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).at(-1)?.body as { messages: { role: string; content?: unknown }[] } | undefined
    const transcript = toolResults?.messages.filter(({ role }) => role === "tool").map(({ content }) => String(content))
    assert.deepStrictEqual(transcript?.filter((content) => /DuplicateInBatch|AlreadySettled/u.test(content)).map((content) => JSON.parse(content).data.code), ["DuplicateInBatch", "AlreadySettled"])
    assert.lengthOf(completed.filter(({ action }) => action === "VIEWS"), 1)
    assert.strictEqual(binding?.clientId, "c2")
    assert.strictEqual(binding?.viewId, "notes")
    assert.strictEqual(taken.status, 200)
    assert.deepStrictEqual(applied.body, { ok: true, accepted: true })
  })
}, 120_000)

it.live('A view the turn\'s screen says it cannot show is refused before anything is prepared, and the views it can show still open (spec/agent/views.md, "The agent prepares a navigation only for the renderer bound to its turn and one view its name resolves to"; spec/agent/conversation/turnContext.md, "A voice view context is accepted only when every stated field has an allowed value and direct requests have completed-action delivery and a routing identity")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { ...loaded.launch, callerRole: "owner", backend: { kind: "cloud", origin: cloud.origin }, allowed: ["REPLY", "IGNORE", "NONE", "VIEWS"] },
    frame: { credential: { version: 1, value: deviceKey } },
  })
  const opened = try ask(agent, { method: "POST", path: "/api/conversations", body: {} })
  const { id } = (opened.body as { conversation: { id: string } }).conversation
  const clientId = "screen-views"
  const turn = effect (uiViews: readonly unknown[] | undefined) => {
    const from = cloud.calls.length
    try Effect.sync(() => cloud.script(toolCalls("", { name: "VIEWS", arguments: { action: "show", view: "Jottings" } }), text("Done.")))
    const voiceUi = { viewDelivery: "completed-action", uiClientId: clientId, ...(uiViews === undefined ? {} : { uiViews }) }
    const reply = try ask(agent, { method: "POST", path: `/api/conversations/${id}/messages`, headers: { "x-elizaos-client-id": clientId },
      body: { text: "Show my notes.", metadata: { viewDelivery: "completed-action", viewClientId: clientId, voiceUi } } })
    const steps = (reply.body as { actionResults?: readonly { action: string; data?: { values?: { navigationBinding?: ViewBinding } } }[] }).actionResults ?? []
    const binding = steps.find(({ action }) => action === "VIEWS")?.data?.values?.navigationBinding
    if (binding !== undefined) try result(agent, binding, claimIdOf((try claim(agent, binding)).body), true)
    return { status: reply.status, binding, seen: JSON.stringify(cloud.calls.slice(from).filter(({ path }) => path.endsWith("/chat/completions"))) }
  }
  const withheld = try turn(["home", "calendar"])
  const listed = try turn(["home", "notes"])
  const silent = try turn(undefined)
  const malformed = try turn(["Notes!"])
  try Effect.try(() => {
    assert.strictEqual(withheld.status, 200)
    assert.isUndefined(withheld.binding)
    assert.include(withheld.seen, "The owner's screen here has no Notes, so it was not opened and will not open on this screen.")
    assert.strictEqual(listed.binding?.viewId, "notes")
    assert.notInclude(listed.seen, "The owner's screen here has no")
    assert.strictEqual(silent.binding?.viewId, "notes")
    assert.strictEqual(malformed.status, 400)
    assert.isUndefined(malformed.binding)
  })
}, 120_000)

it.live('A completed turn prepares the saved editor for the note the model named, only after its current Notes lookup or its own creation (spec/agent/views.md, "A specific saved Notes editor is prepared only after a matching current lookup on a supported renderer")', effect () => {
  const cloud = try cloudFake(deviceKey)
  let current = true
  const saved: Readonly<Record<string, string>> = { "Ferry checklist": "note-ferry", Calendar: "note-calendar", "Q3 offsite": "note-offsite", "shopping list": "note-shopping", groceries: "note-groceries" }
  const held = new Set(Object.values(saved))
  const listedOnly = new Map<string, string>()
  class NotesFixture extends Service {
    static override serviceType = "notes"
    override capabilityDescription = "Current note fixture"
    static override start(runtime: IAgentRuntime): Promise<Service> { return Promise.resolve(new NotesFixture(runtime)) }
    override stop(): Promise<void> { return Promise.resolve() }
    matchesSavedEditor(id: string, query: string): Promise<boolean> {
      return Promise.resolve(current && (query === id ? held.has(id) || [...listedOnly.values()].includes(id) : saved[query] === id))
    }
    snapshot(): Promise<{ notes: { id: string }[] }> {
      return Promise.resolve({ notes: current ? [...held].map((noteId) => ({ id: noteId })) : [] })
    }
  }
  const creation: Action = {
    name: "NOTES_CREATE", similes: [], description: "Create a test note.",
    validate: async () => true,
    parameters: [{ name: "content", required: true, description: "Note title", schema: { type: "string" } }],
    handler: async (_runtime, _message, _state, options) => {
      const params = options?.parameters
      const content = typeof params === "object" && params !== null && "content" in params && typeof params.content === "string" ? params.content : ""
      const noteId = `note-created-${held.size}`
      held.add(noteId)
      return { success: true, data: { actionName: "NOTES_CREATE", op: "create", noteId, note: { id: noteId, title: content } } }
    },
  }
  const lookup: Action = {
    name: "NOTES_GET", similes: [], description: "Read the current test note.",
    validate: async () => true,
    parameters: [{ name: "content", required: true, description: "Note title", schema: { type: "string" } }],
    handler: async (_runtime, _message, _state, options) => {
      const params = options?.parameters
      const content = typeof params === "object" && params !== null && "content" in params && typeof params.content === "string" ? params.content : ""
      return content === "Shoot day" ? { success: true, data: { actionName: "NOTES_GET", code: "NOTES_AMBIGUOUS_NOTE" } }
        : { success: true, data: { actionName: "NOTES_GET", noteId: saved[content] ?? "note-ferry" } }
    },
  }
  const listing: Action = {
    name: "NOTES_LIST", similes: [], description: "List the test notes whose title holds content.",
    validate: async () => true,
    parameters: [{ name: "content", required: false, description: "Title filter", schema: { type: "string" } }],
    handler: async (_runtime, _message, _state, options) => {
      const params = options?.parameters
      const content = typeof params === "object" && params !== null && "content" in params && typeof params.content === "string" ? params.content.toLowerCase() : ""
      const notes = [...Object.entries(saved), ...listedOnly].filter(([title]) => title.toLowerCase().includes(content)).map(([title, noteId]) => ({ id: noteId, title }))
      return { success: true, data: { actionName: "NOTES_LIST", notes } }
    },
  }
  const name = "notes-test-fixture"
  const agent = try startInProcess({
    launch: { ...loaded.launch, load: [...loaded.launch.load, name], callerRole: "owner",
      views: [...loaded.launch.views, { id: "agenda", label: "Calendar", path: "/calendar", aliases: ["appointments"] }],
      backend: { kind: "cloud", origin: cloud.origin }, allowed: ["REPLY", "IGNORE", "NONE", "VIEWS", "NOTES_GET", "NOTES_LIST", "NOTES_CREATE"] },
    frame: { credential: { version: 1, value: deviceKey } },
    bundled: new Map([[name, { name, description: "Saved Notes fixture", actions: [lookup, listing, creation], services: [NotesFixture] }]]),
  })
  const opened = try ask(agent, { method: "POST", path: "/api/conversations", body: {} })
  const { id } = (opened.body as { conversation: { id: string } }).conversation
  const clientId = "notes-renderer"
  const headers = { "x-elizaos-client-id": clientId }
  const metadata = { viewDelivery: "completed-action", viewClientId: clientId,
    voiceUi: { viewDelivery: "completed-action", uiClientId: clientId, uiNotesEditor: "saved-note-v1" } }
  const get = (content: string) => ({ name: "NOTES_GET", arguments: { content } })
  const list = (content: string) => ({ name: "NOTES_LIST", arguments: { content } })
  const create = (content: string) => ({ name: "NOTES_CREATE", arguments: { content } })
  const editor = (note: string) => ({ name: "VIEWS", arguments: { action: "show", view: "notes-editor", note } })
  const view = (named: string) => ({ name: "VIEWS", arguments: { action: "show", view: named } })
  const send = (request: string, data: object) => ask(agent, { method: "POST", path: "/api/conversations/" + id + "/messages",
    headers, body: { text: request, metadata: data } })
  const handoff = (response: { body: unknown }) => {
    const steps = (response.body as { actionResults: readonly { action: string; data?: { values?: { subview?: string; navigationBinding?: ViewBinding; noteId?: string } } }[] }).actionResults
    return steps.find(({ action }) => action === "VIEWS")?.data?.values
  }
  const claimed = (found: ReturnType<typeof handoff>) => claim(agent, { ...found?.navigationBinding, targetProtocol: "saved-note-v1" })
  const shown = (found: ReturnType<typeof handoff>, claimId: string, noteId: string) => ask(agent, {
    method: "POST", path: "/api/views/interact-result",
    body: { ...found?.navigationBinding, claimId, success: true, result: { switched: true, shown: { kind: "saved-note", noteId } } },
  })
  const opensNote = effect (request: string, content: string) => {
    try Effect.sync(() => cloud.script(toolCalls("", get(content)), toolCalls("", editor(content)), text("The note is open.")))
    const found = handoff(try send(request, metadata))
    const { claimId, target } = (try claimed(found)).body as { claimId?: string; target?: { kind: string; noteId: string } }
    try shown(found, claimId ?? "", target?.noteId ?? "")
    return { subview: found?.subview, noteId: found?.noteId, target }
  }

  try Effect.sync(() => cloud.script(toolCalls("", get("Ferry checklist")), toolCalls("", editor("Ferry checklist")), text("The editor is prepared.")))
  const found = handoff(try send("Open my Ferry checklist in Notes.", metadata))
  const ferryClaim = try claimed(found)
  const applied = try shown(found, claimIdOf(ferryClaim.body), "note-ferry")
  try Effect.sync(() => { current = false })
  try Effect.sync(() => cloud.script(toolCalls("", get("Ferry checklist")), toolCalls("", editor("Ferry checklist")), text("That note is unavailable.")))
  const stale = handoff(try send("Open my Ferry checklist in Notes.", metadata))
  try Effect.sync(() => { current = true })
  try Effect.sync(() => cloud.script(toolCalls("", get("Ferry checklist")), toolCalls("", view("notes-editor")), text("Which note?")))
  const unnamed = handoff(try send("Open my Ferry checklist in Notes.", metadata))
  const modelSaw = effect (request: string, data: object, replies: () => void) => {
    const from = cloud.calls.length
    try Effect.sync(replies)
    const values = handoff(try send(request, data))
    return { values, seen: JSON.stringify(cloud.calls.slice(from).filter(({ path }) => path.endsWith("/chat/completions"))) }
  }
  const mismatched = try modelSaw("Open my Ferry checklist in Notes.", metadata, () => cloud.script(toolCalls("", get("Ferry checklist")), toolCalls("", editor("Calendar")), text("Which note?")))
  const unsupported = { viewDelivery: "completed-action", viewClientId: clientId, voiceUi: { viewDelivery: "completed-action", uiClientId: clientId } }
  const noEditor = try modelSaw("Open my Ferry checklist in Notes.", unsupported, () => cloud.script(toolCalls("", get("Ferry checklist")), toolCalls("", view("notes-editor")), text("I can't open that note here.")))
  const calendarCallStart = cloud.calls.length
  try Effect.sync(() => cloud.script(toolCalls("", view("Calendar")), text("Calendar is ready.")))
  const calendar = handoff(try send("Open Calendar.", metadata))
  const calendarCompletions = cloud.calls.slice(calendarCallStart).filter(({ path }) => path.endsWith("/chat/completions"))
  try Effect.sync(() => cloud.script(toolCalls("", view("appointments")), text("Appointments are ready.")))
  const alias = handoff(try send("Open the appointments.", metadata))
  const noted = [
    try opensNote("Open my note called Calendar.", "Calendar"),
    try opensNote("open the notes for the Q3 offsite", "Q3 offsite"),
    try opensNote("open the note titled shopping list", "shopping list"),
    try opensNote("pull up my shopping list", "shopping list"),
  ]
  try Effect.sync(() => { listedOnly.set("Shoot day checklist", "note-shoot") })
  try Effect.sync(() => cloud.script(toolCalls("", list("shoot")), toolCalls("", editor("note-shoot")), text("The note is open.")))
  const listedOpen = handoff(try send("show me the shoot list in notes", metadata))
  const listedClaim = (try claimed(listedOpen)).body as { claimId?: string; target?: { noteId: string } }
  try shown(listedOpen, listedClaim.claimId ?? "", listedClaim.target?.noteId ?? "")
  try Effect.sync(() => cloud.script(toolCalls("", list("shoot")), toolCalls("", editor("Shoot day checklist")), text("Which note?")))
  const listedByTitle = handoff(try send("show me the shoot list in notes", metadata))
  try Effect.sync(() => cloud.script(toolCalls("", list("groceries")), toolCalls("", editor("note-shoot")), text("Which note?")))
  const notListed = handoff(try send("open my shoot day checklist", metadata))
  try Effect.sync(() => cloud.script(toolCalls("", get("Shoot day")), toolCalls("", list("shoot")), toolCalls("", editor("note-shoot")), text("Which note?")))
  const listedAfterAmbiguous = handoff(try send("open my shoot day note", metadata))
  try Effect.sync(() => cloud.script(toolCalls("", create("Groceries")), toolCalls("", editor("groceries")), text("Created and opened.")))
  const created = handoff(try send("create a checklist called groceries with milk and eggs and open it", metadata))
  const createdClaim = (try claimed(created)).body as { target?: { noteId: string } }
  try Effect.sync(() => cloud.script(toolCalls("", create("Packing")), toolCalls("", editor("Ferry checklist")), text("Which note?")))
  const notCreated = handoff(try send("make a packing note and open my ferry checklist", metadata))
  const savedNoteCoaching = "To open one saved note the owner asks for, in any words, first resolve it with NOTES_GET."
  try Effect.try(() => {
    assert.strictEqual(found?.subview, "saved-note-v1")
    assert.isUndefined(found?.noteId)
    assert.strictEqual(ferryClaim.status, 200)
    assert.deepStrictEqual(ferryClaim.body, { claimId: claimIdOf(ferryClaim.body), target: { kind: "saved-note", noteId: "note-ferry" } })
    assert.deepStrictEqual(applied.body, { ok: true, accepted: true })
    assert.isUndefined(stale?.navigationBinding)
    assert.isUndefined(unnamed?.navigationBinding)
    assert.isUndefined(mismatched.values?.navigationBinding)
    assert.include(mismatched.seen, "did not match note to the one note NOTES_GET found")
    assert.isUndefined(noEditor.values?.navigationBinding)
    assert.include(noEditor.seen, "This turn cannot open a saved Notes editor.")
    assert.notInclude(noEditor.seen, "Name the saved note to open")
    assert.strictEqual(calendar?.navigationBinding?.viewId, "agenda")
    assert.isUndefined(calendar?.subview)
    assert.strictEqual(alias?.navigationBinding?.viewId, "agenda")
    assert.isUndefined(alias?.subview)
    assert.include(JSON.stringify(calendarCompletions), savedNoteCoaching)
    assert.deepStrictEqual(noted, ["note-calendar", "note-offsite", "note-shopping", "note-shopping"].map((noteId) => ({ subview: "saved-note-v1", noteId: undefined, target: { kind: "saved-note", noteId } })))
    assert.deepStrictEqual([created?.subview, createdClaim.target?.noteId], ["saved-note-v1", "note-created-5"])
    assert.isUndefined(notCreated?.navigationBinding)
    assert.deepStrictEqual([listedOpen?.subview, listedOpen?.noteId, listedClaim.target?.noteId], ["saved-note-v1", undefined, "note-shoot"])
    assert.isUndefined(listedByTitle?.navigationBinding)
    assert.isUndefined(notListed?.navigationBinding)
    assert.isUndefined(listedAfterAmbiguous?.navigationBinding)
  })
}, 120_000)

it.effect(`A second prepare supersedes an unclaimed navigation, waits for a claimed one and is refused only if it stays claimed, and a lost claim or wait is unknown (spec/agent/views.md, "Preparing again supersedes the client's unclaimed navigation and is refused while one is claimed"; spec/agent/views.md, "A request whose renderer left, whose delivery failed or whose wait ran out ends unknown and never changes again")`, effect () => {
  const agent = try startInProcess(loaded)
  const { views } = try viewHost(agent)

  const first = try views.prepare("r1", "c1", "notes")
  const second = try views.prepare("r2", "c1", "chat")
  const superseded = try first!.wait
  const claimed = try claim(agent, second!.binding)
  const waitingPrepare = fork views.prepare("r3", "c1", "notes")
  for (let round = 0; round < 20; round += 1) try Effect.yieldNow
  try TestClock.adjust(Duration.millis(navigationBusyWaitMs))
  const whileClaimed = join waitingPrepare
  try TestClock.adjust(Duration.millis(navigationClaimLeaseMs - navigationBusyWaitMs))
  const lost = try second!.wait
  const late = try result(agent, second!.binding, claimIdOf(claimed.body), true)
  const afterLease = try prepare(agent, "notes", "r4", "c1")
  try Effect.try(() => {
    assert.deepStrictEqual(superseded, { kind: "Superseded" })
    assert.strictEqual(claimed.status, 200)
    assert.isUndefined(whileClaimed)
    assert.deepStrictEqual(lost, { kind: "Unknown" })
    assert.deepStrictEqual(late.body, { ok: true, accepted: false })
    assert.strictEqual(afterLease.status, 200)
  })

  const fourth = bindingOf(afterLease.body)
  const fourthClaim = try claim(agent, fourth)
  const waited = fork views.prepare("r5", "c1", "chat")
  for (let round = 0; round < 20; round += 1) try Effect.yieldNow
  const switched = try result(agent, fourth, claimIdOf(fourthClaim.body), true)
  const fifth = join waited
  const unclaimed = try views.prepare("r6", "c1", "notes")
  const retired = try fifth!.wait
  try TestClock.adjust(Duration.millis(navigationWaitMs))
  const expired = try unclaimed!.wait
  try Effect.try(() => {
    assert.deepStrictEqual(switched.body, { ok: true, accepted: true })
    assert.strictEqual(fifth?.binding.requestId, "r5")
    assert.deepStrictEqual(retired, { kind: "Superseded" })
    assert.deepStrictEqual(expired, { kind: "Unknown" })
  })
}, 120_000)

const pages: AgentPlugin = {
  name: "@elizaos/plugin-pages",
  description: "Declares a view that takes the agent's page commands",
  views: [{ id: "pages", label: "Pages", path: "/pages", modalities: ["gui"], capabilities: [{ id: "page-command", description: "Turn the page" }] }],
}

const interaction = (frame: unknown): ViewInteractFrame | undefined => {
  const event = frame as { readonly type?: unknown; readonly event?: { readonly stream?: unknown; readonly payload?: { readonly frame?: ViewInteractFrame } } }
  return event.type === "event" && event.event?.stream === "view-interact" ? event.event.payload?.frame : undefined
}

it.live(`An ask of a view a plugin loaded before the views module declares is framed to the renderer's live feed, claimed and answered once; an ask with no feed is unavailable, and stopping ends every wait with Stopped (spec/agent/views.md, "Views are declared once at boot with distinct ids, paths and names, and never change after"; spec/agent/views.md, "The agent asks only a declared view, for a capability the view grants the agent, on a live feed"; spec/agent/views.md, "A claim names its request's exact binding and succeeds once"; spec/agent/views.md, "A result is accepted once, with its claim id, and a navigation result says whether it switched"; spec/agent/views.md, "Closing ends every pending request with the outcome Stopped, and nothing changes after")`, effect () => {
  const agent = try startInProcess({ launch: { ...loaded.launch, load: [pages.name, viewsModuleName] }, bundled: new Map([[pages.name, pages]]) })
  const service = try viewHost(agent)
  const views = service.views

  const grant = { roleAllowed: true, standard: false, declared: true, manifestAllows: true, agentAuthority: true }
  const unavailable = try views.ask({ clientId: "c1", viewId: "notes", capability: "get-state", params: {}, grant: { ...grant, standard: true, declared: false } })
  const feed = try events(agent, ["view-interact"], "c3")
  try host("renderer subscribed", () => feed.next())
  const undeclared = try views.ask({ clientId: "c3", viewId: "nowhere", capability: "page-command", params: {}, grant })
  const unnamed = try views.ask({ clientId: "c3", viewId: "pages", capability: "", params: {}, grant })
  const request = { clientId: "c3", viewId: "pages", capability: "page-command", params: { page: 2 } }
  const authorities = [
    { ...grant, roleAllowed: false }, { ...grant, declared: false },
    { ...grant, manifestAllows: false }, { ...grant, agentAuthority: false },
  ]
  for (const denied of authorities) {
    const answer = try views.ask({ ...request, grant: denied })
    try Effect.try(() => assert.deepStrictEqual(answer, { kind: "refused" }))
  }
  const asked = try views.ask({ ...request, grant })
  try Effect.try(() => assert.deepStrictEqual([unavailable, undeclared, unnamed, asked.kind], [{ kind: "unavailable" }, { kind: "refused" }, { kind: "refused" }, "asked"]))
  const sent = interaction(try host("view frame", () => feed.next((frame) => interaction(frame) !== undefined)))
  try Effect.try(() => assert.isDefined(sent, "The admitted ask did not publish a view frame"))
  const frame = sent!
  const binding = { requestId: frame.requestId, clientId: "c3", viewId: "pages", viewType: "gui", installationId: frame.installationId }
  const claimed = try claim(agent, binding)
  const answered = try ask(agent, { method: "POST", path: "/api/views/interact-result", body: { ...binding, claimId: claimIdOf(claimed.body), success: true, result: { turned: true } } })
  const again = try ask(agent, { method: "POST", path: "/api/views/interact-result", body: { ...binding, claimId: claimIdOf(claimed.body), success: true, result: { turned: true } } })
  const waited = asked.kind === "asked" ? try asked.wait : asked
  try Effect.try(() => {
    assert.deepStrictEqual(sent, { type: "view:interact", installationId: binding.installationId, viewId: "pages", viewType: "gui", capability: "page-command", params: { page: 2 }, requestId: binding.requestId })
    assert.strictEqual(claimed.status, 200)
    assert.deepStrictEqual([answered.body, again.body], [{ ok: true, accepted: true }, { ok: true, accepted: false }])
    assert.deepStrictEqual(waited, { kind: "Replied", reply: "Answered", answer: { success: true, result: { turned: true } } })
  })

  const pending = try views.prepare("r1", "c1", "notes")
  try host("view host stop", () => service.stop())
  const stopped = try pending!.wait
  const afterStop = try claim(agent, pending!.binding)
  const prepareAfterStop = try prepare(agent, "chat", "r2", "c1")
  try Effect.try(() => {
    assert.deepStrictEqual(stopped, { kind: "Stopped" })
    assert.deepStrictEqual([afterStop.status, prepareAfterStop.status], [409, 409])
  })
}, 120_000)

const turn = (metadata: Record<string, unknown>): Memory => ({
  entityId: "00000000-0000-4000-8000-000000000001" as UUID,
  roomId: "00000000-0000-4000-8000-000000000002" as UUID,
  content: { text: "show my notes", metadata },
} as Memory)

effect function show(agent: InProcess, message: Memory, view: string) {
  const action = agent.agent.runtime.actions.find((candidate: Action) => candidate.name === "VIEWS")
  return try host(`VIEWS show ${view}`, async () => {
    assert.isDefined(action)
    return (await action!.handler(agent.agent.runtime, message, undefined, { parameters: { action: "show", view } })) as ActionResult
  })
}

it.effect(`The VIEWS show action prepares a navigation for the turn's renderer by alias, and the renderer confirms it (spec/agent/views.md, "The agent prepares a navigation only for the renderer bound to its turn and one view its name resolves to"; spec/agent/views.md, "The model is told every declared view by its names, and on a bound turn the view the owner's screen showed"; spec/agent/views.md, "A result is accepted once, with its claim id, and a navigation result says whether it switched")`, effect () => {
  const agent = try startInProcess(loaded)
  try viewHost(agent)
  const renderer = turn({ viewClientId: "c2", viewDelivery: "completed-action" })

  const action = agent.agent.runtime.actions.find((candidate: Action) => candidate.name === "VIEWS")
  const note = action === undefined ? undefined : turnNotes.get(action)
  const onChat = note?.(agent.agent.runtime, turn({ viewClientId: "c2", viewDelivery: "completed-action", observation: { view: "chat", revision: 3, sensitive: false } }))
  const unbound = note?.(agent.agent.runtime, turn({ observation: { view: "chat", revision: 3, sensitive: false } }))
  const shown = try show(agent, renderer, "Jottings")
  const unknown = try show(agent, renderer, "nowhere")
  const noRenderer = try show(agent, turn({ viewClientId: "c2" }), "notes")
  const values = shown.values as Record<string, unknown>
  const binding = values.navigationBinding as ViewBinding
  const handoff = try Effect.try(() => findViewActionHandoff([{ ...shown, actionName: "VIEWS" }]))
  const claimed = try claim(agent, binding)
  const switched = try result(agent, binding, claimIdOf(claimed.body), true)
  try Effect.try(() => {
    assert.isTrue(shown.success)
    assert.include(action?.description ?? "", "The owner's views are Notes (jottings), Chat.")
    assert.include(action?.description ?? "", "Going to a view by its name, such as go home, go to Calendar or back to Notes, is showing that view with VIEWS")
    assert.include(onChat ?? "", "The owner's screen showed Chat as they sent this message")
    assert.notInclude(onChat ?? "", "Notes")
    assert.isUndefined(unbound)
    assert.deepStrictEqual(Object.keys(values).sort(), [
      "completedActionDelivered", "completedActionHandoffId", "label", "mode", "navigationBinding", "navigationPrepared", "viewId", "viewPath", "viewType",
    ])
    assert.deepStrictEqual({ ...values, completedActionHandoffId: "", navigationBinding: { ...binding, requestId: "", installationId: "" } }, {
      mode: "show", viewId: "notes", viewPath: "/notes", viewType: "gui", label: "Notes", completedActionDelivered: false,
      completedActionHandoffId: "", navigationPrepared: true,
      navigationBinding: { requestId: "", clientId: "c2", viewId: "notes", viewType: "gui", installationId: "" },
    })
    assert.match(binding.requestId, /^[0-9a-f-]{36}$/)
    assert.strictEqual(values.completedActionHandoffId, binding.requestId)
    assert.deepStrictEqual(handoff?.navigationBinding, binding)
    assert.deepStrictEqual([unknown.success, noRenderer.success], [false, false])
    assert.deepStrictEqual(switched.body, { ok: true, accepted: true })
  })
}, 120_000)
