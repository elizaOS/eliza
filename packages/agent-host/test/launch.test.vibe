// spec/agent/host/launch.md, "The launch document is accepted whole or refused whole"; spec/agent/host/launch.md, "A refused document is a configuration error, and a cloud or own-key launch without a credential is a credential error"; spec/agent/host/launch.md, "The launch frame is one stdin line with the token, the epoch, and the optional credential and storage key"; spec/agent/host/launch.md, "Local embeddings boot only when the device serves them: no operator endpoint or chosen hosted service takes precedence, and the local inference plugin is listed"; spec/agent/host/launch.md, "Plugin settings never set a reserved key, and log retention bounds are positive"
import { assert, it } from "@effect/vitest"
import { AGENT_EXIT_CODES, exitClass, exitCode, parseLaunch } from "../src/host/launch.vibe"
import { startAgent } from "../src/host/process.vibe"
import { agentChild, boot, host, ready, scratch } from "./support/kernel.vibe"
import { account, launchDocument, launchFrame, writeLaunch, type LaunchOptions } from "./support/scratch.ts"

const cloudBackend = { kind: "cloud" as const, origin: "https://cloud.example" }
const ownKeyBackend = { kind: "ownKey" as const, baseUrl: "https://own.example/v1", smallModel: "small", largeModel: "large" }
const keyed = { credential: { version: 1, value: "credential-value-1" } }

effect function refusal(document: Record<string, unknown>, frame: unknown = launchFrame(keyed)) {
  const failed = try Effect.flip(parseLaunch(JSON.stringify(document), JSON.stringify(frame)))
  return failed._tag
}

const mutate = (options: LaunchOptions, change: (document: Record<string, unknown>) => Record<string, unknown>) => change(launchDocument(options))

it.effect('A whole document is admitted and secrets stay Redacted (spec/agent/host/launch.md, "The launch document is accepted whole or refused whole")', effect () => {
  const parsed = try parseLaunch(JSON.stringify(launchDocument({ backend: cloudBackend, callerRole: "owner", productPlugin: "@product/plugin", load: ["a", "b"], hostContextRevision: 3 })), JSON.stringify(launchFrame(keyed)))
  try Effect.try(() => assert.deepStrictEqual(
    [parsed.launch.callerRole, parsed.launch.policy.plugins.product, parsed.launch.hostContextRevision, String(parsed.authority.credential?.value)],
    ["owner", "@product/plugin", 3, "<redacted>"]))
})

it.effect('A document with any bad part is refused whole (spec/agent/host/launch.md, "The launch document is accepted whole or refused whole")', effect () => {
  const refused = try Effect.forEach([
    mutate({}, (d) => ({ ...d, character: { name: " Eliza", system: "s" } })),
    mutate({}, (d) => ({ ...d, character: { name: "", system: "s" } })),
    mutate({}, (d) => ({ ...d, character: { name: "x".repeat(51), system: "s" } })),
    mutate({}, (d) => ({ ...d, character: { name: "Eliza", system: "  " } })),
    launchDocument({ allowed: [] }),
    launchDocument({ load: ["a", "a"] }),
    launchDocument({ load: ["a"], productPlugin: "a" }),
    mutate({ backend: cloudBackend }, ({ account: _account, ...rest }) => rest),
    launchDocument({ backend: { kind: "cloud", origin: "https://cloud.example/api/v1" } }),
    launchDocument({ backend: { kind: "cloud", origin: "http://cloud.example" } }),
    mutate({ backend: ownKeyBackend }, (d) => ({ ...d, model: { backend: "own-key", ownKeyBaseUrl: "https://own.example/v1" } })),
    launchDocument({ backend: { ...ownKeyBackend, sampling: { large: "no-temperature" as "default-temperature-only" } } }),
    mutate({ backend: ownKeyBackend }, (d) => ({ ...d, model: { ...(d.model as object), ownKeySampling: { large: "default-temperature-only", image: "takes-temperature" } } })),
    mutate({}, (d) => ({ ...d, embeddings: "local" })),
    mutate({}, (d) => ({ ...d, embeddings: "local", embeddingDimensions: 0 })),
    launchDocument({ environment: { NODE_OPTIONS: "--x" } }),
    launchDocument({ environment: { ELIZA_AGENT_X: "1" } }),
    launchDocument({ environment: { PATH: "/bin" } }),
    launchDocument({ environment: { lower: "1" } }),
    launchDocument({ environment: { SETTING: "a\nb" } }),
    launchDocument({ environment: { SETTING: "a\rb" } }),
    launchDocument({ retention: { days: 0, maxRowsPerRoom: 10, intervalMinutes: 5 } }),
    launchDocument({ retention: { days: 1, maxRowsPerRoom: 0, intervalMinutes: 5 } }),
    launchDocument({ retention: { days: 1, maxRowsPerRoom: 10, intervalMinutes: 0 } }),
    mutate({}, (d) => ({ ...d, schema: 2 })),
    mutate({}, (d) => ({ ...d, callerRole: "root" })),
    mutate({}, (d) => ({ ...d, agentId: "x" })),
  ], (document) => refusal(document))
  try Effect.try(() => assert.deepStrictEqual(refused.map((tag) => tag), refused.map(() => "LaunchDocumentRejected")))
})

it.effect('Admitted documents include a path-less cloud origin, own key and local embeddings with dimensions (spec/agent/host/launch.md, "The launch document is accepted whole or refused whole")', effect () => {
  const frame = JSON.stringify(launchFrame(keyed))
  const accepted = try Effect.forEach([
    launchDocument({ backend: cloudBackend }),
    launchDocument({ backend: ownKeyBackend }),
    launchDocument({ backend: { ...ownKeyBackend, sampling: { small: "takes-temperature", large: "default-temperature-only" } } }),
    mutate({}, (d) => ({ ...d, embeddings: "local", embeddingDimensions: 384 })),
    launchDocument({ retention: { days: 0.25, maxRowsPerRoom: 200, intervalMinutes: 30 } }),
  ], (document) => parseLaunch(JSON.stringify(document), frame))
  try Effect.try(() => assert.strictEqual(accepted.length, 5))
})

it.effect('A retention under a thousandth of a day still has a positive age and boots (spec/agent/host/launch.md, "Plugin settings never set a reserved key, and log retention bounds are positive")', effect () => {
  const state = try scratch("launch-short-retention")
  const parsed = try parseLaunch(JSON.stringify(launchDocument({ retention: { days: 0.0004, maxRowsPerRoom: 10, intervalMinutes: 5 } })), JSON.stringify(launchFrame()))
  const running = try acquireRelease(
    startAgent({ ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: state.file("agent.sock") } }),
    (agent) => orDie(host("retire agent", () => agent.stop())),
  )
  try Effect.try(() => assert.strictEqual(running.runtime.character.name, "Eliza"))
}, 120_000)

it.effect('View declarations are exactly {id, label, path, aliases?} within their limits (spec/agent/views.md, "Views are declared once at boot with distinct ids, paths and names, and never change after")', effect () => {
  const frame = JSON.stringify(launchFrame(keyed))
  const view = { id: "notes", label: "Notes", path: "/apps/notes", aliases: ["memo", "jot pad"] }
  const withViews = (views: unknown) => mutate({}, (d) => ({ ...d, views }))
  const accepted = try parseLaunch(JSON.stringify(withViews([view, { id: "chat", label: "Chat", path: "/chat" }])), frame)
  const refused = try Effect.forEach([
    [{ ...view, id: "Notes" }], [{ ...view, id: "1notes" }], [{ ...view, label: " Notes" }], [{ ...view, label: "" }],
    [{ ...view, label: "x".repeat(81) }], [{ ...view, label: "No\u0007tes" }], [{ ...view, path: "notes" }], [{ ...view, path: "/notes/" }],
    [{ ...view, path: `/${"p".repeat(256)}` }], [{ ...view, aliases: [] }], [{ ...view, aliases: ["a", "b", "c", "d", "e"] }],
    [{ ...view, aliases: ["Memo"] }], [{ ...view, aliases: ["memo "] }], [{ ...view, viewType: "gui" }],
    Array.from({ length: 33 }, (_, at) => ({ id: `v${at}`, label: `V${at}`, path: `/v${at}` })),
    Array.from({ length: 32 }, (_, at) => ({ id: `v${at}`.padEnd(64, "v"), label: `${at}${"語".repeat(78)}`, path: `/${"p".repeat(255)}`, aliases: ["a", "b", "c", "d"] })),
  ].map(withViews), (document) => refusal(document))
  try Effect.try(() => assert.deepStrictEqual([accepted.launch.views?.map((declared) => declared.id), refused],
    [["notes", "chat"], refused.map(() => "LaunchDocumentRejected")]))
})

it.effect('A malformed frame, version 2 or epoch 0 is a Config refusal whatever the document (spec/agent/host/launch.md, "A refused document is a configuration error, and a cloud or own-key launch without a credential is a credential error")', effect () => {
  const document = JSON.stringify(launchDocument({ backend: cloudBackend }))
  const frames = ["not json", JSON.stringify({ ...launchFrame(keyed), version: 2 }), JSON.stringify({ ...launchFrame(keyed), epoch: 0 }),
    JSON.stringify({ ...launchFrame(keyed), token: "" }), JSON.stringify({ ...launchFrame(), credential: { version: 0, value: "k" } }),
    JSON.stringify({ ...launchFrame(keyed), extra: 1 })]
  const refused = try Effect.forEach(frames, (frame) => Effect.map(Effect.flip(parseLaunch(document, frame)), (failed) => failed._tag))
  try Effect.try(() => assert.deepStrictEqual(refused, frames.map(() => "LaunchFrameRejected")))
})

it.effect('A cloud or own-key launch without a credential is Credential and a no-backend launch needs none (spec/agent/host/launch.md, "A refused document is a configuration error, and a cloud or own-key launch without a credential is a credential error")', effect () => {
  const keyless = JSON.stringify(launchFrame())
  const cloud = try Effect.flip(parseLaunch(JSON.stringify(launchDocument({ backend: cloudBackend })), keyless))
  const ownKey = try Effect.flip(parseLaunch(JSON.stringify(launchDocument({ backend: ownKeyBackend })), keyless))
  const none = try parseLaunch(JSON.stringify(launchDocument()), keyless)
  try Effect.try(() => assert.deepStrictEqual([cloud._tag, ownKey._tag, none.launch.model.backend, account.userId],
    ["LaunchCredentialMissing", "LaunchCredentialMissing", "none", "owner-user"]))
})

it.effect('The exit table maps each boot failure to one code and every other code to a crash (spec/agent/host/launch.md, "Each boot failure has one exit code, and every code outside the table is a crash")', effect () => {
  try Effect.try(() => assert.deepStrictEqual(
    [AGENT_EXIT_CODES.config, AGENT_EXIT_CODES.credential, AGENT_EXIT_CODES.storage, AGENT_EXIT_CODES.agent, exitCode("Config"), exitClass(78), exitClass(137), exitClass(75), exitClass(0), exitClass(1)],
    [78, 77, 74, 70, 78, { tag: "BootFailed", cause: "Config" }, { tag: "Crash" }, { tag: "Crash" }, { tag: "Clean" }, { tag: "ReleaseFailed" }]))
})

it.effect('A refused document exits 78 and a keyless cloud or own-key launch, or an own key longer than its slot, exits 77 before any store opens (spec/agent/host/launch.md, "A refused document is a configuration error, and a cloud or own-key launch without a credential is a credential error")', effect () => {
  const refusedDocument = try boot({ launch: { allowed: [] } })
  const keylessCloud = try boot({ launch: { backend: cloudBackend } })
  const keylessOwn = try boot({ launch: { backend: ownKeyBackend } })
  const oversizedOwn = try boot({ launch: { backend: ownKeyBackend }, frame: { credential: { version: 1, value: "k".repeat(1025) } } })
  const codes = try Effect.forEach([refusedDocument, keylessCloud, keylessOwn, oversizedOwn], (booted) => host("agent exit", () => booted.child.exited).pipe(Effect.map((exited) => exited.code)))
  try Effect.try(() => assert.deepStrictEqual(codes, [78, 77, 77, 77]))
}, 180_000)

it.effect('A bad frame shape exits 78: two lines, no newline, version 2, epoch 0 or over 16 KiB (spec/agent/host/launch.md, "The launch frame is one stdin line with the token, the epoch, and the optional credential and storage key")', effect () => {
  const good = JSON.stringify(launchFrame())
  const frames = [`${good}\n${good}\n`, good, `${JSON.stringify({ ...launchFrame(), version: 2 })}\n`, `${JSON.stringify({ ...launchFrame(), epoch: 0 })}\n`,
    `${JSON.stringify({ ...launchFrame(), storageKey: "k".repeat(17 * 1024) })}\n`]
  const codes = try Effect.forEach(frames, (frame) => Effect.scoped(effect {
    const state = try scratch("launch-frame")
    const launchFile = try host("launch file", () => writeLaunch(state, launchDocument()))
    const child = try agentChild({ launchFile, stateDir: state.path, frame, transport: { kind: "socket", path: state.file("agent.sock") } })
    return (try host("agent exit", () => child.exited)).code
  }))
  try Effect.try(() => assert.deepStrictEqual(codes, frames.map(() => 78)))
}, 600_000)

it.effect('The argv is exactly serve --launch --state and one endpoint (spec/agent/host/launch.md, "The launch frame is one stdin line with the token, the epoch, and the optional credential and storage key")', effect () => {
  const state = try scratch("launch-argv")
  const launchFile = try host("launch file", () => writeLaunch(state, launchDocument()))
  const bad = try agentChild({ launchFile, stateDir: state.path, frame: launchFrame(), transport: { kind: "socket", path: "relative.sock" } })
  const exited = try host("agent exit", () => bad.exited)
  try Effect.try(() => assert.strictEqual(exited.code, 78))
}, 180_000)

it.effect('A launch with a declared view serves health without leaking the token or storage key (spec/agent/views.md, "Views are declared once at boot with distinct ids, paths and names, and never change after"; spec/agent/host/launch.md, "Only the epoch and the credential version of a frame may be shown, never the token, the credential or the storage key")', effect () => {
  const booted = try boot({ launch: { views: [{ id: "notes", label: "Notes", path: "/notes" }] }, frame: { storageKey: "storage-key-material-1", epoch: 7 } })
  const health = try ready(booted)
  const status = try host("status", () => booted.child.health())
  const secrets = [booted.frame.token, "storage-key-material-1"]
  const surfaces = [JSON.stringify(health), JSON.stringify(status), booted.child.output().stdout, booted.child.output().stderr]
  const exited = try host("stop", () => booted.child.stop())
  try Effect.try(() => assert.deepStrictEqual(
    [surfaces.concat([exited.stdout, exited.stderr]).some((text) => secrets.some((secret) => text.includes(secret))), health.status],
    [false, 200]))
}, 180_000)

it.effect('A refused launch does not echo the credential on stdout or stderr (spec/agent/host/launch.md, "Only the epoch and the credential version of a frame may be shown, never the token, the credential or the storage key")', effect () => {
  const booted = try boot({ launch: { allowed: [] }, frame: { credential: { version: 1, value: "credential-leak-probe-1" }, storageKey: "storage-leak-probe-1" } })
  const exited = try host("agent exit", () => booted.child.exited)
  const text = `${exited.stdout}${exited.stderr}`
  try Effect.try(() => assert.deepStrictEqual(
    [exited.code, text.includes("credential-leak-probe-1"), text.includes("storage-leak-probe-1"), text.includes(booted.frame.token)], [78, false, false, false]))
}, 180_000)

module node {
  import { readdir } from "node:fs/promises"

  export function stateEntries(path: string): Promise<string[]> {
    return readdir(path)
  }
}
import { stateEntries } from node

const localEmbeddingsRule = `spec/agent/host/launch.md, "Local embeddings boot only when the device serves them: no operator endpoint or chosen hosted service takes precedence, and the local inference plugin is listed"; spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"`

it.effect(`Local embeddings without the local inference plugin, with an operator endpoint or with chosen hosted embeddings, and a hosted module the bundle does not carry, are Config refusals before any store opens (${localEmbeddingsRule})`, effect () => {
  const state = try scratch("local-embeddings")
  const { startAgent } = try host("agent process", () => import("../src/host/process.vibe"))
  const local = (environment: Record<string, string>, load: readonly string[], backend?: typeof cloudBackend) =>
    mutate({ load, environment, ...(backend === undefined ? {} : { backend }) }, (d) => ({ ...d, embeddings: "local", embeddingDimensions: 384 }))
  const plugin = "@elizaos/plugin-local-inference"
  const documents = [
    local({}, []),
    local({ EMBEDDING_BASE_URL: "https://embed.example" }, [plugin]),
    local({ ELIZAOS_CLOUD_USE_EMBEDDINGS: "true" }, [plugin], cloudBackend),
  ]
  const phases = try Effect.forEach(documents, (document) => effect {
    const parsed = try parseLaunch(JSON.stringify(document), JSON.stringify(launchFrame(keyed)))
    const failed = try Effect.flip(startAgent({ ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: `${state.path}/agent.sock` } }))
    return failed.phase
  })
  const parsed = try parseLaunch(JSON.stringify(launchDocument({})), JSON.stringify(launchFrame({})))
  const unbundled = try Effect.flip(startAgent({
    ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: `${state.path}/agent.sock` },
    hostModules: new Map([[plugin, () => Effect.die("never built")]]),
  }))
  const entries = try host("state listing", () => stateEntries(state.path))
  try Effect.try(() => assert.deepStrictEqual({ phases, unbundled: unbundled.phase, entries }, { phases: ["Config", "Config", "Config"], unbundled: "Config", entries: [] }))
}, 120_000)
