// spec/agent/storage/database.md, "Story: Keep one agent identity for my data across restarts"; spec/agent/storage/database.md, "Story: Keep the agent's records in one store that never loses a committed write"
import { assert, it } from "@effect/vitest"
import { agentChild, boot, call, host, ready, scratch } from "./support/kernel.vibe"
import { launchDocument, launchFrame, writeLaunch, type Scratch } from "./support/scratch.ts"
import { request } from "./support/socket-client.ts"

module node {
  import { link, lstat, readFile, readlink, symlink, writeFile } from "node:fs/promises"
  import { join } from "node:path"

  export type Damage = "corrupted" | "symbolic link" | "second hard link"

  const published = "0b1c2d3e-4f50-4a61-8b72-9c8d7e6f5a4b\n"

  export async function damageIdentity(directory: string, damage: Damage): Promise<void> {
    const file = join(directory, "agent-id")
    const other = join(directory, "elsewhere")
    switch (damage) {
      case "corrupted":
        return writeFile(file, "not an identity\n", { mode: 0o600 })
      case "symbolic link":
        await writeFile(other, published, { mode: 0o600 })
        return symlink(other, file)
      case "second hard link":
        await writeFile(file, published, { mode: 0o600 })
        return link(file, other)
      default: {
        const unhandled: never = damage
        throw new TypeError(`unknown damage ${JSON.stringify(unhandled)}`)
      }
    }
  }

  export async function identityEntry(directory: string) {
    const file = join(directory, "agent-id")
    const status = await lstat(file)
    return {
      target: status.isSymbolicLink() ? await readlink(file) : null,
      links: status.nlink, mode: status.mode & 0o777, text: await readFile(file, "utf8"),
    }
  }
}
import { damageIdentity, identityEntry, type Damage } from node

interface Owner {
  readonly persistMemory: boolean
  readonly account?: { readonly userId: string; readonly organizationId: string }
  readonly embeddingDimensions?: number
}

schema Agent { id: string }
schema Agents { agents: [Agent] }
schema Listing { id: string; updatedAt: number }
schema Created { conversation: Listing }
schema Listed { conversations: Listing[] }
const storageExit = 74

effect function start(state: Scratch, name: string, owner: Owner) {
  const frame = launchFrame()
  const document = try Effect.try(() => ({ ...launchDocument({ persistMemory: owner.persistMemory }), ...owner }))
  const launchFile = try host("launch file", () => writeLaunch(state, document, `${name}.json`))
  const socket = state.file(`${name}.sock`)
  const child = try agentChild({ launchFile, stateDir: state.path, frame, transport: { kind: "socket", path: socket } })
  return { child, socket, token: frame.token }
}

type Started = Effect.Success<ReturnType<typeof start>>

effect function served(agent: Started, path: string, body?: object) {
  try host("readiness", () => agent.child.ready())
  const answer = try host(path, () => request(agent.socket, {
    method: body === undefined ? "GET" : "POST", path, token: agent.token, ...(body === undefined ? {} : { body }),
  }))
  return "json" in answer ? answer : try die(`${path} was refused: ${answer.refused}`)
}

effect function agentId(agent: Started) {
  return (try Schema.decodeUnknownEffect(Agents)((try served(agent, "/api/agents")).json)).agents[0].id
}

effect function exitCode(agent: Started) {
  return (try host("exit", () => agent.child.exited)).code
}

for (const persistMemory of [false, true]) {
  it.effect(`An agent keeps its identity across a restart with persistMemory ${persistMemory} (spec/agent/storage/database.md, "Story: Keep one agent identity for my data across restarts")`, effect () => {
    const state = try scratch("agent-identity")
    const first = try start(state, "first", { persistMemory })
    const created = try agentId(first)
    try host("first stop", () => first.child.stop())
    const published = try host("identity file", () => identityEntry(state.path))
    const reused = try agentId(try start(state, "second", { persistMemory }))
    try Effect.try(() => assert.deepStrictEqual({ published, reused }, {
      published: { target: null, links: 1, mode: 0o600, text: `${created}\n` }, reused: created,
    }))
  }, 180_000)
}

for (const damage of ["corrupted", "symbolic link", "second hard link"] satisfies Damage[]) {
  it.effect(`A ${damage} identity file stops boot and is left in place (spec/agent/storage/database.md, "Story: Keep one agent identity for my data across restarts")`, effect () => {
    const state = try scratch("agent-identity")
    try host("damage", () => damageIdentity(state.path, damage))
    const before = try host("identity before", () => identityEntry(state.path))
    const code = try exitCode(try start(state, "refused", { persistMemory: false }))
    const after = try host("identity after", () => identityEntry(state.path))
    try Effect.try(() => assert.deepStrictEqual({ code, after }, { code: storageExit, after: before }))
  }, 120_000)
}

it.effect('A persisted store opens only for the account and embedding size it was created for (spec/agent/storage/database.md, "Story: Keep one agent identity for my data across restarts")', effect () => {
  const state = try scratch("agent-owner")
  const account = { userId: "owner-user", organizationId: "owner-org" }
  const first = try start(state, "first", { persistMemory: true, account })
  const created = try agentId(first)
  try host("first stop", () => first.child.stop())
  const otherAccount = try exitCode(try start(state, "other-account", { persistMemory: true, account: { ...account, userId: "another-user" } }))
  const otherSize = try exitCode(try start(state, "other-size", { persistMemory: true, account, embeddingDimensions: 384 }))
  const reopened = try agentId(try start(state, "reopened", { persistMemory: true, account }))
  try Effect.try(() => assert.deepStrictEqual({ otherAccount, otherSize, reopened }, {
    otherAccount: storageExit, otherSize: storageExit, reopened: created,
  }))
}, 240_000)

it.effect('A second process is refused while the first holds the store, and a killed holder is replaced (spec/agent/storage/database.md, "Story: Keep the agent\'s records in one store that never loses a committed write")', effect () => {
  const state = try scratch("agent-lock")
  const holder = try start(state, "holder", { persistMemory: true })
  const created = try agentId(holder)
  const refused = try exitCode(try start(state, "second", { persistMemory: true }))
  const stillServed = try agentId(holder)
  try Effect.try(() => holder.child.signal("SIGKILL"))
  const killed = (try host("holder exit", () => holder.child.exited)).signal
  const reclaimed = try agentId(try start(state, "successor", { persistMemory: true }))
  try Effect.try(() => assert.deepStrictEqual({ refused, stillServed, killed, reclaimed }, {
    refused: storageExit, stillServed: created, killed: "SIGKILL", reclaimed: created,
  }))
}, 240_000)

for (const persistMemory of [true, false]) {
  it.live(`A conversation written before a restart is ${persistMemory ? "still listed" : "gone"} with persistMemory ${persistMemory} (spec/agent/storage/database.md, "Story: Keep the agent's records in one store that never loses a committed write")`, effect () => {
    const state = try scratch("agent-records")
    const first = try boot({ state, cloud: true, launch: { persistMemory } })
    try ready(first)
    const created = try call(first, { method: "POST", path: "/api/conversations", body: {} })
    if (!("status" in created) || created.status !== 201) return try die("The conversation was not created")
    const { conversation } = try Schema.decodeUnknownEffect(Created)(created.json)
    try Effect.sleep("20 millis")
    const sent = try call(first, { method: "POST", path: `/api/conversations/${conversation.id}/messages`, body: { text: "Remember the harbour." } })
    if (!("status" in sent) || sent.status !== 200) return try die("The turn was not admitted")
    const listed = try call(first, { method: "GET", path: "/api/conversations" })
    if (!("status" in listed) || listed.status !== 200) return try die("The conversation was not listed")
    const written = try Schema.decodeUnknownEffect(Listed)(listed.json)
    try host("first stop", () => first.child.stop())
    const second = try boot({ state, cloud: true, launch: { persistMemory } })
    try ready(second)
    const recovered = try call(second, { method: "GET", path: "/api/conversations" })
    if (!("status" in recovered) || recovered.status !== 200) return try die("The recovered conversation list was unavailable")
    const kept = try Schema.decodeUnknownEffect(Listed)(recovered.json)
    const messaged = written.conversations.map((listed) => ({ id: listed.id, afterCreation: listed.updatedAt > conversation.updatedAt }))
    try Effect.try(() => assert.deepStrictEqual({ messaged, kept: kept.conversations }, {
      messaged: [{ id: conversation.id, afterCreation: true }], kept: persistMemory ? written.conversations : [],
    }))
  }, 240_000)
}
