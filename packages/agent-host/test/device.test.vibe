// spec/agent/host/launch.md, "Story: Start the agent from one launch document"; spec/agent/access/auth.md, "Story: Admit only the supervising host"; spec/agent/access/transport.md, "Story: Answer each local request exactly once"
import { assert, it } from "@effect/vitest"
import { text } from "./support/cloud-fake.ts"
import { cloudFake, deviceKey, host, scratch } from "./support/kernel.vibe"
import { request, requestStream } from "./support/socket-client.ts"
import { launchOnSocket } from "./support/socket-agent.vibe"

const Conversation = Schema.Struct({ conversation: Schema.Struct({ id: Schema.String, roomId: Schema.String }) })
const History = Schema.Struct({ messages: Schema.Array(Schema.Struct({ id: Schema.String, text: Schema.String })) })
const Enrollment = Schema.Struct({ installationId: Schema.String, enrollmentId: Schema.String })
const DeviceContext = Schema.Struct({
  ...Enrollment.fields, agentId: Schema.String, subjectUserId: Schema.String,
  scope: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/)),
})
const Reply = Schema.Struct({
  type: Schema.String, fullText: Schema.optionalKey(Schema.String), agentName: Schema.optionalKey(Schema.String),
  messageId: Schema.optionalKey(Schema.String), userMessageId: Schema.optionalKey(Schema.String),
})
const response = Schema.decodeUnknownOption(Schema.fromJsonString(Reply))
const replyText = Schema.decodeUnknownOption(Schema.Struct({ text: Schema.String }))

it.effect('An owner starts the agent and receives a complete streamed reply (spec/agent/host/launch.md, "Story: Start the agent from one launch document"; spec/agent/deviceActions/index.md, "Story: Enroll my device and revoke it"; spec/agent/deviceActions/index.md, "An offer goes only to the enrolled device, for a capability it declared")', effect () => {
  const state = try scratch("ez-test")
  const cloud = try cloudFake(deviceKey)
  const name = "Device Stream QA"
  const { socket, frame, running } = try launchOnSocket(state, { name, callerRole: "owner", backend: { kind: "cloud", origin: cloud.origin }, hostContextRevision: 1 }, { credential: { version: 1, value: deviceKey } })
  const token = frame.token
  const started = try host("agent health", () => request(socket, { method: "GET", path: "/api/health" }))
  const stale = try host("stale launch token", () => request(socket, { method: "GET", path: "/api/status", token: "stale" }))
  const publicAuth = try host("anonymous authorization status", () => request(socket, { method: "GET", path: "/api/auth/status" }))
  const noIdentity = try host("anonymous identity refused", () => request(socket, { method: "GET", path: "/api/auth/me" }))
  const owner = try host("authenticated owner identity", () => request(socket, { method: "GET", path: "/api/auth/me", token }))
  const deviceHeaders = { "x-eliza-device-id": running.status.agentId, "x-eliza-device-key": "a".repeat(64) }
  const contextPath = "/api/client-devices/context"
  const unrootedDevice = try host("device credential without the launch token", () => request(socket, { method: "GET", path: contextPath, headers: deviceHeaders }))
  const unregisteredDevice = try host("device context before enrollment", () => request(socket, { method: "GET", path: contextPath, token, headers: deviceHeaders }))
  const registeredDevice = try host("register the device through the running agent", () => request(socket, {
    method: "POST", path: "/api/client-devices/register", token, headers: deviceHeaders,
    body: { capabilities: ["calendar.create.v1"], workflowProtocol: 1 },
  }))
  const contextOfDevice = try host("read enrolled device context", () => request(socket, { method: "GET", path: contextPath, token, headers: deviceHeaders }))
  if (!("json" in registeredDevice) || !("json" in contextOfDevice)) return try die("The device enrollment socket did not answer")
  const enrollment = try Schema.decodeUnknownEffect(Enrollment)(registeredDevice.json)
  const deviceContext = try Schema.decodeUnknownEffect(DeviceContext)(contextOfDevice.json)
  const anotherKey = try host("reject another key", () => request(socket, {
    method: "GET", path: contextPath, token, headers: { ...deviceHeaders, "x-eliza-device-key": "b".repeat(64) },
  }))
  const calendarRoom = try host("open a conversation on the calendar view", () => request(socket, { method: "POST", path: "/api/conversations", token, body: {} }))
  if (!("json" in calendarRoom)) return try die("The calendar conversation was refused")
  const { conversation: calendarView } = try Schema.decodeUnknownEffect(Conversation)(calendarRoom.json)
  try Effect.sync(() => cloud.script(text("I can answer without your agenda.")))
  const undeclaredAgenda = try host("ask for the agenda from a device that never declared it", () => request(socket, {
    method: "POST", path: `/api/conversations/${calendarView.id}/messages`, token,
    headers: { ...deviceHeaders, "x-eliza-device-capabilities": "calendar.agenda-read.v1" },
    body: { text: "Read my agenda for today.", metadata: { clientDevice: {
      calendarAgendaSource: { sourceId: "calendar-1", sourceRevision: "c".repeat(64) },
      context: { view: "calendar", revision: 1, sensitive: false, timeZone: "Etc/UTC", calendarDay: { date: "2026-11-18", timeZone: "Etc/UTC" } },
    } } },
  }))
  const revokedDevice = try host("revoke the device over the socket", () => request(socket, {
    method: "POST", path: "/api/client-devices/revoke", token, headers: deviceHeaders,
  }))
  const revokedContext = try host("refuse context from a revoked device", () => request(socket, { method: "GET", path: contextPath, token, headers: deviceHeaders }))
  try Effect.sync(() => cloud.script(text("Hello", " from the device agent.")))
  const opened = try host("create conversation", () => request(socket, { method: "POST", path: "/api/conversations", token, body: {} }))
  if (!("json" in opened)) return try die("The owner conversation was refused")
  const { conversation } = try Schema.decodeUnknownEffect(Conversation)(opened.json)
  const turn = try host("stream response", () => requestStream(socket, {
    method: "POST", path: `/api/conversations/${conversation.id}/messages/stream`, token, body: { text: "Say hello." },
  }))
  const frames = turn.text.split("\n\n").flatMap((line) =>
    line.startsWith("data: ") ? Option.toArray(response(line.slice(6))) : [])
  const history = try host("read the persisted turn", () => request(socket, {
    method: "GET", path: `/api/conversations/${conversation.id}/messages`, token,
  }))
  if (!("json" in history)) return try die("The owner conversation history was refused")
  const { messages } = try Schema.decodeUnknownEffect(History)(history.json)
  const persistedId = (text: string) => messages.find((message) => message.text === text)?.id
  const inputId = persistedId("Say hello.")
  const replyId = persistedId("Hello from the device agent.")
  if (!inputId || !replyId) return try die("The input and reply were not both stored")
  try host("clean retirement", () => running.stop())
  try Effect.try(() => assert.deepStrictEqual({
    healthy: "status" in started ? started.status : undefined, stale: "status" in stale ? stale.status : undefined, created: opened.status,
    auth: "json" in publicAuth ? publicAuth.json : undefined,
    anonymousIdentity: "status" in noIdentity ? noIdentity.status : undefined,
    owner: "json" in owner ? owner.json : undefined,
    device: {
      statuses: [unrootedDevice, unregisteredDevice, registeredDevice, contextOfDevice, anotherKey, revokedDevice, revokedContext]
        .map((answer) => "status" in answer ? answer.status : undefined),
      bound: [deviceContext.agentId, deviceContext.installationId, deviceContext.enrollmentId],
    },
    undeclaredAgenda: "json" in undeclaredAgenda ? [undeclaredAgenda.status, Option.getOrUndefined(replyText(undeclaredAgenda.json))?.text] : undeclaredAgenda,
    stream: turn.status, terminal: frames.at(-1), containsTokens: frames.some(({type}) => type === "token"),
    fault: turn.error, upstream: cloud.calls.map(({path,authorization}) => ({path,authorization})),
  }, {
    healthy: 200, stale: 401, created: 201, stream: 200,
    auth: { authenticated: false, serverInstanceId: running.status.serverInstanceId }, anonymousIdentity: 401,
    owner: { identity: { kind: "owner", id: running.status.agentId }, access: { role: "OWNER", mode: "local" } },
    device: {
      statuses: [401, 401, 200, 200, 401, 200, 401],
      bound: [running.status.agentId, enrollment.installationId, enrollment.enrollmentId],
    },
    undeclaredAgenda: [200, "I can answer without your agenda."],
    terminal: { type: "done", fullText: "Hello from the device agent.", agentName: name, messageId: replyId, userMessageId: inputId }, containsTokens: true,
    fault: undefined, upstream: Array.from({ length: 2 }, () => ({ path: "/api/v1/chat/completions", authorization: "Bearer " + deviceKey })),
  }))
}, 180_000)

module node {
  import { createRuntimeJsonClient, RuntimeRequestError, type RuntimeJsonBridge } from "@elizaos/agent"

  export async function changeRuntimeAccount() {
    const first = Promise.withResolvers<void>()
    const oldReply = Promise.withResolvers<{ status: number; data: unknown }>()
    const status = { available: true, state: "running", requestBodyLimit: 8192 } as const
    let requests = 0
    let account = "previous"
    const bridge: RuntimeJsonBridge = {
      status: () => Promise.resolve(status),
      start: () => Promise.reject(new Error("An already-running bridge was started")),
      restart: () => { account = "current"; return Promise.resolve(status) },
      request({ path }) {
        requests += 1
        if (account === "previous") {
          first.resolve()
          return oldReply.promise
        }
        return Promise.resolve(path === "/busy" || path === "/busy-unsafe"
          ? { status: 429, data: { error: "Try again", code: "busy", retryAfter: path === "/busy" ? 5 : Number.MAX_SAFE_INTEGER + 1 } }
          : { status: 200, data: { account } })
      },
    }
    const client = createRuntimeJsonClient({ bridge: () => bridge, startupTimeoutMs: 1000, pollMs: 5, requestTimeoutMs: 1000 })
    const previous = client.request("/account").then(
      (result) => result,
      (error: unknown) => error instanceof Error ? error.message : "unknown",
    )
    await first.promise
    const changed = client.refreshNativeAccount()
    const current = client.request("/account")
    await changed
    oldReply.resolve({ status: 200, data: { account: "previous" } })
    const refused = (path: string) => client.request(path).catch((error: unknown) => error instanceof RuntimeRequestError
      ? { status: error.status, code: error.code, retryAfter: error.retryAfter } : error)
    const busy = await refused("/busy")
    const unsafeRetry = await refused("/busy-unsafe")
    return { previous: await previous, current: await current, busy, unsafeRetry, requests, limit: client.requestBodyLimit }
  }

  export async function supersedeRestart() {
    const entered = Promise.withResolvers<void>()
    const release = Promise.withResolvers<void>()
    const running = { available: true, state: "running" } as const
    let account = "original"
    const order: string[] = []
    let selected = "older"
    const client = createRuntimeJsonClient({
      startupTimeoutMs: 1000, pollMs: 5, requestTimeoutMs: 1000,
      bridge: () => {
        const target = selected
        return {
          status: () => Promise.resolve(running),
          start: () => Promise.reject(new Error("already running")),
          async restart() {
            order.push(target + ":start")
            if (target === "older") { entered.resolve(); await release.promise }
            account = target
            order.push(target + ":done")
            return running
          },
          request: () => Promise.resolve({ status: 200, data: account }),
        }
      },
    })
    const older = client.refreshNativeAccount().catch((error: unknown) => error instanceof Error ? error.message : "unknown")
    await entered.promise
    selected = "newer"
    const newer = client.refreshNativeAccount()
    const current = client.request("/account")
    const result = await older
    release.resolve()
    await newer
    return { older: result, current: await current, order }
  }
}

import { changeRuntimeAccount, supersedeRestart } from node

it.effect('A pending request cannot publish the previous account and the current account receives its refusal (spec/agent/client/runtimeClient.md, "Story: Call the runtime for my current account")', effect () => {
  const observed = try tryPromise(() => changeRuntimeAccount())
  try Effect.try(() => assert.deepStrictEqual(observed, {
    previous: "AccountChanged", current: { account: "current" },
    busy: { status: 429, code: "busy", retryAfter: 5 },
    unsafeRetry: { status: 429, code: "busy", retryAfter: undefined }, requests: 4, limit: 8192,
  }))
})

it.effect('A newer account becomes current after the in-flight native restart (spec/agent/client/runtimeClient.md, "Story: Call the runtime for my current account")', effect () => {
  const observed = try tryPromise(() => supersedeRestart())
  try Effect.try(() => assert.deepStrictEqual(observed, {
    older: "AccountChanged", current: "newer",
    order: ["older:start", "older:done", "newer:start", "newer:done"],
  }))
})
