// spec/agent/client/runtimeClient.md, "Story: Reach a runtime that is not running yet"; spec/agent/client/runtimeClient.md, "Story: Call the runtime for my current account"; spec/agent/client/runtimeClient.md, "Story: Understand why the runtime refused"; spec/agent/client/runtimeClient.md, "A stream is sent at most once and only in its generation"
import { assert, it } from "@effect/vitest"
import { host, startInProcess } from "./support/kernel.vibe"

module node {
  import { createServer, type ServerResponse } from "node:http"
  import { createRuntimeJsonClient, RuntimeRequestError, type RuntimeJsonBridge, type RuntimeStatus, type RuntimeStream, type RuntimeStreamFrame } from "@elizaos/agent"

  const failure = (error: unknown) => error instanceof RuntimeRequestError
    ? { status: error.status, message: error.message, code: error.code }
    : error instanceof Error ? error.message : "unknown"

  export async function sharedStartupThenRefresh() {
    let phase: RuntimeStatus["state"] = "stopped"
    let pollsUntilRunning = 0
    let account = 1
    const calls: string[] = []
    const bridge: RuntimeJsonBridge = {
      status() {
        calls.push("status")
        if (phase === "starting" && pollsUntilRunning-- <= 0) phase = "running"
        return Promise.resolve({ available: true, state: phase, requestBodyLimit: 4096 })
      },
      start() {
        calls.push("start")
        phase = "starting"
        pollsUntilRunning = 2
        return Promise.resolve({ available: true, state: phase })
      },
      restart() {
        calls.push("restart")
        account += 1
        phase = "starting"
        pollsUntilRunning = 2
        return Promise.resolve({ available: true, state: phase })
      },
      request({ path, method, headers }) {
        calls.push(`${method} ${path}`)
        if (phase !== "running") return Promise.reject(new Error("RUNTIME_NOT_READY"))
        return Promise.resolve({ status: 200, data: { path, account, ...(headers === undefined ? {} : { headers }) } })
      },
    }
    const client = createRuntimeJsonClient({ bridge: () => bridge, startupTimeoutMs: 5000, pollMs: 5, requestTimeoutMs: 5000 })
    const first = await Promise.all([client.request("/a"), client.request("/b", { note: "posted" }, { "X-Eliza-Device-Capabilities": "notes.query.v1", "X-Eliza-Device-Key": "0f".repeat(32) })])
    const refreshed = client.refreshNativeAccount()
    const afterRefresh = client.request("/c")
    await refreshed
    return {
      first, afterRefresh: await afterRefresh, limit: client.requestBodyLimit,
      starts: calls.filter((call) => call === "start").length,
      lifecycle: calls.filter((call) => call !== "status"),
    }
  }

  export async function failedStartupThenRetry() {
    let phase: RuntimeStatus["state"] = "stopped"
    let starts = 0
    const client = createRuntimeJsonClient({
      startupTimeoutMs: 1000, pollMs: 5, requestTimeoutMs: 1000,
      bridge: () => ({
        status: () => Promise.resolve({ available: true, state: phase }),
        start() {
          starts += 1
          if (starts > 1) phase = "running"
          return Promise.resolve({ available: true, state: phase })
        },
        restart: () => Promise.reject(new Error("not called")),
        request: ({ path }) => Promise.resolve({ status: 200, data: { path } }),
      }),
    })
    const failed = await Promise.all([client.request("/a"), client.request("/b")].map((call) => call.then(() => "answered", failure)))
    const retried = await client.request("/c").then((data) => data, failure)
    return { failed, retried, starts }
  }

  export async function noRoute() {
    let asked = 0
    const client = createRuntimeJsonClient({ bridge: () => { asked += 1; return undefined }, startupTimeoutMs: 1000, pollMs: 5, requestTimeoutMs: 1000 })
    const missing = await client.request("/api/health").then(() => "answered", failure)
    const unrooted = await client.request("//elsewhere.example/api").then(() => "answered", failure)
    const refusedHeaders: readonly Readonly<Record<string, string>>[] = [
      { "x-eliza-device-key": "a".repeat(63) }, { "x-eliza-device-key": "A".repeat(64) }, { "x-eliza-device-token": "a".repeat(64) },
      { Authorization: "Bearer t" }, { "x-eliza-device-id": "a\nb" },
      { "x-eliza-device-id": "a", "X-Eliza-Device-Id": "b" }, { "x-eliza-device-capabilities": "n".repeat(8192) },
    ]
    const withheld = await Promise.all(refusedHeaders.map((headers) => client.request("/api/health", undefined, headers).then(() => "answered", failure)))
    const unstreamed = await client.stream("/api/turn", {}, undefined, { connection: "close" }).then(() => "opened", failure)
    await client.refreshNativeAccount()
    return { missing, unrooted, withheld, unstreamed, asked }
  }

  const bytes = (text: string) => new TextEncoder().encode(text)

  async function readAll(stream: RuntimeStream) {
    const decoder = new TextDecoder()
    let text = ""
    for await (const chunk of stream.body) text += decoder.decode(chunk, { stream: true })
    return text + decoder.decode()
  }

  async function firstThen(stream: RuntimeStream, between: () => Promise<unknown> | void) {
    const reader = stream.body[Symbol.asyncIterator]()
    const first = await reader.next()
    await between()
    const rest = await reader.next().then(() => "more", failure)
    return { first: first.done ? "" : new TextDecoder().decode(first.value), rest }
  }

  function held(signal: AbortSignal, aborts: string[], name: string) {
    return new Promise<void>((resolve) => signal.addEventListener("abort", () => { aborts.push(name); resolve() }, { once: true }))
  }

  export async function streamedOverBridge() {
    let phase: RuntimeStatus["state"] = "stopped"
    const calls: string[] = []
    const aborts: string[] = []
    const bridge: RuntimeJsonBridge = {
      status: () => Promise.resolve({ available: true, state: phase }),
      start() {
        calls.push("start")
        phase = "starting"
        setTimeout(() => { phase = "running" }, 20)
        return Promise.resolve({ available: true, state: phase })
      },
      restart() {
        calls.push("restart")
        return Promise.resolve({ available: true, state: "running" })
      },
      request({ path, method }) {
        calls.push(`${method} ${path}`)
        return Promise.resolve({ status: 200, data: { path } })
      },
      async *requestStream({ path, method, body }, signal): AsyncIterable<RuntimeStreamFrame> {
        calls.push(`${method} ${path} stream`)
        if (phase !== "running") throw new Error("RUNTIME_NOT_READY")
        if (path === "/busy") {
          yield { kind: "head", status: 429, headers: { "content-type": "application/json" } }
          yield { kind: "chunk", data: bytes('{"error":"busy","code":"RUNTIME_BUSY",') }
          yield { kind: "chunk", data: bytes('"retryAfter":30}') }
          yield { kind: "end" }
          return
        }
        const ended = path === "/held" ? held(signal, aborts, path) : undefined
        yield { kind: "head", status: 200, headers: { "content-type": "application/x-ndjson" } }
        yield { kind: "chunk", data: bytes(`said ${(body as { text: string }).text}`) }
        if (ended) {
          await ended
          yield { kind: "aborted" }
          return
        }
        yield { kind: "chunk", data: bytes(" in full") }
        yield { kind: "end" }
      },
    }
    const client = createRuntimeJsonClient({ bridge: () => bridge, startupTimeoutMs: 5000, pollMs: 5, requestTimeoutMs: 5000 })
    const [plain, opened] = await Promise.all([client.request("/a"), client.stream("/turn", { text: "hello" })])
    const whole = { status: opened.status, headers: opened.headers, text: await readAll(opened) }
    const refused = await client.stream("/busy", { text: "again" }).then(() => "opened", (error: unknown) =>
      error instanceof RuntimeRequestError ? { status: error.status, message: error.message, code: error.code, retryAfter: error.retryAfter } : failure(error))
    const stopping = new AbortController()
    const cancelled = await firstThen(await client.stream("/held", { text: "stop" }, stopping.signal), () => stopping.abort(new Error("Cancelled")))
    const refreshed = await firstThen(await client.stream("/held", { text: "switch" }), () => client.refreshNativeAccount())
    const after = await readAll(await client.stream("/turn", { text: "next" }))
    return { plain, whole, refused, cancelled, refreshed, after, aborts, calls }
  }

  export async function streamedOverHttp() {
    const aborts: string[] = []
    const open = new Set<ServerResponse>()
    const server = createServer((request, response) => {
      open.add(response)
      request.on("close", () => { if (!response.writableEnded) aborts.push(request.url ?? "") })
      response.writeHead(200, { "content-type": "application/x-ndjson", "x-run": "r1" })
      response.write(`{"seq":1,"credentials":${request.headers.cookie === undefined && request.headers.authorization === undefined ? "none" : "sent"},"device":${JSON.stringify(request.headers["x-eliza-device-capabilities"] ?? null)}}\n`)
      if (request.url === "/whole") response.end('{"seq":2}\n')
    })
    await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve))
    const address = server.address()
    const port = typeof address === "object" && address ? address.port : 0
    try {
      const client = createRuntimeJsonClient({ httpBase: new URL(`http://127.0.0.1:${port}`), startupTimeoutMs: 1000, pollMs: 5, requestTimeoutMs: 1000 })
      const whole = await client.stream("/whole", { text: "hi" }, undefined, { "x-eliza-device-capabilities": "notes.query.v1" })
      const read = { status: whole.status, run: whole.headers["x-run"], text: await readAll(whole) }
      const refreshed = await firstThen(await client.stream("/held", { text: "hi" }), () => client.refreshNativeAccount())
      for (let tries = 0; tries < 50 && aborts.length === 0; tries += 1) await new Promise((resolve) => setTimeout(resolve, 10))
      return { read, refreshed, aborts }
    } finally {
      for (const response of open) response.destroy()
      await new Promise<void>((resolve) => server.close(() => resolve()))
    }
  }

  export async function streamRefusedByAgent(port: number) {
    const client = createRuntimeJsonClient({ httpBase: new URL(`http://127.0.0.1:${port}`), startupTimeoutMs: 5000, pollMs: 5, requestTimeoutMs: 5000 })
    return client.stream("/api/conversations/c1/messages/stream", { text: "hello" }).then(() => "opened", failure)
  }

  export async function overLoopback(port: number) {
    const client = createRuntimeJsonClient({ httpBase: new URL(`http://127.0.0.1:${port}`), startupTimeoutMs: 5000, pollMs: 5, requestTimeoutMs: 5000 })
    const health = await client.request("/api/health")
    const refused = await client.request("/api/status").then(() => "answered", failure)
    return { health, refused }
  }
}

import { failedStartupThenRetry, noRoute, overLoopback, sharedStartupThenRefresh, streamedOverBridge, streamedOverHttp, streamRefusedByAgent } from node

it.live('Requests to a stopped runtime share one startup, carry their device headers over the bridge, and a refresh restarts it before the next request (spec/agent/client/runtimeClient.md, "Story: Reach a runtime that is not running yet"; spec/agent/client/runtimeClient.md, "Story: Call the runtime for my current account"; spec/agent/client/runtimeClient.md, "A request carries only device headers and the client id, a bounded few")', effect () => {
  const observed = try host("shared startup", () => sharedStartupThenRefresh())
  try Effect.try(() => assert.deepStrictEqual(observed, {
    first: [{ path: "/a", account: 1 }, { path: "/b", account: 1, headers: { "x-eliza-device-capabilities": "notes.query.v1", "x-eliza-device-key": "0f".repeat(32) } }],
    afterRefresh: { path: "/c", account: 2 },
    limit: 4096,
    starts: 1,
    lifecycle: ["start", "GET /a", "POST /b", "restart", "GET /c"],
  }))
})

it.live('A startup that never reports running fails every request waiting for it, and the next request starts the runtime again (spec/agent/client/runtimeClient.md, "Story: Reach a runtime that is not running yet")', effect () => {
  const observed = try host("failed startup", () => failedStartupThenRetry())
  try Effect.try(() => assert.deepStrictEqual(observed, { failed: ["StartupFailed", "StartupFailed"], retried: { path: "/c" }, starts: 2 }))
})

it.live('With no bridge and no HTTP base a request fails as NoRoute, and an unrooted path or an uncarried header is refused before anything is called (spec/agent/client/runtimeClient.md, "Story: Call the runtime for my current account"; spec/agent/client/runtimeClient.md, "A request carries only device headers and the client id, a bounded few")', effect () => {
  const observed = try host("no route", () => noRoute())
  try Effect.try(() => assert.deepStrictEqual(observed, {
    missing: "NoRoute", unrooted: "InvalidPath",
    withheld: Array.from({ length: 7 }, () => "InvalidHeaders"), unstreamed: "InvalidHeaders", asked: 2,
  }))
})

it.live('A page with no bridge reaches a real agent over loopback HTTP and reads its refusal (spec/agent/client/runtimeClient.md, "Story: Understand why the runtime refused"; spec/agent/client/runtimeClient.md, "Story: Call the runtime for my current account")', effect () => {
  const booted = try startInProcess({ http: true })
  const port = booted.transport.kind === "http" ? booted.transport.port : 0
  const observed = try host("loopback client", () => overLoopback(port))
  try Effect.try(() => assert.deepStrictEqual(observed, {
    health: { ready: true, runtime: "ok", agentState: "running", epoch: booted.frame.epoch },
    refused: { status: 401, message: "unauthorized", code: undefined },
  }))
}, 180_000)

it.live('A stream waits for the shared startup, is sent once over the bridge, and a refresh or Stop ends its body (spec/agent/client/runtimeClient.md, "A stream is sent at most once and only in its generation"; spec/agent/client/runtimeClient.md, "Story: Understand why the runtime refused")', effect () => {
  const observed = try host("bridge stream", () => streamedOverBridge())
  try Effect.try(() => assert.deepStrictEqual(observed, {
    plain: { path: "/a" },
    whole: { status: 200, headers: { "content-type": "application/x-ndjson" }, text: "said hello in full" },
    refused: { status: 429, message: "busy", code: "RUNTIME_BUSY", retryAfter: 30 },
    cancelled: { first: "said stop", rest: "Cancelled" },
    refreshed: { first: "said switch", rest: "AccountChanged" },
    after: "said next in full",
    aborts: ["/held", "/held"],
    calls: ["start", "GET /a", "POST /turn stream", "POST /busy stream", "POST /held stream", "POST /held stream", "restart", "POST /turn stream"],
  }))
})

it.live('A page streams over HTTP with its device headers and without credentials, and a refresh aborts the HTTP body (spec/agent/client/runtimeClient.md, "A stream is sent at most once and only in its generation"; spec/agent/client/runtimeClient.md, "A request carries only device headers and the client id, a bounded few")', effect () => {
  const observed = try host("http stream", () => streamedOverHttp())
  try Effect.try(() => assert.deepStrictEqual(observed, {
    read: { status: 200, run: "r1", text: '{"seq":1,"credentials":none,"device":"notes.query.v1"}\n{"seq":2}\n' },
    refreshed: { first: '{"seq":1,"credentials":none,"device":null}\n', rest: "AccountChanged" },
    aborts: ["/held"],
  }))
})

it.live('A real agent refuses an unauthenticated stream with its head, as a RuntimeRequestError (spec/agent/client/runtimeClient.md, "Story: Understand why the runtime refused")', effect () => {
  const booted = try startInProcess({ http: true })
  const port = booted.transport.kind === "http" ? booted.transport.port : 0
  const observed = try host("loopback stream", () => streamRefusedByAgent(port))
  try Effect.try(() => assert.deepStrictEqual(observed, { status: 401, message: "unauthorized", code: undefined }))
}, 180_000)
