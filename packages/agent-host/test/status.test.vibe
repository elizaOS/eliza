// spec/agent/host/process.md, "Status says running only when health says ready, and the agent can respond only with a text backend and an unblocked account"; spec/agent/access/auth.md, "A Root-only route admits only a caller holding the launch token"
import { assert, it } from "@effect/vitest"
import { messageBodyLimitBytes } from "../gen/agent__access__transport.ts"
import { statusRoutes, type BindingState } from "../src/host/status.vibe"
import { cloudFake, deviceKey, host, scratch } from "./support/kernel.vibe"
import type { LaunchOptions } from "./support/scratch.ts"
import { request, type LocalAnswer, type Refusal } from "./support/socket-client.ts"
import { launchOnSocket } from "./support/socket-agent.vibe"

const answered = (answer: LocalAnswer | Refusal) => "status" in answer ? [answer.status, answer.json] : answer

effect function started(options: LaunchOptions, credential: boolean) {
  const state = try scratch("ez-status")
  const { socket, frame, running } = try launchOnSocket(state, options, credential ? { credential: { version: 1, value: deviceKey } } : {})
  const ask = (path: string, token?: string) => host(path, () => request(socket, { method: "GET", path, ...(token === undefined ? {} : { token }) }))
  return { running, ask, token: frame.token }
}

it.effect('A running cloud agent reports it can respond, lists itself and shares its start id with auth status (spec/agent/host/process.md, "Status says running only when health says ready, and the agent can respond only with a text backend and an unblocked account")', effect () => {
  const cloud = try cloudFake(deviceKey)
  const { running, ask, token } = try started({ name: "Ada", backend: { kind: "cloud", origin: cloud.origin } }, true)
  const anonymous = try Effect.forEach(["/api/status", "/api/agents"], (path) => ask(path))
  const stale = try Effect.forEach(["/api/status", "/api/agents"], (path) => ask(path, "earlier-launch-token"))
  const status = try ask("/api/status", token)
  const agents = try ask("/api/agents", token)
  const auth = try ask("/api/auth/status", token)
  const serverInstanceId = running.status.serverInstanceId
  try Effect.try(() => assert.deepStrictEqual({
    refused: [...anonymous, ...stale].map(answered), status: answered(status), agents: answered(agents), auth: answered(auth),
  }, {
    refused: [0, 1, 2, 3].map(() => [401, { error: "unauthorized" }]),
    status: [200, { state: "running", canRespond: true, blocked: false, serverInstanceId, backend: "cloud", embeddings: "none", requestBodyLimit: messageBodyLimitBytes }],
    agents: [200, { agents: [{ id: running.status.agentId, name: "Ada", status: "running" }] }],
    auth: [200, { authenticated: true, serverInstanceId }],
  }))
  try Effect.try(() => assert.strictEqual(cloud.calls.length, 0))
}, 180_000)

it.effect('An agent with no text backend runs but cannot respond (spec/agent/host/process.md, "Status says running only when health says ready, and the agent can respond only with a text backend and an unblocked account")', effect () => {
  const { ask, token } = try started({}, false)
  const status = try ask("/api/status", token)
  try Effect.try(() => assert.deepInclude("json" in status ? status.json as object : {}, { state: "running", canRespond: false, blocked: false, backend: "none" }))
})

it('A blocked account cannot respond and status reports the last cloud failure without text (spec/agent/models/binding.md, "Each refusal is one account state, and the last failure records its kind and time without text")', async () => {
  const backend = { tag: "CloudBackend", baseUrl: "https://cloud.example", baseUrlShape: "HttpsOrigin", smallModel: "s", largeModel: "l", imageModel: "s" } as const
  const view = (binding: BindingState, now: number) => statusRoutes({
    agentId: "a", name: "Ada", serverInstanceId: "i", backend, embeddings: "none", state: () => "running", binding: () => binding, now: () => now,
  })[0]
  const limited = { tag: "LimitReached", retryAt: 50 } as const
  const binding: BindingState = { accountState: { tag: "Failing", failure: limited }, lastCloudFailure: { tag: "CloudFailedAt", failure: limited, at: 40 } }
  const read = async (now: number) => {
    const answer = await view(binding, now).handler({ parameters: new Map(), query: new Map(), headers: new Map(), body: undefined, signal: new AbortController().signal })
    const { canRespond, blocked, lastCloudFailure } = (answer as { body: Record<string, unknown> }).body
    return { canRespond, blocked, lastCloudFailure }
  }
  assert.deepStrictEqual([await read(45), await read(50)], [
    { canRespond: false, blocked: true, lastCloudFailure: { kind: "limit_reached", at: 40, retryAt: 50 } },
    { canRespond: true, blocked: false, lastCloudFailure: { kind: "limit_reached", at: 40, retryAt: 50 } },
  ])
})
