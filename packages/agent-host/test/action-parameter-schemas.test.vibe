// spec/agent/conversation/planning.md, "Every offered action's parameters name the fields the action reads"
import { assert, it } from "@effect/vitest"
import type { Action } from "@elizaos/core"
import { builtinModuleFactories } from "../src/plugins/profile.vibe"
import { cloudFake, deviceKey, startInProcess } from "./support/kernel.vibe"

module node {
  import { readdirSync, readFileSync, statSync } from "node:fs"
  import { join } from "node:path"
  import { pathToFileURL } from "node:url"
  import { actionToJsonSchema, validateToolArgs, type Action } from "@elizaos/core"

  const packages = join(process.cwd(), "..")

  type Schema = { type?: string | string[]; properties?: Record<string, Schema>; additionalProperties?: boolean | Schema; items?: Schema; enum?: unknown[]; anyOf?: Schema[]; oneOf?: Schema[]; required?: string[]; minimum?: number; minLength?: number; minItems?: number; default?: unknown; examples?: unknown[]; const?: unknown }

  export interface Audit { readonly actions: number; readonly names: string[]; readonly unloaded: string[]; readonly bare: string[]; readonly refused: string[] }

  /** @throws {never} */
  function sources(directory: string): string[] {
    return readdirSync(directory).flatMap((entry) => {
      const path = join(directory, entry)
      return statSync(path).isDirectory() ? sources(path) : path.endsWith(".vibe") ? [path] : []
    })
  }

  /** @throws {never} */
  function declaringFiles(): string[] {
    return readdirSync(packages).flatMap((name) => {
      const src = join(packages, name, "src")
      try {
        return name !== "core" && statSync(src).isDirectory() ? sources(src) : []
      } catch {
        return []
      }
    }).filter((path) => /parameters:\s*\[/u.test(readFileSync(path, "utf8")))
  }

  /** @throws {never} */
  function candidateFiles(): string[] {
    const declaring = declaringFiles()
    const entries = [...new Set(declaring.map((path) => join(packages, path.slice(packages.length + 1).split("/")[0] ?? "", "src", "index.vibe")))]
      .filter((path) => {
        try {
          return statSync(path).isFile()
        } catch {
          return false
        }
      })
    return [...new Set([...declaring, ...entries])]
  }

  /** @throws {never} */
  function built(name: string, value: unknown): Action[] {
    if (typeof value !== "function" || !/Plugin$/u.test(name) || /^create/u.test(name)) return []
    try {
      const stub = new Proxy({}, { get: () => undefined })
      return actionsIn((value as (...args: unknown[]) => unknown)(stub, "owner"))
    } catch {
      return []
    }
  }

  /** @throws {never} */
  function isAction(value: unknown): value is Action {
    return typeof value === "object" && value !== null && typeof (value as { name?: unknown }).name === "string" && typeof (value as { handler?: unknown }).handler === "function"
  }

  /** @throws {never} */
  function actionsIn(value: unknown, depth = 0): Action[] {
    if (isAction(value)) return [value]
    if (depth > 1 || typeof value !== "object" || value === null) return []
    if (Array.isArray(value)) return value.flatMap((entry) => actionsIn(entry, depth + 1))
    const actions = (value as { actions?: unknown }).actions
    return Array.isArray(actions) ? actions.flatMap((entry) => actionsIn(entry, depth + 1)) : []
  }

  /** @throws {never} */
  function bareObjects(schema: Schema, path: string): string[] {
    const kinds = Array.isArray(schema.type) ? schema.type : [schema.type]
    const nested = [...Object.entries(schema.properties ?? {}).flatMap(([key, child]) => bareObjects(child, `${path}.${key}`)),
      ...(schema.items === undefined ? [] : bareObjects(schema.items, `${path}[]`)),
      ...(typeof schema.additionalProperties === "object" ? bareObjects(schema.additionalProperties, `${path}.*`) : []),
      ...[...(schema.anyOf ?? []), ...(schema.oneOf ?? [])].flatMap((child) => bareObjects(child, path))]
    const bare = kinds.includes("object") && Object.keys(schema.properties ?? {}).length === 0 && schema.additionalProperties !== true
      && typeof schema.additionalProperties !== "object" && schema.anyOf === undefined && schema.oneOf === undefined
    return bare ? [path, ...nested] : nested
  }

  /** @throws {never} */
  function example(schema: Schema): unknown {
    if (schema.const !== undefined) return schema.const
    if (schema.default !== undefined) return schema.default
    if (schema.examples !== undefined && schema.examples.length > 0) return schema.examples[0]
    if (schema.enum !== undefined && schema.enum.length > 0) return schema.enum[0]
    const choice = schema.anyOf?.[0] ?? schema.oneOf?.[0]
    if (choice !== undefined) return example(choice)
    const kind = Array.isArray(schema.type) ? schema.type.find((entry) => entry !== "null") : schema.type
    if (kind === "string") return "x".repeat(Math.max(1, schema.minLength ?? 1))
    if (kind === "number" || kind === "integer") return schema.minimum ?? 1
    if (kind === "boolean") return true
    if (kind === "array") return Array.from({ length: Math.max(1, schema.minItems ?? 1) }, () => example(schema.items ?? { type: "string" }))
    if (kind === "object") {
      const properties = Object.entries(schema.properties ?? {})
      const chosen = properties.filter(([key]) => (schema.required ?? []).includes(key))
      return Object.fromEntries((chosen.length > 0 ? chosen : properties).map(([key, child]) => [key, example(child)]))
    }
    return "x"
  }

  /** @throws {never} */
  export async function audit(registered: readonly Action[]): Promise<Audit> {
    const found = new Map<string, [string, Action]>()
    const unloaded: string[] = []
    for (const path of candidateFiles()) {
      const where = path.slice(packages.length + 1)
      try {
        const loaded = await import(pathToFileURL(path).href) as Record<string, unknown>
        for (const [name, value] of Object.entries(loaded)) for (const action of [...actionsIn(value), ...built(name, value)]) found.set(action.name, [where, action])
      } catch (cause) {
        unloaded.push(`${where}: ${String(cause).slice(0, 220)}`)
      }
    }
    for (const action of registered) if (!found.has(action.name)) found.set(action.name, ["registered", action])
    const bare: string[] = []
    const refused: string[] = []
    for (const [name, [where, action]] of found) {
      try {
        const schema = actionToJsonSchema(action) as Schema
        const declared = Array.isArray(action.parameters) ? action.parameters.length > 0 : action.parameters !== undefined
        bare.push(...bareObjects(schema, name).filter((path) => declared || path !== name).map((path) => `${where} ${path}`))
        for (const error of validateToolArgs(action, example(schema)).errors) if (/Unexpected argument '[^']*\./u.test(error)) refused.push(`${where} ${name}: ${error}`)
      } catch (cause) {
        refused.push(`${where} ${name}: ${String(cause)}`)
      }
    }
    return { actions: found.size, names: [...found].map(([name, [where]]) => `${where} ${name}`).sort(), unloaded, bare, refused }
  }
}
import { audit } from node

it.live(`Every action's parameters name their fields, so the runtime's argument check never refuses the keys an action reads (spec/agent/conversation/planning.md, "Every offered action's parameters name the fields the action reads")`, effect () => {
  const cloud = try cloudFake(deviceKey)
  const agent = try startInProcess({
    launch: { backend: { kind: "cloud", origin: cloud.origin }, callerRole: "owner", load: [...builtinModuleFactories.keys()] },
    frame: { credential: { version: 1, value: deviceKey } }, modules: builtinModuleFactories,
  })
  const registered: readonly Action[] = agent.agent.runtime.actions
  const found = try Effect.promise(() => audit(registered))
  try Effect.try(() => assert.deepStrictEqual({ enough: found.actions >= 40, unloaded: found.unloaded, bare: found.bare, refused: found.refused }, { enough: true, unloaded: [], bare: [], refused: [] }))
}, 300_000)
