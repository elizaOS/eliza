// spec/agent/conversation/conversations.md, "Story: Create and find my conversations"; spec/agent/conversation/conversations.md, "Story: Read history a page at a time"
import { assert, it } from "@effect/vitest"
import type { Memory, UUID } from "@elizaos/core"
import { privateNotice } from "../gen/agent__conversation__conversations.ts"
import { ask, host, startInProcess, type InProcess } from "./support/kernel.vibe"

interface History { readonly messages: readonly Message[]; readonly hasMore?: boolean }
interface Hit { readonly messageId: string; readonly conversationId: string; readonly text: string }

module node {
  import { randomUUID } from "node:crypto"
  import type { AgentRuntime, UUID } from "@elizaos/core"
  import { conversationStore } from "../src/conversation/conversations.vibe"

  export const freshId = () => randomUUID() as UUID
  export const unknownIds = { message: freshId(), conversation: freshId() }

  export async function pendingBeside(runtime: AgentRuntime, roomId: UUID, title: string) {
    const [room] = await runtime.adapter.getRoomsByIds([roomId])
    if (!room?.worldId) throw new Error("The published conversation has no world")
    const owner = { user: freshId(), world: room.worldId }
    return conversationStore(runtime, owner).createPending(title)
  }
}
import { freshId, pendingBeside, unknownIds } from node
import type { Conversation, Message } from "./support/streaming.vibe"

effect function open(agent: InProcess, body: object) {
  const answer = try ask(agent, { method: "POST", path: "/api/conversations", body })
  return { status: answer.status, conversation: (answer.body as { conversation: Conversation }).conversation }
}

effect function history(agent: InProcess, id: string, query: string) {
  const answer = try ask(agent, { method: "GET", path: `/api/conversations/${id}/messages${query}` })
  return { status: answer.status, page: answer.body as History }
}

effect function search(agent: InProcess, query: string) {
  const answer = try ask(agent, { method: "GET", path: `/api/conversations/messages/search?${query}` })
  return { status: answer.status, hits: (answer.body as { results?: readonly Hit[] }).results ?? [] }
}

effect function seed(agent: InProcess, roomId: UUID, rows: readonly { readonly text: string; readonly at: number }[]) {
  const runtime = agent.agent.runtime
  return try host("seed messages", async () => {
    const memories = rows.map(({ text, at }, index): Memory => ({
      id: freshId(), roomId, agentId: runtime.agentId, createdAt: at,
      entityId: index % 2 === 0 ? freshId() : runtime.agentId, content: { text, source: "device" },
    }))
    await runtime.adapter.createMemories(memories.map((memory) => ({ memory, tableName: "messages" })))
    return memories
  })
}

const inOrder = (memories: readonly Memory[]) => memories.map((memory) => ({ id: String(memory.id), at: memory.createdAt ?? 0 }))
  .sort((a, b) => a.at - b.at || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0)).map(({ id }) => id)
const ids = (page: History) => page.messages.map((message) => message.id)

effect function pageBack(agent: InProcess, id: string, first: History) {
  const held = [...ids(first)]
  let page = first
  let pages = 0
  while (page.hasMore === true) {
    const oldest = page.messages[0]
    const older = try history(agent, id, `?before=${oldest.timestamp}&beforeId=${oldest.id}&limit=50`)
    page = older.page
    held.unshift(...ids(page))
    pages += 1
  }
  return { held, pages }
}

it.effect('Create, list, page history to the start, jump to a message and search in pages (spec/agent/conversation/conversations.md, "Creating a conversation gives it a fresh id and room, and a default title when blank"; spec/agent/conversation/conversations.md, "Messages and model-call log rows arrive only in a published conversation"; spec/agent/conversation/conversations.md, "The list shows only published conversations, most recently updated first"; spec/agent/conversation/conversations.md, "The first page is the newest 200 messages"; spec/agent/conversation/conversations.md, "An older page holds only messages before its cursor, and hasMore says whether any are left"; spec/agent/conversation/conversations.md, "A jump to a message answers it with up to 100 messages on each side, and an unknown one is 404"; spec/agent/conversation/conversations.md, "A search page is a slice of the complete set of visible matches")', effect () => {
  const agent = try startInProcess()
  const plans = try open(agent, { title: "  Plans  " })
  const blank = try open(agent, {})
  const tooLong = try ask(agent, { method: "POST", path: "/api/conversations", body: { title: "x".repeat(201) } })
  const listed = try ask(agent, { method: "GET", path: "/api/conversations" })

  const base = 1_700_000_000_000
  const long = try seed(agent, plans.conversation.roomId, Array.from({ length: 230 }, (_, index) => ({
    text: index % 10 === 0 ? `needle ${index}` : `line ${index}`, at: base + Math.floor(index / 2),
  })))
  try seed(agent, blank.conversation.roomId, [
    { text: "another NEEDLE here", at: base + 500 }, { text: privateNotice, at: base + 501 }, { text: "needle again", at: base + 502 },
  ])
  const pending = try host("pending fork", () => pendingBeside(agent.agent.runtime, plans.conversation.roomId, "Plans · edit"))
  try seed(agent, pending.roomId, [{ text: "needle in a pending fork", at: base + 600 }])
  const listedAfter = try ask(agent, { method: "GET", path: "/api/conversations" })
  const toPending = try ask(agent, { method: "POST", path: `/api/conversations/${pending.id}/messages`, body: { text: "Are you there?" } })
  const stopPending = try ask(agent, { method: "POST", path: `/api/turns/${pending.roomId}/abort`, body: {} })

  const first = try history(agent, plans.conversation.id, "")
  const paged = try pageBack(agent, plans.conversation.id, first.page)
  const pivot = inOrder(long)[120]
  const near = try history(agent, plans.conversation.id, `?around=${pivot}&before=5`)
  const unknownPivot = try history(agent, plans.conversation.id, `?around=${unknownIds.message}`)
  const unknownConversation = try history(agent, unknownIds.conversation, "")
  const pendingHistory = try history(agent, pending.id, "")
  const idWithoutTime = try history(agent, plans.conversation.id, `?beforeId=${pivot}`)
  const padded = try history(agent, plans.conversation.id, "?before=0123")
  const badLimit = try history(agent, plans.conversation.id, `?before=${base + 50}&limit=x`)

  const pages = [
    try search(agent, "q=%20needle%20&limit=10&offset=0"),
    try search(agent, "q=needle&limit=10&offset=10"),
    try search(agent, "q=needle&limit=10&offset=20"),
  ]
  const whole = try search(agent, "q=needle&limit=50&offset=0")
  const defaulted = try search(agent, "q=needle")
  const collapsed = try search(agent, "q=another%20%20%20needle")
  const notice = try search(agent, "q=private%20information")
  const short = try search(agent, "q=%20n%20")
  const negative = try search(agent, "q=needle&offset=-1")

  try Effect.try(() => {
    const everything = inOrder(long)
    const index = everything.indexOf(pivot)
    const rows = (body: unknown) => (body as { conversations: readonly Conversation[] }).conversations
    const titles = (body: unknown) => rows(body).map(({ title }) => title)
    const isoTimes = ({ createdAt, updatedAt }: Conversation) => [createdAt, updatedAt].every((at) => typeof at === "string" && new Date(at).toISOString() === at)
    assert.deepStrictEqual({
      created: [plans.status, blank.status, tooLong.status], titles: [plans.conversation.title, blank.conversation.title],
      listed: titles(listed.body), listedAfter: titles(listedAfter.body),
      isoTimes: [plans.conversation, blank.conversation, ...rows(listedAfter.body)].every(isoTimes),
      pendingTakesNoTurn: [toPending, stopPending],
    }, {
      created: [201, 201, 400], titles: ["Plans", "New Chat"], listed: ["New Chat", "Plans"], listedAfter: ["New Chat", "Plans"],
      isoTimes: true,
      pendingTakesNoTurn: [{ status: 404, body: { error: "unknown_conversation" } }, { status: 404, body: { error: "unknown_conversation" } }],
    })
    assert.deepStrictEqual({ first: ids(first.page), more: first.page.hasMore }, { first: everything.slice(-200), more: true })
    assert.deepStrictEqual({ held: paged.held, pages: paged.pages }, { held: everything, pages: 1 })
    assert.deepStrictEqual({ near: ids(near.page), more: near.page.hasMore }, { near: everything.slice(index - 100, index + 101), more: undefined })
    assert.deepStrictEqual(
      [unknownPivot.status, unknownConversation.status, pendingHistory.status, idWithoutTime.status, padded.status, badLimit.status],
      [404, 404, 404, 400, 400, 400])
    const joined = pages.flatMap(({ hits }) => hits.map(({ messageId }) => messageId))
    assert.deepStrictEqual({
      statuses: [...pages.map(({ status }) => status), whole.status, short.status, negative.status],
      sizes: [...pages.map(({ hits }) => hits.length), whole.hits.length, defaulted.hits.length],
      joined, unique: new Set(joined).size,
      collapsed: collapsed.hits.map(({ text }) => text), notice: notice.hits.length,
      fromPending: whole.hits.some(({ text }) => text.includes("pending")),
    }, {
      statuses: [200, 200, 200, 200, 400, 400], sizes: [10, 10, 5, 25, 20],
      joined: whole.hits.map(({ messageId }) => messageId), unique: 25,
      collapsed: ["another NEEDLE here"], notice: 0, fromPending: false,
    })
  })
}, 180_000)

effect function seedMarked(agent: InProcess, roomId: UUID, rows: readonly { readonly text: string; readonly at: number; readonly agent: boolean; readonly failureKind?: string; readonly cloudCode?: string }[]) {
  const runtime = agent.agent.runtime
  return try host("seed marked messages", async () => {
    const memories = rows.map(({ text, at, agent: fromAgent, failureKind, cloudCode }): Memory => ({
      id: freshId(), roomId, agentId: runtime.agentId, createdAt: at, entityId: fromAgent ? runtime.agentId : freshId(),
      content: { text, source: "device", ...(failureKind === undefined ? {} : { failureKind }), ...(cloudCode === undefined ? {} : { cloudCode }) },
    }))
    await runtime.adapter.createMemories(memories.map((memory) => ({ memory, tableName: "messages" })))
    return memories
  })
}

it.effect('A reopened reply refused for spent plan allowance and credits carries Cloud\'s funds code, and no other row does (spec/agent/conversation/conversations.md, "A history row carries its send key only on the owner\'s message, and a failure kind, what ended its turn and Cloud\'s funds code only on the agent\'s reply")', effect () => {
  const agent = try startInProcess()
  const chat = try open(agent, {})
  const base = 1_700_000_000_000
  try seedMarked(agent, chat.conversation.roomId, [
    { text: "Answer me.", at: base, agent: false, failureKind: "insufficient_credits", cloudCode: "allowance_exhausted" },
    { text: "", at: base + 1, agent: true, failureKind: "insufficient_credits", cloudCode: "allowance_exhausted" },
    { text: "", at: base + 2, agent: true, failureKind: "insufficient_credits", cloudCode: "insufficient_credits" },
    { text: "", at: base + 3, agent: true, failureKind: "insufficient_credits" },
    { text: "Hello there.", at: base + 4, agent: true, cloudCode: "insufficient_credits" },
    { text: "", at: base + 5, agent: true, failureKind: "limit_reached" },
  ])
  const read = try history(agent, chat.conversation.id, "")
  try Effect.try(() => {
    const rows = read.page.messages as readonly (Message & { readonly failureKind?: string; readonly cloudCode?: string })[]
    assert.deepStrictEqual({ status: read.status, rows: rows.map(({ role, failureKind, cloudCode }) => ({ role, failureKind, cloudCode })) }, {
      status: 200,
      rows: [
        { role: "user", failureKind: undefined, cloudCode: undefined },
        { role: "assistant", failureKind: "insufficient_credits", cloudCode: "allowance_exhausted" },
        { role: "assistant", failureKind: "insufficient_credits", cloudCode: "insufficient_credits" },
        { role: "assistant", failureKind: "insufficient_credits", cloudCode: undefined },
        { role: "assistant", failureKind: undefined, cloudCode: undefined },
        { role: "assistant", failureKind: "limit_reached", cloudCode: undefined },
      ],
    })
  })
}, 60_000)
