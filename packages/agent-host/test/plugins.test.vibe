// spec/agent/plugins/profile.md, "Story: Load only the plugins my product lists"; spec/agent/plugins/profile.md, "Story: Register my product's own actions and routes"
import { assert, it } from "@effect/vitest"
import { addLogListener, type LogEntry } from "@elizaos/core"
import { builtinModules, cloudLinkPlugin, privacyPlugin, storagePlugin } from "../gen/agent__plugins__profile.ts"
import { parseLaunch } from "../src/host/launch.vibe"
import type { AgentPlugin } from "../src/host/module.vibe"
import { startAgent, type StartAgentInput } from "../src/host/process.vibe"
import { builtinModuleFactories, bundledPluginMap } from "../src/plugins/profile.vibe"
import { boot, host, ready, scratch } from "./support/kernel.vibe"
import { claimingProductPlugin, productActionName, productPlugin } from "./support/product-plugin/index.ts"
import { launchDocument, launchFrame, type LaunchOptions } from "./support/scratch.ts"
import { request } from "./support/socket-client.ts"

const tasksModule = "@elizaos/agent/tasks"
const unbuiltModule = builtinModules.find((name) => !builtinModuleFactories.has(name))

const listedPlugin = {
  name: "listed-fixture",
  description: "A load-listed plugin fixture with no actions or routes.",
} satisfies AgentPlugin

const hostClaimingPlugin = {
  ...productPlugin,
  name: "host-claiming-product-fixture",
  routes: [{ ...productPlugin.routes[0], path: "/api/conversations/product" }],
} satisfies AgentPlugin

interface Case {
  readonly launch: LaunchOptions
  readonly bundled?: readonly AgentPlugin[]
}

effect function launched(state: { readonly path: string; file(name: string): string }, test: Case) {
  const frame = launchFrame()
  const document = try Effect.try(() => launchDocument(test.launch))
  const parsed = try parseLaunch(JSON.stringify(document), JSON.stringify(frame))
  const bundled = try bundledPluginMap((test.bundled ?? []).map((plugin) => ({ packageName: plugin.name, plugin })))
  const socket = state.file("agent.sock")
  return {
    frame, socket,
    input: {
      ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: socket }, bundled,
    } satisfies StartAgentInput,
  }
}

effect function refusal(test: Case) {
  const state = try scratch("plan-state")
  const { input } = try launched(state, test)
  const failed = try Effect.flip(startAgent(input))
  return failed._tag === "AgentBootFailed" ? failed.phase : failed._tag
}

const refusals: ReadonlyArray<readonly [string, string, Case]> = [
  ["An unknown plugin stops boot", `spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"`,
    { launch: { load: ["@elizaos/plugin-wallet"] } }],
  ["A listed storage plugin stops boot", `spec/agent/plugins/profile.md, "Storage and the cloud link always load, and the load list cannot name either or the privacy service"`,
    { launch: { load: ["@elizaos/agent/storage"] } }],
  ["A product plugin named like an agent module stops boot", `spec/agent/plugins/profile.md, "Storage and the cloud link always load, and the load list cannot name either or the privacy service"`,
    { launch: { productPlugin: tasksModule } }],
  ["A product plugin missing from the bundle stops boot", `spec/agent/plugins/profile.md, "The product plugin must be in the bundle"`,
    { launch: { productPlugin: productPlugin.name, allowed: ["REPLY", "IGNORE", "NONE", productActionName] } }],
  ["A product route under a host prefix stops boot", `spec/agent/plugins/profile.md, "A product route never claims a route prefix an agent module owns"`,
    { launch: { productPlugin: hostClaimingPlugin.name, allowed: ["REPLY", "IGNORE", "NONE", productActionName] }, bundled: [hostClaimingPlugin] }],
  ["A stale allowlist stops boot", `spec/agent/plugins/profile.md, "The agent is ready only when every allowed action is registered"`,
    { launch: { allowed: ["REPLY", "IGNORE", "NONE", "RENAMED"] } }],
]

for (const [title, citation, test] of refusals) {
  it.effect(`${title} with Config (${citation})`, effect () => {
    const phase = try refusal(test)
    try Effect.try(() => assert.strictEqual(phase, "Config"))
  }, 60_000)
}

it.effect.skipIf(!builtinModuleFactories.has(tasksModule))(`A product route under the tasks module's prefix stops boot with Config (spec/agent/plugins/profile.md, "A product route never claims a route prefix an agent module owns")${builtinModuleFactories.has(tasksModule) ? "" : `: skipped while ${tasksModule} has no factory`}`, effect () => {
  const phase = try refusal({
    launch: { load: [tasksModule], productPlugin: claimingProductPlugin.name, allowed: ["REPLY", "IGNORE", "NONE", productActionName] },
    bundled: [claimingProductPlugin],
  })
  try Effect.try(() => assert.strictEqual(phase, "Config"))
}, 120_000)

it.effect(`A bundled package whose plugin has another name is refused, and one that exports no plugin is carried only as a hosted module (spec/agent/plugins/profile.md, "The product plugin must be in the bundle"; spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules")`, effect () => {
  const failed = try Effect.flip(bundledPluginMap([{ packageName: "@product/plugin", plugin: productPlugin }]))
  const hostedName = "@elizaos/plugin-local-inference"
  const unexported = try Effect.flip(bundledPluginMap([{ packageName: hostedName, plugin: undefined }]))
  const hosted = try bundledPluginMap([{ packageName: hostedName, plugin: undefined }], new Set([hostedName]))
  try Effect.try(() => assert.deepStrictEqual(
    { renamed: [failed._tag, failed.packageName], unexported: [unexported._tag, unexported.packageName], hosted: [...hosted.keys()].map((name) => [name, hosted.get(name)?.name]) },
    { renamed: ["BundleEntryRefused", "@product/plugin"], unexported: ["BundleEntryRefused", hostedName], hosted: [[hostedName, hostedName]] },
  ))
})

it.effect(`A malformed product route refuses the whole list, then a corrected launch serves its action and route (spec/agent/plugins/profile.md, "Story: Register my product's own actions and routes"; spec/agent/access/routes.md, "A list is loaded whole or not at all")`, effect () => {
  const state = try scratch("plan-state")
  const launch = { persistMemory: true, productPlugin: productPlugin.name, allowed: ["REPLY", "IGNORE", "NONE", productActionName] }
  const invalid = try launched(state, {
    launch, bundled: [{ ...productPlugin, routes: [...productPlugin.routes, { ...productPlugin.routes[0], path: "/api/product/:id" }] }],
  })
  const refused = try Effect.flip(startAgent(invalid.input))
  try Effect.try(() => assert.deepStrictEqual([refused._tag, "phase" in refused ? refused.phase : null], ["AgentBootFailed", "Config"]))
  const { frame, socket, input } = try launched(state, {
    launch, bundled: [productPlugin],
  })
  const running = try acquireRelease(startAgent(input), (agent) => orDie(host("retire agent", () => agent.stop())))
  const ping = try host("product route", () => request(socket, { method: "GET", path: "/api/product/ping", token: frame.token }))
  const anonymous = try host("product route without the token", () => request(socket, { method: "GET", path: "/api/product/ping" }))
  try Effect.try(() => assert.deepStrictEqual({
    ready: running.status.ready,
    actions: running.status.actions,
    ping: "json" in ping ? { status: ping.status, body: ping.json } : ping,
    anonymous: "status" in anonymous ? anonymous.status : anonymous,
  }, {
    ready: true,
    actions: ["IGNORE", "NONE", productActionName, "REPLY"],
    ping: { status: 200, body: { pong: true } },
    anonymous: 401,
  }))
}, 120_000)

const childRefusals: ReadonlyArray<readonly [string, string, LaunchOptions]> = [
  ["An unknown plugin name", `spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"`, { load: ["@elizaos/plugin-wallet"] }],
  ["A load list naming storage", `spec/agent/plugins/profile.md, "Storage and the cloud link always load, and the load list cannot name either or the privacy service"`, { load: ["@elizaos/agent/storage"] }],
  ["A named product that is not in the bundle", `spec/agent/plugins/profile.md, "The product plugin must be in the bundle"`, { productPlugin: "product-fixture", allowed: ["REPLY", "IGNORE", "NONE", productActionName] }],
]

it.effect.skipIf(unbuiltModule === undefined)(`A listed built-in module without a factory exits 78 (spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules")${unbuiltModule === undefined ? ": skipped, every built-in module has a factory" : `: ${unbuiltModule}`}`, effect () => {
  const booted = try boot({ launch: { load: [unbuiltModule ?? ""] } })
  const exited = try host("exit", () => booted.child.exited)
  try Effect.try(() => assert.strictEqual(exited.code, 78))
}, 120_000)

for (const [title, citation, launch] of childRefusals) {
  it.effect(`${title} exits 78 (${citation})`, effect () => {
    const booted = try boot({ launch })
    const exited = try host("exit", () => booted.child.exited)
    try Effect.try(() => assert.strictEqual(exited.code, 78))
  }, 120_000)
}

it.effect('An agent with a cloud backend and no plugins is ready and registers storage then the cloud link (spec/agent/plugins/profile.md, "Storage loads first, then the cloud link, the privacy service, the listed plugins in order and the product plugin last")', effect () => {
  const booted = try boot({ cloud: true })
  try ready(booted)
  const answer = try host("status", () => request((booted.transport as { path: string }).path, { method: "GET", path: "/api/status", token: booted.frame.token }))
  const stopped = try host("stop", () => booted.child.stop())
  const output = `${stopped.stdout}${stopped.stderr}`
  const registered = output.split("\n").filter((line) => line.includes("Plugin registered"))
  try Effect.try(() => assert.strictEqual("json" in answer ? (answer.json as { state: string }).state : answer, "running"))
  try Effect.try(() => assert.include(registered[0] ?? "", storagePlugin))
  try Effect.try(() => assert.include(registered[1] ?? "", cloudLinkPlugin))
  try Effect.try(() => assert.strictEqual(registered.length, 2))
}, 180_000)

it.effect(`Plugins register as storage, the cloud link, the privacy service in the launch's mode, the listed plugins and the product last (spec/agent/plugins/profile.md, "Storage loads first, then the cloud link, the privacy service, the listed plugins in order and the product plugin last")`, effect () => {
  const order = [storagePlugin, cloudLinkPlugin, privacyPlugin, listedPlugin.name, productPlugin.name]
  const registered: string[] = []
  const listen = (entry: LogEntry) => {
    if (!entry.msg.includes("Plugin registered")) return
    const plugin = order.find((name) => entry.msg.includes(name))
    registered.push(plugin ?? entry.msg)
  }
  try acquireRelease(Effect.sync(() => addLogListener(listen)), (remove) => Effect.sync(() => { remove() }))
  const state = try scratch("plan-state")
  const { input } = try launched(state, {
    launch: {
      load: [listedPlugin.name], productPlugin: productPlugin.name, allowed: ["REPLY", "IGNORE", "NONE", productActionName],
      privacy: { secretSwap: true, piiSwap: false },
    },
    bundled: [listedPlugin, productPlugin],
  })
  const running = try acquireRelease(startAgent(input), (agent) => orDie(host("retire agent", () => agent.stop())))
  const swaps = ["ELIZA_SECRET_SWAP_ENABLED", "ELIZA_PII_SWAP_ENABLED"].map((key) => running.runtime.getSetting(key))
  try Effect.try(() => assert.deepStrictEqual({ ready: running.status.ready, registered, swaps }, { ready: true, registered: order, swaps: [true, false] }))
}, 120_000)
