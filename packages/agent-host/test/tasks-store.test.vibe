// spec/agent/tasks/store.md, "Story: Refuse task storage when custody cannot be verified"; spec/agent/tasks/store.md, "Story: Keep records a build cannot read"; spec/agent/tasks/index.md, "Story: Run one task operation without losing or repeating its effect"
import { assert, it } from "@effect/vitest"
import { createTaskStore, type TaskDatabaseOpener, type TaskStoreOptions } from "../src/tasks/store.vibe"
import { scratch, SupportFailed } from "./support/kernel.vibe"
import { copyIn, sealedFor } from "./support/task-record.vibe"

module node {
  import { randomBytes } from "node:crypto"
  import { spawnSync } from "node:child_process"
  import { chmodSync, existsSync, readdirSync, renameSync, writeFileSync } from "node:fs"
  import { join } from "node:path"
  import { DatabaseSync } from "node:sqlite"
  import { Redacted, Result } from "effect"
  import { createInteractiveTask, ElizaError, transitionInteractiveTask, type InteractiveTask, type TaskEvent, type TaskTransition } from "@elizaos/core"
  import { decodeTaskRecord, decodeTaskRecordResult, openNodeTaskDatabase, storageKeySource, type TaskDatabaseOpener, type TaskRecord } from "../src/tasks/store.vibe"

  export const account = "owner-account"
  const owner = { agentId: "agent-1", actorId: "owner-1", connector: { source: "device", accountId: "device" } }

  export function newKey(bytes = 32): string {
    return randomBytes(bytes).toString("base64")
  }

  export function keyFor(key: string | undefined) {
    return storageKeySource(key === undefined ? undefined : Redacted.make(key))
  }

  export function task(id: string): TaskRecord {
    const created = createInteractiveTask({
      id, owner, goalRef: `goal-${id}`, now: 1_000,
      authorization: { decisionId: `decision-${id}`, policyRevision: "1", decidedAt: "2026-01-01T00:00:00.000Z", state: "active", revokedAt: null },
      allowedCapabilities: ["read"], allowedOrigins: ["https://example.com"],
    })
    return { task: created, events: [] }
  }

  export function cancelled(record: TaskRecord): TaskRecord {
    const next = transitionInteractiveTask(record.task as InteractiveTask, { owner, expectedRevision: record.task.revision, now: 2_000 }, { type: "cancel" })
    return { task: next.task, events: [...record.events, next.event] }
  }

  export function unknownOutcome(id: string): TaskRecord {
    let current = task(id).task as InteractiveTask
    const events: TaskEvent[] = []
    const step = (transition: TaskTransition, now: number) => {
      const next = transitionInteractiveTask(current, { owner, expectedRevision: current.revision, now }, transition)
      current = next.task
      events.push(next.event)
    }
    const observation = { id: `observation-${id}`, pageId: "page-1", origin: "https://example.com", version: 1, inputRevision: 1, observedAt: 1_100 }
    step({ type: "observe", observation }, 1_100)
    step({ type: "prepare", proposal: {
      id: `operation-${id}`, taskId: id, epoch: current.epoch, observationId: observation.id, observationVersion: 1, inputRevision: 1,
      targetRef: "button-1", capability: "read", authorizationId: `decision-${id}`, expiresAt: 10_000,
    } }, 1_200)
    step({ type: "dispatch", operationId: `operation-${id}` }, 1_300)
    step({ type: "cancel" }, 1_400)
    return { task: current, events }
  }

  export function laterBuild(unreadableIds: readonly string[]) {
    /** @throws {never} */
    function decode(text: string): Result.Result<TaskRecord, unknown> {
      try {
        const decoded = decodeTaskRecordResult(text)
        if (Result.isSuccess(decoded) && unreadableIds.includes(decoded.success.task.id)) {
          return Result.fail(new ElizaError("Task schema 2 is not known to this build", { code: "TASK_INVALID" }))
        }
        return decoded
      } catch (cause) {
        return Result.fail(cause)
      }
    }
    return decode
  }

  export function decodes(record: unknown): string {
    try {
      decodeTaskRecord(JSON.stringify(record))
      return "decoded"
    } catch (error) {
      return error instanceof ElizaError ? error.code ?? "" : "thrown"
    }
  }

  export function storedIds(directory: string): string[] {
    const db = new DatabaseSync(join(directory, "tasks.sqlite"))
    try {
      return db.prepare("SELECT id FROM task_records_v1 ORDER BY id").all().map((row) => String(row.id))
    } finally {
      db.close()
    }
  }

  export function exists(path: string): boolean {
    return existsSync(path) && readdirSync(path).length > 0
  }

  export function openPermissions(directory: string): void {
    chmodSync(directory, 0o755)
  }

  export function closePermissions(directory: string): void {
    chmodSync(directory, 0o700)
  }

  export function replaceLock(directory: string, pid = spawnSync(process.execPath, ["-e", ""]).pid): void {
    const staged = join(directory, "replacement.lock")
    writeFileSync(staged, JSON.stringify({ pid, owner: "replacement" }), { mode: 0o600 })
    renameSync(staged, join(directory, "tasks.sqlite.lock"))
  }

  export function leftUnderThisPid(directory: string): void {
    replaceLock(directory, process.pid)
  }

  export function stealingDatabase(directory: string) {
    let armed: "run" | "all" | undefined
    const steal = (during: "run" | "all") => {
      if (armed !== during) return
      armed = undefined
      replaceLock(directory)
    }
    const open: TaskDatabaseOpener = (path) => {
      const db = openNodeTaskDatabase(path)
      return {
        exec: (sql) => db.exec(sql),
        close: () => db.close(),
        prepare(sql) {
          const statement = db.prepare(sql)
          return {
            all: (...parameters) => (steal("all"), statement.all(...parameters)),
            run: (...parameters) => (steal("run"), statement.run(...parameters)),
          }
        },
      }
    }
    return { open, arm: (during: "run" | "all") => { armed = during } }
  }
}

import {
  account, cancelled, closePermissions, decodes, exists, keyFor, laterBuild, leftUnderThisPid, newKey, openPermissions, replaceLock,
  stealingDatabase, storedIds, task, unknownOutcome,
} from node

effect function support<A>(step: string, call: () => A) {
  return try Effect.try({ try: call, catch: (cause) => new SupportFailed({ step, cause }) })
}

effect function outcome<A, E extends { readonly _tag: string }>(run: A!E) {
  return run catch (error) => error._tag
}

effect function storeIn(directory: string, key: string | undefined, decode?: TaskStoreOptions["decode"], database?: TaskDatabaseOpener) {
  return try createTaskStore({
    directory, keys: try support("key", () => keyFor(key)),
    ...(decode === undefined ? {} : { decode }), ...(database === undefined ? {} : { database }),
  })
}

it.effect('Task storage opens only under verified custody and serves only authentic records (spec/agent/tasks/store.md, "Story: Refuse task storage when custody cannot be verified")', effect () => {
  const state = try scratch("task-store")
  const directory = state.file("tasks")
  const key = try support("key", () => newKey())
  const first = try support("task", () => task("task-1"))

  const shortKey = try storeIn(directory, try support("short key", () => newKey(16)))
  const before = try shortKey.storageStatus()
  const wrongLength = try outcome(shortKey.open(account))
  const afterRefusal = { status: try shortKey.storageStatus(), wroteNothing: !(try support("refused files", () => exists(directory))) }
  const missing = try outcome((try storeIn(directory, undefined)).open(account))

  const store = try storeIn(directory, key)
  try store.open(account)
  const second = try storeIn(directory, key)
  const lockHeld = try outcome(second.open(account))
  try store.create(first)
  const read = try store.get("task-1")
  const current = try store.current()
  const taken = try outcome(store.create(try support("task", () => task("task-2"))))
  try store.close()
  const closedStatus = try store.storageStatus()
  try support("a lock left by an earlier run under this pid", () => leftUnderThisPid(directory))
  const afterCrash = try storeIn(directory, key)
  const reclaimed = try outcome(afterCrash.open(account))
  try afterCrash.close()

  try support("non-private directory", () => openPermissions(directory))
  const notPrivate = try outcome((try storeIn(directory, key)).open(account))
  try support("private directory", () => closePermissions(directory))

  try support("copy foreign records", () => {
    copyIn(directory, "foreign", sealedFor(key, "other-account", "TaskRecord", task("foreign")), false)
    copyIn(directory, "evidence", sealedFor(key, account, "TaskEvidence", task("evidence")), false)
    copyIn(directory, "torn", sealedFor(key, account, "TaskRecord", task("torn")).slice(0, -6), true)
  })
  const reopened = try storeIn(directory, key)
  try reopened.open(account)
  const copied = {
    foreign: try outcome(reopened.get("foreign")),
    evidence: try outcome(reopened.get("evidence")),
    torn: try outcome(reopened.get("torn")),
    current: try outcome(reopened.current()),
    slot: try outcome(reopened.create(try support("task", () => task("task-3")))),
    own: (try reopened.get("task-1"))?.task.id,
  }
  const otherAccount = try outcome(reopened.open("other-account"))

  try support("replace the writer lock", () => replaceLock(directory))
  const fenced = { status: try reopened.storageStatus(), read: try outcome(reopened.get("task-1")) }
  const replacement = try storeIn(directory, key)
  try replacement.open(account)
  const replacementRead = (try replacement.get("task-1"))?.task.id
  try replacement.close()

  const thief = try support("lock thief", () => stealingDatabase(directory))
  const writing = try storeIn(directory, key, undefined, thief.open)
  try writing.open(account)
  const live = try writing.get("task-1")
  const cancel = try support("cancel", () => cancelled(live ?? first))
  try support("arm", () => thief.arm("run"))
  const lost = { write: try outcome(writing.save(cancel)), next: try outcome(writing.get("task-1")) }
  try writing.close()
  const reading = try storeIn(directory, key, undefined, thief.open)
  try reading.open(account)
  try support("arm", () => thief.arm("all"))
  const refusedRead = try outcome(reading.get("task-1"))
  try reading.close()

  try Effect.try(() => assert.deepStrictEqual({
    before, wrongLength, afterRefusal, missing, lockHeld, read: read?.task, current: current?.task.id, taken, closedStatus, reclaimed,
    notPrivate, copied, otherAccount, fenced, replacementRead, lost, refusedRead,
  }, {
    before: "deferred", wrongLength: "StorageUnavailable", afterRefusal: { status: "unavailable", wroteNothing: true },
    missing: "StorageUnavailable", lockHeld: "StorageUnavailable", read: first.task, current: "task-1", taken: "SlotTaken",
    closedStatus: "unavailable", reclaimed: undefined, notPrivate: "StorageUnavailable",
    copied: { foreign: "Corrupt", evidence: "Corrupt", torn: "Corrupt", current: "Corrupt", slot: "Corrupt", own: "task-1" },
    otherAccount: "StorageUnavailable", fenced: { status: "unavailable", read: "StorageUnavailable" }, replacementRead: "task-1",
    lost: { write: "OutcomeUnknown", next: "StorageUnavailable" }, refusedRead: "ReadRefused",
  }))
})

it.effect('A record this build cannot read is held aside, keeps the slot until the owner releases it and is never deleted (spec/agent/tasks/store.md, "Story: Keep records a build cannot read")', effect () => {
  const state = try scratch("task-store-unreadable")
  const directory = state.file("tasks")
  const key = try support("key", () => newKey())
  const cannotRead = try support("build", () => laterBuild(["old"]))
  const readsAll = try support("build", () => laterBuild([]))
  const reason = "Task schema 2 is not known to this build"

  const first = try storeIn(directory, key)
  try first.open(account)
  try first.create(try support("task", () => task("old")))
  try first.close()

  const rejecting = try storeIn(directory, key, cannotRead)
  try rejecting.open(account)
  const held = {
    read: rejecting.get("old") catch (error) => ({ tag: error._tag, code: error.code, reason: "reason" in error ? error.reason : "" }),
    current: try rejecting.current(),
    slot: try outcome(rejecting.create(try support("task", () => task("new")))),
    aside: (try rejecting.unreadable()).map(({ taskId, reason, releasedAt }) => ({ taskId, reason, releasedAt })),
    stranger: try outcome(rejecting.acknowledgeUnreadable("other-account", "old")),
  }
  try rejecting.close()

  const recovering = try storeIn(directory, key, readsAll)
  try recovering.open(account)
  const recovered = {
    read: (try recovering.get("old"))?.task.id, current: (try recovering.current())?.task.id, aside: (try recovering.unreadable()).length,
  }
  try recovering.close()

  const releasing = try storeIn(directory, key, cannotRead)
  try releasing.open(account)
  const released = try releasing.acknowledgeUnreadable(account, "old")
  try releasing.create(try support("task", () => task("new")))
  const afterRelease = { reason: released.reason, released: released.releasedAt !== null, current: (try releasing.current())?.task.id }
  try releasing.close()

  const later = try storeIn(directory, key, readsAll)
  try later.open(account)
  const keptAside = {
    read: try outcome(later.get("old")),
    current: (try later.current())?.task.id,
    aside: (try later.unreadable()).map(({ taskId, reason, releasedAt }) => ({ taskId, reason, released: releasedAt !== null })),
  }
  try later.close()
  const rows = try support("rows", () => storedIds(directory))

  try Effect.try(() => assert.deepStrictEqual({ held, recovered, afterRelease, keptAside, rows }, {
    held: {
      read: { tag: "Unreadable", code: "TASK_UNREADABLE", reason }, current: null, slot: "Unreadable",
      aside: [{ taskId: "old", reason, releasedAt: null }], stranger: "NotOwner",
    },
    recovered: { read: "old", current: "old", aside: 0 },
    afterRelease: { reason, released: true, current: "new" },
    keptAside: { read: "Unreadable", current: "new", aside: [{ taskId: "old", reason, released: true }] },
    rows: ["new", "old"],
  }))
})

it.effect('An accepted unknown outcome stays accepted across a restart and frees the slot only then (spec/agent/tasks/index.md, "Story: Run one task operation without losing or repeating its effect")', effect () => {
  const state = try scratch("task-store-unknown")
  const directory = state.file("tasks")
  const key = try support("key", () => newKey())
  const unknown = try support("unknown outcome", () => unknownOutcome("task-1"))

  const before = try storeIn(directory, key)
  try before.open(account)
  try before.create(unknown)
  try before.close()

  const restarted = try storeIn(directory, key)
  try restarted.open(account)
  const open = {
    status: (try restarted.current())?.task.status,
    slot: try outcome(restarted.create(try support("task", () => task("task-2")))),
  }
  try restarted.save({ ...unknown, acknowledgedUnknown: true })
  try restarted.close()

  const accepted = try storeIn(directory, key)
  try accepted.open(account)
  const after = {
    marker: (try accepted.get("task-1"))?.acknowledgedUnknown,
    current: try accepted.current(),
    next: try outcome(accepted.create(try support("task", () => task("task-2")))),
  }
  try accepted.close()
  const markedLive = try support("decode", () => decodes({ ...task("task-3"), acknowledgedUnknown: true }))

  try Effect.try(() => assert.deepStrictEqual({ open, after, markedLive }, {
    open: { status: "cancelled", slot: "SlotTaken" },
    after: { marker: true, current: null, next: undefined },
    markedLive: "TASK_INVALID",
  }))
})
