// spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent's own modules"; spec/core/actionPlanning.md, "An empty, malformed or stale allowlist stops boot"
import { assert, it } from "@effect/vitest"
import { stringToUuid, type Memory } from "@elizaos/core"
import { basicActionsModuleName, calculate, calculationLimits, type Calculation } from "../src/plugins/basic-actions.vibe"
import { builtinModuleFactories } from "../src/plugins/profile.vibe"
import { host, startInProcess } from "./support/kernel.vibe"

const rule = 'spec/agent/plugins/profile.md, "A load list names only plugins the bundle carries or the agent\'s own modules"'

const values: ReadonlyArray<readonly [string, string, boolean]> = [
  ["2 + 3 * 4", "14", true],
  ["(2 + 3) * 4", "20", true],
  ["2 ^ 3 ^ 2", "512", true],
  ["-2 ^ 2", "-4", true],
  ["17 % 5 - -3", "5", true],
  ["123456789012345678901234567890 * 987654321098765432109876543210", "121932631137021795226185032733622923332237463801111263526900", true],
  ["2 ^ 200", "1606938044258990275541962092341162602522202993782792835301376", true],
  ["1,000,000 * 3", "3000000", true],
  ["7 / 2", "3.5", false],
  ["1 / 3", "0.333333333333333", false],
  ["(12.5 + 3) / 4", "3.875", false],
  ["2 ^ -1", "0.5", false],
]

it.effect(`CALCULATE evaluates with precedence, exact big integers and floats only for division or decimals (${rule})`, effect () => {
  const results: Calculation[] = []
  for (const [expression] of values) results.push(try calculate(expression))
  try Effect.try(() => assert.deepStrictEqual(
    results.map(({ value, exact }) => [value, exact]),
    values.map(([, value, exact]) => [value, exact]),
  ))
})

const refusals: ReadonlyArray<readonly [string, string, object]> = [
  ["nesting deeper than the limit", `${"(".repeat(calculationLimits.nestingDepth + 1)}1${")".repeat(calculationLimits.nestingDepth + 1)}`, { kind: "TooDeep", limit: 256 }],
  ["a chain of signs deeper than the limit", `${"-".repeat(calculationLimits.nestingDepth + 1)}1`, { kind: "TooDeep", limit: 256 }],
  ["an expression longer than the limit", "1+".repeat(5_000) + "1", { kind: "TooLong", limit: 10_000 }],
  ["an integer result past the digit limit", "10 ^ 10000", { kind: "TooManyDigits", limit: 10_000 }],
  ["a product past the digit limit", "9 ^ 9999 * 9 ^ 9999", { kind: "TooManyDigits", limit: 10_000 }],
  ["an exponent past the limit", "1 ^ 10001", { kind: "ExponentTooLarge", limit: 10_000 }],
  ["a word", "2 + x", { kind: "ExpectedNumber", position: 5 }],
  ["an unknown operator", "2 & 3", { kind: "UnexpectedCharacter", position: 3, found: "&" }],
  ["a missing closing parenthesis", "(1 + 2", { kind: "MissingParenthesis", position: 7 }],
  ["division by zero", "1 / (2 - 2)", { kind: "DivisionByZero" }],
  ["an integer remainder by zero", "5 % 0", { kind: "DivisionByZero" }],
  ["a float overflow", "10.0 ^ 400", { kind: "NotFinite" }],
]

for (const [title, expression, refusal] of refusals) {
  it.effect(`CALCULATE refuses ${title} and gives no partial result (${rule})`, effect () => {
    const failed = try Effect.flip(calculate(expression))
    try Effect.try(() => assert.deepStrictEqual({ tag: failed._tag, refusal: failed.refusal }, { tag: "ExpressionRefused", refusal }))
  })
}

it.effect(`An agent that loads the basic actions and allows {REPLY, IGNORE, NONE, CALCULATE} is ready and calculates (${rule}; spec/core/actionPlanning.md, "An empty, malformed or stale allowlist stops boot")`, effect () => {
  const { agent } = try startInProcess({
    launch: { load: [basicActionsModuleName], allowed: ["REPLY", "IGNORE", "NONE", "CALCULATE"] },
    modules: builtinModuleFactories,
  })
  const action = agent.runtime.actions.find((found) => found.name === "CALCULATE")
  const message: Memory = try Effect.try(() => ({
    entityId: stringToUuid("calculate-owner"), roomId: stringToUuid("calculate-room"), agentId: agent.runtime.agentId,
    content: { text: "What is 3847 times 292?" },
  }))
  const solved = try host("calculate", async () => action?.handler(agent.runtime, message, undefined, { parameters: { expression: "3847 * 292" } }))
  const refused = try host("calculate a word", async () => action?.handler(agent.runtime, message, undefined, { parameters: { expression: "two plus two" } }))
  try Effect.try(() => assert.deepStrictEqual({
    ready: agent.status.ready,
    actions: agent.status.actions,
    plugins: agent.runtime.plugins.some((plugin) => plugin.name === basicActionsModuleName),
    minRole: action?.roleGate?.minRole,
    solved: { success: solved?.success, text: solved?.text, data: solved?.data },
    refused: { success: refused?.success, data: refused?.data },
  }, {
    ready: true,
    actions: ["CALCULATE", "IGNORE", "NONE", "REPLY"],
    plugins: true,
    minRole: "USER",
    solved: { success: true, text: "3847 * 292 = 1123324", data: { expression: "3847 * 292", value: "1123324", exact: true } },
    refused: { success: false, data: { expression: "two plus two", refusal: "ExpectedNumber" } },
  }))
}, 120_000)
