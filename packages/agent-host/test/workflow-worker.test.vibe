// spec/agent/plugins/profile.md, "Story: Run my workflows only in the pinned worker"; spec/agent/host/launch.md, "Story: Tell the supervisor why the process ended"; spec/agent/plugins/profile.md, "Host runtime services register with storage before every listed plugin, never under an agent service's name, and a pinned worker is the workflow-worker service"
import { assert, it } from "@effect/vitest"
import { parseLaunch } from "../src/host/launch.vibe"
import { AgentBootFailed, startAgent } from "../src/host/process.vibe"
import { Service, type IAgentRuntime, type ServiceClass } from "@elizaos/core"
import { boot, host, scratch } from "./support/kernel.vibe"
import { launchDocument, launchFrame } from "./support/scratch.ts"

module node {
  import { createHash } from "node:crypto"
  import { symlink, writeFile } from "node:fs/promises"
  import type { ChildProcessWithoutNullStreams } from "node:child_process"

  const script = "#!/bin/sh\nprintf 'ARGS=%s\\n' \"$*\"\n/usr/bin/env\n"
  const nodeScript = [
    '#!/usr/bin/env node',
    'const { mkdtempSync, realpathSync, rmSync } = require("node:fs")',
    'const { dirname, join } = require("node:path")',
    'const { tmpdir } = require("node:os")',
    'const probe = mkdtempSync(join(realpathSync(tmpdir()), "workflow-"))',
    'console.log("TMP_USED=" + dirname(probe))',
    'rmSync(probe, { recursive: true })',
    'console.log("ARGS=" + process.argv.slice(2).join(" "))',
    'for (const [name, value] of Object.entries(process.env)) console.log(name + "=" + value)',
  ].join("\n")

  export const workerDigest = createHash("sha256").update(script).digest("hex")
  export const nodeWorkerDigest = createHash("sha256").update(nodeScript).digest("hex")

  export async function writeWorker(directory: string, name: string): Promise<void> {
    const javascript = name.endsWith(".js")
    await writeFile(`${directory}/${name}`, javascript ? nodeScript : script, { mode: javascript ? 0o600 : 0o755 })
  }

  export function useTempDirectory(path: string): () => void {
    const previous = process.env.TMPDIR
    process.env.TMPDIR = path
    return () => {
      if (previous === undefined) delete process.env.TMPDIR
      else process.env.TMPDIR = previous
    }
  }

  export async function linkWorker(directory: string, target: string, name: string): Promise<void> {
    await symlink(`${directory}/${target}`, `${directory}/${name}`)
  }

  export async function finished(child: ChildProcessWithoutNullStreams): Promise<{ code: number | null; lines: string[] }> {
    let output = ""
    child.stdout.setEncoding("utf8").on("data", (data: string) => { output += data })
    const code = await new Promise<number | null>((done, fail) => {
      child.once("error", fail)
      child.once("close", (exit) => done(exit))
    })
    return { code, lines: output.split("\n").filter((line) => line !== "") }
  }
}
import { finished, linkWorker, nodeWorkerDigest, useTempDirectory, workerDigest, writeWorker } from node

it.effect('A verified worker runs with plain settings only (spec/agent/plugins/profile.md, "Story: Run my workflows only in the pinned worker")', effect () => {
  const state = try scratch("ww-state")
  const workers = try scratch("ww-dir")
  const temporary = try scratch("ww-tmp")
  try acquireRelease(Effect.try(() => useTempDirectory(temporary.path)), (restore) => orDie(Effect.try(restore)))
  try host("worker fixture", () => writeWorker(workers.path, "worker.js"))
  const frame = launchFrame({ storageKey: "sealing-key-material-1" })
  const document = try Effect.try(() => launchDocument({
    workflowWorker: { runtimeDir: workers.path, executable: "worker.js", sha256: nodeWorkerDigest },
    environment: { WORKER_SETTING: "plain" },
  }))
  const parsed = try parseLaunch(JSON.stringify(document), JSON.stringify(frame))
  const running = try acquireRelease(
    startAgent({ ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: state.file("agent.sock") } }),
    (agent) => orDie(host("retire agent", () => agent.stop())),
  )
  const worker = running.workflowWorker
  if (worker === undefined) return try die("The verified worker was not installed")
  const child = try host("spawn worker", () => worker.spawnWorker(["run", "flow"], {
    env: { REQUEST_SETTING: "x", PATH: "/system/bin", TMPDIR: workers.path, LEAKED_TOKEN: frame.token, LEAKED_KEY: `prefix-${frame.storageKey}` },
  }))
  const ran = try host("worker exit", () => finished(child))
  try Effect.try(() => assert.deepStrictEqual({
    code: ran.code,
    args: ran.lines.includes("ARGS=run flow"),
    plain: ran.lines.includes("WORKER_SETTING=plain") && ran.lines.includes("REQUEST_SETTING=x"),
    temporary: ran.lines.includes(`TMP_USED=${temporary.path}`) && ran.lines.includes(`TMPDIR=${temporary.path}`),
    secret: ran.lines.some((line) => line.includes(frame.token) || line.includes("sealing-key-material-1") || line.startsWith("LEAKED_")),
    executable: worker.executable,
  }, { code: 0, args: true, plain: true, temporary: true, secret: false, executable: `${workers.path}/worker.js` }))
}, 180_000)

it.effect('A worker whose digest differs from the launch stops the agent with Config (spec/agent/plugins/profile.md, "The worker is installed only after its executable digest matches the launch")', effect () => {
  const workers = try scratch("ww-dir")
  try host("worker fixture", () => writeWorker(workers.path, "worker"))
  const booted = try boot({ launch: { workflowWorker: { runtimeDir: workers.path, executable: "worker", sha256: "0".repeat(64) } } })
  const exited = try host("agent exit", () => booted.child.exited)
  try Effect.try(() => assert.deepStrictEqual({ code: exited.code, signal: exited.signal }, { code: 78, signal: null }, exited.stderr))
}, 180_000)

it.effect('A symlinked worker executable is refused before the plan loads (spec/agent/plugins/profile.md, "The worker is installed only after its executable digest matches the launch")', effect () => {
  const state = try scratch("ww-state")
  const workers = try scratch("ww-dir")
  try host("worker fixture", () => writeWorker(workers.path, "real-worker"))
  try host("worker link", () => linkWorker(workers.path, "real-worker", "worker"))
  const document = try Effect.try(() => launchDocument({ workflowWorker: { runtimeDir: workers.path, executable: "worker", sha256: workerDigest } }))
  const parsed = try parseLaunch(JSON.stringify(document), JSON.stringify(launchFrame()))
  const failed = try Effect.flip(startAgent({ ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: state.file("agent.sock") } }))
  try Effect.try(() => assert.strictEqual(failed._tag === "AgentBootFailed" ? failed.phase : failed._tag, "Config"))
}, 60_000)

const hostServicesRule = "Host runtime services register with storage before every listed plugin, never under an agent service's name, and a pinned worker is the workflow-worker service"

function hostService(serviceType: string): ServiceClass {
  return class HostBridge extends Service {
    static override serviceType = serviceType
    override capabilityDescription = "A host bridge fixture"
    static override start(runtime: IAgentRuntime): Promise<Service> { return Promise.resolve(new HostBridge(runtime)) }
    enrollment(): Promise<undefined> { return Promise.resolve(undefined) }
    perform(): Promise<unknown> { return Promise.resolve({ ok: true }) }
    override stop(): Promise<void> { return Promise.resolve() }
  }
}

it.effect(`A pinned worker is the workflow-worker service, a host's bridges are found by name, and a host service under an agent service's name refuses boot (spec/agent/plugins/profile.md, "${hostServicesRule}")`, effect () => {
  const state = try scratch("ww-services-state")
  const workers = try scratch("ww-services-dir")
  try host("worker fixture", () => writeWorker(workers.path, "worker"))
  const frame = launchFrame({})
  const document = try Effect.try(() => launchDocument({ workflowWorker: { runtimeDir: workers.path, executable: "worker", sha256: workerDigest } }))
  const parsed = try parseLaunch(JSON.stringify(document), JSON.stringify(frame))
  const running = try acquireRelease(
    startAgent({ ...parsed, stateDirectory: state.path, binding: { kind: "socket", path: state.file("agent.sock") },
      runtimeServices: [hostService("workflow-device"), hostService("workflow-native-digests")] }),
    (agent) => orDie(host("retire agent", () => agent.stop())),
  )
  const worker = running.runtime.getService("workflow-worker") as unknown as { spawnWorker?: (args: readonly string[]) => Promise<Parameters<typeof finished>[0]> } | null
  const spawn = worker?.spawnWorker
  if (spawn === undefined) return try die("The workflow-worker service was not registered")
  const ran = try host("worker through the service", async () => finished(await spawn.call(worker, ["run", "flow"])))
  const crowded = try scratch("ww-crowded-state")
  const refused = try Effect.flip(startAgent({ ...parsed, stateDirectory: crowded.path, binding: { kind: "socket", path: crowded.file("agent.sock") },
    runtimeServices: [hostService("cloud")] }))
  try Effect.try(() => assert.deepStrictEqual({
    ran: { code: ran.code, args: ran.lines.includes("ARGS=run flow") },
    device: running.runtime.getService("workflow-device") !== null,
    digests: running.runtime.getService("workflow-native-digests") !== null,
    refused: refused instanceof AgentBootFailed ? refused.phase : "booted",
  }, { ran: { code: 0, args: true }, device: true, digests: true, refused: "Config" }))
}, 180_000)
