// spec/agent/deviceActions/surfaces.md, "Story: Propose a photo, a view, a Maps read or a Photos change only as my words and my screen name them"; spec/agent/deviceActions/surfaces.md, "A named camera is captured only as the owner requested and the phone supports"
import { assert, it } from "@effect/vitest"
import { deviceActionsModuleName } from "../src/device-actions/proposal/module.vibe"
import { viewsModuleName } from "../src/views/module.vibe"
import { deviceJourney } from "./support/device-agent.vibe"

module node {
  import type { AgentRuntime } from "@elizaos/core"
  import { held, text, toolCalls, type CloudFake, type CloudReply, type Completion } from "./support/cloud-fake.ts"
  import { deviceClient, type DeviceClient } from "./support/device.ts"

  export const proposeTool = "PROPOSE_DEVICE_ACTION"
  export const reviewText = "Review this request on your phone before it can run."
  const negotiated = ["camera.capture-photo.v1", "camera.capture-library-id.v1", "maps.selected-read.v1", "photos.library.v1", "photos.view.v1", "photos.view-selected.v1"]
  const place = { kind: "map-place", id: "maps_0f8fad5b-d9cb-469f-a165-70867728950e", revision: "7" }
  const openPhoto = { kind: "photo", id: "lib:i:12:345" }
  const found = { id: "lib:i:7:1", revision: "rev-a1-1", kind: "image", takenAt: 0, width: 10, height: 10 }
  const direct = { viewDelivery: "completed-action", viewClientId: "renderer-1", voiceUi: { viewDelivery: "completed-action", uiClientId: "renderer-1", agentActionMode: "direct-request-v1" } }
  const settledText = "Retrieved this request's stored applied receipt."
  const lensLimitation = "Your phone can't select the requested camera lens."
  const onPhotos = { observation: { view: "photos", revision: 2, sensitive: false, selectedObject: openPhoto } }
  const onNotes = { observation: { view: "notes", revision: 5, sensitive: false, selectedObject: { kind: "note-source", id: "phone-notes", revision: "a".repeat(64) } } }

  interface Turn {
    readonly text: string
    readonly userMessageId: string
  }
  interface Proposal {
    readonly id: string
    readonly digest: string
    readonly state: string
    readonly payload: { readonly operation: { readonly type: string } & Record<string, unknown>; readonly requestMessageId?: string }
    readonly execution?: { readonly attemptId: string }
  }

  const propose = (operation: { readonly type: string } & Readonly<Record<string, unknown>>) => ({ name: proposeTool, arguments: { operation } })
  const capture = propose({ type: "camera_capture_photo" })
  const captureFront = propose({ type: "camera_capture_photo", lens: "front" })
  const captureBack = propose({ type: "camera_capture_photo", lens: "back" })
  const savedPhoto = { version: 1, kind: "camera_capture_photo", operationId: "capture-1", mediaId: "41", libraryId: "lib:i:41:2", width: 10, height: 10, mime: "image/jpeg" }

  function offered(cloud: CloudFake, offset: number) {
    const asked = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions"))
    const body = asked[asked.length - offset]?.body as Completion | undefined
    const tools = body?.tools ?? []
    const tool = tools.find(({ function: called }) => called?.name === proposeTool)?.function
    const messages = body?.messages ?? []
    return {
      types: [...new Set(tool?.parameters?.properties?.operation?.anyOf?.flatMap((form) => form.properties?.type?.enum ?? []) ?? [])].toSorted(),
      description: tool?.description ?? "",
      views: tools.some(({ function: called }) => called?.name === "VIEWS"),
      tools: JSON.stringify(tools),
      note: JSON.stringify(messages.filter(({ role }) => role === "user").at(-1)?.content ?? ""),
      ranFirst: messages.some((said) => said.role === "assistant" && JSON.stringify(said).includes("camera_capture_photo")),
    }
  }

  function lastToolText(cloud: CloudFake): string {
    const asked = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions"))
    const messages = (asked.at(-1)?.body as Completion | undefined)?.messages ?? []
    return JSON.stringify(messages.filter(({ role }) => role === "tool").at(-1)?.content ?? "")
  }

  async function settle(client: DeviceClient, proposal: Proposal | undefined, receipt: unknown): Promise<string | undefined> {
    if (proposal === undefined) return undefined
    await client.call("POST", `/api/client-devices/proposals/${proposal.id}/decision`, { digest: proposal.digest, decision: "approve" })
    const claimed = (await client.call("POST", `/api/client-devices/proposals/${proposal.id}/claim`, { digest: proposal.digest })).json as { proposal: Proposal }
    const attemptId = claimed.proposal.execution?.attemptId ?? ""
    const settled = await client.call("POST", `/api/client-devices/proposals/${proposal.id}/receipt`, { digest: proposal.digest, attemptId, receipt })
    return (settled.json as { proposal: Proposal }).proposal.state
  }

  /** @throws {never} */
  export async function proposeSurfaces(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const client = deviceClient(socket, token, runtime.agentId, negotiated.join(","))
    await client.call("POST", "/api/client-devices/register", { capabilities: negotiated, workflowProtocol: 1 })
    const { conversation } = (await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }
    const path = `/api/conversations/${conversation.id}/messages`
    const proposals = async () => ((await client.call("GET", "/api/client-devices/proposals")).json as { proposals: readonly Proposal[] }).proposals
    const turn = async (words: string, metadata?: object) => (await client.call("POST", path, { text: words, ...(metadata === undefined ? {} : { metadata }) })).json as Turn
    const say = async (words: string, metadata?: object) => (await turn(words, metadata)).text
    const settledAgain = async (words: string, metadata: object, call: ReturnType<typeof propose>, receipt: unknown) => {
      const before = new Set((await proposals()).map(({ id }) => id))
      const gate = Promise.withResolvers<void>()
      cloud.script(toolCalls("", call), held(gate.promise, toolCalls("", call)), text("Okay."))
      const pending = turn(words, metadata)
      pending.catch(() => undefined)
      const deadline = Date.now() + 25_000
      let first: Proposal | undefined
      while (first === undefined && Date.now() < deadline) {
        first = (await proposals()).find(({ id, payload }) => !before.has(id) && payload.operation.type === call.arguments.operation.type)
      }
      const state = first === undefined ? undefined : await settle(client, first, receipt)
      gate.resolve()
      await pending
      const told = lastToolText(cloud)
      return { state, told: told.includes(settledText) && !told.includes("already") }
    }

    cloud.script(toolCalls("", capture), text("Okay."))
    const unasked = await say("Summarize the page I have open")
    const firstOffer = offered(cloud, 2)
    cloud.script(toolCalls("", capture), text("Okay."))
    const asked = await turn("Take a picture", direct)
    const photo = asked.text
    const photoTurn = offered(cloud, 2)
    cloud.script(toolCalls("", capture), text(lensLimitation))
    const selfie = await turn("Hey Eliza, could you please take a selfie?", direct)
    const selfieRefusal = lastToolText(cloud)
    cloud.script(toolCalls("", capture), text("Okay."))
    const whiteboard = await say("Take a photo of the whiteboard", direct)
    const whiteboardTurn = offered(cloud, 2)
    const captures = (await proposals()).filter(({ payload }) => payload.operation.type === "camera_capture_photo").length
    const taken = await settle(client, (await proposals()).find(({ payload }) => payload.requestMessageId === asked.userMessageId), {
      outcome: "applied", operationId: savedPhoto.operationId, result: savedPhoto,
    })
    cloud.script(toolCalls("", propose({ type: "photos_share", ids: [savedPhoto.libraryId] })), text("Okay."))
    const justTaken = await say("Share the photo you just took")
    const retaken = await settledAgain("Take a picture", direct, capture, {
      outcome: "applied", operationId: "capture-2", result: { ...savedPhoto, operationId: "capture-2", mediaId: "42", libraryId: "lib:i:42:2" },
    })

    const onMaps = { observation: { view: "maps", revision: 4, sensitive: false, selectedObject: place } }
    cloud.script(toolCalls("", propose({ type: "maps_read_selected", target: { ...place, revision: "6" } })), text("Okay."))
    const staleMaps = await say("How far is this place?", onMaps)
    cloud.script(toolCalls("", propose({ type: "maps_read_selected", target: place })), text("Okay."))
    const hiddenMaps = await say("How far is this place?", { observation: { ...onMaps.observation, sensitive: true, selectedObject: undefined } })
    cloud.script(toolCalls("", propose({ type: "maps_read_selected", target: place })), text("Okay."))
    await say("How far is this place?", onMaps)

    cloud.script(toolCalls("", propose({ type: "photos_share", selected: true })), text("Okay."))
    const notShown = await say("Share this photo", { observation: { view: "home", revision: 3, sensitive: false } })
    cloud.script(toolCalls("", propose({ type: "photos_share", selected: true })), text("Okay."))
    await say("Share this photo", onPhotos)
    cloud.script(toolCalls("", propose({ type: "photos_share", ids: ["lib:i:99:1"] })), text("Okay."))
    const guessed = await say("Share my latest photo")
    cloud.script(toolCalls("", propose({ type: "photos_open", id: openPhoto.id })), text("Okay."))
    await say("Open this one full screen", onPhotos)

    cloud.script(toolCalls("", propose({ type: "photo_library_search", kind: "image", limit: 1 })), text("Okay."))
    await say("Find my latest photo")
    const search = (await proposals()).find(({ payload }) => payload.operation.type === "photo_library_search")
    const searched = await settle(client, search, {
      outcome: "applied", operationId: "search-1", result: { kind: "photo_library_search", scope: "full", items: [found], more: false },
    })
    cloud.script(toolCalls("", propose({ type: "photo_library_review", action: "favorite", items: [{ id: found.id, revision: "rev-a1-2" }] })), text("Okay."))
    const staleRevision = await say("Favorite it")
    cloud.script(toolCalls("", propose({ type: "photo_library_review", action: "favorite", items: [{ id: found.id, revision: found.revision }] })), text("Okay."))
    await say("Favorite it")

    cloud.script(text("Opening Files."))
    await say("Show my files", direct)
    const navigating = offered(cloud, 1)
    cloud.script(toolCalls("", propose({ type: "open_view", view: "files" })), text("Okay."))
    await say("Open Files")

    cloud.script(toolCalls("", propose({ type: "create_note", title: "Milk", body: "Buy milk" })), text("Okay."))
    const fromHome = await say("Make a note to buy milk")
    const homeOffer = offered(cloud, 2)
    const homeTold = lastToolText(cloud)
    const saved = await settledAgain("Make a note to buy milk", { ...direct, ...onNotes }, propose({ type: "create_note", title: "Milk", body: "Buy milk" }), { outcome: "applied", operationId: "note-1" })
    const notesOffer = offered(cloud, 1)
    cloud.script(toolCalls("", propose({ type: "create_note", title: "Summary", body: "The page lists three deadlines in March." })), text("Okay."))
    const summarized = await say("Summarize this page into a note", { ...direct, ...onNotes })
    cloud.script(text("You saved a note called Milk."))
    await say("What did I just save?")
    const recalled = cloud.calls.filter(({ path: called }) => called.endsWith("/chat/completions")).at(-1)?.body as Completion | undefined
    const remembered = JSON.stringify(recalled?.messages?.at(-1) ?? "")

    await client.call("POST", "/api/client-devices/view-profile", { version: 1, expectedRevision: null, views: ["home", "photos"] })
    cloud.script(toolCalls("", propose({ type: "open_view", view: "settings" })), text("Okay."))
    const disabled = await say("Open Settings")
    const profiled = offered(cloud, 2)

    return {
      unasked: unasked.includes(reviewText), photo: photo.includes("Opening Camera to take the photo."),
      selfie: {
        explained: selfie.text.includes(lensLimitation),
        refused: selfieRefusal.includes("DEVICE_OPERATION_NOT_AVAILABLE_NOW") && selfieRefusal.includes("the showing lens cannot substitute for the requested lens"),
      },
      whiteboard: whiteboard.includes(reviewText), captures,
      taken, justTaken: justTaken.includes(reviewText), retaken,
      photoTurn: {
        sameTools: photoTurn.tools === firstOffer.tools, lead: photoTurn.note.includes("The owner's whole message asks for a photo now"),
        inTool: photoTurn.description.includes("asks for a photo now"), views: photoTurn.views, ranFirst: photoTurn.ranFirst,
      },
      whiteboardTurn: { allForms: whiteboardTurn.types.length > 1, views: whiteboardTurn.views },
      firstOffer: {
        types: firstOffer.types, camera: firstOffer.description.includes("camera_capture_photo takes one still image"),
        photos: firstOffer.description.includes("use the one item the owner has open in the Photos viewer instead of ids"), capabilitiesNamed: negotiated.filter((name) => firstOffer.tools.includes(name)),
      },
      staleMaps: staleMaps.includes("Select the place or route in Maps"), hiddenMaps: hiddenMaps.includes("Select the place or route in Maps"),
      notShown: notShown.includes("Open the photo in Photos first"), guessed: guessed.includes("couldn't tell which photos you meant"),
      searched, staleRevision: staleRevision.includes("couldn't tell which photos you meant"),
      navigating: {
        sameTools: navigating.tools === firstOffer.tools, openView: navigating.types.includes("open_view"),
        views: navigating.note.includes("Open app views with VIEWS (mode show) on this message"), offered: navigating.views,
      },
      notes: {
        fromHome: { quiet: fromHome === "Okay.", told: homeTold.includes("DEVICE_OPERATION_NOT_AVAILABLE_NOW"), redirected: homeTold.includes("so a request to make or save a note uses the canonical NOTES service") }, homeOffer: homeOffer.types.includes("create_note"),
        toldCanonical: homeOffer.note.includes("create_note is not available on this message: the owner's Notes screen does not select the phone's own Notes.") &&
          homeOffer.description.includes("on any other message a request to make or save a note uses the canonical NOTES service"),
        sameTools: homeOffer.tools === notesOffer.tools && homeOffer.tools === firstOffer.tools, notesNote: notesOffer.note.includes("create_note is not available"),
        notesOffer: notesOffer.types.includes("create_note"), canonical: notesOffer.description.includes("on any other message a request to make or save a note uses the canonical NOTES service"),
        summarized: summarized.includes(reviewText),
        saved, learned: remembered.includes('\\"operation\\":\\"create_note\\"') && remembered.includes('\\"label\\":\\"Milk\\"'),
      },
      profile: { refused: disabled.includes("That view isn't turned on for your phone."), told: profiled.description.includes('allows open_view only for ["home","photos"]') },
      proposed: (await proposals())
        .map(({ payload, state }) => ({ operation: payload.operation, bound: payload.requestMessageId !== undefined, state }))
        .toSorted((a, b) => a.operation.type.localeCompare(b.operation.type) || Number(a.bound) - Number(b.bound) ||
          a.state.localeCompare(b.state) || JSON.stringify(a.operation).localeCompare(JSON.stringify(b.operation))),
    }
  }

  /** @throws {never} */
  export async function navigationHomes(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const client = deviceClient(socket, token, runtime.agentId, negotiated.join(","))
    await client.call("POST", "/api/client-devices/register", { capabilities: negotiated, workflowProtocol: 1 })
    const { conversation } = (await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }
    const proposals = async () => ((await client.call("GET", "/api/client-devices/proposals")).json as { proposals: readonly Proposal[] }).proposals
    const say = async (calls: readonly { readonly name: string; readonly arguments: unknown }[], metadata?: object) => {
      const before = (await proposals()).length
      cloud.script(toolCalls("", ...calls), text("Which view?"))
      const turn = (await client.call("POST", `/api/conversations/${conversation.id}/messages`, { text: "Open my files", ...(metadata === undefined ? {} : { metadata }) })).json as Turn
      const seen = offered(cloud, 2)
      const asked = cloud.calls.filter(({ path }) => path.endsWith("/chat/completions"))
      const told = JSON.stringify(((asked.at(-1)?.body as Completion | undefined)?.messages ?? []).filter(({ role }) => role === "tool").map(({ content }) => content))
      return {
        tools: seen.tools, viewsHere: seen.note.includes("Open app views with VIEWS (mode show) on this message"),
        viewsNotHere: seen.note.includes("VIEWS cannot show a view on this message"), proposed: (await proposals()).length - before,
        refused: [told.includes("DEVICE_OPERATION_NOT_AVAILABLE_NOW") ? ["open_view"] : [], told.includes("VIEWS_NOT_ON_THIS_MESSAGE") ? ["VIEWS"] : []].flat(),
        reply: turn.text,
      }
    }
    const views = { name: "VIEWS", arguments: { action: "show", view: "files" } }
    const openView = propose({ type: "open_view", view: "files" })
    const { tools: typedTools, ...typed } = await say([views])
    const { tools: deliveredTools, ...delivered } = await say([openView], direct)
    const { tools: againTools, ...typedAgain } = await say([openView])
    const { tools: bothTools, ...wrongHomeFirst } = await say([{ name: "VIEWS", arguments: { action: "show", view: "photos" } }, propose({ type: "open_view", view: "photos" })])
    return { sameTools: new Set([typedTools, deliveredTools, againTools, bothTools]).size === 1, typed, delivered, typedAgain, wrongHomeFirst }
  }

  /** @throws {never} */
  export async function unofferedDeviceTool(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const client = deviceClient(socket, token, runtime.agentId, negotiated.join(","))
    await client.call("POST", "/api/client-devices/register", { capabilities: negotiated, workflowProtocol: 1 })
    const { conversation } = (await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }
    cloud.script(text("Okay."))
    await client.call("POST", `/api/conversations/${conversation.id}/messages`, { text: "Take a picture", metadata: direct })
    const seen = offered(cloud, 1)
    const proposals = ((await client.call("GET", "/api/client-devices/proposals")).json as { proposals: readonly Proposal[] }).proposals
    return {
      deviceTool: seen.tools.includes(`"name":"${proposeTool}"`), views: seen.views, ranFirst: seen.ranFirst, proposed: proposals.length,
      lead: seen.note.includes("asks for a photo now"), refusedViews: seen.note.includes("refused"), formNotes: seen.note.includes("not available on this message"),
    }
  }

  /** @throws {never} */
  export async function oneConversation(runtime: AgentRuntime, socket: string, token: string, cloud: CloudFake) {
    const capabilities = [...negotiated, "camera.capture-lens.v1"]
    const client = deviceClient(socket, token, runtime.agentId, capabilities.join(","))
    await client.call("POST", "/api/client-devices/register", { capabilities, workflowProtocol: 1 })
    const { conversation } = (await client.host("POST", "/api/conversations", {})).json as { conversation: { id: string } }
    const proposals = async () => ((await client.call("GET", "/api/client-devices/proposals")).json as { proposals: readonly Proposal[] }).proposals
    const completions = () => cloud.calls.filter(({ path }) => path.endsWith("/chat/completions")).map(({ body }) => body as Completion)
    const send = async (words: string, metadata: object | undefined, ...replies: CloudReply[]) => {
      const before = { asked: completions().length, proposed: (await proposals()).map(({ id }) => id) }
      cloud.script(...replies)
      const turn = (await client.call("POST", `/api/conversations/${conversation.id}/messages`, { text: words, ...(metadata === undefined ? {} : { metadata }) })).json as Turn
      const [first, ...later] = completions().slice(before.asked)
      const messages = first?.messages ?? []
      const userMessage = messages.findLastIndex(({ role }) => role === "user")
      const toolText = JSON.stringify(later.flatMap(({ messages }) => messages ?? []).filter(({ role }) => role === "tool").map(({ content }) => content))
      const fresh = (await proposals()).filter(({ id }) => !before.proposed.includes(id))
      return {
        tools: JSON.stringify(first?.tools ?? []),
        note: JSON.stringify(messages[userMessage]?.content ?? ""),
        ranFirst: messages.slice(userMessage + 1).some((said) => said.role === "assistant" && JSON.stringify(said).includes("camera_capture_photo")),
        toolText, fresh, reply: turn.text, userMessageId: turn.userMessageId,
        description: first?.tools?.find(({ function: called }) => called?.name === proposeTool)?.function?.description ?? "",
      }
    }
    const onMaps = { observation: { view: "maps", revision: 4, sensitive: false, selectedObject: place } }
    const notes = await send("What does this note say?", onNotes, text("It is empty."))
    const maps = await send("How far is this place?", onMaps, text("About a mile."))
    const sensitive = await send("What's on my screen?", { observation: { view: "maps", revision: 5, sensitive: true } }, text("I can't see it."))
    const photo = await send("Take a photo of me", direct,
      toolCalls("", capture), text("Okay."))
    const selfie = await send("Take a selfie", direct, toolCalls("", captureBack, captureFront), text("Okay."))
    const rear = await send("Take a photo with the rear camera", direct, toolCalls("", captureBack), text("Okay."))
    const reviewed = await send("Take a photo with the front camera", undefined, toolCalls("", captureFront), text("Okay."))
    const conflicting = await send("Take a photo with the front and back cameras", direct, toolCalls("", capture), text("Okay."))
    const plain = await send("What's the capital of France?", undefined, text("Paris."))
    const noteElsewhere = await send("Make a note to buy milk", { observation: { view: "home", revision: 6, sensitive: false } },
      toolCalls("", propose({ type: "create_note", title: "Milk", body: "Buy milk" })), text("Okay."))
    const noSelection = await send("How far is this place?", { observation: { view: "maps", revision: 7, sensitive: false } },
      toolCalls("", propose({ type: "maps_read_selected", target: place })), text("Okay."))
    const guessedId = await send("Open my latest photo", undefined, toolCalls("", propose({ type: "photos_open", id: "lib:i:99:1" })), text("Okay."))
    const taken = await settle(client, selfie.fresh[0], { outcome: "applied", operationId: savedPhoto.operationId, result: savedPhoto })
    const turns = [notes, maps, sensitive, photo, selfie, rear, reviewed, conflicting, plain, noteElsewhere, noSelection, guessedId]
    const everyTurn = ["Device approval outcomes can change after an earlier reply", "ordinary navigation does not need a phone approval"]
    return {
      sameTools: new Set(turns.map(({ tools }) => tools)).size,
      tail: {
        hostLabels: [...new Set(turns.map(({ note }) => note.split("Note from the agent host").length - 1))],
        outcomesNote: turns.some(({ note }) => note.includes("device request outcomes")),
        guidanceInTool: everyTurn.every((guidance) => notes.description.includes(guidance)),
        guidanceInNote: turns.some(({ note }) => everyTurn.some((guidance) => note.includes(guidance))),
      },
      offersBoth: notes.tools.includes(`"name":"${proposeTool}"`) && notes.tools.includes('"name":"VIEWS"'),
      notes: { noteHere: !notes.note.includes("create_note is not available"), viewsNotHere: notes.note.includes("VIEWS cannot show a view on this message") },
      maps: { noteNotHere: maps.note.includes("create_note is not available on this message") },
      sensitive: { noteNotHere: sensitive.note.includes("create_note is not available on this message"), viewsNotHere: sensitive.note.includes("VIEWS cannot show a view") },
      photo: {
        lead: photo.note.includes("The owner's whole message asks for a photo now"), ranFirst: photo.ranFirst,
        captured: photo.fresh.map(({ payload }) => ({ operation: payload.operation, bound: payload.requestMessageId === photo.userMessageId })),
        viewsRefused: photo.toolText.includes("ROUTE_REFUSED"), switched: photo.toolText.includes("Prepared the switch"),
        otherRefused: photo.toolText.includes("DEVICE_OPERATION_ROUTED"),
        reply: photo.reply,
      },
      lenses: {
        offered: selfie.tools.includes('"lens":'),
        selfie: {
          ranFirst: selfie.ranFirst, operations: selfie.fresh.map(({ payload }) => payload.operation),
          matched: selfie.fresh[0]?.payload.requestMessageId === selfie.userMessageId, rejectedSubstitute: selfie.toolText.includes("DEVICE_OPERATION_NOT_AVAILABLE_NOW"), taken,
        },
        rear: { ranFirst: rear.ranFirst, operations: rear.fresh.map(({ payload }) => payload.operation) },
        reviewed: {
          ranFirst: reviewed.ranFirst, reply: reviewed.reply,
          offers: reviewed.fresh.map(({ payload, state }) => ({ operation: payload.operation, bound: payload.requestMessageId !== undefined, state })),
        },
        conflicting: { ranFirst: conflicting.ranFirst, offered: conflicting.fresh.length },
      },
      plain: { noteNotHere: plain.note.includes("create_note is not available on this message"), lead: plain.note.includes("asks for a photo now") },
      refused: {
        noteElsewhere: { code: noteElsewhere.toolText.includes("DEVICE_OPERATION_NOT_AVAILABLE_NOW"), sent: noteElsewhere.fresh.length, reply: noteElsewhere.reply },
        noSelection: { code: noSelection.toolText.includes("MAPS_SELECTION_UNAVAILABLE"), sent: noSelection.fresh.length },
        guessedId: { sent: guessedId.fresh.length, reply: guessedId.reply.includes("couldn't tell which photos you meant") },
      },
    }
  }
}

import { navigationHomes, oneConversation, proposeSurfaces, proposeTool, reviewText, unofferedDeviceTool } from node

it.live(`Take a photo, open a view, read a Maps place, find and share photos and write a phone note only as the owner's words and screen name them (spec/agent/deviceActions/surfaces.md, "Story: Propose a photo, a view, a Maps read or a Photos change only as my words and my screen name them"; spec/agent/deviceActions/surfaces.md, "A surface operation is bound to the owner's message only on a direct-request turn and as the owner asked"; spec/agent/deviceActions/surfaces.md, "A photo runs without its card only when the owner's own message asks for one now"; spec/agent/deviceActions/surfaces.md, "An app view opens with VIEWS where views arrive as completed actions, else with open_view as the installation's profile enables it"; spec/agent/conversation/planning.md, "Every call of a turn is one the model chose, and a call this message serves in another place is refused before it runs and is no step of the turn"; spec/agent/deviceActions/surfaces.md, "A new note is proposed only while the owner's Notes screen selects the phone's own Notes"; spec/agent/deviceActions/surfaces.md, "A new note runs without its card only when its title and body are the owner's own words"; spec/agent/deviceActions/surfaces.md, "A Maps read names exactly the place or route selected on the owner's Maps screen"; spec/agent/deviceActions/surfaces.md, "A Photos proposal names only the item open in the viewer or library IDs the phone returned"; spec/agent/deviceActions/operations.md, "A turn targets the photo open on the owner's screen only from the Photos view, never on a sensitive screen, and names its library ID only under the library capability"; spec/agent/deviceActions/index.md, "A proposal's identity is its request message and its operation, so a repeat returns the same request"; spec/agent/deviceActions/index.md, "A proposal carries the owner's message only for a live turn that asked for it directly, so otherwise the phone shows its card"; spec/agent/deviceActions/index.md, "A later turn of the same conversation learns at most six outcomes of its own requests: what changed, and what ended without running"; spec/agent/deviceActions/operations.md, "A captured photo's library ID reaches the agent only when the request negotiated it")`, effect () => {
  const observed = try deviceJourney({ load: [deviceActionsModuleName, viewsModuleName], allowed: ["REPLY", "IGNORE", "NONE", proposeTool, "VIEWS"] }, "propose device surfaces", proposeSurfaces)
  try Effect.try(() => assert.deepStrictEqual(observed, {
    unasked: true, photo: true, selfie: { explained: true, refused: true }, whiteboard: true, captures: 2, taken: "done", justTaken: true,
    retaken: { state: "done", told: true },
    photoTurn: { sameTools: true, lead: false, inTool: false, views: true, ranFirst: false },
    whiteboardTurn: { allForms: true, views: true },
    firstOffer: {
      types: [
        "camera_capture_photo", "create_note", "maps_read_selected", "open_view", "photo_library_inspect", "photo_library_review", "photo_library_search",
        "photo_library_select", "photos_album_create", "photos_filter", "photos_open", "photos_share",
      ],
      camera: true, photos: true, capabilitiesNamed: [],
    },
    staleMaps: true, hiddenMaps: true,
    notShown: true, guessed: true,
    searched: "done", staleRevision: true,
    navigating: { sameTools: true, openView: true, views: true, offered: true },
    notes: {
      fromHome: { quiet: true, told: true, redirected: true }, homeOffer: true, toldCanonical: true, sameTools: true, notesNote: false, notesOffer: true, canonical: true, summarized: true,
      saved: { state: "done", told: true }, learned: true,
    },
    profile: { refused: true, told: true },
    proposed: [
      { operation: { type: "camera_capture_photo" }, bound: false, state: "pending" },
      { operation: { type: "camera_capture_photo" }, bound: true, state: "done" },
      { operation: { type: "camera_capture_photo" }, bound: true, state: "done" },
      { operation: { type: "create_note", title: "Summary", body: "The page lists three deadlines in March." }, bound: false, state: "pending" },
      { operation: { type: "create_note", title: "Milk", body: "Buy milk" }, bound: true, state: "done" },
      { operation: { type: "maps_read_selected", target: { kind: "map-place", id: "maps_0f8fad5b-d9cb-469f-a165-70867728950e", revision: "7" } }, bound: false, state: "pending" },
      { operation: { type: "open_view", view: "files" }, bound: false, state: "pending" },
      { operation: { type: "photo_library_review", action: "favorite", items: [{ id: "lib:i:7:1", revision: "rev-a1-1" }] }, bound: false, state: "pending" },
      { operation: { type: "photo_library_search", kind: "image", limit: 1 }, bound: false, state: "done" },
      { operation: { type: "photos_open", id: "lib:i:12:345" }, bound: false, state: "pending" },
      { operation: { type: "photos_share", ids: ["lib:i:41:2"] }, bound: false, state: "pending" },
      { operation: { type: "photos_share", selected: true }, bound: false, state: "pending" },
    ],
  }))
}, 120_000)

it.live(`A device message opens a view in one place under the same tools: VIEWS where views arrive as completed actions, open_view otherwise, and the other is refused before dispatch (spec/agent/deviceActions/surfaces.md, "An app view opens with VIEWS where views arrive as completed actions, else with open_view as the installation's profile enables it"; spec/agent/conversation/planning.md, "An action may narrow its tool to the turn, never beyond its registered form"; spec/agent/deviceActions/index.md, "A grounding refusal offers nothing and is a refusal before dispatch")`, effect () => {
  const observed = try deviceJourney({ load: [deviceActionsModuleName, viewsModuleName], allowed: ["REPLY", "IGNORE", "NONE", proposeTool, "VIEWS"] }, "offer device navigation", navigationHomes)
  try Effect.try(() => assert.deepStrictEqual(observed, {
    sameTools: true,
    typed: { viewsHere: false, viewsNotHere: true, proposed: 0, refused: ["VIEWS"], reply: "Which view?" },
    delivered: { viewsHere: true, viewsNotHere: false, proposed: 0, refused: ["open_view"], reply: "Which view?" },
    typedAgain: { viewsHere: false, viewsNotHere: true, proposed: 1, refused: [], reply: "Review this request on your phone before it can run." },
    wrongHomeFirst: { viewsHere: false, viewsNotHere: true, proposed: 1, refused: ["VIEWS"], reply: "Review this request on your phone before it can run." },
  }))
}, 120_000)

it.live(`One device conversation sends the same tools on every message, whatever its screen or words, names what applies to each message after it, and refuses before dispatch what a message does not allow (spec/agent/conversation/planning.md, "Each call of a conversation starts with the same system prompt and tools, and what changes per turn follows the history"; spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation"; spec/agent/deviceActions/index.md, "A grounding refusal offers nothing and is a refusal before dispatch"; spec/agent/conversation/planning.md, "Every call of a turn is one the model chose, and a call this message serves in another place is refused before it runs and is no step of the turn"; spec/agent/deviceActions/surfaces.md, "A new note is proposed only while the owner's Notes screen selects the phone's own Notes"; spec/agent/deviceActions/surfaces.md, "A Maps read names exactly the place or route selected on the owner's Maps screen"; spec/agent/deviceActions/surfaces.md, "A Photos proposal names only the item open in the viewer or library IDs the phone returned")`, effect () => {
  const observed = try deviceJourney({ load: [deviceActionsModuleName, viewsModuleName], allowed: ["REPLY", "IGNORE", "NONE", proposeTool, "VIEWS"] }, "one device conversation", oneConversation)
  try Effect.try(() => assert.deepStrictEqual(observed, {
    sameTools: 1,
    tail: { hostLabels: [1], outcomesNote: false, guidanceInTool: true, guidanceInNote: false },
    offersBoth: true,
    notes: { noteHere: true, viewsNotHere: true },
    maps: { noteNotHere: true },
    sensitive: { noteNotHere: true, viewsNotHere: true },
    photo: {
      lead: false, ranFirst: false, captured: [{ operation: { type: "camera_capture_photo" }, bound: true }], viewsRefused: false, switched: false, otherRefused: false,
      reply: "Opening Camera to take the photo.",
    },
    lenses: {
      offered: true,
      selfie: { ranFirst: false, operations: [{ type: "camera_capture_photo", lens: "front" }], matched: true, rejectedSubstitute: true, taken: "done" },
      rear: { ranFirst: false, operations: [{ type: "camera_capture_photo", lens: "back" }] },
      reviewed: { ranFirst: false, reply: reviewText, offers: [{ operation: { type: "camera_capture_photo", lens: "front" }, bound: false, state: "pending" }] },
      conflicting: { ranFirst: false, offered: 0 },
    },
    plain: { noteNotHere: true, lead: false },
    refused: {
      noteElsewhere: { code: true, sent: 0, reply: "Okay." },
      noSelection: { code: true, sent: 0 },
      guessedId: { sent: 0, reply: true },
    },
  }))
}, 120_000)

it.live(`A message the device tool is not offered on gets no note of it: no lead, no refusal it would not make, and nothing proposed (spec/agent/conversation/planning.md, "Every call of a turn is one the model chose, and a call this message serves in another place is refused before it runs and is no step of the turn"; spec/agent/deviceActions/index.md, "A proposal is offered only on an owner turn of the enrolled device, as its family grounded it, and re-admitted under the turn's negotiation")`, effect () => {
  const observed = try deviceJourney({ load: [deviceActionsModuleName, viewsModuleName], allowed: ["REPLY", "IGNORE", "NONE", "VIEWS"] }, "device tool not offered", unofferedDeviceTool)
  try Effect.try(() => assert.deepStrictEqual(observed, {
    deviceTool: false, views: true, ranFirst: false, proposed: 0, lead: false, refusedViews: false, formNotes: false,
  }))
}, 120_000)
