// spec/agent/tasks/index.md, "Story: Run one task operation without losing or repeating its effect"; spec/agent/tasks/index.md, "Story: Finish a task and wait for its actuator to let go"
import { assert, it } from "@effect/vitest"
import { TaskView } from "@elizaos/agent"
import { builtinModuleFactories } from "../src/plugins/profile.vibe"
import { createTaskHost, type TaskHostHandle } from "../src/tasks/host.vibe"
import { tasksModule, tasksModuleName } from "../src/tasks/module.vibe"
import type { TaskRoutesHost } from "../src/tasks/routes.vibe"
import { createTaskStore } from "../src/tasks/store.vibe"
import { call, host, scratch, startInProcess, SupportFailed, type InProcess } from "./support/kernel.vibe"
import type { LocalRequest } from "./support/socket-client.ts"
import { copyIn, sealedFor } from "./support/task-record.vibe"

module node {
  import { randomBytes } from "node:crypto"
  import { Redacted } from "effect"
  import type { InteractiveTask, TaskActionProposal, TaskObservation, TaskOutcome, TaskOwner } from "@elizaos/core"
  import { openNodeTaskDatabase, storageKeySource, type TaskDatabaseOpener } from "../src/tasks/store.vibe"
  import type { AuthorizedTaskGoal, TaskActuator, TaskCleanupReason, TaskDispatchContext, TaskGoalAuthorizer } from "../src/tasks/host.vibe"

  export const owner: TaskOwner = { agentId: "agent-1", actorId: "owner-1", connector: { source: "device", accountId: "owner-account" } }
  export const origin = "https://example.com"

  export function newKey(): string {
    return randomBytes(32).toString("base64")
  }

  export function keyFor(key: string) {
    return storageKeySource(Redacted.make(key))
  }

  export function failingDatabase() {
    let armed = false
    const open: TaskDatabaseOpener = (path) => {
      const db = openNodeTaskDatabase(path)
      return {
        exec: (sql) => db.exec(sql),
        close: () => db.close(),
        prepare(sql) {
          const statement = db.prepare(sql)
          return {
            all: (...parameters) => statement.all(...parameters),
            run: (...parameters) => {
              if (armed) throw new Error("disk full")
              return statement.run(...parameters)
            },
          }
        },
      }
    }
    return { open, arm: () => { armed = true } }
  }

  export type Behaviour = (proposal: TaskActionProposal, context: TaskDispatchContext) => Promise<TaskOutcome>

  export function fixture() {
    let clock = 1_000
    let accountId = ""
    let version = 0
    let held: (() => void) | undefined
    const behaviours: Behaviour[] = []
    const seen: { current: boolean[]; quiesced: (TaskCleanupReason | "none")[]; aborted: boolean[] } = { current: [], quiesced: [], aborted: [] }
    let failQuiesce = 0
    let readback: TaskOutcome = { status: "unknown" }
    let entered: () => void = () => undefined
    let quiescence: { readonly began: () => void; readonly release: Promise<void> } | undefined
    const actuator: TaskActuator = {
      capabilities: ["read"],
      async observe() {
        version += 1
        const observation: TaskObservation = { id: `observation-${version}`, pageId: "page-1", origin, version, inputRevision: version, observedAt: clock }
        return observation
      },
      async execute(proposal, context) {
        seen.current.push(context.isCurrent())
        const behaviour = behaviours.shift()
        if (behaviour === undefined) throw new Error("no scripted reply")
        return behaviour(proposal, context)
      },
      async reconcile(_proposal, context) {
        seen.current.push(context.isCurrent())
        return readback
      },
      async quiesce(context) {
        seen.quiesced.push(context.reason ?? "none")
        if (failQuiesce > 0) {
          failQuiesce -= 1
          throw new Error("guide still shown")
        }
        const pending = quiescence
        quiescence = undefined
        if (pending !== undefined) {
          pending.began()
          await pending.release
        }
      },
    }
    const goals: TaskGoalAuthorizer = {
      async authorize(goalRef, caller) {
        accountId = caller.connector.accountId
        const goal: AuthorizedTaskGoal = {
          id: `task-${goalRef}`, goalRef,
          authorization: { decisionId: `decision-${goalRef}`, policyRevision: "1", decidedAt: "2026-01-01T00:00:00.000Z", state: "active", revokedAt: null },
          allowedCapabilities: ["read", "write"], allowedOrigins: [origin],
        }
        return goal
      },
    }
    return {
      actuator, goals, seen,
      accountId: () => accountId,
      now: () => clock,
      advance: (by: number) => { clock += by },
      reply: (behaviour: Behaviour) => { behaviours.push(behaviour) },
      answer: (outcome: TaskOutcome): Behaviour => async () => outcome,
      lose: (): Behaviour => async () => { throw new Error("connection reset") },
      hold: (outcome: TaskOutcome): Behaviour => async (_proposal, context) => {
        await new Promise<void>((resolve) => {
          held = resolve
          entered()
        })
        seen.current.push(context.isCurrent())
        seen.aborted.push(context.signal.aborted)
        return outcome
      },
      whenEntered: () => new Promise<void>((resolve) => { entered = resolve }),
      release: () => held?.(),
      readback: (outcome: TaskOutcome) => { readback = outcome },
      failQuiesce: (times: number) => { failQuiesce = times },
      holdQuiesce: () => {
        const entered = Promise.withResolvers<void>()
        const done = Promise.withResolvers<void>()
        quiescence = { began: entered.resolve, release: done.promise }
        return { entered: entered.promise, release: done.resolve }
      },
    }
  }

  /** @throws {never} */
  export function clockOf(fx: { readonly now: () => number }): number {
    return fx.now()
  }

  export function proposal(task: InteractiveTask, id: string, now: number): TaskActionProposal {
    const observed = task.observation
    return {
      id, taskId: task.id, epoch: task.epoch, observationId: observed?.id ?? "none", observationVersion: observed?.version ?? 0,
      inputRevision: observed?.inputRevision ?? 0, targetRef: "button-1", capability: "read", authorizationId: task.authorization.decisionId, expiresAt: now + 60_000,
    }
  }

  export function operationStatuses(task: InteractiveTask | null): string[] {
    return task === null ? [] : task.operations.map((operation) => operation.status)
  }
}
import { clockOf, failingDatabase, fixture, keyFor, newKey, operationStatuses, owner, proposal } from node

effect function onSocket(running: InProcess, request: LocalRequest) {
  const reply = try call(running, request)
  if (!("status" in reply)) throw new SupportFailed({ step: request.path, cause: reply })
  return { status: reply.status, body: reply.json }
}

const get = (path: string): LocalRequest => ({ method: "GET", path })
const post = (path: string, body: unknown): LocalRequest => ({ method: "POST", path, body })
const readTask = Schema.decodeUnknownSync(Schema.Struct({ task: Schema.NullOr(TaskView) }), { onExcessProperty: "error" })
const readPage = Schema.decodeUnknownSync(Schema.Struct({
  cursor: Schema.Int, hasMore: Schema.Boolean, events: Schema.Array(Schema.Struct({ sequence: Schema.Int })),
}))
const wireCodeOf = (answer: { readonly status: number; readonly body: unknown }) =>
  [answer.status, typeof answer.body === "object" && answer.body !== null && "code" in answer.body ? answer.body.code : undefined]
const recordsOf = Schema.decodeUnknownSync(Schema.Struct({ records: Schema.Array(Schema.Struct({
  taskId: Schema.String, releasedAt: Schema.NullOr(Schema.Number), reason: Schema.String,
})) }))

it.effect('Only the launch owner can start or inspect the durable task over its socket (spec/agent/tasks/index.md, "Every task request comes from the launch account of a started host"; spec/agent/tasks/wire.md, "Only the launch account reaches a serving host, and the storage probe needs neither"; spec/agent/tasks/wire.md, "A repeated start of the running task\'s goal returns that task"; spec/agent/tasks/wire.md, "A view shows six public fields of the held task, or null"; spec/agent/tasks/wire.md, "A command body has exactly the fields its command names"; spec/agent/tasks/wire.md, "Only the event page takes a query, and its cursor is canonical"; spec/agent/tasks/wire.md, "Each route names one command and the one method it answers"; spec/agent/tasks/wire.md, "A reply after the host stopped serving says whether a change was saved")', effect () => {
  const state = try scratch("task-owner-socket")
  const frame = { storageKey: try support("task key", () => newKey()) }
  const enabled = { load: [tasksModuleName], callerRole: "owner" as const }
  const fx = try support("task helper fixture", () => fixture())
  const modules = new Map(builtinModuleFactories)
  modules.set(tasksModuleName, tasksModule({ actuator: fx.actuator, authorizer: fx.goals }))
  const running = try startInProcess({ state, cloud: true, frame, launch: enabled, modules })
  const first = try onSocket(running, get("/api/tasks/current"))
  const created = try onSocket(running, post("/api/tasks", { goalRef: "agenda" }))
  const again = try onSocket(running, post("/api/tasks", { goalRef: "agenda" }))
  const collision = try onSocket(running, post("/api/tasks", { goalRef: "another" }))
  const task = (try support("created task", () => readTask(created.body))).task
  if (task === null) throw new SupportFailed({ step: "created task", cause: created })
  const route = `/api/tasks/${task.id}`
  const attempts: readonly LocalRequest[] = [
    get(`${route}/pause`), { method: "DELETE", path: route }, post("/api/tasks/current", {}),
    get("/api/tasks/current/events"), get(`${route}/events?after=01`), get(`${route}/events?after=-2`),
    get(`${route}/events?after=${task.revision + 1}`), get(`${route}?after=0`),
    post("/api/tasks", { goalRef: "-starts-with-dash" }), post("/api/tasks", { goalRef: "agenda", reason: "close" }),
    post(`${route}/cancel`, { expectedRevision: task.revision, extra: true }),
    post(`${route}/cancel`, { expectedRevision: -1 }), post(`${route}/cancel`, { expectedRevision: 1.5 }),
    post(`${route}/cancel`, { expectedRevision: task.revision, reason: "close" }),
    post(`${route}/pause`, { expectedRevision: task.revision, reason: "open" }),
    post(`${route}/acknowledge-unreadable`, { expectedRevision: task.revision }),
    post("/api/tasks/current/pause", { expectedRevision: task.revision }),
    { ...post(`${route}/resume`, { expectedRevision: task.revision }), headers: { "content-type": "text/plain" } },
  ]
  const refusals = try Effect.forEach(attempts, (request) => onSocket(running, request))
  const unchanged = try onSocket(running, get(route))
  const unreadable = try onSocket(running, get("/api/tasks/current/unreadable"))
  const notFound = try onSocket(running, get("/api/tasks/task-none"))
  const paused = try onSocket(running, post(`${route}/pause`, { expectedRevision: task.revision, reason: "close" }))
  const stale = try onSocket(running, post(`${route}/cancel`, { expectedRevision: task.revision }))
  const page = try onSocket(running, get(`${route}/events?after=-1`))
  const pausedView = (try support("paused task", () => readTask(paused.body))).task
  const events = try support("owner event page", () => readPage(page.body))
  const later = try onSocket(running, get(`${route}/events?after=${task.revision}`))
  const laterEvents = try support("remaining owner events", () => readPage(later.body))
  try support("owner task responses", () => {
    assert.deepStrictEqual(first, { status: 200, body: { task: null } })
    assert.deepStrictEqual([created.status, again.status, again.body], [201, 200, created.body])
    assert.deepStrictEqual(Object.keys(task).sort(), ["epoch", "hasUnknownOutcome", "id", "revision", "schemaVersion", "status"])
    assert.deepStrictEqual(collision, { status: 409, body: { code: "TASK_CONFLICT" } })
    assert.deepStrictEqual(refusals.map(wireCodeOf), [
      ...Array.from({ length: 3 }, () => [405, "TASK_METHOD_NOT_ALLOWED"]), [404, "TASK_NOT_FOUND"],
      ...Array.from({ length: 14 }, () => [400, "TASK_INVALID"]),
    ])
    assert.deepStrictEqual(unchanged, { status: 200, body: created.body })
    assert.deepStrictEqual(unreadable, { status: 200, body: { records: [] } })
    assert.deepStrictEqual(notFound, { status: 404, body: { code: "TASK_NOT_FOUND" } })
    assert.deepStrictEqual(stale, { status: 409, body: { code: "TASK_CONFLICT" } })
    assert.deepStrictEqual([paused.status, pausedView?.status, pausedView?.revision, fx.seen.quiesced], [200, "paused", task.revision + 1, ["close"]])
    assert.deepStrictEqual([page.status, events.cursor, events.events.map(({ sequence }) => sequence)], [200, task.revision + 1, [task.revision, task.revision + 1]])
    assert.deepStrictEqual([later.status, laterEvents.cursor, laterEvents.hasMore, laterEvents.events.map(({ sequence }) => sequence)],
      [200, task.revision + 1, false, [task.revision + 1]])
  })
  const resumed = try onSocket(running, post(`${route}/resume`, { expectedRevision: task.revision + 1 }))
  try support("reject one actuator cleanup", () => fx.failQuiesce(1))
  const unconfirmed = try onSocket(running, post("/api/tasks/current/pause", { reason: "close" }))
  const recoveredPause = try onSocket(running, get(route))
  try support("show durable pause and retry cleanup", () => {
    assert.deepStrictEqual([resumed.status, readTask(resumed.body).task?.status], [200, "active"])
    assert.deepStrictEqual(wireCodeOf(unconfirmed), [503, "TASK_CLEANUP_UNCONFIRMED"])
    assert.deepStrictEqual([recoveredPause.status, readTask(recoveredPause.body).task?.status], [200, "paused"])
  })
  const resumedAgain = try onSocket(running, post(`${route}/resume`, { expectedRevision: task.revision + 3 }))
  try support("verify task eligible for in-flight pause", () => assert.strictEqual(readTask(resumedAgain.body).task?.status, "active"))
  const held = try support("hold the actuator cleanup", () => fx.holdQuiesce())
  const stopping = fork onSocket(running, post("/api/tasks/current/pause", { reason: "close" }))
  try host("wait for committed pause to reach the actuator", () => held.entered)
  const service = running.agent.runtime.getService(tasksModuleName)
  if (service === null) throw new SupportFailed({ step: "loaded task service", cause: tasksModuleName })
  try host("retire the live task service", () => service.stop())
  try Effect.sync(() => held.release())
  const retired = join stopping
  const afterRetirement = try onSocket(running, get("/api/tasks/current"))
  const retiredProbe = try onSocket(running, get("/api/tasks/storage"))
  try support("reply truthfully after the saved write outlived its host", () => {
    assert.deepStrictEqual(wireCodeOf(retired), [409, "TASK_ACCOUNT_CHANGED"])
    assert.deepStrictEqual(wireCodeOf(afterRetirement), [503, "TASK_UNAVAILABLE"])
    assert.deepStrictEqual(retiredProbe, { status: 200, body: { schemaVersion: 1, taskStorage: "unavailable" } })
  })
  try host("stop the owner launch", () => running.agent.stop())

  const unbound = try startInProcess({ state, cloud: true, frame, launch: { ...enabled, callerRole: "user" }, modules })
  const unboundRead = try onSocket(unbound, get(route))
  const unboundWrite = try onSocket(unbound, post("/api/tasks", { goalRef: "another" }))
  const unboundProbe = try onSocket(unbound, get("/api/tasks/storage"))
  try support("unbound supervisor responses", () => {
    const unauthorized = { status: 401, body: { code: "TASK_UNAUTHORIZED" } }
    assert.deepStrictEqual([unboundRead, unboundWrite], [unauthorized, unauthorized])
    assert.deepStrictEqual(unboundProbe, { status: 200, body: { schemaVersion: 1, taskStorage: "deferred" } })
  })
  try host("stop the unbound launch", () => unbound.agent.stop())

  const future = "task-later-build"
  try support("retain an older launch's unfamiliar task record", () => {
    const payload = sealedFor(frame.storageKey, fx.accountId(), "TaskRecord", { task: { id: future, schemaVersion: 2 }, events: [] })
    copyIn(state.file("tasks"), future, payload, false)
  })
  const reopened = try startInProcess({ state, cloud: true, frame, launch: enabled })
  const restored = try onSocket(reopened, get("/api/tasks/current"))
  const staleToken = try onSocket(reopened, { ...get(route), token: running.frame.token })
  const noHelper = try onSocket(reopened, post("/api/tasks", { goalRef: "another" }))
  const noHelperBadBody = try onSocket(reopened, post("/api/tasks", { goalRef: "" }))
  const reopenedProbe = try onSocket(reopened, get("/api/tasks/storage"))
  const futureView = try onSocket(reopened, get(`/api/tasks/${future}`))
  const heldRecords = try onSocket(reopened, get("/api/tasks/current/unreadable"))
  const accepted = try onSocket(reopened, post(`/api/tasks/${future}/acknowledge-unreadable`, {}))
  try support("resumed custody responses", () => {
    const recovered = readTask(restored.body).task
    assert.deepStrictEqual([restored.status, recovered?.id, recovered?.status], [200, task.id, "paused"])
    assert.isAbove(recovered?.epoch ?? 0, pausedView?.epoch ?? 0)
    assert.deepStrictEqual(staleToken, { status: 401, body: { error: "unauthorized" } })
    assert.deepStrictEqual(noHelper, { status: 503, body: { code: "TASK_HELPER_UNAVAILABLE" } })
    assert.deepStrictEqual(noHelperBadBody, noHelper)
    assert.deepStrictEqual(reopenedProbe, { status: 200, body: { schemaVersion: 1, taskStorage: "ok" } })
    const [record] = recordsOf(heldRecords.body).records
    const [released] = recordsOf(accepted.body).records
    assert.deepStrictEqual([wireCodeOf(futureView), heldRecords.status, record?.taskId, record?.releasedAt],
      [[409, "TASK_UNREADABLE"], 200, future, null])
    assert.deepStrictEqual([accepted.status, released?.taskId, typeof released?.releasedAt], [200, future, "number"])
  })
}, 120_000)

effect function support<A>(step: string, call: () => A) {
  return try Effect.try({ try: call, catch: (cause) => new SupportFailed({ step, cause }) })
}

effect function waitFor(step: string, call: () => Promise<void>) {
  try tryPromise({ try: call, catch: (cause) => new SupportFailed({ step, cause }) })
}

effect function code<A, E>(run: A!E) {
  const ran = try exit(run)
  return Exit.isSuccess(ran) ? "accepted" : codeOf(Cause.squash(ran.cause))
}

function codeOf(value: unknown): string {
  return typeof value === "object" && value !== null && "code" in value && typeof value.code === "string" ? value.code : "untyped"
}

effect function hostOver(directory: string, key: string, fx: ReturnType<typeof fixture>, database?: ReturnType<typeof failingDatabase>) {
  const store = try createTaskStore({ directory, keys: try support("key", () => keyFor(key)), now: () => clockOf(fx), ...(database === undefined ? {} : { database: database.open }) })
  return try createTaskHost({ store, now: () => clockOf(fx), actuator: fx.actuator, authorizer: fx.goals })
}

effect function summary(host: TaskHostHandle) {
  const state = try host.state()
  return { status: state.task.status, operation: state.task.operation.status, actuator: state.actuator.tag, cleanup: state.cleanup, poisoned: state.poisoned }
}

it.effect('An operation is recorded before it runs, a stop fences it and a lost reply stays unknown (spec/agent/tasks/index.md, "Story: Run one task operation without losing or repeating its effect")', effect () => {
  const state = try scratch("task-host")
  const directory = state.file("tasks")
  const key = try support("key", () => newKey())
  const fx = try support("fixture", () => fixture())
  const host = try hostOver(directory, key, fx)
  const routesHost: TaskRoutesHost = host

  const beforeStart = try code(host.current())
  try host.start(owner)
  const twice = try code(host.start(owner))
  const started = try host.create("errand")
  const repeated = try host.create("errand")
  const other = (try host.create("other")).reply.tag
  const taskId = started.task?.id ?? ""

  const observed = try host.observe(taskId, 0)
  const first = observed.task?.revision ?? 0
  try support("script success", () => fx.reply(fx.answer({ status: "succeeded", evidenceRef: "receipt-1" })))
  const succeeded = try host.execute(taskId, first, try support("proposal", () => proposal(observed.task!, "operation-1", fx.now())))
  const presented = try host.presentationForConversation({ taskId, expectedEpoch: succeeded?.epoch ?? -1, actorId: owner.actorId })
  const stranger = try host.presentationForConversation({ taskId, expectedEpoch: succeeded?.epoch ?? -1, actorId: "someone-else" })

  try support("script hold", () => fx.reply(fx.hold({ status: "succeeded", evidenceRef: "late-receipt" })))
  const entered = try support("entered", () => fx.whenEntered())
  const running = fork host.execute(taskId, succeeded?.revision ?? 0, try support("proposal", () => proposal(succeeded!, "operation-2", fx.now())))
  try waitFor("actuator entered", () => entered)
  const whileRunning = try summary(host)
  const busy = try code(host.observe(taskId, (try host.state()).task.revision))
  const paused = try host.pause(taskId, (try host.state()).task.revision)
  const retired = try host.presentationForConversation({ taskId, expectedEpoch: succeeded?.epoch ?? -1, actorId: owner.actorId })
  try support("release", () => fx.release())
  const late = join running
  const afterLate = try summary(host)

  try support("readback", () => fx.readback({ status: "succeeded", evidenceRef: "readback-1" }))
  const settled = try host.reconcile(taskId, paused.task?.revision ?? 0)
  const resumed = try host.resume(taskId, settled.task?.revision ?? 0)
  try support("script lost", () => fx.reply(fx.lose()))
  const lostReply = try host.execute(taskId, resumed.task?.revision ?? 0, try support("proposal", () => proposal(resumed.task!, "operation-3", fx.now())))
  try support("script missing evidence", () => fx.reply(fx.answer({ status: "succeeded", evidenceRef: "receipt-4" })))
  const blockedRun = try code(host.execute(taskId, lostReply?.revision ?? 0, try support("proposal", () => proposal(lostReply!, "operation-4", fx.now()))))
  const holdingSlot = (try host.create("other")).reply
  const stillAuthorized = try code(host.acknowledgeUnknown(taskId, lostReply?.revision ?? 0))
  const revoked = try host.revoke(taskId, lostReply?.revision ?? 0)
  const accepted = try host.acknowledgeUnknown(taskId, revoked.task?.revision ?? 0)
  const afterAccept = try summary(host)
  const next = try host.create("other")
  const page = try host.events(taskId, -1)

  try Effect.try(() => {
    assert.strictEqual(typeof routesHost.storageProbe, "function")
    assert.deepStrictEqual({ beforeStart, twice, other }, { beforeStart: "TASK_UNAVAILABLE", twice: "TASK_CONFLICT", other: "StartRefused" })
    assert.deepStrictEqual([started.reply.tag, repeated.reply.tag, repeated.task?.id], ["NewTask", "ExistingTask", taskId])
    assert.deepStrictEqual([succeeded?.status, operationStatuses(succeeded)], ["active", ["succeeded"]])
    assert.deepStrictEqual([presented.tag, stranger.tag, retired.tag], ["Presented", "PresentationRefused", "PresentationRefused"])
    assert.deepStrictEqual(whileRunning, { status: "Waiting", operation: "Dispatched", actuator: "Executing", cleanup: "CleanupDone", poisoned: false })
    assert.strictEqual(busy, "TASK_BUSY")
    assert.deepStrictEqual([paused.task?.status, operationStatuses(paused.task), paused.cleanupConfirmed], ["paused", ["succeeded", "unknown"], true])
    assert.deepStrictEqual([late?.status, operationStatuses(late), late?.revision], ["paused", ["succeeded", "unknown"], paused.task?.revision])
    assert.deepStrictEqual(afterLate, { status: "Paused", operation: "Unknown", actuator: "ActuatorIdle", cleanup: "CleanupDone", poisoned: false })
    assert.deepStrictEqual([settled.task?.status, operationStatuses(settled.task)], ["paused", ["succeeded", "succeeded"]])
    assert.deepStrictEqual([resumed.task?.status, lostReply?.status, operationStatuses(lostReply)], ["active", "blocked", ["succeeded", "succeeded", "unknown"]])
    assert.deepStrictEqual({ blockedRun, holdingSlot, stillAuthorized }, { blockedRun: "TASK_NOT_ACTIVE", holdingSlot: { tag: "StartRefused", error: "TaskStateConflict" }, stillAuthorized: "TASK_CONFLICT" })
    assert.deepStrictEqual([revoked.task?.status, revoked.task?.authorization.state, accepted.task?.status], ["paused", "revoked", "cancelled"])
    assert.deepStrictEqual(afterAccept, { status: "Cancelled", operation: "Unknown", actuator: "ActuatorIdle", cleanup: "CleanupDone", poisoned: false })
    assert.deepStrictEqual([next.reply.tag, next.task?.goalRef], ["NewTask", "other"])
    assert.deepStrictEqual(fx.seen.current, [true, true, false, true, true])
    assert.deepStrictEqual(fx.seen.aborted, [true])
    assert.deepStrictEqual(fx.seen.quiesced, ["pause", "none", "revoke", "cancel"])
    assert.deepStrictEqual([page.cursor, page.hasMore, page.events.map((event) => event.kind).slice(0, 4)], [page.task.revision, false, ["create", "observe", "prepare", "dispatch"]])
  })
})

it.effect('A storage failure poisons the host and a restart pauses the dispatch it left (spec/agent/tasks/index.md, "A storage failure poisons the host until the agent restarts")', effect () => {
  const state = try scratch("task-host-poison")
  const directory = state.file("tasks")
  const key = try support("key", () => newKey())
  const fx = try support("fixture", () => fixture())
  const database = try support("database", () => failingDatabase())
  const host = try hostOver(directory, key, fx, database)
  try host.start(owner)
  const started = try host.create("errand")
  const taskId = started.task?.id ?? ""
  const observed = try host.observe(taskId, 0)
  try support("script failure", () => fx.reply(async () => {
    database.arm()
    return { status: "succeeded", evidenceRef: "receipt-1" }
  }))
  const failed = try code(host.execute(taskId, observed.task?.revision ?? 0, try support("proposal", () => proposal(observed.task!, "operation-1", fx.now()))))
  const poisoned = try summary(host)
  const refusedRead = try code(host.current())
  const probe = try host.storageProbe()
  try host.close()

  const restarted = try hostOver(directory, key, fx)
  const notYet = try code(restarted.current())
  const recovered = try restarted.start(owner)
  const afterRestart = try summary(restarted)
  const resumedWithUnknown = try code(restarted.resume(taskId, recovered?.revision ?? 0))

  try Effect.try(() => {
    assert.strictEqual(failed, "TASK_STORAGE_UNAVAILABLE")
    assert.deepStrictEqual(poisoned, { status: "Waiting", operation: "Dispatched", actuator: "ActuatorIdle", cleanup: "CleanupDone", poisoned: true })
    assert.deepStrictEqual({ refusedRead, notYet }, { refusedRead: "TASK_UNAVAILABLE", notYet: "TASK_UNAVAILABLE" })
    assert.strictEqual(typeof probe, "string")
    assert.deepStrictEqual([recovered?.status, recovered?.epoch, operationStatuses(recovered)], ["paused", (observed.task?.epoch ?? 0) + 1, ["unknown"]])
    assert.deepStrictEqual(afterRestart, { status: "Paused", operation: "Unknown", actuator: "ActuatorIdle", cleanup: "CleanupDone", poisoned: false })
    assert.strictEqual(resumedWithUnknown, "TASK_UNKNOWN_OUTCOME")
    assert.deepStrictEqual(fx.seen.quiesced, ["none"])
  })
})

it.effect('A completed task waits for the actuator to confirm its cleanup (spec/agent/tasks/index.md, "Story: Finish a task and wait for its actuator to let go")', effect () => {
  const state = try scratch("task-host-complete")
  const fx = try support("fixture", () => fixture())
  const host = try hostOver(state.file("tasks"), try support("key", () => newKey()), fx)
  try host.start(owner)
  const started = try host.create("errand")
  const taskId = started.task?.id ?? ""
  try support("quiesce fails once", () => fx.failQuiesce(1))
  const completed = try host.complete(taskId, 0)
  const unconfirmed = try summary(host)
  const current = try host.current()
  const confirmed = try summary(host)
  const again = try code(host.complete(taskId, completed.task?.revision ?? 0))

  try Effect.try(() => {
    assert.deepStrictEqual([completed.task?.status, completed.saved, completed.cleanupConfirmed], ["completed", true, false])
    assert.deepStrictEqual(unconfirmed, { status: "Completed", operation: "Empty", actuator: "ActuatorIdle", cleanup: "QuiesceFailed", poisoned: false })
    assert.strictEqual(current, null)
    assert.deepStrictEqual(confirmed, { status: "Completed", operation: "Empty", actuator: "ActuatorIdle", cleanup: "CleanupDone", poisoned: false })
    assert.strictEqual(again, "TASK_ENDED")
    assert.deepStrictEqual(fx.seen.quiesced, ["complete", "complete"])
  })
})
