{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker", "DOM", "DOM.Iterable"],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["@cloudflare/workers-types", "node", "bun-types"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@/api-app/*": ["./src/*"],
      "@/api-queue/*": ["./src/queue/*"],
      "@/lib/*": ["../shared/src/lib/*"],
      "@/db/*": ["../shared/src/db/*"],
      "@/types/*": ["../shared/src/types/*"],
      "@/billing/*": ["../shared/src/billing/*"],
      "@/api/*": ["./*"],
      "@elizaos/cloud-shared/db/*": ["../shared/src/db/*"],
      "@elizaos/cloud-shared/lib/*": ["../shared/src/lib/*"],
      "@elizaos/cloud-shared/types/*": ["../shared/src/types/*"],
      "@elizaos/cloud-sdk/*": ["../sdk/src/*"],
      "@elizaos/core/*": ["../../../packages/core/src/*"],
      "@elizaos/plugin-elizacloud": [
        "../../../plugins/plugin-elizacloud/src/index.ts"
      ],
      "@elizaos/plugin-elizacloud/*": [
        "../../../plugins/plugin-elizacloud/src/*"
      ],
      "@/*": ["../shared/*"]
    }
  },
  "include": [
    "../scripts/api/**/*.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "../shared/src/db/**/*.ts",
    "../shared/src/types/**/*"
  ],
  "exclude": ["node_modules", "../../../node_modules"]
}
