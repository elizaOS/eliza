// spec/cloud/identity/secondFactor.md, "Story: Finish sign-in with my second factor"; spec/cloud/identity/secondFactor.md, "Story: Set up and change my second factor"; spec/cloud/identity/secondFactor.md, "Story: Confirm it is me before a sensitive change"
import { assert, describe, it } from "@effect/vitest"
import { afterFirstFactor } from "../../src/identity/second-factor.vibe"
import { s256, secretText } from "../../src/shared/credential-crypto.vibe"
import { authenticatorCode } from "../support/authenticator.ts"
import { check, testCloud, type Answer, type TestCloud } from "../support/cloud.vibe"
import { signedIn } from "../support/identity-fixture.ts"
import { latestCode } from "../support/inbox.ts"

interface Enrolled {
  readonly secret: string
  readonly otpauthUri: string
  readonly expiresAt: number
}

interface Challenge {
  readonly status: string
  readonly challengeId: string
  readonly methods: ReadonlyArray<string>
  readonly expiresAt: number
}

function refusal(answer: Answer): string {
  const body = answer.body as { readonly error?: string; readonly reason?: string }
  return `${answer.status} ${body.error}${body.reason === undefined ? "" : ` ${body.reason}`}`
}

effect function asOwner(cloud: TestCloud, token: string, path: string, json?: unknown, method?: string) {
  return try cloud.call(path, { method, headers: { authorization: `Bearer ${token}` }, json })
}

effect function signInAgain(cloud: TestCloud, email: string) {
  const now = try Clock.currentTimeMillis
  return try cloud.store.transaction(effect (tx) => {
    const row = (try tx.query("SELECT key, organization_id FROM accounts WHERE email = $1", [email]))[0]
    return try afterFirstFactor(tx, { userId: String(row?.key), organizationId: String(row?.organization_id), email, created: false }, "test-client", now)
  })
}

effect function enrollTotp(cloud: TestCloud, token: string) {
  const enrolled = (try asOwner(cloud, token, "/api/v1/auth/mfa/totp/enroll", {})).body as Enrolled
  const now = try Clock.currentTimeMillis
  const confirmed = try asOwner(cloud, token, "/api/v1/auth/mfa/totp/confirm", { code: try sync(() => authenticatorCode(enrolled.secret, now)) })
  return { enrolled, confirmed, confirmedAt: now }
}

describe("WP1 Identity: second factor", () => {
  it.live("Finish sign-in with my second factor (spec/cloud/identity/secondFactor.md, \"Story: Finish sign-in with my second factor\"; spec/cloud/identity/secondFactor.md, \"Story: Set up and change my second factor\")", () => scoped(effect {
    const cloud = try testCloud()
    const first = try signedIn(cloud, "ada@example.com")
    const empty = try asOwner(cloud, first.accessToken, "/api/v1/auth/mfa")
    const { enrolled, confirmed, confirmedAt } = try enrollTotp(cloud, first.accessToken)
    try check(() => assert.deepStrictEqual(
      [empty.status, empty.body, enrolled.otpauthUri.startsWith("otpauth://totp/Test%20Cloud%3Aada%40example.com?secret="), confirmed.status, (confirmed.body as { factors: unknown }).factors],
      [200, { factors: [], stepUpAt: null, mfaAt: null }, true, 200, [{ id: "totp", method: "totp", status: "confirmed" }]]
    ))

    const opened = (try signInAgain(cloud, "ada@example.com")) as Challenge
    const replaced = (try signInAgain(cloud, "ada@example.com")) as Challenge
    const stale = try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: opened.challengeId, method: "totp", code: try sync(() => authenticatorCode(enrolled.secret, confirmedAt, 1)) } })
    const replayed = try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: replaced.challengeId, method: "totp", code: try sync(() => authenticatorCode(enrolled.secret, confirmedAt)) } })
    const completed = try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: replaced.challengeId, method: "totp", code: try sync(() => authenticatorCode(enrolled.secret, confirmedAt, 1)) } })
    const again = try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: replaced.challengeId, method: "totp", code: try sync(() => authenticatorCode(enrolled.secret, confirmedAt, 1)) } })
    const session = completed.body as { status: string; accessToken: string; mfaAt: number | null }
    const read = try asOwner(cloud, session.accessToken, "/api/v1/auth/mfa")
    try check(() => assert.deepStrictEqual(
      {
        opened: [opened.status, opened.methods, replaced.expiresAt === opened.expiresAt, replaced.challengeId !== opened.challengeId],
        stale: refusal(stale),
        replayed: refusal(replayed),
        completed: [completed.status, session.status, typeof session.mfaAt === "number" && session.mfaAt >= confirmedAt],
        again: refusal(again),
        read: [read.status, (read.body as { mfaAt: number | null }).mfaAt === session.mfaAt]
      },
      {
        opened: ["mfa_required", ["totp"], true, true],
        stale: "401 authentication_required credential_unknown",
        replayed: "401 credential_proof_invalid",
        completed: [200, "signed_in", true],
        again: "401 authentication_required credential_unknown",
        read: [200, true]
      }
    ))
  }))

  it.live("Five wrong codes lock the login challenge (spec/cloud/identity/secondFactor.md, \"Story: Finish sign-in with my second factor\")", () => scoped(effect {
    const cloud = try testCloud()
    const first = try signedIn(cloud, "ada@example.com")
    const { enrolled, confirmedAt } = try enrollTotp(cloud, first.accessToken)
    const locking = (try signInAgain(cloud, "ada@example.com")) as Challenge
    const wrong: Array<string> = []
    for (let attempt = 0; attempt < 5; attempt += 1) {
      wrong.push(refusal(try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: locking.challengeId, method: "totp", code: "000000" } })))
    }
    const rightButLocked = try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: locking.challengeId, method: "totp", code: try sync(() => authenticatorCode(enrolled.secret, confirmedAt, 1)) } })
    try check(() => assert.deepStrictEqual(
      [...wrong, refusal(rightButLocked)],
      [...Array(4).fill("401 credential_proof_invalid"), "403 access_denied challenge_locked", "403 access_denied challenge_locked"]
    ))
  }))

  it.live("Confirm it is me before a sensitive change (spec/cloud/identity/secondFactor.md, \"Story: Confirm it is me before a sensitive change\"; spec/cloud/identity/sessions.md, \"Story: Confirm it is me before a sensitive change\")", () => scoped(effect {
    const cloud = try testCloud()
    const first = try signedIn(cloud, "ada@example.com")
    const token = first.accessToken
    const unprotected = try asOwner(cloud, token, "/api/v1/auth/mfa/sms", undefined, "DELETE")
    const { enrolled, confirmedAt } = try enrollTotp(cloud, token)
    const unsteppedSetup = try asOwner(cloud, token, "/api/v1/auth/mfa/totp/enroll", {})
    const wrong = try asOwner(cloud, token, "/api/v1/auth/mfa/step-up", { method: "totp", code: "000000" })
    const stepped = try asOwner(cloud, token, "/api/v1/auth/mfa/step-up", { method: "totp", code: try sync(() => authenticatorCode(enrolled.secret, confirmedAt, 1)) })
    const marks = stepped.body as { stepUpAt: number; mfaAt: number }
    const read = try asOwner(cloud, token, "/api/v1/auth/mfa")
    const secondSetup = try asOwner(cloud, token, "/api/v1/auth/mfa/totp/enroll", {})
    const removed = try asOwner(cloud, token, "/api/v1/auth/mfa/totp", undefined, "DELETE")
    const afterRemoval = (try signInAgain(cloud, "ada@example.com")) as { status: string }
    try check(() => assert.deepStrictEqual(
      {
        unprotected: refusal(unprotected),
        unsteppedSetup: refusal(unsteppedSetup),
        secondSetup: refusal(secondSetup),
        wrong: refusal(wrong),
        stepped: [stepped.status, marks.stepUpAt === marks.mfaAt && marks.stepUpAt >= confirmedAt],
        read: read.body,
        removed: [removed.status, (removed.body as { factors: unknown }).factors],
        afterRemoval: afterRemoval.status
      },
      {
        unprotected: "428 fresh_session_required",
        unsteppedSetup: "428 fresh_session_required",
        secondSetup: "400 invalid_request",
        wrong: "401 credential_proof_invalid",
        stepped: [200, true],
        read: { factors: [{ id: "totp", method: "totp", status: "confirmed" }], stepUpAt: marks.stepUpAt, mfaAt: marks.mfaAt },
        removed: [200, []],
        afterRemoval: "signed_in"
      }
    ))
  }))

  it.live("An email code sign-in asks for the second factor and a TOTP finishes it once (spec/cloud/identity/secondFactor.md, \"Story: Finish sign-in with my second factor\")", () => scoped(effect {
    const cloud = try testCloud()
    const first = try signedIn(cloud, "lin@example.com")
    const { enrolled, confirmedAt } = try enrollTotp(cloud, first.accessToken)
    const verifier = secretText("", 32, "base64url")
    const sent = try cloud.call("/api/v1/auth/email/code/send", { json: { email: "lin@example.com", clientId: "app.test", codeChallenge: s256(verifier), codeChallengeMethod: "S256" } })
    const code = try latestCode(cloud, "lin@example.com")
    const verified = try cloud.call("/api/v1/auth/email/code/verify", { json: { email: "lin@example.com", code, clientId: "app.test", codeVerifier: verifier } })
    const challenge = verified.body as Challenge
    const totp = try sync(() => authenticatorCode(enrolled.secret, confirmedAt, 1))
    const completed = try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: challenge.challengeId, method: "totp", code: totp } })
    const reopened = (try signInAgain(cloud, "lin@example.com")) as Challenge
    const replayedStep = try cloud.call("/api/v1/auth/mfa/complete", { json: { challengeId: reopened.challengeId, method: "totp", code: totp } })
    const session = completed.body as { status: string; user: { email: string }; mfaAt: number | null }
    try check(() => assert.deepStrictEqual(
      {
        sent: sent.status,
        challenge: [verified.status, challenge.status, challenge.methods, challenge.expiresAt > confirmedAt],
        completed: [completed.status, session.status, session.user.email, typeof session.mfaAt === "number"],
        replayedStep: refusal(replayedStep)
      },
      {
        sent: 200,
        challenge: [200, "mfa_required", ["totp"], true],
        completed: [200, "signed_in", "lin@example.com", true],
        replayedStep: "401 credential_proof_invalid"
      }
    ))
  }))

  it.live("An SMS step-up on a live session keeps the token and reports stepUpAt (spec/cloud/identity/secondFactor.md, \"Story: Confirm it is me before a sensitive change\"; spec/cloud/identity/sessions.md, \"Story: Confirm it is me before a sensitive change\")", () => scoped(effect {
    const cloud = try testCloud()
    const phone = "+15555550123"
    const first = try signedIn(cloud, "sam@example.com")
    const token = first.accessToken
    const enrolled = try asOwner(cloud, token, "/api/v1/auth/mfa/sms/enroll", { phone })
    const setupCode = try latestCode(cloud, phone)
    const confirmed = try asOwner(cloud, token, "/api/v1/auth/mfa/sms/confirm", { code: setupCode })
    const sentStepUp = try asOwner(cloud, token, "/api/v1/auth/mfa/sms/send", {})
    const stepUpCode = try latestCode(cloud, phone)
    const stepped = try asOwner(cloud, token, "/api/v1/auth/mfa/step-up", { method: "sms", code: stepUpCode })
    const reused = try asOwner(cloud, token, "/api/v1/auth/mfa/step-up", { method: "sms", code: stepUpCode })
    const marks = stepped.body as { stepUpAt: number; mfaAt: number; accessToken?: string }
    const read = try asOwner(cloud, token, "/api/v1/auth/mfa")
    try check(() => assert.deepStrictEqual(
      {
        enrolled: enrolled.status,
        confirmed: [confirmed.status, (confirmed.body as { factors: unknown }).factors],
        sentStepUp: sentStepUp.status,
        stepped: [stepped.status, typeof marks.stepUpAt === "number", marks.accessToken],
        reused: refusal(reused),
        read: [read.status, read.body]
      },
      {
        enrolled: 200,
        confirmed: [200, [{ id: "sms", method: "sms", status: "confirmed" }]],
        sentStepUp: 200,
        stepped: [200, true, undefined],
        reused: "401 credential_proof_invalid",
        read: [200, { factors: [{ id: "sms", method: "sms", status: "confirmed" }], stepUpAt: marks.stepUpAt, mfaAt: marks.mfaAt }]
      }
    ))
  }))
})
