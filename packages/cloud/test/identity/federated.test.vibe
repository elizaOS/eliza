// spec/cloud/identity/federatedSignIn.md, "Story: Sign in with Google in the browser"; spec/cloud/identity/federatedSignIn.md, "Story: Sign in with the device's Google account"; spec/cloud/identity/federatedSignIn.md, "A callback returns a one-minute code only after Google's verified identity and the code are stored, and otherwise one error of the closed list"
import { assert, describe, it } from "@effect/vitest"
import { decodeRegistration, registerClient } from "../../src/native-clients/registry.vibe"
import type { Tx } from "../../src/store/connection.vibe"
import { check, testCloud, type Answer, type TestCloud } from "../support/cloud.vibe"
import { fragment, googleIdentityFake, visit } from "../support/google-identity-fake.ts"
import { s256 } from "../support/identity-fixture.ts"
import { manualClock } from "../support/clock.ts"
import { secrets } from "../support/profile.ts"

const web = "https://www.staging.example.com"
const signInReturn = `${web}/apps/one/sign-in`
const app = {
  clientId: "com.example.one", environment: "staging", displayName: "One", androidPackage: "com.example.one",
  certFingerprints: ["E3:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"],
  signInReturn, billingReturn: `${web}/apps/one/billing`, credentialTtlMs: 30 * 86_400_000, nativeGoogle: true, enabled: true
}
const verifier = "v".repeat(43)

function refusal(answer: Answer): string {
  const body = answer.body as { readonly error?: string; readonly reason?: string }
  return `${answer.status} ${body.error}${body.reason === undefined ? "" : ` ${body.reason}`}`
}

effect function googleCloud() {
  const google = try Effect.try(() => googleIdentityFake(secrets.GOOGLE_CLIENT_SECRET ?? ""))
  const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", google.handler) })
  const now = try Clock.currentTimeMillis
  try cloud.inside(cloud.store.transaction(effect (tx: Tx) => { try registerClient(tx, try decodeRegistration(app), now) }))
  return { cloud, google }
}

function authorizePath(fields: Readonly<Record<string, string>>): string {
  return `/api/v1/auth/google/authorize?${new URLSearchParams({
    response_type: "code", client_id: app.clientId, environment: "staging", redirect_uri: signInReturn,
    code_challenge: s256(verifier), code_challenge_method: "S256", state: "app-state-1", ...fields
  })}`
}

effect function throughGoogle(cloud: TestCloud, fields: Readonly<Record<string, string>> = {}) {
  const authorized = try tryPromise(() => visit(`${cloud.url}${authorizePath(fields)}`))
  const consented = try tryPromise(() => visit(authorized.location))
  const callback = new URL(consented.location)
  return { authorized, callbackPath: `${callback.pathname}${callback.search}` }
}

effect function exchange(cloud: TestCloud, code: string, fields: Readonly<Record<string, string>> = {}) {
  return try cloud.call("/api/v1/auth/google/exchange", { json: { code, redirectUri: signInReturn, clientId: app.clientId, codeVerifier: verifier, ...fields } })
}

describe("WP1 Identity: Google sign-in", () => {
  it.live("Sign in with Google in the browser: the code comes back in the fragment, a wrong binding keeps it, the right one signs in once (spec/cloud/identity/federatedSignIn.md, \"Story: Sign in with Google in the browser\"; spec/cloud/identity/federatedSignIn.md, \"A code is redeemed once, while live, only with its own return and verifier, and starts a session or a second-factor challenge, never both\")", () => scoped(effect {
    const { cloud, google } = try googleCloud()
    const plain = try tryPromise(() => visit(`${cloud.url}${authorizePath({ code_challenge_method: "plain" })}`))
    const foreignReturn = try tryPromise(() => visit(`${cloud.url}${authorizePath({ redirect_uri: `${web}/apps/other/sign-in` })}`))
    const { authorized, callbackPath } = try throughGoogle(cloud)
    const googleUrl = new URL(authorized.location)
    const returned = try tryPromise(() => visit(`${cloud.url}${callbackPath}`))
    const back = fragment(returned.location)
    const code = back.get("code") ?? ""
    const wrongVerifier = try exchange(cloud, code, { codeVerifier: "w".repeat(43) })
    const wrongReturn = try exchange(cloud, code, { redirectUri: `${web}/apps/one/billing` })
    const signed = try exchange(cloud, code)
    const replayed = try exchange(cloud, code)
    const session = signed.body as { status: string; accountCreated: boolean; user: { email: string }; accessToken: string }
    const me = try cloud.call("/api/v1/user", { headers: { authorization: `Bearer ${session.accessToken}` } })
    const sent = google.tokenRequests[0]
    try check(() => assert.deepStrictEqual(
      {
        refused: [plain.status, foreignReturn.status],
        toGoogle: [authorized.status, googleUrl.pathname, googleUrl.searchParams.get("code_challenge_method"), googleUrl.searchParams.get("client_id"), googleUrl.searchParams.get("redirect_uri")],
        back: [returned.status, returned.location.startsWith(`${signInReturn}#`), back.get("state"), code.length > 0],
        tokenRequest: [google.tokenRequests.length, sent?.get("client_id"), (sent?.get("code_verifier") ?? "").length >= 43 && sent?.get("code_verifier") !== verifier],
        refusals: [refusal(wrongVerifier), refusal(wrongReturn)],
        signed: [signed.status, session.status, session.accountCreated, session.user.email],
        replayed: refusal(replayed),
        me: [me.status, (me.body as { data: { email: string } }).data.email]
      },
      {
        refused: [400, 400],
        toGoogle: [302, "/google/accounts", "S256", "google-web-client", "https://api.staging.example.com/api/v1/auth/google/callback"],
        back: [302, true, "app-state-1", true],
        tokenRequest: [1, "google-web-client", true],
        refusals: ["401 credential_proof_invalid", "401 credential_proof_invalid"],
        signed: [200, "signed_in", true, "person@example.com"],
        replayed: "401 authentication_required credential_unknown",
        me: [200, "person@example.com"]
      }
    ))
  }))

  it.live("A replayed callback state answers oauth_state_consumed, and a refusal by the person answers access_denied (spec/cloud/identity/federatedSignIn.md, \"A callback returns a one-minute code only after Google's verified identity and the code are stored, and otherwise one error of the closed list\")", () => scoped(effect {
    const { cloud, google } = try googleCloud()
    const { callbackPath } = try throughGoogle(cloud)
    const first = try tryPromise(() => visit(`${cloud.url}${callbackPath}`))
    const replayed = try tryPromise(() => visit(`${cloud.url}${callbackPath}`))
    try check(() => google.denyNext())
    const denied = try throughGoogle(cloud, { state: "app-state-2" })
    const deniedBack = try tryPromise(() => visit(`${cloud.url}${denied.callbackPath}`))
    const unknown = try tryPromise(() => visit(`${cloud.url}/api/v1/auth/google/callback?code=x&state=never-issued`))
    const unknownBody = try Effect.try(() => JSON.parse(unknown.body) as { readonly error?: string })
    try check(() => assert.deepStrictEqual(
      {
        first: fragment(first.location).has("code"),
        replayed: [replayed.status, replayed.location.startsWith(`${signInReturn}#`), fragment(replayed.location).get("error"), fragment(replayed.location).get("state")],
        denied: [deniedBack.status, fragment(deniedBack.location).get("error"), fragment(deniedBack.location).get("state")],
        unknown: [unknown.status, unknown.location, unknownBody.error],
        tokenRequests: google.tokenRequests.length
      },
      {
        first: true,
        replayed: [302, true, "oauth_state_consumed", "app-state-1"],
        denied: [302, "access_denied", "app-state-2"],
        unknown: [400, "", "oauth_state_invalid"],
        tokenRequests: 1
      }
    ))
  }))

  it.live("A native challenge needs S256 and a registered return, answers a nonce for five minutes, and refuses an address over its limit (spec/cloud/identity/federatedSignIn.md, \"Story: Sign in with the device's Google account\"; spec/cloud/identity/federatedSignIn.md, \"A client address may call the Google sign-in routes 30 times a minute, and over that is refused before anything is stored\")", () => scoped(effect {
    const clock = try sync(() => manualClock())
    try sync(() => clock.set(Math.floor(Date.now() / 60_000) * 60_000))
    provide Clock.Clock = clock.clock {
      const { cloud } = try googleCloud()
      const fields = { clientId: app.clientId, environment: "staging", redirectUri: signInReturn, codeChallenge: s256(verifier), codeChallengeMethod: "S256" }
      const startedAt = try Clock.currentTimeMillis
      const opened = try cloud.call("/api/v1/auth/google/native/challenge", { json: fields })
      const plain = try cloud.call("/api/v1/auth/google/native/challenge", { json: { ...fields, codeChallengeMethod: "plain" } })
      const wrongReturn = try cloud.call("/api/v1/auth/google/native/challenge", { json: { ...fields, redirectUri: app.billingReturn } })
      const body = opened.body as { challengeId: string; nonce: string; serverClientId: string; expiresAt: number }
      const withinLimit: Array<number> = []
      for (let call = 4; call <= 30; call++) withinLimit.push((try cloud.call("/api/v1/auth/google/native/challenge", { json: fields })).status)
      const attempts = effect { return (try cloud.inside(cloud.store.transaction((tx: Tx) => tx.query("SELECT count(*)::int AS n FROM oauth_attempts", [])))).at(0)?.n }
      const storedBefore = try attempts
      const overLimit = try cloud.call("/api/v1/auth/google/native/challenge", { json: fields })
      const storedAfter = try attempts
      try check(() => assert.deepStrictEqual(
        {
          opened: [opened.status, /^[0-9a-f]{64}$/.test(body.nonce), body.serverClientId, body.expiresAt >= startedAt + 5 * 60_000 && body.expiresAt <= Date.now() + 5 * 60_000],
          refused: [refusal(plain), refusal(wrongReturn)],
          withinLimit: withinLimit.every((status) => status === 200),
          overLimit: [refusal(overLimit), storedAfter === storedBefore]
        },
        {
          opened: [200, true, "google-server-client", true],
          refused: ["400 invalid_request", "400 redirect_mismatch"],
          withinLimit: true,
          overLimit: ["429 rate_limited", true]
        }
      ))
    }
  }), 120_000)
})
