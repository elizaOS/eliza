// spec/cloud/identity/codeChallenges.md, "A challenge sends one code, only to an email address or to a phone in a country the deployment allows"; spec/cloud/deployment.md, "An instance starts only for an accepted profile, on its environment's own readable database, seeded only in staging, with loopback delivery only on PGlite"
import { assert, describe, it } from "@effect/vitest"
import { deliverMail } from "../../src/providers/mail.vibe"
import { deliverSms } from "../../src/providers/sms.vibe"
import { testCloud, type Answer, type FakeServer, type ProfileEdit } from "../support/cloud.vibe"
import type { FakeRequest } from "../support/fakes.ts"
import { callCloud } from "../support/http.ts"
import { externalAddress, latestCode } from "../support/inbox.ts"

effect function check(run: () => void) {
  try Effect.try(run)
}

function refusal(answer: Answer): string {
  return `${answer.status} ${(answer.body as { readonly error?: string }).error}`
}

const httpsAdapters: ProfileEdit = (profile) => {
  const fake = profile.environments.staging.billing.apiUrl.replace(/\/stripe$/, "")
  return {
    ...profile,
    environments: {
      ...profile.environments,
      staging: {
        ...profile.environments.staging,
        mail: { kind: "https", url: `${fake}/mail/send`, apiKeyEnv: "CLOUD_TEST_MAIL_TOKEN" },
        sms: { kind: "https", url: `${fake}/sms/messages`, accountEnv: "CLOUD_TEST_SMS_ACCOUNT", tokenEnv: "CLOUD_TEST_SMS_TOKEN", from: "+15550001111" }
      }
    }
  }
}

function providers(seen: FakeRequest[], hang: { readonly to?: string }) {
  return (fakes: FakeServer) => {
    fakes.mount("/mail/", (request) => {
      if (request.path !== "/send") return undefined
      seen.push(request)
      return (JSON.parse(request.body) as { readonly to: ReadonlyArray<string> }).to[0] === "refused@example.com" ? { status: 422, body: { message: "refused" } } : { status: 200, body: { id: "mail-1" } }
    })
    fakes.mount("/sms/", (request) => {
      if (request.path !== "/messages") return undefined
      seen.push(request)
      if (new URLSearchParams(request.body).get("To") === hang.to) return { status: 200, chunks: ["{"], hangAfter: 1 }
      return { status: 201, body: { sid: "sms-1" } }
    })
  }
}

describe("WP1 Identity: mail and SMS delivery", () => {
  it.live("Loopback delivery keeps each message and the inbox answers the latest per destination (spec/cloud/identity/codeChallenges.md, \"Story: Sign in with a code sent to my email or phone\")", () => scoped(effect {
    const cloud = try testCloud()
    try cloud.inside(deliverMail({ to: "ada@example.com", subject: "Your sign-in code", text: "Your sign-in code is 111222." }))
    try cloud.inside(deliverSms({ to: "+15551234567", text: "Your code is 654321." }))
    try cloud.inside(deliverMail({ to: "ada@example.com", subject: "Your sign-in code", text: "Your sign-in code is 333444." }))
    const mailCode = try latestCode(cloud, "ada@example.com")
    const smsCode = try latestCode(cloud, "+15551234567")
    const message = try cloud.call("/api/test/inbox/ada%40example.com")
    const unknown = try cloud.call("/api/test/inbox/bob%40example.com")
    const body = message.body as { readonly destination: string; readonly text: string; readonly createdAt: number }
    try check(() => assert.deepStrictEqual(
      [mailCode, smsCode, message.status, body.destination, body.text, Number.isSafeInteger(body.createdAt), refusal(unknown)],
      ["333444", "654321", 200, "ada@example.com", "Your sign-in code\n\nYour sign-in code is 333444.", true, "404 not_found"]
    ))
  }))

  it.live("HTTPS adapters post to the profile's providers and a refusal is provider_unavailable (spec/cloud/identity/codeChallenges.md, \"Story: Sign in with a code sent to my email or phone\")", () => scoped(effect {
    const seen: FakeRequest[] = []
    const cloud = try testCloud({ edit: httpsAdapters, mount: providers(seen, {}) })
    try cloud.inside(deliverMail({ to: "ada@example.com", subject: "Your sign-in code", text: "Your sign-in code is 111222." }))
    try cloud.inside(deliverSms({ to: "+15551234567", text: "Your code is 654321." }))
    const refusedMail = try (cloud.inside(deliverMail({ to: "refused@example.com", subject: "s", text: "t" })) catch (failure) => failure.refusal.code)
    const inbox = try cloud.call("/api/test/inbox/ada%40example.com")
    const [mail, sms] = seen
    try check(() => assert.deepStrictEqual(
      [
        mail?.headers.authorization, JSON.parse(mail?.body ?? "{}"),
        sms?.headers.authorization, sms?.headers["content-type"], Object.fromEntries(new URLSearchParams(sms?.body ?? "")),
        refusedMail, refusal(inbox)
      ],
      [
        "Bearer mail-token", { from: "sign-in@mail.example.com", to: ["ada@example.com"], subject: "Your sign-in code", text: "Your sign-in code is 111222." },
        `Basic ${btoa("sms-account:sms-token")}`, "application/x-www-form-urlencoded", { To: "+15551234567", From: "+15550001111", Body: "Your code is 654321." },
        "ProviderUnavailable", "404 not_found"
      ]
    ))
  }))

  it.effect("A provider that does not answer within 10 s is provider_unavailable (spec/cloud/identity/codeChallenges.md, \"Story: Sign in with a code sent to my email or phone\")", () => scoped(effect {
    const cloud = try testCloud({ edit: httpsAdapters, mount: providers([], { to: "+15559990000" }) })
    const sending = fork cloud.inside(deliverSms({ to: "+15559990000", text: "Your code is 654321." }) catch (failure) => failure.refusal.code)
    try sleep(Duration.millis(50)) |> TestClock.withLive(%)
    try TestClock.adjust(Duration.seconds(10))
    const outcome = join sending
    try check(() => assert.strictEqual(outcome, "ProviderUnavailable"))
  }))

  it.live("The inbox answers only a loopback caller of a staging instance (spec/cloud/deployment.md, \"Story: Configure a deployment from one reviewed profile\")", () => scoped(effect {
    const cloud = try testCloud({ host: "0.0.0.0" })
    try cloud.inside(deliverMail({ to: "ada@example.com", subject: "Your sign-in code", text: "Your sign-in code is 111222." }))
    const local = try cloud.call("/api/test/inbox/ada%40example.com")
    const address = externalAddress()
    const remote = address === undefined ? undefined : try promise(() => callCloud(cloud.url.replace("127.0.0.1", address), "/api/test/inbox/ada%40example.com"))
    const production = try testCloud({ environment: "production", edit: (profile) => ({ ...profile, environments: { ...profile.environments, production: { ...profile.environments.production, capabilities: [], maps: { provider: "none" } } } }) })
    const closed = try production.call("/api/test/inbox/ada%40example.com")
    try check(() => assert.deepStrictEqual(
      [local.status, remote === undefined ? "404 not_found" : refusal(remote), refusal(closed)],
      [200, "404 not_found", "404 not_found"]
    ))
  }))
})
