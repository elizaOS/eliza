// spec/cloud/shared/metering.md, "Story: Never overdraw an account"; spec/cloud/shared/metering.md, "Story: Settle every call once"; spec/cloud/billing/funds.md, "Story: Spend only money the account has"; spec/cloud/billing/plans.md, "Story: Apply the plan that funds a call"
import { assert, describe, it } from "@effect/vitest"
import { drainProviderEvents, webhookPath } from "../src/billing/provider-events.vibe"
import { observeSubscription, reconcileSubscription } from "../src/billing/subscriptions.vibe"
import { addCredits, stepFunds } from "../src/billing/funds.vibe"
import { refusalBody } from "../src/http/refusal.vibe"
import { holdRows, markDispatched, periodRows, renderHoldKey, reserve, settle, sweepHolds, type HoldOwner, type HoldKey } from "../src/shared/metering.vibe"
import { stepRow } from "../src/store/rows.vibe"
import { Store } from "../src/store/store.vibe"
import { signedCaller } from "./support/caller.vibe"
import { createStripeFake, type SignedEvent } from "./support/fakes/stripe.ts"
import { manualClock, shiftedClock } from "./support/clock.ts"
import { organization, testCloud, type TestCloud } from "./support/cloud.vibe"

const minute = 60_000
const month = 30 * 24 * 60 * minute

effect function failureOf<A, E extends { readonly _tag: string }, R>(program: A!E!R): unknown!!R {
  return match (try exit(program)) {
    when Exit.Success(let value): `succeeded with ${JSON.stringify(value)}`;
    when Exit.Failure(let cause): Cause.findErrorOption(cause).pipe(Option.map((error) => "refusal" in error && typeof error.refusal === "object" && error.refusal !== null ? refusalBody(error.refusal as Parameters<typeof refusalBody>[0]) : error._tag), Option.getOrElse(() => "defect"));
  }
}

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}

effect function numbers(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return (try sql(cloud, text, params)).map((row) => Object.values(row).map((value) => typeof value === "string" ? value : Number(value)))
}

effect function subscribe(cloud: TestCloud, organizationId: string, status: string, planKey: string) {
  const now = try Clock.currentTimeMillis
  try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, period_end, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, $3, $4, $5)", [organizationId, status, planKey, now + month, now])
}

effect function grant(cloud: TestCloud, organizationId: string, planKey: string) {
  const now = try Clock.currentTimeMillis
  try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ($1, $2, 'membership', $3, $4, $5, $4)", [`grant-${organizationId}`, organizationId, planKey, now - minute, now + month])
}

effect function openPeriod(cloud: TestCloud, organizationId: string, planKey: "PlusMonthly" | "ProMonthly") {
  const now = try Clock.currentTimeMillis
  const key = `period-${organizationId}`
  const columns = () => ({ organization_id: organizationId, status: "open", period_start: now - minute, period_end: now + month, updated_at: now })
  try cloud.store.transaction((tx) => stepRow(tx, periodRows, key, { type: "openRenewal", invoiceId: `invoice-${organizationId}`, planKey, startsAt: now - minute, endsAt: now + month }, columns))
  return key
}

function holdKey(caller: string, requestId: string) {
  return { service: "MeteredInference", caller, requestId, part: { tag: "WholeRequest" } } as const
}

effect function retainLegacyInference(cloud: TestCloud, owner: HoldOwner, requestId: string) {
  const now = try Clock.currentTimeMillis
  const key = holdKey(owner.userId, requestId)
  const storedKey = renderHoldKey(owner, key)
  try cloud.store.transaction(effect (tx) => {
    try stepRow(tx, holdRows, storedKey, { type: "reserve", key, quote: 100_000, lane: "CreditsOnly", allowanceAvailable: 0, creditAvailable: 10_000_000, now }, () => ({
      organization_id: owner.organizationId, user_id: owner.userId, service: "inference", phase: "reserved", allowance_period: null, created_at: now, updated_at: now
    }))
    try stepFunds(tx, owner.organizationId, { type: "holdCredits", fromCredits: 150_000 }, now, storedKey)
  })
  return storedKey
}

describe("WP0 Foundation: metering and funds", () => {
  it.live("Spend the plan's allowance before credits, from the plan the policy funds (spec/cloud/shared/metering.md, \"Story: Never overdraw an account\"; spec/cloud/billing/plans.md, \"Story: Apply the plan that funds a call\")", () => scoped(effect {
    const cloud = try testCloud()
    for (const id of ["org-active", "org-granted", "org-broken", "org-lapsed"]) try organization(cloud, id)
    try subscribe(cloud, "org-active", "active", "plus_monthly")
    try subscribe(cloud, "org-lapsed", "past_due", "plus_monthly")
    try subscribe(cloud, "org-granted", "canceled", "plus_monthly")
    try grant(cloud, "org-granted", "pro_monthly")
    try subscribe(cloud, "org-broken", "active", "gold_monthly")
    const period = try openPeriod(cloud, "org-active", "PlusMonthly")
    try openPeriod(cloud, "org-granted", "ProMonthly")
    const lapsedPeriod = try openPeriod(cloud, "org-lapsed", "PlusMonthly")
    provide Store = cloud.store {
      try addCredits({ organizationId: "org-active", amount: 10_000_000, requestKey: "operator-1" })
      const owner = { organizationId: "org-active", userId: "user-1" }
      const ticket = try reserve(owner, holdKey("user-1", "request-1"), 20_000_000)
      const reserved = {
        hold: [ticket.hold.reserved, ticket.hold.fromAllowance, ticket.hold.fromCredits],
        period: try numbers(cloud, "SELECT state->'available' AS available_balance, state->'reserved' AS reserved_balance FROM allowance_periods WHERE key = $1", [period]),
        funds: try numbers(cloud, "SELECT f.state->'creditHeld' AS held_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-active"])
      }
      try markDispatched(ticket.key)
      const settled = try settle(ticket.key, { kind: "known", actual: 26_000_000 })
      const granted = try reserve({ organizationId: "org-granted", userId: "user-2" }, holdKey("user-2", "request-2"), 1_000_000)
      const failedAt = try Clock.currentTimeMillis
      const clock = try sync(() => manualClock())
      try sync(() => clock.set(failedAt))
      const broken = try Effect.provideService(failureOf(reserve({ organizationId: "org-broken", userId: "user-3" }, holdKey("user-3", "request-3"), 1)), Clock.Clock, clock.clock)
      const negativeQuote = try Effect.provideService(failureOf(reserve(owner, holdKey("user-1", "negative-quote"), -1)), Clock.Clock, clock.clock)
      const digested = try reserve(owner, holdKey("user-1", "digested"), 1_000, "digest-a")
      const sameBody = try reserve(owner, holdKey("user-1", "digested"), 1_000, "digest-a")
      const otherBody = try failureOf(reserve(owner, holdKey("user-1", "digested"), 1_000, "digest-b"))
      try addCredits({ organizationId: "org-lapsed", amount: 10_000_000, requestKey: "lapsed-credits" })
      const lapsedOwner = { organizationId: "org-lapsed", userId: "lapsed-owner" }
      const pastDue = try reserve(lapsedOwner, holdKey(lapsedOwner.userId, "past-due-request"), 1_000_000)
      try sql(cloud, "UPDATE subscriptions SET status='unpaid' WHERE key=$1", [lapsedOwner.organizationId])
      const unpaid = try reserve(lapsedOwner, holdKey(lapsedOwner.userId, "unpaid-request"), 1_000_000)
      const lapsedBalance = try numbers(cloud, "SELECT state->'available' AS available_balance, state->'reserved' AS reserved_balance FROM allowance_periods WHERE key=$1", [lapsedPeriod])
      const observed = {
          reserved,
          settled: [settled.charged, settled.uncollected],
          period: try numbers(cloud, "SELECT state->'available' AS available_balance, state->'reserved' AS reserved_balance, state->'settled' AS settled_balance, status FROM allowance_periods WHERE key = $1", [period]),
          funds: try numbers(cloud, "SELECT f.state->'creditBalance' AS state_credit, f.state->'creditHeld' AS held_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-active"]),
          usage: try numbers(cloud, "SELECT charged, from_allowance, from_credits, uncollected, outcome FROM usage_records WHERE hold_key = $1", [ticket.key]),
          granted: [granted.hold.fromAllowance, granted.hold.fromCredits],
          pastDue: [pastDue.hold.fromAllowance, pastDue.hold.fromCredits],
          unpaid: [unpaid.hold.fromAllowance, unpaid.hold.fromCredits],
          lapsedBalance,
          broken,
          negativeQuote,
          replay: [digested.replayed, sameBody.replayed, sameBody.key === digested.key, otherBody]
        }
      try check(() => assert.deepStrictEqual(observed, {
          reserved: { hold: [30_000_000, 25_000_000, 5_000_000], period: [[0, 25_000_000]], funds: [[5_000_000, 5_000_000]] },
          settled: [26_000_000, 0],
          period: [[0, 0, 25_000_000, "open"]],
          funds: [[9_000_000, 1_500, 8_998_500]],
          usage: [[26_000_000, 25_000_000, 1_000_000, 0, "known"]],
          granted: [1_500_000, 0],
          pastDue: [0, 1_500_000],
          unpaid: [0, 1_500_000],
          lapsedBalance: [[25_000_000, 0]],
          broken: { error: "service_unavailable", errorDescription: "Service unavailable.", retryable: true, retryAt: failedAt + 5000 },
          negativeQuote: { error: "service_unavailable", errorDescription: "Service unavailable.", retryable: true, retryAt: failedAt + 5000 },
          replay: [false, true, true, { error: "idempotency_conflict", errorDescription: "Idempotency conflict.", retryable: false }]
        }))
    }
  }))

  it.live("Share an organization hold across inference ingress and retain earlier physical keys (spec/cloud/shared/metering.md, \"Story: Never overdraw an account\"; spec/cloud/shared/metering.md, \"Story: Settle every call once\")", () => scoped(effect {
    const cloud = try testCloud()
    const owner = { organizationId: "org-shared-meter", userId: "current-owner" }
    const previousOwner = { ...owner, userId: "previous-owner" }
    const another = { organizationId: "org-other-meter", userId: "other-owner" }
    try organization(cloud, owner.organizationId)
    try organization(cloud, another.organizationId)
    provide Store = cloud.store {
      try addCredits({ organizationId: owner.organizationId, amount: 10_000_000, requestKey: "shared-meter-funds" })
      try addCredits({ organizationId: another.organizationId, amount: 10_000_000, requestKey: "other-meter-funds" })
      const legacy = try retainLegacyInference(cloud, previousOwner, "earlier-request")
      try markDispatched(legacy)
      try settle(legacy, { kind: "known", actual: 100_000 })
      const replayedLegacy = try reserve(owner, holdKey(owner.organizationId, "earlier-request"), 100_000)
      const attempts = try Effect.all([
        reserve(owner, holdKey(owner.userId, "both-ingress"), 100_000),
        reserve(owner, holdKey(owner.organizationId, "both-ingress"), 100_000)
      ], { concurrency: 2 })
      const current = attempts[0].key
      try markDispatched(current)
      try settle(current, { kind: "known", actual: 100_000 })
      const otherOrganization = try reserve(another, holdKey(another.userId, "both-ingress"), 100_000)
      const speech: HoldKey = { service: "MeteredSpeech", caller: owner.userId, requestId: "both-ingress", part: { tag: "SpeechWindow", direction: "Transcribe", window: 1 } }
      const transcribe = try reserve(owner, speech, 100_000)
      const replayedSpeech = try reserve(owner, { ...speech, caller: owner.organizationId }, 100_000)
      const synthesize = try reserve(owner, { ...speech, part: { tag: "SpeechWindow", direction: "Synthesize", window: 1 } }, 100_000)
      const nextWindow = try reserve(owner, { ...speech, part: { tag: "SpeechWindow", direction: "Transcribe", window: 2 } }, 100_000)
      const firstMap = try reserve(owner, { service: "MeteredMaps", caller: "device-a", requestId: "both-ingress", part: { tag: "WholeRequest" } }, 100_000)
      const secondMap = try reserve(owner, { service: "MeteredMaps", caller: "device-b", requestId: "both-ingress", part: { tag: "WholeRequest" } }, 100_000)
      try reserve(owner, holdKey(owner.organizationId, "duplicate-history"), 100_000)
      try retainLegacyInference(cloud, previousOwner, "duplicate-history")
      const ambiguous = try failureOf(reserve(owner, holdKey(owner.organizationId, "duplicate-history"), 100_000))
      const refusal = try Schema.decodeUnknownEffect(Schema.Struct({ error: Schema.String, retryable: Schema.Boolean }))(ambiguous)
      const rows = try sql(cloud, "SELECT hold_key, charged::int AS charged FROM usage_records WHERE organization_id = $1 ORDER BY hold_key", [owner.organizationId])
      try check(() => assert.deepStrictEqual({
        legacy: [replayedLegacy.replayed, replayedLegacy.key, replayedLegacy.hold.key.caller],
        current: [attempts.map((ticket) => ticket.replayed).sort(), attempts[0].key === attempts[1].key, attempts[0].hold.key.caller],
        isolated: [otherOrganization.replayed, otherOrganization.key !== current],
        speech: [transcribe.replayed, replayedSpeech.replayed, replayedSpeech.key === transcribe.key, synthesize.replayed, nextWindow.replayed, new Set([transcribe.key, synthesize.key, nextWindow.key]).size],
        maps: [firstMap.replayed, secondMap.replayed, firstMap.key !== secondMap.key],
        refusal, charged: rows.map((row) => [row.hold_key, row.charged])
      }, {
        legacy: [true, legacy, previousOwner.userId],
        current: [[false, true], true, owner.organizationId],
        isolated: [false, true],
        speech: [false, true, true, false, false, 3],
        maps: [false, false, true],
        refusal: { error: "service_unavailable", retryable: true },
        charged: [current, legacy].sort().map((key) => [key, 100_000])
      }))
    }
  }))

  it.live("Sweep holds left behind: release one reserved 15 minutes, charge the quote of one dispatched 2 hours (spec/cloud/shared/metering.md, \"Story: Settle every call once\")", () => scoped(effect {
    const cloud = try testCloud()
    try organization(cloud, "org-sweep")
    const clock = try sync(() => shiftedClock())
    provide Store = cloud.store, Clock.Clock = clock.clock {
      try addCredits({ organizationId: "org-sweep", amount: 1_000_000, requestKey: "operator-1" })
      const owner = { organizationId: "org-sweep", userId: "user-1" }
      const abandoned = try reserve(owner, holdKey("user-1", "abandoned"), 100_000)
      const lost = try reserve(owner, holdKey("user-1", "lost"), 200_000)
      try markDispatched(lost.key)
      try sync(() => clock.advance(14 * minute))
      const early = try sweepHolds()
      try sync(() => clock.advance(minute))
      const released = try sweepHolds()
      try sync(() => clock.advance(105 * minute))
      const charged = try sweepHolds()
      const after = try sweepHolds()
      const late = try settle(lost.key, { kind: "known", actual: 50_000 })
      const observed = {
          swept: [early, released, charged, after],
          holds: try numbers(cloud, "SELECT phase, state->'charged' AS charged_amount, state->>'basis' AS charge_basis FROM holds WHERE organization_id = $1 ORDER BY phase", ["org-sweep"]),
          late: [late.phase, late.charged],
          usage: try numbers(cloud, "SELECT outcome, charged FROM usage_records WHERE organization_id = $1 ORDER BY outcome", ["org-sweep"]),
          funds: try numbers(cloud, "SELECT f.state->'creditBalance' AS state_credit, f.state->'creditHeld' AS held_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-sweep"])
        }
      try check(() => assert.deepStrictEqual(observed, {
          swept: [0, 1, 1, 0],
          holds: [["released", 0, "NotCharged"], ["settled", 200_000, "Quoted"]],
          late: ["Settled", 200_000],
          usage: [["released", 0], ["unknown", 200_000]],
          funds: [[800_000, 0, 800_000]]
        }))
      assert.notStrictEqual(abandoned.key, lost.key)
    }
  }))

  it.live("Charge a known cost beyond the hold only from free credits and record the rest uncollected (spec/cloud/shared/metering.md, \"Story: Settle every call once\"; spec/cloud/billing/funds.md, \"Story: Spend only money the account has\")", () => scoped(effect {
    const cloud = try testCloud()
    try organization(cloud, "org-over")
    provide Store = cloud.store {
      try addCredits({ organizationId: "org-over", amount: 1_000_000, requestKey: "operator-1" })
      const owner = { organizationId: "org-over", userId: "user-1" }
      const first = try reserve(owner, holdKey("user-1", "first"), 100_000)
      const other = try reserve(owner, holdKey("user-1", "other"), 200_000)
      try markDispatched(first.key)
      const settled = try settle(first.key, { kind: "known", actual: 2_000_000 })
      const observed = {
          held: [first.hold.fromCredits, other.hold.fromCredits],
          settled: [settled.basis, settled.charged, settled.uncollected],
          usage: try numbers(cloud, "SELECT charged, from_credits, uncollected FROM usage_records WHERE hold_key = $1", [first.key]),
          funds: try numbers(cloud, "SELECT f.state->'creditBalance' AS state_credit, f.state->'creditHeld' AS held_credit, f.state->'collected' AS collected_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-over"])
        }
      try check(() => assert.deepStrictEqual(observed, {
          held: [150_000, 300_000],
          settled: ["Measured", 700_000, 1_300_000],
          usage: [[700_000, 700_000, 1_300_000]],
          funds: [[300_000, 300_000, 700_000, 0]]
        }))
    }
  }))

  it.live("Add credits once per operator request (spec/cloud/billing/funds.md, \"Story: Spend only money the account has\")", () => scoped(effect {
    const cloud = try testCloud()
    try organization(cloud, "org-credits")
    provide Store = cloud.store {
      const first = try addCredits({ organizationId: "org-credits", amount: 500_000, requestKey: "operator-7" })
      const replayed = try addCredits({ organizationId: "org-credits", amount: 500_000, requestKey: "operator-7" })
      const second = try addCredits({ organizationId: "org-credits", amount: 250_000, requestKey: "operator-8" })
      const refusals = [
        try failureOf(addCredits({ organizationId: "org-credits", amount: 400_000, requestKey: "operator-7" })),
        try failureOf(addCredits({ organizationId: "org-credits", amount: 1, requestKey: "  " })),
        try failureOf(addCredits({ organizationId: "org-credits", amount: 0, requestKey: "operator-9" })),
        try failureOf(addCredits({ organizationId: "org-nobody", amount: 1, requestKey: "operator-10" }))
      ]
      const observed = {
          answers: [first, replayed, second].map((added) => [added.balance, added.replayed]),
          refusals,
          ledger: try numbers(cloud, "SELECT request_key, amount FROM credit_entries WHERE organization_id = $1 ORDER BY request_key", ["org-credits"]),
          balance: try numbers(cloud, "SELECT credit_balance FROM organizations WHERE id = $1", ["org-credits"])
        }
      try check(() => assert.deepStrictEqual(observed, {
          answers: [[500_000, false], [500_000, true], [750_000, false]],
          refusals: ["IdempotencyConflict", "InvalidCreditRequest", "InvalidCreditRequest", "OrganizationUnknown"],
          ledger: [["operator-7", 500_000], ["operator-8", 250_000]],
          balance: [[750_000]]
        }))
    }
  }))
})

it.live('Follow the verified Checkout and scope shared charge events (spec/cloud/billing/subscriptions.md, "Story: Keep my plan as the provider says it is"; spec/cloud/billing/providerEvents.md, "Each event type has one owner, and an event of any other type is done at its first handling")', () => scoped(effect {
  const stripe = try sync(() => createStripeFake())
  const cloud = try testCloud({ stripe })
  const owner = try signedCaller(cloud, "verified-checkout")
  const legacy = try signedCaller(cloud, "legacy-checkout")
  const path = "/api/v1/subscriptions/checkout"
  const OpenCheckout = Schema.Struct({ sessionId: Schema.String })
  const buildCheckout = (headers: Readonly<Record<string, string>>, idempotencyKey: string) =>
    cloud.call(path, { headers, json: { planKey: "plus_monthly", presentation: "shared", idempotencyKey } })
  const confirm = (sessionId: string, headers: Readonly<Record<string, string>>) =>
    cloud.call(path + "/confirm", { headers, json: { sessionId } })
  const opened = try buildCheckout(owner.headers, "verified-checkout-current")
  const { sessionId } = try Schema.decodeUnknownEffect(OpenCheckout)(opened.body)
  const completed = try sync(() => stripe.completeSession(sessionId))
  if (completed.kind !== "paid") return try Effect.die("The provider fixture did not pay for Checkout")
  const refused = try confirm(sessionId, legacy.headers)
  const beforeConfirm = try sql(cloud, "SELECT status FROM subscriptions WHERE key=$1", [owner.organizationId])
  const confirmed = try confirm(sessionId, owner.headers)
  const confirmedAgain = try confirm(sessionId, owner.headers)
  const legacyOpened = try buildCheckout(legacy.headers, "verified-checkout-legacy")
  const legacySession = (try Schema.decodeUnknownEffect(OpenCheckout)(legacyOpened.body)).sessionId
  const old = try sync(() => stripe.completeSession(legacySession))
  const legacyConfirmed = try confirm(legacySession, legacy.headers)
  const legacyState = { customerId: old.subscription.customer, subscriptionId: old.subscription.id,
    planKey: "plus_monthly", status: "active", periodEnd: old.subscription.current_period_end * 1000 }
  try sql(cloud, "UPDATE subscriptions SET state=$2::jsonb WHERE key=$1", [legacy.organizationId, JSON.stringify(legacyState)])
  const now = try Clock.currentTimeMillis
  const recovered = try cloud.inside(cloud.store.transaction(effect (tx) => {
    const checked = try observeSubscription(tx, legacy.organizationId)
    return try reconcileSubscription(tx, legacy.organizationId, checked, now)
  }))
  const refresh = (at: number, status: "active" | "past_due", latestInvoice: "PlanChangeInvoice" | "PeriodInvoiceFailed") =>
    cloud.inside(cloud.store.transaction(effect (tx) => {
      const checked = try observeSubscription(tx, owner.organizationId)
      return try reconcileSubscription(tx, owner.organizationId, { ...checked, status, latestInvoice, payment: undefined }, at)
    }))
  const failed = try refresh(now + 1_000, "past_due", "PeriodInvoiceFailed")
  const planChange = try refresh(now + 2_000, "active", "PlanChangeInvoice")

  const deliver = effect (event: SignedEvent) => {
    const json: unknown = try Effect.try(() => JSON.parse(event.raw))
    const answer = try cloud.call(webhookPath, { json, headers: { "stripe-signature": event.header } })
    try cloud.inside(drainProviderEvents(try Clock.currentTimeMillis))
    return [answer.status, answer.body]
  }
  const allowanceKey = "renewal/staging/" + completed.invoice.id
  const allowance = () => sql(cloud, "SELECT status FROM allowance_periods WHERE key=$1 AND organization_id=$2", [allowanceKey, owner.organizationId])
  const beforeUnknown = try allowance()
  const upstreamBefore = cloud.fakes.seen.length
  const unknown = try deliver(try sync(() => stripe.signedEvent("refund.created", { object: "refund", charge: "ch_foreign" })))
  const ignored = cloud.fakes.seen.length === upstreamBefore
  const withdrawal = try sync(() => stripe.disputeCharge(completed.charge.id))
  const dispute = try deliver(try sync(() => stripe.signedEvent("charge.dispute.funds_withdrawn", withdrawal)))
  const clawed = try allowance()
  const restoredDispute = try sync(() => stripe.resolveDispute(withdrawal.id, "won"))
  const returned = try deliver(try sync(() => stripe.signedEvent("charge.dispute.funds_reinstated", restoredDispute)))
  const restored = try allowance()
  const refund = try sync(() => stripe.refundCharge(completed.charge.id))
  const refundEvent = try sync(() => stripe.signedEvent("charge.refunded", refund))
  const refundDelivery = try deliver(refundEvent)
  const refundReplay = try deliver(refundEvent)
  const afterRefund = try allowance()
  const otherAllowance = try sql(cloud, "SELECT status FROM allowance_periods WHERE organization_id=$1", [legacy.organizationId])
  const queued = [200, { received: true, queued: true }]
  try check(() => {
    assert.deepStrictEqual([refused.status, beforeConfirm, confirmed.status, confirmedAgain.body, legacyConfirmed.status, recovered.status],
      [404, [{ status: "none" }], 200, confirmed.body, 200, "Active"])
    assert.deepStrictEqual([failed.status, planChange.status, planChange.dunning], ["Dunning", "Dunning", failed.dunning])
    assert.deepStrictEqual([unknown, dispute, returned, refundDelivery, refundReplay, ignored],
      [queued, queued, queued, queued, [200, { received: true, duplicate: true }], true])
    assert.deepStrictEqual([beforeUnknown, clawed, restored, afterRefund, otherAllowance],
      [[{ status: "open" }], [{ status: "clawed_back" }], [{ status: "open" }], [{ status: "clawed_back" }], [{ status: "open" }]])
  })
}), 90_000)
