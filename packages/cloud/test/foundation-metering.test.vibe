// spec/cloud/shared/metering.md, "Story: Never overdraw an account"; spec/cloud/shared/metering.md, "Story: Settle every call once"; spec/cloud/billing/funds.md, "Story: Spend only money the account has"; spec/cloud/billing/plans.md, "Story: Apply the plan that funds a call"
import { assert, describe, it } from "@effect/vitest"
import { addCredits } from "../src/billing/funds.vibe"
import { refusalBody } from "../src/http/refusal.vibe"
import { markDispatched, periodRows, reserve, settle, sweepHolds } from "../src/shared/metering.vibe"
import { stepRow } from "../src/store/rows.vibe"
import { Store } from "../src/store/store.vibe"
import { manualClock, shiftedClock } from "./support/clock.ts"
import { organization, testCloud, type TestCloud } from "./support/cloud.vibe"

const minute = 60_000
const month = 30 * 24 * 60 * minute

effect function failureOf<A, E extends { readonly _tag: string }, R>(program: A!E!R): unknown!!R {
  return match (try exit(program)) {
    when Exit.Success(let value): `succeeded with ${JSON.stringify(value)}`;
    when Exit.Failure(let cause): Cause.findErrorOption(cause).pipe(Option.map((error) => "refusal" in error && typeof error.refusal === "object" && error.refusal !== null ? refusalBody(error.refusal as Parameters<typeof refusalBody>[0]) : error._tag), Option.getOrElse(() => "defect"));
  }
}

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}

effect function numbers(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return (try sql(cloud, text, params)).map((row) => Object.values(row).map((value) => typeof value === "string" ? value : Number(value)))
}

effect function subscribe(cloud: TestCloud, organizationId: string, status: string, planKey: string) {
  const now = try Clock.currentTimeMillis
  try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, period_end, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, $3, $4, $5)", [organizationId, status, planKey, now + month, now])
}

effect function grant(cloud: TestCloud, organizationId: string, planKey: string) {
  const now = try Clock.currentTimeMillis
  try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ($1, $2, 'membership', $3, $4, $5, $4)", [`grant-${organizationId}`, organizationId, planKey, now - minute, now + month])
}

effect function openPeriod(cloud: TestCloud, organizationId: string, planKey: "PlusMonthly" | "ProMonthly") {
  const now = try Clock.currentTimeMillis
  const key = `period-${organizationId}`
  const columns = () => ({ organization_id: organizationId, status: "open", period_start: now - minute, period_end: now + month, updated_at: now })
  try cloud.store.transaction((tx) => stepRow(tx, periodRows, key, { type: "openRenewal", invoiceId: `invoice-${organizationId}`, planKey, startsAt: now - minute, endsAt: now + month }, columns))
  return key
}

function holdKey(caller: string, requestId: string) {
  return { service: "MeteredInference", caller, requestId, part: { tag: "WholeRequest" } } as const
}

describe("WP0 Foundation: metering and funds", () => {
  it.live("Spend the plan's allowance before credits, from the plan the policy funds (spec/cloud/shared/metering.md, \"Story: Never overdraw an account\"; spec/cloud/billing/plans.md, \"Story: Apply the plan that funds a call\")", () => scoped(effect {
    const cloud = try testCloud()
    for (const id of ["org-past-due", "org-granted", "org-broken"]) try organization(cloud, id)
    try subscribe(cloud, "org-past-due", "past_due", "plus_monthly")
    try subscribe(cloud, "org-granted", "canceled", "plus_monthly")
    try grant(cloud, "org-granted", "pro_monthly")
    try subscribe(cloud, "org-broken", "active", "gold_monthly")
    const period = try openPeriod(cloud, "org-past-due", "PlusMonthly")
    try openPeriod(cloud, "org-granted", "ProMonthly")
    provide Store = cloud.store {
      try addCredits({ organizationId: "org-past-due", amount: 10_000_000, requestKey: "operator-1" })
      const owner = { organizationId: "org-past-due", userId: "user-1" }
      const ticket = try reserve(owner, holdKey("user-1", "request-1"), 20_000_000)
      const reserved = {
        hold: [ticket.hold.reserved, ticket.hold.fromAllowance, ticket.hold.fromCredits],
        period: try numbers(cloud, "SELECT state->'available' AS available_balance, state->'reserved' AS reserved_balance FROM allowance_periods WHERE key = $1", [period]),
        funds: try numbers(cloud, "SELECT f.state->'creditHeld' AS held_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-past-due"])
      }
      try markDispatched(ticket.key)
      const settled = try settle(ticket.key, { kind: "known", actual: 26_000_000 })
      const granted = try reserve({ organizationId: "org-granted", userId: "user-2" }, holdKey("user-2", "request-2"), 1_000_000)
      const failedAt = try Clock.currentTimeMillis
      const clock = try sync(() => manualClock())
      try sync(() => clock.set(failedAt))
      const broken = try Effect.provideService(failureOf(reserve({ organizationId: "org-broken", userId: "user-3" }, holdKey("user-3", "request-3"), 1)), Clock.Clock, clock.clock)
      const observed = {
          reserved,
          settled: [settled.charged, settled.uncollected],
          period: try numbers(cloud, "SELECT state->'available' AS available_balance, state->'reserved' AS reserved_balance, state->'settled' AS settled_balance, status FROM allowance_periods WHERE key = $1", [period]),
          funds: try numbers(cloud, "SELECT f.state->'creditBalance' AS state_credit, f.state->'creditHeld' AS held_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-past-due"]),
          usage: try numbers(cloud, "SELECT charged, from_allowance, from_credits, uncollected, outcome FROM usage_records WHERE hold_key = $1", [ticket.key]),
          granted: [granted.hold.fromAllowance, granted.hold.fromCredits],
          broken
        }
      try check(() => assert.deepStrictEqual(observed, {
          reserved: { hold: [30_000_000, 25_000_000, 5_000_000], period: [[0, 25_000_000]], funds: [[5_000_000, 5_000_000]] },
          settled: [26_000_000, 0],
          period: [[0, 0, 25_000_000, "open"]],
          funds: [[9_000_000, 0, 9_000_000]],
          usage: [[26_000_000, 25_000_000, 1_000_000, 0, "known"]],
          granted: [1_500_000, 0],
          broken: { error: "service_unavailable", errorDescription: "Service unavailable.", retryable: true, retryAt: failedAt + 5000 }
        }))
    }
  }))

  it.live("Sweep holds left behind: release one reserved 15 minutes, charge the quote of one dispatched 2 hours (spec/cloud/shared/metering.md, \"Story: Settle every call once\")", () => scoped(effect {
    const cloud = try testCloud()
    try organization(cloud, "org-sweep")
    const clock = try sync(() => shiftedClock())
    provide Store = cloud.store, Clock.Clock = clock.clock {
      try addCredits({ organizationId: "org-sweep", amount: 1_000_000, requestKey: "operator-1" })
      const owner = { organizationId: "org-sweep", userId: "user-1" }
      const abandoned = try reserve(owner, holdKey("user-1", "abandoned"), 100_000)
      const lost = try reserve(owner, holdKey("user-1", "lost"), 200_000)
      try markDispatched(lost.key)
      try sync(() => clock.advance(14 * minute))
      const early = try sweepHolds()
      try sync(() => clock.advance(minute))
      const released = try sweepHolds()
      try sync(() => clock.advance(105 * minute))
      const charged = try sweepHolds()
      const after = try sweepHolds()
      const late = try settle(lost.key, { kind: "known", actual: 50_000 })
      const observed = {
          swept: [early, released, charged, after],
          holds: try numbers(cloud, "SELECT phase, state->'charged' AS charged_amount, state->>'basis' AS charge_basis FROM holds WHERE organization_id = $1 ORDER BY phase", ["org-sweep"]),
          late: [late.phase, late.charged],
          usage: try numbers(cloud, "SELECT outcome, charged FROM usage_records WHERE organization_id = $1 ORDER BY outcome", ["org-sweep"]),
          funds: try numbers(cloud, "SELECT f.state->'creditBalance' AS state_credit, f.state->'creditHeld' AS held_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-sweep"])
        }
      try check(() => assert.deepStrictEqual(observed, {
          swept: [0, 1, 1, 0],
          holds: [["released", 0, "NotCharged"], ["settled", 200_000, "Quoted"]],
          late: ["Settled", 200_000],
          usage: [["released", 0], ["unknown", 200_000]],
          funds: [[800_000, 0, 800_000]]
        }))
      assert.notStrictEqual(abandoned.key, lost.key)
    }
  }))

  it.live("Charge a known cost beyond the hold only from free credits and record the rest uncollected (spec/cloud/shared/metering.md, \"Story: Settle every call once\"; spec/cloud/billing/funds.md, \"Story: Spend only money the account has\")", () => scoped(effect {
    const cloud = try testCloud()
    try organization(cloud, "org-over")
    provide Store = cloud.store {
      try addCredits({ organizationId: "org-over", amount: 1_000_000, requestKey: "operator-1" })
      const owner = { organizationId: "org-over", userId: "user-1" }
      const first = try reserve(owner, holdKey("user-1", "first"), 100_000)
      const other = try reserve(owner, holdKey("user-1", "other"), 200_000)
      try markDispatched(first.key)
      const settled = try settle(first.key, { kind: "known", actual: 2_000_000 })
      const observed = {
          held: [first.hold.fromCredits, other.hold.fromCredits],
          settled: [settled.basis, settled.charged, settled.uncollected],
          usage: try numbers(cloud, "SELECT charged, from_credits, uncollected FROM usage_records WHERE hold_key = $1", [first.key]),
          funds: try numbers(cloud, "SELECT f.state->'creditBalance' AS state_credit, f.state->'creditHeld' AS held_credit, f.state->'collected' AS collected_credit, o.credit_balance FROM funds f JOIN organizations o ON o.id = f.key WHERE f.key = $1", ["org-over"])
        }
      try check(() => assert.deepStrictEqual(observed, {
          held: [150_000, 300_000],
          settled: ["Measured", 700_000, 1_300_000],
          usage: [[700_000, 700_000, 1_300_000]],
          funds: [[300_000, 300_000, 700_000, 0]]
        }))
    }
  }))

  it.live("Add credits once per operator request (spec/cloud/billing/funds.md, \"Story: Spend only money the account has\")", () => scoped(effect {
    const cloud = try testCloud()
    try organization(cloud, "org-credits")
    provide Store = cloud.store {
      const first = try addCredits({ organizationId: "org-credits", amount: 500_000, requestKey: "operator-7" })
      const replayed = try addCredits({ organizationId: "org-credits", amount: 500_000, requestKey: "operator-7" })
      const second = try addCredits({ organizationId: "org-credits", amount: 250_000, requestKey: "operator-8" })
      const refusals = [
        try failureOf(addCredits({ organizationId: "org-credits", amount: 400_000, requestKey: "operator-7" })),
        try failureOf(addCredits({ organizationId: "org-credits", amount: 1, requestKey: "  " })),
        try failureOf(addCredits({ organizationId: "org-credits", amount: 0, requestKey: "operator-9" })),
        try failureOf(addCredits({ organizationId: "org-nobody", amount: 1, requestKey: "operator-10" }))
      ]
      const observed = {
          answers: [first, replayed, second].map((added) => [added.balance, added.replayed]),
          refusals,
          ledger: try numbers(cloud, "SELECT request_key, amount FROM credit_entries WHERE organization_id = $1 ORDER BY request_key", ["org-credits"]),
          balance: try numbers(cloud, "SELECT credit_balance FROM organizations WHERE id = $1", ["org-credits"])
        }
      try check(() => assert.deepStrictEqual(observed, {
          answers: [[500_000, false], [500_000, true], [750_000, false]],
          refusals: ["IdempotencyConflict", "InvalidCreditRequest", "InvalidCreditRequest", "OrganizationUnknown"],
          ledger: [["operator-7", 500_000], ["operator-8", 250_000]],
          balance: [[750_000]]
        }))
    }
  }))
})

module node {
  import Stripe from "stripe"
  import { billingRequest, stripeWebhook } from "../src/billing.vibe"
  import { openBackupDatabase } from "./support/password-backup.ts"

  export async function reconcileManagedCheckout() {
    const fixture = await openBackupDatabase()
    const original = globalThis.fetch
    try {
      const first = Math.floor(Date.now() / 1000) - 60
      const last = first + 2_592_000
      for (const owner of ["new", "legacy"]) {
        await fixture.db.query("INSERT INTO organizations (id, name, created_at) VALUES ($1, $1, 1)", [owner])
        await fixture.db.query("INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $1, 'active', $2, 1, 1)", [owner, owner + "@fixture.test"])
        await fixture.db.query("INSERT INTO cloud_checkout_customers VALUES ($1, $2, $3)", [owner, "cus_" + owner, owner === "new" ? "cs_new" : null])
      }
      await fixture.db.query("INSERT INTO subscriptions (key,state,revision,status,plan_key,customer_id,provider_subscription_id,period_end,updated_at) VALUES ('legacy',$1,7,'active','plus_monthly','cus_legacy','sub_legacy',$2,1)",
        [JSON.stringify({ customerId: "cus_legacy", subscriptionId: "sub_legacy", planKey: "plus_monthly", status: "active", periodEnd: last * 1000 }), last * 1000])
      let matched = false
      let periodPaid = false
      let refunded = false
      let dispute: "needs_response" | "won" = "needs_response"
      let providerCalls = 0
      const price = {
        id: "price_fixture", product: { id: "product_fixture", active: true, livemode: false }, livemode: false,
        active: true, type: "recurring", currency: "usd", unit_amount: 3000, billing_scheme: "per_unit", transform_quantity: null,
        recurring: { interval: "month", interval_count: 1, usage_type: "licensed", trial_period_days: null },
      }
      globalThis.fetch = async (input, init) => {
        const request = new Request(input, init)
        const url = new URL(request.url)
        providerCalls += 1
        if (url.hostname !== "api.stripe.com") throw new Error("Unrecognized fixture provider")
        if (url.pathname === "/v1/subscriptions") {
          const customer = url.searchParams.get("customer")
          const suffix = customer === "cus_new" ? "new" : "legacy"
          return Response.json({ data: [{
            id: "sub_" + suffix, customer, livemode: false, created: first, status: "active", latest_invoice: "in_" + suffix,
            cancel_at_period_end: false, items: { has_more: false, data: [{ id: "si_fixture", price, quantity: 1, current_period_start: first, current_period_end: last }] },
          }], has_more: false })
        }
        if (url.pathname === "/v1/prices/price_fixture") return Response.json(price)
        if (url.pathname.startsWith("/v1/invoices/in_")) {
          const id = url.pathname.split("/").at(-1) ?? ""
          const suffix = id.slice(3)
          const owner = { id, customer: "cus_" + suffix, livemode: false, parent: { subscription_details: { subscription: "sub_" + suffix } } }
          if (periodPaid && suffix === "new")
            return Response.json({ ...owner, status: "paid", amount_paid: 3000, currency: "usd", billing_reason: "subscription_cycle",
              lines: { data: [{ pricing: { price_details: { price: price.id } }, parent: { subscription_item_details: { subscription_item: "si_fixture", proration: false } },
                quantity: 1, period: { start: first, end: last } }] } })
          return Response.json({ ...owner, status: "open", attempted: true, attempt_count: 1, billing_reason: "subscription_update" })
        }
        if (url.pathname === "/v1/invoice_payments")
          return Response.json({ data: [{ amount_paid: 3000, payment: { type: "charge", charge: "ch_fixture" } }], has_more: false })
        if (url.pathname === "/v1/charges/ch_fixture")
          return Response.json({ id: "ch_fixture", customer: "cus_new", livemode: false, paid: true, captured: true, currency: "usd", amount_refunded: refunded ? 3000 : 0, disputed: true })
        if (url.pathname === "/v1/disputes")
          return Response.json({ data: [{ status: dispute }], has_more: false })
        if (url.pathname === "/v1/checkout/sessions/cs_new")
          return Response.json({ id: "cs_new", client_reference_id: "new", customer: "cus_new", livemode: false, mode: "subscription",
            status: "complete", payment_status: "paid", subscription: matched ? "sub_new" : "sub_foreign",
            line_items: { has_more: false, data: [{ price, quantity: 1 }] } })
        throw new Error("Unexpected Stripe fixture request: " + url.pathname)
      }
      const env = {
        STRIPE_SECRET_KEY: "fixture", STRIPE_WEBHOOK_SECRET: "fixture", STRIPE_PRICE_ID: "price_fixture", STRIPE_PRODUCT_ID: "product_fixture",
        STRIPE_PLAN: "plus_monthly" as const, CLOUD_ENVIRONMENT: "staging" as const, WEB_ORIGIN: "https://fixture.test",
      }
      const read = async (owner: string): Promise<unknown> => {
        const response = await billingRequest(new Request("https://fixture.test/api/v1/billing/subscription"), env, fixture.db, owner)
        return { status: response.status, body: await response.json() }
      }
      const signing = new Stripe(env.STRIPE_SECRET_KEY)
      const deliver = async (eventType: string, object: object) => {
        const payload = JSON.stringify({ id: "evt_" + eventType, type: eventType, livemode: false, data: { object } })
        const signature = signing.webhooks.generateTestHeaderString({ payload, secret: env.STRIPE_WEBHOOK_SECRET })
        const request = new Request("https://fixture.test/api/v1/billing/webhook", {
          method: "POST", headers: { "stripe-signature": signature }, body: payload
        })
        return (await stripeWebhook(request, new TextEncoder().encode(payload), env, fixture.db)).status
      }
      const mappedDispute = (stage: "created" | "closed") => deliver("charge.dispute." + stage, { object: "dispute", charge: "ch_fixture" })
      const unknownStatuses = [
        await deliver("refund.created", { object: "refund", charge: "ch_foreign" }),
        await mappedDispute("created"),
        await deliver("charge.refunded", { object: "charge", id: "ch_foreign", customer: "cus_foreign" })
      ]
      const unknownProviderCalls = providerCalls
      const unrelated = await read("new")
      matched = true
      const paid = await read("new")
      const legacy = await read("legacy")
      const beforeRenewal = await fixture.db.query("SELECT key FROM allowance_periods")
      periodPaid = true
      const renewal = await read("new")
      const beforeResolution = (await fixture.db.query("SELECT key FROM allowance_periods")).rows
      dispute = "won"
      const resolved = await mappedDispute("closed")
      const replay = await mappedDispute("closed")
      const paidReplay = await read("new")
      const rows = await fixture.db.query("SELECT key,status,provider_subscription_id,state->>'lastRenewalInvoice' AS renewal FROM subscriptions ORDER BY key")
      const allowances = await fixture.db.query("SELECT key FROM allowance_periods")
      const allowanceStatus = async () => (await fixture.db.query("SELECT status FROM allowance_periods WHERE key = 'invoice/in_new'")).rows
      dispute = "needs_response"
      const reopened = await mappedDispute("created")
      const disputeClawback = await allowanceStatus()
      dispute = "won"
      const restored = await mappedDispute("closed")
      const disputeRestore = await allowanceStatus()
      refunded = true
      const mappedRefund = await deliver("refund.updated", { object: "refund", charge: "ch_fixture" })
      const seen = await fixture.db.query("SELECT charge_id,customer_id FROM cloud_stripe_charge_owners")
      const refundClawback = await allowanceStatus()
      return { unrelated, paid, legacy, renewal, paidReplay, beforeRenewal: beforeRenewal.rows, rows: rows.rows, allowances: allowances.rows,
        unknownStatuses, unknownProviderCalls, beforeResolution, deliveries: [resolved, replay, reopened, restored, mappedRefund], owners: seen.rows, outcomes: [disputeClawback, disputeRestore, refundClawback] }
    } finally {
      globalThis.fetch = original
      await fixture.close()
    }
  }
}
import { reconcileManagedCheckout } from node

it.live('Follow the verified Checkout and scope shared charge events (spec/cloud/billing/subscriptions.md, "Story: Keep my plan as the provider says it is"; spec/cloud/billing/providerEvents.md, "Each event type has one owner, and an event of any other type is done at its first handling")', () => effect {
  const result = try tryPromise(() => reconcileManagedCheckout())
  const entitled = { status: 200, body: { status: "active", canManage: true, canCheckout: false } }
  try check(() => assert.deepStrictEqual(result, {
    unrelated: { status: 200, body: { status: "inactive", canManage: true, canCheckout: false } },
    paid: entitled, legacy: entitled, renewal: entitled, paidReplay: entitled, beforeRenewal: [],
    rows: [{ key: "legacy", status: "active", provider_subscription_id: "sub_legacy", renewal: "" },
      { key: "new", status: "active", provider_subscription_id: "sub_new", renewal: "in_new" }],
    allowances: [{ key: "invoice/in_new" }], unknownStatuses: [204, 204, 204], unknownProviderCalls: 0, beforeResolution: [],
    deliveries: [204, 204, 204, 204, 204], owners: [{ charge_id: "ch_fixture", customer_id: "cus_new" }],
    outcomes: [[{ status: "clawed_back" }], [{ status: "open" }], [{ status: "clawed_back" }]],
  }))
}, 30_000)
