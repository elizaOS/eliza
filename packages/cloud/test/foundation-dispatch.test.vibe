// spec/cloud/shared/dispatchOnce.md, "Story: Send a change once and recover its outcome without sending it again"
import { assert, describe, it } from "@effect/vitest"
import { NotAState, conflictRefusal, decodeState, initial } from "../gen/cloud__shared__dispatchOnce.effect.vibe"
import { Refused, refusalBody } from "../src/http/refusal.vibe"
import { dispatchReceipt, loadReceipt, mayFollowWith, prepareReceipt, receiptOwner, receiptStatusAt, renderProviderKey, requestDigest, resolveReceipt, type LookupResult, type ProviderKey, type ProviderReply, type Receipt, type ReceiptRows } from "../src/shared/dispatch-once.vibe"
import { Store } from "../src/store/store.vibe"
import { shiftedClock } from "./support/clock.ts"
import { testCloud, type FakeServer, type TestCloud } from "./support/cloud.vibe"

type Mode = "apply" | "lose-reply" | "hang"

interface Change {
  readonly request: string
  readonly receipt: Receipt
}

const owner = receiptOwner("org-1", "user-1", "CheckoutSession")
const minute = 60_000

effect function decodeChange(input: unknown): Change!NotAState {
  const raw = typeof input === "object" && input !== null ? input as { readonly request?: unknown; readonly receipt?: unknown } : {}
  if (typeof raw.request !== "string") throw new NotAState({ input })
  return { request: raw.request, receipt: try decodeState(raw.receipt) }
}

function changesFor(request: string): ReceiptRows<Change, NotAState> {
  return {
    table: "scratch_changes",
    initial: { request, receipt: initial },
    decodeState: decodeChange,
    receiptOf: (change) => change.receipt,
    withReceipt: (change, receipt) => ({ ...change, receipt }),
    columns: (change, now) => ({ status: receiptStatusAt(change.receipt, now), updated_at: now })
  }
}

function mountProvider(fakes: FakeServer, modes: Map<string, Mode>, applied: Set<string>) {
  fakes.mount("/receipts/", async (request) => {
    if (request.method === "POST" && request.path === "/changes") {
      const key = String(request.headers["idempotency-key"])
      const mode = modes.get(key) ?? "apply"
      if (mode === "hang") {
        await new Promise((resolve) => setTimeout(resolve, 1_500))
        return { status: 503 }
      }
      applied.add(key)
      return mode === "lose-reply" ? { status: 500 } : { status: 200, body: { id: key } }
    }
    if (request.method === "GET" && request.path.startsWith("/changes/")) return { status: applied.has(decodeURIComponent(request.path.slice("/changes/".length))) ? 200 : 404 }
    return undefined
  })
}

effect function scratchTable(cloud: TestCloud) {
  try cloud.store.transaction((tx) => tx.script("CREATE TABLE scratch_changes (key text PRIMARY KEY, state jsonb NOT NULL, revision integer NOT NULL, status text NOT NULL, updated_at bigint NOT NULL)"))
}

effect function call(url: string, method: "GET" | "POST", headers: Readonly<Record<string, string>> = {}) {
  return tryPromise({ try: (signal: AbortSignal) => fetch(url, { method, headers, signal }).then((response) => response.status), catch: (cause) => String(cause) }) catch () => 0
}

effect function sendChange(cloud: TestCloud, rowKey: string, durable: string[], providerKey: string): ProviderReply<number>!! {
  const row = (try cloud.store.transaction((tx) => tx.query("SELECT state->'receipt'->'session'->>'phase' AS phase, state->'receipt'->'session'->>'effects' AS effects FROM scratch_changes WHERE key = $1", [rowKey]))) catch () => []
  durable.push(`${String(row[0]?.phase)}:${String(row[0]?.effects)}`)
  const status = try call(`${cloud.fakes.url}/receipts/changes`, "POST", { "idempotency-key": providerKey })
  if (status >= 200 && status < 300) return { kind: "applied", value: status }
  if (status === 404) return { kind: "refused", code: "NotFoundAtProvider" }
  return { kind: "unknown", cause: `the provider answered ${status}` }
}

effect function lookupChange(cloud: TestCloud, providerKey: string): ProviderReply<LookupResult>!! {
  const status = try call(`${cloud.fakes.url}/receipts/changes/${encodeURIComponent(providerKey)}`, "GET")
  if (status === 200) return { kind: "applied", value: { tag: "EffectSeen" } }
  if (status === 404) return { kind: "applied", value: { tag: "NothingSeen" } }
  return { kind: "unknown", cause: `the provider answered ${status}` }
}

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function stored(cloud: TestCloud, key: string) {
  return (try cloud.store.transaction((tx) => tx.query("SELECT status, revision FROM scratch_changes WHERE key = $1", [key]))).map((row) => [row.status, Number(row.revision)])
}

function terms(request: string, providerKey: ProviderKey, staleAfter: number, now: number) {
  return { digest: requestDigest({ request, plan: "plus_monthly" }), providerKey, staleAfter, expiresAt: now + 60 * minute }
}

describe("WP0 Foundation: dispatch once (spec/cloud/shared/dispatchOnce.md, \"Story: Send a change once and recover its outcome without sending it again\")", () => {
  it.live("A lost reply stays unknown until a lookup finds the change; the same key answers as it stands and another digest is 409 (spec/cloud/shared/dispatchOnce.md, \"Only a clear reply settles a receipt; any other reply leaves its outcome unknown\"; spec/cloud/shared/dispatchOnce.md, \"A receipt binds its owner, kind, request digest, provider key and stale duration once\")", () => scoped(effect {
    const modes = new Map<string, Mode>()
    const applied = new Set<string>()
    const cloud = try testCloud({ mount: (fakes) => mountProvider(fakes, modes, applied) })
    try scratchTable(cloud)
    const rows = changesFor("req-1")
    const providerKey: ProviderKey = { providerKind: "CheckoutSession", providerId: "req-1-a1" }
    modes.set(renderProviderKey(providerKey), "lose-reply")
    const durable: string[] = []
    provide Store = cloud.store {
      const now = try Clock.currentTimeMillis
      const prepared = try cloud.store.transaction((tx) => prepareReceipt(tx, rows, "req-1", owner, terms("req-1", providerKey, 5 * minute, now), now))
      const dispatched = try dispatchReceipt(rows, "req-1", owner, (key: string) => sendChange(cloud, "req-1", durable, key))
      const afterReply = receiptStatusAt(dispatched.state.receipt, try Clock.currentTimeMillis)
      const resolved = try resolveReceipt(rows, "req-1", (key: string) => lookupChange(cloud, key))
      const later = try Clock.currentTimeMillis
      const replay = try cloud.store.transaction((tx) => prepareReceipt(tx, rows, "req-1", owner, terms("req-1", providerKey, 5 * minute, later), later))
      const conflict = cloud.store.transaction((tx) => prepareReceipt(tx, rows, "req-1", owner, { ...terms("req-1", providerKey, 5 * minute, later), digest: requestDigest({ request: "req-1", plan: "pro_monthly" }) }, later)) catch (failure) => match (failure) {
        when Refused: refusalBody(failure.refusal);
        default: failure._tag;
      }
      const kept = try cloud.store.transaction((tx) => loadReceipt(tx, rows, "req-1", false))
      try check(() => assert.deepStrictEqual({
        prepared: [prepared.replayed, receiptStatusAt(prepared.state.receipt, now)],
        durable,
        reply: [dispatched.reply.kind, afterReply],
        resolved: [resolved.receipt.settlement, receiptStatusAt(resolved.receipt, later), resolved.request],
        replay: [replay.replayed, replay.state.receipt.settlement],
        conflict,
        kept: [kept.state.receipt.settlement, kept.state.receipt.digest === prepared.state.receipt.digest],
        sent: cloud.fakes.seen.filter((request) => request.method === "POST" && request.path === "/receipts/changes").length,
        row: try stored(cloud, "req-1")
      }, {
        prepared: [false, "StatusPrepared"],
        durable: ["Committed:1"],
        reply: ["unknown", "StatusUnknown"],
        resolved: ["Succeeded", "StatusSucceeded", "req-1"],
        replay: [true, "Succeeded"],
        conflict: { ...refusalBody(conflictRefusal), error: "idempotency_conflict" },
        kept: ["Succeeded", true],
        sent: 1,
        row: [["StatusSucceeded", 5]]
      }))
    }
  }))

  it.live("A stale change with no effect seen settles as not applied, and only then may a new provider key be sent (spec/cloud/shared/dispatchOnce.md, \"An unknown outcome is settled only by a provider lookup, and a sent one as not applied only after one more stale duration\"; spec/cloud/shared/dispatchOnce.md, \"A new receipt may follow only a rejected one, under a different provider key\")", () => scoped(effect {
    const modes = new Map<string, Mode>()
    const applied = new Set<string>()
    const cloud = try testCloud({ mount: (fakes) => mountProvider(fakes, modes, applied) })
    try scratchTable(cloud)
    const clock = try sync(() => shiftedClock())
    const staleAfter = 300
    const first: ProviderKey = { providerKind: "CheckoutSession", providerId: "req-2-a1" }
    const second: ProviderKey = { providerKind: "CheckoutSession", providerId: "req-2-a2" }
    modes.set(renderProviderKey(first), "hang")
    const durable: string[] = []
    provide Store = cloud.store, Clock.Clock = clock.clock {
      const now = try Clock.currentTimeMillis
      const rows = changesFor("req-2")
      try cloud.store.transaction((tx) => prepareReceipt(tx, rows, "req-2#1", owner, terms("req-2", first, staleAfter, now), now))
      const dispatched = try dispatchReceipt(rows, "req-2#1", owner, (key: string) => sendChange(cloud, "req-2#1", durable, key))
      const early = try resolveReceipt(rows, "req-2#1", (key: string) => lookupChange(cloud, key))
      const earlyAt = try Clock.currentTimeMillis
      try sync(() => clock.advance(staleAfter))
      const settled = try resolveReceipt(rows, "req-2#1", (key: string) => lookupChange(cloud, key))
      const retryAllowed = [mayFollowWith(early.receipt, second), mayFollowWith(settled.receipt, first), mayFollowWith(settled.receipt, second)]
      const at = try Clock.currentTimeMillis
      try cloud.store.transaction((tx) => prepareReceipt(tx, rows, "req-2#2", owner, terms("req-2", second, staleAfter, at), at))
      const retried = try dispatchReceipt(rows, "req-2#2", owner, (key: string) => sendChange(cloud, "req-2#2", durable, key))
      try check(() => assert.deepStrictEqual({
        durable,
        first: [dispatched.reply.kind, early.receipt.settlement, receiptStatusAt(early.receipt, earlyAt)],
        settled: [settled.receipt.settlement, settled.receipt.refusal],
        retryAllowed,
        retried: [retried.reply.kind, retried.state.receipt.settlement],
        applied: [...applied],
        rows: [try stored(cloud, "req-2#1"), try stored(cloud, "req-2#2")].map((found) => found.map(([status]) => status))
      }, {
        durable: ["Committed:1", "Committed:1"],
        first: ["unknown", "Unsettled", "StatusUnknown"],
        settled: ["NotApplied", "NoRefusal"],
        retryAllowed: [false, false, true],
        retried: ["applied", "Succeeded"],
        applied: [renderProviderKey(second)],
        rows: [["StatusRejected"], ["StatusSucceeded"]]
      }))
    }
  }))
})
