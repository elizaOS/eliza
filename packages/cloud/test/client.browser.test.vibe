// spec/cloud/client.md, "Story: Use the cloud from the device as configured"
import { assert, describe, it } from "@effect/vitest"
import { createCloudClient } from "../src/client/index.vibe"
import { clientBundleGraph, recordingFetch, runsInBrowser } from "./support/client.ts"

effect function check(run: () => void) {
  try Effect.try(run)
}

describe("Client bundle (spec/cloud/client.md)", () => {
  it.live("Loads without Node or core and reads the getter per call (\"Every call reads the credential when it is sent\")", () => effect {
    const graph = try sync(() => clientBundleGraph())
    const wire = try sync(() => recordingFetch({ object: "list", data: [{ id: "test-chat", object: "model", owned_by: "llm" }] }))
    let held = "eliza_mobile_first"
    const client = createCloudClient({ baseUrl: "https://api.example.com", credential: () => held, fetch: wire.fetch })
    try promise(() => client.models())
    held = "eliza_mobile_second"
    try promise(() => client.models())
    try check(() => assert.deepStrictEqual(
      { graph, sent: wire.authorizations, inBrowser: runsInBrowser() },
      { graph: { missing: [], serverFiles: [], forbidden: [] }, sent: ["Bearer eliza_mobile_first", "Bearer eliza_mobile_second"], inBrowser: true }
    ))
  })
})
