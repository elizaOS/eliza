// spec/cloud/services/maps.md, "Story: Answer a maps request once and pay for it once"
import { assert, describe, it } from "@effect/vitest"
import { FetchHttpClient } from "effect/http"
import { nearbyPrice } from "../gen/cloud__services__maps.effect.vibe"
import { describeMaps, mapsProvider } from "../src/providers/maps.vibe"
import { Deployment, deploymentLayer } from "../src/profile/profile.vibe"
import { startFakeServer } from "./support/fakes.ts"
import { secrets, testProfile } from "./support/profile.ts"
import { googleMapsFake, googlePlace } from "./support/maps-fake.ts"

describe("probe google maps", () => {
  it.live("google adapter against fake", () => scoped(effect {
    const fake = googleMapsFake()
    const fakes = try acquireRelease(promise(() => startFakeServer()), (server) => promise(() => server.close()))
    const profile = try sync(() => { fakes.mount("/maps/", fake.handler); return testProfile(fakes.url) })
    const layer = Layer.mergeAll(deploymentLayer(profile as unknown as Parameters<typeof deploymentLayer>[0], "staging"), FetchHttpClient.layer).pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets }))))
    const results = try Effect.provide(effect {
      const deployment = try Deployment
      const settings = deployment.settings.maps
      const provider = mapsProvider(settings)
      if (provider === undefined) throw new Error("no provider")
      const search = try provider.search({ query: "tor" })
      const geocode = try provider.geocode({ query: "Pariser Platz" })
      const reverse = try provider.reverse({ coordinate: { latitude: 52.5162, longitude: 13.3777 }, preferPlace: true })
      const countsAfterNearby = [fake.count("searchNearby"), fake.count("geocode")]
      fake.script({ kind: "empty" })
      const reverseEmpty = try provider.reverse({ coordinate: { latitude: 52.5162, longitude: 13.3777 }, preferPlace: true })
      const countsAfterEmpty = [fake.count("searchNearby"), fake.count("geocode")]
      const details = try provider.details({ id: googlePlace.id })
      const drive = try provider.routes({ from: { latitude: 52.517, longitude: 13.3888 }, to: { latitude: 52.5163, longitude: 13.3777 }, mode: "drive" })
      const driveMask = String(fake.calls[fake.calls.length - 1].request.headers["x-goog-fieldmask"])
      const walk = try provider.routes({ from: { latitude: 52.517, longitude: 13.3888 }, to: { latitude: 52.5163, longitude: 13.3777 }, mode: "walk" })
      const walkMask = String(fake.calls[fake.calls.length - 1].request.headers["x-goog-fieldmask"])
      fake.script({ kind: "empty" })
      const noRoute = try provider.routes({ from: { latitude: 52.517, longitude: 13.3888 }, to: { latitude: 52.5163, longitude: 13.3777 }, mode: "drive" })
      fake.script({ kind: "empty" })
      const zero = try provider.geocode({ query: "nowhere" })
      fake.script({ kind: "notJson" })
      const malformed = try provider.search({ query: "tor" })
      fake.script({ kind: "oversized" })
      const oversized = try provider.search({ query: "tor" })
      const tile = provider.tile === undefined ? undefined : try provider.tile({ z: 3, x: 1, y: 2 })
      const viewport = provider.viewport === undefined ? undefined : try provider.viewport({ zoom: 3, north: 53, south: 52, east: 14, west: 13 })
      fake.script({ kind: "slow", delayMs: 10_500 })
      const slow = try provider.search({ query: "tor" })
      fake.script({ kind: "outage" })
      const geocodeOutage = try provider.geocode({ query: "Pariser Platz" })
      fake.script({ kind: "empty" }, { kind: "outage" })
      const reverseOutage = try provider.reverse({ coordinate: { latitude: 52.5162, longitude: 13.3777 }, preferPlace: true })
      return { geocodeOutage, reverseOutage, search, geocode, reverse, countsAfterNearby, reverseEmpty, countsAfterEmpty, details, drive, driveMask, walk, walkMask, noRoute, zero, malformed, oversized, tile, viewport, slow, described: describeMaps(settings, "Test Cloud") }
    }, layer)
    try Console.log(JSON.stringify({ geocodeOutage: results.geocodeOutage, reverseOutage: results.reverseOutage, oversized: results.oversized, slow: results.slow, tile: results.tile?.kind, viewport: results.viewport }))
    assert.deepStrictEqual(
      [results.search.kind, results.geocode.kind, results.countsAfterNearby, results.countsAfterEmpty, results.tile?.kind, results.viewport?.kind, results.slow.kind, results.oversized.kind === "refused" ? results.oversized.code : "x", results.geocodeOutage, results.reverseOutage],
      ["answered", "answered", [1, 1], [2, 2], "answered", "answered", "unknown", "ProviderUnavailable", { kind: "refused", code: "ProviderUnavailable", observedMicros: 0 }, { kind: "refused", code: "ProviderUnavailable", observedMicros: nearbyPrice }])
  }), 30_000)
})
