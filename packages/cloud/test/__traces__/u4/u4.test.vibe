// spec/cloud/client.md, "Story: Tell an account that needs attention from a failing service"
import { expect, it } from "vitest"
import { checkEntitlement, nextRefreshDelay, parseEntitlementKeys, verifyEntitlement } from "../../../src/client/entitlement.vibe"

module web {
  /** @throws {never} */
  export function b64(bytes: Uint8Array): string {
    return btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
  }
  /** @throws {never} */
  export async function make(header: object, claims: object): Promise<{ token: string; jwk: JsonWebKey }> {
    const pair = await crypto.subtle.generateKey({ name: "ECDSA", namedCurve: "P-256" }, true, ["sign", "verify"])
    const enc = (v: object) => b64(new TextEncoder().encode(JSON.stringify(v)))
    const input = `${enc(header)}.${enc(claims)}`
    const sig = new Uint8Array(await crypto.subtle.sign({ name: "ECDSA", hash: "SHA-256" }, pair.privateKey, new TextEncoder().encode(input)))
    return { token: `${input}.${b64(sig)}`, jwk: await crypto.subtle.exportKey("jwk", pair.publicKey) }
  }
}
import { make } from web

const now = 1_800_000_000_000
const iat = now / 1000
const claims = { iss: "https://api.example.test", aud: "aud-x", sub: "u1", org: "o1", jti: "j1", iat, exp: iat + 1800, ver: 3, plan: { id: "plus", name: "Plus", status: "active" }, plan_ends_at: null, services: ["inference"], plan_allowance: { unit: "usd_micros", granted: 10, remaining: 5, periodStart: iat - 10, resetsAt: iat + 3600 } }
const header = { alg: "ES256", typ: "eliza-entitlement+jwt", kid: "k1" }

async function run(h: object, c: object, over: Partial<{ issuer: string; audience: string; now: number }> = {}): Promise<string> {
  const { token, jwk } = await make(h, c)
  const keys = parseEntitlementKeys({ keys: [{ kid: "k1", kty: "EC", crv: "P-256", x: jwk.x, y: jwk.y, alg: "ES256", use: "sig" }] }) ?? []
  try {
    await verifyEntitlement(token, { keys, issuer: "https://api.example.test", audience: "aud-x", now, ...over })
    return "ok"
  } catch (e) {
    return (e as { check: string }).check
  }
}

it("verifies and rejects per check", async () => {
  expect(await run(header, claims)).toBe("ok")
  expect(await run({ ...header, crit: ["x"] }, claims)).toBe("UnsupportedHeader")
  expect(await run({ ...header, kid: "k2" }, claims)).toBe("UnknownKey")
  expect(await run(header, { ...claims, ver: 2 })).toBe("WrongVersion")
  expect(await run(header, claims, { issuer: "https://other" })).toBe("WrongIssuer")
  expect(await run(header, claims, { audience: "x" })).toBe("WrongAudience")
  expect(await run(header, { ...claims, exp: iat + 3601 })).toBe("LifetimeTooLong")
  expect(await run(header, { ...claims, iat: iat + 61, exp: iat + 600 })).toBe("IssuedInFuture")
  expect(await run(header, claims, { now: now + 1800_000 })).toBe("Expired")
  expect(await run(header, { ...claims, plan: { id: "p", name: "P", status: "weird" } })).toBe("BadClaims")
  const { token, jwk } = await make(header, claims)
  const keys = parseEntitlementKeys({ keys: [{ kid: "k1", kty: "EC", crv: "P-256", x: jwk.x, y: jwk.y }] }) ?? []
  const other = await make(header, claims)
  const forged = `${token.split(".").slice(0, 2).join(".")}.${other.token.split(".")[2]}`
  try { await verifyEntitlement(forged, { keys, issuer: "https://api.example.test", audience: "aud-x", now }); expect.fail("forged") } catch (e) { expect((e as { check: string }).check).toBe("BadSignature") }
  const ent = await checkEntitlement(token, { keys, issuer: "https://api.example.test", audience: "aud-x", now })
  expect(ent.expiresAt).toBe(now + 1800_000)
  expect(ent.allowance?.resetsAt).toBe(now + 3600_000)
  expect(nextRefreshDelay(ent.expiresAt - now, 0)).toBe(1500_000)
  expect(nextRefreshDelay(0, 9)).toBe(300_000)
})
