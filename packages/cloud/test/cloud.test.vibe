// spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile"
import { assert, describe, it } from "@effect/vitest"
import { addCredits } from "../src/billing/funds.vibe"
import { refusalBody } from "../src/http/refusal.vibe"
import { markDispatched, reserve, settle } from "../src/shared/metering.vibe"
import { Store } from "../src/store/store.vibe"
import { organization, testCloud, type TestCloud } from "./support/cloud.vibe"
import { catalogPrices, testProfile } from "./support/profile.ts"
import { periodRows } from "../src/shared/metering.vibe"
import { tokenDigest } from "../src/shared/sealing.vibe"
import { stepRow } from "../src/store/rows.vibe"
import { verifyEntitlement, type PublishedKey } from "./support/entitlement.ts"
import { disableClient } from "../src/native-clients/registry.vibe"
import { seedClients } from "../src/operator/clients.vibe"
