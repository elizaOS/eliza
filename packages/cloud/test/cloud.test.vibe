describe("WP2 Native clients and pages: return pages (spec/cloud/returnPages.md)", () => {
  it.live("Bring me back to the app on its registered return only, and tell a payer the checkout ended (spec/cloud/returnPages.md, \"Story: Bring me back to the app when its link did not open\"; spec/cloud/returnPages.md, \"Story: Tell a payer the checkout ended\")", () => scoped(effect {
    const cloud = try testCloud()
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    const now = try Clock.currentTimeMillis
    provide deploymentLayer(profile, "staging") {
      try cloud.store.transaction((tx) => seedClients(tx, fixtureSeed.clients, now))
    }
    const web = { "x-forwarded-host": "www.staging.example.com" }
    const signIn = try cloud.call("/apps/fixture/sign-in?code=private-code&state=private-state", { headers: web })
    const html = String(signIn.body)
    const connect = try cloud.call("/apps/fixture/connect", { headers: web })
    const elsewhere = try cloud.call("/apps/fixture/elsewhere", { headers: web })
    const onApi = try cloud.call("/apps/fixture/sign-in")
    const paid = try cloud.call("/api/v1/subscriptions/checkout/payer?outcome=paid")
    const other = try cloud.call("/api/v1/subscriptions/checkout/payer?outcome=success")
    const payerOnWeb = try cloud.call("/api/v1/subscriptions/checkout/payer?outcome=paid", { headers: web })
    try check(() => assert.deepStrictEqual(
      {
        status: signIn.status,
        links: [...html.matchAll(/intent:\/\/[^"]*/g)].map((found) => found[0].replaceAll("&amp;", "&")),
        purpose: /data-purpose="([^"]*)"/.exec(html)?.[1],
        leaked: html.includes("private-code") || html.includes("private-state"),
        forms: html.includes("<form"),
        headers: [signIn.headers["cache-control"], signIn.headers["x-robots-tag"], signIn.headers["referrer-policy"]],
        script: /script-src '(sha256-[^']+)'/.exec(signIn.headers["content-security-policy"] ?? "")?.[1],
        framing: /frame-ancestors 'none'/.test(signIn.headers["content-security-policy"] ?? ""),
        connect: [connect.status, /data-purpose="([^"]*)"/.exec(String(connect.body))?.[1]],
        missing: [elsewhere.status, (elsewhere.body as { readonly error?: string }).error, onApi.status, payerOnWeb.status],
        payer: [paid.status, String(paid.body).includes("Check the subscription"), other.status, String(other.body).includes("Checkout closed")],
        payerScript: [/script-src/.test(paid.headers["content-security-policy"] ?? ""), /<script/.test(String(paid.body)), paid.headers["cache-control"]]
      },
      {
        status: 200,
        links: ["intent://www.staging.example.com/apps/fixture/sign-in#Intent;scheme=https;package=com.example.fixture;end"],
        purpose: "SignInPurpose",
        leaked: false,
        forms: false,
        headers: ["no-store", "noindex", "no-referrer"],
        script: forwardScriptHash,
        framing: true,
        connect: [200, "ConnectPurpose"],
        missing: [404, "not_found", 404, 404],
        payer: [200, true, 200, true],
        payerScript: [false, false, "no-store"]
      }
    ))
    provide deploymentLayer(profile, "staging") {
      try cloud.store.transaction((tx) => disableClient(tx, "com.example.fixture", now))
    }
    const disabled = try cloud.call("/apps/fixture/sign-in", { headers: web })
    try check(() => assert.strictEqual(disabled.status, 404))
  }))
})
describe("WP2 Native clients and pages: device keys (spec/cloud/nativeClients/deviceKeys.md)", () => {
  const binding = { clientId: "com.example.fixture", environment: "staging", redirectUri: "https://www.staging.example.com/apps/fixture/sign-in" }
  const verifier = "v".repeat(43) + "device-key-verifier"
  const state = "s".repeat(43)

  function bearer(token: string) {
    return { authorization: `Bearer ${token}` }
  }

  function refusal(body: unknown): ReadonlyArray<unknown> {
    const answer = body as { readonly error?: string; readonly reason?: string }
    return [answer.error, answer.reason]
  }

  effect function seeded(cloud: TestCloud) {
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    const now = try Clock.currentTimeMillis
    provide Store = cloud.store, deploymentLayer(profile, "staging") {
      try cloud.store.transaction((tx) => seedClients(tx, fixtureSeed.clients, now))
    }
  }

  effect function device(cloud: TestCloud, accessToken: string, name: string) {
    const connected = try cloud.call("/api/v1/app-auth/connect", { headers: bearer(accessToken), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256", deviceName: name } })
    const code = (connected.body as { readonly code: string }).code
    const minted = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...binding, grantType: "authorization_code", code, state, codeVerifier: verifier } })
    const credential = minted.body as { readonly credentialId: string; readonly secret: string }
    const acked = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: credential.secret } })
    return { connected, code, minted, credential, acked }
  }

  it.live("Sign a device in: connect, token twice, a wrong then the right proof, then use the key (spec/cloud/nativeClients/deviceKeys.md, \"Story: Sign a device in and keep its key\")", () => scoped(effect {
    const cloud = try testCloud()
    try seeded(cloud)
    const signed = try signedIn(cloud, "devices@example.com")
    const connected = try cloud.call("/api/v1/app-auth/connect", { headers: bearer(signed.accessToken), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256", deviceName: "Ada's phone" } })
    const opened = connected.body as { readonly code: string; readonly codeType: string; readonly expiresIn: number }
    const anonymousConnect = try cloud.call("/api/v1/app-auth/connect", { json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256" } })
    const tokenBody = { ...binding, grantType: "authorization_code", code: opened.code, state, codeVerifier: verifier }
    const wrongVerifier = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...tokenBody, codeVerifier: "w".repeat(43) } })
    const wrongState = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...tokenBody, state: "t".repeat(43) } })
    const first = try cloud.call("/api/v1/app-auth/mobile/token", { json: tokenBody })
    const again = try cloud.call("/api/v1/app-auth/mobile/token", { json: tokenBody })
    const credential = first.body as { readonly credentialId: string; readonly secret: string; readonly tokenType: string; readonly acknowledgementRequired: boolean; readonly user: { readonly id: string } }
    const unacknowledged = try cloud.call("/api/v1/user", { headers: bearer(credential.secret) })
    const wrongProof = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: `eliza_mobile_${"0".repeat(64)}` } })
    const acked = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: credential.secret } })
    const ackedAgain = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: credential.secret } })
    const tokenAfterAck = try cloud.call("/api/v1/app-auth/mobile/token", { json: tokenBody })
    const me = try cloud.call("/api/v1/user", { headers: bearer(credential.secret) })
    const stored = try sql(cloud, "SELECT phase, sealed_copy, device_name, key_expires_at FROM device_grants WHERE credential_id = $1", [credential.credentialId])
    const acknowledged = acked.body as { readonly status: string; readonly credentialId: string; readonly expiresAt: string }
    try check(() => assert.deepStrictEqual(
      {
        connect: [connected.status, /^emac_[0-9a-f]{64}$/.test(opened.code), opened.codeType, opened.expiresIn],
        anonymousConnect: anonymousConnect.status,
        wrongVerifier: [wrongVerifier.status, refusal(wrongVerifier.body)[0]],
        wrongState: [wrongState.status, refusal(wrongState.body)[0]],
        token: [first.status, /^eliza_mobile_[0-9a-f]{64}$/.test(credential.secret), credential.tokenType, credential.acknowledgementRequired, credential.user.id],
        replay: [again.status, again.body],
        unacknowledged: [unacknowledged.status, refusal(unacknowledged.body)[0]],
        wrongProof: [wrongProof.status, refusal(wrongProof.body)[0]],
        acked: [acked.status, acknowledged.status, acknowledged.credentialId],
        ackedAgain: [ackedAgain.status, ackedAgain.body],
        tokenAfterAck: tokenAfterAck.status >= 400,
        me: me.status,
        stored: [stored[0]?.phase, stored[0]?.sealed_copy, stored[0]?.device_name, Number(stored[0]?.key_expires_at) === Date.parse(acknowledged.expiresAt)]
      },
      {
        connect: [200, true, "mobile_app_auth_code", 300],
        anonymousConnect: 401,
        wrongVerifier: [401, "credential_proof_invalid"],
        wrongState: [401, "credential_proof_invalid"],
        token: [200, true, "Bearer", true, signed.user.id],
        replay: [200, first.body],
        unacknowledged: [401, "authentication_required"],
        wrongProof: [401, "credential_proof_invalid"],
        acked: [200, "acknowledged", credential.credentialId],
        ackedAgain: [200, acked.body],
        tokenAfterAck: true,
        me: 200,
        stored: ["active", null, "Ada's phone", true]
      }
    ))
  }))

  it.live("Refuse an expired key, end this key on self-revoke, end every key on revokeAll, and sweep only stale grants (spec/cloud/nativeClients/deviceKeys.md, \"Story: Sign a device in and keep its key\")", () => scoped(effect {
    const cloud = try testCloud()
    try seeded(cloud)
    const signed = try signedIn(cloud, "keys@example.com")
    const expiring = try device(cloud, signed.accessToken, "Expiring")
    const leaving = try device(cloud, signed.accessToken, "Leaving")
    const kept = try device(cloud, signed.accessToken, "Kept")
    const now = try Clock.currentTimeMillis
    try sql(cloud, "UPDATE device_grants SET key_expires_at = $2, state = jsonb_set(state, '{keyExpiresAt}', to_jsonb($2::bigint)) WHERE credential_id = $1", [expiring.credential.credentialId, now - 1])
    const expired = try cloud.call("/api/v1/user", { headers: bearer(expiring.credential.secret) })

    const revoked = try cloud.call("/api/v1/api-keys/current", { method: "DELETE", headers: bearer(leaving.credential.secret) })
    const afterSelfRevoke = try cloud.call("/api/v1/user", { headers: bearer(leaving.credential.secret) })
    const keptAfterSelfRevoke = try cloud.call("/api/v1/user", { headers: bearer(kept.credential.secret) })
    const sessionRevoke = try cloud.call("/api/v1/api-keys/current", { method: "DELETE", headers: bearer(signed.accessToken) })

    const stale = try cloud.call("/api/v1/app-auth/connect", { headers: bearer(signed.accessToken), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256" } })
    const staleCode = (stale.body as { readonly code: string }).code
    try sql(cloud, "UPDATE device_grants SET code_expires_at = $2, state = jsonb_set(state, '{codeExpiresAt}', to_jsonb($2::bigint)) WHERE code_digest = $1", [tokenDigest(staleCode), now - 1])
    provide Store = cloud.store {
      try sweepGrants()
    }
    const swept = try sql(cloud, "SELECT phase FROM device_grants WHERE code_digest = $1", [tokenDigest(staleCode)])
    const lateToken = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...binding, grantType: "authorization_code", code: staleCode, state, codeVerifier: verifier } })
    const keptAfterSweep = try cloud.call("/api/v1/user", { headers: bearer(kept.credential.secret) })

    const ended = try cloud.store.transaction((tx) => revokeAll(tx, signed.user.id, now))
    const afterRevokeAll = try cloud.call("/api/v1/user", { headers: bearer(kept.credential.secret) })
    const session = try cloud.call("/api/v1/user", { headers: bearer(signed.accessToken) })
    try check(() => assert.deepStrictEqual(
      {
        acked: [expiring.acked.status, leaving.acked.status, kept.acked.status],
        expired: [expired.status, ...refusal(expired.body)],
        revoked: [revoked.status, (revoked.body as { readonly status: string }).status, afterSelfRevoke.status, keptAfterSelfRevoke.status, sessionRevoke.status],
        swept: [swept[0]?.phase === "code_issued", lateToken.status >= 400, keptAfterSweep.status],
        revokeAll: [ended, afterRevokeAll.status, ...refusal(afterRevokeAll.body), session.status]
      },
      {
        acked: [200, 200, 200],
        expired: [401, "authentication_required", "credential_expired"],
        revoked: [200, "revoked", 401, 200, 401],
        swept: [false, true, 200],
        revokeAll: [1, 401, "authentication_required", "credential_revoked", 200]
      }
    ))
  }))
})
describe("WP2 Native clients and pages: registry (spec/cloud/nativeClients/registry.md)", () => {
  const fingerprint = "E3:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"
  const web = "https://www.staging.example.com"
  const signInOne = `${web}/apps/one/sign-in`
  const one = {
    clientId: "com.example.one", environment: "staging", displayName: "One", androidPackage: "com.example.one", certFingerprints: [fingerprint],
    signInReturn: signInOne, billingReturn: `${web}/apps/one/billing`, credentialTtlMs: 30 * 86_400_000, nativeGoogle: true, enabled: true
  }
  const two = { ...one, clientId: "com.example.two", displayName: "Two", androidPackage: "com.example.two", signInReturn: `${web}/apps/two/sign-in`, billingReturn: `${web}/apps/two/billing`, nativeGoogle: false }

  function configPath(clientId: string, environment: string, redirectUri: string): string {
    return `/api/v1/app-auth/mobile/config?${new URLSearchParams({ clientId, environment, redirectUri }).toString()}`
  }

  function code(body: unknown): string | undefined {
    return (body as { readonly error?: string }).error
  }

  effect function registered(cloud: TestCloud, edit: ProfileEdit | undefined, run: (tx: Tx, now: number) => unknown!{ readonly _tag: string }!(Deployment | Store)) {
    const base = try sync(() => testProfile(cloud.fakes.url))
    const profile = try parseProfile(edit === undefined ? base : edit(base))
    const now = try Clock.currentTimeMillis
    provide Store = cloud.store, deploymentLayer(profile, "staging") {
      return try failureTag(cloud.store.transaction((tx) => run(tx, now)))
    }
  }

  it.live("Admit only a registered native client on its exact return, and publish its Android association (spec/cloud/nativeClients/registry.md, \"Story: Admit only a registered native client\"; spec/cloud/nativeClients/registry.md, \"Story: Tell a client exactly why it was refused\")", () => scoped(effect {
    const cloud = try testCloud()
    const writes = [
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return (try registerClient(tx, try decodeRegistration(one), now)).clientId }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return (try registerClient(tx, try decodeRegistration(two), now)).clientId }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try registerClient(tx, try decodeRegistration({ ...two, clientId: "com.example.three", signInReturn: "https://api.staging.example.com/apps/three", billingReturn: `${web}/apps/three/billing`, androidPackage: "com.example.three" }), now) }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try registerClient(tx, try decodeRegistration({ ...two, clientId: "com.example.four", androidPackage: "com.example.one", signInReturn: `${web}/apps/four/sign-in`, billingReturn: `${web}/apps/four/billing` }), now) }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try decodeRegistration({ ...two, signInReturn: `${web}/apps/two/sign-in?next=1` }) }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try updateClient(tx, try decodeRegistration({ ...two, clientId: "com.example.unknown", androidPackage: "com.example.unknown" }), now) })
    ]
    const admitted = try cloud.call(configPath("com.example.one", "staging", signInOne))
    const unknown = try cloud.call(configPath("com.example.nobody", "staging", signInOne))
    const otherEnvironment = try cloud.call(configPath("com.example.one", "production", signInOne))
    const wrongReturn = try cloud.call(configPath("com.example.one", "staging", `${web}/apps/one/billing`))
    const notAUrl = try cloud.call(configPath("com.example.one", "staging", "one-sign-in"))
    const linksBefore = try cloud.call("/.well-known/assetlinks.json")
    try registered(cloud, undefined, effect (tx: Tx, now: number) => { try disableClient(tx, "com.example.two", now) })
    const disabled = try cloud.call(configPath("com.example.two", "staging", `${web}/apps/two/sign-in`))
    const linksAfter = try cloud.call("/.well-known/assetlinks.json")
    try check(() => assert.deepStrictEqual(
      {
        writes,
        admitted: [admitted.status, admitted.body],
        refusals: [unknown, otherEnvironment, wrongReturn, notAUrl, disabled].map((answer) => [answer.status, code(answer.body), (answer.body as { readonly retryable?: boolean }).retryable]),
        linksBefore: (linksBefore.body as ReadonlyArray<{ readonly target: { readonly package_name: string } }>).map((statement) => statement.target.package_name),
        linksAfter: linksAfter.body
      },
      {
        writes: [
          "succeeded with \"com.example.one\"", "succeeded with \"com.example.two\"", "RegistrationRefused", "RegistrationRefused", "RegistrationInvalid", "ClientNotRegistered"
        ],
        admitted: [200, {
          clientId: "com.example.one", environment: "staging", redirectUri: signInOne, codeChallengeMethod: "S256", credentialTtlMs: 30 * 86_400_000,
          methods: { email: true, sms: true, google: true },
          google: { configured: true, serverClientId: "google-server-client", nativeSignIn: true }
        }],
        refusals: [[400, "invalid_client", false], [400, "invalid_client", false], [400, "redirect_mismatch", false], [400, "redirect_mismatch", false], [403, "client_disabled", false]],
        linksBefore: ["com.example.one", "com.example.two"],
        linksAfter: [{ relation: ["delegate_permission/common.handle_all_urls"], target: { namespace: "android_app", package_name: "com.example.one", sha256_cert_fingerprints: [fingerprint] } }]
      }
    ))
  }))

  it.live('Link Google only from the reviewed account with the registered return and matching verifier (spec/cloud/identity/signInMethods.md, "Story: Review, link and remove my sign-in methods"; spec/cloud/identity/federatedSignIn.md, "An ID token spends a live challenge once, only with the client, verifier, signature, issuer, audience and nonce all right, and a refused one spends nothing")', () => scoped(effect {
    const google = try tryPromise(() => nativeGoogleFixture())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", () => ({ status: 200, body: { keys: google.keys } })) })
    try registered(cloud, undefined, effect (tx: Tx, now: number) => { try registerClient(tx, try decodeRegistration(one), now) })
    const owner = try signedIn(cloud, "link-owner@example.com")
    const other = try signedIn(cloud, "link-other@example.com")
    const ownerHeaders = { authorization: `Bearer ${owner.accessToken}` }
    const otherHeaders = { authorization: `Bearer ${other.accessToken}` }
    const methods = "/api/v1/user/methods"
    const challenge = methods + "/google/challenge"
    const link = methods + "/google/link"
    const verifier = "v".repeat(43)
    const fields = { clientId: one.clientId, environment: "staging", redirectUri: signInOne, codeChallenge: s256(verifier), codeChallengeMethod: "S256" }
    const wrongReturn = try cloud.call(challenge, { headers: ownerHeaders, json: { ...fields, redirectUri: one.billingReturn } })
    const wrongEnvironment = try cloud.call(challenge, { headers: ownerHeaders, json: { ...fields, environment: "production" } })
    const opened = try cloud.call(challenge, { headers: ownerHeaders, json: fields })
    const { challengeId, nonce } = try Schema.decodeUnknownEffect(Schema.Struct({ challengeId: Schema.String, nonce: Schema.String }))(opened.body)
    const token = try tryPromise(() => google.issue(nonce))
    const wrongNonceToken = try tryPromise(() => google.issue("different-challenge-nonce"))
    const reviewSchema = Schema.Struct({ reviewId: Schema.String })
    const firstReview = try cloud.call(methods, { headers: ownerHeaders })
    const otherReview = try cloud.call(methods, { headers: otherHeaders })
    const firstId = (try Schema.decodeUnknownEffect(reviewSchema)(firstReview.body)).reviewId
    const otherId = (try Schema.decodeUnknownEffect(reviewSchema)(otherReview.body)).reviewId
    const wrongOwner = try cloud.call(link, { headers: otherHeaders, json: { reviewId: otherId, challengeId, idToken: token, codeVerifier: verifier } })
    const wrongVerifier = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: firstId, challengeId, idToken: token, codeVerifier: "w".repeat(43) } })
    const nonceReview = try cloud.call(methods, { headers: ownerHeaders })
    const nonceId = (try Schema.decodeUnknownEffect(reviewSchema)(nonceReview.body)).reviewId
    const wrongNonce = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: nonceId, challengeId, idToken: wrongNonceToken, codeVerifier: verifier } })
    const validReview = try cloud.call(methods, { headers: ownerHeaders })
    const validId = (try Schema.decodeUnknownEffect(reviewSchema)(validReview.body)).reviewId
    const linked = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: validId, challengeId, idToken: token, codeVerifier: verifier } })
    const after = try cloud.call(methods, { headers: ownerHeaders })
    const account = try Schema.decodeUnknownEffect(Schema.Struct({ reviewId: Schema.String, methods: Schema.Array(Schema.Struct({ kind: Schema.String })) }))(after.body)
    const replayed = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: account.reviewId, challengeId, idToken: token, codeVerifier: verifier } })
    try check(() => assert.deepStrictEqual(
      {
        admitted: opened.status, invalidChallenge: [wrongReturn, wrongEnvironment].map((answer) => [answer.status, code(answer.body)]),
        rejectedProof: [wrongOwner.status, wrongVerifier.status, wrongNonce.status], linked: [linked.status, linked.body],
        methods: account.methods.map(({ kind }) => kind), replayed: replayed.status,
      },
      {
        admitted: 200, invalidChallenge: [[400, "redirect_mismatch"], [400, "invalid_client"]],
        rejectedProof: [401, 401, 401], linked: [200, { status: "linked", method: "google" }],
        methods: ["email", "google"], replayed: 401,
      }
    ))
  }), 60_000)

  it.live("Tell an app that Google sign-in is off (spec/cloud/nativeClients/registry.md, \"Story: Tell a client exactly why it was refused\")", () => scoped(effect {
    const googleOff: ProfileEdit = (profile) => {
      const { google, ...staging } = profile.environments.staging
      return { ...profile, environments: { ...profile.environments, staging: { ...staging, capabilities: staging.capabilities.filter((capability) => capability !== "managedGoogle") } } }
    }
    const cloud = try testCloud({ edit: googleOff })
    try registered(cloud, googleOff, effect (tx: Tx, now: number) => { return try registerClient(tx, try decodeRegistration(one), now) })
    const answer = try cloud.call(configPath("com.example.one", "staging", signInOne))
    try check(() => assert.deepStrictEqual([answer.status, (answer.body as { readonly google?: unknown }).google], [200, { configured: false, serverClientId: "", nativeSignIn: false }]))
  }))
})

