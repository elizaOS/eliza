// spec/cloud/client.md, "Story: Use the cloud from the device as configured"; spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile"
import { assert, it } from "@effect/vitest"
import { CLEF_DECISIONS_PATH, createCloudClient, normalizeSubscriptionCode, parseEnvironment } from "../src/index.vibe"

module node {
  /** @throws {never} */
  export function recordingFetch(seen: string[]): typeof fetch {
    return async (input, init) => {
      const request = new Request(input, init)
      seen.push(`${new URL(request.url).pathname}:${request.headers.get("authorization") ?? ""}`)
      return Response.json({ object: "list", data: [{ id: "m1", object: "model", owned_by: "eliza" }] })
    }
  }
}
import { recordingFetch } from node

it.effect('The browser-safe cloud root barrel serves client, profile and Clef decisions contracts (spec/cloud/client.md, "Every call reads the credential when it is sent"; spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile")', effect () => {
  const seen: string[] = []
  let token = "eliza_mobile_one"
  const client = createCloudClient({
    baseUrl: "https://api.example.com",
    credential: () => token,
    fetch: recordingFetch(seen),
  })
  try Effect.promise(() => client.models())
  token = "eliza_mobile_two"
  try Effect.promise(() => client.models())
  assert.deepStrictEqual(seen, [
    "/api/v1/models:Bearer eliza_mobile_one",
    "/api/v1/models:Bearer eliza_mobile_two",
  ])
  assert.strictEqual(try parseEnvironment("staging"), "staging")
  assert.strictEqual(CLEF_DECISIONS_PATH, "/api/v1/decisions")
  assert.strictEqual(normalizeSubscriptionCode("abcd-efgh-jkmn-pqrs"), "ABCDEFGHJKMNPQRS")
})
