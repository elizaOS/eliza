describe("WP2 Native clients and pages: return pages (spec/cloud/returnPages.md)", () => {
  it.live("Bring me back to the app on its registered return only, and tell a payer the checkout ended (spec/cloud/returnPages.md, \"Story: Bring me back to the app when its link did not open\"; spec/cloud/returnPages.md, \"Story: Tell a payer the checkout ended\")", () => scoped(effect {
    const cloud = try testCloud()
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    const now = try Clock.currentTimeMillis
    provide deploymentLayer(profile, "staging") {
      try cloud.store.transaction((tx) => seedClients(tx, fixtureSeed.clients, now))
    }
    const web = { "x-forwarded-host": "www.staging.example.com" }
    const signIn = try cloud.call("/apps/fixture/sign-in?code=private-code&state=private-state", { headers: web })
    const html = String(signIn.body)
    const connect = try cloud.call("/apps/fixture/connect", { headers: web })
    const elsewhere = try cloud.call("/apps/fixture/elsewhere", { headers: web })
    const onApi = try cloud.call("/apps/fixture/sign-in")
    const paid = try cloud.call("/api/v1/subscriptions/checkout/payer?outcome=paid")
    const other = try cloud.call("/api/v1/subscriptions/checkout/payer?outcome=success")
    const payerOnWeb = try cloud.call("/api/v1/subscriptions/checkout/payer?outcome=paid", { headers: web })
    try check(() => assert.deepStrictEqual(
      {
        status: signIn.status,
        links: [...html.matchAll(/intent:\/\/[^"]*/g)].map((found) => found[0].replaceAll("&amp;", "&")),
        purpose: /data-purpose="([^"]*)"/.exec(html)?.[1],
        leaked: html.includes("private-code") || html.includes("private-state"),
        forms: html.includes("<form"),
        headers: [signIn.headers["cache-control"], signIn.headers["x-robots-tag"], signIn.headers["referrer-policy"]],
        script: /script-src '(sha256-[^']+)'/.exec(signIn.headers["content-security-policy"] ?? "")?.[1],
        framing: /frame-ancestors 'none'/.test(signIn.headers["content-security-policy"] ?? ""),
        connect: [connect.status, /data-purpose="([^"]*)"/.exec(String(connect.body))?.[1]],
        missing: [elsewhere.status, (elsewhere.body as { readonly error?: string }).error, onApi.status, payerOnWeb.status],
        payer: [paid.status, String(paid.body).includes("Check the subscription"), other.status, String(other.body).includes("Checkout closed")],
        payerScript: [/script-src/.test(paid.headers["content-security-policy"] ?? ""), /<script/.test(String(paid.body)), paid.headers["cache-control"]]
      },
      {
        status: 200,
        links: ["intent://www.staging.example.com/apps/fixture/sign-in#Intent;scheme=https;package=com.example.fixture;end"],
        purpose: "SignInPurpose",
        leaked: false,
        forms: false,
        headers: ["no-store", "noindex", "no-referrer"],
        script: forwardScriptHash,
        framing: true,
        connect: [200, "ConnectPurpose"],
        missing: [404, "not_found", 404, 404],
        payer: [200, true, 200, true],
        payerScript: [false, false, "no-store"]
      }
    ))
    provide deploymentLayer(profile, "staging") {
      try cloud.store.transaction((tx) => disableClient(tx, "com.example.fixture", now))
    }
    const disabled = try cloud.call("/apps/fixture/sign-in", { headers: web })
    try check(() => assert.strictEqual(disabled.status, 404))
  }))
})
describe("WP2 Native clients and pages: device keys (spec/cloud/nativeClients/deviceKeys.md)", () => {
  const binding = { clientId: "com.example.fixture", environment: "staging", redirectUri: "https://www.staging.example.com/apps/fixture/sign-in" }
  const verifier = "v".repeat(43) + "device-key-verifier"
  const state = "s".repeat(43)

  function bearer(token: string) {
    return { authorization: `Bearer ${token}` }
  }

  function refusal(body: unknown): ReadonlyArray<unknown> {
    const answer = body as { readonly error?: string; readonly reason?: string }
    return [answer.error, answer.reason]
  }

  effect function seeded(cloud: TestCloud) {
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    const now = try Clock.currentTimeMillis
    provide Store = cloud.store, deploymentLayer(profile, "staging") {
      try cloud.store.transaction((tx) => seedClients(tx, fixtureSeed.clients, now))
    }
  }

  effect function device(cloud: TestCloud, accessToken: string, name: string) {
    const connected = try cloud.call("/api/v1/app-auth/connect", { headers: bearer(accessToken), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256", deviceName: name } })
    const code = (connected.body as { readonly code: string }).code
    const minted = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...binding, grantType: "authorization_code", code, state, codeVerifier: verifier } })
    const credential = minted.body as { readonly credentialId: string; readonly secret: string }
    const acked = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: credential.secret } })
    return { connected, code, minted, credential, acked }
  }

  it.live("Sign a device in: connect, token twice, a wrong then the right proof, then use the key (spec/cloud/nativeClients/deviceKeys.md, \"Story: Sign a device in and keep its key\")", () => scoped(effect {
    const cloud = try testCloud()
    try seeded(cloud)
    const signed = try signedIn(cloud, "devices@example.com")
    const connected = try cloud.call("/api/v1/app-auth/connect", { headers: bearer(signed.accessToken), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256", deviceName: "Ada's phone" } })
    const opened = connected.body as { readonly code: string; readonly codeType: string; readonly expiresIn: number }
    const anonymousConnect = try cloud.call("/api/v1/app-auth/connect", { json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256" } })
    const tokenBody = { ...binding, grantType: "authorization_code", code: opened.code, state, codeVerifier: verifier }
    const wrongVerifier = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...tokenBody, codeVerifier: "w".repeat(43) } })
    const wrongState = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...tokenBody, state: "t".repeat(43) } })
    const first = try cloud.call("/api/v1/app-auth/mobile/token", { json: tokenBody })
    const again = try cloud.call("/api/v1/app-auth/mobile/token", { json: tokenBody })
    const credential = first.body as { readonly credentialId: string; readonly secret: string; readonly tokenType: string; readonly acknowledgementRequired: boolean; readonly user: { readonly id: string } }
    const unacknowledged = try cloud.call("/api/v1/user", { headers: bearer(credential.secret) })
    const wrongProof = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: `eliza_mobile_${"0".repeat(64)}` } })
    const acked = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: credential.secret } })
    const ackedAgain = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: credential.credentialId, secret: credential.secret } })
    const tokenAfterAck = try cloud.call("/api/v1/app-auth/mobile/token", { json: tokenBody })
    const me = try cloud.call("/api/v1/user", { headers: bearer(credential.secret) })
    const stored = try sql(cloud, "SELECT phase, sealed_copy, device_name, key_expires_at FROM device_grants WHERE credential_id = $1", [credential.credentialId])
    const acknowledged = acked.body as { readonly status: string; readonly credentialId: string; readonly expiresAt: string }
    try check(() => assert.deepStrictEqual(
      {
        connect: [connected.status, /^emac_[0-9a-f]{64}$/.test(opened.code), opened.codeType, opened.expiresIn],
        anonymousConnect: anonymousConnect.status,
        wrongVerifier: [wrongVerifier.status, refusal(wrongVerifier.body)[0]],
        wrongState: [wrongState.status, refusal(wrongState.body)[0]],
        token: [first.status, /^eliza_mobile_[0-9a-f]{64}$/.test(credential.secret), credential.tokenType, credential.acknowledgementRequired, credential.user.id],
        replay: [again.status, again.body],
        unacknowledged: [unacknowledged.status, refusal(unacknowledged.body)[0]],
        wrongProof: [wrongProof.status, refusal(wrongProof.body)[0]],
        acked: [acked.status, acknowledged.status, acknowledged.credentialId],
        ackedAgain: [ackedAgain.status, ackedAgain.body],
        tokenAfterAck: tokenAfterAck.status >= 400,
        me: me.status,
        stored: [stored[0]?.phase, stored[0]?.sealed_copy, stored[0]?.device_name, Number(stored[0]?.key_expires_at) === Date.parse(acknowledged.expiresAt)]
      },
      {
        connect: [200, true, "mobile_app_auth_code", 300],
        anonymousConnect: 401,
        wrongVerifier: [401, "credential_proof_invalid"],
        wrongState: [401, "credential_proof_invalid"],
        token: [200, true, "Bearer", true, signed.user.id],
        replay: [200, first.body],
        unacknowledged: [401, "authentication_required"],
        wrongProof: [401, "credential_proof_invalid"],
        acked: [200, "acknowledged", credential.credentialId],
        ackedAgain: [200, acked.body],
        tokenAfterAck: true,
        me: 200,
        stored: ["active", null, "Ada's phone", true]
      }
    ))
  }))

  it.live("Refuse an expired key, end this key on self-revoke, end every key on revokeAll, and sweep only stale grants (spec/cloud/nativeClients/deviceKeys.md, \"Story: Sign a device in and keep its key\")", () => scoped(effect {
    const cloud = try testCloud()
    try seeded(cloud)
    const signed = try signedIn(cloud, "keys@example.com")
    const expiring = try device(cloud, signed.accessToken, "Expiring")
    const leaving = try device(cloud, signed.accessToken, "Leaving")
    const kept = try device(cloud, signed.accessToken, "Kept")
    const now = try Clock.currentTimeMillis
    try sql(cloud, "UPDATE device_grants SET key_expires_at = $2, state = jsonb_set(state, '{keyExpiresAt}', to_jsonb($2::bigint)) WHERE credential_id = $1", [expiring.credential.credentialId, now - 1])
    const expired = try cloud.call("/api/v1/user", { headers: bearer(expiring.credential.secret) })

    const revoked = try cloud.call("/api/v1/api-keys/current", { method: "DELETE", headers: bearer(leaving.credential.secret) })
    const afterSelfRevoke = try cloud.call("/api/v1/user", { headers: bearer(leaving.credential.secret) })
    const keptAfterSelfRevoke = try cloud.call("/api/v1/user", { headers: bearer(kept.credential.secret) })
    const sessionRevoke = try cloud.call("/api/v1/api-keys/current", { method: "DELETE", headers: bearer(signed.accessToken) })

    const stale = try cloud.call("/api/v1/app-auth/connect", { headers: bearer(signed.accessToken), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256" } })
    const staleCode = (stale.body as { readonly code: string }).code
    try sql(cloud, "UPDATE device_grants SET code_expires_at = $2, state = jsonb_set(state, '{codeExpiresAt}', to_jsonb($2::bigint)) WHERE code_digest = $1", [tokenDigest(staleCode), now - 1])
    provide Store = cloud.store {
      try sweepGrants()
    }
    const swept = try sql(cloud, "SELECT phase FROM device_grants WHERE code_digest = $1", [tokenDigest(staleCode)])
    const lateToken = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...binding, grantType: "authorization_code", code: staleCode, state, codeVerifier: verifier } })
    const keptAfterSweep = try cloud.call("/api/v1/user", { headers: bearer(kept.credential.secret) })

    const ended = try cloud.store.transaction((tx) => revokeAll(tx, signed.user.id, now))
    const afterRevokeAll = try cloud.call("/api/v1/user", { headers: bearer(kept.credential.secret) })
    const session = try cloud.call("/api/v1/user", { headers: bearer(signed.accessToken) })
    try check(() => assert.deepStrictEqual(
      {
        acked: [expiring.acked.status, leaving.acked.status, kept.acked.status],
        expired: [expired.status, ...refusal(expired.body)],
        revoked: [revoked.status, (revoked.body as { readonly status: string }).status, afterSelfRevoke.status, keptAfterSelfRevoke.status, sessionRevoke.status],
        swept: [swept[0]?.phase === "code_issued", lateToken.status >= 400, keptAfterSweep.status],
        revokeAll: [ended, afterRevokeAll.status, ...refusal(afterRevokeAll.body), session.status]
      },
      {
        acked: [200, 200, 200],
        expired: [401, "authentication_required", "credential_expired"],
        revoked: [200, "revoked", 401, 200, 401],
        swept: [false, true, 200],
        revokeAll: [1, 401, "authentication_required", "credential_revoked", 200]
      }
    ))
  }))
})
describe("WP2 Native clients and pages: registry (spec/cloud/nativeClients/registry.md)", () => {
  const fingerprint = "E3:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"
  const web = "https://www.staging.example.com"
  const signInOne = `${web}/apps/one/sign-in`
  const one = {
    clientId: "com.example.one", environment: "staging", displayName: "One", androidPackage: "com.example.one", certFingerprints: [fingerprint],
    signInReturn: signInOne, billingReturn: `${web}/apps/one/billing`, credentialTtlMs: 30 * 86_400_000, nativeGoogle: true, enabled: true
  }
  const two = { ...one, clientId: "com.example.two", displayName: "Two", androidPackage: "com.example.two", signInReturn: `${web}/apps/two/sign-in`, billingReturn: `${web}/apps/two/billing`, nativeGoogle: false }

  function configPath(clientId: string, environment: string, redirectUri: string): string {
    return `/api/v1/app-auth/mobile/config?${new URLSearchParams({ clientId, environment, redirectUri }).toString()}`
  }

  function code(body: unknown): string | undefined {
    return (body as { readonly error?: string }).error
  }

  effect function registered(cloud: TestCloud, edit: ProfileEdit | undefined, run: (tx: Tx, now: number) => unknown!{ readonly _tag: string }!(Deployment | Store)) {
    const base = try sync(() => testProfile(cloud.fakes.url))
    const profile = try parseProfile(edit === undefined ? base : edit(base))
    const now = try Clock.currentTimeMillis
    provide Store = cloud.store, deploymentLayer(profile, "staging") {
      return try failureTag(cloud.store.transaction((tx) => run(tx, now)))
    }
  }

  it.live("Admit only a registered native client on its exact return, and publish its Android association (spec/cloud/nativeClients/registry.md, \"Story: Admit only a registered native client\"; spec/cloud/nativeClients/registry.md, \"Story: Tell a client exactly why it was refused\")", () => scoped(effect {
    const cloud = try testCloud()
    const writes = [
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return (try registerClient(tx, try decodeRegistration(one), now)).clientId }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return (try registerClient(tx, try decodeRegistration(two), now)).clientId }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try registerClient(tx, try decodeRegistration({ ...two, clientId: "com.example.three", signInReturn: "https://api.staging.example.com/apps/three", billingReturn: `${web}/apps/three/billing`, androidPackage: "com.example.three" }), now) }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try registerClient(tx, try decodeRegistration({ ...two, clientId: "com.example.four", androidPackage: "com.example.one", signInReturn: `${web}/apps/four/sign-in`, billingReturn: `${web}/apps/four/billing` }), now) }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try decodeRegistration({ ...two, signInReturn: `${web}/apps/two/sign-in?next=1` }) }),
      try registered(cloud, undefined, effect (tx: Tx, now: number) => { return try updateClient(tx, try decodeRegistration({ ...two, clientId: "com.example.unknown", androidPackage: "com.example.unknown" }), now) })
    ]
    const admitted = try cloud.call(configPath("com.example.one", "staging", signInOne))
    const unknown = try cloud.call(configPath("com.example.nobody", "staging", signInOne))
    const otherEnvironment = try cloud.call(configPath("com.example.one", "production", signInOne))
    const wrongReturn = try cloud.call(configPath("com.example.one", "staging", `${web}/apps/one/billing`))
    const notAUrl = try cloud.call(configPath("com.example.one", "staging", "one-sign-in"))
    const linksBefore = try cloud.call("/.well-known/assetlinks.json")
    try registered(cloud, undefined, effect (tx: Tx, now: number) => { try disableClient(tx, "com.example.two", now) })
    const disabled = try cloud.call(configPath("com.example.two", "staging", `${web}/apps/two/sign-in`))
    const linksAfter = try cloud.call("/.well-known/assetlinks.json")
    try check(() => assert.deepStrictEqual(
      {
        writes,
        admitted: [admitted.status, admitted.body],
        refusals: [unknown, otherEnvironment, wrongReturn, notAUrl, disabled].map((answer) => [answer.status, code(answer.body), (answer.body as { readonly retryable?: boolean }).retryable]),
        linksBefore: (linksBefore.body as ReadonlyArray<{ readonly target: { readonly package_name: string } }>).map((statement) => statement.target.package_name),
        linksAfter: linksAfter.body
      },
      {
        writes: [
          "succeeded with \"com.example.one\"", "succeeded with \"com.example.two\"", "RegistrationRefused", "RegistrationRefused", "RegistrationInvalid", "ClientNotRegistered"
        ],
        admitted: [200, {
          clientId: "com.example.one", environment: "staging", redirectUri: signInOne, codeChallengeMethod: "S256", credentialTtlMs: 30 * 86_400_000,
          methods: { email: true, sms: true, google: true },
          google: { configured: true, serverClientId: "google-server-client", nativeSignIn: true }
        }],
        refusals: [[400, "invalid_client", false], [400, "invalid_client", false], [400, "redirect_mismatch", false], [400, "redirect_mismatch", false], [403, "client_disabled", false]],
        linksBefore: ["com.example.one", "com.example.two"],
        linksAfter: [{ relation: ["delegate_permission/common.handle_all_urls"], target: { namespace: "android_app", package_name: "com.example.one", sha256_cert_fingerprints: [fingerprint] } }]
      }
    ))
  }))

  it.live('Link Google only from the reviewed account with the registered return and matching verifier (spec/cloud/identity/signInMethods.md, "Story: Review, link and remove my sign-in methods"; spec/cloud/identity/federatedSignIn.md, "An ID token spends a live challenge once, only with the client, verifier, signature, issuer, audience and nonce all right, and a refused one spends nothing")', () => scoped(effect {
    const google = try tryPromise(() => nativeGoogleFixture())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", () => ({ status: 200, body: { keys: google.keys } })) })
    try registered(cloud, undefined, effect (tx: Tx, now: number) => { try registerClient(tx, try decodeRegistration(one), now) })
    const owner = try signedIn(cloud, "link-owner@example.com")
    const other = try signedIn(cloud, "link-other@example.com")
    const ownerHeaders = { authorization: `Bearer ${owner.accessToken}` }
    const otherHeaders = { authorization: `Bearer ${other.accessToken}` }
    const methods = "/api/v1/user/methods"
    const challenge = methods + "/google/challenge"
    const link = methods + "/google/link"
    const verifier = "v".repeat(43)
    const fields = { clientId: one.clientId, environment: "staging", redirectUri: signInOne, codeChallenge: s256(verifier), codeChallengeMethod: "S256" }
    const wrongReturn = try cloud.call(challenge, { headers: ownerHeaders, json: { ...fields, redirectUri: one.billingReturn } })
    const wrongEnvironment = try cloud.call(challenge, { headers: ownerHeaders, json: { ...fields, environment: "production" } })
    const opened = try cloud.call(challenge, { headers: ownerHeaders, json: fields })
    const { challengeId, nonce } = try Schema.decodeUnknownEffect(Schema.Struct({ challengeId: Schema.String, nonce: Schema.String }))(opened.body)
    const token = try tryPromise(() => google.issue(nonce))
    const wrongNonceToken = try tryPromise(() => google.issue("different-challenge-nonce"))
    const reviewSchema = Schema.Struct({ reviewId: Schema.String })
    const firstReview = try cloud.call(methods, { headers: ownerHeaders })
    const otherReview = try cloud.call(methods, { headers: otherHeaders })
    const firstId = (try Schema.decodeUnknownEffect(reviewSchema)(firstReview.body)).reviewId
    const otherId = (try Schema.decodeUnknownEffect(reviewSchema)(otherReview.body)).reviewId
    const wrongOwner = try cloud.call(link, { headers: otherHeaders, json: { reviewId: otherId, challengeId, idToken: token, codeVerifier: verifier } })
    const wrongVerifier = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: firstId, challengeId, idToken: token, codeVerifier: "w".repeat(43) } })
    const nonceReview = try cloud.call(methods, { headers: ownerHeaders })
    const nonceId = (try Schema.decodeUnknownEffect(reviewSchema)(nonceReview.body)).reviewId
    const wrongNonce = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: nonceId, challengeId, idToken: wrongNonceToken, codeVerifier: verifier } })
    const validReview = try cloud.call(methods, { headers: ownerHeaders })
    const validId = (try Schema.decodeUnknownEffect(reviewSchema)(validReview.body)).reviewId
    const linked = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: validId, challengeId, idToken: token, codeVerifier: verifier } })
    const after = try cloud.call(methods, { headers: ownerHeaders })
    const account = try Schema.decodeUnknownEffect(Schema.Struct({ reviewId: Schema.String, methods: Schema.Array(Schema.Struct({ kind: Schema.String })) }))(after.body)
    const replayed = try cloud.call(link, { headers: ownerHeaders, json: { reviewId: account.reviewId, challengeId, idToken: token, codeVerifier: verifier } })
    try check(() => assert.deepStrictEqual(
      {
        admitted: opened.status, invalidChallenge: [wrongReturn, wrongEnvironment].map((answer) => [answer.status, code(answer.body)]),
        rejectedProof: [wrongOwner.status, wrongVerifier.status, wrongNonce.status], linked: [linked.status, linked.body],
        methods: account.methods.map(({ kind }) => kind), replayed: replayed.status,
      },
      {
        admitted: 200, invalidChallenge: [[400, "redirect_mismatch"], [400, "invalid_client"]],
        rejectedProof: [401, 401, 401], linked: [200, { status: "linked", method: "google" }],
        methods: ["email", "google"], replayed: 401,
      }
    ))
  }), 60_000)

  it.live("Tell an app that Google sign-in is off (spec/cloud/nativeClients/registry.md, \"Story: Tell a client exactly why it was refused\")", () => scoped(effect {
    const googleOff: ProfileEdit = (profile) => {
      const { google, ...staging } = profile.environments.staging
      return { ...profile, environments: { ...profile.environments, staging: { ...staging, capabilities: staging.capabilities.filter((capability) => capability !== "managedGoogle") } } }
    }
    const cloud = try testCloud({ edit: googleOff })
    try registered(cloud, googleOff, effect (tx: Tx, now: number) => { return try registerClient(tx, try decodeRegistration(one), now) })
    const answer = try cloud.call(configPath("com.example.one", "staging", signInOne))
    try check(() => assert.deepStrictEqual([answer.status, (answer.body as { readonly google?: unknown }).google], [200, { configured: false, serverClientId: "", nativeSignIn: false }]))
  }))
})

describe("WP2 Native clients and pages: native Google (spec/cloud/nativeClients/deviceKeys.md)", () => {
  const web = "https://www.staging.example.com"
  const signInReturn = `${web}/apps/native/sign-in`
  const native = {
    clientId: "com.example.native", environment: "staging", displayName: "Native", androidPackage: "com.example.native",
    certFingerprints: ["E3:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"],
    signInReturn, billingReturn: `${web}/apps/native/billing`, credentialTtlMs: 30 * 86_400_000, nativeGoogle: true, enabled: true
  }
  const challengeVerifier = "c".repeat(43)
  const deviceVerifier = "d".repeat(43)
  const person: GooglePerson = { subject: "google-native-1", email: "native@example.com", emailVerified: true, givenName: "Native" }
  const scopes = ["openid", "email", "https://www.googleapis.com/auth/gmail.readonly"]
  const googleOff: ProfileEdit = (profile) => {
    const { google, ...staging } = profile.environments.staging
    return { ...profile, environments: { ...profile.environments, staging: { ...staging, capabilities: staging.capabilities.filter((capability) => capability !== "managedGoogle") } } }
  }

  function refusal(answer: { readonly status: number; readonly body: unknown }): string {
    const body = answer.body as { readonly error?: string; readonly reason?: string }
    return `${answer.status} ${body.error}${body.reason === undefined ? "" : ` ${body.reason}`}`
  }

  effect function nativeCloud(edit: ProfileEdit | undefined, registration: typeof native) {
    const google = try Effect.try(() => googleIdentityFake(secrets.GOOGLE_CLIENT_SECRET ?? ""))
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", google.handler), ...(edit === undefined ? {} : { edit }) })
    const profile = try parseProfile(try sync(() => { const base = testProfile(cloud.fakes.url); return edit === undefined ? base : edit(base) }))
    const now = try Clock.currentTimeMillis
    provide Store = cloud.store, deploymentLayer(profile, "staging") {
      try cloud.store.transaction(effect (tx: Tx) => { try registerClient(tx, try decodeRegistration(registration), now) })
    }
    return { cloud, google }
  }

  effect function challenge(cloud: TestCloud) {
    const opened = try cloud.call("/api/v1/auth/google/native/challenge", { json: { clientId: native.clientId, environment: "staging", redirectUri: signInReturn, codeChallenge: s256(challengeVerifier), codeChallengeMethod: "S256" } })
    return opened.body as { readonly challengeId: string; readonly nonce: string }
  }

  function signInBody(challengeId: string, idToken: string, extra: Readonly<Record<string, unknown>> = {}) {
    return {
      clientId: native.clientId, environment: "staging", redirectUri: signInReturn, state: "s".repeat(43), codeVerifier: deviceVerifier, deviceName: "Ada's phone",
      identity: { challengeId, idToken, codeVerifier: challengeVerifier }, ...extra
    }
  }

  it.live("Sign a device in with its Google account in one call and link the managed Google connection (spec/cloud/nativeClients/deviceKeys.md, \"Story: Sign a device in and keep its key\"; spec/cloud/identity/federatedSignIn.md, \"Story: Sign in with the device's Google account\")", () => scoped(effect {
    const { cloud, google } = try nativeCloud(undefined, native)
    const opened = try challenge(cloud)
    const idToken = try promise(() => google.idToken(person, { audience: "google-server-client", nonce: opened.nonce }))
    const serverAuthCode = try sync(() => google.serverAuthCode(person, scopes))
    const malformed = try cloud.call("/api/v1/app-auth/mobile/google", { json: signInBody(opened.challengeId, "x".repeat(40)) })
    const badName = try cloud.call("/api/v1/app-auth/mobile/google", { json: signInBody(opened.challengeId, idToken, { deviceName: "n".repeat(81) }) })
    const signed = try cloud.call("/api/v1/app-auth/mobile/google", { json: signInBody(opened.challengeId, idToken, { serverAuthCode }) })
    const replayed = try cloud.call("/api/v1/app-auth/mobile/google", { json: signInBody(opened.challengeId, idToken) })
    const body = signed.body as {
      readonly status: string; readonly credentialId: string; readonly secret: string; readonly tokenType: string; readonly expiresIn: number; readonly scopes: ReadonlyArray<string>
      readonly acknowledgementRequired: boolean; readonly code: string; readonly accountCreated: boolean; readonly identity: unknown
      readonly google: { readonly connected: boolean; readonly connectionId: string; readonly email: string; readonly scopes: ReadonlyArray<string>; readonly refreshTokenIssued: boolean }
    }
    const acked = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: body.credentialId, secret: body.secret } })
    const grants = try sql(cloud, "SELECT state->>'phase' AS phase FROM device_grants", [])
    const connections = try sql(cloud, "SELECT key, subject, email FROM google_connections", [])
    try check(() => assert.deepStrictEqual(
      {
        refused: [malformed.status, badName.status, refusal(replayed).startsWith("401")],
        signed: [signed.status, signed.headers["cache-control"], body.status, body.tokenType, body.scopes, body.acknowledgementRequired, /^emac_[0-9a-f]{64}$/.test(body.code), body.accountCreated, body.identity],
        google: [body.google.connected, body.google.email, body.google.scopes, body.google.refreshTokenIssued],
        acked: [acked.status, (acked.body as { readonly status?: string }).status],
        stored: [grants.length, connections.map((row) => [row.key, row.subject, row.email])],
        googleCalls: google.tokenRequests.map((form) => [form.get("client_id"), form.get("redirect_uri"), form.has("code_verifier")])
      },
      {
        refused: [401, 400, true],
        signed: [200, "no-store", "signed_in", "Bearer", ["cloud:user"], true, true, true, { provider: "google", subject: person.subject, email: person.email }],
        google: [true, person.email, scopes, true],
        acked: [200, "acknowledged"],
        stored: [1, [[body.google.connectionId, person.subject, person.email]]],
        googleCalls: [["google-server-client", "", false]]
      }
    ))
  }), 60_000)

  it.live("Refuse native Google when Google is off or the registration does not enable it (spec/cloud/nativeClients/registry.md, \"Story: Tell a client exactly why it was refused\")", () => scoped(effect {
    const off = try nativeCloud(googleOff, native)
    const offAnswer = try off.cloud.call("/api/v1/app-auth/mobile/google", { json: signInBody("missing-challenge", "x".repeat(40)) })
    const plain = try nativeCloud(undefined, { ...native, nativeGoogle: false })
    const plainAnswer = try plain.cloud.call("/api/v1/app-auth/mobile/google", { json: signInBody("missing-challenge", "x".repeat(40)) })
    const unknownClient = try plain.cloud.call("/api/v1/app-auth/mobile/google", { json: { ...signInBody("missing-challenge", "x".repeat(40)), clientId: "com.example.unknown" } })
    try check(() => assert.deepStrictEqual(
      [refusal(offAnswer), refusal(plainAnswer), (unknownClient.body as { readonly error?: string }).error],
      ["503 provider_unavailable google_not_configured", "400 invalid_client", "invalid_client"]
    ))
  }), 60_000)

  it.live("A person with a second factor gets mfa_required and no device key (spec/cloud/identity/secondFactor.md, \"Story: Finish sign-in with my second factor\")", () => scoped(effect {
    const { cloud, google } = try nativeCloud(undefined, native)
    const first = try signedIn(cloud, person.email)
    const owner = { authorization: `Bearer ${first.accessToken}` }
    const enrolled = (try cloud.call("/api/v1/auth/mfa/totp/enroll", { headers: owner, json: {} })).body as { readonly secret: string }
    const now = try Clock.currentTimeMillis
    const confirmed = try cloud.call("/api/v1/auth/mfa/totp/confirm", { headers: owner, json: { code: try sync(() => authenticatorCode(enrolled.secret, now)) } })
    const opened = try challenge(cloud)
    const idToken = try promise(() => google.idToken(person, { audience: "google-server-client", nonce: opened.nonce }))
    const answer = try cloud.call("/api/v1/app-auth/mobile/google", { json: signInBody(opened.challengeId, idToken, { serverAuthCode: try sync(() => google.serverAuthCode(person, scopes)) }) })
    const body = answer.body as { readonly status: string; readonly challengeId: string; readonly methods: ReadonlyArray<string>; readonly expiresAt: number }
    const grants = try sql(cloud, "SELECT key FROM device_grants", [])
    try check(() => assert.deepStrictEqual(
      [confirmed.status, answer.status, body.status, typeof body.challengeId, body.methods, body.expiresAt > now, grants.length, google.tokenRequests.length],
      [200, 200, "mfa_required", "string", ["totp"], true, 0, 0]
    ))
  }), 60_000)
})

import { readBackCheckouts } from "../src/billing/checkout-readback.vibe"

describe("WP3 Checkout and provider events (spec/cloud/billing/checkout.md, \"Story: Subscribe once, whichever screen or payer finishes it\")", () => {
  effect function checkoutCaller(cloud: TestCloud, name: string) {
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    const now = try Clock.currentTimeMillis
    provide deploymentLayer(profile, "staging") {
      try cloud.store.transaction((tx) => seedClients(tx, fixtureSeed.clients, now))
    }
    const caller = try signedCaller(cloud, name)
    try sql(cloud, "UPDATE device_grants SET client_id = 'com.example.fixture' WHERE user_id = $1", [caller.userId])
    return caller
  }

  effect function start(cloud: TestCloud, headers: Readonly<Record<string, string>>, body: unknown) {
    const answer = try cloud.call("/api/v1/subscriptions/checkout", { json: body, headers })
    const read = answer.body as { readonly status?: string; readonly error?: string; readonly sessionId?: string; readonly checkoutUrl?: string; readonly commandId?: string }
    return { code: answer.status, status: read.status ?? read.error, sessionId: read.sessionId, checkoutUrl: read.checkoutUrl, commandId: read.commandId }
  }

  effect function deliverEvent(cloud: TestCloud, signed: { readonly raw: string; readonly header: string }) {
    const json = try Effect.try(() => JSON.parse(signed.raw) as unknown)
    return (try cloud.call(webhookPath, { json, headers: { "stripe-signature": signed.header } })).status
  }

  effect function checkoutRow(cloud: TestCloud, organizationId: string) {
    const rows = try sql(cloud, "SELECT status, provider_session_id, readback_attempt FROM checkouts WHERE organization_id = $1", [organizationId])
    return rows.map((row) => ({ status: row.status, session: row.provider_session_id === null ? null : "set", readBacks: row.readback_attempt }))
  }

  it.live("Subscribe on the phone though the provider's reply is lost: the lookup finds the session, the webhook and the read-back both see it paid, and one subscription results (spec/cloud/billing/checkout.md, \"Story: Subscribe once, whichever screen or payer finishes it\"; spec/cloud/shared/dispatchOnce.md, \"Story: Send a change once and recover its outcome without sending it again\")", () => scoped(effect {
    const stripe = try sync(() => createStripeFake())
    const cloud = try testCloud({ stripe })
    const caller = try checkoutCaller(cloud, "subscriber")
    const body = { planKey: "plus_monthly", idempotencyKey: "checkout-key-0001", presentation: "mobile" }
    const hosted = try start(cloud, caller.headers, { ...body, presentation: "hosted" })
    const extra = try start(cloud, caller.headers, { ...body, successUrl: "https://elsewhere.example.com/" })
    const anonymous = try start(cloud, {}, body)
    try sync(() => stripe.dropNextReply("/v1/checkout/sessions"))
    const lost = try start(cloud, caller.headers, body)
    const opening = try checkoutRow(cloud, caller.organizationId)
    const conflict = try start(cloud, caller.headers, { ...body, presentation: "embedded" })
    const started = try Clock.currentTimeMillis
    try cloud.inside(readBackCheckouts(started + 3 * 60_000))
    const found = try start(cloud, caller.headers, body)
    const sessions = (try sql(cloud, "SELECT count(*)::int AS n FROM checkouts", []))[0]?.n
    const session = try sync(() => stripe.object(found.sessionId ?? ""))
    const completed = try sync(() => stripe.completeSession(found.sessionId ?? "", "paid"))
    const delivered = try deliverEvent(cloud, try sync(() => stripe.signedEvent("checkout.session.completed", completed.session)))
    try cloud.inside(drainProviderEvents(started + 4 * 60_000))
    try cloud.inside(readBackCheckouts(started + 40 * 60_000))
    const paid = try start(cloud, caller.headers, body)
    const again = try start(cloud, caller.headers, { ...body, idempotencyKey: "checkout-key-0002" })
    const subscriptions = try sql(cloud, "SELECT status, plan_key, provider_subscription_id FROM subscriptions WHERE key = $1", [caller.organizationId])
    const pinned = try sql(cloud, "SELECT count(*)::int AS n FROM cloud_checkout_customers WHERE organization_id = $1", [caller.organizationId])
    const settled = try checkoutRow(cloud, caller.organizationId)
    const terms = session as unknown as { readonly success_url: string; readonly cancel_url: string; readonly payment_method_types: ReadonlyArray<string>; readonly allow_promotion_codes: boolean; readonly client_reference_id: string }
    try check(() => assert.deepStrictEqual(
      {
        refused: [hosted.code, hosted.status, extra.code, extra.status, anonymous.code, anonymous.status],
        lost: [lost.code, lost.status], opening, conflict: [conflict.code, conflict.status],
        found: [found.code, found.status, found.checkoutUrl === `https://checkout.stripe.com/c/pay/${found.sessionId}`, found.commandId], sessions,
        terms: [terms.success_url, terms.cancel_url, terms.payment_method_types, terms.allow_promotion_codes, terms.client_reference_id === found.commandId],
        delivered, paid: [paid.code, paid.status, paid.commandId === found.commandId], again: [again.code, again.status],
        subscriptions, pinned: pinned[0]?.n, settled
      },
      {
        refused: [400, "invalid_request", 400, "invalid_request", 401, "authentication_required"],
        lost: [503, "service_unavailable"], opening: [{ status: "opening", session: null, readBacks: 0 }], conflict: [409, "idempotency_conflict"],
        found: [200, "open", true, found.commandId], sessions: 1,
        terms: ["https://www.staging.example.com/apps/fixture/billing?session_id={CHECKOUT_SESSION_ID}&result=success", "https://www.staging.example.com/apps/fixture/billing?result=cancel", ["card"], false, true],
        delivered: 200, paid: [200, "completed", true], again: [409, "billing_state_conflict"],
        subscriptions: [{ status: "active", plan_key: "plus_monthly", provider_subscription_id: completed.subscription.id }], pinned: 1, settled: [{ status: "completed", session: "set", readBacks: settled[0]?.readBacks }]
      }
    ))
  }), 60_000)
})
describe("WP3 Provider events (spec/cloud/billing/providerEvents.md, \"Story: Apply each payment event once, whatever the delivery order\")", () => {
  effect function deliver(cloud: TestCloud, signed: { readonly raw: string; readonly header: string }) {
    const json = try Effect.try(() => JSON.parse(signed.raw) as unknown)
    return try cloud.call(webhookPath, { json, headers: { "stripe-signature": signed.header } })
  }

  effect function eventRow(cloud: TestCloud, id: string) {
    const row = (try sql(cloud, "SELECT phase, attempts, payload IS NULL AS dropped, last_error_code FROM provider_events WHERE key = $1", [id]))[0]
    return row === undefined ? undefined : { state: row.phase, attempts: row.attempts, dropped: row.dropped, error: row.last_error_code }
  }

  const statusOf = (answer: { readonly status: number; readonly body: unknown }) => {
    const body = answer.body as { readonly error?: string; readonly received?: boolean; readonly queued?: boolean; readonly duplicate?: boolean }
    return [answer.status, body.error ?? (body.duplicate === true ? "duplicate" : body.received === true && body.queued === true ? "queued" : "unexpected")]
  }

  it.live("Store a payment event once, refuse a forged, stale, foreign or rewritten one, and apply it once (spec/cloud/billing/providerEvents.md, \"Story: Apply each payment event once, whatever the delivery order\")", () => scoped(effect {
    const stripe = try sync(() => createStripeFake())
    const cloud = try testCloud({ stripe })
    const customer = { id: "cus_listener", object: "customer" }
    const first = try sync(() => stripe.signedEvent("customer.created", customer))
    const stored = try deliver(cloud, first)
    const repeated = try deliver(cloud, first)
    const tampered = try deliver(cloud, { raw: try sync(() => stripe.tamper(first.raw)), header: first.header })
    const started = try Clock.currentTimeMillis
    const stale = try deliver(cloud, try sync(() => stripe.signedEvent("customer.created", customer, { timestamp: Math.floor(started / 1000) - 301 })))
    const foreign = try deliver(cloud, try sync(() => stripe.signedEvent("customer.created", customer, { livemode: true })))
    const rewritten = try deliver(cloud, try sync(() => stripe.signedEvent("customer.created", { ...customer, id: "cus_other" }, { id: first.id })))
    try cloud.inside(drainProviderEvents(started + 60_000))
    try cloud.inside(drainProviderEvents(started + 120_000))
    const replayed = try deliver(cloud, first)
    const rows = try sql(cloud, "SELECT count(*)::int AS n FROM provider_events", [])
    const row = try eventRow(cloud, first.id)
    try check(() => assert.deepStrictEqual(
      { stored: statusOf(stored), repeated: statusOf(repeated), tampered: statusOf(tampered), stale: statusOf(stale), foreign: statusOf(foreign), rewritten: statusOf(rewritten), replayed: statusOf(replayed), rows: rows[0]?.n, row },
      { stored: [200, "queued"], repeated: [200, "duplicate"], tampered: [400, "invalid_request"], stale: [400, "invalid_request"], foreign: [400, "invalid_request"], rewritten: [409, "idempotency_conflict"], replayed: [200, "duplicate"], rows: 1, row: { state: "Done", attempts: 1, dropped: true, error: null } }
    ))
  }), 60_000)

  it.live("Retry a failing event on its own schedule without holding back the next, dead-letter it after eight attempts or when unreadable, and revive it on a resend (spec/cloud/billing/providerEvents.md, \"Story: Apply each payment event once, whatever the delivery order\"; spec/cloud/billing/providerEvents.md, \"Story: Keep an event that cannot be applied until the provider sends it again\")", () => scoped(effect {
    const stripe = try sync(() => createStripeFake())
    const cloud = try testCloud({ stripe })
    const failing = try sync(() => stripe.signedEvent("charge.dispute.funds_withdrawn", { id: "dp_lost", object: "dispute", charge: "ch_missing", status: "needs_response", livemode: false }))
    const following = try sync(() => stripe.signedEvent("customer.created", { id: "cus_after", object: "customer" }))
    const unreadable = try sync(() => stripe.signedEvent("invoice.paid", { id: "in_unreadable", object: "invoice" }))
    try deliver(cloud, failing)
    try deliver(cloud, following)
    try deliver(cloud, unreadable)
    const started = try Clock.currentTimeMillis
    try cloud.inside(drainProviderEvents(started + 60_000))
    const afterFirst = { failing: try eventRow(cloud, failing.id), following: try eventRow(cloud, following.id), unreadable: try eventRow(cloud, unreadable.id) }
    const revived = try deliver(cloud, unreadable)
    const pending = try eventRow(cloud, unreadable.id)
    for (let hour = 2; hour <= 26; hour += 2) {
      try cloud.inside(drainProviderEvents(started + hour * 3_600_000))
    }
    const deadLettered = try eventRow(cloud, failing.id)
    try check(() => assert.deepStrictEqual(
      { afterFirst, revived: statusOf(revived), pending, deadLettered },
      {
        afterFirst: {
          failing: { state: "Pending", attempts: 1, dropped: false, error: "StripeRefused" },
          following: { state: "Done", attempts: 1, dropped: true, error: null },
          unreadable: { state: "DeadLettered", attempts: 1, dropped: false, error: "ProviderEventMalformed" }
        },
        revived: [200, "queued"],
        pending: { state: "Pending", attempts: 0, dropped: false, error: null },
        deadLettered: { state: "DeadLettered", attempts: 8, dropped: false, error: "StripeRefused" }
      }
    ))
  }), 120_000)
})
describe("WP6 Speech batch (spec/cloud/services/speech.md)", () => {
  it.live("Speak a reply with context and timings, transcribe a recording, and charge each once (spec/cloud/services/speech.md, \"Story: Speak a reply as audio\"; spec/cloud/services/speech.md, \"Story: Transcribe a recording\")", () => scoped(effect {
    const speech = try sync(() => speechFake())
    const cloud = try testCloud({ mount: (fakes) => speech.install(fakes) })
    const caller = try signedCaller(cloud, "speaker")
    try cloud.inside(addCredits({ organizationId: caller.organizationId, amount: 1_000_000, requestKey: "speech-funding" }))
    const tts = (body: unknown) => cloud.call("/api/v1/voice/tts", { json: body, headers: caller.headers })
    const stt = effect (fields: Readonly<Record<string, string>>) => {
      const form = try Effect.try(() => recordingForm(fields))
      return try cloud.call("/api/v1/voice/stt", { form, headers: caller.headers })
    }

    const plain = try tts({ text: "Hello there", previousText: "Earlier words.", nextText: "Later words.", speed: 1.1 })
    const timed = try tts({ text: "Hi you", previousText: "Before", withTimestamps: true })
    const lines = try Effect.try(() => String(timed.body).trim().split("\n").map((line) => JSON.parse(line) as { readonly type: string; readonly sequence?: number; readonly alignment?: { readonly characters: ReadonlyArray<string> } }))
    const anonymous = try cloud.call("/api/v1/voice/tts", { json: { text: "Hello" } })
    const foreignVoice = try tts({ text: "Hello", voiceId: "voice-elsewhere" })
    try sync(() => speech.script({ kind: "refuse", status: 422 }, { kind: "refuse", status: 503, retryAfterSeconds: 7 }))
    const rejected = try tts({ text: "Rejected" })
    const busy = try tts({ text: "Busy" })

    const heard = try stt({ languageCode: "en-US", provider: "speech" })
    const otherProvider = try stt({ provider: "elsewhere" })
    const otherLanguage = try stt({ languageCode: "fr" })
    const tooLarge = try promise(() => callDeclaring(cloud.url, "/api/v1/voice/stt", 25 * 1024 * 1024 + 1, { "content-type": "multipart/form-data; boundary=x" }))

    const usage = try sql(cloud, "SELECT service, quote, charged, outcome FROM usage_records WHERE organization_id = $1 ORDER BY settled_at, hold_key", [caller.organizationId])
    try check(() => assert.deepStrictEqual(
      {
        plain: [plain.status, plain.headers["content-type"], plain.headers["x-eliza-tts-provider"], plain.headers["x-eliza-tts-speed"], String(plain.body).length > 0],
        sentPlain: speech.synthesized[0],
        timed: [timed.status, timed.headers["content-type"], timed.headers["x-eliza-tts-timing"], lines.map((line) => [line.type, line.sequence, line.alignment?.characters.join("")])],
        sentTimed: [speech.synthesized[1]?.path, speech.synthesized[1]?.body.previous_text, speech.synthesized[1]?.body.transcript],
        anonymous: anonymous.status,
        foreignVoice: [foreignVoice.status, (foreignVoice.body as { readonly error: string }).error],
        rejected: [rejected.status, (rejected.body as { readonly error: string }).error],
        busy: [busy.status, (busy.body as { readonly error: string }).error, Number(busy.headers["retry-after"]) >= 7],
        heard: [heard.status, heard.body, heard.headers["x-eliza-stt-provider"]],
        sentHeard: speech.transcribed.map((each) => [each.mimeType, each.model, each.language, each.audio.length]),
        otherProvider: [otherProvider.status, (otherProvider.body as { readonly error: string }).error],
        otherLanguage: [otherLanguage.status, (otherLanguage.body as { readonly error: string }).error],
        tooLarge: [tooLarge.status, (tooLarge.body as { readonly error: string }).error],
        usage: usage.map((row) => [row.service, Number(row.quote), Number(row.charged), row.outcome])
      },
      {
        plain: [200, "audio/mpeg", "speech", "1.1", true],
        sentPlain: {
          path: "/tts/bytes",
          body: {
            model_id: "model-1", transcript: "Hello there", voice: { mode: "id", id: "voice-1" },
            output_format: { container: "mp3", sample_rate: 44_100, bit_rate: 128_000 },
            speed: 1.1, apply_text_normalization: "auto", previous_text: "Earlier words.", next_text: "Later words."
          }
        },
        timed: [200, "application/x-ndjson", "character-v1", [["audio", 0, "Hi "], ["audio", 1, "you"], ["done", undefined, undefined]]],
        sentTimed: ["/tts/timestamps", "Before", "Hi you"],
        anonymous: 401,
        foreignVoice: [400, "invalid_request"],
        rejected: [502, "provider_invalid_response"],
        busy: [503, "provider_unavailable", true],
        heard: [200, { transcript: spokenTranscript, duration_ms: 2_500, words: spokenTranscript.split(" ").map((word, index) => ({ text: word, startMs: index * 400, endMs: index * 400 + 300 })) }, "speech"],
        sentHeard: [["audio/wav", "ink-whisper", "en", recordingBytes]],
        otherProvider: [400, "invalid_request"],
        otherLanguage: [400, "invalid_request"],
        tooLarge: [413, "content_too_large"],
        usage: [
          ["speech", 396, 396, "known"],
          ["speech", 216, 216, "known"],
          ["speech", 288, 0, "known"],
          ["speech", 144, 144, "unknown"],
          ["speech", 100, 250, "known"]
        ]
      }
    ))
  }), 60_000)
})
describe("WP6 Speech realtime (spec/cloud/services/speechRelay.md)", () => {
  it.effect("Consent, mint and open one socket, hear connected before turns, speak, renew a window and end on refused funding; a spent allowance refuses the mint (spec/cloud/services/speechRelay.md, \"Story: Start speech only from a consent I gave\"; spec/cloud/services/speechRelay.md, \"Story: Speak the relay protocol on one socket\"; spec/cloud/services/speechRelay.md, \"Story: Keep a live session funded and close it with receipts\")", () => scoped(effect {
    try TestClock.setTime(Date.UTC(2026, 10, 19, 12))
    const speech = try sync(() => speechFake())
    const cloud = try testCloud({ mount: (fakes) => speech.install(fakes) })
    try TestClock.adjust(Duration.seconds(5))
    const caller = try signedCaller(cloud, "talker")
    const windowQuote = 60 * 100 + 4096 * 30
    try cloud.inside(addCredits({ organizationId: caller.organizationId, amount: 2 * windowQuote + 1_000, requestKey: "talk-funding" }))
    const consent = try cloud.call("/api/v1/voice/speech/consent", { json: {}, headers: caller.headers })
    const minted = try cloud.call("/api/v1/voice/speech/session", { json: { consentNonce: (consent.body as { readonly consentNonce: string }).consentNonce }, headers: caller.headers })
    const session = minted.body as { readonly sessionId: string; readonly token: string; readonly expiresAt: string; readonly wsUrl: string }
    const mintedAt = Date.parse(session.expiresAt) - 60_000
    const socket = try promise(() => openRelay(cloud.url, session.sessionId))
    const second = try promise(() => upgradeStatus(cloud.url, session.sessionId))
    try sync(() => socket.send({ t: "hello", token: session.token, errorReasons: true, extend: true }))
    const opened = try promise(() => socket.until((received) => received.kind === "text" && received.frame.t === "stt"))
    try sync(() => socket.send(new Uint8Array(3_200)))
    const heard = try promise(() => socket.until((received) => received.kind === "text" && (received.frame.event as { readonly type?: string } | undefined)?.type === "end-of-turn"))
    try sync(() => {
      socket.send({ t: "prepare", id: "reply-1" })
      socket.send({ t: "tts", id: "reply-1", text: "Porch light is on.", flush: true })
      socket.send({ t: "finish", id: "reply-1" })
    })
    const spoken = try promise(() => socket.until((received) => received.kind === "text" && received.frame.t === "complete"))
    try TestClock.adjust(Duration.seconds(50))
    const extended = try promise(() => socket.next())
    try TestClock.adjust(Duration.seconds(10))
    try TestClock.withLive(sleep(Duration.millis(200)))
    try TestClock.adjust(Duration.seconds(50))
    try TestClock.withLive(sleep(Duration.millis(200)))
    try TestClock.adjust(Duration.seconds(10))
    const ending = try promise(() => socket.until((received) => received.kind === "close"))
    let phase: unknown = undefined
    for (let attempt = 0; attempt < 100 && phase !== "closed"; attempt += 1) {
      try TestClock.withLive(sleep(Duration.millis(50)))
      phase = (try sql(cloud, "SELECT phase FROM speech_sessions WHERE key = $1", [session.sessionId]))[0]?.phase
    }
    const windows = try sql(cloud, "SELECT number, expires_at, settled_at IS NOT NULL AS settled FROM speech_windows WHERE session_id = $1 ORDER BY number", [session.sessionId])
    const usage = try sql(cloud, "SELECT quote, outcome FROM usage_records WHERE organization_id = $1 ORDER BY hold_key", [caller.organizationId])

    const spender = try signedCaller(cloud, "spender")
    const now = try Clock.currentTimeMillis
    const today = try Effect.try(() => utcDayStart(now))
    try sql(cloud, "INSERT INTO speech_usage_days (user_id, usage_day, used_ms, updated_at) VALUES ($1, $2, $3, $4)", [spender.userId, today, realtimeSpeechPerDay, now])
    const spentConsent = try cloud.call("/api/v1/voice/speech/consent", { json: {}, headers: spender.headers })
    const spent = try cloud.call("/api/v1/voice/speech/session", { json: { consentNonce: (spentConsent.body as { readonly consentNonce: string }).consentNonce }, headers: spender.headers })

    const shown = (seen: ReadonlyArray<Received>) => seen.map((received) => received.kind === "text" ? received.frame : received.kind === "binary" ? { audio: received.bytes.length, head: Array.from(received.bytes.subarray(0, 9)) } : { close: received.code })
    try check(() => assert.deepStrictEqual(
      {
        minted: [minted.status, minted.headers["x-eliza-speech-extend"], session.wsUrl.endsWith(`/api/v1/voice/speech/ws?sessionId=${session.sessionId}`)],
        second: [second.status, (second.body as { readonly error?: string }).error],
        opened: shown(opened),
        heard: shown(heard),
        spoken: shown(spoken),
        extended: shown([extended]),
        ending: shown(ending),
        forwarded: speech.sttPcmBytes,
        phase,
        windows: windows.map((row) => [Number(row.number), Number(row.expires_at) - mintedAt, row.settled]),
        usage: usage.map((row) => [Number(row.quote), row.outcome]),
        spent: [spent.status, (spent.body as { readonly error?: string }).error]
      },
      {
        minted: [200, "1", true],
        second: [410, "session_closed"],
        opened: [
          { t: "ready", version: 1, sampleRate: 16_000, channels: 1, expiresAt: session.expiresAt },
          { t: "stt", event: { type: "connected" } }
        ],
        heard: [
          { t: "stt", event: { type: "start-of-turn", transcript: "" } },
          { t: "stt", event: { type: "transcript-update", transcript: spokenTranscript.slice(0, 7) } },
          { t: "stt", event: { type: "end-of-turn", transcript: spokenTranscript } }
        ],
        spoken: [
          { t: "tts_prepared", id: "reply-1" },
          { audio: 2 + 7 + 3_200, head: [1, 7, ...Array.from(new TextEncoder().encode("reply-1"))] },
          { t: "flush_complete", id: "reply-1" },
          { t: "complete", id: "reply-1" }
        ],
        extended: [{ t: "extended", expiresAt: new Date(mintedAt + 120_000).toISOString() }],
        ending: [{ t: "error", code: "unavailable", reason: "insufficient_credits" }, { close: 4402 }],
        forwarded: 3_200,
        phase: "closed",
        windows: [[1, 60_000, true], [2, 120_000, true]],
        usage: [[6_000, "unknown"], [122_880, "unknown"], [6_000, "unknown"], [122_880, "unknown"]],
        spent: [402, "allowance_exhausted"]
      }
    ))
  }), 60_000)
})
describe("WP7 Maps (spec/cloud/services/maps.md)", () => {
  it.live("Answer a maps request once and pay for it once, keep tiles unstored and look a place up nearby first (spec/cloud/services/maps.md, \"Story: Answer a maps request once and pay for it once\"; spec/cloud/services/maps.md, \"Story: Keep maps requests within the provider's terms\")", () => scoped(effect {
    const maps = try sync(() => googleMapsFake())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/maps/", maps.handler) })
    const caller = try signedCaller(cloud, "mapper")
    const unfunded = try signedCaller(cloud, "mapless")
    try cloud.inside(addCredits({ organizationId: caller.organizationId, amount: 1_000_000, requestKey: "maps-funding" }))
    const post = (path: string, key: string, body: unknown, who = caller) => cloud.call(`/api/v1/maps/${path}`, { json: body, headers: { ...who.headers, "idempotency-key": key } })
    const tile = (key: string) => cloud.call("/api/v1/maps/tiles/3/4/2", { headers: { ...caller.headers, "idempotency-key": key } })
    const errorOf = (answer: { readonly body: unknown }) => (answer.body as { readonly error?: string }).error
    const berlin = { latitude: 52.5163, longitude: 13.3777 }

    try sync(() => maps.script({ kind: "slow", delayMs: 10_500 }))
    const lost = try post("geocode", "geo-lost", { query: "Pariser Platz" })

    const first = try post("geocode", "geo-1", { query: "Brandenburger Tor" })
    const geocodesAfterFirst = maps.count("geocode")
    const repeated = try post("geocode", "geo-1", { query: "Brandenburger Tor" })
    const conflicting = try post("geocode", "geo-1", { query: "Alexanderplatz" })
    const unkeyed = try cloud.call("/api/v1/maps/geocode", { json: { query: "Brandenburger Tor" }, headers: caller.headers })

    try sync(() => maps.script({ kind: "empty" }))
    const noRoute = try post("routes", "route-1", { from: { latitude: 52.517, longitude: 13.3888 }, to: berlin, mode: "drive" })

    const tileOne = try tile("tile-1")
    const tileAgain = try tile("tile-2")
    const tileRepeated = try tile("tile-1")
    const tilesFetched = maps.count("tile")

    const nearbyFound = try post("reverse", "rev-1", { coordinate: berlin, preferPlace: true })
    const lookupsWithPlace = [maps.count("searchNearby"), maps.count("geocode")]
    try sync(() => maps.script({ kind: "empty" }))
    const nearbyEmpty = try post("reverse", "rev-2", { coordinate: berlin, preferPlace: true })
    const lookupsWithoutPlace = [maps.count("searchNearby"), maps.count("geocode")]

    const callsBeforeBroke = maps.calls.length
    const broke = try post("geocode", "geo-broke", { query: "Brandenburger Tor" }, unfunded)
    const usage = try sql(cloud, "SELECT r.operation, r.status, r.result IS NULL AS unkept, u.quote, u.charged, u.outcome FROM maps_requests r JOIN usage_records u ON u.hold_key = r.hold_key ORDER BY u.settled_at, r.hold_key", [])

    const off = try testCloud({ edit: (profile) => ({ ...profile, environments: { ...profile.environments, staging: { ...profile.environments.staging, maps: { provider: "none" }, capabilities: ["inference", "speech", "managedGoogle", "billing"] } } }) })
    const offCaller = try signedCaller(off, "offline")
    const offCapabilities = try off.call("/api/v1/maps/capabilities", { headers: offCaller.headers })
    const offGeocode = try off.call("/api/v1/maps/geocode", { json: { query: "Brandenburger Tor" }, headers: { ...offCaller.headers, "idempotency-key": "geo-off" } })

    try check(() => assert.deepStrictEqual(
      {
        lost: [lost.status, errorOf(lost)],
        first: [first.status, (first.body as { readonly places: ReadonlyArray<{ readonly name: string }> }).places.length],
        repeated: [repeated.status, repeated.body, maps.count("geocode") - geocodesAfterFirst],
        conflicting: [conflicting.status, errorOf(conflicting)],
        unkeyed: [unkeyed.status, errorOf(unkeyed)],
        noRoute: [noRoute.status, errorOf(noRoute)],
        tiles: [tileOne.status, tileOne.headers["cache-control"], tileOne.headers["content-type"], String(tileOne.body).length > 0, tileAgain.status, tileAgain.headers["cache-control"], tileRepeated.status, errorOf(tileRepeated), tilesFetched],
        reverse: [nearbyFound.status, lookupsWithPlace, nearbyEmpty.status, (nearbyEmpty.body as { readonly place: unknown }).place !== null, lookupsWithoutPlace],
        broke: [broke.status, errorOf(broke), maps.calls.length - callsBeforeBroke],
        usage: usage.map((row) => [row.operation, row.status, row.unkept, Number(row.quote), Number(row.charged), row.outcome]),
        off: [offCapabilities.status, offCapabilities.body, offGeocode.status, errorOf(offGeocode)]
      },
      {
        lost: [503, "provider_unavailable"],
        first: [200, 1],
        repeated: [200, first.body, 0],
        conflicting: [409, "idempotency_conflict"],
        unkeyed: [400, "invalid_request"],
        noRoute: [422, "no_route"],
        tiles: [200, "no-store", "image/png", true, 200, "no-store", 409, "idempotency_conflict", 2],
        reverse: [200, [1, 2], 200, true, [2, 3]],
        broke: [402, "insufficient_credits", 0],
        usage: [
          ["geocode", "lost", true, 5_000, 5_000, "unknown"],
          ["geocode", "answered", false, 5_000, 5_000, "known"],
          ["routes", "refused", false, 10_000, 10_000, "known"],
          ["tile", "answered", true, 600, 600, "known"],
          ["tile", "answered", true, 600, 600, "known"],
          ["reverse", "answered", false, 37_000, 32_000, "known"],
          ["reverse", "answered", false, 37_000, 37_000, "known"]
        ],
        off: [200, { available: false }, 404, "capability_unavailable"]
      }
    ))
  }), 60_000)

  it.live("Answer maps requests from the operator's own OpenStreetMap stack at no charge, with no tiles, nearby lookup or transit (spec/cloud/services/maps.md, \"Story: Answer a maps request once and pay for it once\")", () => scoped(effect {
    const osm = try sync(() => osmFake())
    const cloud = try testCloud({
      mount: (fakes) => fakes.mount("/maps/", osm.handler),
      edit: (profile) => ({ ...profile, environments: { ...profile.environments, staging: { ...profile.environments.staging, maps: { provider: "osm", baseUrl: profile.environments.staging.maps.baseUrl, coverage: "europe", datasetRevision: "osm-2026-11" } } } })
    })
    const caller = try signedCaller(cloud, "osm-mapper")
    const post = (path: string, key: string, body: unknown) => cloud.call(`/api/v1/maps/${path}`, { json: body, headers: { ...caller.headers, "idempotency-key": key } })
    const errorOf = (answer: { readonly body: unknown }) => (answer.body as { readonly error?: string }).error
    const placesOf = (answer: { readonly body: unknown }) => (answer.body as { readonly places: ReadonlyArray<{ readonly id: string; readonly name: string }> }).places.map((place) => [place.id, place.name])
    const from = { latitude: 52.517, longitude: 13.3888 }
    const to = { latitude: 52.5163, longitude: 13.3777 }

    const capabilities = try cloud.call("/api/v1/maps/capabilities", { headers: caller.headers })
    const geocoded = try post("geocode", "osm-geo-1", { query: "Pariser Platz 1" })
    const repeated = try post("geocode", "osm-geo-1", { query: "Pariser Platz 1" })
    const searched = try post("places/search", "osm-search-1", { query: "Brandenburger Tor", near: to })
    const reversed = try post("reverse", "osm-rev-1", { coordinate: to, preferPlace: true })
    const detailed = try post("places/details", "osm-details-1", { id: "N240109189" })
    const walked = try post("routes", "osm-route-1", { from, to, mode: "walk" })
    const transit = try post("routes", "osm-route-transit", { from, to, mode: "transit" })
    try sync(() => osm.script({ kind: "unroutable", message: "Connection between locations not found" }))
    const unroutable = try post("routes", "osm-route-none", { from, to, mode: "drive" })
    try sync(() => osm.script({ kind: "outage" }))
    const outage = try post("geocode", "osm-geo-outage", { query: "Alexanderplatz" })
    try sync(() => osm.script({ kind: "notJson" }))
    const garbled = try post("geocode", "osm-geo-garbled", { query: "Alexanderplatz" })
    const callsBeforeTile = osm.calls.length
    const tile = try cloud.call("/api/v1/maps/tiles/3/4/2", { headers: { ...caller.headers, "idempotency-key": "osm-tile-1" } })
    const usage = try sql(cloud, "SELECT r.operation, r.status, u.quote, u.charged, u.outcome FROM maps_requests r JOIN usage_records u ON u.hold_key = r.hold_key ORDER BY u.settled_at, r.hold_key", [])
    const route = (walked.body as { readonly routes: ReadonlyArray<{ readonly distanceMeters: number; readonly durationSeconds: number; readonly traffic: string; readonly steps: ReadonlyArray<{ readonly maneuver?: string }> }> }).routes[0]
    const place = (reversed.body as { readonly place: { readonly id: string; readonly name: string } }).place
    const detail = (detailed.body as { readonly place: { readonly website?: string; readonly openingHours?: string; readonly phone?: string } }).place
    const offered = capabilities.body as { readonly providerId: string; readonly tiles?: unknown; readonly capabilities: { readonly map: boolean; readonly placeLookup: boolean; readonly modes: ReadonlyArray<string>; readonly traffic: string; readonly transit: string } }

    try check(() => assert.deepStrictEqual(
      {
        capabilities: [capabilities.status, offered.providerId, offered.tiles, offered.capabilities.map, offered.capabilities.placeLookup, offered.capabilities.modes, offered.capabilities.traffic, offered.capabilities.transit],
        geocoded: [geocoded.status, placesOf(geocoded), osm.calls[0]?.query.get("layer"), osm.calls[0]?.headers["user-agent"]],
        repeated: [repeated.status, repeated.body],
        searched: [searched.status, placesOf(searched), typeof osm.calls[1]?.query.get("viewbox")],
        reversed: [reversed.status, place.id, place.name],
        detailed: [detailed.status, detail.website, detail.openingHours, detail.phone],
        walked: [walked.status, route.distanceMeters, route.durationSeconds, route.traffic, route.steps.map((step) => step.maneuver), osm.calls[4]?.body.includes("\"profile\":\"foot\"")],
        refusals: [transit.status, errorOf(transit), unroutable.status, errorOf(unroutable), outage.status, errorOf(outage), garbled.status, errorOf(garbled)],
        tile: [tile.status, errorOf(tile), osm.calls.length - callsBeforeTile],
        calls: osm.calls.length,
        usage: usage.map((row) => [row.operation, row.status, Number(row.quote), Number(row.charged), row.outcome])
      },
      {
        capabilities: [200, "osm", undefined, false, false, ["drive", "walk", "bicycle"], "none", "none"],
        geocoded: [200, [["W4031000", "1 Pariser Platz"]], "address", "elizaOS-Cloud-Maps/1"],
        repeated: [200, geocoded.body],
        searched: [200, [["N240109189", "Brandenburger Tor"], ["W4031000", "1 Pariser Platz"]], "string"],
        reversed: [200, "W4031000", "1 Pariser Platz"],
        detailed: [200, "https://example.org/tor", "24/7", "+49 30 0000"],
        walked: [200, 1520.4, 912, "none", ["depart", "left", "arrive"], true],
        refusals: [422, "unsupported_mode", 422, "no_route", 503, "provider_unavailable", 502, "provider_invalid_response"],
        tile: [404, "capability_unavailable", 0],
        calls: 8,
        usage: [
          ["geocode", "answered", 0, 0, "known"],
          ["places_search", "answered", 0, 0, "known"],
          ["reverse", "answered", 0, 0, "known"],
          ["place_details", "answered", 0, 0, "known"],
          ["routes", "answered", 0, 0, "known"],
          ["routes", "refused", 0, 0, "known"],
          ["routes", "refused", 0, 0, "known"],
          ["geocode", "refused", 0, 0, "known"],
          ["geocode", "refused", 0, 0, "known"]
        ]
      }
    ))
  }), 60_000)
})
describe("WP8 Managed Google (spec/cloud/services/google/connection.md, \"Story: Connect my Google account with the access I chose\")", () => {
  it.live("Connect Google through a registered return, consume the state once, see the status, land a later grant on the same connection, link a second one natively and disconnect at Google (spec/cloud/services/google/connection.md, \"Story: Connect my Google account with the access I chose\"; spec/cloud/services/google/connection.md, \"Story: See my Google connection as the cloud holds it\"; spec/cloud/services/google/connection.md, \"Story: Disconnect it\")", () => scoped(effect {
    const google = try Effect.try(() => googleFakeState())
    const identity = try Effect.try(() => googleIdentityFake(secrets.GOOGLE_CLIENT_SECRET ?? ""))
    const consent = try Effect.try(() => googleConsent(google, identity, secrets.GOOGLE_CLIENT_SECRET ?? ""))
    const cloud = try testCloud({ mount: (fakes) => {
      fakes.mount("/google/", consent.handler)
      fakes.mount("/google/", identity.handler)
      fakes.mount("/google/", mountGoogleToken(google))
    } })
    const now = try Clock.currentTimeMillis
    const web = "https://www.staging.example.com"
    const connectReturn = `${web}/apps/link/connect`
    const app = (name: string, fingerprint: string) => ({
      clientId: `com.example.${name}`, environment: "staging", displayName: name === "link" ? "Link" : "Plain", androidPackage: `com.example.${name}`,
      certFingerprints: [`E3:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:${fingerprint}`],
      signInReturn: `${web}/apps/${name}/sign-in`, billingReturn: `${web}/apps/${name}/billing`, credentialTtlMs: 30 * 86_400_000, nativeGoogle: false, enabled: true
    })
    try cloud.inside(cloud.store.transaction(effect (tx: Tx) => {
      try registerClient(tx, try decodeRegistration({ ...app("link", "A5"), connectReturn }), now)
      try registerClient(tx, try decodeRegistration(app("plain", "A6")), now)
    }))
    const token = try entitledDevice(cloud, "connect", now)
    try sql(cloud, "UPDATE device_grants SET client_id = 'com.example.plain' WHERE key = 'grant-connect'", [])
    const headers = { authorization: `Bearer ${token}` }
    const call = (path: string, json?: unknown) => cloud.call(`/api/v1/eliza/google${path}`, json === undefined ? { headers } : { method: "POST", headers, json })
    const errorOf = (answer: { readonly status: number; readonly body: unknown }) => [answer.status, (answer.body as { readonly error?: string }).error, (answer.body as { readonly reason?: string }).reason]
    const appState = "s".repeat(43)
    const redirectUrl = `${connectReturn}?state=${appState}`
    const asked = ["google.gmail.triage", "google.calendar.read"]
    const through = effect (body: unknown) => {
      const started = try call("/connect/initiate", body)
      const authUrl = (started.body as { readonly authUrl: string }).authUrl
      const consented = try tryPromise(() => visit(authUrl))
      const callback = new URL(consented.location)
      const back = try tryPromise(() => visit(`${cloud.url}${callback.pathname}${callback.search}`))
      return { started, authUrl, callbackPath: `${callback.pathname}${callback.search}`, back }
    }
    type Status = { readonly connected: boolean; readonly reason: string; readonly identity: unknown; readonly grantedCapabilities: ReadonlyArray<string>; readonly grantedScopes: ReadonlyArray<string>; readonly hasRefreshToken: boolean; readonly connectionId: string | null; readonly expiresAt: string | null }
    const seen = (answer: { readonly body: unknown }) => {
      const body = answer.body as Status
      return [body.connected, body.reason, body.identity, body.grantedCapabilities, body.grantedScopes, body.hasRefreshToken, body.connectionId, body.expiresAt === null]
    }
    const twoParams = try call("/connect/initiate", { capabilities: asked, redirectUrl: `${redirectUrl}&extra=1` })
    const foreign = try call("/connect/initiate", { capabilities: asked, redirectUrl: `${web}/apps/other/connect?state=${appState}` })
    const nothingAsked = try call("/connect/initiate", { capabilities: [] })
    const agentSide = try call("/connect/initiate", { side: "agent", capabilities: asked })
    const stored = (try sql(cloud, "SELECT count(*)::int AS n FROM google_connect_states", []))[0]?.n
    const first = try through({ capabilities: asked, redirectUrl })
    const replayed = try tryPromise(() => visit(`${cloud.url}${first.callbackPath}`))
    const returned = fragment(first.back.location)
    const connectionId = returned.get("connectionId") ?? ""
    const afterFirst = try call("/status")
    try sync(() => consent.withholdRefreshToken())
    const again = try through({ capabilities: ["google.gmail.send"] })
    const afterAgain = try call("/status")
    try sync(() => consent.denyNext())
    const denied = try through({ capabilities: asked, redirectUrl })
    try sync(() => consent.consentAs({ subject: "google-connect-1", email: "connect@example.com", emailVerified: true }, (scopes) => scopes.filter((scope) => !scope.endsWith("/gmail.readonly"))))
    const narrowed = try through({ capabilities: asked, redirectUrl })
    const second = { subject: "google-connect-2", email: "second@example.com", emailVerified: true }
    const nativeCode = try sync(() => consent.serverAuthCode(second, ["openid", "email", "https://www.googleapis.com/auth/gmail.readonly"]))
    const native = try call("/connect/native", { serverAuthCode: nativeCode })
    const nativeId = (native.body as { readonly connectionId: string }).connectionId
    const ambiguous = try call("/status")
    const accounts = try call("/accounts")
    const disconnected = try call("/disconnect", { side: "owner", connectionId })
    const revokedOnce = [...google.revoked].map((refresh) => google.grants.get(refresh)?.subject)
    const afterDisconnect = try call(`/status?grantId=${connectionId}`)
    const disconnectedAgain = try call("/disconnect", { connectionId })
    const anonymous = try cloud.call("/api/v1/eliza/google/status")
    const held = try sql(cloud, "SELECT key, status, subject FROM google_connections WHERE status <> 'Pending' ORDER BY linked_at", [])
    const authorize = new URL(first.authUrl)
    const auth = "https://www.googleapis.com/auth/"
    try check(() => assert.deepStrictEqual(
      {
        refused: [errorOf(twoParams), errorOf(foreign), errorOf(nothingAsked), errorOf(agentSide), stored],
        started: [first.started.status, (first.started.body as { readonly appReturn?: number }).appReturn, authorize.pathname, authorize.searchParams.get("redirect_uri"), authorize.searchParams.get("scope"), authorize.searchParams.get("code_challenge_method"), authorize.searchParams.get("access_type")],
        back: [first.back.status, first.back.location.startsWith(`${redirectUrl}#`), returned.get("state"), returned.get("result"), connectionId !== ""],
        replayed: replayed.status,
        afterFirst: seen(afterFirst),
        again: [(again.started.body as { readonly appReturn?: number }).appReturn, again.back.status, again.back.body.includes("Plain")],
        afterAgain: seen(afterAgain),
        denied: [fragment(denied.back.location).get("result"), fragment(denied.back.location).get("connectionId")],
        narrowed: [fragment(narrowed.back.location).get("result"), fragment(narrowed.back.location).get("connectionId")],
        native: [native.status, native.body],
        ambiguous: errorOf(ambiguous),
        accounts: [accounts.status, (accounts.body as ReadonlyArray<{ readonly connectionId: string }>).map((account) => account.connectionId)],
        disconnected: [disconnected.status, disconnected.body, revokedOnce],
        afterDisconnect: seen(afterDisconnect),
        disconnectedAgain: [disconnectedAgain.status, disconnectedAgain.body, google.revoked.size],
        anonymous: errorOf(anonymous),
        held: held.map((row) => [row.key, row.status, row.subject])
      },
      {
        refused: [[400, "invalid_request", undefined], [400, "redirect_mismatch", undefined], [400, "invalid_request", undefined], [400, "invalid_request", undefined], 0],
        started: [200, 2, "/google/accounts", "https://api.staging.example.com/api/v1/oauth/google/callback", `openid ${auth}userinfo.email ${auth}userinfo.profile ${auth}calendar.events ${auth}gmail.readonly`, "S256", "offline"],
        back: [302, true, appState, "connected", true],
        replayed: 400,
        afterFirst: [true, "connected", { email: "connect@example.com" }, ["google.basic_identity", "google.gmail.triage", "google.calendar.read", "google.calendar.write"],
          ["openid", `${auth}userinfo.email`, `${auth}userinfo.profile`, `${auth}calendar.events`, `${auth}gmail.readonly`], true, connectionId, false],
        again: [undefined, 200, true],
        afterAgain: [true, "connected", { email: "connect@example.com" }, ["google.basic_identity", "google.gmail.send"],
          ["openid", `${auth}userinfo.email`, `${auth}userinfo.profile`, `${auth}gmail.send`], true, connectionId, false],
        denied: ["denied", null],
        narrowed: ["failed", null],
        native: [200, { connected: true, connectionId: nativeId, email: "second@example.com", scopes: ["openid", "email", `${auth}gmail.readonly`], refreshTokenIssued: true }],
        ambiguous: [400, "invalid_request", "grant_required"],
        accounts: [200, [nativeId, connectionId]],
        disconnected: [200, { ok: true }, ["google-connect-1"]],
        afterDisconnect: [false, "disconnected", { email: "connect@example.com" }, [], [], false, connectionId, true],
        disconnectedAgain: [200, { ok: true }, 1],
        anonymous: [401, "authentication_required", "credential_unknown"],
        held: [[connectionId, "Revoked", "google-connect-1"], [nativeId, "Active", "google-connect-2"]]
      }
    ))
  }), 60_000)

  it.live("Triage, search and read my mail at the history Google answered, refusing a stale attachment and an oversized body (spec/cloud/services/google/mailRead.md, \"Story: Read my mail through the grant I chose\")", () => scoped(effect {
    const google = try Effect.try(() => googleFakeState())
    const now = try Clock.currentTimeMillis
    const mailbox = try Effect.try(() => readableMailbox([
      {
        id: "msg-direct", threadId: "thr-direct", labelIds: ["INBOX", "UNREAD", "IMPORTANT"], internalDate: now - 60_000,
        headers: { From: "Ada <ada@example.org>", To: "conn-mail@example.com", Subject: "Quarterly plan" }, snippet: "Can you review", bodyText: "Please review the plan.",
        attachments: [{ partId: "1", filename: "plan.pdf", mimeType: "application/pdf", bytes: new TextEncoder().encode("%PDF-plan") }]
      },
      {
        id: "msg-digest", threadId: "thr-digest", labelIds: ["INBOX"], internalDate: now - 120_000,
        headers: { From: "News <noreply@news.example>", To: "conn-mail@example.com", Subject: "Weekly digest", "List-Id": "<digest.news.example>" }, snippet: "digest", bodyText: "x".repeat(300 * 1024)
      },
      { id: "msg-trashed", threadId: "thr-trashed", labelIds: ["TRASH"], internalDate: now - 30_000, headers: { From: "ada@example.org", Subject: "Old plan" }, snippet: "plan" }
    ]))
    const draftRaw = btoa("To: ada@example.org\r\nSubject: Re: Quarterly plan\r\n\r\nLooks good.").replaceAll("+", "-").replaceAll("/", "_").replace(/=+$/, "")
    mailbox.drafts.set("draft-1", { id: "draft-1", messageId: "msg-draft-1", raw: draftRaw })
    const cloud = try testCloud({ mount: (fakes) => {
      fakes.mount("/google/", mountGoogleToken(google))
      fakes.mount("/google/api/", gmailReads(mailbox))
    } })
    const token = try entitledDevice(cloud, "mail", now)
    const owner: Owner = { organizationId: "org-mail", userId: "user-mail" }
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage"), ...scopeFor("google.gmail.drafts")]
    const refreshToken = try Effect.try(() => seedGrant(google, { subject: "subject-conn-mail", email: "conn-mail@example.com", scopes }))
    const profile = try parseProfile(try Effect.try(() => testProfile(cloud.fakes.url)))
    const deployment = deploymentLayer(profile, "staging").pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets }))))
    provide Store = cloud.store, deployment {
      try linkedGrant(cloud, owner, "conn-mail", refreshToken, scopes, now - 1000)
    }
    const gmail = (path: string) => cloud.call(`/api/v1/eliza/google/gmail${path}`, { headers: { authorization: `Bearer ${token}` } })
    const errorOf = (answer: { readonly status: number; readonly body: unknown }) => [answer.status, (answer.body as { readonly error?: string }).error]
    const triage = try gmail("/triage")
    const search = try gmail("/search?query=plan&maxResults=10")
    const tooMany = try gmail("/search?query=plan&maxResults=101")
    const read = try gmail("/read?messageId=msg-direct")
    const oversized = try gmail("/read?messageId=msg-digest")
    const capabilities = try gmail("/inbox-v1/capabilities")
    const attachment = try gmail("/inbox-v1/attachment?messageId=msg-direct&partId=1&historyId=1001")
    const thread = try gmail("/inbox-v1/thread?threadId=thr-direct&historyId=1001")
    try Effect.try(() => touchMessage(mailbox, "msg-direct"))
    const staleAttachment = try gmail("/inbox-v1/attachment?messageId=msg-direct&partId=1&historyId=1001")
    const staleThread = try gmail("/inbox-v1/thread?threadId=thr-direct&historyId=1001")
    const drafts = try gmail("/inbox-v1/drafts")
    const draft = try gmail("/inbox-v1/draft?draftId=draft-1")
    const anonymous = try cloud.call("/api/v1/eliza/google/gmail/triage")
    const pdf = new TextEncoder().encode("%PDF-plan")
    type Card = { readonly id: string; readonly triageScore: number; readonly triageReason: string; readonly isImportant: boolean; readonly likelyReplyNeeded: boolean; readonly to: ReadonlyArray<string>; readonly metadata: { readonly historyId: string } }
    const cards = (answer: { readonly body: unknown }) => (answer.body as { readonly messages: ReadonlyArray<Card> }).messages.map((card) => [card.id, card.triageScore, card.triageReason, card.isImportant, card.likelyReplyNeeded, card.metadata.historyId])
    const readBody = read.body as { readonly message: Card; readonly bodyText: string; readonly bodyHtml: string | null; readonly bodyHtmlStatus: string; readonly attachments: ReadonlyArray<unknown> }
    const file = attachment.body as { readonly name: string; readonly mimeType: string; readonly size: number; readonly dataBase64: string; readonly sha256: string; readonly supported: boolean }
    const threadBody = thread.body as { readonly historyId: string; readonly total: number; readonly messages: ReadonlyArray<{ readonly bodyText: string }> }
    const draftList = drafts.body as { readonly drafts: ReadonlyArray<{ readonly draftId: string; readonly messageId: string; readonly subject: string; readonly to: ReadonlyArray<string> }>; readonly nextPageToken: string | null }
    const draftBody = draft.body as { readonly providerDigest: string; readonly content: { readonly to: ReadonlyArray<string>; readonly subject: string; readonly bodyText: string; readonly plainText: boolean } }
    try check(() => assert.deepStrictEqual(
      {
        triage: [triage.status, (triage.body as { readonly mailboxHistoryId: string }).mailboxHistoryId, cards(triage)],
        search: [search.status, (search.body as { readonly mailboxHistoryId: string }).mailboxHistoryId, (search.body as { readonly nextPageToken: string | null }).nextPageToken, cards(search)],
        tooMany: errorOf(tooMany),
        read: [read.status, readBody.message.id, readBody.message.to, readBody.bodyText, readBody.bodyHtml, readBody.bodyHtmlStatus, readBody.attachments],
        oversized: errorOf(oversized),
        capabilities: [capabilities.status, capabilities.body],
        attachment: [attachment.status, file.name, file.mimeType, file.size, file.dataBase64, file.sha256, file.supported],
        thread: [thread.status, threadBody.historyId, threadBody.total, threadBody.messages.map((message) => message.bodyText)],
        stale: [errorOf(staleAttachment), errorOf(staleThread)],
        drafts: [drafts.status, draftList.drafts, draftList.nextPageToken],
        draft: [draft.status, draftBody.providerDigest, draftBody.content.to, draftBody.content.subject, draftBody.content.bodyText, draftBody.content.plainText],
        anonymous: errorOf(anonymous)
      },
      {
        triage: [200, "1003", [
          ["msg-direct", 110, "unread, important label, directly addressed, likely needs reply", true, true, "1001"],
          ["msg-digest", 0, "directly addressed, automated sender", false, false, "1002"]
        ]],
        search: [200, "1003", null, [["msg-direct", 110, "unread, important label, directly addressed, likely needs reply", true, true, "1001"]]],
        tooMany: [400, "invalid_request"],
        read: [200, "msg-direct", ["conn-mail@example.com"], "Please review the plan.", null, "none", [{ partId: "1", name: "plan.pdf", mimeType: "application/pdf", size: pdf.length, supported: true }]],
        oversized: [413, "content_too_large"],
        capabilities: [200, { version: 1, from: "conn-mail@example.com", kinds: ["draft-create", "draft-replace", "draft-delete"], attachmentPolicy: { mimeTypes: ["application/pdf", "text/plain", "image/png", "image/jpeg", "image/webp"], maxBytes: 8 * 1024 * 1024 } }],
        attachment: [200, "plan.pdf", "application/pdf", pdf.length, btoa("%PDF-plan"), sha256Hex("%PDF-plan"), true],
        thread: [200, "1001", 1, ["Please review the plan."]],
        stale: [[409, "stale_revision"], [409, "stale_revision"]],
        drafts: [200, [{ draftId: "draft-1", messageId: "msg-draft-1", subject: "Re: Quarterly plan", to: ["ada@example.org"], snippet: "", updatedAt: null }], null],
        draft: [200, sha256Hex(draftRaw), ["ada@example.org"], "Re: Quarterly plan", "Looks good.", true],
        anonymous: [401, "authentication_required"]
      }
    ))
  }), 30_000)

  it.live("Trash a message as reviewed, lose Google's reply, and keep its outcome unknown without asking Google again (spec/cloud/services/google/mailOperations.md, \"Story: Change or send from my mailbox once, as I reviewed it\"; spec/cloud/shared/dispatchOnce.md, \"Story: Send a change once and recover its outcome without sending it again\")", () => scoped(effect {
    const { mailbox, switches, operation, grantId } = try mailOperationSetup("ops-trash")
    const requestId = "6f1c2a3b-4d5e-4f60-8a7b-1c2d3e4f5a6b"
    const proposal = { kind: "trash", messageId: "msg-plan", expectedHistoryId: "1001" }
    const prepared = try operation("", { grantId, requestId, proposal })
    const reviewDigest = (prepared.body as OperationAnswer).receipt.reviewDigest
    const again = try operation("", { grantId, requestId, proposal })
    const otherKind = try operation("", { grantId, requestId, proposal: { ...proposal, kind: "archive" } })
    const wrongDigest = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest: "0".repeat(64), proposal })
    switches.dropNextReply = true
    const lost = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    const looked = try operation(`/${requestId}?grantId=${grantId}`)
    const replayed = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    const unknown = try operation(`/9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d?grantId=${grantId}`)
    const trashed = mailbox.messages.get("msg-plan")
    try check(() => assert.deepStrictEqual(
      {
        prepared: [prepared.status, receiptOf(prepared), (prepared.body as OperationAnswer).review, (prepared.body as OperationAnswer).providerExactlyOnce, (prepared.body as OperationAnswer).version],
        again: [again.status, (again.body as OperationAnswer).receipt.reviewDigest === reviewDigest, receiptOf(again)],
        otherKind: errorOf(otherKind),
        wrongDigest: errorOf(wrongDigest),
        lost: [lost.status, receiptOf(lost)],
        looked: [looked.status, receiptOf(looked), (looked.body as OperationAnswer).receipt.providerResult],
        replayed: [replayed.status, receiptOf(replayed)],
        unknown: errorOf(unknown),
        mailbox: [trashed?.labelIds, switches.calls.filter((call) => call.path === "/messages/msg-plan/trash").length, switches.calls.length]
      },
      {
        prepared: [200, ["trash", "prepared", null, false, false], { kind: "trash", messageId: "msg-plan", expectedHistoryId: "1001", from: "ops-ops-trash@example.com" }, false, 1],
        again: [200, true, ["trash", "prepared", null, false, false]],
        otherKind: [409, "idempotency_conflict"],
        wrongDigest: [409, "stale_revision"],
        lost: [200, ["trash", "outcome-unknown", null, true, false]],
        looked: [200, ["trash", "outcome-unknown", null, true, false], null],
        replayed: [200, ["trash", "outcome-unknown", null, true, false]],
        unknown: [404, "not_found"],
        mailbox: [["UNREAD", "TRASH"], 1, 1]
      }
    ))
  }), 30_000)

  it.live("Send a message with an attachment once though the dispatch is replayed, and refuse a forward at a stale history id (spec/cloud/services/google/mailOperations.md, \"Story: Change or send from my mailbox once, as I reviewed it\"; spec/cloud/services/google/mailRead.md, \"Story: Read my mail through the grant I chose\")", () => scoped(effect {
    const { mailbox, switches, operation, grantId } = try mailOperationSetup("ops-send")
    const requestId = "1b2c3d4e-5f60-4a7b-8c9d-0e1f2a3b4c5d"
    const note = btoa("Agenda for Monday")
    const proposal = { kind: "send", mode: "compose", to: ["ada@example.org"], subject: "Agenda", bodyText: "See the note.", attachments: [{ name: "agenda.txt", mimeType: "text/plain", dataBase64: note }] }
    const prepared = try operation("", { grantId, requestId, proposal })
    const reviewDigest = (prepared.body as OperationAnswer).receipt.reviewDigest
    const changed = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal: { ...proposal, bodyText: "Something else." } })
    const sent = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    const replayed = try operation(`/${requestId}/dispatch`, { grantId, reviewDigest, proposal })
    const looked = try operation(`/${requestId}?grantId=${grantId}`)
    const sends = switches.calls.filter((call) => call.path === "/messages/send").length
    const outgoing = try Effect.try(() => sentTexts(mailbox))
    const raw = outgoing[0] ?? ""
    const forward = (historyId: string) => ({ kind: "send", mode: "forward", to: ["grace@example.org"], subject: "Fwd: Quarterly plan", bodyText: "Forwarding the plan.", forwardAttachments: { messageId: "msg-plan", historyId, partIds: ["1"] } })
    const forwarded = try operation("", { grantId, requestId: "2c3d4e5f-6071-4b8c-9d0e-1f2a3b4c5d6e", proposal: forward("1001") })
    try Effect.try(() => touchMessage(mailbox, "msg-plan"))
    const stale = try operation("", { grantId, requestId: "3d4e5f60-7182-4c9d-8e1f-2a3b4c5d6e7f", proposal: forward("1001") })
    const review = (prepared.body as OperationAnswer).review as { readonly to: ReadonlyArray<string>; readonly attachments: ReadonlyArray<unknown> }
    try check(() => assert.deepStrictEqual(
      {
        prepared: [prepared.status, receiptOf(prepared), review.to, review.attachments],
        changed: errorOf(changed),
        sent: [sent.status, receiptOf(sent), ((sent.body as OperationAnswer).receipt.providerResult as { readonly labelIds: ReadonlyArray<string> }).labelIds],
        replayed: [replayed.status, receiptOf(replayed), (replayed.body as OperationAnswer).receipt.providerResult === null],
        looked: [looked.status, receiptOf(looked)],
        once: [sends, outgoing.length, raw.includes(`Message-ID: <eliza-${requestId}@message.invalid>`), raw.includes(`filename*=UTF-8''agenda.txt`), raw.includes(note)],
        forwarded: [forwarded.status, receiptOf(forwarded), ((forwarded.body as OperationAnswer).review as { readonly forwardedAttachments: ReadonlyArray<{ readonly name: string }> }).forwardedAttachments.map((file) => file.name)],
        stale: errorOf(stale)
      },
      {
        prepared: [200, ["send", "prepared", null, false, false], ["ada@example.org"], [{ name: "agenda.txt", mimeType: "text/plain", size: 17, sha256: sha256Hex("Agenda for Monday") }]],
        changed: [409, "stale_revision"],
        sent: [200, ["send", "succeeded", null, true, true], ["SENT"]],
        replayed: [200, ["send", "succeeded", null, true, true], false],
        looked: [200, ["send", "succeeded", null, true, true]],
        once: [1, 1, true, true, true],
        forwarded: [200, ["send", "prepared", null, false, false], ["plan.pdf"]],
        stale: [409, "stale_revision"]
      }
    ))
  }), 30_000)
})

type OperationAnswer = {
  readonly version: number
  readonly providerExactlyOnce: boolean
  readonly review?: unknown
  readonly receipt: { readonly kind: string; readonly state: string; readonly reviewDigest: string; readonly rejectionCode: string | null; readonly providerResult: unknown; readonly createdAt: string; readonly dispatchedAt: string | null; readonly finishedAt: string | null }
}

function receiptOf(answer: { readonly body: unknown }): ReadonlyArray<unknown> {
  const receipt = (answer.body as OperationAnswer).receipt
  return [receipt.kind, receipt.state, receipt.rejectionCode, receipt.dispatchedAt !== null, receipt.finishedAt !== null]
}

function errorOf(answer: { readonly status: number; readonly body: unknown }): ReadonlyArray<unknown> {
  return [answer.status, (answer.body as { readonly error?: string }).error]
}

effect function mailOperationSetup(name: string) {
  const google = try Effect.try(() => googleFakeState())
  const now = try Clock.currentTimeMillis
  const mailbox = try Effect.try(() => readableMailbox([{
    id: "msg-plan", threadId: "thr-plan", labelIds: ["INBOX", "UNREAD"], internalDate: now - 60_000,
    headers: { From: "Ada <ada@example.org>", To: `ops-${name}@example.com`, Subject: "Quarterly plan", "Message-ID": "<plan@example.org>" }, snippet: "plan", bodyText: "Please review the plan.",
    attachments: [{ partId: "1", filename: "plan.pdf", mimeType: "application/pdf", bytes: new TextEncoder().encode("%PDF-plan") }]
  }]))
  const switches = try Effect.try(() => gmailChangeSwitches())
  const cloud = try testCloud({ mount: (fakes) => {
    fakes.mount("/google/", mountGoogleToken(google))
    fakes.mount("/google/api/", gmailReads(mailbox))
    fakes.mount("/google/api/", gmailChanges(mailbox, switches))
  } })
  const token = try entitledDevice(cloud, name, now)
  const owner: Owner = { organizationId: `org-${name}`, userId: `user-${name}` }
  const grantId = `ops-${name}`
  const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.manage"), ...scopeFor("google.gmail.send")]
  const refreshToken = try Effect.try(() => seedGrant(google, { subject: `subject-${grantId}`, email: `${grantId}@example.com`, scopes }))
  try cloud.inside(linkedGrant(cloud, owner, grantId, refreshToken, scopes, now - 1000))
  const headers = { authorization: `Bearer ${token}` }
  const operation = (path: string, json?: unknown) => cloud.call(`/api/v1/eliza/google/gmail/inbox-v1/operations${path}`, json === undefined ? { headers } : { method: "POST", headers, json })
  return { mailbox, switches, operation, grantId }
}

effect function grantRefusal<A, E extends { readonly _tag: string }, R>(program: A!E!R): string!!R {
  return match (try exit(program)) {
    when Exit.Success: "granted";
    when Exit.Failure(let cause): Cause.findErrorOption(cause).pipe(Option.map((error) => "refusal" in error ? (refusalBody(error.refusal as Parameters<typeof refusalBody>[0]).reason ?? refusalBody(error.refusal as Parameters<typeof refusalBody>[0]).error) : error._tag), Option.getOrElse(() => "defect"));
  }
}

effect function linkedGrant(cloud: TestCloud, owner: Owner, connectionId: string, refreshToken: string, scopes: ReadonlyArray<string>, expiresAt: number) {
  try cloud.store.transaction((tx) => storeGrant(tx, {
    connectionId, owner, subject: `subject-${connectionId}`, email: `${connectionId}@example.com`, grantedScopes: scopes,
    tokens: { refreshToken, accessToken: `stale-${connectionId}`, expiresAt }, now: expiresAt - 1
  }))
}

describe("WP8 Managed Google: grant access (spec/cloud/services/google/connection.md)", () => {
  it.live("Refresh a held grant once for concurrent callers and mark it Expired when Google refuses it (spec/cloud/services/google/connection.md, \"Story: Connect my Google account with the access I chose\")", () => scoped(effect {
    const google = try Effect.try(() => googleFakeState())
    google.tokenDelayMs = 300
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", mountGoogleToken(google)) })
    const profileInput = try Effect.try(() => testProfile(cloud.fakes.url))
    const profile = try parseProfile(profileInput)
    const deployment = deploymentLayer(profile, "staging").pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets }))))
    const now = try Clock.currentTimeMillis
    const held: Owner = { organizationId: "org-google-held", userId: "user-google-held" }
    const lost: Owner = { organizationId: "org-google-lost", userId: "user-google-lost" }
    for (const owner of [held, lost]) {
      try organization(cloud, owner.organizationId)
      try sql(cloud, "INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'active', $3, $4, $4)", [owner.userId, owner.organizationId, `${owner.userId}@example.com`, now])
    }
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage")]
    const heldToken = try Effect.try(() => seedGrant(google, { subject: "subject-conn-held", email: "conn-held@example.com", scopes }))
    const lostToken = try Effect.try(() => seedGrant(google, { subject: "subject-conn-lost", email: "conn-lost@example.com", scopes }))
    google.revoked.add(lostToken)
    provide Store = cloud.store, deployment, FetchHttpClient.layer {
      try linkedGrant(cloud, held, "conn-held", heldToken, scopes, now - 1000)
      try linkedGrant(cloud, lost, "conn-lost", lostToken, scopes, now - 1000)
      const both = try all([useGrant(held, undefined, "google.gmail.triage"), useGrant(held, "conn-held", "google.gmail.triage")], { concurrency: 2 })
      const again = try useGrant(held, undefined, "google.gmail.triage", "subject-conn-held")
      const refusals = {
        missing: try grantRefusal(useGrant(held, undefined, "google.gmail.send")),
        changed: try grantRefusal(useGrant(held, undefined, "google.gmail.triage", "subject-elsewhere")),
        foreign: try grantRefusal(useGrant(held, "conn-lost", "google.gmail.triage")),
        side: try grantRefusal(useGrant(held, "conn-none", "google.gmail.triage")),
        invalidGrant: try grantRefusal(useGrant(lost, undefined, "google.gmail.triage")),
        afterwards: try grantRefusal(useGrant(lost, undefined, "google.gmail.triage"))
      }
      const rows = try sql(cloud, "SELECT key, status, tokens IS NULL AS erased, refreshing_until FROM google_connections ORDER BY key", [])
      try check(() => assert.deepStrictEqual(
        {
          singleFlight: [google.tokenCalls, both[0].accessToken === both[1].accessToken, again.accessToken === both[0].accessToken, both[0].connectionId, both[0].email],
          refusals,
          rows: rows.map((row) => [row.key, row.status, row.erased, Number(row.refreshing_until)])
        },
        {
          singleFlight: [2, true, true, "conn-held", "conn-held@example.com"],
          refusals: { missing: "capability_missing", changed: "google_account_changed", foreign: "not_found", side: "not_found", invalidGrant: "google_reauth_required", afterwards: "google_reauth_required" },
          rows: [["conn-held", "Active", false, 0], ["conn-lost", "Expired", false, 0]]
        }
      ))
    }
  }), 30_000)
})
effect function calendarSetup(email: string) {
  const google = try Effect.try(() => googleFakeState())
  const cloud = try testCloud({ mount: (fakes) => {
    fakes.mount("/google/", mountGoogleToken(google))
    fakes.mount("/google/", mountGoogleCalendar(google))
  } })
  const signed = try signedIn(cloud, email)
  const owner: Owner = { organizationId: signed.organizationId, userId: signed.user.id }
  const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.calendar.write")]
  const refreshToken = try Effect.try(() => seedGrant(google, { subject: "subject-cal", email: "cal@example.com", scopes }))
  const now = try Clock.currentTimeMillis
  try cloud.inside(linkedGrant(cloud, owner, "cal", refreshToken, scopes, now - 1000))
  try Effect.try(() => {
    seedCalendar(google, { id: "own@example.com", summary: "Own", accessRole: "owner", primary: true, timeZone: "Europe/Berlin" })
    seedCalendar(google, { id: "team@example.com", summary: "Team", accessRole: "reader", timeZone: "UTC" })
    seedEvent(google, "own@example.com", "standup", { summary: "Standup", start: { dateTime: "2026-12-01T09:00:00Z" }, end: { dateTime: "2026-12-01T09:15:00Z" } })
  })
  return { google, cloud, headers: { authorization: `Bearer ${signed.accessToken}` } }
}

function calendarRefusal(body: unknown): ReadonlyArray<unknown> {
  const answer = body as { readonly error?: string; readonly reason?: string; readonly outcome?: string }
  return [answer.error, answer.reason, answer.outcome]
}

describe("WP8 Managed Google: calendar (spec/cloud/services/google/calendar.md)", () => {
  const calendarBase = "/api/v1/eliza/google/calendar"

  it.live("Read my calendars, a window of events and one event, refusing a window that is empty or in no time zone (spec/cloud/services/google/calendar.md, \"Story: Read my calendar for a window\")", () => scoped(effect {
    const { cloud, headers } = try calendarSetup("calendar-reads@example.com")
    const window = "timeMin=2026-12-01T00:00:00Z&timeMax=2026-12-02T00:00:00Z"
    const calendars = try cloud.call(`${calendarBase}/calendars`, { headers })
    const feed = try cloud.call(`${calendarBase}/feed?${window}&timeZone=Europe/Berlin`, { headers })
    const reversed = try cloud.call(`${calendarBase}/feed?timeMin=2026-12-02T00:00:00Z&timeMax=2026-12-01T00:00:00Z`, { headers })
    const empty = try cloud.call(`${calendarBase}/feed?timeMin=2026-12-01T00:00:00Z&timeMax=2026-12-01T00:00:00Z`, { headers })
    const noZone = try cloud.call(`${calendarBase}/feed?${window}&timeZone=Mars/Olympus`, { headers })
    const one = try cloud.call(`${calendarBase}/events/standup`, { headers })
    const missing = try cloud.call(`${calendarBase}/events/nothere`, { headers })
    const anonymous = try cloud.call(`${calendarBase}/calendars`)
    const events = (feed.body as { readonly events: ReadonlyArray<{ readonly externalId: string; readonly title: string; readonly etag: string | null }> }).events
    try check(() => assert.deepStrictEqual(
      {
        calendars: [calendars.status, calendars.body],
        feed: [feed.status, (feed.body as { readonly calendarId: string }).calendarId, events.map((event) => [event.externalId, event.title, event.etag !== null]), typeof (feed.body as { readonly syncedAt: unknown }).syncedAt],
        refused: [reversed.status, empty.status, noZone.status, calendarRefusal(reversed.body)],
        one: [one.status, (one.body as { readonly event: { readonly externalId: string } }).event.externalId],
        missing: [missing.status, calendarRefusal(missing.body)],
        anonymous: anonymous.status
      },
      {
        calendars: [200, [
          { calendarId: "own@example.com", accountId: "subject-cal", accountEmail: "cal@example.com", label: "Own", accessRole: "owner", read: true, write: true },
          { calendarId: "team@example.com", accountId: "subject-cal", accountEmail: "cal@example.com", label: "Team", accessRole: "reader", read: true, write: false }
        ]],
        feed: [200, "primary", [["standup", "Standup", true]], "string"],
        refused: [400, 400, 400, ["invalid_request", undefined, undefined]],
        one: [200, "standup"],
        missing: [404, ["not_found", undefined, undefined]],
        anonymous: 401
      }
    ))
  }), 30_000)

  it.live("Create an event once per key and change or delete it only at the revision I read (spec/cloud/services/google/calendar.md, \"Story: Change an event only at the revision I read\"; spec/cloud/shared/dispatchOnce.md, \"Story: Send a change once and recover its outcome without sending it again\")", () => scoped(effect {
    const { google, cloud, headers } = try calendarSetup("calendar-writes@example.com")
    const create = (key: string | undefined, json: unknown) => cloud.call(`${calendarBase}/events`, { method: "POST", headers: key === undefined ? headers : { ...headers, "idempotency-key": key }, json })
    const lunch = { title: "Lunch", startAt: "2026-12-01T12:00:00Z", endAt: "2026-12-01T13:00:00Z" }
    const unkeyed = try create(undefined, lunch)
    const first = try create("lunch-key-0001", lunch)
    const again = try create("lunch-key-0001", lunch)
    const other = try create("lunch-key-0001", { ...lunch, title: "Dinner" })
    const inserts = google.calls.filter((call) => call.method === "POST" && call.path.endsWith("/events")).length
    google.switches.dropNextReply = true
    const dropped = try create("coffee-key-0001", { title: "Coffee", startAt: "2026-12-01T15:00:00Z", endAt: "2026-12-01T15:30:00Z" })
    const changedAccount = try create("tea-key-00000001", { ...lunch, title: "Tea", expectedAccountId: "subject-elsewhere" })
    const created = (first.body as { readonly event: { readonly externalId: string; readonly etag: string; readonly title: string } }).event
    const eventPath = `${calendarBase}/events/${created.externalId}`
    const patch = (etag: string | undefined, json: unknown) => cloud.call(eventPath, { method: "PATCH", headers: etag === undefined ? headers : { ...headers, "if-match": etag }, json })
    const noRevision = try patch(undefined, { title: "Long lunch" })
    const changed = try patch(created.etag, { title: "Long lunch" })
    const stale = try patch(created.etag, { title: "Late lunch" })
    const current = (changed.body as { readonly event: { readonly etag: string; readonly title: string } }).event
    const staleDelete = try cloud.call(eventPath, { method: "DELETE", headers: { ...headers, "if-match": created.etag } })
    const deleted = try cloud.call(eventPath, { method: "DELETE", headers: { ...headers, "if-match": current.etag } })
    const rows = try sql(cloud, "SELECT kind, phase FROM calendar_writes ORDER BY kind, phase", [])
    try check(() => assert.deepStrictEqual(
      {
        unkeyed: [unkeyed.status, calendarRefusal(unkeyed.body)],
        once: [first.status, created.title, again.status, (again.body as { readonly event: { readonly externalId: string } }).event.externalId === created.externalId, inserts],
        other: [other.status, calendarRefusal(other.body)],
        dropped: [dropped.status, (dropped.body as { readonly event: { readonly title: string } }).event.title],
        changedAccount: [changedAccount.status, calendarRefusal(changedAccount.body)],
        noRevision: [noRevision.status, calendarRefusal(noRevision.body)],
        changed: [changed.status, current.title, current.etag !== created.etag, changed.headers.etag === current.etag],
        stale: [stale.status, calendarRefusal(stale.body)],
        staleDelete: [staleDelete.status, calendarRefusal(staleDelete.body)],
        deleted: [deleted.status, deleted.body, google.events.has(`own@example.com/${created.externalId}`)],
        rows: rows.map((row) => [row.kind, row.phase])
      },
      {
        unkeyed: [400, ["invalid_request", undefined, "not_accepted"]],
        once: [201, "Lunch", 201, true, 1],
        other: [409, ["idempotency_conflict", undefined, "not_accepted"]],
        dropped: [201, "Coffee"],
        changedAccount: [403, ["access_denied", "google_account_changed", "not_accepted"]],
        noRevision: [400, ["invalid_request", undefined, "not_accepted"]],
        changed: [200, "Long lunch", true, true],
        stale: [412, ["precondition_failed", undefined, "not_accepted"]],
        staleDelete: [412, ["precondition_failed", undefined, "not_accepted"]],
        deleted: [200, { ok: true }, false],
        rows: [["change", "rejected"], ["change", "succeeded"], ["create", "succeeded"], ["create", "succeeded"], ["delete", "rejected"], ["delete", "succeeded"]]
      }
    ))
  }), 30_000)
})
describe("WP9 Client library (spec/cloud/client.md, \"Story: Use the cloud from the device as configured\")", () => {
  const unknownKey = `eliza_mobile_${"0".repeat(64)}`

  function serverClass(auth: AuthClass): RouteClass {
    switch (auth) {
      case "Public": return "Public"
      case "KeyOrSession": return "ServiceAccess"
      case "Session": return "SignedSession"
      case "FreshSession": return "FreshSession"
      case "StepUp": return "StepUp"
    }
  }

  function patternOf(route: DeviceRoute): string {
    return route.path.map((segment) => `/${segment.tag === "Param" ? `:${segment.name}` : segment.text}`).join("")
  }

  function clientOf(baseUrl: string, credential: () => string): CloudClient {
    return createCloudClient({ baseUrl, credential, fetch: (input, init) => fetch(input, init) })
  }

  effect function failureOf(run: () => Promise<unknown>) {
    return try promise(() => run().then(() => "succeeded", (error: unknown) => error instanceof CloudError ? error.failure : `threw ${String(error)}`))
  }

  effect function refusingServer(cloud: TestCloud, refusals: ReadonlyArray<Refused>) {
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    let next = 0
    const models: Route = {
      method: "GET",
      path: "/api/v1/models",
      auth: "Public",
      handler: () => effect {
        const refusal = refusals[next] ?? refused("NotFound")
        next += 1
        throw refusal
      }
    }
    const built = try Layer.build(HttpServer.serve(respond([models])).pipe(
      Layer.provideMerge(listening(0, "127.0.0.1")),
      Layer.provide(Layer.mergeAll(deploymentLayer(profile, "staging"), Layer.succeed(Store, cloud.store), FetchHttpClient.layer))
    ))
    const { address } = Context.get(built, HttpServer.HttpServer)
    return "port" in address ? `http://127.0.0.1:${address.port}` : ""
  }

  it.live("Read every refusal as one CloudError and leave the credential to its holder (spec/cloud/client.md, \"Every refusal reads as one CloudError and none touches the credential\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const live = try entitledDevice(cloud, "custody", now)
    const expiring = try entitledDevice(cloud, "expiring", now)
    const ended = try entitledDevice(cloud, "ended", now)
    try sql(cloud, "UPDATE device_grants SET key_expires_at = $2, state = jsonb_set(state, '{keyExpiresAt}', to_jsonb($2::bigint)) WHERE credential_id = $1", ["cred-expiring", now - 1])
    try cloud.store.transaction((tx) => revokeAll(tx, "user-ended", now))
    let held = unknownKey
    const read: Array<string> = []
    const client = clientOf(cloud.url, () => {
      read.push(held)
      return held
    })
    const unknown = try failureOf(() => client.account())
    held = expiring
    const expired = try failureOf(() => client.account())
    held = ended
    const revoked = try failureOf(() => client.account())
    held = live
    const kept = try failureOf(() => client.account())

    const resetsAt = now + 3_600_000
    const retryAt = now + 60_000
    const backAt = now + 30_000
    const probe = try refusingServer(cloud, [refused("InsufficientCredits"), refused("AllowanceExhausted", "NoReason", resetsAt), refused("RateLimited", "NoReason", retryAt), refused("ServiceUnavailable", "NoReason", backAt)])
    const refusing = clientOf(probe, () => live)
    const answers = [
      try failureOf(() => refusing.models()),
      try failureOf(() => refusing.models()),
      try failureOf(() => refusing.models()),
      try failureOf(() => refusing.models())
    ]
    try check(() => assert.deepStrictEqual(
      { unknown, expired, revoked, kept, answers, read, held },
      {
        unknown: { tag: "CloudCredentialInvalid", reason: "CredentialUnknown" },
        expired: { tag: "CloudCredentialInvalid", reason: "CredentialExpired" },
        revoked: { tag: "CloudCredentialInvalid", reason: "CredentialRevoked" },
        kept: "succeeded",
        answers: [
          { tag: "CloudInsufficientCredits" },
          { tag: "CloudAllowanceExhausted", resetsAt },
          { tag: "CloudRateLimited", retryAt },
          { tag: "CloudUnavailable", retryAfter: backAt }
        ],
        read: [unknownKey, expiring, ended, live],
        held: live
      }
    ))
  }))

  it.live("Send the credential the getter holds now, with the same client (spec/cloud/client.md, \"Every call reads the credential when it is sent\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const first = try entitledDevice(cloud, "first", now)
    const second = try entitledDevice(cloud, "second", now)
    let held = first
    const client = clientOf(cloud.url, () => held)
    const before = try promise(() => client.account())
    const models = try promise(() => client.models())
    held = second
    const after = try promise(() => client.account())
    held = unknownKey
    const replaced = try failureOf(() => client.models())
    try check(() => assert.deepStrictEqual(
      { before: before.id, after: after.id, models: models.data.map((model) => model.id), replaced },
      { before: "user-first", after: "user-second", models: ["test-chat"], replaced: { tag: "CloudCredentialInvalid", reason: "CredentialUnknown" } }
    ))
  }))

  it.live("Tell an unfunded account it cannot be used until it is funded (spec/cloud/client.md, \"An account is usable when it is active, funded and its lane is open\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const token = try entitledDevice(cloud, "unfunded", now)
    const client = clientOf(cloud.url, () => token)
    const unfunded = try promise(() => client.snapshot())
    provide Store = cloud.store {
      try addCredits({ organizationId: "org-unfunded", amount: 5_000_000, requestKey: "wp9-funding" })
    }
    const funded = try promise(() => client.snapshot())
    try check(() => assert.deepStrictEqual(
      { unfunded: [accountUsable(unfunded), creditFromSnapshot(unfunded, unfunded.observedAt).kind], funded: [accountUsable(funded), creditFromSnapshot(funded, funded.observedAt).kind] },
      { unfunded: [false, "zero"], funded: [true, "funded"] }
    ))
  }))

  it.live("Verify an entitlement the service signed and refuse it for another audience (spec/cloud/billing/entitlements.md, \"Story: Read my plan without substituting another account or source\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const token = try entitledDevice(cloud, "verified", now)
    const bearer = { headers: { authorization: `Bearer ${token}` } }
    const published = try cloud.call("/api/v1/subscription/entitlement-keys")
    const answer = try cloud.call("/api/v1/subscription/entitlement", bearer)
    const signed = (answer.body as { readonly entitlement: string }).entitlement
    const expected = { keys: parseEntitlementKeys(published.body) ?? [], issuer: "https://api.staging.example.com", audience: "cloud-subscription", now }
    const checked = try promise(() => checkEntitlement(signed, expected))
    const otherAudience = try promise(() => verifyOnDevice(signed, { ...expected, audience: "another-service" }).then(() => "verified", (error: unknown) => error instanceof EntitlementInvalid ? error.check : `threw ${String(error)}`))
    try check(() => assert.deepStrictEqual(
      { user: checked.userId, organization: checked.organizationId, plan: checked.plan, lifetime: checked.expiresAt - checked.issuedAt, otherAudience },
      { user: "user-verified", organization: "org-verified", plan: { id: "free", name: "Free", status: "none" }, lifetime: 1_800_000, otherAudience: "WrongAudience" }
    ))
  }))

  it.live("Every route a device sends is one the service serves, with the same credential class (spec/cloud/client.md, \"A device sends only the routes of one table, each with its own headers\")", () => effect {
    const served = areas.flatMap((area) => area.routes)
    const mismatched = deviceRoutes.flatMap((route) => {
      const pattern = patternOf(route)
      const found = matchRoute(served, httpVerb(route.method), pattern)
      const same = found.kind === "route" && found.route.path === pattern && found.route.auth === serverClass(route.auth)
      return same ? [] : [`${httpVerb(route.method)} ${pattern} ${route.auth}: ${found.kind === "route" ? `${found.route.path} ${found.route.auth}` : found.kind}`]
    })
    try check(() => assert.deepStrictEqual({ unlisted: unlistedRoutes, mismatched }, { unlisted: [], mismatched: [] }))
  })
})
import { claimDue, sweepDeletions } from "../src/identity/deletion.vibe"
import { deletionProviders } from "./support/fakes/deletion.ts"
import { shiftedClock } from "./support/clock.ts"

describe("WP10 Operator and deletion (spec/cloud/identity/deletion.md, \"Story: Delete an account once the person asked support\")", () => {
  it.live("Fund an active account, list and revoke a lost device, and refuse every command on another or an unreadable database (spec/cloud/operator.md, \"Story: Operate the deployment without reading secrets\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try openAccount(cloud, { userId: "user-operated", organizationId: "org-operated" })
    const shown = (result: { readonly exit: Exit.Exit<unknown, unknown>; readonly out: ReadonlyArray<string>; readonly err: ReadonlyArray<string> }) =>
      [Exit.isSuccess(result.exit), result.out, result.err.map((line) => /"error":"([a-z_]+)"/.exec(line)?.[1])]
    const credits = ["credits", "add", "--organization", "org-operated", "--amount", "5000000", "--request", "pilot-1"]
    const added = try printed(operator(cloud, credits))
    const replayed = try printed(operator(cloud, credits))
    const missing = try printed(operator(cloud, ["credits", "add", "--organization", "org-missing", "--amount", "1", "--request", "pilot-2"]))
    const device = { deviceName: "Lost phone", createdAt: now - 1000, expiresAt: now + 86_400_000 }
    const key = try deviceKey(cloud, "user-operated", device)
    const entitlement = effect () => (try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${key}` } }))
    const before = try entitlement()
    const listed = try printed(operator(cloud, ["account", "devices", "--user", "user-operated"]))
    const revoked = try printed(operator(cloud, ["account", "revoke-devices", "--user", "user-operated"]))
    const after = try entitlement()
    const listedAfter = try printed(operator(cloud, ["account", "devices", "--user", "user-operated"]))
    const otherDatabase = try printed(operator(cloud, [...credits.slice(0, -1), "pilot-3"], {
      edit: (profile) => ({ ...profile, environments: { ...profile.environments, staging: { ...profile.environments.staging, databaseIdentity: "c".repeat(64) } } })
    }))
    try sql(cloud, "DELETE FROM cloud_identity", [])
    const unreadable = try printed(operator(cloud, [...credits.slice(0, -1), "pilot-4"]))
    const balance = try sql(cloud, "SELECT count(*)::int AS entries FROM credit_entries WHERE organization_id = 'org-operated' AND kind = 'add'", [])
    const body = after.body as { readonly error?: string; readonly reason?: string }
    try check(() => assert.deepStrictEqual(
      {
        added: shown(added), replayed: shown(replayed), missing: shown(missing),
        before: before.status, listed: shown(listed), revoked: shown(revoked), after: [after.status, body.error, body.reason], listedAfter: shown(listedAfter),
        otherDatabase: shown(otherDatabase), unreadable: shown(unreadable), entries: balance[0]?.entries
      },
      {
        added: [true, ["organization org-operated: 5000000 µUSD added, balance 5000000 µUSD"], []],
        replayed: [true, ["organization org-operated: credits already added by this request, balance 5000000 µUSD"], []],
        missing: [false, [], ["not_found"]],
        before: 200,
        listed: [true, [JSON.stringify(device)], []],
        revoked: [true, ["user user-operated: 1 device keys ended, every session ended"], []],
        after: [401, "authentication_required", "credential_revoked"],
        listedAfter: [true, [], []],
        otherDatabase: [false, [], ["precondition_failed"]],
        unreadable: [false, [], ["service_unavailable"]],
        entries: 1
      }
    ))
  }), 30_000)
  it.live("Delete an account the person asked support to delete: fence it at once, cancel billing and revoke Google once though both replies are lost, retry a phase after a crashed sweep's claim expires, and erase the person (spec/cloud/identity/deletion.md, \"Story: Delete an account once the person asked support\"; spec/cloud/operator.md, \"An account deletion starts only for an active account, after the operator confirmed the request with its owner\")", () => scoped(effect {
    const providers = try Effect.try(() => deletionProviders())
    const cloud = try testCloud({ stripe: providers.stripe, mount: (fakes) => { providers.mount(fakes) } })
    const now = try Clock.currentTimeMillis
    const owner = { userId: "user-leaving", organizationId: "org-leaving" }
    try openAccount(cloud, owner)
    const subscribed = try Effect.try(() => providers.subscribe(catalogPrices[0].priceId))
    const subscription: Subscription = {
      ...noSubscription, status: "Active", subscriptionId: subscribed.subscriptionId, customer: { tag: "PinnedCustomer", customerId: subscribed.customerId },
      planKey: "PlusMonthly", periodStart: now - 60_000, periodEnd: now + 30 * 86_400_000, revision: 4
    }
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, provider_subscription_id, period_end, updated_at) VALUES ($1, $2, 4, 'active', 'plus_monthly', $3, $4, $5, $6)", [
      owner.organizationId, JSON.stringify(subscription), subscribed.customerId, subscribed.subscriptionId, subscription.periodEnd, now
    ])
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage")]
    const refreshToken = try Effect.try(() => providers.grant("subject-conn-leaving"))
    try cloud.inside(linkedGrant(cloud, owner, "conn-leaving", refreshToken, scopes, now - 1000))
    const key = try deviceKey(cloud, owner.userId, { deviceName: "Phone", createdAt: now - 1000, expiresAt: now + 86_400_000 })
    const entitlement = effect () => {
      const answer = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${key}` } })
      return [answer.status, (answer.body as { readonly reason?: string }).reason]
    }
    const shown = (result: { readonly exit: Exit.Exit<unknown, unknown>; readonly out: ReadonlyArray<string>; readonly err: ReadonlyArray<string> }) =>
      [Exit.isSuccess(result.exit), result.out, result.err.map((line) => /"error":"([a-z_]+)"/.exec(line)?.[1])]
    const remove = ["account", "delete", "--user", owner.userId]
    const funded = try printed(operator(cloud, ["credits", "add", "--organization", owner.organizationId, "--amount", "1000000", "--request", "pilot-leaving"]))
    const before = try entitlement()
    const unconfirmed = try printed(operator(cloud, remove))
    const requested = try printed(operator(cloud, [...remove, "--confirmed-with-owner"]))
    const fenced = try entitlement()
    const status = effect () => (try sql(cloud, "SELECT status, email, phone, name FROM accounts WHERE key = $1", [owner.userId]))[0]
    const closing = try status()
    const later = try sync(() => shiftedClock())
    const sweep = () => provideService(cloud.inside(sweepDeletions()), Clock.Clock, later.clock)
    try Effect.try(() => providers.loseNextCancelReply(subscribed.subscriptionId))
    const billing = try sweep()
    const phase = effect () => (try sql(cloud, "SELECT phase, step, attempts FROM deletion_requests WHERE key = $1", [owner.userId]))[0]
    const afterBilling = try phase()
    try cloud.inside(claimDue(try later.clock.currentTimeMillis))
    const whileClaimed = try sweep()
    try Effect.try(() => later.advance(10 * 60_000 + 1))
    try Effect.try(() => providers.loseNextRevokeReply())
    const google = try sweep()
    const afterGoogle = try phase()
    const erasing = try sweep()
    const idle = try sweep()
    const again = try printed(operator(cloud, [...remove, "--confirmed-with-owner"]))
    const erased = try status()
    const left = try sql(cloud, "SELECT (SELECT count(*) FROM sessions WHERE user_id = $1)::int AS sessions, (SELECT count(*) FROM device_grants WHERE user_id = $1)::int AS devices, (SELECT count(*) FROM google_connections WHERE user_id = $1)::int AS google, (SELECT count(*) FROM cloud_sign_in_identities WHERE account_id = $1)::int AS identities, (SELECT count(*) FROM credit_entries WHERE organization_id = $2)::int AS ledger", [owner.userId, owner.organizationId])
    const outside = try Effect.try(() => ({
      stripe: [providers.subscriptionStatus(subscribed.subscriptionId), providers.cancelCalls(cloud.fakes, subscribed.subscriptionId)],
      google: [providers.revoked(refreshToken), providers.revokeCalls()]
    }))
    try check(() => assert.deepStrictEqual(
      {
        funded: Exit.isSuccess(funded.exit), before, unconfirmed: shown(unconfirmed), requested: shown(requested), fenced, closing: closing?.status,
        sweeps: [billing, whileClaimed, google, erasing, idle], afterBilling, afterGoogle,
        ...outside, erased, left: left[0],
        again: shown(again)
      },
      {
        funded: true, before: [200, undefined], unconfirmed: [false, [], ["invalid_request"]],
        requested: [true, ["user user-leaving: every session and device key ended; deletion running at cancel_billing, 0 of 12 attempts, no provider call"], []],
        fenced: [401, "credential_revoked"], closing: "deleting",
        sweeps: [1, 0, 1, 1, 0], afterBilling: { phase: "running", step: "revoke_google", attempts: 0 }, afterGoogle: { phase: "running", step: "erase_data", attempts: 0 },
        stripe: ["canceled", 1], google: [true, 1],
        erased: { status: "erased", email: null, phone: null, name: null },
        left: { sessions: 0, devices: 0, google: 0, identities: 0, ledger: 1 },
        again: [true, ["user user-leaving: already requested; deletion erased at erase_data, 0 of 12 attempts, no provider call"], []]
      }
    ))
  }), 60_000)
})
describe("WP10 Operator and deletion: clients (spec/cloud/operator.md)", () => {
  it.live("Register, update and disable a native client from the operator command line (spec/cloud/operator.md, \"Story: Operate the deployment without reading secrets\"; spec/cloud/nativeClients/registry.md, \"A registration is accepted only when the registry stays valid and no return lies on the API origin, and it never changes how another client is admitted\")", () => scoped(effect {
    const cloud = try testCloud()
    const fingerprint = "E3:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"
    const rotated = "A1:DC:37:EF:3F:94:F0:CB:F5:06:F2:6E:CD:F7:99:99:29:C2:B2:D0:53:D1:63:83:56:91:F7:C9:67:F6:7E:A5"
    const web = "https://www.staging.example.com"
    const flagsOf = (name: string) => [
      "--client-id", `com.example.${name}`, "--display-name", name, "--android-package", `com.example.${name}`, "--cert", fingerprint,
      "--sign-in-return", `${web}/apps/${name}/sign-in`, "--billing-return", `${web}/apps/${name}/billing`, "--credential-ttl-days", "7"
    ]
    const config = (name: string) => cloud.call(`/api/v1/app-auth/mobile/config?${new URLSearchParams({ clientId: `com.example.${name}`, environment: "staging", redirectUri: `${web}/apps/${name}/sign-in` }).toString()}`)
    const run = (args: ReadonlyArray<string>) => failureTag(operator(cloud, args))
    const answers = [
      try run(["client", "register", ...flagsOf("one"), "--native-google"]),
      try run(["client", "register", ...flagsOf("two")]),
      try run(["client", "register", ...flagsOf("five"), "--cert", fingerprint, "--cert", fingerprint, "--cert", fingerprint, "--cert", fingerprint]),
      try run(["client", "register", ...flagsOf("api"), "--sign-in-return", "https://api.staging.example.com/apps/api"]),
      try run(["client", "register", "--client-id", "com.example.bare"]),
      try run(["client", "update", "--client-id", "com.example.two", "--display-name", "Two", "--cert", fingerprint, "--cert", rotated]),
      try run(["client", "update", "--client-id", "com.example.nobody", "--display-name", "Nobody"])
    ]
    const one = try config("one")
    const twoBefore = try config("two")
    const linksBefore = try cloud.call("/.well-known/assetlinks.json")
    const disabled = try run(["client", "disable", "--client-id", "com.example.two"])
    const twoAfter = try config("two")
    const oneAfter = try config("one")
    const linksAfter = try cloud.call("/.well-known/assetlinks.json")
    const links = (body: unknown) => (body as ReadonlyArray<{ readonly target: { readonly package_name: string; readonly sha256_cert_fingerprints: ReadonlyArray<string> } }>).map((statement) => [statement.target.package_name, statement.target.sha256_cert_fingerprints.length])
    try check(() => assert.deepStrictEqual(
      {
        answers,
        one: [one.status, (one.body as { readonly credentialTtlMs?: number }).credentialTtlMs],
        twoBefore: twoBefore.status,
        linksBefore: links(linksBefore.body),
        disabled,
        twoAfter: [twoAfter.status, (twoAfter.body as { readonly error?: string }).error],
        oneAfter: [oneAfter.status, oneAfter.body],
        linksAfter: links(linksAfter.body)
      },
      {
        answers: [
          'succeeded with {"kind":"done","lines":["registered com.example.one (staging)"]}',
          'succeeded with {"kind":"done","lines":["registered com.example.two (staging)"]}',
          "RegistrationInvalid", "RegistrationRefused", "ClientFlagsInvalid",
          'succeeded with {"kind":"done","lines":["updated com.example.two (staging)"]}',
          "ClientUnknown"
        ],
        one: [200, 7 * 86_400_000],
        twoBefore: 200,
        linksBefore: [["com.example.one", 1], ["com.example.two", 2]],
        disabled: 'succeeded with {"kind":"done","lines":["disabled com.example.two"]}',
        twoAfter: [403, "client_disabled"],
        oneAfter: [one.status, one.body],
        linksAfter: [["com.example.one", 1]]
      }
    ))
  }))
})
describe("WP10 Operator and deletion: prices (spec/cloud/operator.md)", () => {
  it.live("Price an offered model from the operator command line so its calls are admitted, and check prices and catalog (spec/cloud/operator.md, \"Story: Operate the deployment without reading secrets\"; spec/cloud/services/models.md, \"Story: Price a model call before it runs\")", () => scoped(effect {
    const cloud = try testCloud()
    const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
    const settings = profile.environments.staging.inference
    if (settings === undefined) throw new Error("the test profile offers no inference")
    const caller = try signedCaller(cloud, "pricer")
    const run = (args: ReadonlyArray<string>) => failureTag(operator(cloud, args))
    const admission = cloud.store.transaction((tx) => chooseFor(tx, settings, "test-chat", false)).pipe(
      Effect.map((chosen) => `admitted ${chosen.model.id} at ${chosen.model.inputPer1K}/${chosen.model.outputPer1K} via ${chosen.provider.id}`),
      Effect.catchTag("Refused", (error) => Effect.succeed(refusalBody(error.refusal).error))
    )
    const listed = effect () => {
      const answer = try cloud.call("/api/v1/models", { headers: caller.headers })
      return [answer.status, (answer.body as { readonly data: ReadonlyArray<{ readonly id: string }> }).data.map((model) => model.id)]
    }
    const checkBefore = try run(["prices", "check"])
    const admittedBefore = try admission
    const listedBefore = try listed()
    const refusedSets = [
      try run(["prices", "set", "--model", "unoffered", "--input-per-1k", "100", "--output-per-1k", "200"]),
      try run(["prices", "set", "--model", "test-chat", "--input-per-1k", "1.5", "--output-per-1k", "200"]),
      try run(["prices", "set", "--model", "test-chat", "--output-per-1k", "200"])
    ]
    const set = try run(["prices", "set", "--model", "test-chat", "--input-per-1k", "150", "--output-per-1k", "600"])
    const admittedAfter = try admission
    const listedAfter = try listed()
    const checkAfter = try run(["prices", "check"])
    try check(() => assert.deepStrictEqual(
      { checkBefore, admittedBefore, listedBefore, refusedSets, set, admittedAfter, listedAfter, checkAfter },
      {
        checkBefore: "PricesMismatched",
        admittedBefore: "model_unavailable",
        listedBefore: [200, []],
        refusedSets: ["Refused", "PriceFlagsInvalid", "PriceFlagsInvalid"],
        set: 'succeeded with {"kind":"done","lines":["priced test-chat: input 150, output 600 µUSD per 1,000 tokens"]}',
        admittedAfter: "admitted test-chat at 150/600 via llm",
        listedAfter: [200, ["test-chat"]],
        checkAfter: 'succeeded with {"kind":"done","lines":["0 price mismatches; usable models: test-chat","payment catalog verified"]}'
      }
    ))
  }))
})

effect function entitledDevice(cloud: TestCloud, name: string, now: number) {
  const token = `eliza_mobile_${tokenDigest(name)}`
  try organization(cloud, `org-${name}`)
  try sql(cloud, "INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'active', $3, $4, $4)", [`user-${name}`, `org-${name}`, `${name}@example.com`, now])
  try sql(cloud, "INSERT INTO device_grants (key, state, revision, user_id, client_id, phase, credential_id, secret_digest, code_expires_at, key_expires_at, issued_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'test-client', 'active', $3, $4, $5, $6, $5, $5)", [
    `grant-${name}`, `user-${name}`, `cred-${name}`, tokenDigest(token), now - 1000, now + 24 * 3_600_000
  ])
  return token
}

effect function entitlementClaims(cloud: TestCloud, token: string, keys: ReadonlyArray<PublishedKey>) {
  const answer = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${token}` } })
  const now = try Clock.currentTimeMillis
  const verified = try promise(() => answer.status !== 200 ? Promise.reject(new Error(`entitlement answered ${answer.status}`)) : verifyEntitlement((answer.body as { readonly entitlement: string }).entitlement, keys, { issuer: "https://api.staging.example.com", audience: "cloud-subscription", nowSeconds: Math.floor(now / 1000) }))
  const claims = verified.claims
  return { status: answer.status, kid: verified.header.kid, plan: claims.plan, planEndsAt: claims.plan_ends_at, allowance: claims.plan_allowance, ver: claims.ver, sub: claims.sub, org: claims.org, services: claims.services, lifetime: Number(claims.exp) - Number(claims.iat), exp: claims.exp }
}

describe("WP4 Subscriptions and entitlements: entitlement", () => {
  it.live("Read my plan from a signed entitlement, a grant giving way to a paid plan (spec/cloud/billing/entitlements.md, \"Story: Read my plan without substituting another account or source\"; spec/cloud/billing/subscriptions.md, \"Story: Keep my plan as the provider says it is\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const token = try entitledDevice(cloud, "entitled", now)
    const published = try cloud.call("/api/v1/subscription/entitlement-keys")
    const keys = (published.body as { readonly keys: ReadonlyArray<PublishedKey> }).keys
    const anonymous = try cloud.call("/api/v1/subscription/entitlement")
    const free = try entitlementClaims(cloud, token, keys)

    const grantEnds = now + 10 * 60_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-1', 'org-entitled', 'pilot', 'plus_monthly', $1, $2, $1)", [now - 1000, grantEnds])
    const granted = try entitlementClaims(cloud, token, keys)

    const periodEnd = now + 30 * 24 * 3_600_000
    const resetsAt = now + 20 * 60_000
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, period_end, updated_at) VALUES ('org-entitled', '{}'::jsonb, 1, 'active', 'pro_monthly', $1, $2)", [periodEnd, now])
    try cloud.store.transaction((tx) => stepRow(tx, periodRows, "renewal/staging/in_1", { type: "openRenewal", invoiceId: "in_1", planKey: "ProMonthly", startsAt: now - 1000, endsAt: resetsAt }, () => ({
      organization_id: "org-entitled", status: "open", period_start: now - 1000, period_end: resetsAt, updated_at: now
    })))
    const paid = try entitlementClaims(cloud, token, keys)
    try sql(cloud, "UPDATE subscriptions SET status = 'past_due' WHERE key = 'org-entitled'", [])
    const pastDue = try entitlementClaims(cloud, token, keys)
    try sql(cloud, "UPDATE subscriptions SET plan_key = 'gold' WHERE key = 'org-entitled'", [])
    const unreadable = try cloud.call("/api/v1/subscription/entitlement", { headers: { authorization: `Bearer ${token}` } })

    const seconds = (millis: number) => Math.floor(millis / 1000)
    try check(() => assert.deepStrictEqual(
      {
        published: [published.status, published.headers["cache-control"], keys.length, keys.map((key) => [key.kid, key.kty, key.crv])],
        anonymous: [anonymous.status, (anonymous.body as { readonly error: string }).error],
        free,
        granted: [granted.plan, granted.planEndsAt, granted.exp, granted.allowance],
        paid: [paid.plan, paid.planEndsAt, paid.exp, paid.allowance],
        pastDue: pastDue.plan,
        unreadable: [unreadable.status, (unreadable.body as { readonly error: string }).error]
      },
      {
        published: [200, "public, max-age=60", 1, [["entitlement-1", "EC", "P-256"]]],
        anonymous: [401, "authentication_required"],
        free: { status: 200, kid: "entitlement-1", plan: { id: "free", name: "Free", status: "none" }, planEndsAt: null, allowance: null, ver: 3, sub: "user-entitled", org: "org-entitled", services: ["inference", "speech", "maps"], lifetime: 1800, exp: free.exp },
        granted: [{ id: "plus_monthly", name: "Plus", status: "active" }, seconds(grantEnds), seconds(grantEnds), null],
        paid: [{ id: "pro_monthly", name: "Pro", status: "active" }, seconds(periodEnd), seconds(resetsAt), { unit: "usd_micros", granted: 90_000_000, remaining: 90_000_000, periodStart: seconds(now - 1000), resetsAt: seconds(resetsAt) }],
        pastDue: { id: "pro_monthly", name: "Pro", status: "past_due" },
        unreadable: [503, "service_unavailable"]
      }
    ))
  }))
})

import { initial as noSubscription, type Subscription } from "../gen/cloud__billing__subscriptions.ts"
import type { BillingSnapshot } from "../src/billing/snapshot.vibe"
import type { InvoiceDetail, InvoicePage } from "../src/billing/invoices.vibe"
import { createStripeInvoicesFake } from "./support/fakes/stripe-invoices.ts"

effect function subscribedTo(cloud: TestCloud, organizationId: string, customerId: string, now: number) {
  const state: Subscription = {
    ...noSubscription, status: "Active", subscriptionId: `sub_${organizationId}`, customer: { tag: "PinnedCustomer", customerId },
    planKey: "PlusMonthly", periodStart: now - 60_000, periodEnd: now + 30 * 24 * 3_600_000, revision: 4
  }
  try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, provider_subscription_id, period_end, updated_at) VALUES ($1, $2, 4, 'active', 'plus_monthly', $3, $4, $5, $6)", [
    organizationId, JSON.stringify(state), customerId, state.subscriptionId, state.periodEnd, now
  ])
  return state
}

effect function limitsOf(cloud: TestCloud, headers: Readonly<Record<string, string>>) {
  const answer = try cloud.call("/api/v1/billing/limits", { headers })
  return { status: answer.status, snapshot: (answer.body as { readonly data: BillingSnapshot }).data, error: (answer.body as { readonly error?: string }).error }
}

describe("WP4 Subscriptions and entitlements: snapshot and invoices", () => {
  it.live("Read my billing state in one snapshot as a free, granted and paid account, or a whole 503 (spec/cloud/billing/subscriptions.md, \"Story: Keep my plan as the provider says it is\"; spec/cloud/billing/subscriptions.md, \"Story: Change my plan one command at a time\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "snapshot@example.com")
    const organizationId = signed.organizationId
    const headers = { authorization: `Bearer ${signed.accessToken}` }
    const anonymous = try cloud.call("/api/v1/billing/limits")
    const free = try limitsOf(cloud, headers)

    provide Store = cloud.store {
      try addCredits({ organizationId, amount: 2_000_000, requestKey: "snapshot-credits" })
    }
    const grantEnds = now + 10 * 60_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-snapshot', $1, 'pilot', 'plus_monthly', $2, $3, $2)", [organizationId, now - 1000, grantEnds])
    const granted = try limitsOf(cloud, headers)

    const subscription = try subscribedTo(cloud, organizationId, "cus_snapshot", now)
    const resetsAt = now + 20 * 60_000
    try cloud.store.transaction((tx) => stepRow(tx, periodRows, "renewal/staging/in_snapshot", { type: "openRenewal", invoiceId: "in_snapshot", planKey: "PlusMonthly", startsAt: now - 1000, endsAt: resetsAt }, () => ({
      organization_id: organizationId, status: "open", period_start: now - 1000, period_end: resetsAt, updated_at: now
    })))
    const paid = try limitsOf(cloud, headers)
    try sql(cloud, "UPDATE subscriptions SET state = '{\"status\":\"Gold\"}'::jsonb WHERE key = $1", [organizationId])
    const unreadable = try limitsOf(cloud, headers)

    const grant = { id: "grant-snapshot", planKey: "plus_monthly", family: "pilot", effectiveFrom: now - 1000, effectiveUntil: grantEnds, revoked: false }
    try check(() => assert.deepStrictEqual(
      {
        anonymous: [anonymous.status, (anonymous.body as { readonly error: string }).error],
        free: [free.status, free.snapshot.observedAt >= now, { ...free.snapshot, observedAt: 0, balance: { ...free.snapshot.balance, revision: 0 } }, accountUsable(free.snapshot)],
        granted: [granted.status, granted.snapshot.balance.usdMicros, granted.snapshot.balance.revision > free.snapshot.balance.revision, granted.snapshot.plan, granted.snapshot.grant, granted.snapshot.subscription, granted.snapshot.funding],
        paid: [paid.status, paid.snapshot.plan, paid.snapshot.subscription, paid.snapshot.grant, paid.snapshot.allowance, paid.snapshot.funding, accountUsable(paid.snapshot)],
        unreadable: [unreadable.status, unreadable.error]
      },
      {
        anonymous: [401, "authentication_required"],
        free: [200, true, {
          schemaVersion: 3, observedAt: 0, account: { status: "active" }, balance: { usdMicros: 0, revision: 0 },
          plan: { key: "free", source: "free", effectiveUntil: null }, subscription: null, grant: null, allowance: null,
          funding: { inference: "creditsOnly", speech: "creditsOnly", maps: "creditsOnly" }
        }, false],
        granted: [200, 2_000_000, true, { key: "plus_monthly", source: "grant", effectiveUntil: grantEnds }, grant, null, { inference: "allowanceThenCredits", speech: "allowanceThenCredits", maps: "allowanceThenCredits" }],
        paid: [200, { key: "plus_monthly", source: "subscription", effectiveUntil: subscription.periodEnd }, {
          id: subscription.subscriptionId, planKey: "plus_monthly", status: "active", periodStart: subscription.periodStart, periodEnd: subscription.periodEnd,
          cancelAtPeriodEnd: false, pendingPlanKey: null, dunningEndsAt: null, revision: 4,
          control: { action: "cancel", eligible: true, expectedSubscriptionRevision: 4 }
        }, grant, {
          state: "open", granted: 25_000_000, adjustment: 0, available: 25_000_000, reserved: 0, settled: 0, expired: 0, clawedBack: 0, periodStart: now - 1000, resetsAt
        }, { inference: "allowanceThenCredits", speech: "allowanceThenCredits", maps: "allowanceThenCredits" }, true],
        unreadable: [503, "service_unavailable"]
      }
    ))
  }))

  it.live("Read only my pinned customer's invoices, a page at a time (spec/cloud/billing/subscriptions.md, \"Story: Read my invoices and open the billing portal\")", () => scoped(effect {
    const stripe = try sync(() => createStripeInvoicesFake())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/stripe/", stripe.handler) })
    const now = try Clock.currentTimeMillis
    const own = try signedIn(cloud, "invoices@example.com")
    const other = try signedIn(cloud, "other-invoices@example.com")
    const unpinned = try signedIn(cloud, "unpinned@example.com")
    try subscribedTo(cloud, own.organizationId, "cus_own", now)
    try subscribedTo(cloud, other.organizationId, "cus_other", now)
    const day = 86_400
    const at = Math.floor(now / 1000) - 60 * day
    const ids = try sync(() => ({
      first: stripe.invoice({ customer: "cus_own", amountCents: 3_000, periodStart: at, periodEnd: at + 30 * day, lines: 12 }),
      second: stripe.invoice({ customer: "cus_own", amountCents: 3_000, status: "open", periodStart: at + 30 * day, periodEnd: at + 60 * day }),
      draft: stripe.invoice({ customer: "cus_own", amountCents: 3_000, status: "draft", periodStart: at + 60 * day, periodEnd: at + 90 * day }),
      foreign: stripe.invoice({ customer: "cus_other", amountCents: 10_000, periodStart: at, periodEnd: at + 30 * day })
    }))
    const as = (signed: { readonly accessToken: string }) => ({ headers: { authorization: `Bearer ${signed.accessToken}` } })
    const firstPage = try cloud.call("/api/v1/billing/invoices?limit=2", as(own))
    const nextPage = try cloud.call(`/api/v1/billing/invoices?limit=2&cursor=${ids.second}`, as(own))
    const detail = try cloud.call(`/api/v1/billing/invoices/${ids.first}`, as(own))
    const foreign = try cloud.call(`/api/v1/billing/invoices/${ids.foreign}`, as(own))
    const draft = try cloud.call(`/api/v1/billing/invoices/${ids.draft}`, as(own))
    const otherList = try cloud.call("/api/v1/billing/invoices", as(other))
    const unpinnedList = try cloud.call("/api/v1/billing/invoices", as(unpinned))
    const unpinnedDetail = try cloud.call(`/api/v1/billing/invoices/${ids.first}`, as(unpinned))
    const badLimit = try cloud.call("/api/v1/billing/invoices?limit=500", as(own))
    const anonymous = try cloud.call("/api/v1/billing/invoices")
    const read = detail.body as InvoiceDetail
    const errorOf = (answer: { readonly status: number; readonly body: unknown }) => [answer.status, (answer.body as { readonly error: string }).error]
    try check(() => assert.deepStrictEqual(
      {
        firstPage: [firstPage.status, firstPage.body],
        nextPage: [nextPage.status, (nextPage.body as InvoicePage).invoices.map((invoice) => invoice.id), (nextPage.body as InvoicePage).nextCursor],
        detail: [detail.status, read.id, read.status, read.lines.length, read.lines.reduce((sum, line) => sum + line.amountCents, 0), read.periodStart, read.periodEnd, read.pdfUrl, read.lines[11]?.periodEnd],
        foreign: errorOf(foreign),
        draft: errorOf(draft),
        otherList: (otherList.body as InvoicePage).invoices.map((invoice) => invoice.id),
        unpinned: [unpinnedList.status, unpinnedList.body, ...errorOf(unpinnedDetail)],
        refused: [badLimit.status, anonymous.status]
      },
      {
        firstPage: [200, {
          invoices: [{ id: ids.second, number: "FAKE-0002", date: (at + 30 * day) * 1000, status: "open", amountDueCents: 3_000, amountPaidCents: 0, currency: "usd", hostedInvoiceUrl: `https://invoice.stripe.com/i/${ids.second}` }],
          nextCursor: ids.second
        }],
        nextPage: [200, [ids.first], null],
        detail: [200, ids.first, "paid", 12, 3_000, at * 1000, (at + 30 * day) * 1000, `https://pay.stripe.com/invoice/${ids.first}/pdf`, (at + 30 * day) * 1000],
        foreign: [404, "not_found"],
        draft: [404, "not_found"],
        otherList: [ids.foreign],
        unpinned: [200, { invoices: [], nextCursor: null }, 404, "not_found"],
        refused: [400, 401]
      }
    ))
  }))

  it.live("Open the billing portal only for my pinned customer with a fresh session (spec/cloud/billing/subscriptions.md, \"Story: Read my invoices and open the billing portal\")", () => scoped(effect {
    const stripe = try sync(() => createStripeInvoicesFake())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/stripe/", stripe.handler) })
    const now = try Clock.currentTimeMillis
    const own = try signedIn(cloud, "portal@example.com")
    const unpinned = try signedIn(cloud, "portal-unpinned@example.com")
    try subscribedTo(cloud, own.organizationId, "cus_portal", now)
    try sync(() => stripe.customer("cus_portal"))
    const portal = (signed: { readonly accessToken: string }) => cloud.call("/api/v1/subscriptions/portal", { method: "POST", headers: { authorization: `Bearer ${signed.accessToken}` } })
    const first = try portal(own)
    const second = try portal(own)
    const noCustomer = try portal(unpinned)
    try sql(cloud, "UPDATE sessions SET auth_at = $2 WHERE user_id = $1", [own.user.id, now - 2 * 3_600_000])
    const stale = try portal(own)
    const urls = [first.body, second.body].map((body) => (body as { readonly url: string }).url)
    const configuration = stripe.configurations[0]
    try check(() => assert.deepStrictEqual(
      {
        opened: [first.status, second.status, urls.every((url) => url.startsWith("https://billing.stripe.com/")), new Set(urls).size],
        sessions: stripe.portalSessions.map((session) => [session.customer, session.configuration]),
        configuration: [stripe.configurations.length, configuration?.features.subscription_cancel, configuration?.features.subscription_update.enabled, configuration?.features.customer_update.enabled],
        noCustomer: [noCustomer.status, (noCustomer.body as { readonly error: string }).error],
        stale: [stale.status, (stale.body as { readonly error: string }).error, stripe.portalSessions.length]
      },
      {
        opened: [200, 200, true, 2],
        sessions: [["cus_portal", configuration?.id ?? ""], ["cus_portal", configuration?.id ?? ""]],
        configuration: [1, { enabled: true, mode: "at_period_end", proration_behavior: "none" }, false, false],
        noCustomer: [409, "billing_state_conflict"],
        stale: [428, "fresh_session_required", 2]
      }
    ))
  }))
})

import { addUtcMonths, adjustForUpgrade, allowanceView, clawBackInvoice, closePeriods, openGrantMonths, openRenewal, restoreInvoice, sweepAllowance } from "../src/billing/allowance.vibe"
import { loadRow as loadPeriodRow } from "../src/store/rows.vibe"

const allowanceMonth = 30 * 24 * 3_600_000

effect function periodStatuses(cloud: TestCloud, organizationId: string) {
  const rows = try sql(cloud, "SELECT key, status FROM allowance_periods WHERE organization_id = $1 ORDER BY key", [organizationId])
  return rows.map((row) => [row.key, row.status])
}

describe("WP4 Subscriptions and entitlements: allowance", () => {
  it.live("A refunded invoice claws back its allowance, and what its open hold returns, and is never restored (spec/cloud/billing/allowance.md, \"Story: Lose the allowance of a refunded invoice, and get it back if I win the dispute\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-refund")
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, period_end, updated_at) VALUES ('org-refund', '{}'::jsonb, 1, 'active', 'pro_monthly', $1, $2)", [now + allowanceMonth, now])
    const invoice = { invoiceId: "in_refund", planKey: "ProMonthly", startsAt: now - 1000, endsAt: now + allowanceMonth } as const
    const opened = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-refund", invoice, now))))
    const again = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-refund", invoice, now))))
    const ticket = try cloud.inside(reserve({ organizationId: "org-refund", userId: "user-refund" }, { service: "MeteredInference", caller: "user-refund", requestId: "refund-1", part: { tag: "WholeRequest" } }, 1_000_000))
    const clawed = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(clawBackInvoice(tx, "in_refund", "RefundClawback", now))))
    try cloud.inside(markDispatched(ticket.key))
    try cloud.inside(settle(ticket.key, { kind: "known", actual: 400_000 }))
    const restored = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(restoreInvoice(tx, "in_refund", now))))
    const view = try cloud.store.transaction((tx) => allowanceView(tx, "org-refund", now))
    const usage = try sql(cloud, "SELECT from_allowance, from_credits FROM usage_records WHERE hold_key = $1", [ticket.key])
    try check(() => assert.deepStrictEqual(
      {
        opened: [opened.key, opened.moved, opened.period.granted, again.moved],
        held: ticket.hold.fromAllowance > 0,
        clawed: [clawed.moved, clawed.period.phase, clawed.period.clawbackCause],
        restored: restored.moved,
        view,
        usage: usage.map((row) => [Number(row.from_allowance), Number(row.from_credits)])
      },
      {
        opened: ["renewal/staging/in_refund", true, 90_000_000, false],
        held: true,
        clawed: [true, "PeriodClawedBack", "RefundClawback"],
        restored: false,
        view: { state: "clawed_back", granted: 90_000_000, adjustment: 0, available: 0, reserved: 0, settled: 400_000, expired: 0, clawedBack: 89_600_000, periodStart: now - 1000, resetsAt: now + allowanceMonth },
        usage: [[400_000, 0]]
      }
    ))
  }))

  it.live("A won dispute restores the allowance while the period is open, and leaves an ended one clawed back (spec/cloud/billing/allowance.md, \"Story: Lose the allowance of a refunded invoice, and get it back if I win the dispute\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-dispute")
    const open = effect (invoiceId: string, startsAt: number, endsAt: number) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-dispute", { invoiceId, planKey: "PlusMonthly", startsAt, endsAt }, now))))).moved
    }
    const disputed = effect (invoiceId: string) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(clawBackInvoice(tx, invoiceId, "DisputeClawback", now))))).moved
    }
    const won = effect (invoiceId: string) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(restoreInvoice(tx, invoiceId, now))))).moved
    }
    const opened = [try open("in_won", now - 1000, now + allowanceMonth), try open("in_late", now - allowanceMonth, now - 1000)]
    const clawed = [try disputed("in_won"), try disputed("in_late")]
    const during = try cloud.store.transaction((tx) => allowanceView(tx, "org-dispute", now))
    const restored = [try won("in_won"), try won("in_late")]
    const after = try cloud.store.transaction((tx) => allowanceView(tx, "org-dispute", now))
    const refundedLate = (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(clawBackInvoice(tx, "in_late", "RefundClawback", now))))).moved
    const late = (try cloud.store.transaction((tx) => loadPeriodRow(tx, periodRows, "renewal/staging/in_late", false))).state
    const statuses = try periodStatuses(cloud, "org-dispute")
    try check(() => assert.deepStrictEqual(
      {
        opened, clawed,
        during: [during?.state, during?.available, during?.clawedBack],
        restored,
        after: [after?.state, after?.available, after?.clawedBack, after?.resetsAt],
        refundedLate,
        late: [late.phase, late.clawbackCause, late.clawedBack, late.available],
        statuses
      },
      {
        opened: [true, true],
        clawed: [true, true],
        during: ["clawed_back", 0, 25_000_000],
        restored: [true, false],
        after: ["open", 25_000_000, 0, now + allowanceMonth],
        refundedLate: true,
        late: ["PeriodClawedBack", "RefundClawback", 25_000_000, 0],
        statuses: [["renewal/staging/in_late", "clawed_back"], ["renewal/staging/in_won", "open"]]
      }
    ))
  }))

  it.live("A period expires at its end and its unused allowance is forfeited, while the sweep opens the months of a grant in force (spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-renewed")
    try organization(cloud, "org-granted")
    const ended = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-renewed", { invoiceId: "in_old", planKey: "ProMonthly", startsAt: now - allowanceMonth, endsAt: now - 1000 }, now))))
    const grantFrom = now - 1000
    const firstMonthEnds = addUtcMonths(grantFrom, 1)
    const grantUntil = firstMonthEnds + 10 * 24 * 3_600_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-pilot', 'org-granted', 'pilot', 'plus_monthly', $1, $2, $1)", [grantFrom, grantUntil])
    const swept = try cloud.inside(sweepAllowance())
    const sweptAgain = try cloud.inside(sweepAllowance())
    const renewed = try cloud.store.transaction((tx) => allowanceView(tx, "org-renewed", now))
    const granted = try cloud.store.transaction((tx) => allowanceView(tx, "org-granted", now))
    const partial = (try cloud.store.transaction((tx) => loadPeriodRow(tx, periodRows, "grant/grant-pilot/1", false))).state
    const statuses = [try periodStatuses(cloud, "org-renewed"), try periodStatuses(cloud, "org-granted")]
    try check(() => assert.deepStrictEqual(
      {
        ended: ended.moved,
        swept, sweptAgain,
        renewed,
        granted: [granted?.state, granted?.granted, granted?.available, granted?.periodStart, granted?.resetsAt],
        partial: [partial.phase, partial.startsAt, partial.endsAt, partial.granted > 0 && partial.granted < 25_000_000],
        statuses
      },
      {
        ended: true,
        swept: { expired: 1, opened: 2 },
        sweptAgain: { expired: 0, opened: 0 },
        renewed: { state: "expired", granted: 90_000_000, adjustment: 0, available: 0, reserved: 0, settled: 0, expired: 90_000_000, clawedBack: 0, periodStart: now - allowanceMonth, resetsAt: now - 1000 },
        granted: ["open", 25_000_000, 25_000_000, grantFrom, firstMonthEnds],
        partial: ["PeriodOpen", firstMonthEnds, grantUntil, true],
        statuses: [[["renewal/staging/in_old", "expired"]], [["grant/grant-pilot/0", "open"], ["grant/grant-pilot/1", "open"]]]
      }
    ))
  }))

  it.live("An upgrade mid-period adds exactly the reviewed prorated difference once, and periods close when the subscription ends or a grant is revoked or superseded (spec/cloud/billing/allowance.md, \"Story: Get more allowance when I upgrade mid-period\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-upgrade")
    try organization(cloud, "org-grants")
    const day = 24 * 3_600_000
    try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-upgrade", { invoiceId: "in_up", planKey: "PlusMonthly", startsAt: now - 10 * day, endsAt: now + 20 * day }, now))))
    const reviewed = Math.floor((90_000_000 - 25_000_000) * (20 * 24 * 60) / (30 * 24 * 60))
    const upgrade = effect (amount: number) => {
      return try cloud.store.transaction((tx) => adjustForUpgrade(tx, "org-upgrade", "ProMonthly", now, amount, now))
    }
    const wrong = try upgrade(reviewed + 1)
    const right = try upgrade(reviewed)
    const twice = try upgrade(reviewed)
    const upgraded = try cloud.store.transaction((tx) => allowanceView(tx, "org-upgrade", now))
    const ended = try cloud.store.transaction((tx) => closePeriods(tx, "org-upgrade", { kind: "SubscriptionEnded" }, now))
    const closedRenewal = try cloud.store.transaction((tx) => allowanceView(tx, "org-upgrade", now))
    const lifetime = { id: "grant-life", planKey: "PlusMonthly", effectiveFrom: now - 1000, effectiveUntil: null } as const
    const monthly = { id: "grant-month", planKey: "PlusMonthly", effectiveFrom: now - 1000, effectiveUntil: addUtcMonths(now - 1000, 1) } as const
    const life = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", lifetime, now))
    const lifeAgain = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", lifetime, now))
    const month = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", monthly, now))
    const revoked = try cloud.store.transaction((tx) => closePeriods(tx, "org-grants", { kind: "GrantRevoked", grantId: "grant-life" }, now))
    const superseded = try cloud.store.transaction((tx) => closePeriods(tx, "org-grants", { kind: "SupersededByPaid" }, now))
    const statuses = try periodStatuses(cloud, "org-grants")
    try check(() => assert.deepStrictEqual(
      {
        upgrade: [wrong.moved, right.moved, right.period.planKey, right.period.adjustment, twice.moved],
        upgraded: [upgraded?.state, upgraded?.granted, upgraded?.adjustment, upgraded?.available],
        ended: ended.map((step) => [step.key, step.period.phase]),
        closedRenewal: [closedRenewal?.state, closedRenewal?.available, closedRenewal?.expired],
        opened: [life.map((step) => step.key), lifeAgain.length, month.map((step) => step.key)],
        revoked: revoked.map((step) => step.key),
        superseded: superseded.map((step) => step.key),
        statuses
      },
      {
        upgrade: [false, true, "ProMonthly", reviewed, false],
        upgraded: ["open", 25_000_000, reviewed, 25_000_000 + reviewed],
        ended: [["renewal/staging/in_up", "PeriodClosed"]],
        closedRenewal: ["closed", 0, 25_000_000 + reviewed],
        opened: [["grant/grant-life/0", "grant/grant-life/1", "grant/grant-life/2"], 0, ["grant/grant-month/0"]],
        revoked: ["grant/grant-life/0", "grant/grant-life/1", "grant/grant-life/2"],
        superseded: ["grant/grant-month/0"],
        statuses: [["grant/grant-life/0", "closed"], ["grant/grant-life/1", "closed"], ["grant/grant-life/2", "closed"], ["grant/grant-month/0", "closed"]]
      }
    ))
  }))
})

module node {
  import { Effect, Schema } from "effect"
  import { SecureRandom } from "effect/crypto"
  import { createCipheriv, createHash } from "node:crypto"
  import { exportJWK, generateKeyPair, SignJWT } from "jose"
  import { CLEF_DECISIONS_PATH, createClefDecisionsClient, type ClefDecisionRequest } from "../src/clef-decisions.vibe"
  import { signInWithProof } from "../src/identity-store.vibe"
  import { cloudWorker, type CloudBindings } from "../src/worker.vibe"
  import { openBackupDatabase } from "./support/password-backup.ts"

  export async function nativeGoogleFixture() {
    const { privateKey, publicKey } = await generateKeyPair("RS256", { extractable: true })
    const key = { ...await exportJWK(publicKey), kid: "google-test", alg: "RS256" }
    return {
      keys: [key],
      issue: (nonce: string) => new SignJWT({ nonce, email: "linked@example.test", email_verified: true })
        .setProtectedHeader({ alg: "RS256", kid: "google-test" })
        .setIssuer("https://accounts.google.com")
        .setAudience("google-server-client")
        .setSubject("linked-google-subject")
        .setExpirationTime("5m")
        .sign(privateKey),
    }
  }

  export async function decideForSignedInAccount() {
    const fixture = await openBackupDatabase()
    try {
      const digest = "d".repeat(64)
      await fixture.db.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, 'staging', 1)", [digest])
      const owner = await Effect.runPromise(Effect.provide(signInWithProof(fixture.db, {
        provider: "email", subject: "reader@example.test", email: "reader@example.test",
      }), SecureRandom.layerWebCrypto))
      const web = "https://app.example.test"
      const api = "https://api.example.test"
      const providerInputs: string[] = []
      let chosen = "hours"
      async function run(id: string, input: Record<string, unknown>, options: { returnRawResponse: true; signal: AbortSignal }): Promise<Response>
      async function run(id: string, input: unknown): Promise<unknown>
      async function run(id: string, input: unknown, options?: unknown): Promise<unknown> {
        if (options) return Response.json({ error: "unexpected inference request" }, { status: 500 })
        providerInputs.push(JSON.stringify({ id, input }))
        if (providerInputs.length === 1) await Effect.runPromise(Effect.sleep(4_250))
        return { model: "clef-flash", answers: { target: {
          type: "choice", choice: chosen, confidence: .95, probabilities: { hours: .95, none: .05 },
        } } }
      }
      const env = {
        AI: { run }, DATABASE_URL: fixture.databaseUrl, CLOUD_IDENTITY_DIGEST: digest, CLOUD_ENVIRONMENT: "staging",
        PUBLIC_API_ORIGIN: api, WEB_ORIGIN: web, CHAT_MODEL: "unused", EMBEDDING_MODEL: "unused",
        CHAT_INPUT_MICROS_PER_1K: "1", CHAT_OUTPUT_MICROS_PER_1K: "1", EMBEDDING_INPUT_MICROS_PER_1K: "1", MAX_COMPLETION_TOKENS: "1",
        STRIPE_SECRET_KEY: "unused", STRIPE_WEBHOOK_SECRET: "unused", STRIPE_PRICE_ID: "unused", STRIPE_PRODUCT_ID: "unused", STRIPE_PLAN: "plus_monthly",
      } satisfies CloudBindings
      const worker = cloudWorker()
      const body: ClefDecisionRequest = { kind: "choice", goal: "Find opening hours", page: "Session https://example.test/?token=private",
        candidates: [{ id: "hours", label: "Opening hours" }] }
      const headers = { origin: web, cookie: "__Host-eliza-session=" + owner.access, "X-Eliza-Account": owner.account.id }
      const post = (value: unknown, supplied: Record<string, string>) => worker.fetch(new Request(api + CLEF_DECISIONS_PATH, {
        method: "POST", headers: { ...supplied, "content-type": "application/json" }, body: JSON.stringify(value),
      }), env)
      const signedOut = await post(body, { origin: web })
      const changedAccount = await post(body, { ...headers, "X-Eliza-Account": "different-account" })
      const extraFields = await post({ ...body, form: { password: "private" } }, headers)
      const duplicateIds = await post({ ...body, candidates: [body.candidates[0], body.candidates[0]] }, headers)
      const client = createClefDecisionsClient({ baseUrl: api, headers: () => headers,
        fetch: (input, options) => worker.fetch(new Request(input, options), env) })
      const decision = await client(body)
      chosen = "older-snapshot"
      const staleChoice = await client(body)
      await fixture.db.query("UPDATE cloud_auth_limits SET hits = 2000 WHERE scope = 'clef:organization'")
      const blocked = await post(body, headers)
      const account = await fixture.db.query<{ hits: number }>("SELECT hits FROM cloud_auth_limits WHERE scope = 'clef:account'")
      return {
        refusals: [signedOut.status, changedAccount.status, extraFields.status, duplicateIds.status, blocked.status],
        decision, staleChoice, providerCalls: providerInputs.length, accountCalls: account.rows[0]?.hits,
        withheld: providerInputs.every((input) => !input.includes("token=private") && !input.includes("https://example.test")),
      }
    } finally { await fixture.close() }
  }
  export async function readSelectedAttachment() {
    const fixture = await openBackupDatabase()
    const original = globalThis.fetch
    try {
      const digest = "a".repeat(64)
      await fixture.db.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, 'staging', 1)", [digest])
      const signIn = (email: string) => Effect.runPromise(Effect.provide(signInWithProof(fixture.db, { provider: "email", subject: email, email }), SecureRandom.layerWebCrypto))
      const owner = await signIn("attachment-owner@example.test")
      const other = await signIn("attachment-other@example.test")
      const web = "https://app.example.test"
      const api = "https://api.example.test"
      const key = "11".repeat(32)
      const subject = "fixture-google-subject"
      const grant = "00112233-4455-6677-8899-aabbccddeeff"
      const nonce = Buffer.alloc(12)
      const cipher = createCipheriv("aes-256-gcm", Buffer.from(key, "hex"), nonce)
      cipher.setAAD(Buffer.from(JSON.stringify(["cloud-google-token-v1", api, owner.account.id, subject, true, false])))
      const encrypted = Buffer.concat([nonce, cipher.update("fixture-refresh"), cipher.final(), cipher.getAuthTag()]).toString("hex")
      await fixture.db.query("INSERT INTO cloud_google_connections (account_id, id, subject, email, mail, calendar, refresh_cipher) VALUES ($1, $2, $3, $4, true, false, $5)",
        [owner.account.id, grant, subject, "attachment-owner@example.test", encrypted])
      const bytes = Buffer.from("%PDF-local-fixture")
      const part = { partId: "1", filename: "fixture.pdf", mimeType: "application/pdf", body: { attachmentId: "fixture-attachment", size: bytes.length } }
      const unsupported = { partId: "2", filename: "fixture.html", mimeType: "text/html", body: { attachmentId: "never-fetch", size: 10 } }
      const oversized = { partId: "3", filename: "large.pdf", mimeType: "application/pdf", body: { attachmentId: "never-fetch", size: 8 * 1024 * 1024 + 1 } }
      let attachmentFetches = 0
      let redirect = false
      let changedBytes = false
      let revokeDuringDownload = false
      let revokeListing: "grant" | "session" | undefined
      let providerRequestsValid = true
      globalThis.fetch = async (input, init) => {
        const request = new Request(input, init)
        const url = new URL(request.url)
        providerRequestsValid &&= request.redirect === "manual"
        if (url.href === "https://oauth2.googleapis.com/token" && request.method === "POST")
          return Response.json({ access_token: "fixture-access", scope: "https://www.googleapis.com/auth/gmail.readonly" })
        providerRequestsValid &&= request.headers.get("authorization") === "Bearer fixture-access"
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/messages") {
          const label = url.searchParams.get("labelIds")
          const found = label === "INBOX" ? ["fixture-message", "moved-to-trash"] : label === "TRASH" && url.searchParams.get("includeSpamTrash") === "true" &&
            url.searchParams.get("q") === "subject:plan & dates" ? ["trashed-message", "moved-message"] : []
          return Response.json({ messages: found.map((id) => ({ id })), nextPageToken: "page-two" })
        }
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/labels/INBOX")
          return Response.json({ id: "INBOX", messagesUnread: 52 })
        if (url.origin === "https://gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/labels/DRAFT") {
          if (revokeListing === "grant") await fixture.db.query("DELETE FROM cloud_google_connections WHERE account_id = $1", [owner.account.id])
          if (revokeListing === "session") await fixture.db.query("UPDATE sessions SET live = false WHERE user_id = $1", [owner.account.id])
          return Response.json({ id: "DRAFT", messagesTotal: 7 })
        }
        if (url.origin === "https://gmail.googleapis.com" && ["/gmail/v1/users/me/messages/trashed-message", "/gmail/v1/users/me/messages/moved-message", "/gmail/v1/users/me/messages/moved-to-trash"].includes(url.pathname)) {
          const id = url.pathname.split("/").at(-1)
          const labelIds = id === "moved-to-trash" ? ["TRASH", "INBOX"] : [id === "trashed-message" ? "TRASH" : "INBOX"]
          return Response.json({ id, threadId: "trash-thread", internalDate: "1760000000000", labelIds })
        }
        if (url.hostname === "gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/messages/fixture-message")
          return Response.json({ id: "fixture-message", threadId: "fixture-thread", internalDate: "1760000000000", historyId: "789", labelIds: ["INBOX"],
            payload: { headers: [{ name: "Subject", value: "Selected PDF" }], parts: [{ mimeType: "text/plain", body: { data: "aGVsbG8" } }, part, unsupported, oversized] } })
        if (url.hostname === "gmail.googleapis.com" && url.pathname === "/gmail/v1/users/me/messages/fixture-message/attachments/fixture-attachment") {
          attachmentFetches += 1
          if (revokeDuringDownload) await fixture.db.query("UPDATE device_grants SET key_expires_at = 0 WHERE user_id = $1", [owner.account.id])
          const original = changedBytes ? Buffer.alloc(bytes.length, 120) : bytes
          return redirect ? Response.redirect("https://unexpected.example.test", 302) : Response.json({ data: original.toString("base64url"), size: original.length })
        }
        providerRequestsValid = false
        return Response.json({ error: "unexpected fixture request" }, { status: 500 })
      }
      const clientId = "com.example.attachment"
      const redirectUri = web + "/android/auth/callback"
      const device = async (user: string) => {
        const token = "eliza_mobile_" + createHash("sha256").update(user).digest("hex")
        const now = Date.now()
        await fixture.db.query(`INSERT INTO device_grants (key, state, revision, user_id, client_id, phase,
          credential_id, secret_digest, code_expires_at, key_expires_at, issued_at, updated_at)
          VALUES ($1, '{}'::jsonb, 1, $1, $2, 'active', $1, $3, $4, $5, $4, $4)`,
          [user, clientId, createHash("sha256").update(token).digest("hex"), now, now + 86400000])
        return { authorization: "Bearer " + token }
      }
      const ownDevice = await device(owner.account.id)
      const otherDevice = await device(other.account.id)
      const env = {
        AI: { run: async () => { throw new Error("Unexpected inference in attachment fixture") } }, DATABASE_URL: fixture.databaseUrl, CLOUD_IDENTITY_DIGEST: digest, CLOUD_ENVIRONMENT: "staging",
        PUBLIC_API_ORIGIN: api, WEB_ORIGIN: web, CHAT_MODEL: "unused", EMBEDDING_MODEL: "unused",
        CHAT_INPUT_MICROS_PER_1K: "1", CHAT_OUTPUT_MICROS_PER_1K: "1", EMBEDDING_INPUT_MICROS_PER_1K: "1", MAX_COMPLETION_TOKENS: "1",
        STRIPE_SECRET_KEY: "unused", STRIPE_WEBHOOK_SECRET: "unused", STRIPE_PRICE_ID: "unused", STRIPE_PRODUCT_ID: "unused", STRIPE_PLAN: "plus_monthly",
        NATIVE_CLIENT_ID: clientId, NATIVE_AUTH_CALLBACK: redirectUri,
        NATIVE_CLIENT_REGISTRY: JSON.stringify([{ clientId, androidPackage: clientId, environment: "staging", displayName: "Attachment", signInReturn: redirectUri,
          billingReturn: web + "/billing", certFingerprints: [Array(32).fill("AA").join(":")], enabled: true }]),
        GOOGLE_CLIENT_ID: "fixture-client", GOOGLE_CLIENT_SECRET: "fixture-secret", GOOGLE_CONNECT_TOKEN_KEY: key,
      } satisfies CloudBindings
      const worker = cloudWorker()
      const get = (path: string, cookie?: string) => worker.fetch(new Request(api + "/api/v1/eliza/google/gmail/" + path, {
        headers: cookie ? { origin: web, cookie: "__Host-eliza-session=" + cookie } : { origin: web },
      }), env)
      const query = "grantId=" + grant + "&messageId=fixture-message"
      const folder = "triage?" + new URLSearchParams({ grantId: grant, folder: "trash", q: "  subject:plan & dates ", counts: "1" })
      const readFolder = async (path: string) => {
        const answer = await get(path, owner.access)
        const value = Schema.decodeUnknownSync(Schema.Struct({ accountId: Schema.String, folder: Schema.String, q: Schema.String, messages: Schema.Array(Schema.Struct({ externalId: Schema.String })),
          counts: Schema.optional(Schema.Struct({ inboxUnread: Schema.Number, drafts: Schema.Number })), nextPageToken: Schema.String }))(await answer.json())
        return [answer.status, value.accountId === owner.account.id, value.folder, value.q, value.messages.map(({ externalId }) => externalId), value.counts ?? null, value.nextPageToken]
      }
      const mailboxes = [await readFolder("triage?grantId=" + grant), await readFolder(folder)]
      const deniedFolders = [(await get(folder, other.access)).status, (await get("triage?folder=shared", owner.access)).status]
      const attachment = "attachment?" + query
      const selected = attachment + "&historyId=789&partId=1"
      const read = await get("read?" + query, owner.access)
      const manifest = Schema.decodeUnknownSync(Schema.Struct({
        historyId: Schema.NullOr(Schema.String), bodyText: Schema.String,
        attachments: Schema.Array(Schema.Struct({ partId: Schema.String, name: Schema.String, mimeType: Schema.String, size: Schema.Number, supported: Schema.Boolean })),
      }))(await read.json())
      const guardStatuses = [
        (await get(selected)).status,
        (await get(selected, other.access)).status,
        (await get(attachment + "&historyId=788&partId=1", owner.access)).status,
        (await get(attachment + "&historyId=789&partId=999", owner.access)).status,
        (await get(attachment + "&historyId=789&partId=2", owner.access)).status,
        (await get(attachment + "&historyId=789&partId=3", owner.access)).status,
      ]
      const guardedDownloads = attachmentFetches
      const downloaded = await get(selected, owner.access)
      const raw: unknown = await downloaded.json()
      const { deviceTransfer } = Schema.decodeUnknownSync(Schema.Struct({ deviceTransfer: Schema.String }))(raw)
      const file = Object.fromEntries(Object.entries(Schema.decodeUnknownSync(Schema.Record(Schema.String, Schema.Unknown))(raw)).filter(([name]) => name !== "deviceTransfer"))
      const redeem = (ticket: string, headers: Record<string, string>) => worker.fetch(new Request(api + "/api/v1/google-attachments/device", {
        method: "POST", headers: { ...headers, "content-type": "application/json" }, body: JSON.stringify({ ticket }),
      }), env)
      const refused = [
        (await redeem(deviceTransfer, { origin: web, cookie: "__Host-eliza-session=" + owner.access })).status,
        (await redeem(deviceTransfer, otherDevice)).status,
        (await redeem((deviceTransfer.startsWith("0") ? "1" : "0") + deviceTransfer.slice(1), ownDevice)).status,
      ]
      const beforeDeviceRead = attachmentFetches
      const onDevice = await redeem(deviceTransfer, ownDevice)
      const deviceReceipt: unknown = await onDevice.json()
      changedBytes = true
      const changed = await redeem(deviceTransfer, ownDevice)
      changedBytes = false
      revokeDuringDownload = true
      const revoked = await redeem(deviceTransfer, ownDevice)
      revokeDuringDownload = false
      redirect = true
      const rejectedRedirect = await get(selected, owner.access)
      revokeListing = "session"
      const signedOut = await get(folder, owner.access)
      const signedBackIn = await signIn("attachment-owner@example.test")
      revokeListing = "grant"
      const disconnected = await get(folder, signedBackIn.access)
      return {
        mailboxes, deniedFolders, signedOut: signedOut.status, disconnected: disconnected.status,
        refused, beforeDeviceRead, deviceStatus: onDevice.status, deviceReceipt, changed: changed.status, revoked: revoked.status,
        organization: (await fixture.db.query<{ organization_id: string }>("SELECT organization_id FROM accounts WHERE key = $1", [owner.account.id])).rows[0]?.organization_id, grant, manifest, readStatus: read.status, guardStatuses, guardedDownloads, file, fileStatus: downloaded.status,
        cache: downloaded.headers.get("cache-control"), owner: owner.account.id, expectedHash: createHash("sha256").update(bytes).digest("hex"),
        expectedData: bytes.toString("base64"), size: bytes.length, rejectedRedirect: rejectedRedirect.status, providerRequestsValid, attachmentFetches,
      }
    } finally {
      globalThis.fetch = original
      await fixture.close()
    }
  }

}
import { decideForSignedInAccount, nativeGoogleFixture, readSelectedAttachment } from node

it.live('A reviewed link decision stays within the current account and candidates (spec/cloud/index.md, "Story: Ask for a bounded decision about a browser page")', () => effect {
  const result = try tryPromise(() => decideForSignedInAccount())
  try check(() => assert.deepStrictEqual(result, {
    refusals: [401, 403, 400, 400, 429],
    decision: { status: "ok", kind: "choice", model: "clef-flash", choice: "hours", confidence: .95, probabilities: { hours: .95, none: .05 } },
    staleChoice: { status: "unavailable", reason: "provider_error" }, providerCalls: 2, accountCalls: 2, withheld: true,
  }))
}, 30_000)


it.live('Open the selected named attachment (spec/cloud/index.md, "Story: Connect Google mail and calendar")', () => effect {
  const got = try tryPromise(() => readSelectedAttachment())
  try check(() => assert.deepStrictEqual(
    {
      read: [got.readStatus, got.manifest.historyId, got.manifest.bodyText, got.manifest.attachments],
      refuse: [got.guardStatuses, got.guardedDownloads, got.rejectedRedirect],
      file: [got.fileStatus, got.cache, got.file],
      provider: [got.providerRequestsValid, got.attachmentFetches],
      mailboxes: [got.mailboxes, got.deniedFolders, got.signedOut, got.disconnected],
      device: [got.refused, got.beforeDeviceRead, got.deviceStatus, got.deviceReceipt, got.changed, got.revoked],
    },
    {
      read: [200, "789", "hello", [
        { partId: "1", name: "fixture.pdf", mimeType: "application/pdf", size: got.size, supported: true },
        { partId: "2", name: "fixture.html", mimeType: "text/html", size: 10, supported: false },
        { partId: "3", name: "large.pdf", mimeType: "application/pdf", size: 8 * 1024 * 1024 + 1, supported: false },
      ]],
      refuse: [[401, 409, 409, 404, 415, 415], 0, 502],
      file: [200, "no-store", { version: 1, accountId: got.owner, organizationId: got.organization, grantId: got.grant, messageId: "fixture-message", partId: "1", historyId: "789",
        name: "fixture.pdf", mimeType: "application/pdf", size: got.size, dataBase64: got.expectedData, sha256: got.expectedHash, supported: true }],
      provider: [true, 5],
      mailboxes: [[[200, true, "inbox", "", ["fixture-message"], null, "page-two"], [200, true, "trash", "subject:plan & dates", ["trashed-message"], { inboxUnread: 52, drafts: 7 }, "page-two"]], [409, 400], 401, 409],
      device: [[401, 409, 409], 1, 200, got.file, 409, 401],
    },
  ))
}, 30_000)

import { defaultTerm as defaultGrantTerm } from "../gen/cloud__billing__grantCodes.ts"
import { disableGrantCodes, mintGrantCodes, revokeGrants, type MintRequest } from "../src/billing/grant-codes.vibe"

effect function mintCodes(cloud: TestCloud, request: MintRequest, now: number) {
  return try cloud.inside(cloud.store.transaction((tx) => cloud.inside(mintGrantCodes(tx, request, now))))
}

effect function redeemCode(cloud: TestCloud, token: string, code: string, idempotencyKey: string) {
  const answer = try cloud.call("/api/v1/subscription/redeem", { headers: { authorization: `Bearer ${token}` }, json: { code, idempotencyKey } })
  const body = answer.body as { readonly error?: string; readonly replayed?: boolean; readonly grant?: { readonly id: string; readonly planKey: string; readonly family: string; readonly effectiveFrom: number; readonly effectiveUntil: number | null; readonly revoked: boolean }; readonly entitlement?: { readonly plan: { readonly key: string; readonly source: string }; readonly token: string } }
  return { status: answer.status, error: body.error, replayed: body.replayed, grant: body.grant, plan: body.entitlement?.plan, token: body.entitlement?.token }
}

effect function grantPeriods(cloud: TestCloud, grantId: string) {
  return (try sql(cloud, "SELECT status FROM allowance_periods WHERE starts_with(key, $1) ORDER BY key", [`grant/${grantId}/`])).map((row) => String(row.status))
}

describe("WP4 Subscriptions and entitlements: grant codes", () => {
  it.live("Redeem a membership code once, the same answer on a retry and each refusal in the order the rules give (spec/cloud/billing/grantCodes.md, \"Story: Redeem a membership code once\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const redeemer = try entitledDevice(cloud, "redeemer", now)
    const second = try entitledDevice(cloud, "second", now)
    const third = try entitledDevice(cloud, "third", now)
    const payer = try entitledDevice(cloud, "payer", now)
    const guesser = try entitledDevice(cloud, "guesser", now)
    try subscribedTo(cloud, "org-payer", "cus_payer", now)
    const founders = try mintCodes(cloud, { family: "founders", planKey: "PlusMonthly", term: defaultGrantTerm, requiresNoPaidPlan: true, maxRedemptions: 2, expiresAt: undefined, count: 2 }, now)
    const pilot = try mintCodes(cloud, { family: "pilot", planKey: "ProMonthly", term: { tag: "TermLifetime" }, requiresNoPaidPlan: false, maxRedemptions: 1, expiresAt: undefined, count: 1 }, now)
    const [first = "", other = ""] = founders
    const typed = first.toLowerCase().replaceAll("-", " ").replaceAll("1", "l").replaceAll("0", "o")

    const fresh = try redeemCode(cloud, redeemer, typed, "redeem-key-1")
    const replay = try redeemCode(cloud, redeemer, first, "redeem-key-1")
    const sameFamily = try redeemCode(cloud, redeemer, other, "redeem-key-2")
    const reusedKey = try redeemCode(cloud, redeemer, pilot[0] ?? "", "redeem-key-1")
    const paidPlan = try redeemCode(cloud, payer, first, "redeem-key-3")
    const secondHolder = try redeemCode(cloud, second, first, "redeem-key-4")
    const usedUp = try redeemCode(cloud, third, first, "redeem-key-5")
    const otherFamily = try redeemCode(cloud, third, pilot[0] ?? "", "redeem-key-6")
    const months = try grantPeriods(cloud, fresh.grant?.id ?? "")
    const lifetimeMonths = try grantPeriods(cloud, otherFamily.grant?.id ?? "")
    const published = try cloud.call("/api/v1/subscription/entitlement-keys")
    const verified = try promise(() => verifyEntitlement(fresh.token ?? "", (published.body as { readonly keys: ReadonlyArray<PublishedKey> }).keys, { issuer: "https://api.staging.example.com", audience: "cloud-subscription", nowSeconds: Math.floor(now / 1000) }))

    const guesses: Array<[number, string | undefined]> = []
    for (const guess of ["not a code", "0000-0000-0000-0000", "1111-1111-1111-1111", "2222-2222-2222-2222", "3333-3333-3333-3333", first]) {
      const answer = try redeemCode(cloud, guesser, guess, "guess-key-1")
      guesses.push([answer.status, answer.error])
    }

    try check(() => assert.deepStrictEqual(
      {
        minted: [...founders, ...pilot].map((code) => /^[0-9A-HJKMNP-TV-Z]{4}(-[0-9A-HJKMNP-TV-Z]{4}){3}$/.test(code)),
        fresh: [fresh.status, fresh.replayed, fresh.grant?.planKey, fresh.grant?.family, fresh.grant?.revoked, (fresh.grant?.effectiveUntil ?? 0) - (fresh.grant?.effectiveFrom ?? 0), fresh.plan],
        token: [verified.claims.plan, verified.claims.org],
        replay: [replay.status, replay.replayed, replay.grant?.id === fresh.grant?.id],
        refusals: [[sameFamily.status, sameFamily.error], [reusedKey.status, reusedKey.error], [paidPlan.status, paidPlan.error], [usedUp.status, usedUp.error]],
        secondHolder: [secondHolder.status, secondHolder.replayed, secondHolder.grant?.id !== fresh.grant?.id],
        lifetime: [otherFamily.status, otherFamily.grant?.effectiveUntil, otherFamily.plan, lifetimeMonths],
        months: [months.length >= 6, months.every((status) => status === "open")],
        guesses
      },
      {
        minted: [true, true, true],
        fresh: [200, false, "plus_monthly", "founders", false, 183 * 24 * 3_600_000, { key: "plus_monthly", source: "grant", effectiveUntil: fresh.grant?.effectiveUntil }],
        token: [{ id: "plus_monthly", name: "Plus", status: "active" }, "org-redeemer"],
        replay: [200, true, true],
        refusals: [[409, "subscription_grant_already_redeemed"], [409, "idempotency_conflict"], [409, "subscription_grant_paid_plan_active"], [400, "grant_code_invalid"]],
        secondHolder: [200, false, true],
        lifetime: [200, null, { key: "pro_monthly", source: "grant", effectiveUntil: null }, ["open", "open", "open"]],
        months: [true, true],
        guesses: [[400, "grant_code_invalid"], [400, "grant_code_invalid"], [400, "grant_code_invalid"], [400, "grant_code_invalid"], [400, "grant_code_invalid"], [429, "rate_limited"]]
      }
    ))
  }))

  it.live("Stop a leaked code and end a grant given in error, while replays still answer (spec/cloud/billing/grantCodes.md, \"Story: Stop a code or a grant\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const holder = try entitledDevice(cloud, "holder", now)
    const late = try entitledDevice(cloud, "late", now)
    const keeper = try entitledDevice(cloud, "keeper", now)
    const [leaked = ""] = try mintCodes(cloud, { family: "leaked", planKey: "PlusMonthly", term: { tag: "TermDays", days: 30 }, requiresNoPaidPlan: false, maxRedemptions: 5, expiresAt: undefined, count: 1 }, now)
    const [batch = ""] = try mintCodes(cloud, { family: "batch", planKey: "ProMonthly", term: defaultGrantTerm, requiresNoPaidPlan: false, maxRedemptions: 5, expiresAt: undefined, count: 1 }, now)

    const held = try redeemCode(cloud, holder, leaked, "stop-key-1")
    const disabled = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(disableGrantCodes(tx, { kind: "codes", codes: [leaked] }))))
    const disabledAgain = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(disableGrantCodes(tx, { kind: "family", family: "leaked" }))))
    const afterDisable = try redeemCode(cloud, late, leaked, "stop-key-2")
    const replayDisabled = try redeemCode(cloud, holder, leaked, "stop-key-1")
    const revoked = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(revokeGrants(tx, { kind: "grants", grantIds: [held.grant?.id ?? ""] }, "issued in error"))))
    const revokedAgain = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(revokeGrants(tx, { kind: "grants", grantIds: [held.grant?.id ?? ""] }, "issued in error"))))
    const replayRevoked = try redeemCode(cloud, holder, leaked, "stop-key-1")
    const closedMonths = try grantPeriods(cloud, held.grant?.id ?? "")

    const kept = try redeemCode(cloud, keeper, batch, "stop-key-3")
    const byCode = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(revokeGrants(tx, { kind: "codes", codes: [batch] }, "batch withdrawn"))))
    const afterCodeRevoke = try redeemCode(cloud, late, batch, "stop-key-4")
    const keeperReplay = try redeemCode(cloud, keeper, batch, "stop-key-3")

    try check(() => assert.deepStrictEqual(
      {
        held: [held.status, held.replayed, held.plan?.source],
        disabled: [disabled, disabledAgain, afterDisable.status, afterDisable.error, replayDisabled.status, replayDisabled.replayed, replayDisabled.grant?.revoked],
        revoked: [revoked, revokedAgain, replayRevoked.status, replayRevoked.replayed, replayRevoked.grant?.revoked, replayRevoked.plan?.source, closedMonths.length > 0 && closedMonths.every((status) => status === "closed")],
        byCode: [kept.status, byCode, afterCodeRevoke.status, afterCodeRevoke.error, keeperReplay.status, keeperReplay.grant?.revoked, keeperReplay.plan?.source]
      },
      {
        held: [200, false, "grant"],
        disabled: [1, 0, 400, "grant_code_invalid", 200, true, false],
        revoked: [1, 0, 200, true, true, "free", true],
        byCode: [200, 1, 400, "grant_code_invalid", 200, true, "free"]
      }
    ))
  }))
})

import { createStripePlanChange } from "./support/fakes/stripe-plan-change.ts"
import { fakeSecretKey, type StripeFake } from "./support/fakes/stripe.ts"
import { sweepPlanChanges, type PlanChangeReview, type PlanChangeView } from "../src/billing/plan-change.vibe"

describe("WP4 Subscriptions and entitlements: plan changes", () => {
  effect function stripeCall(stripe: StripeFake, method: string, path: string, form: Readonly<Record<string, string>>) {
    const answer = try tryPromise(async () => await stripe.handler({ method, path, query: new URLSearchParams(), headers: { authorization: `Bearer ${fakeSecretKey}` }, body: new URLSearchParams(form).toString(), raw: new Uint8Array() }))
    return (answer?.body ?? {}) as { readonly id: string }
  }

  effect function subscribedOn(cloud: TestCloud, stripe: StripeFake, organizationId: string, plan: "PlusMonthly" | "ProMonthly", now: number) {
    const customer = try stripeCall(stripe, "POST", "/v1/customers", {})
    const session = try stripeCall(stripe, "POST", "/v1/checkout/sessions", {
      mode: "subscription", customer: customer.id, "line_items[0][price]": plan === "PlusMonthly" ? "price_plus" : "price_pro", "line_items[0][quantity]": "1", success_url: "https://example.com/done"
    })
    const completed = try sync(() => stripe.completeSession(session.id, "paid"))
    const item = completed.subscription.items.data[0]
    const state: Subscription = {
      ...noSubscription, status: "Active", subscriptionId: completed.subscription.id, customer: { tag: "PinnedCustomer", customerId: customer.id },
      planKey: plan, periodStart: item.current_period_start * 1000, periodEnd: item.current_period_end * 1000, lastRenewalInvoice: completed.invoice.id, revision: 4
    }
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, provider_subscription_id, period_end, updated_at) VALUES ($1, $2, 4, 'active', $3, $4, $5, $6, $7)", [
      organizationId, JSON.stringify(state), plan === "PlusMonthly" ? "plus_monthly" : "pro_monthly", customer.id, state.subscriptionId, state.periodEnd, now
    ])
    try cloud.store.transaction((tx) => stepRow(tx, periodRows, `renewal/staging/${completed.invoice.id}`, { type: "openRenewal", invoiceId: completed.invoice.id, planKey: plan, startsAt: state.periodStart, endsAt: state.periodEnd }, () => ({
      organization_id: organizationId, status: "open", period_start: state.periodStart, period_end: state.periodEnd, updated_at: now
    })))
    return state
  }

  effect function planCloud() {
    const stripe = try sync(() => createStripeFake())
    const planChange = try sync(() => createStripePlanChange(stripe))
    const cloud = try testCloud({ stripe: { ...stripe, handler: planChange.handler } })
    return { stripe, planChange, cloud }
  }

  effect function subscriptionOf(cloud: TestCloud, organizationId: string) {
    const rows = try sql(cloud, "SELECT state, pending_plan_key FROM subscriptions WHERE key = $1", [organizationId])
    const state = rows[0]?.state as Subscription
    return { planKey: state.planKey, planned: state.planned, liveCommand: state.liveCommand.tag, pendingPlanKey: rows[0]?.pending_plan_key }
  }

  effect function adjustmentOf(cloud: TestCloud, organizationId: string) {
    const rows = try sql(cloud, "SELECT state FROM allowance_periods WHERE organization_id = $1 AND starts_with(key, 'renewal/')", [organizationId])
    return rows.map((row) => (row.state as { readonly adjustment: number }).adjustment)
  }

  function errorOf(answer: { readonly status: number; readonly body: unknown }) {
    return [answer.status, (answer.body as { readonly error?: string; readonly status?: string }).error ?? (answer.body as { readonly status?: string }).status]
  }

  it.live("Upgrade unpaid, continue to the hosted invoice, then pay: the plan changes and the allowance grows by the quoted amount once (spec/cloud/billing/subscriptionCommands.md, \"Story: Review a plan change before I confirm it\"; spec/cloud/billing/subscriptionCommands.md, \"Story: Get the plan I paid for\"; spec/cloud/billing/allowance.md, \"Story: Get more allowance when I upgrade mid-period\")", () => scoped(effect {
    const { stripe, planChange, cloud } = try planCloud()
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "upgrade@example.com")
    const headers = { authorization: `Bearer ${signed.accessToken}` }
    const subscription = try subscribedOn(cloud, stripe, signed.organizationId, "PlusMonthly", now)
    const reviewBody = { subscriptionId: subscription.subscriptionId, expectedSubscriptionRevision: 4, targetPlanKey: "pro_monthly" }
    const stale = try cloud.call("/api/v1/subscriptions/upgrade/review", { json: { ...reviewBody, expectedSubscriptionRevision: 3 }, headers })
    const sideways = try cloud.call("/api/v1/subscriptions/upgrade/review", { json: { ...reviewBody, targetPlanKey: "plus_monthly" }, headers })
    const reviewed = try cloud.call("/api/v1/subscriptions/upgrade/review", { json: reviewBody, headers })
    const quote = reviewed.body as PlanChangeReview
    try sync(() => planChange.declineNextUpgrade())
    const confirmBody = { quoteId: quote.quoteId, idempotencyKey: "upgrade-key-0001" }
    const confirmed = try cloud.call("/api/v1/subscriptions/upgrade/confirm", { json: confirmBody, headers })
    const command = confirmed.body as PlanChangeView
    const payment = try cloud.call(`/api/v1/subscriptions/upgrade/${command.commandId}/payment`, { method: "POST", headers })
    const blocked = try cloud.call("/api/v1/subscriptions/downgrade/review", { json: { ...reviewBody, targetPlanKey: "plus_monthly" }, headers })
    const waiting = try subscriptionOf(cloud, signed.organizationId)
    const invoice = planChange.invoices[0]
    try tryPromise(() => planChange.payInvoice(invoice?.id ?? ""))
    const paid = try cloud.call(`/api/v1/subscriptions/upgrade/${command.commandId}`, { headers })
    const replayed = try cloud.call("/api/v1/subscriptions/upgrade/confirm", { json: confirmBody, headers })
    const paidAgain = try cloud.call(`/api/v1/subscriptions/upgrade/${command.commandId}/payment`, { method: "POST", headers })
    const quoted = (try sql(cloud, "SELECT adjustment_micros FROM quotes WHERE key = $1", [quote.quoteId]))[0]?.adjustment_micros
    const after = try subscriptionOf(cloud, signed.organizationId)
    const adjustments = try adjustmentOf(cloud, signed.organizationId)
    try sql(cloud, "UPDATE sessions SET auth_at = $2 WHERE user_id = $1", [signed.user.id, now - 2 * 3_600_000])
    const unfresh = try cloud.call("/api/v1/subscriptions/upgrade/review", { json: reviewBody, headers })
    const paidView = paid.body as PlanChangeView
    try check(() => assert.deepStrictEqual(
      {
        refused: [errorOf(stale), errorOf(sideways)],
        review: [reviewed.status, quote.review.kind, quote.review.targetPlanKey, quote.review.dueNow.amountDueCents > 0 && quote.review.dueNow.amountDueCents <= 7_000, quote.review.recurringEstimate.amountDueCents, quote.review.expiresAt - quote.review.effectiveAt <= 60_000, quote.review.effectiveAt >= now],
        preview: planChange.previews.map((form) => [form.get("subscription_details[items][0][price]"), form.get("subscription_details[proration_date]") === String(Math.floor(quote.review.effectiveAt / 1000))]),
        confirmed: [confirmed.status, command.status, command.kind, command.expectedRevision, command.resultRevision],
        sent: planChange.updates.map((form) => [form.get("items[0][price]"), form.get("payment_behavior"), form.get("proration_behavior"), form.get("proration_date") === String(Math.floor(quote.review.effectiveAt / 1000))]),
        payment: [payment.status, (payment.body as { readonly url: string }).url === invoice?.hosted_invoice_url, invoice?.amount_due === quote.review.dueNow.amountDueCents],
        waiting: [errorOf(blocked), waiting.planKey, waiting.liveCommand],
        paid: [paid.status, paidView.status, (paidView.resultRevision ?? 0) >= 4],
        replayed: [replayed.status, (replayed.body as PlanChangeView).commandId === command.commandId, (replayed.body as PlanChangeView).status, planChange.updates.length],
        paidAgain: errorOf(paidAgain),
        after: [after.planKey, after.liveCommand, adjustments, Number(quoted) > 0],
        unfresh: errorOf(unfresh)
      },
      {
        refused: [[409, "stale_revision"], [409, "billing_state_conflict"]],
        review: [200, "upgrade_estimate", "pro_monthly", true, 10_000, true, true],
        preview: [["price_pro", true]],
        confirmed: [200, "awaiting_payment", "upgrade", 4, null],
        sent: [["price_pro", "pending_if_incomplete", "always_invoice", true]],
        payment: [200, true, true],
        waiting: [[409, "billing_state_conflict"], "PlusMonthly", "Live"],
        paid: [200, "succeeded", true],
        replayed: [200, true, "succeeded", 1],
        paidAgain: [409, "billing_state_conflict"],
        after: ["ProMonthly", "NoLiveCommand", [Number(quoted)], true],
        unfresh: [428, "fresh_session_required"]
      }
    ))
  }), 60_000)

  it.live("A voided upgrade invoice rejects the upgrade, keeps the plan and frees the command slot (spec/cloud/billing/subscriptionCommands.md, \"Story: Get the plan I paid for\")", () => scoped(effect {
    const { stripe, planChange, cloud } = try planCloud()
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "voided@example.com")
    const headers = { authorization: `Bearer ${signed.accessToken}` }
    const subscription = try subscribedOn(cloud, stripe, signed.organizationId, "PlusMonthly", now)
    const reviewed = try cloud.call("/api/v1/subscriptions/upgrade/review", { json: { subscriptionId: subscription.subscriptionId, expectedSubscriptionRevision: 4, targetPlanKey: "pro_monthly" }, headers })
    try sync(() => planChange.declineNextUpgrade())
    const confirmed = try cloud.call("/api/v1/subscriptions/upgrade/confirm", { json: { quoteId: (reviewed.body as PlanChangeReview).quoteId, idempotencyKey: "voided-key-0001" }, headers })
    const command = confirmed.body as PlanChangeView
    try sync(() => planChange.voidInvoice(planChange.invoices[0]?.id ?? ""))
    try cloud.inside(sweepPlanChanges())
    const ended = try cloud.call(`/api/v1/subscriptions/upgrade/${command.commandId}`, { headers })
    const foreign = try signedIn(cloud, "voided-other@example.com")
    const hidden = try cloud.call(`/api/v1/subscriptions/upgrade/${command.commandId}`, { headers: { authorization: `Bearer ${foreign.accessToken}` } })
    const after = try subscriptionOf(cloud, signed.organizationId)
    const adjustments = try adjustmentOf(cloud, signed.organizationId)
    try check(() => assert.deepStrictEqual(
      { confirmed: [confirmed.status, command.status], ended: [ended.status, (ended.body as PlanChangeView).status, (ended.body as PlanChangeView).resultRevision], hidden: errorOf(hidden), after: [after.planKey, after.liveCommand, adjustments] },
      { confirmed: [200, "awaiting_payment"], ended: [200, "rejected", null], hidden: [404, "not_found"], after: ["PlusMonthly", "NoLiveCommand", [0]] }
    ))
  }), 60_000)

  it.live("Downgrade at the period end: the confirmed schedule keeps the higher plan until renewal and records the pending plan (spec/cloud/billing/subscriptionCommands.md, \"Story: Get the plan I paid for\"; spec/cloud/billing/subscriptions.md, \"Story: Keep my plan as the provider says it is\")", () => scoped(effect {
    const { stripe, planChange, cloud } = try planCloud()
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "downgrade@example.com")
    const headers = { authorization: `Bearer ${signed.accessToken}` }
    const subscription = try subscribedOn(cloud, stripe, signed.organizationId, "ProMonthly", now)
    const reviewBody = { subscriptionId: subscription.subscriptionId, expectedSubscriptionRevision: 4, targetPlanKey: "plus_monthly" }
    const upward = try cloud.call("/api/v1/subscriptions/downgrade/review", { json: { ...reviewBody, targetPlanKey: "pro_monthly" }, headers })
    const first = try cloud.call("/api/v1/subscriptions/downgrade/review", { json: reviewBody, headers })
    const reviewed = try cloud.call("/api/v1/subscriptions/downgrade/review", { json: reviewBody, headers })
    const quote = reviewed.body as PlanChangeReview
    const replaced = try cloud.call("/api/v1/subscriptions/downgrade/confirm", { json: { quoteId: (first.body as PlanChangeReview).quoteId, idempotencyKey: "downgrade-key-0000" }, headers })
    const confirmed = try cloud.call("/api/v1/subscriptions/downgrade/confirm", { json: { quoteId: quote.quoteId, idempotencyKey: "downgrade-key-0001" }, headers })
    const command = confirmed.body as PlanChangeView
    const read = try cloud.call(`/api/v1/subscriptions/downgrade/${command.commandId}`, { headers })
    const wrongKind = try cloud.call(`/api/v1/subscriptions/upgrade/${command.commandId}`, { headers })
    const after = try subscriptionOf(cloud, signed.organizationId)
    const again = try cloud.call("/api/v1/subscriptions/downgrade/review", { json: { ...reviewBody, expectedSubscriptionRevision: (try sql(cloud, "SELECT (state->>'revision')::int AS revision FROM subscriptions WHERE key = $1", [signed.organizationId]))[0]?.revision }, headers })
    const schedule = planChange.schedules[0]
    try check(() => assert.deepStrictEqual(
      {
        upward: errorOf(upward),
        review: [reviewed.status, quote.review.kind, quote.review.targetPlanKey, quote.review.dueNow.amountDueCents, quote.review.recurringEstimate.amountDueCents, quote.review.effectiveAt],
        replaced: errorOf(replaced),
        confirmed: [confirmed.status, command.status, command.kind, (command.resultRevision ?? 0) >= 4, (read.body as PlanChangeView).status, errorOf(wrongKind)],
        schedule: [planChange.schedules.length, schedule?.subscription, schedule?.end_behavior, schedule?.phases.map((phase) => [phase.items[0]?.price, phase.start_date]), planChange.updates.length],
        after: [after.planKey, after.planned, after.pendingPlanKey, after.liveCommand],
        again: errorOf(again)
      },
      {
        upward: [409, "billing_state_conflict"],
        review: [200, "downgrade_estimate", "plus_monthly", 0, 3_000, subscription.periodEnd],
        replaced: [404, "not_found"],
        confirmed: [200, "succeeded", "downgrade", true, "succeeded", [404, "not_found"]],
        schedule: [1, subscription.subscriptionId, "release", [["price_pro", subscription.periodStart / 1000], ["price_plus", subscription.periodEnd / 1000]], 0],
        after: ["ProMonthly", { tag: "DowngradeAtRenewal", planKey: "PlusMonthly" }, "plus_monthly", "NoLiveCommand"],
        again: [409, "billing_state_conflict"]
      }
    ))
  }), 60_000)
})

import { observeSubscription, reconcileSubscription, releaseLiveCommand, claimLiveCommand, scheduleDowngrade, sendSubscription, sweepSubscriptions } from "../src/billing/subscriptions.vibe"
import { withSubscriptionLifecycle } from "./support/fakes/stripe-subscriptions.ts"
import { manualClock } from "./support/clock.ts"

effect function reconciledAt(cloud: TestCloud, organizationId: string, now: number, checkout?: string) {
  return try cloud.inside(cloud.store.transaction((tx) => cloud.inside(effect {
    const observed = try observeSubscription(tx, organizationId)
    return try reconcileSubscription(tx, organizationId, observed, now, checkout)
  })))
}

effect function heldRow(cloud: TestCloud, organizationId: string) {
  const row = (try sql(cloud, "SELECT status, plan_key, pending_plan_key, live_command, policy_generation, dunning_started_at, dunning_ends_at FROM subscriptions WHERE key = $1", [organizationId]))[0]
  return [row?.status, row?.plan_key, row?.pending_plan_key ?? null, row?.live_command ?? null, Number(row?.policy_generation), row?.dunning_started_at === null ? null : Number(row?.dunning_started_at), row?.dunning_ends_at === null ? null : Number(row?.dunning_ends_at)]
}

describe("WP4 Subscriptions and entitlements: reconcile", () => {
  it.live("Follow the provider through a paid checkout, a renewal that applies a pending downgrade, a failed payment, its dunning window and the end (spec/cloud/billing/subscriptions.md, \"Story: Keep my plan as the provider says it is\"; spec/cloud/billing/subscriptions.md, \"Story: Change my plan one command at a time\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const lifecycle = try sync(() => withSubscriptionLifecycle(createStripeFake()))
    const cloud = try testCloud({ stripe: lifecycle.stripe })
    const now = try Clock.currentTimeMillis
    const organizationId = "org-reconcile"
    const day = 24 * 3_600_000
    try organization(cloud, organizationId)
    const bought = try sync(() => lifecycle.subscribe("price_pro"))
    try cloud.inside(cloud.store.transaction((tx) => cloud.inside(sendSubscription(tx, organizationId, { type: "pinCustomer", customerId: bought.customerId }, now))))
    const paid = try reconciledAt(cloud, organizationId, now, "cmd_checkout")
    const paidRow = try heldRow(cloud, organizationId)
    const replay = try reconciledAt(cloud, organizationId, now + 1000)
    const periodsAfterReplay = try periodStatuses(cloud, organizationId)
    const scheduled = try cloud.store.transaction(effect (tx: Tx) => {
      try claimLiveCommand(tx, organizationId, "DowngradeCommand", "cmd_downgrade", replay.revision, now + 1500)
      const state = try scheduleDowngrade(tx, organizationId, "cmd_downgrade", "PlusMonthly", now + 1500)
      try releaseLiveCommand(tx, organizationId, "cmd_downgrade", now + 1500)
      return state
    })
    const scheduledRow = try heldRow(cloud, organizationId)
    const renewal = try sync(() => lifecycle.renew(bought.subscriptionId, "paid", "price_plus"))
    const renewed = try reconciledAt(cloud, organizationId, now + 2000)
    const renewedRow = try heldRow(cloud, organizationId)
    const periodsAfterRenewal = try periodStatuses(cloud, organizationId)
    try sync(() => lifecycle.renew(bought.subscriptionId, "failed"))
    const failedAt = now + 3000
    const dunning = try reconciledAt(cloud, organizationId, failedAt)
    const stillDunning = try reconciledAt(cloud, organizationId, failedAt + 3_600_000)
    const dunningRow = try heldRow(cloud, organizationId)
    const clock = try sync(() => manualClock())
    try sync(() => clock.set(failedAt + 3 * day))
    const swept = try cloud.inside(Effect.provideService(sweepSubscriptions(), Clock.Clock, clock.clock))
    const lapsedRow = try heldRow(cloud, organizationId)
    try sync(() => clock.set(failedAt + 3 * day + 300_000))
    const refreshed = try cloud.inside(Effect.provideService(sweepSubscriptions(), Clock.Clock, clock.clock))
    const refreshedRow = try heldRow(cloud, organizationId)
    try sync(() => lifecycle.cancel(bought.subscriptionId))
    const ended = try reconciledAt(cloud, organizationId, failedAt + 3 * day + 1000)
    const endedRow = try heldRow(cloud, organizationId)
    const again = try reconciledAt(cloud, organizationId, failedAt + 3 * day + 2000)
    const periodsAtEnd = try periodStatuses(cloud, organizationId)
    const first = `renewal/staging/${bought.invoiceId}`
    const second = `renewal/staging/${renewal.id}`
    const window = { tag: "DunningSince", startedAt: failedAt, endsAt: failedAt + 3 * day }
    try check(() => assert.deepStrictEqual(
      {
        paid: [paid.status, paid.planKey, paid.lastRenewalInvoice, paid.revision, paid.liveCommand.tag, paidRow],
        replay: [replay.revision, periodsAfterReplay],
        scheduled: [scheduled.planned, scheduled.revision, scheduledRow],
        renewed: [renewed.status, renewed.planKey, renewed.planned.tag, renewed.lastRenewalInvoice, renewed.revision, renewedRow, periodsAfterRenewal],
        dunning: [dunning.status, dunning.dunning, dunning.revision, stillDunning.dunning, stillDunning.revision, dunningRow],
        swept: [swept, lapsedRow, refreshed, refreshedRow],
        ended: [ended.status, ended.revision, endedRow, again, periodsAtEnd]
      },
      {
        paid: ["Active", "ProMonthly", bought.invoiceId, 2, "NoLiveCommand", ["active", "pro_monthly", null, null, 1, null, null]],
        replay: [2, [[first, "open"]]],
        scheduled: [{ tag: "DowngradeAtRenewal", planKey: "PlusMonthly" }, 3, ["active", "pro_monthly", "plus_monthly", null, 1, null, null]],
        renewed: ["Active", "PlusMonthly", "NoPlannedChange", renewal.id, 4, ["active", "plus_monthly", null, null, 2, null, null], [[first, "open"], [second, "open"]].sort()],
        dunning: ["Dunning", window, 5, window, 5, ["dunning", "plus_monthly", null, null, 3, failedAt, failedAt + 3 * day]],
        swept: [{ expired: 1, refreshed: 0 }, ["past_due", "plus_monthly", null, null, 4, failedAt, failedAt + 3 * day], { expired: 0, refreshed: 1 }, ["past_due", "plus_monthly", null, null, 4, failedAt, failedAt + 3 * day]],
        ended: ["Canceled", 7, ["canceled", "plus_monthly", null, null, 5, null, null], ended, [[first, "closed"], [second, "closed"]].sort()]
      }
    ))
  }), 60_000)
})

import { withRenewalPreview } from "./support/fakes/stripe-commands.ts"
import type { CommandView, CommandsPage as SubscriptionCommandsPage, RenewalReview } from "../src/billing/commands.vibe"

describe("WP4 Subscriptions and entitlements: cancel and undo", () => {
  effect function stripeCall(stripe: StripeFake, path: string, form: Readonly<Record<string, string>>) {
    const answer = try tryPromise(async () => await stripe.handler({ method: "POST", path, query: new URLSearchParams(), headers: { authorization: `Bearer ${fakeSecretKey}` }, body: new URLSearchParams(form).toString(), raw: new Uint8Array() }))
    return (answer?.body ?? {}) as { readonly id: string }
  }

  effect function subscribedOnPlus(cloud: TestCloud, stripe: StripeFake, organizationId: string, now: number) {
    const customer = try stripeCall(stripe, "/v1/customers", {})
    const session = try stripeCall(stripe, "/v1/checkout/sessions", { mode: "subscription", customer: customer.id, "line_items[0][price]": "price_plus", "line_items[0][quantity]": "1", success_url: "https://example.com/done" })
    const completed = try sync(() => stripe.completeSession(session.id, "paid"))
    const item = completed.subscription.items.data[0]
    const state: Subscription = {
      ...noSubscription, status: "Active", subscriptionId: completed.subscription.id, customer: { tag: "PinnedCustomer", customerId: customer.id },
      planKey: "PlusMonthly", periodStart: item.current_period_start * 1000, periodEnd: item.current_period_end * 1000, lastRenewalInvoice: completed.invoice.id, revision: 4
    }
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, provider_subscription_id, period_end, updated_at) VALUES ($1, $2, 4, 'active', 'plus_monthly', $3, $4, $5, $6)", [
      organizationId, JSON.stringify(state), customer.id, state.subscriptionId, state.periodEnd, now
    ])
    return state
  }

  function refusalOf(answer: { readonly status: number; readonly body: unknown }) {
    return [answer.status, (answer.body as { readonly error?: string }).error]
  }

  it.live("Cancel at the period end, undo it from a fresh session after reading the renewal, recover a lost reply by lookup, and refuse a stale revision (spec/cloud/billing/subscriptionCommands.md, \"Story: Change or cancel my plan without paying twice\"; spec/cloud/billing/subscriptionCommands.md, \"Story: Review a plan change before I confirm it\"; spec/cloud/billing/subscriptionCommands.md, \"Story: Get the plan I paid for\"; spec/cloud/billing/subscriptionCommands.md, \"Story: See my commands\")", () => scoped(effect {
    const stripe = try sync(() => createStripeFake())
    const cloud = try testCloud({ stripe: { ...stripe, handler: withRenewalPreview(stripe) } })
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "cancel@example.com")
    const earlier = try signedIn(cloud, "cancel@example.com")
    const other = try signedIn(cloud, "cancel-other@example.com")
    try sql(cloud, "UPDATE sessions SET auth_at = $2, step_up_at = 0 WHERE access_digest = $1", [tokenDigest(earlier.accessToken), now - 2 * 3_600_000])
    const as = (session: { readonly accessToken: string }) => ({ authorization: `Bearer ${session.accessToken}` })
    const subscription = try subscribedOnPlus(cloud, stripe, signed.organizationId, now)
    const id = subscription.subscriptionId
    const cancel = { subscriptionId: id, expectedSubscriptionRevision: 4, idempotencyKey: "cancel-key-0001" }

    const unfresh = try cloud.call("/api/v1/subscriptions/cancel", { json: cancel, headers: as(earlier) })
    const canceled = try cloud.call("/api/v1/subscriptions/cancel", { json: cancel, headers: as(signed) })
    const replayed = try cloud.call("/api/v1/subscriptions/cancel", { json: cancel, headers: as(signed) })
    const conflicting = try cloud.call("/api/v1/subscriptions/cancel", { json: { ...cancel, expectedSubscriptionRevision: 5 }, headers: as(signed) })
    const command = canceled.body as CommandView
    const afterCancel = try limitsOf(cloud, as(signed))

    const reviewed = try cloud.call("/api/v1/subscriptions/cancel/undo/review", { headers: as(signed) })
    const review = reviewed.body as RenewalReview
    const unreviewed = try cloud.call("/api/v1/subscriptions/cancel/undo", { json: { subscriptionId: id, expectedSubscriptionRevision: review.expectedSubscriptionRevision, idempotencyKey: "undo-key-unreviewed", quoteId: "quo_0000" }, headers: as(signed) })
    const stale = try cloud.call("/api/v1/subscriptions/cancel/undo", { json: { subscriptionId: id, expectedSubscriptionRevision: 4, idempotencyKey: "undo-key-stale", quoteId: review.quoteId }, headers: as(signed) })
    try sync(() => stripe.dropNextReply(`/v1/subscriptions/${id}`))
    const undone = try cloud.call("/api/v1/subscriptions/cancel/undo", { json: { subscriptionId: id, expectedSubscriptionRevision: review.expectedSubscriptionRevision, idempotencyKey: "undo-key-0001", quoteId: review.quoteId }, headers: as(signed) })
    const undo = undone.body as CommandView
    const afterUndo = try limitsOf(cloud, as(signed))

    const undoStatus = try cloud.call(`/api/v1/subscriptions/cancel/undo/${undo.commandId}`, { headers: as(signed) })
    const wrongKind = try cloud.call(`/api/v1/subscriptions/cancel/${undo.commandId}`, { headers: as(signed) })
    const foreign = try cloud.call(`/api/v1/subscriptions/cancel/${command.commandId}`, { headers: as(other) })
    const first = try cloud.call("/api/v1/subscriptions/commands?limit=1", { headers: as(signed) })
    const firstPage = first.body as SubscriptionCommandsPage
    const second = try cloud.call(`/api/v1/subscriptions/commands?limit=1&cursor=${firstPage.nextCursor ?? ""}`, { headers: as(signed) })
    const otherPage = try cloud.call("/api/v1/subscriptions/commands", { headers: as(other) })
    const provider = try sync(() => stripe.object(id) as { readonly cancel_at_period_end: boolean })
    const sent = cloud.fakes.seen.filter((request) => request.method === "POST" && request.path.endsWith(`/v1/subscriptions/${id}`)).map((request) => new URLSearchParams(request.body).get("cancel_at_period_end"))
    const lookups = cloud.fakes.seen.filter((request) => request.method === "GET" && request.path.endsWith(`/v1/subscriptions/${id}`)).length
    const live = (try sql(cloud, "SELECT state->'liveCommand'->>'tag' AS tag FROM subscriptions WHERE key = $1", [signed.organizationId]))[0]?.tag

    try check(() => assert.deepStrictEqual(
      {
        unfresh: refusalOf(unfresh),
        canceled: [canceled.status, command.kind, command.status, command.subscriptionId, command.expectedRevision, (command.resultRevision ?? 0) > 4, command.createdAt >= now],
        replayed: [replayed.status, replayed.body],
        conflicting: refusalOf(conflicting),
        afterCancel: [afterCancel.snapshot.subscription?.cancelAtPeriodEnd, afterCancel.snapshot.subscription?.control],
        review: [reviewed.status, review.subscriptionId, review.expectedSubscriptionRevision, review.review.kind, review.review.targetPlanKey, review.review.dueNow, review.review.recurringEstimate, review.review.effectiveAt, review.review.expiresAt - now <= 60_000 + 10_000],
        refused: [refusalOf(unreviewed), refusalOf(stale)],
        undone: [undone.status, undo.kind, undo.status, undo.expectedRevision, (undo.resultRevision ?? 0) > review.expectedSubscriptionRevision],
        afterUndo: [afterUndo.snapshot.subscription?.cancelAtPeriodEnd, afterUndo.snapshot.subscription?.control, live],
        reads: [undoStatus.status, undoStatus.body, refusalOf(wrongKind), refusalOf(foreign)],
        pages: [first.status, firstPage.items.map((item) => item.commandId), (second.body as SubscriptionCommandsPage).items.map((item) => item.commandId), (second.body as SubscriptionCommandsPage).nextCursor, (otherPage.body as SubscriptionCommandsPage).items],
        provider: [provider.cancel_at_period_end, sent, lookups >= 1]
      },
      {
        unfresh: [428, "fresh_session_required"],
        canceled: [200, "cancel", "succeeded", id, 4, true, true],
        replayed: [200, canceled.body],
        conflicting: [409, "idempotency_conflict"],
        afterCancel: [true, { action: "undo", eligible: true, expectedSubscriptionRevision: command.resultRevision }],
        review: [200, id, command.resultRevision, "renewal_estimate", "plus_monthly", { amountDueCents: 0 }, { amountDueCents: 3_000 }, subscription.periodEnd, true],
        refused: [[409, "billing_state_conflict"], [409, "stale_revision"]],
        undone: [200, "undo", "succeeded", command.resultRevision, true],
        afterUndo: [false, { action: "cancel", eligible: true, expectedSubscriptionRevision: undo.resultRevision }, "NoLiveCommand"],
        reads: [200, undone.body, [404, "not_found"], [404, "not_found"]],
        pages: [200, [undo.commandId], [command.commandId], null, []],
        provider: [false, ["true", "false"], true]
      }
    ))
  }))
})
