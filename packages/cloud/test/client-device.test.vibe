// spec/cloud/client.md, "Story: Use the cloud from the device as configured"
import { assert, describe, it } from "@effect/vitest"
import { addCredits } from "../src/billing/funds.vibe"
import { Store } from "../src/store/store.vibe"
import { landAccount } from "../src/identity/accounts.vibe"
import { setModelPrice } from "../src/services/models.vibe"
import { Deployment } from "../src/profile/profile.vibe"
import { legacyGrant } from "../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import { testCloud, type TestCloud } from "./support/cloud.vibe"
import { tokenDigest } from "../src/shared/sealing.vibe"
import { revokeAll } from "../src/native-clients/device-keys.vibe"
import { accountUsable, CloudError, createCloudClient, creditFromSnapshot, type CloudClient } from "../src/client/index.vibe"

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}
effect function check(run: () => void) {
  try Effect.try(run)
}
effect function entitledDevice(cloud: TestCloud, name: string, now: number, expiresAt: number) {
  const bearer = `eliza_mobile_${tokenDigest(name)}`
  const credentialId = `cred-${name}`
  const email = `${name}@example.com`
  const account = try cloud.store.transaction((tx) => landAccount(tx, { method: "EmailSignIn", subject: email }, email, now))
  const state = legacyGrant({ phase: "OldActive", client: { tag: "UnrecordedClient" }, codeExpiresAt: now - 1_000, credentialTtl: 0, credentialId, keyExpiresAt: expiresAt, epoch: 0, now })
  try sql(cloud, "INSERT INTO device_grants (key, state, revision, user_id, client_id, phase, credential_id, secret_digest, code_expires_at, key_expires_at, issued_at, updated_at) VALUES ($1,$2::jsonb,1,$3,'test-client','active',$4,$5,$6,$7,$6,$6)", [
    `grant-${name}`, JSON.stringify(state), account.userId, credentialId, tokenDigest(bearer), now - 1_000, expiresAt
  ])
  return { ...account, bearer }
}
function clientOf(baseUrl: string, credential: () => string): CloudClient {
  return createCloudClient({ baseUrl, credential })
}
effect function failureOf(run: () => Promise<unknown>) {
  return try promise(() => run().then(() => "succeeded", (error: unknown) => error instanceof CloudError ? error.failure : `threw ${String(error)}`))
}
const unknownKey = `eliza_mobile_${"0".repeat(64)}`

describe("Cloud device client", () => {
  it.live('A signed device reads through its current credential (spec/cloud/client.md, "Story: Tell an account that needs attention from a failing service")', () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const tomorrow = now + 86_400_000
    const live = try entitledDevice(cloud, "custody", now, tomorrow)
    const expiring = try entitledDevice(cloud, "expiring", now, now - 1)
    const ended = try entitledDevice(cloud, "ended", now, tomorrow)
    try cloud.store.transaction((tx) => revokeAll(tx, ended.userId, now))
    try cloud.inside(effect {
      const profile = (try Deployment).settings.inference
      if (profile === undefined) return try fail(new Error("missing test inference profile"))
      try cloud.store.transaction((tx) => setModelPrice(tx, profile, { modelId: "test-chat", inputPer1K: 1_000, outputPer1K: 2_000 }))
    })
    let held = unknownKey
    const client = clientOf(cloud.url, () => held)
    const unknown = try failureOf(() => client.account())
    held = expiring.bearer
    const expired = try failureOf(() => client.account())
    held = ended.bearer
    const revoked = try failureOf(() => client.account())
    held = live.bearer
    const account = try promise(() => client.account())
    const models = try promise(() => client.models())
    const referral = try promise(() => client.referral())
    const plans = try promise(() => client.plans())
    const keys = try promise(() => client.entitlementKeys())
    const token = try promise(() => client.entitlement())
    const commands = try promise(() => client.subscriptionCommands({ limit: 5 }))
    const badReferral = try failureOf(() => client.applyReferral("NOPE"))
    const unfunded = try promise(() => client.snapshot())
    provide Store = cloud.store {
      try addCredits({ organizationId: live.organizationId, amount: 5_000_000, requestKey: "u6-funding" })
    }
    const funded = try promise(() => client.snapshot())
    const consent = try failureOf(() => client.speechConsent())
    const revokedSelf = try promise(() => client.revokeSelf())
    const afterRevoke = try failureOf(() => client.account())
    try check(() => assert.deepStrictEqual(
      { unknown, expired, revoked, account: account.id, models: models.data.map((m) => m.id), referral: typeof referral.code, plans: plans.map((p) => p.key), keys: keys.length > 0, token: token.split(".").length, commands: commands.items.length, badReferral, usable: [accountUsable(unfunded), creditFromSnapshot(unfunded, unfunded.observedAt).kind, accountUsable(funded)], consent, revokedSelf, afterRevoke },
      { unknown: { tag: "CloudCredentialInvalid", reason: "CredentialUnknown" }, expired: { tag: "CloudCredentialInvalid", reason: "CredentialExpired" }, revoked: { tag: "CloudCredentialInvalid", reason: "CredentialRevoked" }, account: live.userId, models: ["test-chat"], referral: "string", plans: ["plus_monthly", "pro_monthly"], keys: true, token: 3, commands: 0, badReferral: { tag: "CloudRefused", code: "NotFound", reason: "NoReason" }, usable: [false, "zero", true], consent: "succeeded", revokedSelf: undefined, afterRevoke: { tag: "CloudCredentialInvalid", reason: "CredentialRevoked" } }
    ))
  }))

})
