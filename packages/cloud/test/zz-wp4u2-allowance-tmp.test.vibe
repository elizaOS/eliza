// spec/cloud/billing/allowance.md, "Story: Spend my plan's allowance before my credits, and never carry it over"
import { assert, describe, it } from "@effect/vitest"
import { markDispatched, reserve, settle } from "../src/shared/metering.vibe"
import { organization, testCloud, type TestCloud } from "./support/cloud.vibe"
import { periodRows } from "../src/shared/metering.vibe"

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}

import { addUtcMonths, adjustForUpgrade, allowanceView, clawBackInvoice, closePeriods, openGrantMonths, openRenewal, restoreInvoice, sweepAllowance } from "../src/billing/allowance.vibe"
import { loadRow as loadPeriodRow } from "../src/store/rows.vibe"

const allowanceMonth = 30 * 24 * 3_600_000

effect function periodStatuses(cloud: TestCloud, organizationId: string) {
  const rows = try sql(cloud, "SELECT key, status FROM allowance_periods WHERE organization_id = $1 ORDER BY key", [organizationId])
  return rows.map((row) => [row.key, row.status])
}

describe("WP4 Subscriptions and entitlements: allowance", () => {
  it.live("A refunded invoice claws back its allowance, and what its open hold returns, and is never restored (spec/cloud/billing/allowance.md, \"Story: Lose the allowance of a refunded invoice, and get it back if I win the dispute\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-refund")
    try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, period_end, updated_at) VALUES ('org-refund', '{}'::jsonb, 1, 'active', 'pro_monthly', $1, $2)", [now + allowanceMonth, now])
    const invoice = { invoiceId: "in_refund", planKey: "ProMonthly", startsAt: now - 1000, endsAt: now + allowanceMonth } as const
    const opened = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-refund", invoice, now))))
    const again = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-refund", invoice, now))))
    const ticket = try cloud.inside(reserve({ organizationId: "org-refund", userId: "user-refund" }, { service: "MeteredInference", caller: "user-refund", requestId: "refund-1", part: { tag: "WholeRequest" } }, 1_000_000))
    const clawed = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(clawBackInvoice(tx, "in_refund", "RefundClawback", now))))
    try cloud.inside(markDispatched(ticket.key))
    try cloud.inside(settle(ticket.key, { kind: "known", actual: 400_000 }))
    const restored = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(restoreInvoice(tx, "in_refund", now))))
    const view = try cloud.store.transaction((tx) => allowanceView(tx, "org-refund", now))
    const usage = try sql(cloud, "SELECT from_allowance, from_credits FROM usage_records WHERE hold_key = $1", [ticket.key])
    try check(() => assert.deepStrictEqual(
      {
        opened: [opened.key, opened.moved, opened.period.granted, again.moved],
        held: ticket.hold.fromAllowance > 0,
        clawed: [clawed.moved, clawed.period.phase, clawed.period.clawbackCause],
        restored: restored.moved,
        view,
        usage: usage.map((row) => [Number(row.from_allowance), Number(row.from_credits)])
      },
      {
        opened: ["renewal/staging/in_refund", true, 90_000_000, false],
        held: true,
        clawed: [true, "PeriodClawedBack", "RefundClawback"],
        restored: false,
        view: { state: "clawed_back", granted: 90_000_000, adjustment: 0, available: 0, reserved: 0, settled: 400_000, expired: 0, clawedBack: 89_600_000, periodStart: now - 1000, resetsAt: now + allowanceMonth },
        usage: [[400_000, 0]]
      }
    ))
  }))

  it.live("A won dispute restores the allowance while the period is open, and leaves an ended one clawed back (spec/cloud/billing/allowance.md, \"Story: Lose the allowance of a refunded invoice, and get it back if I win the dispute\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-dispute")
    const open = effect (invoiceId: string, startsAt: number, endsAt: number) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-dispute", { invoiceId, planKey: "PlusMonthly", startsAt, endsAt }, now))))).moved
    }
    const disputed = effect (invoiceId: string) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(clawBackInvoice(tx, invoiceId, "DisputeClawback", now))))).moved
    }
    const won = effect (invoiceId: string) => {
      return (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(restoreInvoice(tx, invoiceId, now))))).moved
    }
    const opened = [try open("in_won", now - 1000, now + allowanceMonth), try open("in_late", now - allowanceMonth, now - 1000)]
    const clawed = [try disputed("in_won"), try disputed("in_late")]
    const during = try cloud.store.transaction((tx) => allowanceView(tx, "org-dispute", now))
    const restored = [try won("in_won"), try won("in_late")]
    const after = try cloud.store.transaction((tx) => allowanceView(tx, "org-dispute", now))
    const refundedLate = (try cloud.inside(cloud.store.transaction((tx) => cloud.inside(clawBackInvoice(tx, "in_late", "RefundClawback", now))))).moved
    const late = (try cloud.store.transaction((tx) => loadPeriodRow(tx, periodRows, "renewal/staging/in_late", false))).state
    const statuses = try periodStatuses(cloud, "org-dispute")
    try check(() => assert.deepStrictEqual(
      {
        opened, clawed,
        during: [during?.state, during?.available, during?.clawedBack],
        restored,
        after: [after?.state, after?.available, after?.clawedBack, after?.resetsAt],
        refundedLate,
        late: [late.phase, late.clawbackCause, late.clawedBack, late.available],
        statuses
      },
      {
        opened: [true, true],
        clawed: [true, true],
        during: ["clawed_back", 0, 25_000_000],
        restored: [true, false],
        after: ["open", 25_000_000, 0, now + allowanceMonth],
        refundedLate: true,
        late: ["PeriodClawedBack", "RefundClawback", 25_000_000, 0],
        statuses: [["renewal/staging/in_late", "clawed_back"], ["renewal/staging/in_won", "open"]]
      }
    ))
  }))

  it.live("A period expires at its end and its unused allowance is forfeited, while the sweep opens the months of a grant in force (spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-renewed")
    try organization(cloud, "org-granted")
    const ended = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-renewed", { invoiceId: "in_old", planKey: "ProMonthly", startsAt: now - allowanceMonth, endsAt: now - 1000 }, now))))
    const grantFrom = now - 1000
    const firstMonthEnds = addUtcMonths(grantFrom, 1)
    const grantUntil = firstMonthEnds + 10 * 24 * 3_600_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-pilot', 'org-granted', 'pilot', 'plus_monthly', $1, $2, $1)", [grantFrom, grantUntil])
    const swept = try cloud.inside(sweepAllowance())
    const sweptAgain = try cloud.inside(sweepAllowance())
    const renewed = try cloud.store.transaction((tx) => allowanceView(tx, "org-renewed", now))
    const granted = try cloud.store.transaction((tx) => allowanceView(tx, "org-granted", now))
    const partial = (try cloud.store.transaction((tx) => loadPeriodRow(tx, periodRows, "grant/grant-pilot/1", false))).state
    const statuses = [try periodStatuses(cloud, "org-renewed"), try periodStatuses(cloud, "org-granted")]
    try check(() => assert.deepStrictEqual(
      {
        ended: ended.moved,
        swept, sweptAgain,
        renewed,
        granted: [granted?.state, granted?.granted, granted?.available, granted?.periodStart, granted?.resetsAt],
        partial: [partial.phase, partial.startsAt, partial.endsAt, partial.granted > 0 && partial.granted < 25_000_000],
        statuses
      },
      {
        ended: true,
        swept: { expired: 1, opened: 2 },
        sweptAgain: { expired: 0, opened: 0 },
        renewed: { state: "expired", granted: 90_000_000, adjustment: 0, available: 0, reserved: 0, settled: 0, expired: 90_000_000, clawedBack: 0, periodStart: now - allowanceMonth, resetsAt: now - 1000 },
        granted: ["open", 25_000_000, 25_000_000, grantFrom, firstMonthEnds],
        partial: ["PeriodOpen", firstMonthEnds, grantUntil, true],
        statuses: [[["renewal/staging/in_old", "expired"]], [["grant/grant-pilot/0", "open"], ["grant/grant-pilot/1", "open"]]]
      }
    ))
  }))

  it.live("An upgrade mid-period adds exactly the reviewed prorated difference once, and periods close when the subscription ends or a grant is revoked or superseded (spec/cloud/billing/allowance.md, \"Story: Get more allowance when I upgrade mid-period\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    try organization(cloud, "org-upgrade")
    try organization(cloud, "org-grants")
    const day = 24 * 3_600_000
    try cloud.inside(cloud.store.transaction((tx) => cloud.inside(openRenewal(tx, "org-upgrade", { invoiceId: "in_up", planKey: "PlusMonthly", startsAt: now - 10 * day, endsAt: now + 20 * day }, now))))
    const reviewed = Math.floor((90_000_000 - 25_000_000) * (20 * 24 * 60) / (30 * 24 * 60))
    const upgrade = effect (amount: number) => {
      return try cloud.store.transaction((tx) => adjustForUpgrade(tx, "org-upgrade", "ProMonthly", now, amount, now))
    }
    const wrong = try upgrade(reviewed + 1)
    const right = try upgrade(reviewed)
    const twice = try upgrade(reviewed)
    const upgraded = try cloud.store.transaction((tx) => allowanceView(tx, "org-upgrade", now))
    const ended = try cloud.store.transaction((tx) => closePeriods(tx, "org-upgrade", { kind: "SubscriptionEnded" }, now))
    const closedRenewal = try cloud.store.transaction((tx) => allowanceView(tx, "org-upgrade", now))
    const lifetime = { id: "grant-life", planKey: "PlusMonthly", effectiveFrom: now - 1000, effectiveUntil: null } as const
    const monthly = { id: "grant-month", planKey: "PlusMonthly", effectiveFrom: now - 1000, effectiveUntil: addUtcMonths(now - 1000, 1) } as const
    const life = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", lifetime, now))
    const lifeAgain = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", lifetime, now))
    const month = try cloud.store.transaction((tx) => openGrantMonths(tx, "org-grants", monthly, now))
    const revoked = try cloud.store.transaction((tx) => closePeriods(tx, "org-grants", { kind: "GrantRevoked", grantId: "grant-life" }, now))
    const superseded = try cloud.store.transaction((tx) => closePeriods(tx, "org-grants", { kind: "SupersededByPaid" }, now))
    const statuses = try periodStatuses(cloud, "org-grants")
    try check(() => assert.deepStrictEqual(
      {
        upgrade: [wrong.moved, right.moved, right.period.planKey, right.period.adjustment, twice.moved],
        upgraded: [upgraded?.state, upgraded?.granted, upgraded?.adjustment, upgraded?.available],
        ended: ended.map((step) => [step.key, step.period.phase]),
        closedRenewal: [closedRenewal?.state, closedRenewal?.available, closedRenewal?.expired],
        opened: [life.map((step) => step.key), lifeAgain.length, month.map((step) => step.key)],
        revoked: revoked.map((step) => step.key),
        superseded: superseded.map((step) => step.key),
        statuses
      },
      {
        upgrade: [false, true, "ProMonthly", reviewed, false],
        upgraded: ["open", 25_000_000, reviewed, 25_000_000 + reviewed],
        ended: [["renewal/staging/in_up", "PeriodClosed"]],
        closedRenewal: ["closed", 0, 25_000_000 + reviewed],
        opened: [["grant/grant-life/0", "grant/grant-life/1", "grant/grant-life/2"], 0, ["grant/grant-month/0"]],
        revoked: ["grant/grant-life/0", "grant/grant-life/1", "grant/grant-life/2"],
        superseded: ["grant/grant-month/0"],
        statuses: [["grant/grant-life/0", "closed"], ["grant/grant-life/1", "closed"], ["grant/grant-life/2", "closed"], ["grant/grant-month/0", "closed"]]
      }
    ))
  }))
})
