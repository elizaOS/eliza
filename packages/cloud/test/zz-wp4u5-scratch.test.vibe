// spec/cloud/billing/subscriptions.md, "Story: Read my invoices and open the billing portal"
import { assert, describe, it } from "@effect/vitest"
import { addCredits } from "../src/billing/funds.vibe"
import { Store, type Tx } from "../src/store/store.vibe"
import { testCloud, type TestCloud } from "./support/cloud.vibe"
import { periodRows } from "../src/shared/metering.vibe"
import { stepRow } from "../src/store/rows.vibe"
import { signedIn } from "./support/identity-fixture.ts"
import { accountUsable } from "../src/client/index.vibe"

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}

import { initial as noSubscription, type Subscription } from "../gen/cloud__billing__subscriptions.ts"
import type { BillingSnapshot } from "../src/billing/snapshot.vibe"
import type { InvoiceDetail, InvoicePage } from "../src/billing/invoices.vibe"
import { createStripeInvoicesFake } from "./support/fakes/stripe-invoices.ts"

effect function subscribedTo(cloud: TestCloud, organizationId: string, customerId: string, now: number) {
  const state: Subscription = {
    ...noSubscription, status: "Active", subscriptionId: `sub_${organizationId}`, customer: { tag: "PinnedCustomer", customerId },
    planKey: "PlusMonthly", periodStart: now - 60_000, periodEnd: now + 30 * 24 * 3_600_000, revision: 4
  }
  try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, provider_subscription_id, period_end, updated_at) VALUES ($1, $2, 4, 'active', 'plus_monthly', $3, $4, $5, $6)", [
    organizationId, JSON.stringify(state), customerId, state.subscriptionId, state.periodEnd, now
  ])
  return state
}

effect function limitsOf(cloud: TestCloud, headers: Readonly<Record<string, string>>) {
  const answer = try cloud.call("/api/v1/billing/limits", { headers })
  return { status: answer.status, snapshot: (answer.body as { readonly data: BillingSnapshot }).data, error: (answer.body as { readonly error?: string }).error }
}

describe("WP4 Subscriptions and entitlements: snapshot and invoices", () => {
  it.live("Read my billing state in one snapshot as a free, granted and paid account, or a whole 503 (spec/cloud/billing/subscriptions.md, \"Story: Keep my plan as the provider says it is\"; spec/cloud/billing/subscriptions.md, \"Story: Change my plan one command at a time\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const signed = try signedIn(cloud, "snapshot@example.com")
    const organizationId = signed.organizationId
    const headers = { authorization: `Bearer ${signed.accessToken}` }
    const anonymous = try cloud.call("/api/v1/billing/limits")
    const free = try limitsOf(cloud, headers)

    provide Store = cloud.store {
      try addCredits({ organizationId, amount: 2_000_000, requestKey: "snapshot-credits" })
    }
    const grantEnds = now + 10 * 60_000
    try sql(cloud, "INSERT INTO grants (id, organization_id, family, plan_key, effective_from, effective_until, created_at) VALUES ('grant-snapshot', $1, 'pilot', 'plus_monthly', $2, $3, $2)", [organizationId, now - 1000, grantEnds])
    const granted = try limitsOf(cloud, headers)

    const subscription = try subscribedTo(cloud, organizationId, "cus_snapshot", now)
    const resetsAt = now + 20 * 60_000
    try cloud.store.transaction((tx) => stepRow(tx, periodRows, "renewal/staging/in_snapshot", { type: "openRenewal", invoiceId: "in_snapshot", planKey: "PlusMonthly", startsAt: now - 1000, endsAt: resetsAt }, () => ({
      organization_id: organizationId, status: "open", period_start: now - 1000, period_end: resetsAt, updated_at: now
    })))
    const paid = try limitsOf(cloud, headers)
    try sql(cloud, "UPDATE subscriptions SET state = '{\"status\":\"Gold\"}'::jsonb WHERE key = $1", [organizationId])
    const unreadable = try limitsOf(cloud, headers)

    const grant = { id: "grant-snapshot", planKey: "plus_monthly", family: "pilot", effectiveFrom: now - 1000, effectiveUntil: grantEnds, revoked: false }
    try check(() => assert.deepStrictEqual(
      {
        anonymous: [anonymous.status, (anonymous.body as { readonly error: string }).error],
        free: [free.status, free.snapshot.observedAt >= now, { ...free.snapshot, observedAt: 0, balance: { ...free.snapshot.balance, revision: 0 } }, accountUsable(free.snapshot)],
        granted: [granted.status, granted.snapshot.balance.usdMicros, granted.snapshot.balance.revision > free.snapshot.balance.revision, granted.snapshot.plan, granted.snapshot.grant, granted.snapshot.subscription, granted.snapshot.funding],
        paid: [paid.status, paid.snapshot.plan, paid.snapshot.subscription, paid.snapshot.grant, paid.snapshot.allowance, paid.snapshot.funding, accountUsable(paid.snapshot)],
        unreadable: [unreadable.status, unreadable.error]
      },
      {
        anonymous: [401, "authentication_required"],
        free: [200, true, {
          schemaVersion: 3, observedAt: 0, account: { status: "active" }, balance: { usdMicros: 0, revision: 0 },
          plan: { key: "free", source: "free", effectiveUntil: null }, subscription: null, grant: null, allowance: null,
          funding: { inference: "creditsOnly", speech: "creditsOnly", maps: "creditsOnly" }
        }, false],
        granted: [200, 2_000_000, true, { key: "plus_monthly", source: "grant", effectiveUntil: grantEnds }, grant, null, { inference: "allowanceThenCredits", speech: "allowanceThenCredits", maps: "allowanceThenCredits" }],
        paid: [200, { key: "plus_monthly", source: "subscription", effectiveUntil: subscription.periodEnd }, {
          id: subscription.subscriptionId, planKey: "plus_monthly", status: "active", periodStart: subscription.periodStart, periodEnd: subscription.periodEnd,
          cancelAtPeriodEnd: false, pendingPlanKey: null, dunningEndsAt: null, revision: 4,
          control: { action: "cancel", eligible: true, expectedSubscriptionRevision: 4 }
        }, grant, {
          state: "open", granted: 25_000_000, adjustment: 0, available: 25_000_000, reserved: 0, settled: 0, expired: 0, clawedBack: 0, periodStart: now - 1000, resetsAt
        }, { inference: "allowanceThenCredits", speech: "allowanceThenCredits", maps: "allowanceThenCredits" }, true],
        unreadable: [503, "service_unavailable"]
      }
    ))
  }))

  it.live("Read only my pinned customer's invoices, a page at a time (spec/cloud/billing/subscriptions.md, \"Story: Read my invoices and open the billing portal\")", () => scoped(effect {
    const stripe = try sync(() => createStripeInvoicesFake())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/stripe/", stripe.handler) })
    const now = try Clock.currentTimeMillis
    const own = try signedIn(cloud, "invoices@example.com")
    const other = try signedIn(cloud, "other-invoices@example.com")
    const unpinned = try signedIn(cloud, "unpinned@example.com")
    try subscribedTo(cloud, own.organizationId, "cus_own", now)
    try subscribedTo(cloud, other.organizationId, "cus_other", now)
    const day = 86_400
    const at = Math.floor(now / 1000) - 60 * day
    const ids = try sync(() => ({
      first: stripe.invoice({ customer: "cus_own", amountCents: 3_000, periodStart: at, periodEnd: at + 30 * day, lines: 12 }),
      second: stripe.invoice({ customer: "cus_own", amountCents: 3_000, status: "open", periodStart: at + 30 * day, periodEnd: at + 60 * day }),
      draft: stripe.invoice({ customer: "cus_own", amountCents: 3_000, status: "draft", periodStart: at + 60 * day, periodEnd: at + 90 * day }),
      foreign: stripe.invoice({ customer: "cus_other", amountCents: 10_000, periodStart: at, periodEnd: at + 30 * day })
    }))
    const as = (signed: { readonly accessToken: string }) => ({ headers: { authorization: `Bearer ${signed.accessToken}` } })
    const firstPage = try cloud.call("/api/v1/billing/invoices?limit=2", as(own))
    const nextPage = try cloud.call(`/api/v1/billing/invoices?limit=2&cursor=${ids.second}`, as(own))
    const detail = try cloud.call(`/api/v1/billing/invoices/${ids.first}`, as(own))
    const foreign = try cloud.call(`/api/v1/billing/invoices/${ids.foreign}`, as(own))
    const draft = try cloud.call(`/api/v1/billing/invoices/${ids.draft}`, as(own))
    const otherList = try cloud.call("/api/v1/billing/invoices", as(other))
    const unpinnedList = try cloud.call("/api/v1/billing/invoices", as(unpinned))
    const unpinnedDetail = try cloud.call(`/api/v1/billing/invoices/${ids.first}`, as(unpinned))
    const badLimit = try cloud.call("/api/v1/billing/invoices?limit=500", as(own))
    const anonymous = try cloud.call("/api/v1/billing/invoices")
    const read = detail.body as InvoiceDetail
    const errorOf = (answer: { readonly status: number; readonly body: unknown }) => [answer.status, (answer.body as { readonly error: string }).error]
    try check(() => assert.deepStrictEqual(
      {
        firstPage: [firstPage.status, firstPage.body],
        nextPage: [nextPage.status, (nextPage.body as InvoicePage).invoices.map((invoice) => invoice.id), (nextPage.body as InvoicePage).nextCursor],
        detail: [detail.status, read.id, read.status, read.lines.length, read.lines.reduce((sum, line) => sum + line.amountCents, 0), read.periodStart, read.periodEnd, read.pdfUrl, read.lines[11]?.periodEnd],
        foreign: errorOf(foreign),
        draft: errorOf(draft),
        otherList: (otherList.body as InvoicePage).invoices.map((invoice) => invoice.id),
        unpinned: [unpinnedList.status, unpinnedList.body, ...errorOf(unpinnedDetail)],
        refused: [badLimit.status, anonymous.status]
      },
      {
        firstPage: [200, {
          invoices: [{ id: ids.second, number: "FAKE-0002", date: (at + 30 * day) * 1000, status: "open", amountDueCents: 3_000, amountPaidCents: 0, currency: "usd", hostedInvoiceUrl: `https://invoice.stripe.com/i/${ids.second}` }],
          nextCursor: ids.second
        }],
        nextPage: [200, [ids.first], null],
        detail: [200, ids.first, "paid", 12, 3_000, at * 1000, (at + 30 * day) * 1000, `https://pay.stripe.com/invoice/${ids.first}/pdf`, (at + 30 * day) * 1000],
        foreign: [404, "not_found"],
        draft: [404, "not_found"],
        otherList: [ids.foreign],
        unpinned: [200, { invoices: [], nextCursor: null }, 404, "not_found"],
        refused: [400, 401]
      }
    ))
  }))

  it.live("Open the billing portal only for my pinned customer with a fresh session (spec/cloud/billing/subscriptions.md, \"Story: Read my invoices and open the billing portal\")", () => scoped(effect {
    const stripe = try sync(() => createStripeInvoicesFake())
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/stripe/", stripe.handler) })
    const now = try Clock.currentTimeMillis
    const own = try signedIn(cloud, "portal@example.com")
    const unpinned = try signedIn(cloud, "portal-unpinned@example.com")
    try subscribedTo(cloud, own.organizationId, "cus_portal", now)
    try sync(() => stripe.customer("cus_portal"))
    const portal = (signed: { readonly accessToken: string }) => cloud.call("/api/v1/subscriptions/portal", { method: "POST", headers: { authorization: `Bearer ${signed.accessToken}` } })
    const first = try portal(own)
    const second = try portal(own)
    const noCustomer = try portal(unpinned)
    try sql(cloud, "UPDATE sessions SET auth_at = $2 WHERE user_id = $1", [own.user.id, now - 2 * 3_600_000])
    const stale = try portal(own)
    const urls = [first.body, second.body].map((body) => (body as { readonly url: string }).url)
    const configuration = stripe.configurations[0]
    try check(() => assert.deepStrictEqual(
      {
        opened: [first.status, second.status, urls.every((url) => url.startsWith("https://billing.stripe.com/")), new Set(urls).size],
        sessions: stripe.portalSessions.map((session) => [session.customer, session.configuration]),
        configuration: [stripe.configurations.length, configuration?.features.subscription_cancel, configuration?.features.subscription_update.enabled, configuration?.features.customer_update.enabled],
        noCustomer: [noCustomer.status, (noCustomer.body as { readonly error: string }).error],
        stale: [stale.status, (stale.body as { readonly error: string }).error, stripe.portalSessions.length]
      },
      {
        opened: [200, 200, true, 2],
        sessions: [["cus_portal", configuration?.id ?? ""], ["cus_portal", configuration?.id ?? ""]],
        configuration: [1, { enabled: true, mode: "at_period_end", proration_behavior: "none" }, false, false],
        noCustomer: [409, "billing_state_conflict"],
        stale: [428, "fresh_session_required", 2]
      }
    ))
  }))
})

