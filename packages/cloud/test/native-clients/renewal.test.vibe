// spec/cloud/nativeClients/deviceKeys.md, "Story: Keep my phone signed in without a browser"; spec/cloud/nativeClients/deviceKeys.md, "Signing out ends the presenting key and every key renewed from it, unless it names its acknowledged successor"
import { assert, describe, it } from "@effect/vitest"
import { codeLifetime, renewalCap } from "../../gen/cloud__nativeClients__deviceKeys.ts"
import { seedClients } from "../../src/operator/clients.vibe"
import { deploymentLayer, parseProfile } from "../../src/profile/profile.vibe"
import { Store } from "../../src/store/store.vibe"
import fixtureSeed from "../fixtures/seed.json" with { type: "json" }
import { testCloud, type TestCloud } from "../support/cloud.vibe"
import { manualClock } from "../support/clock.ts"
import { s256, signedIn } from "../support/identity-fixture.ts"
import { testProfile } from "../support/profile.ts"

const binding = { clientId: "com.example.fixture", environment: "staging", redirectUri: "https://www.staging.example.com/apps/fixture/sign-in" }
const day = 86_400_000
const start = 1_000_000

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}

function bearer(token: string) {
  return { authorization: `Bearer ${token}` }
}

function failure(body: unknown): unknown {
  const refusal = body as { readonly error?: string; readonly reason?: string }
  return [refusal.error, refusal.reason]
}

interface Key {
  readonly credentialId: string
  readonly secret: string
}

effect function seeded(cloud: TestCloud) {
  const profile = try parseProfile(try sync(() => testProfile(cloud.fakes.url)))
  const now = try Clock.currentTimeMillis
  provide Store = cloud.store, deploymentLayer(profile, "staging") {
    try cloud.store.transaction((tx) => seedClients(tx, fixtureSeed.clients, now))
  }
}

effect function finish(cloud: TestCloud, code: string, state: string, verifier: string) {
  const minted = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...binding, grantType: "authorization_code", code, state, codeVerifier: verifier } })
  const key = minted.body as Key
  const acked = try cloud.call("/api/v1/app-auth/mobile/ack", { json: { credentialId: key.credentialId, secret: key.secret } })
  return { minted, key, acked }
}

effect function signedInDevice(cloud: TestCloud, accessToken: string) {
  const state = "s".repeat(43)
  const verifier = "v".repeat(43)
  const connected = try cloud.call("/api/v1/app-auth/connect", { headers: bearer(accessToken), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256", deviceName: "Ada's phone" } })
  return (try finish(cloud, (connected.body as { readonly code: string }).code, state, verifier)).key
}

effect function renew(cloud: TestCloud, secret: string, letter: string) {
  const state = letter.repeat(43)
  const verifier = letter.toUpperCase().repeat(43)
  const answer = try cloud.call("/api/v1/app-auth/mobile/renew", { headers: bearer(secret), json: { ...binding, state, codeChallenge: s256(verifier), codeChallengeMethod: "S256", deviceName: "Ada's phone" } })
  return { answer, state, verifier }
}

effect function usable(cloud: TestCloud, secret: string) {
  return (try cloud.call("/api/v1/user", { headers: bearer(secret) })).status
}

describe("Device key renewal (spec/cloud/nativeClients/deviceKeys.md)", () => {
  it.live("Renew a live key, finish its successor and retire the old key by naming the successor (spec/cloud/nativeClients/deviceKeys.md, \"A live key of its own client gets its successor's code, which inherits the sign-in and ends by the sign-in's six-month cap\")", () => scoped(effect {
    const clock = try sync(() => manualClock())
    try sync(() => clock.set(start))
    provide Clock.Clock = clock.clock {
    const cloud = try testCloud()
    try seeded(cloud)
    const signed = try signedIn(cloud, "renewal@example.com")
    const old = try signedInDevice(cloud, signed.accessToken)
    const bySession = try renew(cloud, signed.accessToken, "a")
    const renewed = try renew(cloud, old.secret, "b")
    const opened = renewed.answer.body as { readonly success: unknown; readonly code: string; readonly codeType: string; readonly expiresIn: number; readonly renewableUntil: string }
    const successor = try finish(cloud, opened.code, renewed.state, renewed.verifier)
    const recorded = try sql(cloud, "SELECT g.sign_in_at, g.renewed_from = p.key AS linked FROM device_grants g JOIN device_grants p ON p.credential_id = $2 WHERE g.credential_id = $1", [successor.key.credentialId, old.credentialId])
    const bothUsable = [try usable(cloud, old.secret), try usable(cloud, successor.key.secret)]
    const retired = try cloud.call("/api/v1/api-keys/current", { method: "DELETE", headers: { ...bearer(old.secret), "x-renewed-credential-id": successor.key.credentialId } })
    const afterRetirement = [try usable(cloud, old.secret), try usable(cloud, successor.key.secret)]
    try check(() => assert.deepStrictEqual({
      bySession: [bySession.answer.status, failure(bySession.answer.body)],
      renewed: [renewed.answer.status, opened.success, /^emac_[0-9a-f]{64}$/.test(opened.code), opened.codeType, opened.expiresIn, opened.renewableUntil],
      successor: [successor.minted.status, successor.acked.status, successor.key.credentialId !== old.credentialId],
      recorded: [Number(recorded[0]?.sign_in_at), recorded[0]?.linked],
      bothUsable,
      retired: retired.status,
      afterRetirement
    }, {
      bySession: [401, ["authentication_required", "credential_unknown"]],
      renewed: [200, true, true, "mobile_app_auth_code", 300, new Date(start + renewalCap).toISOString()],
      successor: [200, 200, true],
      recorded: [start, true],
      bothUsable: [200, 200],
      retired: 204,
      afterRetirement: [401, 200]
    }))
    }
  }))

  it.live("Renewing a key whose successor was acknowledged ends every key of the sign-in (spec/cloud/nativeClients/deviceKeys.md, \"A key has at most one live successor, and renewing a key whose successor was acknowledged ends the sign-in\")", () => scoped(effect {
    const clock = try sync(() => manualClock())
    try sync(() => clock.set(start))
    provide Clock.Clock = clock.clock {
    const cloud = try testCloud()
    try seeded(cloud)
    const signed = try signedIn(cloud, "reuse@example.com")
    const old = try signedInDevice(cloud, signed.accessToken)
    const superseded = try renew(cloud, old.secret, "c")
    const abandoned = try renew(cloud, old.secret, "x")
    const renewed = try renew(cloud, old.secret, "d")
    const stale = try cloud.call("/api/v1/app-auth/mobile/token", { json: { ...binding, grantType: "authorization_code", code: (superseded.answer.body as { readonly code: string }).code, state: superseded.state, codeVerifier: superseded.verifier } })
    const successor = try finish(cloud, (renewed.answer.body as { readonly code: string }).code, renewed.state, renewed.verifier)
    const reused = try renew(cloud, old.secret, "e")
    const after = [try usable(cloud, old.secret), try usable(cloud, successor.key.secret)]
    try check(() => assert.deepStrictEqual({
      superseded: [superseded.answer.status, stale.status],
      abandoned: abandoned.answer.status,
      successor: [successor.minted.status, successor.acked.status],
      reused: [reused.answer.status, failure(reused.answer.body)],
      after
    }, {
      superseded: [200, 401],
      abandoned: 200,
      successor: [200, 200],
      reused: [401, ["authentication_required", "credential_revoked"]],
      after: [401, 401]
    }))
    }
  }))

  it.live("Close renewal at the sign-in's cap, shorten the last successor, and end it when the old key signs out without naming it (spec/cloud/nativeClients/deviceKeys.md, \"Story: Keep my phone signed in without a browser\")", () => scoped(effect {
    const clock = try sync(() => manualClock())
    try sync(() => clock.set(start))
    provide Clock.Clock = clock.clock {
    const cloud = try testCloud()
    try seeded(cloud)
    const signed = try signedIn(cloud, "cap@example.com")
    const old = try signedInDevice(cloud, signed.accessToken)
    const later = start + 25 * day
    try sync(() => clock.set(later))
    try sql(cloud, "UPDATE device_grants SET sign_in_at = $2 WHERE credential_id = $1", [old.credentialId, later - renewalCap + day / 2])
    const closed = try renew(cloud, old.secret, "f")
    try sql(cloud, "UPDATE device_grants SET sign_in_at = $2 WHERE credential_id = $1", [old.credentialId, later - renewalCap + 10 * day])
    const last = try renew(cloud, old.secret, "g")
    const successor = try finish(cloud, (last.answer.body as { readonly code: string }).code, last.state, last.verifier)
    const signedOut = try cloud.call("/api/v1/api-keys/current", { method: "DELETE", headers: bearer(old.secret) })
    const after = [try usable(cloud, old.secret), try usable(cloud, successor.key.secret)]
    try check(() => assert.deepStrictEqual({
      closed: [closed.answer.status, failure(closed.answer.body)],
      last: [last.answer.status, (last.answer.body as { readonly renewableUntil: string }).renewableUntil],
      shortened: (successor.acked.body as { readonly expiresAt: string }).expiresAt,
      signedOut: signedOut.status,
      after
    }, {
      closed: [409, ["renewal_window_closed", undefined]],
      last: [200, new Date(start + 35 * day).toISOString()],
      shortened: new Date(start + 35 * day - codeLifetime).toISOString(),
      signedOut: 204,
      after: [401, 401]
    }))
    }
  }))
})
