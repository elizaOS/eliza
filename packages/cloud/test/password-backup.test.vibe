// spec/cloud/index.md, "Story: Back up my passwords for another device"
import { assert, describe, it } from "@effect/vitest"
import { SecureRandom } from "effect/crypto"
import { apply, initial } from "../gen/cloud__identity__sessions.effect.vibe"
import { signInWithProof, type BrowserSession } from "../src/identity-store.vibe"
import { s256, tokenDigest } from "../src/shared/credential-crypto.vibe"
import { migrate, storeLayer } from "../src/store/store.vibe"
import { cloudWorker, type CloudBindings } from "../src/worker.vibe"
import { androidCredentialTtlMs, coldPasswordRecovery, fixtureDevices } from "./support/cold-password-backup.vibe"
import { openBackupDatabase, webRequest } from "./support/password-backup.ts"

const identity = "a".repeat(64)
const clientId = "com.example.consumer"
const webOrigin = "https://consumer.example.test"
const apiOrigin = "https://api.consumer.example.test"
const redirectUri = webOrigin + "/android/auth/callback"
const path = "/api/v1/app-auth/mobile/password-backup"
const registration = { clientId, environment: "staging", displayName: "Consumer", androidPackage: clientId, signInReturn: redirectUri,
  billingReturn: webOrigin + "/billing/return", enabled: true, nativeGoogle: true, credentialTtlMs: androidCredentialTtlMs, certFingerprints: [Array(32).fill("AA").join(":")] }
const verifier = "v".repeat(43)
const state = "s".repeat(43)
const headers = { "content-type": "application/json" }

schema BrowserReturn { redirectUrl: string }
schema NativeEnrollment { token: string; accountId: string; expiresIn: number }
schema GoogleChallenge { challengeId: string; expiresIn: number }
schema NativeConfig { credentialTtlMs: number }
const Grant = Schema.Struct({ code: Schema.NullOr(Schema.String), ownerId: Schema.String, scope: Schema.String,
  revision: Schema.NullOr(Schema.String), present: Schema.Boolean })

function browser(user: BrowserSession) {
  return { ...headers, origin: webOrigin, cookie: "__Host-eliza-session=" + user.access }
}

function bearer(credential: string) {
  return { ...headers, authorization: "Bearer " + credential }
}

effect function check(f: () => void) {
  try Effect.try(f)
}

effect function decode<A>(response: Response, schema: Schema.Decoder<A>) {
  try check(() => assert.equal(response.status, 200))
  return try Schema.decodeUnknownEffect(schema)(try tryPromise(() => response.json()))
}

describe("Password backup (spec/cloud/index.md, \"Story: Back up my passwords for another device\")", () => {
  it.live("a recent browser consent returns a code that only its enrolled owner can redeem", () => scoped(effect {
    const { db, databaseUrl, pendingMigrations } = try acquireRelease(tryPromise(() => openBackupDatabase(true)), (fixture) => promise(() => fixture.close()))
    try tryPromise(() => db.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, 'staging', 1)", [identity]))
    const env = { DATABASE_URL: databaseUrl, CLOUD_IDENTITY_DIGEST: identity, CLOUD_ENVIRONMENT: "staging", PUBLIC_API_ORIGIN: apiOrigin,
      WEB_ORIGIN: webOrigin, NATIVE_CLIENT_ID: clientId, NATIVE_AUTH_CALLBACK: redirectUri, NATIVE_CLIENT_REGISTRY: JSON.stringify([registration]),
      GOOGLE_CLIENT_ID: "123456-example.apps.googleusercontent.com", GOOGLE_CLIENT_SECRET: "unusable",
      INFERENCE_BASE_URL: "https://inference.example.test", INFERENCE_API_KEY: "unusable", CHAT_MODEL: "synthetic", EMBEDDING_MODEL: "synthetic",
      CHAT_INPUT_MICROS_PER_1K: "1", CHAT_OUTPUT_MICROS_PER_1K: "1", EMBEDDING_INPUT_MICROS_PER_1K: "1", MAX_COMPLETION_TOKENS: "1",
      STRIPE_SECRET_KEY: "unusable", STRIPE_WEBHOOK_SECRET: "unusable", STRIPE_PRICE_ID: "unusable", STRIPE_PRODUCT_ID: "unusable", STRIPE_PLAN: "plus_monthly" } satisfies CloudBindings
    const worker = cloudWorker<CloudBindings>()
    const call = (route: string, init?: RequestInit, overrides?: Partial<Pick<CloudBindings, "CLOUD_IDENTITY_DIGEST" | "NATIVE_CLIENT_REGISTRY">>) =>
      tryPromise(() => worker.fetch(webRequest(apiOrigin + route, init), { ...env, ...overrides }))
    const post = (route: string, body: object, requestHeaders: Record<string, string>) =>
      call(route, { method: "POST", headers: requestHeaders, body: JSON.stringify(body) })
    const signIn = (name: string) => Effect.provide(signInWithProof(db, { provider: "google", subject: name + "-proof",
      email: name + "@example.test" }), SecureRandom.layerWebCrypto)
    const configQuery = new URLSearchParams({ clientId, environment: "staging", redirectUri })
    const advertised = try decode(try call("/api/v1/app-auth/mobile/config?" + configQuery), NativeConfig)
    try check(() => assert.equal(advertised.credentialTtlMs, androidCredentialTtlMs))
    const alice = try signIn("alice")
    const bob = try signIn("bob")
    const changedAccount = try post("/api/auth/device/authorize", { challenge: s256(verifier), state, expectedAccountId: alice.account.id }, browser(bob))
    const rejection = try tryPromise(() => changedAccount.json())
    try check(() => assert.deepEqual([changedAccount.status, rejection], [409, { error: "sign_in_changed" }]))

    effect function onboard(user: BrowserSession, acknowledged: boolean) {
      const native = try decode(try post("/api/auth/device/authorize", { challenge: s256(verifier), state, expectedAccountId: user.account.id }, browser(user)), BrowserReturn)
      const code = new URL(native.redirectUrl).searchParams.get("code")
      const issued = try decode(try post("/api/auth/device/exchange", { code, verifier }, headers), NativeEnrollment)
      try check(() => assert.deepEqual([issued.accountId, issued.expiresIn], [user.account.id, androidCredentialTtlMs / 1000]))
      if (acknowledged) {
        const ack = try post("/api/auth/device/ack", {}, bearer(issued.token))
        try check(() => assert.equal(ack.status, 204))
      }
      return issued.token
    }

    const aliceNative = try onboard(alice, true)
    const alicePending = try onboard(alice, false)
    const bobNative = try onboard(bob, true)
    const proof = (purpose: string) => ({ clientId, environment: "staging", redirectUri, state, codeChallenge: s256(verifier),
      codeChallengeMethod: "S256", purpose })
    const consent = (purpose: string, user: BrowserSession, expectedOwnerId = user.account.id) =>
      post(path, { approval: proof(purpose), expectedOwnerId }, browser(user))
    const exchange = (purpose: string, code: string, token: string, suppliedVerifier = verifier) =>
      post(path + "/exchange", { clientId, environment: "staging", redirectUri, state, code, verifier: suppliedVerifier, purpose }, bearer(token))
    const run = (method: string, code: string, input: { headers?: Record<string, string>; body?: Uint8Array<ArrayBuffer> } = {}) =>
      call(path, { ...input, method, headers: { authorization: "Bearer " + code, "x-backup-verifier": verifier, "x-backup-state": state, ...input.headers } })

    effect function approve(purpose: string, user: BrowserSession) {
      const result = try decode(try consent(purpose, user), BrowserReturn)
      const callback = new URL(result.redirectUrl)
      try check(() => assert.deepEqual([Object.keys(result), callback.origin + callback.pathname, callback.searchParams.get("state")],
        [["redirectUrl"], redirectUri, state]))
      return callback.searchParams.get("code") ?? ""
    }

    effect function grant(purpose: string, user: BrowserSession, token: string) {
      const code = try approve(purpose, user)
      return try decode(try exchange(purpose, code, token), Grant)
    }

    const ready = path + "/readiness?clientId=" + clientId + "&environment=staging"
    const readyResponse = try call(ready)
    const badDb = try call(ready, {}, { CLOUD_IDENTITY_DIGEST: "b".repeat(64) })
    const missingRegistration = try call(ready, {}, { NATIVE_CLIENT_REGISTRY: "[]" })
    const opened = try call(path + "/approve?" + new URLSearchParams(proof("save")))
    const foreignCallback = try call(path + "/approve?" + new URLSearchParams({ ...proof("save"), redirectUri: "https://attacker.example.test/exit" }))
    const crossOrigin = try post(path, { approval: proof("save"), expectedOwnerId: alice.account.id }, { ...browser(alice), origin: "https://attacker.example.test" })
    const switched = try consent("save", alice, bob.account.id)
    try check(() => assert.deepEqual([readyResponse.status, badDb.status, missingRegistration.status, opened.status,
      new URL(opened.headers.get("location") ?? apiOrigin).pathname, foreignCallback.status, crossOrigin.status, switched.status],
      [204, 503, 404, 303, "/android/passwords/approve", 400, 403, 409]))

    const ciphertext = new Uint8Array([0, 10, 255, 17])
    const create = (body: Uint8Array<ArrayBuffer>) => ({ headers: { "content-type": "application/octet-stream", "if-none-match": "*" }, body })
    const browserCode = try approve("save", alice)
    const unauthorized = [
      (try exchange("save", browserCode, bobNative)).status, (try exchange("save", browserCode, alicePending)).status,
      (try exchange("save", browserCode, aliceNative, "w".repeat(43))).status, (try exchange("read", browserCode, aliceNative)).status,
      (try run("PUT", browserCode, create(ciphertext))).status
    ]
    const initialGrant = try decode(try exchange("save", browserCode, aliceNative), Grant)
    const operationCode = initialGrant.code ?? ""
    const replayedExchange = try exchange("save", browserCode, aliceNative)
    const wrongPurpose = try run("GET", operationCode)
    const tooLarge = try run("PUT", operationCode, create(new Uint8Array(2097153)))
    const saved = try run("PUT", operationCode, create(ciphertext))
    const replayedSave = try run("PUT", operationCode, create(ciphertext))
    try check(() => assert.deepEqual([unauthorized, initialGrant.ownerId, initialGrant.revision, initialGrant.present,
      replayedExchange.status, wrongPurpose.status, tooLarge.status, saved.status, saved.headers.get("etag"), replayedSave.status],
      [[401, 401, 401, 401, 401], alice.account.id, null, false, 401, 401, 413, 204, '"1"', 401]))

    const migration = try Effect.provide(migrate({ digest: identity, environment: "staging", now: 2 }),
      storeLayer({ kind: "pg", url: databaseUrl }))
    const required = ["0002_identity.sql", "0002_identity_factors.sql", "0002_identity_methods.sql",
      "0003_device_keys.sql", "0003_device_keys_state.sql", "0004_provider_events.sql", "0006_inference.sql",
      "0107_sms_code_transport.sql", "0108_native_google_challenges.sql"]
    try check(() => assert.deepEqual(migration.applied, pendingMigrations))
    try check(() => assert.deepEqual(migration.applied.filter((name) => required.includes(name)), required))
    try tryPromise(() => db.query("SELECT code_challenge, state_digest, sealed_copy FROM device_grants LIMIT 0"))
    const repeated = try Effect.provide(migrate({ digest: identity, environment: "staging", now: 3 }),
      storeLayer({ kind: "pg", url: databaseUrl }))
    try check(() => assert.deepEqual(repeated.applied, []))
    const googlePath = "/api/v1/app-auth/mobile/google/challenge"
    const googleInput = { clientId, environment: "staging", redirectUri, challenge: s256(verifier), state }
    const google = try decode(try post(googlePath, googleInput, headers), GoogleChallenge)
    const googleFromBrowser = try post(googlePath, googleInput, browser(alice))
    try check(() => assert.deepEqual([google.challengeId.length, google.expiresIn, googleFromBrowser.status], [36, 120, 403]))

    const other = try grant("read", bob, bobNative)
    const otherSnapshot = try run("GET", other.code ?? "")
    const read = try grant("read", alice, aliceNative)
    const snapshot = try run("GET", read.code ?? "")
    const restored = new Uint8Array(try tryPromise(() => snapshot.arrayBuffer()))
    const staleCreate = try grant("save", alice, aliceNative)
    const stale = try run("PUT", staleCreate.code ?? "", create(ciphertext))
    const deletion = try grant("delete", alice, aliceNative)
    const removed = try run("DELETE", deletion.code ?? "", { headers: { "if-match": '"1"' } })
    const nextRead = try grant("read", alice, aliceNative)
    const tombstone = try run("GET", nextRead.code ?? "")
    try check(() => assert.deepEqual([other.scope === initialGrant.scope, otherSnapshot.status, snapshot.status, restored,
      stale.status, removed.status, removed.headers.get("etag"), tombstone.status, tombstone.headers.get("etag")],
      [false, 404, 200, ciphertext, 412, 204, '"2"', 404, '"2"']))

    const pending = try grant("read", alice, aliceNative)
    try tryPromise(() => db.query("UPDATE device_grants SET phase = 'ended' WHERE secret_digest = $1", [tokenDigest(aliceNative)]))
    const revoked = try run("GET", pending.code ?? "")
    const verified = try grant("verify", bob, bobNative)
    const now = try Clock.currentTimeMillis
    const aged = (try apply({ ...initial, now: now - 300001 }, { type: "signIn", assurance: "SingleFactor", personEpoch: 0 })).state
    try tryPromise(() => db.query(
      "UPDATE sessions SET state = $1, auth_at = $2, access_expires_at = $3, refresh_expires_at = $4 WHERE user_id = $5",
      [aged, aged.authAt, aged.accessExpiresAt, aged.refreshExpiresAt, bob.account.id]))
    const oldSession = try consent("read", bob)
    try check(() => assert.deepEqual([revoked.status, verified.code, verified.ownerId, verified.revision, oldSession.status],
      [401, null, bob.account.id, null, 401]))
  }))
  const androidFixture = fixtureDevices
  if (androidFixture !== undefined) {
    it.live("restore an enrolled vault after an Android cold start", () => scoped(coldPasswordRecovery(androidFixture)), 240_000)
  }

})
