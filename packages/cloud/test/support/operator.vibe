// spec/cloud/operator.md, "Story: Operate the deployment without reading secrets"
import { apply, initial } from "../../gen/cloud__identity__accounts.effect.vibe"
import type { DeviceRow } from "../../gen/cloud__operator.effect.vibe"
import { legacyGrant } from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import { operate, type OperatorCommandHandler } from "../../src/operator/admin.vibe"
import { deploymentLayer, parseProfile } from "../../src/profile/profile.vibe"
import { newId, secretText, tokenDigest } from "../../src/shared/credential-crypto.vibe"
import { Store, type Tx } from "../../src/store/store.vibe"
import type { ProfileEdit, TestCloud } from "./cloud.vibe"
import { secrets, testProfile } from "./profile.ts"

export interface OperatorOptions {
  readonly edit?: ProfileEdit
  readonly table?: ReadonlyArray<OperatorCommandHandler>
}

export effect function operator(cloud: TestCloud, args: ReadonlyArray<string>, options: OperatorOptions = {}) {
  const base = try sync(() => testProfile(cloud.fakes.url))
  const profile = try parseProfile(options.edit === undefined ? base : options.edit(base))
  const deployment = deploymentLayer(profile, "staging").pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets }))))
  provide Store = cloud.store, deployment, FetchHttpClient.layer {
    return try operate(args, options.table)
  }
}

export effect function printed<A, E, R>(program: A!E!R) {
  const host = try Console.Console
  const out: string[] = []
  const err: string[] = []
  const capturing: Console.Console = {
    ...host,
    log: (...args) => { out.push(args.join(" ")) },
    error: (...args) => { err.push(args.join(" ")) }
  }
  return { exit: try exit(provideService(program, Console.Console, capturing)), out, err }
}

export effect function openAccount(cloud: TestCloud, account: { readonly userId: string; readonly organizationId: string }) {
  const now = try Clock.currentTimeMillis
  const email = `${account.userId}@example.com`
  const opened = try apply(initial, {
    type: "openAccount", ...account, identity: { method: "EmailSignIn", subject: email }, verifiedEmail: true,
    subjectOwner: { tag: "Unowned" }, emailOwner: { tag: "Unowned" }, referralCode: `R-${account.userId}`
  })
  try cloud.store.transaction(effect (tx: Tx) => {
    try tx.query("INSERT INTO organizations (id, name, created_at) VALUES ($1, $2, $3)", [account.organizationId, email, now])
    try tx.query(
      "INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, $2::jsonb, 1, $3, 'active', $4, $5, $5)",
      [account.userId, JSON.stringify(opened.state), account.organizationId, email, now]
    )
  })
}

export effect function deviceKey(cloud: TestCloud, userId: string, device: DeviceRow) {
  const secret = secretText("eliza_mobile_", 32, "hex")
  const credentialId = newId()
  const now = try Clock.currentTimeMillis
  const grant = legacyGrant({ phase: "OldActive", client: { tag: "UnrecordedClient" }, codeExpiresAt: device.createdAt, credentialTtl: 0, credentialId, keyExpiresAt: device.expiresAt, epoch: 0, now })
  try cloud.store.transaction((tx) => tx.query(
    "INSERT INTO device_grants (key, state, revision, user_id, client_id, phase, credential_id, secret_digest, device_name, code_expires_at, key_expires_at, issued_at, updated_at) VALUES ($1, $7::jsonb, 1, $2, 'com.example.app', 'active', $1, $3, $4, $5, $6, $5, $5)",
    [credentialId, userId, tokenDigest(secret), device.deviceName, device.createdAt, device.expiresAt, JSON.stringify(grant)]
  ))
  return secret
}
