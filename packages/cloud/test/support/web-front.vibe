// spec/cloud/returnPages.md, "A return URL on the web origin shows ReturnToApp only for the one enabled registration of the served environment that holds it"; spec/cloud/nativeClients/registry.md, "A return URL names at most one enabled registration and purpose, and the cloud serves it only on the environment's web origin"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import seed from "../fixtures/seed.json" with { type: "json" }

module node {
  import { type ChildProcess, spawn } from "node:child_process"
  import { createServer, request, type Server } from "node:http"
  import type { AddressInfo } from "node:net"

  export function startServe(port: number): ChildProcess {
    return spawn(process.execPath, [
      "--env-file=test/fixtures/secrets.env", "--import", "vibelang/register", "src/main.vibe", "serve",
      "--profile", "test/fixtures/profile.json", "--environment", "staging",
      "--store", "pglite:.cache/cloud.pglite", "--seed", "test/fixtures/seed.json", "--port", String(port)
    ], { stdio: "inherit" })
  }

  export function onExit(child: ChildProcess, exited: (code: number | null) => void): () => void {
    child.once("exit", exited)
    return () => child.off("exit", exited)
  }

  /** @throws {unknown} */
  export async function answers(upstream: URL): Promise<void> {
    await fetch(new URL("/.well-known/assetlinks.json", upstream))
  }

  /** @throws {unknown} */
  export async function openFrontDoor(upstream: URL, webHost: string): Promise<{ server: Server; port: number }> {
    const front = createServer((incoming, outgoing) => {
      const forwarded = request(new URL(incoming.url ?? "/", upstream), {
        method: incoming.method,
        headers: { ...incoming.headers, host: upstream.host, "x-forwarded-host": webHost, "x-forwarded-proto": "https" }
      }, (answer) => {
        outgoing.writeHead(answer.statusCode ?? 502, answer.headers)
        answer.pipe(outgoing)
      })
      forwarded.on("error", () => outgoing.writeHead(502).end())
      incoming.pipe(forwarded)
    })
    await new Promise<void>((resolve, reject) => front.once("error", reject).listen(0, "127.0.0.1", resolve))
    return { server: front, port: (front.address() as AddressInfo).port }
  }
}
import { answers, onExit, openFrontDoor, startServe } from node

export error FrontDoorFailed { upstream: string }
export error ServeExited { code: number | null }

const servePort = 8080
const upstream = new URL(`http://127.0.0.1:${servePort}`)
const fixtureReturn = new URL(seed.clients[0]?.signInReturn ?? "")
const fixtureState = "AbCdEfGhIjKlMnOpQrStUvWxYz0123456789_-abcde"

effect function main() {
  const serve = try acquireRelease(sync(() => startServe(servePort)), (child) => sync(() => child.kill()))
  const serveEnds = callback<never, ServeExited>((resume) => {
    const stop = onExit(serve, (code) => resume(fail(new ServeExited({ code }))))
    return sync(stop)
  })
  const ready = tryPromise({ try: () => answers(upstream), catch: () => new FrontDoorFailed({ upstream: upstream.href }) })
  try raceFirst(serveEnds, timeout(retry(ready, Schedule.spaced("500 millis")), "5 minutes"))
  const front = try acquireRelease(
    tryPromise({ try: () => openFrontDoor(upstream, fixtureReturn.host), catch: () => new FrontDoorFailed({ upstream: upstream.href }) }),
    (opened) => sync(() => opened.server.close())
  )
  const local = `http://127.0.0.1:${front.port}${fixtureReturn.pathname}?state=${fixtureState}`
  try annotateLogs(logInfo("serving the web origin"), { url: local, returnUrl: fixtureReturn.href })
  try serveEnds
}

NodeRuntime.runMain(Effect.provide(scoped(main()), NodeServices.layer))
