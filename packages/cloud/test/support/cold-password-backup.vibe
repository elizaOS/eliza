// spec/cloud/index.md, "Story: Back up my passwords for another device"
import { SecureRandom } from "effect/crypto"
import { signInWithProof } from "../../src/identity-store.vibe"
import type { CloudBindings } from "../../src/worker.vibe"
import { openBackupDatabase } from "./password-backup.ts"

const clientId = "technology.graceful.grace"
const api = "https://127.0.0.1", web = "https://localhost"
const callback = web + "/android/auth/callback"
const digest = "c".repeat(64)
const registration = { clientId, environment: "staging", displayName: "Grace", androidPackage: clientId, signInReturn: callback,
  billingReturn: web + "/billing/return", enabled: true, certFingerprints: [Array(32).fill("AA").join(":")] }

module native {
  import { execFile } from "node:child_process"
  import { mkdtemp, readFile, rm } from "node:fs/promises"
  import type { IncomingMessage, ServerResponse } from "node:http"
  import { createServer } from "node:https"
  import { tmpdir } from "node:os"
  import { join } from "node:path"
  import { promisify } from "node:util"
  import { Schema } from "effect"
  import type { BrowserSession } from "../../src/identity-store.vibe"
  import { cloudWorker, type CloudBindings } from "../../src/worker.vibe"

  export const fixtureSerial = process.env.GRACE_PASSWORD_ANDROID_FIXTURE
  const run = promisify(execFile)
  const fixturePackage = "ai.eliza.plugins.passwords.test"
  const instrumentation = fixturePackage + "/androidx.test.runner.AndroidJUnitRunner"
  const nativeTest = "ai.eliza.plugins.securestore.nativeonly.ColdPasswordBackupInstrumentedTest"
  const backup = "/api/v1/app-auth/mobile/password-backup"
  const BrowserStep = Schema.Struct({ action: Schema.Literals(["enroll", "approve"]), address: Schema.String })

  async function request(input: IncomingMessage, api: string) {
    const chunks: Buffer[] = []
    let size = 0
    for await (const chunk of input) {
      if (!Buffer.isBuffer(chunk) || (size += chunk.length) > 2 * 1024 * 1024 + 8192) throw new Error("Oversized fixture request")
      chunks.push(chunk)
    }
    const headers = new Headers()
    for (const [key, value] of Object.entries(input.headers)) if (typeof value === "string") headers.set(key, value)
    const url = new URL(input.url ?? "/", api)
    if (url.origin !== api) throw new Error("Fixture only admits its local origin")
    return new Request(url, { method: input.method, headers, body: size === 0 ? undefined : Uint8Array.from(Buffer.concat(chunks)) })
  }

  function serve(tls: { key: Buffer; cert: Buffer }, env: CloudBindings, session: BrowserSession) {
    const api = env.PUBLIC_API_ORIGIN ?? ""
    const web = env.WEB_ORIGIN ?? ""
    const worker = cloudWorker<CloudBindings>()
    const access = (input: Request) => worker.fetch(input, env)
    const browserPost = (path: string, body: object) => access(new Request(api + path, {
      method: "POST",
      headers: { "content-type": "application/json", origin: web, cookie: "__Host-eliza-session=" + session.access },
      body: JSON.stringify(body),
    }))
    async function browser(input: Request) {
      const step = Schema.decodeUnknownSync(BrowserStep)(await input.json())
      const address = new URL(step.address)
      if (step.action === "enroll") {
        if (address.origin !== web || address.pathname !== "/" || address.hash !== "#account") return new Response(null, { status: 400 })
        return browserPost("/api/auth/device/authorize", {
          challenge: address.searchParams.get("device_challenge"), state: address.searchParams.get("device_state"),
        })
      }
      if (address.origin !== api || address.pathname !== backup + "/approve") return new Response(null, { status: 400 })
      const opened = await access(new Request(address))
      const destination = opened.headers.get("location")
      if (opened.status !== 303 || destination === null) return new Response(null, { status: 400 })
      const consent = new URL(destination)
      if (consent.origin !== web || consent.pathname !== "/android/passwords/approve") return new Response(null, { status: 400 })
      return browserPost(backup, {
        approval: Object.fromEntries(new URLSearchParams(consent.hash.slice(1))), expectedOwnerId: session.account.id,
      })
    }
    async function respond(input: IncomingMessage, output: ServerResponse) {
      try {
        const parsed = await request(input, api)
        const fixture = new URL(parsed.url).pathname === "/__fixture/browser" && parsed.method === "POST"
        const result = fixture ? await browser(parsed) : await access(parsed)
        output.writeHead(result.status, Object.fromEntries(result.headers))
        output.end(Buffer.from(await result.arrayBuffer()))
      } catch {
        output.writeHead(500)
        output.end()
      }
    }
    return createServer(tls, (input, output) => { void respond(input, output) })
  }

  export async function execute(serial: string, env: CloudBindings, session: BrowserSession) {
    if (!/^emulator-[1-9][0-9]{3,5}$/.test(serial)) throw new Error("The fixture requires an explicitly reserved emulator")
    const adb = (...input: string[]) => run("adb", ["-s", serial, ...input], { timeout: 90_000, maxBuffer: 1024 * 1024 })
    const installed = await adb("shell", "pm", "list", "instrumentation")
    if (!installed.stdout.includes("instrumentation:" + instrumentation + " ")) throw new Error("Install the portable Passwords test APK on the reserved emulator")
    const mapping = await adb("reverse", "--list")
    if (mapping.stdout.split("\n").some((row) => /(?:^|\s)tcp:443(?:\s|$)/.test(row))) throw new Error("The emulator already has an HTTPS reverse mapping")

    const root = await mkdtemp(join(tmpdir(), "android-password-backup-"))
    let server: ReturnType<typeof serve> | undefined
    let mapped = false
    try {
      const key = join(root, "tls.key"), cert = join(root, "tls.pem"), der = join(root, "tls.der")
      await run("openssl", ["req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "1", "-subj", "/CN=127.0.0.1",
        "-addext", "subjectAltName=IP:127.0.0.1", "-keyout", key, "-out", cert])
      await run("openssl", ["x509", "-in", cert, "-outform", "DER", "-out", der])
      const certificate = (await readFile(der)).toString("base64")
      server = serve({ key: await readFile(key), cert: await readFile(cert) }, env, session)
      const host = server
      await new Promise<void>((resolve, reject) => {
        host.once("error", reject)
        host.listen(0, "127.0.0.1", resolve)
      })
      const address = host.address()
      if (address === null || typeof address === "string") throw new Error("Fixture HTTPS listener did not start")
      await adb("reverse", "tcp:443", "tcp:" + address.port)
      mapped = true
      for (const phase of ["save", "restore"]) {
        const result = await adb("shell", "am", "instrument", "-w", "-r", "-e", "class", nativeTest,
          "-e", "coldPasswordPhase", phase, "-e", "coldPasswordCertificate", certificate, instrumentation)
        if (!/OK \(1 test\)/.test(result.stdout)) throw new Error(phase + " instrumentation failed\n" + result.stdout)
        if (phase === "save") await adb("shell", "am", "force-stop", fixturePackage)
      }
    } finally {
      try {
        if (mapped) await adb("reverse", "--remove", "tcp:443")
      } finally {
        server?.closeAllConnections()
        if (server !== undefined) {
          const host = server
          await new Promise<void>((resolve) => { host.close(() => resolve()) })
        }
        await rm(root, { recursive: true, force: true })
      }
    }
  }

}

import { execute } from native
export { fixtureSerial } from native

export effect function coldPasswordRecovery(serial: string) {
  const fixture = try acquireRelease(tryPromise(() => openBackupDatabase()), (database) => promise(() => database.close()))
  try tryPromise(() => fixture.db.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, 'staging', 1)", [digest]))
  const env = { DATABASE_URL: fixture.databaseUrl, CLOUD_IDENTITY_DIGEST: digest, CLOUD_ENVIRONMENT: "staging", PUBLIC_API_ORIGIN: api,
    WEB_ORIGIN: web, NATIVE_CLIENT_ID: clientId, NATIVE_AUTH_CALLBACK: callback, NATIVE_CLIENT_REGISTRY: JSON.stringify([registration]),
    INFERENCE_BASE_URL: "https://inference.example.test", INFERENCE_API_KEY: "unusable", CHAT_MODEL: "synthetic", EMBEDDING_MODEL: "synthetic",
    CHAT_INPUT_MICROS_PER_1K: "1", CHAT_OUTPUT_MICROS_PER_1K: "1", EMBEDDING_INPUT_MICROS_PER_1K: "1", MAX_COMPLETION_TOKENS: "1",
    STRIPE_SECRET_KEY: "unusable", STRIPE_WEBHOOK_SECRET: "unusable", STRIPE_PRICE_ID: "unusable", STRIPE_PRODUCT_ID: "unusable", STRIPE_PLAN: "plus_monthly" } satisfies CloudBindings
  const session = try Effect.provide(signInWithProof(fixture.db,
    { provider: "google", subject: "android-cold-recovery-fixture", email: "cold@fixture.example.test" }), SecureRandom.layerWebCrypto)
  try tryPromise(() => execute(serial, env, session))
}
