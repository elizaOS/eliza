// spec/cloud/services/speechRelay.md, "The wire is version 1 with 16 kHz mono PCM16 and bounded frames"
import { assert, describe, it } from "@effect/vitest"
import { decodeDeviceFrame, decodeRelayFrame, decodeServerFrame, encodeClientFrame, encodeRelayAudio, encodeWireFrame, relayCloseCodes } from "../src/index.vibe"

describe("Speech relay codec", () => {
  it.live("Relay codec round trips and bounds (spec/cloud/services/speechRelay.md, \"The wire is version 1 with 16 kHz mono PCM16 and bounded frames\")", () => Effect.try(() => {
    const pcm = Uint8Array.from([1, 2, 3, 4])
    const frame = encodeRelayAudio({ id: "utt_1-a", pcm })
    assert.deepEqual(Array.from(frame ?? []), [1, 7, 117, 116, 116, 95, 49, 45, 97, 1, 2, 3, 4])
    assert.deepEqual(decodeRelayFrame(frame!), { id: "utt_1-a", pcm })
    assert.equal(encodeRelayAudio({ id: "bad id", pcm }), undefined)
    assert.equal(encodeRelayAudio({ id: "a", pcm: Uint8Array.from([1, 2, 3]) }), undefined)
    assert.equal(encodeRelayAudio({ id: "a".repeat(65), pcm }), undefined)
    assert.ok(encodeRelayAudio({ id: "a".repeat(64), pcm: new Uint8Array(65536) }))
    assert.equal(encodeRelayAudio({ id: "a", pcm: new Uint8Array(65538) }), undefined)
    assert.equal(decodeRelayFrame(Uint8Array.from([2, 1, 97, 0, 0])), undefined)

    const hello = encodeClientFrame({ kind: "hello", token: "tök\"en", errorReasons: true, extend: false })
    assert.equal(hello, JSON.stringify({ t: "hello", token: "tök\"en", errorReasons: true }))
    assert.deepEqual(decodeDeviceFrame(hello!), { kind: "hello", token: "tök\"en", errorReasons: true, extend: false })
    assert.equal(decodeDeviceFrame(JSON.stringify({ t: "hello", token: "x", timings: true })), undefined)
    assert.equal(encodeClientFrame({ kind: "hello", token: "x".repeat(6145), errorReasons: false, extend: false }), undefined)
    assert.equal(encodeClientFrame({ kind: "tts", id: "u1", text: "   ", flush: false }), undefined)
    assert.equal(encodeClientFrame({ kind: "tts", id: "u1", text: "x".repeat(1025), flush: false }), undefined)
    assert.equal(encodeClientFrame({ kind: "tts", id: "u1", text: "hi\n", flush: true }), JSON.stringify({ t: "tts", id: "u1", text: "hi\n", flush: true }))
    assert.equal(encodeClientFrame({ kind: "stop" }), "{\"t\":\"stop\"}")
    assert.equal(encodeClientFrame({ kind: "audio", pcm: new Uint8Array(3202) }), undefined)
    assert.ok(encodeClientFrame({ kind: "audio", pcm: new Uint8Array(3200) }))
    assert.equal(encodeClientFrame({ kind: "audio", pcm: new Uint8Array(0) }), undefined)

    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "ready", version: 1, sampleRate: 16000, channels: 1, expiresAt: "2026-11-19T00:00:00Z" })), { kind: "ready", expiresAt: "2026-11-19T00:00:00Z" })
    assert.equal(decodeServerFrame(JSON.stringify({ t: "ready", version: 2, sampleRate: 16000, channels: 1, expiresAt: "x" })), undefined)
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "stt", event: { type: "end-of-turn", transcript: "héllo 😀" } })), { kind: "stt", event: "EndOfTurn", transcript: "héllo 😀" })
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "stt", event: { type: "connected" } })), { kind: "stt", event: "SttConnected", transcript: "" })
    assert.equal(decodeServerFrame(JSON.stringify({ t: "stt", event: { type: "end-of-turn", transcript: "x".repeat(16385) } })), undefined)
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "error", code: "unavailable", reason: "allowance_exhausted" })), { kind: "error", code: "RelayUnavailable", reason: { tag: "FundingReason", funding: "AllowanceShort" } })
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "error", code: "unauthorized" })), { kind: "error", code: "RelayUnauthorized", reason: { tag: "NoRelayReason" } })
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "tts_prepared", id: "u1" })), { kind: "prepared", id: "u1" })
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "flush_complete", id: "u1" })), { kind: "flushed", id: "u1" })
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "complete", id: "u1" })), { kind: "complete", id: "u1" })
    assert.deepEqual(decodeServerFrame(JSON.stringify({ t: "extended", expiresAt: "e" })), { kind: "extended", expiresAt: "e" })
    assert.deepEqual(decodeServerFrame(frame!), { kind: "audio", id: "utt_1-a", pcm })
    const err = encodeWireFrame({ kind: "error", code: "RelayUnavailable", reason: { tag: "FundingReason", funding: "CreditsShort" } })
    assert.equal(err, JSON.stringify({ t: "error", code: "unavailable", reason: "insufficient_credits" }))
    assert.deepEqual(relayCloseCodes, { normal: 1000, violation: 1008, unauthorized: 4401, funding: 4402, sessionClosed: 4410 })
  }))
})
