// spec/cloud/billing/grantCodes.md, "Story: Redeem a membership code once"
import { assert, describe, it } from "@effect/vitest"
import { organization, testCloud, type TestCloud } from "./support/cloud.vibe"
import { tokenDigest } from "../src/shared/sealing.vibe"
import { verifyEntitlement, type PublishedKey } from "./support/entitlement.ts"
import { initial as noSubscription, type Subscription } from "../gen/cloud__billing__subscriptions.ts"

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}
effect function entitledDevice(cloud: TestCloud, name: string, now: number) {
  const token = `eliza_mobile_${tokenDigest(name)}`
  try organization(cloud, `org-${name}`)
  try sql(cloud, "INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'active', $3, $4, $4)", [`user-${name}`, `org-${name}`, `${name}@example.com`, now])
  try sql(cloud, "INSERT INTO device_grants (key, state, revision, user_id, client_id, phase, credential_id, secret_digest, code_expires_at, key_expires_at, issued_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'test-client', 'active', $3, $4, $5, $6, $5, $5)", [
    `grant-${name}`, `user-${name}`, `cred-${name}`, tokenDigest(token), now - 1000, now + 24 * 3_600_000
  ])
  return token
}
effect function subscribedTo(cloud: TestCloud, organizationId: string, customerId: string, now: number) {
  const state: Subscription = {
    ...noSubscription, status: "Active", subscriptionId: `sub_${organizationId}`, customer: { tag: "PinnedCustomer", customerId },
    planKey: "PlusMonthly", periodStart: now - 60_000, periodEnd: now + 30 * 24 * 3_600_000, revision: 4
  }
  try sql(cloud, "INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, provider_subscription_id, period_end, updated_at) VALUES ($1, $2, 4, 'active', 'plus_monthly', $3, $4, $5, $6)", [
    organizationId, JSON.stringify(state), customerId, state.subscriptionId, state.periodEnd, now
  ])
  return state
}
import { defaultTerm as defaultGrantTerm } from "../gen/cloud__billing__grantCodes.ts"
import { disableGrantCodes, mintGrantCodes, revokeGrants, type MintRequest } from "../src/billing/grant-codes.vibe"

effect function mintCodes(cloud: TestCloud, request: MintRequest, now: number) {
  return try cloud.inside(cloud.store.transaction((tx) => cloud.inside(mintGrantCodes(tx, request, now))))
}

effect function redeemCode(cloud: TestCloud, token: string, code: string, idempotencyKey: string) {
  const answer = try cloud.call("/api/v1/subscription/redeem", { headers: { authorization: `Bearer ${token}` }, json: { code, idempotencyKey } })
  const body = answer.body as { readonly error?: string; readonly replayed?: boolean; readonly grant?: { readonly id: string; readonly planKey: string; readonly family: string; readonly effectiveFrom: number; readonly effectiveUntil: number | null; readonly revoked: boolean }; readonly entitlement?: { readonly plan: { readonly key: string; readonly source: string }; readonly token: string } }
  return { status: answer.status, error: body.error, replayed: body.replayed, grant: body.grant, plan: body.entitlement?.plan, token: body.entitlement?.token }
}

effect function grantPeriods(cloud: TestCloud, grantId: string) {
  return (try sql(cloud, "SELECT status FROM allowance_periods WHERE starts_with(key, $1) ORDER BY key", [`grant/${grantId}/`])).map((row) => String(row.status))
}

describe("WP4 Subscriptions and entitlements: grant codes", () => {
  it.live("Redeem a membership code once, the same answer on a retry and each refusal in the order the rules give (spec/cloud/billing/grantCodes.md, \"Story: Redeem a membership code once\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const redeemer = try entitledDevice(cloud, "redeemer", now)
    const second = try entitledDevice(cloud, "second", now)
    const third = try entitledDevice(cloud, "third", now)
    const payer = try entitledDevice(cloud, "payer", now)
    const guesser = try entitledDevice(cloud, "guesser", now)
    try subscribedTo(cloud, "org-payer", "cus_payer", now)
    const founders = try mintCodes(cloud, { family: "founders", planKey: "PlusMonthly", term: defaultGrantTerm, requiresNoPaidPlan: true, maxRedemptions: 2, expiresAt: undefined, count: 2 }, now)
    const pilot = try mintCodes(cloud, { family: "pilot", planKey: "ProMonthly", term: { tag: "TermLifetime" }, requiresNoPaidPlan: false, maxRedemptions: 1, expiresAt: undefined, count: 1 }, now)
    const [first = "", other = ""] = founders
    const typed = first.toLowerCase().replaceAll("-", " ").replaceAll("1", "l").replaceAll("0", "o")

    const fresh = try redeemCode(cloud, redeemer, typed, "redeem-key-1")
    const replay = try redeemCode(cloud, redeemer, first, "redeem-key-1")
    const sameFamily = try redeemCode(cloud, redeemer, other, "redeem-key-2")
    const reusedKey = try redeemCode(cloud, redeemer, pilot[0] ?? "", "redeem-key-1")
    const paidPlan = try redeemCode(cloud, payer, first, "redeem-key-3")
    const secondHolder = try redeemCode(cloud, second, first, "redeem-key-4")
    const usedUp = try redeemCode(cloud, third, first, "redeem-key-5")
    const otherFamily = try redeemCode(cloud, third, pilot[0] ?? "", "redeem-key-6")
    const months = try grantPeriods(cloud, fresh.grant?.id ?? "")
    const lifetimeMonths = try grantPeriods(cloud, otherFamily.grant?.id ?? "")
    const published = try cloud.call("/api/v1/subscription/entitlement-keys")
    const verified = try promise(() => verifyEntitlement(fresh.token ?? "", (published.body as { readonly keys: ReadonlyArray<PublishedKey> }).keys, { issuer: "https://api.staging.example.com", audience: "cloud-subscription", nowSeconds: Math.floor(now / 1000) }))

    const guesses: Array<[number, string | undefined]> = []
    for (const guess of ["not a code", "0000-0000-0000-0000", "1111-1111-1111-1111", "2222-2222-2222-2222", "3333-3333-3333-3333", first]) {
      const answer = try redeemCode(cloud, guesser, guess, "guess-key-1")
      guesses.push([answer.status, answer.error])
    }

    try check(() => assert.deepStrictEqual(
      {
        minted: [...founders, ...pilot].map((code) => /^[0-9A-HJKMNP-TV-Z]{4}(-[0-9A-HJKMNP-TV-Z]{4}){3}$/.test(code)),
        fresh: [fresh.status, fresh.replayed, fresh.grant?.planKey, fresh.grant?.family, fresh.grant?.revoked, (fresh.grant?.effectiveUntil ?? 0) - (fresh.grant?.effectiveFrom ?? 0), fresh.plan],
        token: [verified.claims.plan, verified.claims.org],
        replay: [replay.status, replay.replayed, replay.grant?.id === fresh.grant?.id],
        refusals: [[sameFamily.status, sameFamily.error], [reusedKey.status, reusedKey.error], [paidPlan.status, paidPlan.error], [usedUp.status, usedUp.error]],
        secondHolder: [secondHolder.status, secondHolder.replayed, secondHolder.grant?.id !== fresh.grant?.id],
        lifetime: [otherFamily.status, otherFamily.grant?.effectiveUntil, otherFamily.plan, lifetimeMonths],
        months: [months.length >= 6, months.every((status) => status === "open")],
        guesses
      },
      {
        minted: [true, true, true],
        fresh: [200, false, "plus_monthly", "founders", false, 183 * 24 * 3_600_000, { key: "plus_monthly", source: "grant", effectiveUntil: fresh.grant?.effectiveUntil }],
        token: [{ id: "plus_monthly", name: "Plus", status: "active" }, "org-redeemer"],
        replay: [200, true, true],
        refusals: [[409, "subscription_grant_already_redeemed"], [409, "idempotency_conflict"], [409, "subscription_grant_paid_plan_active"], [400, "grant_code_invalid"]],
        secondHolder: [200, false, true],
        lifetime: [200, null, { key: "pro_monthly", source: "grant", effectiveUntil: null }, ["open", "open", "open"]],
        months: [true, true],
        guesses: [[400, "grant_code_invalid"], [400, "grant_code_invalid"], [400, "grant_code_invalid"], [400, "grant_code_invalid"], [400, "grant_code_invalid"], [429, "rate_limited"]]
      }
    ))
  }))

  it.live("Stop a leaked code and end a grant given in error, while replays still answer (spec/cloud/billing/grantCodes.md, \"Story: Stop a code or a grant\"; spec/cloud/billing/allowance.md, \"Story: Spend my plan's allowance before my credits, and never carry it over\")", () => scoped(effect {
    const cloud = try testCloud()
    const now = try Clock.currentTimeMillis
    const holder = try entitledDevice(cloud, "holder", now)
    const late = try entitledDevice(cloud, "late", now)
    const keeper = try entitledDevice(cloud, "keeper", now)
    const [leaked = ""] = try mintCodes(cloud, { family: "leaked", planKey: "PlusMonthly", term: { tag: "TermDays", days: 30 }, requiresNoPaidPlan: false, maxRedemptions: 5, expiresAt: undefined, count: 1 }, now)
    const [batch = ""] = try mintCodes(cloud, { family: "batch", planKey: "ProMonthly", term: defaultGrantTerm, requiresNoPaidPlan: false, maxRedemptions: 5, expiresAt: undefined, count: 1 }, now)

    const held = try redeemCode(cloud, holder, leaked, "stop-key-1")
    const disabled = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(disableGrantCodes(tx, { kind: "codes", codes: [leaked] }))))
    const disabledAgain = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(disableGrantCodes(tx, { kind: "family", family: "leaked" }))))
    const afterDisable = try redeemCode(cloud, late, leaked, "stop-key-2")
    const replayDisabled = try redeemCode(cloud, holder, leaked, "stop-key-1")
    const revoked = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(revokeGrants(tx, { kind: "grants", grantIds: [held.grant?.id ?? ""] }, "issued in error"))))
    const revokedAgain = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(revokeGrants(tx, { kind: "grants", grantIds: [held.grant?.id ?? ""] }, "issued in error"))))
    const replayRevoked = try redeemCode(cloud, holder, leaked, "stop-key-1")
    const closedMonths = try grantPeriods(cloud, held.grant?.id ?? "")

    const kept = try redeemCode(cloud, keeper, batch, "stop-key-3")
    const byCode = try cloud.inside(cloud.store.transaction((tx) => cloud.inside(revokeGrants(tx, { kind: "codes", codes: [batch] }, "batch withdrawn"))))
    const afterCodeRevoke = try redeemCode(cloud, late, batch, "stop-key-4")
    const keeperReplay = try redeemCode(cloud, keeper, batch, "stop-key-3")

    try check(() => assert.deepStrictEqual(
      {
        held: [held.status, held.replayed, held.plan?.source],
        disabled: [disabled, disabledAgain, afterDisable.status, afterDisable.error, replayDisabled.status, replayDisabled.replayed, replayDisabled.grant?.revoked],
        revoked: [revoked, revokedAgain, replayRevoked.status, replayRevoked.replayed, replayRevoked.grant?.revoked, replayRevoked.plan?.source, closedMonths.length > 0 && closedMonths.every((status) => status === "closed")],
        byCode: [kept.status, byCode, afterCodeRevoke.status, afterCodeRevoke.error, keeperReplay.status, keeperReplay.grant?.revoked, keeperReplay.plan?.source]
      },
      {
        held: [200, false, "grant"],
        disabled: [1, 0, 400, "grant_code_invalid", 200, true, false],
        revoked: [1, 0, 200, true, true, "free", true],
        byCode: [200, 1, 400, "grant_code_invalid", 200, true, "free"]
      }
    ))
  }))
})
