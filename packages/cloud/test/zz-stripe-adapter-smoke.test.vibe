// spec/cloud/shared/dispatchOnce.md, "Story: Send a change once and recover its outcome without sending it again"
import { assert, describe, it } from "@effect/vitest"
import { FetchHttpClient } from "effect/http"
import { createCustomer, createCheckoutSession, findCheckoutSession, expireCheckoutSession, retrieveCheckoutSession, listSubscriptions, retrieveSubscription, retrieveInvoice, retrieveCharge, createPortalSession, verifyWebhookSignature, providerReply, lookupOf } from "../src/providers/stripe.vibe"
import { startFakeServer } from "./support/fakes.ts"
import { createStripeFake, tamper } from "./support/fakes/stripe.ts"
import { secrets, testProfile } from "./support/profile.ts"
import { deploymentLayer } from "../src/profile/profile.vibe"

effect function failureTag<A, E extends { readonly _tag: string }, R>(program: A!E!R): string!!R {
  return match (try exit(program)) {
    when Exit.Success: "ok";
    when Exit.Failure(let cause): Cause.findErrorOption(cause).pipe(Option.map((error) => error._tag), Option.getOrElse(() => "defect"));
  }
}

describe("stripe adapter smoke", () => {
  it.live("adapter against fake", () => scoped(effect {
    const fake = createStripeFake()
    const fakes = try acquireRelease(promise(() => startFakeServer()), (server) => promise(() => server.close()))
    try sync(() => fakes.mount("/stripe/", fake.handler))
    const layer = Layer.mergeAll(deploymentLayer(testProfile(fakes.url) as never, "staging"), FetchHttpClient.layer).pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets }))))
    const result = try Effect.provide(scoped(effect {
      const now = Date.now()
      const customer = try createCustomer("org-1", { idempotencyKey: "k-cus", timeout: 5000 })
      const again = try createCustomer("org-1", { idempotencyKey: "k-cus", timeout: 5000 })
      const terms = { organizationId: "org-1", commandId: "cmd-1", customerId: customer.id, priceId: "price_pro", expiresAt: now + 3_600_000, returns: { kind: "hosted" as const, successUrl: "https://x.test/ok", cancelUrl: "https://x.test/no" } }
      const missing = lookupOf(try providerReply(findCheckoutSession(customer.id, "cmd-1", { timeout: 5000 })))
      const session = try createCheckoutSession(terms, { idempotencyKey: "k-cs", timeout: 5000 })
      const embedded = try createCheckoutSession({ ...terms, commandId: "cmd-2", returns: { kind: "embedded" } }, { idempotencyKey: "k-cs2", timeout: 5000 })
      const found = try findCheckoutSession(customer.id, "cmd-1", { timeout: 5000 })
      const seen = lookupOf(try providerReply(findCheckoutSession(customer.id, "cmd-1", { timeout: 5000 })))
      const reused = try failureTag(createCheckoutSession({ ...terms, commandId: "cmd-3" }, { idempotencyKey: "k-cs", timeout: 5000 }))
      const expired = try expireCheckoutSession(embedded.id, { idempotencyKey: "k-exp", timeout: 5000 })
      const completed = try sync(() => fake.completeSession(session.id))
      const after = try retrieveCheckoutSession(session.id, { timeout: 5000 })
      const subs = try listSubscriptions(customer.id, { timeout: 5000 })
      const sub = try retrieveSubscription(after.subscription ?? "", { timeout: 5000 })
      const invoice = try retrieveInvoice(sub.latest_invoice ?? "", { timeout: 5000 })
      const chargeId = (completed as unknown as { charge?: { id: string } }).charge?.id
      const charge = chargeId === undefined ? "no charge id" : (try retrieveCharge(chargeId, { timeout: 5000 })).id
      const portal = try createPortalSession({ customerId: customer.id, returnUrl: "https://x.test/back" }, { idempotencyKey: "k-portal", timeout: 5000 })
      const notFound = try providerReply(retrieveInvoice("in_missing", { timeout: 5000 }))
      try sync(() => fake.failNext("/v1/customers", { status: 503, type: "api_error" }))
      const outage = try failureTag(createCustomer("org-2", { idempotencyKey: "k2", timeout: 5000 }))
      try sync(() => fake.failNext("/v1/customers", { status: 402, type: "card_error", code: "card_declined" }))
      const refused = try providerReply(createCustomer("org-2", { idempotencyKey: "k3", timeout: 5000 }))
      try sync(() => fake.dropNextReply("/v1/customers"))
      const dropped = try failureTag(createCustomer("org-2", { idempotencyKey: "k4", timeout: 5000 }))
      return { same: again.id === customer.id, missing, url: session.url !== null, secret: embedded.client_secret !== null, found: found?.id === session.id, seen, reused, expired: expired.status, status: after.status, subs: subs.length, sub: sub.status, invoice: invoice.status, charge, portal: portal.url.startsWith("https://"), notFound, outage, refused, dropped }
    }), layer)
    const signed = fake.signedEvent("checkout.session.completed", { id: "cs_x" })
    const at = signed.event.created * 1000
    const signature = [verifyWebhookSignature(signed.raw, signed.header, "whsec_fake", at), verifyWebhookSignature(tamper(signed.raw), signed.header, "whsec_fake", at), verifyWebhookSignature(signed.raw, signed.header, "whsec_other", at), verifyWebhookSignature(signed.raw, signed.header, "whsec_fake", at + 301_000), verifyWebhookSignature(signed.raw, `${signed.header},v1=00`, "whsec_fake", at)]
    try Console.error(JSON.stringify(result), JSON.stringify(signature))
    assert.deepStrictEqual(signature, [true, false, false, false, true])
  }))
})
