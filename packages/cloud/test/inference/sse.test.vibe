// spec/cloud/services/inference.md, "Story: Stream a reply in the shape clients read"; spec/cloud/services/inference.md, "Reading the provider's stream yields the same events however its bytes were split"
import { assert, describe, it } from "@effect/vitest"
import { stream } from "../../src/providers/llm.vibe"
import { billedFromUsage } from "../../src/services/models.vibe"
import { abort, chunkFrame, doneFrame, feed, finish } from "../../src/services/sse.ts"
import { replyText, streamText, upstreamModel } from "../support/llm-fake.ts"
import { check } from "../support/cloud.vibe"
import { llmAdapter, segmented } from "../support/llm-adapter.vibe"

const request = { model: upstreamModel, messages: [{ role: "user", content: "Say hello" }], max_tokens: 16 }

function segmentedTo(chunks: ReadonlyArray<ReadonlyArray<number>>, end: "finish" | "abort" = "finish"): ReadonlyArray<string> {
  return segmented(chunks, end === "finish" ? finish : () => feed(abort(), [10, 10]))
}

function bytesOf(text: string): ReadonlyArray<number> {
  return [...new TextEncoder().encode(text)]
}

const cut = bytesOf("data: {\"a\":1}\n\ndata: {\"b\"")

describe("WP5 Inference: SSE segmentation", () => {
  it.live("Read the provider's stream as whole events whatever its byte chunking (spec/cloud/services/inference.md, \"Story: Stream a reply in the shape clients read\")", () => scoped(effect {
    const { llm, provider, layer } = try llmAdapter()
    provide layer {
      try sync(() => llm.script({ kind: "stream" }))
      const chunks = Array.from(try Stream.runCollect(try stream(provider, request)), (bytes) => [...bytes])
      const read = segmentedTo(chunks)
      const json = try Effect.try(() => read.filter((event) => event !== "[DONE]").map((event) => JSON.parse(event) as { choices: Array<{ delta?: { content?: string } }>; usage?: unknown }))
      const billed = try billedFromUsage(json.find((chunk) => chunk.usage !== undefined)?.usage)
      try check(() => assert.deepStrictEqual(
        {
          chunked: chunks.length > 1,
          sameAsByByte: read,
          reframed: read.map((event) => event === "[DONE]" ? doneFrame : chunkFrame(event)).join(""),
          text: json.map((chunk) => chunk.choices[0]?.delta?.content ?? "").join(""),
          billed,
          crlf: segmentedTo([bytesOf("data: {\"a\":\r\ndata: 1}\r"), bytesOf("\n\r\n: keep-alive\n\ndata:[DONE]\n\n")]),
          malformed: segmentedTo([[...bytesOf("data: "), 0xc3], [0x28, 0xed, 0xa0, 0x80, 0xf0, 0x9f], [0x98, 0x80, 0xe2, 10, 10]]),
          finished: segmentedTo([cut]),
          aborted: segmentedTo([cut], "abort")
        },
        {
          chunked: true,
          sameAsByByte: segmentedTo(bytesOf(streamText).map((b) => [b])),
          reframed: streamText,
          text: replyText,
          billed: { tag: "Reported", counts: { inputTokens: 8, cachedTokens: 4, outputTokens: 7 } },
          crlf: ["{\"a\":\n1}", "[DONE]"],
          malformed: ["�(���\u{1F600}�"],
          finished: ["{\"a\":1}", "{\"b\""],
          aborted: ["{\"a\":1}"]
        }
      ))
    }
  }))
})
