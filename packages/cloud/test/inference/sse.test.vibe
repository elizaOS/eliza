// spec/cloud/services/inference.md, "Story: Stream a reply in the shape clients read"; spec/cloud/services/inference.md, "Reading the provider's stream yields the same events however its bytes were split"
import { assert, describe, it } from "@effect/vitest"
import { FetchHttpClient } from "effect/http"
import { deploymentLayer, parseProfile } from "../../src/profile/profile.vibe"
import { stream, type LlmProvider } from "../../src/providers/llm.vibe"
import { billedFromUsage } from "../../src/services/models.vibe"
import { abort, chunkFrame, doneFrame, feed, finish, isDone, segmenter, utf8Text } from "../../src/services/sse.ts"
import { sseReader } from "../../src/services/sse-reader.vibe"
import { startFakeServer } from "../support/fakes.ts"
import { llmFake, replyText, streamText, upstreamModel } from "../support/llm-fake.ts"
import { secrets, testProfile } from "../support/profile.ts"

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function adapter() {
  const fakes = try acquireRelease(promise(() => startFakeServer()), (server) => promise(() => server.close()))
  const llm = try sync(() => {
    const fake = llmFake()
    fakes.mount("/llm/", fake.handler)
    return fake
  })
  const profile = try parseProfile(try sync(() => testProfile(fakes.url)))
  const provider: LlmProvider = { id: "llm", baseUrl: `${fakes.url}/llm`, apiKeyEnv: "LLM_API_KEY" }
  const layer = Layer.mergeAll(deploymentLayer(profile, "staging"), FetchHttpClient.layer).pipe(
    Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets })))
  )
  return { llm, provider, layer }
}

const request = { model: upstreamModel, messages: [{ role: "user", content: "Say hello" }], max_tokens: 16 }

function referenceEvents(chunks: readonly Uint8Array[], end: "finish" | "abort"): number[][] {
  let state = segmenter()
  const events: number[][] = []
  for (const chunk of chunks) {
    const next = feed(state, [...chunk])
    state = next.segmenter
    events.push(...next.events)
  }
  events.push(...(end === "finish" ? finish(state) : feed(abort(), [10, 10])).events)
  return events
}

function eventsFrom(chunks: readonly Uint8Array[], end: "finish" | "abort"): number[][] {
  const reader = sseReader()
  const events = chunks.flatMap((chunk) => [...reader.read(chunk)])
  const tail = end === "finish" ? reader.finish() : undefined
  if (tail !== undefined) events.push(tail)
  return events
}

function segmented(chunks: ReadonlyArray<ReadonlyArray<number>>, end: "finish" | "abort" = "finish"): ReadonlyArray<string> {
  const events = eventsFrom(chunks.map((chunk) => Uint8Array.from(chunk)), end)
  return events.map((event) => isDone(event) ? "[DONE]" : String.fromCodePoint(...utf8Text(event)))
}

function bytesOf(text: string): ReadonlyArray<number> {
  return [...new TextEncoder().encode(text)]
}

const cut = bytesOf("data: {\"a\":1}\n\ndata: {\"b\"")

describe("WP5 Inference: SSE segmentation", () => {
  it('The stream reader matches the byte model at every transport split and yields one detached event at a time (spec/cloud/services/inference.md, "Reading the provider\'s stream yields the same events however its bytes were split")', () => {
    const bytes = Uint8Array.from([...bytesOf(": ignored\r\ndata:\r\ndata: café 🙂\r\n\r\ndata\n\ndata: [DONE]\r\n\r\ndata: "), 0xe2, 0x82])
    for (let split = 0; split <= bytes.length; split++) {
      const chunks = [bytes.subarray(0, split), bytes.subarray(split)]
      for (const end of ["finish", "abort"] as const) assert.deepStrictEqual(eventsFrom(chunks, end), referenceEvents(chunks, end))
    }
    const reader = sseReader()
    const other = sseReader()
    const frames = reader.read(Uint8Array.from(bytesOf("data: first\n\ndata: second\n\ndata: last")))
    const first = frames.next().value
    assert.deepStrictEqual(first, bytesOf("first"))
    assert.equal(reader.pendingBytes(), 0)
    assert.deepStrictEqual([...other.read(Uint8Array.from(bytesOf("data: alone\n\n")))], [bytesOf("alone")])
    assert.deepStrictEqual([...frames], [bytesOf("second")])
    assert.deepStrictEqual(reader.finish(), bytesOf("last"))
    assert.deepStrictEqual(first, bytesOf("first"))
    assert.isUndefined(reader.finish())
  })

  it.live("Read the provider's stream as whole events whatever its byte chunking (spec/cloud/services/inference.md, \"Story: Stream a reply in the shape clients read\")", () => scoped(effect {
    const { llm, provider, layer } = try adapter()
    provide layer {
      try sync(() => llm.script({ kind: "stream" }))
      const chunks = Array.from(try Stream.runCollect(try stream(provider, request)), (bytes) => [...bytes])
      const read = segmented(chunks)
      const json = try Effect.try(() => read.filter((event) => event !== "[DONE]").map((event) => JSON.parse(event) as { choices: Array<{ delta?: { content?: string } }>; usage?: unknown }))
      const billed = try billedFromUsage(json.find((chunk) => chunk.usage !== undefined)?.usage)
      try check(() => assert.deepStrictEqual(
        {
          chunked: chunks.length > 1,
          sameAsByByte: read,
          reframed: read.map((event) => event === "[DONE]" ? doneFrame : chunkFrame(event)).join(""),
          text: json.map((chunk) => chunk.choices[0]?.delta?.content ?? "").join(""),
          billed,
          crlf: segmented([bytesOf("data: {\"a\":\r\ndata: 1}\r"), bytesOf("\n\r\n: keep-alive\n\ndata:[DONE]\n\n")]),
          malformed: segmented([[...bytesOf("data: "), 0xc3], [0x28, 0xed, 0xa0, 0x80, 0xf0, 0x9f], [0x98, 0x80, 0xe2, 10, 10]]),
          finished: segmented([cut]),
          aborted: segmented([cut], "abort")
        },
        {
          chunked: true,
          sameAsByByte: segmented(bytesOf(streamText).map((b) => [b])),
          reframed: streamText,
          text: replyText,
          billed: { tag: "Reported", counts: { inputTokens: 8, cachedTokens: 4, outputTokens: 7 } },
          crlf: ["{\"a\":\n1}", "[DONE]"],
          malformed: ["�(���\u{1F600}�"],
          finished: ["{\"a\":1}", "{\"b\""],
          aborted: ["{\"a\":1}"]
        }
      ))
    }
  }))
})
