// spec/cloud/services/google/connection.md, "Story: Connect my Google account with the access I chose"
import { assert, describe, it } from "@effect/vitest"
import { refusalBody } from "../src/http/refusal.vibe"
import { Store } from "../src/store/store.vibe"
import { organization, testCloud, type TestCloud } from "./support/cloud.vibe"
import { testProfile, secrets } from "./support/profile.ts"
import { deploymentLayer, parseProfile } from "../src/profile/profile.vibe"
import { scopeFor, storeGrant, useGrant, type Owner } from "../src/services/google/grant-access.vibe"
import { googleFakeState, mountGoogleToken, seedGrant } from "./support/fakes/google.ts"

effect function check(run: () => void) {
  try Effect.try(run)
}

effect function sql(cloud: TestCloud, text: string, params: ReadonlyArray<unknown>) {
  return try cloud.store.transaction((tx) => tx.query(text, params))
}

effect function grantRefusal<A, E extends { readonly _tag: string }, R>(program: A!E!R): string!!R {
  return match (try exit(program)) {
    when Exit.Success: "granted";
    when Exit.Failure(let cause): Cause.findErrorOption(cause).pipe(Option.map((error) => "refusal" in error ? (refusalBody(error.refusal as Parameters<typeof refusalBody>[0]).reason ?? refusalBody(error.refusal as Parameters<typeof refusalBody>[0]).error) : error._tag), Option.getOrElse(() => "defect"));
  }
}

effect function linkedGrant(cloud: TestCloud, owner: Owner, connectionId: string, refreshToken: string, scopes: ReadonlyArray<string>, expiresAt: number) {
  try cloud.store.transaction((tx) => storeGrant(tx, {
    connectionId, owner, subject: `subject-${connectionId}`, email: `${connectionId}@example.com`, grantedScopes: scopes,
    tokens: { refreshToken, accessToken: `stale-${connectionId}`, expiresAt }, now: expiresAt - 1
  }))
}

describe("WP8 Managed Google: grant access (spec/cloud/services/google/connection.md)", () => {
  it.live("Refresh a held grant once for concurrent callers and mark it Expired when Google refuses it (spec/cloud/services/google/connection.md, \"Story: Connect my Google account with the access I chose\")", () => scoped(effect {
    const google = try Effect.try(() => googleFakeState())
    google.tokenDelayMs = 300
    const cloud = try testCloud({ mount: (fakes) => fakes.mount("/google/", mountGoogleToken(google)) })
    const profileInput = try Effect.try(() => testProfile(cloud.fakes.url))
    const profile = try parseProfile(profileInput)
    const deployment = deploymentLayer(profile, "staging").pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord({ ...secrets }))))
    const now = try Clock.currentTimeMillis
    const held: Owner = { organizationId: "org-google-held", userId: "user-google-held" }
    const lost: Owner = { organizationId: "org-google-lost", userId: "user-google-lost" }
    for (const owner of [held, lost]) {
      try organization(cloud, owner.organizationId)
      try sql(cloud, "INSERT INTO accounts (key, state, revision, organization_id, status, email, created_at, updated_at) VALUES ($1, '{}'::jsonb, 1, $2, 'active', $3, $4, $4)", [owner.userId, owner.organizationId, `${owner.userId}@example.com`, now])
    }
    const scopes = [...scopeFor("google.basic_identity"), ...scopeFor("google.gmail.triage")]
    const heldToken = try Effect.try(() => seedGrant(google, { subject: "subject-conn-held", email: "conn-held@example.com", scopes }))
    const lostToken = try Effect.try(() => seedGrant(google, { subject: "subject-conn-lost", email: "conn-lost@example.com", scopes }))
    google.revoked.add(lostToken)
    provide Store = cloud.store, deployment, FetchHttpClient.layer {
      try linkedGrant(cloud, held, "conn-held", heldToken, scopes, now - 1000)
      try linkedGrant(cloud, lost, "conn-lost", lostToken, scopes, now - 1000)
      const both = try all([useGrant(held, undefined, "google.gmail.triage"), useGrant(held, "conn-held", "google.gmail.triage")], { concurrency: 2 })
      const again = try useGrant(held, undefined, "google.gmail.triage", "subject-conn-held")
      const refusals = {
        missing: try grantRefusal(useGrant(held, undefined, "google.gmail.send")),
        changed: try grantRefusal(useGrant(held, undefined, "google.gmail.triage", "subject-elsewhere")),
        foreign: try grantRefusal(useGrant(held, "conn-lost", "google.gmail.triage")),
        side: try grantRefusal(useGrant(held, "conn-none", "google.gmail.triage")),
        invalidGrant: try grantRefusal(useGrant(lost, undefined, "google.gmail.triage")),
        afterwards: try grantRefusal(useGrant(lost, undefined, "google.gmail.triage"))
      }
      const rows = try sql(cloud, "SELECT key, status, tokens IS NULL AS erased, refreshing_until FROM google_connections ORDER BY key", [])
      try check(() => assert.deepStrictEqual(
        {
          singleFlight: [google.tokenCalls, both[0].accessToken === both[1].accessToken, again.accessToken === both[0].accessToken, both[0].connectionId, both[0].email],
          refusals,
          rows: rows.map((row) => [row.key, row.status, row.erased, Number(row.refreshing_until)])
        },
        {
          singleFlight: [2, true, true, "conn-held", "conn-held@example.com"],
          refusals: { missing: "capability_missing", changed: "google_account_changed", foreign: "not_found", side: "not_found", invalidGrant: "google_reauth_required", afterwards: "google_reauth_required" },
          rows: [["conn-held", "Active", false, 0], ["conn-lost", "Expired", false, 0]]
        }
      ))
    }
  }), 30_000)
})
