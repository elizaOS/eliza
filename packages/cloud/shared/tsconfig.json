{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/billing": ["./src/billing/index.ts"],
      "@/billing/*": ["./src/billing/*"],
      "@/db": ["./src/db/index.ts"],
      "@/db/*": ["./src/db/*"],
      "@/lib": ["./src/lib/index.ts"],
      "@/lib/*": ["./src/lib/*"],
      "@/types": ["./src/types/index.ts"],
      "@/types/*": ["./src/types/*"],
      "@elizaos/cloud-routing": ["../routing/src/index.ts"],
      "@elizaos/cloud-routing/*": ["../routing/src/*"],
      "@elizaos/cloud-sdk": ["../sdk/src/index.ts"],
      "@elizaos/cloud-sdk/*": ["../sdk/src/*"],
      "@elizaos/plugin-sql": ["../../../plugins/plugin-sql/src/index.ts"],
      "@elizaos/core": ["../../../packages/core/src/index.ts"],
      "@elizaos/core/*": ["../../../packages/core/src/*"],
      "@elizaos/plugin-elizacloud": ["../../../plugins/plugin-elizacloud/src/index.ts"],
      "@elizaos/plugin-elizacloud/*": ["../../../plugins/plugin-elizacloud/src/*"],
      "@elizaos/plugin-web-search": ["../../../plugins/plugin-web-search/src/index.ts"],
      "@elizaos/plugin-scheduling": ["../../../plugins/plugin-scheduling/src/index.ts"],
      "@elizaos/plugin-native-inference/model-catalog/bge-input": [
        "../../../plugins/plugin-native-inference/src/model-catalog/bge-input.ts"
      ],
      "@elizaos/plugin-mcp/protocol-utils/prompts": [
        "../../../plugins/plugin-mcp/src/protocol-utils/prompts.ts"
      ],
      "@elizaos/plugin-mcp/protocol-utils/model-provider": [
        "../../../plugins/plugin-mcp/src/protocol-utils/model-provider.ts"
      ],
      "@elizaos/plugin-mcp/protocol-utils/resource-selection": [
        "../../../plugins/plugin-mcp/src/protocol-utils/resource-selection.ts"
      ],
      "@elizaos/plugin-mcp/protocol-utils/action-naming": [
        "../../../plugins/plugin-mcp/src/protocol-utils/action-naming.ts"
      ],
      "@elizaos/plugin-mcp/protocol-utils/json": [
        "../../../plugins/plugin-mcp/src/protocol-utils/json.ts"
      ],
      "@elizaos/plugin-mcp/protocol-utils/schema-converter": [
        "../../../plugins/plugin-mcp/src/protocol-utils/schema-converter.ts"
      ],
      "@elizaos/plugin-native-inference/model-catalog/voice-models": [
        "../../../plugins/plugin-native-inference/src/model-catalog/voice-models.ts"
      ],
      "@elizaos/ui/brand": ["../../ui/src/brand/index.ts"],
      "@elizaos/plugin-mcp/protocol-utils/provider-projection": [
        "../../../plugins/plugin-mcp/src/protocol-utils/provider-projection.ts"
      ],
      "@elizaos/plugin-mcp/protocol-utils/tool-schema-compatibility": [
        "../../../plugins/plugin-mcp/src/protocol-utils/tool-schema-compatibility.ts"
      ],
      "@elizaos/plugin-wallet/lib/market-overview": [
        "../../../plugins/plugin-wallet/src/lib/market-overview.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/lib/services/eliza-sandbox/test-support/**",
    "src/db/repositories/test-support/**"
  ]
}
