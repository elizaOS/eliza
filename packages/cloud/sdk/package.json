{
  "name": "@elizaos/cloud-sdk",
  "version": "2.0.3-beta.7",
  "description": "TypeScript SDK for Eliza Cloud API, auth, and agent management.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build.ts",
    "clean": "rm -rf dist",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src && node scripts/audit-api-routes.mjs",
    "audit:routes": "node scripts/audit-api-routes.mjs",
    "test:e2e": "ELIZA_CLOUD_SDK_LIVE=1 vitest run --config vitest.live.config.ts src/live.e2e.test.ts",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "eliza-source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wallet-provision-challenge": {
      "types": "./dist/wallet-provision-challenge.d.ts",
      "eliza-source": {
        "types": "./src/wallet-provision-challenge.ts",
        "import": "./src/wallet-provision-challenge.ts",
        "default": "./src/wallet-provision-challenge.ts"
      },
      "import": "./dist/wallet-provision-challenge.js",
      "default": "./dist/wallet-provision-challenge.js"
    },
    "./redemption-contract": {
      "types": "./dist/redemption-contract.d.ts",
      "eliza-source": {
        "types": "./src/redemption-contract.ts",
        "import": "./src/redemption-contract.ts",
        "default": "./src/redemption-contract.ts"
      },
      "import": "./dist/redemption-contract.js",
      "default": "./dist/redemption-contract.js"
    },
    "./api-explorer": {
      "types": "./dist/api-explorer/index.d.ts",
      "eliza-source": {
        "types": "./src/api-explorer/index.ts",
        "import": "./src/api-explorer/index.ts",
        "default": "./src/api-explorer/index.ts"
      },
      "import": "./dist/api-explorer/index.js",
      "default": "./dist/api-explorer/index.js"
    },
    "./browser-contracts": {
      "types": "./dist/browser-contracts/index.d.ts",
      "eliza-source": {
        "types": "./src/browser-contracts/index.ts",
        "import": "./src/browser-contracts/index.ts",
        "default": "./src/browser-contracts/index.ts"
      },
      "import": "./dist/browser-contracts/index.js",
      "default": "./dist/browser-contracts/index.js"
    },
    "./account-billing-snapshot": {
      "types": "./dist/account-billing-snapshot.d.ts",
      "eliza-source": {
        "types": "./src/account-billing-snapshot.ts",
        "import": "./src/account-billing-snapshot.ts",
        "default": "./src/account-billing-snapshot.ts"
      },
      "import": "./dist/account-billing-snapshot.js",
      "default": "./dist/account-billing-snapshot.js"
    },
    "./cloud-setup-session": {
      "types": "./dist/cloud-setup-session/index.d.ts",
      "import": "./dist/cloud-setup-session/index.js",
      "default": "./dist/cloud-setup-session/index.js"
    },
    "./cloud-setup-session/*": {
      "types": "./dist/cloud-setup-session/*.d.ts",
      "import": "./dist/cloud-setup-session/*.js",
      "default": "./dist/cloud-setup-session/*.js"
    },
    "./package.json": "./package.json"
  },
  "elizaos": {
    "managedIntegration": {
      "promoted": true,
      "contractId": "eliza-cloud-api"
    },
    "scripts": {
      "coreBuild": true,
      "testLanes": [
        "server"
      ]
    }
  },
  "dependencies": {
    "@elizaos/shared": "workspace:*",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
