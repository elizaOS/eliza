{
  "name": "@elizaos/cloud-routing",
  "version": "2.0.3-beta.7",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc6 --noCheck -p tsconfig.json && node ../../scripts/prepare-package-dist.ts packages/cloud/routing",
    "clean": "rm -rf dist",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write --unsafe src",
    "lint:check": "bunx @biomejs/biome check src",
    "format": "bunx @biomejs/biome format --write src",
    "format:check": "bunx @biomejs/biome format src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^25.0.0",
    "bun-types": "1.4.2",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "elizaos": {
    "scripts": {
      "coreBuild": true
    }
  }
}
