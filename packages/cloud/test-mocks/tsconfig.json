{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "bun-types", "vite/client"],
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*.ts", "./bin/**/*.ts", "./test/**/*.ts"],
  "exclude": ["node_modules"]
}
