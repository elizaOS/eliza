    "triggers": [
      {
        "name": "managed_gmail_operation_receipt_guard",
        "enabled": "O",
        "definition": "CREATE TRIGGER managed_gmail_operation_receipt_guard BEFORE UPDATE ON public.managed_gmail_operation_receipts FOR EACH ROW EXECUTE FUNCTION guard_managed_gmail_operation_receipt()"
      }
    ],
    "functions": [
      {
        "defaultAcl": true,
        "definition": "CREATE OR REPLACE FUNCTION public.guard_managed_gmail_operation_receipt()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF (NEW.organization_id,NEW.user_id,NEW.grant_id,NEW.request_id,NEW.kind,NEW.review_digest,NEW.created_at)\n     IS DISTINCT FROM (OLD.organization_id,OLD.user_id,OLD.grant_id,OLD.request_id,OLD.kind,OLD.review_digest,OLD.created_at) THEN\n    RAISE EXCEPTION 'Gmail operation identity and review are immutable' USING ERRCODE='55000';\n  END IF;\n  IF NOT ((OLD.state='prepared' AND NEW.state='dispatched')\n      OR (OLD.state='dispatched' AND NEW.state IN ('succeeded','rejected','outcome-unknown'))) THEN\n    RAISE EXCEPTION 'Gmail operation cannot be redispatched or rewritten' USING ERRCODE='55000';\n  END IF;\n  IF OLD.dispatched_at IS NOT NULL AND NEW.dispatched_at IS DISTINCT FROM OLD.dispatched_at THEN\n    RAISE EXCEPTION 'Gmail dispatch identity is immutable' USING ERRCODE='55000';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n",
        "ownedByExpectedRole": true
      }
    ],
    "constraints": [
      {
        "name": "managed_gmail_operation_receipts_check",
        "deferred": false,
        "validated": true,
        "deferrable": false,
        "definition": "CHECK ((((state = 'prepared'::text) AND (dispatched_at IS NULL) AND (finished_at IS NULL)) OR ((state = 'dispatched'::text) AND (dispatched_at IS NOT NULL) AND (finished_at IS NULL)) OR ((state = ANY (ARRAY['succeeded'::text, 'rejected'::text, 'outcome-unknown'::text])) AND (dispatched_at IS NOT NULL) AND (finished_at IS NOT NULL))))",
        "enforced": true
      },
      {
        "name": "managed_gmail_operation_receipts_check1",
        "deferred": false,
        "validated": true,
        "deferrable": false,
        "definition": "CHECK (((state = 'succeeded'::text) = (provider_result IS NOT NULL)))",
        "enforced": true
      },
      {
        "name": "managed_gmail_operation_receipts_check2",
        "deferred": false,
        "validated": true,
        "deferrable": false,
        "definition": "CHECK (((rejection_code IS NULL) OR (state = 'rejected'::text)))",
        "enforced": true
      },
      {
        "name": "managed_gmail_operation_receipts_kind_check",
        "deferred": false,
        "validated": true,
        "deferrable": false,
        "definition": "CHECK ((kind = ANY (ARRAY['send'::text, 'draft-create'::text, 'draft-replace'::text, 'draft-delete'::text, 'archive'::text, 'unarchive'::text, 'trash'::text, 'untrash'::text, 'mark-read'::text, 'mark-unread'::text])))",
        "enforced": true
      },
      {
        "name": "managed_gmail_operation_receipts_organization_id_fkey",
