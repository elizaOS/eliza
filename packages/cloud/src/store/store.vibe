// spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile"
module node {
  import { readdir, readFile } from "node:fs/promises"
  import { PGlite } from "@electric-sql/pglite"

  export type Row = Readonly<Record<string, unknown>>

  export interface Connection {
    query(sql: string, params: ReadonlyArray<unknown>): Promise<ReadonlyArray<Row>>
    release(): Promise<void>
  }

  export interface Pool {
    readonly permits: number
    connect(): Promise<Connection>
    close(): Promise<void>
  }

  export interface Migration {
    readonly name: string
    readonly sql: string
  }

  const poolSize = 10

  /** @throws {unknown} */
  function safeInteger(text: string): number {
    const value = BigInt(text)
    if (value > BigInt(Number.MAX_SAFE_INTEGER) || value < BigInt(Number.MIN_SAFE_INTEGER)) throw new RangeError(`int8 ${text} is outside the safe range`)
    return Number(value)
  }

  /** @throws {unknown} */
  export async function openPglite(file: string | undefined): Promise<Pool> {
    const db = file === undefined ? new PGlite() : new PGlite(file)
    await db.waitReady
    const connection: Connection = {
      query: async (sql, params) => (await db.query<Row>(sql, [...params])).rows,
      release: async () => {}
    }
    return { permits: 1, connect: async () => connection, close: () => db.close() }
  }

  /** @throws {unknown} */
  export async function openPg(url: string): Promise<Pool> {
    const { default: pg } = await import("pg")
    const pool = new pg.Pool({
      connectionString: url,
      max: poolSize,
      types: { getTypeParser: (oid: number, format?: string) => oid === 20 ? safeInteger : pg.types.getTypeParser(oid, format as "text") }
    })
    return {
      permits: poolSize,
      connect: async () => {
        const client = await pool.connect()
        return {
          query: async (sql, params) => (await client.query(sql, [...params])).rows as ReadonlyArray<Row>,
          release: async () => client.release()
        }
      },
      close: () => pool.end()
    }
  }

  /** @throws {unknown} */
  export async function migrationFiles(): Promise<ReadonlyArray<Migration>> {
    const directory = new URL("./migrations/", import.meta.url)
    const names = (await readdir(directory)).filter((name) => /^\d{4}_[a-z0-9_]+\.sql$/.test(name)).sort()
    return Promise.all(names.map(async (name) => ({ name, sql: await readFile(new URL(name, directory), "utf8") })))
  }

  /** @throws {unknown} */
  export async function runScript(connection: Connection, sql: string): Promise<void> {
    await connection.query(sql, [])
  }
}
import { migrationFiles, openPg, openPglite, type Connection, type Migration, type Pool, type Row } from node

export type { Row }

export type StoreLocation =
  | { readonly kind: "pg"; readonly url: string }
  | { readonly kind: "pglite"; readonly file: string | undefined }

export error StoreFailure { operation: string; cause: unknown }
export error DatabaseIdentityMismatch { expected: string; found: string }
export error StoreLocationInvalid { input: string }

export interface Tx {
  query(sql: string, params?: ReadonlyArray<unknown>): ReadonlyArray<Row>!StoreFailure
}

export service Store {
  static readonly key = "@elizaos/cloud/store/Store"
  readonly location: StoreLocation
  transaction<A, E, R>(body: (tx: Tx) => A!E!R): A!(E | StoreFailure)!R
}

export effect function parseStoreLocation(input: string): StoreLocation!StoreLocationInvalid {
  if (input === "pglite") return { kind: "pglite", file: undefined }
  if (input.startsWith("pglite:") && input.length > "pglite:".length) return { kind: "pglite", file: input.slice("pglite:".length) }
  if (/^postgres(ql)?:\/\/./.test(input)) return { kind: "pg", url: input }
  throw new StoreLocationInvalid({ input: input.startsWith("postgres") ? "postgres://…" : input })
}

effect function foreign<A>(operation: string, run: () => Promise<A>): A!StoreFailure {
  return try tryPromise({ try: run, catch: (cause) => new StoreFailure({ operation, cause }) })
}

function txOver(connection: Connection): Tx {
  return { query: (sql, params = []) => foreign("query", () => connection.query(sql, params)) }
}

effect function finish(connection: Connection, committed: boolean) {
  try foreign(committed ? "commit" : "rollback", () => connection.query(committed ? "COMMIT" : "ROLLBACK", [])) catch () => undefined
  try foreign("release", () => connection.release()) catch () => undefined
}

effect function storeOver(location: StoreLocation, pool: Pool): Store.Shape!! {
  const permits = try Semaphore.make(pool.permits)
  return {
    location,
    transaction: <A, E, R>(body: (tx: Tx) => A!E!R) => permits.withPermits(1)(acquireUseRelease(
      effect {
        const connection = try foreign("connect", () => pool.connect())
        try foreign("begin", () => connection.query("BEGIN", [])) catch effect (failure) => {
          try foreign("release", () => connection.release()) catch () => undefined
          throw failure
        }
        return connection
      },
      (connection) => body(txOver(connection)),
      (connection, exit) => finish(connection, Exit.isSuccess(exit))
    ))
  }
}

export function storeLayer(location: StoreLocation): Layer.Layer<Store, StoreFailure> {
  return Layer.effect(Store, effect {
    const pool = try acquireRelease(
      foreign("open", () => location.kind === "pg" ? openPg(location.url) : openPglite(location.file)),
      (opened) => foreign("close", () => opened.close()) catch () => undefined
    )
    return try storeOver(location, pool)
  })
}

export function toInt(value: unknown): number {
  return typeof value === "number" ? value : typeof value === "bigint" ? Number(value) : typeof value === "string" && /^-?\d+$/.test(value) ? Number(value) : Number.NaN
}

export function toText(value: unknown): string | undefined {
  return typeof value === "string" ? value : undefined
}

effect function identityDigest(tx: Tx): string | undefined!StoreFailure {
  const table = try tx.query("SELECT to_regclass('cloud_identity') IS NOT NULL AS present")
  if (table[0]?.present !== true) return undefined
  return toText((try tx.query("SELECT digest FROM cloud_identity"))[0]?.digest)
}

export effect function assertDatabaseIdentity(tx: Tx, expected: string): void!(StoreFailure | DatabaseIdentityMismatch) {
  const found = try identityDigest(tx)
  if (found !== expected) throw new DatabaseIdentityMismatch({ expected, found: found ?? "none" })
}

export interface MigrationReport {
  readonly applied: ReadonlyArray<string>
  readonly identity: string
}

export effect function migrate(options: { readonly digest: string; readonly environment: "production" | "staging"; readonly now: number }): MigrationReport!(StoreFailure | DatabaseIdentityMismatch)!Store {
  const store = try Store
  const migrations: ReadonlyArray<Migration> = try foreign("read migrations", () => migrationFiles())
  return try store.transaction(effect (tx: Tx) => {
    try tx.query("SELECT pg_advisory_xact_lock(4242001)")
    const found = try identityDigest(tx)
    if (found !== undefined && found !== options.digest) throw new DatabaseIdentityMismatch({ expected: options.digest, found })
    try tx.query("CREATE TABLE IF NOT EXISTS schema_migrations (name text PRIMARY KEY, applied_at bigint NOT NULL)")
    const done = new Set((try tx.query("SELECT name FROM schema_migrations")).map((row) => toText(row.name)))
    const applied: string[] = []
    for (const migration of migrations) {
      if (done.has(migration.name)) continue
      try tx.query(migration.sql)
      try tx.query("INSERT INTO schema_migrations (name, applied_at) VALUES ($1, $2)", [migration.name, options.now])
      applied.push(migration.name)
    }
    if (found === undefined) {
      try tx.query("INSERT INTO cloud_identity (digest, environment, created_at) VALUES ($1, $2, $3)", [options.digest, options.environment, options.now])
    }
    return { applied, identity: options.digest }
  })
}
