// spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile"; spec/cloud/deployment.md, "Story: Answer only the deployment's own callers"
import { corsGrant, enabledServices, profileAccepted, routeOpen, methodsAnswer, type MethodsAnswer, type Capability as SpecCapability, type EnvironmentProfile as ProfileRow, type Profile as SpecProfile, type SignInSetup } from "../../gen/cloud__deployment.effect.vibe"
import { CloudEnvironment as EnvironmentSchema, CloudProfile, type Capability, type EnvironmentProfile, type LegalDocument } from "./profile.schema.ts"

export type { Capability, CloudProfile, EnvironmentProfile, LegalDocument }
export type CloudEnvironment = typeof EnvironmentSchema.Type

export error ProfileInvalid { problem: string }
export error SecretMissing { name: string }

export interface MailBinding {
  send(message: { from: string; to: string; subject: string; text: string }): Promise<unknown>
}

export const capabilityOf: Readonly<Record<Capability, SpecCapability>> = {
  inference: "InferenceCapability",
  speech: "SpeechCapability",
  maps: "MapsCapability",
  managedGoogle: "ManagedGoogleCapability",
  billing: "BillingCapability"
}

const wireCapability: Readonly<Record<SpecCapability, Capability>> = {
  InferenceCapability: "inference",
  SpeechCapability: "speech",
  MapsCapability: "maps",
  ManagedGoogleCapability: "managedGoogle",
  BillingCapability: "billing"
}

function isLoopback(origin: string): boolean {
  return /^https?:\/\/(?:localhost|127\.0\.0\.1)(?::\d+)?$/.test(origin)
}

function signInSetup(settings: EnvironmentProfile): SignInSetup {
  return {
    mail: settings.mail.kind === "https" ? "HttpsDelivery" : settings.mail.kind === "binding" ? "BindingDelivery" : "LoopbackDelivery",
    sms: settings.sms.kind === "https" ? "HttpsDelivery" : settings.sms.kind === "loopback" ? "LoopbackDelivery" : "NoDelivery",
    google: settings.google ? "GoogleOn" : "GoogleOff"
  }
}

export function rowOf(name: string, settings: EnvironmentProfile): ProfileRow {
  const document = (doc: LegalDocument) => ({ ...doc, sections: doc.sections.map((section) => ({ ...section, paragraphs: [...section.paragraphs] })) })
  return {
    name, api: settings.api, web: settings.web, audience: settings.entitlementAudience,
    mailSender: settings.mailSender, databaseDigest: settings.databaseIdentity, firstPartyOrigins: [...settings.firstPartyOrigins],
    capabilities: settings.capabilities.map((value) => capabilityOf[value]), signIn: signInSetup(settings),
    terms: document(settings.documents.terms), privacy: document(settings.documents.privacy)
  }
}

function configured(settings: EnvironmentProfile) {
  const mapsServed = settings.maps !== undefined && settings.maps.provider !== "none"
  return settings.capabilities.includes("maps") === mapsServed &&
    settings.capabilities.every((capability) => capability === "managedGoogle" ? settings.google !== undefined : settings[capability] !== undefined)
}

export function specProfile(profile: CloudProfile): SpecProfile {
  return { production: rowOf(profile.environments.production.name, profile.environments.production), staging: rowOf(profile.environments.staging.name, profile.environments.staging) }
}

export effect function parseProfile(input: unknown): CloudProfile!ProfileInvalid {
  const profile = Schema.decodeUnknownEffect(CloudProfile)(input) catch effect (failure) => { throw new ProfileInvalid({ problem: failure.message }) }
  if (!profileAccepted(specProfile(profile)) ||
      profile.environments.production.firstPartyOrigins.some(isLoopback) || !configured(profile.environments.production) || !configured(profile.environments.staging)) {
    throw new ProfileInvalid({ problem: "the profile breaks a deployment rule: distinct origins and databases, a sign-in method and complete documents per environment, configured providers for every enabled capability, maps enabled exactly when a maps provider is set, and no loopback adapter or first-party origin in production" })
  }
  return profile
}

export effect function parseEnvironment(input: string): CloudEnvironment!ProfileInvalid {
  return Schema.decodeUnknownEffect(EnvironmentSchema)(input) catch effect () => { throw new ProfileInvalid({ problem: `environment must be production or staging, not ${JSON.stringify(input)}` }) }
}

export effect function readProfile(file: string): CloudProfile!ProfileInvalid!FileSystem.FileSystem {
  const fs = try FileSystem.FileSystem
  const text = fs.readFileString(file) catch effect () => { throw new ProfileInvalid({ problem: `cannot read ${file}` }) }
  const parsed = try Effect.try({ try: () => JSON.parse(text) as unknown, catch: () => new ProfileInvalid({ problem: `${file} is not JSON` }) })
  return try parseProfile(parsed)
}

export service Deployment {
  static readonly key = "@elizaos/cloud/profile/Deployment"
  readonly profile: CloudProfile
  readonly environment: CloudEnvironment
  readonly settings: EnvironmentProfile
  secret(name: string): string!SecretMissing
  mailBinding(name: string): MailBinding!SecretMissing
}

function isMailBinding(value: unknown): value is MailBinding {
  return typeof value === "object" && value !== null && "send" in value && typeof value.send === "function"
}

export function deploymentLayer(profile: CloudProfile, environment: CloudEnvironment, bindings: object = {}): Layer.Layer<Deployment> {
  return Layer.effect(Deployment, effect {
    const provider = try ConfigProvider.ConfigProvider
    return {
      profile,
      environment,
      settings: profile.environments[environment],
      secret: effect (name: string) => {
        const value = provideService(Config.Redacted(name), ConfigProvider.ConfigProvider, provider) catch effect () => { throw new SecretMissing({ name }) }
        return Redacted.value(value)
      },
      mailBinding: effect (name: string) => {
        const bound: unknown = Reflect.get(bindings, name)
        if (!isMailBinding(bound)) throw new SecretMissing({ name })
        return bound
      }
    }
  })
}

export effect function requireSecrets(): void!SecretMissing!Deployment {
  const deployment = try Deployment
  const settings = deployment.settings
  const names = [
    settings.digestKeyEnv,
    settings.entitlement.signingKeyEnv,
    ...settings.sealing.keys.map((key) => key.env),
    ...(settings.mail.kind === "https" ? [settings.mail.apiKeyEnv] : []),
    ...(settings.sms.kind === "https" ? [settings.sms.accountEnv, settings.sms.tokenEnv] : []),
    ...(settings.google === undefined ? [] : [settings.google.clientSecretEnv]),
    ...(settings.billing === undefined ? [] : [settings.billing.secretKeyEnv, settings.billing.webhookSecretEnv]),
    ...(settings.inference?.providers.map((provider) => provider.apiKeyEnv) ?? []),
    ...(settings.speech === undefined ? [] : [settings.speech.apiKeyEnv]),
    ...(settings.maps?.provider === "google" ? [settings.maps.apiKeyEnv] : [])
  ]
  for (const name of names) try deployment.secret(name)
  if (settings.mail.kind === "binding") try deployment.mailBinding(settings.mail.binding)
}

export function corsForOrigin(settings: EnvironmentProfile, origin: string): boolean {
  return corsGrant(rowOf(settings.name, settings), { tag: "FromOrigin", origin }) === "CredentialedGrant"
}

export function capabilityEnabled(settings: EnvironmentProfile, capability: Capability): boolean {
  return routeOpen(settings.capabilities.map((offered) => capabilityOf[offered]), { tag: "Gated", capability: capabilityOf[capability] })
}

export function enabledCapabilities(settings: EnvironmentProfile): ReadonlyArray<Capability> {
  return enabledServices(settings.capabilities.map((value) => capabilityOf[value])).map((spec) => wireCapability[spec])
}

export function signInMethods(settings: EnvironmentProfile): MethodsAnswer {
  return methodsAnswer(signInSetup(settings))
}

export interface ServiceDocument {
  readonly success: true
  readonly version: 1
  readonly service: { readonly name: string; readonly terms: LegalDocument; readonly privacy: LegalDocument }
}

export function serviceDocument(profile: CloudProfile, settings: EnvironmentProfile): ServiceDocument {
  return { success: true, version: 1, service: { name: settings.name, terms: settings.documents.terms, privacy: settings.documents.privacy } }
}
