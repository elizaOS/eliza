// spec/cloud/index.md, "Story: Back up my passwords for another device"
import type { Client } from "pg"
import { HttpServerResponse } from "effect/http"
import { authQuery, accountTransaction, browserAccount, rateLimit, RateLimited, StorageUnavailable } from "./identity-store.vibe"
import { browserNativeRegistration, mobileRegistration, type NativeRegistryEnv } from "./native-registry.vibe"
import { secretText, tokenDigest, s256 } from "./shared/credential-crypto.vibe"

const backupPath = "/api/v1/app-auth/mobile/password-backup"
const maximumBytes = 2097152
const leaseMs = 300000
const proofText = /^[A-Za-z0-9._~-]{43,128}$/
const backupCode = /^pbackup_[A-Za-z0-9_-]{43}$/
const noStore = { "cache-control": "no-store" }

type Purpose = "read" | "save" | "delete" | "verify"
type Approval = { client_id: string; organization_id: string; account_id: string; environment: string; redirect_uri: string }
type Revision = { revision: number }
type Snapshot = Revision & { snapshot: Uint8Array | null }
type Observation = Revision & { present: boolean }

schema ApprovalInput {
  clientId: string
  environment: string
  redirectUri: string
  state: string
  codeChallenge: string
  codeChallengeMethod: "S256"
  purpose: "read" | "save" | "delete" | "verify"
}

function json(status: number, body: object) {
  return HttpServerResponse.jsonUnsafe(body, { status, headers: noStore })
}

function refuse(status: number, error: string) {
  return json(status, { error })
}

function etag(revision: number) {
  return '"' + revision.toString() + '"'
}

function expectedRevision(request: Request): number | null | undefined {
  const match = request.headers.get("if-match")
  const absent = request.headers.get("if-none-match")
  if (match === null) return absent === "*" ? null : undefined
  if (absent !== null) return undefined
  const rev = Number(/^"([1-9][0-9]{0,9})"$/.exec(match)?.[1])
  return Number.isInteger(rev) && rev <= 2147483647 ? rev : undefined
}

function proofDigest(code: string, challenge: string, state: string, purpose: Purpose) {
  return tokenDigest(JSON.stringify([code, challenge, state, purpose]))
}

async function limitedBody(request: Request, limit: number) {
  const reader = request.body?.getReader()
  if (!reader) return null
  const pieces: Uint8Array[] = []
  let length = 0
  try {
    for (;;) {
      const next = await reader.read()
      if (next.done) break
      length += next.value.byteLength
      if (length > limit) {
        await reader.cancel()
        return null
      }
      pieces.push(next.value)
    }
    if (length === 0) return null
    const bytes = new Uint8Array(length)
    let offset = 0
    for (const piece of pieces) {
      bytes.set(piece, offset)
      offset += piece.byteLength
    }
    return bytes
  } finally {
    reader.releaseLock()
  }
}

effect function readBody(request: Request, ceiling: number) {
  return try tryPromise({ try: () => limitedBody(request, ceiling), catch: () => new StorageUnavailable() })
}

effect function approve(request: Request, env: NativeRegistryEnv, db: Client) {
  const origin = request.headers.get("origin")
  if ((origin !== env.WEB_ORIGIN && origin !== env.PUBLIC_API_ORIGIN) || request.headers.has("authorization"))
    return refuse(403, "browser_session_required")
  if (request.headers.get("content-type")?.split(";")[0] !== "application/json") return refuse(415, "invalid_content_type")
  const bytes = try readBody(request, 8192)
  if (!bytes) return refuse(400, "invalid_approval")
  const raw = Effect.try({ try: () => JSON.parse(new TextDecoder().decode(bytes)) as unknown, catch: () => new StorageUnavailable() }) catch () => null
  const parsed = Schema.decodeUnknownOption(ApprovalInput, { onExcessProperty: "error" })(raw)
  if (Option.isNone(parsed)) return refuse(400, "invalid_approval")
  const input = parsed.value
  if (!proofText.test(input.state) || !/^[A-Za-z0-9_-]{43}$/.test(input.codeChallenge)) return refuse(400, "invalid_proof")
  const registration = mobileRegistration(env, input.clientId, input.environment, input.redirectUri)
  if (registration.kind === "refused") return refuse(registration.status, registration.error)
  const client = registration.registration
  const user = try browserAccount(request, db)
  const now = try Clock.currentTimeMillis
  if (!user || user.authAt > now || user.authAt <= now - leaseMs) return refuse(401, "recent_auth_required")

  try rateLimit(db, "password-backup:authorize", user.id, 8, 300)
  const code = secretText("pbackup_", 32, "base64url")
  const scope = [client.clientId, user.organizationId, user.id]
  return try accountTransaction(db, effect {
    const observed = input.purpose === "verify" ? undefined : (try authQuery<Observation>(db, `
      SELECT revision, snapshot IS NOT NULL AS present FROM cloud_password_backups
      WHERE client_id = $1 AND organization_id = $2 AND account_id = $3
    `, scope)).rows[0]
    try authQuery(db, "DELETE FROM cloud_password_backup_approvals WHERE expires_at <= $1", [now])
    if (input.purpose !== "verify") try authQuery(db, `
      INSERT INTO cloud_password_backup_approvals
        (proof_digest, session_key, account_id, organization_id, client_id, environment, redirect_uri, expires_at)
      VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
    `, [proofDigest(code, input.codeChallenge, input.state, input.purpose), user.sessionKey, user.id, user.organizationId,
      client.clientId, input.environment, input.redirectUri, now + leaseMs])
    return json(200, { code, scope: tokenDigest(JSON.stringify([env.PUBLIC_API_ORIGIN, ...scope])),
      ownerId: user.id, revision: observed ? etag(observed.revision) : null, present: observed?.present ?? false })
  })
}

function requestProof(request: Request, purpose: Purpose) {
  const code = request.headers.get("authorization")?.match(/^Bearer ([^\s]+)$/)?.[1]
  const verifier = request.headers.get("x-backup-verifier")
  const state = request.headers.get("x-backup-state")
  return code && backupCode.test(code) && verifier && proofText.test(verifier) && state && proofText.test(state) ?
    proofDigest(code, s256(verifier), state, purpose) : null
}

effect function accessBackup(request: Request, env: NativeRegistryEnv, db: Client, purpose: "read" | "save" | "delete") {
  const digest = requestProof(request, purpose)
  if (!digest) return refuse(401, "backup_approval_required")
  const expected = expectedRevision(request)
  if ((purpose === "save" && expected === undefined) || (purpose === "delete" && expected == null))
    return refuse(428, "backup_revision_required")
  if (purpose === "save" && request.headers.get("content-type") !== "application/octet-stream") return refuse(415, "invalid_content_type")
  const bytes = purpose === "save" ? try readBody(request, maximumBytes) : null
  if (purpose === "save" && !bytes) return refuse(413, "invalid_snapshot_size")
  const now = try Clock.currentTimeMillis

  return try accountTransaction(db, effect {
    const grant = (try authQuery<Approval>(db, `
      WITH active AS MATERIALIZED (
        SELECT p.proof_digest FROM cloud_password_backup_approvals p
        JOIN sessions s ON s.key = p.session_key AND s.user_id = p.account_id
        JOIN accounts a ON a.key = p.account_id AND a.organization_id = p.organization_id
        WHERE p.proof_digest = $1 AND p.expires_at > $2
          AND s.live AND s.access_expires_at > $2 AND a.status = 'active'
          AND (s.state->>'epoch')::bigint = a.sessions_revoked_before
        FOR SHARE OF s, a
      )
      DELETE FROM cloud_password_backup_approvals p USING active
      WHERE p.proof_digest = active.proof_digest
      RETURNING p.client_id, p.organization_id, p.account_id, p.environment, p.redirect_uri
    `, [digest, now])).rows[0]
    if (!grant) return refuse(401, "backup_approval_required")
    const admitted = mobileRegistration(env, grant.client_id, grant.environment, grant.redirect_uri)
    if (admitted.kind !== "registered") return refuse(401, "backup_approval_required")
    const scope = [grant.client_id, grant.organization_id, grant.account_id]
    if (purpose === "read") {
      const row = (try authQuery<Snapshot>(db, `
        SELECT revision, snapshot FROM cloud_password_backups
        WHERE client_id = $1 AND organization_id = $2 AND account_id = $3
      `, scope)).rows[0]
      const headers = { ...noStore, ...(row ? { etag: etag(row.revision) } : {}) }
      return row?.snapshot
        ? HttpServerResponse.uint8Array(row.snapshot, { headers: { ...headers, "content-type": "application/octet-stream" } })
        : HttpServerResponse.empty({ status: 404, headers })
    }
    const applied = expected === null
      ? try authQuery<Revision>(db, `
          INSERT INTO cloud_password_backups (client_id, organization_id, account_id, revision, snapshot)
          VALUES ($1, $2, $3, 1, $4) ON CONFLICT DO NOTHING RETURNING revision
        `, [...scope, bytes])
      : try authQuery<Revision>(db, `
          UPDATE cloud_password_backups SET revision = revision + 1, snapshot = $4
          WHERE client_id = $1 AND organization_id = $2 AND account_id = $3 AND revision = $5
            AND revision < 2147483647 AND ($6 OR snapshot IS NOT NULL)
          RETURNING revision
        `, [...scope, bytes, expected, purpose === "save"])
    const changed = applied.rows[0]
    return changed ? HttpServerResponse.empty({ status: 204, headers: { ...noStore, etag: etag(changed.revision) } })
      : refuse(412, "backup_revision_conflict")
  })
}

export function ownsPasswordBackupPath(path: string) {
  return path === backupPath || path === backupPath + "/readiness"
}

effect function handleBackup(request: Request, env: NativeRegistryEnv, db: Client) {
  const url = new URL(request.url)
  if (url.origin !== env.PUBLIC_API_ORIGIN) return refuse(404, "not_found")
  if (url.pathname === backupPath + "/readiness" && request.method === "GET") {
    const registration = browserNativeRegistration(env)
    if (!registration || registration.clientId !== url.searchParams.get("clientId")) return refuse(404, "not_found")
    try authQuery(db, "SELECT 1 FROM cloud_password_backups, cloud_password_backup_approvals LIMIT 0")
    return HttpServerResponse.empty({ status: 204, headers: noStore })
  }
  if (url.pathname !== backupPath) return refuse(404, "not_found")
  switch (request.method) {
    case "POST": return try approve(request, env, db)
    case "GET": return try accessBackup(request, env, db, "read")
    case "PUT": return try accessBackup(request, env, db, "save")
    case "DELETE": return try accessBackup(request, env, db, "delete")
    default: return refuse(405, "method_not_allowed")
  }
}

export function passwordBackupRequest(request: Request, env: NativeRegistryEnv, db: Client): Promise<Response> {
  return runPromise(effect {
    const response = handleBackup(request, env, db) catch (error) => match (error) {
      when RateLimited: refuse(429, "rate_limited");
      default: refuse(503, "password_backup_unavailable");
    }
    return HttpServerResponse.toWeb(response)
  })
}
