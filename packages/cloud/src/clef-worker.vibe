// spec/cloud/index.md, "Story: Ask for a bounded decision about a browser page"
import type { Client } from "pg"
import { SecureRandom } from "effect/crypto"
import { decisionAccountLimit, decisionOrganizationLimit } from "../gen/cloud.ts"
import { WorkerResponse } from "./worker-platform.ts"
import { limitedBody } from "./inference.vibe"
import { accountTransaction, authQuery, rateLimit, RateLimited } from "./identity-store.vibe"
import {
  CLEF_DECISION_TIMEOUT_MS, CLEF_NO_CHOICE, CLEF_ASK_THRESHOLD, CLEF_TURN_COMPLETE_THRESHOLD,
  decodeClefRequest, decodeClefResult, type ClefDecisionRequest,
} from "./clef-decisions.vibe"

const model = "clef-flash"
const modelId = "@cf/cloudflare/clef-flash"
type Question =
  | { type: "choice"; instructions: string; criteria: Record<string, string> }
  | { type: "noul"; instructions: string; criteria: { true: string; false: string } }

export type ClefEnv = {
  AI?: { run(id: typeof modelId, input: { model: typeof model; state: unknown; questions: Record<string, Question> }): Promise<unknown> }
}

const response = Schema.decodeUnknownOption(Schema.Struct({
  model: Schema.String, answers: Schema.Record(Schema.String, Schema.Unknown),
}))
const probability = Schema.Finite.check(Schema.isBetween({ minimum: 0, maximum: 1 }))
const booleanAnswer = Schema.decodeUnknownOption(Schema.Struct({ type: Schema.Literal("noul"), noul: probability }))
const choiceAnswer = Schema.decodeUnknownOption(Schema.Struct({
  type: Schema.Literal("choice"), choice: Schema.String, confidence: probability,
  probabilities: Schema.Record(Schema.String, probability),
}))
const maxBytes = 160 * 1024
const providerDeadlineMs = CLEF_DECISION_TIMEOUT_MS - 5_000

function publicText(text: string) {
  return text.replace(/https?:\/\/\S+|[\w.+-]+@[\w.-]+\.[\w-]+|\bBearer\s+[^\s]+|\b\d{6}\b|\b(?:\d[ -]?){12,19}\b/giu, "…")
    .replace(/\b(password|passcode|otp|pin|secret|cookie|token)\s*[:=]\s*[^\s]+/giu, "$1: …")
    .replace(/[\p{Cc}\p{Cf}]/gu, " ").trim()
}

function question(request: ClefDecisionRequest): { state: unknown; questions: Record<string, Question> } {
  switch (request.kind) {
    case "choice":
      return {
        state: { goal: publicText(request.goal), page: publicText(request.page ?? "") },
        questions: { target: { type: "choice", instructions: "Which control should this person use next to reach their goal? Choose none if no control clearly fits.",
          criteria: Object.fromEntries([...request.candidates.map(({ id, label }) => [id, publicText(label)]), [CLEF_NO_CHOICE, "None fits the goal."]]) } },
      }
    case "mode":
      return {
        state: { action: publicText(request.action), context: publicText(request.context ?? "") },
        questions: { ask: { type: "noul", instructions: "Should the assistant ask for a clear yes first? Ask before payments, buying, credentials, messages, personal data, account changes, deletion, consent, booking, or anything hard to undo.",
          criteria: { true: "Stop and ask the person first.", false: "Safe to narrate and do." } } },
      }
    case "turn":
      return {
        state: { recentTurns: request.recentTurns?.map(({ speaker, text }) => ({ speaker, text: publicText(text) })) ?? [], currentTurn: publicText(request.transcript) },
        questions: { complete: { type: "noul", instructions: "Has the person finished speaking and expects an answer? No if the words trail off, stop mid-sentence or mid-number, or the person is still thinking.",
          criteria: { true: "The person has finished.", false: "The person is still talking or paused mid-thought." } } },
      }
  }
}

function decision(request: ClefDecisionRequest, raw: unknown) {
  const decoded = response(raw)
  if (Option.isNone(decoded) || (decoded.value.model !== model && decoded.value.model !== modelId)) return undefined
  const { answers } = decoded.value
  const successful = { status: "ok", model }
  if (request.kind === "choice") {
    const found = choiceAnswer(answers.target)
    if (Option.isNone(found)) return undefined
    const { choice, confidence, probabilities } = found.value
    return decodeClefResult(request, { ...successful, kind: "choice", choice: choice === CLEF_NO_CHOICE ? null : choice, confidence, probabilities })
  }
  const found = booleanAnswer(request.kind === "mode" ? answers.ask : answers.complete)
  if (Option.isNone(found)) return undefined
  const score = found.value.noul
  return request.kind === "mode"
    ? decodeClefResult(request, { ...successful, kind: "mode", suggestedMode: score >= CLEF_ASK_THRESHOLD ? "ask" : "tell", askProbability: score })
    : decodeClefResult(request, { ...successful, kind: "turn", complete: score >= CLEF_TURN_COMPLETE_THRESHOLD, completeProbability: score })
}

const unavailable = (reason: "disabled" | "provider_error") => WorkerResponse.json({ status: "unavailable", reason }, { status: 503 })

effect function admit(db: Client, account: string) {
  return try accountTransaction(db, effect {
    const { rows } = try authQuery<{ organization_id: string }>(db, "SELECT organization_id FROM accounts WHERE key = $1 AND status = 'active'", [account])
    const organization = rows[0]?.organization_id
    if (!organization) return false
    try rateLimit(db, decisionAccountLimit.name, account, decisionAccountLimit.limit, decisionAccountLimit.windowMs / 1000)
    try rateLimit(db, decisionOrganizationLimit.name, organization, decisionOrganizationLimit.limit, decisionOrganizationLimit.windowMs / 1000)
    return true
  })
}

export async function clefRequest(request: Request, env: ClefEnv, db: Client, account: string): Promise<Response> {
  const expected = request.headers.get("x-eliza-account")
  if (expected !== null && expected !== account) return WorkerResponse.json({ error: "account_mismatch" }, { status: 403 })
  if (request.method !== "POST") return WorkerResponse.json({ error: "method_not_allowed" }, { status: 405, headers: { allow: "POST" } })
  if (request.headers.get("content-type")?.split(";")[0]?.trim().toLowerCase() !== "application/json") {
    return WorkerResponse.json({ error: "invalid_decision" }, { status: 400 })
  }
  const bytes = await limitedBody(request, maxBytes)
  if (!bytes) return WorkerResponse.json({ error: "request_too_large" }, { status: 413 })
  let raw: unknown
  try { raw = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(bytes)) }
  catch { return WorkerResponse.json({ error: "invalid_decision" }, { status: 400 }) }
  const decoded = decodeClefRequest(raw)
  if (Option.isNone(decoded)) return WorkerResponse.json({ error: "invalid_decision" }, { status: 400 })
  const binding = env.AI
  if (!binding) return unavailable("disabled")
  try {
    if (!await Effect.runPromise(Effect.provide(admit(db, account), SecureRandom.layerWebCrypto))) {
      return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
    }
  } catch (error) {
    if (error instanceof RateLimited) return WorkerResponse.json({ error: "rate_limited" }, { status: 429 })
    return unavailable("provider_error")
  }
  try {
    const answer = await Effect.runPromise(Effect.timeout(Effect.tryPromise(() =>
      binding.run(modelId, { model, ...question(decoded.value) })), providerDeadlineMs), { signal: request.signal })
    const found = decision(decoded.value, answer)
    return found ? WorkerResponse.json(found) : unavailable("provider_error")
  } catch {
    return unavailable("provider_error")
  }
}
