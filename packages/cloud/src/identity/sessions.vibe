// spec/cloud/identity/sessions.md, "Story: Stay signed in"; spec/cloud/identity/sessions.md, "Story: Sign out here, or end my other sessions"; spec/cloud/identity/sessions.md, "Story: Confirm it is me before a sensitive change"
import { type NotAState, type Rejected, apply, canLogout, canRecordStepUp, canRefresh, canRevokeOthers, decodeState, elapse, initial, refreshPerIp, refreshRefusal, revokeAll, sessionRefusal, type Assurance, type Event, type Family, type FamilyStep, type Moment, type SessionEffect } from "../../gen/cloud__identity__sessions.effect.vibe"
import { refused, type Refused, type RefusalReason } from "../http/refusal.vibe"
import { bearerToken } from "../http/request-auth.vibe"
import { json, jsonBody, type Route, type RouteContext, type Sweep } from "../http/routes.vibe"
import { admit } from "../shared/rate-limit.vibe"
import { newId, secretText, tokenDigest } from "../shared/sealing.vibe"
import { loadRow, stepRow, type RowConflict, type RowCorrupt, type Columns, type MachineRows } from "../store/rows.vibe"
import { Store, type StoreFailure, toInt, toText, type Tx } from "../store/connection.vibe"

export interface SignedIn {
  readonly status: "signed_in"
  readonly user: { readonly id: string; readonly email: string | null }
  readonly organizationId: string
  readonly accessToken: string
  readonly accessExpiresAt: number
  readonly refreshToken: string
  readonly refreshExpiresAt: number
  readonly mfaAt: number | null
  readonly accountCreated: boolean
}

interface Rotated {
  readonly accessToken: string
  readonly accessExpiresAt: number
  readonly refreshToken: string
  readonly refreshExpiresAt: number
  readonly stepUpAt: number | null
  readonly mfaAt: number | null
}

export interface SteppedUp {
  readonly stepUpAt: number
  readonly mfaAt: number
}

export interface Issue {
  readonly userId: string
  readonly organizationId: string
  readonly assurance: Assurance
  readonly accountCreated: boolean
  readonly now: number
}

export interface Timed {
  readonly event: Event
  readonly now: number
}

export type SessionFailure = StoreFailure | RowCorrupt | RowConflict | Rejected | Refused

type Refreshed = { readonly kind: "rotated"; readonly answer: Rotated } | { readonly kind: "refused"; readonly reason: RefusalReason }

const accessPattern = /^eliza_session_[A-Za-z0-9_-]{43}$/
const refreshPattern = /^eliza_refresh_[A-Za-z0-9_-]{54}$/

effect function applyAt(family: Family, timed: Timed): FamilyStep!Rejected {
  const current = timed.now > family.now ? (try apply(family, { type: "elapse", elapsed: timed.now - family.now })).state : family
  return try apply(current, timed.event)
}

export const familyRows: MachineRows<Family, Timed, FamilyStep, Rejected, NotAState> = { table: "sessions", initial, decodeState, apply: applyAt, next: (stepped) => stepped.state }

function at(moment: Moment): number | null {
  return moment.tag === "At" ? moment.ms : null
}

function advanced(family: Family, now: number): Family {
  return now > family.now ? elapse(family, now - family.now) : family
}

function credentialRefused(reason: RefusalReason): Refused {
  return refused("AuthenticationRequired", reason === "NoReason" ? "CredentialRevoked" : reason)
}

export effect function stepFamily(tx: Tx, key: string, event: Event, now: number, more: (family: Family) => Columns = () => ({})): FamilyStep!(StoreFailure | RowCorrupt | RowConflict | Rejected) {
  return (try stepRow(tx, familyRows, key, { event, now }, (family) => ({
    live: family.phase === "Live",
    access_expires_at: family.accessExpiresAt,
    refresh_expires_at: family.refreshExpiresAt,
    auth_at: family.authAt,
    step_up_at: at(family.stepUpAt) ?? 0,
    mfa_at: at(family.mfaAt) ?? 0,
    updated_at: now,
    ...more(family)
  }))).out
}

effect function lockAccount(tx: Tx, userId: string): { readonly epoch: number; readonly email: string | null; readonly active: boolean }!(StoreFailure | Refused) {
  const row = (try tx.query("SELECT sessions_revoked_before, email, status FROM accounts WHERE key = $1 FOR UPDATE", [userId]))[0]
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return { epoch: toInt(row.sessions_revoked_before), email: toText(row.email) ?? null, active: row.status === "active" }
}

effect function moveEpochs(tx: Tx, userId: string, out: ReadonlyArray<SessionEffect>, now: number): void!StoreFailure {
  for (const revoked of out) {
    try tx.query("UPDATE accounts SET sessions_revoked_before = GREATEST(sessions_revoked_before, $2), updated_at = $3 WHERE key = $1", [userId, revoked.toEpoch, now])
  }
}

effect function liveFamily(tx: Tx, key: string, now: number, userId?: string): { readonly family: Family; readonly epoch: number; readonly userId: string }!(StoreFailure | RowCorrupt | Refused) {
  const owner = toText((try tx.query("SELECT user_id FROM sessions WHERE key = $1", [key]))[0]?.user_id)
  if (owner === undefined || (userId !== undefined && owner !== userId)) throw refused("AuthenticationRequired", "CredentialUnknown")
  const { epoch } = try lockAccount(tx, owner)
  return { family: advanced((try loadRow(tx, familyRows, key)).state, now), epoch, userId: owner }
}

function mintPair() {
  const accessToken = secretText("eliza_session_", 32, "base64url")
  const refreshToken = secretText("eliza_refresh_", 40, "base64url")
  return { accessToken, refreshToken, access_digest: tokenDigest(accessToken), refresh_digest: tokenDigest(refreshToken) }
}

export effect function issueSession(tx: Tx, input: Issue): SignedIn!SessionFailure {
  const account = try lockAccount(tx, input.userId)
  if (!account.active) throw refused("AccessDenied", "AccountInactive")
  const { accessToken, refreshToken, access_digest, refresh_digest } = mintPair()
  const { state } = try stepFamily(tx, newId(), { type: "signIn", assurance: input.assurance, personEpoch: account.epoch }, input.now, () => ({ user_id: input.userId, access_digest, refresh_digest }))
  return {
    status: "signed_in",
    user: { id: input.userId, email: account.email },
    organizationId: input.organizationId,
    accessToken,
    accessExpiresAt: state.accessExpiresAt,
    refreshToken,
    refreshExpiresAt: state.refreshExpiresAt,
    mfaAt: at(state.mfaAt),
    accountCreated: input.accountCreated
  }
}

export effect function recordStepUp(tx: Tx, sessionKey: string, now: number): SteppedUp!SessionFailure {
  const { family, epoch } = try liveFamily(tx, sessionKey, now)
  if (!canRecordStepUp(family, epoch)) throw credentialRefused(sessionRefusal(family.generation, family, epoch))
  const { state } = try stepFamily(tx, sessionKey, { type: "recordStepUp", personEpoch: epoch }, now)
  return { stepUpAt: at(state.stepUpAt) ?? now, mfaAt: at(state.mfaAt) ?? now }
}

export effect function revokeOthers(tx: Tx, sessionKey: string, userId: string, now: number): void!SessionFailure {
  const { family, epoch } = try liveFamily(tx, sessionKey, now, userId)
  if (!canRevokeOthers(family, epoch)) throw credentialRefused(sessionRefusal(family.generation, family, epoch))
  const { out } = try stepFamily(tx, sessionKey, { type: "revokeOthers", personEpoch: epoch }, now)
  try moveEpochs(tx, userId, out, now)
}

export effect function revokeAllSessions(tx: Tx, userId: string, now: number): void!(StoreFailure | Refused) {
  const { epoch } = try lockAccount(tx, userId)
  try moveEpochs(tx, userId, [revokeAll(epoch)], now)
}

effect function refreshFamily(tx: Tx, token: string, now: number): Refreshed!SessionFailure {
  const presentedDigest = tokenDigest(token)
  const found = (try tx.query(
    "SELECT key, access_digest, NULL::integer AS generation FROM sessions WHERE refresh_digest = $1 UNION ALL SELECT session_key, access_digest, generation FROM cloud_spent_refresh WHERE digest = $1",
    [presentedDigest]
  ))[0]
  if (found === undefined) return { kind: "refused", reason: "CredentialUnknown" }
  const key = toText(found.key) ?? ""
  const { family, epoch, userId } = try liveFamily(tx, key, now)
  const current = found.generation === null
  const presented = current ? family.generation : toInt(found.generation)
  if (!canRefresh(family, presented, epoch)) {
    const reason = refreshRefusal(presented, family, epoch)
    return { kind: "refused", reason: reason === "NoReason" ? "CredentialRevoked" : reason }
  }
  const { accessToken, refreshToken, access_digest, refresh_digest } = mintPair()
  const { state, out } = try stepFamily(tx, key, { type: "refresh", presented, personEpoch: epoch }, now, (next): Columns => next.phase === "Reused" ? {} : { access_digest, refresh_digest })
  if (out.length > 0) {
    try moveEpochs(tx, userId, out, now)
    return { kind: "refused", reason: "CredentialRevoked" }
  }
  try tx.query("INSERT INTO cloud_spent_refresh (digest, access_digest, session_key, generation) VALUES ($1, $2, $3, $4)", [presentedDigest, toText(found.access_digest) ?? "", key, family.generation])
  return {
    kind: "rotated",
    answer: { accessToken, accessExpiresAt: state.accessExpiresAt, refreshToken, refreshExpiresAt: state.refreshExpiresAt, stepUpAt: at(state.stepUpAt), mfaAt: at(state.mfaAt) }
  }
}

effect function logoutFamily(tx: Tx, token: string, now: number): boolean!SessionFailure {
  const digest = tokenDigest(token)
  const key = toText((try tx.query(
    "SELECT key FROM sessions WHERE access_digest = $1 OR refresh_digest = $1 UNION SELECT session_key FROM cloud_spent_refresh WHERE digest = $1 OR access_digest = $1",
    [digest]
  ))[0]?.key)
  if (key === undefined) return false
  const family = advanced((try loadRow(tx, familyRows, key, true)).state, now)
  if (!canLogout(family)) return false
  if (family.phase === "Live") try stepFamily(tx, key, { type: "logout" }, now)
  return true
}

function clientAddress(context: RouteContext): string {
  return Option.getOrElse(context.request.remoteAddress, () => "unknown")
}

schema RefreshRequest { refreshToken: string }

export const routes: ReadonlyArray<Route> = [
  {
    method: "POST",
    path: "/api/v1/auth/refresh",
    auth: "Public",
    handler: (context) => effect {
      try admit({ subject: clientAddress(context), scope: refreshPerIp.name, limit: refreshPerIp.limit, widthMs: refreshPerIp.windowMs })
      const { refreshToken } = try jsonBody(context, RefreshRequest)
      if (!refreshPattern.test(refreshToken)) throw refused("AuthenticationRequired", "CredentialUnknown")
      const store = try Store
      const refreshed = try store.transaction((tx) => refreshFamily(tx, refreshToken, context.now))
      if (refreshed.kind === "refused") throw refused("AuthenticationRequired", refreshed.reason)
      return json(refreshed.answer)
    }
  },
  {
    method: "POST",
    path: "/api/v1/auth/logout",
    auth: "SessionFamily",
    handler: (context) => effect {
      const bearer = bearerToken(context.request.headers.authorization)
      const token = bearer ?? (try jsonBody(context, RefreshRequest)).refreshToken
      if (!accessPattern.test(token) && !refreshPattern.test(token)) throw refused("AuthenticationRequired", "CredentialUnknown")
      const store = try Store
      const ended = try store.transaction((tx) => logoutFamily(tx, token, context.now))
      if (!ended) throw refused("AuthenticationRequired", "CredentialUnknown")
      return HttpServerResponse.empty({ status: 204, headers: { "cache-control": "no-store" } })
    }
  }
]

effect function sweepFamilies(): void!!Store {
  const now = try Clock.currentTimeMillis
  const store = try Store
  store.transaction(effect (tx: Tx) => {
    try tx.query("DELETE FROM cloud_spent_refresh d USING sessions s WHERE s.key = d.session_key AND s.refresh_expires_at <= $1", [now])
    try tx.query("DELETE FROM sessions s WHERE s.refresh_expires_at <= $1 AND NOT EXISTS (SELECT 1 FROM cloud_device_proofs p WHERE p.session_key = s.key)", [now])
  }) catch effect (failure) => {
    try annotateLogs(logWarning("session sweep failed"), { cause: failure._tag })
  }
}

export const sweeps: ReadonlyArray<Sweep> = [{ name: "ended sessions", everyMs: 60 * 60_000, run: sweepFamilies() }]
