// spec/cloud/deployment.md, "Story: Serve the deployment from a Worker"; spec/cloud/deployment.md, "A Worker answers a path from the server's route table first, and its Worker-only routes only for a path the table does not serve"
import { workerFetch, type WorkerLifetime } from "./worker-platform.ts"
import { relayFromTable, serveFromTable, sweepTable, workerReady, type ProfileBindings } from "./worker/canonical.vibe"
import { ownsWorkerOnly, workerOnlyRequest, type DeploymentExtension, type LegacyBindings, type WorkerPorts } from "./worker/legacy.vibe"
import { answerOf, opensRelay } from "./worker/routes.vibe"

export { nativeAssetLinks } from "./native-registry.vibe"
export type { DeploymentExtension }

/** The part of a Worker's execution context that keeps work running after the answer. */
export type WorkerExecution = WorkerLifetime

/** Every binding a deployment's Worker reads: the profile, its database, its secrets and the Worker-only routes' own. */
export type CloudBindings = LegacyBindings & ProfileBindings

/** The deployment's whole Cloud API as a Worker: the server's route table, the Worker-only routes and the scheduled sweeps. */
export function cloudWorker<E extends CloudBindings>(extension?: DeploymentExtension<E>, providerFetch: typeof fetch = workerFetch) {
  const ports: WorkerPorts<E> = { extension, providerFetch }
  return {
    scheduled(event: { readonly scheduledTime: number }, env: E): Promise<void> {
      return sweepTable(env, event.scheduledTime)
    },
    async fetch(request: Request, env: E, execution?: WorkerExecution): Promise<Response> {
      const path = new URL(request.url).pathname
      if (opensRelay(request.method, path)) {
        return relayFromTable(request, env, (work) => execution === undefined ? void work.then(() => undefined, () => undefined) : execution.waitUntil(work))
      }
      const answer = answerOf(request.method, path, (owned) => ownsWorkerOnly(owned, ports))
      if (answer !== "FromWorkerOnly") return serveFromTable(request, env, providerFetch, execution)
      return (await workerReady(env)) ?? workerOnlyRequest(request, env, ports)
    }
  }
}
