// spec/cloud/index.md, "Story: Use inference on my subscription or funded pilot account"; spec/cloud/index.md, "Story: Sign in to the Cloud"
import { WorkerResponse, WorkerHeaders, withRequestBody, workerFetch, type WorkerLifetime } from "./worker-platform.ts"
import type { Client } from "pg"
import { FetchHttpClient, HttpEffect, HttpServerRequest } from "effect/http"
import { authenticate, recheckAccess } from "./http/request-auth.vibe"
import { refusalResponse, refused, Refused } from "./http/refusal.vibe"
import { matchRoute } from "./http/routes.vibe"
import { respond } from "./http/transport.vibe"
import { leaseRoutes } from "./identity/sessions.vibe"
import { accessCookie, browserAccessBearer, readCookie } from "./identity-store.vibe"
import { routes as deviceKeyRoutes } from "./native-clients/device-keys.vibe"
import { deploymentLayer, parseProfile } from "./profile/profile.vibe"
import { Store } from "./store/connection.vibe"
import { clientStore, withCloudDatabase, type WorkerDatabase } from "./worker-store.vibe"
import { sweepUsage } from "./worker-metering.vibe"
import { cloudCredential, identityRequest, nativeGooglePath, inferenceAccount, sessionAccount, sweepDeviceOffers, type IdentityEnv } from "./identity.vibe"
import { nativeAssetLinks } from "./native-registry.vibe"
import { ownsPasswordBackupPath } from "./password-backup.vibe"
export { nativeAssetLinks }
export { SpeechRelayCoordinator } from "./speech-relay.vibe"
import { speechRequest, speechRoute, speechWebSocket, type SpeechEnv } from "./speech.vibe"
import { deviceAttachmentPath, googleRequest, reminderSchedule, type GoogleEnv } from "./google.vibe"
import { inboxArrivalPath } from "./services/google/inbox-arrival.vibe"
import { billingRequest, refreshPaidAccess, stripeWebhook, stripeWebhookRoute, sweepSubscriptions, type BillingEnv } from "./billing.vibe"
import { CLEF_DECISIONS_PATH } from "./clef-decisions.vibe"
import { clefRequest, type ClefEnv } from "./clef-worker.vibe"
import { inferenceRequest, limitedBody, type InferenceEnv } from "./inference.vibe"

export type CloudBindings = ClefEnv & IdentityEnv & GoogleEnv & InferenceEnv & SpeechEnv & BillingEnv & WorkerDatabase & { readonly CLOUD_PROFILE?: string }
const mobileRoutes = [...deviceKeyRoutes, ...leaseRoutes]
const connectPath = "/api/v1/app-auth/connect"
const managedGoogleReadPaths: ReadonlySet<string> = new Set([
  "/api/v1/eliza/google/status",
  "/api/v1/eliza/google/gmail/triage",
  "/api/v1/eliza/google/gmail/search",
  "/api/v1/eliza/google/gmail/read",
  "/api/v1/eliza/google/calendar/feed",
])

type DeploymentExtension<E extends CloudBindings> = (request: Request, env: E, db: Client, account: string) => Promise<Response>

function mobileRequest(request: Request, env: CloudBindings, db: Client, providerFetch: typeof fetch): Promise<Response> {
  const dispatchMobile = effect {
    const value = env.CLOUD_PROFILE
    if (value === undefined) throw refused("ServiceUnavailable")
    const parsed = Effect.try(() => JSON.parse(value) as unknown) catch effect () => { throw refused("ServiceUnavailable") }
    const profile = parseProfile(parsed) catch effect () => { throw refused("ServiceUnavailable") }
    const settings = profile.environments[env.CLOUD_ENVIRONMENT]
    if (settings.api !== env.PUBLIC_API_ORIGIN || settings.web !== env.WEB_ORIGIN || settings.databaseIdentity !== env.CLOUD_IDENTITY_DIGEST) {
      throw refused("ServiceUnavailable")
    }
    const source = try HttpServerRequest.HttpServerRequest
    const access = new URL(request.url).pathname === connectPath && !request.headers.has("authorization")
      ? readCookie(request, accessCookie) : null
    const forwarded = request.headers.get("cf-connecting-ip")
    const seen = source.modify({
      headers: access === null ? source.headers : { ...source.headers, authorization: "Bearer " + access },
      remoteAddress: forwarded === null ? source.remoteAddress : Option.some(forwarded)
    })
    const bindings = Object.fromEntries(Object.entries(env).filter((entry): entry is [string, string] => typeof entry[1] === "string"))
    const context = Layer.mergeAll(
      Layer.effect(Store, clientStore(db)),
      deploymentLayer(profile, env.CLOUD_ENVIRONMENT).pipe(Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnvRecord(bindings)))),
      FetchHttpClient.layer
    )
    return try provideService(Effect.provide(provideService(respond(mobileRoutes), HttpServerRequest.HttpServerRequest, seen), context), FetchHttpClient.Fetch, providerFetch)
  }
  return HttpEffect.toWebHandler(effect {
    return dispatchMobile catch effect (failure) => refusalResponse(failure.refusal, try Clock.currentTimeMillis)
  })(request)
}

function managedGoogleRead(request: Request, env: CloudBindings, db: Client, providerFetch: typeof fetch): Promise<Response> {
  const authorization = request.headers.get("authorization") ?? undefined
  const read = effect {
    const caller = try authenticate(authorization, "MailAccess")
    if (caller.kind !== "lease") throw refused("AuthenticationRequired", "CredentialUnknown")
    const answer = try promise(() => googleRequest(request, env, db, caller.userId, providerFetch))
    if (answer.ok) try recheckAccess(authorization, caller, "MailAccess")
    return answer
  }
  return runPromise(Effect.provide(effect {
    return read catch effect (failure) => {
      const refusal = failure instanceof Refused ? failure : refused("ServiceUnavailable")
      return HttpServerResponse.toWeb(refusalResponse(refusal.refusal, try Clock.currentTimeMillis))
    }
  }, Layer.effect(Store, clientStore(db))), { signal: request.signal })
}

async function route<E extends CloudBindings>(request: Request, env: E, db: Client, extension: DeploymentExtension<E> | undefined, providerFetch: typeof fetch, lifetime?: WorkerLifetime) {
  const path = new URL(request.url).pathname
  if (path === stripeWebhookRoute && request.method === "POST") {
    const bytes = await limitedBody(request, 256 * 1024)
    return bytes ? stripeWebhook(request, bytes, env, db) : WorkerResponse.json({ error: "request_too_large" }, { status: 413 })
  }
  if (path === "/health" && request.method === "GET") {
    await db.query("SELECT 1 FROM accounts, sessions, device_grants, subscriptions, holds, usage_records LIMIT 0")
    return WorkerResponse.json({ status: "ready" })
  }
  if (matchRoute(mobileRoutes, request.method, path).kind === "route") return mobileRequest(request, env, db, providerFetch)
  if (ownsPasswordBackupPath(path)) return identityRequest(request, env, db)
  if (path.startsWith("/api/auth/") || path === "/api/v1/app-auth/mobile/config" || nativeGooglePath(path)) {
    if (request.method === "POST") {
      const bytes = await limitedBody(request, 8192)
      if (!bytes) return WorkerResponse.json({ error: "request_too_large" }, { status: 413 })
      request = withRequestBody(request, bytes)
    }
    return identityRequest(request, env, db)
  }
  if (path === deviceAttachmentPath) {
    if (request.method !== "POST") return WorkerResponse.json({ error: "method_not_allowed" }, { status: 405 })
    if (!request.headers.has("authorization")) return WorkerResponse.json({ error: "device_required" }, { status: 401 })
    const owner = await inferenceAccount(request, db, env)
    if (!owner) return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
    const bytes = await limitedBody(request, 8704)
    if (!bytes) return WorkerResponse.json({ error: "request_too_large" }, { status: 413 })
    const response = await googleRequest(withRequestBody(request, bytes), env, db, owner, providerFetch)
    if (response.ok && await inferenceAccount(request, db, env) !== owner) return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
    return response
  }
  if (path === inboxArrivalPath) {
    if (request.method !== "GET") return WorkerResponse.json({ error: "method_not_allowed" }, { status: 405 })
    const owner = await inferenceAccount(request, db, env)
    const credential = owner ? await cloudCredential(request) : null
    if (!owner || !credential) return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
    return googleRequest(request, env, db, owner, providerFetch, {
      credential,
      current: async () => await inferenceAccount(request, db, env) === owner,
    })
  }
  const managedRead = request.method === "GET" && managedGoogleReadPaths.has(path)
  const explicitCredential = request.headers.has("authorization")
  const browserBearer = managedRead && browserAccessBearer(request) !== undefined
  if (managedRead && explicitCredential && !browserBearer) return managedGoogleRead(request, env, db, providerFetch)
  const session = () => sessionAccount(request, db, browserBearer ? "bearer" : "cookie")
  const decisions = path === CLEF_DECISIONS_PATH
  const inference = path === "/api/v1/chat/completions" || path === "/api/v1/embeddings"
  if (path === speechRoute + "/ws") return speechWebSocket(request, env, db)
  const speech = path.startsWith(speechRoute + "/")
  const billing = path.startsWith("/api/v1/billing/")
  const reminders = path === "/api/v1/calendar-reminders/device"
  const google = path.startsWith("/api/v1/eliza/google/")
  const nativeConnect = path === "/api/v1/eliza/google/connect/native"
  if (!reminders && !decisions && !inference && !speech && !billing && !google && !(extension && path.startsWith("/api/product/"))) return WorkerResponse.json({ error: "route_not_found" }, { status: 404 })
  if (google && !nativeConnect && explicitCredential && !browserBearer) {
    return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
  }
  const account = reminders || decisions || inference || speech || nativeConnect ? await inferenceAccount(request, db, env) : await session()
  if (!account) return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
  if ((reminders || nativeConnect) && !request.headers.has("authorization")) return WorkerResponse.json({ error: "device_required" }, { status: 403 })
  if (reminders) return reminderSchedule(request, env, db, account)
  if (decisions) return clefRequest(request, env, db, account)
  if (inference || path === speechRoute + "/session") await refreshPaidAccess(env, db, account)
  if (speech) return speechRequest(request, env, db, account)
  if (inference) return inferenceRequest(request, env, db, account, workerFetch, lifetime)
  if (google) {
    const response = await googleRequest(request, env, db, account, providerFetch)
    if (response.ok && (managedRead || (request.method === "GET" && path.startsWith("/api/v1/eliza/google/gmail/"))) && await session() !== account)
      return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
    return response
  }
  if (billing) return billingRequest(request, env, db, account)
  if (extension) return extension(request, env, db, account)
  return WorkerResponse.json({ error: "route_not_found" }, { status: 404 })
}

export function cloudWorker<E extends CloudBindings>(extension?: DeploymentExtension<E>, providerFetch = workerFetch) {
  return {
    scheduled(_event: unknown, env: E) {
      return withCloudDatabase(env, async (db) => {
        await sweepUsage(db)
        await sweepSubscriptions(env, db)
        await sweepDeviceOffers(db)
      })
    },
    async fetch(request: Request, env: E, lifetime?: WorkerLifetime): Promise<Response> {
      if (new URL(request.url).origin === env.PUBLIC_API_ORIGIN && new URL(request.url).pathname === "/.well-known/assetlinks.json" && request.method === "GET") return nativeAssetLinks(env)
      const origin = request.headers.get("origin")
      if (origin && origin !== env.WEB_ORIGIN && origin !== env.PUBLIC_API_ORIGIN) {
        return WorkerResponse.json({ error: "forbidden_origin" }, { status: 403 })
      }
      const cors = new WorkerHeaders({ Vary: "Origin", "Cache-Control": "no-store" })
      if (origin) {
        cors.set("Access-Control-Allow-Origin", origin)
        cors.set("Access-Control-Allow-Credentials", "true")
      }
      const path = new URL(request.url).pathname
      if (request.method === "OPTIONS") {
        cors.set("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        cors.set("Access-Control-Allow-Headers", path === CLEF_DECISIONS_PATH
          ? "Authorization, Content-Type, X-Eliza-Account"
          : "Authorization, Content-Type, Idempotency-Key")
        return new WorkerResponse(null, { status: 204, headers: cors })
      }
      if (request.method !== "GET" && !origin && !request.headers.has("authorization") &&
          path !== stripeWebhookRoute && path !== "/api/auth/device/exchange" && !nativeGooglePath(path) &&
          !ownsPasswordBackupPath(path) && !mobileRoutes.some((entry) => entry.path === path && entry.auth === "Public")) {
        return WorkerResponse.json({ error: "origin_required" }, { status: 403, headers: cors })
      }
      try {
        const result = await withCloudDatabase(env, (db) => route(request, env, db, extension, providerFetch, lifetime))
        if (result.status === 101) return result
        const headers = new WorkerHeaders(result.headers)
        for (const [key, value] of cors) headers.set(key, value)
        return new WorkerResponse(result.body, { status: result.status, headers })
      } catch {
        return WorkerResponse.json({ error: "service_unavailable" }, { status: 503, headers: cors })
      }
    }
  }
}
