    },
    async fetch(request: Request, env: E, execution?: WorkerExecution): Promise<Response> {
      const path = new URL(request.url).pathname
      if (opensRelay(request.method, path)) {
        return relayFromTable(request, env, (work) => execution === undefined ? void work.then(() => undefined, () => undefined) : execution.waitUntil(work))
      }
      const answer = answerOf(request.method, path, (owned) => ownsWorkerOnly(owned, ports))
      if (answer !== "FromWorkerOnly") return serveFromTable(request, env, providerFetch, execution)
      return (await workerReady(env)) ?? workerOnlyRequest(request, env, ports)
    }
  }
