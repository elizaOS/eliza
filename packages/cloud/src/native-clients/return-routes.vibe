// spec/cloud/returnPages.md, "Story: Bring me back to the app when its link did not open"; spec/cloud/returnPages.md, "Story: Tell a payer the checkout ended"
import { answerAt, connectedAnswer, isPayerUrl, pageHeaders, payerPath, readOf, type Page, type PageAnswer, type PagePurpose, type RegistryRead } from "../../gen/cloud__returnPages.effect.vibe"
import type { Registration, ReturnPurpose } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import { Refused } from "../http/refusal.vibe"
import type { Route, RouteContext } from "../http/routes.vibe"
import { forwardScriptHash, pageFile, pageSlots, type PageSlot, type PageTemplate } from "../pages/forward-script.ts"
import { Deployment, rowOf } from "../profile/profile.vibe"
import { Store } from "../store/store.vibe"
import { readRegistry } from "./registry.vibe"

module node {
  import { createHash } from "node:crypto"
  import { readFile } from "node:fs/promises"

  export interface Template {
    readonly source: string
    readonly styleHashes: ReadonlyArray<string>
  }

  const templates = new Map<string, Template>()

  /** @throws {unknown} */
  async function load(root: URL, file: string): Promise<Template | undefined> {
    for (const base of ["pages/", "dist/pages/"]) {
      const text = await readFile(new URL(base + file, root), "utf8").catch(() => undefined)
      if (text === undefined) continue
      const styles = [...text.matchAll(/<style>([\s\S]*?)<\/style>/g)].map((found) => `'sha256-${createHash("sha256").update(found[1] ?? "").digest("base64")}'`)
      return { source: text, styleHashes: styles }
    }
    return undefined
  }

  /** @throws {unknown} */
  export async function pageTemplate(root: URL, file: string): Promise<Template | undefined> {
    const known = templates.get(file)
    if (known !== undefined) return known
    const loaded = await load(root, file)
    if (loaded !== undefined) templates.set(file, loaded)
    return loaded
  }
}
import { pageTemplate, type Template } from node

export error PageTemplateMissing { file: string }

const packageRoot = new URL("../../", import.meta.url)

const returnPurpose: Readonly<Record<Exclude<PagePurpose, "ConnectedPage">, ReturnPurpose>> = {
  SignInPage: "SignInPurpose",
  BillingPage: "BillingPurpose",
  ConnectPage: "ConnectPurpose"
}

const slotOf: ReadonlyMap<string, PageSlot> = new Map(Object.entries(pageSlots).map(([slot, token]) => [token, slot as PageSlot]))
const slotPattern = new RegExp([...slotOf.keys()].map((token) => token.replace(/[{}]/g, "\\$&")).join("|"), "g")

function escaped(value: string): string {
  return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("\"", "&quot;").replaceAll("'", "&#39;")
}

type Shown = { readonly template: PageTemplate; readonly slots: Readonly<Partial<Record<PageSlot, string>>> }

function shown(page: Page): Shown {
  switch (page.tag) {
    case "CheckoutOutcome":
      return { template: { kind: "checkoutOutcome", outcome: page.shown === "PaidOutcome" ? "paid" : "canceled" }, slots: {} }
    case "ReturnToApp": {
      const names = { deploymentName: page.serviceName, displayName: page.appName }
      if (page.offer.tag === "NoAction" || page.purpose === "ConnectedPage") return { template: { kind: "returnToAppConnected" }, slots: names }
      const { target, androidPackage } = page.offer.link
      const purpose = returnPurpose[page.purpose]
      return {
        template: { kind: "returnToApp", purpose },
        slots: { ...names, purpose, intentHref: `intent://${new URL(target.origin).host}${target.path}#Intent;scheme=https;package=${androidPackage};end` }
      }
    }
  }
}

function contentPolicy(page: Page, template: Template): string {
  const headers = pageHeaders(page)
  const script = headers.script === "PinnedScript" ? ` script-src '${forwardScriptHash}';` : ""
  const style = template.styleHashes.length === 0 ? "" : ` style-src ${template.styleHashes.join(" ")};`
  return `default-src 'none';${script}${style} base-uri 'none'; form-action ${headers.formAction}; frame-ancestors ${headers.frameAncestors}`
}

effect function pageResponse(answer: PageAnswer) {
  if (answer.tag === "Refused") throw new Refused({ refusal: answer.refusal })
  const page = answer.page
  const { template, slots } = shown(page)
  const file = try sync(() => pageFile(template))
  const loaded = try tryPromise({ try: () => pageTemplate(packageRoot, file), catch: () => new PageTemplateMissing({ file }) })
  if (loaded === undefined) throw new PageTemplateMissing({ file })
  const html = loaded.source.replace(slotPattern, (token) => {
    const value = slots[slotOf.get(token) ?? "purpose"]
    return value === undefined ? token : escaped(value)
  })
  const headers = pageHeaders(page)
  return HttpServerResponse.text(html, {
    contentType: "text/html; charset=utf-8",
    headers: {
      "cache-control": headers.cacheControl,
      "x-robots-tag": headers.robots,
      "referrer-policy": headers.referrerPolicy,
      "content-security-policy": contentPolicy(page, loaded),
      "x-content-type-options": "nosniff",
      "x-frame-options": "DENY"
    }
  })
}

function requestOrigin(context: RouteContext, api: string): string {
  const { host, "x-forwarded-host": forwarded } = context.request.headers
  const direct = `https://${host ?? ""}`
  if (direct === api) return api
  return `https://${(forwarded ?? host ?? "").split(",")[0]?.trim() ?? ""}`
}

effect function registryRead(): RegistryRead!!(Store | Deployment) {
  const registry = (try Store).transaction((tx) => readRegistry(tx)) catch effect (failure) => {
    try annotateLogs(logWarning("the native client registry could not be read"), { cause: failure._tag })
    return undefined
  }
  return registry === undefined ? readOf([], false) : readOf([...registry], true)
}

effect function servePage(context: RouteContext) {
  const deployment = try Deployment
  const { web, api } = deployment.settings
  const row = rowOf(deployment.settings.name, deployment.settings)
  const url = { origin: requestOrigin(context, api), path: new URL(context.request.url, api).pathname }
  const read = url.origin === web && !isPayerUrl(row, url) ? try registryRead() : readOf([], false)
  const served = deployment.environment === "production" ? "Production" : "Staging"
  return try pageResponse(answerAt(row, read, served, url, context.query.get("outcome") ?? ""))
}

export effect function connectedReturnPage(registration: Registration) {
  const deployment = try Deployment
  return try pageResponse(connectedAnswer(rowOf(deployment.settings.name, deployment.settings), registration))
}

export const returnPageRoute: Route = { method: "GET", path: "/*", auth: "Public", handler: servePage }

export const routes: ReadonlyArray<Route> = [
  { method: "GET", path: payerPath as `/${string}`, auth: "Public", capability: "billing", handler: servePage }
]
