// spec/cloud/returnPages.md, "Story: Bring me back to the app when its link did not open"; spec/cloud/returnPages.md, "Story: Tell a payer the checkout ended"
import { connectedPage, pageAt, pageHeaders, payerPath, type Page, type PagePurpose } from "../../gen/cloud__returnPages.effect.vibe"
import type { Registration } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import { refused } from "../http/refusal.vibe"
import type { Route, RouteContext } from "../http/routes.vibe"
import { forwardScriptHash, pageFile, pageSlots, type PageSlot, type PageTemplate } from "../pages/forward-script.ts"
import { Deployment, rowOf } from "../profile/profile.vibe"
import { Store } from "../store/store.vibe"
import { readRegistry } from "./registry.vibe"

module node {
  import { readFile } from "node:fs/promises"

  const templates = new Map<string, Promise<string | undefined>>()

  /** @throws {unknown} */
  async function load(file: string): Promise<string | undefined> {
    for (const base of ["../../pages/", "../../dist/pages/"]) {
      const text = await readFile(new URL(base + file, import.meta.url), "utf8").catch(() => undefined)
      if (text !== undefined) return text
    }
    const { renderPages } = await import("../pages/render.tsx")
    return renderPages("").find((page) => page.fileName === file)?.source
  }

  /** @throws {unknown} */
  export function pageTemplate(file: string): Promise<string | undefined> {
    const known = templates.get(file) ?? load(file)
    templates.set(file, known)
    return known
  }
}
import { pageTemplate } from node

export error PageTemplateMissing { file: string }

const purposeSlot: Readonly<Record<Exclude<PagePurpose, "ConnectedPage">, string>> = {
  SignInPage: "SignInPurpose",
  BillingPage: "BillingPurpose",
  ConnectPage: "ConnectPurpose"
}

function escaped(value: string): string {
  return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("\"", "&quot;").replaceAll("'", "&#39;")
}

type Shown = { readonly template: PageTemplate; readonly slots: Readonly<Partial<Record<PageSlot, string>>> }

function shown(page: Exclude<Page, { tag: "NoPage" }>): Shown {
  switch (page.tag) {
    case "CheckoutOutcome":
      return { template: { kind: "checkoutOutcome", outcome: page.outcome === "PaidOutcome" ? "paid" : "canceled" }, slots: {} }
    case "ReturnToApp": {
      const names = { deploymentName: page.serviceName, displayName: page.appName }
      if (page.action.tag === "NoAction" || page.purpose === "ConnectedPage") return { template: { kind: "returnToAppConnected" }, slots: names }
      const { target, androidPackage } = page.action.link
      return {
        template: { kind: "returnToApp", purpose: purposeSlot[page.purpose] },
        slots: { ...names, purpose: purposeSlot[page.purpose], intentHref: `intent://${new URL(target.origin).host}${target.path}#Intent;scheme=https;package=${androidPackage};end` }
      }
    }
  }
}

function contentPolicy(page: Page): string {
  const headers = pageHeaders(page)
  const script = headers.script === "PinnedScript" ? ` script-src '${forwardScriptHash}';` : ""
  return `default-src 'none';${script} style-src 'unsafe-inline'; base-uri 'none'; form-action ${headers.formAction}; frame-ancestors ${headers.frameAncestors}`
}

effect function pageResponse(page: Page) {
  if (page.tag === "NoPage") throw refused("NotFound")
  const { template, slots } = shown(page)
  const file = pageFile(template)
  const source = try tryPromise({ try: () => pageTemplate(file), catch: () => new PageTemplateMissing({ file }) })
  if (source === undefined) throw new PageTemplateMissing({ file })
  const html = Object.entries(slots).reduce((text, [slot, value]) => text.replaceAll(pageSlots[slot as PageSlot], escaped(value)), source)
  const headers = pageHeaders(page)
  return HttpServerResponse.html(html, {
    headers: {
      "cache-control": headers.cacheControl,
      "x-robots-tag": headers.robots,
      "referrer-policy": headers.referrerPolicy,
      "content-security-policy": contentPolicy(page),
      "x-content-type-options": "nosniff",
      "x-frame-options": "DENY"
    }
  })
}

function requestOrigin(context: RouteContext): string {
  const host = (context.request.headers["x-forwarded-host"] ?? context.request.headers.host ?? "").split(",")[0]?.trim() ?? ""
  return host === "" ? "" : `https://${host}`
}

effect function servePage(context: RouteContext) {
  const deployment = try Deployment
  const registry = try (try Store).transaction((tx) => readRegistry(tx))
  const path = new URL(context.request.url, deployment.settings.api).pathname
  const served = deployment.environment === "production" ? "Production" : "Staging"
  const page = pageAt(rowOf(deployment.profile.name, deployment.settings), [...registry], served, { origin: requestOrigin(context), path }, context.query.get("outcome") ?? "")
  return try pageResponse(page)
}

export effect function connectedReturnPage(registration: Registration) {
  const deployment = try Deployment
  return try pageResponse(connectedPage(rowOf(deployment.profile.name, deployment.settings), registration))
}

export const returnPageRoute: Route = { method: "GET", path: "/*", auth: "Public", handler: servePage }

export const routes: ReadonlyArray<Route> = [
  { method: "GET", path: payerPath as `/${string}`, auth: "Public", capability: "billing", handler: servePage }
]
