// spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device in and keep its key"; spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device out"; spec/cloud/nativeClients/deviceKeys.md, "Story: Keep no grant longer than it can be used"; spec/cloud/nativeClients/registry.md, "Story: Admit only a registered native client"
import {
  ackAnswer, ackOutcome, ackPerIp, apply, codeRequestRefusal, decodeState, initial, keyRefusal, NotAState, Rejected, revokeAll as nextEpoch, tokenAnswer, tokenOutcome, tokenPerIp,
  type CodeRequest, type Event, type Grant, type GrantEffect, type GrantOutcome, type GrantPhase, type GrantStep
} from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import type { CodeBinding } from "../../gen/cloud__identity__federatedSignIn.effect.vibe"
import { admitRequest, type CredentialView } from "../../gen/cloud__identity__sessions.effect.vibe"
import { clientCheck, registrationsFor, type ClientCheck, type ClientRequest, type Registration } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import type { RateLimit } from "../../gen/cloud__shared__rateLimit.effect.vibe"
import { refused, Refused, type Refusal } from "../http/refusal.vibe"
import { json, jsonBody, type Route, type RouteContext, type Sweep } from "../http/routes.vibe"
import { s256 } from "../shared/credential-crypto.vibe"
import { admitCheck } from "../shared/rate-limit.vibe"
import { newId, sameText, seal, secretText, tokenDigest, unseal } from "../shared/sealing.vibe"
import { Store, toInt, toText, type Row, type Tx } from "../store/connection.vibe"
import { outputRows, stepRow, type Columns, type MachineRows } from "../store/rows.vibe"
import { loadRegistry, servedEnvironment } from "./registry.vibe"

export const grants = outputRows("device_grants", { initial, decodeState, apply })

interface Timed {
  readonly event: Event
  readonly now: number
}

effect function applyAt(grant: Grant, timed: Timed): GrantStep!Rejected {
  const current = timed.now > grant.now ? (try apply(grant, { type: "elapse", elapsed: timed.now - grant.now })).state : grant
  return try apply(current, timed.event)
}

const timedGrants: MachineRows<Grant, Timed, GrantStep, Rejected, NotAState> = { table: "device_grants", initial, decodeState, apply: applyAt, next: (stepped) => stepped.state }

const Scopes = Schema.Array(Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(100)))
const Text = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256))
const Binding = {
  clientId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(200)),
  environment: Schema.Literals(["production", "staging"]),
  redirectUri: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(2000))
}
const ConnectBody = Schema.Struct({
  ...Binding,
  flow: Schema.optionalKey(Schema.Literal("mobile_pkce")),
  state: Schema.String.check(Schema.isPattern(/^[A-Za-z0-9._~-]{43,128}$/)),
  codeChallenge: Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{43}$/)),
  codeChallengeMethod: Text,
  deviceName: Schema.optionalKey(Schema.String)
})
const TokenBody = Schema.Struct({
  ...Binding,
  grantType: Schema.Literal("authorization_code"),
  code: Text,
  state: Text,
  codeVerifier: Text
})
const AckBody = Schema.Struct({
  credentialId: Text,
  secret: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(512)),
  clientId: Schema.optionalKey(Binding.clientId),
  environment: Schema.optionalKey(Binding.environment),
  redirectUri: Schema.optionalKey(Binding.redirectUri),
  code: Schema.optionalKey(Text),
  state: Schema.optionalKey(Text),
  codeVerifier: Schema.optionalKey(Text)
})

interface BindingFields {
  readonly clientId: string
  readonly environment: "production" | "staging"
  readonly redirectUri: string
}

export interface Credential {
  readonly credentialId: string
  readonly secret: string
  readonly tokenType: "Bearer"
  readonly expiresAt: string
  readonly expiresIn: number
  readonly scopes: ReadonlyArray<string>
  readonly acknowledgementRequired: true
  readonly acknowledgeBy: string
  readonly user: { readonly id: string }
  readonly organizationId: string
}

interface Admission {
  readonly check: ClientCheck
  readonly registration: Registration | undefined
}

const phaseColumns: Readonly<Record<GrantPhase["tag"], string>> = {
  Unissued: "unissued", CodeIssued: "code_issued", Exchanged: "exchanged", Active: "active", Expired: "expired", Ended: "ended"
}

function phaseColumn(grant: Grant): string {
  return phaseColumns[grant.phase.tag]
}

function keyExpiresAt(grant: Grant): number {
  return grant.phase.tag === "Active" ? grant.phase.keyExpiresAt : 0
}

function iso(at: number): string {
  return new Date(at).toISOString()
}

export function deviceName(raw: string | undefined): string | null {
  if (raw === undefined) return null
  const name = raw.trim()
  return name.length >= 1 && name.length <= 80 && !/[\p{Cc}\p{Cf}]/u.test(name) ? name : null
}

function signInRequest(body: BindingFields): ClientRequest | undefined {
  if (!URL.canParse(body.redirectUri)) return undefined
  const url = new URL(body.redirectUri)
  if (url.origin + url.pathname !== body.redirectUri) return undefined
  return {
    clientId: body.clientId,
    environment: body.environment === "production" ? "Production" : "Staging",
    redirect: { tag: "ClaimsReturn", purpose: "SignInPurpose", url: { origin: url.origin, path: url.pathname } }
  }
}

effect function admission(tx: Tx, request: ClientRequest | undefined) {
  if (request === undefined) return { check: { tag: "ClientRefused", fault: "WrongRedirect" }, registration: undefined } satisfies Admission
  const served = try servedEnvironment()
  const registry = try loadRegistry(tx, served)
  const check = clientCheck(registry, served, request)
  return { check, registration: check.tag === "ClientAdmitted" ? registrationsFor(registry, served, request.clientId)[0] : undefined } satisfies Admission
}

function refusalOf(outcome: GrantOutcome): Refusal {
  return outcome.tag === "GrantRefused" ? outcome.refusal : refused("ServiceUnavailable").refusal
}

effect function step(tx: Tx, key: string, event: Event, now: number, columns: (grant: Grant) => Columns, refusal: (state: Grant) => Refusal) {
  return stepRow(tx, timedGrants, key, { event, now }, columns) catch effect (failure) => match (failure) {
    when Rejected: throw new Refused({ refusal: refusal(failure.state) });
    default: throw failure;
  }
}

effect function deviceEpoch(tx: Tx, userId: string) {
  const account = (try tx.query("SELECT status, devices_revoked_before FROM accounts WHERE key = $1 FOR SHARE", [userId]))[0]
  if (account === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return { epoch: toInt(account.devices_revoked_before), active: toText(account.status) === "active" }
}

effect function grantBy(tx: Tx, column: "code_digest" | "credential_id", value: string) {
  const found: Row | undefined = (try tx.query(
    `SELECT g.key, g.client_id, g.user_id, g.code_digest, g.code_challenge, g.state_digest, g.secret_digest, g.sealed_copy, g.scopes, a.organization_id, a.devices_revoked_before
     FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.${column} = $1 FOR UPDATE OF g FOR SHARE OF a`,
    [value]
  ))[0]
  if (found === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return found
}

effect function grantScopes(row: Row) {
  const decoded = Schema.decodeUnknownEffect(Scopes)(row.scopes) catch effect () => { throw refused("ServiceUnavailable") }
  return decoded
}

effect function eraseSealedCopy(tx: Tx, key: string, out: ReadonlyArray<GrantEffect>) {
  if (out.includes("EraseSealedCopy")) try tx.query("UPDATE device_grants SET sealed_copy = NULL WHERE key = $1", [key])
}

export effect function perIp(context: RouteContext, limit: RateLimit) {
  try admitCheck({ subject: Option.getOrElse(context.request.remoteAddress, () => "unknown"), rule: limit })
}

effect function connect(context: RouteContext) {
  const caller = context.caller
  if (caller.kind !== "session") throw refused("AuthenticationRequired", "CredentialUnknown")
  const body = try jsonBody(context, ConnectBody)
  const name = deviceName(body.deviceName)
  if (body.deviceName !== undefined && name === null) throw refused("InvalidRequest")
  const store = try Store
  const code = secretText("emac_", 32, "hex")
  const opened = try store.transaction(effect (tx: Tx) => {
    const admitted = try admission(tx, signInRequest(body))
    const account = try deviceEpoch(tx, caller.userId)
    const view: CredentialView = {
      kind: "RequestSession", found: true, live: true, expiresAt: caller.accessExpiresAt, issuedAt: caller.authAt, revokedBefore: 0,
      accountStatus: account.active ? "RequestAccountActive" : "RequestAccountInactive", authAt: caller.authAt, stepUpAt: caller.stepUpAt, mfaAt: caller.mfaAt
    }
    const codeRequest: CodeRequest = { client: admitted.check, method: body.codeChallengeMethod === "S256" ? "S256" : "PlainMethod", hasState: true }
    const event: Event = { type: "connect", view, codeRequest, credentialTtl: admitted.registration?.credentialTtl ?? 0, deviceEpoch: account.epoch }
    return try step(tx, newId(), event, context.now, (grant) => ({
      user_id: caller.userId,
      client_id: body.clientId,
      phase: phaseColumn(grant),
      code_digest: tokenDigest(code),
      code_challenge: body.codeChallenge,
      state_digest: tokenDigest(body.state),
      device_name: name,
      code_expires_at: grant.codeExpiresAt,
      issued_at: Math.max(context.now, account.epoch),
      updated_at: context.now
    }), () => {
      const decided = admitRequest(view, "SignedSession", context.now)
      return decided.tag === "RequestRefused" ? decided.refusal : codeRequestRefusal(codeRequest)
    })
  })
  return json({
    code,
    codeType: "mobile_app_auth_code",
    expiresAt: iso(opened.state.codeExpiresAt),
    expiresIn: Math.floor((opened.state.codeExpiresAt - context.now) / 1000)
  })
}

function codeBinding(row: Row, body: typeof TokenBody.Type): CodeBinding {
  if (toText(row.client_id) !== body.clientId || !sameText(tokenDigest(body.state), toText(row.state_digest) ?? "")) return "RedirectDiffers"
  return sameText(s256(body.codeVerifier), toText(row.code_challenge) ?? "") ? "BindingMatches" : "VerifierDiffers"
}

effect function token(context: RouteContext) {
  try perIp(context, tokenPerIp)
  const body = try jsonBody(context, TokenBody)
  const store = try Store
  const credential = try store.transaction(effect (tx: Tx) => {
    const row = try grantBy(tx, "code_digest", tokenDigest(body.code))
    const key = toText(row.key) ?? ""
    const client = (try admission(tx, signInRequest(body))).check
    const binding = codeBinding(row, body)
    const epoch = toInt(row.devices_revoked_before)
    const stepped = try step(tx, key, { type: "token", client, binding, credentialId: newId(), deviceEpoch: epoch }, context.now, (grant) => ({
      phase: phaseColumn(grant),
      credential_id: grant.credentialId,
      updated_at: context.now
    }), (state) => refusalOf(tokenOutcome(state, client, binding, epoch)))
    const minted = stepped.out.out.includes("MintSealedKey")
    const secret = minted ? secretText("eliza_mobile_", 32, "hex") : try unseal("device-key", toText(row.sealed_copy) ?? "")
    if (minted) try tx.query("UPDATE device_grants SET secret_digest = $2, sealed_copy = $3 WHERE key = $1", [key, tokenDigest(secret), try seal("device-key", secret)])
    const answer = tokenAnswer(stepped.state)
    const issued: Credential = {
      credentialId: answer.credentialId,
      secret,
      tokenType: "Bearer",
      expiresAt: iso(answer.expiresAt),
      expiresIn: Math.floor(stepped.state.credentialTtl / 1000),
      scopes: try grantScopes(row),
      acknowledgementRequired: true,
      acknowledgeBy: iso(answer.acknowledgeBy),
      user: { id: toText(row.user_id) ?? "" },
      organizationId: toText(row.organization_id) ?? ""
    }
    return issued
  })
  return json(credential)
}

effect function keyDigest(row: Row) {
  const kept = toText(row.secret_digest)
  if (kept !== undefined) return kept
  const sealed = toText(row.sealed_copy)
  return sealed === undefined ? "" : tokenDigest(try unseal("device-key", sealed))
}

effect function ack(context: RouteContext) {
  try perIp(context, ackPerIp)
  const body = try jsonBody(context, AckBody)
  const store = try Store
  const answered = try store.transaction(effect (tx: Tx) => {
    const row = try grantBy(tx, "credential_id", body.credentialId)
    const key = toText(row.key) ?? ""
    const clientId = toText(row.client_id) ?? ""
    const ownClient: ClientRequest = { clientId, environment: try servedEnvironment(), redirect: { tag: "NoRedirect" } }
    const named = body.clientId === undefined || body.environment === undefined || body.redirectUri === undefined
      ? ownClient
      : signInRequest({ clientId: body.clientId, environment: body.environment, redirectUri: body.redirectUri })
    const client = (try admission(tx, named)).check
    const digest = try keyDigest(row)
    const proofMatches = digest !== "" && sameText(tokenDigest(body.secret), digest)
      && (body.clientId === undefined || body.clientId === clientId)
      && (body.code === undefined || sameText(tokenDigest(body.code), toText(row.code_digest) ?? ""))
      && (body.state === undefined || sameText(tokenDigest(body.state), toText(row.state_digest) ?? ""))
      && (body.codeVerifier === undefined || sameText(s256(body.codeVerifier), toText(row.code_challenge) ?? ""))
    const epoch = toInt(row.devices_revoked_before)
    const stepped = try step(tx, key, { type: "ack", client, proofMatches, deviceEpoch: epoch }, context.now, (grant) => ({
      phase: phaseColumn(grant),
      key_expires_at: keyExpiresAt(grant),
      updated_at: context.now
    }), (state) => refusalOf(ackOutcome(state, client, proofMatches, epoch)))
    try eraseSealedCopy(tx, key, stepped.out.out)
    return { answer: ackAnswer(stepped.state), scopes: try grantScopes(row) }
  })
  return json({ status: "acknowledged", credentialId: answered.answer.credentialId, expiresAt: iso(answered.answer.expiresAt), scopes: answered.scopes })
}

effect function selfRevoke(context: RouteContext) {
  const caller = context.caller
  if (caller.kind !== "deviceKey") throw refused("AuthenticationRequired", "CredentialUnknown")
  const store = try Store
  try store.transaction(effect (tx: Tx) => {
    const account = try deviceEpoch(tx, caller.userId)
    return try step(tx, caller.grantKey, { type: "selfRevoke", deviceEpoch: account.epoch }, context.now, (grant) => ({ phase: phaseColumn(grant), updated_at: context.now }), (state) => {
      const reason = keyRefusal(state, context.now, account.epoch)
      return refused("AuthenticationRequired", reason === "NoReason" ? "CredentialRevoked" : reason).refusal
    })
  })
  return HttpServerResponse.empty({ status: 204, headers: { "cache-control": "no-store" } })
}

export effect function revokeAll(tx: Tx, userId: string, now: number) {
  const account = (try tx.query("SELECT devices_revoked_before FROM accounts WHERE key = $1 FOR UPDATE", [userId]))[0]
  if (account === undefined) return 0
  const current = toInt(account.devices_revoked_before)
  const live = try tx.query(
    "SELECT count(*)::int AS live FROM device_grants WHERE user_id = $1 AND phase = 'active' AND key_expires_at > $2 AND issued_at >= $3",
    [userId, now, current]
  )
  try tx.query("UPDATE accounts SET devices_revoked_before = $2, updated_at = $3 WHERE key = $1", [userId, Math.max(nextEpoch(current).toDeviceEpoch, now + 1), now])
  return toInt(live[0]?.live ?? 0)
}

effect function close(key: string, event: Event, now: number) {
  const store = try Store
  store.transaction(effect (tx: Tx) => {
    const stepped = try stepRow(tx, timedGrants, key, { event, now }, (grant) => ({ phase: phaseColumn(grant), updated_at: now }))
    try eraseSealedCopy(tx, key, stepped.out.out)
  }) catch effect (failure) => {
    try annotateLogs(logWarning("device grant cleanup failed"), { key, event: event.type, cause: failure._tag })
  }
}

export effect function sweepAt(now: number): void!!Store {
  const store = try Store
  const due = store.transaction((tx: Tx) => tx.query(
    "SELECT key, phase FROM device_grants WHERE (phase IN ('code_issued', 'exchanged') AND code_expires_at <= $1) OR (phase = 'active' AND key_expires_at <= $1)",
    [now]
  )) catch effect (failure) => {
    try annotateLogs(logWarning("device grant sweep failed"), { cause: failure._tag })
    return []
  }
  for (const row of due) {
    try close(toText(row.key) ?? "", toText(row.phase) === "active" ? { type: "expire" } : { type: "lapse" }, now)
  }
}

export effect function sweepGrants(): void!!Store {
  try sweepAt(try Clock.currentTimeMillis)
}

export const routes: ReadonlyArray<Route> = [
  { method: "POST", path: "/api/v1/app-auth/connect", auth: "SignedSession", maxBodyBytes: 4096, handler: connect },
  { method: "POST", path: "/api/v1/app-auth/mobile/token", auth: "Public", maxBodyBytes: 4096, handler: token },
  { method: "POST", path: "/api/v1/app-auth/mobile/ack", auth: "Public", maxBodyBytes: 4096, handler: ack },
  { method: "DELETE", path: "/api/v1/api-keys/current", auth: "ServiceAccess", handler: selfRevoke }
]

export const sweeps: ReadonlyArray<Sweep> = [
  { name: "device grants", everyMs: 60 * 60_000, run: sweepGrants() }
]
