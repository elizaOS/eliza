// spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device in and keep its key"; spec/cloud/nativeClients/registry.md, "Story: Admit only a registered native client"
import { ackPerIp, apply, decodeState, initial, Rejected, tokenPerIp, type Event, type Grant } from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import { codeChallengeMethod, type ClientRequest, type Registration } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import type { RateLimit } from "../../gen/cloud__shared__rateLimit.effect.vibe"
import { refused, Refused } from "../http/refusal.vibe"
import { json, jsonBody, type Route, type RouteContext, type Sweep } from "../http/routes.vibe"
import { admit } from "../shared/rate-limit.vibe"
import { newId, sameText, seal, secretText, tokenDigest, unseal } from "../shared/sealing.vibe"
import { Store, toInt, toText, type Row, type Tx } from "../store/connection.vibe"
import { outputRows, stepRow, type Columns } from "../store/rows.vibe"
import { admitClient } from "./registry.vibe"

module node {
  import { createHash } from "node:crypto"

  /** @throws {never} */
  export function s256(verifier: string): string {
    return createHash("sha256").update(verifier, "ascii").digest("base64url")
  }
}
import { s256 } from node

const grants = outputRows("device_grants", { initial, decodeState, apply })

const pkceText = /^[A-Za-z0-9._~-]{43,128}$/
const challengeText = /^[A-Za-z0-9_-]{43}$/
const codeText = /^emac_[0-9a-f]{64}$/
const keyText = /^eliza_mobile_[0-9a-f]{64}$/
const uuidText = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
const scopes = ["cloud:user"] as const

const Text = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256))
const Binding = {
  clientId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(200)),
  environment: Schema.Literals(["production", "staging"]),
  redirectUri: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(2000))
}
const ConnectBody = Schema.Struct({
  ...Binding,
  flow: Schema.optionalKey(Schema.Literal("mobile_pkce")),
  state: Text,
  codeChallenge: Text,
  codeChallengeMethod: Text,
  deviceName: Schema.optionalKey(Schema.String)
})
const TokenBody = Schema.Struct({
  ...Binding,
  grantType: Schema.Literal("authorization_code"),
  code: Text,
  state: Text,
  codeVerifier: Text
})
const AckBody = Schema.Struct({
  credentialId: Text,
  secret: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(512)),
  clientId: Schema.optionalKey(Binding.clientId),
  environment: Schema.optionalKey(Binding.environment),
  redirectUri: Schema.optionalKey(Binding.redirectUri),
  code: Schema.optionalKey(Text),
  state: Schema.optionalKey(Text),
  codeVerifier: Schema.optionalKey(Text)
})

export interface Credential {
  readonly credentialId: string
  readonly secret: string
  readonly tokenType: "Bearer"
  readonly expiresAt: string
  readonly expiresIn: number
  readonly scopes: ReadonlyArray<string>
  readonly acknowledgementRequired: true
  readonly acknowledgeBy: string
  readonly user: { readonly id: string }
  readonly organizationId: string
}

export interface Opening {
  readonly userId: string
  readonly registration: Registration
  readonly codeChallenge: string
  readonly deviceName?: string
  readonly now: number
}

interface Issued {
  readonly key: string
  readonly code: string
  readonly codeExpiresAt: number
}

function phaseColumn(grant: Grant): string {
  return match (grant.phase.tag) {
    when "CodeIssued": "code_issued";
    when "Exchanged": "exchanged";
    when "Active": "active";
    when "Expired": "expired";
    when "Ended": "ended";
  }
}

function iso(at: number): string {
  return new Date(at).toISOString()
}

function deviceName(raw: string | undefined): string | null {
  if (raw === undefined) return null
  const name = raw.trim()
  return name.length >= 1 && name.length <= 80 && !/[\p{Cc}\p{Cf}]/u.test(name) ? name : null
}

effect function signInClient(tx: Tx, body: { readonly clientId: string; readonly environment: "production" | "staging"; readonly redirectUri: string }) {
  const url = try Effect.try({ try: () => new URL(body.redirectUri), catch: () => refused("RedirectMismatch") })
  const request: ClientRequest = {
    clientId: body.clientId,
    environment: body.environment === "production" ? "Production" : "Staging",
    redirect: { tag: "ClaimsReturn", purpose: "SignInPurpose", url: { origin: url.origin, path: url.pathname } }
  }
  if (url.origin + url.pathname !== body.redirectUri) throw refused("RedirectMismatch")
  return try admitClient(tx, request)
}

effect function step(tx: Tx, key: string, event: Event, columns: (grant: Grant) => Columns) {
  return try stepRow(tx, grants, key, event, columns)
}

effect function openGrant(tx: Tx, opening: Opening) {
  if (!challengeText.test(opening.codeChallenge)) throw refused("InvalidRequest")
  const code = secretText("emac_", 32, "hex")
  const key = newId()
  const stepped = try step(tx, key, { type: "connect", clientId: opening.registration.clientId, credentialTtl: opening.registration.credentialTtl, now: opening.now }, (grant) => ({
    user_id: opening.userId,
    client_id: opening.registration.clientId,
    phase: phaseColumn(grant),
    code_digest: tokenDigest(code),
    code_challenge: opening.codeChallenge,
    device_name: opening.deviceName ?? null,
    code_expires_at: grant.codeExpiresAt,
    issued_at: opening.now,
    updated_at: opening.now
  }))
  const issued: Issued = { key, code, codeExpiresAt: stepped.state.codeExpiresAt }
  return issued
}

function proofRefusal(grant: Grant, now: number): Refused {
  return now >= grant.codeExpiresAt ? refused("AuthenticationRequired", "CredentialExpired") : refused("CredentialProofInvalid")
}

effect function mint(tx: Tx, row: Row, verifierMatches: boolean, now: number) {
  const key = toText(row.key) ?? ""
  const before = decodeState(row.state) catch effect () => { throw refused("ServiceUnavailable", "NoReason", now + 5000) }
  if (toText(row.status) !== "active" || toInt(row.issued_at) < toInt(row.devices_revoked_before)) throw refused("AuthenticationRequired", "CredentialRevoked")
  const event: Event = { type: "token", verifierMatches, now }
  apply(before, event) catch effect (failure) => { throw proofRefusal(failure.state, now) }
  const minting = before.phase.tag === "CodeIssued"
  const secret = minting ? secretText("eliza_mobile_", 32, "hex") : try unseal("device-key", toText(row.sealed_copy) ?? "")
  const credentialId = minting ? newId() : toText(row.credential_id) ?? ""
  const sealed = minting ? try seal("device-key", secret) : toText(row.sealed_copy) ?? ""
  const stepped = try step(tx, key, event, (grant) => ({
    phase: phaseColumn(grant),
    credential_id: credentialId,
    secret_digest: tokenDigest(secret),
    sealed_copy: sealed,
    updated_at: now
  }))
  const credential: Credential = {
    credentialId,
    secret,
    tokenType: "Bearer",
    expiresAt: iso(now + stepped.state.credentialTtl),
    expiresIn: Math.floor(stepped.state.credentialTtl / 1000),
    scopes,
    acknowledgementRequired: true,
    acknowledgeBy: iso(stepped.state.codeExpiresAt),
    user: { id: toText(row.user_id) ?? "" },
    organizationId: toText(row.organization_id) ?? ""
  }
  return credential
}

const grantColumns = "g.key, g.state, g.client_id, g.user_id, g.code_challenge, g.credential_id, g.secret_digest, g.sealed_copy, g.issued_at, a.organization_id, a.status, a.devices_revoked_before"

effect function grantBy(tx: Tx, column: "code_digest" | "credential_id" | "key", value: string) {
  const found: Row | undefined = (try tx.query(`SELECT ${grantColumns} FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.${column} = $1 FOR UPDATE OF g`, [value]))[0]
  return found
}

export effect function connectAndMint(tx: Tx, opening: Opening) {
  const issued = try openGrant(tx, opening)
  const row = try grantBy(tx, "key", issued.key)
  if (row === undefined) throw refused("ServiceUnavailable", "NoReason", opening.now + 5000)
  return { code: issued.code, credential: try mint(tx, row, true, opening.now) }
}

export effect function revokeAll(tx: Tx, userId: string, now: number) {
  const live = try tx.query(
    "SELECT count(*)::int AS live FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.user_id = $1 AND g.phase = 'active' AND g.key_expires_at > $2 AND g.issued_at >= a.devices_revoked_before",
    [userId, now]
  )
  try tx.query("UPDATE accounts SET devices_revoked_before = GREATEST(devices_revoked_before, $2), updated_at = $3 WHERE key = $1", [userId, now + 1, now])
  return toInt(live[0]?.live ?? 0)
}

effect function perIp(context: RouteContext, limit: RateLimit) {
  const forwarded = context.request.headers["x-forwarded-for"]?.split(",")[0]?.trim()
  const address = forwarded !== undefined && forwarded !== "" ? forwarded : Option.getOrElse(context.request.remoteAddress, () => "unknown")
  try admit({ subject: address, scope: limit.name, limit: limit.limit, widthMs: limit.windowMs })
}

effect function connect(context: RouteContext) {
  const caller = context.caller
  if (caller.kind !== "session") throw refused("AuthenticationRequired", "CredentialUnknown")
  const body = try jsonBody(context, ConnectBody)
  if (body.codeChallengeMethod !== codeChallengeMethod) throw refused("InvalidRequest")
  const name = deviceName(body.deviceName)
  if (body.deviceName !== undefined && name === null) throw refused("InvalidRequest")
  const store = try Store
  const issued = try store.transaction(effect (tx: Tx) => {
    const registration = try signInClient(tx, body)
    return try openGrant(tx, { userId: caller.userId, registration, codeChallenge: body.codeChallenge, now: context.now, ...(name === null ? {} : { deviceName: name }) })
  })
  return json({
    code: issued.code,
    codeType: "mobile_app_auth_code",
    expiresAt: iso(issued.codeExpiresAt),
    expiresIn: Math.floor((issued.codeExpiresAt - context.now) / 1000)
  })
}

effect function token(context: RouteContext) {
  try perIp(context, tokenPerIp)
  const body = try jsonBody(context, TokenBody)
  if (!codeText.test(body.code) || !pkceText.test(body.codeVerifier)) throw refused("CredentialProofInvalid")
  const store = try Store
  const credential = try store.transaction(effect (tx: Tx) => {
    const registration = try signInClient(tx, body)
    const row = try grantBy(tx, "code_digest", tokenDigest(body.code))
    if (row === undefined || toText(row.client_id) !== registration.clientId) throw refused("CredentialProofInvalid")
    return try mint(tx, row, sameText(s256(body.codeVerifier), toText(row.code_challenge) ?? ""), context.now)
  })
  return json(credential)
}

effect function ack(context: RouteContext) {
  try perIp(context, ackPerIp)
  const body = try jsonBody(context, AckBody)
  if (!uuidText.test(body.credentialId) || !keyText.test(body.secret)) throw refused("CredentialProofInvalid")
  const store = try Store
  const expiresAt = try store.transaction(effect (tx: Tx) => {
    const row = try grantBy(tx, "credential_id", body.credentialId)
    if (row === undefined) throw refused("CredentialProofInvalid")
    if (toText(row.status) !== "active" || toInt(row.issued_at) < toInt(row.devices_revoked_before)) throw refused("AuthenticationRequired", "CredentialRevoked")
    const secretMatches = sameText(tokenDigest(body.secret), toText(row.secret_digest) ?? "")
    const before = decodeState(row.state) catch effect () => { throw refused("ServiceUnavailable", "NoReason", context.now + 5000) }
    if (before.phase.tag === "Active" && secretMatches) return before.keyExpiresAt
    const stepped = step(tx, toText(row.key) ?? "", { type: "ack", secretMatches, now: context.now }, (grant) => ({
      phase: phaseColumn(grant),
      sealed_copy: null,
      key_expires_at: grant.keyExpiresAt,
      updated_at: context.now
    })) catch effect (failure) => match (failure) {
      when Rejected: throw secretMatches ? proofRefusal(failure.state, context.now) : refused("CredentialProofInvalid");
      default: throw failure;
    }
    return stepped.state.keyExpiresAt
  })
  return json({ status: "acknowledged", credentialId: body.credentialId, expiresAt: iso(expiresAt) })
}

effect function selfRevoke(context: RouteContext) {
  const caller = context.caller
  if (caller.kind !== "deviceKey") throw refused("AuthenticationRequired", "CredentialUnknown")
  const store = try Store
  try store.transaction((tx: Tx) => step(tx, caller.grantKey, { type: "selfRevoke", now: context.now }, (grant) => ({
    phase: phaseColumn(grant),
    sealed_copy: null,
    updated_at: context.now
  })))
  return json({ status: "revoked", credentialId: caller.credentialId })
}

export effect function sweepGrants(): void!!Store {
  const now = try Clock.currentTimeMillis
  const store = try Store
  const stale = store.transaction((tx: Tx) => tx.query(
    "SELECT key FROM device_grants WHERE phase IN ('code_issued', 'exchanged') AND code_expires_at <= $1",
    [now]
  )) catch effect (failure) => {
    try annotateLogs(logWarning("device grant sweep failed"), { cause: failure._tag })
    return []
  }
  for (const row of stale) {
    const key = toText(row.key) ?? ""
    store.transaction((tx: Tx) => step(tx, key, { type: "cleanup", now }, (grant) => ({
      phase: phaseColumn(grant),
      sealed_copy: null,
      updated_at: now
    }))) catch effect (failure) => {
      try annotateLogs(logWarning("device grant cleanup failed"), { key, cause: failure._tag })
    }
  }
}

export const routes: ReadonlyArray<Route> = [
  { method: "POST", path: "/api/v1/app-auth/connect", auth: "SignedSession", maxBodyBytes: 4096, handler: connect },
  { method: "POST", path: "/api/v1/app-auth/mobile/token", auth: "Public", maxBodyBytes: 4096, handler: token },
  { method: "POST", path: "/api/v1/app-auth/mobile/ack", auth: "Public", maxBodyBytes: 4096, handler: ack },
  { method: "DELETE", path: "/api/v1/api-keys/current", auth: "ServiceAccess", handler: selfRevoke }
]

export const sweeps: ReadonlyArray<Sweep> = [
  { name: "device grants", everyMs: 60 * 60_000, run: sweepGrants() }
]
