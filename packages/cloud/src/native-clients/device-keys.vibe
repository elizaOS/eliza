// spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device in and keep its key"; spec/cloud/nativeClients/deviceKeys.md, "Story: Keep my phone signed in without a browser"; spec/cloud/nativeClients/deviceKeys.md, "Signing out ends the presenting key and every key renewed from it, unless it names its acknowledged successor"; spec/cloud/nativeClients/registry.md, "Story: Admit only a registered native client"
import { ackOutcome, ackPerIp, apply, recordedExpiryReached, grantBindingMatches, lapsed, nativeOutcome, renewableUntil, renewalCheck, renewPerIp, reusedRefusal, revokeAll as revokeDeviceEpoch, signOutEndsSuccessor, successorMayFinish, tokenAnswer, tokenOutcome, tokenPerIp, type ClientBinding, type CodeRequest, type Event, type GoogleLink, type Grant, type GrantEffect, type RenewalFacts } from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import { clientCheck, codeChallengeMethod, faultRefusal, type ClientCheck, type ClientRequest, type Registration } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import type { NativeVerdict, SignInYield } from "../../gen/cloud__identity__federatedSignIn.effect.vibe"
import type { CodeBinding } from "../../gen/cloud__identity__federatedSignIn.effect.vibe"
import { admitRequest, type CredentialView } from "../../gen/cloud__identity__sessions.effect.vibe"
import type { NativeGoogleCheck } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import type { RateLimit } from "../../gen/cloud__shared__rateLimit.effect.vibe"
import type { RefusalReason } from "../../gen/cloud__shared__types.effect.vibe"
import { refused, Refused } from "../http/refusal.vibe"
import { json, jsonBody, type Route, type RouteContext, type Sweep } from "../http/routes.vibe"
import { admitCheck } from "../shared/rate-limit.vibe"
import { s256 } from "../shared/credential-crypto.vibe"
import { newId, sameText, seal, secretText, tokenDigest, unseal } from "../shared/sealing.vibe"
import { Store, toInt, toText, type Row, type Tx } from "../store/connection.vibe"
import { type Columns } from "../store/rows.vibe"
import { currentGrant, decodeGrant, endKey, inspectKey, isFlatGrant, keyExpiresAt, phaseColumn, stepGrant } from "./grants.vibe"
import { admitClient, parseReturn, readRegistry, servedEnvironment } from "./registry.vibe"


const pkceText = /^[A-Za-z0-9._~-]{43,128}$/
const challengeText = /^[A-Za-z0-9_-]{43}$/
const codeText = /^emac_[0-9a-f]{64}$/
const keyText = /^eliza_mobile_[0-9a-f]{64}$/
const uuidText = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
const scopes = ["cloud:user"] as const

const Text = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256))
const Binding = {
  clientId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(200)),
  environment: Schema.Literals(["production", "staging"]),
  redirectUri: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(2000))
}
const ConnectBody = Schema.Struct({
  ...Binding,
  flow: Schema.optionalKey(Schema.Literal("mobile_pkce")),
  state: Text,
  codeChallenge: Text,
  codeChallengeMethod: Text,
  deviceName: Schema.optionalKey(Schema.String)
})
const TokenBody = Schema.Struct({ ...Binding, grantType: Schema.Literal("authorization_code"), code: Text, state: Text, codeVerifier: Text })
const AckBody = Schema.Struct({
  credentialId: Text,
  secret: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(512)),
  clientId: Schema.optionalKey(Binding.clientId),
  environment: Schema.optionalKey(Binding.environment),
  redirectUri: Schema.optionalKey(Binding.redirectUri),
  code: Schema.optionalKey(Text),
  state: Schema.optionalKey(Text),
  codeVerifier: Schema.optionalKey(Text)
})

export interface Credential {
  readonly credentialId: string
  readonly secret: string
  readonly tokenType: "Bearer"
  readonly expiresAt: string
  readonly expiresIn: number
  readonly scopes: ReadonlyArray<string>
  readonly acknowledgementRequired: true
  readonly acknowledgeBy: string
  readonly user: { readonly id: string }
  readonly organizationId: string
}

export interface Opening {
  readonly grantKey: string
  readonly userId: string
  readonly sessionKey: string
  readonly request: typeof ConnectBody.Type
}

export interface NativeOpening {
  readonly grantKey: string
  readonly userId: string
  readonly request: typeof ConnectBody.Type
  readonly nativeGoogle: NativeGoogleCheck
  readonly verdict: NativeVerdict
  readonly yielded: SignInYield
  readonly serverCode: GoogleLink
}

function iso(at: number): string { return new Date(at).toISOString() }

export function deviceName(raw: string | undefined): string | null {
  if (raw === undefined) return null
  const name = raw.trim()
  return name.length >= 1 && name.length <= 80 && !/[\p{Cc}\p{Cf}]/u.test(name) ? name : null
}

function bindingOf(registration: Registration): ClientBinding {
  return { clientId: registration.clientId, environment: registration.environment, signInReturn: registration.signInReturn }
}

function requestOf(body: { readonly clientId: string; readonly environment: "production" | "staging"; readonly redirectUri: string }): ClientRequest {
  const url = parseReturn(body.redirectUri)
  return { clientId: body.clientId, environment: body.environment === "production" ? "Production" : "Staging", redirect: url === undefined ? { tag: "NoRedirect" } : { tag: "ClaimsReturn", purpose: "SignInPurpose", url } }
}

effect function admission(tx: Tx, request: ClientRequest) {
  try tx.query("LOCK TABLE native_clients IN SHARE MODE")
  const served = try servedEnvironment()
  const registry = try readRegistry(tx)
  const check = clientCheck(registry, served, request)
  if (check.tag === "ClientRefused") throw new Refused({ refusal: faultRefusal(check.fault) })
  const registration = registry.find((entry) => entry.clientId === request.clientId && entry.environment === request.environment)
  if (registration === undefined) throw refused("InvalidClient")
  return { registration, check }
}

export effect function signInClient(tx: Tx, body: { readonly clientId: string; readonly environment: "production" | "staging"; readonly redirectUri: string }) {
  return try admitClient(tx, requestOf(body))
}

effect function storedAdmission(tx: Tx, grant: Grant) {
  const client = grant.client
  if (client.tag !== "BoundClient") throw refused("CredentialProofInvalid")
  return try admission(tx, { clientId: client.clientId, environment: client.environment, redirect: { tag: "ClaimsReturn", purpose: "SignInPurpose", url: client.signInReturn } })
}

function bindingMatches(grant: Grant, body: { readonly clientId: string; readonly environment: "production" | "staging"; readonly redirectUri: string }): boolean {
  const offered = requestOf(body)
  return offered.redirect.tag === "ClaimsReturn" && grantBindingMatches(grant, { clientId: offered.clientId, environment: offered.environment, signInReturn: offered.redirect.url })
}

function codeRequest(body: typeof ConnectBody.Type, client: ClientCheck): CodeRequest {
  return { client, method: body.codeChallengeMethod === codeChallengeMethod ? "S256" : "PlainMethod", hasState: pkceText.test(body.state) }
}

function openingName(body: typeof ConnectBody.Type): string | null {
  return deviceName(body.deviceName)
}

effect function account(tx: Tx, userId: string) {
  const row = (try tx.query("SELECT key, organization_id, status, device_epoch FROM accounts WHERE key = $1 FOR UPDATE", [userId]))[0]
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return row
}

effect function sessionView(tx: Tx, opening: Opening) {
  const row = (try tx.query("SELECT s.live, s.state->>'epoch' AS epoch, s.access_expires_at, s.refresh_expires_at, s.auth_at, s.step_up_at, s.mfa_at, a.status, a.sessions_revoked_before FROM sessions s JOIN accounts a ON a.key = s.user_id WHERE s.key = $1 AND s.user_id = $2 FOR UPDATE OF s, a", [opening.sessionKey, opening.userId]))[0]
  const now = try Clock.currentTimeMillis
  return {
    kind: "RequestSession", found: row !== undefined && now < toInt(row.refresh_expires_at),
    live: row?.live === true && toInt(row.epoch) === toInt(row.sessions_revoked_before),
    expiresAt: toInt(row?.access_expires_at ?? 0), issuedAt: toInt(row?.auth_at ?? 0), revokedBefore: 0,
    accountStatus: row?.status === "active" ? "RequestAccountActive" : "RequestAccountInactive",
    authAt: toInt(row?.auth_at ?? 0), stepUpAt: toInt(row?.step_up_at ?? 0), mfaAt: toInt(row?.mfa_at ?? 0)
  } satisfies CredentialView
}

function openingColumns(opening: Pick<Opening, "userId" | "request">, code: string, name: string | null, grant: Grant): Columns {
  return {
    user_id: opening.userId, client_id: opening.request.clientId, phase: phaseColumn(grant), code_digest: tokenDigest(code),
    code_challenge: opening.request.codeChallenge, state_digest: tokenDigest(opening.request.state), device_name: name,
    code_expires_at: grant.codeExpiresAt, device_epoch: grant.epoch, issued_at: grant.now, sign_in_at: grant.now, updated_at: grant.now
  }
}

export effect function openGrant(tx: Tx, opening: Opening) {
  const body = opening.request
  const name = openingName(body)
  if (!challengeText.test(body.codeChallenge) || (body.deviceName !== undefined && name === null)) throw refused("InvalidRequest")
  const admitted = try admission(tx, requestOf(body))
  const owner = try account(tx, opening.userId)
  const view = try sessionView(tx, opening)
  const code = secretText("emac_", 32, "hex")
  const stepped = stepGrant(tx, opening.grantKey, {
    type: "connect", view, codeRequest: codeRequest(body, admitted.check), clientBinding: bindingOf(admitted.registration),
    credentialTtl: admitted.registration.credentialTtl, deviceEpoch: toInt(owner.device_epoch)
  }, (grant) => openingColumns(opening, code, name, grant)) catch effect (failure) => {
    if (failure._tag === "Rejected") {
      const decision = admitRequest(view, "SignedSession", failure.state.now)
      if (decision.tag === "RequestRefused") throw new Refused({ refusal: decision.refusal })
      throw refused("InvalidRequest")
    }
    throw failure
  }
  return { key: opening.grantKey, code, codeExpiresAt: stepped.state.codeExpiresAt, out: stepped.out.out }
}

const grantColumns = "g.key, g.state, g.phase, g.device_epoch AS grant_epoch, a.device_epoch AS account_epoch, g.client_id, g.user_id, g.code_digest, g.code_challenge, g.state_digest, g.credential_id, g.secret_digest, g.sealed_copy, g.issued_at, g.key_expires_at, g.renewed_from, COALESCE(g.sign_in_at, g.issued_at) AS sign_in_at, a.organization_id, a.status, a.device_epoch"

effect function grantBy(tx: Tx, column: "code_digest" | "credential_id" | "key", value: string) {
  return (try tx.query(`SELECT ${grantColumns} FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.${column} = $1 FOR UPDATE OF a, g`, [value]))[0]
}

effect function renewedFrom(tx: Tx, key: string) {
  return try tx.query(`WITH RECURSIVE chain AS (SELECT key FROM device_grants WHERE renewed_from = $1 UNION SELECT d.key FROM device_grants d JOIN chain c ON d.renewed_from = c.key) SELECT ${grantColumns} FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.key IN (SELECT key FROM chain) FOR UPDATE OF a, g`, [key])
}

function pending(row: Row): boolean {
  return row.phase === "code_issued" || row.phase === "exchanged"
}

export effect function supersedeGrant(tx: Tx, key: string) {
  const stepped = try stepGrant(tx, key, { type: "supersede" }, (grant) => ({ phase: phaseColumn(grant), sealed_copy: null, updated_at: grant.now }))
  return stepped.out.out
}

effect function endRenewed(tx: Tx, row: Row, now: number) {
  if (!pending(row)) {
    try endKey(tx, row, now)
    return
  }
  supersedeGrant(tx, toText(row.key) ?? "") catch effect (failure) => {
    if (failure._tag !== "Rejected") throw failure
  }
}

effect function predecessorReason(tx: Tx, grant: Grant, row: Row, now: number) {
  const none: RefusalReason = "NoReason"
  if (grant.origin.tag !== "Renewed") return none
  const predecessor = try grantBy(tx, "key", toText(row.renewed_from) ?? "")
  const gone: RefusalReason = "CredentialRevoked"
  if (predecessor === undefined) return gone
  const key = inspectKey(predecessor, now) catch effect () => { throw refused("ServiceUnavailable", "NoReason", now + 5000) }
  return key.reason
}

effect function finishable(tx: Tx, grant: Grant, row: Row, now: number) {
  const predecessor = try predecessorReason(tx, grant, row, now)
  if (!successorMayFinish(grant, predecessor)) throw refused("AuthenticationRequired", predecessor)
}

effect function current(row: Row, now: number) {
  if (isFlatGrant(row.state)) throw refused("CredentialProofInvalid")
  const grant = decodeGrant(row.state) catch effect () => { throw refused("ServiceUnavailable", "NoReason", now + 5000) }
  if (row.status !== "active") throw refused("AuthenticationRequired", "CredentialRevoked")
  return try currentGrant(grant, now)
}

function credential(grant: Grant, row: Row, secret: string): Credential {
  const answer = tokenAnswer(grant)
  return {
    credentialId: answer.credentialId, secret, tokenType: "Bearer", expiresAt: iso(answer.expiresAt),
    expiresIn: Math.floor((answer.expiresAt - grant.now) / 1000), scopes, acknowledgementRequired: true,
    acknowledgeBy: iso(answer.acknowledgeBy), user: { id: toText(row.user_id) ?? "" }, organizationId: toText(row.organization_id) ?? ""
  }
}

effect function mint(tx: Tx, row: Row, body: typeof TokenBody.Type) {
  const now = try Clock.currentTimeMillis
  const before = try current(row, now)
  const admitted = try storedAdmission(tx, before)
  const at = try Clock.currentTimeMillis
  const ready = try currentGrant(before, at)
  try finishable(tx, ready, row, at)
  const proof = sameText(s256(body.codeVerifier), toText(row.code_challenge) ?? "") && sameText(tokenDigest(body.state), toText(row.state_digest) ?? "")
  const binding: CodeBinding = !bindingMatches(ready, body) ? "RedirectDiffers" : proof ? "BindingMatches" : "VerifierDiffers"
  const outcome = tokenOutcome(ready, admitted.check, binding, toInt(row.device_epoch))
  if (outcome.tag === "GrantRefused") throw new Refused({ refusal: outcome.refusal })
  const credentialId = ready.phase.tag === "CodeIssued" ? newId() : ready.credentialId
  const event: Event = { type: "token", client: admitted.check, binding, credentialId, deviceEpoch: toInt(row.device_epoch) }
  const preview = try apply(ready, event)
  const minting = preview.out.includes("MintSealedKey")
  const secret = minting ? secretText("eliza_mobile_", 32, "hex") : try unseal("device-key", toText(row.sealed_copy) ?? "")
  const sealed = minting ? try seal("device-key", secret) : toText(row.sealed_copy) ?? ""
  const stepped = stepGrant(tx, toText(row.key) ?? "", event, (grant) => ({ phase: phaseColumn(grant), credential_id: credentialId, secret_digest: tokenDigest(secret), sealed_copy: sealed, updated_at: grant.now })) catch effect (failure) => {
    if (failure._tag === "Rejected") {
      const decision = tokenOutcome(failure.state, admitted.check, binding, toInt(row.device_epoch))
      if (decision.tag === "GrantRefused") throw new Refused({ refusal: decision.refusal })
      throw refused("CredentialProofInvalid")
    }
    throw failure
  }
  return { credential: credential(stepped.state, row, secret), out: stepped.out.out }
}

export effect function connectAndMint(tx: Tx, opening: NativeOpening) {
  const body = opening.request
  const name = openingName(body)
  if (!challengeText.test(body.codeChallenge) || (body.deviceName !== undefined && name === null)) throw refused("InvalidRequest")
  const admitted = try admission(tx, requestOf(body))
  const outcome = nativeOutcome(codeRequest(body, admitted.check), opening.nativeGoogle, opening.verdict, opening.yielded)
  if (outcome.tag === "NativeRefused") throw new Refused({ refusal: outcome.refusal })
  const owner = try account(tx, opening.userId)
  if (owner.status !== "active") throw refused("AuthenticationRequired", "CredentialRevoked")
  const code = secretText("emac_", 32, "hex")
  const secret = secretText("eliza_mobile_", 32, "hex")
  const credentialId = newId()
  const sealed = try seal("device-key", secret)
  const stepped = try stepGrant(tx, opening.grantKey, {
    type: "signInNatively", codeRequest: codeRequest(body, admitted.check), clientBinding: bindingOf(admitted.registration),
    nativeGoogle: opening.nativeGoogle, verdict: opening.verdict, yielded: opening.yielded, serverCode: opening.serverCode,
    credentialTtl: admitted.registration.credentialTtl, credentialId, deviceEpoch: toInt(owner.device_epoch)
  }, (grant) => ({ ...openingColumns(opening, code, name, grant), credential_id: credentialId, secret_digest: tokenDigest(secret), sealed_copy: sealed }))
  return { code, credential: credential(stepped.state, { user_id: opening.userId, organization_id: owner.organization_id }, secret), out: stepped.out.out }
}

export effect function revokeAll(tx: Tx, userId: string, now: number) {
  const owner = try account(tx, userId)
  const rows = try tx.query("SELECT state, phase, key_expires_at, device_epoch AS grant_epoch, $2::bigint AS account_epoch FROM device_grants WHERE user_id = $1 FOR UPDATE", [userId, owner.device_epoch])
  const live = try Effect.forEach(rows, effect (row) => { return inspectKey(row, now) catch () => undefined })
  const changed = revokeDeviceEpoch(toInt(owner.device_epoch))
  try tx.query("UPDATE accounts SET device_epoch = $2, updated_at = $3 WHERE key = $1", [userId, changed.toDeviceEpoch, now])
  return live.filter((key) => key?.reason === "NoReason").length
}

export effect function perIp(context: RouteContext, limit: RateLimit) {
  try admitCheck({ subject: Option.getOrElse(context.request.remoteAddress, () => "unknown"), rule: limit })
}

effect function connect(context: RouteContext) {
  const caller = context.caller
  if (caller.kind !== "session") throw refused("AuthenticationRequired", "CredentialUnknown")
  const body = try jsonBody(context, ConnectBody)
  const store = try Store
  const issued = try store.transaction((tx: Tx) => openGrant(tx, { grantKey: newId(), userId: caller.userId, sessionKey: caller.sessionKey, request: body }))
  return json({ code: issued.code, codeType: "mobile_app_auth_code", expiresAt: iso(issued.codeExpiresAt), expiresIn: Math.floor((issued.codeExpiresAt - (try Clock.currentTimeMillis)) / 1000) })
}

export effect function exchangeGrant(tx: Tx, body: typeof TokenBody.Type) {
  if (!codeText.test(body.code) || !pkceText.test(body.codeVerifier)) throw refused("CredentialProofInvalid")
  const row = try grantBy(tx, "code_digest", tokenDigest(body.code))
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return try mint(tx, row, body)
}

effect function token(context: RouteContext) {
  try perIp(context, tokenPerIp)
  const body = try jsonBody(context, TokenBody)
  const store = try Store
  const minted = try store.transaction((tx: Tx) => exchangeGrant(tx, body))
  return json(minted.credential)
}

export effect function acknowledgeGrant(tx: Tx, body: typeof AckBody.Type) {
  if (!uuidText.test(body.credentialId) || !keyText.test(body.secret)) throw refused("CredentialProofInvalid")
  const row = try grantBy(tx, "credential_id", body.credentialId)
  if (row === undefined) throw refused("CredentialProofInvalid")
  const before = try current(row, try Clock.currentTimeMillis)
  const admitted = try storedAdmission(tx, before)
  const snapshot = before.client
  if (snapshot.tag !== "BoundClient") throw refused("CredentialProofInvalid")
  const matches = bindingMatches(before, {
    clientId: body.clientId ?? snapshot.clientId,
    environment: body.environment ?? (snapshot.environment === "Production" ? "production" : "staging"),
    redirectUri: body.redirectUri ?? snapshot.signInReturn.origin + snapshot.signInReturn.path
  })
  const proofMatches = matches && sameText(tokenDigest(body.secret), toText(row.secret_digest) ?? "")
    && (body.code === undefined || sameText(tokenDigest(body.code), toText(row.code_digest) ?? ""))
    && (body.state === undefined || sameText(tokenDigest(body.state), toText(row.state_digest) ?? ""))
    && (body.codeVerifier === undefined || (pkceText.test(body.codeVerifier) && sameText(s256(body.codeVerifier), toText(row.code_challenge) ?? "")))
  const now = try Clock.currentTimeMillis
  const ready = try currentGrant(before, now)
  try finishable(tx, ready, row, now)
  const outcome = ackOutcome(ready, admitted.check, proofMatches, toInt(row.device_epoch))
  if (outcome.tag === "GrantRefused") throw new Refused({ refusal: outcome.refusal })
  const stepped = stepGrant(tx, toText(row.key) ?? "", { type: "ack", client: admitted.check, proofMatches, deviceEpoch: toInt(row.device_epoch) },
    (grant) => ({ phase: phaseColumn(grant), sealed_copy: null, key_expires_at: keyExpiresAt(grant), updated_at: grant.now })) catch effect (failure) => {
    if (failure._tag === "Rejected") {
      const decision = ackOutcome(failure.state, admitted.check, proofMatches, toInt(row.device_epoch))
      if (decision.tag === "GrantRefused") throw new Refused({ refusal: decision.refusal })
      throw refused("CredentialProofInvalid")
    }
    throw failure
  }
  return { answer: { status: "acknowledged", credentialId: body.credentialId, expiresAt: iso(keyExpiresAt(stepped.state)), scopes }, out: stepped.out.out }
}

effect function ack(context: RouteContext) {
  try perIp(context, ackPerIp)
  const body = try jsonBody(context, AckBody)
  const store = try Store
  const acknowledged = try store.transaction((tx: Tx) => acknowledgeGrant(tx, body))
  return json(acknowledged.answer)
}

effect function signOutKey(tx: Tx, grantKey: string, namedSuccessor: string) {
  const row = try grantBy(tx, "key", grantKey)
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const now = try Clock.currentTimeMillis
  const reason = try endKey(tx, row, now)
  if (reason !== "NoReason") throw refused("AuthenticationRequired", reason)
  const chain = try renewedFrom(tx, grantKey)
  let kept: string | undefined
  for (const successor of chain) {
    if (toText(successor.renewed_from) !== grantKey || pending(successor)) continue
    const live = inspectKey(successor, now) catch effect () => { throw refused("ServiceUnavailable", "NoReason", now + 5000) }
    if (!signOutEndsSuccessor(namedSuccessor, toText(successor.credential_id) ?? "", live.reason === "NoReason")) kept = toText(successor.key)
  }
  for (const successor of chain) {
    if (kept !== undefined && (toText(successor.key) === kept || !pending(successor) || toText(successor.renewed_from) !== grantKey)) continue
    try endRenewed(tx, successor, now)
  }
}

effect function selfRevoke(context: RouteContext) {
  const caller = context.caller
  if (caller.kind !== "deviceKey") throw refused("AuthenticationRequired", "CredentialUnknown")
  const named = context.request.headers["x-renewed-credential-id"]
  if (named !== undefined && !uuidText.test(named)) throw refused("InvalidRequest")
  const store = try Store
  try store.transaction((tx: Tx) => signOutKey(tx, caller.grantKey, named ?? ""))
  return HttpServerResponse.empty({ status: 204, headers: { "cache-control": "no-store" } })
}

export interface Renewing {
  readonly grantKey: string
  readonly predecessorKey: string
  readonly request: typeof ConnectBody.Type
}

effect function acknowledgedSuccessor(chain: ReadonlyArray<Row>, predecessorKey: string, now: number) {
  for (const successor of chain) {
    if (toText(successor.renewed_from) !== predecessorKey || pending(successor)) continue
    const key = inspectKey(successor, now) catch effect () => { throw refused("ServiceUnavailable", "NoReason", now + 5000) }
    if (key.authority.tag === "RecordedAuthority" || !lapsed(key.authority.grant)) return true
  }
  return false
}

export effect function renewGrant(tx: Tx, renewing: Renewing) {
  const { predecessorKey, request: body } = renewing
  const name = openingName(body)
  if (!challengeText.test(body.codeChallenge) || (body.deviceName !== undefined && name === null)) throw refused("InvalidRequest")
  const row = try grantBy(tx, "key", predecessorKey)
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const now = try Clock.currentTimeMillis
  const key = inspectKey(row, now) catch effect () => { throw refused("ServiceUnavailable", "NoReason", now + 5000) }
  try tx.query("LOCK TABLE native_clients IN SHARE MODE")
  const served = try servedEnvironment()
  const registry = try readRegistry(tx)
  const request = requestOf(body)
  const check = clientCheck(registry, served, request)
  const registration = registry.find((entry) => entry.clientId === request.clientId && entry.environment === request.environment)
  const predecessor = key.authority.tag === "GrantAuthority" ? try currentGrant(key.authority.grant, now) : undefined
  const chain = try renewedFrom(tx, predecessorKey)
  const facts: RenewalFacts = {
    predecessor: key.reason,
    clientMatches: check.tag === "ClientAdmitted" && registration !== undefined && predecessor !== undefined && grantBindingMatches(predecessor, bindingOf(registration)),
    predecessorExpiresAt: key.expiresAt,
    signInAt: toInt(row.sign_in_at),
    successorAcknowledged: try acknowledgedSuccessor(chain, predecessorKey, now)
  }
  const checked = renewalCheck(facts, now, registration?.credentialTtl ?? 0)
  if (checked.tag === "RenewalRefused") throw new Refused({ refusal: checked.refusal })
  if (checked.tag === "RenewalReused") {
    try endKey(tx, row, now)
    for (const successor of chain) try endRenewed(tx, successor, now)
    return { kind: "reused" as const }
  }
  if (registration === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  for (const successor of chain) try endRenewed(tx, successor, now)
  const userId = toText(row.user_id) ?? ""
  const code = secretText("emac_", 32, "hex")
  const stepped = stepGrant(tx, renewing.grantKey, {
    type: "renew", facts, codeRequest: codeRequest(body, check), clientBinding: bindingOf(registration),
    registrationTtl: registration.credentialTtl, deviceEpoch: toInt(row.device_epoch)
  }, (grant) => ({ ...openingColumns({ userId, request: body }, code, name, grant), sign_in_at: facts.signInAt, renewed_from: predecessorKey })) catch effect (failure) => {
    if (failure._tag === "Rejected") throw refused("InvalidRequest")
    throw failure
  }
  return { kind: "issued" as const, code, codeExpiresAt: stepped.state.codeExpiresAt, renewableUntil: renewableUntil(facts.signInAt) }
}

effect function renewKey(context: RouteContext) {
  try perIp(context, renewPerIp)
  const caller = context.caller
  if (caller.kind !== "deviceKey") throw refused("AuthenticationRequired", "CredentialUnknown")
  const body = try jsonBody(context, ConnectBody)
  const store = try Store
  const renewed = try store.transaction((tx: Tx) => renewGrant(tx, { grantKey: newId(), predecessorKey: caller.grantKey, request: body }))
  if (renewed.kind === "reused") throw new Refused({ refusal: reusedRefusal })
  const now = try Clock.currentTimeMillis
  return json({
    code: renewed.code, codeType: "mobile_app_auth_code", expiresAt: iso(renewed.codeExpiresAt),
    expiresIn: Math.floor((renewed.codeExpiresAt - now) / 1000), renewableUntil: iso(renewed.renewableUntil)
  })
}

export effect function retireGrant(tx: Tx, key: string, kind: "lapse" | "expire") {
  const held = try grantBy(tx, "key", key)
  if (held === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const now = try Clock.currentTimeMillis
  const authority = try inspectKey(held, now)
  if (authority.authority.tag === "RecordedAuthority") {
    if (kind !== "expire" || !recordedExpiryReached(authority.authority.key, now)) throw refused("CredentialProofInvalid")
    try tx.query("UPDATE device_grants SET phase = 'expired', sealed_copy = NULL, revision = revision + 1, updated_at = $2 WHERE key = $1", [key, now])
    const out: ReadonlyArray<GrantEffect> = []
    return out
  }
  const stepped = try stepGrant(tx, key, { type: kind }, (grant) => ({ phase: phaseColumn(grant), sealed_copy: null, updated_at: grant.now }))
  return stepped.out.out
}

export effect function sweepGrants(): void!!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const stale = store.transaction((tx: Tx) => tx.query("SELECT key, phase FROM device_grants WHERE (phase IN ('code_issued', 'exchanged') AND code_expires_at <= $1 AND NOT state ? 'flatDeviceGrant') OR (phase = 'active' AND key_expires_at <= $1)", [now])) catch effect (failure) => {
    try annotateLogs(logWarning("device grant sweep failed"), { cause: failure._tag })
    return []
  }
  for (const row of stale) {
    const key = toText(row.key) ?? ""
    store.transaction((tx: Tx) => retireGrant(tx, key, row.phase === "active" ? "expire" : "lapse")) catch effect (failure) => {
      try annotateLogs(logWarning("device grant cleanup failed"), { key, cause: failure._tag })
    }
  }
}

export const routes: ReadonlyArray<Route> = [
  { method: "POST", path: "/api/v1/app-auth/connect", auth: "SignedSession", maxBodyBytes: 4096, handler: connect },
  { method: "POST", path: "/api/v1/app-auth/mobile/token", auth: "Public", maxBodyBytes: 4096, handler: token },
  { method: "POST", path: "/api/v1/app-auth/mobile/ack", auth: "Public", maxBodyBytes: 4096, handler: ack },
  { method: "POST", path: "/api/v1/app-auth/mobile/renew", auth: "ServiceAccess", maxBodyBytes: 4096, handler: renewKey },
  { method: "DELETE", path: "/api/v1/api-keys/current", auth: "ServiceAccess", handler: selfRevoke }
]
export const sweeps: ReadonlyArray<Sweep> = [{ name: "device grants", everyMs: 60 * 60_000, run: sweepGrants() }]
