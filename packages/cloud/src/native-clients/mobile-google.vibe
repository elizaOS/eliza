// spec/cloud/nativeClients/deviceKeys.md, "Story: Sign a device in and keep its key"; spec/cloud/nativeClients/registry.md, "Native Google sign-in is refused as google_not_configured when Google is off, and as invalid_client when the registration does not enable it"; spec/cloud/identity/federatedSignIn.md, "An ID token spends a live challenge once, only with the client, verifier, signature, issuer, audience and nonce all right, and a refused one spends nothing"
import { tokenPerIp } from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import { nativeGoogleCheck, nativeGoogleRefusal } from "../../gen/cloud__nativeClients__registry.effect.vibe"
import { millisPerSecond } from "../../gen/cloud__shared__types.effect.vibe"
import { refused, Refused } from "../http/refusal.vibe"
import { json, jsonBody, type Route, type RouteContext } from "../http/routes.vibe"
import { landAccount, type Landed } from "../identity/accounts.vibe"
import { spendNativeGoogle, verifyNativeGoogle, type VerifiedGoogle } from "../identity/federated.vibe"
import { factorChallenge } from "../identity/second-factor.vibe"
import { Deployment, rowOf } from "../profile/profile.vibe"
import { readIdToken } from "../providers/google-identity.vibe"
import { openTokens, sealTokens, tokenForm, type GoogleProfile } from "../providers/google.vibe"
import { connectionColumns, connectionRows } from "../services/google/grant-access.vibe"
import { s256 } from "../shared/credential-crypto.vibe"
import { newId } from "../shared/sealing.vibe"
import { Store, toText, type Tx } from "../store/connection.vibe"
import { stepRow } from "../store/rows.vibe"
import { connectAndMint, deviceName, perIp, signInClient, type Credential } from "./device-keys.vibe"

const pkceText = /^[A-Za-z0-9._~-]{43,128}$/
const Text = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256))
const SignInBody = Schema.Struct({
  clientId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(200)),
  environment: Schema.Literals(["production", "staging"]),
  redirectUri: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(2000)),
  state: Text,
  codeVerifier: Text,
  deviceName: Schema.optionalKey(Schema.String),
  identity: Schema.Struct({
    challengeId: Text,
    idToken: Schema.String.check(Schema.isMinLength(20), Schema.isMaxLength(8192)),
    codeVerifier: Text
  }),
  serverAuthCode: Schema.optionalKey(Schema.String.check(Schema.isMinLength(10), Schema.isMaxLength(2048), Schema.isPattern(/^[A-Za-z0-9/_.~-]+$/)))
})
schema ServerCodeReply { access_token: string; expires_in: number; refresh_token?: string; scope?: string; id_token?: string }

export type GoogleLink =
  | { readonly connected: true; readonly connectionId: string; readonly email: string | null; readonly scopes: ReadonlyArray<string>; readonly refreshTokenIssued: boolean }
  | { readonly connected: false; readonly code: GoogleLinkFault }

type GoogleLinkFault = "google_not_configured" | "google_code_rejected" | "google_scopes_missing" | "google_account_mismatch" | "google_unavailable"

type SignedIn =
  | { readonly kind: "mfa"; readonly answer: { readonly status: "mfa_required"; readonly challengeId: string; readonly methods: ReadonlyArray<string>; readonly expiresAt: number } }
  | { readonly kind: "minted"; readonly landed: Landed; readonly verified: VerifiedGoogle; readonly code: string; readonly credential: Credential }

interface Linked {
  readonly connectionId: string
  readonly email: string
  readonly scopes: ReadonlyArray<string>
  readonly refreshTokenIssued: boolean
}

function unlinked(code: GoogleLinkFault): GoogleLink {
  return { connected: false, code }
}

effect function signIn(body: typeof SignInBody.Type, now: number) {
  const deployment = try Deployment
  const store = try Store
  const name = deviceName(body.deviceName)
  if ((body.deviceName !== undefined && name === null) || !pkceText.test(body.codeVerifier)) throw refused("InvalidRequest")
  return try store.transaction(effect (tx: Tx) => {
    const registration = try signInClient(tx, body)
    const native = nativeGoogleCheck(rowOf(deployment.profile.name, deployment.settings).signIn, registration)
    if (native !== "NativeGoogleOpen") throw new Refused({ refusal: nativeGoogleRefusal(native) })
    const verified = try verifyNativeGoogle(tx, {
      challengeId: body.identity.challengeId,
      idToken: body.identity.idToken,
      presenter: { kind: "signIn", clientId: registration.clientId, redirectUri: body.redirectUri, codeVerifier: body.identity.codeVerifier },
      now
    })
    const landed = try landAccount(tx, verified.identity, verified.verifiedEmail, now, verified.givenName)
    const factor = try factorChallenge(tx, landed, registration.clientId, now)
    if (factor !== undefined) {
      try spendNativeGoogle(tx, verified, "SecondFactorRequired", now)
      return { kind: "mfa", answer: factor } satisfies SignedIn
    }
    try spendNativeGoogle(tx, verified, "SessionStarts", now)
    const minted = try connectAndMint(tx, {
      userId: landed.userId,
      registration,
      codeChallenge: s256(body.codeVerifier),
      state: body.state,
      now,
      ...(name === null ? {} : { deviceName: name })
    })
    return { kind: "minted", landed, verified, code: minted.code, credential: minted.credential } satisfies SignedIn
  })
}

effect function redeemServerCode(google: GoogleProfile, serverAuthCode: string, subject: string, now: number) {
  const secret = try orDie((try Deployment).secret(google.clientSecretEnv))
  const answer = try tokenForm(google.tokenUrl, new URLSearchParams({
    grant_type: "authorization_code",
    code: serverAuthCode,
    client_id: google.serverClientId,
    client_secret: secret,
    redirect_uri: ""
  }))
  if (answer.status >= 400 && answer.status < 500) return unlinked("google_code_rejected")
  if (answer.status < 200 || answer.status >= 300) return unlinked("google_unavailable")
  const reply = Option.getOrUndefined(Schema.decodeUnknownOption(ServerCodeReply)(answer.body))
  if (reply === undefined || reply.access_token === "" || !(reply.expires_in > 0)) return unlinked("google_unavailable")
  const scopes = [...new Set((reply.scope ?? "").split(/\s+/).filter((scope) => scope !== ""))]
  if (scopes.length === 0) return unlinked("google_scopes_missing")
  const token = reply.id_token === undefined ? undefined : try readIdToken(google, reply.id_token, now)
  if (token === undefined || !token.signatureOk || !token.issuerOk || !token.audienceOk || token.subject !== subject) return unlinked("google_account_mismatch")
  return { connected: true, reply, scopes, email: token.verifiedEmail } as const
}

effect function storeConnection(tx: Tx, landed: Landed, subject: string, redeemed: { readonly reply: typeof ServerCodeReply.Type; readonly scopes: ReadonlyArray<string>; readonly email: string | undefined }, now: number) {
  const held = (try tx.query("SELECT key, email, tokens FROM google_connections WHERE organization_id = $1 AND subject = $2 FOR UPDATE", [landed.organizationId, subject]))[0]
  const previous = toText(held?.tokens)
  const kept = previous === undefined ? "" : (try openTokens(previous)).refreshToken
  const issued = redeemed.reply.refresh_token ?? ""
  const tokens = try sealTokens({ refreshToken: issued === "" ? kept : issued, accessToken: redeemed.reply.access_token, expiresAt: now + redeemed.reply.expires_in * millisPerSecond })
  const connectionId = toText(held?.key) ?? newId()
  const email = redeemed.email ?? toText(held?.email) ?? landed.email ?? ""
  try stepRow(tx, connectionRows, connectionId, { type: "link", scopes: redeemed.scopes, tokens, expiresAt: now + redeemed.reply.expires_in * millisPerSecond }, connectionColumns({
    organization_id: landed.organizationId,
    user_id: landed.userId,
    subject,
    email,
    linked_at: now
  }))
  return { connectionId, email, scopes: redeemed.scopes, refreshTokenIssued: issued !== "" } satisfies Linked
}

effect function linkGoogle(landed: Landed, subject: string, serverAuthCode: string, now: number) {
  const google = (try Deployment).settings.google
  if (google === undefined) return unlinked("google_not_configured")
  const store = try Store
  const linked = effect {
    const redeemed = try redeemServerCode(google, serverAuthCode, subject, now)
    if (!redeemed.connected) return redeemed
    const stored = try store.transaction((tx: Tx) => storeConnection(tx, landed, subject, redeemed, now))
    return { connected: true, connectionId: stored.connectionId, email: stored.email === "" ? null : stored.email, scopes: stored.scopes, refreshTokenIssued: stored.refreshTokenIssued } satisfies GoogleLink
  }
  return linked catch effect (failure) => {
    try annotateLogs(logWarning("native google connection not linked"), { cause: failure._tag })
    return unlinked("google_unavailable")
  }
}

effect function mobileGoogle(context: RouteContext) {
  try perIp(context, tokenPerIp)
  const body = try jsonBody(context, SignInBody)
  const signed = try signIn(body, context.now)
  if (signed.kind === "mfa") return json(signed.answer, { headers: { "cache-control": "no-store" } })
  const { landed, verified, credential } = signed
  const google = body.serverAuthCode === undefined ? undefined : try linkGoogle(landed, verified.identity.subject, body.serverAuthCode, context.now)
  return json({
    status: "signed_in",
    ...credential,
    code: signed.code,
    accountCreated: landed.created,
    identity: { provider: "google", subject: verified.identity.subject, email: verified.verifiedEmail ?? null },
    ...(google === undefined ? {} : { google })
  }, { headers: { "cache-control": "no-store" } })
}

export const routes: ReadonlyArray<Route> = [
  { method: "POST", path: "/api/v1/app-auth/mobile/google", auth: "Public", maxBodyBytes: 16 * 1024, handler: mobileGoogle }
]
