// spec/cloud/index.md, "Story: Ask for a bounded decision about a browser page"
import { Schema } from "effect"
import { decisionCandidatesFit, decisionChoiceOffered, decisionProbabilityKeysFit, type DecisionCandidate, type DecisionChoiceValue } from "../gen/cloud.ts"

export const CLEF_DECISIONS_PATH = "/api/v1/decisions"
export const CLEF_DECISION_TIMEOUT_MS = 30_000
export const CLEF_DECISION_LIMITS = Object.freeze({
  goal: 2000, page: 16000, candidates: 16, candidateId: 64, candidateLabel: 300,
  action: 1000, context: 4000, transcript: 2000, recentTurns: 6,
})
export const CLEF_NO_CHOICE = "none"
export const CLEF_ASK_THRESHOLD = 0.3
export const CLEF_TURN_COMPLETE_THRESHOLD = 0.5

const limits = CLEF_DECISION_LIMITS
const text = (maximum: number) => Schema.String.check(Schema.isPattern(/\S/), Schema.isMaxLength(maximum))
const probability = Schema.Finite.check(Schema.isBetween({ minimum: 0, maximum: 1 }))
const Candidate = Schema.Struct({
  id: text(limits.candidateId).check(Schema.isPattern(/^[A-Za-z0-9_.-]+$/), Schema.makeFilter((id) => id !== CLEF_NO_CHOICE)),
  label: text(limits.candidateLabel),
})
const Turn = Schema.Struct({ speaker: Schema.Literals(["person", "assistant"]), text: text(limits.transcript) })
const Mode = Schema.Literals(["ask", "tell"])
const Request = Schema.Union([
  Schema.Struct({
    kind: Schema.Literal("choice"), goal: text(limits.goal), page: Schema.optionalKey(text(limits.page)),
    candidates: Schema.Array(Candidate).check(Schema.isMinLength(1), Schema.isMaxLength(limits.candidates),
      Schema.makeFilter((candidates) => decisionCandidatesFit(candidateFacts(candidates)))),
  }),
  Schema.Struct({ kind: Schema.Literal("mode"), action: text(limits.action), context: Schema.optionalKey(text(limits.context)) }),
  Schema.Struct({ kind: Schema.Literal("turn"), transcript: text(limits.transcript),
    recentTurns: Schema.optionalKey(Schema.Array(Turn).check(Schema.isMaxLength(limits.recentTurns))) }),
])
const success = { status: Schema.Literal("ok"), model: text(128) }
const Choice = Schema.Struct({
  ...success, kind: Schema.Literal("choice"), choice: Schema.NullOr(Candidate.fields.id),
  confidence: probability, probabilities: Schema.Record(Schema.String, probability),
})
const Result = Schema.Union([
  Choice,
  Schema.Struct({ ...success, kind: Schema.Literal("mode"), suggestedMode: Mode, askProbability: probability }),
  Schema.Struct({ ...success, kind: Schema.Literal("turn"), complete: Schema.Boolean, completeProbability: probability }),
])
const Unavailable = Schema.Struct({ status: Schema.Literal("unavailable"), reason: Schema.Literals(["disabled", "provider_error"]) })

export type ClefChoiceCandidate = typeof Candidate.Type
export type ClefTurn = typeof Turn.Type
export type ActionMode = typeof Mode.Type
export type ClefDecisionRequest = typeof Request.Type
export type ClefDecisionResult = typeof Result.Type
export type ClefDecisionResponse = ClefDecisionResult | typeof Unavailable.Type

function candidateFacts(candidates: readonly ClefChoiceCandidate[]): DecisionCandidate[] {
  return candidates.map(({ id, label }) => ({ id, idUnits: id.length, labelUnits: label.length }))
}

export const decodeClefRequest = Schema.decodeUnknownOption(Request, { onExcessProperty: "error" })
const decodeResult = Schema.decodeUnknownOption(Result, { onExcessProperty: "error" })
const decodeUnavailable = Schema.decodeUnknownOption(Unavailable)

export function clefDecisionRequestProblem(request: unknown): string | null {
  if (Option.isSome(decodeClefRequest(request))) return null
  return typeof request === "object" && request !== null && "kind" in request && typeof request.kind === "string" ? request.kind : "kind"
}

export function combineActionMode(floor: ActionMode, suggestion: ActionMode | null | undefined): ActionMode {
  return floor === "ask" || suggestion === "ask" ? "ask" : "tell"
}

const incomplete = /(?:^|\s)(?:and|or|but|so|um+|uh+|er+|like|because|the|a|an|to|of|my|your|for|with|then|point)$/i
export function turnLooksComplete(transcript: string): boolean {
  const raw = transcript.trim()
  if (!raw || /(?:\.\.\.|…|-|–|—|\$|\d,)$/u.test(raw)) return false
  const words = raw.replace(/[\s,;:.!?]+$/u, "")
  return words.length > 0 && !incomplete.test(words)
}

export function decodeClefResult(request: ClefDecisionRequest, raw: unknown): ClefDecisionResult | undefined {
  const decoded = decodeResult(raw)
  if (Option.isNone(decoded) || decoded.value.kind !== request.kind) return undefined
  if (request.kind === "choice" && decoded.value.kind === "choice") {
    const candidates = candidateFacts(request.candidates)
    const { choice, probabilities } = decoded.value
    const selected: DecisionChoiceValue = choice === null ? { tag: "DecisionNoMatch" } : { tag: "DecisionCandidateId", id: choice }
    if (!decisionChoiceOffered(candidates, selected) || !decisionProbabilityKeysFit(candidates, Object.keys(probabilities))) return undefined
  }
  return decoded.value
}

module node {
  import { CLEF_DECISIONS_PATH, CLEF_DECISION_TIMEOUT_MS, decodeClefResult, clefDecisionRequestProblem, clefUnavailability,
    type ClefDecisionRequest, type ClefDecisionResponse } from "./clef-decisions.vibe"

  export interface ClefDecisionsClientOptions {
    readonly baseUrl: string
    readonly headers: () => Record<string, string> | Promise<Record<string, string>>
    readonly fetch?: typeof fetch
    readonly timeoutMs?: number
    readonly onUnavailable?: (status: number | null) => void
  }

  export class ClefDecisionRefused extends Error {
    constructor(readonly status: 400 | 401 | 403 | 429) {
      super(`Clef decision request was refused (${status})`)
      this.name = "ClefDecisionRefused"
    }
  }

  function withAbort<A>(signal: AbortSignal, operation: () => Promise<A>): Promise<A> {
    return new Promise((resolve, reject) => {
      signal.throwIfAborted()
      const abort = () => reject(signal.reason)
      signal.addEventListener("abort", abort, { once: true })
      Promise.resolve().then(() => {
        signal.throwIfAborted()
        return operation()
      }).then(resolve, reject).finally(() => signal.removeEventListener("abort", abort))
    })
  }

  export function createClefDecisionsClient(options: ClefDecisionsClientOptions) {
    const duration = options.timeoutMs ?? CLEF_DECISION_TIMEOUT_MS
    if (!Number.isSafeInteger(duration) || duration < 1 || duration > 2147483647) throw new RangeError("Invalid Clef deadline")
    const url = new URL(CLEF_DECISIONS_PATH, options.baseUrl)
    const send = options.fetch ?? globalThis.fetch.bind(globalThis)
    const unavailable = (status: number | null, reason: "disabled" | "provider_error"): ClefDecisionResponse => {
      options.onUnavailable?.(status)
      return { status: "unavailable", reason }
    }
    return async (request: ClefDecisionRequest, signal?: AbortSignal): Promise<ClefDecisionResponse> => {
      signal?.throwIfAborted()
      const problem = clefDecisionRequestProblem(request)
      if (problem !== null) throw new TypeError("Invalid Clef decision request: " + problem)
      const timeout = AbortSignal.timeout(duration)
      const combined = signal ? AbortSignal.any([signal, timeout]) : timeout
      try {
        const reply = await withAbort(combined, async () => {
          const headers = new Headers(await options.headers())
          combined.throwIfAborted()
          headers.set("content-type", "application/json")
          return await send(url, { method: "POST", headers, body: JSON.stringify(request), signal: combined, redirect: "manual" })
        })
        if (reply.status === 400 || reply.status === 401 || reply.status === 403 || reply.status === 429) throw new ClefDecisionRefused(reply.status)
        const body = await withAbort<unknown>(combined, () => reply.json()).catch(() => {
          combined.throwIfAborted()
          return null
        })
        combined.throwIfAborted()
        if (reply.ok) {
          const decision = decodeClefResult(request, body)
          if (decision) return decision
        }
        return unavailable(reply.status, clefUnavailability(body))
      } catch (error) {
        signal?.throwIfAborted()
        if (error instanceof ClefDecisionRefused) throw error
        return unavailable(null, "provider_error")
      }
    }
  }
}

export function clefUnavailability(raw: unknown): "disabled" | "provider_error" {
  const decoded = decodeUnavailable(raw)
  return Option.isSome(decoded) ? decoded.value.reason : "provider_error"
}

export { createClefDecisionsClient, ClefDecisionRefused, type ClefDecisionsClientOptions } from node
