// spec/cloud/identity/sessions.md, "Story: Stay signed in"
module node {
  import { createHash, randomBytes, randomUUID, timingSafeEqual } from "node:crypto"

  /** @throws {never} */
  export function sha256Hex(text: string): string {
    return createHash("sha256").update(text, "utf8").digest("hex")
  }

  /** @throws {never} */
  export function randomText(bytes: number, encoding: "hex" | "base64url"): string {
    return randomBytes(bytes).toString(encoding)
  }

  /** @throws {never} */
  export function uuid(): string {
    return randomUUID()
  }

  /** @throws {never} */
  export function sameText(left: string, right: string): boolean {
    const a = Buffer.from(left, "utf8")
    const b = Buffer.from(right, "utf8")
    return a.length === b.length && timingSafeEqual(a, b)
  }
}
import { randomText, sameText, sha256Hex, uuid } from node

export { sameText, sha256Hex }

export function newId(): string {
  return uuid()
}

export function secretText(prefix: string, bytes: number, encoding: "hex" | "base64url"): string {
  return prefix + randomText(bytes, encoding)
}

export function tokenDigest(token: string): string {
  return sha256Hex(token)
}
