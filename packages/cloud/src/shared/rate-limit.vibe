// spec/cloud/shared/rateLimit.md, "Story: Refuse excess requests with a usable retry time"; spec/cloud/shared/rateLimit.md, "Story: Refuse rather than guess when the limiter cannot count"
import { type Rejected, admitsAll, apply, decodeState, groupRefusal, initial, perWindow, unavailableRefusal, type Check, type Event, type RateLimit, type Window } from "../../gen/cloud__shared__rateLimit.effect.vibe"
import { Refused } from "../http/refusal.vibe"
import { loadRow, machineRows, stepRow } from "../store/rows.vibe"
import { Store, type Tx } from "../store/connection.vibe"

export { perWindow, windowEndOf } from "../../gen/cloud__shared__rateLimit.effect.vibe"
export type { RateLimit }

const windows = machineRows<Window, Event, Rejected, unknown>("rate_windows", { initial, decodeState, apply })

export interface Limit {
  readonly subject: string
  readonly scope: string
  readonly limit: number
  readonly widthMs: number
}

export interface LimitCheck {
  readonly subject: string
  readonly rule: RateLimit
}

export const minute = 60_000

function windowKey(check: LimitCheck): string {
  return `${check.rule.name}|${check.subject}`
}

effect function lockWindow(tx: Tx, key: string) {
  try tx.query("SELECT pg_advisory_xact_lock(hashtextextended($1, 0))", [`rate-window:${key}`])
}

effect function countIn(tx: Tx, check: LimitCheck, now: number) {
  return (try stepRow(tx, windows, windowKey(check), { type: "request", rule: check.rule, now }, (window) => ({ window_end: window.end }))).state
}

export effect function readWindow(check: LimitCheck) {
  const store = try Store
  return (try store.transaction((tx) => loadRow(tx, windows, windowKey(check), false))).state
}

export effect function admitCheck(check: LimitCheck): void!Refused!Store {
  const now = try Clock.currentTimeMillis
  const store = try Store
  const window = store.transaction(effect (tx: Tx) => {
    try lockWindow(tx, windowKey(check))
    return try countIn(tx, check, now)
  }) catch effect (failure) => {
    try annotateLogs(logWarning("rate limiter could not count"), { limit: check.rule.name, cause: failure._tag })
    throw new Refused({ refusal: unavailableRefusal(now) })
  }
  if (window.last.tag !== "Admitted") throw new Refused({ refusal: groupRefusal([{ window, rule: check.rule }], now) })
}

export effect function admit(limit: Limit): void!Refused!Store {
  try admitCheck({ subject: limit.subject, rule: perWindow(limit.scope, limit.limit, limit.widthMs) })
}

export effect function admitAll(checks: ReadonlyArray<LimitCheck>): void!Refused!Store {
  const now = try Clock.currentTimeMillis
  const byKey = new Map<string, LimitCheck>()
  for (const check of checks) {
    const key = windowKey(check)
    const prior = byKey.get(key)
    if (prior !== undefined && (prior.rule.name !== check.rule.name || prior.rule.limit !== check.rule.limit || prior.rule.windowMs !== check.rule.windowMs)) {
      throw new Refused({ refusal: unavailableRefusal(now) })
    }
    byKey.set(key, check)
  }
  const store = try Store
  const refusal = store.transaction(effect (tx: Tx) => {
    for (const key of [...byKey.keys()].sort()) try lockWindow(tx, key)
    const group: Array<Check> = []
    for (const [key, check] of byKey) group.push({ window: (try loadRow(tx, windows, key)).state, rule: check.rule })
    if (!admitsAll(group, now)) return groupRefusal(group, now)
    for (const check of byKey.values()) try countIn(tx, check, now)
    return undefined
  }) catch effect (failure) => {
    try annotateLogs(logWarning("rate limiter could not count"), { limits: checks.map((check) => check.rule.name).join(","), cause: failure._tag })
    throw new Refused({ refusal: unavailableRefusal(now) })
  }
  if (refusal !== undefined) throw new Refused({ refusal })
}

export effect function sweepWindows(): void!!Store {
  const now = try Clock.currentTimeMillis
  const store = try Store
  store.transaction((tx) => tx.query("DELETE FROM rate_windows WHERE window_end < $1", [now - 60 * minute])) catch effect (failure) => {
    try annotateLogs(logWarning("rate window sweep failed"), { cause: failure._tag })
  }
}
