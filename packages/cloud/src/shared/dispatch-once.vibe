// spec/cloud/shared/dispatchOnce.md, "Story: Send a change once and recover its outcome without sending it again"
import { type NotAState, type Rejected, apply, initial, canReceiveReply, canResolve, conflictRefusal, connectorOf, decodeState, elapse, isConflict, isUnknown, mayFollowWith, receiptStatus, staleAt, type Event, type LookupResult, type ProviderReply as Reply, type Receipt, type ReceiptStatus, type RefusalCause } from "../../gen/cloud__shared__dispatchOnce.effect.vibe"
import type { ProviderKey, ProviderKind } from "../../gen/cloud__shared__types.ts"
import type { SessionOwner } from "../../gen/core__sessions.ts"
import { Refused, wireName } from "../http/refusal.vibe"
import { Store, type StoreFailure, type Tx } from "../store/connection.vibe"
import { loadRow, stepRow, type Columns, type MachineRows, type RowConflict, type RowCorrupt } from "../store/rows.vibe"
import { sha256Hex } from "./sealing.vibe"

export type { LookupResult, ProviderKey, Receipt, ReceiptStatus, SessionOwner }
export { mayFollowWith, staleAt }

export type ProviderReply<A> =
  | { readonly kind: "applied"; readonly value: A }
  | { readonly kind: "refused"; readonly code: string }
  | { readonly kind: "unknown"; readonly cause: string }

export function renderProviderKey(key: ProviderKey): string {
  return `${wireName(key.providerKind)}_${key.providerId}`
}

function canonical(value: unknown): string {
  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`
  if (value !== null && typeof value === "object") {
    const entries = Object.entries(value).filter(([, item]) => item !== undefined).sort(([left], [right]) => left < right ? -1 : left > right ? 1 : 0)
    return `{${entries.map(([name, item]) => `${JSON.stringify(name)}:${canonical(item)}`).join(",")}}`
  }
  return JSON.stringify(value) ?? "null"
}

export function requestDigest(value: unknown): string {
  return sha256Hex(canonical(value))
}

export interface DispatchSteps<A, E, R> {
  readonly claim: void!E!R
  readonly send: ProviderReply<A>!E!R
  readonly record: (reply: ProviderReply<A>, now: number) => void!E!R
}

export effect function dispatchOnce<A, E, R>(steps: DispatchSteps<A, E, R>): ProviderReply<A>!E!R {
  try steps.claim
  const reply = try steps.send
  try steps.record(reply, try Clock.currentTimeMillis)
  if (reply.kind === "unknown") try annotateLogs(logWarning("a provider change has an unknown outcome until it is looked up"), { cause: reply.cause })
  return reply
}

export interface ResolveSteps<A, E, R> {
  readonly lookup: ProviderReply<A>!E!R
  readonly record: (reply: ProviderReply<A>, now: number) => void!E!R
}

export effect function resolveUnknown<A, E, R>(steps: ResolveSteps<A, E, R>): ProviderReply<A>!E!R {
  const seen = try steps.lookup
  try steps.record(seen, try Clock.currentTimeMillis)
  return seen
}

export function receiptOwner(organizationId: string, userId: string, providerKind: ProviderKind): SessionOwner {
  return { agentId: organizationId, actorId: userId, connector: connectorOf(providerKind) }
}

function receiptAt(receipt: Receipt, now: number): Receipt {
  return now > receipt.session.now ? elapse(receipt, now - receipt.session.now) : receipt
}

export function receiptStatusAt(receipt: Receipt, now: number): ReceiptStatus {
  return receiptStatus(receiptAt(receipt, now))
}

function causeOf(code: string): RefusalCause {
  return code === "NotFoundAtProvider" || code === "AuthorizationLost" ? code : "OtherRefusal"
}

export function replyOf<A>(reply: ProviderReply<A>): Reply {
  switch (reply.kind) {
    case "applied": return { tag: "ShowsEffect" }
    case "refused": return { tag: "DefiniteRefusal", cause: causeOf(reply.code) }
    case "unknown": return { tag: "Unclear" }
    default: {
      const _exhaustive: never = reply
      return _exhaustive
    }
  }
}

export interface ReceiptRows<S, Corrupt> {
  readonly table: string
  readonly initial: S
  readonly decodeState: (input: unknown) => S!Corrupt
  readonly receiptOf: (state: S) => Receipt
  readonly withReceipt: (state: S, receipt: Receipt) => S
  readonly columns: (state: S, now: number) => Columns
}

type ReceiptFailure = StoreFailure | RowCorrupt | RowConflict | Rejected

export interface ReceiptSent {
  readonly event: Event
  readonly by: SessionOwner
  readonly now: number
}

export interface ReceiptTerms {
  readonly digest: string
  readonly providerKey: ProviderKey
  readonly staleAfter: number
  readonly expiresAt: number
}

interface Prepared<S> {
  readonly state: S
  readonly replayed: boolean
}

interface Dispatched<S, A> {
  readonly state: S
  readonly reply: ProviderReply<A>
}

export function receiptTable(table: string, columns: (receipt: Receipt, now: number) => Columns = () => ({})): ReceiptRows<Receipt, NotAState> {
  return { table, initial, decodeState, receiptOf: (receipt) => receipt, withReceipt: (_, receipt) => receipt, columns }
}

function receiptMachineRows<S, Corrupt>(rows: ReceiptRows<S, Corrupt>): MachineRows<S, ReceiptSent, S, Rejected, Corrupt> {
  return {
    table: rows.table,
    initial: rows.initial,
    decodeState: rows.decodeState,
    apply: effect (state: S, sent: ReceiptSent) => rows.withReceipt(state, try apply(receiptAt(rows.receiptOf(state), sent.now), sent.event, sent.by)),
    next: (state) => state
  }
}

export effect function loadReceipt<S, Corrupt>(tx: Tx, rows: ReceiptRows<S, Corrupt>, key: string, lock = true) {
  return try loadRow(tx, receiptMachineRows(rows), key, lock)
}

export effect function receiptStep<S, Corrupt>(tx: Tx, rows: ReceiptRows<S, Corrupt>, key: string, sent: ReceiptSent) {
  return (try stepRow(tx, receiptMachineRows(rows), key, sent, (state) => rows.columns(state, sent.now))).state
}

export effect function prepareReceipt<S, Corrupt>(tx: Tx, rows: ReceiptRows<S, Corrupt>, key: string, by: SessionOwner, terms: ReceiptTerms, now: number) {
  const loaded = try loadReceipt(tx, rows, key)
  const receipt = rows.receiptOf(loaded.state)
  if (receipt.session.phase !== "Absent") {
    if (isConflict(receipt, by, terms.digest)) throw new Refused({ refusal: conflictRefusal })
    return { state: loaded.state, replayed: true } satisfies Prepared<S>
  }
  const state = try receiptStep(tx, rows, key, { event: { type: "prepare", ...terms }, by, now })
  return { state, replayed: false } satisfies Prepared<S>
}

effect function claimReceipt<S, Corrupt>(tx: Tx, rows: ReceiptRows<S, Corrupt>, key: string, by: SessionOwner, now: number) {
  const claimed = try receiptStep(tx, rows, key, { event: { type: "claim" }, by, now })
  return try receiptStep(tx, rows, key, { event: { type: "send", claimToken: rows.receiptOf(claimed).session.currentClaim }, by, now })
}

effect function recordReply<S, Corrupt, A>(tx: Tx, rows: ReceiptRows<S, Corrupt>, key: string, by: SessionOwner, reply: ProviderReply<A>, now: number) {
  const loaded = try loadReceipt(tx, rows, key)
  const verdict = replyOf(reply)
  if (!canReceiveReply(receiptAt(rows.receiptOf(loaded.state), now), verdict)) return loaded.state
  return try receiptStep(tx, rows, key, { event: { type: "receiveReply", reply: verdict }, by, now })
}

effect function recordLookup<S, Corrupt>(tx: Tx, rows: ReceiptRows<S, Corrupt>, key: string, lookup: LookupResult, now: number) {
  const loaded = try loadReceipt(tx, rows, key)
  const receipt = rows.receiptOf(loaded.state)
  if (!canResolve(receiptAt(receipt, now), lookup)) return loaded.state
  return try receiptStep(tx, rows, key, { event: { type: "resolve", lookup }, by: receipt.session.owner, now })
}

export effect function bounded<A, E, R>(call: ProviderReply<A>!E!R, within: number): ProviderReply<A>!E!R {
  return try Effect.timeoutOrElse(call, {
    duration: Duration.millis(Math.max(1, within)),
    orElse: () => Effect.succeed<ProviderReply<A>>({ kind: "unknown", cause: "the provider did not answer before the stale time" })
  })
}

export effect function dispatchReceipt<S, Corrupt, A, E, R>(rows: ReceiptRows<S, Corrupt>, key: string, by: SessionOwner, send: (providerKey: string, deadline: number) => ProviderReply<A>!E!R) {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const claimed = try store.transaction((tx) => claimReceipt(tx, rows, key, by, now))
  const receipt = rows.receiptOf(claimed)
  const deadline = staleAt(receipt)
  let state = claimed
  const reply = try dispatchOnce<A, E | ReceiptFailure, R>({
    claim: Effect.void,
    send: bounded(send(renderProviderKey(receipt.providerKey), deadline), deadline - now),
    record: effect (seen: ProviderReply<A>, at: number) => {
      state = try store.transaction((tx) => recordReply(tx, rows, key, by, seen, at))
    }
  })
  return { state, reply } satisfies Dispatched<S, A>
}

export effect function resolveReceipt<S, Corrupt, E, R>(rows: ReceiptRows<S, Corrupt>, key: string, lookup: (providerKey: string, deadline: number) => ProviderReply<LookupResult>!E!R) {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const loaded = try store.transaction((tx) => loadReceipt(tx, rows, key, false))
  const receipt = receiptAt(rows.receiptOf(loaded.state), now)
  if (!isUnknown(receipt)) return loaded.state
  if (receipt.session.effects === 0) return try store.transaction((tx) => recordLookup(tx, rows, key, { tag: "NothingSeen" }, now))
  let state = loaded.state
  try resolveUnknown<LookupResult, E | ReceiptFailure, R>({
    lookup: bounded(lookup(renderProviderKey(receipt.providerKey), now + receipt.staleAfter), receipt.staleAfter),
    record: effect (seen: ProviderReply<LookupResult>, at: number) => {
      if (seen.kind === "applied") state = try store.transaction((tx) => recordLookup(tx, rows, key, seen.value, at))
    }
  })
  return state
}
