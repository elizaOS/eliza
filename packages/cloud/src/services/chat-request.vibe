// spec/cloud/index.md, "Story: Use inference on my subscription or funded pilot account"; spec/cloud/services/models.md, "A side has at most 2,000,000 tokens, so every side's price arithmetic stays a safe integer"
import { callCost, countsInBound, type Model, type TokenCounts } from "../../gen/cloud__services__models.effect.vibe"
import { refused, type Refused } from "../http/refusal.vibe"
import type { RouteContext } from "../http/routes.vibe"
import { acceptedFields, ChatRequest, type ChatMessage, type ResponseFormat } from "./chat-request.schema.ts"

export type { ChatMessage, ChatRequest, ResponseFormat }

export interface Quote {
  readonly counts: TokenCounts
  readonly micros: number
}

export const chatIngressPerMinute = 600
export const defaultOutputTokens = 500

function isRecord(value: unknown): value is Readonly<Record<string, unknown>> {
  return typeof value === "object" && value !== null && !Array.isArray(value)
}

export effect function parseChat(raw: unknown): ChatRequest!Refused {
  if (isRecord(raw) && Object.keys(raw).some((field) => !acceptedFields.includes(field))) throw refused("InvalidRequest", "UnsupportedField")
  const body = Schema.decodeUnknownEffect(ChatRequest, { onExcessProperty: "error" })(raw) catch effect () => { throw refused("InvalidRequest") }
  if (!formatServable(body.response_format)) throw refused("InvalidRequest")
  return body
}

export effect function chatBody(context: RouteContext): ChatRequest!Refused {
  if (!(context.request.headers["content-type"] ?? "").startsWith("application/json")) throw refused("InvalidRequest")
  const raw = context.request.json catch effect (failure) => {
    throw refused(failure.reason._tag === "RequestParseError" && failure.reason.reason === "BodyTooLarge" ? "ContentTooLarge" : "InvalidRequest")
  }
  return try parseChat(raw)
}

export function hasImage(body: ChatRequest): boolean {
  return body.messages.some((message) => typeof message.content !== "string" && message.content.some((part) => part.type === "image_url"))
}

function closedSchema(node: unknown): boolean {
  if (!isRecord(node)) return true
  const properties = isRecord(node.properties) ? node.properties : undefined
  if (node.type === "object" || properties !== undefined) {
    const required = Array.isArray(node.required) ? node.required : []
    if (node.additionalProperties !== false || !Object.keys(properties ?? {}).every((key) => required.includes(key))) return false
  }
  const nested = [
    ...Object.values(properties ?? {}),
    ...(isRecord(node.$defs) ? Object.values(node.$defs) : []),
    ...(isRecord(node.definitions) ? Object.values(node.definitions) : []),
    ...(Array.isArray(node.anyOf) ? node.anyOf : []),
    node.items
  ]
  return nested.every(closedSchema)
}

function formatServable(format: ResponseFormat | undefined): boolean {
  if (format?.type !== "json_schema" || format.json_schema.strict !== true) return true
  return format.json_schema.schema !== undefined && closedSchema(format.json_schema.schema)
}

function textChars(message: ChatMessage): number {
  if (typeof message.content === "string") return message.content.length
  return message.content.reduce((sum, part) => sum + (part.type === "text" ? part.text.length : 0), 0)
}

export function quoteCounts(body: ChatRequest): TokenCounts {
  const chars = body.messages.reduce((sum, message) => sum + textChars(message), 0)
  return { inputTokens: Math.floor(chars / 4), outputTokens: body.max_completion_tokens ?? body.max_tokens ?? defaultOutputTokens }
}

export effect function quote(body: ChatRequest, model: Model): Quote!Refused {
  const counts = quoteCounts(body)
  if (!countsInBound(counts)) throw refused("InvalidRequest")
  return { counts, micros: callCost(model, counts) }
}
