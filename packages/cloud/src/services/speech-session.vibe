// spec/cloud/services/speechRelay.md, "Story: Start speech only from a consent I gave"; spec/cloud/services/speechSession.md, "Story: Start speech only from a consent I gave"; spec/cloud/services/speechRelay.md, "Story: Keep a live session funded and close it with receipts"; spec/cloud/billing/plans.md, "Story: Share realtime speech fairly"; spec/cloud/index.md, "Story: Use a cloud speech session"; spec/cloud/index.md, "Consent and an allowance are required before speech is sent"
import { apply, canSettleWindow, consentLifetime, decodeState, firstSessionDeadline, initial, nextWindowDeadline, Rejected, retryWindowAdmitted, windowLength, windowTtsChars, windowRequestAdmitted, type Event, type Session, type NotAState } from "../../gen/cloud__services__speechRelay.effect.vibe"
import { realtimeSpeechAdmits, realtimeSpeechResetsAt, utcDayStart } from "../../gen/cloud__billing__plans.effect.vibe"
import { relayChannels, relaySampleRate } from "../../gen/cloud__services__speechRelay.effect.vibe"
import type { HoldKey, SpeechDirection } from "../../gen/cloud__shared__types.ts"
import { refused, Refused, wireName } from "../http/refusal.vibe"
import { signed, type Signed } from "../http/request-auth.vibe"
import { json, jsonBody, type Route, type RouteContext, type Sweep } from "../http/routes.vibe"
import type { RelaySession, SessionEnd, WindowAdmission, WindowUsage } from "./speech-relay.vibe"
import { Deployment } from "../profile/profile.vibe"
import { holdRows, markDispatched, reserveIn, settle, type HoldOwner, type MeteringFailure, type Settlement } from "../shared/metering.vibe"
import { newId, sameText, secretText, tokenDigest } from "../shared/sealing.vibe"
import { loadRow, machineRows, stepRow, type RowConflict, type RowCorrupt } from "../store/rows.vibe"
import { Store, type StoreFailure, toInt, toText, type Tx } from "../store/connection.vibe"
import { inspectKey } from "../native-clients/grants.vibe"

export type { Session, SessionEnd, WindowAdmission, WindowUsage }

export const sessionRows = machineRows<Session, Event, Rejected, NotAState>("speech_sessions", { initial, decodeState, apply })

export type SessionFailure = Refused | StoreFailure | RowCorrupt | RowConflict | Rejected | MeteringFailure

export type RetireCause = "Stopped" | "FundingRefused" | "ProviderFailed" | "Revoked" | "CredentialRevoked" | "AccountDeleting" | "DeadlinePassed"

export interface OpenedSession {
  readonly id: string
  readonly userId: string
  readonly organizationId: string
  readonly credentialExpiresAt: number
  readonly state: Session
}

type CredentialKind = "device_key" | "session"

interface Credential {
  readonly kind: CredentialKind
  readonly ref: string
  readonly expiresAt: number
}

interface WindowHolds {
  readonly transcribe: string
  readonly synthesize: string
}

interface WindowReservation extends WindowHolds {
  readonly funded: boolean
}

interface RecordedWindow extends WindowHolds {
  readonly settled: boolean
  readonly expiresAt: number
}

interface Rates {
  readonly microsPerSecond: number
  readonly microsPerCharacter: number
}

const speechPath = "/api/v1/voice/speech"
const directions: ReadonlyArray<SpeechDirection> = ["Transcribe", "Synthesize"]
const pcmBytesPerSecond = relaySampleRate * relayChannels * 2
const reaperEveryMs = 10_000
const orphanAfterMs = 30_000
const reaperBatch = 200

const endings = new Map<string, Deferred.Deferred<SessionEnd>>()

function credentialOf(caller: Signed): Credential {
  switch (caller.kind) {
    case "deviceKey": return { kind: "device_key", ref: caller.grantKey, expiresAt: caller.expiresAt }
    case "session": return { kind: "session", ref: caller.sessionKey, expiresAt: caller.accessExpiresAt }
    default: {
      const _exhaustive: never = caller
      return _exhaustive
    }
  }
}

function endOf(cause: RetireCause): SessionEnd | undefined {
  switch (cause) {
    case "Revoked":
    case "AccountDeleting":
    case "DeadlinePassed":
      return "SessionOver"
    case "CredentialRevoked":
      return "CredentialRefused"
    case "Stopped":
    case "FundingRefused":
    case "ProviderFailed":
      return undefined
    default: {
      const _exhaustive: never = cause
      return _exhaustive
    }
  }
}

function iso(millis: number): string {
  return new Date(millis).toISOString()
}

function holdKey(userId: string, sessionId: string, direction: SpeechDirection, window: number): HoldKey {
  return { service: "MeteredSpeech", caller: userId, requestId: sessionId, part: { tag: "SpeechWindow", direction, window } }
}

function quoteOf(direction: SpeechDirection, rates: Rates): number {
  return direction === "Transcribe"
    ? Math.max(1, Math.ceil(windowLength / 1000) * rates.microsPerSecond)
    : Math.max(1, windowTtsChars * rates.microsPerCharacter)
}

function holdOf(holds: WindowHolds, direction: SpeechDirection): string {
  return direction === "Transcribe" ? holds.transcribe : holds.synthesize
}

function settlementFor(direction: SpeechDirection, dispatched: boolean, usage: WindowUsage, rates: Rates): Settlement {
  if (!dispatched) return { kind: "release" }
  if (direction === "Transcribe") {
    return usage.sttFinal ? { kind: "known", actual: Math.ceil(usage.pcmBytes * rates.microsPerSecond / pcmBytesPerSecond) } : { kind: "unknown" }
  }
  return usage.ttsFinal ? { kind: "known", actual: usage.ttsChars * rates.microsPerCharacter } : { kind: "unknown" }
}

export function sessionColumns(now: number) {
  return (session: Session) => ({ phase: wireName(session.phase), expires_at: session.expiresAt, updated_at: now })
}

function tokenMatches(opened: OpenedSession, token: string): boolean {
  return sameText(tokenDigest(token), opened.state.tokenDigest)
}

effect function signer(context: RouteContext): Signed!Refused {
  const caller = signed(context.caller)
  if (caller === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return caller
}

effect function speechRates(): Rates!Refused!Deployment {
  const speech = (try Deployment).settings.speech
  if (speech === undefined) throw refused("CapabilityUnavailable")
  return { microsPerSecond: speech.stt.microsPerSecond, microsPerCharacter: speech.tts.microsPerCharacter }
}

effect function socketUrl(sessionId: string): string!!Deployment {
  const url = new URL(`${speechPath}/ws`, (try Deployment).settings.api)
  url.protocol = url.protocol === "http:" ? "ws:" : "wss:"
  url.searchParams.set("sessionId", sessionId)
  return url.href
}

effect function usedToday(tx: Tx, userId: string, day: number, lock: boolean): number!StoreFailure {
  const row = (try tx.query(`SELECT used_ms FROM speech_usage_days WHERE user_id = $1 AND usage_day = $2${lock ? " FOR UPDATE" : ""}`, [userId, day]))[0]
  return row === undefined ? 0 : toInt(row.used_ms)
}

effect function readSession(tx: Tx, id: string, lock: boolean): OpenedSession!(Refused | StoreFailure | RowCorrupt) {
  const row = (try tx.query(`SELECT user_id, organization_id, credential_expires_at FROM speech_sessions WHERE key = $1${lock ? " FOR UPDATE" : ""}`, [id]))[0]
  if (row === undefined) throw refused("NotFound")
  const loaded = try loadRow(tx, sessionRows, id, lock)
  return {
    id,
    userId: toText(row.user_id) ?? "",
    organizationId: toText(row.organization_id) ?? "",
    credentialExpiresAt: toInt(row.credential_expires_at),
    state: loaded.state
  }
}

effect function stepSession(tx: Tx, id: string, event: Event, now: number): Session!(StoreFailure | RowCorrupt | RowConflict | Rejected) {
  return (try stepRow(tx, sessionRows, id, event, sessionColumns(now))).state
}

effect function closeIfSettled(tx: Tx, id: string, now: number): Session!(StoreFailure | RowCorrupt | RowConflict) {
  return stepSession(tx, id, { type: "close" }, now) catch effect (failure) => match (failure) {
    when Rejected: (try loadRow(tx, sessionRows, id)).state;
    default: throw failure;
  }
}

effect function windowHolds(tx: Tx, id: string, window: number): (RecordedWindow | undefined)!StoreFailure {
  const row = (try tx.query("SELECT transcribe_hold, synthesize_hold, settled_at, expires_at FROM speech_windows WHERE session_id = $1 AND number = $2", [id, window]))[0]
  if (row === undefined) return undefined
  return {
    transcribe: toText(row.transcribe_hold) ?? "",
    synthesize: toText(row.synthesize_hold) ?? "",
    settled: row.settled_at !== null && row.settled_at !== undefined,
    expiresAt: toInt(row.expires_at)
  }
}

effect function announceEnd(id: string, end: SessionEnd): void!! {
  const waiting = endings.get(id)
  if (waiting !== undefined) try Deferred.succeed(waiting, end)
}

export effect function sessionEnding(id: string): SessionEnd!! {
  const known = endings.get(id)
  const waiting = known ?? try Deferred.make<SessionEnd>()
  if (known === undefined) endings.set(id, waiting)
  return try ensuring(Deferred.await(waiting), sync(() => {
    if (endings.get(id) === waiting) endings.delete(id)
  }))
}

export effect function openSocket(id: string): OpenedSession!SessionFailure!Store {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const found = try readSession(tx, id, true)
    const now = try Clock.currentTimeMillis
    const state = stepSession(tx, id, { type: "openSocket", now }, now) catch effect (failure) => match (failure) {
      when Rejected: throw refused("SessionClosed");
      default: throw failure;
    }
    return { ...found, state }
  })
}

effect function reserveWindow(tx: Tx, owner: HoldOwner, id: string, window: number, rates: Rates, now: number): WindowReservation!MeteringFailure {
  const transcribe = try reserveIn(tx, owner, holdKey(owner.organizationId, id, "Transcribe", window), quoteOf("Transcribe", rates), now)
  const synthesize = try reserveIn(tx, owner, holdKey(owner.organizationId, id, "Synthesize", window), quoteOf("Synthesize", rates), now)
  return { transcribe: transcribe.key, synthesize: synthesize.key, funded: transcribe.hold.phase === "Reserved" && synthesize.hold.phase === "Reserved" }
}

export effect function admitWindow(id: string, window: number): WindowAdmission!SessionFailure!(Store | Deployment) {
  const store = try Store
  const rates = try speechRates()
  return store.transaction(effect (tx: Tx) => {
    const organization = try tx.query("SELECT o.id FROM organizations o JOIN speech_sessions s ON s.organization_id = o.id WHERE s.key = $1 FOR UPDATE OF o", [id])
    if (organization.length !== 1) throw refused("NotFound")
    const current = try readSession(tx, id, true)
    const now = try Clock.currentTimeMillis
    const day = utcDayStart(now)
    const known = try windowHolds(tx, id, window)
    if (known !== undefined) {
      if (!retryWindowAdmitted(current.state, window, known.settled, now)) throw refused("SessionClosed")
      return { kind: "admitted", expiresAt: known.expiresAt } satisfies WindowAdmission
    }
    const expiresAt = nextWindowDeadline(current.state, window)
    if (!windowRequestAdmitted(current.state, window, expiresAt, now)) throw refused("SessionClosed")
    const allowanceAvailable = realtimeSpeechAdmits(try usedToday(tx, current.userId, day, false), windowLength)
    if (!allowanceAvailable) return { kind: "short", shortfall: "AllowanceShort" } satisfies WindowAdmission
    const holds = try reserveWindow(tx, { organizationId: current.organizationId, userId: current.userId }, id, window, rates, now)
    if (!holds.funded) throw refused("ServiceUnavailable", "NoReason", now + 5000)
    try stepSession(tx, id, { type: "admitWindow", window, expiresAt, now, funded: holds.funded, allowanceAvailable }, now)
    try tx.query(
      "INSERT INTO speech_windows (session_id, number, user_id, usage_day, speech_ms, transcribe_hold, synthesize_hold, expires_at, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)",
      [id, window, current.userId, day, windowLength, holds.transcribe, holds.synthesize, expiresAt, now]
    )
    try tx.query(
      "INSERT INTO speech_usage_days (user_id, usage_day, used_ms, updated_at) VALUES ($1, $2, $3, $4) ON CONFLICT (user_id, usage_day) DO UPDATE SET used_ms = speech_usage_days.used_ms + EXCLUDED.used_ms, updated_at = EXCLUDED.updated_at",
      [current.userId, day, windowLength, now]
    )
    return { kind: "admitted", expiresAt } satisfies WindowAdmission
  }) catch effect (failure) => {
    if (failure instanceof Rejected) throw refused("SessionClosed")
    if (failure instanceof Refused && failure.refusal.code === "InsufficientCredits") return { kind: "short", shortfall: "CreditsShort" } satisfies WindowAdmission
    throw failure
  }
}

effect function dispatchWindow(id: string, window: number, only?: SpeechDirection): void!SessionFailure!Store {
  const store = try Store
  const holds = try store.transaction((tx) => windowHolds(tx, id, window))
  if (holds === undefined || holds.settled) throw refused("SessionClosed")
  for (const direction of only === undefined ? directions : [only]) {
    const key = holdOf(holds, direction)
    const hold = (try store.transaction((tx) => loadRow(tx, holdRows, key, false))).state
    if (hold.phase === "Reserved") try markDispatched(key)
  }
}

export effect function settleWindow(id: string, window: number, usage: WindowUsage): Session!SessionFailure!(Store | Deployment) {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const rates = try speechRates()
  const holds = try store.transaction((tx) => windowHolds(tx, id, window))
  if (holds === undefined) throw refused("NotFound")
  if (!holds.settled) {
    const current = try store.transaction((tx) => readSession(tx, id, false))
    if (!canSettleWindow(current.state, window)) throw refused("SessionClosed")
    for (const direction of directions) {
      const key = holdOf(holds, direction)
      const hold = (try store.transaction((tx) => loadRow(tx, holdRows, key, false))).state
      try settle(key, settlementFor(direction, hold.phase === "Dispatched", usage, rates))
    }
  }
  return try store.transaction(effect (tx: Tx) => {
    try readSession(tx, id, true)
    const marked = try tx.query("UPDATE speech_windows SET settled_at = $3 WHERE session_id = $1 AND number = $2 AND settled_at IS NULL RETURNING number", [id, window, now])
    if (marked.length === 1) try stepSession(tx, id, { type: "settleWindow", window }, now)
    return try closeIfSettled(tx, id, now)
  })
}

export effect function retire(id: string, cause: RetireCause): Session!SessionFailure!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const state = try store.transaction(effect (tx: Tx) => {
    try readSession(tx, id, true)
    stepSession(tx, id, { type: "retire" }, now) catch effect (failure) => match (failure) {
      when Rejected: undefined;
      default: throw failure;
    }
    return try closeIfSettled(tx, id, now)
  })
  const end = endOf(cause)
  if (end !== undefined) try announceEnd(id, end)
  return state
}

effect function settleOrphans(id: string): void!SessionFailure!(Store | Deployment) {
  const store = try Store
  const open = try store.transaction((tx) => tx.query("SELECT number FROM speech_windows WHERE session_id = $1 AND settled_at IS NULL ORDER BY number", [id]))
  for (const row of open) {
    try settleWindow(id, toInt(row.number), { pcmBytes: 0, ttsChars: 0, sttFinal: false, ttsFinal: false, dispatched: true })
  }
  try retire(id, "DeadlinePassed")
}

type Reap =
  | { readonly kind: "nothing" }
  | { readonly kind: "retire"; readonly cause: RetireCause }
  | { readonly kind: "settleOrphans" }

function reapOf(row: Readonly<Record<string, unknown>>, now: number): Reap {
  const phase = toText(row.phase)
  if (phase === "retiring") return toInt(row.updated_at) <= now - orphanAfterMs ? { kind: "settleOrphans" } : { kind: "nothing" }
  if (row.account_status !== "active") return { kind: "retire", cause: "AccountDeleting" }
  if (row.credential_live !== true) return { kind: "retire", cause: "CredentialRevoked" }
  if (toInt(row.expires_at) <= now) return { kind: "retire", cause: "DeadlinePassed" }
  return { kind: "nothing" }
}

effect function reapOne(id: string, reap: Reap): boolean!SessionFailure!(Store | Deployment) {
  switch (reap.kind) {
    case "nothing": return false
    case "retire": {
      try retire(id, reap.cause)
      return true
    }
    case "settleOrphans": {
      try settleOrphans(id)
      return true
    }
    default: {
      const _exhaustive: never = reap
      return _exhaustive
    }
  }
}

export effect function reapSessions(): number!!(Store | Deployment) {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const rows = store.transaction((tx) => tx.query(
    `SELECT s.key, s.phase, s.expires_at, s.updated_at, s.credential_kind, a.status AS account_status, a.device_epoch AS account_epoch,
      g.state AS device_state, g.phase AS device_phase, g.key_expires_at, g.device_epoch AS grant_epoch,
      EXISTS (SELECT 1 FROM sessions c WHERE c.key = s.credential_ref AND c.live AND (c.state->>'epoch')::bigint = a.sessions_revoked_before) AS session_live
    FROM speech_sessions s LEFT JOIN accounts a ON a.key = s.user_id
    LEFT JOIN device_grants g ON s.credential_kind = 'device_key' AND g.key = s.credential_ref AND g.user_id = s.user_id
    WHERE s.phase IN ('minted', 'starting', 'active', 'retiring')
    ORDER BY s.expires_at LIMIT $1`,
    [reaperBatch]
  )) catch effect (failure) => {
    try annotateLogs(logError("the speech reaper could not read sessions"), { failure: failure._tag })
    return []
  }
  let reaped = 0
  for (const row of rows) {
    const id = toText(row.key) ?? ""
    const key = row.credential_kind === "device_key" ? (inspectKey({ ...row, state: row.device_state, phase: row.device_phase }, now) catch () => undefined) : undefined
    const credentialLive = row.credential_kind === "device_key" ? key?.reason === "NoReason" : row.session_live === true
    const done = reapOne(id, reapOf({ ...row, credential_live: credentialLive }, now)) catch effect (failure) => {
      try annotateLogs(logError("the speech reaper could not end a session"), { sessionId: id, failure: failure._tag })
      return false
    }
    if (done) reaped += 1
  }
  store.transaction((tx) => tx.query("DELETE FROM speech_consents WHERE consumed_at IS NULL AND expires_at < $1", [now])) catch effect (failure) => {
    try annotateLogs(logError("the speech reaper could not remove expired consents"), { failure: failure._tag })
  }
  return reaped
}

export const speechReaper: Sweep = { name: "speech reaper", everyMs: reaperEveryMs, run: reapSessions() }

schema MintRequest { consentNonce: string }

type BootstrapRoute = "speech-consent" | "speech-session"
type BootstrapPhase = "speech_identity_rate" | "speech_consent_write" | "speech_consent_consume"
interface PhaseSpan { readonly phase: BootstrapPhase; readonly ms: number; readonly outcome: "returned" | "threw" }
interface Bootstrap { readonly context: RouteContext; readonly route: BootstrapRoute; readonly spans: Array<PhaseSpan> }

effect function notePhase(bootstrap: Bootstrap, span: PhaseSpan): void!!Deployment {
  bootstrap.spans.push(span)
  if ((try Deployment).environment !== "production") return
  try annotateLogs(logInfo("cloud speech phase timing"), {
    schema: "cloud_speech_phase_v1", requestId: bootstrap.context.requestId, route: bootstrap.route, phase: span.phase, durationMs: span.ms, outcome: span.outcome
  })
}

effect function bootstrapOf(context: RouteContext, route: BootstrapRoute): Bootstrap!!Deployment {
  const bootstrap: Bootstrap = { context, route, spans: [] }
  const entered = try Clock.currentTimeMillis
  try notePhase(bootstrap, { phase: "speech_identity_rate", ms: Math.max(0, entered - context.now), outcome: "returned" })
  return bootstrap
}

effect function timedPhase<A, E, R>(bootstrap: Bootstrap, phase: BootstrapPhase, work: A!E!R): A!E!(R | Deployment) {
  const started = try Clock.currentTimeMillis
  return try onExit(work, effect (ended) => {
    const now = try Clock.currentTimeMillis
    try notePhase(bootstrap, { phase, ms: Math.max(0, now - started), outcome: Exit.isSuccess(ended) ? "returned" : "threw" })
  })
}

effect function phaseTimings(bootstrap: Bootstrap): Readonly<Record<string, string>>!!Deployment {
  if ((try Deployment).environment !== "staging") return {}
  return { "server-timing": bootstrap.spans.map((span) => `${span.phase};dur=${span.ms}`).join(", ") }
}

effect function consent(context: RouteContext) {
  const bootstrap = try bootstrapOf(context, "speech-consent")
  const caller = try signer(context)
  const credential = credentialOf(caller)
  const nonce = newId()
  const expiresAt = Math.min(context.now + consentLifetime, credential.expiresAt)
  const store = try Store
  try timedPhase(bootstrap, "speech_consent_write", store.transaction((tx) => tx.query(
    "INSERT INTO speech_consents (nonce, user_id, organization_id, credential_kind, credential_ref, expires_at, created_at) VALUES ($1, $2, $3, $4, $5, $6, $7)",
    [nonce, caller.userId, caller.organizationId, credential.kind, credential.ref, expiresAt, context.now]
  )))
  return json({ consentNonce: nonce, expiresAt: iso(expiresAt) }, { headers: try phaseTimings(bootstrap) })
}

effect function mint(context: RouteContext) {
  const bootstrap = try bootstrapOf(context, "speech-session")
  const caller = try signer(context)
  const credential = credentialOf(caller)
  const { consentNonce } = try jsonBody(context, MintRequest)
  const store = try Store
  const sessionId = newId()
  const token = secretText("eliza_speech_", 32, "base64url")
  const minted = try timedPhase(bootstrap, "speech_consent_consume", store.transaction(effect (tx: Tx) => {
    try tx.query("SELECT nonce FROM speech_consents WHERE nonce = $1 FOR UPDATE", [consentNonce])
    const now = try Clock.currentTimeMillis
    const consumed = try tx.query(
      "UPDATE speech_consents SET consumed_at = $1 WHERE nonce = $2 AND user_id = $3 AND credential_kind = $4 AND credential_ref = $5 AND consumed_at IS NULL AND expires_at > $1 RETURNING nonce",
      [now, consentNonce, caller.userId, credential.kind, credential.ref]
    )
    if (consumed.length !== 1) throw refused("SpeechConsentRequired")
    if (!realtimeSpeechAdmits(try usedToday(tx, caller.userId, utcDayStart(now), false), windowLength)) {
      throw refused("AllowanceExhausted", "NoReason", realtimeSpeechResetsAt(now))
    }
    const expiresAt = firstSessionDeadline(now, credential.expiresAt)
    return try stepRow(tx, sessionRows, sessionId, { type: "mint", tokenDigest: tokenDigest(token), expiresAt, credentialExpiresAt: credential.expiresAt, now, consentConsumed: consumed.length === 1 }, (session) => ({
      ...sessionColumns(now)(session),
      consent_nonce: consentNonce,
      user_id: caller.userId,
      organization_id: caller.organizationId,
      credential_kind: credential.kind,
      credential_ref: credential.ref,
      credential_expires_at: credential.expiresAt,
      created_at: now
    }))
  }))
  return json(
    { version: 1, sessionId, token, expiresAt: iso(minted.state.expiresAt), wsUrl: try socketUrl(sessionId) },
    { headers: { "x-eliza-speech-extend": "1", ...(try phaseTimings(bootstrap)) } }
  )
}

effect function revoke(context: RouteContext) {
  const caller = try signer(context)
  const sessionId = context.params.sessionId ?? ""
  const store = try Store
  const row = (try store.transaction((tx) => tx.query("SELECT user_id FROM speech_sessions WHERE key = $1", [sessionId])))[0]
  if (row === undefined || toText(row.user_id) !== caller.userId) throw refused("NotFound")
  try retire(sessionId, "Revoked")
  return json({ revoked: true })
}

export const sessionSpeechRoutes: ReadonlyArray<Route> = [
  { method: "POST", path: `${speechPath}/consent`, auth: "ServiceAccess", capability: "speech", rateClass: "StandardRequests", handler: consent },
  { method: "POST", path: `${speechPath}/session`, auth: "ServiceAccess", capability: "speech", rateClass: "StandardRequests", handler: mint },
  { method: "POST", path: `${speechPath}/session/:sessionId/revoke`, auth: "ServiceAccess", capability: "speech", rateClass: "StandardRequests", handler: revoke }
]

effect function refusedOnly<A, R>(work: A!SessionFailure!R): A!Refused!R {
  const now = try Clock.currentTimeMillis
  const value = work catch effect (failure) => {
    if (failure instanceof Refused) throw failure
    try annotateLogs(logError("a speech session step failed"), { failure: failure._tag })
    throw refused("ServiceUnavailable", "NoReason", now + 5000)
  }
  return value
}

effect function sessionTokenMatches(id: string, token: string): boolean!SessionFailure!Store {
  const store = try Store
  const found = try store.transaction((tx) => readSession(tx, id, false))
  return tokenMatches(found, token)
}

export const relaySession: RelaySession = {
  openSocket: (id) => Effect.asVoid(refusedOnly(openSocket(id))),
  tokenMatches: sessionTokenMatches,
  admitWindow,
  dispatchWindow: (id, window) => dispatchWindow(id, window),
  settleWindow: (id, window, usage) => Effect.asVoid(settleWindow(id, window, usage)),
  retire: (id) => Effect.asVoid(retire(id, "Stopped")),
  ended: sessionEnding
}
