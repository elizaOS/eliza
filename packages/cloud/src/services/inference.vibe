// spec/cloud/services/inference.md, "Story: Answer a chat completion once and charge it once"; spec/cloud/services/inference.md, "Story: Stream a reply in the shape clients read"
import type { HoldKey } from "../../gen/cloud__shared__types.ts"
import { refusalBody, refused, type Refused } from "../http/refusal.vibe"
import type { Caller } from "../http/request-auth.vibe"
import { json, owner, type Route, type RouteContext } from "../http/routes.vibe"
import { Deployment } from "../profile/profile.vibe"
import { complete, stream, ProviderInvalidResponse, type ChatBody, type LlmFailure, type LlmProvider } from "../providers/llm.vibe"
import { markDispatched, reserve, settle, type HoldTicket, type Settlement } from "../shared/metering.vibe"
import { newId } from "../shared/sealing.vibe"
import { Store } from "../store/connection.vibe"
import { chatBody, chatIngressPerMinute, hasImage, quote, type Quote } from "./chat-request.vibe"
import { billedFromUsage, callCostFor, chooseFor, type Model } from "./models.vibe"

module node {
  import { chunkFrame, doneFrame, errorFrame, feed, finish, isDone, segmenter, utf8Text, type Segmenter } from "./sse.ts"

  export interface Relay {
    readonly segmenter: Segmenter
    readonly usage: unknown
    readonly deliveredChars: number
    readonly done: boolean
    readonly invalid: boolean
  }

  export interface Relayed {
    readonly relay: Relay
    readonly bytes: Uint8Array
  }

  const encoder = new TextEncoder()

  function objectOf(text: string): Readonly<Record<string, unknown>> | undefined {
    try {
      const value: unknown = JSON.parse(text)
      return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Readonly<Record<string, unknown>> : undefined
    } catch {
      return undefined
    }
  }

  function contentChars(choices: ReadonlyArray<unknown>): number {
    return choices.reduce<number>((sum, choice) => {
      const delta = typeof choice === "object" && choice !== null ? (choice as { readonly delta?: { readonly content?: unknown } }).delta : undefined
      return sum + (typeof delta?.content === "string" ? delta.content.length : 0)
    }, 0)
  }

  function relayEvents(start: Relay, events: ReadonlyArray<number[]>, modelId: string): { readonly relay: Relay; readonly frames: string } {
    let relay = start
    let frames = ""
    for (const event of events) {
      if (relay.done || relay.invalid) continue
      if (isDone(event)) {
        relay = { ...relay, done: true }
        continue
      }
      const chunk = objectOf(utf8Text(event).map((point) => String.fromCodePoint(point)).join(""))
      if (chunk === undefined) {
        relay = { ...relay, invalid: true }
        continue
      }
      const choices: ReadonlyArray<unknown> = Array.isArray(chunk.choices) ? chunk.choices : []
      const reportsUsage = chunk.usage !== undefined && chunk.usage !== null
      if (reportsUsage && relay.usage !== undefined && choices.length === 0) continue
      relay = { ...relay, deliveredChars: relay.deliveredChars + contentChars(choices), usage: reportsUsage && relay.usage === undefined ? chunk.usage : relay.usage }
      frames += chunkFrame(JSON.stringify({ ...chunk, model: modelId }))
    }
    return { relay, frames }
  }

  /** @throws {never} */
  export function openRelay(): Relay {
    return { segmenter: segmenter(), usage: undefined, deliveredChars: 0, done: false, invalid: false }
  }

  /** @throws {never} */
  export function relayChunk(relay: Relay, chunk: Uint8Array, modelId: string): Relayed {
    const fed = feed(relay.segmenter, Array.from(chunk))
    const next = relayEvents({ ...relay, segmenter: fed.segmenter }, fed.events, modelId)
    return { relay: next.relay, bytes: encoder.encode(next.frames) }
  }

  /** @throws {never} */
  export function closeRelay(relay: Relay, modelId: string): Relayed {
    const fed = finish(relay.segmenter)
    const next = relayEvents({ ...relay, segmenter: fed.segmenter }, fed.events, modelId)
    return { relay: next.relay, bytes: encoder.encode(next.relay.invalid ? next.frames : next.frames + doneFrame) }
  }

  /** @throws {never} */
  export function failureFrames(refusalJson: string): Uint8Array {
    return encoder.encode(errorFrame(refusalJson) + doneFrame)
  }
}
import { closeRelay, failureFrames, openRelay, relayChunk, type Relay } from node

export const chatMaxBodyBytes = 8 * 1024 * 1024
export const providerRetryMs = 5000

export type Ending =
  | { readonly kind: "answered"; readonly usage: unknown }
  | { readonly kind: "unserved" }
  | { readonly kind: "lost" }
  | { readonly kind: "abandoned"; readonly usage: unknown; readonly deliveredChars: number }

export effect function settlementFor(model: Model, priced: Quote, ending: Ending): Settlement!! {
  switch (ending.kind) {
    case "answered": {
      const billed = try billedFromUsage(ending.usage)
      if (billed.tag === "Unreadable") return { kind: "known", actual: priced.micros }
      return { kind: "known", actual: try callCostFor(model, billed.counts) }
    }
    case "unserved": return { kind: "known", actual: 0 }
    case "lost": return { kind: "unknown" }
    case "abandoned": {
      const billed = try billedFromUsage(ending.usage)
      const reportedInput = billed.tag === "Reported" ? billed.counts.inputTokens : 0
      return { kind: "known", actual: try callCostFor(model, { inputTokens: Math.max(priced.counts.inputTokens, reportedInput), outputTokens: Math.floor(ending.deliveredChars / 4) }) }
    }
    default: {
      const _exhaustive: never = ending
      return _exhaustive
    }
  }
}

function endingOf(failure: LlmFailure): Ending {
  switch (failure._tag) {
    case "ProviderRefused": return { kind: "unserved" }
    case "ProviderUnreachable": return { kind: "unserved" }
    case "ProviderTimedOut": return { kind: "lost" }
    case "ProviderInvalidResponse": return { kind: "lost" }
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

function refusalOf(failure: LlmFailure, now: number): Refused {
  switch (failure._tag) {
    case "ProviderRefused": return refused("ProviderUnavailable", "NoReason", now + (failure.retryAfter ?? providerRetryMs))
    case "ProviderUnreachable": return refused("ProviderUnavailable", "NoReason", now + providerRetryMs)
    case "ProviderTimedOut": return refused("ProviderUnavailable", "NoReason", now + providerRetryMs)
    case "ProviderInvalidResponse": return refused("ProviderInvalidResponse")
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

function credentialOf(caller: Caller): string | undefined {
  switch (caller.kind) {
    case "deviceKey": return caller.credentialId
    case "session": return caller.sessionKey
    case "anonymous": return undefined
    default: {
      const _exhaustive: never = caller
      return _exhaustive
    }
  }
}

effect function settleOnce(key: string, model: Model, priced: Quote, ending: Ending): void!!Store {
  const settlement = try settlementFor(model, priced, ending)
  settle(key, settlement) catch effect (failure) => {
    try annotateLogs(logError("a chat completion could not be settled; the hold sweep settles it"), { holdKey: key, settlement: settlement.kind, failure: failure._tag })
  }
}

effect function releaseUnsent(key: string): void!!Store {
  settle(key, { kind: "release" }) catch effect (failure) => {
    try annotateLogs(logError("an undispatched chat hold could not be released; the hold sweep releases it"), { holdKey: key, failure: failure._tag })
  }
}

interface Progress {
  dispatched: boolean
  ending: Ending | undefined
  handedOff: boolean
}

effect function relayed(ticket: HoldTicket, model: Model, priced: Quote, bytes: Stream.Stream<Uint8Array, LlmFailure>): Stream.Stream<Uint8Array, never, Store>!! {
  const now = try Clock.currentTimeMillis
  const seen: { relay: Relay; failed: boolean } = { relay: openRelay(), failed: false }
  const framed = Stream.mapEffect(bytes, (chunk: Uint8Array) => effect {
    if (seen.relay.invalid) throw new ProviderInvalidResponse()
    const next = relayChunk(seen.relay, chunk, model.id)
    seen.relay = next.relay
    return next.bytes
  })
  const tail = Stream.fromEffect(effect {
    if (seen.relay.invalid) throw new ProviderInvalidResponse()
    const next = closeRelay(seen.relay, model.id)
    seen.relay = next.relay
    if (next.relay.invalid) throw new ProviderInvalidResponse()
    return next.bytes
  })
  const answered = Stream.catch(Stream.concat(framed, tail), (failure: LlmFailure) => {
    seen.failed = true
    return Stream.make(failureFrames(JSON.stringify(refusalBody(refusalOf(failure, now).refusal))))
  })
  return Stream.onExit(answered, (exit) => settleOnce(ticket.key, model, priced, Exit.isSuccess(exit)
    ? (seen.failed ? { kind: "lost" } : { kind: "answered", usage: seen.relay.usage })
    : { kind: "abandoned", usage: seen.relay.usage, deliveredChars: seen.relay.deliveredChars }))
}

effect function serve(ticket: HoldTicket, progress: Progress, model: Model, priced: Quote, upstream: ChatBody, streaming: boolean, provider: LlmProvider, now: number) {
  try markDispatched(ticket.key)
  progress.dispatched = true
  if (!streaming) {
    const answer = complete(provider, upstream) catch effect (failure) => {
      progress.ending = endingOf(failure)
      throw refusalOf(failure, now)
    }
    progress.ending = { kind: "answered", usage: answer.usage }
    return json({ ...answer.json, model: model.id })
  }
  const bytes = stream(provider, upstream) catch effect (failure) => {
    progress.ending = endingOf(failure)
    throw refusalOf(failure, now)
  }
  const services = try Effect.context<Store>()
  const body = Stream.provideContext(try relayed(ticket, model, priced, bytes), services)
  progress.handedOff = true
  return HttpServerResponse.stream(body, { contentType: "text/event-stream", headers: { "cache-control": "no-store" } })
}

effect function finishHold(ticket: HoldTicket, progress: Progress, model: Model, priced: Quote): void!!Store {
  if (progress.handedOff) return
  if (!progress.dispatched) return try releaseUnsent(ticket.key)
  try settleOnce(ticket.key, model, priced, progress.ending ?? { kind: "abandoned", usage: undefined, deliveredChars: 0 })
}

effect function completeChat(context: RouteContext) {
  const settings = (try Deployment).settings.inference
  if (settings === undefined) throw refused("CapabilityUnavailable")
  const body = try chatBody(context)
  const chosen = try (try Store).transaction((tx) => chooseFor(tx, settings, body.model, hasImage(body)))
  const priced = try quote(body, chosen.model)
  const payer = owner(context.caller)
  const caller = credentialOf(context.caller)
  if (payer === undefined || caller === undefined) throw refused("AuthenticationRequired")
  const key: HoldKey = { service: "MeteredInference", caller, requestId: newId(), part: { tag: "WholeRequest" } }
  const upstream: ChatBody = { ...body, model: chosen.model.upstreamModel }
  const progress: Progress = { dispatched: false, ending: undefined, handedOff: false }
  return try acquireUseRelease(
    reserve(payer, key, priced.micros),
    (ticket) => serve(ticket, progress, chosen.model, priced, upstream, body.stream === true, chosen.provider, context.now),
    (ticket) => finishHold(ticket, progress, chosen.model, priced)
  )
}

export const chatRoutes: ReadonlyArray<Route> = [
  {
    method: "POST",
    path: "/api/v1/chat/completions",
    auth: "ServiceAccess",
    capability: "inference",
    rateClass: "CompletionsRequests",
    ingressPerMinute: chatIngressPerMinute,
    maxBodyBytes: chatMaxBodyBytes,
    handler: completeChat
  }
]
