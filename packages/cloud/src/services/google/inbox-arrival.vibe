// spec/cloud/services/google/mailRead.md, "Story: Notice new mail while I sign in privately"
import { inboxPageOutcome, inboxWatchCurrent, inboxWatchPageLimit, inboxWatchSelectionAllowed, startInboxWatch, type InboxWatch, type InboxWatchCaller } from "../../../gen/cloud__services__google__mailRead.effect.vibe"

export const inboxArrivalPath = "/api/v1/eliza/google/gmail/inbox-v1/arrival"
export const inboxArrivalBodyLimit = 65536

export error InboxWatchRequestInvalid
error InboxWatchUnavailable
export error InboxHistoryInvalid

schema ArrivalCursor { historyId: string; expiresAt: number }
schema ArrivalProfile { historyId: string }
schema ArrivalEntry { message: { id: string } }
schema ArrivalRecord { id: string; messagesAdded?: ArrivalEntry[] }
schema ArrivalHistory { historyId: string; history?: ArrivalRecord[]; nextPageToken?: string }

const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
const providerId = /^[A-Za-z0-9_-]{1,255}$/
const historyId = /^[1-9][0-9]{0,19}$/
const historyBefore = (earlier: string, later: string) => earlier.length < later.length || (earlier.length === later.length && earlier < later)

export effect function inboxWatchInput(query: URLSearchParams, caller: InboxWatchCaller) {
  const grants = query.getAll("grantId")
  const cursors = query.getAll("cursor")
  const grant = grants[0]
  const cursor = cursors[0]
  if (grants.length > 1 || !inboxWatchSelectionAllowed(caller, grant !== undefined) || (grant !== undefined && !uuid.test(grant)) || cursors.length > 1 ||
      (cursor !== undefined && (cursor.length > 1024 || !/^[a-f0-9]+$/.test(cursor)))) throw new InboxWatchRequestInvalid()
  return { grant, cursor }
}

export function inboxWatchBinding(origin: string, owner: string, organization: string, grant: string, credential: { readonly kind: "device" | "browser"; readonly hash: string }): string {
  return JSON.stringify(["cloud-google-inbox-arrival-v1", origin, owner, organization, grant, credential.kind, credential.hash])
}

export effect function decodeInboxWatch(raw: string, now: number): InboxWatch!InboxWatchUnavailable {
  const decoded = Schema.decodeUnknownOption(ArrivalCursor)(Effect.try(() => JSON.parse(raw) as unknown) catch () => undefined)
  if (Option.isNone(decoded) || !historyId.test(decoded.value.historyId) ||
      !Number.isSafeInteger(decoded.value.expiresAt) || !inboxWatchCurrent(decoded.value, now)) throw new InboxWatchUnavailable()
  return decoded.value
}

effect function parsed<A>(schema: Schema.Decoder<A>, raw: unknown): A!InboxHistoryInvalid {
  const decoded = Schema.decodeUnknownOption(schema)(raw)
  if (Option.isNone(decoded)) throw new InboxHistoryInvalid()
  return decoded.value
}

export effect function observeInboxWatch<E, R>(watch: InboxWatch | undefined, now: number, read: (path: string) => unknown!E!R): { watch: InboxWatch; arrived: boolean }!(E | InboxHistoryInvalid)!R {
  if (watch === undefined) {
    const profile = try parsed(ArrivalProfile, try read("/profile?fields=historyId"))
    if (!historyId.test(profile.historyId)) throw new InboxHistoryInvalid()
    return { watch: startInboxWatch(profile.historyId, now), arrived: false }
  }
  const query = new URLSearchParams({
    startHistoryId: watch.historyId, historyTypes: "messageAdded", labelId: "INBOX", maxResults: "25",
    fields: "historyId,nextPageToken,history(id,messagesAdded(message(id)))",
  })
  const visited = new Set<string>()
  for (let pageCount = 1; pageCount <= inboxWatchPageLimit; pageCount += 1) {
    const page = try parsed(ArrivalHistory, try read("/history?" + query))
    const records = page.history ?? []
    const additions = records.flatMap((entry) => entry.messagesAdded ?? [])
    const validPage = historyId.test(page.historyId) && !historyBefore(page.historyId, watch.historyId) &&
      records.every(({ id }) => historyId.test(id) && historyBefore(watch.historyId, id) && !historyBefore(page.historyId, id)) &&
      additions.every(({ message }) => providerId.test(message.id))
    const token = page.nextPageToken
    const continuation = token === undefined ? "EndOfHistory"
      : token.length > 0 && token.length <= 2048 && !visited.has(token) ? "FreshPageToken" : "InvalidPageToken"
    const outcome = inboxPageOutcome(pageCount, validPage, additions.length > 0, continuation)
    if (outcome === "ArrivalFound" || outcome === "NoArrival") return { watch, arrived: outcome === "ArrivalFound" }
    if (outcome === "RefusePage" || token === undefined) throw new InboxHistoryInvalid()
    visited.add(token)
    query.set("pageToken", token)
  }
  throw new InboxHistoryInvalid()
}
