// spec/cloud/services/google/connection.md, "Story: Connect my Google account with the access I chose"; spec/cloud/services/google/connection.md, "Story: See my Google connection as the cloud holds it"
import { millisPerMinute, millisPerSecond } from "../../../gen/cloud__shared__types.effect.vibe"
import { refused, type Refused } from "../../http/refusal.vibe"
import { Deployment } from "../../profile/profile.vibe"
import { openTokens, refreshAccess, type GoogleFailure } from "../../providers/google.vibe"
import { Store, toText, type Tx } from "../../store/connection.vibe"
import { loadRow, machineRows, stepRow, type Columns } from "../../store/rows.vibe"

export type GoogleCapability =
  | "google.basic_identity"
  | "google.gmail.triage"
  | "google.gmail.send"
  | "google.gmail.manage"
  | "google.gmail.drafts"
  | "google.gmail.mailbox"
  | "google.calendar.read"
  | "google.calendar.write"

export type ConnectionStatus = "Pending" | "Active" | "Expired" | "Revoked" | "Errored"

export interface Connection {
  readonly status: ConnectionStatus
  readonly scopes: ReadonlyArray<string>
  readonly tokens: string
  readonly expiresAt: number
  readonly refreshingUntil: number
}

export type ConnectionEvent =
  | { readonly type: "link"; readonly scopes: ReadonlyArray<string>; readonly tokens: string; readonly expiresAt: number }
  | { readonly type: "startRefresh"; readonly until: number }
  | { readonly type: "refreshed"; readonly scopes: ReadonlyArray<string>; readonly tokens: string; readonly expiresAt: number }
  | { readonly type: "refreshFailed" }
  | { readonly type: "grantInvalid" }
  | { readonly type: "fail" }
  | { readonly type: "revoke" }

export error ConnectionRejected { event: ConnectionEvent["type"]; status: ConnectionStatus }
export error ConnectionCorrupt { input: unknown }

export interface Owner {
  readonly organizationId: string
  readonly userId: string
}

export interface GoogleGrant {
  readonly connectionId: string
  readonly accessToken: string
  readonly subject: string
  readonly email: string
  readonly scopes: ReadonlyArray<string>
}

export const refreshMargin = 5 * millisPerMinute
export const refreshLease = 15 * millisPerSecond
const refreshPoll = 100

const auth = "https://www.googleapis.com/auth/"
const fullMail = "https://mail.google.com/"

const scopeTable: Readonly<Record<GoogleCapability, { readonly requested: ReadonlyArray<string>; readonly heldBy: ReadonlyArray<string> }>> = {
  "google.basic_identity": { requested: ["openid", "email"], heldBy: ["openid", "email", `${auth}userinfo.email`] },
  "google.gmail.triage": { requested: [`${auth}gmail.readonly`], heldBy: [`${auth}gmail.readonly`, `${auth}gmail.modify`, fullMail] },
  "google.gmail.send": { requested: [`${auth}gmail.send`], heldBy: [`${auth}gmail.send`, fullMail] },
  "google.gmail.manage": { requested: [`${auth}gmail.modify`], heldBy: [`${auth}gmail.modify`, fullMail] },
  "google.gmail.drafts": { requested: [`${auth}gmail.compose`], heldBy: [`${auth}gmail.compose`, `${auth}gmail.modify`, fullMail] },
  "google.gmail.mailbox": { requested: [`${auth}gmail.modify`], heldBy: [`${auth}gmail.modify`, fullMail] },
  "google.calendar.read": { requested: [`${auth}calendar.events`], heldBy: [`${auth}calendar.events`, `${auth}calendar`] },
  "google.calendar.write": { requested: [`${auth}calendar.events`], heldBy: [`${auth}calendar.events`, `${auth}calendar`] }
}

export const googleCapabilities = Object.keys(scopeTable) as ReadonlyArray<GoogleCapability>

export function scopeFor(capability: GoogleCapability): ReadonlyArray<string> {
  return scopeTable[capability].requested
}

export function holds(scopes: ReadonlyArray<string>, capability: GoogleCapability): boolean {
  return scopeTable[capability].heldBy.some((scope) => scopes.includes(scope))
}

export function capabilitiesOf(scopes: ReadonlyArray<string>): ReadonlyArray<GoogleCapability> {
  return googleCapabilities.filter((capability) => holds(scopes, capability))
}

export const initialConnection: Connection = { status: "Pending", scopes: [], tokens: "", expiresAt: 0, refreshingUntil: 0 }

schema ConnectionState { status: "Pending" | "Active" | "Expired" | "Revoked" | "Errored";scopes: ReadonlyArray<string>; tokens: string; expiresAt: number; refreshingUntil: number }

export effect function decodeConnection(input: unknown): Connection!ConnectionCorrupt {
  return Schema.decodeUnknownEffect(ConnectionState)(input) catch effect () => { throw new ConnectionCorrupt({ input }) }
}

export effect function applyConnection(state: Connection, event: ConnectionEvent): Connection!ConnectionRejected {
  const rejected = new ConnectionRejected({ event: event.type, status: state.status })
  switch (event.type) {
    case "link": return { status: "Active", scopes: [...event.scopes], tokens: event.tokens, expiresAt: event.expiresAt, refreshingUntil: 0 }
    case "startRefresh": {
      if (state.status !== "Active") throw rejected
      return { ...state, refreshingUntil: event.until }
    }
    case "refreshed": {
      if (state.status !== "Active") throw rejected
      return { ...state, scopes: [...event.scopes], tokens: event.tokens, expiresAt: event.expiresAt, refreshingUntil: 0 }
    }
    case "refreshFailed": {
      if (state.status !== "Active") throw rejected
      return { ...state, refreshingUntil: 0 }
    }
    case "grantInvalid": {
      if (state.status !== "Active") throw rejected
      return { ...state, status: "Expired", refreshingUntil: 0 }
    }
    case "fail": {
      if (state.status !== "Active") throw rejected
      return { ...state, status: "Errored", refreshingUntil: 0 }
    }
    case "revoke": return { ...state, status: "Revoked", tokens: "", expiresAt: 0, refreshingUntil: 0 }
    default: {
      const _exhaustive: never = event
      return _exhaustive
    }
  }
}

export const connectionRows = machineRows<Connection, ConnectionEvent, ConnectionRejected, ConnectionCorrupt>("google_connections", {
  initial: initialConnection,
  decodeState: decodeConnection,
  apply: applyConnection
})

export function connectionColumns(extra: Columns = {}) {
  return (state: Connection): Columns => ({
    ...extra,
    status: state.status,
    tokens: state.tokens === "" ? null : state.tokens,
    expires_at: state.expiresAt,
    refreshing_until: state.refreshingUntil
  })
}

effect function profileGoogle(): void!Refused!Deployment {
  if ((try Deployment).settings.google === undefined) throw refused("ProviderUnavailable", "GoogleNotConfigured")
}

export effect function ownerSide(query: URLSearchParams): void!Refused {
  const side = query.get("side")
  if (side !== null && side !== "owner") throw refused("InvalidRequest")
}

export effect function pickGrant(tx: Tx, owner: Owner, grantId?: string) {
  const held = try tx.query("SELECT key, status FROM google_connections WHERE organization_id = $1 AND status <> 'Pending' ORDER BY linked_at DESC, key", [owner.organizationId])
  if (grantId !== undefined) {
    if (!held.some((row) => row.key === grantId)) throw refused("NotFound")
    return grantId
  }
  const active = held.filter((row) => row.status === "Active")
  if (active.length > 1) throw refused("InvalidRequest", "GrantRequired")
  const chosen = toText((active[0] ?? held[0])?.key)
  if (chosen === undefined) throw refused("GoogleReauthRequired")
  return chosen
}

export effect function selectGrant(owner: Owner, grantId?: string) {
  try profileGoogle()
  const store = try Store
  return try store.transaction((tx) => pickGrant(tx, owner, grantId))
}

type Claimed =
  | { readonly kind: "ready"; readonly grant: Omit<GoogleGrant, "accessToken">; readonly tokens: string }
  | { readonly kind: "refresh"; readonly grant: Omit<GoogleGrant, "accessToken">; readonly tokens: string }
  | { readonly kind: "wait" }

function admitted(connection: Connection, capability: GoogleCapability, subject: string, expectedAccountId: string | undefined): Refused | undefined {
  if (connection.status !== "Active" || connection.tokens === "") return refused("GoogleReauthRequired")
  if (!holds(connection.scopes, capability)) return refused("AccessDenied", "CapabilityMissing")
  if (expectedAccountId !== undefined && expectedAccountId !== subject) return refused("AccessDenied", "GoogleAccountChanged")
  return undefined
}

effect function claim(tx: Tx, owner: Owner, grantId: string | undefined, capability: GoogleCapability, expectedAccountId: string | undefined, now: number) {
  const connectionId = try pickGrant(tx, owner, grantId)
  const loaded = try loadRow(tx, connectionRows, connectionId)
  const identity = (try tx.query("SELECT subject, email FROM google_connections WHERE key = $1", [connectionId]))[0]
  const subject = toText(identity?.subject) ?? ""
  const refusal = admitted(loaded.state, capability, subject, expectedAccountId)
  if (refusal !== undefined) throw refusal
  const grant = { connectionId, subject, email: toText(identity?.email) ?? "", scopes: loaded.state.scopes }
  if (loaded.state.expiresAt - now > refreshMargin) {
    try tx.query("UPDATE google_connections SET last_used_at = $2 WHERE key = $1", [connectionId, now])
    return { kind: "ready", grant, tokens: loaded.state.tokens } satisfies Claimed
  }
  if (loaded.state.refreshingUntil > now) return { kind: "wait" } satisfies Claimed
  try stepRow(tx, connectionRows, connectionId, { type: "startRefresh", until: now + refreshLease }, connectionColumns())
  return { kind: "refresh", grant, tokens: loaded.state.tokens } satisfies Claimed
}

function refusalOf(failure: GoogleFailure): Refused {
  switch (failure._tag) {
    case "InvalidGrant": return refused("GoogleReauthRequired")
    case "InvalidResponse": return refused("ProviderInvalidResponse")
    default: return refused("ProviderUnavailable")
  }
}

error RefreshDropped

type Settled = { readonly kind: "kept"; readonly connection: Connection } | { readonly kind: "dropped" }

effect function settleRefresh(connectionId: string, from: string, event: ConnectionEvent, now: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const loaded = try loadRow(tx, connectionRows, connectionId)
    if (loaded.state.status !== "Active" || loaded.state.tokens !== from) return { kind: "dropped" } satisfies Settled
    const stepped = stepRow(tx, connectionRows, connectionId, event, connectionColumns(event.type === "refreshed" ? { last_used_at: now } : {})) catch effect (failure) => {
      if (failure._tag === "ConnectionRejected") throw refused("GoogleReauthRequired")
      throw failure
    }
    return { kind: "kept", connection: stepped.state } satisfies Settled
  })
}

type ClaimedRefresh = { readonly grant: Omit<GoogleGrant, "accessToken">; readonly tokens: string }

effect function closeRefresh(claimed: ClaimedRefresh, event: ConnectionEvent, refusal: Refused) {
  const now = try Clock.currentTimeMillis
  const settled = try settleRefresh(claimed.grant.connectionId, claimed.tokens, event, now)
  if (settled.kind === "dropped") throw new RefreshDropped()
  throw refusal
}

effect function refreshed(claimed: ClaimedRefresh, capability: GoogleCapability) {
  const held = openTokens(claimed.tokens) catch effect () => { return try closeRefresh(claimed, { type: "grantInvalid" }, refused("GoogleReauthRequired")) }
  if (held.refreshToken === "") {
    const now = try Clock.currentTimeMillis
    if (held.expiresAt <= now) return try closeRefresh(claimed, { type: "refreshFailed" }, refused("GoogleReauthRequired"))
    try settleRefresh(claimed.grant.connectionId, claimed.tokens, { type: "refreshFailed" }, now)
    return { ...claimed.grant, accessToken: held.accessToken } satisfies GoogleGrant
  }
  const answer = refreshAccess(claimed.tokens) catch effect (failure) => {
    switch (failure._tag) {
      case "SealingFailed": return try closeRefresh(claimed, { type: "fail" }, refused("GoogleReauthRequired"))
      case "InvalidGrant": return try closeRefresh(claimed, { type: "grantInvalid" }, refused("GoogleReauthRequired"))
      default: return try closeRefresh(claimed, { type: "refreshFailed" }, refusalOf(failure))
    }
  }
  const now = try Clock.currentTimeMillis
  const settled = try settleRefresh(claimed.grant.connectionId, claimed.tokens, { type: "refreshed", scopes: answer.scopes ?? claimed.grant.scopes, tokens: answer.sealed, expiresAt: answer.tokens.expiresAt }, now)
  if (settled.kind === "dropped") throw new RefreshDropped()
  if (!holds(settled.connection.scopes, capability)) throw refused("AccessDenied", "CapabilityMissing")
  return { ...claimed.grant, scopes: settled.connection.scopes, accessToken: answer.tokens.accessToken } satisfies GoogleGrant
}

export effect function useGrant(owner: Owner, grantId: string | undefined, capability: GoogleCapability, expectedAccountId?: string) {
  try profileGoogle()
  const store = try Store
  const attempt = effect {
    const now = try Clock.currentTimeMillis
    return try store.transaction((tx) => claim(tx, owner, grantId, capability, expectedAccountId, now))
  }
  while (true) {
    const claimed: Claimed = try attempt
    switch (claimed.kind) {
      case "wait": {
        try sleep(refreshPoll)
        break
      }
      case "ready": {
        const tokens = openTokens(claimed.tokens) catch effect () => { throw refused("GoogleReauthRequired") }
        return { ...claimed.grant, accessToken: tokens.accessToken } satisfies GoogleGrant
      }
      case "refresh": {
        const grant = refreshed(claimed, capability) catch effect (failure) => {
          if (failure._tag === "RefreshDropped") return undefined
          throw failure
        }
        if (grant !== undefined) return grant
        break
      }
      default: {
        const _exhaustive: never = claimed
        return _exhaustive
      }
    }
  }
}
