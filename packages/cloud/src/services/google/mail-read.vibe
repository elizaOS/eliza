// spec/cloud/services/google/mailRead.md, "Story: Read my mail through the grant I chose"
import { refused, type Refused } from "../../http/refusal.vibe"
import { json, owner as ownerOf, type Route, type RouteContext } from "../../http/routes.vibe"
import { sha256Hex } from "../../shared/sealing.vibe"
import { googleJson, type GoogleFailure } from "../../providers/google.vibe"
import { holds, useGrant, type GoogleCapability } from "./grant-access.vibe"
import { attachmentDescriptor, attachmentMaxBytes, attachmentMimeTypes } from "../../google-read.vibe"
import type { OperationKind } from "./mail-operations.vibe"

module node {
  import { createHash } from "node:crypto"

  /** @throws {never} */
  export function decodePart(data: string, charset: string): { readonly text: string; readonly size: number } {
    const bytes = Buffer.from(data, "base64url")
    const decoder = (() => {
      try {
        return new TextDecoder(charset)
      } catch {
        return new TextDecoder("utf-8")
      }
    })()
    return { text: decoder.decode(bytes), size: bytes.length }
  }

  /** @throws {never} */
  export function partBytes(data: string): { readonly dataBase64: string; readonly size: number; readonly sha256: string } {
    const bytes = Buffer.from(data, "base64url")
    return { dataBase64: bytes.toString("base64"), size: bytes.length, sha256: createHash("sha256").update(bytes).digest("hex") }
  }

  /** @throws {never} */
  export function utf8Length(text: string): number {
    return Buffer.byteLength(text, "utf8")
  }
}
import { decodePart, partBytes, utf8Length } from node

schema Header { name: string; value: string }
schema PartBody { data?: string; attachmentId?: string; size?: number }
schema MailPart { partId?: string; mimeType?: string; filename?: string; headers?: Header[]; body?: PartBody; parts?: Schema.Unknown[] }
schema MailMessage {
  id: string; threadId: string; historyId?: string; snippet?: string; internalDate?: string; labelIds?: string[]; payload?: MailPart
}
schema MessageRef { id: string }
schema MessageList { messages?: MessageRef[]; nextPageToken?: string }
schema Profile { historyId: string }
schema Thread { id: string; historyId: string; messages: Schema.Unknown[] }
schema DraftList { drafts?: MessageRef[]; nextPageToken?: string }
schema DraftMessage { id: string; raw?: string; snippet?: string; internalDate?: string; payload?: MailPart }
schema Draft { id: string; message: DraftMessage }

export interface ReadGrant {
  readonly accessToken: string
}

interface Grant extends ReadGrant {
  readonly email: string
  readonly scopes: ReadonlyArray<string>
}

export interface Attachment {
  readonly name: string
  readonly mimeType: string
  readonly size: number
  readonly dataBase64: string
  readonly sha256: string
}

type HtmlStatus = "available" | "none"
type Format = "metadata" | "full"

export { attachmentMaxBytes, attachmentMimeTypes }
const gmail = "/gmail/v1/users/me"
const providerId = /^[A-Za-z0-9_-]{1,256}$/
const historyPattern = /^\d{1,20}$/
const partIdPattern = /^[0-9.]{1,32}$/
const pageSize = /^[1-9]\d{0,2}$/
const mimeToken = /^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}\/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$/i
const triageMax = 50
const searchMax = 100
const threadPage = 25
const threadOffsetMax = 2000
const draftPage = 25
const maxParts = 200
const bodyTextMaxBytes = 256 * 1024
const bodyHtmlMaxBytes = 512 * 1024
const messageMaxBytes = Math.ceil(attachmentMaxBytes / 3) * 4 + 65536
const threadMaxBytes = 12 * 1024 * 1024
const metadataHeaders = ["From", "To", "Cc", "Subject", "Reply-To", "Message-ID", "Precedence", "List-Id", "Auto-Submitted"]
const automatedSender = /(?:^|\b)(?:no-?reply|donotreply|notifications?|mailer-daemon)(?:\b|@)/i
const trashQuery = /(?:^|[\s({])in:(?:spam|trash|anywhere)(?=[\s)}]|$)/i

const kindsByCapability: ReadonlyArray<readonly [GoogleCapability, ReadonlyArray<OperationKind>]> = [
  ["google.gmail.send", ["send"]],
  ["google.gmail.drafts", ["draft-create", "draft-replace", "draft-delete"]],
  ["google.gmail.manage", ["archive", "unarchive", "trash", "untrash", "mark-read", "mark-unread", "star", "unstar"]]
]

export function googleRefused(failure: GoogleFailure): Refused {
  switch (failure._tag) {
    case "NotFound": return refused("NotFound")
    case "InvalidGrant": return refused("GoogleReauthRequired")
    case "ContentTooLarge": return refused("ContentTooLarge")
    case "InvalidResponse": return refused("ProviderInvalidResponse")
    case "PreconditionFailed":
    case "Duplicate":
    case "Rejected":
    case "Unavailable": return refused("ProviderUnavailable")
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

effect function google(grant: ReadGrant, path: string, maxBytes?: number) {
  const answer = googleJson(grant.accessToken, "GET", `${gmail}${path}`, maxBytes === undefined ? {} : { maxBytes }) catch effect (failure) => { throw googleRefused(failure) }
  return answer
}

effect function parsed<A>(schema: Schema.Codec<A>, raw: unknown): A!Refused {
  const value = Schema.decodeUnknownOption(schema)(raw)
  if (Option.isNone(value)) throw refused("ProviderInvalidResponse")
  return value.value
}

function headerValues(part: MailPart | undefined, name: string): ReadonlyArray<string> {
  return (part?.headers ?? []).filter((header) => header.name.toLowerCase() === name).map((header) => header.value)
}

function header(part: MailPart | undefined, name: string): string {
  return headerValues(part, name).at(-1) ?? ""
}

function addressOf(entry: string): string {
  const bracketed = /<([^<>]+)>\s*$/.exec(entry)
  return (bracketed?.[1] ?? entry).trim()
}

function addresses(value: string): ReadonlyArray<string> {
  return value.split(/,(?=(?:[^"]*"[^"]*")*[^"]*$)/).map(addressOf).filter((entry) => entry !== "")
}

function senderEmail(value: string): string | null {
  const candidate = addressOf(value)
  return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(candidate) ? candidate.toLowerCase() : null
}

function triage(labels: ReadonlyArray<string>, part: MailPart | undefined, to: ReadonlyArray<string>, cc: ReadonlyArray<string>, selfEmail: string) {
  const labelSet = new Set(labels.map((label) => label.trim().toUpperCase()))
  const isUnread = labelSet.has("UNREAD")
  const explicitlyImportant = labelSet.has("IMPORTANT")
  const self = selfEmail.trim().toLowerCase()
  const fromEmail = senderEmail(header(part, "from"))
  const directlyAddressed = self !== "" && [...to, ...cc].some((entry) => entry.trim().toLowerCase() === self)
  const fromSelf = self !== "" && fromEmail === self
  const precedence = header(part, "precedence").trim().toLowerCase()
  const autoSubmitted = headerValues(part, "auto-submitted").at(-1)?.trim().toLowerCase()
  const automated = (fromEmail !== null && automatedSender.test(fromEmail)) || header(part, "list-id") !== "" ||
    precedence === "bulk" || precedence === "list" || precedence === "junk" || (autoSubmitted !== undefined && autoSubmitted !== "no")
  const likelyReplyNeeded = !automated && !fromSelf && isUnread && directlyAddressed
  const weights: ReadonlyArray<readonly [boolean, number, string]> = [
    [isUnread, 30, "unread"],
    [explicitlyImportant, 35, "important label"],
    [directlyAddressed, 15, "directly addressed"],
    [likelyReplyNeeded, 30, "likely needs reply"],
    [automated, -25, "automated sender"],
    [fromSelf, -60, "sent by self"]
  ]
  const applied = weights.filter(([holds]) => holds)
  return {
    isImportant: explicitlyImportant || likelyReplyNeeded,
    likelyReplyNeeded,
    triageScore: Math.max(0, applied.reduce((total, [, weight]) => total + weight, 0)),
    triageReason: applied.map(([, , reason]) => reason).join(", ") || "recent inbox message"
  }
}

effect function mailCard(message: MailMessage, selfEmail: string) {
  const received = Number(message.internalDate ?? "")
  if (!providerId.test(message.id) || !providerId.test(message.threadId) || !/^\d+$/.test(message.internalDate ?? "") || !Number.isSafeInteger(received)) {
    throw refused("ProviderInvalidResponse")
  }
  const part = message.payload
  const labels = (message.labelIds ?? []).map((label) => label.trim()).filter((label) => label !== "")
  const to = addresses(header(part, "to"))
  const cc = addresses(header(part, "cc"))
  return {
    id: message.id, threadId: message.threadId, subject: header(part, "subject"), from: header(part, "from"), to, cc,
    snippet: message.snippet ?? "", receivedAt: new Date(received).toISOString(), labels, isUnread: labels.includes("UNREAD"),
    ...triage(labels, part, to, cc, selfEmail), metadata: { historyId: message.historyId ?? null }
  }
}

effect function readMessage(grant: ReadGrant, id: string, format: Format) {
  if (!providerId.test(id)) throw refused("InvalidRequest")
  const query = new URLSearchParams({ format })
  if (format === "metadata") for (const name of metadataHeaders) query.append("metadataHeaders", name)
  const message = try parsed(MailMessage, try google(grant, `/messages/${id}?${query}`, format === "full" ? messageMaxBytes : undefined))
  if (message.id !== id) throw refused("ProviderInvalidResponse")
  return message
}

export effect function readAtHistory(grant: ReadGrant, messageId: string, historyId: string) {
  if (!historyPattern.test(historyId)) throw refused("InvalidRequest")
  const message = try readMessage(grant, messageId, "full")
  if (message.historyId !== historyId) throw refused("StaleRevision")
  return message
}

effect function partsOf(root: MailPart | undefined) {
  const found: MailPart[] = []
  const pending: unknown[] = root === undefined ? [] : [root]
  while (pending.length > 0) {
    if (found.length >= maxParts) throw refused("ContentTooLarge")
    const part = try parsed(MailPart, pending.shift())
    found.push(part)
    pending.unshift(...(part.parts ?? []))
  }
  return found
}

function charsetOf(part: MailPart): string {
  return /charset="?([^";\s]+)"?/i.exec(header(part, "content-type"))?.[1] ?? "utf-8"
}

effect function partData(grant: ReadGrant, messageId: string, part: MailPart, maxBytes: number) {
  const body = part.body ?? {}
  if ((body.size ?? 0) > maxBytes) throw refused("ContentTooLarge")
  if (body.data !== undefined) return body.data
  if (body.attachmentId === undefined || !providerId.test(body.attachmentId)) return ""
  const fetched = try parsed(PartBody, try google(grant, `/messages/${messageId}/attachments/${body.attachmentId}`, Math.ceil(maxBytes / 3) * 4 + 4096))
  return fetched.data ?? ""
}

effect function bodyPart(grant: ReadGrant, messageId: string, part: MailPart | undefined, maxBytes: number) {
  if (part === undefined) return undefined
  const data = try partData(grant, messageId, part, maxBytes)
  if (!/^[A-Za-z0-9_=-]*$/.test(data)) throw refused("ProviderInvalidResponse")
  const decoded = decodePart(data, charsetOf(part))
  if (decoded.size > maxBytes || utf8Length(decoded.text) > maxBytes) throw refused("ContentTooLarge")
  return decoded.text
}

function htmlText(html: string): string {
  return html
    .replace(/<(script|style|head)\b[\s\S]*?<\/\1\s*>/gi, " ")
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/(?:p|div|section|article|li|tr|table|h[1-6])>/gi, "\n")
    .replace(/<[^<>]*>/g, " ")
    .replace(/&nbsp;/gi, " ").replace(/&lt;/gi, "<").replace(/&gt;/gi, ">").replace(/&quot;/gi, "\"").replace(/&#39;|&apos;/gi, "'").replace(/&amp;/gi, "&")
    .replace(/\r/g, "").replace(/[ \t]+\n/g, "\n").replace(/\n{3,}/g, "\n\n").replace(/[ \t]{2,}/g, " ")
    .trim()
}

function attachmentDescriptors(parts: ReadonlyArray<MailPart>) {
  return parts.filter((part) => part.filename !== undefined && part.filename !== "").map(attachmentDescriptor)
}

effect function messageView(grant: ReadGrant, message: MailMessage, selfEmail: string) {
  const parts = try partsOf(message.payload)
  const inline = parts.filter((part) => (part.filename ?? "") === "")
  const plain = try bodyPart(grant, message.id, inline.find((part) => part.mimeType?.toLowerCase() === "text/plain"), bodyTextMaxBytes)
  const html = try bodyPart(grant, message.id, inline.find((part) => part.mimeType?.toLowerCase() === "text/html"), bodyHtmlMaxBytes)
  const bodyText = plain ?? (html === undefined ? "" : htmlText(html))
  if (utf8Length(bodyText) > bodyTextMaxBytes) throw refused("ContentTooLarge")
  const bodyHtmlStatus: HtmlStatus = html === undefined ? "none" : "available"
  return {
    message: try mailCard(message, selfEmail),
    bodyText,
    bodyHtml: html ?? null,
    bodyHtmlStatus,
    attachments: attachmentDescriptors(parts)
  }
}

export effect function attachmentBytes(grant: ReadGrant, messageId: string, partId: string, historyId: string) {
  if (!partIdPattern.test(partId)) throw refused("InvalidRequest")
  const message = try readAtHistory(grant, messageId, historyId)
  const matching = (try partsOf(message.payload)).filter((part) => part.partId === partId && (part.filename ?? "") !== "")
  const part = matching[0]
  if (part === undefined || matching.length !== 1) throw refused("NotFound")
  const declared = part.body?.size
  if (declared === undefined || !Number.isSafeInteger(declared) || declared < 0) throw refused("ProviderInvalidResponse")
  const data = try partData(grant, message.id, part, attachmentMaxBytes)
  if (!/^[A-Za-z0-9_-]*={0,2}$/.test(data)) throw refused("ProviderInvalidResponse")
  const bytes = partBytes(data)
  if (bytes.size !== declared) throw refused("ProviderInvalidResponse")
  const name = part.filename ?? ""
  return {
    name: name.trim() !== "" && name.length <= 120 && name !== "." && name !== ".." && !/[\\/\x00-\x1f\x7f]/.test(name) ? name : "attachment",
    mimeType: mimeToken.test(part.mimeType ?? "") ? (part.mimeType ?? "").toLowerCase() : "application/octet-stream",
    ...bytes
  } satisfies Attachment
}

effect function mailboxHistory(grant: ReadGrant) {
  const profile = try parsed(Profile, try google(grant, "/profile?fields=historyId"))
  if (!historyPattern.test(profile.historyId)) throw refused("ProviderInvalidResponse")
  return profile.historyId
}

effect function listed(grant: Grant, query: URLSearchParams, limit: number, pageToken: string | undefined) {
  const page = try parsed(MessageList, try google(grant, `/messages?${query}`))
  const next = page.nextPageToken
  if ((page.messages ?? []).length > limit || (next !== undefined && (next === "" || next.length > 4096 || next === pageToken))) throw refused("ProviderInvalidResponse")
  const messages = try Effect.forEach(page.messages ?? [], effect (entry) => {
    return try mailCard(try readMessage(grant, entry.id, "metadata"), grant.email)
  }, { concurrency: 8 })
  return { messages, nextPageToken: next ?? null }
}

effect function grantOf(context: RouteContext) {
  const owner = ownerOf(context.caller)
  if (owner === undefined) throw refused("AuthenticationRequired")
  const grantId = context.query.get("grantId") ?? ""
  const grant: Grant = try useGrant(owner, grantId === "" ? undefined : grantId, "google.gmail.triage")
  return grant
}

effect function param(context: RouteContext, name: string, pattern: RegExp) {
  const value = context.query.get(name) ?? ""
  if (!pattern.test(value)) throw refused("InvalidRequest")
  return value
}

effect function limitOf(context: RouteContext, fallback: number, max: number) {
  const raw = context.query.get("maxResults")
  if (raw === null) return fallback
  if (!pageSize.test(raw) || Number(raw) > max) throw refused("InvalidRequest")
  return Number(raw)
}

effect function pageTokenOf(context: RouteContext) {
  const token = context.query.get("pageToken")
  if (token === null) return undefined
  if (token === "" || token.length > 4096 || /[\r\n\0]/.test(token)) throw refused("InvalidRequest")
  return token
}

const syncedAt = (context: RouteContext) => new Date(context.now).toISOString()

effect function triageRoute(context: RouteContext) {
  const limit = try limitOf(context, triageMax, triageMax)
  const grant = try grantOf(context)
  const mailboxHistoryId = try mailboxHistory(grant)
  const page = try listed(grant, new URLSearchParams({ maxResults: String(limit), labelIds: "INBOX", q: "-in:trash" }), limit, undefined)
  const messages = page.messages.toSorted((left, right) => Date.parse(right.receivedAt) - Date.parse(left.receivedAt))
  return json({ messages, syncedAt: syncedAt(context), mailboxHistoryId })
}

effect function searchRoute(context: RouteContext) {
  const query = (context.query.get("query") ?? "").trim()
  if (query === "" || query.length > 2048) throw refused("InvalidRequest")
  const limit = try limitOf(context, triageMax, searchMax)
  const pageToken = try pageTokenOf(context)
  const grant = try grantOf(context)
  const mailboxHistoryId = try mailboxHistory(grant)
  const search = new URLSearchParams({ q: query, maxResults: String(limit), includeSpamTrash: String(trashQuery.test(query)) })
  if (pageToken !== undefined) search.set("pageToken", pageToken)
  const page = try listed(grant, search, limit, pageToken)
  return json({ ...page, syncedAt: syncedAt(context), mailboxHistoryId, supportsSpamTrash: true })
}

effect function readRoute(context: RouteContext) {
  const messageId = try param(context, "messageId", providerId)
  const grant = try grantOf(context)
  return json(try messageView(grant, try readMessage(grant, messageId, "full"), grant.email))
}

effect function capabilitiesRoute(context: RouteContext) {
  const grant = try grantOf(context)
  const kinds = kindsByCapability.flatMap(([capability, granted]) => holds(grant.scopes, capability) ? granted : [])
  return json({ version: 1, from: grant.email, kinds, attachmentPolicy: { mimeTypes: attachmentMimeTypes, maxBytes: attachmentMaxBytes } })
}

effect function threadRoute(context: RouteContext) {
  const threadId = try param(context, "threadId", providerId)
  const offset = Number(context.query.get("offset") ?? "0")
  const expected = context.query.get("historyId") ?? undefined
  if (!Number.isSafeInteger(offset) || offset < 0 || offset > threadOffsetMax || (offset > 0 && expected === undefined) ||
      (expected !== undefined && !historyPattern.test(expected))) throw refused("InvalidRequest")
  const grant = try grantOf(context)
  const thread = try parsed(Thread, try google(grant, `/threads/${threadId}?format=full`, threadMaxBytes))
  if (thread.id !== threadId || !historyPattern.test(thread.historyId)) throw refused("ProviderInvalidResponse")
  if (expected !== undefined && thread.historyId !== expected) throw refused("StaleRevision")
  const all = (try Effect.forEach(thread.messages, (raw) => parsed(MailMessage, raw))).toSorted((left, right) => Number(left.internalDate) - Number(right.internalDate))
  if (all.some((message) => message.threadId !== threadId)) throw refused("ProviderInvalidResponse")
  if (offset > all.length) throw refused("InvalidRequest")
  const page = all.slice(offset, offset + threadPage)
  const messages = try Effect.forEach(page, effect (message) => {
    return { ...(try messageView(grant, message, grant.email)), historyId: message.historyId ?? null }
  })
  return json({
    version: 1, threadId, historyId: thread.historyId, total: all.length, offset,
    nextOffset: offset + page.length < all.length ? offset + page.length : null, messages
  })
}

effect function attachmentRoute(context: RouteContext) {
  const messageId = try param(context, "messageId", providerId)
  const partId = try param(context, "partId", partIdPattern)
  const historyId = try param(context, "historyId", historyPattern)
  const grant = try grantOf(context)
  const file = try attachmentBytes(grant, messageId, partId, historyId)
  return json({ version: 1, messageId, partId, historyId, ...file, supported: attachmentMimeTypes.includes(file.mimeType) })
}

effect function draftsRoute(context: RouteContext) {
  const pageToken = try pageTokenOf(context)
  const grant = try grantOf(context)
  const query = new URLSearchParams({ maxResults: String(draftPage) })
  if (pageToken !== undefined) query.set("pageToken", pageToken)
  const page = try parsed(DraftList, try google(grant, `/drafts?${query}`))
  const next = page.nextPageToken
  if ((page.drafts ?? []).length > draftPage || (next !== undefined && (next === "" || next.length > 4096 || next === pageToken))) throw refused("ProviderInvalidResponse")
  const drafts = try Effect.forEach(page.drafts ?? [], effect (entry) => {
    if (!providerId.test(entry.id)) throw refused("ProviderInvalidResponse")
    const draft = try parsed(Draft, try google(grant, `/drafts/${entry.id}?format=metadata`))
    if (draft.id !== entry.id || !providerId.test(draft.message.id)) throw refused("ProviderInvalidResponse")
    const updated = Number(draft.message.internalDate ?? "")
    return {
      draftId: draft.id, messageId: draft.message.id, subject: header(draft.message.payload, "subject"),
      to: addresses(header(draft.message.payload, "to")), snippet: draft.message.snippet ?? "",
      updatedAt: Number.isSafeInteger(updated) && updated > 0 ? new Date(updated).toISOString() : null
    }
  }, { concurrency: 8 })
  return json({ version: 1, drafts, nextPageToken: next ?? null })
}

effect function draftRoute(context: RouteContext) {
  const draftId = try param(context, "draftId", providerId)
  const grant = try grantOf(context)
  const raw = try parsed(Draft, try google(grant, `/drafts/${draftId}?format=raw`, threadMaxBytes))
  const full = try parsed(Draft, try google(grant, `/drafts/${draftId}?format=full`, threadMaxBytes))
  if (raw.id !== draftId || raw.message.raw === undefined || !providerId.test(raw.message.id)) throw refused("ProviderInvalidResponse")
  if (full.id !== draftId || full.message.id !== raw.message.id) throw refused("StaleRevision")
  const parts = try partsOf(full.message.payload)
  const inline = parts.filter((part) => (part.filename ?? "") === "")
  const plain = inline.find((part) => part.mimeType?.toLowerCase() === "text/plain")
  const payload = full.message.payload
  return json({
    version: 1, id: draftId, messageId: raw.message.id, providerDigest: sha256Hex(raw.message.raw),
    content: {
      to: addresses(header(payload, "to")), cc: addresses(header(payload, "cc")), bcc: addresses(header(payload, "bcc")),
      subject: header(payload, "subject"),
      bodyText: (try bodyPart(grant, full.message.id, plain, bodyTextMaxBytes)) ?? "",
      plainText: plain !== undefined || !inline.some((part) => part.mimeType?.toLowerCase() === "text/html"),
      threaded: header(payload, "in-reply-to") !== "" || header(payload, "references") !== "",
      attachmentCount: attachmentDescriptors(parts).length
    }
  })
}

const gmailPath = "/api/v1/eliza/google/gmail"

export const mailReadRoutes: ReadonlyArray<Route> = [
  { method: "GET", path: `${gmailPath}/triage`, auth: "ServiceAccess", capability: "managedGoogle", handler: triageRoute },
  { method: "GET", path: `${gmailPath}/search`, auth: "ServiceAccess", capability: "managedGoogle", handler: searchRoute },
  { method: "GET", path: `${gmailPath}/read`, auth: "ServiceAccess", capability: "managedGoogle", handler: readRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/capabilities`, auth: "ServiceAccess", capability: "managedGoogle", handler: capabilitiesRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/thread`, auth: "ServiceAccess", capability: "managedGoogle", handler: threadRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/attachment`, auth: "ServiceAccess", capability: "managedGoogle", handler: attachmentRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/drafts`, auth: "ServiceAccess", capability: "managedGoogle", handler: draftsRoute },
  { method: "GET", path: `${gmailPath}/inbox-v1/draft`, auth: "ServiceAccess", capability: "managedGoogle", handler: draftRoute }
]
