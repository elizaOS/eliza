// spec/cloud/index.md, "Story: Use inference on my subscription or funded pilot account"; spec/cloud/index.md, "A streamed answer sends complete OpenAI frames and settles the same hold"; spec/cloud/shared/metering.md, "A call reaches its provider only after its hold is durably marked dispatched"
import { hangUpCounts } from "../../gen/cloud__services__inference.effect.vibe"
import { laneFor } from "../billing/policy.vibe"
import { refusalBody, refused } from "../http/refusal.vibe"
import { recheckServiceAccess, signed } from "../http/request-auth.vibe"
import { json, type CloudContext, type Route, type RouteContext } from "../http/routes.vibe"
import { Deployment } from "../profile/profile.vibe"
import { complete, maxReplyBytes, ProviderInvalidResponse, ProviderRefused, ProviderTimedOut, ProviderUnreachable, readLlmObject, stream, type LlmFailure } from "../providers/llm.vibe"
import { markDispatched, reserve, settle, type Settlement } from "../shared/metering.vibe"
import { Store } from "../store/connection.vibe"
import { chatBody, chatIngressPerMinute, hasImage, quote, type ChatRequest, type Quote } from "./chat-request.vibe"
import { billedFromUsage, callCostFor, chooseFor, type Model, type TokenCounts } from "./models.vibe"
import { chunkFrame, doneFrame, errorFrame, feed, finish, isDone, segmenter } from "./sse.ts"

const requestIdPattern = /^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$/i
const frameBytes = 256 * 1024
const chunkBytes = 16 * 1024
const providerPause = 5_000
const encoder = new TextEncoder()
const decoder = new TextDecoder()
const headers = { "cache-control": "no-store" }
const DeltaText = Schema.Struct({ delta: Schema.optionalKey(Schema.Struct({ content: Schema.optionalKey(Schema.NullOr(Schema.String)) })) })
const readDeltaText = Schema.decodeUnknownOption(DeltaText)

function providerBody({ max_tokens: _maxTokens, max_completion_tokens, ...body }: ChatRequest, model: string, max: number) {
  return { ...body, model, ...(max_completion_tokens === undefined ? { max_tokens: max } : { max_completion_tokens: max }) }
}

function providerRefusal(failure: LlmFailure, now: number) {
  if (failure._tag === "ProviderInvalidResponse") return refused("ProviderInvalidResponse")
  if (failure._tag === "ProviderRefused" && failure.status >= 400 && failure.status < 500 && failure.status !== 429) return refused("ProviderInvalidResponse")
  return refused("ProviderUnavailable", "NoReason", now + (failure._tag === "ProviderRefused" ? failure.retryAfter ?? providerPause : providerPause))
}

function failureSettlement(failure: LlmFailure): Settlement {
  return failure._tag === "ProviderRefused" && failure.status >= 400 && failure.status < 500
    ? { kind: "known", actual: 0 }
    : { kind: "unknown" }
}

effect function priceUsage(model: Model, usage: unknown): (number | undefined)!! {
  const billed = try billedFromUsage(usage)
  return billed.tag === "Reported" ? try callCostFor(model, billed.counts) : undefined
}

function outcome(actual: number | undefined): Settlement {
  return actual === undefined ? { kind: "unknown" } : { kind: "known", actual }
}

effect function settleAfterClose(holdKey: string, settlement: Settlement): void!!Store {
  settle(holdKey, settlement) catch effect (failure) => {
    try annotateLogs(logError("a chat hold could not settle when the connection closed"), { holdKey, failure: failure._tag })
  }
}

function meteredStream({ upstream, model, priced, holdKey, store, includeUsage }: {
  readonly upstream: Stream.Stream<Uint8Array, LlmFailure>
  readonly model: Model
  readonly priced: Quote
  readonly holdKey: string
  readonly store: typeof Store.Service
  readonly includeUsage: boolean
}) {
  let pending = segmenter()
  let total = 0
  let reported: TokenCounts | undefined
  let deliveredChars = 0
  let usageFrame = ""
  let settled = false
  let failed = false

  const delivered = Stream.flatMap(upstream, (chunk) => {
    const length = Math.min(chunk.byteLength, maxReplyBytes - total)
    const events: number[][] = []
    for (let start = 0; start < length; start += chunkBytes) {
      const next = feed(pending, Array.from(chunk.subarray(start, Math.min(length, start + chunkBytes))))
      pending = next.segmenter
      events.push(...next.events)
      if (pending.line.length + pending.data.length > frameBytes) {
        return Stream.concat(Stream.fromIterable(events), Stream.fail(new ProviderInvalidResponse()))
      }
    }
    total += length
    const frames = Stream.fromIterable(events)
    return length < chunk.byteLength ? Stream.concat(frames, Stream.fail(new ProviderInvalidResponse())) : frames
  })
  const frames = Stream.concat(delivered, Stream.suspend(() => Stream.fromIterable(finish(pending).events)))
  const replies = Stream.flatMap(Stream.takeUntil(frames, isDone), (frame) => Stream.fromEffect(effect {
    if (frame.length > frameBytes) throw new ProviderInvalidResponse()
    if (isDone(frame)) {
      const actual = reported === undefined ? undefined : try callCostFor(model, reported)
      try settle(holdKey, outcome(actual))
      settled = true
      return encoder.encode(usageFrame + doneFrame)
    }
    const payload = readLlmObject(decoder.decode(Uint8Array.from(frame)))
    if (payload === undefined || !Array.isArray(payload.choices)) throw new ProviderInvalidResponse()
    const { usage, ...delta } = payload
    const served = { ...delta, model: model.id }
    if (usage != null && reported === undefined) {
      const billed = try billedFromUsage(usage)
      if (billed.tag === "Reported") {
        reported = billed.counts
        if (includeUsage) usageFrame = chunkFrame(JSON.stringify({ ...served, choices: [], usage }))
      }
    }
    if (payload.choices.length === 0) return undefined
    for (const choice of payload.choices) {
      const read = readDeltaText(choice)
      if (read._tag === "Some") deliveredChars += read.value.delta?.content?.length ?? 0
    }
    return encoder.encode(chunkFrame(JSON.stringify(served)))
  })).pipe(Stream.filter((bytes) => bytes !== undefined))
  const terminal = Stream.suspend(() => settled ? Stream.empty : Stream.fail(new ProviderInvalidResponse()))

  return Stream.concat(replies, terminal).pipe(
    Stream.catch((failure) => Stream.fromEffect(effect {
      failed = true
      const refusal = failure instanceof ProviderInvalidResponse || failure instanceof ProviderUnreachable || failure instanceof ProviderTimedOut || failure instanceof ProviderRefused
        ? providerRefusal(failure, try Clock.currentTimeMillis) : refused("ServiceUnavailable")
      return encoder.encode(errorFrame(JSON.stringify(refusalBody(refusal.refusal))) + doneFrame)
    })),
    Stream.ensuring(effect {
      if (settled) return
      const counts = failed ? reported : hangUpCounts(priced.counts, reported?.inputTokens ?? 0, deliveredChars)
      const actual = counts === undefined ? undefined : try callCostFor(model, counts)
      try settleAfterClose(holdKey, outcome(actual))
    }),
    Stream.provideService(Store, store)
  )
}

effect function chat(context: RouteContext): HttpServerResponse.HttpServerResponse!{ readonly _tag: string }!CloudContext {
  const caller = signed(context.caller)
  if (caller === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const id = context.request.headers["idempotency-key"]
  if (id !== undefined && !requestIdPattern.test(id)) throw refused("InvalidRequest")
  const settings = (try Deployment).settings.inference
  if (settings === undefined) throw refused("CapabilityUnavailable")
  const body = try chatBody(context)
  const store = try Store
  const { model, provider } = try store.transaction((tx) => chooseFor(tx, settings, body.model, hasImage(body)))
  const priced = try quote(body, model)
  const payload = providerBody(body, model.upstreamModel, priced.counts.outputTokens)
  const ticket = try reserve(caller, { service: "MeteredInference", caller: caller.organizationId, requestId: id ?? context.requestId, part: { tag: "WholeRequest" } }, priced.micros)
  if (ticket.replayed) throw refused("AlreadyDispatched")

  let dispatched = false
  const work = effect {
    const standing = effect {
      try recheckServiceAccess(context.request.headers.authorization, caller)
      const now = try Clock.currentTimeMillis
      const lane = try store.transaction((tx) => laneFor(tx, caller.organizationId, "MeteredInference", now))
      if (lane !== ticket.lane) throw refused("BillingStateConflict")
    }
    standing catch effect (failure) => {
      try settleAfterClose(ticket.key, { kind: "release" })
      throw failure
    }
    try Effect.uninterruptible(effect {
      try markDispatched(ticket.key)
      dispatched = true
    })
    if (body.stream === true) {
      const upstream = stream(provider, payload) catch effect (failure) => {
        try settle(ticket.key, failureSettlement(failure))
        throw providerRefusal(failure, try Clock.currentTimeMillis)
      }
      const bodyStream = meteredStream({ upstream, model, priced, holdKey: ticket.key, store, includeUsage: body.stream_options?.include_usage === true })
      return HttpServerResponse.stream(bodyStream, { contentType: "text/event-stream", headers })
    }
    const answer = complete(provider, payload) catch effect (failure) => {
      try settle(ticket.key, failureSettlement(failure))
      throw providerRefusal(failure, try Clock.currentTimeMillis)
    }
    try settle(ticket.key, outcome(try priceUsage(model, answer.usage)))
    return json({ ...answer.json, model: model.id }, { headers })
  }
  return try Effect.onInterrupt(work, () => effect {
    const actual = dispatched ? try callCostFor(model, hangUpCounts(priced.counts, 0, 0)) : undefined
    try settleAfterClose(ticket.key, actual === undefined ? { kind: "release" } : { kind: "known", actual })
  })
}

export const chatRoute: Route = {
  method: "POST", path: "/api/v1/chat/completions", auth: "ServiceAccess", capability: "inference",
  rateClass: "CompletionsRequests", ingressPerMinute: chatIngressPerMinute, maxBodyBytes: 256 * 1024, handler: chat,
}
