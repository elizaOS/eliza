// spec/cloud/returnPages.md, "Story: Bring me back to the app when its link did not open"; spec/cloud/returnPages.md, "Story: Tell a payer the checkout ended"; spec/cloud/deployment.md, "Story: Serve the deployment from a Worker"
import { renderedTemplate } from "./rendered.ts"

/** Where a host reads its built return pages: the package's build output under `serve`, the Worker's static assets on a Worker. */
export service PageTemplates {
  static readonly key = "@elizaos/cloud/pages/PageTemplates"
  static readonly defaultValue = () => ({ read: async (file: string) => renderedTemplate(file) })
  readonly read: (file: string) => Promise<string | undefined>
}
