// spec/cloud/index.md, "Story: Connect Google mail and calendar"; spec/cloud/services/google/mailRead.md, "Story: Notice new mail while I sign in privately"
import type { Client } from "pg"
import type { cloudCredential } from "./identity.vibe"
import { canReadCloudCalendarReminder, currentAttachmentTransfer } from "../gen/cloud.effect.vibe"
import { inboxWatchCanAnswer } from "../gen/cloud__services__google__mailRead.effect.vibe"
import { decodeInboxWatch, inboxArrivalBodyLimit, inboxArrivalPath, inboxWatchBinding, inboxWatchInput, observeInboxWatch, InboxHistoryInvalid, InboxWatchRequestInvalid } from "./services/google/inbox-arrival.vibe"
import { Aead, Digest, SecureRandom } from "effect/crypto"
import { Base64 } from "effect/encoding"
import { FetchHttpClient, HttpClient, HttpClientRequest, HttpServerResponse, HttpServerRequest, HttpIncomingMessage } from "effect/http"
import { attachmentSelection, gmailSearchInput, googleCalendarItem, googleGmailAttachment, googleGmailMessage, googleGmailSearch, googleGmailTriage, GoogleAttachmentMissing, GoogleAttachmentStale, GoogleAttachmentUnsupported, GoogleReadInput, GoogleReadTooLarge, GoogleMailboxResponse, type GoogleReadApi } from "./google-read.vibe"

import { boundedText, ProviderBodyTooLarge } from "./providers/bounded-body.vibe"
import { RateLimited, StorageUnavailable } from "./identity-store.vibe"

export type GoogleEnv = {
  PUBLIC_API_ORIGIN: string
  WEB_ORIGIN: string
  GOOGLE_CLIENT_ID?: string
  GOOGLE_CLIENT_SECRET?: string
  GOOGLE_CONNECT_CLIENT_ID?: string
  GOOGLE_CONNECT_CLIENT_SECRET?: string
  GOOGLE_CONNECT_TOKEN_KEY?: string
}

type Config = { clientId: string; clientSecret: string; key: Aead.Key }
type Capabilities = { mail: boolean; calendar: boolean; send_mail: boolean; trash_mail: boolean; write_calendar: boolean }
type Connection = Capabilities & {
  id: string; account_id: string; subject: string; email: string; refresh_cipher: string; linked_at: Date; last_used_at: Date | null
}
export type LegacyGoogleCustody = Pick<Connection, "account_id" | "subject" | "refresh_cipher" | keyof Capabilities>
schema OAuthResult { access_token: string; refresh_token?: string; scope?: string }
error BadRequest
error AuthorizationFailed
error ConnectionUnavailable
error ProviderUnavailable
error GoogleNotFound
error ItemChanged
error DatabaseUnavailable

const route = "/api/v1/eliza/google"
export const selectedAttachmentPath = route + "/gmail/attachment"
export const deviceAttachmentPath = "/api/v1/google-attachments/device"
const googleOAuth = "https://oauth2.googleapis.com"
const scopeByCapability = {
  mail: "https://www.googleapis.com/auth/gmail.readonly",
  send_mail: "https://www.googleapis.com/auth/gmail.send",
  trash_mail: "https://www.googleapis.com/auth/gmail.modify",
  write_calendar: "https://www.googleapis.com/auth/calendar.events.owned",
  calendar: "https://www.googleapis.com/auth/calendar.events.readonly"
} as const
const encoder = new TextEncoder()
const decoder = new TextDecoder()
const hex = (bytes: Uint8Array) => Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("")
const fromHex = (value: string) => Uint8Array.from(value.match(/../g) ?? [], (pair) => Number.parseInt(pair, 16))
const secureRandom = SecureRandom.layerWebCrypto
const providerLayer = Layer.mergeAll(secureRandom, Digest.layerWebCrypto, Layer.provide(Aead.layerWebCrypto, secureRandom), FetchHttpClient.layer)

function client(env: GoogleEnv) {
  const connector = env.GOOGLE_CONNECT_CLIENT_ID || env.GOOGLE_CONNECT_CLIENT_SECRET
  const id = connector ? env.GOOGLE_CONNECT_CLIENT_ID : env.GOOGLE_CLIENT_ID
  const secret = connector ? env.GOOGLE_CONNECT_CLIENT_SECRET : env.GOOGLE_CLIENT_SECRET
  return id && secret ? { id, secret } : null
}

effect function googleConfig(env: GoogleEnv) {
  const credentials = client(env)
  if (!credentials) throw new ConnectionUnavailable()
  const key = try tokenKey(env.GOOGLE_CONNECT_TOKEN_KEY)
  return { clientId: credentials.id, clientSecret: credentials.secret, key }
}

effect function tokenKey(raw: string | undefined) {
  if (!raw || !/^[a-f0-9A-F]{64}$/.test(raw)) throw new ConnectionUnavailable()
  const key = Aead.key(Aead.aes256Gcm, fromHex(raw)) catch effect () => { throw new ConnectionUnavailable() }
  return key
}

effect function query<Row extends Record<string, unknown>>(db: Client, statement: string, args: (string | boolean | number | null)[]) {
  return try tryPromise({ try: () => db.query<Row>(statement, args), catch: () => new DatabaseUnavailable() })
}

function body(status: number, value: object) {
  return HttpServerResponse.jsonUnsafe(value, { status, headers: { "cache-control": "no-store" } })
}

effect function http(url: string, input: { access?: string; form?: URLSearchParams; json?: object; method?: "POST" | "PATCH" | "DELETE"; version?: string }) {
  const base = input.method === "PATCH" ? HttpClientRequest.patch(url) : input.method === "DELETE" ? HttpClientRequest.make("DELETE")(url) : input.method === "POST" || input.json ? HttpClientRequest.post(url) : HttpClientRequest.get(url)
  let request = input.form
    ? HttpClientRequest.bodyText(HttpClientRequest.post(url), input.form.toString(), "application/x-www-form-urlencoded")
    : input.json ? HttpClientRequest.bodyText(base, JSON.stringify(input.json), "application/json") : base
  if (input.version) request = HttpClientRequest.setHeader(request, "if-match", input.version)
  if (input.access) request = HttpClientRequest.setHeader(request, "authorization", "Bearer " + input.access)
  const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "manual" })
  return timeout(response, "10 seconds") catch effect () => { throw new ProviderUnavailable() }
}

function ok(status: number) {
  return status >= 200 && status < 300
}

effect function oauthToken(config: Config, grant: URLSearchParams) {
  grant.set("client_id", config.clientId)
  grant.set("client_secret", config.clientSecret)
  const response = try http(googleOAuth + "/token", { form: grant })
  if (response.status === 400 || response.status === 401) throw new AuthorizationFailed()
  if (!ok(response.status)) throw new ProviderUnavailable()
  const raw = timeout(response.json, "10 seconds") catch effect () => { throw new ProviderUnavailable() }
  const decoded = Schema.decodeUnknownOption(OAuthResult)(raw)
  if (Option.isNone(decoded) || !decoded.value.access_token) throw new ProviderUnavailable()
  return decoded.value
}

function credentialContext(env: Pick<GoogleEnv, "PUBLIC_API_ORIGIN">, account: string, subject: string, scopes: Capabilities) {
  return encoder.encode(JSON.stringify(["cloud-google-token-v1", env.PUBLIC_API_ORIGIN, account, subject, scopes.mail, scopes.calendar, ...(scopes.send_mail ? ["send_mail"] : []), ...(scopes.trash_mail ? ["trash_mail"] : []), ...(scopes.write_calendar ? ["write_calendar"] : [])]))
}

effect function seal(config: Config, token: string, aad: Uint8Array) {
  const nonce = try (try SecureRandom.SecureRandom).randomBytes(12)
  const vault = try Aead.Aead
  const cipher = vault.encrypt(config.key, encoder.encode(token), { nonce, aad }) catch effect () => { throw new ProviderUnavailable() }
  return hex(nonce) + hex(cipher)
}

effect function unseal(key: Aead.Key, encoded: string, aad: Uint8Array) {
  if (!/^[a-f0-9]+$/.test(encoded) || encoded.length < 58 || encoded.length % 2 !== 0) throw new ConnectionUnavailable()
  const nonce = fromHex(encoded.slice(0, 24))
  const cipher = fromHex(encoded.slice(24))
  const vault = try Aead.Aead
  const plain = vault.decrypt(key, cipher, { nonce, aad }) catch effect () => { throw new ConnectionUnavailable() }
  return decoder.decode(plain)
}

export effect function openLegacyRefreshToken(origin: string, rawKey: string | undefined, connection: LegacyGoogleCustody) {
  const key = try tokenKey(rawKey)
  return try Effect.provide(unseal(key, connection.refresh_cipher, credentialContext({ PUBLIC_API_ORIGIN: origin }, connection.account_id, connection.subject, connection)), providerLayer)
}

effect function accessFor(env: GoogleEnv, db: Client, account: string, capability: keyof Capabilities, selected: string | null) {
  const config = try googleConfig(env)
  const { rows } = try query<Connection>(db, "SELECT * FROM cloud_google_connections WHERE account_id = $1 AND ($2::text IS NULL OR id::text = $2)", [account, selected])
  const connection = rows[0]
  if (!connection?.[capability]) throw new ConnectionUnavailable()
  const refresh = try unseal(config.key, connection.refresh_cipher, credentialContext(env, connection.account_id, connection.subject, connection))
  const credentials = try oauthToken(config, new URLSearchParams({ grant_type: "refresh_token", refresh_token: refresh }))
  if (credentials.scope && !credentials.scope.split(/\s+/).includes(scopeByCapability[capability])) throw new AuthorizationFailed()
  const used = try query(db, "UPDATE cloud_google_connections SET last_used_at = now() WHERE account_id = $1 AND id = $2", [account, connection.id])
  if (!used.rowCount) throw new ConnectionUnavailable()
  return credentials.access_token
}

function googleReadApi(access: string, reportOversize = false): GoogleReadApi<ProviderUnavailable | GoogleNotFound | GoogleReadTooLarge, HttpClient.HttpClient> {
  return effect (url: string, maxBytes?: number) => {
    const response = try http(url, { access })
    if (response.status === 404) throw new GoogleNotFound()
    if (!ok(response.status)) throw new ProviderUnavailable()
    if (maxBytes === undefined) return timeout(response.json, "10 seconds") catch effect () => { throw new ProviderUnavailable() }
    const text = timeout(boundedText(response, maxBytes), "10 seconds") catch effect (failure) => {
      if (reportOversize && failure instanceof ProviderBodyTooLarge) throw new GoogleReadTooLarge()
      throw new ProviderUnavailable()
    }
    return Effect.try(() => JSON.parse(text) as unknown) catch effect () => { throw new ProviderUnavailable() }
  }
}

const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
const providerId = /^[a-zA-Z0-9_-]{1,255}$/

effect function readAction<A>(request: Request, schema: Schema.Decoder<A>) {
  if (request.headers.get("content-type")?.split(";")[0] !== "application/json") throw new BadRequest()
  const message = HttpServerRequest.fromWeb(request)
  const input = Effect.provideService(message.json, HttpIncomingMessage.MaxBodySize, ByteSize.kibibytes(48)) catch effect () => { throw new BadRequest() }
  const result = Schema.decodeUnknownOption(schema, { onExcessProperty: "error" })(input)
  if (Option.isNone(result)) throw new BadRequest()
  return result.value
}

type ReminderRow = { grant_id: string; occurrence_id: string; provider_version: string; lead_minutes: number; fire_at: string; display_title: string }

export function reminderSchedule(request: Request, env: GoogleEnv, db: Client, account: string): Promise<Response> {
  return runPromise(Effect.provide(effect {
    const url = try Effect.try(() => new URL(request.url))
    const target = url.searchParams.get("verify")
    const page = url.searchParams.get("page")
    const cursor = page === null ? null : /^([a-f0-9]{64}):([1-9][0-9]{0,8})$/.exec(page)
    const now = try Clock.currentTimeMillis
    const read = effect {
      if (request.method !== "GET" || (page !== null && cursor === null) || (target !== null && (page !== null || !providerId.test(target))))
        return body(400, { error: "invalid_request" })
      const project = ({ grant_id, occurrence_id, provider_version, lead_minutes, fire_at, display_title }: ReminderRow) => ({
        grantId: grant_id, occurrenceId: occurrence_id, version: provider_version, minutes: lead_minutes, fireAt: Number(fire_at), title: display_title,
      })
      if (target === null) {
        const offset = cursor === null ? 0 : Number(cursor[2])
        const current = try query<{ stamp: string; reminders: Array<ReminderRow> }>(db, `
          WITH eligible AS MATERIALIZED (
            SELECT r.grant_id, r.occurrence_id, r.provider_version, r.lead_minutes, r.fire_at, r.display_title
            FROM cloud_google_calendar_reminders r JOIN cloud_google_connections c ON c.id = r.grant_id
            WHERE r.account_id = $1 AND c.account_id = $1 AND c.calendar AND r.fire_at > $2
          ), page AS (
            SELECT * FROM eligible ORDER BY fire_at, grant_id, occurrence_id COLLATE "C" LIMIT 65 OFFSET $3
          )
          SELECT (SELECT encode(sha256(convert_to($1::text || COALESCE(string_agg(row_to_json(eligible)::text, ''
              ORDER BY fire_at, grant_id, occurrence_id COLLATE "C"), ''), 'UTF8')), 'hex') FROM eligible) AS stamp,
            COALESCE(json_agg(page ORDER BY fire_at, grant_id, occurrence_id COLLATE "C"), '[]'::json) AS reminders FROM page`,
          [account, now - 86400000, offset])
        const snapshot = current.rows[0]
        if (!snapshot || (cursor !== null && cursor[1] !== snapshot.stamp)) return body(409, { error: "schedule_changed" })
        const nextPage = snapshot.reminders.length > 64 ? `${snapshot.stamp}:${offset + 64}` : null
        return body(200, { reminders: snapshot.reminders.slice(0, 64).map(project), nextPage })
      }
      const { rows } = try query<ReminderRow>(db, `
        SELECT r.grant_id, r.occurrence_id, r.provider_version, r.lead_minutes, r.fire_at, r.display_title
        FROM cloud_google_calendar_reminders r JOIN cloud_google_connections c ON c.id = r.grant_id
        WHERE r.account_id = $1 AND c.account_id = $1 AND c.calendar
          AND r.fire_at > $2 AND ($3::text IS NULL OR r.occurrence_id = $3)
        ORDER BY r.fire_at LIMIT 1`, [account, now - 86400000, target])
      const selected = rows[0] ? project(rows[0]) : null
      if (!selected) return body(404, { error: "reminder_unavailable" })
      const api = googleReadApi(try accessFor(env, db, account, "calendar", selected.grantId))
      const { item } = try googleCalendarItem(api, target)
      const current = try query(db, `SELECT 1 FROM cloud_google_calendar_reminders
        WHERE account_id = $1 AND grant_id = $2 AND occurrence_id = $3 AND provider_version = $4 AND fire_at = $5`,
        [account, selected.grantId, selected.occurrenceId, selected.version, selected.fireAt])
      if (!canReadCloudCalendarReminder(true, Boolean(current.rowCount), true,
          item.editable && !item.isAllDay && item.externalId === selected.occurrenceId,
          item.etag === selected.version && Date.parse(item.startAt) - selected.minutes * 60_000 === selected.fireAt))
        return body(409, { error: "reminder_changed" })
      return body(200, selected)
    } catch (failure) => match (failure) {
      when GoogleNotFound: body(404, { error: "reminder_unavailable" });
      default: body(503, { error: "reminder_unavailable" });
    }
    return HttpServerResponse.toWeb(read)
  }, providerLayer)).catch(() => HttpServerResponse.toWeb(body(503, { error: "reminder_unavailable" })))
}

schema TransferRequest { ticket: string }
schema TransferSelection { messageId: string; partId: string; historyId: string; grantId: string; sha256: string; issuedAt: number }

function transferContext(env: GoogleEnv, account: string, organization: string) {
  return encoder.encode(JSON.stringify(["cloud-google-attachment-v1", env.PUBLIC_API_ORIGIN, account, organization]))
}

effect function mailGrant(db: Client, account: string, grant: string | null) {
  const { rows } = try query<{ id: string; organization_id: string; email: string }>(db, `SELECT c.id, a.organization_id, c.email FROM accounts a JOIN cloud_google_connections c ON c.account_id = a.key
    WHERE a.key = $1 AND a.status = 'active' AND ($2::text IS NULL OR c.id::text = $2) AND c.mail`, [account, grant])
  if (!rows[0]?.organization_id) throw new ConnectionUnavailable()
  return rows[0]
}

interface ArrivalAuthorization {
  readonly credential: NonNullable<Awaited<ReturnType<typeof cloudCredential>>>
  readonly current: () => Promise<boolean>
}

effect function arrivalPayload(access: string, path: string) {
  const response = try http("https://gmail.googleapis.com/gmail/v1/users/me" + path, { access })
  if (response.status === 401 || response.status === 403) throw new AuthorizationFailed()
  if (response.status === 404 || response.status === 410) throw new GoogleNotFound()
  if (!ok(response.status)) throw new ProviderUnavailable()
  const text = timeout(boundedText(response, inboxArrivalBodyLimit), "10 seconds") catch effect () => { throw new ProviderUnavailable() }
  return Effect.try(() => JSON.parse(text) as unknown) catch () => undefined
}

effect function inboxArrival(request: Request, url: URL, env: GoogleEnv, db: Client, account: string, authorization: ArrivalAuthorization) {
  const { credential } = authorization
  const { grant: selected, cursor } = try inboxWatchInput(url.searchParams, credential.kind === "device" ? "DeviceWatch" : "BrowserWatch")
  const { id: grant, organization_id: organization } = try mailGrant(db, account, selected ?? null)
  const config = try googleConfig(env)
  const binding = encoder.encode(inboxWatchBinding(env.PUBLIC_API_ORIGIN, account, organization, grant, credential))
  const now = try Clock.currentTimeMillis
  const watch = cursor === undefined ? undefined : (effect {
    const raw = try unseal(config.key, cursor, binding)
    return try decodeInboxWatch(raw, now)
  } catch () => undefined)
  if (cursor !== undefined && watch === undefined) throw new ConnectionUnavailable()
  const access = try accessFor(env, db, account, "mail", grant)
  const answer = try observeInboxWatch(watch, now, (path) => arrivalPayload(access, path))
  const sealed = cursor ?? (try seal(config, JSON.stringify(answer.watch), binding))
  const grantCurrent = (try mailGrant(db, account, grant)).organization_id === organization
  const callerCurrent = try tryPromise({ try: authorization.current, catch: () => new DatabaseUnavailable() })
  if (!callerCurrent) return body(401, { error: "authentication_required" })
  if (!inboxWatchCanAnswer(answer.watch, try Clock.currentTimeMillis, grantCurrent, callerCurrent, !request.signal.aborted))
    throw new ConnectionUnavailable()
  return body(200, { cursor: sealed, arrived: answer.arrived })
}

effect function selectedAttachment(env: GoogleEnv, db: Client, account: string, grant: string, selection: { messageId: string; partId: string; historyId: string }) {
  const api = googleReadApi(try accessFor(env, db, account, "mail", grant))
  const { bytes, ...file } = try googleGmailAttachment(api, selection)
  const organizationId = (try mailGrant(db, account, grant)).organization_id
  const digest = try (try Digest.Digest).digest(Digest.sha256, bytes)
  return { version: 1, accountId: account, organizationId, grantId: grant, ...file, dataBase64: Base64.encode(bytes), sha256: hex(digest), supported: true }
}

effect function redeemAttachment(request: Request, env: GoogleEnv, db: Client, account: string) {
  const { ticket } = try readAction(request, TransferRequest)
  if (ticket.length > 8192) throw new BadRequest()
  const { rows } = try query<{ organization_id: string }>(db, "SELECT organization_id FROM accounts WHERE key = $1 AND status = 'active'", [account])
  const organization = rows[0]?.organization_id
  if (!organization) throw new ConnectionUnavailable()
  const value = try unseal((try googleConfig(env)).key, ticket, transferContext(env, account, organization))
  const raw: unknown = try Effect.try({ try: () => JSON.parse(value), catch: () => new BadRequest() })
  const claims = Schema.decodeUnknownOption(TransferSelection)(raw)
  if (Option.isNone(claims)) throw new BadRequest()
  const selected = claims.value
  if (!currentAttachmentTransfer(selected.issuedAt, try Clock.currentTimeMillis)) throw new ItemChanged()
  const file = try selectedAttachment(env, db, account, selected.grantId, selected)
  if (file.organizationId !== organization || file.sha256 !== selected.sha256 || !currentAttachmentTransfer(selected.issuedAt, try Clock.currentTimeMillis)) throw new ItemChanged()
  return body(200, file)
}

effect function routeGoogle(request: Request, env: GoogleEnv, db: Client, account: string, arrivalAuthorization?: ArrivalAuthorization) {
  const url = try Effect.try({ try: () => new URL(request.url), catch: () => new BadRequest() })
  if (url.pathname === deviceAttachmentPath && request.method === "POST") return try redeemAttachment(request, env, db, account)
  if (request.method !== "GET") return body(404, { error: "route_not_found" })
  const path = url.pathname.slice(route.length)
  if (url.searchParams.has("side") && url.searchParams.get("side") !== "owner") return body(403, { error: "owner_consent_required" })
  if (url.pathname === inboxArrivalPath) return arrivalAuthorization === undefined
    ? body(401, { error: "authentication_required" })
    : try inboxArrival(request, url, env, db, account, arrivalAuthorization)
  const selected = url.searchParams.get("grantId")
  if (url.pathname === selectedAttachmentPath) {
    const selection = attachmentSelection(url.searchParams)
    if (!selected || !uuid.test(selected) || !selection) throw new BadRequest()
    const file = try selectedAttachment(env, db, account, selected, selection)
    if (file.mimeType === "text/plain") return body(200, file)
    const claims = { ...selection, grantId: selected, sha256: file.sha256, issuedAt: try Clock.currentTimeMillis }
    const deviceTransfer = try seal(try googleConfig(env), JSON.stringify(claims), transferContext(env, account, file.organizationId))
    return body(200, { ...file, deviceTransfer })
  }
  if (path === "/gmail/triage" || path === "/gmail/read" || path === "/gmail/search") {
    const now = new Date(try Clock.currentTimeMillis).toISOString()
    const search = path === "/gmail/search" ? try gmailSearchInput(url) : undefined
    const { id: grant, email } = try mailGrant(db, account, selected)
    const api = googleReadApi(try accessFor(env, db, account, "mail", grant), path === "/gmail/read")
    const result = search !== undefined ? try googleGmailSearch(api, search, now, email)
      : path === "/gmail/triage" ? try googleGmailTriage(api, url, now, email)
      : try googleGmailMessage(api, url, email)
    try mailGrant(db, account, grant)
    return body(200, { accountId: account, ...result })
  }
  return body(404, { error: "route_not_found" })
}

export function googleResponse(request: Request, env: GoogleEnv, db: Client, account: string, send: typeof fetch, arrivalAuthorization?: ArrivalAuthorization): Promise<HttpServerResponse.HttpServerResponse> {
  const routed = effect {
    return routeGoogle(request, env, db, account, arrivalAuthorization) catch (error) => match (error) {
      when BadRequest: body(400, { error: "invalid_request" });
      when InboxWatchRequestInvalid: body(400, { error: "invalid_request" });
      when GoogleReadInput: body(400, { error: "invalid_request" });
      when GoogleMailboxResponse: body(502, { error: "provider_invalid_response" });
      when GoogleReadTooLarge: body(413, { error: "content_too_large" });
      when GoogleAttachmentStale: body(409, { error: "google_item_changed" });
      when GoogleAttachmentMissing: body(404, { error: "google_item_not_found" });
      when GoogleAttachmentUnsupported: body(415, { error: "google_attachment_unsupported" });
      when ItemChanged: body(409, { error: "google_item_changed" });
      when GoogleNotFound: body(404, { error: "google_item_not_found" });
      when AuthorizationFailed: body(409, { error: "google_reconnect_required" });
      when ConnectionUnavailable: body(409, { error: "google_connection_unavailable" });
      when DatabaseUnavailable: body(503, { error: "storage_unavailable" });
      when StorageUnavailable: body(503, { error: "storage_unavailable" });
      when RateLimited: body(429, { error: "rate_limited" });
      when ProviderUnavailable: body(502, { error: "google_unavailable" });
      when InboxHistoryInvalid: body(502, { error: "google_unavailable" });
      default: body(502, { error: "google_response_invalid" });
    }
  }
  return runPromise(Effect.provideService(Effect.provide(routed, providerLayer), FetchHttpClient.Fetch, send),
    arrivalAuthorization === undefined ? undefined : { signal: request.signal })
}

export function googleRequest(request: Request, env: GoogleEnv, db: Client, account: string, send: typeof fetch, arrivalAuthorization?: ArrivalAuthorization): Promise<Response> {
  return googleResponse(request, env, db, account, send, arrivalAuthorization).then((response) => HttpServerResponse.toWeb(response))
}
