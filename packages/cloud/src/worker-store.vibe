// spec/cloud/deployment.md, "Story: Configure a deployment from one reviewed profile"; spec/cloud/deployment.md, "A Worker serves only after the server's own start checks pass and its bindings agree with its profile"
import { Client } from "pg"
import { safeIntegerTypes } from "./worker-platform.ts"
import { storeOver, type Connection } from "./store/connection.vibe"

/** The bindings that name the environment and its database. */
export type WorkerDatabase = {
  CLOUD_IDENTITY_DIGEST: string
  CLOUD_ENVIRONMENT: "staging" | "production"
  HYPERDRIVE?: { connectionString: string }
  DATABASE_URL?: string
}

/** How a connection reads int8: as text, as the Worker-only routes expect, or as a safe number, as the server's handlers do. */
export type IntegerReading = "text" | "safe"

/** Opens one connection to the environment's database and refuses it unless the database carries this environment's identity. */
export async function openCloudDatabase(env: WorkerDatabase, integers: IntegerReading = "text"): Promise<Client> {
  const connectionString = env.HYPERDRIVE?.connectionString ?? env.DATABASE_URL
  if (!connectionString || !/^[a-f0-9]{64}$/.test(env.CLOUD_IDENTITY_DIGEST)) throw new Error("cloud database is unconfigured")
  const db = new Client({
    connectionString, connectionTimeoutMillis: 5000, statement_timeout: 15000,
    ...(integers === "safe" ? { types: safeIntegerTypes } : {})
  })
  try {
    await db.connect()
    const identity = await db.query("SELECT 1 FROM public.cloud_identity WHERE singleton AND digest = $1 AND environment = $2", [env.CLOUD_IDENTITY_DIGEST, env.CLOUD_ENVIRONMENT])
    if (identity.rowCount !== 1) throw new Error("cloud database identity mismatch")
    return db
  } catch (failure) {
    await db.end().catch(() => undefined)
    throw failure
  }
}

/** Ends a connection opened by `openCloudDatabase`, never failing. */
export async function closeCloudDatabase(db: Client): Promise<void> {
  await db.end().catch(() => undefined)
}

/** Runs one action on its own identified connection and closes it afterwards. */
export async function withCloudDatabase<T>(env: WorkerDatabase, action: (db: Client) => Promise<T>) {
  const db = await openCloudDatabase(env)
  try {
    return await action(db)
  } finally {
    await closeCloudDatabase(db)
  }
}

/** The server's Store over one Worker connection, one transaction at a time. */
export function clientStore(db: Client) {
  const connection: Connection = {
    query: async (sql, params) => (await db.query(sql, [...params])).rows,
    script: async (sql) => { await db.query(sql) },
    release: async () => {}
  }
  return storeOver({ kind: "connected-pg" }, { permits: 1, connect: async () => connection, close: async () => {} })
}
