// spec/cloud/index.md, "Story: Sign in to the Cloud"
import type { Client } from "pg"
import type { JWTVerifyGetKey } from "jose"
import { Digest, Mac, SecureRandom } from "effect/crypto"
import { FetchHttpClient, HttpClient, HttpClientRequest, HttpIncomingMessage, HttpServerRequest, HttpServerResponse } from "effect/http"

import {
  accessCookie, refreshCookie, accessDigest, deviceDigest, digestCredential, readCookie, newSecret,
  authQuery as query, accountTransaction, browserAccount, signInWithProof, openSignInFamily, renewBrowserSession, logoutBrowserSession,
  rateLimit, RateLimited, StorageUnavailable, IdentityConflict, type BrowserSession, type Identity
} from "./identity-store.vibe"

import { browserNativeRegistration, mobileRegistration, type NativeRegistryEnv } from "./native-registry.vibe"
import { googleServerClientId, verifyNativeGoogle } from "./native-google.vibe"
import { connectSignedInGoogle, nativeGoogleScopes, type GoogleEnv } from "./google.vibe"
import { ownsPasswordBackupPath, passwordBackupRequest } from "./password-backup.vibe"

export type IdentityEnv = NativeRegistryEnv & GoogleEnv & {
  SIGN_IN_EMAIL?: { send(message: { from: string; to: string; subject: string; text: string }): Promise<unknown> }
  RESEND_API_KEY?: string
  EMAIL_FROM?: string
  EMAIL_CODE_SECRET?: string
  BLOOIO_API_KEY?: string
  BLOOIO_SMS_CHANNEL_ID?: string
  TWILIO_ACCOUNT_SID?: string
  TWILIO_AUTH_TOKEN?: string
  TWILIO_VERIFY_SERVICE_SID?: string
  SMS_ALLOWED_COUNTRY_CODES?: string
  SMS_HOURLY_BUDGET?: string
}

type Destination = "email" | "sms"

error InvalidRequest
error Unauthorized
error ProviderUnavailable

schema EmailInput { email: string; code?: string }
schema SmsInput { phone: string; code?: string }
schema GoogleToken { access_token: string }
schema GoogleProfile { sub: string; email?: string; email_verified?: boolean }
schema DeviceAuthorization { challenge: string; state: string }
schema NativeGoogleChallenge { clientId: string; environment: string; redirectUri: string; challenge: string; state: string }
schema NativeGoogleCompletion { clientId: string; environment: string; redirectUri: string; challengeId: string; idToken: string; serverAuthCode?: string }
schema DeviceExchange { code: string; verifier: string }
schema SmsReceipt { status: string; to?: string; channel?: string; service_sid?: string }
schema BlooioReceipt { id: string; channel_id: string; status: string; channel_type?: string; to?: string; direction?: string; dry_run?: boolean }

const flowCookie = "__Host-eliza-google"
const codeSeconds = 10 * 60
const smsCodeSeconds = 5 * 60
const deviceGrantSeconds = 2 * 60
const nativeGoogleStart = "/api/v1/app-auth/mobile/google/challenge"
const nativeGoogleFinish = "/api/v1/app-auth/mobile/google"
const nativeGoogleSeconds = 120
const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i
const s256 = /^[A-Za-z0-9_-]{43}$/
const callbackPath = "/api/auth/google/callback"
const encoder = new TextEncoder()
const opaqueToken = /^[a-f0-9]{64}$/
const pkceText = /^[A-Za-z0-9._~-]{43,128}$/

const hex = (bytes: Uint8Array) => Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("")

const secureRandom = SecureRandom.layerWebCrypto
const cryptoServices = Layer.mergeAll(secureRandom, Digest.layerWebCrypto, Layer.provide(Mac.layerWebCrypto, secureRandom))
const services = Layer.merge(cryptoServices, FetchHttpClient.layer)

effect function sha256(value: string) {
  const digest = try Digest.Digest
  return try digest.digest(Digest.sha256, encoder.encode(value))
}

effect function pkceChallenge(verifier: string) {
  const challenge = try sha256(verifier)
  return try sync(() => btoa(String.fromCharCode(...challenge)).replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", ""))
}

effect function makeCodeHash(secret: string, address: string, code: string) {
  const key = Mac.key(Mac.hmacSha256, encoder.encode(secret)) catch effect () => { throw new ProviderUnavailable() }
  const mac = try Mac.Mac
  const signature = mac.sign(key, encoder.encode(JSON.stringify([address, code]))) catch effect () => { throw new ProviderUnavailable() }
  return hex(signature)
}

effect function token() {
  return hex(try (try SecureRandom.SecureRandom).randomBytes(32))
}

effect function signInCode() {
  return (try (try SecureRandom.SecureRandom).intBetween(0, 999_999)).toString().padStart(6, "0")
}

function cookieValue(name: string, value: string, age: number) {
  return [name, value, { path: "/", httpOnly: true, secure: true, sameSite: "lax", maxAge: Duration.seconds(age) }] as const
}

function sessionCookies(session: BrowserSession) {
  return [cookieValue(accessCookie, session.access, session.accessSeconds), cookieValue(refreshCookie, session.refresh, session.refreshSeconds)]
}

export function sessionAccount(request: Request, db: Client): Promise<string | null> {
  return runPromise(Effect.provide(effect { return (try browserAccount(request, db))?.id ?? null }, cryptoServices))
}

effect function requestCredential(request: Request) {
  if (request.headers.has("authorization")) {
    const hash = try deviceDigest(request)
    return hash ? { kind: "device", hash } : null
  }
  const hash = try accessDigest(request)
  return hash ? { kind: "browser", hash } : null
}

export function cloudCredential(request: Request) {
  return runPromise(Effect.provide(requestCredential(request), cryptoServices))
}

effect function accountForInference(request: Request, db: Client, env: NativeRegistryEnv | undefined) {
  if (!request.headers.has("authorization")) return (try browserAccount(request, db))?.id ?? null
  const registration = env ? browserNativeRegistration(env) : null
  const hash = try deviceDigest(request)
  if (hash === null || !registration) return null
  const now = try Clock.currentTimeMillis
  const { rows } = try query<{ user_id: string }>(db, `
    SELECT d.user_id FROM device_grants d JOIN accounts a ON a.key = d.user_id
    WHERE d.secret_digest = $1 AND d.phase = 'active' AND d.key_expires_at > $2
      AND a.status = 'active' AND d.issued_at >= a.devices_revoked_before AND d.client_id = $3
  `, [hash, now, registration.clientId])
  return rows[0]?.user_id ?? null
}

export function inferenceAccount(request: Request, db: Client, env?: NativeRegistryEnv): Promise<string | null> {
  return runPromise(Effect.provide(accountForInference(request, db, env), cryptoServices))
}

function json(status: number, body: object) {
  return HttpServerResponse.jsonUnsafe(body, { status, headers: { "cache-control": "no-store" } })
}

function redirect(location: string, cookies: ReturnType<typeof cookieValue>[]) {
  const response = HttpServerResponse.redirect(location, { status: 303, headers: { "cache-control": "no-store", "referrer-policy": "no-referrer" } })
  return HttpServerResponse.setCookiesUnsafe(response, cookies)
}

effect function readJson(request: Request) {
  if (request.headers.get("content-type")?.split(";")[0] !== "application/json") throw new InvalidRequest()
  const message = HttpServerRequest.fromWeb(request)
  const limited = Effect.provideService(message.json, HttpIncomingMessage.MaxBodySize, ByteSize.kibibytes(8))
  return limited catch effect () => { throw new InvalidRequest() }
}

effect function external(url: string, input: { authorization?: string; form?: URLSearchParams; body?: string; idempotencyKey?: string }) {
  let request = HttpClientRequest.make(input.form || input.body ? "POST" : "GET")(url)
  if (input.authorization) request = HttpClientRequest.setHeader(request, "authorization", input.authorization)
  if (input.idempotencyKey) request = HttpClientRequest.setHeader(request, "Idempotency-Key", input.idempotencyKey)
  if (input.body) request = HttpClientRequest.bodyText(request, input.body, "application/json")
  if (input.form) request = HttpClientRequest.bodyText(request, input.form.toString(), "application/x-www-form-urlencoded")
  const result = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "manual" })
  return timeout(result, "10 seconds") catch effect () => { throw new ProviderUnavailable() }
}

effect function googleStart(env: IdentityEnv, chooseAccount: boolean) {
  if (!env.GOOGLE_CLIENT_ID || !env.GOOGLE_CLIENT_SECRET) throw new ProviderUnavailable()
  const state = try token()
  const verifier = try token()
  const challenge = try pkceChallenge(verifier)
  const params = new URLSearchParams({
    client_id: env.GOOGLE_CLIENT_ID,
    redirect_uri: env.PUBLIC_API_ORIGIN + callbackPath,
    response_type: "code",
    scope: "openid email",
    include_granted_scopes: "false",
    state,
    code_challenge: challenge,
    code_challenge_method: "S256"
  })
  if (chooseAccount) params.set("prompt", "select_account")
  return redirect("https://accounts.google.com/o/oauth2/v2/auth?" + params, [cookieValue(flowCookie, state + "." + verifier, codeSeconds)])
}

effect function googleIdentity(request: Request, url: URL, env: IdentityEnv) {
  if (!env.GOOGLE_CLIENT_ID || !env.GOOGLE_CLIENT_SECRET) throw new ProviderUnavailable()
  const flow = readCookie(request, flowCookie)
  if (flow === null || !/^[a-f0-9]{64}\.[a-f0-9]{64}$/.test(flow)) throw new Unauthorized()
  const [state, verifier] = flow.split(".")
  const code = url.searchParams.get("code")
  if (!code || code.length > 2048 || url.searchParams.get("state") !== state || url.searchParams.has("error")) throw new Unauthorized()
  const response = try external("https://oauth2.googleapis.com/token", {
    form: new URLSearchParams({
      client_id: env.GOOGLE_CLIENT_ID,
      client_secret: env.GOOGLE_CLIENT_SECRET,
      redirect_uri: env.PUBLIC_API_ORIGIN + callbackPath,
      grant_type: "authorization_code",
      code,
      code_verifier: verifier
    })
  })
  if (response.status < 200 || response.status >= 300) throw new Unauthorized()
  const token = Schema.decodeUnknownOption(GoogleToken)((response.json catch effect () => { throw new ProviderUnavailable() }))
  if (Option.isNone(token)) throw new ProviderUnavailable()
  const user = try external("https://openidconnect.googleapis.com/v1/userinfo", {
    authorization: "Bearer " + token.value.access_token
  })
  if (user.status < 200 || user.status >= 300) throw new ProviderUnavailable()
  const profile = Schema.decodeUnknownOption(GoogleProfile)((user.json catch effect () => { throw new ProviderUnavailable() }))
  if (Option.isNone(profile) || !/^[a-zA-Z0-9_-]{1,255}$/.test(profile.value.sub)) throw new ProviderUnavailable()
  return {
    provider: "google",
    subject: profile.value.sub,
    email: profile.value.email_verified === true ? profile.value.email ?? null : null
  } satisfies Identity
}

effect function otpInput(request: Request, kind: Destination, verify: boolean) {
  const raw = try readJson(request)
  if (kind === "email") {
    const value = Schema.decodeUnknownOption(EmailInput)(raw)
    if (Option.isNone(value)) throw new InvalidRequest()
    const address = value.value.email.trim().toLowerCase()
    if (address.length > 254 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(address)) throw new InvalidRequest()
    const code = value.value.code ?? ""
    if (verify && !/^\d{6}$/.test(code)) throw new InvalidRequest()
    return { address, code }
  }
  const value = Schema.decodeUnknownOption(SmsInput)(raw)
  if (Option.isNone(value)) throw new InvalidRequest()
  if (!/^\+[1-9]\d{6,14}$/.test(value.value.phone)) throw new InvalidRequest()
  const code = value.value.code ?? ""
  if (verify && !/^\d{6}$/.test(code)) throw new InvalidRequest()
  return { address: value.value.phone, code }
}

function smsBudget(env: IdentityEnv) {
  const allowed = (env.SMS_ALLOWED_COUNTRY_CODES ?? "").split(",").map((code) => code.trim()).filter(Boolean)
  const hourly = Number(env.SMS_HOURLY_BUDGET)
  if (!allowed.length || allowed.some((code) => !/^\+[1-9]\d{0,2}$/.test(code)) || !Number.isSafeInteger(hourly) || hourly <= 0) return null
  return { allowed, hourly }
}

function emailReady(env: IdentityEnv) {
  return Boolean((env.SIGN_IN_EMAIL || env.RESEND_API_KEY) && env.EMAIL_FROM && env.EMAIL_CODE_SECRET && env.EMAIL_CODE_SECRET.length >= 32)
}

function smsTransport(env: IdentityEnv) {
  if (env.BLOOIO_API_KEY || env.BLOOIO_SMS_CHANNEL_ID) {
    return env.BLOOIO_API_KEY && /^ch_[A-Za-z0-9_-]+$/.test(env.BLOOIO_SMS_CHANNEL_ID ?? "") && (env.EMAIL_CODE_SECRET?.length ?? 0) >= 32 ? "blooio" : null
  }
  return env.TWILIO_ACCOUNT_SID && env.TWILIO_AUTH_TOKEN && env.TWILIO_VERIFY_SERVICE_SID ? "twilio" : null
}

function smsReady(env: IdentityEnv) {
  return Boolean(smsTransport(env) && smsBudget(env))
}

effect function sendEmail(env: IdentityEnv, address: string, code: string) {
  if (!env.EMAIL_FROM) throw new ProviderUnavailable()
  const message = {
    from: env.EMAIL_FROM, to: address, subject: "Your sign-in code",
    text: `Your sign-in code is ${code}. It expires in ten minutes. If you did not request this code, you can ignore this email.`
  }
  const binding = env.SIGN_IN_EMAIL
  if (binding) {
    try Effect.tryPromise({ try: () => binding.send(message), catch: () => new ProviderUnavailable() })
    return
  }
  if (!env.RESEND_API_KEY) throw new ProviderUnavailable()
  const sent = try external("https://api.resend.com/emails", {
    authorization: "Bearer " + env.RESEND_API_KEY,
    body: JSON.stringify({ ...message, to: [address] })
  })
  if (sent.status < 200 || sent.status >= 300) throw new ProviderUnavailable()
}

effect function twilio(env: IdentityEnv, address: string, code: string | null) {
  if (!env.TWILIO_ACCOUNT_SID || !env.TWILIO_AUTH_TOKEN || !env.TWILIO_VERIFY_SERVICE_SID) throw new ProviderUnavailable()
  if (!/^AC[a-fA-F0-9]{32}$/.test(env.TWILIO_ACCOUNT_SID) || !/^VA[a-fA-F0-9]{32}$/.test(env.TWILIO_VERIFY_SERVICE_SID)) throw new ProviderUnavailable()
  const basic = try sync(() => btoa(env.TWILIO_ACCOUNT_SID + ":" + env.TWILIO_AUTH_TOKEN))
  const path = code === null ? "Verifications" : "VerificationCheck"
  const response = try external(`https://verify.twilio.com/v2/Services/${env.TWILIO_VERIFY_SERVICE_SID}/${path}`, {
    authorization: "Basic " + basic,
    form: new URLSearchParams(code === null ? { To: address, Channel: "sms" } : { To: address, Code: code })
  })
  if (response.status === 429) throw new RateLimited()
  if (code !== null && (response.status === 400 || response.status === 404)) throw new Unauthorized()
  if (response.status < 200 || response.status >= 300) throw new ProviderUnavailable()
  const receipt = Schema.decodeUnknownOption(SmsReceipt)((response.json catch effect () => { throw new ProviderUnavailable() }))
  if (Option.isNone(receipt)) throw new ProviderUnavailable()
  const result = receipt.value
  if ((result.to !== undefined && result.to !== address) ||
      (result.channel !== undefined && result.channel !== "sms") ||
      (result.service_sid !== undefined && result.service_sid !== env.TWILIO_VERIFY_SERVICE_SID)) throw new ProviderUnavailable()
  if (code !== null && result.status !== "approved") throw new Unauthorized()
  if (code === null && result.status !== "pending") throw new ProviderUnavailable()
}

const codeCookie = (provider: Destination) => "__Host-eliza-code-" + provider

effect function sendBlooio(env: IdentityEnv, address: string, code: string, challenge: string) {
  if (!env.BLOOIO_API_KEY || !env.BLOOIO_SMS_CHANNEL_ID) throw new ProviderUnavailable()
  const response = try external("https://api.blooio.com/v4/messages", {
    authorization: "Bearer " + env.BLOOIO_API_KEY, idempotencyKey: challenge,
    body: JSON.stringify({ from: env.BLOOIO_SMS_CHANNEL_ID, to: address, text: `Your sign-in code is ${code}. It expires in five minutes.` })
  })
  if (response.status === 429) throw new RateLimited()
  if (response.status < 200 || response.status >= 300) throw new ProviderUnavailable()
  const receipt = Schema.decodeUnknownOption(BlooioReceipt)((response.json catch effect () => { throw new ProviderUnavailable() }))
  if (Option.isNone(receipt)) throw new ProviderUnavailable()
  const result = receipt.value
  if (!result.id || result.channel_id !== env.BLOOIO_SMS_CHANNEL_ID || result.dry_run === true ||
      (result.channel_type !== undefined && result.channel_type !== "sms") ||
      (result.to !== undefined && result.to !== address) || (result.direction !== undefined && result.direction !== "outbound") ||
      !["queued", "pending", "sending", "sent", "delivered", "read"].includes(result.status)) throw new ProviderUnavailable()
}

effect function requestCode(env: IdentityEnv, db: Client, provider: Destination, address: string) {
  const code = provider === "email" || smsTransport(env) === "blooio" ? try signInCode() : null
  const secret = env.EMAIL_CODE_SECRET
  if (code !== null && (!secret || secret.length < 32)) throw new ProviderUnavailable()
  const hash = code !== null && secret ? try makeCodeHash(secret, provider === "sms" ? "sms:" + address : address, code) : null
  const verifier = try token()
  const challenge = try pkceChallenge(verifier)
  const age = provider === "email" ? codeSeconds : smsCodeSeconds
  const { rows } = try query<{ expires_at: Date }>(db, `
    INSERT INTO cloud_code_challenges (provider, destination, challenge, code_hash, expires_at, tries, consumed)
    VALUES ($1, $2, $3, $4, now() + $5 * interval '1 second', 0, false)
    ON CONFLICT (provider, destination) DO UPDATE
    SET challenge = EXCLUDED.challenge, code_hash = EXCLUDED.code_hash, expires_at = EXCLUDED.expires_at, tries = 0, consumed = false
    RETURNING expires_at
  `, [provider, address, challenge, hash, age])
  const pending = rows[0]
  if (!pending) throw new StorageUnavailable()
  effect {
    if (code === null) try twilio(env, address, null)
    else if (provider === "email") try sendEmail(env, address, code)
    else try sendBlooio(env, address, code, challenge)
  } catch effect (failure) => {
    try query(db, "DELETE FROM cloud_code_challenges WHERE provider = $1 AND destination = $2 AND challenge = $3", [provider, address, challenge])
    throw failure
  }
  return HttpServerResponse.setCookiesUnsafe(json(200, { ok: true, expiresAt: pending.expires_at, codeLength: 6 }),
    [cookieValue(codeCookie(provider), verifier, age)])
}

effect function verifyCode(request: Request, env: IdentityEnv, db: Client, provider: Destination, address: string, code: string) {
  const verifier = readCookie(request, codeCookie(provider))
  if (!verifier || !opaqueToken.test(verifier)) throw new Unauthorized()
  const challenge = try pkceChallenge(verifier)
  const secret = env.EMAIL_CODE_SECRET
  const hash = secret ? try makeCodeHash(secret, provider === "sms" ? "sms:" + address : address, code) : null
  const attempt = try query<{ consumed: boolean; requires_twilio: boolean }>(db, `
    UPDATE cloud_code_challenges
    SET tries = tries + 1, consumed = COALESCE(code_hash = $4, false)
    WHERE provider = $1 AND destination = $2 AND challenge = $3 AND expires_at > now() AND tries < 5 AND NOT consumed
    RETURNING consumed, (provider = 'sms' AND code_hash IS NULL) AS requires_twilio
  `, [provider, address, challenge, hash])
  const admitted = attempt.rows[0]
  if (!admitted || (!admitted.requires_twilio && !admitted.consumed)) throw new Unauthorized()
  if (admitted.requires_twilio) {
    try twilio(env, address, code)
    const finished = try query(db, `
      UPDATE cloud_code_challenges SET consumed = true
      WHERE provider = $1 AND destination = $2 AND challenge = $3 AND expires_at > now() AND NOT consumed
      RETURNING consumed
    `, [provider, address, challenge])
    if (!finished.rowCount) throw new Unauthorized()
  }
  const session = try signInWithProof(db, { provider, subject: address, email: provider === "email" ? address : null })
  return HttpServerResponse.setCookiesUnsafe(json(200, { account: session.account }),
    [...sessionCookies(session), cookieValue(codeCookie(provider), "", 0)])
}

effect function otp(request: Request, env: IdentityEnv, db: Client, provider: Destination, verify: boolean) {
  const input = try otpInput(request, provider, verify)
  const budget = provider === "sms" ? smsBudget(env) : null
  if (provider === "sms") {
    if (!smsReady(env) || !budget) throw new ProviderUnavailable()
    if (!budget.allowed.some((code) => input.address.startsWith(code))) throw new InvalidRequest()
  } else if (!emailReady(env)) {
    throw new ProviderUnavailable()
  }
  const ip = request.headers.get("cf-connecting-ip") ?? "local"
  const action = verify ? "verify" : "send"
  try accountTransaction(db, effect {
    try rateLimit(db, provider + ":" + action + ":ip", ip, verify ? 10 : provider === "sms" ? 5 : 30, 60)
    try rateLimit(db, provider + ":" + action + ":destination", input.address, 5, 600)
    if (!verify && budget) try rateLimit(db, "sms:send:deployment", "all", budget.hourly, 3600)
  })
  if (verify) return try verifyCode(request, env, db, provider, input.address, input.code)
  return try requestCode(env, db, provider, input.address)
}

export function nativeGooglePath(path: string) {
  return path === nativeGoogleStart || path === nativeGoogleFinish
}

function nativeGoogleAudience(env: IdentityEnv): string | null {
  return env.GOOGLE_CLIENT_SECRET && env.GOOGLE_CLIENT_ID && googleServerClientId.test(env.GOOGLE_CLIENT_ID) ? env.GOOGLE_CLIENT_ID : null
}

effect function issueDeviceCode(db: Client, proof: { accountId: string; sessionKey: string; clientId: string; challenge: string }) {
  const now = try Clock.currentTimeMillis
  const code = try token()
  const codeHash = try digestCredential(code)
  const key = try (try SecureRandom.SecureRandom).uuidV4()
  try query(db, `
    WITH created AS (
      INSERT INTO device_grants (key,state,revision,user_id,client_id,phase,code_digest,code_expires_at,issued_at,updated_at)
      VALUES ($1,jsonb_build_object('phase','CodeIssued'),1,$2,$3,'code_issued',$4,$5,$6,$6) RETURNING key
    )
    INSERT INTO cloud_device_proofs (grant_key, session_key, challenge)
    SELECT key,$7,$8 FROM created
  `, [key, proof.accountId, proof.clientId, codeHash, now + deviceGrantSeconds * 1000, now, proof.sessionKey, proof.challenge])
  return code
}

effect function nativeGoogle(request: Request, env: IdentityEnv, db: Client, starting: boolean, keys?: JWTVerifyGetKey) {
  if (request.headers.has("origin")) return json(403, { error: "forbidden_origin" })
  const raw = try readJson(request)
  const input = starting
    ? Schema.decodeUnknownOption(NativeGoogleChallenge, { onExcessProperty: "error" })(raw)
    : Schema.decodeUnknownOption(NativeGoogleCompletion, { onExcessProperty: "error" })(raw)
  if (input._tag === "None") throw new InvalidRequest()
  const { clientId, environment, redirectUri } = input.value
  const admitted = mobileRegistration(env, clientId, environment, redirectUri)
  if (admitted.kind === "refused") return json(admitted.status, { error: admitted.error })
  const audience = nativeGoogleAudience(env)
  if (!audience) return json(503, { error: "google_not_configured" })
  if (!admitted.registration.nativeGoogle || browserNativeRegistration(env)?.clientId !== admitted.registration.clientId) {
    return json(400, { error: "invalid_client" })
  }
  const ip = request.headers.get("cf-connecting-ip") ?? "local"
  const now = try Clock.currentTimeMillis
  if ("challenge" in input.value) {
    const { challenge, state } = input.value
    if (!s256.test(challenge) || !pkceText.test(state)) throw new InvalidRequest()
    try rateLimit(db, "google:native:challenge", ip, 10, 60)
    const challengeId = try (try SecureRandom.SecureRandom).uuidV4()
    const nonce = try token()
    const nonceHash = try digestCredential(nonce)
    try query(db, "DELETE FROM cloud_native_google_challenges WHERE expires_at <= $1", [now])
    try query(db, `
      INSERT INTO cloud_native_google_challenges (key,client_id,environment,redirect_uri,audience,nonce_digest,challenge,state,expires_at)
      VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)
    `, [challengeId, clientId, environment, redirectUri, audience, nonceHash, challenge, state, now + nativeGoogleSeconds * 1000])
    return json(200, { challengeId, nonce, expiresIn: nativeGoogleSeconds })
  }
  const { challengeId, idToken } = input.value
  if (!uuid.test(challengeId) || idToken.length > 7500 || idToken.split(".").length !== 3) throw new InvalidRequest()
  try rateLimit(db, "google:native:verify", ip, 10, 60)
  const pending = try query(db, `
    SELECT key FROM cloud_native_google_challenges
    WHERE key = $1 AND client_id = $2 AND environment = $3 AND redirect_uri = $4 AND audience = $5 AND expires_at > $6
  `, [challengeId, clientId, environment, redirectUri, audience, now])
  if (pending.rows.length === 0) throw new Unauthorized()
  const verified = verifyNativeGoogle(idToken, audience, keys) catch effect () => { throw new Unauthorized() }
  const nonceHash = try digestCredential(verified.nonce)
  const signedIn = try accountTransaction(db, effect {
    const verifiedAt = try Clock.currentTimeMillis
    const { rows } = try query<{ challenge: string; state: string }>(db, `
      DELETE FROM cloud_native_google_challenges
      WHERE key = $1 AND client_id = $2 AND environment = $3 AND redirect_uri = $4 AND audience = $5
        AND nonce_digest = $6 AND expires_at > $7
      RETURNING challenge,state
    `, [challengeId, clientId, environment, redirectUri, audience, nonceHash, verifiedAt])
    const proof = rows[0]
    if (!proof) throw new Unauthorized()
    const family = try openSignInFamily(db, verified.identity)
    const code = try issueDeviceCode(db, {
      accountId: family.account.id, sessionKey: family.key, clientId: admitted.registration.clientId, challenge: proof.challenge
    })
    return { code, state: proof.state, accountId: family.account.id }
  })
  const { serverAuthCode } = input.value
  if (serverAuthCode === undefined) return json(200, { code: signedIn.code, state: signedIn.state })
  const connected = try Effect.promise(() => connectSignedInGoogle(env, db, signedIn.accountId, verified.identity.subject, serverAuthCode))
  return json(200, { code: signedIn.code, state: signedIn.state, google: { connected } })
}

effect function authorizeDevice(request: Request, env: IdentityEnv, db: Client) {
  const registration = browserNativeRegistration(env)
  if (!registration) throw new ProviderUnavailable()
  const callback = try Effect.try({ try: () => new URL(registration.signInReturn.origin + registration.signInReturn.path), catch: () => new ProviderUnavailable() })
  const browser = try browserAccount(request, db)
  if (!browser) throw new Unauthorized()
  const raw = try readJson(request)
  const parsed = Schema.decodeUnknownOption(DeviceAuthorization, { onExcessProperty: "error" })(raw)
  if (Option.isNone(parsed) || !s256.test(parsed.value.challenge) || !pkceText.test(parsed.value.state)) throw new InvalidRequest()
  try rateLimit(db, "device:authorize", browser.sessionKey, 6, 600)
  const code = try issueDeviceCode(db, {
    accountId: browser.id, sessionKey: browser.sessionKey, clientId: registration.clientId, challenge: parsed.value.challenge
  })
  callback.searchParams.set("code", code)
  callback.searchParams.set("state", parsed.value.state)
  return json(200, { redirectUrl: callback.href })
}

effect function exchangeDevice(request: Request, env: IdentityEnv, db: Client) {
  const registration = browserNativeRegistration(env)
  if (!registration) throw new ProviderUnavailable()
  const raw = try readJson(request)
  const parsed = Schema.decodeUnknownOption(DeviceExchange, { onExcessProperty: "error" })(raw)
  if (Option.isNone(parsed) || !opaqueToken.test(parsed.value.code) || !pkceText.test(parsed.value.verifier)) throw new InvalidRequest()
  const codeHash = try digestCredential(parsed.value.code)
  const challenge = try pkceChallenge(parsed.value.verifier)
  const bearer = try newSecret("device")
  const bearerHash = try digestCredential(bearer)
  const credential = try (try SecureRandom.SecureRandom).uuidV4()
  const now = try Clock.currentTimeMillis
  const { rows } = try query<{ id: string; organization_id: string }>(db, `
    UPDATE device_grants d SET phase = 'exchanged', state = jsonb_build_object('phase','Exchanged'),
      credential_id = $4, secret_digest = $5, key_expires_at = $6, revision = d.revision + 1, updated_at = $3, code_digest = NULL
    FROM cloud_device_proofs p JOIN sessions s ON s.key = p.session_key JOIN accounts a ON a.key = s.user_id
    WHERE d.key = p.grant_key AND d.user_id = a.key AND d.phase = 'code_issued' AND d.code_digest = $1 AND p.challenge = $2
      AND d.code_expires_at > $3 AND s.refresh_expires_at > $3 AND s.live AND a.status = 'active'
      AND (s.state->>'epoch')::bigint = a.sessions_revoked_before
      AND d.issued_at >= a.devices_revoked_before AND d.client_id = $7
    RETURNING a.key AS id, a.organization_id
  `, [codeHash, challenge, now, credential, bearerHash, now + registration.credentialTtl, registration.clientId])
  const device = rows[0]
  if (!device) throw new Unauthorized()
  return json(200, { token: bearer, expiresIn: Math.floor(registration.credentialTtl / 1000), accountId: device.id, organizationId: device.organization_id })
}

const empty = () => HttpServerResponse.empty({ status: 204, headers: { "cache-control": "no-store" } })

effect function acknowledgeDevice(request: Request, env: IdentityEnv, db: Client) {
  const registration = browserNativeRegistration(env)
  if (!registration) throw new ProviderUnavailable()
  const hash = try deviceDigest(request)
  if (hash === null) throw new Unauthorized()
  const now = try Clock.currentTimeMillis
  const { rowCount } = try query(db, `
    UPDATE device_grants d SET phase = 'active', state = jsonb_build_object('phase','Active'),
      revision = d.revision + CASE WHEN d.phase = 'exchanged' THEN 1 ELSE 0 END,
      updated_at = CASE WHEN d.phase = 'exchanged' THEN $2 ELSE d.updated_at END
    FROM cloud_device_proofs p JOIN sessions s ON s.key = p.session_key JOIN accounts a ON a.key = s.user_id
    WHERE d.key = p.grant_key AND d.user_id = a.key AND d.secret_digest = $1
      AND d.key_expires_at > $2 AND d.issued_at >= a.devices_revoked_before AND a.status = 'active' AND d.client_id = $3
      AND (d.phase = 'active' OR (d.phase = 'exchanged' AND d.code_expires_at > $2 AND s.live
        AND s.refresh_expires_at > $2 AND (s.state->>'epoch')::bigint = a.sessions_revoked_before))
    RETURNING d.key
  `, [hash, now, registration.clientId])
  if (!rowCount) throw new Unauthorized()
  return empty()
}

effect function revokeDevice(request: Request, db: Client) {
  const hash = try deviceDigest(request)
  if (hash === null) throw new Unauthorized()
  const now = try Clock.currentTimeMillis
  try query(db, `
    UPDATE device_grants SET phase = 'ended', state = jsonb_build_object('phase','Ended'), revision = revision + 1, updated_at = $2
    WHERE secret_digest = $1 AND phase IN ('exchanged', 'active')
  `, [hash, now])
  return empty()
}

effect function handleIdentity(request: Request, env: IdentityEnv, db: Client, keys?: JWTVerifyGetKey) {
  const url = try Effect.try({ try: () => new URL(request.url), catch: () => new InvalidRequest() })
  if (request.method === "GET") {
    switch (url.pathname) {
      case "/api/v1/app-auth/mobile/config": {
        const id = url.searchParams.get("clientId")
        const environment = url.searchParams.get("environment")
        const redirect = url.searchParams.get("redirectUri")
        const matched = mobileRegistration(env, id, environment, redirect)
        if (matched.kind === "refused") return json(matched.status, { error: matched.error })
        const registered = matched.registration
        const configured = Boolean(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET)
        return json(200, {
          clientId: registered.clientId, environment, redirectUri: redirect, codeChallengeMethod: "S256",
          credentialTtlMs: registered.credentialTtl, methods: { google: configured, email: emailReady(env), sms: smsReady(env) },
          google: { configured, serverClientId: configured ? env.GOOGLE_CLIENT_ID : "",
            nativeSignIn: registered.nativeGoogle && nativeGoogleAudience(env) !== null &&
              browserNativeRegistration(env)?.clientId === registered.clientId, scopes: nativeGoogleScopes }
        })
      }
      case "/api/auth/providers":
        return json(200, { google: Boolean(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET), email: emailReady(env), sms: smsReady(env) })
      case "/api/auth/session": {
        const account = try browserAccount(request, db)
        return json(200, { account: account ? { id: account.id, email: account.email } : null })
      }
      case "/api/auth/google/start":
        return try googleStart(env, url.searchParams.get("password_backup") === "1")
      case callbackPath: {
        const clear = cookieValue(flowCookie, "", 0)
        return effect {
          const identity = try googleIdentity(request, url, env)
          const session = try signInWithProof(db, identity)
          return redirect(env.WEB_ORIGIN + "/#account", [clear, ...sessionCookies(session)])
        } catch () => redirect(env.WEB_ORIGIN + "/?authError=google_failed#account", [clear])
      }
    }
  }
  if (request.method === "POST") {
    if (nativeGooglePath(url.pathname)) return try nativeGoogle(request, env, db, url.pathname === nativeGoogleStart, keys)
    if (url.pathname === "/api/auth/device/exchange") return try exchangeDevice(request, env, db)
    if (url.pathname === "/api/auth/device/ack") return try acknowledgeDevice(request, env, db)
    if (url.pathname === "/api/auth/device/revoke") return try revokeDevice(request, db)
    const origin = request.headers.get("origin")
    if (origin !== env.WEB_ORIGIN && origin !== env.PUBLIC_API_ORIGIN) return json(403, { error: "forbidden_origin" })
    switch (url.pathname) {
      case "/api/auth/device/authorize":
        return try authorizeDevice(request, env, db)
      case "/api/auth/email/send":
        return try otp(request, env, db, "email", false)
      case "/api/auth/email/verify":
        return try otp(request, env, db, "email", true)
      case "/api/auth/sms/send":
        return try otp(request, env, db, "sms", false)
      case "/api/auth/sms/verify":
        return try otp(request, env, db, "sms", true)
      case "/api/auth/refresh": {
        const session = try renewBrowserSession(request, db)
        if (!session) return HttpServerResponse.setCookiesUnsafe(json(401, { error: "authentication_required" }),
          [cookieValue(accessCookie, "", 0), cookieValue(refreshCookie, "", 0)])
        return HttpServerResponse.setCookiesUnsafe(json(200, { account: session.account }), sessionCookies(session))
      }
      case "/api/auth/logout": {
        try logoutBrowserSession(request, db)
        return HttpServerResponse.setCookiesUnsafe(empty(), [cookieValue(accessCookie, "", 0), cookieValue(refreshCookie, "", 0)])
      }
    }
  }
  return json(404, { error: "not_found" })
}

export function identityRequest(request: Request, env: IdentityEnv, db: Client, keys?: JWTVerifyGetKey): Promise<Response> {
  if (ownsPasswordBackupPath(new URL(request.url).pathname)) return passwordBackupRequest(request, env, db)
  return runPromise(Effect.provide(effect {
    const response = handleIdentity(request, env, db, keys) catch (error) => match (error) {
      when InvalidRequest: json(400, { error: "invalid_request" });
      when Unauthorized: json(401, { error: "verification_failed" });
      when RateLimited: json(429, { error: "rate_limited" });
      when ProviderUnavailable: json(503, { error: "provider_unavailable" });
      when StorageUnavailable: json(503, { error: "storage_unavailable" });
      when IdentityConflict: json(409, { error: "identity_conflict" });
    }
    return HttpServerResponse.toWeb(response)
  }, services))
}
