// spec/cloud/shared/types.md, "Story: Speak one refusal language"; spec/cloud/services/inference.md, "A provider's 400 keeps only its listed code and parameter and a short message for the caller"
import { refuse, refuseFor, refuseUntil, refuseAllowance, retryAfterSeconds, statusOf, retryableOf, type Refusal, type RefusalCode, type RefusalReason } from "../../gen/cloud__shared__types.effect.vibe"

export type { Refusal, RefusalCode, RefusalReason }

export interface ProviderFields {
  readonly code?: string
  readonly param?: string
  readonly providerMessage?: string
}

export error Refused { refusal: Refusal; fields?: ProviderFields }

export interface RefusalBody extends ProviderFields {
  readonly error: string
  readonly errorDescription: string
  readonly retryable: boolean
  readonly retryAt?: number
  readonly resetsAt?: number
  readonly reason?: string
}

export function wireName(name: string): string {
  return name.replace(/(?<=[a-z0-9])(?=[A-Z])/g, "_").toLowerCase()
}

export function refused(code: RefusalCode, reason: RefusalReason = "NoReason", retryAt = 0): Refused {
  const refusal = code === "AllowanceExhausted" ? refuseAllowance(retryAt)
    : retryAt > 0 ? refuseUntil(code, retryAt)
    : reason === "NoReason" ? refuse(code) : refuseFor(code, reason)
  return new Refused({ refusal })
}

export function refusalBody(value: Refusal, fields: ProviderFields = {}): RefusalBody {
  const error = wireName(value.code)
  const reason = value.reason === "NoReason" ? undefined : wireName(value.reason)
  const words = error.replaceAll("_", " ")
  return {
    error,
    errorDescription: `${words.charAt(0).toUpperCase()}${words.slice(1)}${reason === undefined ? "" : ` (${reason.replaceAll("_", " ")})`}.`,
    retryable: retryableOf(value),
    ...(value.wait.tag === "RetryAt" ? { retryAt: value.wait.retryAtMs } : {}),
    ...(value.wait.tag === "ResetsAt" ? { resetsAt: value.wait.resetsAtMs } : {}),
    ...(reason === undefined ? {} : { reason }),
    ...fields
  }
}

export function refusalResponse(value: Refusal, now: number, fields: ProviderFields = {}): HttpServerResponse.HttpServerResponse {
  const status = statusOf(value.code)
  const retryAfter = value.wait.tag === "RetryAt" && (status === 429 || status === 503)
    ? String(retryAfterSeconds(value.wait.retryAtMs, now)) : undefined
  return HttpServerResponse.jsonUnsafe(refusalBody(value, fields), {
    status,
    headers: {
      "cache-control": "no-store",
      ...(retryAfter === undefined ? {} : { "retry-after": retryAfter })
    }
  })
}
