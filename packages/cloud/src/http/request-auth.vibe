// spec/cloud/identity/requestAuth.md, "Story: Admit a request only for a live credential of an active account"; spec/cloud/shared/rateLimit.md, "Story: Refuse excess requests with a usable retry time"
import { admit as admission, isProtected, keyIngress, keyIngressLimit, type Admission, type Presented, type RouteClass as CredentialRoute, type Standing } from "../../gen/cloud__identity__requestAuth.effect.vibe"
import type { AccountStatus } from "../../gen/cloud__identity__accounts.effect.vibe"
import { decodeState as decodeFamily, type Moment, type RouteClass } from "../../gen/cloud__identity__sessions.effect.vibe"
import { decodeState as decodeGrant } from "../../gen/cloud__nativeClients__deviceKeys.effect.vibe"
import { admitsAll, initial as uncounted, unavailableRefusal, type Window } from "../../gen/cloud__shared__rateLimit.effect.vibe"
import { Refused } from "./refusal.vibe"
import { Deployment, type SecretMissing } from "../profile/profile.vibe"
import { admitCheck, readWindow, type LimitCheck } from "../shared/rate-limit.vibe"
import { keyedDigest, tokenDigest } from "../shared/sealing.vibe"
import { Store, StoreFailure, toInt, toText, type Row } from "../store/connection.vibe"

export type { RouteClass }

export type Caller =
  | { readonly kind: "anonymous" }
  | {
      readonly kind: "deviceKey"
      readonly userId: string
      readonly organizationId: string
      readonly credentialId: string
      readonly grantKey: string
      readonly expiresAt: number
    }
  | {
      readonly kind: "session"
      readonly userId: string
      readonly organizationId: string
      readonly sessionKey: string
      readonly authAt: number
      readonly stepUpAt: number
      readonly mfaAt: number
      readonly accessExpiresAt: number
    }

export type Signed = Exclude<Caller, { readonly kind: "anonymous" }>

const deviceKeyPattern = /^eliza_mobile_[0-9a-f]{64}$/
const sessionTokenPattern = /^eliza_session_[A-Za-z0-9_-]{43}$/

const anonymous: Caller = { kind: "anonymous" }

const credentialRoute: Readonly<Record<RouteClass, CredentialRoute>> = {
  Public: "PublicRoute",
  ProviderSignature: "SignatureRoute",
  ServiceAccess: "KeyOrSessionRoute",
  SignedSession: "SessionRoute",
  FreshSession: "FreshRoute",
  StepUp: "StepUpRoute"
}

const accountStatus: Readonly<Record<string, AccountStatus>> = { active: "Active", deleting: "Deleting", erased: "Erased" }

const noAccount: Standing = { status: "Unopened", personEpoch: 0, deviceEpoch: 0 }

export const deviceKeyPerMinute = keyIngressLimit.limit

export function bearerToken(authorization: string | undefined): string | undefined {
  const match = /^Bearer ([^\s]+)$/.exec(authorization ?? "")
  return match?.[1]
}

function standingOf(row: Row): Standing {
  return {
    status: accountStatus[toText(row.status) ?? ""] ?? "Unopened",
    personEpoch: toInt(row.sessions_revoked_before),
    deviceEpoch: toInt(row.devices_revoked_before)
  }
}

function moment(at: Moment): number {
  return at.tag === "At" ? at.ms : 0
}

effect function decided(route: CredentialRoute, presented: Presented, standing: Standing, now: number): Admission!Refused {
  const answer = admission(route, presented, standing, now)
  if (answer.tag === "Denied") throw new Refused({ refusal: answer.refusal })
  return answer
}

effect function stateOf<S, Corrupt>(row: Row, decode: (input: unknown) => S!Corrupt, operation: string): S!StoreFailure {
  return decode(row.state) catch effect (cause) => { throw new StoreFailure({ operation, cause }) }
}

effect function keyCaller(token: string, route: CredentialRoute, window: Window, now: number): Caller!(Refused | StoreFailure)!Store {
  const store = try Store
  const row = (try store.transaction((tx) => tx.query(
    "SELECT g.key, g.user_id, g.state, a.organization_id, a.status, a.sessions_revoked_before, a.devices_revoked_before FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.secret_digest = $1",
    [tokenDigest(token)]
  )))[0]
  if (row === undefined) {
    try decided(route, { tag: "KeyBearer", window, lookup: { tag: "NoGrant" } }, noAccount, now)
    return anonymous
  }
  const grant = try stateOf(row, decodeGrant, "read device grant")
  const answer = try decided(route, { tag: "KeyBearer", window, lookup: { tag: "GrantRow", grant } }, standingOf(row), now)
  if (answer.tag !== "Caller") return anonymous
  return {
    kind: "deviceKey",
    userId: toText(row.user_id) ?? "",
    organizationId: toText(row.organization_id) ?? "",
    credentialId: grant.credentialId,
    grantKey: toText(row.key) ?? "",
    expiresAt: answer.expiresAt
  }
}

effect function countedKeyCaller(token: string, route: CredentialRoute, now: number): Caller!(Refused | StoreFailure | SecretMissing)!(Store | Deployment) {
  const check: LimitCheck = { subject: try keyedDigest(token), rule: keyIngressLimit }
  const window = readWindow(check) catch effect () => { throw new Refused({ refusal: unavailableRefusal(now) }) }
  if (!admitsAll(keyIngress(window), now)) {
    try decided(route, { tag: "KeyBearer", window, lookup: { tag: "NoGrant" } }, noAccount, now)
    return anonymous
  }
  try admitCheck(check)
  return try keyCaller(token, route, window, now)
}

effect function sessionCaller(token: string, route: CredentialRoute, now: number): Caller!(Refused | StoreFailure)!Store {
  const store = try Store
  const row = (try store.transaction((tx) => tx.query(
    "SELECT s.key, s.user_id, s.state, p.generation, a.organization_id, a.status, a.sessions_revoked_before, a.devices_revoked_before FROM (SELECT key AS session_key, NULL::integer AS generation FROM sessions WHERE access_digest = $1 UNION ALL SELECT session_key, generation FROM cloud_spent_refresh WHERE access_digest = $1) p JOIN sessions s ON s.key = p.session_key JOIN accounts a ON a.key = s.user_id",
    [tokenDigest(token)]
  )))[0]
  if (row === undefined) {
    try decided(route, { tag: "SessionBearer", lookup: { tag: "NoFamily" } }, noAccount, now)
    return anonymous
  }
  const family = try stateOf(row, decodeFamily, "read session family")
  const generation = row.generation === null ? family.generation : toInt(row.generation)
  const answer = try decided(route, { tag: "SessionBearer", lookup: { tag: "FamilyRow", family, generation } }, standingOf(row), now)
  if (answer.tag !== "Caller") return anonymous
  return {
    kind: "session",
    userId: toText(row.user_id) ?? "",
    organizationId: toText(row.organization_id) ?? "",
    sessionKey: toText(row.key) ?? "",
    authAt: family.authAt,
    stepUpAt: moment(family.stepUpAt),
    mfaAt: moment(family.mfaAt),
    accessExpiresAt: answer.expiresAt
  }
}

effect function presentedCaller(token: string | undefined, route: CredentialRoute, now: number): Caller!(Refused | StoreFailure)!Store {
  if (token !== undefined && sessionTokenPattern.test(token)) return try sessionCaller(token, route, now)
  try decided(route, { tag: "NoCredential" }, noAccount, now)
  return anonymous
}

export effect function authenticate(authorization: string | undefined, routeClass: RouteClass): Caller!(Refused | StoreFailure | SecretMissing)!(Store | Deployment) {
  const route = credentialRoute[routeClass]
  if (!isProtected(route)) return anonymous
  const now = try Clock.currentTimeMillis
  const token = bearerToken(authorization)
  if (token !== undefined && deviceKeyPattern.test(token)) return try countedKeyCaller(token, route, now)
  return try presentedCaller(token, route, now)
}

export effect function recheck(authorization: string | undefined, routeClass: RouteClass): Caller!(Refused | StoreFailure)!Store {
  const route = credentialRoute[routeClass]
  if (!isProtected(route)) return anonymous
  const now = try Clock.currentTimeMillis
  const token = bearerToken(authorization)
  if (token !== undefined && deviceKeyPattern.test(token)) return try keyCaller(token, route, uncounted, now)
  return try presentedCaller(token, route, now)
}

export function signed(caller: Caller): Signed | undefined {
  return caller.kind === "anonymous" ? undefined : caller
}
