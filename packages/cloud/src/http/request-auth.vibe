// spec/cloud/identity/requestAuth.md, "Story: Admit a request only for a live credential of an active account"
import { admit, deviceKeyRequestsPerMinute, type AccountStatus, type CredentialView, type RouteClass } from "../../gen/cloud__identity__requestAuth.effect.vibe"
import { refused, Refused } from "./refusal.vibe"
import { admit as admitRate, minute } from "../shared/rate-limit.vibe"
import { tokenDigest } from "../shared/sealing.vibe"
import { Store, StoreFailure, toInt, toText, type Row } from "../store/store.vibe"

export type { RouteClass }

export type Caller =
  | { readonly kind: "anonymous" }
  | {
      readonly kind: "deviceKey"
      readonly userId: string
      readonly organizationId: string
      readonly credentialId: string
      readonly grantKey: string
      readonly expiresAt: number
    }
  | {
      readonly kind: "session"
      readonly userId: string
      readonly organizationId: string
      readonly sessionKey: string
      readonly authAt: number
      readonly stepUpAt: number
      readonly mfaAt: number
      readonly accessExpiresAt: number
    }

export type Signed = Exclude<Caller, { readonly kind: "anonymous" }>

const deviceKeyPattern = /^eliza_mobile_[0-9a-f]{64}$/
const sessionTokenPattern = /^eliza_session_[A-Za-z0-9_-]{43}$/

const accountStatuses: Readonly<Record<string, AccountStatus>> = { active: "Active", deleting: "Deleting", erased: "Erased" }

export function bearerToken(authorization: string | undefined): string | undefined {
  const match = /^Bearer ([^\s]+)$/.exec(authorization ?? "")
  return match?.[1]
}

effect function verdict(view: CredentialView, routeClass: RouteClass, now: number): void!Refused {
  const decided = admit(view, routeClass, now)
  if (decided.tag === "Refused") throw new Refused({ refusal: decided.refusal })
}

function status(row: Row): AccountStatus {
  return accountStatuses[toText(row.status) ?? ""] ?? "Erased"
}

effect function deviceKeyCaller(token: string, routeClass: RouteClass, now: number): Caller!(Refused | StoreFailure)!Store {
  const digest = tokenDigest(token)
  try admitRate({ subject: digest, scope: "device-key", limit: deviceKeyRequestsPerMinute, widthMs: minute })
  const store = try Store
  const row = (try store.transaction((tx) => tx.query(
    "SELECT g.key, g.user_id, g.phase, g.credential_id, g.key_expires_at, g.issued_at, a.organization_id, a.status, a.devices_revoked_before FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.secret_digest = $1",
    [digest]
  )))[0]
  try verdict({
    kind: "DeviceKey",
    found: row !== undefined,
    live: row?.phase === "active",
    expiresAt: toInt(row?.key_expires_at ?? 0),
    issuedAt: toInt(row?.issued_at ?? 0),
    revokedBefore: toInt(row?.devices_revoked_before ?? 0),
    accountStatus: row === undefined ? "Erased" : status(row),
    authAt: 0,
    stepUpAt: 0
  }, routeClass, now)
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return {
    kind: "deviceKey",
    userId: toText(row.user_id) ?? "",
    organizationId: toText(row.organization_id) ?? "",
    credentialId: toText(row.credential_id) ?? "",
    grantKey: toText(row.key) ?? "",
    expiresAt: toInt(row.key_expires_at)
  }
}

effect function sessionCaller(token: string, routeClass: RouteClass, now: number): Caller!(Refused | StoreFailure)!Store {
  const store = try Store
  const row = (try store.transaction((tx) => tx.query(
    "SELECT s.key, s.user_id, s.live, s.access_expires_at, s.auth_at, s.step_up_at, s.mfa_at, a.organization_id, a.status, a.sessions_revoked_before FROM sessions s JOIN accounts a ON a.key = s.user_id WHERE s.access_digest = $1",
    [tokenDigest(token)]
  )))[0]
  try verdict({
    kind: "Session",
    found: row !== undefined,
    live: row?.live === true,
    expiresAt: toInt(row?.access_expires_at ?? 0),
    issuedAt: toInt(row?.auth_at ?? 0),
    revokedBefore: toInt(row?.sessions_revoked_before ?? 0),
    accountStatus: row === undefined ? "Erased" : status(row),
    authAt: toInt(row?.auth_at ?? 0),
    stepUpAt: toInt(row?.step_up_at ?? 0)
  }, routeClass, now)
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  return {
    kind: "session",
    userId: toText(row.user_id) ?? "",
    organizationId: toText(row.organization_id) ?? "",
    sessionKey: toText(row.key) ?? "",
    authAt: toInt(row.auth_at),
    stepUpAt: toInt(row.step_up_at),
    mfaAt: toInt(row.mfa_at),
    accessExpiresAt: toInt(row.access_expires_at)
  }
}

export effect function authenticate(authorization: string | undefined, routeClass: RouteClass): Caller!(Refused | StoreFailure)!Store {
  if (routeClass === "Public" || routeClass === "ProviderSignature") return { kind: "anonymous" }
  const now = try Clock.currentTimeMillis
  const token = bearerToken(authorization)
  if (token === undefined) throw refused("AuthenticationRequired")
  if (deviceKeyPattern.test(token)) return try deviceKeyCaller(token, routeClass, now)
  if (sessionTokenPattern.test(token)) return try sessionCaller(token, routeClass, now)
  throw refused("AuthenticationRequired", "CredentialUnknown")
}

export function signed(caller: Caller): Signed | undefined {
  return caller.kind === "anonymous" ? undefined : caller
}
