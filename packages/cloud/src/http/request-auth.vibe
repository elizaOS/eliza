// spec/cloud/identity/sessions.md, "Story: Admit a request only for a live credential of an active account"; spec/cloud/shared/rateLimit.md, "Story: Refuse excess requests with a usable retry time"
import { admitPrincipal, admitRequest, type RequestAccountStatus, type RequestAdmission, type RouteClass } from "../../gen/cloud__identity__sessions.effect.vibe"
import { inspectKey } from "../native-clients/grants.vibe"
import { refused, Refused } from "./refusal.vibe"
import { admit, minute } from "../shared/rate-limit.vibe"
import { tokenDigest } from "../shared/sealing.vibe"
import { Store, type StoreFailure, toInt, toText, type Row } from "../store/connection.vibe"

export type { RouteClass }

export type Caller =
  | { readonly kind: "anonymous" }
  | {
      readonly kind: "deviceKey"
      readonly userId: string
      readonly organizationId: string
      readonly credentialScope: string
      readonly grantKey: string
      readonly expiresAt: number
    }
  | {
      readonly kind: "session"
      readonly userId: string
      readonly organizationId: string
      readonly sessionKey: string
      readonly authAt: number
      readonly stepUpAt: number
      readonly mfaAt: number
      readonly accessExpiresAt: number
    }

export type Signed = Exclude<Caller, { readonly kind: "anonymous" }>

const deviceKeyPattern = /^eliza_mobile_[0-9a-f]{64}$/
const sessionTokenPattern = /^eliza_session_[A-Za-z0-9_-]{43}$/

export const deviceKeyPerMinute = 120

export function bearerToken(authorization: string | undefined): string | undefined {
  const match = /^Bearer ([^\s]+)$/.exec(authorization ?? "")
  return match?.[1]
}

effect function verdict(decided: RequestAdmission): void!Refused {
  if (decided.tag === "RequestRefused") throw new Refused({ refusal: decided.refusal })
}

function status(row: Row | undefined): RequestAccountStatus {
  return row?.status === "active" ? "RequestAccountActive" : "RequestAccountInactive"
}

effect function deviceKeyCaller(token: string, routeClass: RouteClass): Caller!(Refused | StoreFailure)!Store {
  const digest = tokenDigest(token)
  try admit({ subject: digest, scope: "device-key", limit: deviceKeyPerMinute, widthMs: minute })
  const store = try Store
  const row = (try store.transaction((tx) => tx.query(
    "SELECT g.key, g.state, g.phase, g.key_expires_at, g.device_epoch AS grant_epoch, g.user_id, g.credential_id, a.organization_id, a.status, a.device_epoch AS account_epoch FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.secret_digest = $1",
    [digest]
  )))[0]
  if (row === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  const at = try Clock.currentTimeMillis
  const key = inspectKey(row, at) catch effect () => { throw refused("ServiceUnavailable") }
  if (key.reason !== "NoReason") throw refused("AuthenticationRequired", key.reason)
  try verdict(admitPrincipal({ accountStatus: status(row), credential: { tag: "DevicePrincipal" } }, routeClass, at))
  const grantKey = toText(row.key)
  if (!grantKey) throw refused("ServiceUnavailable")
  return {
    kind: "deviceKey",
    userId: toText(row.user_id) ?? "",
    organizationId: toText(row.organization_id) ?? "",
    credentialScope: toText(row.credential_id) || `recorded-grant:${grantKey}`,
    grantKey,
    expiresAt: key.expiresAt
  }
}

effect function sessionCaller(token: string, routeClass: RouteClass, now: number): Caller!(Refused | StoreFailure)!Store {
  const store = try Store
  const row = (try store.transaction((tx) => tx.query(
    "SELECT s.key, s.user_id, s.live, (s.state->>'epoch')::bigint AS epoch, s.access_expires_at, s.refresh_expires_at, s.auth_at, s.step_up_at, s.mfa_at, a.organization_id, a.status, a.sessions_revoked_before FROM sessions s JOIN accounts a ON a.key = s.user_id WHERE s.access_digest = $1",
    [tokenDigest(token)]
  )))[0]
  try verdict(admitRequest({
    kind: "RequestSession",
    found: row !== undefined && now < toInt(row.refresh_expires_at),
    live: row?.live === true && toInt(row.epoch) === toInt(row.sessions_revoked_before),
    expiresAt: toInt(row?.access_expires_at ?? 0),
    issuedAt: toInt(row?.auth_at ?? 0),
    revokedBefore: 0,
    accountStatus: status(row),
    authAt: toInt(row?.auth_at ?? 0),
    stepUpAt: toInt(row?.step_up_at ?? 0),
    mfaAt: toInt(row?.mfa_at ?? 0)
  }, routeClass, now))
  if (row === undefined || !(now < toInt(row.refresh_expires_at))) throw refused("AuthenticationRequired", "CredentialUnknown")
  return {
    kind: "session",
    userId: toText(row.user_id) ?? "",
    organizationId: toText(row.organization_id) ?? "",
    sessionKey: toText(row.key) ?? "",
    authAt: toInt(row.auth_at),
    stepUpAt: toInt(row.step_up_at),
    mfaAt: toInt(row.mfa_at),
    accessExpiresAt: toInt(row.access_expires_at)
  }
}

export effect function authenticate(authorization: string | undefined, routeClass: RouteClass): Caller!(Refused | StoreFailure)!Store {
  if (routeClass === "Public" || routeClass === "ProviderSignature") return { kind: "anonymous" }
  const now = try Clock.currentTimeMillis
  const token = bearerToken(authorization)
  if (token === undefined) throw refused("AuthenticationRequired", "CredentialUnknown")
  if (deviceKeyPattern.test(token)) return try deviceKeyCaller(token, routeClass)
  if (sessionTokenPattern.test(token)) return try sessionCaller(token, routeClass, now)
  throw refused("AuthenticationRequired", "CredentialUnknown")
}

export function signed(caller: Caller): Signed | undefined {
  return caller.kind === "anonymous" ? undefined : caller
}
