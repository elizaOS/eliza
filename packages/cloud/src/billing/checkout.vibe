// spec/cloud/billing/checkout.md, "Story: Subscribe once, whichever screen or payer finishes it"; spec/cloud/shared/dispatchOnce.md, "Story: Send a change once and recover its outcome without sending it again"; spec/cloud/billing/subscriptions.md, "Story: Change my plan one command at a time"; spec/cloud/nativeClients/registry.md, "Story: Admit only a registered native client"
import {
  Rejected, answerOf, apply, canReceiveReply, canResolve, decodeState, elapse, initial, nowOf, resumes, returnFor,
  type Checkout, type CheckoutEffect, type CheckoutPhase, type CheckoutReturn, type CheckoutStep, type Event, type NotAState, type Presentation
} from "../../gen/cloud__billing__checkout.effect.vibe"
import { isConflict } from "../../gen/cloud__shared__dispatchOnce.effect.vibe"
import { apply as stepSubscription, isLive } from "../../gen/cloud__billing__subscriptions.effect.vibe"
import type { ReturnUrl } from "../../gen/cloud__nativeClients__registry.ts"
import { payerPath } from "../../gen/cloud__returnPages.effect.vibe"
import { refused, type Refused } from "../http/refusal.vibe"
import type { Signed } from "../http/request-auth.vibe"
import { json, jsonBody, type Route, type RouteContext } from "../http/routes.vibe"
import { readClient } from "../native-clients/registry.vibe"
import { Deployment } from "../profile/profile.vibe"
import {
  createCheckoutSession, createCustomer, expireCheckoutSession, providerReply, retrieveCheckoutSession,
  type CheckoutReturns, type StripeCheckoutSession, type StripeContext
} from "../providers/stripe.vibe"
import { dispatchOnce, receiptOwner, renderProviderKey, replyOf, requestDigest, staleAt, type ProviderReply, type SessionOwner } from "../shared/dispatch-once.vibe"
import { sha256Hex } from "../shared/sealing.vibe"
import { foreign, Store, toText, type StoreFailure, type Tx } from "../store/connection.vibe"
import { loadRow, RowCorrupt, stepRow, type Columns, type MachineRows } from "../store/rows.vibe"
import { idempotencyKeyPattern } from "./commands.vibe"
import { parsePlanKey, wirePlanKey, type PaidPlanKey, type PlanKey } from "./plans.vibe"
import { readStripeSubscription, stripeClient } from "./stripe-observation.vibe"
import { claimLiveCommand, readSubscription, reconcileSubscription, releaseLiveCommand } from "./subscriptions.vibe"

export const providerTimeout = 30_000
const retryAfterMs = 5_000

export interface CheckoutSent {
  readonly event: Event
  readonly by: SessionOwner
  readonly now: number
}

export interface StoredCheckout {
  readonly commandId: string
  readonly organizationId: string
  readonly state: Checkout
}

interface StartRequest {
  readonly planKey: PlanKey
  readonly idempotencyKey: string
  readonly presentation: Presentation
}

type Admission =
  | { readonly kind: "replay"; readonly stored: StoredCheckout }
  | { readonly kind: "live"; readonly stored: StoredCheckout }
  | { readonly kind: "fresh"; readonly customerId: string | undefined }

type CheckoutAnswer =
  | { readonly status: "open"; readonly commandId: string; readonly checkoutUrl: string; readonly sessionId: string; readonly expiresAt: number }
  | {
      readonly status: "open"; readonly commandId: string; readonly uiMode: "embedded"; readonly sessionId: string; readonly clientSecret: string
      readonly publishableKey: string; readonly amountDueCents: number; readonly currency: "usd"; readonly interval: "month"; readonly expiresAt: number
    }
  | { readonly status: "completed" | "stale_intent" | "expired"; readonly commandId: string }

type CheckoutAnswerFailure = Refused | StoreFailure |
  Effect.Error<ReturnType<typeof readSubscription>> | Effect.Error<ReturnType<typeof applyCheckoutEvent>>

const wireStatus: Readonly<Record<CheckoutPhase, string>> = { NotStarted: "not_started", Opening: "opening", Open: "open", Completed: "completed", Expired: "expired" }
const wirePresentation: Readonly<Record<Presentation, "mobile" | "embedded" | "shared">> = { Mobile: "mobile", Embedded: "embedded", Shared: "shared" }
const noReturn: ReturnUrl = { origin: "", path: "" }

function parsePresentation(input: string): Presentation | undefined {
  switch (input) {
    case "mobile": return "Mobile"
    case "embedded": return "Embedded"
    case "shared": return "Shared"
    default: return undefined
  }
}

function paidWire(planKey: PlanKey): PaidPlanKey | undefined {
  const wire = wirePlanKey(planKey)
  return wire === "free" ? undefined : wire
}

function checkoutIdOf(organizationId: string, idempotencyKey: string): string {
  return `cmd_${sha256Hex(`${organizationId}\n${idempotencyKey}`).slice(0, 32)}`
}

export function checkoutAt(state: Checkout, now: number): Checkout {
  return now > nowOf(state) ? elapse(state, now - nowOf(state)) : state
}

effect function applyAt(state: Checkout, sent: CheckoutSent): CheckoutStep!Rejected {
  const current = sent.now > nowOf(state) ? (try apply(state, { type: "elapse", elapsed: sent.now - nowOf(state) }, sent.by)).state : state
  return try apply(current, sent.event, sent.by)
}

const checkoutRows: MachineRows<Checkout, CheckoutSent, CheckoutStep, Rejected, NotAState> = {
  table: "checkouts", initial, decodeState, apply: applyAt, next: (stepped) => stepped.state
}

function columnsOf(state: Checkout, now: number): Columns {
  return {
    status: wireStatus[state.phase],
    plan_key: paidWire(state.planKey) ?? "",
    presentation: wirePresentation[state.presentation],
    provider_session_id: state.sessionId === "" ? null : state.sessionId,
    session_expires_at: state.sessionExpiresAt,
    readback_attempt: state.readBacks,
    next_readback_at: state.nextReadBackAt,
    updated_at: now
  }
}

export effect function loadCheckout(tx: Tx, commandId: string, lock = true) {
  const row = (try tx.query(`SELECT organization_id FROM checkouts WHERE key = $1${lock ? " FOR UPDATE" : ""}`, [commandId]))[0]
  const organizationId = toText(row?.organization_id)
  if (organizationId === undefined) return undefined
  const loaded = try loadRow(tx, checkoutRows, commandId, lock)
  return { commandId, organizationId, state: loaded.state } satisfies StoredCheckout
}

export effect function pinnedCustomer(tx: Tx, organizationId: string) {
  return toText((try tx.query("SELECT customer_id FROM cloud_checkout_customers WHERE organization_id = $1", [organizationId]))[0]?.customer_id)
}

effect function observeCheckout(customerId: string, plan: PaidPlanKey) {
  const deployment = try Deployment
  const billing = deployment.settings.billing
  if (billing === undefined) throw refused("CapabilityUnavailable")
  const key = try deployment.secret(billing.secretKeyEnv)
  return (try foreign("observe checkout subscription", () => readStripeSubscription(stripeClient(key, billing.apiUrl), {
    STRIPE_PRICE_ID: billing.plans[plan].priceId,
    STRIPE_PRODUCT_ID: billing.plans[plan].productId,
    STRIPE_PLAN: plan,
    CLOUD_ENVIRONMENT: deployment.environment
  }, customerId))).observation
}

effect function perform(tx: Tx, organizationId: string, out: CheckoutEffect, now: number) {
  switch (out.tag) {
    case "ClaimSlot": {
      const subscription = try readSubscription(tx, organizationId)
      try claimLiveCommand(tx, organizationId, "CheckoutCommand", out.commandId, subscription.revision, now)
      return
    }
    case "ReleaseSlot":
      try releaseLiveCommand(tx, organizationId, out.commandId, now)
      return
    case "CheckoutPaid": {
      const customerId = try pinnedCustomer(tx, organizationId)
      const plan = paidWire(out.planKey)
      if (customerId === undefined || plan === undefined) throw new RowCorrupt({ table: "checkouts", key: out.commandId, cause: "a paid checkout has no pinned customer or paid plan" })
      const observed = try observeCheckout(customerId, plan)
      if (observed.subscriptionId !== out.subscriptionId) throw new RowCorrupt({ table: "checkouts", key: out.commandId, cause: "the provider does not show the subscription the checkout bought" })
      try reconcileSubscription(tx, organizationId, observed, now, { kind: "Checkout", checkoutId: out.commandId })
      return
    }
    default: {
      const _exhaustive: never = out
      return _exhaustive
    }
  }
}

export effect function stepCheckout(tx: Tx, organizationId: string, commandId: string, sent: CheckoutSent, fixed: Columns = {}) {
  const stepped = try stepRow(tx, checkoutRows, commandId, sent, (state) => ({ ...fixed, ...columnsOf(state, sent.now) }))
  for (const out of stepped.out.out) try perform(tx, organizationId, out, sent.now)
  return stepped.state
}

export effect function applyCheckoutEvent(tx: Tx, session: StripeCheckoutSession, now: number) {
  const commandId = session.metadata?.commandId
  const organizationId = session.metadata?.organizationId
  if (commandId === undefined || organizationId === undefined || session.client_reference_id !== commandId) return undefined
  try tx.query("SELECT id FROM organizations WHERE id=$1 FOR UPDATE", [organizationId])
  const stored = try loadCheckout(tx, commandId)
  const customerId = try pinnedCustomer(tx, organizationId)
  if (stored === undefined || stored.organizationId !== organizationId || session.customer !== customerId) return undefined
  const by = stored.state.receipt.session.owner
  let state = stored.state
  if (state.phase === "Opening" && canResolve(checkoutAt(state, now), { tag: "EffectSeen" }, session.id)) {
    state = try stepCheckout(tx, organizationId, commandId, { event: { type: "resolve", lookup: { tag: "EffectSeen" }, sessionId: session.id }, by, now })
  }
  if (state.phase !== "Open" || state.sessionId !== session.id) return state
  if (session.status === "complete" && session.payment_status === "paid" && session.subscription !== null) {
    return try stepCheckout(tx, organizationId, commandId, { event: { type: "observePaid", sessionId: session.id, subscriptionId: session.subscription }, by, now })
  }
  if (session.status === "expired") return try stepCheckout(tx, organizationId, commandId, { event: { type: "observeExpired", sessionId: session.id }, by, now })
  return state
}

effect function billingReturnOf(tx: Tx, caller: Signed, presentation: Presentation): ReturnUrl!(Refused | StoreFailure)!Deployment {
  if (presentation !== "Mobile") return noReturn
  if (caller.kind !== "deviceKey") throw refused("InvalidClient")
  const clientId = toText((try tx.query("SELECT client_id FROM device_grants WHERE key = $1", [caller.grantKey]))[0]?.client_id)
  const registration = clientId === undefined ? undefined : try readClient(tx, clientId)
  if (registration === undefined) throw refused("InvalidClient")
  if (!registration.enabled) throw refused("ClientDisabled")
  return registration.billingReturn
}

effect function admit(tx: Tx, caller: Signed, commandId: string, by: SessionOwner, digest: string) {
  try tx.query("SELECT id FROM organizations WHERE id = $1 FOR UPDATE", [caller.organizationId])
  const existing = try loadCheckout(tx, commandId)
  if (existing !== undefined) {
    if (existing.organizationId !== caller.organizationId || isConflict(existing.state.receipt, by, digest)) throw refused("IdempotencyConflict")
    return { kind: "replay", stored: existing } satisfies Admission
  }
  const account = (try tx.query("SELECT status FROM accounts WHERE key = $1 AND organization_id = $2", [caller.userId, caller.organizationId]))[0]
  if (account?.status !== "active") throw refused("AccessDenied", "AccountInactive")
  const live = toText((try tx.query("SELECT key FROM checkouts WHERE organization_id = $1 AND status IN ('opening', 'open')", [caller.organizationId]))[0]?.key)
  const stored = live === undefined ? undefined : try loadCheckout(tx, live)
  if (stored !== undefined) return { kind: "live", stored } satisfies Admission
  const subscription = try readSubscription(tx, caller.organizationId)
  if (isLive(subscription.status) || subscription.liveCommand.tag !== "NoLiveCommand") throw refused("BillingStateConflict")
  return { kind: "fresh", customerId: try pinnedCustomer(tx, caller.organizationId) } satisfies Admission
}

effect function pinCustomer(tx: Tx, organizationId: string, customerId: string, now: number) {
  try tx.query("INSERT INTO cloud_checkout_customers (organization_id, customer_id) VALUES ($1, $2) ON CONFLICT (organization_id) DO NOTHING", [organizationId, customerId])
  if ((try pinnedCustomer(tx, organizationId)) !== customerId) throw refused("BillingStateConflict")
  const found = (try tx.query("SELECT key FROM subscriptions WHERE key = $1 FOR UPDATE", [organizationId]))[0]
  const subscription = try readSubscription(tx, organizationId)
  if (subscription.customer.tag === "PinnedCustomer") {
    if (subscription.customer.customerId !== customerId) throw refused("BillingStateConflict")
    return
  }
  const pinned = (try stepSubscription(subscription, { type: "pinCustomer", customerId })).state
  if (found === undefined) {
    try tx.query("INSERT INTO subscriptions (key, state, revision, status, plan_key, customer_id, updated_at) VALUES ($1, $2::jsonb, 1, 'none', 'free', $3, $4)",
      [organizationId, JSON.stringify(pinned), customerId, now])
  } else {
    try tx.query("UPDATE subscriptions SET state = $2::jsonb, revision = revision + 1, customer_id = $3, updated_at = $4 WHERE key = $1", [organizationId, JSON.stringify(pinned), customerId, now])
  }
}

function providerReturns(returns: CheckoutReturn, api: string): CheckoutReturns {
  switch (returns.tag) {
    case "ToApp": {
      const base = `${returns.url.origin}${returns.url.path}`
      return { kind: "hosted", successUrl: `${base}?session_id={CHECKOUT_SESSION_ID}&result=success`, cancelUrl: `${base}?result=cancel` }
    }
    case "ToPayerPage":
      return { kind: "hosted", successUrl: `${api}${payerPath}?outcome=paid`, cancelUrl: `${api}${payerPath}?outcome=canceled` }
    case "StaysInApp":
      return { kind: "embedded" }
    default: {
      const _exhaustive: never = returns
      return _exhaustive
    }
  }
}

function unavailable(now: number): Refused {
  return refused("ServiceUnavailable", "NoReason", now + retryAfterMs)
}

function providerRefusal<A>(reply: ProviderReply<A>, now: number): Refused {
  return reply.kind === "refused" && reply.code === "NotFoundAtProvider" ? refused("NotFound") : refused("ProviderUnavailable", "NoReason", now + retryAfterMs)
}

effect function readSession(sessionId: string) {
  return try providerReply(retrieveCheckoutSession(sessionId, { timeout: providerTimeout }))
}

effect function openAnswer(stored: StoredCheckout, session: StripeCheckoutSession): CheckoutAnswer!Refused!Deployment {
  const state = stored.state
  if (state.presentation !== "Embedded") {
    if (session.url === null) throw refused("ProviderInvalidResponse")
    return { status: "open", commandId: stored.commandId, checkoutUrl: session.url, sessionId: session.id, expiresAt: state.sessionExpiresAt }
  }
  const billing = (try Deployment).settings.billing
  const clientSecret = session.client_secret ?? null
  if (billing === undefined || clientSecret === null || session.amount_total === null) throw refused("ProviderInvalidResponse")
  return {
    status: "open", commandId: stored.commandId, uiMode: "embedded", sessionId: session.id, clientSecret, publishableKey: billing.publishableKey,
    amountDueCents: session.amount_total, currency: "usd", interval: "month", expiresAt: state.sessionExpiresAt
  }
}

effect function verdictOf(stored: StoredCheckout) {
  const store = try Store
  const subscription = try store.transaction((tx) => readSubscription(tx, stored.organizationId))
  return answerOf(stored.state, isLive(subscription.status) && subscription.subscriptionId === stored.state.subscriptionId)
}

effect function settledAnswer(stored: StoredCheckout, answer: ReturnType<typeof answerOf>, now: number) {
  switch (answer) {
    case "AnswerCompleted": return { status: "completed", commandId: stored.commandId } satisfies CheckoutAnswer
    case "AnswerStaleIntent": return { status: "stale_intent", commandId: stored.commandId } satisfies CheckoutAnswer
    case "AnswerExpired": return { status: "expired", commandId: stored.commandId } satisfies CheckoutAnswer
    case "AnswerOpen":
    case "AnswerUnavailable": throw unavailable(now)
    default: {
      const _exhaustive: never = answer
      return _exhaustive
    }
  }
}

effect function answerCheckout(stored: StoredCheckout, known: StripeCheckoutSession | undefined): CheckoutAnswer!CheckoutAnswerFailure!(Store | StripeContext) {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const answer = try verdictOf(stored)
  if (answer !== "AnswerOpen") return try settledAnswer(stored, answer, now)
  const fresh = known?.id === stored.state.sessionId && known.status === "open" ? known : undefined
  const seen = fresh === undefined ? try readSession(stored.state.sessionId) : { kind: "applied", value: fresh } as const
  if (seen.kind !== "applied") throw providerRefusal(seen, now)
  if (seen.value.status === "open") return try openAnswer(stored, seen.value)
  const after = try store.transaction((tx) => applyCheckoutEvent(tx, seen.value, now))
  if (after === undefined || after.phase === "Open") throw unavailable(now)
  const current = { ...stored, state: after }
  return try settledAnswer(current, try verdictOf(current), now)
}

effect function replaceLive(live: StoredCheckout) {
  const store = try Store
  const now = try Clock.currentTimeMillis
  if (live.state.phase !== "Open") throw unavailable(now)
  try providerReply(expireCheckoutSession(live.state.sessionId, { idempotencyKey: `expire_${live.state.sessionId}`, timeout: providerTimeout }))
  const seen = try readSession(live.state.sessionId)
  if (seen.kind !== "applied") throw unavailable(now)
  const after = try store.transaction((tx) => applyCheckoutEvent(tx, seen.value, now))
  if (after?.phase === "Completed") throw refused("BillingStateConflict")
  if (after?.phase !== "Expired") throw unavailable(now)
}

effect function customerFor(organizationId: string, pinned: string | undefined) {
  if (pinned !== undefined) return pinned
  const now = try Clock.currentTimeMillis
  const created = try providerReply(createCustomer(organizationId, { idempotencyKey: `customer_${organizationId}`, timeout: providerTimeout }))
  if (created.kind !== "applied") throw providerRefusal(created, now)
  return created.value.id
}

effect function recordReply(tx: Tx, organizationId: string, commandId: string, reply: ProviderReply<StripeCheckoutSession>, now: number) {
  try tx.query("SELECT id FROM organizations WHERE id=$1 FOR UPDATE", [organizationId])
  const stored = try loadCheckout(tx, commandId)
  if (stored === undefined) throw new RowCorrupt({ table: "checkouts", key: commandId, cause: "a dispatched checkout disappeared" })
  const verdict = replyOf(reply)
  const sessionId = reply.kind === "applied" ? reply.value.id : ""
  if (!canReceiveReply(checkoutAt(stored.state, now), verdict, sessionId)) return stored.state
  return try stepCheckout(tx, organizationId, commandId, { event: { type: "receiveReply", reply: verdict, sessionId }, by: stored.state.receipt.session.owner, now })
}

effect function admitted(caller: Signed, commandId: string, by: SessionOwner, digest: string, request: StartRequest, billingReturn: ReturnUrl) {
  const store = try Store
  const first = try store.transaction((tx) => admit(tx, caller, commandId, by, digest))
  if (first.kind !== "live" || resumes(first.stored.state, request.planKey, request.presentation, billingReturn)) return first
  try replaceLive(first.stored)
  const second = try store.transaction((tx) => admit(tx, caller, commandId, by, digest))
  if (second.kind === "live" && !resumes(second.stored.state, request.planKey, request.presentation, billingReturn)) throw refused("BillingStateConflict")
  return second
}

effect function startCheckout(caller: Signed, request: StartRequest) {
  const store = try Store
  const deployment = try Deployment
  const billing = deployment.settings.billing
  const plan = paidWire(request.planKey)
  if (billing === undefined) throw refused("CapabilityUnavailable")
  if (plan === undefined || !idempotencyKeyPattern.test(request.idempotencyKey)) throw refused("InvalidRequest")
  const { organizationId, userId } = caller
  const commandId = checkoutIdOf(organizationId, request.idempotencyKey)
  const by = receiptOwner(organizationId, userId, "CheckoutSession")
  const priceId = billing.plans[plan].priceId
  const billingReturn = try store.transaction((tx) => billingReturnOf(tx, caller, request.presentation))
  const returns = returnFor(request.presentation, billingReturn)
  const digest = requestDigest({ organizationId, userId, plan, priceId, presentation: wirePresentation[request.presentation], returns })
  const admission = try admitted(caller, commandId, by, digest, request, billingReturn)
  if (admission.kind !== "fresh") return try answerCheckout(admission.stored, undefined)
  const customerId = try customerFor(organizationId, admission.customerId)
  const now = try Clock.currentTimeMillis
  const opened = try store.transaction(effect (tx: Tx) => {
    const again = try admit(tx, caller, commandId, by, digest)
    if (again.kind === "live" && !resumes(again.stored.state, request.planKey, request.presentation, billingReturn)) throw refused("BillingStateConflict")
    if (again.kind !== "fresh") return { kind: "existing", stored: again.stored } as const
    try pinCustomer(tx, organizationId, customerId, now)
    const subscription = try readSubscription(tx, organizationId)
    const fixed = { organization_id: organizationId, user_id: userId, idempotency_key: request.idempotencyKey, digest, created_at: now }
    const start: Event = { type: "start", sub: subscription, commandId, planKey: request.planKey, presentation: request.presentation, billingReturn, digest, accountActive: true }
    const started = stepCheckout(tx, organizationId, commandId, { event: start, by, now }, fixed) catch effect (failure) => match (failure) {
      when Rejected: throw refused("BillingStateConflict");
      default: throw failure;
    }
    const sent = try stepCheckout(tx, organizationId, commandId, { event: { type: "send", claimToken: started.receipt.session.currentClaim }, by, now })
    return { kind: "sent", stored: { commandId, organizationId, state: sent } satisfies StoredCheckout } as const
  })
  if (opened.kind === "existing") return try answerCheckout(opened.stored, undefined)
  let state = opened.stored.state
  const deadline = staleAt(state.receipt)
  const terms = { organizationId, commandId, customerId, priceId, expiresAt: state.sessionExpiresAt, returns: providerReturns(state.returns, deployment.settings.api) }
  const reply = try dispatchOnce<StripeCheckoutSession, StoreFailure | Effect.Error<ReturnType<typeof recordReply>>, Store | StripeContext>({
    claim: Effect.void,
    send: providerReply(createCheckoutSession(terms, { idempotencyKey: renderProviderKey(state.receipt.providerKey), timeout: Math.max(1, Math.min(providerTimeout, deadline - now)) })),
    record: effect (seen: ProviderReply<StripeCheckoutSession>, at: number) => {
      state = try store.transaction((tx) => recordReply(tx, organizationId, commandId, seen, at))
    }
  })
  return try answerCheckout({ commandId, organizationId, state }, reply.kind === "applied" ? reply.value : undefined)
}

effect function confirmCheckout(caller: Signed, sessionId: string) {
  const store = try Store
  const now = try Clock.currentTimeMillis
  const seen = try readSession(sessionId)
  if (seen.kind !== "applied") throw providerRefusal(seen, now)
  if (seen.value.metadata?.organizationId !== caller.organizationId) throw refused("NotFound")
  const state = try store.transaction((tx) => applyCheckoutEvent(tx, seen.value, now))
  const commandId = seen.value.metadata.commandId
  if (state === undefined || commandId === undefined) throw refused("NotFound")
  return try answerCheckout({ commandId, organizationId: caller.organizationId, state }, seen.value)
}

schema StartBody { planKey: string; idempotencyKey: string; presentation: string }
schema ConfirmBody { sessionId: string }

effect function signedCaller(context: RouteContext) {
  if (context.caller.kind === "anonymous") throw refused("AuthenticationRequired", "CredentialUnknown")
  return context.caller
}

export const routes: ReadonlyArray<Route> = [
  {
    method: "POST", path: "/api/v1/subscriptions/checkout", auth: "ServiceAccess", area: "SubscriptionRoutes", rateClass: "StandardRequests",
    handler: (context) => effect {
      const caller = try signedCaller(context)
      const body = try jsonBody(context, StartBody)
      const planKey = parsePlanKey(body.planKey)
      const presentation = parsePresentation(body.presentation)
      if (planKey === undefined || presentation === undefined) throw refused("InvalidRequest")
      return json(try startCheckout(caller, { planKey, idempotencyKey: body.idempotencyKey, presentation }))
    }
  },
  {
    method: "POST", path: "/api/v1/subscriptions/checkout/confirm", auth: "ServiceAccess", area: "SubscriptionRoutes", rateClass: "StandardRequests",
    handler: (context) => effect {
      const caller = try signedCaller(context)
      const body = try jsonBody(context, ConfirmBody)
      if (!/^cs_[A-Za-z0-9_]{1,250}$/.test(body.sessionId)) throw refused("InvalidRequest")
      return json(try confirmCheckout(caller, body.sessionId))
    }
  }
]
