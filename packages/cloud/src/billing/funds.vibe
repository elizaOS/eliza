// spec/cloud/billing/funds.md, "Story: Spend only money the account has"
import { type Rejected, addDecision, apply, availableCredits, decodeState, initial, type Event, type Funds } from "../../gen/cloud__billing__funds.effect.vibe"
import { loadRow, machineRows, type RowConflict, type RowCorrupt, stepRow } from "../store/rows.vibe"
import { Store, type StoreFailure, toInt, type Tx } from "../store/connection.vibe"

export type { Funds }

export error OrganizationUnknown { organizationId: string }
export error InvalidCreditRequest
export error IdempotencyConflict { requestKey: string }

export const fundsRows = machineRows<Funds, Event, Rejected, unknown>("funds", { initial, decodeState, apply })

export type FundsFailure = StoreFailure | RowCorrupt | RowConflict | Rejected

export effect function readFunds(tx: Tx, organizationId: string, lock = true): Funds!(StoreFailure | RowCorrupt) {
  return (try loadRow(tx, fundsRows, organizationId, lock)).state
}

export function creditAvailable(funds: Funds): number {
  return funds.creditBalance - funds.creditHeld
}

export effect function stepFunds(tx: Tx, organizationId: string, event: Event, now: number, requestKey: string): Funds!FundsFailure {
  const before = try readFunds(tx, organizationId)
  const { state } = try stepRow(tx, fundsRows, organizationId, event, () => ({ updated_at: now }))
  try tx.query("UPDATE organizations SET credit_balance = $2 WHERE id = $1", [organizationId, availableCredits(state)])
  const moved = state.creditBalance - before.creditBalance
  if (moved !== 0) {
    try tx.query(
      "INSERT INTO credit_entries (id, organization_id, kind, amount, request_key, created_at) VALUES ($1, $2, $3, $4, $5, $6)",
      [`${organizationId}:${event.type}:${requestKey}`, organizationId, event.type === "addCredits" ? "add" : "settle", moved, requestKey, now]
    )
  }
  return state
}

export interface CreditsAdded {
  readonly organizationId: string
  readonly balance: number
  readonly replayed: boolean
}

export interface CreditRequest {
  readonly organizationId: string
  readonly amount: number
  readonly requestKey: string
}

export type CreditFailure = FundsFailure | OrganizationUnknown | InvalidCreditRequest | IdempotencyConflict

export effect function addCreditsIn(tx: Tx, input: CreditRequest, now: number): CreditsAdded!CreditFailure {
  if (!input.requestKey.trim() || !Number.isSafeInteger(input.amount) || input.amount < 1) throw new InvalidCreditRequest()
  const organization = try tx.query("SELECT id FROM organizations WHERE id = $1 FOR UPDATE", [input.organizationId])
  if (organization.length === 0) throw new OrganizationUnknown({ organizationId: input.organizationId })
  const done = try tx.query("SELECT amount FROM credit_entries WHERE organization_id = $1 AND kind = 'add' AND request_key = $2", [input.organizationId, input.requestKey])
  const decision = addDecision(done.length ? { tag: "EntryOf", amount: toInt(done[0].amount) } : { tag: "NoEntry" }, input.amount)
  if (decision.tag === "RefuseAdd") {
    if (decision.code === "IdempotencyConflict") throw new IdempotencyConflict({ requestKey: input.requestKey })
    throw new InvalidCreditRequest()
  }
  if (decision.tag === "AnswerFirstEntry") return { organizationId: input.organizationId, balance: (try readFunds(tx, input.organizationId)).creditBalance, replayed: true }
  const funds = try stepFunds(tx, input.organizationId, { type: "addCredits", amount: input.amount }, now, input.requestKey)
  return { organizationId: input.organizationId, balance: funds.creditBalance, replayed: false }
}

export effect function addCredits(input: CreditRequest): CreditsAdded!CreditFailure!Store {
  const store = try Store
  const now = try Clock.currentTimeMillis
  return try store.transaction((tx) => addCreditsIn(tx, input, now))
}
