// spec/cloud/billing/providerEvents.md, "Story: Apply each payment event once, whatever the delivery order"; spec/cloud/billing/providerEvents.md, "Story: Keep an event that cannot be applied until the provider sends it again"
import {
  NotAState, Rejected, apply, canClaim, decodeState, drainBatch, drainBudget, drainEvery, elapse, holdsLease, initial, intakeAnswer, nowOf, routeOf, verifiedDelivery,
  type Event, type HandlerError, type HandlerResult, type ProviderEvent, type ProviderEventType
} from "../../gen/cloud__billing__providerEvents.effect.vibe"
import { refused } from "../http/refusal.vibe"
import { json, type CloudContext, type Route, type RouteContext, type Sweep } from "../http/routes.vibe"
import { Deployment } from "../profile/profile.vibe"
import { retrieveCharge, retrieveInvoice, StripeCharge, StripeCheckoutSession, StripeDispute, StripeEvent, StripeInvoice, StripeSubscription, StripeUnavailable, verifyWebhookSignature } from "../providers/stripe.vibe"
import { sha256Hex } from "../shared/sealing.vibe"
import { Store, StoreFailure, toText, type Tx } from "../store/connection.vibe"
import { loadRow, RowConflict, RowCorrupt, stepRow, type Columns, type MachineRows } from "../store/rows.vibe"
import { clawBackInvoice, restoreInvoice } from "./allowance.vibe"
import { applyCheckoutEvent } from "./checkout.vibe"
import { observeSubscription, reconcileSubscription } from "./subscriptions.vibe"

export const webhookPath = "/api/stripe/webhook"
export const maxWebhookBytes = 256 * 1024

export error ProviderEventMalformed { id: string; type: string }

interface Timed {
  readonly now: number
  readonly event: Event
}

const stripeTypes: ReadonlyMap<string, ProviderEventType> = new Map<string, ProviderEventType>([
  ["checkout.session.completed", "CheckoutSessionCompleted"],
  ["checkout.session.expired", "CheckoutSessionExpired"],
  ["invoice.paid", "InvoicePaid"],
  ["invoice.payment_failed", "InvoicePaymentFailed"],
  ["customer.subscription.updated", "SubscriptionUpdated"],
  ["customer.subscription.deleted", "SubscriptionDeleted"],
  ["charge.refunded", "ChargeRefunded"],
  ["charge.dispute.funds_withdrawn", "DisputeFundsWithdrawn"],
  ["charge.dispute.funds_reinstated", "DisputeFundsReinstated"]
])

type Sink =
  | { readonly kind: "checkout"; readonly session: StripeCheckoutSession }
  | { readonly kind: "subscription"; readonly customerId: string | null }
  | { readonly kind: "refund"; readonly charge: StripeCharge }
  | { readonly kind: "dispute"; readonly dispute: StripeDispute }
  | { readonly kind: "unowned" }

type Settled =
  | { readonly kind: "done" }
  | { readonly kind: "retried" }
  | { readonly kind: "deadLettered" }
  | { readonly kind: "stale" }

interface Claimed {
  readonly key: string
  readonly token: number
}

export interface DrainReport {
  readonly done: number
  readonly retried: number
  readonly deadLettered: number
  readonly released: number
}

const applied: HandlerResult = { tag: "Applied" }
const nothingToApply: HandlerResult = { tag: "NothingToApply" }

function decoded<A>(schema: Schema.Codec<A>, raw: unknown): A | undefined {
  return Option.getOrUndefined(Schema.decodeUnknownOption(schema)(raw))
}

function parsedJson(text: string): unknown {
  try {
    return JSON.parse(text) as unknown
  } catch {
    return undefined
  }
}

function signedAtOf(header: string): number {
  const stamp = /(?:^|,)\s*t=(\d{1,12})\s*(?:,|$)/.exec(header)
  return stamp === null ? 0 : Number(stamp[1]) * 1000
}

function at(state: ProviderEvent, now: number): ProviderEvent {
  return now > nowOf(state) ? elapse(state, now - nowOf(state)) : state
}

effect function applyAt(state: ProviderEvent, sent: Timed): ProviderEvent!Rejected {
  const current = sent.now > nowOf(state) ? try apply(state, { type: "elapse", elapsed: sent.now - nowOf(state) }) : state
  return try apply(current, sent.event)
}

const eventRows: MachineRows<ProviderEvent, Timed, ProviderEvent, Rejected, NotAState> = {
  table: "provider_events", initial, decodeState, apply: applyAt, next: (state) => state
}

function columnsOf(state: ProviderEvent, now: number, changes: Columns): Columns {
  const leaseEnds = state.lease.phase === "Claimed" ? state.lease.leaseUntil : 0
  return {
    phase: state.phase.tag,
    attempts: state.attempts,
    next_attempt_at: Math.max(state.dueAt, leaseEnds),
    lease_until: state.phase.tag === "Leased" ? state.lease.leaseUntil : null,
    updated_at: now,
    ...(state.phase.tag === "Done" ? { payload: null } : {}),
    ...changes
  }
}

effect function step(tx: Tx, key: string, now: number, event: Event, changes: Columns = {}) {
  return (try stepRow(tx, eventRows, key, { now, event }, (state) => columnsOf(state, now, changes))).state
}

effect function logDeadLetter(state: ProviderEvent, code: string) {
  try annotateLogs(logWarning("a provider event was dead-lettered"), { eventId: state.eventId, eventType: state.eventType, attempts: state.attempts, code })
}

type Intake = "stored" | "revived" | "duplicate"

effect function record(tx: Tx, event: StripeEvent, eventType: ProviderEventType, payload: string, signedAt: number, liveEnvironment: boolean, now: number) {
  const payloadDigest = sha256Hex(payload)
  const loaded = try loadRow(tx, eventRows, event.id)
  const delivery = { payloadDigest, signatureValid: true, signedAt, livemode: event.livemode, liveEnvironment }
  const answer = intakeAnswer(at(loaded.state, now), payloadDigest, true)
  switch (answer) {
    case "StoredNew":
      try step(tx, event.id, now, { type: "receive", eventId: event.id, eventType, ...delivery },
        { type: event.type, livemode: event.livemode, payload, payload_digest: payloadDigest, last_error_code: null, created_at: now })
      return "stored" satisfies Intake
    case "RevivedResend": {
      const revived = try step(tx, event.id, now, { type: "revive", ...delivery }, { last_error_code: null })
      try annotateLogs(logInfo("a dead-lettered provider event was revived"), { eventId: event.id, revivals: revived.revivals })
      return "revived" satisfies Intake
    }
    case "DuplicateDelivery": return "duplicate" satisfies Intake
    case "RefusedOtherPayload": throw refused("IdempotencyConflict")
    case "RefusedUnverified": throw refused("InvalidRequest")
    default: {
      const _exhaustive: never = answer
      return _exhaustive
    }
  }
}

effect function receive(context: RouteContext) {
  const deployment = try Deployment
  const billing = deployment.settings.billing
  if (billing === undefined) throw refused("CapabilityUnavailable")
  const secret = deployment.secret(billing.webhookSecretEnv) catch effect () => { throw refused("ServiceUnavailable", "NoReason", context.now + 5_000) }
  const raw = context.request.text catch effect () => { throw refused("InvalidRequest") }
  const header = context.request.headers["stripe-signature"] ?? ""
  const signedAt = signedAtOf(header)
  const liveEnvironment = deployment.environment === "production"
  const event = decoded(StripeEvent, parsedJson(raw))
  if (event === undefined || !verifiedDelivery(at(initial, context.now), verifyWebhookSignature(raw, header, secret, context.now), signedAt, event.livemode, liveEnvironment)) throw refused("InvalidRequest")
  const store = try Store
  const intake = store.transaction((tx) => record(tx, event, stripeTypes.get(event.type) ?? "OtherEventType", JSON.stringify(event), signedAt, liveEnvironment, context.now)) catch effect (failure) => {
    if (failure instanceof RowConflict) throw refused("ServiceUnavailable", "NoReason", context.now + 5_000)
    throw failure
  }
  return json(intake === "duplicate" ? { received: true, duplicate: true } : { received: true, queued: true })
}

function sinkOf(eventType: ProviderEventType, object: unknown): Sink | undefined {
  switch (eventType) {
    case "CheckoutSessionCompleted":
    case "CheckoutSessionExpired": {
      const session = decoded(StripeCheckoutSession, object)
      return session === undefined ? undefined : { kind: "checkout", session }
    }
    case "InvoicePaid":
    case "InvoicePaymentFailed": {
      const invoice = decoded(StripeInvoice, object)
      return invoice === undefined ? undefined : { kind: "subscription", customerId: invoice.customer }
    }
    case "SubscriptionUpdated":
    case "SubscriptionDeleted": {
      const subscription = decoded(StripeSubscription, object)
      return subscription === undefined ? undefined : { kind: "subscription", customerId: subscription.customer }
    }
    case "ChargeRefunded": {
      const charge = decoded(StripeCharge, object)
      return charge === undefined ? undefined : { kind: "refund", charge }
    }
    case "DisputeFundsWithdrawn":
    case "DisputeFundsReinstated": {
      const dispute = decoded(StripeDispute, object)
      return dispute === undefined ? undefined : { kind: "dispute", dispute }
    }
    case "OtherEventType": return { kind: "unowned" }
    default: {
      const _exhaustive: never = eventType
      return _exhaustive
    }
  }
}

effect function organizationOf(tx: Tx, customerId: string | null) {
  if (customerId === null) return undefined
  const rows = try tx.query(
    "SELECT organization_id AS organization FROM cloud_checkout_customers WHERE customer_id = $1 UNION SELECT key AS organization FROM subscriptions WHERE customer_id = $1",
    [customerId]
  )
  if (rows.length > 1) throw new RowCorrupt({ table: "cloud_checkout_customers", key: customerId, cause: "one provider customer is pinned to two organizations" })
  return toText(rows[0]?.organization)
}

effect function reconcileOrganization(tx: Tx, organizationId: string, now: number) {
  try tx.query("SELECT id FROM organizations WHERE id = $1 FOR UPDATE", [organizationId])
  try reconcileSubscription(tx, organizationId, try observeSubscription(tx, organizationId), now)
  return applied
}

effect function settleCharge(tx: Tx, eventType: ProviderEventType, charge: StripeCharge, deadline: number, now: number) {
  const organizationId = try organizationOf(tx, charge.customer)
  const invoiceId = charge.invoice ?? null
  if (organizationId === undefined || invoiceId === null || (eventType === "ChargeRefunded" && charge.amount_refunded <= 0)) return nothingToApply
  const invoice = try retrieveInvoice(invoiceId, { timeout: Math.max(1, deadline - now) })
  const route = routeOf(eventType, (invoice.parent?.subscription_details?.subscription ?? null) !== null)
  if (route.tag !== "ToAllowance") return nothingToApply
  const change = route.change
  switch (change.tag) {
    case "ClawBack":
      if (change.cause === "NoClawback") return nothingToApply
      try clawBackInvoice(tx, invoice.id, change.cause, now)
      break
    case "RestoreAllowance":
      try restoreInvoice(tx, invoice.id, now)
      break
    default: {
      const _exhaustive: never = change
      return _exhaustive
    }
  }
  return try reconcileOrganization(tx, organizationId, now)
}

effect function applySink(tx: Tx, eventType: ProviderEventType, sink: Sink, deadline: number, now: number) {
  switch (sink.kind) {
    case "checkout": return (try applyCheckoutEvent(tx, sink.session, now)) === undefined ? nothingToApply : applied
    case "subscription": {
      const organizationId = try organizationOf(tx, sink.customerId)
      return organizationId === undefined ? nothingToApply : try reconcileOrganization(tx, organizationId, now)
    }
    case "refund": return try settleCharge(tx, eventType, sink.charge, deadline, now)
    case "dispute": return try settleCharge(tx, eventType, try retrieveCharge(sink.dispute.charge, { timeout: Math.max(1, deadline - now) }), deadline, now)
    case "unowned": return nothingToApply
    default: {
      const _exhaustive: never = sink
      return _exhaustive
    }
  }
}

function handlerErrorOf(failure: unknown): HandlerError {
  if (failure instanceof ProviderEventMalformed) return "PayloadParseFailed"
  if (failure instanceof StripeUnavailable) return failure.status === 429 ? "ProviderThrottled" : "ProviderDown"
  if (failure instanceof StoreFailure || failure instanceof RowConflict) return "StoreBusy"
  return "UnclassifiedError"
}

effect function heldLease(tx: Tx, claimed: Claimed, now: number) {
  const loaded = try loadRow(tx, eventRows, claimed.key)
  return loaded.found && holdsLease(at(loaded.state, now), claimed.token) ? loaded.state : undefined
}

effect function settleDone(claimed: Claimed, deadline: number, now: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const held = try heldLease(tx, claimed, now)
    if (held === undefined) return { kind: "stale" } satisfies Settled
    const payload = (try tx.query("SELECT payload FROM provider_events WHERE key = $1", [claimed.key]))[0]?.payload
    const event = decoded(StripeEvent, payload)
    const sink = event === undefined ? undefined : sinkOf(held.eventType, event.data.object)
    if (sink === undefined) throw new ProviderEventMalformed({ id: claimed.key, type: held.eventType })
    const result = try applySink(tx, held.eventType, sink, deadline, now)
    try step(tx, claimed.key, now, { type: "finish", claimToken: claimed.token, result }, { last_error_code: null })
    return { kind: "done" } satisfies Settled
  })
}

effect function settleFailed(claimed: Claimed, failure: unknown, code: string, now: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    if ((try heldLease(tx, claimed, now)) === undefined) return { kind: "stale" } satisfies Settled
    const settled = try step(tx, claimed.key, now, { type: "finish", claimToken: claimed.token, result: { tag: "Failed", error: handlerErrorOf(failure) } }, { last_error_code: code })
    if (settled.phase.tag !== "DeadLettered") return { kind: "retried" } satisfies Settled
    try logDeadLetter(settled, code)
    return { kind: "deadLettered" } satisfies Settled
  })
}

effect function release(claimed: Claimed, now: number) {
  const store = try Store
  try store.transaction(effect (tx: Tx) => {
    if ((try heldLease(tx, claimed, now)) !== undefined) try step(tx, claimed.key, now, { type: "release", claimToken: claimed.token })
  })
}

type ClaimOutcome =
  | { readonly kind: "claimed"; readonly claimed: Claimed }
  | { readonly kind: "deadLettered" }
  | { readonly kind: "skipped" }

effect function claimOne(tx: Tx, key: string, now: number) {
  const loaded = try loadRow(tx, eventRows, key)
  const current = at(loaded.state, now)
  if (!loaded.found || !canClaim(current)) return { kind: "skipped" } satisfies ClaimOutcome
  const claimed = try step(tx, key, now, { type: "claim" }, current.phase.tag === "Leased" ? { last_error_code: "LeaseLapsed" } : {})
  if (claimed.phase.tag !== "DeadLettered") return { kind: "claimed", claimed: { key, token: claimed.lease.currentClaim } } satisfies ClaimOutcome
  try logDeadLetter(claimed, "LeaseLapsed")
  return { kind: "deadLettered" } satisfies ClaimOutcome
}

effect function claimDue(now: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    const due = try tx.query(
      `SELECT key FROM provider_events WHERE phase IN ('Pending', 'Leased') AND next_attempt_at <= $1
       ORDER BY created_at, key LIMIT $2 FOR UPDATE SKIP LOCKED`,
      [now, drainBatch]
    )
    const claimed: Array<Claimed> = []
    let deadLettered = 0
    for (const row of due) {
      const one: ClaimOutcome = try claimOne(tx, toText(row.key) ?? "", now)
      if (one.kind === "claimed") claimed.push(one.claimed)
      if (one.kind === "deadLettered") deadLettered += 1
    }
    return { claimed, deadLettered }
  })
}

effect function settle(claimed: Claimed, deadline: number, now: number) {
  return settleDone(claimed, deadline, now) catch effect (failure) => {
    try annotateLogs(logWarning("a provider event failed"), { eventId: claimed.key, code: failure._tag })
    return try settleFailed(claimed, failure, failure._tag, now)
  }
}

export effect function drainProviderEvents(now: number): DrainReport!!CloudContext {
  const started = try Clock.currentTimeMillis
  const due = claimDue(now) catch effect (failure) => {
    try annotateLogs(logWarning("provider events could not be claimed"), { failure: failure._tag })
    return { claimed: [], deadLettered: 0 }
  }
  const deadline = now + drainBudget
  const report = { done: 0, retried: 0, deadLettered: due.deadLettered, released: 0 }
  for (const each of due.claimed) {
    const reached = now + (try Clock.currentTimeMillis) - started
    if (reached >= deadline) {
      release(each, reached) catch effect (failure) => { try annotateLogs(logWarning("a provider event could not be released"), { eventId: each.key, failure: failure._tag }) }
      report.released += 1
      continue
    }
    const settled = settle(each, deadline, reached) catch effect (failure) => {
      try annotateLogs(logWarning("a provider event failure could not be recorded"), { eventId: each.key, failure: failure._tag })
      return { kind: "stale" } satisfies Settled
    }
    switch (settled.kind) {
      case "done": report.done += 1; break
      case "retried": report.retried += 1; break
      case "deadLettered": report.deadLettered += 1; break
      case "stale": break
      default: {
        const _exhaustive: never = settled
        return _exhaustive
      }
    }
  }
  return report satisfies DrainReport
}

export effect function drainDue() {
  try drainProviderEvents(try Clock.currentTimeMillis)
}

export const routes: ReadonlyArray<Route> = [
  { method: "POST", path: webhookPath, auth: "ProviderSignature", capability: "billing", maxBodyBytes: maxWebhookBytes, handler: receive }
]

export const sweeps: ReadonlyArray<Sweep> = [{ name: "provider events", everyMs: drainEvery, run: drainDue() }]
