// spec/cloud/billing/entitlements.md, "Story: Read my plan without substituting another account or source"; spec/cloud/billing/subscriptions.md, "Story: Keep my plan as the provider says it is"
import { effectivePolicy, fundingLane, type HeldGrant, type Policy as EffectivePolicy, type PolicyAnswer, type PolicyRead } from "../../gen/cloud__billing__entitlements.effect.vibe"
import type { PlanKey } from "../../gen/cloud__billing__plans.effect.vibe"
import { initial as noSubscription, parseState, type SubscriptionStatus } from "../../gen/cloud__billing__subscriptions.effect.vibe"
import type { FundingLane } from "../../gen/cloud__shared__metering.effect.vibe"
import type { MeteredService } from "../../gen/cloud__shared__types.ts"
import { parsePlanKey } from "./plans.vibe"
import { type StoreFailure, toInt, toText, type Tx } from "../store/connection.vibe"

export type { FundingLane, MeteredService, SubscriptionStatus }

export type PlanSource = "subscription" | "grant" | "free"
export type FundingClass = "inference" | "speech" | "maps"

export interface Policy {
  readonly planKey: PlanKey
  readonly source: PlanSource
  readonly effectiveUntil: number | null
  readonly status: SubscriptionStatus
  readonly effective: EffectivePolicy
}

export error PolicyUnreadable { organizationId: string; problem: string }

const sourceNames = { FromSubscription: "subscription", FromGrant: "grant", FromFree: "free" } as const

function heldGrant(row: Readonly<Record<string, unknown>>): HeldGrant | undefined {
  const planKey = parsePlanKey(row.plan_key)
  const grantId = toText(row.id)
  const organizationId = toText(row.organization_id)
  const startsAt = toInt(row.effective_from)
  const endsAt = row.effective_until === null ? undefined : toInt(row.effective_until)
  const revokedAt = row.revoked === true ? toInt(row.revoked_at) : undefined
  if (planKey === undefined || grantId === undefined || organizationId === undefined || !Number.isSafeInteger(startsAt)) return undefined
  if ((endsAt !== undefined && !Number.isSafeInteger(endsAt)) || (revokedAt !== undefined && !Number.isSafeInteger(revokedAt))) return undefined
  return {
    planKey,
    grant: {
      grantId,
      organizationId,
      idempotencyKey: toText(row.idempotency_key) ?? "",
      startsAt,
      ends: endsAt === undefined ? { tag: "NeverEnds" } : { tag: "EndsAt", endsAtMs: endsAt },
      standing: revokedAt === undefined ? { tag: "InForce" } : { tag: "RevokedAt", revokedAtMs: revokedAt }
    }
  }
}

effect function policyRead(tx: Tx, organizationId: string): PolicyRead!StoreFailure {
  const row = (try tx.query("SELECT state FROM subscriptions WHERE key = $1", [organizationId]))[0]
  const subscription = row === undefined ? noSubscription : parseState(row.state)
  const grants = (try tx.query(
    "SELECT id, organization_id, plan_key, effective_from, effective_until, revoked, revoked_at, idempotency_key FROM grants WHERE organization_id = $1",
    [organizationId]
  )).map(heldGrant)
  if (subscription === undefined || grants.some((grant) => grant === undefined)) return { tag: "PolicyUnreadable" }
  return { tag: "PolicyReadable", subscription, grants: grants.filter((grant): grant is HeldGrant => grant !== undefined) }
}

export effect function readPolicy(tx: Tx, organizationId: string, now: number): Policy!(StoreFailure | PolicyUnreadable) {
  const answer = effectivePolicy(try policyRead(tx, organizationId), now)
  if (answer.tag === "PolicyUnavailable") throw new PolicyUnreadable({ organizationId, problem: "subscription or grant row" })
  const effective = answer.policy
  return {
    planKey: effective.planKey,
    source: sourceNames[effective.source],
    effectiveUntil: effective.ends.tag === "PlanEndsAt" ? effective.ends.endsAtMs : null,
    status: effective.subscription,
    effective
  }
}

export function laneOf(policy: Policy | undefined): FundingLane {
  const answer: PolicyAnswer = policy === undefined ? { tag: "PolicyUnavailable" } : { tag: "PolicyOf", policy: policy.effective }
  return fundingLane(answer)
}

export function fundingOf(policy: Policy | undefined): Readonly<Record<FundingClass, FundingLane>> {
  const lane = laneOf(policy)
  return { inference: lane, speech: lane, maps: lane }
}

export effect function laneFor(tx: Tx, organizationId: string, _service: MeteredService, now: number): FundingLane!StoreFailure {
  const policy = readPolicy(tx, organizationId, now) catch effect (failure) => match (failure) {
    when PolicyUnreadable: undefined;
    default: throw failure;
  }
  return laneOf(policy)
}
