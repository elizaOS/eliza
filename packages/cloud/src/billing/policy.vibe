// spec/cloud/billing/plans.md, "Story: Apply the plan that funds a call"
import { fundedPlan, hasAllowance, type FundingGrant, type PlanKey } from "../../gen/cloud__billing__plans.effect.vibe"
import type { FundingLane } from "../../gen/cloud__shared__metering.effect.vibe"
import type { MeteredService } from "../../gen/cloud__shared__types.ts"
import { parsePlanKey } from "./plans.vibe"
import { StoreFailure, toInt, toText, type Tx } from "../store/connection.vibe"

export type { FundingLane, MeteredService }
export interface Policy { readonly planKey: PlanKey }
export error PolicyUnreadable { organizationId: string; problem: string }

const statuses = new Set(["none","pending","incomplete","active","dunning","past_due","unpaid","canceled","incomplete_expired"])

export effect function readPolicy(tx: Tx, organizationId: string, now: number): Policy!(StoreFailure | PolicyUnreadable) {
  const row = (try tx.query("SELECT status, plan_key, period_end FROM subscriptions WHERE key = $1", [organizationId]))[0]
  const status = row ? toText(row.status) : "none"
  const plan = row ? parsePlanKey(row.plan_key) : "Free"
  if (!status || !statuses.has(status) || plan === undefined) throw new PolicyUnreadable({ organizationId, problem: "subscription row" })
  const active = (status === "active" || status === "dunning") && toInt(row?.period_end) > now
  const rows = try tx.query("SELECT plan_key, effective_from, effective_until, revoked FROM grants WHERE organization_id = $1 AND effective_from <= $2 AND effective_until > $2", [organizationId, now])
  const grants: FundingGrant[] = []
  for (const grant of rows) {
    const planKey = parsePlanKey(grant.plan_key)
    if (planKey === undefined) throw new PolicyUnreadable({ organizationId, problem: "grant row" })
    grants.push({ planKey, effectiveFrom: toInt(grant.effective_from), effectiveUntil: toInt(grant.effective_until), revoked: grant.revoked === true })
  }
  return { planKey: fundedPlan(active, plan, grants, now) }
}

export effect function laneFor(tx: Tx, organizationId: string, _service: MeteredService, now: number): FundingLane!StoreFailure {
  const policy = readPolicy(tx, organizationId, now) catch effect (failure) => match (failure) {
    when PolicyUnreadable: undefined;
    default: throw failure;
  }
  if (policy === undefined) return "Refused"
  return hasAllowance(policy.planKey) ? "AllowanceThenCredits" : "CreditsOnly"
}
