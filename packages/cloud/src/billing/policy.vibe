// spec/cloud/billing/entitlements.md, "Story: Read my plan without substituting another account or source"; spec/cloud/billing/subscriptions.md, "Story: Keep my plan as the provider says it is"
import { hasAllowance, isPaid, rankOf, type PlanKey } from "../../gen/cloud__billing__plans.effect.vibe"
import { hasPaidLimits, type SubscriptionStatus } from "../../gen/cloud__billing__subscriptions.effect.vibe"
import type { FundingLane } from "../../gen/cloud__shared__metering.effect.vibe"
import type { MeteredService } from "../../gen/cloud__shared__types.ts"
import { parsePlanKey, wirePlanKey } from "./plans.vibe"
import { type StoreFailure, toInt, toText, type Tx } from "../store/connection.vibe"

export type { FundingLane, MeteredService, SubscriptionStatus }

export type PlanSource = "subscription" | "grant" | "free"
export type FundingClass = "inference" | "speech" | "maps"

export interface Policy {
  readonly planKey: PlanKey
  readonly source: PlanSource
  readonly effectiveUntil: number | null
  readonly status: SubscriptionStatus
}

export function planSummary(policy: Policy) {
  return { key: wirePlanKey(policy.planKey), source: policy.source, effectiveUntil: policy.effectiveUntil }
}

export error PolicyUnreadable { organizationId: string; problem: string }

const statusOf: Readonly<Record<string, SubscriptionStatus>> = {
  none: "NoSubscription",
  pending: "Pending",
  incomplete: "Incomplete",
  active: "Active",
  dunning: "Dunning",
  past_due: "PastDue",
  unpaid: "Unpaid",
  canceled: "Canceled",
  incomplete_expired: "IncompleteExpired"
}

export effect function readPolicy(tx: Tx, organizationId: string, now: number): Policy!(StoreFailure | PolicyUnreadable) {
  const row = (try tx.query("SELECT status, plan_key, period_end FROM subscriptions WHERE key = $1", [organizationId]))[0]
  const status = row ? statusOf[toText(row.status) ?? ""] : "NoSubscription"
  const subscribed = row ? parsePlanKey(row.plan_key) : "Free"
  if (status === undefined || subscribed === undefined) throw new PolicyUnreadable({ organizationId, problem: "subscription row" })
  const rows = try tx.query(
    "SELECT plan_key, effective_from, effective_until, revoked FROM grants WHERE organization_id = $1 AND NOT revoked AND effective_from <= $2 AND (effective_until IS NULL OR effective_until > $2)",
    [organizationId, now]
  )
  let granted: { readonly planKey: PlanKey; readonly effectiveUntil: number | null } | undefined
  for (const grant of rows) {
    const planKey = parsePlanKey(grant.plan_key)
    if (planKey === undefined) throw new PolicyUnreadable({ organizationId, problem: "grant row" })
    const effectiveUntil = grant.effective_until === null ? null : toInt(grant.effective_until)
    if (granted === undefined || rankOf(planKey) > rankOf(granted.planKey)) granted = { planKey, effectiveUntil }
    else if (planKey === granted.planKey && granted.effectiveUntil !== null) granted = { planKey, effectiveUntil: effectiveUntil === null ? null : Math.max(effectiveUntil, granted.effectiveUntil) }
  }
  if (hasPaidLimits(status) && isPaid(subscribed)) return { planKey: subscribed, source: "subscription", effectiveUntil: toInt(row?.period_end), status }
  if (granted !== undefined && isPaid(granted.planKey)) return { ...granted, source: "grant", status }
  return { planKey: "Free", source: "free", effectiveUntil: null, status }
}

export function laneOf(policy: Policy | undefined): FundingLane {
  if (policy === undefined) return "Refused"
  return hasAllowance(policy.planKey) ? "AllowanceThenCredits" : "CreditsOnly"
}

export function fundingOf(policy: Policy | undefined): Readonly<Record<FundingClass, FundingLane>> {
  const lane = laneOf(policy)
  return { inference: lane, speech: lane, maps: lane }
}

export effect function laneFor(tx: Tx, organizationId: string, _service: MeteredService, now: number): FundingLane!StoreFailure {
  const policy = readPolicy(tx, organizationId, now) catch effect (failure) => match (failure) {
    when PolicyUnreadable: undefined;
    default: throw failure;
  }
  return laneOf(policy)
}
