// spec/cloud/billing/subscriptionCommands.md, "Story: Change or cancel my plan without paying twice"; spec/cloud/billing/subscriptionCommands.md, "A settled command applies only what the provider did, and an upgrade applies only once its invoice is paid"; spec/cloud/billing/subscriptionCommands.md, "Story: See my commands"
import {
  apply, canConfirm, canFinish, canReceiveReply, canResolve, commandStatus, isFinished, mayContinuePayment,
  type UpgradeInvoice
} from "../../gen/cloud__billing__subscriptionCommands.effect.vibe"
import { holdsCommand } from "../../gen/cloud__billing__subscriptions.effect.vibe"
import { refused } from "../http/refusal.vibe"
import { json, jsonBody, type Route, type Sweep } from "../http/routes.vibe"
import { Deployment } from "../profile/profile.vibe"
import {
  bindPlanChange, dispatchPlanUpgrade, failureReply, findUpgradeOrigin, previewPlanChange,
  upgradeInvoice, upgradedSubscription, type StripeUpgradeOrigin, type StripeUpgradeTerms, type StripeUpgradeApplication, type StripeInvoice
} from "../providers/stripe.vibe"
import { dispatchOnce, receiptOwner, renderProviderKey, replyOf, requestDigest, type ProviderReply } from "../shared/dispatch-once.vibe"
import { Store, type Tx } from "../store/connection.vibe"
import { adjustForUpgrade } from "./allowance.vibe"
import { commandIdOf, idempotencyKeyPattern, readRetainedCommand, refuseRetainedCommandConflict } from "./commands.vibe"
import { commandAt, insertPlanCommand, lockOrganization, planCommandView, readPlanCommand, savePlanCommand, upgradeTerms, type PlanCommandRecord } from "./plan-command-state.vibe"
import { consumeReviewedPlanQuote, freshOwner, PlanConfirmation, PlanReviewBody, readReviewedPlanQuote, readSubscriptionForConfirmation, reviewPlanChange, type ReviewedPlanQuote } from "./plan-quotes.vibe"
import { wirePlanKey } from "./plans.vibe"
import { claimLiveCommand, readSubscription, reconcileSubscription, releaseLiveCommand } from "./subscriptions.vibe"

const providerRead = { timeout: 8_000 }
const commandIdPattern = /^cmd_[0-9a-f]{32}$/

effect function commandFor(tx: Tx, organizationId: string, commandId: string, lock: boolean) {
  const row = try readPlanCommand(tx, commandId, lock)
  if (row === undefined || row.organizationId !== organizationId || row.command.kind !== "UpgradeCommand") throw refused("NotFound")
  return row
}

effect function recheckPrices(quote: ReviewedPlanQuote) {
  const terms = quote.command.quote
  const source = wirePlanKey(terms.sourcePlanKey)
  const target = wirePlanKey(terms.targetPlanKey)
  const billing = (try Deployment).settings.billing
  if (billing === undefined || source === "free" || target === "free") throw refused("CapabilityUnavailable")
  if (billing.plans[source].priceId !== quote.binding.sourcePriceId || billing.plans[target].priceId !== quote.binding.targetPriceId)
    throw refused("BillingStateConflict")
  const current = try bindPlanChange({ ...quote.binding, subscriptionId: quote.command.subscriptionId,
    periodStart: terms.periodStart, periodEnd: terms.periodEnd }, providerRead)
  if (current.subscriptionItemId !== quote.binding.subscriptionItemId) throw refused("BillingStateConflict")
  try previewPlanChange(quote.command.subscriptionId, quote.binding, { kind: "recurring", expectedCents: terms.recurringCents }, providerRead)
  const due = try previewPlanChange(quote.command.subscriptionId, quote.binding,
    { kind: "proration", date: terms.effectiveAt, periodEnd: terms.periodEnd }, providerRead)
  if (due !== terms.dueNowCents) throw refused("BillingStateConflict")
}

effect function existingUpgrade(tx: Tx, commandId: string, digest: string, organizationId: string, userId: string, lock: boolean) {
  try refuseRetainedCommandConflict(tx, organizationId, commandId)
  const row = try readPlanCommand(tx, commandId, lock)
  if (row !== undefined) {
    if (row.organizationId !== organizationId || row.command.kind !== "UpgradeCommand" || row.command.receipt.session.owner.actorId !== userId || row.command.receipt.digest !== digest)
      throw refused("IdempotencyConflict")
    return row
  }
  if ((try tx.query("SELECT key FROM subscription_commands WHERE key=$1", [commandId]))[0] !== undefined)
    throw refused("IdempotencyConflict")
  return undefined
}

effect function recordProvider(store: Store.Shape, row: PlanCommandRecord, answer: ProviderReply<StripeUpgradeOrigin>, at: number) {
  try store.transaction(effect (tx: Tx) => {
    try lockOrganization(tx, row.organizationId)
    const current = try commandFor(tx, row.organizationId, row.command.commandId, true)
    const command = commandAt(current.command, at)
    const reply = replyOf(answer)
    if (canReceiveReply(command, reply)) {
      const next = (try apply(command, { type: "receiveReply", reply }, command.receipt.session.owner)).state
      try savePlanCommand(tx, { ...current, command: next, ...(answer.kind === "applied" ? { origin: answer.value } : {}) }, at)
    }
  })
}

type UpgradeEvidence =
  | { readonly kind: "refused" }
  | { readonly kind: "invoice"; readonly origin: StripeUpgradeOrigin; readonly invoice: StripeInvoice; readonly application: StripeUpgradeApplication | undefined }

effect function settleUpgrade(row: PlanCommandRecord, evidence: UpgradeEvidence, at: number) {
  const store = try Store
  return try store.transaction(effect (tx: Tx) => {
    try lockOrganization(tx, row.organizationId)
    try tx.query("SELECT key FROM subscriptions WHERE key=$1 FOR UPDATE", [row.organizationId])
    const current = try commandFor(tx, row.organizationId, row.command.commandId, true)
    let command = commandAt(current.command, at)
    if (isFinished(command)) return current
    let origin = current.origin
    if (evidence.kind === "invoice") {
      if (origin !== undefined && (origin.invoiceId !== evidence.origin.invoiceId || origin.requestId !== evidence.origin.requestId))
        throw refused("BillingStateConflict")
      if (origin === undefined) {
        const lookup = { tag: "EffectSeen" } as const
        if (!canResolve(command, lookup)) return current
        command = (try apply(command, { type: "resolve", lookup }, command.receipt.session.owner)).state
        origin = evidence.origin
      }
    }
    let invoice: UpgradeInvoice = "NoUpgradeInvoice"
    const application = evidence.kind === "invoice" ? evidence.application : undefined
    if (evidence.kind === "invoice") {
      if (evidence.invoice.status === "open") invoice = "UpgradeInvoiceOpen"
      else if (evidence.invoice.status === "void") invoice = "UpgradeInvoiceVoided"
      else if (evidence.invoice.status === "paid" && application !== undefined) invoice = "UpgradeInvoicePaid"
      else {
        if (current.origin === undefined) try savePlanCommand(tx, { ...current, command, origin }, at)
        return { ...current, command, origin }
      }
    }
    const subscription = try readSubscription(tx, row.organizationId)
    if (!holdsCommand(subscription, "UpgradeCommand", command.commandId)) throw refused("BillingStateConflict")
    const terms = command.quote
    const paid = invoice === "UpgradeInvoicePaid"
    if (!canFinish(command, invoice, paid ? subscription.revision : 0)) return current
    let revision = 0
    if (paid && application !== undefined) {
      if (subscription.periodStart > application.periodStart ||
        (subscription.periodStart === application.periodStart && subscription.periodEnd > application.periodEnd)) return current
      const updated = try reconcileSubscription(tx, row.organizationId, {
        customerId: current.binding.customerId, subscriptionId: command.subscriptionId, plan: wirePlanKey(terms.targetPlanKey),
        status: "active", startsAt: application.periodStart, endsAt: application.periodEnd, latestInvoice: "PlanChangeInvoice", cancelAtPeriodEnd: false
      }, at, { kind: "ReviewedUpgrade", commandId: command.commandId, source: terms.sourcePlanKey, target: terms.targetPlanKey })
      revision = updated.revision
    }
    const finished = try apply(command, { type: "finish", invoice, resultRevision: revision }, command.receipt.session.owner)
    for (const action of finished.out) {
      if (action.tag === "AdjustAllowance") {
        try adjustForUpgrade(tx, row.organizationId, action.planKey, action.effectiveAt, action.reviewed, at, terms)
      } else if (action.tag === "ReleaseSlot") try releaseLiveCommand(tx, row.organizationId, action.commandId, at)
      else throw refused("BillingStateConflict")
    }
    const settled = { ...current, command: finished.state, origin } satisfies PlanCommandRecord
    try savePlanCommand(tx, settled, at)
    return settled
  })
}

effect function refreshUpgrade(row: PlanCommandRecord) {
  const now = try Clock.currentTimeMillis
  const command = commandAt(row.command, now)
  if (isFinished(command)) return { row }
  if (command.receipt.settlement === "Refused" || command.receipt.settlement === "NotApplied")
    return { row: try settleUpgrade(row, { kind: "refused" }, now) }
  const terms = upgradeTerms(row)
  const origin = row.origin ?? (commandStatus(command) === "ShowUnknown"
    ? (findUpgradeOrigin(terms, renderProviderKey(command.receipt.providerKey), providerRead) catch () => undefined)
    : undefined)
  if (origin === undefined) return { row }
  const invoice = upgradeInvoice(terms, origin, providerRead) catch () => undefined
  if (invoice === undefined) return { row }
  const application = invoice.status === "paid" ? (upgradedSubscription(terms, providerRead) catch () => undefined) : undefined
  return { row: try settleUpgrade(row, { kind: "invoice", origin, invoice, application }, try Clock.currentTimeMillis), invoice }
}

effect function sendUpgrade(terms: StripeUpgradeTerms, operationKey: string) {
  return effect {
    const origin = try dispatchPlanUpgrade(terms, { idempotencyKey: operationKey, timeout: 30_000 })
    return { kind: "applied", value: origin } as const
  } catch (failure) => failureReply(failure)
}

effect function confirmUpgrade(authorization: string | undefined, input: PlanConfirmation) {
  if (!idempotencyKeyPattern.test(input.idempotencyKey) || input.quoteId === "" ||
    (input.expectedSubscriptionRevision !== undefined && (!Number.isSafeInteger(input.expectedSubscriptionRevision) || input.expectedSubscriptionRevision < 1)))
    throw refused("InvalidRequest")
  const own = try freshOwner(authorization)
  const store = try Store
  const commandId = commandIdOf(own.organizationId, own.userId, input.idempotencyKey)
  const digest = requestDigest({ kind: "UpgradeCommand", quoteId: input.quoteId, expectedRevision: input.expectedSubscriptionRevision ?? null })
  const existing = try store.transaction((tx) => existingUpgrade(tx, commandId, digest, own.organizationId, own.userId, false))
  if (existing !== undefined) return planCommandView((try refreshUpgrade(existing)).row, try Clock.currentTimeMillis)
  const quote = try store.transaction(effect (tx: Tx) => {
    const quoted = try readReviewedPlanQuote(tx, own, input.quoteId)
    try readSubscriptionForConfirmation(tx, own.organizationId, quoted, "UpgradeCommand", input.expectedSubscriptionRevision, try Clock.currentTimeMillis)
    return quoted
  })
  recheckPrices(quote) catch effect (failure) => {
    if (failure._tag === "Refused") throw failure
    throw refused("ProviderUnavailable", "NoReason", (try Clock.currentTimeMillis) + 5_000)
  }
  const fresh = try freshOwner(authorization)
  if (fresh.sessionKey !== own.sessionKey || fresh.userId !== own.userId || fresh.organizationId !== own.organizationId)
    throw refused("AuthenticationRequired")
  const by = receiptOwner(own.organizationId, own.userId, "SubscriptionUpdate")
  const admitted = try store.transaction(effect (tx: Tx) => {
    try lockOrganization(tx, own.organizationId)
    try tx.query("SELECT key FROM subscriptions WHERE key=$1 FOR UPDATE", [own.organizationId])
    const existing = try existingUpgrade(tx, commandId, digest, own.organizationId, own.userId, true)
    if (existing !== undefined) return { row: existing, newDispatch: false }
    const now = try Clock.currentTimeMillis
    const retained = try consumeReviewedPlanQuote(tx, own, input.quoteId)
    const subscription = try readSubscriptionForConfirmation(tx, own.organizationId, retained, "UpgradeCommand", input.expectedSubscriptionRevision, now)
    const quoted = commandAt(retained.command, now)
    const revision = quoted.expectedRevision
    if (!canConfirm(quoted, by, subscription, "UpgradeCommand", commandId, input.quoteId, revision, "", digest, true))
      throw refused("BillingStateConflict")
    const started = try apply(quoted, {
      type: "confirm", sub: subscription, kind: "UpgradeCommand", commandId,
      quoteId: input.quoteId, expectedRevision: revision, attachmentProviderId: "", digest, freshOwner: true
    }, by)
    for (const action of started.out) {
      if (action.tag !== "ClaimSlot") throw refused("BillingStateConflict")
      try claimLiveCommand(tx, own.organizationId, action.kind, action.commandId, action.expectedRevision, now)
    }
    const sent = (try apply(started.state, { type: "send", claimToken: started.state.receipt.session.currentClaim }, by)).state
    const row = { organizationId: own.organizationId, command: sent, binding: retained.binding } satisfies PlanCommandRecord
    try insertPlanCommand(tx, row, now)
    return { row, newDispatch: true }
  })
  if (admitted.newDispatch) {
    const terms = upgradeTerms(admitted.row)
    const operationKey = renderProviderKey(admitted.row.command.receipt.providerKey)
    try dispatchOnce({
      claim: Effect.void,
      send: sendUpgrade(terms, operationKey),
      record: (reply: ProviderReply<StripeUpgradeOrigin>, at: number) => recordProvider(store, admitted.row, reply, at)
    })
  }
  const latest = try store.transaction((tx) => commandFor(tx, own.organizationId, commandId, false))
  return planCommandView((try refreshUpgrade(latest)).row, try Clock.currentTimeMillis)
}

effect function findUpgrade(authorization: string | undefined, commandId: string) {
  const own = try freshOwner(authorization)
  if (!commandIdPattern.test(commandId)) throw refused("NotFound")
  const store = try Store
  return try store.transaction((tx) => commandFor(tx, own.organizationId, commandId, false))
}

function hostedPayment(url: string | null | undefined) {
  if (url === undefined || url === null) return undefined
  try {
    const parsed = new URL(url)
    return parsed.origin === "https://invoice.stripe.com" && !parsed.username && !parsed.password && parsed.pathname.startsWith("/i/") ? url : undefined
  } catch {
    return undefined
  }
}

effect function upgradePayment(authorization: string | undefined, commandId: string) {
  const current = try findUpgrade(authorization, commandId)
  const observed = try refreshUpgrade(current)
  const owner = try freshOwner(authorization)
  if (owner.organizationId !== current.organizationId || !mayContinuePayment(observed.row.command, true) ||
      observed.invoice?.status !== "open") throw refused("BillingStateConflict")
  const url = hostedPayment(observed.invoice.hosted_invoice_url)
  if (url === undefined) throw refused("ProviderUnavailable", "NoReason", (try Clock.currentTimeMillis) + 5_000)
  return { url }
}

export const routes: ReadonlyArray<Route> = [
  { method: "POST", path: "/api/v1/subscriptions/upgrade/review", auth: "FreshSession", area: "SubscriptionRoutes", rateClass: "StandardRequests",
    handler: (context) => effect {
      const request = try jsonBody(context, PlanReviewBody)
      return json(try reviewPlanChange(context.request.headers.authorization, { ...request, kind: "UpgradeCommand" }))
    } },
  { method: "POST", path: "/api/v1/subscriptions/upgrade/confirm", auth: "FreshSession", area: "SubscriptionRoutes", rateClass: "StandardRequests",
    handler: (context) => effect { return json(try confirmUpgrade(context.request.headers.authorization, try jsonBody(context, PlanConfirmation))) } },
  { method: "GET", path: "/api/v1/subscriptions/upgrade/:commandId", auth: "FreshSession", area: "SubscriptionRoutes", rateClass: "StandardRequests",
    handler: (context) => effect {
      const own = try freshOwner(context.request.headers.authorization)
      const commandId = context.params.commandId ?? ""
      if (!commandIdPattern.test(commandId)) throw refused("NotFound")
      const retained = try readRetainedCommand(own.organizationId, commandId, "upgrade")
      if (retained !== undefined) return json(retained)
      const store = try Store
      const row = try store.transaction((tx) => commandFor(tx, own.organizationId, commandId, false))
      return json(planCommandView((try refreshUpgrade(row)).row, try Clock.currentTimeMillis))
    } },
  { method: "POST", path: "/api/v1/subscriptions/upgrade/:commandId/payment", auth: "FreshSession", area: "SubscriptionRoutes", rateClass: "StandardRequests",
    handler: (context) => effect { return json(try upgradePayment(context.request.headers.authorization, context.params.commandId ?? "")) } }
]

export const sweeps: ReadonlyArray<Sweep> = [{ name: "subscription upgrades", everyMs: 60_000, run: effect {
  const store = try Store
  const pending = store.transaction((tx) => tx.query(
    "SELECT key FROM subscription_commands WHERE kind='upgrade' AND stripe_plan_binding IS NOT NULL AND status IN ('prepared','dispatched','unknown','awaiting_payment') ORDER BY updated_at,key LIMIT 100", []
  )) catch () => []
  for (const found of pending) {
    const commandId = found.key
    if (typeof commandId !== "string") continue
    const refreshed = effect {
      const row = try store.transaction((tx) => readPlanCommand(tx, commandId, false))
      if (row?.command.kind === "UpgradeCommand") try refreshUpgrade(row)
    }
    refreshed catch effect (failure) => {
      try annotateLogs(logWarning("a reviewed upgrade could not be settled"), { commandId, failure: failure._tag })
    }
  }
} }]
