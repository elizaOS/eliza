// spec/cloud/operator.md, "Credits go only to an active account"; spec/cloud/operator.md, "The device list shows each key only by its name and dates"; spec/cloud/billing/funds.md, "A fresh request id adds credits, a replay with the same amount answers the first entry, and any other replay is refused"
import type { DeviceRow } from "../../gen/cloud__operator.effect.vibe"
import { addCreditsIn } from "../billing/funds.vibe"
import { revokeAllSessions } from "../identity/sessions.vibe"
import { revokeAll } from "../native-clients/device-keys.vibe"
import { inspectKey } from "../native-clients/grants.vibe"
import { toInt, toText, type Tx } from "../store/store.vibe"
import type { AccountNamed, OperatorCommandHandler, OperatorFlags } from "./admin.vibe"

const wholeMicros = /^\d{1,16}$/

effect function organizationNamed(flags: OperatorFlags) {
  const named: AccountNamed = { kind: "organization", organizationId: try flags.required("organization") }
  return named
}

effect function userNamed(flags: OperatorFlags) {
  const named: AccountNamed = { kind: "user", userId: try flags.required("user") }
  return named
}

effect function addCreditsFromFlags(tx: Tx, flags: OperatorFlags, now: number) {
  const amount = try flags.required("amount")
  const added = try addCreditsIn(tx, {
    organizationId: try flags.required("organization"),
    amount: wholeMicros.test(amount) ? Number(amount) : Number.NaN,
    requestKey: try flags.required("request")
  }, now)
  return [`organization ${added.organizationId}: ${added.replayed ? "credits already added by this request" : `${amount} µUSD added`}, balance ${added.balance} µUSD`]
}

effect function listDevices(tx: Tx, flags: OperatorFlags, now: number) {
  const rows = try tx.query("SELECT COALESCE(g.device_name, '') AS device_name, g.state, g.phase, g.key_expires_at, g.device_epoch AS grant_epoch, g.issued_at, a.device_epoch AS account_epoch FROM device_grants g JOIN accounts a ON a.key = g.user_id WHERE g.user_id = $1 ORDER BY g.issued_at, g.key", [try flags.required("user")])
  const listed: string[] = []
  for (const row of rows) {
    const key = inspectKey(row, now) catch () => undefined
    if (key?.reason === "NoReason") {
      listed.push(JSON.stringify({ deviceName: toText(row.device_name) ?? "", createdAt: toInt(row.issued_at), expiresAt: key.expiresAt } satisfies DeviceRow))
    }
  }
  return listed
}

effect function revokeDevices(tx: Tx, flags: OperatorFlags, now: number) {
  const userId = try flags.required("user")
  const ended = try revokeAll(tx, userId, now)
  try revokeAllSessions(tx, userId, now)
  return [`user ${userId}: ${ended} device keys ended, every session ended`]
}

export const commands: ReadonlyArray<OperatorCommandHandler> = [
  { words: ["credits", "add"], operatorCommand: "AddCredits", valued: ["organization", "amount", "request"], repeated: [], switches: [], account: organizationNamed, run: addCreditsFromFlags },
  { words: ["account", "devices"], operatorCommand: "ListDevices", valued: ["user"], repeated: [], switches: [], account: userNamed, run: listDevices },
  { words: ["account", "revoke-devices"], operatorCommand: "RevokeDevices", valued: ["user"], repeated: [], switches: [], account: userNamed, run: revokeDevices }
]
