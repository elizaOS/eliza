// spec/cloud/operator.md, "A mint runs only for a batch of 1 to 10,000 codes"; spec/cloud/billing/grantCodes.md, "A minted code names a family, a paid plan, a term of whole days or life, a redemption limit and an optional expiry"; spec/cloud/billing/grantCodes.md, "A disabled code stays disabled and issues no new grant, but its grants stand"; spec/cloud/billing/grantCodes.md, "Revoking a grant ends it at once, never before it began, and a revoked grant stays revoked"
import { defaultTerm, type Term } from "../../gen/cloud__billing__grantCodes.effect.vibe"
import { paidPlanKeys, type PlanKey } from "../../gen/cloud__billing__plans.effect.vibe"
import { disableGrantCodes, mintGrantCodes, revokeGrants } from "../billing/grant-codes.vibe"
import { isPaid, parsePlanKey, wirePlanKey } from "../billing/plans.vibe"
import type { Tx } from "../store/store.vibe"
import { OperatorUsageInvalid, type OperatorCommandHandler, type OperatorFlags } from "./admin.vibe"

const wholeNumber = /^\d{1,9}$/

effect function wholeFlag(flags: OperatorFlags, name: string): (number | undefined)!OperatorUsageInvalid {
  const text = flags.values(name)[0]
  if (text === undefined) return undefined
  if (!wholeNumber.test(text)) throw new OperatorUsageInvalid({ problem: `--${name} must be a whole number` })
  return Number(text)
}

effect function planOf(flags: OperatorFlags): PlanKey!OperatorUsageInvalid {
  const plan = parsePlanKey(try flags.required("plan"))
  if (plan === undefined || !isPaid(plan)) throw new OperatorUsageInvalid({ problem: `--plan is one of ${paidPlanKeys.map(wirePlanKey).join(", ")}` })
  return plan
}

effect function termOf(flags: OperatorFlags): Term!OperatorUsageInvalid {
  const days = try wholeFlag(flags, "days")
  if (flags.has("lifetime") && days !== undefined) throw new OperatorUsageInvalid({ problem: "--days and --lifetime are exclusive" })
  if (flags.has("lifetime")) return { tag: "TermLifetime" }
  return days === undefined ? defaultTerm : { tag: "TermDays", days }
}

effect function expiryOf(flags: OperatorFlags): (number | undefined)!OperatorUsageInvalid {
  const text = flags.values("expires-at")[0]
  if (text === undefined) return undefined
  const at = Date.parse(text)
  if (Number.isNaN(at)) throw new OperatorUsageInvalid({ problem: "--expires-at must be a date and time such as 2027-01-31T00:00:00Z" })
  return at
}

effect function mint(tx: Tx, flags: OperatorFlags, now: number) {
  const codes = try mintGrantCodes(tx, {
    family: try flags.required("family"),
    planKey: try planOf(flags),
    term: try termOf(flags),
    requiresNoPaidPlan: flags.has("requires-no-paid-plan"),
    maxRedemptions: (try wholeFlag(flags, "max-redemptions")) ?? 1,
    expiresAt: try expiryOf(flags),
    count: Number(try flags.required("count"))
  }, now)
  return codes
}

effect function disable(tx: Tx, flags: OperatorFlags) {
  const codes = flags.values("code")
  const family = flags.values("family")[0]
  if ((codes.length === 0) === (family === undefined)) throw new OperatorUsageInvalid({ problem: "grants disable needs --code or --family, not both" })
  const disabled = try disableGrantCodes(tx, family === undefined ? { kind: "codes", codes } : { kind: "family", family })
  return [`${disabled} codes disabled; their grants stand`]
}

effect function revoke(tx: Tx, flags: OperatorFlags) {
  const codes = flags.values("code")
  const grantIds = flags.values("grant-id")
  const reason = (try flags.required("reason")).trim()
  if (reason === "" || (codes.length === 0) === (grantIds.length === 0))
    throw new OperatorUsageInvalid({ problem: "grants revoke needs --reason and either --grant-id or --code" })
  const count = try revokeGrants(tx, codes.length === 0 ? { kind: "grants", grantIds } : { kind: "codes", codes }, reason)
  return [`${count} grants revoked`]
}

export const commands: ReadonlyArray<OperatorCommandHandler> = [
  { words: ["grants", "mint"], operatorCommand: "MintGrantCodes", valued: ["family", "plan", "count", "days", "max-redemptions", "expires-at"], repeated: [], switches: ["lifetime", "requires-no-paid-plan"], run: mint },
  { words: ["grants", "disable"], operatorCommand: "DisableGrantCodes", valued: ["family"], repeated: ["code"], switches: [], run: disable },
  { words: ["grants", "revoke"], operatorCommand: "RevokeGrants", valued: ["reason"], repeated: ["code", "grant-id"], switches: [], run: revoke }
]
