// spec/cloud/index.md, "Story: Use inference on my subscription or funded pilot account"; spec/cloud/index.md, "A streamed answer sends complete OpenAI frames and settles the same hold"; spec/cloud/services/inference.md, "A provider's 400 keeps only its listed code and parameter and a short message for the caller"
import { FetchHttpClient, HttpClient, HttpClientRequest, type HttpClientResponse } from "effect/http"
import { providerMessageChars, type ProviderDetail, type ProviderField } from "../../gen/cloud__services__inference.effect.vibe"
import type { Millis } from "../../gen/cloud__shared__types.ts"
import type { InferenceSettings } from "../profile/profile.schema.ts"
import { Deployment } from "../profile/profile.vibe"
import { boundedText } from "./bounded-body.vibe"

export type LlmProvider = (typeof InferenceSettings.Type)["providers"][number]
export type ChatBody = Readonly<Record<string, unknown>>

export error ProviderRefused { status: number; retryAfter?: Millis; sent?: ProviderDetail }
export error ProviderUnreachable
export error ProviderTimedOut
export error ProviderInvalidResponse
export type LlmFailure = ProviderRefused | ProviderUnreachable | ProviderTimedOut | ProviderInvalidResponse

export interface LlmAnswer {
  readonly json: ChatBody
  readonly usage?: unknown
}

const providerBudget: Millis = 800_000
export const maxReplyBytes = 16 * 1024 * 1024
const rejectionBytes = 16 * 1024
const absent: ProviderField = { tag: "FieldAbsent" }

type LlmContext = Deployment | HttpClient.HttpClient

export function retryAfter(header: string | undefined): Millis | undefined {
  return header !== undefined && /^\d{1,9}$/.test(header) ? Number(header) * 1000 : undefined
}

export function readLlmObject(text: string): ChatBody | undefined {
  try {
    const value: unknown = JSON.parse(text)
    return typeof value === "object" && value !== null && !Array.isArray(value) ? value as ChatBody : undefined
  } catch {
    return undefined
  }
}

effect function released(response: HttpClientResponse.HttpClientResponse): void!! {
  Stream.runHead(response.stream) catch () => undefined
}

function fieldOf(value: unknown): ProviderField {
  return typeof value === "string" ? { tag: "FieldSent", value } : absent
}

function messageOf(value: unknown, cacheKey: unknown): ProviderField {
  if (typeof value !== "string") return absent
  const redacted = typeof cacheKey === "string" && cacheKey !== "" ? value.replaceAll(cacheKey, "[REDACTED_PROMPT_CACHE_KEY]") : value
  const kept = redacted.trim().slice(0, providerMessageChars)
  return kept === "" ? absent : { tag: "FieldSent", value: kept }
}

effect function rejectionOf(response: HttpClientResponse.HttpClientResponse, body: ChatBody): ProviderDetail!! {
  const text = boundedText(response, rejectionBytes) catch effect () => {
    try released(response)
    return ""
  }
  const said = readLlmObject(text)
  const envelope = said?.error
  const fields = typeof envelope === "object" && envelope !== null && !Array.isArray(envelope) ? envelope as ChatBody : said
  return { code: fieldOf(fields?.code), param: fieldOf(fields?.param), message: messageOf(fields?.message, body.prompt_cache_key) }
}

effect function accepted(provider: LlmProvider, body: ChatBody): HttpClientResponse.HttpClientResponse!(ProviderRefused | ProviderUnreachable)!LlmContext {
  const key = try orDie((try Deployment).secret(provider.apiKeyEnv))
  const request = HttpClientRequest.post(`${provider.baseUrl}/chat/completions`).pipe(
    HttpClientRequest.bearerToken(key),
    HttpClientRequest.bodyText(JSON.stringify(body), "application/json")
  )
  const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "manual" }) catch effect () => { throw new ProviderUnreachable() }
  if (response.status >= 200 && response.status < 300) return response
  const wait = retryAfter(response.headers["retry-after"])
  const sent = response.status === 400 ? try rejectionOf(response, body) : undefined
  if (sent === undefined) try released(response)
  throw new ProviderRefused({ status: response.status, ...(wait === undefined ? {} : { retryAfter: wait }), ...(sent === undefined ? {} : { sent }) })
}

export effect function complete(provider: LlmProvider, body: ChatBody): LlmAnswer!LlmFailure!LlmContext {
  const answer = effect {
    const response = try accepted(provider, body)
    const chunks: string[] = []
    let length = 0
    const decoder = new TextDecoder()
    const bytes = Stream.mapError(response.stream, () => new ProviderUnreachable())
    try Stream.runForEach(bytes, effect (chunk: Uint8Array) => {
      length += chunk.byteLength
      if (length > maxReplyBytes) throw new ProviderInvalidResponse()
      chunks.push(decoder.decode(chunk, { stream: true }))
    })
    const json = readLlmObject(chunks.join("") + decoder.decode())
    if (json === undefined) throw new ProviderInvalidResponse()
    return json.usage === undefined ? { json } : { json, usage: json.usage }
  }
  return try timeoutOrElse(answer, { duration: providerBudget, orElse: () => fail(new ProviderTimedOut()) })
}

export effect function stream(provider: LlmProvider, body: ChatBody): Stream.Stream<Uint8Array, LlmFailure>!LlmFailure!LlmContext {
  const deadline = (try Clock.currentTimeMillis) + providerBudget
  const forced = { ...body, stream: true, stream_options: { include_usage: true } }
  const response = try timeoutOrElse(accepted(provider, forced), { duration: providerBudget, orElse: () => fail(new ProviderTimedOut()) })
  if (!(response.headers["content-type"] ?? "").toLowerCase().startsWith("text/event-stream")) {
    try released(response)
    throw new ProviderInvalidResponse()
  }
  const expired = effect {
    try sleep(Math.max(0, deadline - (try Clock.currentTimeMillis)))
    throw new ProviderTimedOut()
  }
  return Stream.mapError(response.stream, (): LlmFailure => new ProviderUnreachable()).pipe(Stream.interruptWhen(expired))
}
