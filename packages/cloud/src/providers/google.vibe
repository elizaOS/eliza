// spec/cloud/services/google/connection.md, "Story: Connect my Google account with the access I chose"; spec/cloud/shared/dispatchOnce.md, "Story: Send a change once and recover its outcome without sending it again"
import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import { boundedText, ProviderBodyTooLarge } from "./bounded-body.vibe"
import type { ProviderReply } from "../../gen/cloud__shared__dispatchOnce.ts"
import { millisPerSecond } from "../../gen/cloud__shared__types.effect.vibe"
import type { GoogleSettings } from "../profile/profile.schema.ts"
import { Deployment, type SecretMissing } from "../profile/profile.vibe"
import { SealingFailed, seal, unseal } from "../shared/sealing.vibe"

export error InvalidGrant
export error NotFound
export error PreconditionFailed
export error Duplicate
export error ContentTooLarge
export error Rejected { status: number }
export error Unavailable
export error InvalidResponse
export type GoogleFailure = InvalidGrant | NotFound | PreconditionFailed | Duplicate | ContentTooLarge | Rejected | Unavailable | InvalidResponse

export type GoogleMethod = "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
export type GoogleProfile = typeof GoogleSettings.Type
export type GoogleContext = Deployment | HttpClient.HttpClient

export interface GoogleTokens {
  readonly refreshToken: string
  readonly accessToken: string
  readonly expiresAt: number
}

export interface Refreshed {
  readonly tokens: GoogleTokens
  readonly sealed: string
  readonly scopes: ReadonlyArray<string> | undefined
}

export interface JsonOptions {
  readonly body?: unknown
  readonly ifMatch?: string
  readonly maxBytes?: number
}

export const providerTimeout = 10 * millisPerSecond
export const defaultMaxBytes = 16 * 1024 * 1024
const tokenMaxBytes = 64 * 1024

schema TokenReply { access_token: string; expires_in: number; refresh_token?: string; scope?: string }
schema SealedTokens { refreshToken: string; accessToken: string; expiresAt: number }
schema OAuthError { error: string }

function decoded<A>(schema: Schema.Codec<A>, raw: unknown): A | undefined {
  return Option.getOrUndefined(Schema.decodeUnknownOption(schema)(raw))
}

function parsed(text: string): unknown {
  try {
    return text === "" ? null : JSON.parse(text) as unknown
  } catch {
    return undefined
  }
}

function failureOf(status: number): GoogleFailure {
  if (status === 401) return new InvalidGrant()
  if (status === 404 || status === 410) return new NotFound()
  if (status === 409) return new Duplicate()
  if (status === 412) return new PreconditionFailed()
  if (status === 429 || status >= 500) return new Unavailable()
  if (status >= 400) return new Rejected({ status })
  return new InvalidResponse()
}

export function failureReply(failure: GoogleFailure): ProviderReply {
  switch (failure._tag) {
    case "NotFound": return { tag: "DefiniteRefusal", cause: "NotFoundAtProvider" }
    case "InvalidGrant": return { tag: "DefiniteRefusal", cause: "AuthorizationLost" }
    case "PreconditionFailed":
    case "Duplicate":
    case "Rejected": return { tag: "DefiniteRefusal", cause: "OtherRefusal" }
    case "ContentTooLarge":
    case "Unavailable":
    case "InvalidResponse": return { tag: "Unclear" }
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}

export effect function googleProfile(): GoogleProfile!Unavailable!Deployment {
  const google = (try Deployment).settings.google
  if (google === undefined) throw new Unavailable()
  return google
}

effect function exchange(request: HttpClientRequest.HttpClientRequest, maxBytes: number): { status: number; body: unknown }!(ContentTooLarge | Unavailable | InvalidResponse)!HttpClient.HttpClient {
  const answered = effect {
    const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "manual" }) catch effect () => { throw new Unavailable() }
    const text = boundedText(response, maxBytes) catch effect (failure) => {
      if (failure instanceof ProviderBodyTooLarge) throw new ContentTooLarge()
      throw new Unavailable()
    }
    const body = parsed(text)
    if (body === undefined && response.status >= 200 && response.status < 300) throw new InvalidResponse()
    return { status: response.status, body }
  }
  return try timeoutOrElse(answered, { duration: providerTimeout, orElse: () => fail(new Unavailable()) })
}

export effect function googleJson(access: string, method: GoogleMethod, path: string, options: JsonOptions = {}): unknown!GoogleFailure!GoogleContext {
  const google = try googleProfile()
  let request = HttpClientRequest.make(method)(`${google.apiUrl}${path}`).pipe(HttpClientRequest.bearerToken(access), HttpClientRequest.acceptJson)
  if (options.body !== undefined) request = HttpClientRequest.bodyText(request, JSON.stringify(options.body), "application/json")
  if (options.ifMatch !== undefined) request = HttpClientRequest.setHeader(request, "if-match", options.ifMatch)
  const answer = try exchange(request, options.maxBytes ?? defaultMaxBytes)
  if (answer.status >= 200 && answer.status < 300) return answer.body
  throw failureOf(answer.status)
}

export effect function tokenForm(url: string, form: URLSearchParams) {
  const request = HttpClientRequest.bodyText(HttpClientRequest.post(url), form.toString(), "application/x-www-form-urlencoded").pipe(HttpClientRequest.acceptJson)
  return try exchange(request, tokenMaxBytes)
}

function oauthError(body: unknown): string | undefined {
  return decoded(OAuthError, body)?.error
}

effect function sealingOnly<A>(program: A!(SecretMissing | SealingFailed)!Deployment): A!SealingFailed!Deployment {
  return program catch effect (failure) => {
    if (failure._tag === "SecretMissing") return try die(failure)
    throw failure
  }
}

export effect function sealTokens(tokens: GoogleTokens): string!SealingFailed!Deployment {
  return try sealingOnly(seal("google-tokens", JSON.stringify(tokens)))
}

export effect function openTokens(sealed: string): GoogleTokens!SealingFailed!Deployment {
  const tokens = decoded(SealedTokens, parsed(try sealingOnly(unseal("google-tokens", sealed))))
  if (tokens === undefined) throw new SealingFailed({ purpose: "google-tokens", cause: "not a token record" })
  return tokens
}

export effect function refreshAccess(sealedTokens: string): Refreshed!(GoogleFailure | SealingFailed)!GoogleContext {
  const google = try googleProfile()
  const held = try openTokens(sealedTokens)
  const secret = try orDie((try Deployment).secret(google.clientSecretEnv))
  const answer = try tokenForm(google.tokenUrl, new URLSearchParams({
    grant_type: "refresh_token",
    refresh_token: held.refreshToken,
    client_id: google.clientId,
    client_secret: secret
  }))
  if (answer.status === 400 || answer.status === 401) throw oauthError(answer.body) === "invalid_grant" ? new InvalidGrant() : new Unavailable()
  if (answer.status < 200 || answer.status >= 300) throw failureOf(answer.status)
  const reply = decoded(TokenReply, answer.body)
  if (reply === undefined || reply.access_token === "" || !(reply.expires_in > 0)) throw new InvalidResponse()
  const now = try Clock.currentTimeMillis
  const tokens: GoogleTokens = { refreshToken: reply.refresh_token ?? held.refreshToken, accessToken: reply.access_token, expiresAt: now + reply.expires_in * millisPerSecond }
  return { tokens, sealed: try sealTokens(tokens), scopes: reply.scope?.split(/\s+/).filter((scope) => scope !== "") }
}

export effect function revokeToken(token: string): void!GoogleFailure!GoogleContext {
  const google = try googleProfile()
  const answer = try tokenForm(google.revokeUrl, new URLSearchParams({ token }))
  if (answer.status >= 200 && answer.status < 300) return
  if (answer.status === 400 && oauthError(answer.body) === "invalid_token") return
  throw failureOf(answer.status)
}
