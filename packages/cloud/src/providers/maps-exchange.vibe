// spec/cloud/services/maps.md, "A request reaches the provider only under the standing that admitted it, for at most 10 seconds and 2 MiB"; spec/cloud/services/maps.md, "A dispatched request is charged what the provider billed, or its quote when the reply was lost, and one never dispatched is charged nothing"
import { FetchHttpClient, HttpClient, type HttpClientRequest, type HttpClientResponse } from "effect/http"
import { billingOf, upstreamBodyCap, upstreamTimeout, type TravelMode as SpecMode } from "../../gen/cloud__services__maps.effect.vibe"
import type { Micros } from "../../gen/cloud__shared__types.ts"
import type { TravelMode } from "../services/maps.schema.ts"
import { boundedBytes } from "./bounded-body.vibe"
import type { MapsContext, MapsReply, ProviderRefusal } from "./maps.vibe"

export error Refused { code: ProviderRefusal }
export error Rejected { status: number }
export error Lost { cause: string }
export type Stop = Refused | Rejected | Lost
export type Meter = { observed: Micros }
export type Got = { readonly status: number; readonly bytes: Uint8Array; readonly contentType: string | undefined }

export const specModeOf: Readonly<Record<TravelMode, SpecMode>> = { drive: "Drive", walk: "Walk", bicycle: "Bicycle", transit: "Transit" }

effect function capped(response: HttpClientResponse.HttpClientResponse): Uint8Array!(Refused | Lost) {
  return boundedBytes(response, upstreamBodyCap) catch effect (failure) => {
    if (failure._tag === "ProviderBodyTooLarge") throw new Refused({ code: "ProviderUnavailable" })
    throw new Lost({ cause: failure._tag })
  }
}

export effect function send(meter: Meter, request: HttpClientRequest.HttpClientRequest, price: Micros, unclear?: (got: Got) => ProviderRefusal | undefined): Got!Stop!HttpClient.HttpClient {
  const exchange = effect {
    const response = Effect.provideService(HttpClient.execute(request), FetchHttpClient.RequestInit, { redirect: "manual" }) catch effect (cause) => { throw new Lost({ cause: cause._tag }) }
    const billing = billingOf(response.status)
    if (billing === "CallBilled") meter.observed += price
    if (billing === "CallUnclear" && unclear !== undefined) {
      const code = unclear({ status: response.status, bytes: try capped(response), contentType: response.headers["content-type"] })
      if (code !== undefined) throw new Refused({ code })
      throw new Lost({ cause: `status ${response.status}` })
    }
    if (billing !== "CallBilled") {
      Stream.runHead(response.stream) catch () => undefined
      if (billing === "CallNotBilled") throw new Rejected({ status: response.status })
      throw new Lost({ cause: `status ${response.status}` })
    }
    return { status: response.status, bytes: try capped(response), contentType: response.headers["content-type"] }
  }
  return try timeoutOrElse(exchange, { duration: upstreamTimeout, orElse: () => fail(new Lost({ cause: "timeout" })) })
}

export effect function jsonOf(got: Got): unknown!Refused {
  if (got.status !== 200) throw new Refused({ code: "ProviderInvalidResponse" })
  const text = new TextDecoder().decode(got.bytes)
  return try Effect.try({ try: () => JSON.parse(text) as unknown, catch: () => new Refused({ code: "ProviderInvalidResponse" }) })
}

export effect function conforming<A>(json: unknown, schema: Schema.Decoder<A>): A!Refused {
  return Schema.decodeUnknownEffect(schema)(json) catch effect () => { throw new Refused({ code: "ProviderInvalidResponse" }) }
}

export effect function decoded<A>(got: Got, schema: Schema.Decoder<A>): A!Refused {
  return try conforming(try jsonOf(got), schema)
}

export effect function metered<A>(work: (meter: Meter) => A!Stop!MapsContext): MapsReply<A>!!MapsContext {
  const meter: Meter = { observed: 0 }
  const answered = effect {
    const value = try work(meter)
    return { kind: "answered", value, observedMicros: meter.observed } satisfies MapsReply<A>
  }
  return answered catch (stop): MapsReply<A> => match (stop) {
    when Refused: { kind: "refused", code: stop.code, observedMicros: meter.observed };
    when Rejected: { kind: "refused", code: "ProviderUnavailable", observedMicros: meter.observed };
    when Lost: { kind: "unknown", cause: stop.cause };
  }
}

export function routeId(parts: string): string {
  let low = 0x811c9dc5
  let high = 0x01000193
  for (let index = 0; index < parts.length; index += 1) {
    low = Math.imul(low ^ parts.charCodeAt(index), 0x01000193) >>> 0
    high = Math.imul(high ^ parts.charCodeAt(parts.length - 1 - index), 0x01000193) >>> 0
  }
  return `route_${low.toString(16).padStart(8, "0")}${high.toString(16).padStart(8, "0")}`
}
