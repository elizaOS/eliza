// spec/cloud/services/maps.md, "A request reaches the provider only under the standing that admitted it, for at most 10 seconds and 2 MiB"; spec/cloud/services/maps.md, "A request is quoted from the provider's price table with no markup"; spec/cloud/services/maps.md, "A dispatched request is charged what the provider billed, or its quote when the reply was lost, and one never dispatched is charged nothing"
import { type HttpClient, HttpClientRequest } from "effect/http"
import { providerQuote, supportsMode, type MapsOperation, type TravelMode as SpecMode } from "../../gen/cloud__services__maps.effect.vibe"
import type { MapsSettings } from "../profile/profile.schema.ts"
import { MapsPlace, MapsRoute, type Maneuver, type MapsPlaceResponse, type MapsPlacesResponse, type MapsRoutesResponse, type MapsRouteStep, type TextSearchRequest, type TravelMode } from "../services/maps.schema.ts"
import type { MapsProvider, ProviderRefusal } from "./maps.vibe"
import { conforming, decoded, jsonOf, metered, Refused, routeId, send, specModeOf, type Got, type Meter, type Stop } from "./maps-exchange.vibe"

export type OsmSettings = Extract<typeof MapsSettings.Type, { readonly provider: "osm" }>

schema NominatimAddress { house_number?: string; road?: string }
schema NominatimTags { phone?: string; website?: string; opening_hours?: string }
schema NominatimEntry { osm_type?: string; osm_id?: number; lat: string; lon: string; name?: string | null; display_name?: string; address?: NominatimAddress | null; extratags?: NominatimTags | null }
schema NominatimMiss { error: string }
schema HopperInstruction { text: string; distance: number; interval: Array<number>; sign?: number }
schema HopperPoints { coordinates: Array<Array<number>> }
schema HopperPath { distance: number; time: number; points: HopperPoints; instructions: Array<HopperInstruction> }
schema HopperReply { paths: Array<HopperPath> }
schema HopperMessage { message: string }

export const osmAttribution = "© OpenStreetMap contributors (ODbL). Search: Nominatim. Routing: GraphHopper."

const headers = { accept: "application/json", "user-agent": "elizaOS-Cloud-Maps/1" }
const osmId = /^[NWR][1-9][0-9]{0,18}$/
const osmPrefixes: Readonly<Record<string, "N" | "W" | "R">> = { node: "N", way: "W", relation: "R" }
const graphHopperProfiles: Readonly<Partial<Record<TravelMode, string>>> = { drive: "car", walk: "foot", bicycle: "bike" }
const graphHopperSigns: Readonly<Record<number, Maneuver>> = {
  [-98]: "u-turn", [-8]: "u-turn", 8: "u-turn", [-7]: "keep-left", 7: "keep-right", [-3]: "sharp-left", [-2]: "left", [-1]: "slight-left",
  0: "continue", 1: "slight-right", 2: "right", 3: "sharp-right", 4: "arrive", 5: "continue", 6: "roundabout", [-6]: "continue",
}
const isPlace = Schema.is(MapsPlace)
const isRoute = Schema.is(MapsRoute)
const isMiss = Schema.is(NominatimMiss)
const hopperMessage = Schema.decodeUnknownOption(Schema.fromJsonString(HopperMessage))

function nameOf(entry: NominatimEntry): string {
  const street = entry.address?.house_number !== undefined && entry.address.road !== undefined ? `${entry.address.house_number} ${entry.address.road}` : undefined
  return [entry.name, street, entry.display_name?.split(",")[0]].map((name) => name?.trim() ?? "").find((name) => name !== "") ?? ""
}

function placeOf(entry: NominatimEntry, detail: boolean, fetchedAt: number): ReadonlyArray<MapsPlace> | undefined {
  const prefix = osmPrefixes[entry.osm_type ?? ""]
  if (prefix === undefined || entry.osm_id === undefined || !Number.isSafeInteger(entry.osm_id) || entry.osm_id <= 0) return []
  const base = {
    providerId: "osm", id: `${prefix}${entry.osm_id}`, name: nameOf(entry), coordinate: { latitude: Number(entry.lat), longitude: Number(entry.lon) },
    ...(entry.display_name === undefined ? {} : { address: entry.display_name }), attribution: osmAttribution, fetchedAt,
  }
  if (!isPlace(base)) return undefined
  const tags = detail ? entry.extratags ?? {} : {}
  const extras = [["phone", tags.phone?.split(";")[0].trim()], ["website", tags.website?.split(";")[0].trim()], ["openingHours", tags.opening_hours?.trim()]] as const
  let place: MapsPlace = base
  for (const [key, value] of extras) {
    const next = { ...place, [key]: value }
    if (value !== undefined && isPlace(next)) place = next
  }
  return [place]
}

function unroutableOf(got: Got): ProviderRefusal | undefined {
  const reply = got.status === 400 ? hopperMessage(new TextDecoder().decode(got.bytes)) : undefined
  const message = reply?._tag === "Some" ? reply.value.message.toLowerCase() : ""
  if (message.includes("out of bounds")) return "UnsupportedRegion"
  if (message.includes("cannot find point") || message.includes("connection between locations not found")) return "NoRoute"
  return undefined
}

function stepsOf(path: HopperPath, geometry: MapsRoute["geometry"]): ReadonlyArray<MapsRouteStep> | undefined {
  const steps = path.instructions.map((step, index): MapsRouteStep | undefined => {
    const coordinate = geometry[step.interval[0] ?? -1]
    const maneuver = index === 0 && step.sign === 0 ? "depart" : step.sign === undefined ? undefined : graphHopperSigns[step.sign]
    return coordinate === undefined ? undefined : { instruction: step.text, coordinate, distanceMeters: step.distance, ...(maneuver === undefined ? {} : { maneuver }) }
  })
  return steps.every((step) => step !== undefined) ? steps : undefined
}

export function osmMapsProvider(settings: OsmSettings): MapsProvider {
  const base = settings.baseUrl.replace(/\/+$/, "")
  const price = (op: MapsOperation, mode: SpecMode) => providerQuote("OsmMaps", op, false, mode)
  const single = (place: MapsPlace | undefined): MapsPlaceResponse => ({ providerId: settings.provider, attribution: osmAttribution, place: place ?? null })

  effect function nominatim(meter: Meter, op: MapsOperation, path: "search" | "reverse" | "lookup", params: Readonly<Record<string, string>>) {
    const request = HttpClientRequest.get(`${base}/nominatim/${path}`, { urlParams: { format: "jsonv2", extratags: "1", addressdetails: "1", ...params } }).pipe(HttpClientRequest.setHeaders(headers))
    return try send(meter, request, price(op, "Drive"))
  }

  effect function stamped(entries: ReadonlyArray<NominatimEntry>, detail: boolean): ReadonlyArray<MapsPlace>!Refused {
    const fetchedAt = try Clock.currentTimeMillis
    const found = entries.map((entry) => placeOf(entry, detail, fetchedAt))
    if (found.some((place) => place === undefined)) throw new Refused({ code: "ProviderInvalidResponse" })
    return found.flatMap((place) => place ?? [])
  }

  effect function places(meter: Meter, op: MapsOperation, request: TextSearchRequest): MapsPlacesResponse!Stop!HttpClient.HttpClient {
    const near = request.near
    const got = try nominatim(meter, op, "search", {
      q: request.query,
      limit: String(request.limit ?? 10),
      ...(op === "Geocode" ? { layer: "address" } : {}),
      ...(near === undefined ? {} : { viewbox: [near.longitude - 0.1, near.latitude + 0.1, near.longitude + 0.1, near.latitude - 0.1].join(",") }),
    })
    return { providerId: settings.provider, attribution: osmAttribution, places: try stamped(try decoded(got, Schema.Array(NominatimEntry)), false) }
  }

  return {
    geocode: (request) => metered(effect (meter) => try places(meter, "Geocode", request)),
    search: (request) => metered(effect (meter) => try places(meter, "PlacesSearch", request)),
    reverse: (request) => metered(effect (meter) => {
      const json = try jsonOf(try nominatim(meter, "Reverse", "reverse", { lat: String(request.coordinate.latitude), lon: String(request.coordinate.longitude), zoom: "18" }))
      if (isMiss(json)) {
        if (json.error === "Unable to geocode") return single(undefined)
        throw new Refused({ code: "ProviderInvalidResponse" })
      }
      return single((try stamped([try conforming(json, NominatimEntry)], true))[0])
    }),
    details: (request) => metered(effect (meter) => {
      if (!osmId.test(request.id)) return single(undefined)
      const entries = try decoded(try nominatim(meter, "PlaceDetails", "lookup", { osm_ids: request.id }), Schema.Array(NominatimEntry))
      return single((try stamped(entries, true))[0])
    }),
    routes: (request) => metered(effect (meter) => {
      const mode = specModeOf[request.mode]
      const profile = graphHopperProfiles[request.mode]
      if (!supportsMode("OsmMaps", mode) || profile === undefined) throw new Refused({ code: "UnsupportedMode" })
      const count = request.alternatives === true ? 3 : 1
      const payload = {
        points: [[request.from.longitude, request.from.latitude], [request.to.longitude, request.to.latitude]], profile, points_encoded: false, instructions: true, locale: "en",
        ...(count > 1 ? { algorithm: "alternative_route", "alternative_route.max_paths": count } : {}),
      }
      const call = HttpClientRequest.post(`${base}/graphhopper/route`).pipe(HttpClientRequest.setHeaders(headers), HttpClientRequest.bodyText(JSON.stringify(payload), "application/json"))
      const reply = try decoded(try send(meter, call, price("Routes", mode), unroutableOf), HopperReply)
      const fetchedAt = try Clock.currentTimeMillis
      const found = reply.paths.slice(0, count).map((path, index): MapsRoute | undefined => {
        const geometry = path.points.coordinates.map((pair) => ({ latitude: pair[1] ?? Number.NaN, longitude: pair[0] ?? Number.NaN }))
        const steps = stepsOf(path, geometry)
        if (steps === undefined) return undefined
        const candidate = {
          providerId: settings.provider, from: request.from, to: request.to, mode: request.mode, geometry, distanceMeters: path.distance, durationSeconds: path.time / 1000,
          steps, attribution: osmAttribution, traffic: "none",
        } as const
        const built = { id: routeId(JSON.stringify({ revision: settings.datasetRevision, profile, index, ...candidate })), ...candidate, fetchedAt }
        return isRoute(built) ? built : undefined
      })
      if (found.some((route) => route === undefined)) throw new Refused({ code: "ProviderInvalidResponse" })
      const [first, ...rest] = found.flatMap((route) => route ?? [])
      if (first === undefined) throw new Refused({ code: "NoRoute" })
      return { providerId: settings.provider, attribution: osmAttribution, routes: [first, ...rest] } satisfies MapsRoutesResponse
    }),
  }
}
