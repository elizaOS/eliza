// spec/cloud/client.md, "Story: Use the cloud from the device as configured"; spec/cloud/client.md, "Story: Tell an account that needs attention from a failing service"; spec/cloud/services/inference.md, "Story: Stream a reply in the shape clients read"
import { callOf, originAccepted } from "../../gen/cloud__client.effect.vibe"
import { answerOf, bodyOf, queryOf, unreadable, type CallOptions, type CloudAnswer } from "./answer.vibe"
import type { ChatRequest } from "../services/chat-request.schema.ts"
import { isDone, pushByte, segmenter } from "../services/sse.ts"
import { parseEntitlementKeys, type EntitlementKey } from "./entitlement.vibe"
import { CloudError, networkError, readCloudError } from "./errors.vibe"
import { googleCalls } from "./google.vibe"
import { mapsCalls } from "./maps.vibe"
import { admitsHeader, httpVerb, idempotencyKey, listedRoute, lookupPath, renderPath, routesByName, type DeviceRoute } from "./routes.vibe"
import { commandsFromResponse, snapshotFromResponse, type BillingSnapshot, type CommandsPage } from "./views.vibe"

export interface CloudClientOptions {
  readonly baseUrl: string
  readonly credential: () => string | undefined
  readonly fetch?: typeof globalThis.fetch
}

type CloudRequest = CallOptions & {
  readonly params?: Readonly<Record<string, string>>
  readonly query?: Readonly<Record<string, string>>
  readonly headers?: Readonly<Record<string, string>>
} & ({ readonly json?: unknown; readonly form?: never } | { readonly json?: never; readonly form: FormData })

interface TransportAnswer extends CloudAnswer {
  stream(): ReadableStream<Uint8Array>
}

export interface CloudTransport {
  call(route: DeviceRoute, request?: CloudRequest): Promise<TransportAnswer>
}

const cents = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const optionalText = Schema.NullOr(Schema.String)
const paidPlanKey = Schema.Literals(["plus_monthly", "pro_monthly"])

const accountSchema = Schema.Struct({
  success: Schema.Literal(true),
  data: Schema.Struct({
    id: Schema.String,
    email: Schema.optionalKey(Schema.String),
    phone: Schema.optionalKey(Schema.String),
    name: Schema.optionalKey(Schema.String),
    organization_id: Schema.String,
    organization: Schema.Struct({ id: Schema.String, name: Schema.String })
  })
})
export type Account = typeof accountSchema.Type["data"]

const referralSchema = Schema.Struct({ code: Schema.String, total_referrals: Schema.Int, is_active: Schema.Boolean })
export type Referral = typeof referralSchema.Type

schema Applied { success: true }

const Plans = Schema.Struct({
  plans: Schema.Array(Schema.Struct({
    key: paidPlanKey,
    name: Schema.String,
    amountCents: cents,
    currency: Schema.Literal("usd"),
    interval: Schema.Literal("month"),
    allowance: Schema.Struct({ amountUsd: Schema.String })
  }))
})
export type PlanOffer = typeof Plans.Type["plans"][number]

schema EntitlementToken { entitlement: string }

const Models = Schema.Struct({
  object: Schema.Literal("list"),
  data: Schema.Array(Schema.Struct({ id: Schema.String, object: Schema.Literal("model"), owned_by: Schema.String }))
})
export type ModelList = typeof Models.Type
export type CloudModel = ModelList["data"][number]

schema Usage { prompt_tokens: number; completion_tokens: number; total_tokens: number }

const ToolCalls = Schema.optionalKey(Schema.Array(Schema.Unknown))

const chatChunkSchema = Schema.Struct({
  id: Schema.String,
  object: Schema.Literal("chat.completion.chunk"),
  created: Schema.Int,
  model: Schema.String,
  choices: Schema.Array(Schema.Struct({
    index: Schema.Int,
    delta: Schema.Struct({ role: Schema.optionalKey(Schema.String), content: Schema.optionalKey(optionalText), tool_calls: ToolCalls }),
    finish_reason: Schema.optionalKey(optionalText)
  })),
  usage: Schema.optionalKey(Schema.NullOr(Usage))
})
export type ChatChunk = typeof chatChunkSchema.Type

const speechConsentSchema = Schema.Struct({ consentNonce: Schema.String, expiresAt: Schema.String })
export type SpeechConsent = typeof speechConsentSchema.Type

export interface PageRequest {
  readonly limit?: number
  readonly cursor?: string
}

export interface ChatOptions extends CallOptions {
  readonly idempotencyKey?: string
}

const ipv4Loopback = /^127(?:\.\d{1,3}){3}$/
const originText = /^https?:\/\/[^\s/?#\\]+\/?$/i

function invalidRequest(problem: string): CloudError {
  return new CloudError({ failure: { tag: "CloudRefused", code: "InvalidRequest", reason: "NoReason" }, cause: problem })
}

effect function originOf(base: string): string!CloudError {
  if (!originText.test(base)) throw invalidRequest("The cloud base must be an origin")
  const url = try Effect.try({ try: () => new URL(base), catch: () => invalidRequest("The cloud base must be an origin") })
  const scheme = url.protocol === "https:" ? "Https" : url.protocol === "http:" ? "Http" : "OtherScheme"
  const loopback = url.hostname === "localhost" || url.hostname === "[::1]" || ipv4Loopback.test(url.hostname)
  if (url.href !== `${url.origin}/` || !originAccepted({ scheme, loopback, hasPath: url.pathname !== "/", hasQueryOrFragment: url.search !== "" || url.hash !== "" })) {
    throw invalidRequest("The cloud base must be an HTTPS origin or an HTTP loopback origin")
  }
  return url.origin
}

effect function destination(origin: string, route: DeviceRoute, request: CloudRequest): URL!CloudError {
  const params = request.params ?? {}
  for (const part of route.path) {
    if (part.tag !== "Param") continue
    const value = params[part.name]
    if (value === undefined || value === "" || value === "." || value === "..") throw invalidRequest("The route requires a path parameter")
  }
  const path = try Effect.try({ try: () => renderPath(route, params), catch: () => invalidRequest("A route parameter is not a valid URL segment") })
  const url = new URL(path, origin)
  const matched = lookupPath(route.method, url.pathname)
  if (url.origin !== origin || url.pathname !== path || matched.tag !== "Listed" || matched.route !== route) {
    throw invalidRequest("The requested cloud route is not listed")
  }
  url.search = new URLSearchParams(request.query).toString()
  return url
}

effect function requestHeaders(route: DeviceRoute, request: CloudRequest): Record<string, string>!CloudError {
  const headers: Record<string, string> = {}
  for (const [name, value] of Object.entries(request.headers ?? {})) {
    const normalized = name.toLowerCase()
    if (normalized === "authorization" || !admitsHeader(route, name)) throw invalidRequest("The cloud route does not admit a request header")
    headers[normalized] = value
  }
  return headers
}

effect function dispatch(origin: string, credential: CloudClientOptions["credential"], route: DeviceRoute, request: CloudRequest) {
  const selected = listedRoute(route)
  if (selected === undefined) throw invalidRequest("The requested cloud route is not listed")
  const url = try destination(origin, selected, request)
  const headers = try requestHeaders(selected, request)
  const init = HttpClientRequest.make(httpVerb(selected.method))(url, { headers })
  const outgoing = request.form !== undefined ? HttpClientRequest.bodyFormData(init, request.form)
    : request.json === undefined ? init : try Effect.mapError(
      HttpClientRequest.bodyJson(init, request.json), () => invalidRequest("The cloud request body is not JSON")
    )
  const client = try HttpClient.HttpClient
  const { bearer } = callOf(selected, credential() ?? "")
  return try Effect.mapError(
    client.execute(bearer === "" ? outgoing : HttpClientRequest.setHeader(outgoing, "authorization", `Bearer ${bearer}`)),
    (error) => networkError(error.reason._tag === "TransportError" ? error.reason.cause : error)
  )
}

function transportOf(options: CloudClientOptions): CloudTransport {
  const origin = Effect.runSync(originOf(options.baseUrl))
  const layer = Layer.mergeAll(
    FetchHttpClient.layer,
    Layer.succeed(FetchHttpClient.RequestInit, { credentials: "omit", redirect: "error" }),
    Layer.succeed(HttpClient.TracerPropagationEnabled, false)
  )
  const runtime = options.fetch === undefined ? layer : Layer.merge(layer, Layer.succeed(FetchHttpClient.Fetch, options.fetch))
  return {
    async call(route, request = {}) {
      const arrival = Effect.provide(dispatch(origin, options.credential, route, request), runtime)
      let response: HttpClientResponse.HttpClientResponse
      try {
        response = await Effect.runPromise(arrival, { signal: request.signal })
      } catch (cause) {
        request.signal?.throwIfAborted()
        throw cause instanceof CloudError ? cause : networkError(cause)
      }
      const answer = {
        status: response.status,
        headers: { get: (name: string) => response.headers[name.toLowerCase()] ?? null },
        text: () => Effect.runPromise(response.text, { signal: request.signal }),
        arrayBuffer: () => Effect.runPromise(response.arrayBuffer, { signal: request.signal }),
        stream: () => Stream.toReadableStream(response.stream)
      }
      if (answer.status < 200 || answer.status >= 300) throw await readCloudError(answer)
      return answer
    }
  }
}

function keyed(key: string): Readonly<Record<string, string>> {
  return { [idempotencyKey]: key }
}

async function chunkOf(data: Array<number>): Promise<ChatChunk> {
  let parsed: unknown
  try {
    parsed = JSON.parse(new TextDecoder().decode(Uint8Array.from(data)))
  } catch (cause) {
    throw unreadable(cause)
  }
  if (typeof parsed === "object" && parsed !== null && "error" in parsed) throw unreadable(parsed)
  const read = Schema.decodeUnknownExit(chatChunkSchema)(parsed)
  if (read._tag === "Failure") throw unreadable(read.cause)
  return read.value
}

async function* chunksOf(call: () => Promise<TransportAnswer>, signal: AbortSignal | undefined): AsyncGenerator<ChatChunk, void, undefined> {
  signal?.throwIfAborted()
  const answer = await call()
  const reader = answer.stream().getReader()
  const aborted = () => { void reader.cancel(signal?.reason).catch(() => undefined) }
  signal?.addEventListener("abort", aborted, { once: true })
  let state = segmenter()
  try {
    const contentType = answer.headers.get("content-type")
    if (contentType?.split(";", 1)[0]?.trim().toLowerCase() !== "text/event-stream") throw unreadable("expected an event stream")
    signal?.throwIfAborted()
    while (true) {
      let read: ReadableStreamReadResult<Uint8Array>
      try {
        read = await reader.read()
      } catch (cause) {
        throw networkError(cause)
      }
      signal?.throwIfAborted()
      if (read.done) throw networkError("stream ended before [DONE]")
      for (const byte of read.value) {
        const fed = pushByte(state, byte)
        state = fed.segmenter
        for (const event of fed.events) {
          if (isDone(event)) return
          yield await chunkOf(event)
        }
      }
    }
  } finally {
    signal?.removeEventListener("abort", aborted)
    await reader.cancel().catch(() => undefined)
    reader.releaseLock()
  }
}

export function createCloudClient(options: CloudClientOptions) {
  const transport = transportOf(options)
  const call = transport.call
  return {
    ...mapsCalls(transport),
    ...googleCalls(transport),
    async account(options: CallOptions = {}): Promise<Account> {
      return (await answerOf(await call(routesByName.user, { signal: options.signal }), accountSchema)).data
    },
    async revokeSelf(options: CallOptions = {}): Promise<void> {
      await call(routesByName.currentKeyRevoke, options)
    },
    async referral(options: CallOptions = {}): Promise<Referral> {
      return answerOf(await call(routesByName.referrals, { signal: options.signal }), referralSchema)
    },
    async applyReferral(code: string, options: CallOptions = {}): Promise<void> {
      await answerOf(await call(routesByName.referralApply, { json: { code }, signal: options.signal }), Applied)
    },
    async snapshot(options: CallOptions = {}): Promise<BillingSnapshot> {
      return Effect.runPromise(snapshotFromResponse(await bodyOf(await call(routesByName.billingLimits, { signal: options.signal }))))
    },
    async plans(options: CallOptions = {}): Promise<ReadonlyArray<PlanOffer>> {
      return (await answerOf(await call(routesByName.plans, { signal: options.signal }), Plans)).plans
    },
    async entitlement(options: CallOptions = {}): Promise<string> {
      return (await answerOf(await call(routesByName.entitlement, { signal: options.signal }), EntitlementToken)).entitlement
    },
    async entitlementKeys(options: CallOptions = {}): Promise<ReadonlyArray<EntitlementKey>> {
      const keys = parseEntitlementKeys(await bodyOf(await call(routesByName.entitlementKeys, { signal: options.signal })))
      if (keys === undefined) throw unreadable("entitlement keys")
      return keys
    },
    async subscriptionCommands(page: PageRequest = {}, options: CallOptions = {}): Promise<CommandsPage> {
      return Effect.runPromise(commandsFromResponse(await bodyOf(await call(routesByName.commands, { query: queryOf({ ...page }), signal: options.signal }))))
    },
    async models(options: CallOptions = {}): Promise<ModelList> {
      return answerOf(await call(routesByName.models, { signal: options.signal }), Models)
    },
    async chatCompletionStream(request: ChatRequest, options: ChatOptions = {}): Promise<AsyncGenerator<ChatChunk, void, undefined>> {
      return chunksOf(() => call(routesByName.chatCompletions, {
        json: { ...request, stream: true },
        headers: options.idempotencyKey === undefined ? undefined : keyed(options.idempotencyKey),
        signal: options.signal
      }), options.signal)
    },
    async speechConsent(options: CallOptions = {}): Promise<SpeechConsent> {
      return answerOf(await call(routesByName.speechConsent, { signal: options.signal }), speechConsentSchema)
    }
  }
}

export type CloudClient = ReturnType<typeof createCloudClient>
