// spec/cloud/client.md, "Story: Use the cloud from the device as configured"
import type { AuthClass, DeviceRoute, HttpMethod, RouteLookup, Segment } from "../../gen/cloud__client.ts"
import { admitsHeader as tableAdmitsHeader, baseHeaders, deviceRoutes, idempotencyKey, ifMatch, routeFor } from "../../gen/cloud__client.effect.vibe"

export type { AuthClass, DeviceRoute, HttpMethod, RouteLookup, Segment }
export { baseHeaders, deviceRoutes, idempotencyKey, ifMatch }

type SegmentParam<S extends string> = S extends `:${infer Name}` ? Name : never

type ParamNames<P extends string> = P extends `${infer Head}/${infer Rest}` ? SegmentParam<Head> | ParamNames<Rest> : SegmentParam<P>

export interface NamedRoute<N extends string> extends DeviceRoute {
  readonly params: ReadonlyArray<N>
}

export type ParamsOf<R> = R extends NamedRoute<infer N> ? Readonly<Record<N, string>> : never

export interface UnlistedRoute {
  readonly method: HttpMethod
  readonly pattern: string
}

function sameSegment(a: Segment, b: Segment): boolean {
  switch (a.tag) {
    case "Literal": return b.tag === "Literal" && a.text === b.text
    case "Param": return b.tag === "Param" && a.name === b.name
  }
}

const unlisted: UnlistedRoute[] = []

function sameRoute(route: DeviceRoute, method: HttpMethod, path: ReadonlyArray<Segment>): boolean {
  return route.method === method && route.path.length === path.length &&
    route.path.every((segment, index) => sameSegment(segment, path[index] as Segment))
}

function on<const P extends `/${string}`>(method: HttpMethod, pattern: P): NamedRoute<ParamNames<P>> {
  const path = pattern.split("/").slice(1).map((part): Segment =>
    part.startsWith(":") ? { tag: "Param", name: part.slice(1) } : { tag: "Literal", text: part })
  const params = path.flatMap((segment) => segment.tag === "Param" ? [segment.name as ParamNames<P>] : [])
  const listed = deviceRoutes.find((route) => sameRoute(route, method, path))
  if (listed !== undefined) return { ...listed, params }
  unlisted.push({ method, pattern })
  return { method, path, auth: "Public", headers: [], params }
}

