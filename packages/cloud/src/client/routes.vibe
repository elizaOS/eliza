export type DeviceRouteName = keyof typeof routesByName

export const unlistedRoutes: ReadonlyArray<UnlistedRoute> = unlisted

export function listedRoute(route: DeviceRoute): DeviceRoute | undefined {
  return deviceRoutes.find((listed) => sameRoute(listed, route.method, route.path))
}

export function httpVerb(method: HttpMethod): "GET" | "POST" | "PATCH" | "DELETE" {
  switch (method) {
    case "Get": return "GET"
    case "Post": return "POST"
    case "Patch": return "PATCH"
    case "Delete": return "DELETE"
  }
}

export function pathOf<R extends NamedRoute<string>>(route: R, ...[params]: R extends NamedRoute<never> ? [] : [ParamsOf<R>]): string {
  return renderPath(route, params ?? {})
}

export function renderPath(route: DeviceRoute, values: Readonly<Record<string, string>>): string {
  return route.path.map((segment) => `/${segment.tag === "Param" ? encodeURIComponent(values[segment.name] ?? "") : segment.text}`).join("")
}

export function admitsHeader(route: DeviceRoute, name: string): boolean {
  const wanted = name.toLowerCase()
  const listed = [...baseHeaders, ...route.headers].find((header) => header.toLowerCase() === wanted)
  return listed !== undefined && tableAdmitsHeader(route, listed)
}

export function lookupPath(method: HttpMethod, pathname: string): RouteLookup {
  return routeFor(method, pathname.split("/").slice(1))
}
