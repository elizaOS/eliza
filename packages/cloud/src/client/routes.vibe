// spec/cloud/client.md, "Story: Use the cloud from the device as configured"
export type HttpMethod = "Get" | "Post" | "Patch" | "Delete"

export type Segment =
  | { readonly tag: "Literal"; readonly value: string }
  | { readonly tag: "Param"; readonly value: string }

export type AuthClass = "Public" | "KeyOrSession" | "Session" | "FreshSession" | "StepUp"

export interface DeviceRoute {
  readonly method: HttpMethod
  readonly path: ReadonlyArray<Segment>
  readonly auth: AuthClass
  readonly headers: ReadonlyArray<string>
}

type SegmentParam<S extends string> = S extends `:${infer Name}` ? Name : never

type ParamNames<P extends string> = P extends `${infer Head}/${infer Rest}` ? SegmentParam<Head> | ParamNames<Rest> : SegmentParam<P>

export interface NamedRoute<N extends string> extends DeviceRoute {
  readonly params: ReadonlyArray<N>
}

export type ParamsOf<R> = R extends NamedRoute<infer N> ? Readonly<Record<N, string>> : never

export const idempotencyKey = "Idempotency-Key"
export const ifMatch = "If-Match"
export const baseHeaders: ReadonlyArray<string> = ["Authorization", "Content-Type", "X-Request-ID", "Traceparent", "Tracestate"]

function on<const P extends `/${string}`>(method: HttpMethod, pattern: P, auth: AuthClass, headers: ReadonlyArray<string> = []): NamedRoute<ParamNames<P>> {
  const path = pattern.split("/").slice(1).map((part): Segment =>
    part.startsWith(":") ? { tag: "Param", value: part.slice(1) } : { tag: "Literal", value: part })
  const params = path.flatMap((segment) => segment.tag === "Param" ? [segment.value as ParamNames<P>] : [])
  return { method, path, auth, headers, params }
}

