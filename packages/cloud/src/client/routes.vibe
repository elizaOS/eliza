export type DeviceRouteName = keyof typeof routesByName

export const deviceRoutes: ReadonlyArray<DeviceRoute> = Object.values(routesByName)

export function httpVerb(method: HttpMethod): "GET" | "POST" | "PATCH" | "DELETE" {
  switch (method) {
    case "Get": return "GET"
    case "Post": return "POST"
    case "Patch": return "PATCH"
    case "Delete": return "DELETE"
  }
}

export function pathOf<R extends NamedRoute<string>>(route: R, ...[params]: R extends NamedRoute<never> ? [] : [ParamsOf<R>]): string {
  const values: Readonly<Record<string, string>> = params ?? {}
  return route.path.map((segment) => `/${segment.tag === "Param" ? encodeURIComponent(values[segment.value] ?? "") : segment.value}`).join("")
}

export function admitsHeader(route: DeviceRoute, name: string): boolean {
  const wanted = name.toLowerCase()
  return [...baseHeaders, ...route.headers].some((header) => header.toLowerCase() === wanted)
}

function literalCount(route: DeviceRoute): number {
  return route.path.filter((segment) => segment.tag === "Literal").length
}

function routeMatches(route: DeviceRoute, method: HttpMethod, parts: ReadonlyArray<string>): boolean {
  return route.method === method && route.path.length === parts.length &&
    route.path.every((segment, index) => segment.tag === "Literal" ? segment.value === parts[index] : (parts[index] ?? "") !== "")
}

export function routeFor(method: HttpMethod, pathname: string): DeviceRoute | undefined {
  const parts = pathname.split("/").slice(1)
  return deviceRoutes.reduce<DeviceRoute | undefined>((best, route) =>
    routeMatches(route, method, parts) && (best === undefined || literalCount(route) > literalCount(best)) ? route : best, undefined)
}
