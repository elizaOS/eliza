// spec/cloud/services/google/connection.md, "Story: See my Google connection as the cloud holds it"; spec/cloud/services/google/connection.md, "Story: Disconnect it"; spec/cloud/services/google/mailRead.md, "Story: Read my mail through the grant I chose"; spec/cloud/services/google/calendar.md, "Story: Read my calendar for a window"
import { answerOf, queryOf, type CallOptions } from "./answer.vibe"
import type { CloudTransport } from "./client.vibe"
import { routesByName } from "./routes.vibe"

const googleCapabilitySchema = Schema.Literals([
  "google.basic_identity", "google.gmail.triage", "google.gmail.send", "google.gmail.manage", "google.gmail.drafts",
  "google.gmail.mailbox", "google.calendar.read", "google.calendar.write"
])

const optionalText = Schema.NullOr(Schema.String)

const googleStatusSchema = Schema.Struct({
  provider: Schema.Literal("google"),
  side: Schema.Literal("owner"),
  mode: Schema.String,
  configured: Schema.Boolean,
  connected: Schema.Boolean,
  reason: Schema.Literals(["connected", "disconnected", "config_missing", "token_missing", "needs_reauth"]),
  identity: Schema.NullOr(Schema.Struct({ email: Schema.String })),
  grantedCapabilities: Schema.Array(googleCapabilitySchema),
  grantedScopes: Schema.Array(Schema.String),
  expiresAt: optionalText,
  hasRefreshToken: Schema.Boolean,
  connectionId: optionalText,
  linkedAt: optionalText,
  lastUsedAt: optionalText
})
export type GoogleStatus = typeof googleStatusSchema.Type

const mailCardSchema = Schema.Struct({
  id: Schema.String,
  threadId: Schema.String,
  subject: Schema.String,
  from: Schema.String,
  to: Schema.Array(Schema.String),
  cc: Schema.Array(Schema.String),
  snippet: Schema.String,
  hasAttachments: Schema.optionalKey(Schema.Boolean),
  receivedAt: Schema.String,
  labels: Schema.Array(Schema.String),
  isUnread: Schema.Boolean,
  isImportant: Schema.Boolean,
  likelyReplyNeeded: Schema.Boolean,
  triageScore: Schema.Number,
  triageReason: Schema.String,
  metadata: Schema.Struct({ historyId: optionalText })
})
export type MailCard = typeof mailCardSchema.Type

const mailTriageSchema = Schema.Struct({ messages: Schema.Array(mailCardSchema), syncedAt: Schema.String, mailboxHistoryId: Schema.String })
export type MailTriage = typeof mailTriageSchema.Type

const mailSearchSchema = Schema.Struct({
  messages: Schema.Array(mailCardSchema),
  nextPageToken: optionalText,
  syncedAt: Schema.String,
  mailboxHistoryId: Schema.String,
  supportsSpamTrash: Schema.Boolean
})
export type MailSearch = typeof mailSearchSchema.Type

const mailMessageSchema = Schema.Struct({
  message: mailCardSchema,
  bodyText: Schema.String,
  bodyHtml: optionalText,
  bodyHtmlStatus: Schema.Literals(["available", "none", "too_large"]),
  attachments: Schema.Array(Schema.Struct({
    partId: Schema.String, name: Schema.String, mimeType: Schema.String, size: Schema.Number, supported: Schema.Boolean
  })),
  authenticationResults: Schema.optionalKey(optionalText)
})
export type MailMessage = typeof mailMessageSchema.Type

const mailKindSchema = Schema.Literals([
  "send", "draft-create", "draft-replace", "draft-delete", "archive", "unarchive", "trash", "untrash", "mark-read", "mark-unread", "star", "unstar"
])

// spec/cloud/services/google/mailRead.md, "Capabilities offer exactly the reads and changes the grant allows, and each change comes with the read its review needs"
const mailCapabilitiesSchema = Schema.Struct({
  version: Schema.Literal(1),
  from: Schema.String,
  reads: Schema.optionalKey(Schema.Array(Schema.Literals(["triage", "search", "read", "thread", "attachment", "drafts", "draft", "capabilities"]))),
  kinds: Schema.Array(mailKindSchema),
  attachmentPolicy: Schema.Struct({ mimeTypes: Schema.Array(Schema.String), maxBytes: Schema.Number }),
  providerExactlyOnce: Schema.optionalKey(Schema.Literal(false))
})
export type MailCapabilities = typeof mailCapabilitiesSchema.Type

const calendarRowSchema = Schema.Struct({
  calendarId: Schema.String,
  accountId: Schema.String,
  accountEmail: Schema.String,
  label: Schema.String,
  accessRole: Schema.String,
  read: Schema.Boolean,
  write: Schema.Boolean,
  recurrenceLines: Schema.optionalKey(Schema.Literal(true)),
  privateCreate: Schema.optionalKey(Schema.Literal(true))
})
export type CalendarRow = typeof calendarRowSchema.Type

const calendarEventSchema = Schema.Struct({
  externalId: Schema.String,
  calendarId: Schema.String,
  title: Schema.String,
  description: Schema.String,
  location: Schema.String,
  status: Schema.String,
  startAt: Schema.String,
  endAt: Schema.String,
  isAllDay: Schema.Boolean,
  timezone: optionalText,
  htmlLink: optionalText,
  conferenceLink: optionalText,
  etag: optionalText,
  seriesId: optionalText,
  recurrence: Schema.optionalKey(Schema.Array(Schema.String)),
  organizer: Schema.NullOr(Schema.Struct({ email: optionalText, displayName: optionalText, self: Schema.Boolean })),
  attendees: Schema.Array(Schema.Struct({
    email: optionalText, displayName: optionalText, responseStatus: optionalText,
    self: Schema.Boolean, organizer: Schema.Boolean, optional: Schema.Boolean
  })),
  metadata: Schema.Struct({ iCalUID: optionalText, createdAt: optionalText, updatedAt: optionalText,
    originalStartTime: Schema.optionalKey(Schema.String) })
})
export type CalendarEvent = typeof calendarEventSchema.Type

const calendarFeedSchema = Schema.Struct({ calendarId: Schema.String, events: Schema.Array(calendarEventSchema), syncedAt: Schema.String })
export type CalendarFeed = typeof calendarFeedSchema.Type

const EventAnswer = Schema.Struct({ event: calendarEventSchema })

type GrantChoice = { readonly grantId?: string }
type CalendarTarget = GrantChoice & { readonly calendarId?: string }

export function googleCalls(transport: CloudTransport) {
  return {
    async googleStatus(choice: GrantChoice = {}, options: CallOptions = {}): Promise<GoogleStatus> {
      return answerOf(await transport.call(routesByName.googleStatus, { query: queryOf({ grantId: choice.grantId }), signal: options.signal }), googleStatusSchema)
    },
    async googleDisconnect(choice: GrantChoice = {}, options: CallOptions = {}): Promise<void> {
      await transport.call(routesByName.googleDisconnect, { json: choice, signal: options.signal })
    },
    async gmailTriage(request: GrantChoice & { readonly maxResults?: number } = {}, options: CallOptions = {}): Promise<MailTriage> {
      return answerOf(await transport.call(routesByName.gmailTriage, { query: queryOf(request), signal: options.signal }), mailTriageSchema)
    },
    async gmailSearch(request: GrantChoice & { readonly query: string; readonly maxResults?: number; readonly pageToken?: string }, options: CallOptions = {}): Promise<MailSearch> {
      return answerOf(await transport.call(routesByName.gmailSearch, { query: queryOf(request), signal: options.signal }), mailSearchSchema)
    },
    async gmailRead(request: GrantChoice & { readonly messageId: string }, options: CallOptions = {}): Promise<MailMessage> {
      return answerOf(await transport.call(routesByName.gmailRead, { query: queryOf(request), signal: options.signal }), mailMessageSchema)
    },
    async gmailCapabilities(choice: GrantChoice = {}, options: CallOptions = {}): Promise<MailCapabilities> {
      return answerOf(await transport.call(routesByName.inboxCapabilities, { query: queryOf({ grantId: choice.grantId }), signal: options.signal }), mailCapabilitiesSchema)
    },
    async calendarCalendars(choice: GrantChoice = {}, options: CallOptions = {}): Promise<ReadonlyArray<CalendarRow>> {
      return answerOf(await transport.call(routesByName.calendars, { query: queryOf({ grantId: choice.grantId }), signal: options.signal }), Schema.Array(calendarRowSchema))
    },
    async calendarFeed(request: CalendarTarget & { readonly timeMin: string; readonly timeMax: string; readonly timeZone?: string }, options: CallOptions = {}): Promise<CalendarFeed> {
      return answerOf(await transport.call(routesByName.calendarFeed, { query: queryOf(request), signal: options.signal }), calendarFeedSchema)
    },
    async calendarEvent(request: CalendarTarget & { readonly eventId: string }, options: CallOptions = {}): Promise<CalendarEvent> {
      const { eventId, ...target } = request
      return (await answerOf(await transport.call(routesByName.calendarEvent, { params: { eventId }, query: queryOf(target), signal: options.signal }), EventAnswer)).event
    }
  }
}

export type GoogleCalls = ReturnType<typeof googleCalls>
