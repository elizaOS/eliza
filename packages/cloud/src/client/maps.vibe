// spec/cloud/services/maps.md, "Story: Answer a maps request once and pay for it once"; spec/cloud/client.md, "Story: Use the cloud from the device as configured"
import type { RefusalCode } from "../../gen/cloud__shared__types.ts"
import {
  MapsCapabilities, MapsPlaceResponse, MapsPlacesResponse, MapsRoutesResponse, MapsViewportResponse,
  type PlaceDetailsRequest, type PlacesSearchRequest, type RoutesRequest, type TileAddress, type ViewportRequest
} from "../services/maps.schema.ts"
import { answerOf, bytesOf, type CallOptions } from "./answer.vibe"
import type { CloudTransport } from "./client.vibe"
import type { CloudError } from "./errors.vibe"
import { idempotencyKey, routesByName, type DeviceRoute } from "./routes.vibe"

module browser {
  /** @throws {never} */
  export function freshRequestId(): string {
    return globalThis.crypto.randomUUID()
  }
}
import { freshRequestId } from browser


export type MapsRefusal = "NoRoute" | "UnsupportedMode" | "UnsupportedRegion" | "ProviderInvalidResponse"

interface MapsTile {
  readonly contentType: string
  readonly bytes: Uint8Array
}

function isMapsRefusal(code: RefusalCode): code is Exclude<MapsRefusal, "ProviderInvalidResponse"> {
  return code === "NoRoute" || code === "UnsupportedMode" || code === "UnsupportedRegion"
}

export function mapsRefusalOf(error: CloudError): MapsRefusal | undefined {
  const failure = error.failure
  switch (failure.tag) {
    case "CloudProviderIssue": return "ProviderInvalidResponse"
    case "CloudRefused": return isMapsRefusal(failure.code) ? failure.code : undefined
    default: return undefined
  }
}

function freshKey(route: DeviceRoute): Readonly<Record<string, string>> {
  return route.headers.includes(idempotencyKey) ? { [idempotencyKey]: freshRequestId() } : {}
}

export function mapsCalls(transport: CloudTransport) {
  async function post<A>(route: DeviceRoute, schema: Schema.Codec<A>, json: unknown, options: CallOptions): Promise<A> {
    return answerOf(await transport.call(route, { json, headers: freshKey(route), signal: options.signal }), schema)
  }
  return {
    async mapsCapabilities(options: CallOptions = {}): Promise<MapsCapabilities> {
      return answerOf(await transport.call(routesByName.mapsCapabilities, { signal: options.signal }), MapsCapabilities)
    },
    mapsPlacesSearch: (request: PlacesSearchRequest, options: CallOptions = {}): Promise<MapsPlacesResponse> =>
      post(routesByName.mapsPlacesSearch, MapsPlacesResponse, request, options),
    mapsPlaceDetails: (request: PlaceDetailsRequest, options: CallOptions = {}): Promise<MapsPlaceResponse> =>
      post(routesByName.mapsPlaceDetails, MapsPlaceResponse, request, options),
    mapsRoutes: (request: RoutesRequest, options: CallOptions = {}): Promise<MapsRoutesResponse> =>
      post(routesByName.mapsRoutes, MapsRoutesResponse, request, options),
    mapsViewport: (request: ViewportRequest, options: CallOptions = {}): Promise<MapsViewportResponse> =>
      post(routesByName.mapsViewport, MapsViewportResponse, request, options),
    async mapsTile(tile: TileAddress, options: CallOptions = {}): Promise<MapsTile> {
      const route = routesByName.mapsTile
      const answer = await transport.call(route, {
        params: { z: String(tile.z), x: String(tile.x), y: String(tile.y) }, headers: freshKey(route), signal: options.signal
      })
      return { contentType: answer.headers.get("content-type") ?? "application/octet-stream", bytes: await bytesOf(answer) }
    }
  }
}

export type MapsCalls = ReturnType<typeof mapsCalls>
