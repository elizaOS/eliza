// spec/cloud/services/maps.md, "Story: Answer a maps request once and pay for it once"; spec/cloud/client.md, "Story: Use the cloud from the device as configured"
import { SecureRandom } from "effect/crypto"
import type { RefusalCode } from "../../gen/cloud__shared__types.ts"
import {
  type IdempotencyKey, MapsCapabilities, MapsPlaceResponse, MapsPlacesResponse, MapsRoutesResponse, MapsViewportResponse,
  type PlaceDetailsRequest, type ReverseRequest, type RoutesRequest, type TextSearchRequest, type TileAddress, type ViewportRequest
} from "../services/maps.schema.ts"
import { answerOf, bytesOf, type CallOptions } from "./answer.vibe"
import type { CloudTransport } from "./client.vibe"
import type { CloudError } from "./errors.vibe"
import { idempotencyKey, routesByName, type DeviceRoute } from "./routes.vibe"

export type {
  IdempotencyKey, MapsCapabilities, MapsPlaceResponse, MapsPlacesResponse, MapsRoutesResponse, MapsViewportResponse,
  PlaceDetailsRequest, ReverseRequest, RoutesRequest, TextSearchRequest, TileAddress, ViewportRequest
}

export type MapsRefusal = "NoRoute" | "UnsupportedMode" | "UnsupportedRegion" | "ProviderInvalidResponse"

export interface MapsTile {
  readonly contentType: string
  readonly bytes: Uint8Array
}

function isMapsRefusal(code: RefusalCode): code is Exclude<MapsRefusal, "ProviderInvalidResponse"> {
  return code === "NoRoute" || code === "UnsupportedMode" || code === "UnsupportedRegion"
}

export function mapsRefusalOf(error: CloudError): MapsRefusal | undefined {
  const failure = error.failure
  switch (failure.tag) {
    case "CloudProviderIssue": return "ProviderInvalidResponse"
    case "CloudRefused": return isMapsRefusal(failure.code) ? failure.code : undefined
    default: return undefined
  }
}

export interface MapsCallOptions extends CallOptions {
  readonly idempotencyKey?: IdempotencyKey
}

function keyOf(route: DeviceRoute, options: MapsCallOptions): Readonly<Record<string, string>> {
  return route.headers.includes(idempotencyKey) ? { [idempotencyKey]: options.idempotencyKey ?? SecureRandom.uuidV4Unsafe() } : {}
}

export function mapsCalls(transport: CloudTransport) {
  async function post<A>(route: DeviceRoute, schema: Schema.Codec<A>, json: unknown, options: MapsCallOptions): Promise<A> {
    return answerOf(await transport.call(route, { json, headers: keyOf(route, options), signal: options.signal }), schema)
  }
  return {
    async mapsCapabilities(options: CallOptions = {}): Promise<MapsCapabilities> {
      return answerOf(await transport.call(routesByName.mapsCapabilities, { signal: options.signal }), MapsCapabilities)
    },
    mapsGeocode: (request: TextSearchRequest, options: MapsCallOptions = {}): Promise<MapsPlacesResponse> =>
      post(routesByName.mapsGeocode, MapsPlacesResponse, request, options),
    mapsReverse: (request: ReverseRequest, options: MapsCallOptions = {}): Promise<MapsPlaceResponse> =>
      post(routesByName.mapsReverse, MapsPlaceResponse, request, options),
    mapsPlacesSearch: (request: TextSearchRequest, options: MapsCallOptions = {}): Promise<MapsPlacesResponse> =>
      post(routesByName.mapsPlacesSearch, MapsPlacesResponse, request, options),
    mapsPlaceDetails: (request: PlaceDetailsRequest, options: MapsCallOptions = {}): Promise<MapsPlaceResponse> =>
      post(routesByName.mapsPlaceDetails, MapsPlaceResponse, request, options),
    mapsRoutes: (request: RoutesRequest, options: MapsCallOptions = {}): Promise<MapsRoutesResponse> =>
      post(routesByName.mapsRoutes, MapsRoutesResponse, request, options),
    mapsViewport: (request: ViewportRequest, options: MapsCallOptions = {}): Promise<MapsViewportResponse> =>
      post(routesByName.mapsViewport, MapsViewportResponse, request, options),
    async mapsTile(tile: TileAddress, options: MapsCallOptions = {}): Promise<MapsTile> {
      const route = routesByName.mapsTile
      const answer = await transport.call(route, {
        params: { z: String(tile.z), x: String(tile.x), y: String(tile.y) }, headers: keyOf(route, options), signal: options.signal
      })
      return { contentType: answer.headers.get("content-type") ?? "application/octet-stream", bytes: await bytesOf(answer) }
    }
  }
}

export type MapsCalls = ReturnType<typeof mapsCalls>
