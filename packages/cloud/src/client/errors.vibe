// spec/cloud/client.md, "Story: Tell an account that needs attention from a failing service"; spec/cloud/shared/types.md, "Story: Speak one refusal language"
import { isCredentialReason, millisPerSecond, type Millis, type RefusalCode, type RefusalReason } from "../../gen/cloud__shared__types.effect.vibe"

export type CloudFailure =
  | { readonly tag: "CloudCredentialInvalid"; readonly reason: RefusalReason }
  | { readonly tag: "CloudInsufficientCredits" }
  | { readonly tag: "CloudAllowanceExhausted"; readonly resetsAt: Millis }
  | { readonly tag: "CloudRateLimited"; readonly retryAt: Millis }
  | { readonly tag: "CloudConsentRequired" }
  | { readonly tag: "CloudUnavailable"; readonly retryAfter: Millis }
  | { readonly tag: "CloudProviderIssue" }
  | { readonly tag: "CloudNetwork" }
  | { readonly tag: "CloudRefused"; readonly code: RefusalCode; readonly reason: RefusalReason }

export error CloudError { failure: CloudFailure; cause: unknown }

const codeTable = {
  InvalidRequest: 0, ModelUnavailable: 0, InvalidClient: 0, RedirectMismatch: 0, GrantCodeInvalid: 0,
  AuthenticationRequired: 0, CredentialProofInvalid: 0, InsufficientCredits: 0, AllowanceExhausted: 0,
  AccessDenied: 0, ClientDisabled: 0, SpeechConsentRequired: 0, NotFound: 0, CapabilityUnavailable: 0,
  IdempotencyConflict: 0, StaleRevision: 0, BillingStateConflict: 0, IdentityInUse: 0, LastMethod: 0,
  GoogleReauthRequired: 0, SubscriptionGrantAlreadyRedeemed: 0, SubscriptionGrantPaidPlanActive: 0,
  ReferralAlreadyApplied: 0, SessionClosed: 0, PreconditionFailed: 0, ContentTooLarge: 0, NoRoute: 0,
  UnsupportedMode: 0, UnsupportedRegion: 0, FreshSessionRequired: 0, RateLimited: 0, ProviderInvalidResponse: 0,
  ServiceUnavailable: 0, ProviderUnavailable: 0, RateLimitUnavailable: 0
} satisfies Record<RefusalCode, 0>

const reasonTable = {
  GrantRequired: 0, UnsupportedField: 0, CredentialExpired: 0, CredentialRevoked: 0, CredentialUnknown: 0,
  ChallengeLocked: 0, GoogleAccountChanged: 0, AccountInactive: 0, CapabilityMissing: 0, GoogleNotConfigured: 0
} satisfies Record<Exclude<RefusalReason, "NoReason">, 0>

function wireName(name: string): string {
  return name.replace(/(?<=[a-z0-9])(?=[A-Z])/g, "_").toLowerCase()
}

const codeOfWire: ReadonlyMap<string, RefusalCode> = new Map(
  (Object.keys(codeTable) as RefusalCode[]).map((code) => [wireName(code), code]))

const reasonOfWire: ReadonlyMap<string, RefusalReason> = new Map(
  (Object.keys(reasonTable) as RefusalReason[]).map((reason) => [wireName(reason), reason]))

export function credentialReasonOf(reason: RefusalReason): RefusalReason {
  return isCredentialReason(reason) ? reason : "CredentialUnknown"
}

export function defaultCodeOf(status: number): RefusalCode {
  if (status === 401) return "AuthenticationRequired"
  if (status === 402) return "InsufficientCredits"
  if (status === 403) return "AccessDenied"
  if (status === 404) return "NotFound"
  if (status === 429) return "RateLimited"
  if (status === 502) return "ProviderInvalidResponse"
  if (status >= 500) return "ServiceUnavailable"
  return "InvalidRequest"
}

export function cloudErrorOf(status: number, code: RefusalCode, reason: RefusalReason, retryAt: Millis, resetsAt: Millis): CloudFailure {
  if (status === 401) return { tag: "CloudCredentialInvalid", reason: credentialReasonOf(reason) }
  if (status === 402) return code === "AllowanceExhausted" ? { tag: "CloudAllowanceExhausted", resetsAt } : { tag: "CloudInsufficientCredits" }
  if (status === 429) return { tag: "CloudRateLimited", retryAt }
  if (code === "SpeechConsentRequired") return { tag: "CloudConsentRequired" }
  if (status === 502) return { tag: "CloudProviderIssue" }
  if (status === 503 && reason === "GoogleNotConfigured") return { tag: "CloudRefused", code, reason }
  if (status >= 500) return { tag: "CloudUnavailable", retryAfter: retryAt }
  return { tag: "CloudRefused", code, reason }
}

interface RefusalRead {
  readonly code: RefusalCode
  readonly reason: RefusalReason
  readonly retryAt: Millis
  readonly resetsAt: Millis
}

function timeOf(value: unknown): Millis {
  return typeof value === "number" && Number.isSafeInteger(value) && value > 0 ? value : 0
}

function refusalOf(text: string): RefusalRead | undefined {
  let body: unknown
  try {
    body = JSON.parse(text)
  } catch {
    return undefined
  }
  if (typeof body !== "object" || body === null || !("error" in body) || typeof body.error !== "string") return undefined
  const code = codeOfWire.get(body.error)
  if (code === undefined) return undefined
  const reason = "reason" in body && typeof body.reason === "string" ? reasonOfWire.get(body.reason) ?? "NoReason" : "NoReason"
  return {
    code,
    reason,
    retryAt: "retryAt" in body ? timeOf(body.retryAt) : 0,
    resetsAt: "resetsAt" in body ? timeOf(body.resetsAt) : 0
  }
}

function retryAfterOf(header: string | null, now: Millis): Millis {
  if (header === null) return 0
  const value = header.trim()
  if (/^\d+$/.test(value)) return now + Number(value) * millisPerSecond
  const at = Date.parse(value)
  return Number.isFinite(at) && at > 0 ? at : 0
}

export function networkError(cause: unknown): CloudError {
  return new CloudError({ failure: { tag: "CloudNetwork" }, cause })
}

export async function readCloudError(response: Response, now: Millis = Date.now()): Promise<CloudError> {
  let text: string
  try {
    text = await response.text()
  } catch (cause) {
    return networkError(cause)
  }
  const read: RefusalRead = refusalOf(text) ?? { code: defaultCodeOf(response.status), reason: "NoReason", retryAt: 0, resetsAt: 0 }
  const retryAt = read.retryAt > 0 ? read.retryAt : retryAfterOf(response.headers.get("retry-after"), now)
  return new CloudError({ failure: cloudErrorOf(response.status, read.code, read.reason, retryAt, read.resetsAt), cause: undefined })
}
