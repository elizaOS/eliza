// spec/cloud/client.md, "Story: Tell an account that needs attention from a failing service"; spec/cloud/client.md, "A balance shows only from a snapshot under five minutes old, and a grant has ended once revoked or past its end"; spec/cloud/billing/grantCodes.md, "Story: Redeem a membership code once"
import type { AccountStatus } from "../../gen/cloud__identity__accounts.ts"
import type { PlanKey } from "../../gen/cloud__billing__plans.ts"
import type { SubscriptionStatus } from "../../gen/cloud__billing__subscriptions.ts"
import type { FundingLane } from "../../gen/cloud__shared__metering.ts"
import type { GrantTerm, PlanAdmission, PlanSource, PlanView, SnapshotView } from "../../gen/cloud__client.ts"
import {
  accountUsable as usableView, creditOf, grantEndedAt, grantEndedInSnapshot, planAdmission, planFromSnapshot as planOfView
} from "../../gen/cloud__client.effect.vibe"
import type { Micros, Millis } from "../../gen/cloud__shared__types.effect.vibe"
import { CloudError, type CloudFailure } from "./errors.vibe"

export type { PlanAdmission, PlanView }
export { planAdmission }

const millis = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const micros = Schema.Int
const revision = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const id = Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128))

const wirePlanKeySchema = Schema.Literals(["free", "plus_monthly", "pro_monthly"])
const paidWirePlanKeySchema = Schema.Literals(["plus_monthly", "pro_monthly"])
const wirePlanSourceSchema = Schema.Literals(["subscription", "grant", "free"])
const wireAccountStatusSchema = Schema.Literals(["active", "deleting", "erased"])
const wireSubscriptionStatusSchema = Schema.Literals(["pending", "incomplete", "active", "dunning", "past_due", "unpaid", "canceled", "incomplete_expired"])
const wireControlActionSchema = Schema.Literals(["cancel", "undo", "none"])
const wireAllowanceStateSchema = Schema.Literals(["open", "expired", "closed", "clawed_back"])
const wireFundingLaneSchema = Schema.Literals(["allowanceThenCredits", "creditsOnly", "refused"])

export type WirePlanKey = typeof wirePlanKeySchema.Type
export type PaidWirePlanKey = typeof paidWirePlanKeySchema.Type
export type WirePlanSource = typeof wirePlanSourceSchema.Type
type WireAccountStatus = typeof wireAccountStatusSchema.Type
type WireSubscriptionStatus = typeof wireSubscriptionStatusSchema.Type
export type WireAllowanceState = typeof wireAllowanceStateSchema.Type
type WireFundingLane = typeof wireFundingLaneSchema.Type

const snapshotPlanSchema = Schema.Struct({ key: wirePlanKeySchema, source: wirePlanSourceSchema, effectiveUntil: Schema.NullOr(millis) })

const snapshotSubscriptionSchema = Schema.Struct({
  id,
  planKey: wirePlanKeySchema,
  status: wireSubscriptionStatusSchema,
  periodStart: millis,
  periodEnd: millis,
  cancelAtPeriodEnd: Schema.Boolean,
  pendingPlanKey: Schema.NullOr(wirePlanKeySchema),
  dunningEndsAt: Schema.NullOr(millis),
  revision,
  control: Schema.Struct({ action: wireControlActionSchema, eligible: Schema.Boolean, expectedSubscriptionRevision: revision })
})

const snapshotGrantSchema = Schema.Struct({
  id,
  planKey: paidWirePlanKeySchema,
  family: id,
  effectiveFrom: millis,
  effectiveUntil: Schema.NullOr(millis),
  revoked: Schema.Boolean
})

const snapshotAllowanceSchema = Schema.Struct({
  state: wireAllowanceStateSchema,
  granted: micros,
  adjustment: micros,
  available: micros,
  reserved: micros,
  settled: micros,
  expired: micros,
  clawedBack: micros,
  periodStart: millis,
  resetsAt: millis
})

const billingSnapshotSchema = Schema.Struct({
  schemaVersion: Schema.Literal(3),
  observedAt: millis,
  account: Schema.Struct({ status: wireAccountStatusSchema }),
  balance: Schema.Struct({ usdMicros: micros, revision }),
  plan: snapshotPlanSchema,
  subscription: Schema.NullOr(snapshotSubscriptionSchema),
  grant: Schema.NullOr(snapshotGrantSchema),
  allowance: Schema.NullOr(snapshotAllowanceSchema),
  funding: Schema.Struct({ inference: wireFundingLaneSchema, speech: wireFundingLaneSchema, maps: wireFundingLaneSchema })
})

export type SnapshotPlan = typeof snapshotPlanSchema.Type
export type SnapshotSubscription = typeof snapshotSubscriptionSchema.Type
export type SnapshotGrant = typeof snapshotGrantSchema.Type
export type SnapshotAllowance = typeof snapshotAllowanceSchema.Type
export type BillingSnapshot = typeof billingSnapshotSchema.Type

const subscriptionCommandSchema = Schema.Struct({
  commandId: id,
  kind: Schema.Literals(["cancel", "undo", "upgrade", "downgrade"]),
  subscriptionId: id,
  status: Schema.Literals(["dispatched", "unknown", "awaiting_payment", "succeeded", "rejected"]),
  expectedRevision: revision,
  resultRevision: Schema.NullOr(revision),
  createdAt: millis
})

const commandsPageSchema = Schema.Struct({ observedAt: millis, items: Schema.Array(subscriptionCommandSchema), nextCursor: Schema.NullOr(Schema.String) })

const cents = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))

const planChangeReviewSchema = Schema.Struct({
  quoteId: id,
  review: Schema.Struct({
    kind: Schema.Literals(["upgrade_estimate", "downgrade_estimate"]),
    targetPlanKey: paidWirePlanKeySchema,
    dueNow: Schema.Struct({ amountDueCents: cents }),
    recurringEstimate: Schema.Struct({ amountDueCents: cents }),
    effectiveAt: millis,
    expiresAt: millis
  })
})

const paymentContinuationSchema = Schema.Struct({ url: Schema.String })

const checkoutStartSchema = Schema.Union([
  Schema.Struct({ status: Schema.Literal("open"), commandId: id, checkoutUrl: Schema.String, sessionId: id, expiresAt: millis }),
  Schema.Struct({
    status: Schema.Literal("open"),
    commandId: id,
    uiMode: Schema.Literal("embedded"),
    sessionId: id,
    clientSecret: Schema.String,
    publishableKey: Schema.String,
    amountDueCents: cents,
    currency: Schema.Literal("usd"),
    interval: Schema.Literal("month"),
    expiresAt: millis
  }),
  Schema.Struct({ status: Schema.Literals(["completed", "expired", "stale_intent"]), commandId: id })
])

export type SubscriptionCommand = typeof subscriptionCommandSchema.Type
export type CommandStatus = SubscriptionCommand["status"]
export type CommandsPage = typeof commandsPageSchema.Type
export type PlanChangeReview = typeof planChangeReviewSchema.Type
export type PaymentContinuation = typeof paymentContinuationSchema.Type
export type CheckoutStart = typeof checkoutStartSchema.Type

type Answer = "snapshot" | "redeem" | "command" | "commands" | "review" | "payment" | "checkout"

function unreadable(answer: Answer, issue: unknown): CloudError {
  return new CloudError({ failure: { tag: "CloudProviderIssue" }, cause: { answer, issue } })
}

effect function decode<T>(schema: Schema.ConstraintDecoder<T>, answer: Answer, body: unknown): T!CloudError {
  const read = Schema.decodeUnknownExit(schema)(body)
  if (read._tag === "Failure") throw unreadable(answer, read.cause)
  return read.value
}

export effect function snapshotFromResponse(body: unknown): BillingSnapshot!CloudError {
  return (try decode(Schema.Struct({ data: billingSnapshotSchema }), "snapshot", body)).data
}

export effect function commandFromResponse(body: unknown): SubscriptionCommand!CloudError {
  return try decode(subscriptionCommandSchema, "command", body)
}

export effect function commandsFromResponse(body: unknown): CommandsPage!CloudError {
  return try decode(commandsPageSchema, "commands", body)
}

export effect function reviewFromResponse(body: unknown): PlanChangeReview!CloudError {
  return try decode(planChangeReviewSchema, "review", body)
}

export effect function paymentFromResponse(body: unknown): PaymentContinuation!CloudError {
  return try decode(paymentContinuationSchema, "payment", body)
}

export effect function checkoutFromResponse(body: unknown): CheckoutStart!CloudError {
  return try decode(checkoutStartSchema, "checkout", body)
}

const planKeys = { free: "Free", plus_monthly: "PlusMonthly", pro_monthly: "ProMonthly" } as const satisfies Record<WirePlanKey, PlanKey>

const planSources = { subscription: "FromSubscription", grant: "FromGrant", free: "FromFree" } as const satisfies Record<WirePlanSource, PlanSource>

const accountStatuses = { active: "Active", deleting: "Deleting", erased: "Erased" } as const satisfies Record<WireAccountStatus, AccountStatus>

const subscriptionStatuses = {
  pending: "Pending",
  incomplete: "Incomplete",
  active: "Active",
  dunning: "Dunning",
  past_due: "PastDue",
  unpaid: "Unpaid",
  canceled: "Canceled",
  incomplete_expired: "IncompleteExpired"
} as const satisfies Record<WireSubscriptionStatus, SubscriptionStatus>

const fundingLanes = { allowanceThenCredits: "AllowanceThenCredits", creditsOnly: "CreditsOnly", refused: "Refused" } as const satisfies Record<WireFundingLane, FundingLane>

export function planKeyOf(key: WirePlanKey): PlanKey {
  return planKeys[key]
}

export function snapshotView(snapshot: BillingSnapshot): SnapshotView {
  const allowance = snapshot.allowance
  return {
    accountStatus: accountStatuses[snapshot.account.status],
    balance: snapshot.balance.usdMicros,
    planKey: planKeys[snapshot.plan.key],
    source: planSources[snapshot.plan.source],
    subscription: snapshot.subscription === null ? "NoSubscription" : subscriptionStatuses[snapshot.subscription.status],
    allowanceAvailable: allowance !== null && allowance.state === "open" ? allowance.available : 0,
    inference: fundingLanes[snapshot.funding.inference],
    observedAt: snapshot.observedAt
  }
}

export function accountUsable(snapshot: BillingSnapshot): boolean {
  return usableView(snapshotView(snapshot))
}

export function planFromSnapshot(snapshot: BillingSnapshot): PlanView {
  return planOfView(snapshotView(snapshot))
}

export const planChecking: PlanView = { tag: "PlanChecking" }
export const planUnavailable: PlanView = { tag: "PlanUnavailable" }

export type CreditView =
  | { readonly kind: "funded"; readonly usdMicros: Micros; readonly observedAt: Millis }
  | { readonly kind: "zero"; readonly observedAt: Millis }
  | { readonly kind: "unavailable"; readonly observedAt: Millis }

export function creditFromSnapshot(snapshot: BillingSnapshot, now: Millis): CreditView {
  const observedAt = snapshot.observedAt
  const credit = creditOf(snapshot.balance.usdMicros, observedAt, now)
  switch (credit.tag) {
    case "CreditFunded": return { kind: "funded", usdMicros: credit.usdMicros, observedAt }
    case "CreditZero": return { kind: "zero", observedAt }
    case "CreditUnavailable": return { kind: "unavailable", observedAt }
  }
}

export interface ActiveGrant {
  readonly id: string
  readonly planKey: PaidWirePlanKey
  readonly family: string
  readonly effectiveFrom: Millis
  readonly effectiveUntil: Millis | null
}

export type GrantView =
  | { readonly kind: "none" }
  | { readonly kind: "ended"; readonly id: string; readonly planKey: PaidWirePlanKey }
  | { readonly kind: "active"; readonly grant: ActiveGrant; readonly paidPlanTakesPrecedence: boolean }

function activeGrant(grant: SnapshotGrant): ActiveGrant {
  return { id: grant.id, planKey: grant.planKey, family: grant.family, effectiveFrom: grant.effectiveFrom, effectiveUntil: grant.effectiveUntil }
}

function termOf(grant: SnapshotGrant): GrantTerm {
  return { revoked: grant.revoked, bounded: grant.effectiveUntil !== null, until: grant.effectiveUntil ?? 0 }
}

export function grantFromSnapshot(snapshot: BillingSnapshot, now: Millis): GrantView {
  const grant = snapshot.grant
  if (grant === null) return { kind: "none" }
  if (grantEndedInSnapshot(termOf(grant), snapshot.observedAt, now)) return { kind: "ended", id: grant.id, planKey: grant.planKey }
  return { kind: "active", grant: activeGrant(grant), paidPlanTakesPrecedence: snapshot.plan.source === "subscription" }
}

export interface SubscriptionView {
  readonly observedAt: Millis
  readonly plan: PlanView
  readonly admission: PlanAdmission
  readonly usable: boolean
  readonly planKey: WirePlanKey
  readonly planSource: WirePlanSource
  readonly planEffectiveUntil: Millis | null
  readonly subscription: SnapshotSubscription | null
  readonly grant: GrantView
  readonly allowance: SnapshotAllowance | null
  readonly credit: CreditView
}

export function subscriptionView(snapshot: BillingSnapshot, now: Millis): SubscriptionView {
  const view = snapshotView(snapshot)
  const plan = planOfView(view)
  return {
    observedAt: snapshot.observedAt,
    plan,
    admission: planAdmission(plan),
    usable: usableView(view),
    planKey: snapshot.plan.key,
    planSource: snapshot.plan.source,
    planEffectiveUntil: snapshot.plan.effectiveUntil,
    subscription: snapshot.subscription,
    grant: grantFromSnapshot(snapshot, now),
    allowance: snapshot.allowance,
    credit: creditFromSnapshot(snapshot, now)
  }
}

const redeemAnswerSchema = Schema.Struct({
  replayed: Schema.Boolean,
  grant: snapshotGrantSchema,
  entitlement: Schema.Struct({ plan: snapshotPlanSchema })
})

export type RedeemAnswer = typeof redeemAnswerSchema.Type

export type RedeemResult =
  | { readonly kind: "redeemed"; readonly replayed: boolean; readonly grant: ActiveGrant; readonly plan: SnapshotPlan; readonly paidPlanTakesPrecedence: boolean }
  | { readonly kind: "ended"; readonly id: string; readonly planKey: PaidWirePlanKey }

export effect function redeemResultFromResponse(body: unknown, now: Millis): RedeemResult!CloudError {
  const answer = try decode(redeemAnswerSchema, "redeem", body)
  const grant = answer.grant
  if (grantEndedAt(termOf(grant), now)) return { kind: "ended", id: grant.id, planKey: grant.planKey }
  const plan = answer.entitlement.plan
  return { kind: "redeemed", replayed: answer.replayed, grant: activeGrant(grant), plan, paidPlanTakesPrecedence: plan.source === "subscription" }
}

export type RedeemFailure =
  | { readonly kind: "CodeInvalid" }
  | { readonly kind: "AlreadyRedeemed" }
  | { readonly kind: "PaidPlanActive" }
  | { readonly kind: "AccountRefused" }
  | { readonly kind: "RateLimited"; readonly retryAt: Millis }
  | { readonly kind: "Unavailable" }

function refusedRedeem(code: Extract<CloudFailure, { tag: "CloudRefused" }>["code"]): RedeemFailure {
  switch (code) {
    case "SubscriptionGrantAlreadyRedeemed": return { kind: "AlreadyRedeemed" }
    case "SubscriptionGrantPaidPlanActive": return { kind: "PaidPlanActive" }
    case "AccessDenied":
    case "ClientDisabled": return { kind: "AccountRefused" }
    case "GrantCodeInvalid":
    case "InvalidRequest":
    case "IdempotencyConflict": return { kind: "CodeInvalid" }
    default: return { kind: "Unavailable" }
  }
}

export function redeemFailureForStatus(error: CloudError): RedeemFailure | undefined {
  const failure = error.failure
  switch (failure.tag) {
    case "CloudCredentialInvalid": return undefined
    case "CloudRefused": return refusedRedeem(failure.code)
    case "CloudRateLimited": return { kind: "RateLimited", retryAt: failure.retryAt }
    case "CloudInsufficientCredits":
    case "CloudAllowanceExhausted":
    case "CloudConsentRequired":
    case "CloudUnavailable":
    case "CloudProviderIssue":
    case "CloudNetwork": return { kind: "Unavailable" }
    default: {
      const _exhaustive: never = failure
      return _exhaustive
    }
  }
}
