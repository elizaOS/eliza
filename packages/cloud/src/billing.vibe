// spec/cloud/index.md, "Story: Use inference on my subscription or funded pilot account"; spec/cloud/billing/providerEvents.md, "Each event type has one owner, and an event of any other type is done at its first handling"
import { WorkerResponse } from "./worker-platform.ts"
import type { Client } from "pg"
import Stripe from "stripe"
import { reconcileSubscription } from "./billing/subscriptions.vibe"
import { foreign, type Tx } from "./store/connection.vibe"
import { catalogMatches, readStripeSubscription, resourceId, stripeClient } from "./billing/stripe-observation.vibe"

export type BillingEnv = {
  STRIPE_SECRET_KEY: string
  STRIPE_WEBHOOK_SECRET: string
  STRIPE_PRICE_ID: string
  STRIPE_PRODUCT_ID: string
  STRIPE_PLAN: "plus_monthly" | "pro_monthly"
  CLOUD_ENVIRONMENT: "staging" | "production"
  WEB_ORIGIN: string
}
type Customer = { customer_id: string; checkout_id: string | null }

export async function billingTransaction<T>(db: Client, account: string, work: () => Promise<T>): Promise<T> {
  await db.query("BEGIN")
  try {
    await db.query("SELECT pg_advisory_xact_lock(hashtextextended($1, 0))", [account])
    const result = await work()
    await db.query("COMMIT")
    return result
  } catch (failure) {
    await db.query("ROLLBACK")
    throw failure
  }
}

async function customerFor(db: Client, account: string) {
  return (await db.query<Customer>("SELECT customer_id, checkout_id FROM cloud_checkout_customers WHERE organization_id = $1", [account])).rows[0]
}

function provider(env: BillingEnv) {
  return stripeClient(env.STRIPE_SECRET_KEY)
}

async function reconcile(stripe: Stripe, env: BillingEnv, db: Client, organization: string, customer: string) {
  const linked = (await db.query<{ checkout_id: string | null }>(`SELECT c.checkout_id FROM cloud_checkout_customers c
    JOIN organizations o ON o.id=c.organization_id WHERE c.organization_id=$1 AND c.customer_id=$2 FOR UPDATE OF o,c`, [organization, customer])).rows[0]
  if (!linked) return { active: false, ongoing: false }
  const { observation, chargeIds, ongoing } = await readStripeSubscription(stripe, env, customer)
  const tx: Tx = {
    query: (sql, params = []) => foreign("query", async () => (await db.query(sql, [...params])).rows),
    script: (sql) => foreign("script", async () => { await db.query(sql) })
  }
  const stored = (await db.query<{ provider_subscription_id: string | null }>("SELECT provider_subscription_id FROM subscriptions WHERE key=$1", [organization])).rows[0]
  let verifiedCheckout: string | undefined
  if (linked.checkout_id && observation.subscriptionId && observation.subscriptionId !== stored?.provider_subscription_id) {
    const checkout = await stripe.checkout.sessions.retrieve(linked.checkout_id, { expand: ["line_items"] })
    if (checkout.id === linked.checkout_id && checkout.client_reference_id === organization &&
        resourceId(checkout.customer) === customer && checkout.livemode === (env.CLOUD_ENVIRONMENT === "production") &&
        checkout.mode === "subscription" && checkout.status === "complete" && checkout.payment_status === "paid" &&
        resourceId(checkout.subscription) === observation.subscriptionId &&
        checkout.line_items?.has_more === false && checkout.line_items.data.length === 1 &&
        checkout.line_items.data[0]?.price?.id === env.STRIPE_PRICE_ID && checkout.line_items.data[0]?.quantity === 1)
      verifiedCheckout = checkout.id
  }
  const state = await Effect.runPromise(reconcileSubscription(tx, organization, observation, Date.now(),
    verifiedCheckout === undefined ? undefined : { kind: "Checkout", checkoutId: verifiedCheckout }))
  if (chargeIds.length && observation.subscriptionId === state.subscriptionId) {
    await db.query(`INSERT INTO cloud_stripe_charge_owners (charge_id, customer_id)
      SELECT unnest($1::text[]), $2 ON CONFLICT (charge_id) DO NOTHING`, [chargeIds, customer])
    const confirmed = await db.query(
      "SELECT charge_id FROM cloud_stripe_charge_owners WHERE charge_id = ANY($1::text[]) AND customer_id = $2", [chargeIds, customer])
    if (confirmed.rowCount !== chargeIds.length) throw new Error("Stripe charge already has a different owner")
  }
  return { active: state.status === "Active", ongoing }
}

type BillingOwner = { organization_id: string; customer_id: string }

async function refreshDue(stripe: Stripe, env: BillingEnv, db: Client, owner: BillingOwner) {
  await billingTransaction(db, owner.organization_id, async () => {
    const stale = await db.query("SELECT key FROM subscriptions WHERE key=$1 AND updated_at <= $2", [owner.organization_id, Date.now() - 300_000])
    if (stale.rowCount) await reconcile(stripe, env, db, owner.organization_id, owner.customer_id)
  })
}

export async function refreshPaidAccess(env: BillingEnv, db: Client, account: string) {
  const result = await db.query<BillingOwner>(`SELECT c.organization_id, c.customer_id FROM cloud_checkout_customers c
    JOIN accounts a ON a.organization_id=c.organization_id JOIN subscriptions s ON s.key=c.organization_id
    WHERE a.key=$1 AND a.status='active' AND s.updated_at <= $2`, [account, Date.now() - 300_000])
  const owner = result.rows[0]
  if (owner) await refreshDue(provider(env), env, db, owner)
}

export async function sweepSubscriptions(env: BillingEnv, db: Client) {
  if (!env.STRIPE_SECRET_KEY) return
  const stripe = provider(env)
  const due = await db.query<BillingOwner>(`SELECT c.organization_id, c.customer_id FROM cloud_checkout_customers c
    JOIN subscriptions s ON s.key=c.organization_id WHERE s.stale_after <= $1 AND s.status IN ('active','incomplete','past_due','unpaid','dunning')
    ORDER BY s.stale_after,s.key LIMIT 12`, [Date.now()])
  for (const owner of due.rows) {
    try {
      await refreshDue(stripe, env, db, owner)
    } catch {
      await db.query("UPDATE subscriptions SET stale_after=$2 WHERE key=$1 AND stale_after <= $3", [owner.organization_id, Date.now() + 300_000, Date.now()])
      await Effect.runPromise(Effect.logWarning("Subscription reconciliation will retry").pipe(Effect.annotateLogs({ organizationId: owner.organization_id })))
    }
  }
}

export const stripeWebhookRoute = "/api/v1/billing/webhook"

export async function stripeWebhook(request: Request, raw: Uint8Array, env: BillingEnv, db: Client) {
  const signature = request.headers.get("stripe-signature")
  if (!signature || !env.STRIPE_WEBHOOK_SECRET) return WorkerResponse.json({error:"invalid_signature"},{status:400})
  const stripe = provider(env)
  let event: Stripe.Event
  try {
    event = await stripe.webhooks.constructEventAsync(new TextDecoder().decode(raw),signature,env.STRIPE_WEBHOOK_SECRET,undefined,Stripe.createSubtleCryptoProvider())
  } catch { return WorkerResponse.json({error:"invalid_signature"},{status:400}) }
  if (event.livemode !== (env.CLOUD_ENVIRONMENT === "production")) return WorkerResponse.json({error:"invalid_environment"},{status:400})
  const obj = event.data.object
  let binding: BillingOwner | undefined
  if (obj.object === "dispute" || obj.object === "refund") {
    const charge = resourceId(obj.charge)
    if (charge) binding = (await db.query<BillingOwner>(`SELECT c.organization_id,c.customer_id FROM cloud_stripe_charge_owners q
      JOIN cloud_checkout_customers c ON c.customer_id=q.customer_id WHERE q.charge_id=$1`, [charge])).rows[0]
  } else if (obj.object === "subscription" || obj.object === "invoice" || obj.object === "checkout.session" || obj.object === "charge") {
    const customer = resourceId(obj.customer)
    if (customer) binding = (await db.query<BillingOwner>(
      "SELECT organization_id,customer_id FROM cloud_checkout_customers WHERE customer_id=$1", [customer])).rows[0]
  }
  const owner = binding
  if (owner) await billingTransaction(db, owner.organization_id, () => reconcile(stripe, env, db, owner.organization_id, owner.customer_id))
  return new WorkerResponse(null,{status:204})
}


export async function billingRequest(request: Request, env: BillingEnv, db: Client, user: string) {
  const account = (await db.query<{ organization_id: string }>("SELECT organization_id FROM accounts WHERE key = $1 AND status = 'active'", [user])).rows[0]?.organization_id
  if (!account) return WorkerResponse.json({ error: "authentication_required" }, { status: 401 })
  const route = new URL(request.url).pathname
  const configured = Boolean(env.STRIPE_SECRET_KEY && env.STRIPE_WEBHOOK_SECRET && env.STRIPE_PRICE_ID && env.STRIPE_PRODUCT_ID &&
    (env.STRIPE_PLAN === "plus_monthly" || env.STRIPE_PLAN === "pro_monthly"))
  if (!configured) {
    if (route === "/api/v1/billing/subscription" && request.method === "GET") {
      if (await customerFor(db, account)) return WorkerResponse.json({error:"billing_unavailable"}, {status:503})
      return WorkerResponse.json({status:"inactive",canManage:false,canCheckout:false})
    }
    return WorkerResponse.json({error:"billing_unavailable"}, {status:503})
  }
  if (route === "/api/v1/billing/subscription" && request.method === "GET") {
    const customer = await customerFor(db, account)
    const state = customer ? await billingTransaction(db, account, () => reconcile(provider(env), env, db, account, customer.customer_id)) : { active: false, ongoing: false }
    return WorkerResponse.json({ status: state.active ? "active" : "inactive", canManage: Boolean(customer), canCheckout: !state.ongoing })
  }
  if (request.method !== "POST" || (route !== "/api/v1/billing/checkout" && route !== "/api/v1/billing/portal")) {
    return WorkerResponse.json({ error: "route_not_found" }, { status: 404 })
  }
  const stripe = provider(env)
  const returnUrl = new URL("/#account", env.WEB_ORIGIN).href
  return billingTransaction(db, account, async () => {
    let customer = await customerFor(db, account)
    if (route.endsWith("/portal")) {
      if (!customer) return WorkerResponse.json({ error: "no_customer" }, { status: 409 })
      const session = await stripe.billingPortal.sessions.create({ customer: customer.customer_id, return_url: returnUrl })
      return WorkerResponse.json({ url: session.url })
    }
    if (!await catalogMatches(stripe, env, true)) return WorkerResponse.json({ error: "billing_catalog_mismatch" }, { status: 503 })
    if (!customer) {
      const created = await stripe.customers.create({ metadata: { organization_id: account } }, { idempotencyKey: "cloud-customer-" + account })
      customer = { customer_id: created.id, checkout_id: null }
      await db.query("INSERT INTO cloud_checkout_customers (organization_id, customer_id) VALUES ($1, $2)", [account, created.id])
    }
    if ((await reconcile(stripe, env, db, account, customer.customer_id)).ongoing) {
      return WorkerResponse.json({ error: "manage_existing_subscription" }, { status: 409 })
    }
    if (customer.checkout_id) {
      const existing = await stripe.checkout.sessions.retrieve(customer.checkout_id)
      if (existing.status === "open" && existing.url) return WorkerResponse.json({ url: existing.url })
      if (existing.status === "complete" && existing.payment_status === "unpaid") return WorkerResponse.json({ error: "payment_pending" }, { status: 409 })
    }
    const session = await stripe.checkout.sessions.create({
      mode: "subscription", customer: customer.customer_id, client_reference_id: account,
      line_items: [{ price: env.STRIPE_PRICE_ID, quantity: 1 }], success_url: returnUrl, cancel_url: returnUrl
    }, { idempotencyKey: ["cloud-checkout", account, env.STRIPE_PRICE_ID, customer.checkout_id ?? "first"].join("-") })
    if (!session.url) throw new Error("Checkout did not return a hosted session")
    await db.query("UPDATE cloud_checkout_customers SET checkout_id = $2 WHERE organization_id = $1", [account, session.id])
    return WorkerResponse.json({ url: session.url })
  })
}
