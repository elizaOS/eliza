{
  "name": "@elizaos/operator",
  "version": "0.0.1",
  "description": "elizaOS Server Operator",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "pepr": {
    "uuid": "eliza-operator",
    "onError": "reject",
    "webhookTimeout": 10,
    "customLabels": {
      "namespace": {
        "pepr.dev": ""
      }
    },
    "alwaysIgnore": {
      "namespaces": []
    },
    "admission": {
      "alwaysIgnore": {
        "namespaces": []
      }
    },
    "watch": {
      "alwaysIgnore": {
        "namespaces": []
      }
    },
    "includedFiles": [],
    "env": {}
  },
  "scripts": {
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write --unsafe .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/operator/build.ts",
    "clean": "rm -rf dist",
    "dev": "bunx pepr dev"
  },
  "dependencies": {
    "ioredis": "^5.10.1",
    "kubernetes-fluent-client": "^3.11.11",
    "pepr": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "esbuild": "0.28.1",
    "ioredis-mock": "^8.13.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "5.8.3"
  }
}
