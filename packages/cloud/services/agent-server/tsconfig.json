{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["node", "eliza-source"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../../../../",
    "types": ["bun-types", "node"],
    "paths": {
      "@elizaos/plugin-openai": [
        "../../../../plugins/plugin-openai/index.node.ts"
      ]
    }
  },
  "include": ["src"]
}
