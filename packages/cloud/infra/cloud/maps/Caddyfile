# TLS and access control in front of the Maps backends. Caddy writes no
# access log unless a `log` directive is added; keep it that way, because
# Nominatim requests carry the search text and coordinates in the query.
# Eliza Cloud sends the access key as the `key` query parameter
# (ELIZA_MAPS_GEOCODER_API_KEY / ELIZA_MAPS_ROUTER_API_KEY); it is removed
# before the request reaches a backend.

{$MAPS_SEARCH_HOST} {
	@authorized query key={$MAPS_ACCESS_KEY}
	handle @authorized {
		uri query -key
		reverse_proxy nominatim:8080
	}
	handle {
		respond "Forbidden" 403
	}
}

{$MAPS_ROUTE_HOST} {
	@authorized query key={$MAPS_ACCESS_KEY}
	handle @authorized {
		uri query -key
		reverse_proxy graphhopper:8989
	}
	handle {
		respond "Forbidden" 403
	}
}
