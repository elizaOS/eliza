# Backend stack (docker compose). Copy to .env next to compose.yaml.
# Region extract, for example https://download.geofabrik.de/europe/monaco-latest.osm.pbf.
# Save the same file as ./data/region.osm.pbf for GraphHopper.
MAPS_PBF_URL=
# Optional minutely or daily updates for Nominatim, e.g. the extract's -updates URL.
MAPS_REPLICATION_URL=
MAPS_IMPORT_THREADS=4
NOMINATIM_DB_PASSWORD=
# sha256 of graphhopper-web-10.2.jar after the operator reviewed it.
GRAPHHOPPER_SHA256=
GRAPHHOPPER_JAVA_OPTS=-Xmx2g
# Public TLS names served by Caddy, and the access key Eliza Cloud sends.
MAPS_SEARCH_HOST=
MAPS_ROUTE_HOST=
MAPS_ACCESS_KEY=

# Eliza Cloud API settings (Worker secrets/vars), matching the stack above.
# ELIZA_MAPS_PROVIDER=osm
# ELIZA_MAPS_GEOCODER=nominatim
# ELIZA_MAPS_ROUTER=graphhopper
# ELIZA_MAPS_GEOCODER_URL=https://<MAPS_SEARCH_HOST>/
# ELIZA_MAPS_GEOCODER_API_KEY=<MAPS_ACCESS_KEY>
# ELIZA_MAPS_ROUTER_URL=https://<MAPS_ROUTE_HOST>/
# ELIZA_MAPS_ROUTER_API_KEY=<MAPS_ACCESS_KEY>
# ELIZA_MAPS_ROUTER_PROFILES={"drive":"car","walk":"foot","bicycle":"bike"}
# ELIZA_MAPS_COVERAGE_JSON=[{"id":"monaco","name":"Monaco","bounds":[7.409,43.724,7.449,43.752]}]
# ELIZA_MAPS_DATASET_REVISION=geofabrik-monaco-<extract date>
# ELIZA_MAPS_OPERATOR=<who runs these servers>
# ELIZA_MAPS_ROUTE_ALTERNATIVES=true
