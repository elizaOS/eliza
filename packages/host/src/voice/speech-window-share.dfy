// Generated by lsc from speech-window-share.ts

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

function speechWindowShare(total: int, size: int, index: int, granted: int): int
  requires (0 <= total)
  requires (total <= 9007199254740991)
  requires (0 < size)
  requires (size <= 9007199254740991)
  requires (0 <= index)
  requires (index < granted)
  requires (granted <= 9007199254740991)
  requires ((granted * size) <= 9007199254740991)
{
  var remainder := MathMax(0, (total - (index * size)));
  if (index == (granted - 1)) then
    remainder
  else
    MathMin(size, remainder)
}

lemma speechWindowShare_ensures(total: int, size: int, index: int, granted: int)
  requires (0 <= total)
  requires (total <= 9007199254740991)
  requires (0 < size)
  requires (size <= 9007199254740991)
  requires (0 <= index)
  requires (index < granted)
  requires (granted <= 9007199254740991)
  requires ((granted * size) <= 9007199254740991)
  ensures (0 <= speechWindowShare(total, size, index, granted))
  ensures ((index < (granted - 1)) ==> (speechWindowShare(total, size, index, granted) <= size))
  ensures ((index == (granted - 1)) ==> (speechWindowShare(total, size, index, granted) == MathMax(0, (total - (index * size)))))
{
  reveal speechWindowShare();
  reveal MathMin();
  reveal MathMax();
}

// Sum of the actual production helper over a prefix of the granted windows.
function SpeechSharePrefix(total: int, size: int, granted: int, count: int): int
  requires 0 <= total <= 9007199254740991
  requires 0 < size <= 9007199254740991
  requires 0 < granted <= 9007199254740991
  requires granted * size <= 9007199254740991
  requires 0 <= count <= granted
  decreases count
{
  if count == 0 then 0 else SpeechSharePrefix(total, size, granted, count - 1) + speechWindowShare(total, size, count - 1, granted)
}

lemma NonFinalSpeechSharePrefix(total: int, size: int, granted: int, count: int)
  requires 0 <= total <= 9007199254740991
  requires 0 < size <= 9007199254740991
  requires 0 < granted <= 9007199254740991
  requires granted * size <= 9007199254740991
  requires 0 <= count < granted
  ensures SpeechSharePrefix(total, size, granted, count) == MathMin(total, count * size)
  decreases count
{
  reveal SpeechSharePrefix();
  reveal MathMin();
  if count > 0 {
    NonFinalSpeechSharePrefix(total, size, granted, count - 1);
    reveal speechWindowShare();
    reveal MathMax();
    var before := (count - 1) * size;
    assert count * size == before + size;
    if total <= before {
      assert speechWindowShare(total, size, count - 1, granted) == 0;
    } else if total >= before + size {
      assert speechWindowShare(total, size, count - 1, granted) == size;
    } else {
      assert speechWindowShare(total, size, count - 1, granted) == total - before;
    }
  }
}

lemma SpeechWindowSharesConserveTotal(total: int, size: int, granted: int)
  requires 0 <= total <= 9007199254740991
  requires 0 < size <= 9007199254740991
  requires 0 < granted <= 9007199254740991
  requires granted * size <= 9007199254740991
  ensures SpeechSharePrefix(total, size, granted, granted) == total
{
  NonFinalSpeechSharePrefix(total, size, granted, granted - 1);
  reveal SpeechSharePrefix();
  reveal speechWindowShare();
  reveal MathMin();
  reveal MathMax();
  if total <= (granted - 1) * size {
    assert speechWindowShare(total, size, granted - 1, granted) == 0;
  } else {
    assert speechWindowShare(total, size, granted - 1, granted) == total - (granted - 1) * size;
  }
}
