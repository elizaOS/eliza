      "eliza-source": "./src/voice/protocol.ts",
      "types": "./dist/voice/protocol.d.ts",
      "import": "./dist/voice/protocol.js",
      "default": "./dist/voice/protocol.js"
    },
    "./voice/session-registry": {
      "workerd": "./dist/voice/session-registry.js",
      "worker": "./dist/voice/session-registry.js",
      "browser": null,
      "eliza-source": "./src/voice/session-registry.ts",
      "types": "./dist/voice/session-registry.d.ts",
      "import": "./dist/voice/session-registry.js",
      "default": "./dist/voice/session-registry.js"
    },
    "./voice/eliza-sse-bridge": {
      "workerd": "./dist/voice/eliza-sse-bridge.js",
      "worker": "./dist/voice/eliza-sse-bridge.js",
      "browser": null,
      "eliza-source": "./src/voice/eliza-sse-bridge.ts",
      "types": "./dist/voice/eliza-sse-bridge.d.ts",
      "import": "./dist/voice/eliza-sse-bridge.js",
      "default": "./dist/voice/eliza-sse-bridge.js"
    },
    "./voice/ws-handler": {
      "workerd": "./dist/voice/ws-handler.js",
      "worker": "./dist/voice/ws-handler.js",
      "browser": null,
      "eliza-source": "./src/voice/ws-handler.ts",
      "types": "./dist/voice/ws-handler.d.ts",
      "import": "./dist/voice/ws-handler.js",
      "default": "./dist/voice/ws-handler.js"
    },
    "./voice/session-token": {
      "workerd": "./dist/voice/session-token.js",
      "worker": "./dist/voice/session-token.js",
      "browser": null,
      "eliza-source": "./src/voice/session-token.ts",
      "types": "./dist/voice/session-token.d.ts",
      "import": "./dist/voice/session-token.js",
      "default": "./dist/voice/session-token.js"
    },
    "./voice/usage": {
      "workerd": "./dist/voice/usage.js",
      "worker": "./dist/voice/usage.js",
      "browser": null,
      "eliza-source": "./src/voice/usage.ts",
      "types": "./dist/voice/usage.d.ts",
      "import": "./dist/voice/usage.js",
      "default": "./dist/voice/usage.js"
    }
  },
  "scripts": {
    "build": "tsc6 --noCheck -p tsconfig.emit.json && node ../scripts/rewrite-dist-relative-imports-node-esm.ts packages/host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../scripts/run-vitest.ts run && bun run test:native-host",
    "lint:check": "bunx @biomejs/biome check src *.ts native-host",
    "lint": "bunx @biomejs/biome check --write src *.ts native-host",
    "prepublishOnly": "bun run build",
    "test:native-host": "node --test native-host/*.test.mjs"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "zod": "^4.6.5",
    "@elizaos/contracts": "workspace:*",
    "tar": "7.5.22",
    "@msgpack/msgpack": "3.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "elizaos": {
    "scripts": {
      "buildOnInstall": {},
      "testLanes": [
        "server"
      ]
    }
  }
}
