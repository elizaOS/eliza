{
  "name": "@elizaos/host",
  "version": "2.0.3-beta.7",
  "description": "Shared application host configuration and explicit HTTP plugin lifecycle.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native-host/*.mjs",
    "native-host/*.patch",
    "!native-host/*.test.mjs"
  ],
  "exports": {
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "eliza-source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./native-host": {
      "browser": null,
      "import": "./native-host/index.mjs",
      "default": "./native-host/index.mjs"
    },
    "./voice/session": {
      "workerd": "./dist/voice/session.js",
      "worker": "./dist/voice/session.js",
      "browser": null,
      "eliza-source": "./src/voice/session.ts",
      "types": "./dist/voice/session.d.ts",
      "import": "./dist/voice/session.js",
      "default": "./dist/voice/session.js"
    },
    "./voice/uplink-reframer": {
      "workerd": "./dist/voice/uplink-reframer.js",
      "worker": "./dist/voice/uplink-reframer.js",
      "browser": null,
      "eliza-source": "./src/voice/uplink-reframer.ts",
      "types": "./dist/voice/uplink-reframer.d.ts",
      "import": "./dist/voice/uplink-reframer.js",
      "default": "./dist/voice/uplink-reframer.js"
    },
    "./voice/local-runtime-conversation-fetch": {
      "workerd": "./dist/voice/local-runtime-conversation-fetch.js",
      "worker": "./dist/voice/local-runtime-conversation-fetch.js",
      "browser": null,
      "eliza-source": "./src/voice/local-runtime-conversation-fetch.ts",
      "types": "./dist/voice/local-runtime-conversation-fetch.d.ts",
      "import": "./dist/voice/local-runtime-conversation-fetch.js",
      "default": "./dist/voice/local-runtime-conversation-fetch.js"
    },
    "./voice/cartesia-ink": {
      "workerd": "./dist/voice/cartesia-ink.js",
      "worker": "./dist/voice/cartesia-ink.js",
      "browser": null,
      "eliza-source": "./src/voice/cartesia-ink.ts",
      "types": "./dist/voice/cartesia-ink.d.ts",
      "import": "./dist/voice/cartesia-ink.js",
      "default": "./dist/voice/cartesia-ink.js"
    },
    "./voice/cartesia-sonic-tts": {
      "workerd": "./dist/voice/cartesia-sonic-tts.js",
      "worker": "./dist/voice/cartesia-sonic-tts.js",
      "browser": null,
      "eliza-source": "./src/voice/cartesia-sonic-tts.ts",
      "types": "./dist/voice/cartesia-sonic-tts.d.ts",
      "import": "./dist/voice/cartesia-sonic-tts.js",
      "default": "./dist/voice/cartesia-sonic-tts.js"
    },
    "./voice/fish-audio-tts": {
      "workerd": "./dist/voice/fish-audio-tts.js",
      "worker": "./dist/voice/fish-audio-tts.js",
      "browser": null,
      "eliza-source": "./src/voice/fish-audio-tts.ts",
      "types": "./dist/voice/fish-audio-tts.d.ts",
      "import": "./dist/voice/fish-audio-tts.js",
      "default": "./dist/voice/fish-audio-tts.js"
    },
    "./voice/phrase-aggregator": {
      "workerd": "./dist/voice/phrase-aggregator.js",
      "worker": "./dist/voice/phrase-aggregator.js",
      "browser": null,
      "eliza-source": "./src/voice/phrase-aggregator.ts",
      "types": "./dist/voice/phrase-aggregator.d.ts",
      "import": "./dist/voice/phrase-aggregator.js",
      "default": "./dist/voice/phrase-aggregator.js"
    },
    "./voice/protocol": {
