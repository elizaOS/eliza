// spec/workflow/hostedDigest.md, "Story: Acknowledge a page of digests only after it is stored"; spec/workflow/hostedDigest.md, "Parse the complete page before durable writes and bind its acknowledgement to its final incoming row"; spec/workflow/hostedDigest.md, "Writes may leave unindexed bytes, and eviction journals precede deletion"; spec/workflow/hostedDigest.md, "Notice retry and an uncertain ACK preserve the committed journal"; spec/workflow/hostedDigest.md, "Reconciliation preserves equivalent bytes and replaces only the matching cancellation"; spec/workflow/hostedDigest.md, "Source freshness and newer results determine whether a retry offer is visible"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import {
  initial, initialDigestIndex, machineOver, type DigestInbox as DigestInboxState, type Event as DigestInboxEvent, type Rejected as DigestInboxRejected, offersMissedRun, planDigestIndex, reconcileDigest,
  type DigestIndex, type DigestPageRow, type DigestStatus, type SavedDigestRow,
} from "../../gen/workflow__hostedDigest.effect.vibe"
import {
  DIGEST_PAGE_LIMIT, DIGEST_RENEWAL_WINDOW_MS, DIGEST_RETAINED_RESULTS, digestSourceState, isDigestNotRunStatus, missedRunNowMutationId,
  type DigestNotRunStatus, type DigestSourceState, type DigestSpec, type DigestTemplate, type HostedLiveSelection, type HostedNativeSelection,
} from "../contract/digest.vibe"
import { workflowUuid, zoneOffsetMinutes } from "../contract/phone.vibe"
import { WorkflowResponseInvalid, type WorkflowHttpError, type WorkflowRequest } from "../client/workflow-client.vibe"

export interface DigestSource {
  readonly id: string; readonly revision: string; readonly kind: string; readonly label: string; readonly observedAt: string; readonly expiresAt: string
  readonly revoked: boolean; readonly live?: HostedLiveSelection | HostedNativeSelection
}
export interface DigestLoop {
  readonly id: string; readonly versionId: string; readonly name: string; readonly active: boolean; readonly removed: boolean; readonly spec: DigestSpec
  readonly sourceState?: DigestSourceState
}
export interface DigestResult {
  readonly cursor: number; readonly runId: string; readonly workflowId: string; readonly workflowVersionId: string; readonly templateVersion: string
  readonly scheduledAt: string; readonly source: Readonly<Record<string, unknown>>; readonly status: string; readonly startedAt: string; readonly completedAt: string
  readonly output: unknown; readonly error: string | null
}
export interface DigestCapabilities { readonly digests: boolean; readonly nativeSources: boolean; readonly nativeEvening: boolean; readonly sourcePause: boolean; readonly dossier: boolean }
export interface HostedLiveAccount { readonly accountId: string; readonly accountRevision: string; readonly label: string; readonly kinds: readonly ("email" | "calendar")[]; readonly expiresAt?: string }
export interface HostedLiveCalendar { readonly calendarId: string; readonly label: string; readonly timeZone: string }
export interface DigestRenewal { readonly source: DigestSource; readonly state: DigestSourceState | "expiring"; readonly loops: readonly DigestLoop[] }
export interface MissedRunNow {
  readonly runId: string; readonly sourceId: string; readonly sourceRevision: string; readonly sourceLabel: string; readonly scheduledAt: string; readonly mutationId: string
}
export interface RetainedDigestSummary { readonly summary: string; readonly ranAt: string; readonly agent: string; readonly status: string }
export type HostedDigestMutationPath = "sources" | "loops" | "sources/revoke" | "dossier"

export error HostedSourceRejected { get message() { return "Source access changed before saving. Refresh accounts and review the source again." } }
export error DigestInboxFailed { reason: string }

export const HOSTED_DIGEST_CLIENT_ROUTES: readonly string[] = [
  "GET /api/workflow/status", "GET /api/workflow/hosted/live-accounts", "POST /api/workflow/hosted/live-calendars", "GET /api/workflow/hosted/sources",
  "GET /api/workflow/hosted/loops", "POST /api/workflow/hosted/sources", "POST /api/workflow/hosted/loops", "POST /api/workflow/hosted/sources/revoke",
  "POST /api/workflow/hosted/dossier", "GET /api/workflow/hosted/results", "POST /api/workflow/hosted/results/ack",
]

type Bag = Record<string, unknown>
type ProtocolError = WorkflowHttpError | WorkflowResponseInvalid | HostedSourceRejected

effect function invalid(message: string): never!WorkflowResponseInvalid {
  throw new WorkflowResponseInvalid({ message })
}

effect function object(value: unknown): Bag!WorkflowResponseInvalid {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return try invalid("Invalid hosted digest response")
  return value as Bag
}

effect function id(value: unknown): string!WorkflowResponseInvalid {
  if (typeof value !== "string" || !/^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/.test(value)) return try invalid("Invalid digest identity")
  return value
}

effect function date(value: unknown): string!WorkflowResponseInvalid {
  if (typeof value !== "string" || !Number.isFinite(Date.parse(value))) return try invalid("Invalid digest date")
  return value
}

effect function boundedIdentity(value: unknown): string!WorkflowResponseInvalid {
  if (typeof value !== "string" || value.length === 0 || value.length > 256 || Array.from(value).some((c) => c.charCodeAt(0) < 32 || c.charCodeAt(0) === 127)) {
    return try invalid("Invalid live source identity")
  }
  return value
}

effect function revision(value: unknown): string!WorkflowResponseInvalid {
  if (typeof value !== "string" || !/^[a-f0-9]{64}$/.test(value)) return try invalid("Invalid live source revision")
  return value
}

const nativeKeys = ["provider", "ownerId", "agentId", "installationId", "enrollmentId", "sourceId", "revision"]

effect function liveSelection(value: unknown): (HostedLiveSelection | HostedNativeSelection)!WorkflowResponseInvalid {
  const v = try object(value)
  if (v.provider === "native") {
    if (Object.keys(v).some((key) => !nativeKeys.includes(key))) return try invalid("Invalid native source")
    return {
      provider: "native", ownerId: try boundedIdentity(v.ownerId), agentId: try boundedIdentity(v.agentId), installationId: try boundedIdentity(v.installationId),
      enrollmentId: try boundedIdentity(v.enrollmentId), sourceId: try boundedIdentity(v.sourceId), revision: try revision(v.revision),
    }
  }
  const window = v.windowHours
  const items = v.maxItems
  if (v.provider !== "google" || (v.kind !== "email" && v.kind !== "calendar") || typeof window !== "number" || !Number.isInteger(window) || window < 1 || window > 168
    || typeof items !== "number" || !Number.isInteger(items) || items < 1 || items > 25) return try invalid("Invalid live source")
  return {
    provider: "google", accountId: try boundedIdentity(v.accountId), accountRevision: try revision(v.accountRevision), kind: v.kind, windowHours: window, maxItems: items,
    ...(v.kind === "calendar" ? { calendarId: try boundedIdentity(v.calendarId) } : {}),
  }
}

export effect function parseDigestResult(value: unknown): DigestResult!WorkflowResponseInvalid {
  const v = try object(value)
  const cursor = v.cursor
  if (typeof cursor !== "number" || !Number.isSafeInteger(cursor) || cursor < 1 || typeof v.status !== "string" || JSON.stringify(v).length > 200000) return try invalid("Invalid digest result")
  return {
    cursor, runId: try id(v.runId), workflowId: try id(v.workflowId), workflowVersionId: try id(v.workflowVersionId), templateVersion: try id(v.templateVersion),
    scheduledAt: try date(v.scheduledAt), source: try object(v.source), status: v.status, startedAt: try date(v.startedAt), completedAt: try date(v.completedAt),
    output: v.output, error: typeof v.error === "string" ? v.error : null,
  }
}

const notRunLabel: Readonly<Record<DigestNotRunStatus, string>> = {
  missed: "Missed — not run",
  overlap: "Skipped — an earlier run was still active",
  unavailable: "Not run — source unavailable",
}

export function digestRan(result: Pick<DigestResult, "status">): boolean {
  return !isDigestNotRunStatus(result.status)
}

export function digestStatusLabel(status: string): string {
  return isDigestNotRunStatus(status) ? notRunLabel[status] : status
}

export function digestSummaryText(result: Pick<DigestResult, "runId" | "output" | "error">): string {
  if (result.error !== null) return result.error
  const output = result.output
  if (typeof output === "string") return output
  if (Array.isArray(output) && output.length === 1) {
    const value: unknown = output[0]
    if (typeof value === "object" && value !== null && "nodeId" in value && value.nodeId === "typed-steps" && "runId" in value && value.runId === result.runId
      && "text" in value && typeof value.text === "string") return value.text
  }
  if (typeof output === "object" && output !== null && !Array.isArray(output)) {
    if ("summary" in output && typeof output.summary === "string") return output.summary
    if ("text" in output && typeof output.text === "string") return output.text
  }
  return "No readable summary was returned. Open execution details to inspect this result."
}

export function digestRenewals(sources: readonly DigestSource[], loops: readonly DigestLoop[], now: number): DigestRenewal[] {
  return sources.flatMap((source) => {
    const bound = loops.filter((loop) => !loop.removed && loop.spec.enabled && loop.spec.sourceId === source.id)
    if (bound.length === 0) return []
    const reported = bound.find((loop) => loop.sourceState !== undefined && loop.sourceState !== "current")?.sourceState
    const expiresAt = Date.parse(source.expiresAt)
    const state: DigestRenewal["state"] = source.revoked || reported === "revoked" ? "revoked"
      : expiresAt <= now || reported === "expired" ? "expired"
      : expiresAt - now <= DIGEST_RENEWAL_WINDOW_MS ? "expiring" : "current"
    return state === "current" ? [] : [{ source, state, loops: bound }]
  })
}

export function digestLoopState(loop: DigestLoop, sources: readonly DigestSource[], now: number, pauses = false): string {
  if (loop.removed) return "Removed"
  if (!loop.spec.enabled || !loop.active) return "Paused"
  const source = sources.find((candidate) => candidate.id === loop.spec.sourceId)
  const suffix = pauses ? " — paused" : " — renew to resume"
  if (loop.sourceState === "revoked" || source?.revoked === true) return `Source revoked${suffix}`
  if (loop.sourceState === "expired" || source === undefined || digestSourceState(source, now) === "expired") return `Source expired${suffix}`
  return "On"
}

export function digestZoneNote(loop: Pick<DigestLoop, "spec" | "removed">, deviceZone: string, now: number): string {
  if (loop.removed || !loop.spec.enabled || loop.spec.timeZone === deviceZone) return ""
  const reviewed = zoneOffsetMinutes(now, loop.spec.timeZone)
  const device = zoneOffsetMinutes(now, deviceZone)
  if (reviewed === device) return ""
  return `Runs at ${loop.spec.localTime} in ${loop.spec.timeZone}, not ${deviceZone}.`
}

export function missedRunNowOffers(results: readonly DigestResult[], loops: readonly DigestLoop[], sources: readonly DigestSource[], now: number): Map<string, MissedRunNow> {
  const offers = new Map<string, MissedRunNow>()
  for (const result of results) {
    if (result.status !== "missed") continue
    const loop = loops.find((candidate) => candidate.id === result.workflowId)
    const source = loop === undefined ? undefined : sources.find((candidate) => candidate.id === loop.spec.sourceId)
    const mutationId = missedRunNowMutationId(result.runId)
    const superseding = (other: DigestResult) => other.workflowId === loop?.id || other.source.id === source?.id || !loops.some((candidate) => candidate.id === other.workflowId)
    const offered = loop !== undefined && loop.spec.template === "morning" && offersMissedRun({
      scheduledAt: Date.parse(result.scheduledAt), digestExists: true, removed: loop.removed, active: loop.active, enabled: loop.spec.enabled,
      deviceSource: source?.live?.provider === "native", revisionMatches: source?.revision === loop.spec.sourceRevision, sourcePresent: source !== undefined,
      revoked: source?.revoked ?? false, expiresAt: source === undefined ? 0 : Date.parse(source.expiresAt),
      digestSourceCurrent: loop.sourceState === undefined || loop.sourceState === "current",
      newerResult: results.some((other) => other.cursor > result.cursor && superseding(other)), validMutation: mutationId !== undefined,
    }, now)
    if (offered && source !== undefined && mutationId !== undefined) {
      offers.set(result.runId, { runId: result.runId, sourceId: source.id, sourceRevision: source.revision, sourceLabel: source.label, scheduledAt: result.scheduledAt, mutationId })
    }
  }
  return offers
}

function clipText(text: string, maximum: number): string {
  return text.length <= maximum ? text : `${text.slice(0, maximum - 1).trimEnd()}…`
}

export function latestRetainedBrief(results: readonly DigestResult[] | undefined, agent = "Your agent"): RetainedDigestSummary | undefined {
  const latest = (results ?? []).filter(digestRan).reduce<DigestResult | undefined>((best, row) => {
    if (best === undefined) return row
    const a = Date.parse(row.completedAt)
    const b = Date.parse(best.completedAt)
    return a > b || (a === b && row.cursor > best.cursor) ? row : best
  }, undefined)
  return latest === undefined ? undefined : { summary: clipText(digestSummaryText(latest), 2000), ranAt: latest.completedAt, agent: clipText(agent, 200) || "Your agent", status: latest.status }
}

export function hostedDigestProtocol(request: WorkflowRequest) {
  effect function capabilities(): DigestCapabilities!ProtocolError {
    const v = try object(try request("/api/workflow/status", undefined))
    return {
      digests: v.hostedDigestProtocol === 1, nativeSources: v.hostedNativeSourceProtocol === 1,
      nativeEvening: v.hostedNativeSourceProtocol === 1 && v.hostedNativeEveningProtocol === 1, sourcePause: v.hostedDigestSourcePauseProtocol === 1, dossier: v.hostedDossierProtocol === 1,
    }
  }

  effect function liveAccounts(): readonly HostedLiveAccount[]!ProtocolError {
    const v = try object(try request("/api/workflow/hosted/live-accounts", undefined))
    if (!Array.isArray(v.accounts) || v.accounts.length > 100) return try invalid("Invalid live accounts")
    const accounts: HostedLiveAccount[] = []
    for (const raw of v.accounts) {
      const a = try object(raw)
      const kinds = a.kinds
      if (!Array.isArray(kinds) || kinds.length === 0 || kinds.length > 2 || new Set(kinds).size !== kinds.length || kinds.some((k) => k !== "email" && k !== "calendar")
        || typeof a.label !== "string" || a.label === "" || a.label.length > 200
        || (a.expiresAt !== undefined && (typeof a.expiresAt !== "string" || !Number.isFinite(Date.parse(a.expiresAt))))) return try invalid("Invalid live account")
      accounts.push({
        accountId: try boundedIdentity(a.accountId), accountRevision: try revision(a.accountRevision), label: a.label, kinds: kinds as ("email" | "calendar")[],
        ...(typeof a.expiresAt === "string" ? { expiresAt: a.expiresAt } : {}),
      })
    }
    return accounts
  }

  effect function liveCalendars(account: Pick<HostedLiveAccount, "accountId" | "accountRevision">): { readonly calendars: readonly HostedLiveCalendar[]; readonly truncated: boolean }!ProtocolError {
    const v = try object(try request("/api/workflow/hosted/live-calendars", { accountId: account.accountId, accountRevision: account.accountRevision }))
    if (!Array.isArray(v.calendars) || v.calendars.length > 50 || typeof v.truncated !== "boolean") return try invalid("Invalid live calendars")
    const calendars: HostedLiveCalendar[] = []
    for (const raw of v.calendars) {
      const c = try object(raw)
      if (typeof c.label !== "string" || c.label === "" || c.label.length > 256 || typeof c.timeZone !== "string" || c.timeZone.length > 100) return try invalid("Invalid live calendar")
      calendars.push({ calendarId: try boundedIdentity(c.calendarId), label: c.label, timeZone: c.timeZone })
    }
    return { calendars, truncated: v.truncated }
  }

  effect function sources(): DigestSource[]!ProtocolError {
    const values = (try object(try request("/api/workflow/hosted/sources", undefined))).sources
    if (!Array.isArray(values) || values.length > 1000) return try invalid("Invalid sources")
    const found: DigestSource[] = []
    for (const raw of values) {
      const v = try object(raw)
      found.push({
        id: try id(v.id), revision: try id(v.revision), kind: String(v.kind), label: clipText(String(v.label), 200), observedAt: try date(v.observedAt),
        expiresAt: try date(v.expiresAt), revoked: v.revoked === true, ...(v.live === undefined ? {} : { live: try liveSelection(v.live) }),
      })
    }
    return found
  }

  effect function loops(): DigestLoop[]!ProtocolError {
    const values = (try object(try request("/api/workflow/hosted/loops", undefined))).loops
    if (!Array.isArray(values) || values.length > 1000) return try invalid("Invalid loops")
    const found: DigestLoop[] = []
    for (const raw of values) {
      const v = try object(raw)
      const spec = try object(v.spec)
      const state = v.sourceState
      if (typeof v.name !== "string" || typeof v.active !== "boolean" || typeof v.removed !== "boolean" || (spec.template !== "morning" && spec.template !== "evening")) {
        return try invalid("Invalid loop")
      }
      found.push({
        id: try id(v.id), versionId: try id(v.versionId), name: v.name, active: v.active, removed: v.removed, spec: spec as unknown as DigestSpec,
        ...(state === "current" || state === "expired" || state === "revoked" ? { sourceState: state } : {}),
      })
    }
    return found
  }

  effect function mutate(target: HostedDigestMutationPath, body: Bag): Bag!ProtocolError {
    return try object((request(`/api/workflow/hosted/${target}`, body) catch effect (error) => {
      if (target === "sources" && (error.status === 409 || error.status === 400) && error.code === "HOSTED_SOURCE_NOT_SAVED" && error.mutationId === body.id) throw new HostedSourceRejected()
      throw error
    }))
  }

  effect function results(clientId: string): DigestResult[]!ProtocolError {
    const v = try object(try request(`/api/workflow/hosted/results?clientId=${encodeURIComponent(try id(clientId))}`, undefined))
    if (!Array.isArray(v.entries)) return try invalid("Invalid result page")
    const entries: DigestResult[] = []
    for (const raw of v.entries) entries.push(try parseDigestResult(raw))
    return entries
  }

  effect function ack(clientId: string, last: Pick<DigestResult, "cursor" | "runId">): void!ProtocolError {
    try request("/api/workflow/hosted/results/ack", { clientId, cursor: last.cursor, runId: last.runId })
  }

  effect function available(): boolean!ProtocolError {
    return (try capabilities()).digests
  }

  return { capabilities, available, liveAccounts, liveCalendars, sources, loops, mutate, results, ack }
}

export type HostedDigestProtocol = ReturnType<typeof hostedDigestProtocol>

function sameResultValue(left: unknown, right: unknown): boolean {
  if (left === right) return true
  if (left === null || right === null || typeof left !== "object" || typeof right !== "object") return false
  if (Array.isArray(left) || Array.isArray(right)) {
    return Array.isArray(left) && Array.isArray(right) && left.length === right.length && left.every((value, index) => sameResultValue(value, right[index]))
  }
  const a = left as Bag
  const b = right as Bag
  const keys = Object.keys(a)
  return keys.length === Object.keys(b).length && keys.every((key) => Object.hasOwn(b, key) && sameResultValue(a[key], b[key]))
}

function digestStatus(status: string): DigestStatus {
  return status === "cancelled" ? "DigestCancelled" : status === "failed" ? "DigestFailed" : "DigestOther"
}

function sameProvenance(saved: DigestResult, incoming: DigestResult): boolean {
  return saved.runId === incoming.runId && saved.workflowId === incoming.workflowId && saved.workflowVersionId === incoming.workflowVersionId
    && saved.templateVersion === incoming.templateVersion && saved.scheduledAt === incoming.scheduledAt && sameResultValue(saved.source, incoming.source)
}

interface StoredIndex extends DigestIndex { readonly clientId: string }

export type DigestAfterCommit = (result: DigestResult) => void!unknown

export interface DigestInbox {
  readonly state: DigestInboxState!!
  step(event: DigestInboxEvent): DigestInboxState!DigestInboxRejected
  history(): DigestResult[]!DigestInboxFailed
  sync(protocol: HostedDigestProtocol, generation: number): DigestResult[]!(DigestInboxFailed | ProtocolError)
  retire(): void!!
}

export effect function digestInbox(scope: string, afterCommit?: DigestAfterCommit) {
  const store = try KeyValueStore.KeyValueStore
  const serial = (try Semaphore.make(1)).withPermits(1)
  const kept = try Ref.make(initial)
  const inbox = try machineOver(() => Ref.get(kept), (next) => Ref.set(kept, next))
  const rowKey = (run: string) => `${scope}:${run}`
  const failed = (reason: string) => new DigestInboxFailed({ reason })

  effect function read<A>(key: string, decode: (value: unknown) => A!WorkflowResponseInvalid): (A | undefined)!DigestInboxFailed {
    const raw = try mapError(store.get(key), () => failed("The digest inbox could not be read"))
    if (raw === undefined) return undefined
    const value = try Effect.try({ try: () => JSON.parse(raw) as unknown, catch: () => failed("A saved digest is unreadable") })
    return try mapError(decode(value), () => failed("A saved digest is unreadable"))
  }

  effect function save(key: string, value: unknown): void!DigestInboxFailed {
    try mapError(store.set(key, JSON.stringify(value)), () => failed("The digest inbox could not be written"))
  }

  effect function write(key: string, value: unknown): void!DigestInboxFailed {
    if ((try inbox.get()).retired) throw failed("The digest inbox was retired")
    try save(key, value)
  }

  effect function decodeIndex(value: unknown): StoredIndex!WorkflowResponseInvalid {
    const v = try object(value)
    const list = (field: unknown) => Array.isArray(field) && field.every((item) => typeof item === "string") ? field as string[] : undefined
    const retained = list(v.retained)
    const noticeDue = list(v.noticeDue)
    const removalDue = list(v.removalDue)
    if (typeof v.clientId !== "string" || retained === undefined || noticeDue === undefined || removalDue === undefined) return try invalid("Invalid digest index")
    return { clientId: v.clientId, retained, noticeDue, removalDue }
  }

  effect function history() {
    const index = try read(scope, decodeIndex)
    if (index === undefined) return []
    const rows: DigestResult[] = []
    for (const run of index.retained) {
      const row = try read(rowKey(run), parseDigestResult)
      if (row !== undefined) rows.push(row)
    }
    return rows
  }

  effect function step(event: Parameters<typeof inbox.send>[0]) {
    return try mapError(inbox.send(event), () => failed("The digest inbox is retired or out of step"))
  }

  effect function settleNotices(index: StoredIndex): StoredIndex!DigestInboxFailed {
    let current = index
    for (const run of index.noticeDue) {
      if (!current.retained.includes(run)) continue
      const saved = try read(rowKey(run), parseDigestResult)
      if (saved === undefined || afterCommit === undefined) continue
      const delivered = (map(afterCommit(saved), () => true) catch () => false)
      if (!delivered) continue
      current = { ...current, noticeDue: current.noticeDue.filter((due) => due !== run) }
      try write(scope, current)
    }
    return current
  }

  effect function recoverJournal(index: StoredIndex, keep: (key: string, value: unknown) => void!DigestInboxFailed): StoredIndex!DigestInboxFailed {
    for (const run of index.removalDue) if (!index.retained.includes(run)) try mapError(store.remove(rowKey(run)), () => failed("A removed digest could not be deleted"))
    const cleared = { ...index, removalDue: [] }
    try keep(scope, cleared)
    return cleared
  }

  effect function storePage(entries: readonly DigestResult[]): SavedDigestRow[]!! {
    const saved: SavedDigestRow[] = []
    for (const entry of entries) {
      const kept = (effect {
        const existing = try read(rowKey(entry.runId), parseDigestResult)
        const verdict = reconcileDigest({
          exists: existing !== undefined, exactValue: existing !== undefined && sameResultValue(existing, entry), exactProvenance: existing !== undefined && sameProvenance(existing, entry),
          savedStatus: digestStatus(existing?.status ?? ""), incomingStatus: digestStatus(entry.status), savedCursor: existing?.cursor ?? 0, incomingCursor: entry.cursor,
        })
        if (verdict === "RefuseConflict") return undefined
        if (verdict === "StoreNew" || verdict === "ReplaceCancelled") try write(rowKey(entry.runId), entry)
        return { digestRun: entry.runId, replaced: verdict === "ReplaceCancelled" }
      } catch () => undefined)
      if (kept === undefined) return saved
      saved.push(kept)
    }
    return saved
  }

  effect function abort(reason: string): never!DigestInboxFailed {
    void (inbox.send({ type: "retireDigestPoll" }) catch () => undefined)
    throw failed(reason)
  }

  effect function interrupted() {
    void (inbox.send({ type: "retireDigestPoll" }) catch () => undefined)
    if ((try inbox.get()).phase === "AwaitingAck") void (inbox.send({ type: "observeDigestAck", exactProviderRow: false, responseSuccessful: false }) catch () => undefined)
  }

  effect function sync(protocol: HostedDigestProtocol, generation: number) {
    return try serial(Effect.onInterrupt(effect {
      let index = (try read(scope, decodeIndex)) ?? { clientId: try workflowUuid(), ...initialDigestIndex }
      if ((try inbox.get()).phase === "ReadyToPoll") try save(scope, index)
      const recovered = (map(recoverJournal(index, save), (next) => { index = next; return true }) catch () => false)
      try step({ type: "beginDigestPoll", generation, client: index.clientId, recoveredAtStart: recovered })
      if (!recovered) throw failed("The removal journal could not be recovered")
      index = (settleNotices(index) catch effect () => try abort("A delivered notice could not be recorded"))
      while ((try inbox.get()).phase === "FetchingPage") {
        const entries = (protocol.results(index.clientId) catch effect (error) => {
          try step({ type: "receiveDigestPage", entries: [], validEnvelope: false })
          throw error
        })
        const rows: DigestPageRow[] = entries.map((entry) => ({ digestRun: entry.runId, cursor: entry.cursor, wireValid: true }))
        const scanned = try step({ type: "receiveDigestPage", entries: rows, validEnvelope: entries.length <= DIGEST_PAGE_LIMIT })
        if (scanned.phase === "PollFinished") break
        if (scanned.phase !== "WritingRows") throw failed("The digest page was out of order or too large")
        const saved = try storePage(entries)
        if ((try step({ type: "observeRows", durablePrefix: saved.length })).phase !== "WritingIndex") throw failed("A digest result changed or could not be kept")
        const plan = planDigestIndex(index, saved)
        const next: StoredIndex = { clientId: index.clientId, ...plan }
        const stored = (map(write(scope, next), () => true) catch () => false)
        const tail = entries[entries.length - 1]
        const committed = try step({ type: "commitDigestIndex", indexCommit: {
          stored, exactPlan: stored, retainedCount: plan.retained.length, tailRetained: plan.retained.includes(tail.runId),
          evictedRuns: plan.removalDue.filter((run) => !plan.retained.includes(run)),
        } })
        if (committed.phase !== "SettlingNotices") throw failed("The digest index could not be kept")
        index = next
        const settled = (map(settleNotices(index), (after) => { index = after; return true }) catch () => false)
        if ((try step({ type: "settleDigestNotices", noticesCanProceed: settled })).phase !== "ReadyToAck") throw failed("A delivered notice could not be recorded")
        try step({ type: "dispatchDigestAck" })
        const acked = (map(protocol.ack(index.clientId, tail), () => true) catch () => false)
        if ((try step({ type: "observeDigestAck", exactProviderRow: acked, responseSuccessful: acked })).phase !== "RecoveringRemoval") {
          throw failed("The server did not confirm the acknowledgement")
        }
        const cleared = (map(recoverJournal(index, write), (after) => { index = after; return true }) catch () => false)
        try step({ type: "recoverDigestJournal", removedAndCleared: cleared })
        if (!cleared) throw failed("The removal journal could not be cleared")
      }
      return try history()
    }, interrupted))
  }

  return {
    history: () => serial(history()),
    sync,
    state: inbox.get(),
    step: (event: Parameters<typeof inbox.send>[0]) => serial(inbox.send(event)),
    effect retire() {
      const phase = (try inbox.get()).phase
      if (phase !== "ReadyToPoll" && phase !== "PollFinished" && phase !== "PollFailed") (inbox.send({ type: "retireDigestPoll" }) catch () => undefined)
    },
  } satisfies DigestInbox
}

export effect function retainedBriefStore() {
  const state = try SubscriptionRef.make<{ readonly scope: string | undefined; readonly brief: RetainedDigestSummary | undefined }>({ scope: undefined, brief: undefined })
  return {
    changes: Stream.map(SubscriptionRef.changes(state), (value) => value.brief),
    current: map(SubscriptionRef.get(state), (value) => value.brief),
    bind: (scope: string | undefined) => SubscriptionRef.update(state, (value) => value.scope === scope ? value : { scope, brief: undefined }),
    remember: (results: readonly DigestResult[] | undefined, options: { readonly agent?: string; readonly scope?: string } = {}) =>
      SubscriptionRef.modify(state, (value) => value.scope !== options.scope ? [false, value] as const
        : [true, { scope: value.scope, brief: results === undefined ? undefined : latestRetainedBrief(results, options.agent) }] as const),
  }
}

export function digestTemplateName(template: DigestTemplate): string {
  return template === "morning" ? "Morning digest" : "Evening brief"
}

export const DIGEST_INBOX_LIMITS = { page: DIGEST_PAGE_LIMIT, retained: DIGEST_RETAINED_RESULTS } as const
