// spec/workflow/generated.md, "Activation needs a passing check and a review of the current source digest"; spec/workflow/worker.md, "Producer, package and installed tree must each prove their own identity"
import { GENERATED_ENGINE_DECLARATION } from "@elizaos/plugin-workflow-client"

export { GENERATED_ENGINE_DECLARATION }
export const GENERATED_SOURCE_MAX_BYTES = 65_536
export const GENERATED_ENGINE_REVISION = "generated-workflow-engine-2"
export const GENERATED_CONTEXT_METHODS: readonly string[] = ["step", "generate", "approval", "signal", "sleep"]


export error CompilerUnavailable { reason: string }

module node {
  import type { CompilerOptions, Node as SyntaxNode } from "typescript"
  export interface GeneratedCall { readonly id: string; readonly method: string }
  export interface GeneratedCheck {
    readonly ok: boolean
    readonly diagnostics: readonly string[]
    readonly js: string
    readonly calls: readonly GeneratedCall[]
    readonly compilerRevision: string
  }

  const hostGlobals = new Set(["globalThis", "window", "self", "global", "process", "require", "module", "exports", "eval", "Function", "Bun", "Deno", "fetch", "WebAssembly", "importScripts", "Reflect", "Proxy"])

  export async function check(source: string, declaration: string, methods: readonly string[], engineRevision: string, maximum: number): Promise<GeneratedCheck> {
    const ts = (await import("typescript")).default
    const compilerRevision = `${engineRevision}+typescript-${ts.version}`
    const refuse = (diagnostics: string[]): GeneratedCheck => ({ ok: false, diagnostics: [...new Set(diagnostics)].slice(0, 10), js: "", calls: [], compilerRevision })
    if (new TextEncoder().encode(source).byteLength > maximum) return refuse([`Workflow source exceeds ${maximum} bytes`])
    const root = "/eliza-workflow"
    const file = `${root}/workflow.ts`
    const ambient = `${root}/engine.d.ts`
    const contract = `${root}/contract.ts`
    const contractText = 'import program from "./workflow"; import type { WorkflowProgram } from "eliza-workflow"; const checked: WorkflowProgram = program; export { checked };'
    const parsed = ts.createSourceFile(file, source, ts.ScriptTarget.ES2022, true, ts.ScriptKind.TS)
    const rejected: string[] = []
    const calls: GeneratedCall[] = []
    if (/@ts-(?:ignore|expect-error|nocheck|check)\b/i.test(source)) rejected.push("TypeScript suppression and directive comments are not supported")
    if (parsed.referencedFiles.length > 0 || parsed.typeReferenceDirectives.length > 0 || parsed.libReferenceDirectives.length > 0 || parsed.hasNoDefaultLib) rejected.push("Source reference directives are not supported")
    const visit = (node: SyntaxNode): void => {
      if ((ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) && node.moduleSpecifier !== undefined) {
        const typeOnly = ts.isImportDeclaration(node) ? node.importClause?.isTypeOnly === true : node.isTypeOnly
        if (!ts.isStringLiteral(node.moduleSpecifier) || node.moduleSpecifier.text !== "eliza-workflow" || !typeOnly) rejected.push("Only type imports from eliza-workflow are supported")
      }
      if (ts.isImportEqualsDeclaration(node) || ts.isImportTypeNode(node) || (ts.isCallExpression(node) && node.expression.kind === ts.SyntaxKind.ImportKeyword)) rejected.push("Dynamic and type-only module loaders are not supported")
      if (ts.isMetaProperty(node)) rejected.push("import.meta is not supported")
      if (ts.isIdentifier(node) && hostGlobals.has(node.text) && !(ts.isPropertyAccessExpression(node.parent) && node.parent.name === node)) rejected.push(`The host global ${node.text} is not available to workflows`)
      if ((ts.isPropertyAccessExpression(node) && (node.name.text === "constructor" || node.name.text === "__proto__" || node.name.text === "prototype"))
        || (ts.isElementAccessExpression(node) && !ts.isNumericLiteral(node.argumentExpression) && !ts.isIdentifier(node.argumentExpression))) {
        rejected.push("Reflective property access is not supported")
      }
      if (ts.isCallExpression(node) && ts.isPropertyAccessExpression(node.expression) && ts.isIdentifier(node.expression.expression) && methods.includes(node.expression.name.text)) {
        const first = node.arguments[0]
        if (first !== undefined && (ts.isStringLiteral(first) || ts.isNoSubstitutionTemplateLiteral(first))) calls.push({ id: first.text, method: node.expression.name.text })
      }
      ts.forEachChild(node, visit)
    }
    visit(parsed)
    if (rejected.length > 0) return refuse(rejected)
    const options: CompilerOptions = {
      target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext, moduleResolution: ts.ModuleResolutionKind.Bundler, strict: true, noEmit: true,
      skipLibCheck: true, types: [], lib: ["lib.es2022.d.ts"], noImplicitAny: true, exactOptionalPropertyTypes: false,
    }
    const virtual = new Map([[file, source], [ambient, declaration], [contract, contractText]])
    const host = ts.createCompilerHost(options)
    const getSourceFile = host.getSourceFile.bind(host)
    const directoryExists = host.directoryExists?.bind(host)
    const fileExists = host.fileExists.bind(host)
    const readFile = host.readFile.bind(host)
    host.getSourceFile = (name, version, onError, shouldCreate) => name === file ? parsed
      : virtual.has(name) ? ts.createSourceFile(name, virtual.get(name) ?? "", version, true) : getSourceFile(name, version, onError, shouldCreate)
    host.directoryExists = (name) => name === root || (directoryExists?.(name) ?? false)
    host.fileExists = (name) => virtual.has(name) || fileExists(name)
    host.readFile = (name) => virtual.get(name) ?? readFile(name)
    const program = ts.createProgram([file, ambient, contract], options, host)
    const errors = ts.getPreEmitDiagnostics(program).filter((diagnostic) => diagnostic.category === ts.DiagnosticCategory.Error)
    if (errors.length > 0) {
      return refuse(errors.map((diagnostic) => {
        const at = diagnostic.file !== undefined && diagnostic.start !== undefined && diagnostic.file.fileName === file ? diagnostic.file.getLineAndCharacterOfPosition(diagnostic.start) : undefined
        return `TS${diagnostic.code}${at === undefined ? "" : ` line ${at.line + 1}`}: ${ts.flattenDiagnosticMessageText(diagnostic.messageText, " ").slice(0, 500)}`
      }))
    }
    const js = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext }, fileName: "workflow.ts" }).outputText
    if (/\bimport\s*\(|\brequire\s*\(|^\s*import\s|\bfrom\s*["']/m.test(js)) return refuse(["The compiled workflow still loads a module"])
    return { ok: true, diagnostics: [], js, calls, compilerRevision }
  }
}
import { check, type GeneratedCheck } from node
export type { GeneratedCall, GeneratedCheck } from node

export effect function checkGeneratedSource(source: string): GeneratedCheck!CompilerUnavailable {
  return try tryPromise({
    try: () => check(source, GENERATED_ENGINE_DECLARATION, GENERATED_CONTEXT_METHODS, GENERATED_ENGINE_REVISION, GENERATED_SOURCE_MAX_BYTES),
    catch: (cause) => new CompilerUnavailable({ reason: String(cause) }),
  })
}
