// spec/network/index.md, "Only the authenticated turn may request a state write or relay"; spec/network/index.md, "A successful Network action requires its own matching receipt"; spec/network/index.md, "Only unseen updates for the bound member appear in the read acknowledgement"
import { networkUpdatesFor, type NetworkUpdate } from "../gen/network.effect.vibe"
import {
  NETWORK_APP_IDS,
  NETWORK_MEMBER_STATES,
  RELAY_PATH,
  SET_STATE_PATH,
  SIGNALS_PATH,
  SVC_ID_HEADER,
  SVC_MAX_SKEW_S,
  SVC_MIN_SECRET,
  SVC_SIG_HEADER,
  SVC_TS_HEADER,
  TURN_PATH,
  TURN_RECEIPT_PATH,
  UPDATES_PATH,
  type NetworkAppId,
  type NetworkMemberContext,
  type NetworkRouteAuthority,
  type NetworkSignal,
  type NetworkStore,
  type NetworkStoreTurnAuthority,
  type ReadUpdatesInput,
  type ReadUpdatesResult,
  type RecordSignalsInput,
  type RecordSignalsResult,
  type RelayInput,
  type RelayResult,
  type RelaySendRequest,
  type RelaySendResponse,
  type SetStateInput,
  type SetStateRequest,
  type SetStateResponse,
  type SetStateResult,
  type SignalsRequest,
  type SignalsResponse,
  type SvcVerify,
  type TurnContextWire,
  type TurnReceiptRequest,
  type TurnReceiptResponse,
  type TurnRequest,
  type TurnResponse,
  type UpdatesRequest,
  type UpdatesResponse,
} from "./types.vibe"

module node {
  import { createHash, createHmac } from "node:crypto"

  export function sha256HexSync(body: string): string {
    return createHash("sha256").update(body).digest("hex")
  }

  export function hmacSha256HexSync(secret: string, canonical: string): string {
    return createHmac("sha256", secret).update(canonical).digest("hex")
  }

  export async function boundedJsonPost(input: {
    readonly url: string
    readonly headers: Record<string, string>
    readonly body: string
    readonly timeoutMs: number
    readonly maxResponseBytes: number
    readonly fetchImpl?: typeof fetch
  }): Promise<{ readonly status: number; readonly ok: boolean; readonly text: string }> {
    const fn = input.fetchImpl ?? globalThis.fetch
    const response = await fn(input.url, {
      method: "POST",
      redirect: "manual",
      headers: input.headers,
      body: input.body,
      signal: AbortSignal.timeout(input.timeoutMs),
    })
    const buffer = await response.arrayBuffer()
    if (buffer.byteLength > input.maxResponseBytes) {
      return { status: -1, ok: false, text: "Network service response exceeds body limit" }
    }
    return {
      status: response.status,
      ok: response.ok,
      text: new TextDecoder().decode(buffer),
    }
  }
}

import { boundedJsonPost, hmacSha256HexSync, sha256HexSync } from node

export async function svcCanonical(
  method: string,
  path: string,
  ts: number,
  id: string,
  body: string,
): Promise<string> {
  return `${method.toUpperCase()}\n${path}\n${ts}\n${id}\n${sha256HexSync(body)}`
}

export async function svcSign(
  secret: string | undefined,
  req: {
    readonly method: string
    readonly path: string
    readonly id: string
    readonly body: string
    readonly nowS?: number
  },
): Promise<Record<string, string>> {
  if (!secret || secret.length < SVC_MIN_SECRET) {
    return Promise.reject(
      new Error(`SERVICE_TURN_SECRET missing or shorter than ${SVC_MIN_SECRET} characters`),
    )
  }
  const ts = req.nowS ?? Math.floor(Date.now() / 1000)
  const canonical = await svcCanonical(req.method, req.path, ts, req.id, req.body)
  const sig = hmacSha256HexSync(secret, canonical)
  return {
    [SVC_TS_HEADER]: String(ts),
    [SVC_ID_HEADER]: req.id,
    [SVC_SIG_HEADER]: sig,
  }
}

export async function svcVerify(
  secret: string | undefined,
  req: {
    readonly method: string
    readonly path: string
    readonly headers: { get(name: string): string | null }
    readonly body: string
    readonly nowS?: number
  },
): Promise<SvcVerify> {
  if (!secret || secret.length < SVC_MIN_SECRET) return { ok: false, reason: "no_secret" }
  const ts = Number(req.headers.get(SVC_TS_HEADER))
  const id = req.headers.get(SVC_ID_HEADER)
  const sig = req.headers.get(SVC_SIG_HEADER)
  if (!Number.isFinite(ts) || !id || !sig) return { ok: false, reason: "missing" }
  const now = req.nowS ?? Math.floor(Date.now() / 1000)
  if (Math.abs(now - ts) > SVC_MAX_SKEW_S) return { ok: false, reason: "stale" }
  const want = hmacSha256HexSync(secret, await svcCanonical(req.method, req.path, ts, id, req.body))
  if (want.length !== sig.length) return { ok: false, reason: "bad_signature" }
  let diff = 0
  for (let i = 0; i < want.length; i += 1) {
    diff |= want.charCodeAt(i) ^ sig.charCodeAt(i)
  }
  return diff === 0 ? { ok: true, id } : { ok: false, reason: "bad_signature" }
}

const NETWORK_APPS = new Set<string>(NETWORK_APP_IDS)
const MEMBER_STATES = new Set<string>(NETWORK_MEMBER_STATES)

function isRecord(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === "object" && !Array.isArray(value)
}

function isStringOrNull(value: unknown): value is string | null {
  return value === null || typeof value === "string"
}

function isNetworkApp(value: unknown): value is NetworkAppId {
  return typeof value === "string" && NETWORK_APPS.has(value)
}

function isTurnContext(value: unknown): value is TurnContextWire {
  if (!isRecord(value)) return false
  if (
    !isStringOrNull(value.firstName) ||
    !isStringOrNull(value.city) ||
    typeof value.state !== "string" ||
    !MEMBER_STATES.has(value.state) ||
    !isStringOrNull(value.stateFrom) ||
    !isStringOrNull(value.stateUntil) ||
    !Array.isArray(value.facets) ||
    !value.facets.every((facet) => typeof facet === "string") ||
    typeof value.singlePlayer !== "boolean"
  ) {
    return false
  }
  return (
    value.activeItems === null ||
    (Array.isArray(value.activeItems) &&
      value.activeItems.every(
        (item) =>
          isRecord(item) &&
          typeof item.id === "string" &&
          typeof item.kind === "string" &&
          typeof item.summary === "string",
      ))
  )
}

function isConsent(value: unknown): boolean {
  return (
    isRecord(value) &&
    (value.state === "opted_out" || value.state === "opted_in") &&
    (value.scope === "all" || value.scope === "app") &&
    (value.app === null || isNetworkApp(value.app)) &&
    Number.isSafeInteger(value.at)
  )
}

function isTurnResponse(value: unknown): value is TurnResponse {
  if (!isRecord(value)) return false
  if (value.outcome === "ignored") return typeof value.reason === "string"
  if (value.outcome === "open") {
    return (
      (value.channel === "blooio" || value.channel === "twilio") &&
      isNetworkApp(value.app) &&
      typeof value.memberId === "string" &&
      isTurnContext(value.context)
    )
  }
  if (value.outcome !== "handled") return false
  return (
    Array.isArray(value.replies) &&
    value.replies.every((reply) => typeof reply === "string") &&
    Array.isArray(value.replyIds) &&
    value.replyIds.every((id) => typeof id === "string") &&
    value.delivery === "collected" &&
    (value.replyKind === "reply" || value.replyKind === "compliance") &&
    typeof value.accountEligible === "boolean" &&
    (value.app === null || isNetworkApp(value.app)) &&
    isStringOrNull(value.memberId) &&
    typeof value.reason === "string" &&
    (value.consent === undefined || isConsent(value.consent))
  )
}

export error NetworkServiceError {
  status: number
  message: string
}

export interface NetworkServiceClientOptions {
  readonly baseUrl: string
  readonly secret: string
  readonly fetch?: typeof fetch
  readonly timeoutMs?: number
}

export class NetworkServiceClient {
  readonly #baseUrl: string
  readonly #secret: string
  readonly #timeoutMs: number
  readonly #fetch: typeof fetch | undefined

  constructor(options: NetworkServiceClientOptions) {
    this.#baseUrl = options.baseUrl.replace(/\/+$/u, "")
    this.#secret = options.secret
    this.#timeoutMs = options.timeoutMs ?? 8_000
    this.#fetch = options.fetch
  }

  async #post(path: string, id: string, payload: unknown): Promise<unknown> {
    const body = JSON.stringify(payload)
    const headers = await svcSign(this.#secret, { method: "POST", path, id, body })
    const res = await boundedJsonPost({
      url: `${this.#baseUrl}${path}`,
      headers: { "content-type": "application/json", ...headers },
      body,
      timeoutMs: this.#timeoutMs,
      maxResponseBytes: 4 * 1024 * 1024,
      ...(this.#fetch !== undefined ? { fetchImpl: this.#fetch } : {}),
    })
    if (res.status === -1) {
      return Promise.reject(new NetworkServiceError({ status: 0, message: res.text }))
    }
    if (!res.ok) {
      return Promise.reject(
        new NetworkServiceError({ status: res.status, message: `${path} -> ${res.status}` }),
      )
    }
    try {
      return JSON.parse(res.text) as unknown
    } catch {
      return Promise.reject(
        new NetworkServiceError({
          status: res.status,
          message: "Network service returned invalid JSON",
        }),
      )
    }
  }

  async turn(req: TurnRequest): Promise<TurnResponse> {
    const result = await this.#post(TURN_PATH, req.messageId, req)
    if (!isTurnResponse(result)) {
      return Promise.reject(
        new NetworkServiceError({
          status: 200,
          message: "Network service returned an invalid turn response",
        }),
      )
    }
    return result
  }

  async turnReceipt(req: TurnReceiptRequest): Promise<TurnReceiptResponse> {
    const result = await this.#post(TURN_RECEIPT_PATH, `${req.messageId}:receipt`, req)
    if (!isRecord(result) || result.ok !== true || typeof result.replayed !== "boolean") {
      return Promise.reject(
        new NetworkServiceError({
          status: 200,
          message: "Network service returned an invalid turn receipt",
        }),
      )
    }
    return result as unknown as TurnReceiptResponse
  }

  async setState(req: SetStateRequest): Promise<SetStateResponse> {
    const result = await this.#post(SET_STATE_PATH, req.idempotencyKey, req)
    if (
      !isRecord(result) ||
      !isStringOrNull(result.eventId) ||
      typeof result.previous !== "string" ||
      !MEMBER_STATES.has(result.previous) ||
      typeof result.current !== "string" ||
      !MEMBER_STATES.has(result.current) ||
      result.current !== req.state ||
      !isStringOrNull(result.from) ||
      !isStringOrNull(result.until) ||
      typeof result.committedAt !== "string" ||
      !Number.isFinite(Date.parse(result.committedAt)) ||
      typeof result.replayed !== "boolean" ||
      typeof result.unchanged !== "boolean" ||
      (!result.unchanged && (typeof result.eventId !== "string" || !result.eventId.trim()))
    ) {
      return Promise.reject(
        new NetworkServiceError({
          status: 200,
          message: "Network service returned an invalid state commit receipt",
        }),
      )
    }
    return result as unknown as SetStateResponse
  }

  async recordSignals(req: SignalsRequest): Promise<SignalsResponse> {
    const result = await this.#post(SIGNALS_PATH, `${req.messageId}:signals`, req)
    if (
      !isRecord(result) ||
      typeof result.recorded !== "number" ||
      !Number.isSafeInteger(result.recorded) ||
      result.recorded < 0 ||
      result.recorded > req.signals.length
    ) {
      return Promise.reject(
        new NetworkServiceError({
          status: 200,
          message: "Network service returned an invalid signals receipt",
        }),
      )
    }
    return result as unknown as SignalsResponse
  }

  async readUpdates(req: UpdatesRequest): Promise<UpdatesResponse> {
    const result = await this.#post(UPDATES_PATH, `${req.messageId}:updates`, req)
    if (
      !isRecord(result) ||
      !Array.isArray(result.items) ||
      result.items.some((item) => !isRecord(item) || typeof item.summary !== "string")
    ) {
      return Promise.reject(
        new NetworkServiceError({
          status: 200,
          message: "Network service returned invalid member updates",
        }),
      )
    }
    return result as unknown as UpdatesResponse
  }

  async relay(req: RelaySendRequest): Promise<RelaySendResponse> {
    const result = await this.#post(RELAY_PATH, `${req.messageId}:relay`, req)
    if (
      !isRecord(result) ||
      (result.decision !== "pass" &&
        result.decision !== "hold" &&
        result.decision !== "block" &&
        result.decision !== "none") ||
      typeof result.senderNotice !== "string" ||
      typeof result.delivered !== "boolean" ||
      typeof result.replayed !== "boolean" ||
      (result.delivered && result.decision !== "pass")
    ) {
      return Promise.reject(
        new NetworkServiceError({
          status: 200,
          message: "Network service returned an invalid relay receipt",
        }),
      )
    }
    return result as unknown as RelaySendResponse
  }
}

export interface ServiceNetworkStoreOptions {
  readonly client: NetworkServiceClient
  readonly memberId: string
  readonly app: NetworkAppId
  readonly channel: "blooio" | "twilio"
  readonly context: TurnContextWire
  readonly networkAuthority?: NetworkRouteAuthority
}

export function createServiceNetworkStore(options: ServiceNetworkStoreOptions): NetworkStore {
  let memberState = options.context.state
  let stateFrom = options.context.stateFrom
  let stateUntil = options.context.stateUntil

  return {
    getMemberContext: async (memberId: string): Promise<NetworkMemberContext | null> => {
      if (memberId !== options.memberId) return null
      return {
        memberId: options.memberId,
        firstName: options.context.firstName ?? "Member",
        city: options.context.city ?? "",
        state: memberState,
        stateFrom,
        stateUntil,
        facets: [...options.context.facets],
        activeItems: options.context.activeItems === null ? null : [...options.context.activeItems],
        singlePlayer: options.context.singlePlayer,
      }
    },
    setState: async (input: SetStateInput): Promise<SetStateResult> => {
      const receipt = await options.client.setState({
        memberId: options.memberId,
        app: options.app,
        channel: options.channel,
        messageId: input.messageId,
        idempotencyKey: input.idempotencyKey,
        state: input.state,
        from: input.from,
        until: input.until,
        note: input.note ?? null,
        ...(options.networkAuthority !== undefined
          ? { networkAuthority: options.networkAuthority }
          : {}),
      })
      memberState = receipt.current
      stateFrom = receipt.from
      stateUntil = receipt.until
      return receipt
    },
    recordSignals: async (input: RecordSignalsInput): Promise<RecordSignalsResult> =>
      options.client.recordSignals({
        memberId: options.memberId,
        app: options.app,
        channel: options.channel,
        messageId: input.messageId,
        signals: input.signals,
        ...(options.networkAuthority !== undefined
          ? { networkAuthority: options.networkAuthority }
          : {}),
      }),
    readUpdates: async (input: ReadUpdatesInput): Promise<ReadUpdatesResult> =>
      options.client.readUpdates({
        memberId: options.memberId,
        app: options.app,
        channel: options.channel,
        messageId: input.messageId,
        ...(options.networkAuthority !== undefined
          ? { networkAuthority: options.networkAuthority }
          : {}),
      }),
    relay: async (input: RelayInput): Promise<RelayResult> =>
      options.client.relay({
        memberId: options.memberId,
        app: options.app,
        channel: options.channel,
        messageId: input.messageId,
        itemId: input.itemId,
        text: input.text,
        ...(options.networkAuthority !== undefined
          ? { networkAuthority: options.networkAuthority }
          : {}),
      }),
  }
}

export function parseServiceTurn(
  response: TurnResponse,
  options: {
    readonly client: NetworkServiceClient
    readonly messageId: string
    readonly text?: string
    readonly networkAuthority?: NetworkRouteAuthority
  },
): { readonly authority: NetworkStoreTurnAuthority; readonly store: NetworkStore } | null {
  if (response.outcome !== "open") return null
  const store = createServiceNetworkStore({
    client: options.client,
    memberId: response.memberId,
    app: response.app,
    channel: response.channel,
    context: response.context,
    ...(options.networkAuthority !== undefined ? { networkAuthority: options.networkAuthority } : {}),
  })
  const authority: NetworkStoreTurnAuthority = {
    memberId: response.memberId,
    messageId: options.messageId,
    app: response.app,
    channel: response.channel,
    ...(options.text !== undefined ? { text: options.text } : {}),
    singlePlayer: response.context.singlePlayer,
    ...(options.networkAuthority !== undefined ? { route: options.networkAuthority } : {}),
  }
  return { authority, store }
}

export class InMemoryNetworkStore implements NetworkStore {
  readonly #members = new Map<string, NetworkMemberContext>()
  readonly #stateReceipts = new Map<string, SetStateResult>()
  readonly #relayReceipts = new Map<string, RelayResult>()
  readonly #updates: NetworkUpdate[] = []
  readonly recordedSignals: Array<RecordSignalsInput> = []
  readonly relayedMessages: Array<RelayInput> = []
  #eventSeq = 0

  constructor(initialMembers: readonly NetworkMemberContext[] = []) {
    for (const member of initialMembers) {
      this.#members.set(member.memberId, { ...member, facets: [...member.facets] })
    }
  }

  seedMember(member: NetworkMemberContext): void {
    this.#members.set(member.memberId, { ...member, facets: [...member.facets] })
  }

  addUpdate(update: NetworkUpdate): void {
    this.#updates.push({ ...update })
  }

  async getMemberContext(memberId: string): Promise<NetworkMemberContext | null> {
    const member = this.#members.get(memberId)
    return member !== undefined ? { ...member } : null
  }

  async setState(input: SetStateInput): Promise<SetStateResult> {
    const cached = this.#stateReceipts.get(input.idempotencyKey)
    if (cached !== undefined) {
      return { ...cached, replayed: true }
    }
    const existing = this.#members.get(input.memberId)
    const previous = existing?.state ?? "open"
    const unchanged =
      existing !== undefined &&
      existing.state === input.state &&
      (existing.stateFrom ?? null) === input.from &&
      existing.stateUntil === input.until
    let eventId: string | null = null
    if (!unchanged) {
      this.#eventSeq += 1
      eventId = `evt-${this.#eventSeq}`
      if (existing !== undefined) {
        this.#members.set(input.memberId, {
          ...existing,
          state: input.state,
          stateFrom: input.from,
          stateUntil: input.until,
        })
      }
    }
    const receipt: SetStateResult = {
      eventId,
      previous,
      current: input.state,
      from: input.from,
      until: input.until,
      committedAt: new Date().toISOString(),
      replayed: false,
      unchanged,
    }
    this.#stateReceipts.set(input.idempotencyKey, receipt)
    return receipt
  }

  async recordSignals(input: RecordSignalsInput): Promise<RecordSignalsResult> {
    const copy: readonly NetworkSignal[] = input.signals.map((s) => ({ ...s }))
    this.recordedSignals.push({ ...input, signals: copy })
    return { recorded: copy.length }
  }

  async readUpdates(input: ReadUpdatesInput): Promise<ReadUpdatesResult> {
    const unseen = networkUpdatesFor(input.memberId, this.#updates)
    const unseenIds = new Set(unseen.map((u) => u.updateId))
    for (let i = 0; i < this.#updates.length; i += 1) {
      const item = this.#updates[i]
      if (item !== undefined && item.forMember === input.memberId && unseenIds.has(item.updateId)) {
        this.#updates[i] = { ...item, seen: true }
      }
    }
    return { items: unseen.map((item) => ({ id: item.updateId, summary: item.summary })) }
  }

  async relay(input: RelayInput): Promise<RelayResult> {
    const cached = this.#relayReceipts.get(input.messageId)
    if (cached !== undefined) {
      return { ...cached, replayed: true }
    }
    this.relayedMessages.push({ ...input })
    const result: RelayResult = {
      decision: "pass",
      senderNotice: "Passed on.",
      delivered: true,
      replayed: false,
    }
    this.#relayReceipts.set(input.messageId, result)
    return result
  }
}
