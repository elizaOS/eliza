// spec/network/index.md, "Only the authenticated turn may request a state write or relay"; spec/network/index.md, "A successful Network action requires its own matching receipt"
import { assert, makeMethods } from "@effect/vitest"
import { test } from "vitest"
import { FetchHttpClient } from "effect/http"
import { TestClock } from "effect/testing"
import { postNetwork } from "../src/index.vibe"

const it = makeMethods(test)
const relayTestUrl = import.meta.url

module node {
  import { spawn } from "node:child_process"
  import { once } from "node:events"
  import { createServer } from "node:net"
  import { fileURLToPath } from "node:url"

  export async function startMockoon(signal: AbortSignal, moduleUrl: string): Promise<{ baseUrl: string; stop(): Promise<void> }> {
    const server = createServer()
    server.listen(0, "127.0.0.1")
    await once(server, "listening", { signal })
    const address = server.address()
    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()))
    if (address === null || typeof address === "string") throw new Error("Could not reserve a loopback fixture port")
    const fixture = fileURLToPath(new URL("./fixtures/network.mockoon.json", moduleUrl))
    const child = spawn("mockoon-cli", ["start", "--data", fixture, "--port", String(address.port), "--hostname", "127.0.0.1", "--disable-admin-api"], { signal, stdio: ["ignore", "pipe", "pipe"] })
    const close = new Promise<void>(resolve => child.once("close", () => resolve()))
    let log = ""
    child.stderr.on("data", chunk => { log += String(chunk) })
    const stop = async () => { if (child.exitCode === null) child.kill(); await close }
    try {
      await new Promise<void>((resolve, reject) => {
        child.stdout.on("data", chunk => {
          log += String(chunk)
          if (/server started|server listening|listening on/i.test(log)) resolve()
        })
        child.once("error", reject)
        child.once("close", code => reject(new Error(`Mockoon exited (${code}): ${log}`)))
      })
      return { baseUrl: `http://127.0.0.1:${address.port}`, stop }
    } catch (error) { await stop(); throw error }
  }
}
import { startMockoon } from node

it.effect("A valid Network relay receives a receipt and an altered retry is refused (spec/network/index.md, \"A successful Network action requires its own matching receipt\")", () => scoped(effect {
  try TestClock.setTime(1700000000000)
  const fixture = try acquireRelease(tryPromise(signal => startMockoon(signal, relayTestUrl)), fixture => promise(() => fixture.stop()))
  const transport = { baseUrl: fixture.baseUrl, secret: Redacted.make("network-local-fixture-secret-32-bytes") }
  const payload = { memberId: "local-member", app: "ntwrk", channel: "blooio", messageId: "local-msg-1", itemId: "match-1", text: "Tell Sam I am running late." }
  provide FetchHttpClient.layer {
    const first = try postNetwork(transport, "/internal/relay", payload.messageId, payload)
    const changed = postNetwork(transport, "/internal/relay", payload.messageId, { ...payload, itemId: "different-target" }) catch error => error.status
    const retry = try postNetwork(transport, "/internal/relay", payload.messageId, payload)
    try Effect.try(() => assert.deepStrictEqual({ first, changed, retry }, { first: { decision: "pass", senderNotice: "Passed on.", delivered: true, replayed: false }, changed: 401, retry: first }))
  }
}), 20_000)
