// spec/notes/read.md, "Story: Search private notes and share only what I select"
import { assert, it } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { NotesReadRefused, selectedNotes, type NotesAuthority, type NotesClaim, type NotesOwner, type NotesReadOperation,
  type NotesReadPorts, type NotesTarget } from "../src/selected-read.vibe"

const collection = "11111111-1111-4111-8111-111111111111"
const target: NotesTarget = { sourceId: collection, sourceRevision: "1265a4d998c8f7f4765ebbc9b2eb385d6a052a89cc85985d63548f158ccc4ea4",
  noteId: "one", revision: "6f1ad1d8b56dd18f1e742e31b7e1942c35ba33312273f54aeebb1be8273c880c" }
const alice: NotesOwner = { ownerId: "alice", agentId: "agent", installationId: "installation", enrollmentId: "enrollment",
  origin: "https://local.example", scope: "private-notes" }
const proposal = { proposalId: "proposal", operationId: "operation", digest: "exact", owner: alice }
const claim: NotesClaim = { proposalId: proposal.proposalId, operationId: proposal.operationId, attemptId: 11 }
const one = { id: "one", kind: "text", title: "Work Ｐlan", body: "Reviewed body", createdAt: 100, updatedAt: 300 }
const two = { id: "two", kind: "voice", title: "Work plan upstairs", body: "Unselected body", createdAt: 100, updatedAt: 150,
  format: { kind: "voice", data: { recordingHandle: "secret-local-recording" } } }
const title = { type: "notes_query", query: { kind: "title", text: " ＰＬＡＮ " } } as const
const latest = { type: "notes_query", query: { kind: "latest", by: "created" } } as const
const direct: NotesReadOperation = { type: "notes_read_selected", target }
const missing = { type: "notes_query", query: { kind: "title", text: "absent" } } as const

const refused = <A>(plan: A!NotesReadRefused) => map(Effect.flip(plan), (error) => error.code)
const record = { version: 1, kind: "notes_read_selected", sourceId: collection, noteId: "one", revision: target.revision,
  fields: { title: one.title, body: one.body } } as const

effect function vaultFixture() {
  const files = try FileSystem.FileSystem
  const root = try files.makeTempDirectoryScoped({ prefix: "selected-notes-" })
  const path = try Path.Path
  const ownFile = path.join(root, "alice.committed")
  const otherFile = path.join(root, "bob.committed")
  const controls: {
    authority: NotesAuthority
    confirmed: boolean
    claimLive: boolean
    chose: string | undefined
    offered: ReadonlyArray<unknown>
    reviewed: unknown
    afterRead?: () => void
  } = {
    authority: { ...proposal, owner: alice, viewRevision: 1, view: "notes", foreground: true, permitted: true, selected: target },
    confirmed: true, claimLive: true, chose: "one", offered: [], reviewed: undefined,
  }
  effect function write(revision: string, records: readonly unknown[], file = ownFile) {
    const raw = JSON.stringify({ version: 2, collectionId: collection, records, deleted: [] })
    try files.writeFileString(file, JSON.stringify({ revision, raw }))
  }
  try write("original", [two, one])
  try write("foreign", [{ ...one, id: "foreign", body: "Foreign account body" }], otherFile)
  schema Envelope { revision: string; raw: string }
  const ports: NotesReadPorts = {
    current: () => controls.authority,
    effect readCommitted(owner) {
      if (owner.scope !== "private-notes") throw new NotesReadRefused({ code: "unavailable" })
      const file = owner.ownerId === "alice" ? ownFile : owner.ownerId === "bob" ? otherFile : undefined
      if (file === undefined) return undefined
      const input = try mapError(files.readFileString(file), () => new NotesReadRefused({ code: "unavailable" }))
      const snapshot = try mapError(Schema.decodeUnknownEffect(Schema.fromJsonString(Envelope))(input), () => new NotesReadRefused({ code: "unavailable" }))
      controls.afterRead?.()
      return snapshot
    },
    effect choose(choices) {
      controls.offered = choices
      return controls.chose
    },
    effect review(preview) {
      controls.reviewed = preview
      return controls.confirmed
    },
    hasClaim: (request, call) => request.digest === proposal.digest && call.attemptId === claim.attemptId && controls.claimLive,
  }
  return { local: try selectedNotes(ports), controls, write, remove: () => files.remove(ownFile) }
}

it.effect('Select and review a current local note and share its exact receipt (spec/notes/read.md, "Story: Search private notes and share only what I select"; spec/notes/read.md, "A query receipt carries the original query, an allowed basis and a record only on a match")', effect () => {
  provide NodeServices.layer {
    const { local, controls, write } = try vaultFixture()
    const selected = try local.prepare(title, proposal)
    assert.deepEqual(controls.offered, [{ id: "two", title: two.title }, { id: "one", title: one.title }])
    assert.deepEqual(controls.reviewed, { target, fields: record.fields })
    assert.deepEqual(try selected.execute(claim), { version: 1, kind: "notes_query", query: title.query, basis: "title-match", target, record })
    assert.equal(try refused(selected.execute(claim)), "not_current")
    assert.deepEqual(try (try local.prepare(direct, proposal)).execute(claim), record)
    assert.deepEqual(try (try local.prepare(latest, proposal)).execute(claim),
      { version: 1, kind: "notes_query", query: latest.query, basis: "owner-choice-uncertain", target, record })
    const updated = { type: "notes_query", query: { kind: "latest", by: "updated" } } as const
    assert.deepEqual(try (try local.prepare(updated, proposal)).execute(claim),
      { version: 1, kind: "notes_query", query: updated.query, basis: "latest-updated", target, record })
    try write("legacy-dates", [two, { ...one, createdAt: "2026-02-31T10:12:30Z" }])
    const uncertain = try (try local.prepare(latest, proposal)).execute(claim)
    assert.equal(uncertain.kind === "notes_query" && uncertain.basis, "owner-choice-uncertain")
    try write("sole-note", [one])
    const only = try (try local.prepare(latest, proposal)).execute(claim)
    assert.equal(only.kind === "notes_query" && only.basis, "only-note")
    assert.deepEqual(try (try local.prepare(missing, proposal)).execute(claim),
      { version: 1, kind: "notes_query", query: missing.query, basis: "no-match" })
  }
})

it.effect('Decline publication after cancellation, authority drift or a changed committed note (spec/notes/read.md, "Story: Search private notes and share only what I select"; spec/notes/read.md, "Wire and authored content have different boundaries")', effect () => {
  provide NodeServices.layer {
    const { local, controls, write, remove } = try vaultFixture()
    const held = controls.authority
    const approved = try local.prepare(title, proposal)
    const wrongScope = { ...alice, scope: "another-scope" }
    controls.authority = { ...held, owner: wrongScope }
    assert.equal(try refused(approved.execute(claim)), "not_current")
    controls.authority = { ...held, owner: { ...alice, ownerId: "bob" } }
    assert.equal(try refused(local.prepare(title, proposal)), "not_current")
    controls.authority = held
    const previous = try local.prepare(direct, proposal)
    const replacement = try local.prepare(direct, proposal)
    assert.equal(try refused(previous.execute(claim)), "not_current")
    controls.afterRead = () => { controls.authority = { ...held, owner: { ...alice, ownerId: "bob" } } }
    assert.equal(try refused(replacement.execute(claim)), "not_current")
    controls.afterRead = undefined
    controls.authority = held
    const changed = try local.prepare(direct, proposal)
    try write("original", [two, { ...one, body: "Changed after review" }])
    assert.equal(try refused(changed.execute(claim)), "source_changed")
    assert.equal(try refused(local.prepare(direct, proposal)), "source_changed")
    try write("other-revision", [two, one])
    const empty = try local.prepare(missing, proposal)
    controls.afterRead = () => { controls.claimLive = false }
    assert.equal(try refused(empty.execute(claim)), "not_current")
    controls.afterRead = undefined
    controls.claimLive = true
    controls.confirmed = false
    assert.equal(try refused(local.prepare(direct, proposal)), "cancelled")
    controls.confirmed = true
    const revoked = try local.prepare(direct, proposal)
    controls.authority = { ...held, permitted: false, view: "sensitive", viewRevision: 2, foreground: false }
    assert.equal(try refused(revoked.execute(claim)), "not_current")
    controls.authority = { ...held, viewRevision: 3 }
    assert.equal(try refused(revoked.execute(claim)), "not_current")
    controls.chose = "two"
    try write("checklist", [one, { ...two, kind: "list" }])
    assert.equal(try refused(local.prepare(title, proposal)), "not_shareable")
    try write("over-wire-budget", [{ ...one, body: "界".repeat(25_000) }])
    assert.equal(try refused(local.prepare(title, proposal)), "oversize")
    try remove()
    assert.equal(try refused(local.prepare(missing, proposal)), "unavailable")
  }
})
