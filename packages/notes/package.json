{
  "name": "@elizaos/plugin-notes",
  "version": "4.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Notes, their folders, Trash and recorded audio custody, changed only on the owner's words.",
  "license": "MIT",
  "publishConfig": {
    "exports": {
      "./selected-read": {
        "types": "./dist/src/selected-read.d.ts",
        "import": "./dist/src/selected-read.js",
        "default": "./dist/src/selected-read.js"
      }
    }
  },
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@elizaos/agent": "workspace:*",
    "@elizaos/core": "workspace:*",
    "effect": "4.1.1",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibestack": "workspace:*",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "eliza-source": "./src/agent.vibe",
      "types": "./dist/src/agent.d.ts",
      "import": "./dist/src/agent.js",
      "default": "./dist/src/agent.js"
    },
    "./client": {
      "eliza-source": "./src/client.vibe",
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js",
      "default": "./dist/src/client.js"
    },
    "./format": {
      "eliza-source": "./src/format.vibe",
      "types": "./dist/src/format.d.ts",
      "import": "./dist/src/format.js",
      "default": "./dist/src/format.js"
    },
    "./types": {
      "eliza-source": "./src/types.vibe",
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    },
    "./organize": {
      "eliza-source": "./src/organize.vibe",
      "types": "./dist/src/organize.d.ts",
      "import": "./dist/src/organize.js",
      "default": "./dist/src/organize.js"
    },
    "./selected-read": {
      "eliza-source": "./src/selected-read.vibe",
      "types": "./dist/src/selected-read.d.ts",
      "import": "./dist/src/selected-read.js",
      "default": "./dist/src/selected-read.js"
    },
    "./package.json": "./package.json"
  }
}
