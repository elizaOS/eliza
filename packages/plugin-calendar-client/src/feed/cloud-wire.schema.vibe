// spec/calendar/managedFeed.md, "The resident accepts only a whole Cloud answer for the exact selected calendar"
import { sampledWireInstant } from "../availability/availability.schema.vibe"

const NonBlank = Schema.String.check(Schema.isPattern(/\S/))
const NullableNonBlank = Schema.NullOr(NonBlank)
const Instant = sampledWireInstant(NonBlank.check(Schema.makeFilter((value) => Number.isFinite(Date.parse(value)))))

export const ManagedGoogleCalendar = Schema.Struct({
  calendarId: NonBlank,
  summary: NonBlank,
  description: NullableNonBlank,
  primary: Schema.Boolean,
  accessRole: NonBlank,
  backgroundColor: NullableNonBlank,
  foregroundColor: NullableNonBlank,
  timeZone: NullableNonBlank,
  selected: Schema.Boolean,
})

export const ManagedGoogleAccount = Schema.Struct({
  connected: Schema.Boolean,
  connectionId: NullableNonBlank,
  grantedCapabilities: Schema.Array(Schema.String),
})

export const ManagedGoogleCalendarRow = Schema.Struct({
  calendarId: NonBlank,
  accountId: NonBlank,
  accountEmail: Schema.String,
  label: Schema.String,
  accessRole: NonBlank,
  read: Schema.Boolean,
  write: Schema.Boolean,
  recurrenceLines: Schema.optionalKey(Schema.Literal(true)),
  privateCreate: Schema.optionalKey(Schema.Literal(true)),
})

export const ManagedGoogleAttendee = Schema.Struct({
  email: NullableNonBlank,
  displayName: NullableNonBlank,
  responseStatus: NullableNonBlank,
  self: Schema.Boolean,
  organizer: Schema.Boolean,
  optional: Schema.Boolean,
})

export const ManagedGoogleEvent = Schema.Struct({
  externalId: NonBlank,
  calendarId: NonBlank,
  title: Schema.String,
  description: Schema.String,
  location: Schema.String,
  status: NonBlank,
  startAt: Instant,
  endAt: Instant,
  isAllDay: Schema.Boolean,
  timezone: NullableNonBlank,
  htmlLink: NullableNonBlank,
  conferenceLink: NullableNonBlank,
  organizer: Schema.NullOr(Schema.Record(Schema.String, Schema.Unknown)),
  metadata: Schema.Record(Schema.String, Schema.Unknown),
  attendees: Schema.Array(ManagedGoogleAttendee),
  etag: Schema.optionalKey(NullableNonBlank),
  seriesId: Schema.optionalKey(NullableNonBlank),
  recurrence: Schema.optionalKey(Schema.Array(NonBlank)),
})

export const ManagedGoogleEventAnswer = Schema.Struct({ event: ManagedGoogleEvent })

export const ManagedGoogleRefusal = Schema.Struct({
  error: NonBlank,
  retryable: Schema.Boolean,
  outcome: Schema.optionalKey(Schema.String),
})

export const ManagedGoogleFeed = Schema.Struct({
  calendarId: NonBlank,
  events: Schema.Array(ManagedGoogleEvent),
  syncedAt: Instant,
  nextPageToken: Schema.optionalKey(Schema.Null),
  truncated: Schema.optionalKey(Schema.Literal(false)),
})

export type ManagedGoogleCalendar = typeof ManagedGoogleCalendar.Type

export type ManagedGoogleAccount = typeof ManagedGoogleAccount.Type

export type ManagedGoogleCalendarRow = typeof ManagedGoogleCalendarRow.Type

export type ManagedGoogleEvent = typeof ManagedGoogleEvent.Type

export interface ManagedGoogleCalendarFeed {
  readonly calendarId: string
  readonly events: readonly ManagedGoogleEvent[]
  readonly syncedAt: string
}

export error ManagedGoogleWireInvalid

const decodeCalendars = Schema.decodeUnknownEffect(Schema.Array(ManagedGoogleCalendar))
const decodeFeed = Schema.decodeUnknownEffect(ManagedGoogleFeed)

export const isManagedGoogleAccounts = Schema.is(Schema.Array(ManagedGoogleAccount))
export const isManagedGoogleCalendarRows = Schema.is(Schema.Array(ManagedGoogleCalendarRow))
export const isManagedGoogleFeed = Schema.is(ManagedGoogleFeed)
export const isManagedGoogleEventAnswer = Schema.is(ManagedGoogleEventAnswer)
export const isManagedGoogleRefusal = Schema.is(ManagedGoogleRefusal)

export function exactFeedEvents(events: readonly ManagedGoogleEvent[], calendarId: string): boolean {
  return events.every((event) => event.calendarId === calendarId && Date.parse(event.endAt) >= Date.parse(event.startAt))
    && new Set(events.map((event) => event.externalId)).size === events.length
}

export effect function parseManagedGoogleCalendars(data: unknown): readonly ManagedGoogleCalendar[]!ManagedGoogleWireInvalid {
  const calendars = decodeCalendars(data) catch effect () => { throw new ManagedGoogleWireInvalid() }
  if (new Set(calendars.map((calendar) => calendar.calendarId)).size !== calendars.length) throw new ManagedGoogleWireInvalid()
  return calendars
}

export effect function parseManagedGoogleCalendarFeed(value: unknown, calendarId: string): ManagedGoogleCalendarFeed!ManagedGoogleWireInvalid {
  const feed = decodeFeed(value) catch effect () => { throw new ManagedGoogleWireInvalid() }
  if (feed.calendarId !== calendarId || !exactFeedEvents(feed.events, calendarId)) throw new ManagedGoogleWireInvalid()
  return { calendarId, events: feed.events, syncedAt: feed.syncedAt }
}
