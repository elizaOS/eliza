// spec/calendar/readClock.md, "Story: See and create times in the zone I am asking about"; spec/calendar/readClock.md, "A request's zone is the stated zone, else the client's zone, else the owner's"; spec/calendar/readClock.md, "Display shifts the canonical instant by the zone's offset on that date"; spec/calendar/readClock.md, "An all-day event keeps its civil date; a timed event uses the viewer's day"; spec/calendar/readClock.md, "A stated year wins, a wrong extracted year is corrected, and a past start asks first"
import { createStartYear, displayDayShift, mustAskBeforeCreate, nextMeansNextYear, yearCueFrom, type YearCue } from "../gen/calendar__readClock.effect.vibe"
import type { CalendarEventFields } from "./model.vibe"

export interface ZonedDateParts {
  readonly year: number
  readonly month: number
  readonly day: number
  readonly hour: number
  readonly minute: number
  readonly second: number
}

export type LocalDate = Pick<ZonedDateParts, "year" | "month" | "day">

const minuteMs = 60_000
const dayMs = 86_400_000
const offsetSampleHours = [-48, -36, -24, -12, 0, 12, 24, 36, 48]
const formatters = new Map<string, Intl.DateTimeFormat | undefined>()

function formatter(timeZone: string): Intl.DateTimeFormat | undefined {
  if (formatters.has(timeZone)) return formatters.get(timeZone)
  let made: Intl.DateTimeFormat | undefined
  try {
    made = new Intl.DateTimeFormat("en-US", { timeZone, hourCycle: "h23", year: "numeric", month: "2-digit", day: "2-digit",
      hour: "2-digit", minute: "2-digit", second: "2-digit" })
  } catch {
    made = undefined
  }
  formatters.set(timeZone, made)
  return made
}

export function knownTimeZone(name: unknown): name is string {
  return typeof name === "string" && name !== "" && name.length <= 128 && !name.includes("\0") && formatter(name) !== undefined
}

export function deviceTimeZone(): string {
  const zone = new Intl.DateTimeFormat().resolvedOptions().timeZone
  return zone === "+00:00" || zone === "-00:00" || !knownTimeZone(zone) ? "UTC" : zone
}

export function getZonedDateParts(date: Date, timeZone: string): ZonedDateParts | undefined {
  const format = formatter(timeZone)
  if (format === undefined || !Number.isFinite(date.getTime())) return undefined
  const parts = Object.fromEntries(format.formatToParts(date).map((part) => [part.type, Number(part.value)]))
  const read = { year: parts.year, month: parts.month, day: parts.day, hour: parts.hour, minute: parts.minute, second: parts.second }
  return Object.values(read).every((value) => Number.isInteger(value)) ? read : undefined
}

function wallMs(parts: ZonedDateParts): number {
  const date = new Date(0)
  date.setUTCFullYear(parts.year, parts.month - 1, parts.day)
  date.setUTCHours(parts.hour, parts.minute, parts.second, 0)
  return date.getTime()
}

export function getTimeZoneOffsetMinutes(date: Date, timeZone: string): number | undefined {
  const parts = getZonedDateParts(date, timeZone)
  return parts === undefined ? undefined : Math.round((wallMs(parts) - Math.floor(date.getTime() / 1000) * 1000) / minuteMs)
}

function sameParts(left: ZonedDateParts | undefined, right: ZonedDateParts): boolean {
  return left !== undefined && left.year === right.year && left.month === right.month && left.day === right.day
    && left.hour === right.hour && left.minute === right.minute && left.second === right.second
}

export function buildUtcDateFromLocalParts(timeZone: string, parts: ZonedDateParts, disambiguation: "compatible" | "reject" = "compatible"): Date | undefined {
  const base = wallMs(parts)
  if (!Number.isFinite(base) || formatter(timeZone) === undefined) return undefined
  const offsets = new Set(offsetSampleHours.map((hours) => getTimeZoneOffsetMinutes(new Date(base + hours * 3_600_000), timeZone) ?? 0))
  const candidates = [...offsets].map((offset) => new Date(base - offset * minuteMs)).filter((at) => Number.isFinite(at.getTime()))
  const exact = candidates.filter((at) => sameParts(getZonedDateParts(at, timeZone), parts)).sort((a, b) => a.getTime() - b.getTime())
  if (disambiguation === "reject") return exact.length === 1 ? exact[0] : undefined
  if (exact.length > 0) return exact[0]
  const forward = candidates.flatMap((at) => {
    const seen = getZonedDateParts(at, timeZone)
    const delta = seen === undefined ? Number.NaN : wallMs(seen) - base
    return Number.isFinite(delta) && delta > 0 ? [{ at, delta }] : []
  }).sort((a, b) => a.delta - b.delta || a.at.getTime() - b.at.getTime())
  return forward[0]?.at
}

export function addDaysToLocalDate(date: LocalDate, days: number): LocalDate {
  const moved = new Date(0)
  moved.setUTCFullYear(date.year, date.month - 1, date.day + days)
  moved.setUTCHours(12, 0, 0, 0)
  return { year: moved.getUTCFullYear(), month: moved.getUTCMonth() + 1, day: moved.getUTCDate() }
}

export function weekdayOfLocalDate(date: LocalDate): number {
  return new Date(wallMs({ ...date, hour: 12, minute: 0, second: 0 })).getUTCDay()
}

export function startOfCivilDay(date: LocalDate, timeZone: string): number | undefined {
  const target = Date.UTC(date.year, date.month - 1, date.day)
  const dayOf = (at: number) => {
    const parts = getZonedDateParts(new Date(at), timeZone)
    return parts === undefined ? Number.NaN : Date.UTC(parts.year, parts.month - 1, parts.day)
  }
  let guess = buildUtcDateFromLocalParts(timeZone, { ...date, hour: 0, minute: 0, second: 0 })?.getTime()
  if (guess === undefined) return undefined
  while (dayOf(guess) < target) guess += minuteMs
  while (dayOf(guess - minuteMs) === target) guess -= minuteMs
  return dayOf(guess) === target ? guess : undefined
}

export interface ZoneSources {
  readonly explicit?: string
  readonly client?: string
  readonly owner: string
}

export function requestTimeZone(sources: ZoneSources): string {
  return knownTimeZone(sources.explicit) ? sources.explicit : createTimeZone(sources)
}

export function createTimeZone(sources: Omit<ZoneSources, "explicit">): string {
  return knownTimeZone(sources.client) ? sources.client : sources.owner
}

export function displayWallTime(instant: string, timeZone: string): (ZonedDateParts & { readonly offsetMinutes: number }) | undefined {
  const at = new Date(instant)
  const parts = getZonedDateParts(at, timeZone)
  const offsetMinutes = getTimeZoneOffsetMinutes(at, timeZone)
  return parts === undefined || offsetMinutes === undefined ? undefined : { ...parts, offsetMinutes }
}

export function createdUtcInstant(wall: ZonedDateParts, timeZone: string): string | undefined {
  return buildUtcDateFromLocalParts(timeZone, wall)?.toISOString()
}

export function displayDay(event: { readonly startAt: string; readonly isAllDay: boolean }, viewerTimeZone: string): string | undefined {
  const at = Date.parse(event.startAt)
  const offset = getTimeZoneOffsetMinutes(new Date(at), viewerTimeZone)
  if (!Number.isFinite(at) || offset === undefined) return undefined
  const utcDay = Math.floor(at / dayMs) * dayMs
  const shift = displayDayShift(Math.floor((at - utcDay) / minuteMs), offset, event.isAllDay)
  return new Date(utcDay + shift * dayMs).toISOString().slice(0, 10)
}

const nextYearWord = /\bnext\s+year\b|(?<![\p{L}\p{M}\p{N}_])내년|明年/u
const thisYearWord = /\bthis year\b|(?<![\p{L}\p{M}\p{N}_])올해|今年/u
const monthWord = "(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|june?|july?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)"
const dayWord = "(\\d{1,2})(?:st|nd|rd|th)?"
const monthNames = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
const datePatterns = [
  new RegExp(`\\b${monthWord}\\.?\\s+${dayWord}\\b(?!\\s*(?::|[ap]\\.?m\\b))`, "u"),
  new RegExp(`\\b${dayWord}\\s+(?:of\\s+)?${monthWord}\\b`, "u"),
  /\b\d{4}-\d{1,2}-\d{1,2}\b/u,
  /\b(?:1[0-2]|0?[1-9])[/-](?:3[01]|[12]\d|0?[1-9])(?:[/-]\d{2,4})?\b/u,
  /(?<!\p{N})\d{1,2}\s*월\s*\d{1,2}\s*일|(?<!\p{N})\d{1,2}\s*月\s*\d{1,2}\s*[日号]/u,
]
const nextDate = new RegExp(`\\bnext\\s+(?:${monthWord}\\b\\.?(?:\\s+${dayWord}\\b)?|(1[0-2]|0?[1-9])[/-](3[01]|[12]\\d|0?[1-9])\\b)`, "u")

function namesCalendarDate(text: string): boolean {
  const folded = text.normalize("NFKC").toLowerCase()
  return datePatterns.some((pattern) => pattern.test(folded))
}

function notLaterThanToday(month: number, day: number | undefined, today: LocalDate): boolean {
  return day === undefined ? month <= today.month : month < today.month || (month === today.month && day <= today.day)
}

export function yearCueOf(text: string, today: LocalDate, sentClocks: readonly string[] = []): { readonly cue: YearCue; readonly statedYear: number; readonly trailingYear: number; readonly namesDate: boolean } {
  const folded = text.normalize("NFKC").toLowerCase()
  const lastDigits = /\b(\d{4})\s*[.!?]?\s*$/.exec(folded)
  const trailing = lastDigits !== null && sentClocks.includes(lastDigits[1] ?? "") ? null : lastDigits
  const stated = [...folded.matchAll(/\b(?:19|20|21)\d{2}\b/g)].find((found) => !sentClocks.includes(found[0])) ?? null
  const next = nextDate.exec(folded)
  const named = next?.[1]
  const month = next === null ? 0 : named !== undefined ? monthNames.indexOf(named.slice(0, 3)) + 1 : Number(next[3])
  const day = next === null ? undefined : named !== undefined ? (next[2] === undefined ? undefined : Number(next[2])) : Number(next[4])
  const saysNextYear = nextMeansNextYear(nextYearWord.test(folded), next !== null, next !== null && notLaterThanToday(month, day, today))
  return {
    cue: yearCueFrom(saysNextYear, stated !== null, thisYearWord.test(folded)),
    statedYear: stated === null ? 0 : Number(stated[0]),
    trailingYear: trailing === null ? 0 : Number(trailing[1]),
    namesDate: next !== null || namesCalendarDate(folded),
  }
}

export function createYear(text: string, today: LocalDate, extractedYear: number, sentClocks: readonly string[] = []): number {
  const { cue, statedYear, trailingYear, namesDate } = yearCueOf(text, today, sentClocks)
  return createStartYear(cue, statedYear, trailingYear, today.year, namesDate, extractedYear)
}

export function statedYearCreate(fields: CalendarEventFields, text: string, now: Date): { readonly fields: CalendarEventFields; readonly move: (instant: string) => string } | undefined {
  const zone = fields.isAllDay ? "UTC" : fields.timeZone
  const start = getZonedDateParts(new Date(fields.startAt), zone)
  const today = getZonedDateParts(now, fields.timeZone)
  const sentClocks = [fields.startAt, fields.endAt].flatMap((instant) => {
    const wall = getZonedDateParts(new Date(instant), zone)
    return wall === undefined ? [] : [`${String(wall.hour).padStart(2, "0")}${String(wall.minute).padStart(2, "0")}`]
  })
  const years = start === undefined || today === undefined ? 0 : createYear(text, today, start.year, sentClocks) - start.year
  const move = (instant: string) => {
    const parts = years === 0 ? undefined : getZonedDateParts(new Date(instant), zone)
    return parts === undefined ? instant : buildUtcDateFromLocalParts(zone, { ...parts, year: parts.year + years })?.toISOString() ?? instant
  }
  const startAt = move(fields.startAt)
  if (start !== undefined && years !== 0 && !sameParts(getZonedDateParts(new Date(startAt), zone), { ...start, year: start.year + years })) {
    return undefined
  }
  return { fields: { ...fields, startAt, endAt: new Date(Date.parse(startAt) + Date.parse(fields.endAt) - Date.parse(fields.startAt)).toISOString() }, move }
}

export function createNeedsConfirmation(startAt: string, now: Date, timeZone: string): boolean {
  const start = getZonedDateParts(new Date(startAt), timeZone)
  const today = getZonedDateParts(now, timeZone)
  if (start === undefined || today === undefined) return true
  return mustAskBeforeCreate(start.year, today.year, Date.parse(startAt) < now.getTime())
}
