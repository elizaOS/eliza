// spec/calendar/seriesScope.md, "An occurrence becomes a standalone override or an exclusion under its series"; spec/calendar/seriesScope.md, "A write names its scope: this event, this and following, or all"; spec/calendar/actions.md, "A repeating create carries its reviewed recurrence and reads back with it"
import type { CalendarRow, CalendarWriteScope } from "./document.vibe"
import type { CalendarRecurrence } from "./recurrence-rule.vibe"

const Instant = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0), Schema.isLessThanOrEqualTo(8_640_000_000_000_000))

export const CalendarRowRecord = Schema.Struct({
  id: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(1024)),
  calendarId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(1024)),
  title: Schema.String.check(Schema.isMaxLength(500)),
  body: Schema.String.check(Schema.isMaxLength(16_000)),
  location: Schema.String.check(Schema.isMaxLength(2_000)),
  begin: Instant,
  end: Instant,
  revision: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256)),
  allDay: Schema.optionalKey(Schema.Boolean),
  timeZone: Schema.optionalKey(Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128))),
  repeat: Schema.optionalKey(Schema.Literals(["none", "daily", "weekdays", "weekly"])),
  who: Schema.optionalKey(Schema.Array(Schema.String)),
  responses: Schema.optionalKey(Schema.Record(Schema.String, Schema.String)),
  seriesId: Schema.optionalKey(Schema.String.check(Schema.isMinLength(1))),
  occurrenceBegin: Schema.optionalKey(Instant),
  excluded: Schema.optionalKey(Schema.Array(Instant)),
  until: Schema.optionalKey(Instant),
}).check(Schema.makeFilter((row) => row.end >= row.begin))

export const WriteScopeRecord = Schema.Literals(["instance", "this_and_following", "series"])

const Utc = Schema.String.check(Schema.makeFilter((text) => /^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{3})?Z$/.test(text) && Number.isFinite(Date.parse(text))))

export const RecurrenceRecord = Schema.Struct({
  rule: Schema.Literals(["daily", "weekdays", "weekly"]),
  until: Schema.optionalKey(Utc),
  excluded: Schema.optionalKey(Schema.Array(Utc).check(Schema.isMaxLength(500), Schema.makeFilter((starts) => new Set(starts.map((start) => Date.parse(start))).size === starts.length))),
})

type Assignable<A, B extends A> = B
export type StoredRow = Assignable<CalendarRow, typeof CalendarRowRecord.Type>
export type StoredScope = Assignable<CalendarWriteScope, typeof WriteScopeRecord.Type>
export type StoredRecurrence = Assignable<CalendarRecurrence, typeof RecurrenceRecord.Type>
