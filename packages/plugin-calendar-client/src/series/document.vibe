// spec/calendar/seriesScope.md, "Story: Change one occurrence without changing its siblings"; spec/calendar/seriesScope.md, "An occurrence becomes a standalone override or an exclusion under its series"; spec/calendar/seriesScope.md, "A write names its scope: this event, this and following, or all"
import { effectiveScope, excludeStart, explicitSeriesScope, movedWall, scopeAllowed, splitStarts, type WriteScope } from "../../gen/calendar__seriesScope.effect.vibe"
import { generatedOccurrence, occurrenceId, repeatingRow, seriesOccursAt, seriesZone } from "../availability/recurrence.vibe"
import { buildUtcDateFromLocalParts, getZonedDateParts } from "../clock.vibe"

export type CalendarRepeat = "none" | "daily" | "weekdays" | "weekly"

export interface CalendarRow {
  readonly id: string
  readonly calendarId: string
  readonly title: string
  readonly body: string
  readonly location: string
  readonly begin: number
  readonly end: number
  readonly revision: string
  readonly allDay?: boolean
  readonly timeZone?: string
  readonly repeat?: CalendarRepeat
  readonly who?: readonly string[]
  readonly responses?: Readonly<Record<string, string>>
  readonly seriesId?: string
  readonly occurrenceBegin?: number
  readonly excluded?: readonly number[]
  readonly until?: number
}

export type CalendarRowFields = Partial<Pick<CalendarRow, "title" | "body" | "location" | "begin" | "end" | "allDay" | "timeZone" | "repeat" | "who" | "responses">>

export interface ReviewedRow {
  readonly id: string
  readonly revision: string
}

export interface SeriesReview {
  readonly occurrenceId: string
  readonly occurrenceRevision: string
  readonly parentId: string
  readonly parentRevision: string
  readonly occurrenceExact: boolean
  readonly parentFound: boolean
  readonly confirmed: boolean
}

export error SeriesChanged { id: string }
export error InvalidSeriesTime { zone: string; wall: number }
export error ScopeMismatch { id: string; scope: CalendarWriteScope }

export type CalendarWriteScope = "instance" | "this_and_following" | "series"

export interface ScopedEdit {
  readonly rows: readonly CalendarRow[]
  readonly selected: string
}

const zoneOf = (row: CalendarRow) => seriesZone(row)

function wallOf(instant: number, zone: string): number | undefined {
  const parts = getZonedDateParts(new Date(instant), zone)
  return parts === undefined ? undefined
    : Date.UTC(parts.year, parts.month - 1, parts.day, parts.hour, parts.minute, parts.second) + (((instant % 1000) + 1000) % 1000)
}

function instantOf(wall: number, zone: string): number | undefined {
  const at = new Date(wall)
  const resolved = buildUtcDateFromLocalParts(zone, { year: at.getUTCFullYear(), month: at.getUTCMonth() + 1, day: at.getUTCDate(),
    hour: at.getUTCHours(), minute: at.getUTCMinutes(), second: at.getUTCSeconds() })
  return resolved === undefined ? undefined : resolved.getTime() + at.getUTCMilliseconds()
}

function civilDay(instant: number, zone: string): number | undefined {
  const parts = getZonedDateParts(new Date(instant), zone)
  return parts === undefined ? undefined : Date.UTC(parts.year, parts.month - 1, parts.day)
}

const repeating = repeatingRow

export function findRow(rows: readonly CalendarRow[], id: string): CalendarRow | undefined {
  const direct = rows.find((row) => row.id === id)
  if (direct !== undefined) return direct
  const match = /^(.*):occ:(-?\d+)$/.exec(id)
  if (match === null) return undefined
  const begin = Number(match[2])
  const series = rows.find((row) => row.id === match[1] && row.seriesId === undefined)
  if (series === undefined || series.excluded?.includes(begin) === true || !seriesOccursAt(series, begin)) return undefined
  return generatedOccurrence(series, begin)
}

export function storedRow(rows: readonly CalendarRow[], row: CalendarRow): boolean {
  return rows.some((stored) => stored.id === row.id)
}

function standalone(row: CalendarRow, revision: string): CalendarRow {
  const { seriesId: _series, occurrenceBegin: _original, ...rest } = row
  return { ...rest, revision }
}

function withoutExclusions(row: CalendarRow): CalendarRow {
  const { excluded: _excluded, until: _until, ...rest } = row
  return rest
}

function replace(rows: readonly CalendarRow[], row: CalendarRow): CalendarRow[] {
  const index = rows.findIndex((stored) => stored.id === row.id)
  return index < 0 ? [...rows, row] : rows.map((stored, at) => at === index ? row : stored)
}

effect function parentOf(rows: readonly CalendarRow[], seriesId: string): CalendarRow!SeriesChanged {
  const parent = rows.find((row) => row.id === seriesId && row.seriesId === undefined)
  if (parent === undefined) throw new SeriesChanged({ id: seriesId })
  return parent
}

export effect function remapExclusions(rows: readonly CalendarRow[], before: CalendarRow, next: CalendarRow): number[]!InvalidSeriesTime {
  const oldZone = zoneOf(before)
  const newZone = zoneOf(next)
  const anchor = civilDay(before.begin, oldZone)
  const nextWall = wallOf(next.begin, newZone)
  if (anchor === undefined || nextWall === undefined) throw new InvalidSeriesTime({ zone: newZone, wall: next.begin })
  const dates = [...before.excluded ?? [], ...rows.flatMap((row) => row.seriesId === before.id && row.occurrenceBegin !== undefined ? [row.occurrenceBegin] : [])]
  let kept: number[] = []
  for (const date of dates) {
    const excludedDay = civilDay(date, oldZone)
    const wall = excludedDay === undefined ? undefined : movedWall(anchor, excludedDay, nextWall)
    const resolved = wall === undefined ? undefined : instantOf(wall, newZone)
    if (resolved === undefined) throw new InvalidSeriesTime({ zone: newZone, wall: wall ?? date })
    kept = excludeStart(kept, resolved)
  }
  return kept
}

export effect function saveEdit(rows: readonly CalendarRow[], reviewed: ReviewedRow, fields: CalendarRowFields, mint: () => string) {
  const before = findRow(rows, reviewed.id)
  if (before === undefined || before.revision !== reviewed.revision) throw new SeriesChanged({ id: reviewed.id })
  const merged: CalendarRow = { ...before, ...fields, revision: mint() }
  const updated = merged.responses === undefined ? merged
    : { ...merged, responses: Object.fromEntries(Object.entries(merged.responses).filter(([person]) => merged.who?.includes(person) === true)) }
  if (before.seriesId !== undefined) {
    const parent = try parentOf(rows, before.seriesId)
    const saved: CalendarRow = { ...withoutExclusions(updated), id: before.id, seriesId: before.seriesId, occurrenceBegin: before.occurrenceBegin, repeat: "none" }
    return replace(replace(rows, { ...parent, revision: saved.revision }), saved)
  }
  if (!repeating(before)) return replace(rows, updated)
  if (updated.repeat === undefined || updated.repeat === "none") {
    const detached = rows.map((row) => row.seriesId === before.id ? standalone(row, mint()) : row)
    return replace(detached, withoutExclusions(updated))
  }
  return replace(rows, { ...updated, excluded: try remapExclusions(rows, before, updated) })
}

export effect function removeRow(rows: readonly CalendarRow[], row: CalendarRow, revision: string): CalendarRow[]!SeriesChanged {
  if (row.seriesId === undefined) return rows.filter((stored) => stored.id !== row.id && stored.seriesId !== row.id)
  const parent = try parentOf(rows, row.seriesId)
  const excluded = excludeStart([...parent.excluded ?? []], row.occurrenceBegin ?? row.begin)
  return replace(rows, { ...parent, excluded, revision }).filter((stored) => stored.id !== row.id)
}

export effect function reviewSeries<E>(rows: readonly CalendarRow[], selected: ReviewedRow, confirm: (parent: CalendarRow) => boolean!E): SeriesReview!(SeriesChanged | E) {
  const occurrence = findRow(rows, selected.id)
  const seriesId = occurrence?.revision === selected.revision ? occurrence.seriesId : undefined
  const occurrenceExact = seriesId !== undefined
  const parent = rows.find((row) => row.id === seriesId && row.seriesId === undefined)
  if (parent === undefined) throw new SeriesChanged({ id: selected.id })
  const confirmed = try confirm(structuredClone(parent))
  if (!explicitSeriesScope(occurrenceExact, true, confirmed)) throw new SeriesChanged({ id: parent.id })
  return { occurrenceId: selected.id, occurrenceRevision: selected.revision, parentId: parent.id, parentRevision: parent.revision, occurrenceExact, parentFound: true, confirmed }
}

export effect function saveSeriesEdit(rows: readonly CalendarRow[], review: SeriesReview, fields: CalendarRowFields, mint: () => string) {
  if (!explicitSeriesScope(review.occurrenceExact, review.parentFound, review.confirmed)) throw new SeriesChanged({ id: review.parentId })
  return try saveEdit(rows, { id: review.parentId, revision: review.parentRevision }, fields, mint)
}

const writeScopes: Record<CalendarWriteScope, WriteScope> = { instance: "InstanceScope", this_and_following: "FollowingScope", series: "WholeSeriesScope" }

type ScopePlan =
  | { readonly scope: "InstanceScope" }
  | { readonly scope: "FollowingScope" | "WholeSeriesScope"; readonly parent: CalendarRow; readonly splitAt: number }

effect function planScope(rows: readonly CalendarRow[], row: CalendarRow, scope: CalendarWriteScope): ScopePlan!ScopeMismatch {
  const parent = row.seriesId !== undefined ? rows.find((stored) => stored.id === row.seriesId && stored.seriesId === undefined) : repeating(row) ? row : undefined
  const asked = writeScopes[scope]
  if (!scopeAllowed(asked, parent !== undefined) || (parent !== undefined && parent.id === row.id && asked === "InstanceScope")) throw new ScopeMismatch({ id: row.id, scope })
  if (parent === undefined) return { scope: "InstanceScope" }
  const splitAt = row.occurrenceBegin ?? row.begin
  const chosen = effectiveScope(asked, splitAt === parent.begin)
  return chosen === "InstanceScope" ? { scope: chosen } : { scope: chosen, parent, splitAt }
}

effect function reviewed(rows: readonly CalendarRow[], selected: ReviewedRow): CalendarRow!SeriesChanged {
  const row = findRow(rows, selected.id)
  if (row === undefined || row.revision !== selected.revision) throw new SeriesChanged({ id: selected.id })
  return row
}

export effect function saveScopedEdit(rows: readonly CalendarRow[], selected: ReviewedRow, scope: CalendarWriteScope, fields: CalendarRowFields,
  mint: () => string, newSeriesId: string): ScopedEdit!(SeriesChanged | ScopeMismatch | InvalidSeriesTime) {
  const row = try reviewed(rows, selected)
  const plan = try planScope(rows, row, scope)
  if (plan.scope === "InstanceScope") return { rows: try saveEdit(rows, selected, fields, mint), selected: row.id }
  const begin = fields.begin ?? row.begin
  const end = fields.end ?? row.end
  const { parent, splitAt } = plan
  if (plan.scope === "WholeSeriesScope") {
    const parentBegin = parent.begin + begin - row.begin
    const parentFields: CalendarRowFields = { ...fields, begin: parentBegin, end: parentBegin + end - begin }
    const saved = parent.id === row.id ? try saveEdit(rows, { id: parent.id, revision: parent.revision }, parentFields, mint)
      : try saveSeriesEdit(rows, try reviewSeries(rows, selected, effect () => true), parentFields, mint)
    if (parent.id !== row.id && storedRow(rows, row)) return { rows: try saveEdit(saved, selected, fields, mint), selected: row.id }
    const moved = occurrenceId(parent.id, begin)
    if (findRow(saved, moved) === undefined) throw new InvalidSeriesTime({ zone: zoneOf(parent), wall: begin })
    return { rows: saved, selected: moved }
  }
  const { kept, moved } = splitStarts([...parent.excluded ?? []], splitAt)
  const following = rows.filter((stored) => stored.seriesId === parent.id && stored.id !== row.id && (stored.occurrenceBegin ?? stored.begin) >= splitAt)
  const head: CalendarRow = { ...parent, until: splitAt, excluded: kept, revision: mint() }
  const tailBase = storedRow(rows, row) ? standalone(withoutExclusions(row), row.revision) : withoutExclusions(parent)
  const tail: CalendarRow = { ...tailBase, ...fields, id: newSeriesId, begin, end, revision: mint(), repeat: parent.repeat,
    ...(parent.until === undefined ? {} : { until: parent.until }) }
  const excluded = try remapExclusions(following, { ...parent, begin: splitAt, excluded: moved }, tail)
  const movedIds = new Set(following.map((stored) => stored.id))
  const remaining = rows.filter((stored) => stored.id !== row.id)
    .map((stored) => stored.id === parent.id ? head : movedIds.has(stored.id) ? { ...stored, seriesId: newSeriesId } : stored)
  return { rows: [...remaining, { ...tail, excluded }], selected: occurrenceId(newSeriesId, begin) }
}

export effect function removeScoped(rows: readonly CalendarRow[], selected: ReviewedRow, scope: CalendarWriteScope, mint: () => string): CalendarRow[]!(SeriesChanged | ScopeMismatch) {
  const row = try reviewed(rows, selected)
  const plan = try planScope(rows, row, scope)
  if (plan.scope === "InstanceScope") return try removeRow(rows, row, mint())
  if (plan.scope === "WholeSeriesScope") return try removeRow(rows, plan.parent, mint())
  const { parent, splitAt } = plan
  const { kept } = splitStarts([...parent.excluded ?? []], splitAt)
  const head: CalendarRow = { ...parent, until: splitAt, excluded: kept, revision: mint() }
  return rows.filter((stored) => !(stored.seriesId === parent.id && (stored.occurrenceBegin ?? stored.begin) >= splitAt))
    .map((stored) => stored.id === parent.id ? head : stored)
}
