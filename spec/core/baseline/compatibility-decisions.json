    {
      "id": "release-partial-log-acquisition",
      "kind": "internal-resource-cleanup",
      "source": "packages/core/src/logger.ts",
      "sourceBehavior": "A failed later file open leaves earlier descriptors owned until process termination.",
      "targetBehavior": "Close earlier descriptors before disabling file sinks. If a close fails, retain explicit ownership and a retryable cleanup-failure state.",
      "specification": "spec/core/logging/files.md",
      "publicResult": "An unsuccessful initialization continues to produce no file-log success.",
      "approval": "Proposed specification change for user review; implementation has not been written.",
      "verification": {
        "pinnedSourceSha256": "b5a4d415cd227b3c85d41bdd4ab17350b0e32af26a1301cabbe8b1115ffebd87",
        "modelRevision": "afdb27e31373a1a66374a9eb1cf9145f08dbb473",
        "modelInputs": [
          {
            "path": "spec/core/logFiles.md",
            "sha256": "e011f9f7a793f45485747c27a743893482c85c083876f16c9e5a04f481ee548a"
          }
        ],
        "proofObligations": {
          "logFiles": 66
        },
        "pinnedObservation": "A real third open failure left both earlier file descriptors owned and wrote no prompt bytes.",
        "modelReplay": "Failure at any of the three opens reaches Disabled after cleanup. An unsuccessful close preserves ownership, keeps writes disabled and permits explicit cleanup retry."
      }
    },
    {
      "id": "task-event-observer-failure-cleanup",
      "kind": "internal-failure-recovery",
      "source": "packages/core/src/messaging/task-events.ts",
      "sourceBehavior": "A throw from the first changed observer occurs before try/finally and retains pending=true until stop/start.",
      "targetBehavior": "Release pending ownership, preserve the accepted page and record internal ObserverFailure. Rejecting publication boundaries rethrow the original observed value unchanged. Permit an explicit refresh or stop/start; do not automatically retry.",
      "specification": "spec/core/taskEventReader.md",
      "publicResult": "Successful polling retains its existing pages and notifications. Observer failure preserves the original thrown value at rejecting publication boundaries and leaves explicit refresh available instead of permanently suppressing it.",
      "approval": "Implementation releases pending ownership and preserves original thrown values; specification awaits user review and root acceptance. Source filesystem recovery controls pass; packed qualification remains pending.",
      "verification": {
        "pinnedSourceSha256": "2f3dea209d7b518a1fe34c66a77b80e8585ec8b64562ebeba76aafa1f7bb18b1",
        "modelRevision": "afdb27e31373a1a66374a9eb1cf9145f08dbb473",
