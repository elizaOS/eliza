          }
        ],
        "proofObligations": {
          "taskEventReader": 44
        },
        "pinnedObservation": "A first publication throw rejected start before any read. An explicit refresh performed no read because pending ownership remained.",
        "modelReplay": "A current observer failure releases pending ownership and permits explicit refresh. Each publication stage refuses both successful and failed completion from an older generation."
      }
    },
    {
      "id": "trace-owner-conflict",
      "kind": "cross-owner-identity-transfer",
      "source": "packages/core/src/runtime/active-prompt-traces.ts",
      "sourceBehavior": "A trace ID may be overwritten by another run while the earlier run index retains that ID; deleting the earlier run can remove the newer run trace.",
      "targetBehavior": "Transfer a captured trace key to the receiving run while preserving its global insertion slot and existing destination admission position, or appending new destination membership. Remove prior run membership so deleting the old run cannot erase the transferred trace. Record remains void and adds no public rejection.",
      "specification": "spec/core/traces.md",
      "publicResult": "Existing trace methods preserve their synchronous void/reference interface. Same-run replacement publishes the original replacement object; cross-run reuse corrects stale index aliasing without TraceIdentityConflict.",
      "approval": "Superseding compatible-transfer proposal; user acceptance remains pending. Current v4 implementation and verification are recorded separately from the historical rejecting model.",
      "verification": {
        "pinnedSourceSha256": "cba59c217657a8a8107772461fc07063532e3f51103a07d2505646a5a766dced",
        "modelRevision": "afdb27e31373a1a66374a9eb1cf9145f08dbb473",
        "modelInputs": [
          {
            "path": "spec/core/traces.md",
            "sha256": "2c8fcef740d233956fc75bc6fb18ac5e257363c396687e9bb777f5a6274cd722"
