          {
            "path": "spec/core/scoreCard.md",
            "sha256": "18bd580967803e0bd38976773e10192944eb6b50e13439f8de7ed8ed5d6ca89c"
          }
        ],
        "proofObligations": {
          "traces": 45,
          "scoreCard": 6
        },
        "pinnedObservation": "Cross-run reuse made the original run resolve the replacement. Deleting the original run then erased the newer run's trace.",
        "modelReplay": "Cross-run reuse produces TraceIdentityConflict, retains the existing run's trace and purge counter, and preserves same-run replacement."
      },
      "currentContract": {
        "implementationSource": "packages/core/src/runtime/active-prompt-traces.vibe",
        "implementationSourceSha256": "0612a35de0fc77b1d0f633bb702d721e90369619945164ada254a9a0d6cb9964",
        "specification": "spec/core/traces.md",
        "specificationSha256": "d29977993d50a36cdfafc004223a68167bb4511b6ac3ca13de241596fdaeb4c1",
        "qualification": "Fresh isolated current-tool canonical verification of these exact model/proof inputs passed 12,000 safety traces, all five reachability goals, 405 replays and all 85 obligations, with zero normal audit findings. Source/test lint passed. Root generation, source types, J03 and same-artifact package qualification remain pending; the private scope did not check application source. No root acceptance was run.",
        "owner": "Generated TraceState with global key order, independently ordered run memberships and cadence; native original Map/Set references mechanically interpret emitted effects.",
        "compatibility": "Void record API transfers a captured key across runs; no new public TraceIdentityConflict. Admitted id captured once rather than the historical two reads.",
        "nativeBoundaries": "Current inline compositeScore/ScoreCardData, raw live Map/Set iteration, original trace/score-card/signal references, native NaN/infinity/fractional TTL comparisons and original thrown values remain conformance boundaries."
      }
