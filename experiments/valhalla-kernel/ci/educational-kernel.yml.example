name: Educational kernel QEMU
on:
  pull_request:
    branches: [develop]
    paths: ["experiments/valhalla-kernel/**", ".github/workflows/educational-kernel.yml"]
  push:
    branches: [develop]
    paths: ["experiments/valhalla-kernel/**", ".github/workflows/educational-kernel.yml"]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  boot:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Install kernel tools
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential binutils grub-common grub-pc-bin xorriso mtools qemu-system-x86
      - name: Build and test the actual kernel
        working-directory: experiments/valhalla-kernel
        run: |
          make test iso CROSS=
          for ram in 64M 128M 256M; do
            python3 scripts/smoke.py --memory "$ram"
            cp build/serial.log "build/serial-$ram.log"
          done
          tar --exclude=build -czf build/source.tar.gz --transform='s,^,valhalla-kernel/,' README.md Makefile linker.ld .gitignore arch boot include kernel scripts tests
          cd build
          sha256sum valhalla.iso kernel.elf source.tar.gz serial-*.log > SHA256SUMS
      - uses: actions/upload-artifact@v4
        if: success()
        with:
          name: educational-kernel-${{ github.sha }}
          path: |
            experiments/valhalla-kernel/build/valhalla.iso
            experiments/valhalla-kernel/build/kernel.elf
            experiments/valhalla-kernel/build/source.tar.gz
            experiments/valhalla-kernel/build/SHA256SUMS
            experiments/valhalla-kernel/build/serial-*.log
          if-no-files-found: error
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: educational-kernel-failure-${{ github.sha }}
          path: experiments/valhalla-kernel/build/*.log
          if-no-files-found: ignore
