{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "incremental": false,
    "noEmit": false,
    "paths": {
      "@elizaos/core": ["../../packages/core/dist/index.d.ts"],
      "@elizaos/ui": ["../../packages/ui/dist/index.d.ts"],
      "@elizaos/ui/*": ["../../packages/ui/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
