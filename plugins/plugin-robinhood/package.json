{
  "name": "@elizaos/plugin-robinhood",
  "version": "0.1.0",
  "type": "module",
  "description": "Cheshire Terminal Robinhood Chain agent identity forge for elizaOS — ERC-8004 register, reputation, validation (preview-first).",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "eliza-source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "package.json", "registry-entry.json"],
  "scripts": {
    "build": "bun run build.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@elizaos/core": "workspace:*"
  },
  "elizaos": {
    "plugin": {
      "capabilities": ["robinhood-forge", "erc-8004", "cheshire-terminal"]
    }
  },
  "keywords": ["elizaos", "plugin", "robinhood-chain", "cheshire", "erc-8004", "agent-identity"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solizardking/eliza.git",
    "directory": "plugins/plugin-robinhood"
  }
}
