<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
 <queries>
  <package android:name="example.notificationmirror.selected" />
  <package android:name="example.notificationmirror.excluded" />
  <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
 </queries>
 <application android:label="Mirror consumer" android:allowBackup="false">
  <service android:name="example.mirror.TestListener" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
   <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
  </service>
 </application>
</manifest>
