{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "types": [
      "node",
      "vite/client"
    ],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "drizzle-orm": [
        "../plugin-sql/node_modules/drizzle-orm"
      ],
      "drizzle-orm/*": [
        "../plugin-sql/node_modules/drizzle-orm/*"
      ],
      "@elizaos/app": [
        "../../packages/app/src/index.ts"
      ],
      "@elizaos/app/*": [
        "../../packages/app/src/*"
      ],
      "@elizaos/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@elizaos/ui/spatial": [
        "../../packages/ui/src/spatial/index.ts"
      ],
      "@elizaos/ui/spatial/*": [
        "../../packages/ui/src/spatial/*"
      ],
      "@elizaos/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@elizaos/core": [
        "../../packages/core/src/index.ts"
      ],
      "@elizaos/core/*": [
        "../../packages/core/src/*"
      ],
      "@elizaos/agent": [
        "../../packages/agent/src/index.ts"
      ],
      "@elizaos/agent/*": [
        "../../packages/agent/src/*"
      ],
      "@elizaos/capacitor-bun-runtime": [
        "../../plugins/plugin-native-bun-runtime/src/index.ts"
      ],
      "@elizaos/capacitor-secure-store": [
        "../../plugins/plugin-native-secure-store/src/index.ts"
      ],
      "@elizaos/capacitor-camera": [
        "../../plugins/plugin-native-camera/src/index.ts"
      ],
      "@elizaos/plugin-scheduling": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ]
}
