{
  "name": "@elizaos/plugin-scheduling",
  "version": "2.0.3-beta.7",
  "type": "module",
  "description": "Scheduling spine for elizaOS agents: the storage-agnostic ScheduledTask state machine \u2014 trigger evaluation (cron/interval/once/event/after_task/relative_to_anchor/during_window), gate + completion-check + escalation-ladder + anchor + consolidation registries, the due/next-fire-at math, and the runner. Persistence + owner/channel/connector deps are injected by the host (e.g. @elizaos/plugin-personal-assistant). Reminders register a tick-hook via the ports here.",
  "main": "./dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "test": "bunx vitest run --config ./vitest.config.ts",
    "build": "bun run build:js && bun run build:views && bun run build:types",
    "clean": "node ../../packages/scripts/rm-path-recursive.ts dist",
    "build:js": "tsup --config ../tsup.plugin-packages.shared.ts",
    "build:views": "vite build --config vite.config.views.ts",
    "build:types": "bunx tsc6 --noCheck -p tsconfig.build.json && node ../../packages/scripts/rewrite-dist-relative-imports-node-esm.ts",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@elizaos/plugin-sql": "workspace:*",
    "@elizaos/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "registry-entry.json",
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electric-sql/pglite": "^0.4.5",
    "@types/node": "^25.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@elizaos/plugin-sqlite": "workspace:*"
  }
}
