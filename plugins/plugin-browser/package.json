{
  "name": "@elizaos/plugin-browser",
  "version": "2.0.3-beta.7",
  "type": "module",
  "description": "Browser automation through the embedded desktop workspace, JSDOM, and optional Stagehand targets.",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./remote-controller": {
      "browser": null,
      "eliza-source": "./src/remote-controller.ts",
      "types": "./dist/remote-controller.d.ts",
      "import": "./dist/remote-controller.js",
      "default": "./dist/remote-controller.js"
    },
    "./remote-control/browser-controller": {
      "browser": null,
      "eliza-source": "./src/remote-control/browser-controller.ts",
      "types": "./dist/remote-control/browser-controller.d.ts",
      "import": "./dist/remote-control/browser-controller.js",
      "default": "./dist/remote-control/browser-controller.js"
    },
    "./remote-control/controller": {
      "browser": null,
      "eliza-source": "./src/remote-control/controller.ts",
      "types": "./dist/remote-control/controller.d.ts",
      "import": "./dist/remote-control/controller.js",
      "default": "./dist/remote-control/controller.js"
    },
    "./remote-control/crypto": {
      "browser": null,
      "eliza-source": "./src/remote-control/crypto.ts",
      "types": "./dist/remote-control/crypto.d.ts",
      "import": "./dist/remote-control/crypto.js",
      "default": "./dist/remote-control/crypto.js"
    },
    "./remote-control/runtime-store": {
      "browser": null,
      "eliza-source": "./src/remote-control/runtime-store.ts",
      "types": "./dist/remote-control/runtime-store.d.ts",
      "import": "./dist/remote-control/runtime-store.js",
      "default": "./dist/remote-control/runtime-store.js"
    },
    "./*": {
      "eliza-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "test": "vitest run && bun run test:remote-control",
    "build": "bun run build:js && bun run build:types",
    "clean": "node ../../packages/scripts/rm-path-recursive.ts dist",
    "build:js": "tsup --config ../tsup.plugin-packages.shared.ts",
    "build:types": "tsc6 --noCheck -p tsconfig.build.json",
    "test:remote-control": "bun test --conditions=eliza-source test/remote-control"
  },
  "dependencies": {
    "@elizaos/auth": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/host": "workspace:*",
    "@elizaos/plugin-assistant": "workspace:*",
    "@elizaos/plugin-elizacloud": "workspace:*",
    "drizzle-orm": "0.45.3",
    "linkify-it": "5.0.2",
    "@elizaos/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/linkify-it": "5.0.0",
    "bun-types": "1.4.2",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^24.37.5",
    "tsup": "^8.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "@elizaos/plugin-sql": "workspace:*"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {}
  },
  "elizaos": {
    "plugin": {
      "autoEnableModule": "./auto-enable.ts",
      "capabilities": [
        "browser-automation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "registry-entry.json",
    "dist",
    "auto-enable.ts"
  ]
}
