{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@elizaos/core": [
        "../../packages/core/src/index.ts"
      ],
      "@elizaos/auth/auth": [
        "../../packages/auth/src/auth/index.ts"
      ],
      "@elizaos/auth/auth/*": [
        "../../packages/auth/src/auth/*"
      ],
      "@elizaos/plugin-agent-orchestrator": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src/__tests__/task-agent-live.live.test.ts",
    "../../packages/core/test/live/task-agent-live-smoke.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
