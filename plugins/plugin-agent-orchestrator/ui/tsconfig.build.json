{
  "extends": "../../tsconfig.build.shared.json",
  "compilerOptions": {
    "outDir": "../dist/ui",
    "rootDir": "../src/ui",
    "emitDeclarationOnly": false
  },
  "include": ["../src/ui"],
  "exclude": [
    "../src/ui/**/*.test.ts",
