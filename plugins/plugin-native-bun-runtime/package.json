{
  "name": "@elizaos/capacitor-bun-runtime",
  "version": "2.0.3-beta.7",
  "description": "Embedded Bun-shape JS runtime bridge for iOS and Android",
  "keywords": [
    "capacitor",
    "bun",
    "javascriptcore",
    "embedded-runtime",
    "eliza"
  ],
  "main": "./dist/plugin.cjs.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "ios/Sources/",
    "ios/Tests/",
    "ElizaosCapacitorBunRuntime.podspec",
    "dist/",
    "src/",
    "README.md",
    "ElizaBunEngine.podspec",
    "engine/Sources/",
    "engine/patches/",
    "engine/README.md",
    "engine/artifacts/ElizaBunEngine.xcframework/",
    "ios/sqlite-vec/build-ios.sh",
    "ios/sqlite-vec/VERSION",
    "ios/sqlite-vec/README.md"
  ],
  "author": "elizaOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaOS/eliza.git",
    "directory": "plugins/plugin-native-bun-runtime"
  },
  "scripts": {
    "build": "node ../../packages/scripts/with-package-build-lock.mjs plugins/plugin-native-bun-runtime -- bun run build:unlocked",
    "clean": "node ../../packages/scripts/rm-path-recursive.mjs dist",
    "test": "bun run test:bridge && bun run engine:test",
    "prepublishOnly": "bun run build",
    "watch": "tsc6 --watch",
    "build:unlocked": "bun run clean && tsc6 && bunx rollup -c rollup.config.mjs && bun run build:engine-tools",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "test:bridge": "vitest run",
    "engine:check": "node dist/engine/check-upstream-support.mjs",
    "engine:check:strict": "node dist/engine/check-upstream-support.mjs --strict",
    "engine:build:sim": "node dist/engine/build-ios-bun-engine.mjs --target=simulator",
    "engine:build:device": "node dist/engine/build-ios-bun-engine.mjs --target=device",
    "engine:verify:app-store": "node dist/engine/verify-ios-app-store.mjs",
    "engine:test": "node --test ../../packages/scripts/plugins/plugin-native-bun-runtime/engine/*.test.mjs",
    "engine:smoke:sim": "node dist/engine/smoke-ios-bun-engine.mjs --target=simulator",
    "engine:smoke:device": "node dist/engine/smoke-ios-bun-engine.mjs --target=device",
    "build:sqlite-vec": "node ../../packages/scripts/run-bash-darwin-only.mjs plugins/plugin-native-bun-runtime/ios/sqlite-vec/build-ios.sh",
    "build:sqlite-vec:device": "node ../../packages/scripts/run-bash-darwin-only.mjs plugins/plugin-native-bun-runtime/ios/sqlite-vec/build-ios.sh device",
    "build:sqlite-vec:simulator": "node ../../packages/scripts/run-bash-darwin-only.mjs plugins/plugin-native-bun-runtime/ios/sqlite-vec/build-ios.sh simulator",
    "clean:sqlite-vec": "node ../../packages/scripts/run-bash-darwin-only.mjs plugins/plugin-native-bun-runtime/ios/sqlite-vec/build-ios.sh clean",
    "build:engine-tools": "bun build ../../packages/scripts/plugins/plugin-native-bun-runtime/engine/build-ios-bun-engine.mjs ../../packages/scripts/plugins/plugin-native-bun-runtime/engine/check-upstream-support.mjs ../../packages/scripts/plugins/plugin-native-bun-runtime/engine/smoke-ios-bun-engine.mjs ../../packages/scripts/plugins/plugin-native-bun-runtime/engine/verify-ios-app-store.mjs ../../packages/scripts/plugins/plugin-native-bun-runtime/engine/ios-app-store-runtime-policy.mjs ../../packages/scripts/rm-path-recursive.mjs --target=node --outdir=dist/engine --entry-naming='[name].mjs'"
  },
  "devDependencies": {
    "@capacitor/core": "^8.3.1",
    "rollup": "^4.62.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios",
      "podName": "ElizaosCapacitorBunRuntime"
    }
  }
}
