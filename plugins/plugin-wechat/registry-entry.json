{
  "id": "wechat",
  "name": "WeChat",
  "description": "WeChat connector for Official Account and WeCom self-built app messaging through the first-party platform APIs.",
  "npmName": "@elizaos/plugin-wechat",
  "version": "2.0.3-beta.7",
  "source": "bundled",
  "tags": ["connector", "messaging", "wechat", "social", "social-chat"],
  "config": {
    "ELIZA_WECHAT_WEBHOOK_PORT": {
      "type": "number",
      "required": false,
      "sensitive": false,
      "label": "Callback Port",
      "help": "Public callback listener port for platform message delivery (default: 18790)",
      "advanced": true,
      "min": 1,
      "max": 65535
    }
  },
  "render": {
    "visible": false,
    "pinTo": [],
    "style": "setup-panel",
    "icon": "MessageCircle",
    "group": "connector",
    "groupOrder": 1,
    "actions": ["enable", "configure", "setup-guide"]
  },
  "resources": {
    "setupGuideUrl": "https://docs.eliza.ai/plugin-setup-guide#wechat"
  },
  "dependsOn": [],
  "kind": "connector",
  "subtype": "messaging",
  "auth": {
    "kind": "token",
    "credentialKeys": []
  },
  "channels": ["wechat"]
}
