{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/node",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["./**/*.ts"],
  "exclude": [
    "build.ts",
    "dist",
    "node_modules",
    "__tests__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "vitest*.config.ts"
  ]
}
