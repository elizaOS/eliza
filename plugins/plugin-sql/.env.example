# PGlite Storage
# ────────────────────────────────────────────────────────
# Filesystem directory for PGlite data. Defaults to the
# project-relative .eliza/.elizadb when unset.
PGLITE_DATA_DIR=

# Extra Postgres settings for an in-memory database
# (PGLITE_DATA_DIR=memory://). They are added after PGlite's
# defaults and the built-in ones (shared_buffers=16MB,
# max_wal_size=32MB, min_wal_size=32MB, full_page_writes=off,
# wal_level=minimal, max_wal_senders=0) and win over them.
# Format: name=value pairs separated by commas; a value may not
# contain spaces, commas or "=". A malformed value stops startup.
# max_wal_size and min_wal_size must be at least 32MB, and
# wal_level=minimal needs max_wal_senders=0.
# PGLITE_MEMORY_SETTINGS=shared_buffers=32MB,max_wal_size=64MB

# Set to "1" to disable PGlite extensions (vector, live
# queries, fuzzystrmatch, pg_trgm).
# ELIZA_PGLITE_DISABLE_EXTENSIONS=1

# ────────────────────────────────────────────────────────
# PostgreSQL
# ────────────────────────────────────────────────────────
# When set, use this PostgreSQL connection instead of embedded PGlite.
POSTGRES_URL=

# ────────────────────────────────────────────────────────
# Data Isolation / RLS
# ────────────────────────────────────────────────────────
# Enable row-level security for multi-tenant deployments.
# ENABLE_DATA_ISOLATION=true

# Server ID used as the RLS tenant identifier. Must be a
# valid UUID when ENABLE_DATA_ISOLATION is true.
ELIZA_SERVER_ID=

# ────────────────────────────────────────────────────────
# Migrations
# ────────────────────────────────────────────────────────
# Set to "true" to allow destructive DDL migrations in
# production (e.g., DROP COLUMN, DROP TABLE). Off by
# default in NODE_ENV=production.
# ELIZA_ALLOW_DESTRUCTIVE_MIGRATIONS=true
