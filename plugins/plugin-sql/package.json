{
  "name": "@elizaos/plugin-sql",
  "version": "2.0.3-beta.7",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "eliza-source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js",
      "default": "./dist/drizzle.js"
    },
    "./package.json": "./package.json",
    "./database-utils/carve-out-migration": {
      "types": "./dist/database-utils/carve-out-migration.d.ts",
      "eliza-source": "./src/database-utils/carve-out-migration.ts",
      "import": "./dist/database-utils/carve-out-migration.js",
      "default": "./dist/database-utils/carve-out-migration.js"
    },
    "./database-utils/drizzle-database": {
      "types": "./dist/database-utils/drizzle-database.d.ts",
      "eliza-source": "./src/database-utils/drizzle-database.ts",
      "import": "./dist/database-utils/drizzle-database.js",
      "default": "./dist/database-utils/drizzle-database.js"
    },
    "./database-utils/raw-sql": {
      "types": "./dist/database-utils/raw-sql.d.ts",
      "eliza-source": "./src/database-utils/raw-sql.ts",
      "import": "./dist/database-utils/raw-sql.js",
      "default": "./dist/database-utils/raw-sql.js"
    },
    "./database-utils/pglite-storage": {
      "types": "./dist/database-utils/pglite-storage.d.ts",
      "eliza-source": "./src/database-utils/pglite-storage.ts",
      "import": "./dist/database-utils/pglite-storage.js",
      "default": "./dist/database-utils/pglite-storage.js"
    },
    "./database-utils/sql-compat": {
      "types": "./dist/database-utils/sql-compat.d.ts",
      "eliza-source": "./src/database-utils/sql-compat.ts",
      "import": "./dist/database-utils/sql-compat.js",
      "default": "./dist/database-utils/sql-compat.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [],
  "author": "elizaOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaos-plugins/plugin-sql"
  },
  "scripts": {
    "build": "bun run build.ts",
    "migrate": "cd src && drizzle-kit migrate",
    "migrate:generate": "cd src && drizzle-kit generate",
    "dev": "bun run build.ts --watch",
    "test": "cd src && vitest run",
    "typecheck": "tsc --noEmit -p src/tsconfig.typecheck.json",
    "lint": "bunx @biomejs/biome check --write src build.ts",
    "lint:check": "bunx @biomejs/biome check src build.ts",
    "clean": "node ../../packages/scripts/rm-path-recursive.mjs dist src/dist .turbo",
    "format": "bunx @biomejs/biome format --write src build.ts",
    "format:check": "bunx @biomejs/biome format src build.ts",
    "test:postgres": "bash ../../packages/scripts/plugins/plugin-sql/run-integration-tests.sh --postgres",
    "test:real": "cd src && vitest run --config vitest.real.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@electric-sql/pglite": "^0.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "pg": "^8.23.0",
    "uuid": "^14.0.0",
    "@elizaos/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "@elizaos/core": "workspace:*"
  },
  "gitHead": "05d4ca11d769db8c7f54a722ee24b2ce2b951543",
  "publishConfig": {
    "access": "public"
  },
  "elizaos": {
    "scripts": {
      "testSerial": true,
      "publish": {
        "registryFallbackTag": "beta"
      },
      "devStack": {
        "harnessBuild": true
      },
      "contentContextEvidence": {
        "role": "sql"
      }
    }
  },
  "engines": {
    "node": ">=24"
  }
}
