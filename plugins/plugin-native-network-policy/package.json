{
  "name": "@elizaos/capacitor-network-policy",
  "version": "2.0.5",
  "description": "Android + iOS native shims surfacing the `metered` / `isExpensive` hints used by the voice-model auto-updater (R5-versioning \u00a74).",
  "main": "./dist/plugin.cjs.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "bun": "./dist/esm/index.js",
      "development": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android/src/main",
    "android/build.gradle",
    "ios/Sources",
    "ios/Package.swift",
    "ElizaosCapacitorNetworkPolicy.podspec",
    "dist"
  ],
  "scripts": {
    "build": "bun ../../packages/scripts/with-package-build-lock.ts plugins/plugin-native-network-policy -- bun run build:unlocked",
    "clean": "bun ../../packages/scripts/rm-path-recursive.ts dist",
    "prepublishOnly": "bun run build",
    "build:unlocked": "bun run clean && tsc6 && bunx rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "license": "MIT",
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "devDependencies": {
    "@capacitor/core": "^8.3.1",
    "rollup": "^4.68.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.3.1"
  },
  "elizaos": {
    "platforms": [
      "browser",
      "node"
    ],
    "runtime": "both",
    "platformDetails": {
      "browser": "Web fallback returns unknown cost hints unless Data Saver supplies a restrictive true hint.",
      "node": "Server-side consumers read the bridge through the runtime probe; no Capacitor required."
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
