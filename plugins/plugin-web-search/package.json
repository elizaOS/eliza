{
    "name": "@elizaos/plugin-web-search",
    "version": "2.0.3-beta.7",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "eliza-source": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./*.css": "./dist/*.css",
        "./browser-web-search": {
            "eliza-source": "./src/browser-web-search.ts",
            "types": "./dist/browser-web-search.d.ts",
            "import": "./dist/browser-web-search.js"
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@elizaos/core": "workspace:*"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "tsup": "^8.5.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "scripts": {
        "test": "vitest run --config ./vitest.config.ts",
        "build": "tsup --format esm --dts",
        "dev": "tsup --format esm --dts --watch",
        "lint": "bunx @biomejs/biome check --write --unsafe .",
        "lint:fix": "bunx @biomejs/biome check --write src/",
        "format": "bunx @biomejs/biome format --write .",
        "format:fix": "bunx @biomejs/biome format --write src/",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint:check": "bunx @biomejs/biome check .",
        "format:check": "bunx @biomejs/biome format ."
    },
    "agentConfig": {
        "pluginType": "elizaos:client:1.0.0",
        "pluginParameters": {
            "WEB_SEARCH_BROWSER_PROFILE_ID": {
                "type": "string",
                "description": "Explicit owner grant: exact registered Chromium profile ID permitted for browser-first web searches."
            },
            "WEB_SEARCH_BROWSER_TARGET_ID": {
                "type": "string",
                "description": "Registered profile-bound browser target; defaults to chromium-device. Does not grant access without the exact profile ID."
            }
        }
    }
}
