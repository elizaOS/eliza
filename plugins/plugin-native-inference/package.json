{
  "name": "@elizaos/plugin-native-inference",
  "version": "2.0.3-beta.7",
  "description": "Native inference for AOSP and Capacitor, mobile host bridges, and Android ML Kit OCR.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elizaos/eliza.git",
    "directory": "plugins/plugin-native-inference"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "eliza-source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./llama": {
      "types": "./dist/llama/index.d.ts",
      "eliza-source": "./src/llama/index.ts",
      "import": "./dist/llama/index.js",
      "default": "./dist/llama/index.js"
    },
    "./mlkit-text": {
      "types": "./dist/mlkit-text/index.d.ts",
      "eliza-source": "./src/mlkit-text/index.ts",
      "import": "./dist/mlkit-text/index.js",
      "default": "./dist/mlkit-text/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "eliza-source": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./host-bridge": {
      "types": "./dist/bridge.d.ts",
      "eliza-source": "./src/bridge.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    }
  },
  "files": [
    "dist",
    "src",
    "android",
    "android-bridge"
  ],
  "keywords": [
    "elizaos",
    "plugin",
    "aosp",
    "android",
    "llama.cpp",
    "local-inference",
    "bun-ffi"
  ],
  "author": "elizaOS",
  "license": "MIT",
  "scripts": {
    "build": "node ../../packages/scripts/rm-path-recursive.mjs dist && bun run check:android-manifest && tsc6 --noCheck -p tsconfig.build.json && node ../../packages/scripts/rewrite-dist-relative-imports-node-esm.mjs plugins/plugin-native-inference",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "node ../../packages/scripts/rm-path-recursive.mjs dist .turbo node_modules",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "test": "bun run test:aosp && bun run test:mobile",
    "check:android-manifest": "node ../../packages/scripts/plugins/plugin-native-inference/check-android-manifest.ts",
    "test:aosp": "bun test __tests__",
    "test:mobile": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@elizaos/shared": "workspace:*",
    "ws": "^8.21.3",
    "llama-cpp-capacitor": "^0.1.5"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "bun-types": "1.3.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.3.14",
    "@types/ws": "^8.5.13",
    "vitest": "^5.0.1",
    "@capacitor/core": "^8.3.1"
  },
  "peerDependencies": {
    "@elizaos/core": "workspace:*",
    "@capacitor/core": "^8.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
