  "files": [
    "dist",
    "src",
    "android",
    "android-bridge"
  ],
  "keywords": [
    "elizaos",
    "plugin",
    "aosp",
    "android",
    "llama.cpp",
    "local-inference",
    "bun-ffi"
  ],
  "author": "elizaOS",
  "license": "MIT",
  "scripts": {
    "build": "node ../../packages/scripts/rm-path-recursive.ts dist && bun run check:android-manifest && tsc6 --noCheck -p tsconfig.build.json && node ../../packages/scripts/rewrite-dist-relative-imports-node-esm.ts plugins/plugin-native-inference && node ../../packages/scripts/copy-package-assets.ts plugins/plugin-native-inference src/model-catalog/bge src/model-gpu/profiles",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "node ../../packages/scripts/rm-path-recursive.ts dist .turbo node_modules",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "test": "bun run test:aosp && bun run test:mobile",
    "check:android-manifest": "node ../../packages/scripts/plugins/plugin-native-inference/check-android-manifest.ts",
    "test:aosp": "bun test __tests__",
    "test:mobile": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "ws": "^8.21.3",
    "llama-cpp-capacitor": "^0.1.5",
    "@huggingface/tokenizers": "0.1.3",
    "@elizaos/plugin-elizacloud": "workspace:*",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "bun-types": "1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/ws": "^8.5.13",
    "vitest": "^5.0.1",
    "@capacitor/core": "^8.3.1",
    "@elizaos/testing": "workspace:*"
  },
  "peerDependencies": {
    "@elizaos/core": "workspace:*",
    "@capacitor/core": "^8.3.1",
    "@elizaos/agent": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "peerDependenciesMeta": {
    "@elizaos/agent": {
      "optional": true
    }
  }
}
