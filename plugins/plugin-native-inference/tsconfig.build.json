{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@elizaos/agent": ["./src/type-shims/agent-root.ts"],
      "@elizaos/plugin-local-inference/runtime": [
        "./src/type-shims/plugin-local-inference-runtime.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.e2e.test.ts",
    "**/*.mtp.test.ts"
  ]
}
