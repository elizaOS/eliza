{
  "name": "@elizaos/plugin-personal-assistant",
  "version": "2.0.3-beta.7",
  "type": "module",
  "description": "Personal-assistant orchestration plugin: BRIEF, PRIORITIZE, PERSONAL_ASSISTANT cross-domain orchestration, scheduled-task owner CRUD, and default-pack composition. Slimmed from the legacy plugin-lifeops; domain-specific surfaces have moved to plugin-inbox, plugin-goals, plugin-calendar, plugin-blocker, plugin-finances, plugin-relationships, etc.",
  "sideEffects": [
    "./src/api/client-lifeops.ts",
    "./dist/api/client-lifeops.js",
    "./src/register.ts",
    "./dist/register.js"
  ],
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "eliza-source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "eliza-source": {
        "types": "./src/plugin.ts",
        "import": "./src/plugin.ts",
        "default": "./src/plugin.ts"
      },
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "eliza-source": {
        "types": "./src/*.ts",
        "import": "./src/*.ts",
        "default": "./src/*.ts"
      },
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "lint:default-packs": "node scripts/lint-default-packs.mjs",
    "verify": "bun run lint:default-packs && bun run build:types && bun run test",
    "pretest": "node scripts/lint-default-packs.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:background-real": "vitest run --config vitest.background-real.config.ts test/scheduled-task-end-to-end.e2e.test.ts test/reminder-review-job.real.e2e.test.ts test/lifeops-scheduling.real.test.ts test/schedule-merged-state.real.test.ts",
    "test:integration": "vitest run --config vitest.src-integration.config.ts && cd \"$(git rev-parse --show-toplevel)\" && vitest run --config packages/scripts/vitest/integration.config.ts plugins/plugin-personal-assistant/test/integration-lane.smoke.integration.test.ts plugins/plugin-personal-assistant/test/life-smoke.integration.test.ts",
    "test:connections:e2e": "bun test/browser-e2e/run-lifeops-connections-e2e.mjs",
    "test:scenarios": "cd ../.. && SCENARIO_USE_DETERMINISTIC_MODEL=1 bun packages/scenario-runner/src/cli.ts run packages/test/scenarios/reminders --lane pr-deterministic && cd plugins/plugin-personal-assistant && bun run test:scenarios:lifeops-spine",
    "test:scenarios:lifeops-spine": "cd ../.. && SCENARIO_USE_DETERMINISTIC_MODEL=1 bun packages/scenario-runner/src/cli.ts run packages/scenario-runner/test/scenarios --lane pr-deterministic --scenario deterministic-lifeops-scheduled-tasks,deterministic-lifeops-dispatch-retry,deterministic-lifeops-recurrence,deterministic-lifeops-concurrent-day,deterministic-lifeops-multiday-journey,deterministic-lifeops-brief-recalibrate",
    "test:scenarios:list": "cd ../.. && bun packages/scenario-runner/src/cli.ts list plugins/plugin-personal-assistant/test/scenarios",
    "bench:work-threads": "cd ../.. && bun plugins/plugin-personal-assistant/scripts/work-thread-benchmark.ts",
    "verify:live-schedule": "bun run ./scripts/verify-live-schedule-data.ts",
    "build": "bun run build:js && bun run build:views && bun run build:types",
    "clean": "node ../../packages/scripts/rm-path-recursive.mjs dist",
    "build:js": "bun run clean && tsup --config tsup.config.ts",
    "build:views": "bunx --bun vite build --config vite.config.views.ts",
    "build:types": "tsc6 --noCheck -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "dependencies": {
    "@capacitor/core": "8.4.0",
    "@elizaos/agent": "workspace:*",
    "@elizaos/app-core": "workspace:*",
    "@elizaos/capacitor-calendar": "workspace:*",
    "@elizaos/capacitor-mobile-signals": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/macosreminders": "workspace:*",
    "@elizaos/native-activity-tracker": "workspace:*",
    "@elizaos/plugin-blocker": "workspace:*",
    "@elizaos/plugin-browser": "workspace:*",
    "@elizaos/plugin-calendar": "workspace:*",
    "@elizaos/plugin-discord": "workspace:*",
    "@elizaos/plugin-elizacloud": "workspace:*",
    "@elizaos/plugin-finances": "workspace:*",
    "@elizaos/plugin-goals": "workspace:*",
    "@elizaos/plugin-google-workspace": "workspace:*",
    "@elizaos/plugin-health": "workspace:*",
    "@elizaos/plugin-imessage": "workspace:*",
    "@elizaos/plugin-inbox": "workspace:*",
    "@elizaos/plugin-phone": "workspace:*",
    "@elizaos/plugin-pdf": "workspace:*",
    "@elizaos/plugin-reminders": "workspace:*",
    "@elizaos/plugin-scheduling": "workspace:*",
    "@elizaos/plugin-telegram": "workspace:*",
    "@elizaos/plugin-vision": "workspace:*",
    "@elizaos/plugin-whatsapp": "workspace:*",
    "@elizaos/plugin-x": "workspace:*",
    "@elizaos/shared": "workspace:*",
    "@elizaos/ui": "workspace:*",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.0.0",
    "react-plaid-link": "^5.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@electric-sql/pglite": "^0.4.0",
    "@types/jsdom": "^30.0.0",
    "bun-types": "1.4.0",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.4.0",
    "google-auth-library": "^10.0.0",
    "jsdom": "^29.0.0",
    "json5": "^2.2.3",
    "playwright": "1.62.1",
    "ts-morph": "28.0.0",
    "tsup": "^8.5.1",
    "react-dom": "*",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {}
  },
  "elizaos": {
    "appRegister": "register",
    "app": {
      "heroImage": "assets/hero.png",
      "featured": true,
      "permissions": [
        "reminders",
        "calendar",
        "notes"
      ]
    },
    "scripts": {
      "testSerial": true,
      "testLanes": [
        "client"
      ],
      "devStack": {
        "skipInDevAll": true
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ]
}
