# =============================================================================
# @elizaos/plugin-kamino — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# Solana RPC endpoint.
# Use a private RPC for production (Helius, QuickNode, Triton, etc.)
# Public endpoints are rate-limited and not recommended for mainnet use.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Base58-encoded private key of the wallet the agent will sign transactions with.
# Use a DEDICATED wallet — the agent has full signing authority over these funds.
SOLANA_PRIVATE_KEY=your_base58_private_key_here

# ── Optional — Wallet ─────────────────────────────────────────────────────────

# Alternative to SOLANA_PRIVATE_KEY: path to a Solana keypair JSON file.
# Only one of SOLANA_PRIVATE_KEY or SOLANA_KEYPAIR_PATH is needed.
# SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# ── Optional — WebSocket ──────────────────────────────────────────────────────

# WebSocket URL for transaction confirmations.
# If not set, auto-derived from SOLANA_RPC_URL (https→wss, http→ws).
# Set explicitly if your RPC provider uses a different WS endpoint,
# or when testing with a local validator (e.g. Surfpool, solana-test-validator).
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ── Optional — Kamino ─────────────────────────────────────────────────────────

# JSON array of Kamino markets to load.
# Defaults to the Main market if not set.
# Format: [{"name":"<label>","address":"<market_pubkey>"}]
# KAMINO_MARKETS=[{"name":"main","address":"7u3HeHxYDLhnCoErrtycNokbQYbWGzLs6JSDqGAv5PfF"}]

# How often (ms) to refresh reserve data from the chain. Default: 30000 (30s).
# KAMINO_REFRESH_MS=30000

# ── LLM Provider (choose one) ─────────────────────────────────────────────────

# OpenRouter (supports 200+ models via a single API key)
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Google AI Studio (free tier available at aistudio.google.com)
# GOOGLE_GENERATIVE_AI_API_KEY=your_key_here

# OpenAI
# OPENAI_API_KEY=sk-your_key_here

# Groq (free tier, very fast)
# GROQ_API_KEY=gsk_your_key_here
