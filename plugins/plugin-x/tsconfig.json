{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@elizaos/plugin-elizacloud/cloud-config/dev-cloud-env-authority": [
        "../plugin-elizacloud/src/cloud-config/dev-cloud-env-authority.ts"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.e2e.test.ts"
  ]
}
