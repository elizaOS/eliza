{
  "name": "@elizaos/plugin-security-gate",
  "version": "2.0.4",
  "description": "Deterministic local prompt injection defense, AST code sandboxing, and autonomous agent safety guardrails for ElizaOS",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run"
  },
  "keywords": [
    "elizaos",
    "eliza",
    "ai-agent",
    "security",
    "prompt-injection",
    "guardrails",
    "x402",
    "safety"
  ],
  "author": "Security Gate Team",
  "license": "MIT",
  "dependencies": {
    "@elizaos/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
