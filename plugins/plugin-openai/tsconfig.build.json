{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@elizaos/core": [
        "../../packages/core/dist/index.d.ts"
      ]
    },
    "incremental": false,
    "composite": false
  },
  "include": [
    "index.ts",
    "utils/config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__",
    "**/*.test.ts",
    "build.ts",
    "vitest.real-runtime.config.ts"
  ]
}
