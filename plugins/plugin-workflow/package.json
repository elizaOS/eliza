{
  "name": "@elizaos/plugin-workflow",
  "version": "2.0.3-beta.7",
  "description": "ElizaOS plugin for generating and running workflows in-process",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "eliza-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./services/hosted-native-source": {
      "eliza-source": "./src/services/hosted-native-source.ts",
      "types": "./src/services/hosted-native-source.ts",
      "import": "./dist/services/hosted-native-source.js",
      "default": "./dist/services/hosted-native-source.js"
    }
  },
  "files": [
    "registry-entry.json",
    "dist",
    "src",
    "auto-enable.ts"
  ],
  "elizaos": {
    "plugin": {
      "autoEnableModule": "./auto-enable.ts",
      "capabilities": [
        "workflow",
        "automation"
      ]
    },
    "scripts": {
      "mobileWorkflowArtifact": true
    }
  },
  "scripts": {
    "build": "node ../../packages/scripts/rm-path-recursive.ts dist && tsc6 --noCheck -p tsconfig.json",
    "dev": "tsc6 --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node ../../packages/scripts/run-with-flake-retry.ts 'EEXIST[^\\n]*epoll_ctl|error: Failed to connect' -- node ../../packages/scripts/run-with-deadline.ts 1500000 -- node ../../packages/scripts/plugins/plugin-workflow/run-isolated-tests.ts",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "keywords": [
    "elizaos",
    "plugin",
    "workflows",
    "workflow",
    "automation",
    "ai"
  ],
  "author": "Eliza Cloud Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elizaos-plugins/plugin-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/elizaos-plugins/plugin-workflow/issues"
  },
  "homepage": "https://github.com/elizaos-plugins/plugin-workflow#readme",
  "peerDependencies": {
    "@elizaos/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.2.17",
    "@elizaos/core": "workspace:*",
    "bun-types": "1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {}
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@elizaos/host": "workspace:*",
    "@smthrs/engine": "0.35.0",
    "@types/bun": "1.4.2",
    "@types/json-schema": "7.0.15",
    "@types/node": "^25.1.0",
    "@types/react": "19.3.0",
    "buffer": "6.0.3",
    "drizzle-orm": "0.45.3",
    "effect": "4.0.0-beta.105",
    "smthrs": "0.35.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.5",
    "@elizaos/contracts": "workspace:*"
  }
}
