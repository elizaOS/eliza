import ai.eliza.voice.SpeechRequestGate;
import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.nio.file.Files;
import java.util.Arrays;
import java.util.HashMap;
import java.util.UUID;
import java.util.concurrent.CountDownLatch;

public final class PreparedSpeechPublicationProbe {
  private final File cache;
  private final SpeechRequestGate gate = new SpeechRequestGate();
  private File playbackFile;
  private Object streamPlayback;
  private boolean destroyed;
  private String playbackRequestId, playbackId;
  private final String playbackPrefix = "speech-probe-";
  private Runnable beforePublication = () -> {};
  private int cleared;
  private final Main main = new Main();

  PreparedSpeechPublicationProbe(File cache) { this.cache = cache; }
  private final class Main {
    void post(Runnable task) { beforePublication.run(); task.run(); }
  }
  private final class Context { File getCacheDir() { return cache; } }
  private Context getContext() { return new Context(); }
  private void clearPlayback() {
    cleared++;
    streamPlayback = null;
    if (playbackFile != null) playbackFile.delete();
    playbackFile = null;
    playbackId = null;
    playbackRequestId = null;
  }
  private static final class PluginCall {
    final boolean replace;
    PluginCall(boolean replace) { this.replace = replace; }
    Boolean getBoolean(String key, boolean fallback) { return replace; }
    String getString(String key) { return "prepared"; }
  }
  private static final class JSObject extends HashMap<String, Object> {}

  // PRODUCTION_PREDICATES
  // PRODUCTION_PUBLICATION

  private static void expect(boolean condition, String detail) {
    if (!condition) throw new AssertionError(detail);
  }
  public static void main(String[] args) throws Exception {
    String scenario = args[0];
    File cache = new File(args[1]);
    PreparedSpeechPublicationProbe h = new PreparedSpeechPublicationProbe(cache);
    boolean replace = scenario.equals("explicit-replacement");
    Object existingStream = new Object();
    expect(!h.speakerBusy(), "an empty playback slot and request gate are idle");
    SpeechRequestGate.Request request = h.gate.admit("prepared", replace).request;
    expect(request != null && h.speakerBusy(), "the publishing request owns the request gate");
    switch (scenario) {
      case "late-stream":
      case "explicit-replacement":
        h.beforePublication = () -> h.streamPlayback = existingStream;
        break;
      case "existing-clip":
        h.playbackFile = Files.createTempFile(cache.toPath(), "existing", ".wav").toFile();
        break;
      case "cancelled":
        h.beforePublication = () -> { h.streamPlayback = existingStream; request.cancel(); };
        break;
      case "empty-speaker":
        break;
      default:
        throw new AssertionError("unknown schedule " + scenario);
    }
    File existingClip = h.playbackFile;
    byte[] audio = {42, 17, 3};
    h.publishPreparedAudio(new PluginCall(replace), request, audio);
    expect(Arrays.equals(audio, new byte[3]), "prepared bytes were not cleared");
    int files = cache.list().length;
    switch (scenario) {
      case "late-stream":
        expect(h.streamPlayback == existingStream && h.cleared == 0,
            "replace:false interrupted the stream during publication");
        expect("playback-busy".equals(request.failureCode) && request.result == null && files == 0,
            "busy stream refusal must remove the attempted clip");
        break;
      case "existing-clip":
        expect(h.playbackFile == existingClip && h.cleared == 0 && files == 1,
            "replace:false interrupted the existing clip");
        expect("playback-busy".equals(request.failureCode) && request.result == null,
            "busy clip must refuse the new request");
        break;
      case "cancelled":
        expect("Voice request cancelled".equals(request.failure) && request.result == null && files == 0,
            "cancelled publication must clean up its new clip");
        expect(h.streamPlayback == existingStream && h.cleared == 0,
            "cancelled publication interrupted the existing stream");
        break;
      default:
        expect(h.cleared == 1 && h.streamPlayback == null && h.playbackFile != null && files == 1,
            "admitted publication must own the new clip");
        expect(request.result instanceof JSObject && "prepared".equals(h.playbackRequestId),
            "admitted publication must keep its own request identity");
        break;
    }
    h.gate.settle(request);
    expect(h.gate.idle(), "the original request must release its own gate");
  }
}
