{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": [
			"src/**",
			"quint/LiveCaptureLifecycle.cases.json",
			"quint/check-live-capture-lifecycle.mjs",
			"quint/coverage.json",
			"*.ts",
			"*.json"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"formatter": {
		"enabled": true
	}
}
