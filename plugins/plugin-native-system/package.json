{
  "name": "@elizaos/capacitor-system",
  "version": "2.0.3-beta.7",
  "description": "Android system-role status bridge for ElizaOS.",
  "main": "./dist/plugin.cjs.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./package.json": "./package.json",
    "./launcher": {
      "eliza-source": "./src/client/launcher.ts",
      "types": "./dist/esm/client/launcher.d.ts",
      "import": "./dist/esm/client/launcher.js"
    },
    "./shade": {
      "eliza-source": "./src/client/shade.ts",
      "types": "./dist/esm/client/shade.d.ts",
      "import": "./dist/esm/client/shade.js",
      "default": "./dist/esm/client/shade.js"
    },
    "./sense": {
      "eliza-source": "./src/sense-bridge.ts",
      "types": "./dist/esm/sense-bridge.d.ts",
      "import": "./dist/esm/sense-bridge.js",
      "default": "./dist/esm/sense-bridge.js"
    },
    "./reset": {
      "eliza-source": "./src/reset.ts",
      "types": "./dist/esm/reset.d.ts",
      "import": "./dist/esm/reset.js",
      "default": "./dist/esm/reset.js"
    },
    "./settings": {
      "eliza-source": "./src/settings.ts",
      "types": "./dist/esm/settings.d.ts",
      "import": "./dist/esm/settings.js",
      "default": "./dist/esm/settings.js"
    }
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "dist"
  ],
  "scripts": {
    "build": "node ../../packages/scripts/with-package-build-lock.ts plugins/plugin-native-system -- bun run build:unlocked",
    "clean": "node ../../packages/scripts/rm-path-recursive.ts dist",
    "prepublishOnly": "bun run build",
    "build:unlocked": "bun run clean && tsc6 && bunx rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "devDependencies": {
    "@capacitor/core": "^8.3.1",
    "rollup": "^4.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "@types/ws": "^8.18.1"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.3.1"
  },
  "elizaos": {
    "platforms": [
      "browser",
      "node"
    ],
    "runtime": "both",
    "platformDetails": {
      "browser": "Web fallback reports no Android roles.",
      "android": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "ws": "^8.21.3"
  }
}
