{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "types": ["node", "vite/client"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@elizaos/cloud-sdk/*": ["../../packages/cloud/sdk/src/*"],
      "@elizaos/app": ["../../packages/app/src/index.ts"],
      "@elizaos/app/*": ["../../packages/app/src/*"],
      "@elizaos/ui/*": ["../../packages/ui/src/*"],
      "@elizaos/core/*": ["../../packages/core/src/*"],
      "@elizaos/agent/*": ["../../packages/agent/src/*"],
      "@elizaos/plugin-google-workspace/*": ["../plugin-google-workspace/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["src/**/*.stories.ts", "src/**/*.stories.tsx"]
}
