{
  "name": "@elizaos/capacitor-owned-media",
  "version": "2.0.3-beta.7",
  "description": "Android owned-media primitives for Eliza hosts: photo edit copies, filters and explicitly kept captures in the host's own MediaStore items.",
  "files": [
    "android/src/main/",
    "android/build.gradle"
  ],
  "author": "elizaOS",
  "license": "MIT",
  "repository": {
    "type": "git",
