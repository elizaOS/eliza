{
  "id": "aomi",
  "name": "Aomi",
  "description": "Delegate open-ended on-chain workflows to Aomi while keeping signing and confirmation inside the Eliza wallet.",
  "npmName": "@elizaos/plugin-aomi",
  "version": "2.0.3-beta.7",
  "source": "bundled",
  "tags": ["aomi", "crypto", "onchain", "evm", "solana"],
  "config": {
    "AOMI_API_URL": {
      "type": "url",
      "required": false,
      "sensitive": false,
      "default": "https://api.aomi.dev",
      "label": "Aomi API URL",
      "help": "Backend base URL for Aomi agent requests.",
      "advanced": false
    },
    "AOMI_API_KEY": {
      "type": "secret",
      "required": false,
      "sensitive": true,
      "label": "Aomi API Key",
      "help": "Optional key for a private Aomi app namespace.",
      "advanced": false
    },
    "AOMI_APP": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "default": "default",
      "label": "Aomi App",
      "help": "Aomi app key used for delegated requests.",
      "advanced": false
    },
    "AOMI_APPLICATION_ID": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Application ID",
      "help": "Optional concrete Aomi application id.",
      "advanced": true
    },
    "AOMI_CHAIN_ID": {
      "type": "number",
      "required": false,
      "sensitive": false,
      "default": 1,
      "label": "Default Chain ID",
      "help": "Default EVM chain id supplied with the Eliza wallet.",
      "advanced": true
    },
    "AOMI_EVM_RPC_URL": {
      "type": "url",
      "required": false,
      "sensitive": true,
      "label": "EVM RPC URL",
      "help": "Optional RPC override for submitting Aomi-built EVM transactions.",
      "advanced": true
    }
  },
  "render": {
    "visible": true,
    "pinTo": [],
    "style": "card",
    "icon": "Orbit",
    "group": "blockchain",
    "groupOrder": 4,
    "actions": ["enable", "configure"]
  },
  "resources": {
    "homepage": "https://aomi.dev",
    "repository": "https://github.com/elizaOS/eliza/tree/develop/plugins/plugin-aomi",
    "setupGuideUrl": "https://github.com/elizaOS/eliza/tree/develop/plugins/plugin-aomi#readme"
  },
  "dependsOn": ["wallet"],
  "kind": "plugin",
  "subtype": "blockchain"
}
