{
  "id": "whatsapp",
  "name": "Whatsapp",
  "description": "Direct WhatsApp messaging through the bundled in-process Baileys library and QR pairing.",
  "npmName": "@elizaos/plugin-whatsapp",
  "version": "2.0.0-beta.0",
  "source": "bundled",
  "tags": [
    "whatsapp",
    "connector",
    "social",
    "social-chat",
    "messaging"
  ],
  "config": {
    "WHATSAPP_AUTH_DIR": {
      "type": "file-path",
      "required": false,
      "sensitive": false,
      "label": "Auth Dir",
      "help": "Directory used to persist Baileys session files (required for baileys auth)",
      "advanced": false
    },
    "WHATSAPP_PRINT_QR": {
      "type": "boolean",
      "required": false,
      "sensitive": false,
      "label": "Print Qr",
      "help": "Print QR code in terminal when using Baileys auth",
      "advanced": false
    },
    "WHATSAPP_DM_POLICY": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Dm Policy",
      "help": "DM policy (e.g. allow, deny, allowlist)",
      "advanced": false
    },
    "WHATSAPP_GROUP_POLICY": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Group Policy",
      "help": "Group message policy",
      "advanced": false
    }
  },
  "render": {
    "visible": true,
    "pinTo": [],
    "style": "setup-panel",
    "icon": "Smartphone",
    "group": "connector",
    "groupOrder": 1,
    "actions": [
      "enable",
      "configure",
      "setup-guide"
    ]
  },
  "resources": {
    "homepage": "https://github.com/elizaos/eliza#readme",
    "repository": "https://github.com/elizaos/eliza",
    "setupGuideUrl": "https://docs.eliza.ai/plugin-setup-guide#whatsapp"
  },
  "dependsOn": [],
  "kind": "connector",
  "subtype": "messaging",
  "accounts": {
    "agent": {
      "supported": true,
      "authKind": "qr",
      "credentialKeys": []
    }
  },
  "channels": [
    "whatsapp"
  ]
}
