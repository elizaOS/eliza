<?xml version="1.0" encoding="utf-8"?>
<!-- Host configuration. Hosts override these values with resources of the same name.
     Preserve deployed alias, AAD and directory values when upgrading. -->
<resources>
    <!-- Directory under Context#getNoBackupFilesDir; never under backed-up storage. -->
    <string name="eliza_passwords_vault_directory" translatable="false">eliza-passwords</string>
    <string name="eliza_passwords_key_alias" translatable="false">eliza.passwords.vault.v1</string>
    <string name="eliza_passwords_vault_aad" translatable="false">eliza.passwords.vault.v1</string>
    <!-- Keystore and UI unlock window in seconds (15..300). -->
    <integer name="eliza_passwords_unlock_seconds">60</integer>
    <!-- Accept Class 3 (strong) biometrics as well as the device credential. -->
    <bool name="eliza_passwords_allow_biometric">true</bool>
    <!-- True only when the host app is itself a browser whose WebViews report
         PasswordFormPolicy.TOP_ORIGIN_EXTRA for the committed top-level document. -->
    <bool name="eliza_passwords_host_is_browser">false</bool>
    <!-- Other browsers whose web-domain metadata is trusted: "package:sha256-of-signing-cert". -->
    <string-array name="eliza_passwords_trusted_browsers" translatable="false" />
    <string name="eliza_passwords_token_scheme" translatable="false">eliza-passwords</string>

    <string name="eliza_passwords_service_label">Saved passwords</string>
    <string name="eliza_passwords_unlock_title">Unlock saved passwords</string>
    <string name="eliza_passwords_unlock_subtitle">Confirm it\'s you to use your saved passwords</string>
    <string name="eliza_passwords_fill_offer">Fill with a saved password</string>
    <string name="eliza_passwords_fill_title">Choose a sign-in</string>
    <string name="eliza_passwords_fill_for">For %1$s</string>
    <string name="eliza_passwords_fill_none">No saved sign-ins for %1$s</string>
    <string name="eliza_passwords_cancel">Cancel</string>
    <string name="eliza_passwords_save_title">Save password?</string>
    <string name="eliza_passwords_update_title">Update saved password?</string>
    <string name="eliza_passwords_save">Save</string>
    <string name="eliza_passwords_not_now">Not now</string>
    <string name="eliza_passwords_saved">Password saved</string>
    <string name="eliza_passwords_no_username">No username</string>
    <string name="eliza_passwords_hide">Hide</string>
    <string name="eliza_passwords_copied">Password copied. It will be cleared from the clipboard shortly.</string>
    <string name="eliza_passwords_unavailable">Saved passwords are unavailable</string>
    <string name="eliza_passwords_no_screen_lock">Set a screen lock to use saved passwords</string>
    <string name="eliza_passwords_save_failed">The password was not saved</string>
</resources>
