{
  "name": "@elizaos/plugin-calendar",
  "version": "2.0.3-beta.7",
  "type": "module",
  "description": "First-class calendar plugin for elizaOS agents: Google, Microsoft, Apple, and ICS feeds; scheduling; event management; and owner-facing calendar views.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register": {
      "eliza-source": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    },
    "./api/client-calendar": {
      "eliza-source": "./src/api/client-calendar.ts",
      "types": "./dist/api/client-calendar.d.ts",
      "import": "./dist/api/client-calendar.js",
      "default": "./dist/api/client-calendar.js"
    },
    "./linked-sync": {
      "eliza-source": "./src/linked-sync/index.ts",
      "types": "./dist/linked-sync/index.d.ts",
      "import": "./dist/linked-sync/index.js",
      "default": "./dist/linked-sync/index.js"
    },
    "./client/availability-review": {
      "eliza-source": "./src/client/availability-review.ts",
      "types": "./dist/client/availability-review.d.ts",
      "import": "./dist/client/availability-review.js",
      "default": "./dist/client/availability-review.js"
    },
    "./format": {
      "eliza-source": "./src/internal/format.ts",
      "types": "./src/internal/format.ts",
      "import": "./dist/internal/format.js",
      "default": "./dist/internal/format.js"
    },
    "./mutations/ledger": {
      "eliza-source": "./src/mutations/ledger.ts",
      "types": "./dist/mutations/ledger.d.ts",
      "import": "./dist/mutations/ledger.js",
      "default": "./dist/mutations/ledger.js"
    },
    "./mutations/execution": {
      "eliza-source": "./src/mutations/execution.ts",
      "types": "./dist/mutations/execution.d.ts",
      "import": "./dist/mutations/execution.js",
      "default": "./dist/mutations/execution.js"
    },
    "./mutations/types": {
      "eliza-source": "./src/mutations/types.ts",
      "types": "./dist/mutations/types.d.ts",
      "import": "./dist/mutations/types.js",
      "default": "./dist/mutations/types.js"
    },
    "./mutations/schema": {
      "eliza-source": "./src/mutations/schema.ts",
      "types": "./dist/mutations/schema.d.ts",
      "import": "./dist/mutations/schema.js",
      "default": "./dist/mutations/schema.js"
    },
    "./mutations/port": {
      "eliza-source": "./src/mutations/port.ts",
      "types": "./dist/mutations/port.d.ts",
      "import": "./dist/mutations/port.js",
      "default": "./dist/mutations/port.js"
    },
    "./mutations/managed": {
      "eliza-source": "./src/mutations/managed.ts",
      "types": "./dist/mutations/managed.d.ts",
      "import": "./dist/mutations/managed.js",
      "default": "./dist/mutations/managed.js"
    }
  },
  "scripts": {
    "verify": "bun run build:types && bun run test",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:js && bun run build:views && bun run build:types",
    "clean": "node ../../packages/scripts/rm-path-recursive.ts dist .turbo",
    "build:js": "bun run clean && tsup --config ../tsup.plugin-packages.shared.ts",
    "build:views": "vite build --config vite.config.views.ts",
    "build:types": "tsc6 --noCheck -p tsconfig.build.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "dependencies": {
    "@capacitor/core": "8.4.0",
    "@elizaos/capacitor-calendar": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/host": "workspace:*",
    "@elizaos/plugin-assistant": "workspace:*",
    "@elizaos/plugin-google-workspace": "workspace:*",
    "@elizaos/plugin-scheduling": "workspace:*",
    "@elizaos/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.0.0",
    "zod": "^4.6.5",
    "@elizaos/contracts": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@electric-sql/pglite": "^0.4.0",
    "bun-types": "1.4.2",
    "googleapis": "^169.0.0",
    "tsup": "^9.0.0",
    "react-dom": "*",
    "vitest": "^5.0.5",
    "vite": "^8.3.3"
  },
  "peerDependencies": {
    "@elizaos/plugin-sql": "workspace:*",
    "react": "*",
    "react-dom": "*"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "MICROSOFT_CLIENT_ID": {
        "type": "string",
        "description": "Microsoft identity platform application (client) ID for Calendar OAuth.",
        "required": false,
        "sensitive": false
      },
      "MICROSOFT_CLIENT_SECRET": {
        "type": "string",
        "description": "Microsoft identity platform client secret for confidential Calendar OAuth clients.",
        "required": false,
        "sensitive": true
      },
      "MICROSOFT_REDIRECT_URI": {
        "type": "string",
        "description": "Microsoft OAuth redirect URI registered for Calendar connect callbacks.",
        "required": false,
        "sensitive": false
      },
      "MICROSOFT_TENANT_ID": {
        "type": "string",
        "description": "Microsoft tenant id (or common/organizations/consumers) for Calendar OAuth.",
        "required": false,
        "sensitive": false
      },
      "GOOGLE_CALENDAR_WEBHOOK_ENABLED": {
        "type": "boolean",
        "description": "Explicitly enables the public Google Calendar push-notification endpoint and watch creation.",
        "required": false,
        "default": false,
        "sensitive": false
      },
      "GOOGLE_CALENDAR_WEBHOOK_URL": {
        "type": "string",
        "description": "Public HTTPS callback URL ending in /api/lifeops/calendar/google/webhook.",
        "required": false,
        "sensitive": false
      }
    }
  },
  "elizaos": {
    "appRegister": {
      "export": "registerCalendarApp",
      "subpath": "register"
    },
    "app": {
      "permissions": [
        "calendar"
      ]
    },
    "scripts": {
      "coreBuild": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "assets",
    "dist"
  ]
}
