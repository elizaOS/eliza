{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declarationDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "ignoreDeprecations": "6.0",
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "__tests__", "../dist"]
}
