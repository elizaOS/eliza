{
  "extends": "../../tsconfig.build.template.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "types": ["node", "bun"],
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],
  "exclude": [
    "./__tests__/**",
    "./**/*.test.ts",
    "./dist/**",
    "./build.ts",
    "vitest.config.ts"
  ]
}
