{
  "id": "fish-audio",
  "name": "Fish Audio",
  "description": "Governance-gated Fish Audio realtime text-to-speech provider for elizaOS.",
  "npmName": "@elizaos/plugin-fish-audio",
  "version": "0.1.0",
  "source": "bundled",
  "tags": ["ai-provider", "voice", "text-to-speech", "tts", "streaming"],
  "config": {
    "ELIZA_TTS_FISH_ENABLED": {
      "type": "boolean",
      "required": false,
      "sensitive": false,
      "default": false,
      "label": "Enable Fish Audio",
      "help": "Registers the Fish Audio TTS handler only when governance approval and credentials are also present.",
      "advanced": false
    },
    "FISH_AUDIO_DATA_GOVERNANCE_APPROVED": {
      "type": "boolean",
      "required": false,
      "sensitive": false,
      "default": false,
      "label": "Data Governance Approved",
      "help": "Operator attestation that sending text and voice references to Fish Audio is approved for this deployment.",
      "advanced": false
    },
    "FISH_AUDIO_API_KEY": {
      "type": "secret",
      "required": true,
      "sensitive": true,
      "label": "Fish Audio API Key",
      "advanced": false
    },
    "FISH_AUDIO_MODEL": {
      "type": "select",
      "required": false,
      "sensitive": false,
      "default": "s2.1-pro",
      "label": "Fish Audio Model",
      "advanced": false,
      "options": [
        { "value": "s1", "label": "S1" },
        { "value": "s2-pro", "label": "S2 Pro" },
        { "value": "s2.1-pro", "label": "S2.1 Pro" },
        { "value": "s2.1-pro-free", "label": "S2.1 Pro Free" }
      ]
    },
    "FISH_AUDIO_REFERENCE_ID": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Reference ID",
      "help": "Consented Fish Audio voice/reference identifier.",
      "advanced": false
    },
    "FISH_AUDIO_VOICE_ID": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Voice ID",
      "help": "Compatibility alias for the consented reference identifier.",
      "advanced": true
    },
    "FISH_AUDIO_FORMAT": {
      "type": "select",
      "required": false,
      "sensitive": false,
      "default": "pcm",
      "label": "Audio Format",
      "advanced": true,
      "options": [{ "value": "pcm", "label": "PCM16" }]
    },
    "FISH_AUDIO_SAMPLE_RATE": {
      "type": "number",
      "required": false,
      "sensitive": false,
      "default": 24000,
      "label": "Sample Rate",
      "advanced": true,
      "min": 24000,
      "max": 24000,
      "unit": "Hz"
    },
    "FISH_AUDIO_MAX_BUFFER_BYTES": {
      "type": "number",
      "required": false,
      "sensitive": false,
      "default": 16777216,
      "label": "Maximum Buffered Audio",
      "advanced": true,
      "min": 1,
      "unit": "bytes"
    },
    "FISH_AUDIO_SYNTHESIS_TIMEOUT_MS": {
      "type": "number",
      "required": false,
      "sensitive": false,
      "default": 120000,
      "label": "Synthesis Timeout",
      "advanced": true,
      "min": 1,
      "unit": "ms"
    }
  },
  "render": {
    "visible": true,
    "pinTo": [],
    "style": "card",
    "icon": "AudioWaveform",
    "group": "ai-provider",
    "groupOrder": 30,
    "actions": ["enable", "configure"]
  },
  "resources": {
    "homepage": "https://github.com/elizaOS/eliza/tree/develop/plugins/plugin-fish-audio#readme",
    "repository": "https://github.com/elizaOS/eliza"
  },
  "dependsOn": [],
  "kind": "plugin",
  "subtype": "ai-provider"
}
