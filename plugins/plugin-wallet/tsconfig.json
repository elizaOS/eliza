{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@elizaos/plugin-elizacloud": [
        "../plugin-elizacloud/src/index.ts"
      ],
      "@elizaos/cloud-sdk": [
        "../../packages/cloud/sdk/src/index.ts"
      ],
      "@elizaos/plugin-elizacloud/cloud-config/dev-cloud-env-authority": [
        "../plugin-elizacloud/src/cloud-config/dev-cloud-env-authority.ts"
      ],
      "@elizaos/plugin-assistant/text/template-rendering": [
        "../plugin-assistant/src/text/template-rendering.ts"
      ],
      "@elizaos/plugin-elizacloud/cloud-config/base-url": [
        "../plugin-elizacloud/src/cloud-config/base-url.ts"
      ],
      "@elizaos/cloud-sdk/*": [
        "../../packages/cloud/sdk/src/*"
      ]
    },
    "types": [
      "node",
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/ui/**",
    "src/ui.ts",
    "src/register.ts",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.e2e.test.ts",
    "build.ts"
  ]
}
