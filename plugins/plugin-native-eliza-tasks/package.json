{
  "name": "@elizaos/capacitor-eliza-tasks",
  "version": "2.0.3-beta.7",
  "description": "Bridges iOS BGTaskScheduler (BGAppRefreshTask + BGProcessingTask) wake events into the Eliza Capacitor runtime.",
  "keywords": [
    "background",
    "bgtaskscheduler",
    "ios",
    "wake",
    "eliza"
  ],
  "main": "./dist/plugin.cjs.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources/",
    "*.podspec",
    "dist"
  ],
  "author": "elizaOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaOS/eliza"
  },
  "scripts": {
    "build": "node ../../packages/scripts/with-package-build-lock.mjs plugins/plugin-native-eliza-tasks -- bun run build:unlocked",
    "clean": "node ../../packages/scripts/rm-path-recursive.mjs dist",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "watch": "tsc6 --watch",
    "build:unlocked": "bun run clean && bunx tsc6 -p tsconfig.json && bunx rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format ."
  },
  "devDependencies": {
    "@capacitor/core": "^8.3.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "rollup": "^4.63.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "capacitor": {
    "ios": {
      "src": "ios",
      "podName": "ElizaosCapacitorElizaTasks"
    },
    "android": {
      "src": "android"
    }
  },
  "elizaos": {
    "platforms": [
      "browser",
      "node"
    ],
    "runtime": "both",
    "platformDetails": {
      "browser": "Unsupported web fallback; BGTaskScheduler is iOS-only.",
      "node": "No desktop equivalent; runtime ignores this plugin off-mobile.",
      "ios": true,
      "android": false
    }
  }
}
