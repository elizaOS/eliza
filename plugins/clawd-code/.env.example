# Clawd Code — Environment Configuration
# Copy to ~/.clawd-code/.env and fill in your values

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Default mode: code, trade, research, image, voice
CLAWD_MODE=code

# Grok model: grok-4.3, grok-4.20-multi-agent (for research)
CLAWD_MODEL=grok-4.20-multi-agent

# Agent count for multi-agent research: 4 (fast) or 16 (deep)
CLAWD_AGENT_COUNT=4

# =============================================================================
# AI PROVIDERS (xAI or OpenRouter)
# =============================================================================

# Provider preference: xai (default), openrouter, or deepseek
CLAWD_PROVIDER=xai

# xAI API key for Grok (get from console.x.ai)
XAI_API_KEY=

# DeepSeek API key (get from platform.deepseek.com)
DEEPSEEK_API_KEY=

# DeepSeek OpenAI-compatible base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter API key (fallback / free models like nex-agi/nex-n2-pro:free)
OPENROUTER_API_KEY=

# Default free OpenRouter model
OPENROUTER_FREE_MODEL=nex-agi/nex-n2-pro:free

# OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# SOLANA / PHOENIX RISE
# =============================================================================

# Helius RPC URL (recommended for Phoenix perps data + Vulcan CLI)
# Get yours: https://helius.dev
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# Helius API key (for DAS token verification)
HELIUS_API_KEY=

# Phoenix Rise realtime data endpoint
PHOENIX_RISE_URL=https://api.phoenix.gg/enclave

# =============================================================================
# VULCAN MCP (Perpetuals Trading)
# =============================================================================

# Vulcan MCP server URL
VULCAN_MCP_URL=http://localhost:3001

# Phoenix underwriter preference
PHOENIX_UNDERWRITER=phoenix

# =============================================================================
# TRADING SAFETY (all must be true for live trading)
# =============================================================================

# Enable live trading (default: false = paper mode)
LIVE_TRADING=false

# Operator confirmed (set to true after reviewing safety docs)
OPERATOR_CONFIRMED=false

# Simulation only (set to false to enable real execution)
PERPS_SIM_ONLY=true

# Max notional USD per trade
PERPS_MAX_NOTIONAL_USD=250

# Max leverage (1-10)
PERPS_MAX_LEVERAGE=3

# Max spread in bps
PERPS_MAX_SPREAD_BPS=40

# Allowed symbols (comma-separated)
PERPS_ALLOWED_SYMBOLS=SOL,ETH,BTC

# =============================================================================
# IMAGE GENERATION
# =============================================================================

# OpenAI API key (for DALL-E)
OPENAI_API_KEY=

# Gemini API key (for free image gen via nano-banana)
GEMINI_API_KEY=

# =============================================================================
# VOICE / TTS
# =============================================================================

# ElevenLabs API key (for premium voice)
ELEVENLABS_API_KEY=

# Sherpa-onnx paths (auto-detected if installed via clawdbot)
SHERPA_ONNX_RUNTIME_DIR=~/.clawdbot/tools/sherpa-onnx-tts/runtime
SHERPA_ONNX_MODEL_DIR=~/.clawdbot/tools/sherpa-onnx-tts/models/vits-piper-en_US-lessac-high

# =============================================================================
# x402 PAYMENTS
# =============================================================================

# x402 payment gateway
X402_GATEWAY_URL=https://x402.wtf

# Payment secret (openssl rand -base64 32)
X402_PAYMENT_SECRET=

# =============================================================================
# LOGGING & DEBUG
# =============================================================================

# Log level: debug, info, warn, error
CLAWD_LOG_LEVEL=info

# Enable verbose output
CLAWD_VERBOSE=false
