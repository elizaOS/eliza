{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "bun-types"],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules",
      "../../node_modules/@types",
      "../../node_modules",
      "../../node_modules/.bun/node_modules/@types",
      "../../node_modules/.bun/node_modules",
      "../../../node_modules/@types",
      "../../../node_modules/.bun/node_modules/@types",
      "../../../node_modules",
      "../../../node_modules/.bun/node_modules"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "drizzle-orm": ["../plugin-sql/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../plugin-sql/node_modules/drizzle-orm/*"],
      "@elizaos/plugin-browser": ["../plugin-browser/src/index.ts"],
      "@elizaos/agent": ["../../packages/agent/src/index.ts"],
      "@elizaos/agent/*": ["../../packages/agent/src/*"],
      "@elizaos/plugin-app-manager": [
        "../../plugins/plugin-app-manager/src/index.ts"
      ],
      "@elizaos/plugin-agent-skills": [
        "../plugin-agent-skills/dist/index.d.ts"
      ],
      "@elizaos/app-core": ["../../packages/app-core/src/index.ts"],
      "@elizaos/app-core/*": ["../../packages/app-core/src/*"],
      "@elizaos/core": ["../../packages/core/src/index.ts"],
      "@elizaos/core/*": ["../../packages/core/src/*"],
      "@elizaos/logger": ["../../packages/logger/src/index.ts"],
      "@elizaos/logger/*": ["../../packages/logger/src/*"],
      "@elizaos/plugin-coding-tools": [
        "../plugin-coding-tools/dist/index.d.ts"
      ],
      "@elizaos/plugin-commands": ["../plugin-commands/src/index.ts"],
      "@elizaos/plugin-commands/*": ["../plugin-commands/src/*"],
      "@elizaos/plugin-health": ["../plugin-health/src/index.ts"],
      "@elizaos/plugin-health/*": ["../plugin-health/src/*"],
      "@elizaos/plugin-task-coordinator": [
        "../../plugins/plugin-task-coordinator/src/index.ts"
      ],
      "@elizaos/plugin-task-coordinator/*": [
        "../../plugins/plugin-task-coordinator/src/*"
      ],
      "@elizaos/plugin-wallet/ui": [
        "../../plugins/plugin-wallet/src/ui/index.ts"
      ],
      "@elizaos/plugin-wallet/*": ["../../plugins/plugin-wallet/src/*"],
      "@elizaos/ui": ["../../packages/ui/src/index.ts"],
      "@elizaos/ui/*": ["../../packages/ui/src/*"],
      "@elizaos/shared": ["../../packages/shared/src/index.ts"],
      "@elizaos/shared/*": ["../../packages/shared/src/*"],
      "@elizaos/capacitor-phone": [
        "../../plugins/plugin-native-phone/src/index.ts"
      ],
      "@elizaos/capacitor-bun-runtime": [
        "../../plugins/plugin-native-bun-runtime/src/index.ts"
      ],
      "@elizaos/capacitor-camera": [
        "../../plugins/plugin-native-camera/src/index.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["src/**/*.stories.ts", "src/**/*.stories.tsx"]
}
