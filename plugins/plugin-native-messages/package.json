{
  "name": "@elizaos/plugin-native-messages",
  "version": "2.0.3-beta.7",
  "type": "module",
  "description": "Android Messages overlay app for ElizaOS \u2014 SMS inbox and compose surface backed by @elizaos/plugin-native-messages/bridge.",
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "eliza-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "eliza-source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "eliza-source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./bridge": {
      "eliza-source": "./src/bridge.ts",
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "bunx @biomejs/biome check --write --unsafe .",
    "test": "bunx vitest run --config ./vitest.config.ts",
    "build": "node ../../packages/scripts/with-package-build-lock.ts plugins/plugin-native-messages -- bun run build:unlocked",
    "clean": "node ../../packages/scripts/rm-path-recursive.ts dist",
    "build:js": "tsup --config ../tsup.plugin-packages.shared.ts",
    "build:views": "vite build --config vite.config.views.ts",
    "build:types": "tsc6 --noCheck -p tsconfig.build.json",
    "lint:check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "build:unlocked": "bun run build:js && bun run build:views && bun run build:types"
  },
  "dependencies": {
    "@elizaos/capacitor-system": "workspace:*",
    "@elizaos/core": "workspace:*",
    "@elizaos/ui": "workspace:*",
    "lucide-react": "^1.0.0",
    "@capacitor/core": "8.4.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "elizaos": {
    "app": {
      "displayName": "Messages",
      "category": "system",
      "androidOnly": true,
      "heroImage": "assets/hero.png"
    },
    "appRegister": "register"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "assets",
    "dist",
    "android/src/main/",
    "android/build.gradle"
  ],
  "devDependencies": {
    "@capacitor/core": "^8.3.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "rollup": "^4.63.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "vite": "^8.3.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
