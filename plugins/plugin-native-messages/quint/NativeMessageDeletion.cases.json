          "metadataRacesCannotDeleteAReplacementEvenOnProvidersWhoseRowUriIgnoresSelection",
          "smsAndMmsUseDistinctTablesAndOnlyTheSelectedCollectionRow",
          "accessLossDuringTheIdentityReadRefusesBeforeAnyEffect",
          "malformedIdentityNeverReachesTheProvider",
          "missingAndAlreadyChangedRowsNeverDispatchADelete",
          "mmsUsesTheReaderNormalizationButBindsTheObservedRawDate",
          "unavailableOrCancelledReadsDoNotDelete",
          "unexplainedZeroAndInvalidCountsAreNeverConfirmedDeleted",
          "knownDeletionSurvivesAccessLossAfterTheEffect",
          "concurrentExternalRemovalReportsMissingNotAnUnprovenOwnDeletion"
        ]
      },
      {
        "className": "ai.eliza.plugins.messages.TelephonyPluginReviewTest",
        "required": [
          "backgroundBeforeJournalReplyMustRetireQueuedReview",
          "deleteRequiresImageForegroundUnlockedDefaultSmsAndReadAuthority",
          "withdrawnComposerApprovalCannotDispatchOrBeReplayed",
          "deleteRechecksRoleAndReadPermissionDuringIdentityLookup",
          "deleteRechecksLifecycleBeforeEffectAndKeepsKnownContentFreeOutcomeAfterwards",
          "mmsRetiredAfterStagingRollsBackOnlyItsOwnRow",
          "cancellationCannotEraseARecordedSubmission",
          "ownerApprovedMmsUsesTheSameReceiptWithoutDialogOrReplay",
