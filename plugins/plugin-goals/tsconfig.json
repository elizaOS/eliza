{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "types": ["node", "vite/client"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@elizaos/cloud-sdk/*": ["../../packages/cloud/sdk/src/*"],
      "@elizaos/app": ["../../packages/app/src/index.ts"],
      "@elizaos/app/*": ["../../packages/app/src/*"],
      "@elizaos/agent/*": ["../../packages/agent/src/*"],
      "@elizaos/core/protocol": ["../../packages/core/src/protocol"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.real.test.ts",
    "vitest.real-runtime.config.ts"
  ]
}
