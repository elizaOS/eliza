{
  "id": "imessage",
  "name": "iMessage",
  "description": "iMessage connector using native macOS Messages or an authenticated, channel-isolated Blooio transport for hosted agents.",
  "npmName": "@elizaos/plugin-imessage",
  "version": "2.0.0-beta.0",
  "source": "bundled",
  "tags": [
    "connector",
    "messaging",
    "imessage",
    "apple",
    "macos",
    "social",
    "social-chat"
  ],
  "config": {
    "IMESSAGE_TRANSPORT": {
      "type": "select",
      "required": true,
      "sensitive": false,
      "default": "native",
      "label": "Transport",
      "help": "Use native for the local macOS Messages app, or blooio for a hosted agent with a Blooio API channel.",
      "advanced": false,
      "options": [
        {
          "value": "native",
          "label": "Native macOS Messages"
        },
        {
          "value": "blooio",
          "label": "Blooio hosted transport"
        }
      ]
    },
    "IMESSAGE_DB_PATH": {
      "type": "file-path",
      "required": false,
      "sensitive": false,
      "label": "Db Path",
      "help": "Path to database file",
      "advanced": false
    },
    "IMESSAGE_ENABLED": {
      "type": "boolean",
      "required": false,
      "sensitive": false,
      "label": "Enabled",
      "help": "Enable or disable this feature",
      "advanced": false
    },
    "IMESSAGE_DM_POLICY": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Dm Policy",
      "help": "DM policy (e.g. allow, deny, allowlist)",
      "advanced": false
    },
    "IMESSAGE_ALLOW_FROM": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Allow From",
      "help": "Comma-separated allowed sender list",
      "advanced": false
    },
    "IMESSAGE_GROUP_POLICY": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "label": "Group Policy",
      "help": "Group message policy",
      "advanced": false
    },
    "IMESSAGE_POLL_INTERVAL_MS": {
      "type": "number",
      "required": false,
      "sensitive": false,
      "label": "Poll Interval Ms",
      "help": "Polling interval in milliseconds",
      "advanced": false,
      "min": 0,
      "unit": "ms"
    },
    "IMESSAGE_BLOOIO_API_KEY": {
      "type": "secret",
      "required": true,
      "sensitive": true,
      "label": "Blooio API Key",
      "help": "Blooio API key used when IMESSAGE_TRANSPORT is blooio",
      "advanced": false,
      "visible": {
        "key": "IMESSAGE_TRANSPORT",
        "equals": "blooio"
      }
    },
    "IMESSAGE_BLOOIO_WEBHOOK_SECRET": {
      "type": "secret",
      "required": true,
      "sensitive": true,
      "label": "Blooio Webhook Secret",
      "help": "Signing secret for Blooio webhook verification",
      "advanced": false,
      "visible": {
        "key": "IMESSAGE_TRANSPORT",
        "equals": "blooio"
      }
    },
    "IMESSAGE_BLOOIO_FROM_NUMBER": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "label": "Blooio From Number",
      "help": "Blooio sender phone number in E.164 format",
      "advanced": false,
      "visible": {
        "key": "IMESSAGE_TRANSPORT",
        "equals": "blooio"
      }
    },
    "IMESSAGE_BLOOIO_CHANNEL_ID": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "label": "Blooio Channel ID",
      "help": "Exact Blooio channel accepted for inbound webhooks and used by the configured sender number",
      "advanced": false,
      "visible": {
        "key": "IMESSAGE_TRANSPORT",
        "equals": "blooio"
      }
    }
  },
  "render": {
    "visible": true,
    "pinTo": [],
    "style": "setup-panel",
    "icon": "MessageSquare",
    "group": "connector",
    "groupOrder": 1,
    "actions": [
      "enable",
      "configure",
      "setup-guide"
    ]
  },
  "resources": {
    "setupGuideUrl": "https://docs.eliza.ai/tracks/agent/connect-channels#imessage-native-or-blooio"
  },
  "dependsOn": [],
  "kind": "connector",
  "subtype": "messaging",
  "auth": {
    "kind": "credentials",
    "credentialKeys": [
      "IMESSAGE_BLOOIO_API_KEY",
      "IMESSAGE_BLOOIO_WEBHOOK_SECRET",
      "IMESSAGE_BLOOIO_FROM_NUMBER",
      "IMESSAGE_BLOOIO_CHANNEL_ID"
    ]
  },
  "channels": [
    "imessage",
    "blooio"
  ]
}
