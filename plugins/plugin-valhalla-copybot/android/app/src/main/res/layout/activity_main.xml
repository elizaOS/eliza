<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="@string/title"
                android:textColor="@color/amber"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/about" />

            <Button
                android:id="@+id/proLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/pro_license" />

            <TextView
                android:id="@+id/cacheBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cached"
                android:textColor="@color/amber"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Update available"
                android:textColor="@color/amber"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pairingBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/status_idle"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/deskUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/panel"
                    android:hint="@string/hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:padding="12dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted" />

                <EditText
                    android:id="@+id/accessCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/panel"
                    android:hint="@string/access_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted" />

                <Button
                    android:id="@+id/connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/connect" />

                <Button
                    android:id="@+id/phantom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/connect_phantom" />

                <Button
                    android:id="@+id/solflare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/connect_solflare" />

                <Button
                    android:id="@+id/scanQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/scan_qr" />

                <Button
                    android:id="@+id/privacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_policy" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/liveStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/pnl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/green"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/positions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/recover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/recover" />

                <Button
                    android:id="@+id/openChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_chat" />

                <Button
                    android:id="@+id/openErrors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_errors" />

                <Button
                    android:id="@+id/stopWatch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stop_watch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chatBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chatLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/suggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/amber"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/confirmSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_suggestion"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/panel"
                    android:hint="@string/chat_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:padding="12dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted" />

                <Button
                    android:id="@+id/chatSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_send" />

                <Button
                    android:id="@+id/chatBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/back" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/errorBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/errorBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/back" />

                <Button
                    android:id="@+id/deleteData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/delete_data" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/safety"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/adColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/houseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/amber"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/houseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/houseLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/house_link"
            android:visibility="gone" />

        <TextView
            android:id="@+id/houseCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rewardedAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/rewarded_ad" />

        <TextView
            android:id="@+id/adNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ad_label"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <FrameLayout
            android:id="@+id/adSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
