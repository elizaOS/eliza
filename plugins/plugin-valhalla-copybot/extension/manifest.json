{
  "manifest_version": 3,
  "name": "Valhalla",
  "version": "0.2.0",
  "description": "Read-only status for your Valhalla desk. No send or withdraw.",
  "author": "TokenJunction LLC",
  "homepage_url": "https://valhalla-app.xyz/extension",
  "action": {
    "default_title": "Valhalla",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.mainnet-beta.solana.com/*"
  ],
  "externally_connectable": {
    "matches": ["https://valhalla-app.xyz/*", "https://www.valhalla-app.xyz/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  }
}
