# Copy this file to .env and fill in the Google key.
# Do not commit .env. The desk never prints these values.

# Google AI Studio key. This is not a Vertex AI key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Leave false. The desk stays read-only until you arm live in the app.
# Set this to false to block live swaps even if the app asks.
VALHALLA_LIVE_TRADING=false

# Optional. Public RPC is used when this is empty.
HELIUS_API_KEY=

# Optional price fallback.
BIRDEYE_API_KEY=

# Optional invite code. The repository is public. This only opens the desk.
VALHALLA_ACCESS_CODE=

# Optional password for the desk on this PC.
VALHALLA_DASHBOARD_PASSWORD=

VALHALLA_DASHBOARD_PORT=8787
VALHALLA_OPEN_BROWSER=true
