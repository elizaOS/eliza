{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "types": ["node", "bun"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@elizaos/cloud-sdk/*": ["../../packages/cloud/sdk/src/*"],
      "@elizaos/app": ["../../packages/app/src/index.ts"],
      "@elizaos/app/*": ["../../packages/app/src/*"],
      "@elizaos/agent/*": ["../../packages/agent/src/*"],
      "@elizaos/plugin-workflow/*": ["../plugin-workflow/dist/*"],
      "@elizaos/core/*": ["../../packages/core/src/*"],
      "@elizaos/plugin-wallet/ui": [
        "../../plugins/plugin-wallet/src/ui/index.ts"
      ],
      "@elizaos/plugin-wallet/*": ["../../plugins/plugin-wallet/src/*"],
      "@elizaos/ui/*": ["../../packages/ui/src/*"],
      "@elizaos/auth/vault/*": ["../../packages/auth/src/vault/*"],
      "@elizaos/plugin-local-inference/*": [
        "../../plugins/plugin-local-inference/src/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["src/**/*.stories.ts", "src/**/*.stories.tsx"]
}
