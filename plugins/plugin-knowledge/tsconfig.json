{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "strictNullChecks": true,
    "types": ["node", "vite/client"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@elizaos/cloud-sdk/*": ["../../packages/cloud/sdk/src/*"],
      "@elizaos/core/protocol": ["../../packages/core/src/protocol"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ]
}
