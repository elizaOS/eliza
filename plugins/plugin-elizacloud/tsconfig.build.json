{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "paths": {}
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "python",
    "rust",
    "build.ts",
    "vitest.config.ts",
    "**/__tests__/**",
    "**/*.test.ts",
    "src/components/**"
  ]
}
