{
  "framework": null,
  "buildCommand": "bash website/scripts/vercel-build.sh",
  "outputDirectory": "site-build",
  "proxy": {
    "entrypoint": "website/proxy.mjs",
    "matcher": ["/", "/index.html"]
  },
  "redirects": [
    { "source": "/app", "destination": "/app/", "permanent": true }
  ]
}
