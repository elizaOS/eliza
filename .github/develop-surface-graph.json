{
  "schemaVersion": 1,
  "graphVersion": "2026-09-16.1",
  "evidenceTtlHours": 168,
  "reusePolicy": "current-run-only",
  "environment": {
    "bun": "1.4.2",
    "node": "24.15.0",
    "runnerPolicy": "develop-full-v1",
    "runnerImageIdentity": "not-bound"
  },
  "globalInputs": [
    ".github/develop-surface-graph.json",
    ".github/develop-effects.json",
    ".github/workflows/develop-full.yml",
    ".github/workflows/develop-reconcile.yml",
    ".github/actions/setup-bun-workspace/**",
    "package.json",
    "bun.lock",
    "bunfig.toml",
    "biome.json",
    "turbo.json",
    "tsconfig.json",
    "tsconfig.base.json",
    "packages/scripts/develop-effect-ledger.mjs",
    "packages/scripts/develop-impact-evidence.mjs"
  ],
  "surfaces": [
    {
      "id": "canonical",
      "workflow": ".github/workflows/ci.yml",
      "workspacePatterns": [
        "packages/core",
        "packages/agent",
        "packages/auth",
        "packages/testing/synthetic-world",
        "plugins/**",
        "packages/app",
        "packages/ui",
        "packages/testing/scenario-runner",
        "packages/testing",
        "plugins/plugin-computeruse",
        "packages/**"
      ],
      "inputs": [
        "packages/scripts/**",
        "*.md",
        "**/*.md",
        "packages/scripts/audit-*.mjs",
        "packages/testing/scenario-runner/test/**",
        "packages/scripts/run-all-tests.mjs",
        "vitest*.ts",
        "vitest*.mts"
      ]
    },
    {
      "id": "cloud",
      "workflow": ".github/workflows/cloud-tests.yml",
      "workspacePatterns": ["packages/cloud/**", "plugins/plugin-elizacloud"],
      "inputs": ["packages/scripts/cloud/**"],
      "dependsOn": ["canonical"]
    },
    {
      "id": "cloud-gateway-discord",
      "workflow": ".github/workflows/cloud-gateway-discord.yml",
      "workspacePatterns": [
        "packages/cloud/shared",
        "packages/cloud/services/gateway-discord",
        "plugins/plugin-discord"
      ],
      "inputs": ["packages/cloud/scripts/**"],
      "dependsOn": ["canonical"]
    },
    {
      "id": "dev-smoke",
      "workflow": ".github/workflows/dev-smoke.yml",
      "workspacePatterns": [
        "packages/agent",
        "packages/app",
        "packages/core",
        "packages/ui"
      ],
      "inputs": ["packages/app/test/ui-smoke/**"],
      "dependsOn": ["canonical"]
    },
    {
      "id": "platform-smoke",
      "workflow": ".github/workflows/platform-smoke.yml",
      "workspacePatterns": ["packages/core"],
      "inputs": [
        "packages/scripts/test-cloud-run-watchdog.self-test.mjs",
        ".github/ci-windows-command-inventory.json"
      ],
      "dependsOn": ["canonical"]
    },
    {
      "id": "ui-core",
      "workflow": ".github/workflows/ui-e2e-gate.yml",
      "workspacePatterns": ["packages/app", "packages/core", "packages/ui"],
      "inputs": [
        "packages/ui/src/**",
        "packages/ui/test/**",
        "packages/ui/src/testing/**"
      ],
      "dependsOn": ["canonical"]
    },
    {
      "id": "ui-stories",
      "workflow": ".github/workflows/ui-story-gate.yml",
      "workspacePatterns": ["packages/app", "packages/ui"],
      "inputs": ["packages/ui/src/**/*.stories.*", ".storybook/**"],
      "dependsOn": ["ui-core"]
    }
  ]
}
