{
  "schemaVersion": 1,
  "graphVersion": "2026-09-16.1",
  "evidenceTtlHours": 168,
  "reusePolicy": "current-run-only",
  "environment": {
    "bun": "1.3.14",
    "node": "24.15.0",
    "runnerPolicy": "develop-full-v1",
    "runnerImageIdentity": "not-bound"
  },
  "globalInputs": [
    ".github/develop-surface-graph.json",
    ".github/develop-effects.json",
    ".github/workflows/develop-full.yml",
    ".github/workflows/develop-reconcile.yml",
    ".github/actions/setup-bun-workspace/**",
    "package.json",
    "bun.lock",
    "bunfig.toml",
    "biome.json",
    "turbo.json",
    "tsconfig.json",
    "tsconfig.base.json",
    "packages/scripts/develop-effect-ledger.mjs",
    "packages/scripts/develop-impact-evidence.mjs"
  ],
  "surfaces": [
    {
      "id": "canonical",
      "workflow": ".github/workflows/ci.yml",
      "workspacePatterns": [
        "packages/core",
        "packages/agent",
        "packages/auth",
        "packages/logger",
        "packages/prompts",
        "packages/registry",
        "packages/shared",
        "packages/synthetic-world",
        "packages/skills",
        "packages/vault",
        "plugins/**",
        "packages/app",
        "packages/app-core",
        "packages/homepage",
        "packages/ui",
        "packages/scenario-runner",
        "packages/test",
        "plugins/plugin-app-control",
        "plugins/plugin-computeruse",
        "packages/**"
      ],
      "inputs": [
        "packages/scripts/**",
        "scripts/**",
        "*.md",
        "**/*.md",
        "packages/docs/**",
        "packages/scripts/audit-*.mjs",
        "packages/scenario-runner/test/**",
        "packages/scripts/run-all-tests.mjs",
        "vitest*.ts",
        "vitest*.mts"
      ]
    },
    {
      "id": "cloud",
      "workflow": ".github/workflows/cloud-tests.yml",
      "workspacePatterns": [
        "packages/cloud/**",
        "plugins/plugin-cloud-apps",
        "plugins/plugin-elizacloud",
        "packages/cloud/shared",
        "packages/cloud/services/gateway-discord",
        "plugins/plugin-discord"
      ],
      "inputs": ["scripts/cloud/**", "packages/cloud/scripts/**"],
      "dependsOn": ["canonical"]
    },
    {
      "id": "dev-smoke",
      "workflow": ".github/workflows/dev-smoke.yml",
      "workspacePatterns": [
        "packages/agent",
        "packages/app",
        "packages/app-core",
        "packages/core",
        "packages/shared",
        "packages/ui"
      ],
      "inputs": ["packages/app/test/ui-smoke/**"],
      "dependsOn": ["canonical"]
    },
    {
      "id": "docker",
      "workflow": ".github/workflows/docker-ci-smoke.yml",
      "workspacePatterns": [
        "packages/agent",
        "packages/core",
        "packages/shared"
      ],
      "inputs": [
        "Dockerfile",
        ".dockerignore",
        "packages/scripts/build-core*.mjs"
      ],
      "dependsOn": ["canonical"]
    },
    {
      "id": "secrets",
      "workflow": ".github/workflows/gitleaks.yml",
      "catchAll": true,
      "workspacePatterns": [],
      "inputs": ["**", ".gitleaks.toml"]
    },
    {
      "id": "platform-smoke",
      "workflow": ".github/workflows/platform-smoke.yml",
      "workspacePatterns": ["packages/core", "packages/shared"],
      "inputs": [
        "packages/scripts/test-cloud-run-watchdog.self-test.mjs",
        ".github/ci-windows-command-inventory.json"
      ],
      "dependsOn": ["canonical"]
    },
    {
      "id": "ui-core",
      "workflow": ".github/workflows/ui-e2e-gate.yml",
      "workspacePatterns": [
        "packages/app",
        "packages/app-core",
        "packages/core",
        "packages/shared",
        "packages/ui"
      ],
      "inputs": [
        "packages/ui/src/**",
        "packages/ui/test/**",
        "packages/ui/src/testing/**"
      ],
      "dependsOn": ["canonical"]
    },
    {
      "id": "ui-stories",
      "workflow": ".github/workflows/ui-story-gate.yml",
      "workspacePatterns": [
        "packages/app",
        "packages/app-core",
        "packages/shared",
        "packages/ui"
      ],
      "inputs": ["packages/ui/src/**/*.stories.*", ".storybook/**"],
      "dependsOn": ["ui-core"]
    }
  ]
}
