{
  "schemaVersion": 1,
  "ledgerVersion": "2026-09-06.three-branch-v1",
  "effects": [
    {
      "id": "agent-image-staging",
      "workflow": "build-agent-image.yml",
      "surfaces": [
        "canonical",
        "cloud",
        "docker"
      ],
      "shaInput": "source_sha",
      "inputs": {
        "publication_target": "canonical"
      }
    },
    {
      "id": "apps-worker-staging",
      "workflow": "deploy-apps-worker.yml",
      "surfaces": [
        "canonical",
        "cloud"
      ],
      "shaInput": "source_sha",
      "inputs": {
        "environment": "staging"
      }
    },
    {
      "id": "provisioning-worker-staging",
      "workflow": "deploy-eliza-provisioning-worker.yml",
      "surfaces": [
        "canonical",
        "cloud"
      ],
      "shaInput": "deployment_sha",
      "inputs": {
        "environment": "staging"
      }
    },
    {
      "id": "cloud-staging",
      "workflow": "cloud-cf-deploy.yml",
      "surfaces": [
        "canonical",
        "cloud",
        "quality",
        "ui-core"
      ],
      "shaInput": "source_sha",
      "inputs": {
        "environment": "staging",
        "force": "false"
      }
    }
  ],
  "promotion": {
    "id": "main-promotion",
    "sourceBranch": "staging",
    "targetBranch": "main"
  },
  "sourceBranch": "staging"
}
