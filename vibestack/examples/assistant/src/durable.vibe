// The assistant's state kept in one JSON file, so that a crash loses only what spec/assistant.md keeps in memory
// (spec/assistant.md, "Story: Survive a restart").
import { apply, decodeState, initial, Machine, machineOver, NotAState } from "../gen/assistant.effect.vibe"
import type * as T from "../gen/assistant.effect.vibe"

/**
 * A Machine kept in `file`: a missing file starts from `initial`, one that holds no state fails with `NotAState`.
 * Opening it is a restart, which comes from the world (spec/assistant.md, "A restart loses what was in memory and keeps
 * what was saved"). Each accepted event is applied to what the file holds when it is sent, and is in the file, written
 * to a temporary file, synced to the disk and renamed, before `send` returns; one that cannot be read or written is a
 * defect, and the state stays as the file has it.
 *
 * It is for one process: nothing locks the file between an event's read and its rename, so two processes that send at
 * once can overwrite each other's events.
 * Pending effects and their delivery counter are saved with the state. `deliver` in agent.vibe retries them with
 * their original number after a restart; the World confirms each number idempotently before it is removed.
 */
export effect function opened(file: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  effect function save(state: T.Assistant) {
    try scoped(effect {
      const directory = try fs.makeTempDirectoryScoped({ directory: path.dirname(file), prefix: ".assistant-" })
      const temporary = path.join(directory, "state.json")
      try scoped(effect {
        const temp = try fs.open(temporary, { flag: "wx", mode: 0o600 })
        try temp.writeAll(new TextEncoder().encode(JSON.stringify(state)))
        try temp.sync
      })
      try fs.rename(temporary, file)
    })
  }
  effect function load() {
    const text = (try fs.exists(file)) ? try fs.readFileString(file) : undefined
    return text === undefined
      ? initial
      : try mapError(flatMap(Effect.try(() => JSON.parse(text)), decodeState), () => new NotAState({ input: "saved assistant state" }))
  }
  try save((try apply(try load(), { type: "restart" }, "World")).state)
  return try machineOver(load, (next) => orDie(save(next)))
}

/** `opened(file)` as the Machine service. */
export function durable(file: string) {
  return Layer.effect(Machine, opened(file))
}
