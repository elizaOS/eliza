// spec/server.md, "Story: Change the list over HTTP"
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { listening, server } from "./server.vibe"

effect function main() {
  // `pnpm build` puts this file in dist/src and the page in dist/web; the list is kept beside them, in dist/todos.json.
  const path = try Path.Path
  const web = try path.fromFileUrl(new URL("../web", import.meta.url))
  const list = try path.fromFileUrl(new URL("../todos.json", import.meta.url))
  provide server(web, Layer.catchTag(listening(3000), "ServeError", () => listening(0)), list) {
    const { address } = try HttpServer.HttpServer
    if ("port" in address) try Console.log(`http://localhost:${address.port}`)
    try never
  }
}

NodeRuntime.runMain(Effect.provide(main(), NodeServices.layer))
